+void RenderManager::DeferClear(const DeferredClear& clear) {
+    // Asked between render passes (ClearTexture ends the open one); never left inside one.
+    EndRendering();
+    // A later clear of the whole image replaces the one still held back.
+    for (DeferredClear& pending : deferred_clears) {
+        if (pending.image == clear.image) {
+            pending = clear;
+            return;
+        }
+    }
+    if (deferred_clears.size() == deferred_clears.capacity()) {
+        FlushDeferredClears();
+    }
+    deferred_clears.push_back(clear);
+    scheduler.RequestBeforeRecord();
+}
+
+void RenderManager::FlushDeferredClears() {
+    if (deferred_clears.empty()) {
+        return;
+    }
+    const boost::container::static_vector<DeferredClear, 4> clears = deferred_clears;
+    deferred_clears.clear();
+    scheduler.CancelBeforeRecord();
+    for (const DeferredClear& clear : clears) {
+        // As TextureRuntime::ClearTexture recorded it before.
+        scheduler.Record([clear](vk::CommandBuffer cmdbuf) {
+            const vk::ImageSubresourceRange range = {
+                .aspectMask = clear.aspect,
+                .baseMipLevel = 0,
+                .levelCount = 1,
+                .baseArrayLayer = 0,
+                .layerCount = 1,
+            };
+
+            const vk::ImageMemoryBarrier pre_barrier = {
+                .srcAccessMask = clear.src_access,
+                .dstAccessMask = vk::AccessFlagBits::eTransferWrite,
+                .oldLayout = vk::ImageLayout::eGeneral,
+                .newLayout = vk::ImageLayout::eTransferDstOptimal,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = clear.image,
+                .subresourceRange = range,
+            };
+
+            const vk::ImageMemoryBarrier post_barrier = {
+                .srcAccessMask = vk::AccessFlagBits::eTransferWrite,
+                .dstAccessMask = clear.src_access,
+                .oldLayout = vk::ImageLayout::eTransferDstOptimal,
+                .newLayout = vk::ImageLayout::eGeneral,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = clear.image,
+                .subresourceRange = range,
+            };
+
+            cmdbuf.pipelineBarrier(clear.pipeline_flags, vk::PipelineStageFlagBits::eTransfer,
+                                   vk::DependencyFlagBits::eByRegion, {}, {}, pre_barrier);
+
+            if (clear.aspect & vk::ImageAspectFlagBits::eColor) {
+                cmdbuf.clearColorImage(clear.image, vk::ImageLayout::eTransferDstOptimal,
+                                       clear.value.color, range);
