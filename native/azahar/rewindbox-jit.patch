diff --git a/src/video_core/renderer_vulkan/vk_rewindbox_perf.h b/src/video_core/renderer_vulkan/vk_rewindbox_perf.h
new file mode 100644
index 0000000..b8c329b
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_rewindbox_perf.h
@@ -0,0 +1,46 @@
+// Copyright 2026 RewindBox contributors
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+#pragma once
+
+#include <chrono>
+#include "common/common_types.h"
+
+namespace Vulkan::RewindBoxPerf {
+
+/// GPU work of the Vulkan renderer, counted on the emulation thread and written every
+/// kFramesPerLine frames as one "[rb-perf] azahar" line of the core log (RendererVulkan). The
+/// frontend copies the lines carrying "[rb-perf]" into its session journal, so a device test
+/// shows where the time of a frame goes at a high internal resolution.
+struct Counters {
+    u64 passes{};       ///< render passes begun (draws, blits, conversions)
+    u64 folded{};       ///< deferred clears a render pass took as its load operation
+    u64 flushed{};      ///< deferred clears recorded as separate clear commands
+    u64 partial{};      ///< clears of part of an image (a render pass of their own)
+    u64 kept{};         ///< draws that kept the other attachment of the open render pass
+    u64 uploads{};      ///< texture uploads from guest memory
+    u64 upload_bytes{}; ///< bytes of those uploads
+    u64 downloads{};    ///< surfaces read back to guest memory
+    u64 copies{};       ///< image copies
+    u64 blits{};        ///< image blits (scaling, display transfers)
+    u64 transfers{};    ///< display transfers asked by the game (one per screen and eye)
+    u64 fills{};        ///< memory fills asked by the game (clears of its buffers)
+    u64 submits{};      ///< queue submissions
+    u64 finishes{};     ///< waits of the CPU for the GPU (Scheduler::Finish)
+    u64 finish_ns{};    ///< time of those waits
+    u64 sync_ns{};      ///< time in the frontend's wait_sync_index (GetRenderFrame)
+    u64 present_ns{};   ///< time in the frontend's video refresh (PresentWindow::Present)
+};
+
+inline Counters counters;
+
+inline constexpr u64 kFramesPerLine = 600;
+
+[[nodiscard]] inline u64 NowNs() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+} // namespace Vulkan::RewindBoxPerf
