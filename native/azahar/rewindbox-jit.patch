+            }
+
+            cmdbuf.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, clear.pipeline_flags,
+                                   vk::DependencyFlagBits::eByRegion, {}, {}, post_barrier);
+        });
+    }
+    RewindBoxPerf::counters.flushed += clears.size();
