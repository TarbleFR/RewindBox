+        code.LDUR(X0, Xstate, offsetof(A32JitState, regs) + 15 * sizeof(u32));
+
+        code.EOR(Xscratch0, X0, X0, LSR, 32);
+        code.UBFX(Xscratch0, Xscratch0, 1, AddressSpace::fast_dispatch_table_bits);
+        code.MOV(Xscratch1, ctx.conf.fast_dispatch_table_pointer);
+        code.ADD(Xscratch0, Xscratch1, Xscratch0, LSL, 4);
+        code.LDP(Xscratch1, Xscratch2, Xscratch0);
+
+        code.CMP(X0, Xscratch1);
+        code.B(NE, fail);
+        code.BR(Xscratch2);
+
+        code.l(fail);
+    }
+
+    EmitRelocation(code, ctx, LinkTarget::ReturnToDispatcher);
