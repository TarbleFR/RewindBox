+    // cache's garbage collector (RunGarbageCollector).
+    retired.emplace_back(GetResourceTick(), std::move(handle));
+    CollectRetired();
+}
+
+namespace {
+u64 StorageHintKey(PAddr addr, u32 width, u32 height) {
+    return (u64{addr} << 32) ^ (u64{width} << 16) ^ u64{height};
+}
+} // Anonymous namespace
+
+void TextureRuntime::NoteShaderStorage(PAddr addr, u32 width, u32 height) {
+    if (storage_hints.size() < 4096) {
+        storage_hints.insert(StorageHintKey(addr, width, height));
+    }
+}
+
+bool TextureRuntime::WantsShaderStorage(PAddr addr, u32 width, u32 height) const {
+    return !storage_hints.empty() && storage_hints.contains(StorageHintKey(addr, width, height));
+}
+
+void TextureRuntime::CollectRetired() {
+    if (retired.empty()) {
+        return;
+    }
+    const u64 free_tick = GetResourceFreeTick();
+    while (!retired.empty() && free_tick > retired.front().first) {
+        retired.pop_front();
+    }
+}
+
+vk::ImageUsageFlags Surface::ImageUsage(bool with_storage) const noexcept {
+    vk::ImageUsageFlags usage = traits.usage & ~vk::ImageUsageFlagBits::eStorage;
+    // Ensure color formats have the color attachment bit set for framebuffers
+    if (traits.aspect & vk::ImageAspectFlagBits::eColor) {
+        usage |= vk::ImageUsageFlagBits::eColorAttachment;
+    }
+    if (with_storage && traits.native == vk::Format::eR8G8B8A8Unorm && traits.storage_support) {
+        usage |= vk::ImageUsageFlagBits::eStorage;
+    }
+    return usage;
+}
+
+vk::ImageCreateFlags Surface::ImageFlags(bool with_storage) const noexcept {
+    vk::ImageCreateFlags flags{};
+    if (texture_type == VideoCore::TextureType::CubeMap) {
+        flags |= vk::ImageCreateFlagBits::eCubeCompatible;
+    }
+    if (with_storage && traits.native == vk::Format::eR8G8B8A8Unorm) {
+        // R32Uint views (StorageView) for the atomic shadow writes and reads.
+        flags |= vk::ImageCreateFlagBits::eMutableFormat;
+    }
+    return flags;
+}
+
+bool Surface::EnsureShaderStorage() {
+    if (shader_storage || traits.native != vk::Format::eR8G8B8A8Unorm) {
+        return false;
+    }
+    shader_storage = true;
+    runtime.NoteShaderStorage(addr, width, height);
+    if (!handles[Type::Base]) {
+        return false;
+    }
+
+    runtime.renderpass_cache.EndRendering();
+    runtime.ResolveClears({this});
+
+    const vk::ImageCreateFlags flags = ImageFlags(true);
+    const vk::ImageUsageFlags usage = ImageUsage(true);
+    const bool need_format_list = instance.IsImageFormatListSupported();
+    const vk::PipelineStageFlags pipeline_flags = PipelineStageFlags();
+    const vk::AccessFlags access = AccessFlags();
+    const vk::ImageAspectFlags aspect = Aspect();
+
+    for (const Type type : {Type::Base, Type::Scaled}) {
+        if (!handles[type]) {
+            continue;
+        }
+        Handle fresh{instance};
+        fresh.Create(handles[type].width, handles[type].height, handles[type].levels, texture_type,
+                     traits.native, vk::SampleCountFlagBits::e1, usage, flags, aspect,
+                     need_format_list, DebugName(type == Type::Scaled));
+
+        scheduler.RecordIndependent([src_image = handles[type].image, dst_image = fresh.image,
+                                     width = handles[type].width, height = handles[type].height,
+                                     levels = handles[type].levels,
+                                     layers = handles[type].layers, aspect, pipeline_flags,
+                                     access](vk::CommandBuffer cmdbuf) {
+            const vk::ImageSubresourceRange range = {
+                .aspectMask = aspect,
+                .baseMipLevel = 0,
+                .levelCount = levels,
+                .baseArrayLayer = 0,
+                .layerCount = layers,
+            };
+            const std::array pre_barriers = {
+                vk::ImageMemoryBarrier{
+                    .srcAccessMask = access,
+                    .dstAccessMask = vk::AccessFlagBits::eTransferRead,
+                    .oldLayout = vk::ImageLayout::eGeneral,
+                    .newLayout = vk::ImageLayout::eTransferSrcOptimal,
+                    .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .image = src_image,
+                    .subresourceRange = range,
+                },
+                vk::ImageMemoryBarrier{
+                    .srcAccessMask = vk::AccessFlagBits::eNone,
+                    .dstAccessMask = vk::AccessFlagBits::eTransferWrite,
+                    .oldLayout = vk::ImageLayout::eUndefined,
+                    .newLayout = vk::ImageLayout::eTransferDstOptimal,
+                    .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .image = dst_image,
+                    .subresourceRange = range,
+                },
+            };
+            const std::array post_barriers = {
+                vk::ImageMemoryBarrier{
+                    .srcAccessMask = vk::AccessFlagBits::eTransferRead,
+                    .dstAccessMask = vk::AccessFlagBits::eNone,
+                    .oldLayout = vk::ImageLayout::eTransferSrcOptimal,
+                    .newLayout = vk::ImageLayout::eGeneral,
+                    .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .image = src_image,
+                    .subresourceRange = range,
+                },
+                vk::ImageMemoryBarrier{
+                    .srcAccessMask = vk::AccessFlagBits::eTransferWrite,
+                    .dstAccessMask = access,
+                    .oldLayout = vk::ImageLayout::eTransferDstOptimal,
+                    .newLayout = vk::ImageLayout::eGeneral,
+                    .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                    .image = dst_image,
+                    .subresourceRange = range,
+                },
+            };
+            boost::container::small_vector<vk::ImageCopy, 8> copies;
+            for (u32 level = 0; level < levels; level++) {
+                const vk::ImageSubresourceLayers layer_range = {
+                    .aspectMask = aspect,
+                    .mipLevel = level,
+                    .baseArrayLayer = 0,
+                    .layerCount = layers,
+                };
+                copies.push_back(vk::ImageCopy{
+                    .srcSubresource = layer_range,
+                    .srcOffset = {0, 0, 0},
+                    .dstSubresource = layer_range,
+                    .dstOffset = {0, 0, 0},
+                    .extent = {std::max(width >> level, 1u), std::max(height >> level, 1u), 1},
+                });
+            }
+            cmdbuf.pipelineBarrier(pipeline_flags | vk::PipelineStageFlagBits::eTopOfPipe,
+                                   vk::PipelineStageFlagBits::eTransfer,
+                                   vk::DependencyFlagBits::eByRegion, {}, {}, pre_barriers);
+            cmdbuf.copyImage(src_image, vk::ImageLayout::eTransferSrcOptimal, dst_image,
+                             vk::ImageLayout::eTransferDstOptimal, copies);
+            cmdbuf.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, pipeline_flags,
+                                   vk::DependencyFlagBits::eByRegion, {}, {}, post_barriers);
+        });
+
+        runtime.Retire(std::move(handles[type]));
+        handles[type] = std::move(fresh);
+    }
+
+    // Framebuffers keyed on the old generation are never used again (RasterizerCache).
+    view_generation++;
+    RewindBoxPerf::counters.migrated++;
+    return true;
+}
