+
+static void ApplyJitPlan() {
+    if (!jit_plan) {
+        const bool installed = RewindBoxJit::IsInstalled();
+        const bool capable = installed && LibRetro::CanUseJIT();
+        const unsigned cores = Settings::values.is_new_3ds.GetValue() ? 4 : 2;
+        jit_plan = capable ? RewindBoxJit::MakePlan(Settings::values.use_cpu_jit.GetValue(),
+                                                    Settings::values.use_shader_jit.GetValue(),
+                                                    cores)
+                           : RewindBoxJit::Plan{};
+        LOG_INFO(Frontend, "[rb-jit] installed={} capable={} cpu={} shader={}", installed,
+                 capable, jit_plan->cpu_jit ? "dynarmic" : "interpreter",
+                 jit_plan->shader_jit ? "jit" : "interpreter");
+    }
+    Settings::values.use_cpu_jit = jit_plan->cpu_jit;
+    Settings::values.use_shader_jit = jit_plan->shader_jit;
+    Settings::values.dynarmic_code_cache_size = jit_plan->app_code_cache;
+    Settings::values.dynarmic_idle_code_cache_size = jit_plan->idle_code_cache;
+}
