+void EmitA32Terminal(oaknut::CodeGenerator& code, EmitContext& ctx, IR::Term::FastDispatchHint, IR::LocationDescriptor, bool is_single_step) {
+    // RewindBox: indirect branches other than returns (BX/BLX to a register, MOV/LDR to PC,
+    // jump tables) look their target up in the dispatcher's direct-mapped table
+    // (AddressSpace::FastDispatchEntry) instead of calling the dispatcher every time. Same
+    // location value and slot as AddressSpace::FastDispatchIndex; a miss, an empty slot or the
+    // end of the time slice goes through the dispatcher, which fills the slot.
+    if (ctx.conf.HasOptimization(OptimizationFlag::FastDispatch) && !is_single_step && ctx.conf.fast_dispatch_table_pointer != 0) {
+        oaknut::Label fail;
+
+        if (ctx.conf.enable_cycle_counting) {
+            code.CMP(Xticks, 0);
+            code.B(LE, fail);
+        } else {
+            code.LDAR(Wscratch0, Xhalt);
+            code.CBNZ(Wscratch0, fail);
+        }
 
