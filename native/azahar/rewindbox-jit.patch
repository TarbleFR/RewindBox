+// Copyright 2026 RewindBox contributors
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+#pragma once
+
+#include <cstddef>
+
+#include "citra_libretro/RewindBoxLibretroJit.h" // verbatim copy of the host header (MIT)
+
+/// Exported (libretro.osx.def); called by the host right after dlopen. 0 = the arena is taken.
+extern "C" int rewindbox_libretro_jit_install(const RewindBoxLibretroJitV1* abi);
+
+namespace RewindBoxJit {
+
+struct Plan {
+    bool cpu_jit = false;
+    bool shader_jit = false;
+    std::size_t app_code_cache = 0;  ///< per dynarmic instance bound to a process page table
+    std::size_t idle_code_cache = 0; ///< per dynarmic instance created for the initial null table
+    std::size_t shader_bytes = 0;    ///< region reserved for Pica shader code
+};
+
+/// A valid ABI v1 arena was installed for this dlopen session.
+bool IsInstalled();
+
+/// Partitions the arena for one game. Only valid while no code block is alive.
+Plan MakePlan(bool want_cpu_jit, bool want_shader_jit, unsigned num_cores);
+
+/// retro_deinit: forget the arena (the host frees it after dlclose).
+void Shutdown();
+
+} // namespace RewindBoxJit
