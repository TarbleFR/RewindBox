+        if (it != deferred_clears.end()) {
+            const bool is_color = i == 0;
+            clear_mask |= 1u << i;
+            clears[attachment] = it->value;
+            // What the clear's own barrier did, towards the attachment instead of a transfer.
+            barriers[num_barriers++] = vk::ImageMemoryBarrier{
+                .srcAccessMask = it->src_access,
+                .dstAccessMask = is_color ? vk::AccessFlagBits::eColorAttachmentRead |
+                                                vk::AccessFlagBits::eColorAttachmentWrite
+                                          : vk::AccessFlagBits::eDepthStencilAttachmentRead |
+                                                vk::AccessFlagBits::eDepthStencilAttachmentWrite,
+                .oldLayout = vk::ImageLayout::eGeneral,
+                .newLayout = vk::ImageLayout::eGeneral,
+                .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                .image = it->image,
+                .subresourceRange{
+                    .aspectMask = it->aspect,
+                    .baseMipLevel = 0,
+                    .levelCount = 1,
+                    .baseArrayLayer = 0,
+                    .layerCount = 1,
