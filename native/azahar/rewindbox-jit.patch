+        total.compiled_bytes += stats.compiled_bytes;
+        total.compile_ns += stats.compile_ns;
+        total.clears += stats.clears;
+        total.full_clears += stats.full_clears;
+        total.invalidated_blocks += stats.invalidated_blocks;
+        total.dispatcher_lookups += stats.dispatcher_lookups;
