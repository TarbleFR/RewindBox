+             static_cast<double>(delta(total.compile_ns, rb_stats.compile_ns)) / 1e6,
+             delta(total.clears, rb_stats.clears), delta(total.full_clears, rb_stats.full_clears),
+             delta(total.invalidated_blocks, rb_stats.invalidated_blocks),
+             static_cast<double>(delta(total.dispatcher_lookups, rb_stats.dispatcher_lookups)) /
