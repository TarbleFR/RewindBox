diff --git a/src/citra_libretro/rewindbox_jit.cpp b/src/citra_libretro/rewindbox_jit.cpp
new file mode 100644
index 0000000..1387a61
--- /dev/null
+++ b/src/citra_libretro/rewindbox_jit.cpp
@@ -0,0 +1,216 @@
+// Copyright 2026 RewindBox contributors
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+// Code memory for dynarmic and the Pica shader JIT, taken from the arena that the RewindBox host
+// prepares before loading the core (RX view + RW alias of the same pages). oaknut::CodeBlock asks
+// this file for memory while an arena is installed, so no JIT code is ever mmap'd or mprotect'ed.
+
+#include <algorithm>
+#include <iterator>
+#include <map>
+#include <mutex>
+#include <oaknut/code_block.hpp>
+
+#include "citra_libretro/rewindbox_jit.h"
+#include "common/logging/log.h"
+
+namespace RewindBoxJit {
+namespace {
+
+constexpr std::size_t MiB = std::size_t{1} << 20;
+constexpr std::size_t kSmallAlign = 256;      // Pica shaders (sub-page blocks)
+constexpr std::size_t kMinCapacity = 16 * MiB;
+
+struct Region {
+    std::map<std::size_t, std::size_t> free; // offset -> length, coalesced
+
+    void Reset(std::size_t begin, std::size_t end) {
+        free.clear();
+        if (end > begin) {
+            free.emplace(begin, end - begin);
+        }
+    }
+};
+
+std::mutex g_mutex;
+RewindBoxLibretroJitV1 g_abi{};
+std::uintptr_t g_rx = 0;
+std::uintptr_t g_rw = 0;
+std::size_t g_capacity = 0;
+std::size_t g_live = 0;
+bool g_installed = false;
+Region g_cpu;    // dynarmic code caches (>= 1 MiB each)
+Region g_shader; // Pica shader programs
+
+std::size_t AlignUp(std::size_t value, std::size_t align) {
+    return (value + align - 1) / align * align;
+}
+
+std::size_t AlignFor(std::size_t size) {
+    return size >= MiB ? static_cast<std::size_t>(g_abi.pageBytes) : kSmallAlign;
+}
+
+Region& RegionFor(std::size_t size) {
+    return size >= MiB ? g_cpu : g_shader;
+}
+
+std::uint32_t* Allocate(std::size_t size, std::uint32_t** wptr) {
+    std::lock_guard lock{g_mutex};
+    if (!g_installed || size == 0) {
+        return nullptr;
+    }
+    const std::size_t align = AlignFor(size);
+    const std::size_t want = AlignUp(size, align);
+    Region& region = RegionFor(size);
+    for (auto it = region.free.begin(); it != region.free.end(); ++it) {
+        const auto [offset, length] = *it;
+        const std::size_t start = AlignUp(offset, align);
+        if (start + want > offset + length) {
+            continue;
+        }
+        region.free.erase(it);
+        if (start > offset) {
+            region.free.emplace(offset, start - offset);
+        }
+        if (offset + length > start + want) {
+            region.free.emplace(start + want, offset + length - start - want);
+        }
+        ++g_live;
+        *wptr = reinterpret_cast<std::uint32_t*>(g_rw + start);
+        return reinterpret_cast<std::uint32_t*>(g_rx + start);
+    }
+    LOG_WARNING(Frontend, "[rb-jit] arena full: {} bytes requested", size);
+    return nullptr;
+}
+
+void Release(std::uint32_t* xptr, std::size_t size) {
+    std::lock_guard lock{g_mutex};
+    std::size_t start = reinterpret_cast<std::uintptr_t>(xptr) - g_rx;
+    std::size_t length = AlignUp(size, AlignFor(size));
+    Region& region = RegionFor(size);
+    auto next = region.free.lower_bound(start);
+    if (next != region.free.begin()) {
+        const auto prev = std::prev(next);
+        if (prev->first + prev->second == start) {
+            start = prev->first;
+            length += prev->second;
+            region.free.erase(prev);
+        }
+    }
+    if (next != region.free.end() && start + length == next->first) {
+        length += next->second;
+        region.free.erase(next);
+    }
+    region.free.emplace(start, length);
+    --g_live;
+}
+
+void Flush(std::uint32_t* xptr, std::size_t size) {
+    g_abi.flush(reinterpret_cast<std::uintptr_t>(xptr), size);
+}
+
+constexpr oaknut::ExternalCodeAllocator kAllocator{&Allocate, &Release, &Flush};
+
+} // namespace
+
+bool IsInstalled() {
+    std::lock_guard lock{g_mutex};
+    return g_installed;
+}
+
+Plan MakePlan(bool want_cpu_jit, bool want_shader_jit, unsigned num_cores) {
+    std::lock_guard lock{g_mutex};
+    Plan plan{};
+    if (!g_installed || g_live != 0 || num_cores == 0) {
+        return plan;
+    }
+    constexpr std::size_t idle = 2 * MiB;  // > prelude + the 1 MiB dynarmic keeps free
+    constexpr std::size_t slack = 8 * MiB; // one extra small cache (e.g. an LLE applet)
+    std::size_t shader = want_shader_jit ? std::min(16 * MiB, g_capacity / 4 / MiB * MiB) : 0;
+    const auto app_for = [&](std::size_t shader_bytes) -> std::size_t {
+        const std::size_t fixed = shader_bytes + num_cores * idle + slack;
+        if (!want_cpu_jit || g_capacity <= fixed) {
+            return 0;
+        }
+        return std::min(32 * MiB, (g_capacity - fixed) / num_cores / MiB * MiB);
+    };
+    std::size_t app = app_for(shader);
+    if (want_cpu_jit && app < 8 * MiB && shader != 0 && app_for(0) >= 8 * MiB) {
+        shader = 0; // the CPU JIT matters more than the shader JIT
+        app = app_for(0);
+    }
+    plan.cpu_jit = app >= 8 * MiB;
+    plan.app_code_cache = plan.cpu_jit ? app : 0;
+    plan.idle_code_cache = plan.cpu_jit ? idle : 0;
+    plan.shader_jit = shader != 0;
+    plan.shader_bytes = shader;
+    g_cpu.Reset(0, g_capacity - shader);
+    g_shader.Reset(g_capacity - shader, g_capacity);
+    LOG_INFO(Frontend, "[rb-jit] arena={} cores={} cpu_jit={} app_cache={} idle_cache={} "
+             "shader_jit={} shader_bytes={}", g_capacity, num_cores, plan.cpu_jit,
+             plan.app_code_cache, plan.idle_code_cache, plan.shader_jit, plan.shader_bytes);
+    return plan;
+}
+
+void Shutdown() {
+    std::lock_guard lock{g_mutex};
+    if (g_live != 0) {
+        LOG_ERROR(Frontend, "[rb-jit] {} code blocks still alive at deinit", g_live);
+        return; // keep the allocator: those blocks will still be released into it
+    }
+    oaknut::g_external_code_allocator = nullptr;
+    g_installed = false;
+    g_abi = {};
+    g_rx = g_rw = 0;
+    g_capacity = 0;
+    g_cpu.Reset(0, 0);
+    g_shader.Reset(0, 0);
+}
+
+} // namespace RewindBoxJit
+
+extern "C" __attribute__((visibility("default"))) int rewindbox_libretro_jit_install(
+    const RewindBoxLibretroJitV1* abi) {
+    using namespace RewindBoxJit;
+    std::lock_guard lock{g_mutex};
+    if (g_live != 0) {
+        return -7; // a game is running on the current arena
+    }
+    oaknut::g_external_code_allocator = nullptr;
+    g_installed = false;
+    if (abi == nullptr) {
+        return 0;
+    }
+    if (abi->version != 1) {
+        return -2;
+    }
+    if (abi->structBytes < sizeof(RewindBoxLibretroJitV1)) {
+        return -3;
+    }
+    const std::uint64_t page = abi->pageBytes;
+    if (page < 4096 || page > MiB || (page & (page - 1)) != 0) {
+        return -4;
+    }
+    if (abi->capacity < kMinCapacity || abi->capacity % page != 0 || abi->capacity > 1024 * MiB) {
+        return -5;
+    }
+    if (abi->allocate == nullptr || abi->flush == nullptr) {
+        return -1;
+    }
+    std::uint64_t rx = 0;
+    std::uint64_t rw = 0;
+    if (abi->allocate(abi->capacity, &rx, &rw) != 0 || rx == 0 || rw == 0 || rx == rw ||
+        rx % page != 0 || rw % page != 0) {
+        return -6;
+    }
+    g_abi = *abi;
+    g_rx = static_cast<std::uintptr_t>(rx);
+    g_rw = static_cast<std::uintptr_t>(rw);
+    g_capacity = static_cast<std::size_t>(abi->capacity);
+    g_cpu.Reset(0, g_capacity);
+    g_shader.Reset(g_capacity, g_capacity);
+    g_installed = true;
+    oaknut::g_external_code_allocator = &kAllocator;
+    return 0;
+}
