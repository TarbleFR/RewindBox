diff --git a/desmume/src/arm_jit.h b/desmume/src/arm_jit.h
index 60f07adb..733b161a 100644
--- a/desmume/src/arm_jit.h
+++ b/desmume/src/arm_jit.h
@@ -79,4 +79,31 @@ extern uintptr_t compiled_funcs[];
 
 extern u32 saveBlockSizeJIT;
 
+#ifdef REWINDBOX_LIBRETRO_JIT
+// RewindBox: the executable arena the AArch64 JIT writes its code into (the libretro
+// frontend takes it from RewindBoxLibretroJit.h): written through rw, run at rx, the same
+// pages at two addresses, flush(rx, bytes) after each write. Without one there is no JIT.
+struct arm_jit_code_arena
+{
+	void *rx;
+	void *rw;
+	size_t bytes;
+	void (*flush)(void *rx, size_t bytes);
+};
+
+struct arm_jit_stats
+{
+	u64 blocks;      // blocks compiled into the arena
+	u64 failures;    // blocks left to the interpreter: no room in the arena or in memory
+	u64 interpreted; // addresses handed to the interpreter after 8 recompilations
+	u64 flushes;     // full arena emptied and rewound
+	size_t used;     // bytes in use
+	size_t capacity; // arena bytes
+};
+
+void arm_jit_set_code_arena(const arm_jit_code_arena *arena); // NULL: none
+bool arm_jit_has_code_arena();
+void arm_jit_get_stats(arm_jit_stats *stats);
+#endif
+
 #endif
