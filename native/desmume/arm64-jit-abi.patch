+// N:immr:imms of a logical immediate, or false when imm has none
+static inline bool logical_imm(u64 imm, bool is64, u32 *enc)
+{
+	if (!is64)
+	{
+		imm &= 0xFFFFFFFFull;
+		imm |= imm << 32;
+	}
+	if (imm == 0 || imm == ~0ull)
+		return false;
+	u32 size = 64;
+	while (size > 2)
+	{
+		const u32 half = size / 2;
+		const u64 m = (1ull << half) - 1;
+		if ((imm & m) != ((imm >> half) & m))
+			break;
+		size = half;
+	}
+	const u64 mask = size == 64 ? ~0ull : ((1ull << size) - 1);
+	const u64 elt = imm & mask;
+	u32 ones = 0;
+	for (u32 i = 0; i < size; i++)
+		ones += (elt >> i) & 1;
+	const u64 run = (1ull << ones) - 1; // ones < size here
+	u32 rot = 0;
+	for (; rot < size; rot++)
+	{
+		const u64 r = rot ? (((elt >> rot) | (elt << (size - rot))) & mask) : elt;
+		if (r == run)
+			break;
+	}
+	if (rot == size)
+		return false;
+	const u32 immr = (size - rot) & (size - 1);
+	const u32 imms = ((~(size - 1) << 1) | (ones - 1)) & 0x3F;
+	*enc = ((size == 64 ? 1u : 0u) << 12) | (immr << 6) | imms;
+	return true;
