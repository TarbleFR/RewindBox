+extern u16 jit_l1_page[2][0x4000];                  // page of each 16 KiB (JIT_PAGE_NONE: no code runs there)
+extern const u16 jit_region_first_page[JIT_REGION_COUNT];
+extern u8 *jit_page_codebits[];                     // a bit per 16 bytes holding compiled code (NULL: none)
+extern u32 jit_invalidate_sink;
+extern u32 jit_exit_request;                        // generated code leaves its block after a store when set
+#define JIT_EXIT_DMA 1                              // a store armed a DMA channel (cleared once hardware ran)
+#define JIT_EXIT_SMC 2                              // a store hit the running block (cleared before each block)
+#define JIT_EXIT_RESCHEDULE 4                       // NDS_Reschedule: the CPU loop must stop (cleared with it)
+#define JIT_EXIT_HALT 8                             // the bus froze or emulation stopped
+#define JIT_EXIT_WAIT9 16                           // the ARM9 waits for an IRQ
+#define JIT_EXIT_WAIT7 32                           // the ARM7 waits for an IRQ
+extern u32 *jit_current_slot[2];                    // table entry of the block each CPU runs
