+void jit_cached_get_stats(jit_cached_stats *stats);
+void jit_cached_clear();
+
+// RewindBox: the JIT of rb_jit.cpp ("jit_exact", "jit_fast"); "jit" runs the JIT of T (rb_jit_enabled false)
+extern bool rb_jit_enabled;
+extern bool rb_jit_exact;                           // exact mode: the interpreter's order of the two CPUs
+template<int PROCNUM> s32 rb_jit_run(s32 t, const s32 limit, const s32 next, const u64 base);
+u8 *jit_code_alloc(size_t bytes, u8 **rw);          // room in the arena (emptied first when full)
