+	      (this->_framebufferHeight * supersampling > GPU_FRAMEBUFFER_NATIVE_HEIGHT * 10)) )
+	{
+		supersampling = 1;
+	}
+	
+	free_aligned(this->_renderColorOwned);
+	this->_renderColorOwned = NULL;
+	
+	if (supersampling > 1)
+	{
+		const size_t pixCount = this->_framebufferPixCount * supersampling * supersampling;
+		this->_renderColorOwned = (FragmentColor *)malloc_alignedCacheLine(pixCount * sizeof(FragmentColor));
+		if (this->_renderColorOwned == NULL)
+		{
+			supersampling = 1;
+		}
+	}
+	
+	this->_supersampling = supersampling;
+	gSoftRasterizerActiveSupersampling = supersampling;
+	this->_renderWidth = this->_framebufferWidth * supersampling;
+	this->_renderHeight = this->_framebufferHeight * supersampling;
+	this->_renderPixCount = this->_renderWidth * this->_renderHeight;
+	this->_renderColor = (supersampling > 1) ? this->_renderColorOwned : this->_framebufferColor;
+	this->_supersampleResolved = true;
+	
+	delete this->_framebufferAttributes;
+	this->_framebufferAttributes = new FragmentAttributesBuffer(this->_renderPixCount);
+}
+
+// RewindBox: one output pixel from its four samples. Where the four alphas are equal (the whole picture
+// but the edges of the 3D against a transparent clear, and translucent polygons) it is their average.
+// Elsewhere the colour is averaged with the alphas as weights and the alpha averaged on its own: the edge
+// of a model takes the share of the pixel it covers when the 2D engine blends it, and is never darkened by
+// the colour of the transparent samples.
+static FORCEINLINE FragmentColor SoftRasterizer_ResolveQuad(const FragmentColor c0, const FragmentColor c1,
+                                                            const FragmentColor c2, const FragmentColor c3)
+{
+	FragmentColor out;
+	if ( (c0.a == c1.a) && (c1.a == c2.a) && (c2.a == c3.a) )
+	{
+		out.r = (u8)(((u32)c0.r + c1.r + c2.r + c3.r + 2) >> 2);
+		out.g = (u8)(((u32)c0.g + c1.g + c2.g + c3.g + 2) >> 2);
+		out.b = (u8)(((u32)c0.b + c1.b + c2.b + c3.b + 2) >> 2);
+		out.a = c0.a;
+		return out;
+	}
+	
+	const u32 a0 = c0.a, a1 = c1.a, a2 = c2.a, a3 = c3.a;
+	const u32 sum = a0 + a1 + a2 + a3; // not 0: the alphas differ
+	out.r = (u8)((a0 * c0.r + a1 * c1.r + a2 * c2.r + a3 * c3.r + (sum >> 1)) / sum);
+	out.g = (u8)((a0 * c0.g + a1 * c1.g + a2 * c2.g + a3 * c3.g + (sum >> 1)) / sum);
+	out.b = (u8)((a0 * c0.b + a1 * c1.b + a2 * c2.b + a3 * c3.b + (sum >> 1)) / sum);
+	out.a = (u8)((sum + 2) >> 2);
+	return out;
+}
+
+void SoftRasterizerRenderer::ResolveSupersamplingLines(const size_t startLine, const size_t endLine)
+{
+	const size_t w = this->_framebufferWidth;
+	const size_t rw = this->_renderWidth;
+	FragmentColor *__restrict out = this->_framebufferColor;
+	const FragmentColor *__restrict in = this->_renderColor;
+	
+	for (size_t y = startLine; y < endLine; y++)
+	{
+		const FragmentColor *__restrict row0 = in + (y * 2) * rw;
+		const FragmentColor *__restrict row1 = row0 + rw;
+		FragmentColor *__restrict dst = out + y * w;
+		for (size_t x = 0; x < w; x++)
+		{
+			dst[x] = SoftRasterizer_ResolveQuad(row0[x * 2], row0[x * 2 + 1], row1[x * 2], row1[x * 2 + 1]);
+		}
+	}
+}
+
+void SoftRasterizerRenderer::_ResolveSupersampling()
+{
+	if ( (this->_supersampling < 2) || this->_supersampleResolved )
+	{
+		return;
+	}
+	
+#ifdef REWINDBOX_PERF
+	const u64 rbPerfStart = rb_perf_now();
+#endif
+	const size_t h = this->_framebufferHeight;
+	if (this->_threadCount > 0)
+	{
+		const size_t lines = h / this->_threadCount;
+		for (size_t i = 0; i < this->_threadCount; i++)
+		{
+			this->_threadResolveParam[i].renderer = this;
+			this->_threadResolveParam[i].startLine = i * lines;
+			this->_threadResolveParam[i].endLine = (i < this->_threadCount - 1) ? (i + 1) * lines : h;
+			this->_task[i].execute(&SoftRasterizer_RunResolveSupersampling, &this->_threadResolveParam[i]);
+		}
+		for (size_t i = 0; i < this->_threadCount; i++)
+		{
+			this->_task[i].finish();
+		}
+	}
+	else
+	{
+		this->ResolveSupersamplingLines(0, h);
+	}
+	this->_supersampleResolved = true;
+#ifdef REWINDBOX_PERF
+	rb_perf_add_atomic(&rb_perf.resolve, rb_perf_now() - rbPerfStart);
+#endif
+}
+
+// RewindBox: eight bands of consecutive lines a thread, taken from the top: a thread on a faster core takes
+// more of them, the last one taken is short, and the upper bands are finished first, for the 2D engine
+// that composes the picture from its first line (RenderFinishLines). A band holds whole output lines.
+// Which thread draws a line does not change the picture: a pixel only depends on its own history.
+#define SOFTRASTERIZER_BANDS_PER_THREAD 8
+
+void SoftRasterizerRenderer::_UpdateSlices()
+{
+	const u32 wanted = (this->_threadCount > 0) ? (u32)std::min<size_t>(this->_threadCount * SOFTRASTERIZER_BANDS_PER_THREAD, SOFTRASTERIZER_MAX_BANDS) : 0;
+	if ( (wanted == this->_sliceWanted) && (this->_sliceTableHeight == this->_renderHeight) && (this->_sliceSupersampling == this->_supersampling) )
+	{
+		return;
+	}
+	
+	free(this->_sliceOfLine);
+	this->_sliceOfLine = NULL;
+	this->_sliceCount = 0;
+	this->_sliceWanted = wanted;
+	this->_sliceSupersampling = this->_supersampling;
+	this->_sliceTableHeight = this->_renderHeight;
+	if ( (wanted == 0) || (this->_renderHeight == 0) )
+	{
+		return;
+	}
+	
+	u8 *table = (u8 *)malloc(this->_renderHeight);
+	if (table == NULL)
+	{
+		return; // each thread then draws its band, as before
+	}
+	
+	const size_t ss = (this->_supersampling > 0) ? this->_supersampling : 1;
+	size_t bandLines = (this->_renderHeight + wanted - 1) / wanted;
+	bandLines = ((bandLines + ss - 1) / ss) * ss;
+	const u32 count = (u32)((this->_renderHeight + bandLines - 1) / bandLines);
+	for (size_t y = 0; y < this->_renderHeight; y++)
+	{
+		table[y] = (u8)(y / bandLines);
+	}
+	
+	this->_sliceOfLine = table;
+	this->_sliceCount = count;
+	this->_bandLines = bandLines;
+}
+
+void SoftRasterizerRenderer::_PrepareBands()
+{
+	this->_bandsReady = 0;
+	this->_bandsActive = (this->_sliceOfLine != NULL) && (this->_sliceCount > 0);
+	if (!this->_bandsActive)
+	{
+		return;
+	}
+	
+	this->_bandsNeedNeighbors = this->_enableEdgeMark;
+	SoftRasterizerPostProcessParams &param = this->_bandPostprocessParam;
+	param.renderer = this;
+	param.enableEdgeMarking = this->_enableEdgeMark;
+	param.enableFog = this->_enableFog;
+	param.fogColor = this->currentRenderState->fogColor;
+	param.fogAlphaOnly = this->currentRenderState->enableFogAlphaOnly;
+	
+	const u32 count = this->_sliceCount;
+	for (u32 b = 0; b < count; b++)
+	{
+		s32 pending = 1;
+		if (this->_bandsNeedNeighbors)
+		{
+			pending += (b > 0) ? 1 : 0;
+			pending += (b + 1 < count) ? 1 : 0;
+		}
+		this->_bandPending[b] = pending;
+		this->_bandDone[b] = 0;
+	}
+	this->_bandWaiting = 0;
+#ifdef REWINDBOX_PERF
+	this->_rbPerfBandsFinished = 0;
+	this->_rbPerfRenderStart = rb_perf_now();
+	rb_perf.bandRenders++;
+#endif
+}
+
+void SoftRasterizerRenderer::BandRastered(const u32 band)
+{
+	if (!this->_bandsActive)
+	{
+		return;
+	}
+	
+	const u32 first = (this->_bandsNeedNeighbors && (band > 0)) ? band - 1 : band;
+	const u32 last = (this->_bandsNeedNeighbors && (band + 1 < this->_sliceCount)) ? band + 1 : band;
+	for (u32 b = first; b <= last; b++)
+	{
+		// acquire-release: the thread that counts a band down to zero sees every drawing it waited for
+		if (__atomic_sub_fetch(&this->_bandPending[b], 1, __ATOMIC_ACQ_REL) == 0)
+		{
+			this->_FinishBand(b);
+		}
+	}
+}
+
+void SoftRasterizerRenderer::_FinishBand(const u32 band)
+{
+	const size_t startLine = (size_t)band * this->_bandLines;
+	const size_t endLine = std::min<size_t>(this->_renderHeight, startLine + this->_bandLines);
+	
+	if (this->_bandPostprocessParam.enableEdgeMarking || this->_bandPostprocessParam.enableFog)
+	{
+		SoftRasterizerPostProcessParams param = this->_bandPostprocessParam;
+		param.startLine = startLine;
+		param.endLine = endLine;
+		this->RenderEdgeMarkingAndFog(param);
+	}
+	
+	if (this->_supersampling > 1)
+	{
+#ifdef REWINDBOX_PERF
+		const u64 rbPerfStart = rb_perf_now();
+#endif
+		this->ResolveSupersamplingLines(startLine / this->_supersampling, endLine / this->_supersampling);
+#ifdef REWINDBOX_PERF
+		rb_perf_add_atomic(&rb_perf.resolve, rb_perf_now() - rbPerfStart);
+#endif
+	}
+	
+#ifdef REWINDBOX_PERF
+	// the band that completes the render (before its flag: RenderFinish then reads a whole render)
+	if ((u32)__atomic_add_fetch(&this->_rbPerfBandsFinished, 1, __ATOMIC_ACQ_REL) == this->_sliceCount)
+	{
+		rb_perf_add_atomic(&rb_perf.render3dWall, rb_perf_now() - this->_rbPerfRenderStart);
+	}
+#endif
+	__atomic_store_n(&this->_bandDone[band], 1, __ATOMIC_SEQ_CST);
+	if (__atomic_load_n(&this->_bandWaiting, __ATOMIC_SEQ_CST) != 0)
+	{
+		slock_lock(this->_bandLock);
+		scond_broadcast(this->_bandCond);
+		slock_unlock(this->_bandLock);
+	}
+}
+
+void SoftRasterizerRenderer::_WaitBand(const u32 band)
+{
+	if (__atomic_load_n(&this->_bandDone[band], __ATOMIC_ACQUIRE) != 0)
+	{
+		return;
+	}
+	
+#ifdef REWINDBOX_PERF
+	rb_perf.bandWaits++;
+#endif
+	// The waiting flag is set before the band is checked again, and a finishing thread sets the band before
+	// it reads the flag: one of the two always sees the other.
+	slock_lock(this->_bandLock);
+	__atomic_store_n(&this->_bandWaiting, 1, __ATOMIC_SEQ_CST);
+	while (__atomic_load_n(&this->_bandDone[band], __ATOMIC_SEQ_CST) == 0)
+	{
+		scond_wait(this->_bandCond, this->_bandLock);
+	}
+	__atomic_store_n(&this->_bandWaiting, 0, __ATOMIC_SEQ_CST);
+	slock_unlock(this->_bandLock);
+}
+
+bool SoftRasterizerRenderer::RenderFinishLines(const size_t outputLineEnd)
+{
+	if (!this->_renderNeedsFinish)
+	{
+		return true;
+	}
+	
+	if (!this->_renderGeometryNeedsFinish || !this->_bandsActive)
+	{
+		this->RenderFinish();
+		return true;
+	}
+	
+#ifdef REWINDBOX_PERF
+	const u64 rbPerfStart = rb_perf_now();
+#endif
+	const size_t renderLineEnd = outputLineEnd * this->_supersampling;
+	u32 needed = (u32)((renderLineEnd + this->_bandLines - 1) / this->_bandLines);
+	if (needed > this->_sliceCount)
+	{
+		needed = this->_sliceCount;
+	}
+	while (this->_bandsReady < needed)
+	{
+		this->_WaitBand(this->_bandsReady);
+		this->_bandsReady++;
+	}
+#ifdef REWINDBOX_PERF
+	rb_perf.wait3d += rb_perf_now() - rbPerfStart;
+#endif
+	
+	if (this->_bandsReady < this->_sliceCount)
+	{
+		return false;
+	}
+	
+	this->RenderFinish();
+	return true;
+}
+
+// RewindBox: the lines of one slice take the clear values (the frame's clear, when it was left to the
+// threads): the thread that draws them next still has them in its cache, and the emulation thread no
+// longer waits for a clear of the whole framebuffer before the drawing starts.
+void SoftRasterizerRenderer::ClearSliceIfPending(const u8 slice)
+{
+	if (!this->_clearInSlices)
+	{
+		return;
+	}
+	
+	const u8 *sliceOfLine = this->_sliceOfLine;
+	const size_t h = this->_sliceTableHeight;
+	const size_t w = this->_renderWidth;
+	for (size_t y = 0; y < h; )
+	{
+		if (sliceOfLine[y] != slice)
+		{
+			y++;
+			continue;
+		}
+		
+		const size_t first = y;
+		while ( (y < h) && (sliceOfLine[y] == slice) )
+		{
+			y++;
+		}
+		this->ClearUsingValues_Execute(first * w, y * w);
+	}
+}
+
+s32 SoftRasterizerRenderer::TakeSlice()
+{
+	const s32 slice = atomic_inc_32(&this->_sliceNext) - 1;
+	return (slice < (s32)this->_sliceCount) ? slice : -1;
+}
