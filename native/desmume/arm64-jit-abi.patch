+/*
+	RewindBox: the SSE2 instructions the 2D engines use (GPU.h, GPU.cpp and the colour conversion helpers
+	they call), written with AArch64 NEON, each with the exact result of its SSE2 counterpart for every input:
+	saturations, signed and unsigned comparisons, shift counts above the element size (zero), byte masks.
+	Only these 49 are defined; a 2D path that needs another one does not compile. types.h includes this
+	header for RB_GPU_SSE2_NEON; the rest of the core keeps its plain C++ paths on AArch64.
+*/
+#ifndef RB_SSE2NEON_H
+#define RB_SSE2NEON_H
+
+#if !defined(__aarch64__)
+	#error rb_sse2neon.h is for AArch64
+#endif
+
+#include <arm_neon.h>
+#include <stdint.h>
+
+typedef int64x2_t __m128i;
+
+#define RB_SSE2NEON_INLINE static inline __attribute__((always_inline))
+
+#define rb_u8(a)  vreinterpretq_u8_s64(a)
+#define rb_s8(a)  vreinterpretq_s8_s64(a)
+#define rb_u16(a) vreinterpretq_u16_s64(a)
+#define rb_s16(a) vreinterpretq_s16_s64(a)
+#define rb_u32(a) vreinterpretq_u32_s64(a)
+#define rb_s32(a) vreinterpretq_s32_s64(a)
+#define rb_m_u8(a)  vreinterpretq_s64_u8(a)
+#define rb_m_s8(a)  vreinterpretq_s64_s8(a)
+#define rb_m_u16(a) vreinterpretq_s64_u16(a)
+#define rb_m_s16(a) vreinterpretq_s64_s16(a)
+#define rb_m_u32(a) vreinterpretq_s64_u32(a)
+#define rb_m_s32(a) vreinterpretq_s64_s32(a)
+
+// ---- set, load, store
+
+RB_SSE2NEON_INLINE __m128i _mm_setzero_si128(void) { return vdupq_n_s64(0); }
+RB_SSE2NEON_INLINE __m128i _mm_set1_epi8(char a) { return rb_m_s8(vdupq_n_s8((int8_t)a)); }
+RB_SSE2NEON_INLINE __m128i _mm_set1_epi16(short a) { return rb_m_s16(vdupq_n_s16((int16_t)a)); }
+RB_SSE2NEON_INLINE __m128i _mm_set1_epi32(int a) { return rb_m_s32(vdupq_n_s32((int32_t)a)); }
+
+RB_SSE2NEON_INLINE __m128i _mm_set_epi16(short e7, short e6, short e5, short e4, short e3, short e2, short e1, short e0)
+{
+	const int16_t v[8] = { (int16_t)e0, (int16_t)e1, (int16_t)e2, (int16_t)e3, (int16_t)e4, (int16_t)e5, (int16_t)e6, (int16_t)e7 };
+	return rb_m_s16(vld1q_s16(v));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_set_epi32(int e3, int e2, int e1, int e0)
+{
+	const int32_t v[4] = { (int32_t)e0, (int32_t)e1, (int32_t)e2, (int32_t)e3 };
+	return rb_m_s32(vld1q_s32(v));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_setr_epi32(int e0, int e1, int e2, int e3)
+{
+	const int32_t v[4] = { (int32_t)e0, (int32_t)e1, (int32_t)e2, (int32_t)e3 };
+	return rb_m_s32(vld1q_s32(v));
+}
+
+// Unaligned loads and stores are fine for NEON: the aligned and unaligned forms are the same.
+RB_SSE2NEON_INLINE __m128i _mm_load_si128(const __m128i *p) { return rb_m_u8(vld1q_u8((const uint8_t *)p)); }
+RB_SSE2NEON_INLINE __m128i _mm_loadu_si128(const __m128i *p) { return rb_m_u8(vld1q_u8((const uint8_t *)p)); }
+RB_SSE2NEON_INLINE __m128i _mm_loadl_epi64(const __m128i *p)
+{
+	return rb_m_u8(vcombine_u8(vld1_u8((const uint8_t *)p), vdup_n_u8(0)));
+}
+
+RB_SSE2NEON_INLINE void _mm_store_si128(__m128i *p, __m128i a) { vst1q_u8((uint8_t *)p, rb_u8(a)); }
+RB_SSE2NEON_INLINE void _mm_storeu_si128(__m128i *p, __m128i a) { vst1q_u8((uint8_t *)p, rb_u8(a)); }
+RB_SSE2NEON_INLINE void _mm_stream_si128(__m128i *p, __m128i a) { vst1q_u8((uint8_t *)p, rb_u8(a)); }
+RB_SSE2NEON_INLINE void _mm_storel_epi64(__m128i *p, __m128i a) { vst1_u8((uint8_t *)p, vget_low_u8(rb_u8(a))); }
+
+// ---- bitwise
+
+RB_SSE2NEON_INLINE __m128i _mm_and_si128(__m128i a, __m128i b) { return rb_m_u8(vandq_u8(rb_u8(a), rb_u8(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_or_si128(__m128i a, __m128i b) { return rb_m_u8(vorrq_u8(rb_u8(a), rb_u8(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_xor_si128(__m128i a, __m128i b) { return rb_m_u8(veorq_u8(rb_u8(a), rb_u8(b))); }
+// (~a) & b
+RB_SSE2NEON_INLINE __m128i _mm_andnot_si128(__m128i a, __m128i b) { return rb_m_u8(vbicq_u8(rb_u8(b), rb_u8(a))); }
+
+// ---- arithmetic
+
+RB_SSE2NEON_INLINE __m128i _mm_add_epi16(__m128i a, __m128i b) { return rb_m_u16(vaddq_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_sub_epi8(__m128i a, __m128i b) { return rb_m_u8(vsubq_u8(rb_u8(a), rb_u8(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_sub_epi16(__m128i a, __m128i b) { return rb_m_u16(vsubq_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_adds_epu16(__m128i a, __m128i b) { return rb_m_u16(vqaddq_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_subs_epu16(__m128i a, __m128i b) { return rb_m_u16(vqsubq_u16(rb_u16(a), rb_u16(b))); }
+// the low 16 bits of each product
+RB_SSE2NEON_INLINE __m128i _mm_mullo_epi16(__m128i a, __m128i b) { return rb_m_u16(vmulq_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_min_epi16(__m128i a, __m128i b) { return rb_m_s16(vminq_s16(rb_s16(a), rb_s16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_min_epu8(__m128i a, __m128i b) { return rb_m_u8(vminq_u8(rb_u8(a), rb_u8(b))); }
+
+// ---- comparisons (all ones where true)
+
+RB_SSE2NEON_INLINE __m128i _mm_cmpeq_epi8(__m128i a, __m128i b) { return rb_m_u8(vceqq_u8(rb_u8(a), rb_u8(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_cmpeq_epi16(__m128i a, __m128i b) { return rb_m_u16(vceqq_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_cmpeq_epi32(__m128i a, __m128i b) { return rb_m_u32(vceqq_u32(rb_u32(a), rb_u32(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_cmpgt_epi16(__m128i a, __m128i b) { return rb_m_u16(vcgtq_s16(rb_s16(a), rb_s16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_cmplt_epi8(__m128i a, __m128i b) { return rb_m_u8(vcltq_s8(rb_s8(a), rb_s8(b))); }
+
+// ---- shifts: a count above the element size gives zero, as with SSE2. USHL takes the count from the low
+// byte of each element, signed (negative: right), so the count is clamped first.
+
+RB_SSE2NEON_INLINE __m128i _mm_slli_epi16(__m128i a, int count)
+{
+	const int16_t c = (int16_t)(((unsigned)count > 15u) ? 16 : count);
+	return rb_m_u16(vshlq_u16(rb_u16(a), vdupq_n_s16(c)));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_srli_epi16(__m128i a, int count)
+{
+	const int16_t c = (int16_t)(((unsigned)count > 15u) ? 16 : count);
+	return rb_m_u16(vshlq_u16(rb_u16(a), vdupq_n_s16((int16_t)-c)));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_slli_epi32(__m128i a, int count)
+{
+	const int32_t c = ((unsigned)count > 31u) ? 32 : count;
+	return rb_m_u32(vshlq_u32(rb_u32(a), vdupq_n_s32(c)));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_srli_epi32(__m128i a, int count)
+{
+	const int32_t c = ((unsigned)count > 31u) ? 32 : count;
+	return rb_m_u32(vshlq_u32(rb_u32(a), vdupq_n_s32(-c)));
+}
+
+// ---- packing with saturation
+
+RB_SSE2NEON_INLINE __m128i _mm_packs_epi16(__m128i a, __m128i b)
+{
+	return rb_m_s8(vcombine_s8(vqmovn_s16(rb_s16(a)), vqmovn_s16(rb_s16(b))));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_packus_epi16(__m128i a, __m128i b)
+{
+	return rb_m_u8(vcombine_u8(vqmovun_s16(rb_s16(a)), vqmovun_s16(rb_s16(b))));
+}
+
+RB_SSE2NEON_INLINE __m128i _mm_packs_epi32(__m128i a, __m128i b)
+{
+	return rb_m_s16(vcombine_s16(vqmovn_s32(rb_s32(a)), vqmovn_s32(rb_s32(b))));
+}
+
+// ---- interleaving
+
+RB_SSE2NEON_INLINE __m128i _mm_unpacklo_epi8(__m128i a, __m128i b) { return rb_m_u8(vzip1q_u8(rb_u8(a), rb_u8(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_unpackhi_epi8(__m128i a, __m128i b) { return rb_m_u8(vzip2q_u8(rb_u8(a), rb_u8(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_unpacklo_epi16(__m128i a, __m128i b) { return rb_m_u16(vzip1q_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_unpackhi_epi16(__m128i a, __m128i b) { return rb_m_u16(vzip2q_u16(rb_u16(a), rb_u16(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_unpacklo_epi32(__m128i a, __m128i b) { return rb_m_u32(vzip1q_u32(rb_u32(a), rb_u32(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_unpackhi_epi32(__m128i a, __m128i b) { return rb_m_u32(vzip2q_u32(rb_u32(a), rb_u32(b))); }
+RB_SSE2NEON_INLINE __m128i _mm_unpacklo_epi64(__m128i a, __m128i b) { return vzip1q_s64(a, b); }
+
+// ---- the most significant bit of each byte, byte 0 in bit 0
+
+RB_SSE2NEON_INLINE int _mm_movemask_epi8(__m128i a)
+{
+	static const int8_t position[16] = { 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7 };
+	const uint8x16_t bits = vshlq_u8(vshrq_n_u8(rb_u8(a), 7), vld1q_s8(position));
+	return (int)vaddv_u8(vget_low_u8(bits)) | ((int)vaddv_u8(vget_high_u8(bits)) << 8);
+}
+
+// ---- shuffles by an immediate (a constant expression at every use, as with SSE2)
+
+#define _mm_shuffle_epi32(a, imm) \
+	vreinterpretq_s64_s32(__builtin_shufflevector(vreinterpretq_s32_s64(a), vreinterpretq_s32_s64(a), \
+		((imm) >> 0) & 3, ((imm) >> 2) & 3, ((imm) >> 4) & 3, ((imm) >> 6) & 3))
+
+#define _mm_shufflelo_epi16(a, imm) \
+	vreinterpretq_s64_s16(__builtin_shufflevector(vreinterpretq_s16_s64(a), vreinterpretq_s16_s64(a), \
+		((imm) >> 0) & 3, ((imm) >> 2) & 3, ((imm) >> 4) & 3, ((imm) >> 6) & 3, 4, 5, 6, 7))
+
+#define _mm_shufflehi_epi16(a, imm) \
+	vreinterpretq_s64_s16(__builtin_shufflevector(vreinterpretq_s16_s64(a), vreinterpretq_s16_s64(a), \
+		0, 1, 2, 3, 4 + (((imm) >> 0) & 3), 4 + (((imm) >> 2) & 3), 4 + (((imm) >> 4) & 3), 4 + (((imm) >> 6) & 3)))
+
+#endif // RB_SSE2NEON_H
