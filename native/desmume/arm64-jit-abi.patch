+#ifndef RETRO_ENVIRONMENT_GET_JIT_CAPABLE
+#define RETRO_ENVIRONMENT_GET_JIT_CAPABLE 74
+#endif
+/* RewindBox's JIT interface (rewindbox/RewindBoxLibretroJit.h, copied from RewindBox by
+   the build). The host prepares the executable memory before it opens the core and hands
+   it over right after dlopen: the AArch64 JIT (utils/arm_jit) takes all of it at once and
+   writes its code there. Without it no code is generated and the interpreter runs,
+   whatever desmume_cpu_mode says. */
+#define REWINDBOX_JIT_MIN_BYTES (4u << 20)
+static const RewindBoxLibretroJitV1 *rewindbox_jit = NULL;
+static unsigned rewindbox_jit_frames = 0;
+
+static void rewindbox_jit_flush(void *rx, size_t bytes)
+{
+   if (rewindbox_jit && rx && bytes)
+      rewindbox_jit->flush((uint64_t)(uintptr_t)rx, (uint64_t)bytes);
+}
+
+extern "C" RETRO_API int rewindbox_libretro_jit_install(const RewindBoxLibretroJitV1 *jit)
+{
+   uint64_t rx = 0, rw = 0, bytes = 0;
+
+   /* A new open: what an earlier one installed went with it */
+   rewindbox_jit = NULL;
+   arm_jit_set_code_arena(NULL);
+
+   if (!jit || jit->version != REWINDBOX_LIBRETRO_JIT_VERSION ||
+       jit->structBytes != sizeof(*jit) ||
+       !jit->allocate || !jit->flush || !jit->available ||
+       !jit->pageBytes || (jit->pageBytes & (jit->pageBytes - 1)))
+      return -1;
+
+   /* All of the arena the host prepared (jitArenaBytes of the core's identity): it never
+      grows, and a full one is emptied and reused */
+   bytes = jit->available() & ~(jit->pageBytes - 1);
+   if (bytes < REWINDBOX_JIT_MIN_BYTES || jit->allocate(bytes, &rx, &rw) != 0 ||
+       !rx || !rw || ((rx | rw) & (jit->pageBytes - 1)))
+      return -1;
+
+   rewindbox_jit = jit;
+   arm_jit_code_arena arena = { (void *)(uintptr_t)rx, (void *)(uintptr_t)rw,
+                                (size_t)bytes, rewindbox_jit_flush };
+   arm_jit_set_code_arena(&arena);
+   return 0;
+}
+
+static void rewindbox_jit_log_stats(const char *when)
+{
+   arm_jit_stats stats;
+   if (!log_cb || !CommonSettings.use_jit)
+      return;
+   arm_jit_get_stats(&stats);
+   log_cb(RETRO_LOG_INFO, "[rb-jit] desmume %s jit=1 blocks=%llu used=%llu capacity=%llu "
+          "flushes=%llu interpreted=%llu failures=%llu\n", when,
+          (unsigned long long)stats.blocks, (unsigned long long)stats.used,
+          (unsigned long long)stats.capacity, (unsigned long long)stats.flushes,
+          (unsigned long long)stats.interpreted, (unsigned long long)stats.failures);
+}
