+/*
+	RewindBox: AArch64 JIT (steps 3 and 4 of docs/desmume-arm64-jit-architecture.md).
+
+	A block is a run of guest instructions compiled into the code arena. For each instruction the code does
+	what armcpu_exec does: the state the prefetch leaves (instruct_adr, next_instruction, R15, instruction),
+	the ARM condition (tested natively: CPSR and AArch64 share NZCV), the handler of the interpreter (step 3,
+	"call-threaded") or native code (step 4), then the timing of the fetch of the next instruction and
+	max(execute, fetch). Cycles are therefore the interpreter's.
+
+	Blocks chain: at its end a block looks up the table entry of the next address and branches there while
+	this CPU may go on (its time below the other CPU's and the next hardware event, no exit request), so
+	whole loops run without returning to C. In exact mode the same test, and the update of nds_timer, come
+	after every instruction: the CPU loop's order of the two CPUs is kept, and the emulated result is the
+	interpreter's. In fast mode they come only between blocks.
+
+	Registers inside generated code (callee-saved, set by the entry stub):
+	  x19 armcpu_t *      w20 time t           w21 limit (min(other CPU, next event))
+	  x22 RbRun *         x23 &jit_exit_request x24 table level 1 of this CPU (JIT.JIT_MEM[P])
+	  x25 code arena base x26 nds_timer base    x27 &nds_timer      x28 leave stub
+	x0-x17 are scratch (the handlers may clobber them); x18 is never touched (reserved by Apple).
+
+	Code is only compiled from the C dispatcher, never from generated code, so a full arena can be emptied
+	at once: no block is on the stack then.
+*/
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <algorithm>
+
+#include "../../types.h"
+#include "../../armcpu.h"
+#include "../../utils/bits.h"
+#include "../../instructions.h"
+#include "../../instruction_attributes.h"
+#include "../../MMU.h"
+#include "../../MMU_timing.h"
+#include "../../NDSSystem.h"
+#include "../../arm_jit.h"
+#include "rb_a64.h"
+
+#if defined(HAVE_JIT) && defined(REWINDBOX_LIBRETRO_JIT)
+
+using namespace rba64;
+
+bool rb_jit_enabled = false;  // "jit_exact" or "jit_fast": this JIT; "jit": the JIT of T (step 0)
+bool rb_jit_exact = true;     // exact mode (see above); false: fast mode
+static int rb_jit_timing = -1; // CommonSettings.advanced_timing the arena's code was compiled for
+#ifdef RB_JIT_DEBUG
+// test builds: RB_JIT_NOFOLD (every fetch through the helper), RB_JIT_NOMID (an entry per block only),
+// RB_JIT_NONATIVE (every instruction through its handler)
+#include <stdio.h>
+static int rb_dbg_nofold = -1, rb_dbg_nomid = -1, rb_dbg_nonative = -1;
+static void rb_dbg_init()
+{
+	if (rb_dbg_nofold >= 0)
+		return;
+	rb_dbg_nofold = getenv("RB_JIT_NOFOLD") != NULL;
+	rb_dbg_nomid = getenv("RB_JIT_NOMID") != NULL;
+	rb_dbg_nonative = getenv("RB_JIT_NONATIVE") != NULL;
+	fprintf(stderr, "rbdbg nofold=%d nomid=%d nonative=%d\n", rb_dbg_nofold, rb_dbg_nomid, rb_dbg_nonative);
+}
+#endif
+
+// The run, x22 in generated code
+struct RbRun
+{
+	armcpu_t *cpu;          // 0
+	u32 **l1;               // 8
+	u8 *code;               // 16
+	u64 base;               // 24
+	s32 limit;              // 32
+	s32 t;                  // 36
+	u64 leave;              // 40
+	u32 *fetch_last;        // 48  address of this CPU's last code fetch (MMU_timing)
+	const OpFunc *arm;      // 56  arm_instructions_set[P]
+	const OpFunc *thumb;    // 64  thumb_instructions_set[P]
+	u64 fetch_seq_arm;      // 72
+	u64 fetch_seq_thumb;    // 80
+	u64 fetch_branch;       // 88
+};
+enum { RUN_FETCH_LAST = 48, RUN_ARM = 56, RUN_THUMB = 64, RUN_SEQ_ARM = 72, RUN_SEQ_THUMB = 80, RUN_BRANCH = 88 };
+
+#define RB_STUB_ENTER 16   // arena offsets of the stubs (in the reserved start of the arena)
+#define RB_STUB_LEAVE 128
+#define RB_MAX_INSTR 100
+
+typedef void (*RbEnterFn)(u8 *code, RbRun *run);
+
+static const u32 O_IA = (u32)offsetof(armcpu_t, instruct_adr);
+static const u32 O_NI = (u32)offsetof(armcpu_t, next_instruction);
+static const u32 O_INS = (u32)offsetof(armcpu_t, instruction);
+static const u32 O_R15 = (u32)offsetof(armcpu_t, R) + 15 * 4;
+static const u32 O_CPSR = (u32)offsetof(armcpu_t, CPSR);
+static const u32 O_R0 = (u32)offsetof(armcpu_t, R);
+
+// ---------------------------------------------------------------------------- stubs
+
+// Written into the reserved start of a new arena: enter(code, run) saves the callee-saved registers,
+// loads the run and branches to the code; leave stores the time and returns to enter's caller.
+void rb_jit_write_stubs(u8 *rx, u8 *rw, void (*flush)(void *, size_t))
+{
+	Asm a;
+	a.stp_pre(FP, LR, SP, -96);
+	a.mov_sp(FP, SP);
+	a.stp(19, 20, SP, 16);
+	a.stp(21, 22, SP, 32);
+	a.stp(23, 24, SP, 48);
+	a.stp(25, 26, SP, 64);
+	a.stp(27, 28, SP, 80);
+	a.mov(22, 1, true);
+	a.ldrx(19, 22, 0);
+	a.ldrx(24, 22, 8);
+	a.ldrx(25, 22, 16);
+	a.ldrx(26, 22, 24);
+	a.ldrw(21, 22, 32);
+	a.ldrw(20, 22, 36);
+	a.ldrx(28, 22, 40);
+	a.mov64(23, (u64)(uintptr_t)&jit_exit_request);
+	a.mov64(27, (u64)(uintptr_t)&nds_timer);
+	a.br(0);
+	memcpy(rw + RB_STUB_ENTER, &a.code[0], a.code.size() * 4);
+	flush(rx + RB_STUB_ENTER, a.code.size() * 4);
+
+	Asm l;
+	l.strw(20, 22, 36);
+	l.ldp(27, 28, SP, 80);
+	l.ldp(25, 26, SP, 64);
+	l.ldp(23, 24, SP, 48);
+	l.ldp(21, 22, SP, 32);
+	l.ldp(19, 20, SP, 16);
+	l.ldp_post(FP, LR, SP, 96);
+	l.ret();
+	memcpy(rw + RB_STUB_LEAVE, &l.code[0], l.code.size() * 4);
+	flush(rx + RB_STUB_LEAVE, l.code.size() * 4);
+	rb_jit_timing = -1;
+}
+
+// ---------------------------------------------------------------------------- helpers called by blocks
+
+// Timing of the fetch of the next instruction when it follows the one just run, where the compiler
+// could not work it out (the ARM9's instruction cache, at the start of a new line)
+template<int PROCNUM, int THUMB>
+static u32 rb_fetch_seq(u32 execute, u32 adr)
+{
+	const u32 fetch = (THUMB && PROCNUM == 1) ? MMU_codeFetchCycles<1, 16>(adr) : MMU_codeFetchCycles<PROCNUM, 32>(adr);
+	return MMU_fetchExecuteCycles<PROCNUM>(execute, fetch);
+}
+
+// After a branch (or any change of next_instruction): the interpreter's prefetch, without the read of the
+// opcode (the next block, or the C dispatcher, sets it)
+template<int PROCNUM>
+static u32 rb_fetch_branch(u32 execute)
+{
+	armcpu_t *const cpu = &ARMPROC;
+	u32 cur = cpu->next_instruction;
+	u32 fetch;
+	if (cpu->CPSR.bits.T == 0)
+	{
+		cur &= 0xFFFFFFFC;
+		cpu->instruct_adr = cur;
+		cpu->next_instruction = cur + 4;
+		cpu->R[15] = cur + 8;
+		fetch = MMU_codeFetchCycles<PROCNUM, 32>(cur);
+	}
+	else
+	{
+		cur &= 0xFFFFFFFE;
+		cpu->instruct_adr = cur;
+		cpu->next_instruction = cur + 2;
+		cpu->R[15] = cur + 4;
+		fetch = PROCNUM == 0 ? MMU_codeFetchCycles<PROCNUM, 32>(cur) : MMU_codeFetchCycles<PROCNUM, 16>(cur);
+	}
+	return MMU_fetchExecuteCycles<PROCNUM>(execute, fetch);
+}
+
+// ---------------------------------------------------------------------------- compiler
+
+struct RbIns
+{
+	u32 pc;
+	u32 op;
+	bool ends;  // may change the PC (or the CPU state): last of its block
+	bool fused; // second half of a Thumb BL right after its first half: compiled with it, no entry of its own
+};
+
+static bool rb_ends_block(u32 opcode, bool thumb)
+{
+	if (thumb)
+	{
+		const u32 x = thumb_attributes[opcode >> 6];
+		return (x & BRANCH_ALWAYS) || ((x & BRANCH_POS0) && ((opcode & 7) | ((opcode >> 4) & 8)) == 15) ||
+		       (x & BRANCH_SWI) || (x & JIT_BYPASS);
+	}
+	const u32 x = instruction_attributes[INSTRUCTION_INDEX(opcode)];
+	return (x & BRANCH_ALWAYS) || ((x & BRANCH_POS12) && REG_POS(opcode, 12) == 15) ||
+	       ((x & BRANCH_LDM) && BIT15(opcode)) || (x & BRANCH_SWI) || (x & JIT_BYPASS);
+}
+
+static bool rb_bypass(u32 opcode, bool thumb)
+{
+	return thumb ? (thumb_attributes[opcode >> 6] & JIT_BYPASS) != 0
+	             : (instruction_attributes[INSTRUCTION_INDEX(opcode)] & JIT_BYPASS) != 0;
+}
+
+// TEST_COND for condition 0xF (ARMv5's unconditional instructions) does not depend on the flags
+static int rb_cond_nv(u32 opcode)
+{
+	const int first = (arm_cond_table[0x0F] >> CODE(opcode)) & 1;
+	for (u32 flags = 1; flags < 16; flags++)
+		if (((arm_cond_table[(flags << 4) | 0x0F] >> CODE(opcode)) & 1) != first)
+			return -1;
+	return first;
+}
+
+struct RbCompiler
+{
+	Asm a;
+	int procnum;
+	bool thumb;
+	bool exact;
+	bool timing;    // CommonSettings.advanced_timing: fetch cycles count
+	u32 size;
+	u32 tag;
+	u32 exit_mask;
+	int l_dyn;      // shared tail after a branch: exit checks, then lookup of instruct_adr
+	s64 pending;    // address of the last code fetch not yet written to MMU_timing (-1: none)
+
+	void add_time() { a.addr(20, 20, 0, LSL, procnum ? 1 : 0); }
+
+	void store_last(u32 v)
+	{
+		a.ldrx(1, 22, RUN_FETCH_LAST);
+		a.mov32(2, v);
+		a.strw(2, 1, 0);
+	}
+	void flush_last()
+	{
+		if (pending >= 0)
+			store_last((u32)pending);
+		pending = -1;
+	}
+
+	// leaves with instruct_adr = adr (the C dispatcher completes the interpreter's state from it)
+	void leave_at(u32 adr)
+	{
+		a.mov32(1, adr);
+		a.strw(1, 19, O_IA);
+		a.br(28);
+	}
+
+	void store_timer()
+	{
+		a.addx_ext(1, 26, 20, SXTW);
+		a.strx(1, 27, 0);
+	}
+
+	// goes on at adr, known now: through its table entry, or out to C
+	void chain_static(u32 adr)
+	{
+		flush_last();
+		const int l_out = a.label();
+		a.cmpr(20, 21);
+		a.bcond(GE, l_out);
+		store_timer();
+		a.mov32(1, ((adr & 0x0FFFC000) >> 14) * 8);
+		a.ldrx_r(1, 24, 1, false);
+		a.mov32(2, ((adr & 0x3FFE) >> 1) * 4);
+		a.ldrw_r(1, 1, 2, false);
+		if (tag)
+			a.eori(1, 1, tag, 2);
+		a.tsti(1, 3, 2);
+		a.bcond(NE, l_out);
+		a.cmpi(1, 8);
+		a.bcond(CC, l_out);
+		a.addx_ext(1, 25, 1, UXTW);
+		a.br(1);
+		a.bind(l_out);
+		leave_at(adr);
+	}
+
+	// after a branch: instruct_adr and the Thumb bit are only known now
+	void emit_dyn_tail()
+	{
+		const int l_out = a.label();
+		a.bind(l_dyn);
+		a.ldrw(1, 23, 0);
+		a.tsti(1, exit_mask, 2);
+		a.bcond(NE, l_out);
+		a.cmpr(20, 21);
+		a.bcond(GE, l_out);
+		store_timer();
+		a.ldrw(1, 19, O_IA);
+		a.ubfx(2, 1, 14, 14);
+		a.ldrx_r(3, 24, 2, true);
+		a.ubfx(2, 1, 1, 13);
+		a.ldrw_r(3, 3, 2, true);
+		a.ldrw(4, 19, O_CPSR);
+		a.ubfx(4, 4, 5, 1);
+		a.lsli(4, 4, 1);
+		if (procnum)
+			a.orri(4, 4, 1, 5);
+		a.eor(3, 3, 4);
+		a.tsti(3, 3, 5);
+		a.bcond(NE, l_out);
+		a.cmpi(3, 8);
+		a.bcond(CC, l_out);
+		a.addx_ext(3, 25, 3, UXTW);
+		a.br(3);
+		a.bind(l_out);
+		a.br(28); // instruct_adr is already the target
+	}
+
+	/*
+		Cycles of the fetch of npc right after the fetch of pc, when the compiler can tell them: everything
+		but a new line of the ARM9's instruction cache in main RAM. _MMU_accesstime has no side effect
+		outside that cache; the fetch unit's last address is written later (pending).
+	*/
+	bool fold_fetch(u32 pc, u32 npc, u32 *cycles, u32 *last)
+	{
+		const bool r32 = procnum == 0 || !thumb;
+		const u32 mask = r32 ? 0xFFFFFFFCu : 0xFFFFFFFEu;
+		const u32 adr = npc & mask, prev = pc & mask;
+		const bool sequential = adr == prev + (r32 ? 4 : 2);
+		*last = adr;
+		if (procnum == 0 && adr < 0x02000000)
+		{
+			*cycles = 1; // ITCM
+			return true;
+		}
+		if (procnum == 0 && (adr & 0x0F000000) == 0x02000000)
+		{
+			// a hit if the previous fetch (pc, in main RAM too) was in the same cache set
+			if ((prev & 0x0F000000) != 0x02000000 || (adr & 0x7E0) != (prev & 0x7E0))
+				return false;
+			*cycles = 1;
+			return true;
+		}
+		if (procnum == 0)
+			*cycles = _MMU_accesstime<0, MMU_AT_CODE, 32, MMU_AD_READ, true>(adr, sequential);
+		else if (r32)
+			*cycles = _MMU_accesstime<1, MMU_AT_CODE, 32, MMU_AD_READ, true>(adr, sequential);
+		else
+			*cycles = _MMU_accesstime<1, MMU_AT_CODE, 16, MMU_AD_READ, true>(adr, sequential);
+		return true;
+	}
+
+	// w0 = max(w0, c)
+	void max_imm(u32 c)
+	{
+		if (c <= 1)
+		{
+			a.cmpi(0, 1);
+			a.csinc(0, 0, ZR, CS); // w0 >= 1 ? w0 : 1
+			return;
+		}
+		a.mov32(1, c);
+		a.cmpr(0, 1);
+		a.csel(0, 0, 1, CS);
+	}
+
+	// ------------------------------------------------------------------ step 4: native code
+	//
+	// Instructions that only touch registers and flags, and branches whose target is known, become AArch64
+	// code doing what their handler does (read in arm_instructions.cpp and thumb_instructions.cpp), with the
+	// handler's cycles as a constant. The opcode must map to the handler of its class (the same table entry
+	// as a canonical opcode of the class), or the handler is called as in step 3. Guest registers are read
+	// from and written to armcpu_t at each instruction: any instruction can be entered from outside.
+
+	static u32 ror32(u32 v, u32 s) { return s ? (v >> s) | (v << (32 - s)) : v; }
+
+	bool same_handler(u32 op, u32 canon) const
+	{
+		if (thumb)
+			return thumb_instructions_set[procnum][op >> 6] == thumb_instructions_set[procnum][canon >> 6];
+		return arm_instructions_set[procnum][INSTRUCTION_INDEX(op)] == arm_instructions_set[procnum][INSTRUCTION_INDEX(canon)];
+	}
+
+	// guest register n into wd (R15 reads as the interpreter's R15: pc + 8, or pc + 4 in Thumb)
+	void get_reg(int wd, u32 n, u32 pc)
+	{
+		if (n == 15)
+			a.mov32(wd, pc + (thumb ? 4 : 8));
+		else
+			a.ldrw(wd, 19, O_R0 + 4 * n);
+	}
+	void set_reg(int ws, u32 n) { a.strw(ws, 19, O_R0 + 4 * n); }
+
+	// host C = guest C (for ADC, SBC, RSC)
+	void load_carry()
+	{
+		a.ldrw(9, 19, O_CPSR);
+		a.andi(9, 9, 0xF0000000u, 10);
+		a.msr_nzcv(9);
+	}
+	// CPSR's N, Z, C, V from the host flags (arithmetic)
+	void flags_nzcv()
+	{
+		a.mrs_nzcv(9);
+		a.ldrw(10, 19, O_CPSR);
+		a.bfm(9, 10, 0, 27); // CPSR bits 0-27 under the host's N, Z, C, V
+		a.strw(9, 19, O_CPSR);
+	}
+	// CPSR's N and Z from the host flags; C: -1 unchanged, 0 or 1, 2 = bit 0 of w3; V unchanged
+	void flags_nz(int carry)
+	{
+		a.mrs_nzcv(9);
+		a.ldrw(10, 19, O_CPSR);
+		a.bfm(9, 10, 0, 29); // CPSR bits 0-29 (C and V among them) under the host's N and Z
+		if (carry == 0)
+			a.andi(9, 9, ~0x20000000u, 10);
+		else if (carry == 1)
+			a.orri(9, 9, 0x20000000u, 10);
+		else if (carry == 2)
+			a.bfi(9, 3, 29, 1);
+		a.strw(9, 19, O_CPSR);
+	}
+	void test_w0() { a.logr(3, false, ZR, 0, 0); } // tst w0, w0
+
+	void add_time_imm(u32 c)
+	{
+		const u32 v = procnum ? c * 2 : c;
+		a.addi(20, 20, v);
+	}
+
+	// After an instruction run natively with `e` execute cycles, going on with the next one
+	void native_tail(const RbIns &in, u32 e, bool last)
+	{
+		const u32 npc = in.pc + size;
+		u32 fc, flast;
+		if (!timing)
+			add_time_imm(e);
+#ifdef RB_JIT_DEBUG
+		else if (!rb_dbg_nofold && fold_fetch(in.pc, npc, &fc, &flast))
+#else
+		else if (fold_fetch(in.pc, npc, &fc, &flast))
+#endif
+		{
+			add_time_imm(std::max(e, fc));
+			pending = flast;
+		}
+		else
+		{
+			flush_last();
+			a.movz(0, e, 0, false);
+			a.mov32(1, npc);
+			a.ldrx(16, 22, thumb ? RUN_SEQ_THUMB : RUN_SEQ_ARM);
+			a.blr(16);
+			add_time();
+		}
+		if (last)
+		{
+			chain_static(npc);
+			return;
+		}
+		if (exact)
+		{
+			const int l_cont = a.label();
+			a.cmpr(20, 21);
+			a.bcond(LT, l_cont);
+			if (pending >= 0)
+				store_last((u32)pending);
+			leave_at(npc);
+			a.bind(l_cont);
+		}
+	}
+
+	// A branch to `target`, known now, with `e` execute cycles: the fetch there, then the block there
+	void branch_tail(u32 pc, u32 target, u32 e)
+	{
+		u32 fc, flast;
+		if (!timing)
+			add_time_imm(e);
+#ifdef RB_JIT_DEBUG
+		else if (!rb_dbg_nofold && fold_fetch(pc, target, &fc, &flast))
+#else
+		else if (fold_fetch(pc, target, &fc, &flast))
+#endif
+		{
+			add_time_imm(std::max(e, fc));
+			pending = flast;
+		}
+		else
+		{
+			flush_last();
+			a.movz(0, e, 0, false);
+			a.mov32(1, target);
+			a.ldrx(16, 22, thumb ? RUN_SEQ_THUMB : RUN_SEQ_ARM);
+			a.blr(16);
+			add_time();
+		}
+		chain_static(target);
+	}
+
+	// conditional code: host flags from CPSR, then a branch to l when the condition fails
+	void skip_unless(u32 cond, int l)
+	{
+		a.ldrw(9, 19, O_CPSR);
+		a.andi(9, 9, 0xF0000000u, 10);
+		a.msr_nzcv(9);
+		a.bcond((Cond)(cond ^ 1), l);
+	}
+
+	// ARM data processing with an immediate, or a register shifted by an immediate; Rd != PC
+	bool native_arm_dp(const RbIns &in, bool last)
+	{
+		const u32 i = in.op;
+		if ((i >> 26) & 3)
+			return false;
+		const u32 imm = (i >> 25) & 1, op = (i >> 21) & 0xF, S = (i >> 20) & 1;
+		const u32 Rn = (i >> 16) & 0xF, Rd = (i >> 12) & 0xF;
+		const bool test = op >= 8 && op <= 11;
+		const u32 cond = CONDITION(i);
+		if ((test && !S) || (!imm && (i & 0x10)) || (!test && Rd == 15) || cond == 0xF)
+			return false;
+		const u32 canon = 0xE0000000u | (imm << 25) | (op << 21) | (S << 20) | (imm ? 0 : (((i >> 5) & 3) << 5));
+		if (!same_handler(i, canon))
+			return false;
+
+		const bool logical = op == 0 || op == 1 || (op >= 8 && op <= 9) || op >= 12;
+		const bool want_carry = S && logical;
+		int l_skip = -1;
+		if (cond != 0xE)
+		{
+			l_skip = a.label();
+			skip_unless(cond, l_skip);
+		}
+
+		// operand 2 into w2, and the shifter's carry (-1: CPSR's)
+		int carry = -1;
+		if (imm)
+		{
+			const u32 rot = ((i >> 8) & 0xF) * 2;
+			const u32 val = ror32(i & 0xFF, rot);
+			a.mov32(2, val);
+			if (rot)
+				carry = (int)(val >> 31);
+		}
+		else
+		{
+			const u32 Rm = i & 0xF, sh = (i >> 5) & 3, amt = (i >> 7) & 0x1F;
+			get_reg(4, Rm, in.pc);
+			switch (sh)
+			{
+			case 0: // LSL
+				if (amt == 0)
+					a.mov(2, 4);
+				else
+				{
+					a.lsli(2, 4, amt);
+					if (want_carry) { a.ubfx(3, 4, 32 - amt, 1); carry = 2; }
+				}
+				break;
+			case 1: // LSR (#0: #32)
+				if (amt == 0)
+				{
+					a.movz(2, 0, 0, false);
+					if (want_carry) { a.lsri(3, 4, 31); carry = 2; }
+				}
+				else
+				{
+					a.lsri(2, 4, amt);
+					if (want_carry) { a.ubfx(3, 4, amt - 1, 1); carry = 2; }
+				}
+				break;
+			case 2: // ASR (#0: #32)
+				if (amt == 0)
+				{
+					a.asri(2, 4, 31);
+					if (want_carry) { a.lsri(3, 4, 31); carry = 2; }
+				}
+				else
+				{
+					a.asri(2, 4, amt);
+					if (want_carry) { a.ubfx(3, 4, amt - 1, 1); carry = 2; }
+				}
+				break;
+			default: // ROR (#0: RRX)
+				if (amt == 0)
+				{
+					a.ldrw(5, 19, O_CPSR);
+					a.ubfx(5, 5, 29, 1);
+					a.lsri(2, 4, 1);
+					a.logr(1, false, 2, 2, 5, LSL, 31); // orr w2, w2, w5, lsl #31
+					if (want_carry) { a.andi(3, 4, 1, 6); carry = 2; }
+				}
+				else
+				{
+					a.rori(2, 4, amt);
+					if (want_carry) { a.ubfx(3, 4, amt - 1, 1); carry = 2; }
+				}
+				break;
+			}
+		}
+		if (op != 13 && op != 15)
+			get_reg(1, Rn, in.pc);
+
+		const bool s = S != 0;
+		switch (op)
+		{
+		case 0: a.logr(s ? 3 : 0, false, 0, 1, 2); break;            // AND(S)
+		case 1: a.eor(0, 1, 2); if (s) test_w0(); break;             // EOR(S)
+		case 2: a.subr(0, 1, 2, LSL, 0, false, s); break;            // SUB(S)
+		case 3: a.subr(0, 2, 1, LSL, 0, false, s); break;            // RSB(S)
+		case 4: a.addr(0, 1, 2, LSL, 0, false, s); break;            // ADD(S)
+		case 5: load_carry(); a.adc(0, 1, 2, s); break;              // ADC(S)
+		case 6: load_carry(); a.sbc(0, 1, 2, s); break;              // SBC(S)
+		case 7: load_carry(); a.sbc(0, 2, 1, s); break;              // RSC(S)
+		case 8: a.logr(3, false, ZR, 1, 2); break;                   // TST
+		case 9: a.eor(0, 1, 2); test_w0(); break;                    // TEQ
+		case 10: a.subr(ZR, 1, 2, LSL, 0, false, true); break;       // CMP
+		case 11: a.addr(ZR, 1, 2, LSL, 0, false, true); break;       // CMN
+		case 12: a.orr(0, 1, 2); if (s) test_w0(); break;            // ORR(S)
+		case 13: a.mov(0, 2); if (s) test_w0(); break;               // MOV(S)
+		case 14: a.logr(s ? 3 : 0, true, 0, 1, 2); break;            // BIC(S)
+		default: a.logr(1, true, 0, ZR, 2); if (s) test_w0(); break; // MVN(S)
+		}
+		if (!test)
+			set_reg(0, Rd);
+		if (s)
+		{
+			if (logical)
+				flags_nz(carry);
+			else
+				flags_nzcv();
+		}
+		if (l_skip >= 0)
+			a.bind(l_skip);
+		native_tail(in, 1, last); // 1 cycle whether the condition held or not
+		return true;
+	}
+
+	// ARM B and BL (not BLX): the target is known
+	bool native_arm_branch(const RbIns &in)
+	{
+		const u32 i = in.op;
+		const u32 cond = CONDITION(i);
+		if (((i >> 25) & 7) != 5 || cond == 0xF)
+			return false;
+		const bool link = (i >> 24) & 1;
+		if (!same_handler(i, link ? 0xEB000000u : 0xEA000000u))
+			return false;
+		// B after "mov r12, r12" may print a no$gba message: left to the handler
+		if (!link)
+		{
+			const u32 last = procnum ? _MMU_read32<1, MMU_AT_DEBUG>(in.pc - 4) : _MMU_read32<0, MMU_AT_DEBUG>(in.pc - 4);
+			if (last == 0xE1A0C00Cu)
+				return false;
+		}
+		const u32 target = (in.pc + 8 + ((u32)((s32)(i << 8) >> 8) << 2)) & 0xFFFFFFFCu;
+		int l_nt = -1;
+		const s64 saved = pending;
+		if (cond != 0xE)
+		{
+			l_nt = a.label();
+			skip_unless(cond, l_nt);
+		}
+		if (link)
+		{
+			a.mov32(1, in.pc + 4);
+			set_reg(1, 14);
+		}
+		branch_tail(in.pc, target, 3);
+		if (l_nt >= 0)
+		{
+			a.bind(l_nt);
+			pending = saved;
+			native_tail(in, 1, true);
+		}
+		return true;
+	}
+
+	bool native_thumb(const RbIns &in, const RbIns *prev, bool last)
+	{
+		const u32 i = in.op;
+		const u32 pc = in.pc;
+		const u32 top5 = i >> 11;
+
+		if (top5 <= 2) // LSL, LSR, ASR #imm
+		{
+			const u32 Rd = i & 7, Rm = (i >> 3) & 7, amt = (i >> 6) & 0x1F;
+			if (!same_handler(i, (top5 << 11) | (amt ? 0x40 : 0)))
+				return false;
+			get_reg(4, Rm, pc);
+			int carry = 2;
+			if (top5 == 0)
+			{
+				if (amt == 0) { a.mov(0, 4); carry = -1; }
+				else { a.lsli(0, 4, amt); a.ubfx(3, 4, 32 - amt, 1); }
+			}
+			else if (top5 == 1)
+			{
+				if (amt == 0) { a.movz(0, 0, 0, false); a.lsri(3, 4, 31); }
+				else { a.lsri(0, 4, amt); a.ubfx(3, 4, amt - 1, 1); }
+			}
+			else
+			{
+				if (amt == 0) { a.asri(0, 4, 31); a.lsri(3, 4, 31); }
+				else { a.asri(0, 4, amt); a.ubfx(3, 4, amt - 1, 1); }
+			}
+			set_reg(0, Rd);
+			test_w0();
+			flags_nz(carry);
+			native_tail(in, 1, last);
+			return true;
+		}
+		if (top5 == 3) // ADD, SUB: register or 3-bit immediate
+		{
+			const u32 Rd = i & 7, Rn = (i >> 3) & 7, sub = (i >> 9) & 1, isimm = (i >> 10) & 1, v = (i >> 6) & 7;
+			if (!same_handler(i, 0x1800 | (isimm << 10) | (sub << 9)))
+				return false;
+			get_reg(1, Rn, pc);
+			if (isimm)
+				a.mov32(2, v);
+			else
+				get_reg(2, v, pc);
+			if (sub)
+				a.subr(0, 1, 2, LSL, 0, false, true);
+			else
+				a.addr(0, 1, 2, LSL, 0, false, true);
+			set_reg(0, Rd);
+			flags_nzcv();
+			native_tail(in, 1, last);
+			return true;
+		}
+		if (top5 >= 4 && top5 <= 7) // MOV, CMP, ADD, SUB #imm8
+		{
+			const u32 op = top5 - 4, Rd = (i >> 8) & 7, imm8 = i & 0xFF;
+			if (!same_handler(i, top5 << 11))
+				return false;
+			if (op == 0)
+			{
+				a.mov32(0, imm8);
+				set_reg(0, Rd);
+				// N = 0, Z = (imm8 == 0); C and V unchanged
+				a.ldrw(9, 19, O_CPSR);
+				a.andi(9, 9, 0x3FFFFFFFu, 10);
+				if (imm8 == 0)
+					a.orri(9, 9, 0x40000000u, 10);
+				a.strw(9, 19, O_CPSR);
+			}
+			else
+			{
+				get_reg(1, Rd, pc);
+				a.mov32(2, imm8);
+				if (op == 1)
+					a.subr(ZR, 1, 2, LSL, 0, false, true);
+				else if (op == 2)
+					a.addr(0, 1, 2, LSL, 0, false, true);
+				else
+					a.subr(0, 1, 2, LSL, 0, false, true);
+				if (op != 1)
+					set_reg(0, Rd);
+				flags_nzcv();
+			}
+			native_tail(in, 1, last);
+			return true;
+		}
+		if ((i >> 10) == 0x10) // ALU operations
+		{
+			const u32 op = (i >> 6) & 0xF, Rd = i & 7, Rm = (i >> 3) & 7;
+			if (op == 2 || op == 3 || op == 4 || op == 7 || op == 13) // shifts by register, MUL
+				return false;
+			if (!same_handler(i, 0x4000 | (op << 6)))
+				return false;
+			get_reg(1, Rd, pc);
+			get_reg(2, Rm, pc);
+			bool store = true, arith = false;
+			switch (op)
+			{
+			case 0: a.logr(3, false, 0, 1, 2); break;                         // AND
+			case 1: a.eor(0, 1, 2); test_w0(); break;                         // EOR
+			case 5: load_carry(); a.adc(0, 1, 2, true); arith = true; break;  // ADC
+			case 6: load_carry(); a.sbc(0, 1, 2, true); arith = true; break;  // SBC
+			case 8: a.logr(3, false, ZR, 1, 2); store = false; break;         // TST
+			case 9: a.subr(0, ZR, 2, LSL, 0, false, true); arith = true; break; // NEG
+			case 10: a.subr(ZR, 1, 2, LSL, 0, false, true); store = false; arith = true; break; // CMP
+			case 11: a.addr(ZR, 1, 2, LSL, 0, false, true); store = false; arith = true; break; // CMN
+			case 12: a.orr(0, 1, 2); test_w0(); break;                        // ORR
+			case 14: a.logr(3, true, 0, 1, 2); break;                         // BIC
+			default: a.logr(1, true, 0, ZR, 2); test_w0(); break;             // MVN
+			}
+			if (store)
+				set_reg(0, Rd);
+			if (arith)
+				flags_nzcv();
+			else
+				flags_nz(-1);
+			native_tail(in, 1, last);
+			return true;
+		}
+		if ((i >> 10) == 0x11) // ADD, CMP, MOV with high registers (BX left to the handler)
+		{
+			const u32 op = (i >> 8) & 3, Rd = (i & 7) | ((i >> 4) & 8), Rm = (i >> 3) & 0xF;
+			if (op == 3 || (op != 1 && Rd == 15))
+				return false;
+			if (!same_handler(i, 0x4400 | (op << 8) | (i & 0xC0)))
+				return false;
+			get_reg(2, Rm, pc);
+			if (op == 0)
+			{
+				get_reg(1, Rd, pc);
+				a.addr(0, 1, 2);
+				set_reg(0, Rd);
+			}
+			else if (op == 1)
+			{
+				get_reg(1, Rd, pc);
+				a.subr(ZR, 1, 2, LSL, 0, false, true);
+				flags_nzcv();
+			}
+			else
+				set_reg(2, Rd);
+			native_tail(in, 1, last);
+			return true;
+		}
+		if ((i >> 12) == 0xA) // ADD Rd, PC or SP, #imm8 * 4
+		{
+			const u32 sp = (i >> 11) & 1, Rd = (i >> 8) & 7, off = (i & 0xFF) << 2;
+			if (!same_handler(i, 0xA000 | (sp << 11)))
+				return false;
+			if (sp)
+			{
+				get_reg(1, 13, pc);
+				a.mov32(2, off);
+				a.addr(0, 1, 2);
+			}
+			else
+				a.mov32(0, ((pc + 4) & 0xFFFFFFFCu) + off);
+			set_reg(0, Rd);
+			native_tail(in, 1, last);
+			return true;
+		}
+		if ((i >> 8) == 0xB0) // ADD SP, #imm7 * 4 / SUB SP, #imm7 * 4
+		{
+			const u32 neg = (i >> 7) & 1, off = (i & 0x7F) << 2;
+			if (!same_handler(i, 0xB000 | (neg << 7)))
+				return false;
+			get_reg(1, 13, pc);
+			a.mov32(2, off);
+			if (neg)
+				a.subr(0, 1, 2);
+			else
+				a.addr(0, 1, 2);
+			set_reg(0, 13);
+			native_tail(in, 1, last);
+			return true;
+		}
+		if ((i >> 12) == 0xD && ((i >> 8) & 0xF) < 14) // B<cond>
+		{
+			const u32 cond = (i >> 8) & 0xF;
+			if (!same_handler(i, 0xD000 | (cond << 8)))
+				return false;
+			const u32 target = pc + 4 + ((u32)(s32)(s8)(i & 0xFF) << 1);
+			const int l_nt = a.label();
+			const s64 saved = pending;
+			skip_unless(cond, l_nt);
+			branch_tail(pc, target, 3);
+			a.bind(l_nt);
+			pending = saved;
+			native_tail(in, 1, true);
+			return true;
+		}
+		if (top5 == 0x1C) // B
+		{
+			if (!same_handler(i, 0xE000))
+				return false;
+			// no$gba message: "mov r12, r12" before, 0x6464 after
+			const u32 before = procnum ? _MMU_read16<1, MMU_AT_DEBUG>(pc - 2) : _MMU_read16<0, MMU_AT_DEBUG>(pc - 2);
+			if (before == 0x46E4)
+				return false;
+			const u32 target = pc + 4 + ((u32)((s32)(i << 21) >> 21) << 1);
+			branch_tail(pc, target, 1);
+			return true;
+		}
+		if (top5 == 0x1E) // BL, first half: LR = PC + (offset << 12)
+		{
+			if (!same_handler(i, 0xF000))
+				return false;
+			a.mov32(1, pc + 4 + ((u32)((s32)(i << 21) >> 21) << 12));
+			set_reg(1, 14);
+			native_tail(in, 1, last);
+			return true;
+		}
+		if (top5 == 0x1F) // BL, second half
+		{
+			if (!same_handler(i, 0xF800))
+				return false;
+			a.mov32(1, (pc + 2) | 1);
+			if (prev && (prev->op >> 11) == 0x1E && prev->pc + 2 == pc)
+			{
+				// right after its first half in this block (no entry here): the target is known
+				const u32 lr = prev->pc + 4 + ((u32)((s32)(prev->op << 21) >> 21) << 12);
+				set_reg(1, 14);
+				branch_tail(pc, lr + ((i & 0x7FF) << 1), 4);
+				return true;
+			}
+			get_reg(2, 14, pc);
+			a.addi(2, 2, (i & 0x7FF) << 1);
+			a.strw(2, 19, O_NI);
+			set_reg(1, 14);
+			if (pending >= 0)
+				store_last((u32)pending);
+			a.movz(0, 4, 0, false);
+			a.ldrx(16, 22, RUN_BRANCH);
+			a.blr(16);
+			add_time();
+			a.b(l_dyn);
+			return true;
+		}
+		return false;
+	}
+
+	bool emit_native(const RbIns &in, const RbIns *prev, bool last)
+	{
+#ifdef RB_JIT_DEBUG
+		if (rb_dbg_nonative)
+			return false;
+#endif
+		if (thumb)
+			return native_thumb(in, prev, last);
+		return native_arm_dp(in, last) || native_arm_branch(in);
+	}
+
+	// the handler of the interpreter (step 3); w0 = execute cycles. Returns false if the instruction
+	// cannot be compiled.
+	bool emit_call(const RbIns &in)
+	{
+		const u32 cond = thumb ? 0xE : CONDITION(in.op);
+		bool always = cond == 0xE;
+		if (cond == 0xF)
+		{
+			const int nv = rb_cond_nv(in.op);
+			if (nv < 0)
+				return false;
+			if (!nv)
+			{
+				a.movz(0, 1, 0, false);
+				return true;
+			}
+			always = true;
+		}
+		const int l_skip = a.label(), l_done = a.label();
+		if (!always)
+		{
+			a.ldrw(1, 19, O_CPSR);
+			a.andi(1, 1, 0xF0000000u, 2); // N, Z, C, V: the same bits in CPSR and in NZCV
+			a.msr_nzcv(1);
+			a.bcond((Cond)(cond ^ 1), l_skip);
+		}
+		a.ldrx(16, 22, thumb ? RUN_THUMB : RUN_ARM);
+		a.ldrx(16, 16, (thumb ? (in.op >> 6) : INSTRUCTION_INDEX(in.op)) * 8);
+		a.mov32(0, in.op);
+		a.blr(16);
+		if (!always)
+		{
+			a.b(l_done);
+			a.bind(l_skip);
+			a.movz(0, 1, 0, false); // condition false: 1 cycle
+			a.bind(l_done);
+		}
+		return true;
+	}
+
+	bool emit_ins(const RbIns &in, const RbIns *prev, bool last)
+	{
+		if (emit_native(in, prev, last))
+			return true;
+		const u32 npc = in.pc + size;
+		// the state the interpreter's prefetch left before this instruction (the opcode itself is only read
+		// by the handlers of undefined instructions); in exact mode, nds_timer as the CPU loop sets it
+		if (exact)
+			store_timer();
+		a.mov32(0, in.pc);
+		a.strw(0, 19, O_IA);
+		a.addi(1, 0, size);
+		a.strw(1, 19, O_NI);
+		a.addi(1, 0, size * 2);
+		a.strw(1, 19, O_R15);
+		if (rb_bypass(in.op, thumb))
+		{
+			a.mov32(1, in.op);
+			a.strw(1, 19, O_INS);
+		}
+
+		if (!emit_call(in))
+			return false;
+
+		// next instruction: the following one, or a branch. An instruction that may branch always takes the
+		// branch path, which reads the Thumb bit too (BX to the next address may change it).
+		const int l_branch = a.label();
+		const s64 before = pending;
+		if (in.ends)
+		{
+			if (before >= 0)
+				store_last((u32)before);
+			a.ldrx(16, 22, RUN_BRANCH);
+			a.blr(16);
+			add_time();
+			a.b(l_dyn);
+			return true;
+		}
+		a.ldrw(1, 19, O_NI);
+		a.mov32(2, npc);
+		a.cmpr(1, 2);
+		a.bcond(NE, l_branch);
+		u32 fc, flast;
+		if (!timing)
+			add_time(); // without advanced timing the fetch costs nothing and is not recorded
+#ifdef RB_JIT_DEBUG
+		else if (!rb_dbg_nofold && fold_fetch(in.pc, npc, &fc, &flast))
+#else
+		else if (fold_fetch(in.pc, npc, &fc, &flast))
+#endif
+		{
+			max_imm(fc);
+			add_time();
+			pending = flast;
+		}
+		else
+		{
+			flush_last(); // (uses w1 and w2)
+			a.mov32(1, npc);
+			a.ldrx(16, 22, thumb ? RUN_SEQ_THUMB : RUN_SEQ_ARM);
+			a.blr(16);
+			add_time();
+		}
+
+		// exit requests, and in exact mode the CPU loop's test before the next instruction
+		const int l_cont = a.label(), l_exit = a.label();
+		a.ldrw(1, 23, 0);
+		a.tsti(1, exit_mask, 2);
+		a.bcond(NE, l_exit);
+		if (exact && !last)
+		{
+			a.cmpr(20, 21);
+			a.bcond(GE, l_exit);
+		}
+		a.b(l_cont);
+		a.bind(l_exit);
+		if (pending >= 0)
+			store_last((u32)pending);
+		leave_at(npc);
+
+		a.bind(l_branch);
+		if (before >= 0)
+			store_last((u32)before);
+		a.ldrx(16, 22, RUN_BRANCH);
+		a.blr(16);
+		add_time();
+		a.b(l_dyn);
+
+		a.bind(l_cont);
+		if (last)
+			chain_static(npc);
+		return true;
+	}
+};
+
+// Emits the block at pc0 into the arena, with a table entry for each of its instructions (a run can
+// enter it anywhere); returns the entry at pc0 (0: left to the interpreter).
+template<int PROCNUM>
+static u32 rb_compile(u32 pc0, u32 thumb)
+{
+	const u32 tag = JIT_ENTRY_TAG(PROCNUM, thumb);
+	if (!jit_recompile_allowed(pc0))
+	{
+		jit_table_set(pc0, PROCNUM, JIT_ENTRY_INTERPRET | tag);
+		return JIT_ENTRY_INTERPRET | tag;
+	}
+
+	RbIns ins[RB_MAX_INSTR];
+	size_t start[RB_MAX_INSTR];
+	const u32 size = thumb ? 2 : 4;
+	const int maxn = std::max(1, std::min((int)CommonSettings.jit_max_block_size, RB_MAX_INSTR));
+	int n = 0;
+	u32 pc = pc0;
+	for (;;)
+	{
+		const u32 op = thumb ? _MMU_read16<PROCNUM, MMU_AT_CODE>(pc) : _MMU_read32<PROCNUM, MMU_AT_CODE>(pc);
+		ins[n].pc = pc;
+		ins[n].op = op;
+		ins[n].ends = rb_ends_block(op, thumb);
+		ins[n].fused = thumb && n > 0 && (op >> 11) == 0x1F && (ins[n - 1].op >> 11) == 0x1E;
+		n++;
+		pc += size;
+		if (ins[n - 1].ends || n == maxn || (pc & 0x3FFF) == 0)
+			break;
+	}
+
+	RbCompiler c;
+	c.procnum = PROCNUM;
+	c.thumb = thumb != 0;
+	c.exact = rb_jit_exact;
+	c.timing = CommonSettings.advanced_timing;
+	c.size = size;
+	c.tag = tag;
+	c.exit_mask = ~(u32)(PROCNUM ? JIT_EXIT_WAIT9 : JIT_EXIT_WAIT7);
+	c.l_dyn = c.a.label();
+	// Before each instruction the last code fetch was its own, whether the code got there from the
+	// instruction before (which may have left it unwritten) or from outside (which wrote it): writing it
+	// again is always right.
+	const u32 fetch_mask = (PROCNUM == 0 || !thumb) ? 0xFFFFFFFCu : 0xFFFFFFFEu;
+	for (int k = 0; k < n; k++)
+	{
+		start[k] = c.a.pos();
+		c.pending = c.timing ? (s64)(ins[k].pc & fetch_mask) : -1;
+		if (!c.emit_ins(ins[k], ins[k].fused ? &ins[k - 1] : NULL, k == n - 1))
+			return 0;
+	}
+	c.emit_dyn_tail();
+	if (!c.a.finish())
+		return 0;
+
+	u8 *rw;
+	const size_t bytes = c.a.code.size() * 4;
+	u8 *rx = jit_code_alloc(bytes, &rw);
+	if (!rx)
+		return 0;
+	memcpy(rw, &c.a.code[0], bytes);
+	jit_code_flush(rx, bytes);
+#ifdef RB_JIT_DEBUG
+	if (getenv("RB_JIT_DUMP"))
+	{
+		// test builds: every block appended to the file, after a header {magic, pc, cpu|thumb<<1, words}
+		FILE *f = fopen(getenv("RB_JIT_DUMP"), "ab");
+		if (f)
+		{
+			const u32 h[4] = { 0x4B4C4252u, pc0, (u32)PROCNUM | (thumb << 1), (u32)c.a.code.size() };
+			fwrite(h, 4, 4, f);
+			fwrite(&c.a.code[0], 4, c.a.code.size(), f);
+			fclose(f);
+		}
+	}
+#endif
+
+	int nent = n;
+#ifdef RB_JIT_DEBUG
+	if (rb_dbg_nomid)
+		nent = 1;
+#endif
+	for (int k = nent - 1; k >= 0; k--)
+		if (!ins[k].fused && !jit_table_set(ins[k].pc, PROCNUM, (u32)(rx + start[k] * 4 - jit_code_base) | tag))
+			return 0;
+	jit_register_block_entries(PROCNUM, pc0, n * size, &JIT_COMPILED_FUNC(pc0, PROCNUM), nent, size / 2);
+	return (u32)(rx - jit_code_base) | tag;
+}
+
+// ---------------------------------------------------------------------------- dispatcher
+
+// The interpreter's state between instructions, from instruct_adr (after generated code)
+template<int PROCNUM>
+static FORCEINLINE void rb_complete_state(armcpu_t *cpu)
+{
+	const u32 cur = cpu->instruct_adr;
+	if (cpu->CPSR.bits.T == 0)
+	{
+		cpu->next_instruction = cur + 4;
+		cpu->R[15] = cur + 8;
+		cpu->instruction = _MMU_read32<PROCNUM, MMU_AT_CODE>(cur);
+	}
+	else
+	{
+		cpu->next_instruction = cur + 2;
+		cpu->R[15] = cur + 4;
+		cpu->instruction = _MMU_read16<PROCNUM, MMU_AT_CODE>(cur);
+	}
+}
+
+/*
+	Like jit_cached_run: runs this CPU from time t, at least one instruction, then on while the CPU loop
+	would have given it the next instruction. Generated code goes on by itself through chained blocks;
+	this loop compiles what is missing, runs the interpreter where nothing is compiled, and checks again.
+*/
+template<int PROCNUM>
+s32 rb_jit_run(s32 t, const s32 limit, const s32 next, const u64 base)
+{
+	armcpu_t *const cpu = &ARMPROC;
+	const u32 stop = JIT_EXIT_RESCHEDULE | JIT_EXIT_HALT | (PROCNUM ? JIT_EXIT_WAIT7 : JIT_EXIT_WAIT9);
+#ifdef RB_JIT_DEBUG
+	rb_dbg_init();
+#endif
+	if (rb_jit_timing != (int)CommonSettings.advanced_timing)
+	{
+		// the code counts fetch cycles for one setting: compile it again for the other
+		if (rb_jit_timing >= 0)
+			arm_jit_reset(true, true);
+		rb_jit_timing = CommonSettings.advanced_timing;
+	}
+	RbRun run;
+	run.cpu = cpu;
+	run.l1 = (u32 **)JIT.JIT_MEM[PROCNUM];
+	run.code = jit_code_base;
+	run.base = base;
+	run.limit = std::min(limit, next);
+	run.leave = (u64)(uintptr_t)(jit_code_base + RB_STUB_LEAVE);
+	run.fetch_last = MMU_timing.armCodeFetch<PROCNUM>().LastAddressPtr();
+	run.arm = arm_instructions_set[PROCNUM];
+	run.thumb = thumb_instructions_set[PROCNUM];
+	run.fetch_seq_arm = (u64)(uintptr_t)&rb_fetch_seq<PROCNUM, 0>;
+	run.fetch_seq_thumb = (u64)(uintptr_t)&rb_fetch_seq<PROCNUM, 1>;
+	run.fetch_branch = (u64)(uintptr_t)&rb_fetch_branch<PROCNUM>;
+	const RbEnterFn enter = (RbEnterFn)(jit_code_base + RB_STUB_ENTER);
+	bool first = true;
+	for (;;)
+	{
+		if (!first)
+		{
+			if (!(t < limit && t < next) || (jit_exit_request & stop))
+				return t;
+			nds_timer = base + t;
+		}
+
+		const u32 thumb = cpu->CPSR.bits.T;
+		const u32 adr = cpu->instruct_adr;
+		const u32 tag = JIT_ENTRY_TAG(PROCNUM, thumb);
+		u32 e = JIT_COMPILED_FUNC(adr, PROCNUM);
+		if (!((e & 3) == tag && e >= 8))
+		{
+			if (e != (JIT_ENTRY_INTERPRET | tag) && JIT_MAPPED(adr & 0x0FFFFFFF, PROCNUM))
+				e = rb_compile<PROCNUM>(adr, thumb);
+			else
+				e = 0;
+		}
+		// The opcode the interpreter prefetched is the one it would run: the other CPU or a DMA may have
+		// changed memory since (within this run, every change of code ended it)
+		if (e < 8 || (first && cpu->instruction != (thumb ? (u32)_MMU_read16<PROCNUM, MMU_AT_CODE>(adr)
+		                                                    : _MMU_read32<PROCNUM, MMU_AT_CODE>(adr))))
+		{
+			first = false;
+			const u32 c = armcpu_exec<PROCNUM>();
+			t += PROCNUM ? (s32)(c << 1) : (s32)c;
+			continue;
+		}
+		first = false;
+		jit_exit_request &= ~JIT_EXIT_SMC;
+		run.t = t;
+		run.code = jit_code_base;
+		enter(jit_code_base + (e & ~3u), &run);
+		t = run.t;
+		rb_complete_state<PROCNUM>(cpu);
+	}
+}
+
+template s32 rb_jit_run<0>(s32 t, const s32 limit, const s32 next, const u64 base);
+template s32 rb_jit_run<1>(s32 t, const s32 limit, const s32 next, const u64 base);
+
+#endif
