+		size = half;
+	}
+	const u64 mask = size == 64 ? ~0ull : ((1ull << size) - 1);
+	const u64 elt = imm & mask;
+	u32 ones = 0;
+	for (u32 i = 0; i < size; i++)
+		ones += (elt >> i) & 1;
+	const u64 run = (1ull << ones) - 1; // ones < size here
+	u32 rot = 0;
+	for (; rot < size; rot++)
+	{
+		const u64 r = rot ? (((elt >> rot) | (elt << (size - rot))) & mask) : elt;
+		if (r == run)
+			break;
+	}
+	if (rot == size)
+		return false;
+	const u32 immr = (size - rot) & (size - 1);
+	const u32 imms = ((~(size - 1) << 1) | (ones - 1)) & 0x3F;
+	*enc = ((size == 64 ? 1u : 0u) << 12) | (immr << 6) | imms;
+	return true;
+}
+
+struct Asm
+{
+	std::vector<u32> code;
+	std::vector<long> labels; // word index, -1 while unbound
+	struct Fix { size_t at; int label; int kind; };
+	std::vector<Fix> fixes;
+	enum { FIX_B26, FIX_B19, FIX_B14 };
+
+	void w(u32 x) { code.push_back(x); }
+	size_t pos() const { return code.size(); }
+
+	int label() { labels.push_back(-1); return (int)labels.size() - 1; }
+	void bind(int l) { labels[l] = (long)code.size(); }
+	void fix(int l, int kind) { Fix f = { code.size(), l, kind }; fixes.push_back(f); }
+
+	// resolves the branches to local labels; false if one is out of range (cannot happen in a block)
+	bool finish()
+	{
+		for (size_t i = 0; i < fixes.size(); i++)
+		{
+			const Fix &f = fixes[i];
+			if (labels[f.label] < 0)
+				return false;
+			const long d = labels[f.label] - (long)f.at;
+			u32 &ins = code[f.at];
+			if (f.kind == FIX_B26)
+			{
+				if (d < -(1L << 25) || d >= (1L << 25)) return false;
+				ins |= (u32)d & 0x03FFFFFF;
+			}
+			else if (f.kind == FIX_B19)
+			{
+				if (d < -(1L << 18) || d >= (1L << 18)) return false;
+				ins |= ((u32)d & 0x7FFFF) << 5;
+			}
+			else
+			{
+				if (d < -(1L << 13) || d >= (1L << 13)) return false;
+				ins |= ((u32)d & 0x3FFF) << 5;
+			}
+		}
+		return true;
+	}
+
+	// ---- moves
+	void movz(int rd, u32 imm16, int hw, bool x) { w((x ? 0xD2800000u : 0x52800000u) | (hw << 21) | ((imm16 & 0xFFFF) << 5) | rd); }
+	void movk(int rd, u32 imm16, int hw, bool x) { w((x ? 0xF2800000u : 0x72800000u) | (hw << 21) | ((imm16 & 0xFFFF) << 5) | rd); }
+	void movn(int rd, u32 imm16, int hw, bool x) { w((x ? 0x92800000u : 0x12800000u) | (hw << 21) | ((imm16 & 0xFFFF) << 5) | rd); }
+	void mov32(int rd, u32 v)
+	{
+		if ((v & 0xFFFF0000u) == 0) { movz(rd, v, 0, false); return; }
+		if ((v & 0xFFFF) == 0) { movz(rd, v >> 16, 1, false); return; }
+		if ((v | 0xFFFF) == 0xFFFFFFFFu) { movn(rd, ~v & 0xFFFF, 0, false); return; }
+		u32 enc;
+		if (logical_imm(v, false, &enc)) { w(0x32000000u | (enc << 10) | (ZR << 5) | rd); return; } // ORR rd, wzr, #v
+		movz(rd, v & 0xFFFF, 0, false);
+		movk(rd, v >> 16, 1, false);
+	}
+	void mov64(int rd, u64 v)
+	{
+		if ((v >> 32) == 0) { mov32(rd, (u32)v); return; } // writing a W register clears the top half
+		bool first = true;
+		for (int hw = 0; hw < 4; hw++)
+		{
+			const u32 part = (u32)(v >> (16 * hw)) & 0xFFFF;
+			if (part == 0)
+				continue;
+			if (first) movz(rd, part, hw, true); else movk(rd, part, hw, true);
+			first = false;
+		}
+	}
+	void mov(int rd, int rm, bool x = false) { w((x ? 0xAA000000u : 0x2A000000u) | (rm << 16) | (ZR << 5) | rd); }
+	void mov_sp(int rd, int rn) { w(0x91000000u | (rn << 5) | rd); } // add xd, xn, #0 (works with sp)
+
+	// ---- arithmetic
+	void addi(int rd, int rn, u32 imm, bool x = false, bool s = false) { w((x ? 0x91000000u : 0x11000000u) | (s ? 0x20000000u : 0) | ((imm & 0xFFF) << 10) | (rn << 5) | rd); }
+	void subi(int rd, int rn, u32 imm, bool x = false, bool s = false) { w((x ? 0xD1000000u : 0x51000000u) | (s ? 0x20000000u : 0) | ((imm & 0xFFF) << 10) | (rn << 5) | rd); }
+	void cmpi(int rn, u32 imm, bool x = false) { subi(ZR, rn, imm, x, true); }
+	void addr(int rd, int rn, int rm, Shift sh = LSL, int amt = 0, bool x = false, bool s = false)
+	{ w((x ? 0x8B000000u : 0x0B000000u) | (s ? 0x20000000u : 0) | (sh << 22) | (rm << 16) | ((amt & 63) << 10) | (rn << 5) | rd); }
+	void subr(int rd, int rn, int rm, Shift sh = LSL, int amt = 0, bool x = false, bool s = false)
+	{ w((x ? 0xCB000000u : 0x4B000000u) | (s ? 0x20000000u : 0) | (sh << 22) | (rm << 16) | ((amt & 63) << 10) | (rn << 5) | rd); }
+	void cmpr(int rn, int rm, bool x = false) { subr(ZR, rn, rm, LSL, 0, x, true); }
+	void addx_ext(int rd, int rn, int rm, Extend e, int amt = 0) { w(0x8B200000u | (rm << 16) | (e << 13) | ((amt & 7) << 10) | (rn << 5) | rd); }
+	void adc(int rd, int rn, int rm, bool s = false) { w((s ? 0x3A000000u : 0x1A000000u) | (rm << 16) | (rn << 5) | rd); }
+	void sbc(int rd, int rn, int rm, bool s = false) { w((s ? 0x7A000000u : 0x5A000000u) | (rm << 16) | (rn << 5) | rd); }
+
+	// ---- logic (shifted register); opc: 0 AND, 1 ORR, 2 EOR, 3 ANDS; n inverts rm (BIC, ORN, EON, BICS)
+	void logr(int opc, bool n, int rd, int rn, int rm, Shift sh = LSL, int amt = 0, bool x = false)
+	{ w((x ? 0x8A000000u : 0x0A000000u) | (opc << 29) | (sh << 22) | (n ? 0x200000u : 0) | (rm << 16) | ((amt & 63) << 10) | (rn << 5) | rd); }
+	void andr(int rd, int rn, int rm) { logr(0, false, rd, rn, rm); }
+	void orr(int rd, int rn, int rm) { logr(1, false, rd, rn, rm); }
+	void eor(int rd, int rn, int rm) { logr(2, false, rd, rn, rm); }
+	void tst(int rn, int rm) { logr(3, false, ZR, rn, rm); }
+	// logical immediate; false when imm is not encodable (nothing emitted)
+	bool logi(int opc, int rd, int rn, u64 imm, bool x = false)
+	{
+		u32 enc;
+		if (!logical_imm(imm, x, &enc)) return false;
+		w((x ? 0x92000000u : 0x12000000u) | (opc << 29) | (enc << 10) | (rn << 5) | rd);
+		return true;
+	}
+	void andi(int rd, int rn, u64 imm, int tmp, bool x = false) { if (!logi(0, rd, rn, imm, x)) { x ? mov64(tmp, imm) : mov32(tmp, (u32)imm); logr(0, false, rd, rn, tmp, LSL, 0, x); } }
+	void orri(int rd, int rn, u64 imm, int tmp, bool x = false) { if (!logi(1, rd, rn, imm, x)) { x ? mov64(tmp, imm) : mov32(tmp, (u32)imm); logr(1, false, rd, rn, tmp, LSL, 0, x); } }
+	void eori(int rd, int rn, u64 imm, int tmp, bool x = false) { if (!logi(2, rd, rn, imm, x)) { x ? mov64(tmp, imm) : mov32(tmp, (u32)imm); logr(2, false, rd, rn, tmp, LSL, 0, x); } }
+	void tsti(int rn, u64 imm, int tmp, bool x = false) { if (!logi(3, ZR, rn, imm, x)) { x ? mov64(tmp, imm) : mov32(tmp, (u32)imm); logr(3, false, ZR, rn, tmp, LSL, 0, x); } }
+
+	// ---- bitfields and shifts (32-bit)
+	void ubfm(int rd, int rn, int immr, int imms, bool x = false) { w((x ? 0xD3400000u : 0x53000000u) | (immr << 16) | (imms << 10) | (rn << 5) | rd); }
+	void sbfm(int rd, int rn, int immr, int imms, bool x = false) { w((x ? 0x93400000u : 0x13000000u) | (immr << 16) | (imms << 10) | (rn << 5) | rd); }
+	void bfm(int rd, int rn, int immr, int imms, bool x = false) { w((x ? 0xB3400000u : 0x33000000u) | (immr << 16) | (imms << 10) | (rn << 5) | rd); }
+	void lsli(int rd, int rn, int s) { ubfm(rd, rn, (32 - s) & 31, 31 - s); }
+	void lsri(int rd, int rn, int s) { ubfm(rd, rn, s, 31); }
+	void asri(int rd, int rn, int s) { sbfm(rd, rn, s, 31); }
+	void rori(int rd, int rn, int s) { w(0x13800000u | (rn << 16) | ((s & 31) << 10) | (rn << 5) | rd); } // EXTR
+	void ubfx(int rd, int rn, int lsb, int width, bool x = false) { ubfm(rd, rn, lsb, lsb + width - 1, x); }
+	void sbfx(int rd, int rn, int lsb, int width, bool x = false) { sbfm(rd, rn, lsb, lsb + width - 1, x); }
+	void bfi(int rd, int rn, int lsb, int width, bool x = false) { bfm(rd, rn, (-lsb) & (x ? 63 : 31), width - 1, x); }
+	void lslv(int rd, int rn, int rm) { w(0x1AC02000u | (rm << 16) | (rn << 5) | rd); }
+	void lsrv(int rd, int rn, int rm) { w(0x1AC02400u | (rm << 16) | (rn << 5) | rd); }
+	void asrv(int rd, int rn, int rm) { w(0x1AC02800u | (rm << 16) | (rn << 5) | rd); }
+	void rorv(int rd, int rn, int rm) { w(0x1AC02C00u | (rm << 16) | (rn << 5) | rd); }
+	void lsrv64(int rd, int rn, int rm) { w(0x9AC02400u | (rm << 16) | (rn << 5) | rd); }
+	void clz(int rd, int rn) { w(0x5AC01000u | (rn << 5) | rd); }
+
+	// ---- multiply
+	void madd(int rd, int rn, int rm, int ra, bool x = false) { w((x ? 0x9B000000u : 0x1B000000u) | (rm << 16) | (ra << 10) | (rn << 5) | rd); }
+	void mul(int rd, int rn, int rm) { madd(rd, rn, rm, ZR); }
+	void smaddl(int rd, int rn, int rm, int ra) { w(0x9B200000u | (rm << 16) | (ra << 10) | (rn << 5) | rd); }
+	void umaddl(int rd, int rn, int rm, int ra) { w(0x9BA00000u | (rm << 16) | (ra << 10) | (rn << 5) | rd); }
+
+	// ---- conditional select
+	void csel(int rd, int rn, int rm, Cond c, bool x = false) { w((x ? 0x9A800000u : 0x1A800000u) | (rm << 16) | (c << 12) | (rn << 5) | rd); }
+	void csinc(int rd, int rn, int rm, Cond c, bool x = false) { w((x ? 0x9A800400u : 0x1A800400u) | (rm << 16) | (c << 12) | (rn << 5) | rd); }
+	void cset(int rd, Cond c) { csinc(rd, ZR, ZR, (Cond)(c ^ 1)); }
+
+	// ---- flags
+	void msr_nzcv(int rt) { w(0xD51B4200u | rt); }
+	void mrs_nzcv(int rt) { w(0xD53B4200u | rt); }
+
+	// ---- memory (unsigned scaled offset; off must be a multiple of the size and in range)
+	void ldrw(int rt, int rn, u32 off) { w(0xB9400000u | ((off >> 2) << 10) | (rn << 5) | rt); }
+	void strw(int rt, int rn, u32 off) { w(0xB9000000u | ((off >> 2) << 10) | (rn << 5) | rt); }
+	void ldrx(int rt, int rn, u32 off) { w(0xF9400000u | ((off >> 3) << 10) | (rn << 5) | rt); }
+	void strx(int rt, int rn, u32 off) { w(0xF9000000u | ((off >> 3) << 10) | (rn << 5) | rt); }
+	void ldrb(int rt, int rn, u32 off) { w(0x39400000u | (off << 10) | (rn << 5) | rt); }
+	void strb(int rt, int rn, u32 off) { w(0x39000000u | (off << 10) | (rn << 5) | rt); }
+	void ldrh(int rt, int rn, u32 off) { w(0x79400000u | ((off >> 1) << 10) | (rn << 5) | rt); }
+	void strh(int rt, int rn, u32 off) { w(0x79000000u | ((off >> 1) << 10) | (rn << 5) | rt); }
+	// register offset, index scaled by the access size when scaled
+	void ldrw_r(int rt, int rn, int rm, bool scaled) { w(0xB8606800u | (scaled ? 0x1000u : 0) | (rm << 16) | (rn << 5) | rt); }
+	void ldrx_r(int rt, int rn, int rm, bool scaled) { w(0xF8606800u | (scaled ? 0x1000u : 0) | (rm << 16) | (rn << 5) | rt); }
+	void strw_r(int rt, int rn, int rm, bool scaled) { w(0xB8206800u | (scaled ? 0x1000u : 0) | (rm << 16) | (rn << 5) | rt); }
+	void stp_pre(int r1, int r2, int rn, int off) { w(0xA9800000u | (((u32)(off / 8) & 0x7F) << 15) | (r2 << 10) | (rn << 5) | r1); }
+	void stp(int r1, int r2, int rn, int off) { w(0xA9000000u | (((u32)(off / 8) & 0x7F) << 15) | (r2 << 10) | (rn << 5) | r1); }
+	void ldp(int r1, int r2, int rn, int off) { w(0xA9400000u | (((u32)(off / 8) & 0x7F) << 15) | (r2 << 10) | (rn << 5) | r1); }
+	void ldp_post(int r1, int r2, int rn, int off) { w(0xA8C00000u | (((u32)(off / 8) & 0x7F) << 15) | (r2 << 10) | (rn << 5) | r1); }
+
+	// ---- branches
+	void b(int l) { fix(l, FIX_B26); w(0x14000000u); }
+	void bcond(Cond c, int l) { fix(l, FIX_B19); w(0x54000000u | c); }
+	void cbz(int rt, int l, bool x = false) { fix(l, FIX_B19); w((x ? 0xB4000000u : 0x34000000u) | rt); }
+	void cbnz(int rt, int l, bool x = false) { fix(l, FIX_B19); w((x ? 0xB5000000u : 0x35000000u) | rt); }
+	void tbz(int rt, int bit, int l) { fix(l, FIX_B14); w(0x36000000u | ((bit >> 5) << 31) | ((bit & 31) << 19) | rt); }
+	void tbnz(int rt, int bit, int l) { fix(l, FIX_B14); w(0x37000000u | ((bit >> 5) << 31) | ((bit & 31) << 19) | rt); }
+	void br(int rn) { w(0xD61F0000u | (rn << 5)); }
+	void blr(int rn) { w(0xD63F0000u | (rn << 5)); }
+	void ret() { w(0xD65F03C0u); }
+	void call(u64 fn, int tmp = 16) { mov64(tmp, fn); blr(tmp); }
+};
+
+} // namespace rba64
