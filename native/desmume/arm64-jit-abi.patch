+	                      ((((adr)&(mask))>>1)+(ofs)) & (JIT_PAGE_ENTRIES-1)))
+#define JIT_MAPPED(adr, PROCNUM) (jit_l1_page[PROCNUM][(adr)>>14] != JIT_PAGE_NONE)
