+	along with the this software.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+	RewindBox: time spent per frame in each stage of the core, written to the core log by the libretro
+	frontend ("[rb-perf] desmume ..."). The emulation thread adds to the plain counters; the rasterizer
+	threads add their busy time to `raster` atomically. Two clock reads per measured call.
+	Counts: renders3d, bandRenders (renders drawn by bands), bandWaits (waits of the emulation thread that
+	blocked on a band), captureFrames and capture3DFrames (frames with a display capture, and with a direct
+	capture of the 3D). render3dWall: from the start of a render drawn by bands to its last band (atomic);
+	rasterCpu: CPU time of the rasterizer threads (atomic), against `raster`, their wall time.
+*/
+#ifndef RB_PERF_H
+#define RB_PERF_H
+
+#include "../types.h"
+#include <time.h>
+
+struct RbPerf
+{
+	u64 gpuLine;   // GPUSubsystem::RenderLine, the 2D engines (includes waits for the 3D, counted in wait3d)
+	u64 wait3d;    // the emulation thread waiting for the rasterizer threads (RenderFinish), resolve included
+	u64 render3d;  // SoftRasterizerRenderer::Render on the emulation thread (state, clear, start of the threads)
+	u64 resolve;   // averaging of the supersampled 3D into the output (atomic: by bands, the rasterizer threads do it)
+	u64 raster;    // busy time of the rasterizer threads, all of them (atomic)
+	u64 gpuMain;   // part of gpuLine: the main 2D engine's lines (the one that composes the 3D)
+	u64 gpuSub;    // part of gpuLine: the sub 2D engine's lines
+	u64 gpuEnd;    // part of gpuLine: the end of the frame (resolve to the custom size, display post-processing)
+	u64 renders3d;       // 3D renders started
+	u64 bandRenders;     // part of renders3d: drawn by bands (the emulation thread waits for its own lines)
+	u64 bandWaits;       // waits of the emulation thread that blocked on a band
+	u64 captureFrames;   // frames with a display capture
+	u64 capture3DFrames; // part of captureFrames: a direct capture of the 3D (DISPCAPCNT source A = 3D)
+	u64 render3dWall;    // start of a render drawn by bands to its last band (atomic)
+	u64 rasterCpu;       // CPU time of the rasterizer threads (atomic)
+};
+
+extern RbPerf rb_perf;
+
+static inline u64 rb_perf_now()
+{
+#if defined(__APPLE__)
+	return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+#else
+	struct timespec t;
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return (u64)t.tv_sec * 1000000000ull + (u64)t.tv_nsec;
+#endif
+}
+
+// CPU time of the calling thread: below its wall time when it waited for a core
+static inline u64 rb_perf_thread_cpu()
+{
+#if defined(__APPLE__)
+	return clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID);
+#else
+	struct timespec t;
+	clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+	return (u64)t.tv_sec * 1000000000ull + (u64)t.tv_nsec;
+#endif
+}
+
+static inline void rb_perf_add_atomic(u64 *counter, u64 value)
+{
+	__atomic_fetch_add(counter, value, __ATOMIC_RELAXED);
+}
+
+// The counters as the emulation thread sees them; the ones other threads add to are read atomically.
+static inline RbPerf rb_perf_snapshot()
+{
+	RbPerf s;
+	s.gpuLine = rb_perf.gpuLine;
+	s.wait3d = rb_perf.wait3d;
+	s.render3d = rb_perf.render3d;
+	s.resolve = __atomic_load_n(&rb_perf.resolve, __ATOMIC_RELAXED);
+	s.raster = __atomic_load_n(&rb_perf.raster, __ATOMIC_RELAXED);
+	s.gpuMain = rb_perf.gpuMain;
+	s.gpuSub = rb_perf.gpuSub;
+	s.gpuEnd = rb_perf.gpuEnd;
+	s.renders3d = rb_perf.renders3d;
+	s.bandRenders = rb_perf.bandRenders;
+	s.bandWaits = rb_perf.bandWaits;
+	s.captureFrames = rb_perf.captureFrames;
+	s.capture3DFrames = rb_perf.capture3DFrames;
+	s.render3dWall = __atomic_load_n(&rb_perf.render3dWall, __ATOMIC_RELAXED);
+	s.rasterCpu = __atomic_load_n(&rb_perf.rasterCpu, __ATOMIC_RELAXED);
+	return s;
+}
+
+#endif
