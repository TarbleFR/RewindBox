+// RewindBox: the state the interpreter keeps between instructions, rebuilt after JIT blocks without the
+// fetch timing (cache model, last fetch address) that armcpu_prefetch would also move
+template<u32 PROCNUM>
+static void arm_jit_sync_cpu()
+{
+	armcpu_t* const armcpu = &ARMPROC;
+	if (armcpu->CPSR.bits.T == 0)
+	{
+		const u32 cur = armcpu->instruct_adr & 0xFFFFFFFC;
+		armcpu->instruct_adr = cur;
+		armcpu->next_instruction = cur + 4;
+		armcpu->R[15] = cur + 8;
+		armcpu->instruction = _MMU_read32<PROCNUM, MMU_AT_CODE>(cur);
+	}
+	else
+	{
+		const u32 cur = armcpu->instruct_adr & 0xFFFFFFFE;
+		armcpu->instruct_adr = cur;
+		armcpu->next_instruction = cur + 2;
+		armcpu->R[15] = cur + 4;
+		armcpu->instruction = _MMU_read16<PROCNUM, MMU_AT_CODE>(cur);
+	}
+}
+
+void arm_jit_sync()
+{
+	// the interpreter and the cached interpreter keep that state themselves
+	if (!CommonSettings.use_jit)
+		return;
+	arm_jit_sync_cpu<0>();
+	arm_jit_sync_cpu<1>();
+}
