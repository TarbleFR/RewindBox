+++ b/desmume/src/GPU.cpp
@@ -7342,6 +7342,36 @@ void GPUEngineA::RenderLine_Layer3D(GPUEngineCompositorInfo &compInfo)
 	{
 		size_t i = 0;
 		
+#ifndef ENABLE_SSE2
+		// RewindBox: the usual case (plain copy to the 15-bit picture, no window test) as one loop without
+		// branches or calls, which the compiler vectorizes (this build has no SIMD path of its own). It
+		// writes what _PixelCopy writes: a 3D pixel with a non-zero alpha replaces the picture's pixel and
+		// its layer. At 2560x1920 this layer is 4.9 million pixels a frame on the emulation thread.
+		if ( (COMPOSITORMODE == GPUCompositorMode_Copy) && (OUTPUTFORMAT == NDSColorFormat_BGR555_Rev) && !WILLPERFORMWINDOWTEST )
+		{
+			const size_t pixCount = compInfo.line.pixelCount;
+			u16 *__restrict dstColor16 = compInfo.target.lineColor16;
+			u8 *__restrict dstLayerID = compInfo.target.lineLayerID;
+			const u8 layerID = (u8)compInfo.renderState.selectedLayerID;
+			
+			for (; i < pixCount; i++)
+			{
+				const FragmentColor src = srcLinePtr[i];
+				const bool pass = (src.a != 0);
+				const u16 color16 = (u16)(R6G6B6TORGB15(src.r, src.g, src.b) | 0x8000);
+				dstColor16[i] = (pass) ? color16 : dstColor16[i];
+				dstLayerID[i] = (pass) ? layerID : dstLayerID[i];
+			}
+			
+			// The state the general loop leaves
+			srcLinePtr += pixCount;
+			compInfo.target.xCustom = (pixCount > 0) ? compInfo.line.widthCustom : 0;
+			compInfo.target.lineColor16 += pixCount;
+			compInfo.target.lineColor32 += pixCount;
+			compInfo.target.lineLayerID += pixCount;
+		}
+#endif
+		
 #ifdef ENABLE_SSE2
 		const size_t ssePixCount = (compInfo.line.pixelCount - (compInfo.line.pixelCount % 16));
 		const __m128i srcEffectEnableMask = compInfo.renderState.srcEffectEnable_SSE2[GPULayerID_BG0];
