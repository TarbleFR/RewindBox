+		// used only if it was made for this CPU in this ARM/Thumb state
+		u32 *slot = &JIT_COMPILED_FUNC(ARMPROC.instruct_adr, PROCNUM);
+		jit_current_slot[PROCNUM] = slot;
+		jit_exit_request &= ~JIT_EXIT_SMC;
+		const u32 e = *slot;
+		if ((e & 3) == JIT_ENTRY_TAG(PROCNUM, ARMPROC.CPSR.bits.T))
+		{
