  "buildCommands": {
    "prepare": [
      "copy desmume/src/utils/arm_jit/{arm_jit_arm.cpp,emit_core.cpp,arm64_emit.cpp} from TASEmulators/desmume b549f71b",
      "git apply --check native/desmume/arm64-jit-abi.patch",
      "git apply native/desmume/arm64-jit-abi.patch",
      "mkdir -p desmume/src/frontend/libretro/rewindbox && cp packages/libretro_internal_bridge/ios/Classes/RewindBoxLibretroJit.h desmume/src/frontend/libretro/rewindbox/RewindBoxLibretroJit.h"
    ],
    "desmume": "cd desmume/src/frontend/libretro && SOURCE_DATE_EPOCH=1795306701 make -f Makefile.libretro -j$(sysctl -n hw.ncpu) platform=ios-arm64 DESMUME_JIT_A64=1 IOSMINVER=14.0 && strip -x desmume_libretro_ios.dylib",
    "defines": "DESMUME_JIT_A64=1 adds -DHAVE_JIT -DREWINDBOX_LIBRETRO_JIT and compiles utils/arm_jit/arm_jit_arm.cpp (which includes emit_core.cpp and arm64_emit.cpp) instead of the x86 JIT"
  },
  "build": {
    "kind": "make",
    "directory": "desmume/src/frontend/libretro",
    "makefile": "Makefile.libretro",
    "make": [
      "platform=ios-arm64",
      "DESMUME_JIT_A64=1",
      "IOSMINVER=14.0"
    ],
    "output": "desmume/src/frontend/libretro/desmume_libretro_ios.dylib",
    "strip": [
      "-x"
    ]
  },
