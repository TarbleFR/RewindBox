+#ifdef REWINDBOX_LIBRETRO_JIT
+/* RewindBox's JIT interface (rewindbox/RewindBoxLibretroJit.h, copied from
+ * RewindBox by the build). The host prepares the executable memory before
+ * it opens the core and hands it over right after dlopen: Lightrec's code
+ * buffer is one block of it, taken once per open, written at
+ * lightrec_codebuffer and run rewindbox_jit_exec_offset bytes away. Without
+ * it no code is generated: the dynarec stays off. */
+static const RewindBoxLibretroJitV1 *rewindbox_jit;
+intptr_t rewindbox_jit_exec_offset;
+
+RETRO_API int rewindbox_libretro_jit_install(const RewindBoxLibretroJitV1 *jit)
+{
+   uint64_t rx = 0, rw = 0;
+
+   /* A new open: what an earlier one installed went with it */
+   rewindbox_jit             = NULL;
+   rewindbox_jit_exec_offset = 0;
+   lightrec_codebuffer       = NULL;
+
+   if (!jit || jit->version != REWINDBOX_LIBRETRO_JIT_VERSION ||
+       jit->structBytes != sizeof(*jit) ||
+       !jit->allocate || !jit->flush || !jit->available ||
+       !jit->pageBytes || (jit->pageBytes & (jit->pageBytes - 1)))
+      return -1;
+
+   /* The whole code buffer at once: the arena never grows, and a full
+    * buffer is flushed and reused by Lightrec */
+   if (jit->available() < LIGHTREC_CODEBUFFER_SIZE ||
+       jit->allocate(LIGHTREC_CODEBUFFER_SIZE, &rx, &rw) != 0 ||
+       !rx || !rw || ((rx | rw) & (jit->pageBytes - 1)))
+      return -1;
+
+   rewindbox_jit             = jit;
+   rewindbox_jit_exec_offset = (intptr_t)(rx - rw);
+   lightrec_codebuffer       = (uint8_t *)(uintptr_t)rw;
+   return 0;
+}
+
