  "buildCommands": {
    "prepare": [
      "git apply --check native/beetle-psx/lightrec-jit-abi.patch",
      "git apply native/beetle-psx/lightrec-jit-abi.patch",
      "mkdir -p rewindbox && cp packages/libretro_internal_bridge/ios/Classes/RewindBoxLibretroJit.h rewindbox/RewindBoxLibretroJit.h"
    ],
    "mednafen_psx_hw": "make -j$(sysctl -n hw.ncpu) platform=ios-arm64 HAVE_HW=1 HAVE_LIGHTREC=1 THREADED_RECOMPILER=1 LIGHTREC_CODEBUFFER_SIZE=16777216 && strip -x mednafen_psx_hw_libretro_ios.dylib",
    "between": "make clean (or a separate tree per core: the objects differ with HAVE_HW)",
    "mednafen_psx": "make -j$(sysctl -n hw.ncpu) platform=ios-arm64 HAVE_LIGHTREC=1 THREADED_RECOMPILER=1 LIGHTREC_CODEBUFFER_SIZE=16777216 && strip -x mednafen_psx_libretro_ios.dylib",
    "defines": "With platform=ios-arm64 and HAVE_LIGHTREC=1 the patched Makefile adds -DREWINDBOX_LIBRETRO_JIT -DLIGHTREC_CODEBUFFER_SIZE=$(LIGHTREC_CODEBUFFER_SIZE); Makefile.common adds -DHAVE_LIGHTREC -DENABLE_THREADED_COMPILER=1. No HAVE_SHM on iOS."
  },
