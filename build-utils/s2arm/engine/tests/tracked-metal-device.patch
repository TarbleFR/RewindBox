+// These shader tests submit ordinary Metal commands with tracked resources.
+// A paravirtual device can run all of them without the guest renderer's residency sets.
+static void fixture_device(void) {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    REQUIRE(device);
+    NSError *error = nil;
+    MTLResidencySetDescriptor *descriptor = [MTLResidencySetDescriptor new];
+    descriptor.initialCapacity = 4096;  // probe the same request as mtl_init
+    if ([device respondsToSelector:@selector(newResidencySetWithDescriptor:error:)] &&
+        [device newResidencySetWithDescriptor:descriptor error:&error]) {
+        mtl_init();
+        return;
+    }
+    s2a_mtl_slot_take("shader-flight fixture");
+    g_dev = device;
+    g_m3 = 1;  // real session retirement rebuilds its argument tables via DmTable3
+    g_q = [device newCommandQueue];
+    REQUIRE(g_q);
+    g_q3 = g_q;
+    printf("Shader fixture using tracked Metal command resources on %s (%s)\n",
+           device.name.UTF8String, error.localizedDescription.UTF8String ?: "residency sets unavailable");
 }
