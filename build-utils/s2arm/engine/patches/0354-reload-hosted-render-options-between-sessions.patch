 void nvn_be_begin_session(void) {
+    // The previous session has drained. A collection can reload its profile during boot,
+    // so resolve both options on first use. Discard only unreported barrier reasons;
+    // the texture counters are cumulative and the sampler retains its baselines.
+    atomic_store_explicit(&g_rb_dbar_game, -1, memory_order_relaxed);
+    atomic_store_explicit(&g_rb_view_meta_mode, -1, memory_order_relaxed);
+    g_game_barrier = 0;
+    g_last_end_relaxed = 0;
+    for (int i = 0; i < RB_DBAR_COUNT; i++) atomic_store_explicit(&g_rb_dbar[i], 0, memory_order_relaxed);
+    for (size_t i = 0; i < sizeof g_rb_dbar_out / sizeof *g_rb_dbar_out; i++) atomic_store_explicit(&g_rb_dbar_out[i], 0, memory_order_relaxed);
     rb_xq_resume_reset();
     atomic_store(&g_spec_sampled,0);
     atomic_store(&rb_gov_next,0);
