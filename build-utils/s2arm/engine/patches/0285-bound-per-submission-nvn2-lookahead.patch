diff --git a/graphics/nvn/tests/t_rb_look_budget.c b/graphics/nvn/tests/t_rb_look_budget.c
new file mode 100644
index 0000000..c115866
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_look_budget.c
@@ -0,0 +1,27 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../gfx/nvn/rb_look_budget.h"
+
+int main(void) {
+    rb_look_budget b={0};
+    assert(rb_look_begin(&b,0,100,1));
+    assert(!rb_look_begin(&b,0,101,1)); // no recursion
+    rb_look_finish(&b,1000100);
+    assert(rb_look_begin(&b,0,9000000,1));
+    assert(b.deadline==9950000); // idle gap between scans is free
+    rb_look_finish(&b,b.deadline);
+    assert(!rb_look_begin(&b,0,10000000,1));
+    assert(rb_look_begin(&b,1,11000000,0));
+    rb_look_finish(&b,11000001);
+    assert(!rb_look_begin(&b,1,12000000,0));
+    assert(rb_look_begin(&b,2,13000000,1));
+    rb_look_finish(&b,15000123);
+    assert(b.spent==2000123 && !rb_look_begin(&b,2,16000000,1)); // actual overshoot is recorded
+    rb_look_miss miss={17,7,3};
+    assert(rb_look_still_missing(&miss,17,7,3));
+    assert(!rb_look_still_missing(&miss,17,8,3));
+    assert(!rb_look_still_missing(&miss,17,7,4));
+    assert(!rb_look_still_missing(&miss,17+RB_LOOK_NEGATIVE_SLOTS,7,3));
+    puts("PASS cumulative lookahead deadline, retry cap, publication epochs and collisions");
+}
