diff --git a/graphics/nvn/gfx/nvn/rb_look_budget.h b/graphics/nvn/gfx/nvn/rb_look_budget.h
new file mode 100644
index 0000000..2c3f67f
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_look_budget.h
@@ -0,0 +1,29 @@
+#ifndef RB_LOOK_BUDGET_H
+#define RB_LOOK_BUDGET_H
+#include <stdint.h>
+
+enum { RB_LOOK_BUDGET_NS = 2000000, RB_LOOK_RETURN_NS = 50000, RB_LOOK_NEGATIVE_SLOTS = 128 };
+typedef struct {
+    uint64_t submission, spent, start, deadline;
+    unsigned scans;
+} rb_look_budget;
+
+static inline int rb_look_begin(rb_look_budget *b, uint64_t sub, uint64_t now, int retry) {
+    if (sub != b->submission) *b = (rb_look_budget){.submission=sub};
+    if (b->deadline || b->scans >= (retry ? 2u : 1u) ||
+        b->spent >= RB_LOOK_BUDGET_NS - RB_LOOK_RETURN_NS) return 0;
+    b->scans++;
+    b->start = now;
+    b->deadline = now + RB_LOOK_BUDGET_NS - RB_LOOK_RETURN_NS - b->spent;
+    return 1;
+}
+static inline void rb_look_finish(rb_look_budget *b, uint64_t now) {
+    b->spent += now - b->start;
+    b->deadline = 0;
+}
+typedef struct { uint64_t serial, libraries, programs; } rb_look_miss;
+static inline int rb_look_still_missing(const rb_look_miss *m, uint64_t serial,
+                                         uint64_t libraries, uint64_t programs) {
+    return serial && m->serial == serial && m->libraries == libraries && m->programs == programs;
+}
+#endif
