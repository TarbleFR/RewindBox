new file mode 100644
index 0000000..522f4b3
--- /dev/null
+++ b/graphics/nvn/tests/rb_look_flight.inc
@@ -0,0 +1,35 @@
+// Exercise the actual Metal-backend scanner with host-generated command
+// records. None of these serials has guest shader bytes to fall back to.
+static void rb_test_look_scan(void) {
+    unsigned old_scope=rb_test_first_scope;
+    const uint8_t *old_next=g_exec_next;
+    uint64_t sub=g_sub_serial, old_hits=g_look_memo_hits;
+    rb_look_budget prior=g_look_budget;
+    rb_test_first_scope=1;
+    struct { op_hdr bind; p_bind_program_id program; } rec={
+        {OP_BIND_PROGRAM,8+sizeof(p_bind_program_id)},
+        {.prog=(const prog_t *)(uintptr_t)1,.serial=UINT64_C(0xff001234568),.stages=3}
+    };
+    struct { typeof(rec) bind[3]; op_hdr end; } list={.bind={rec,rec,rec},.end={OP_END,8}};
+    g_exec_next=(const uint8_t *)&list;
+    g_sub_serial++; g_look_budget=(rb_look_budget){0};
+    uint64_t calls=g_ppr_n, textures=g_tex_mtl_n;
+    pso_predict_rest(NULL);
+    CHECK(g_ppr_n==calls+1 && g_look_memo_hits>=old_hits+2 && g_tex_mtl_n==textures,
+          "a repeated unresolved bind uses the negative serial cache without materializing a texture");
+    NvProg *ready=[NvProg new];
+    serial_put_kind(rec.program.serial,ready,YES);
+    CHECK(rb_look_program(rec.program.serial)==ready,"program publication invalidates the negative prediction");
+    serial_del_kind(rec.program.serial,YES);
+    // Even pathological guest jumps obey the shared deadline inside fz_next.
+    struct { op_hdr op; const void *destination; } loop={{OP_JUMP,16},NULL};
+    loop.destination=&loop;
+    fz_cursor cursor={.p=(const uint8_t *)&loop};
+    CHECK(!fz_next_until(&cursor,NULL,NULL,NULL,bp_now()+1000000) && !cursor.bad && cursor.p==(const uint8_t *)&loop,
+          "the deadline interrupts a cycle consisting entirely of JUMP records");
+    g_look_budget=(rb_look_budget){0}; g_sub_serial++;
+    g_exec_next=(const uint8_t *)&list.end; calls=g_ppr_n;
+    pso_predict_rest(NULL); pso_predict_rest(NULL); pso_predict_rest(NULL);
+    CHECK(g_ppr_n==calls+(rb_look_again_on()?2:1),"all origins share the initial scan and at most one retry");
+    g_exec_next=old_next; g_sub_serial=sub; g_look_budget=prior; rb_test_first_scope=old_scope;
+}
