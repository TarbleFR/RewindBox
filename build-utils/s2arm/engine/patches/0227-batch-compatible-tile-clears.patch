diff --git a/graphics/nvn/gfx/nvn/rb_clear_batch.h b/graphics/nvn/gfx/nvn/rb_clear_batch.h
new file mode 100644
index 0000000..4aea91c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_clear_batch.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+
+typedef struct {
+    uint64_t start, size;
+    uintptr_t backing;
+    uint32_t width, height;
+    unsigned bytes, depth;
+} rb_clear_plane;
+
+typedef struct {
+    rb_clear_plane planes[9];
+    unsigned count, colors, depths, bytes;
+} rb_clear_batch;
+
+// All attachments are ordinary single-sample, level-zero planes checked by the
+// caller. The conservative byte limit also bounds the tile footprint of the MRT.
+static inline int rb_clear_batch_add(rb_clear_batch *b, rb_clear_plane p) {
+    if (!p.start || !p.size || p.size > UINT64_MAX-p.start || !p.backing ||
+        !p.width || !p.height || !p.bytes || p.bytes>8 || b->bytes+p.bytes>32 ||
+        b->count>=9 || (p.depth ? b->depths!=0 : b->colors>=8)) return 0;
+    for (unsigned i=0; i<b->count; i++) {
+        const rb_clear_plane *q=&b->planes[i];
+        if (q->width!=p.width || q->height!=p.height || q->backing==p.backing ||
+            (q->start<p.start+p.size && p.start<q->start+q->size)) return 0;
+    }
+    b->planes[b->count++]=p;
+    if (p.depth) b->depths++; else b->colors++;
+    b->bytes+=p.bytes;
+    return 1;
+}
+
+static inline int rb_clear_disjoint_masks(unsigned targets, unsigned first, unsigned second) {
+    return targets && !(targets & ~0x1ffu) && first && second && !(first & second) &&
+           (first | second)==targets;
+}
diff --git a/graphics/nvn/tests/t_rb_clear_batch.c b/graphics/nvn/tests/t_rb_clear_batch.c
new file mode 100644
index 0000000..2cc8264
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_clear_batch.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+// cc -std=c11 -Wall -Werror tests/t_rb_clear_batch.c -o /tmp/t_rb_clear_batch
+#include "../gfx/nvn/rb_clear_batch.h"
+#include <assert.h>
+#include <stdio.h>
+
+static rb_clear_plane target(unsigned index, unsigned bpp) {
+    return (rb_clear_plane){0x100000ull * (index+1), 0x100000, 0x2000+index,960,540,bpp,0};
+}
+int main(void) {
+    assert(rb_clear_disjoint_masks(3,1,2)); // two colors of the same MRT
+    assert(rb_clear_disjoint_masks(0x101,0x100,1)); // depth + color
+    assert(!rb_clear_disjoint_masks(3,1,1)); // would erase the order of two writes
+    assert(!rb_clear_disjoint_masks(7,1,2)); // an untouched plane needs its own load
+    assert(!rb_clear_disjoint_masks(3,0,3));
+    rb_clear_batch batch={0};
+    rb_clear_plane depth=target(0,4); depth.depth=1;
+    assert(rb_clear_batch_add(&batch,depth));
+    for (unsigned i=1; i<=6; i++) assert(rb_clear_batch_add(&batch,target(i,4)));
+    assert(batch.colors==6 && batch.depths==1 && batch.bytes==28);
+    rb_clear_plane different=target(7,4);
+    different.width=1920; assert(!rb_clear_batch_add(&batch,different)); different.width=960;
+    different.height=1080; assert(!rb_clear_batch_add(&batch,different)); different.height=540;
+    different.depth=1; assert(!rb_clear_batch_add(&batch,different)); different.depth=0;
+    different.backing=depth.backing; assert(!rb_clear_batch_add(&batch,different)); different=target(7,4);
+    different.start=depth.start+depth.size-1; assert(!rb_clear_batch_add(&batch,different));
+    different.start=UINT64_MAX-4; assert(!rb_clear_batch_add(&batch,different));
+    assert(!rb_clear_batch_add(&batch,target(7,8))); // tile footprint
+    assert(rb_clear_batch_add(&batch,target(7,4)));
+    assert(!rb_clear_batch_add(&batch,target(8,1)));
+    rb_clear_batch eight={0};
+    for (unsigned i=0; i<8; i++) assert(rb_clear_batch_add(&eight,target(i,1)));
+    assert(!rb_clear_batch_add(&eight,target(8,1)));
+    assert(!rb_clear_batch_add(&eight,(rb_clear_plane){0}));
+    assert(eight.colors==8 && eight.bytes==8);
+    puts("clear batches: disjoint intervals, exact domains, MRT limits and rejected cases passed");
+}
diff --git a/graphics/nvn/tests/t_rb_clear_batch_metal.m b/graphics/nvn/tests/t_rb_clear_batch_metal.m
new file mode 100644
index 0000000..62009f2
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_clear_batch_metal.m
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: MIT
+// make native-test-rb_clear_batch_metal on macOS.
+#include "../gfx/nvn/nvn_mtl.m"
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"clear batch: %s (line %d)\n",#x,__LINE__); exit(1); } } while (0)
+enum { WIDTH=32, HEIGHT=8, POOL_BYTES=1<<20 };
+typedef float ClearImage[2][HEIGHT][WIDTH];
+static const double colors[2]={0.125,0.75};
+static tex_t targets[2];
+static pool_t pool;
+
+static void read_pair(id<MTLDevice> dev, id<MTLTexture> a, id<MTLTexture> b, ClearImage out) {
+    id<MTLCommandQueue> q=[dev newCommandQueue]; id<MTLCommandBuffer> cb=[q commandBuffer];
+    id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];
+    id<MTLBuffer> read=[dev newBufferWithLength:2*256*HEIGHT options:MTLResourceStorageModeShared];
+    CHECK(read && blit);
+    for (int i=0; i<2; i++)
+        [blit copyFromTexture:i ? b : a sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+            sourceSize:MTLSizeMake(WIDTH,HEIGHT,1) toBuffer:read destinationOffset:i*256*HEIGHT
+            destinationBytesPerRow:256 destinationBytesPerImage:256*HEIGHT];
+    [blit endEncoding]; [cb commit]; [cb waitUntilCompleted]; CHECK(cb.status==MTLCommandBufferStatusCompleted);
+    float *v=read.contents;
+    for (int i=0; i<2; i++) for (int y=0; y<HEIGHT; y++) for (int x=0; x<WIDTH; x++) {
+        out[i][y][x]=v[(i*HEIGHT+y)*64+x]; CHECK(out[i][y][x]==(float)colors[i]);
+    }
+}
+static void native_pair(int mode, ClearImage out) {
+    nvn_be_sub_begin(); state_reset();
+    lc_group poison={0}; poison.rt.n=2;
+    for (int i=0; i<2; i++) {
+        poison.rt.color[i]=&targets[i]; poison.clear_c[i]=1; poison.cc[i]=MTLClearColorMake(-0.5,0,0,1);
+    }
+    lc_apply(&poison); CHECK(rp_begin_ex(1)); rp_end();
+    lc_group a={0}, b={0};
+    a.rt.n=1; a.rt.color[0]=&targets[0]; a.clear_c[0]=1; a.cc[0]=MTLClearColorMake(colors[0],0,0,1);
+    if (mode==1) {
+        b.rt.n=1; b.rt.color[0]=&targets[1]; b.clear_c[0]=1; b.cc[0]=MTLClearColorMake(colors[1],0,0,1);
+    } else {
+        a.rt.n=2; a.rt.color[1]=&targets[1];
+        b.rt=a.rt; b.clear_c[1]=1; b.cc[1]=MTLClearColorMake(colors[1],0,0,1);
+    }
+    if (mode) {
+        CHECK(!rb_clear_combine(&a,&a));  // same subresource and duplicate clear
+        if (mode==2) CHECK(rt_same(&a.rt,&b.rt));
+        CHECK(rb_clear_combine(&a,&b));
+    } else {
+        lc_apply(&a); CHECK(rp_begin_ex(1)); rp_end();
+        lc_apply(&b); CHECK(rp_begin_ex(1)); rp_end();
+    }
+    uint64_t fence=nvn_be_sub_commit();
+    CHECK(nvn_be_wait(fence,10000000000ull) && !mtl_last_commit_error());
+    read_pair(g_dev,tex_mtl(&targets[0]),tex_mtl(&targets[1]),out);
+}
+static void tracked_pair(id<MTLDevice> dev, int combined, ClearImage out) {
+    MTLTextureDescriptor *d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Float
+                                                                           width:WIDTH height:HEIGHT mipmapped:NO];
+    d.storageMode=MTLStorageModePrivate; d.usage=MTLTextureUsageRenderTarget;
+    id<MTLTexture> t[2]={[dev newTextureWithDescriptor:d],[dev newTextureWithDescriptor:d]};
+    CHECK(t[0] && t[1]);
+    if (combined) {
+        rb_clear_batch batch={0};
+        rb_clear_plane a={0x100000,65536,(uintptr_t)(__bridge void *)t[0],WIDTH,HEIGHT,4,0};
+        rb_clear_plane b={0x110000,65536,(uintptr_t)(__bridge void *)t[1],WIDTH,HEIGHT,4,0};
+        CHECK(rb_clear_disjoint_masks(3,1,2) && rb_clear_batch_add(&batch,a));
+        CHECK(!rb_clear_batch_add(&batch,a) && rb_clear_batch_add(&batch,b));
+    }
+    id<MTLCommandQueue> q=[dev newCommandQueue]; id<MTLCommandBuffer> cb=[q commandBuffer]; CHECK(cb);
+    MTLRenderPassDescriptor *poison=[MTLRenderPassDescriptor renderPassDescriptor];
+    for (int i=0; i<2; i++) {
+        MTLRenderPassColorAttachmentDescriptor *at=poison.colorAttachments[i];
+        at.texture=t[i]; at.loadAction=MTLLoadActionClear; at.storeAction=MTLStoreActionStore;
+        at.clearColor=MTLClearColorMake(-0.5,0,0,1);
+    }
+    id<MTLRenderCommandEncoder> reset=[cb renderCommandEncoderWithDescriptor:poison]; CHECK(reset); [reset endEncoding];
+    for (int p=0; p<(combined ? 1 : 2); p++) {
+        MTLRenderPassDescriptor *pass=[MTLRenderPassDescriptor renderPassDescriptor];
+        for (int i=0; i<2; i++) if (combined || p==i) {
+            MTLRenderPassColorAttachmentDescriptor *at=pass.colorAttachments[i];
+            at.texture=t[i]; at.loadAction=MTLLoadActionClear; at.storeAction=MTLStoreActionStore;
+            at.clearColor=MTLClearColorMake(colors[i],0,0,1);
+        }
+        id<MTLRenderCommandEncoder> enc=[cb renderCommandEncoderWithDescriptor:pass]; CHECK(enc); [enc endEncoding];
+    }
+    [cb commit]; [cb waitUntilCompleted]; CHECK(cb.status==MTLCommandBufferStatusCompleted);
+    read_pair(dev,t[0],t[1],out);
+}
+int main(void) { @autoreleasepool {
+    id<MTLDevice> dev=MTLCreateSystemDefaultDevice(); CHECK(dev);
+    BOOL direct=NO;
+    if (@available(macOS 26.0, iOS 26.0, *)) {
+        MTLResidencySetDescriptor *rd=[MTLResidencySetDescriptor new]; rd.initialCapacity=4;
+        direct=dev.hasUnifiedMemory && [dev supportsFamily:MTLGPUFamilyMetal4] &&
+               [dev newResidencySetWithDescriptor:rd error:NULL]!=nil &&
+               [dev newMTL4CommandQueueWithDescriptor:[MTL4CommandQueueDescriptor new] error:NULL]!=nil;
+    }
+    ClearImage before,after;
+    if (!direct) {
+        tracked_pair(dev,0,before); tracked_pair(dev,1,after); CHECK(!memcmp(before,after,sizeof before));
+        puts("PASS tracked Metal: identical MRT clear/store results and alias rejection; direct Metal 4 unavailable");
+        return 0;
+    }
+    mtl_init(); CHECK(!g_m3);
+    const op_hdr end={OP_END,sizeof(op_hdr)}; nvn_be_exec((const uint8_t *)&end);
+    uint8_t *mem=NULL; CHECK(!posix_memalign((void **)&mem,65536,POOL_BYTES)); memset(mem,0,POOL_BYTES);
+    pool=(pool_t){.magic=MAGIC('P','O','O','L'),.flags=NVN_MEMORY_POOL_FLAGS_CPU_NO_ACCESS|NVN_MEMORY_POOL_FLAGS_GPU_CACHED,
+                  .mem=mem,.size=POOL_BYTES}; nvn_be_pool_add(mem,POOL_BYTES);
+    for (int i=0; i<2; i++) {
+        tex_t *t=&targets[i]; t->magic=MAGIC('T','E','X',0); t->serial=nvn_new_serial();
+        t->d=(nvn_texdesc){.target=NVN_TEXTURE_TARGET_2D,.format=NVN_FORMAT_R32F,.width=WIDTH,.height=HEIGHT,.depth=1,.levels=1};
+        t->pool=&pool; t->off=i*65536; t->mem=mem+t->off;
+        nvn_tex_layout(&t->d,&t->L); nvn_be_tex_init(t); CHECK(tex_mtl(t));
+    }
+    native_pair(0,before);
+    for (int mode=1; mode<=2; mode++) { native_pair(mode,after); CHECK(!memcmp(before,after,sizeof before)); }
+    puts("PASS direct Metal 4: distinct/same target sets, alias rejection, both images identical");
+    return 0;
+} }
