diff --git a/ios/extdisplay.m b/ios/extdisplay.m
index 2ccf06a..309cc95 100644
--- a/ios/extdisplay.m
+++ b/ios/extdisplay.m
@@ -74,6 +74,9 @@ UIView *s2a_ios_present_view(void) {
 // 游戏界面控制器建好时登记外接屏场景配件（主线程）。返回登记对象，由控制器持有（控制器放掉 = 登记跟着没）；iOS 27 以下 / 不接管返回 nil
 id s2a_ios_ext_register(UIViewController *vc) {
     if (!vc || !ext_on()) return nil;
