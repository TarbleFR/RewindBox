+++ b/graphics/nvn/tests/t_rb_adaptive_drs.c
@@ -79,6 +79,44 @@ int main(void) {
     assert(rb_drs_floor_push(&fl, g++, 2073600) && rb_drs_floor_push(&fl, g++, 1500000) && rb_drs_floor_push(&fl, g++, 873600));
     for (int i = 0; i < RB_DRS_FLOOR_STALL; ++i) assert(rb_drs_floor_push(&fl, g++, 873600));
     assert(fl.resting && fl.rests == 3 && fl.floor == 873600 && !rb_drs_floor_push(&fl, g + 100000, 873600));
+    // A game locked at 30 is offered the 60 fps hold: only one that alternates
+    // its interval, after 60 frames, for 30 frames, twice as late after a failure.
+    rb_drs_trial tr = {0};
+    uint64_t h = 1000, ch = 0;
+    for (int i = 0; i < 2000; ++i) assert(!rb_drs_trial_step(&tr, h++, 30, 3, 1));   // 30 by design: three changes in all
+    assert(!tr.adaptive && !tr.trials);
+    for (int i = 0; i < 300; ++i) assert(!rb_drs_trial_step(&tr, h++, 60, ch += i % 2, 1));   // alternating at 60
+    assert(tr.adaptive && !tr.trials && !tr.tried);
+    assert(!rb_drs_trial_step(&tr, h, 30, ch, 1) && tr.next_at == h + RB_DRS_TRIAL_WAIT);   // the lock begins
+    assert(!rb_drs_trial_step(&tr, h, 30, ch, 1));   // a frame counts once
+    for (++h; h < tr.next_at; ++h) assert(!rb_drs_trial_step(&tr, h, 30, ch, 1));
+    assert(rb_drs_trial_step(&tr, h, 30, ch, 1) && tr.trials == 1 && tr.until == h + RB_DRS_TRIAL_FRAMES);
+    assert(rb_drs_trial_step(&tr, h, 30, ch, 1));
+    // The game answers with interval 1: the trial's remaining frames keep the hold at a target of 60.
+    uint64_t end = tr.until;
+    for (++h; h < end; ++h) assert(rb_drs_trial_step(&tr, h, 60, ch, 1));
+    assert(!rb_drs_trial_step(&tr, h++, 60, ch, 1));   // then the times as they are
+    for (int i = 0; i < 100; ++i) assert(!rb_drs_trial_step(&tr, h++, 60, ch, 1));
+    assert(tr.tried && !tr.kept);
+    // Back at 30 before 300 frames at 60: the next trial waits twice as long, up to 960 frames.
+    for (uint64_t wait = 2 * RB_DRS_TRIAL_WAIT;; wait = wait * 2 < RB_DRS_TRIAL_WAIT_MAX ? wait * 2 : RB_DRS_TRIAL_WAIT_MAX) {
+        assert(!rb_drs_trial_step(&tr, h, 30, ch, 1) && tr.wait == wait && tr.next_at == h + wait);
+        for (++h; h < tr.next_at; ++h) assert(!rb_drs_trial_step(&tr, h, 30, ch, 1));
+        for (int i = 0; i < RB_DRS_TRIAL_FRAMES; ++i) assert(rb_drs_trial_step(&tr, h++, 30, ch, 1));   // the game does not answer
+        if (wait == RB_DRS_TRIAL_WAIT_MAX && tr.trials >= 8) break;
+    }
+    assert(tr.wait == RB_DRS_TRIAL_WAIT_MAX);
+    // A user limit, a video or Critical: no trial, and none pending when it lifts.
+    for (int i = 0; i < 3000; ++i) assert(!rb_drs_trial_step(&tr, h++, 30, ch, 0));
+    uint64_t before = tr.trials;
+    assert(!rb_drs_trial_step(&tr, h, 30, ch, 1) && tr.next_at == h + RB_DRS_TRIAL_WAIT_MAX && tr.trials == before);
+    for (++h; h < tr.next_at; ++h) assert(!rb_drs_trial_step(&tr, h, 30, ch, 1));
+    assert(rb_drs_trial_step(&tr, h++, 30, ch, 1) && tr.trials == before + 1);
+    // 300 frames at 60 after a trial: it held, and a later lock starts from the first wait again.
+    for (int i = 0; i < RB_DRS_TRIAL_KEPT + RB_DRS_TRIAL_FRAMES; ++i) rb_drs_trial_step(&tr, h++, 60, ch, 1);
+    assert(tr.kept == 1 && !tr.tried && !tr.wait);
+    assert(!rb_drs_trial_step(&tr, h, 30, ch, 1) && tr.next_at == h + RB_DRS_TRIAL_WAIT);
+    puts("PASS guest DRS trial: only an alternating game, 60 then 30 frames, hold kept through the answer, doubled waits, limits, a kept trial");
     puts("PASS guest DRS floor: unknown size, one count a frame, stall at the smallest size, rest at the floor, retry above it");
     puts("PASS guest DRS: measured medians/tails, hold at Fair, 18.675/20.5 ms steps, Serious push, disjoint samples, invalid windows, hysteresis, 30 Hz and off");
 }
