diff --git a/graphics/nvn/gfx/nvn/rb_adaptive_drs.h b/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
index cd296e8..71a632f 100644
--- a/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
+++ b/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
@@ -113,3 +113,53 @@ static inline int rb_drs_floor_push(rb_drs_floor *s, uint64_t frame, uint64_t pi
     if (!s->floor || s->run_min < s->floor) s->floor = s->run_min;
     return 1;
 }
+// Once the game has asked for present interval 2 for a second, the hold follows
+// it to 33.2 ms and every report from 16.6 to 33.2 ms reads 33.2 ms. A game
+// that picks each frame's interval from the time it read cannot read a time
+// under its 60 fps budget again, and the GPU slows to that pace: an iPhone at
+// Fair drew the same 127 passes in 9.9 ms at interval 1 and in 24.5 ms inside
+// the lock, an 8x8 pass in 78 then 222 microseconds. A trial gives such a game
+// the 60 fps hold for RB_DRS_TRIAL_FRAMES frames. If the GPU keeps up the game
+// stays at interval 1; if not, its own readings send it back and the next
+// trial waits twice as long. Only a game seen to alternate its interval is
+// tried: a title that runs at 30 by design changes it a few times a session.
+enum { RB_DRS_TRIAL_FRAMES = 30, RB_DRS_TRIAL_WAIT = 60, RB_DRS_TRIAL_WAIT_MAX = 960,
+       RB_DRS_TRIAL_CHANGES = 8, RB_DRS_TRIAL_WINDOW = 600, RB_DRS_TRIAL_KEPT = 300 };
+typedef struct {
+    uint64_t seen, mark_frame, mark_changes, prior_changes;   // seen, mark_frame: a frame + 1
+    uint64_t wait, next_at, until, at60;                      // at60: the frame + 1 the target last became 60
+    uint64_t trials, kept;
+    int adaptive, tried, decision;
+} rb_drs_trial;
+// Whether the reports of `frame` take the 60 fps hold whatever their time.
+// fps: the engine's target (30 once the game holds interval 2). changes: the
+// present interval changes the game has made so far. allowed: no user limit,
+// no video pacing, not at Critical.
+static inline int rb_drs_trial_step(rb_drs_trial *s, uint64_t frame, int fps, uint64_t changes, int allowed) {
+    if (s->seen == frame + 1) return s->decision;
+    s->seen = frame + 1;
+    if (!s->mark_frame || frame + 1 - s->mark_frame >= RB_DRS_TRIAL_WINDOW) {
+        s->prior_changes = s->mark_frame ? changes - s->mark_changes : 0;
+        s->mark_frame = frame + 1; s->mark_changes = changes;
+    }
+    if (changes - s->mark_changes + s->prior_changes >= RB_DRS_TRIAL_CHANGES) s->adaptive = 1;
+    const int running = frame < s->until;
+    if (fps != 30) {
+        if (!s->at60) s->at60 = frame + 1;
+        if (s->tried && frame + 1 - s->at60 >= RB_DRS_TRIAL_KEPT) { s->tried = 0; s->wait = 0; ++s->kept; }
+        s->next_at = 0;
+        return s->decision = running;
+    }
+    s->at60 = 0;
+    if (running) return s->decision = 1;
+    if (!allowed || !s->adaptive) { s->next_at = 0; return s->decision = 0; }
+    if (!s->next_at) {
+        if (!s->wait) s->wait = RB_DRS_TRIAL_WAIT;
+        else if (s->tried) s->wait = s->wait * 2 < RB_DRS_TRIAL_WAIT_MAX ? s->wait * 2 : RB_DRS_TRIAL_WAIT_MAX;
+        s->next_at = frame + s->wait;
+        return s->decision = 0;
+    }
+    if (frame < s->next_at) return s->decision = 0;
+    s->until = frame + RB_DRS_TRIAL_FRAMES; s->next_at = 0; s->tried = 1; ++s->trials;
+    return s->decision = 1;
+}
diff --git a/graphics/nvn/tests/t_rb_adaptive_drs.c b/graphics/nvn/tests/t_rb_adaptive_drs.c
index a7cfcc6..a33543c 100644
