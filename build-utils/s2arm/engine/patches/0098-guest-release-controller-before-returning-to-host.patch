+// RewindBox (patch 0098): enqueued before the bridge's callback on the same main
+// queue. setForeground:NO releases the system handler and pauses BLE feedback.
+// The existing restart_done restores foreground and attaches on the resume.
+void s2a_rb_guest_input_release(void);
+void s2a_rb_guest_input_release(void) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        s2a_controller_set_foreground(0);
+        LOG("RewindBox (patch 0098): released game input before returning to the host");
+    });
+}
