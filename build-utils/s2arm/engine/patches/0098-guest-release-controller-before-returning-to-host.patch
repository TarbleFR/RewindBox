diff --git a/runtime/src/rb_guest.c b/runtime/src/rb_guest.c
--- a/runtime/src/rb_guest.c
+++ b/runtime/src/rb_guest.c
@@ -23,6 +23,18 @@
 int s2a_rb_guest_log_open(const char *dir);   // os.c: the engine's log file in docs (the constructor redirected nothing)
 void s2a_host_shutdown(const char *why);      // lifecycle.c

+// RewindBox (patch 0098): IPA 783 had 0 parked Mario Kart World stops out of 1 menu
+// stop. On the restored park path, the host and the game share the single native
+// valueChangedHandler slot per controller. Drop S2Arm's ownership before announcing
+// the return, so the resume attaches it again even with the same controller connected.
+// S2A_RB_PARK_INPUT=0 preserves the old controller lifecycle.
+extern void s2a_rb_guest_input_release(void) __attribute__((weak_import));
+static void release_guest_input(void) {
+    const char *setting = getenv("S2A_RB_PARK_INPUT");
+    if (s2a_rb_guest_input_release && !(setting && !strcmp(setting, "0")))
+        s2a_rb_guest_input_release();
+}
+
 static _Atomic int g_on;        // 1 once s2a_rb_guest_configure passed its checks (before the launch context and the window)
 static _Atomic int g_ended;     // the session is over and the host was told (session_ended sent at most once)
 static _Atomic int g_term;      // the process itself ends: 1 = SIGTERM (exit as S2Arm does), 2 = the app terminates (back to UIKit)
@@ -89,6 +101,7 @@
     if (!s2a_rb_guest_on() || atomic_exchange(&g_ended, 1)) return;
     LOG("RewindBox guest: session ended, code %d (%s)", code, why && *why ? why : "-");
     s2a_logcon_flush();
+    release_guest_input();
     if (g_cfg.session_ended) g_cfg.session_ended(code, why ? why : "", g_cfg.ended_context);
 }

@@ -133,6 +146,7 @@
         LOG("RewindBox guest: session parked (%s); the same game can resume in this process", why);
         s2a_sesmark_rest_home(1);   // patch 0018: at rest, as after an orderly end: the diagnostics question is not asked for a game the player quit
         s2a_logcon_flush();
+        release_guest_input();
         if (g_cfg.session_parked) g_cfg.session_parked(why, g_cfg.parked_context);   // the host copies the reason
         free((void *)why);
         return;
