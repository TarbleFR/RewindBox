new file mode 100644
index 0000000..315e5bc
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_raster_clear.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include "nvn_obj.h"
+// Only values that cannot change the attachments, scissor, clear mask, queue
+// order or a resource. Unknown records stop the proof; no call/jump is followed.
+static inline const uint8_t *rb_raster_then_clear(const uint8_t *p) {
+    int raster=0;
+    for (unsigned i=0;p && i<8;i++) {
+        op_hdr h; memcpy(&h,p,8);
+        if (h.op==OP_VIEWPORTS && h.size==8+sizeof(p_viewports)) {
+            p_viewports v; memcpy(&v,p+8,sizeof v);
+            if (v.first<0 || v.n<1 || v.n>16 || v.first>16-v.n) return NULL;
+            raster=1;
+        } else if (h.op==OP_DEPTH_RANGE && h.size==8+sizeof(p_depth_range)) raster=1;
+        else if ((h.op==OP_ALPHA_REF && h.size==8+sizeof(p_alpha_ref)) ||
+                 (h.op==OP_BLEND_COLOR && h.size==8+sizeof(p_blend_color))) { }
+        else if (raster && ((h.op==OP_CLEAR_COLOR && h.size==8+sizeof(p_clear_color)) ||
+                            (h.op==OP_CLEAR_DS && h.size==8+sizeof(p_clear_ds)))) return p;
+        else return NULL;
+        p+=h.size;
+    }
+    return NULL;
+}
