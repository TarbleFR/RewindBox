+    for (int w = RB_ARGS_WHY_MODE; w < RB_ARGS_WHY_N; w++) if (w != RB_ARGS_WHY_PUSH && w != RB_ARGS_WHY_OWNER) assert(n_why[w] > 0);
+    const unsigned long part_on = n_part, full_on = n_full, reuse_on = n_reuse;
+    // … other seeds
+    for (uint32_t seed = 1; seed <= 6; seed++) { replay(RB_ARGS_MODE_ON, MUT_NONE, seed * 7919u, 300000); assert(n_wrong == 0 && n_part > 0); }
+    // Off: never in part, the mark is never RB_ARGS_UNIFORM (every rebuild is the full walk, as before), and the same draws reuse the same blocks
+    replay(RB_ARGS_MODE_OFF, MUT_NONE, 0x0325u, 1500000);
+    assert(n_wrong == 0 && n_part == 0 && n_check == 0 && n_reuse == reuse_on && n_full == part_on + full_on);
+    assert(n_why[RB_ARGS_WHY_OFF] == n_full);
+    // Check: the same decisions as on, each would-be partial rebuild made in full, and the comparison never differs
+    replay(RB_ARGS_MODE_CHECK, MUT_NONE, 0x0325u, 1500000);
+    assert(n_wrong == 0 && n_part == 0 && n_check == part_on && n_full == part_on + full_on && n_reuse == reuse_on);
+    // ⑥ each guard matters: with one of them broken the replay hands out a wrong block (and the check mode's comparison sees it, where it is about a kept entry)
+    replay(RB_ARGS_MODE_ON, MUT_LOWER_FULL, 0x0325u, 300000); assert(n_wrong > 0);            // a uniform binding lowering a full mark
+    replay(RB_ARGS_MODE_ON, MUT_NO_SERIAL, 0x0325u, 300000); assert(n_wrong > 0);             // a texture's storage replaced without a mark
+    replay(RB_ARGS_MODE_ON, MUT_KEEP_ROWS, 0x0325u, 300000); assert(n_wrong > 0);             // a rows / buffer texture binding kept
+    replay(RB_ARGS_MODE_ON, MUT_KEEP_UNIFORM_HANDLE, 0x0325u, 300000); assert(n_wrong > 0);   // a handle read from uniform memory kept
+    replay(RB_ARGS_MODE_CHECK, MUT_NO_SERIAL, 0x0325u, 300000); assert(n_wrong > 0);
+    replay(RB_ARGS_MODE_CHECK, MUT_LOWER_FULL, 0x0325u, 300000); assert(n_wrong > 0);
+    // ⑦ the owner: shader A builds, a texture is bound, another shader B takes the stage without a program mark and builds (it consumes the mark), a uniform is
