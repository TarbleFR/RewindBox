+    // ⑧ the base instance alone: a shader that reads it and a clean stage go in part (the driver table is walked again), one that does not read it reuses
+    g_mode = RB_ARGS_MODE_ON; g_mut = MUT_NONE; n_wrong = n_part = n_full = n_reuse = 0; memset(n_why, 0, sizeof n_why);
+    memset(&W, 0, sizeof W); make_shaders(); W.pass = W.sub = W.agen = W.ser = W.pkg = 1; W.subst_tex = -1; W.dirty[0] = W.dirty[1] = RB_ARGS_FULL;
