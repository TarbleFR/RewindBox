+    for (int broken = 0; broken < 2; broken++) {
+        g_mode = RB_ARGS_MODE_ON; g_mut = broken ? MUT_NO_OWNER : MUT_NONE; n_wrong = n_part = n_full = n_reuse = 0; memset(n_why, 0, sizeof n_why);
+        memset(&W, 0, sizeof W); make_shaders(); W.pass = W.sub = W.agen = W.ser = W.pkg = 1; W.subst_tex = -1; W.dirty[0] = W.dirty[1] = RB_ARGS_FULL;
+        for (int i = 0; i < NTEXID; i++) { W.view[i] = 100 + (uint64_t)i; W.sampv[i] = (uint64_t)i; }
+        W.cur[1] = 0; encode(1);                                   // A, in full
+        W.cur[1] = 3; encode(1);                                   // B takes the stage unmarked: the old reuse test fails (B has no block), B builds in full
+        W.tex[1][0] = 5; mark_full(1, RB_ARGS_C_HANDLES); encode(1);   // a texture bound, B rebuilds and clears the mark
+        W.ubo[1][0] = 64; mark_uniform(1);
+        W.cur[1] = 0; encode(1);                                   // A again, the mark says uniform only
