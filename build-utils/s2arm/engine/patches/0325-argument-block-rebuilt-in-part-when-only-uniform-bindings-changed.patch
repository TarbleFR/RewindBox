+      for (int i = 0; i < 6; i++) { acc |= (unsigned)cause[i]; g = ok; g.dirty = RB_ARGS_FULL; g.causes = (uint8_t)acc; assert(rb_args_why(&g) == why[i]); } }   // the first that applies, in the line's order
