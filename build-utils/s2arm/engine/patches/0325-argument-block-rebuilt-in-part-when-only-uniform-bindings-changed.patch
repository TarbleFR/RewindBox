diff --git a/graphics/nvn/gfx/nvn/rb_args_ubo.h b/graphics/nvn/gfx/nvn/rb_args_ubo.h
new file mode 100644
index 0000000..4b3551c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_args_ubo.h
@@ -0,0 +1,97 @@
+// RewindBox (patch 0325): when a stage's argument block may be rebuilt in part, and which of its entries are then taken from the block before (nvn_mtl.m
+//   encode_args_). Pure C: tests/t_rb_args_ubo.c.
+//   IPA 827 (Mario Kart World, iPhone A18 Pro, in a race): about 40,000 submit-thread instructions per draw at 1,000 to 2,058 draws a frame; a stage's block was
+//   rebuilt in full 1.28 to 1.43 times per draw, looking up 4.4 to 5.7 texture bindings per draw again (views, type and format fits, checks, notes), while 76 to 93 %
+//   of the rebuilt blocks got a bounds table identical to the one before: the uniform buffers changed address, not shape. Until now any change marked the stage and
+//   a marked stage walked every binding.
+//   Rule. The mark has two values: RB_ARGS_FULL (anything), RB_ARGS_UNIFORM (only uniform buffer bindings changed: BindUniformBuffer, or an inline uniform update
+//   deferred inside the pass, which changes what a uniform binding resolves to). A full mark is never lowered. A marked stage is rebuilt in part when, since this
+//   same shader last encoded this same stage, in the same pass, submission and scratch generation, nothing but uniform bindings marked it (or nothing did and only
+//   the draw's base instance differs), and no texture was made, replaced or dropped meanwhile (the serial table's generation, which a storage taken over or
+//   swapped moves without marking any stage; the full walk then resolves each texture ID to the view it resolved to before). In part means: the walk skips the bindings rb_args_kept names, whose entries are copied from the shader's previous block,
+//   and runs every other binding's code exactly as the full walk does (uniform buffers, bounds tables, driver tables with the base instance, support buffer, storage
+//   buffers, push constants, handles read from uniform memory, …). Kept are the bindings whose entry depends only on the stage's bound texture and sampler handles
+//   and on registrations, each of which marks the stage in full when it changes: a sampler (SAMP, SAMPT, SAMPI) and a texture (TEX) that is neither fetched as rows
+//   nor a buffer texture. The existing reuse of a whole block rests on the same statement for every entry. Never in part: compute, geometry and tessellation blocks,
+//   a shader whose block holds a table made from its textures per draw, and while a diagnostic that walks every binding is on.
+//   S2A_RB_ARGS_UBO_ONLY=0: as before (the mark is always RB_ARGS_FULL, every rebuild a full walk). =check: every rebuild that would be in part is made in full
+//   and its kept entries compared with the previous block's; a difference stops the process with a line naming the shader, stage and entry. (The check can also
+//   stop on two views of the same texels: one texture ID read under two declared types in turn through a same-pass copy, or with S2A_RB_VIEW_KEEP=0, makes its
+//   bridging view again at each walk.)
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_ARGS_CLEAN = 0, RB_ARGS_FULL = 1, RB_ARGS_UNIFORM = 2 };          // g_args_dirty[stage]; every reader tests non-zero, every other writer writes 1
+enum { RB_ARGS_MODE_OFF = 0, RB_ARGS_MODE_ON = 1, RB_ARGS_MODE_CHECK = 2 };  // S2A_RB_ARGS_UBO_ONLY
+static inline int rb_args_mode(const char *env) {
+    if (!env) return RB_ARGS_MODE_ON;
+    if (!strcmp(env, "0")) return RB_ARGS_MODE_OFF;
+    if (!strcmp(env, "check")) return RB_ARGS_MODE_CHECK;
+    return RB_ARGS_MODE_ON;
+}
+// The mark after a uniform binding of the stage changed: a clean stage becomes uniform-only (full with the switch at 0), a marked one stays as it is
+static inline uint8_t rb_args_mark_uniform(uint8_t cur, int mode) {
+    return cur != RB_ARGS_CLEAN ? cur : mode != RB_ARGS_MODE_OFF ? RB_ARGS_UNIFORM : RB_ARGS_FULL;
+}
+
+enum { RB_AK_SAMP = 2, RB_AK_TEX = 3, RB_AK_SAMPT = 11, RB_AK_SAMPI = 15,   // nvn_refl.h NVN_RB_* (asserted equal in nvn_mtl.m and in the test)
+       RB_AK_TYPE_TBUF = 9 };                                               // MTLTextureTypeTextureBuffer (asserted in nvn_mtl.m)
+// 1 = a rebuild in part keeps this binding's entry from the previous block
+static inline int rb_args_kept(unsigned kind, unsigned f1d, unsigned dtt) {
+    if (kind == RB_AK_SAMP || kind == RB_AK_SAMPT || kind == RB_AK_SAMPI) return 1;
+    return kind == RB_AK_TEX && !f1d && dtt != RB_AK_TYPE_TBUF;
+}
+
+// What marked a stage since its last encode, for the counters (bits; a site not listed leaves none: "other")
+enum { RB_ARGS_C_UNIFORM = 1 << 0, RB_ARGS_C_PROGRAM = 1 << 1, RB_ARGS_C_HANDLES = 1 << 2, RB_ARGS_C_STORAGE = 1 << 3,
+       RB_ARGS_C_PUSH = 1 << 4, RB_ARGS_C_FEEDBACK = 1 << 5, RB_ARGS_C_REGISTRY = 1 << 6 };
+// How a rebuild is made: in part, or in full and why (the counters of the [rb-args] line, in this order)
+enum { RB_ARGS_PARTIAL = 0,
+       RB_ARGS_WHY_OFF,        // the switch is 0
+       RB_ARGS_WHY_STAGE,      // not a vertex or fragment block
+       RB_ARGS_WHY_MODE,       // a diagnostic or mode that walks every binding is on
+       RB_ARGS_WHY_SHADER,     // the shader keeps no entry, or its block holds a per-draw table
+       RB_ARGS_WHY_FIRST,      // no block of this shader for this stage in this pass, submission and scratch generation
+       RB_ARGS_WHY_SERIAL,     // a texture was made, replaced or dropped since that block, or the check period of CPU-written textures is another
+       RB_ARGS_WHY_PROGRAM,    // marked in full, by (first that applies): a program binding,
+       RB_ARGS_WHY_HANDLES,    //   a texture, sampler or image binding or a pool change,
+       RB_ARGS_WHY_STORAGE,    //   a storage buffer binding,
+       RB_ARGS_WHY_PUSH,       //   push constants,
+       RB_ARGS_WHY_FEEDBACK,   //   a same-pass feedback substitution,
+       RB_ARGS_WHY_REGISTRY,   //   a registration or a guest write to texture storage,
+       RB_ARGS_WHY_OTHER,      //   anything else (an internal draw, a state restore, …)
+       RB_ARGS_WHY_OWNER,      // not marked in full, but another shader encoded this stage since this one did
+       RB_ARGS_WHY_N };
+typedef struct {
+    uint8_t mode;         // RB_ARGS_MODE_*
+    uint8_t stage;        // nvn_stage
+    uint8_t dirty;        // g_args_dirty[stage], after the registration / guest-write generations were looked at
+    uint8_t causes;       // RB_ARGS_C_* noted for the stage since its last encode
+    uint8_t walk_all;     // a diagnostic or mode that needs every binding walked
+    uint8_t per_draw;     // the shader's block holds a table made per draw from its textures, or pool tables
+    uint8_t kept;         // the shader has a binding rb_args_kept names
+    uint8_t have;         // the shader has a previous block and its bytes
+    uint8_t same_pass, same_sub, same_arena, same_stage;   // … built in this pass, submission, scratch generation, for this stage
+    uint8_t same_views;   // … with the serial table's generation and the check period as they are now (a texture ID resolves to the view it resolved to then)
+    uint8_t owner;        // … and it is the shader whose encode last cleared this stage's mark
+} rb_args_gate;
+static inline int rb_args_why(const rb_args_gate *g) {
+    if (g->mode == RB_ARGS_MODE_OFF) return RB_ARGS_WHY_OFF;
+    if (g->stage > 1) return RB_ARGS_WHY_STAGE;
+    if (g->walk_all) return RB_ARGS_WHY_MODE;
+    if (g->per_draw || !g->kept) return RB_ARGS_WHY_SHADER;
+    if (!g->have || !g->same_pass || !g->same_sub || !g->same_arena || !g->same_stage) return RB_ARGS_WHY_FIRST;
+    if (!g->same_views) return RB_ARGS_WHY_SERIAL;
+    if (g->dirty != RB_ARGS_CLEAN && g->dirty != RB_ARGS_UNIFORM) {   // RB_ARGS_FULL, or a value this header does not know: in full
+        if (g->causes & RB_ARGS_C_PROGRAM) return RB_ARGS_WHY_PROGRAM;
+        if (g->causes & RB_ARGS_C_HANDLES) return RB_ARGS_WHY_HANDLES;
+        if (g->causes & RB_ARGS_C_STORAGE) return RB_ARGS_WHY_STORAGE;
+        if (g->causes & RB_ARGS_C_PUSH) return RB_ARGS_WHY_PUSH;
+        if (g->causes & RB_ARGS_C_FEEDBACK) return RB_ARGS_WHY_FEEDBACK;
+        if (g->causes & RB_ARGS_C_REGISTRY) return RB_ARGS_WHY_REGISTRY;
+        return RB_ARGS_WHY_OTHER;
+    }
+    if (!g->owner) return RB_ARGS_WHY_OWNER;
+    return RB_ARGS_PARTIAL;
+}
diff --git a/graphics/nvn/tests/t_rb_args_ubo.c b/graphics/nvn/tests/t_rb_args_ubo.c
new file mode 100644
index 0000000..9be7ff3
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_args_ubo.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0325): host-only checks of the partial rebuild of a stage's argument block (gfx/nvn/rb_args_ubo.h): the switch's values, the two marks, the
+//   bindings kept, the gate's table, and a replay of the engine's bookkeeping (nvn_mtl.m state_op, ubd_dirty, args_sync_dirty, encode_args_) over a small model of
+//   what the walk reads, in which every block handed to the GPU, reused, rebuilt in part or in full, must equal a full walk of the state at that draw.
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "../gfx/nvn/nvn_refl.h"
+#include "../gfx/nvn/rb_args_ubo.h"
+
+_Static_assert((int)RB_AK_SAMP == (int)NVN_RB_SAMP && (int)RB_AK_TEX == (int)NVN_RB_TEX && (int)RB_AK_SAMPT == (int)NVN_RB_SAMPT && (int)RB_AK_SAMPI == (int)NVN_RB_SAMPI, "rb_args_ubo.h kinds");
+enum { TYPE_2D = 2, TYPE_TBUF = RB_AK_TYPE_TBUF };
+
+// ---------- the model ----------
+enum { NSH = 6, NB = 10, NREG = 4, NTEXID = 8 };
+typedef struct {
+    int nb, per_draw, drv0; nvn_rbind b[NB];
+    // what the engine keeps per shader (NvShader ab_* / rb_ab_*)
+    int have, ab_stage; uint64_t prev[NB], ab_pass, ab_sub, ab_agen, ab_ser, ab_pkg; uint32_t ab_binst;
+} shader;
+static struct {
+    // what the walk reads
+    uint64_t ubo[2][NREG], ubosz[2][NREG], shadow[2][NREG], ssbo[2]; int tex[2][NREG], samp[2][NREG];
+    uint64_t view[NTEXID], sampv[NTEXID], expand; uint32_t binst; int subst_tex; uint64_t subst_view;
+    // generations and the engine's own state
+    uint64_t pass, sub, agen, ser, pkg, reg, reg_seen; int walk_all;
+    uint8_t dirty[2], causes[2]; const shader *owner[2]; int cur[2];
+} W;
+static shader SH[NSH];
+static int g_mode, g_mut;   // g_mut: one guard deliberately broken (the replay must then catch a wrong block)
+enum { MUT_NONE, MUT_LOWER_FULL, MUT_NO_SERIAL, MUT_KEEP_ROWS, MUT_KEEP_UNIFORM_HANDLE, MUT_NO_OWNER, MUT_N };
+static unsigned long n_reuse, n_part, n_full, n_wrong, n_why[RB_ARGS_WHY_N], n_check, n_stale_reuse;
+
+static uint32_t rnd_state;
+static uint32_t rnd(void) { rnd_state = rnd_state * 1664525u + 1013904223u; return rnd_state >> 8; }
+
+// one binding's entry, as the full walk computes it from the state now
+static uint64_t entry(const shader *sh, int st, const nvn_rbind *b) {
+    (void)sh;
+    switch (b->kind) {
+    case NVN_RB_CBUF: return W.ubo[st][b->reg] * 3 + W.shadow[st][b->reg];                   // the binding's address, or a deferred update's shadow
+    case NVN_RB_UBOLEN: { uint64_t h = 0; for (int r = 0; r < NREG; r++) h = h * 31 + W.ubosz[st][r]; return h; }
+    case NVN_RB_TEX: { int id = W.tex[st][b->reg]; uint64_t v = W.view[id];
+        if (st == 1 && W.subst_tex == id) v = W.subst_view;                                  // same-pass feedback: the copy instead
+        if (b->f1d || b->dtt == TYPE_TBUF) v ^= W.expand << 32;                              // rows / buffer texture: an expanded copy that may be made again
+        return v; }
+    case NVN_RB_SAMP: case NVN_RB_SAMPT: case NVN_RB_SAMPI: return 1000 + W.sampv[W.samp[st][b->reg]];
+    case NVN_RB_TEXU: return W.view[W.ubo[st][b->reg] / 16 % NTEXID];                        // a handle read from uniform memory
+    case NVN_RB_SBUFP: return W.ssbo[st] * 5;
+    case NVN_RB_DRV0: return W.binst * 7ull + W.ssbo[st];                                    // the driver table holds the base instance
+    case NVN_RB_SUPPORT: return 42;
+    default: return 7;
+    }
+}
+static void full_walk(const shader *sh, int st, uint64_t *out) { for (int i = 0; i < sh->nb; i++) out[sh->b[i].aid] = entry(sh, st, &sh->b[i]); }
+static int kept(const nvn_rbind *b) {
+    if (g_mut == MUT_KEEP_ROWS && b->kind == NVN_RB_TEX) return 1;
+    if (g_mut == MUT_KEEP_UNIFORM_HANDLE && b->kind == NVN_RB_TEXU) return 1;
+    return rb_args_kept(b->kind, b->f1d, b->dtt);
+}
+// the engine's marks (state_op, ubd_dirty, args_sync_dirty)
+static void mark_full(int st, unsigned cause) { W.dirty[st] = RB_ARGS_FULL; W.causes[st] |= (uint8_t)cause; }
+static void mark_uniform(int st) {
+    W.dirty[st] = g_mut == MUT_LOWER_FULL && g_mode ? RB_ARGS_UNIFORM : rb_args_mark_uniform(W.dirty[st], g_mode);
+    W.causes[st] |= RB_ARGS_C_UNIFORM;
+}
+// encode_args_ for one stage
+static void encode(int st) {
+    shader *sh = &SH[W.cur[st]];
+    uint64_t want[NB] = {0}, slots[NB] = {0};
+    if (W.reg != W.reg_seen) { W.reg_seen = W.reg; mark_full(0, RB_ARGS_C_REGISTRY); mark_full(1, RB_ARGS_C_REGISTRY); }   // args_sync_dirty
+    full_walk(sh, st, want);
+    if (!W.dirty[st] && sh->have && sh->ab_pass == W.pass && !(sh->drv0 && sh->ab_binst != W.binst)) {   // the reuse of the whole block, as before the patch
+        n_reuse++;
+        if (memcmp(sh->prev, want, sizeof want)) n_stale_reuse++;   // the old reuse's own exposure (a storage replaced without a mark): not this patch's, and the same in every mode
+        return;
+    }
+    rb_args_gate g; memset(&g, 0, sizeof g);
+    g.mode = (uint8_t)g_mode; g.stage = (uint8_t)st; g.dirty = W.dirty[st]; g.causes = W.causes[st]; g.walk_all = (uint8_t)W.walk_all; g.per_draw = (uint8_t)sh->per_draw;
+    for (int i = 0; i < sh->nb; i++) g.kept |= (uint8_t)kept(&sh->b[i]);
+    g.have = (uint8_t)sh->have; g.same_pass = sh->ab_pass == W.pass; g.same_sub = sh->ab_sub == W.sub; g.same_arena = sh->ab_agen == W.agen; g.same_stage = sh->ab_stage == st;
+    g.same_views = g_mut == MUT_NO_SERIAL || (sh->ab_ser == W.ser && sh->ab_pkg == W.pkg);
+    g.owner = g_mut == MUT_NO_OWNER || W.owner[st] == sh;
+    int why = rb_args_why(&g);
+    n_why[why]++;
+    const uint64_t ser0 = W.ser, pkg0 = W.pkg;
+    if (why == RB_ARGS_PARTIAL && g_mode == RB_ARGS_MODE_CHECK) {   // made in full, the kept entries compared
+        full_walk(sh, st, slots); n_check++;
+        for (int i = 0; i < sh->nb; i++) if (kept(&sh->b[i]) && slots[sh->b[i].aid] != sh->prev[sh->b[i].aid]) n_wrong++;
+        n_full++;
+    } else if (why == RB_ARGS_PARTIAL) {
+        memcpy(slots, sh->prev, sizeof slots);
+        for (int i = 0; i < sh->nb; i++) { if (kept(&sh->b[i])) continue; slots[sh->b[i].aid] = entry(sh, st, &sh->b[i]); }
+        n_part++;
+    } else { full_walk(sh, st, slots); n_full++; }
+    if (memcmp(slots, want, sizeof want)) n_wrong++;
+    memcpy(sh->prev, slots, sizeof slots);
+    sh->have = 1; sh->ab_stage = st; sh->ab_pass = W.pass; sh->ab_sub = W.sub; sh->ab_agen = W.agen; sh->ab_ser = ser0; sh->ab_pkg = pkg0; sh->ab_binst = W.binst;
+    W.dirty[st] = RB_ARGS_CLEAN; W.causes[st] = 0; W.owner[st] = sh;
+}
+static void make_shaders(void) {
+    memset(SH, 0, sizeof SH);
+    for (int s = 0; s < NSH; s++) {
+        shader *sh = &SH[s]; int n = 0;
+        #define ADD(k, r) do { sh->b[n].kind = (k); sh->b[n].reg = (uint16_t)(r); sh->b[n].aid = (uint16_t)n; sh->b[n].dtt = TYPE_2D; n++; } while (0)
+        ADD(NVN_RB_CBUF, 0); ADD(NVN_RB_CBUF, 1); ADD(NVN_RB_UBOLEN, 0); ADD(NVN_RB_TEX, 0); ADD(NVN_RB_SAMPT, 0); ADD(NVN_RB_TEX, 1); ADD(NVN_RB_SAMP, 1); ADD(NVN_RB_SUPPORT, 0);
+        if (s == 1) { ADD(NVN_RB_DRV0, 0); sh->drv0 = 1; }                    // reads the base instance
+        if (s == 2) { ADD(NVN_RB_TEX, 2); sh->b[n - 1].f1d = 1; }             // a texture fetched as rows: not kept
+        if (s == 3) { ADD(NVN_RB_TEXU, 2); ADD(NVN_RB_SBUFP, 0); }            // a handle in uniform memory, a storage buffer: walked again
+        if (s == 4) sh->per_draw = 1;                                         // a per-draw table: never in part
+        if (s == 5) { ADD(NVN_RB_TEX, 3); sh->b[n - 1].dtt = TYPE_TBUF; ADD(NVN_RB_DRV0, 0); sh->drv0 = 1; }
+        #undef ADD
+        sh->nb = n; assert(n <= NB);
+    }
+}
+static void replay(int mode, int mut, uint32_t seed, long steps) {
+    g_mode = mode; g_mut = mut; rnd_state = seed;
+    n_reuse = n_part = n_full = n_wrong = n_check = n_stale_reuse = 0; memset(n_why, 0, sizeof n_why);
+    memset(&W, 0, sizeof W); make_shaders();
+    W.pass = W.sub = W.agen = W.ser = W.pkg = 1; W.subst_tex = -1; W.dirty[0] = W.dirty[1] = RB_ARGS_FULL; W.cur[1] = 1;
+    for (int i = 0; i < NTEXID; i++) { W.view[i] = 100 + (uint64_t)i; W.sampv[i] = (uint64_t)i; }
+    uint64_t next_view = 1000;
+    for (long step = 0; step < steps; step++) {
+        unsigned e = rnd() % 1000; int st = (int)(rnd() & 1), r = (int)(rnd() % NREG);
+        if (e < 420) { uint64_t a = 16 * (1 + rnd() % 64); if (W.ubo[st][r] != a) { W.ubo[st][r] = a; W.ubosz[st][r] = 16 * (1 + rnd() % 3); mark_uniform(st); } }   // BindUniformBuffer
+        else if (e < 470) { W.shadow[st][r]++; if (!W.dirty[st]) mark_uniform(st); }                                    // an inline update deferred in the pass (ubd_dirty)
+        else if (e < 520) { int id = (int)(rnd() % NTEXID); if (W.tex[st][r] != id) { W.tex[st][r] = id; mark_full(st, RB_ARGS_C_HANDLES); } }   // BindTexture
+        else if (e < 540) { int id = (int)(rnd() % NTEXID); if (W.samp[st][r] != id) { W.samp[st][r] = id; mark_full(st, RB_ARGS_C_HANDLES); } }
+        else if (e < 550) { W.ssbo[st] = rnd(); mark_full(st, RB_ARGS_C_STORAGE); }
+        else if (e < 600) { int s = (int)(rnd() % NSH); if (W.cur[st] != s) { W.cur[st] = s; mark_full(0, RB_ARGS_C_PROGRAM); mark_full(1, RB_ARGS_C_PROGRAM); } }   // BindProgram
+        else if (e < 615) { W.view[rnd() % NTEXID] = next_view++; W.ser++; }                                           // a storage taken over or swapped: no stage is marked
+        else if (e < 630) W.ser++;                                                                                      // a texture made: nothing bound changes
+        else if (e < 640) { W.view[rnd() % NTEXID] = next_view++; W.reg++; }                                            // a texture ID registered again
+        else if (e < 645) { W.sampv[rnd() % NTEXID] = next_view++; W.reg++; }                                           // a sampler ID registered again
+        else if (e < 650) { W.view[rnd() % NTEXID] = next_view++; W.pkg++; }                                            // a new check period: a CPU-written texture uploaded again
+        else if (e < 655) W.expand++;                                                                                   // an expanded copy made again (its cache turned over)
+        else if (e < 690) { W.pass++; }                                                                                 // a new pass
+        else if (e < 700) { W.sub++; W.agen++; W.pkg++; W.pass++; }                                                     // a new submission
+        else if (e < 705) { W.agen++; W.pass++; }                                                                       // a segment cut (no pass is open across one)
+        else if (e < 740) W.binst = rnd() % 4;                                                                          // the next draw's base instance
+        else if (e < 760) { int t = rnd() % 3 ? (int)(rnd() % NTEXID) : -1; uint64_t v = t < 0 ? 0 : 5000 + rnd() % 3;  // same-pass feedback (patch 0324's rule, or the old one: both mark)
+                            if (t != W.subst_tex || v != W.subst_view) { W.subst_tex = t; W.subst_view = v; mark_full(1, RB_ARGS_C_FEEDBACK); } }
+        else if (e < 763) W.walk_all = W.walk_all ? 0 : rnd() % 20 == 0;                                                // a diagnostic that walks every binding, on for a while
+        else if (e < 770) { mark_full(0, 0); mark_full(1, 0); }                                                         // an internal draw's args_dirty_all
+        else { encode(0); encode(1); }                                                                                  // a draw
+    }
+}
+
+int main(void) {
+    // ① the switch
+    assert(rb_args_mode(NULL) == RB_ARGS_MODE_ON && rb_args_mode("1") == RB_ARGS_MODE_ON && rb_args_mode("") == RB_ARGS_MODE_ON && rb_args_mode("yes") == RB_ARGS_MODE_ON);
+    assert(rb_args_mode("0") == RB_ARGS_MODE_OFF && rb_args_mode("check") == RB_ARGS_MODE_CHECK);
+    assert(rb_args_mode("00") == RB_ARGS_MODE_ON && rb_args_mode("Check") == RB_ARGS_MODE_ON);   // only the exact words
+    // ② the mark: a clean stage becomes uniform-only, a marked one is never lowered; with the switch at 0 the mark is the old one
+    assert(rb_args_mark_uniform(RB_ARGS_CLEAN, RB_ARGS_MODE_ON) == RB_ARGS_UNIFORM && rb_args_mark_uniform(RB_ARGS_CLEAN, RB_ARGS_MODE_CHECK) == RB_ARGS_UNIFORM);
+    assert(rb_args_mark_uniform(RB_ARGS_UNIFORM, RB_ARGS_MODE_ON) == RB_ARGS_UNIFORM);
+    assert(rb_args_mark_uniform(RB_ARGS_FULL, RB_ARGS_MODE_ON) == RB_ARGS_FULL && rb_args_mark_uniform(RB_ARGS_FULL, RB_ARGS_MODE_CHECK) == RB_ARGS_FULL);
+    assert(rb_args_mark_uniform(RB_ARGS_CLEAN, RB_ARGS_MODE_OFF) == RB_ARGS_FULL && rb_args_mark_uniform(RB_ARGS_FULL, RB_ARGS_MODE_OFF) == RB_ARGS_FULL);
