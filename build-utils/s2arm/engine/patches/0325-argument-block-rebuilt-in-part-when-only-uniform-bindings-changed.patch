+    for (unsigned c = 0; c < 128; c++) { g = ok; g.dirty = RB_ARGS_FULL; g.causes = (uint8_t)c; assert(rb_args_why(&g) != RB_ARGS_PARTIAL);
+                                         g = ok; g.causes = (uint8_t)c; assert(rb_args_why(&g) == RB_ARGS_PARTIAL); }
+    // ⑤ the replay. On: no wrong block in 1.5 million events, rebuilds in part do happen, and each reason for a full walk occurs
+    replay(RB_ARGS_MODE_ON, MUT_NONE, 0x0325u, 1500000);
+    assert(n_wrong == 0 && n_part > 20000 && n_reuse > 0 && n_full > 0);
