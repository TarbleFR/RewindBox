+// RewindBox (patch 0350): whether gpw_stale would return a run (1) or none (0), stopping at the first stale GOB: the same walk, the same readability rule and the same unmarking
+//   of the GOBs whose bytes changed until then (the orphan pass, alias_orphan_pass)
+static int gpw_any_stale(const uint8_t *mem, uint64_t size) {
+    uint64_t a = (uint64_t)(uintptr_t)mem, e = a + size; int rb_ok = -1, found = 0;
+    if (!atomic_load_explicit(&g_gpw_nblk, memory_order_relaxed)) return 0;
+    pthread_mutex_lock(&g_gpw_mu);
+    zp_map z; int zb = 0; z.v = NULL; z.np = 0; z.a0 = z.pg = 0;
+    uint64_t lk = UINT64_MAX; gpw_blk *b = NULL;
+    for (uint64_t g = a >> 9, ge = (e + 511) >> 9; g < ge; g++) {
+        uint64_t k = g >> 9; if (k != lk) { b = nvn_hm_get(&g_gpw, &k); lk = k; }
+        if (!b) { g = (k << 9) + 511; continue; }
+        unsigned i = (unsigned)(g & 511); if (!(b->bits[i >> 6] >> (i & 63) & 1)) continue;
+        if (rb_ok < 0) rb_ok = rb_span_readable((uintptr_t)mem, size);
+        if (rb_ok && !zb) { zp_build(&z, a, size); zb = 1; }
+        if (rb_ok && gob_hash(g, &z) != b->h[i]) { gpw_unmark(g); lk = UINT64_MAX; b = NULL; continue; }
+        found = 1; break;
+    }
+    if (zb) zp_free(&z);
+    pthread_mutex_unlock(&g_gpw_mu);
+    return found;
+}
