@@ -57,6 +57,14 @@ static inline uint64_t rb_gov_pso_count(unsigned plan) {
     uint64_t legacy = rb_gov_share(plan & ~RB_GOV_PSO_FLOOR,RB_GOV_PIPELINE) / 4096u;
     return (plan & RB_GOV_PSO_FLOOR) && legacy < 4096u ? 4096u : legacy;
 }
+// Match the count planner's 4 KiB estimate. Leave capacity for the actual draw
+// and one concurrent worker. Thermal state already affects the published quota.
+static inline int rb_gov_admit_registered(unsigned plan, uint64_t room, uint64_t bytes, uint64_t count) {
+    const uint64_t limit = rb_gov_pso_count(plan);
+    const uint64_t cap = rb_gov_share(plan,RB_GOV_PIPELINE);
+    return room != UINT64_MAX && room >= (1000ull << 20) && (plan & 3u) != RB_GOV_CRITICAL &&
+           count < limit && limit - count > 2 && bytes < cap && cap - bytes > 2u * 4096;
+}
 static inline unsigned rb_gov_pso_drops(unsigned plan, uint64_t bytes, uint64_t count, unsigned scanLimit) {
     if (!(plan & RB_GOV_PSO_FLOOR) || bytes > rb_gov_share(plan,RB_GOV_PIPELINE)) return scanLimit;
     uint64_t limit = rb_gov_pso_count(plan);
