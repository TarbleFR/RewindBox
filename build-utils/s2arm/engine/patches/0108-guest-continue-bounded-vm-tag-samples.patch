 // RewindBox (patch 0092): in IPA 781 the old walk showed 173–179 MiB compressed during play while
 // TASK_VM_INFO reported about 1 GiB. Visit the top-level map on both sides of the shared cache and
 // inside the guest window. These are per-mapping VM counts (aliases can overlap), not a footprint.
-void s2a_rb_mem_tags_wide(char *out, size_t cap) {
-    enum { RB_VM_TAGS = 256, RB_VM_REGIONS = 8192, RB_VM_MS = 25 };
+// RewindBox (patch 0108): the bounded walk on IPA 785 counted 329–402 MiB before its
+// limit, against up to 1,140 MiB in TASK_VM_INFO. Keep separate, time-bounded slices;
+// their page counts describe mappings observed at different times, never one total.
+void s2a_rb_mem_tags_wide(char *out, size_t cap, uint64_t *resume, unsigned *slice) {
+    enum { RB_VM_TAGS = 256, RB_VM_REGIONS = 8192 };
+    const uint64_t budget_ns = (resume ? 5 : 25) * 1000000ull;
     const uint64_t guest_start = g_ok ? g_base : 0, guest_end = guest_start ? guest_start + g_size : 0;
     const uint64_t page_bytes = (uint64_t)vm_page_size;
     const uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
@@ -1293,9 +1297,9 @@
     uint64_t h_file = 0, g_file = 0, crossing = 0;
     unsigned regions = 0, skipped = 0;
     const char *status = "region-limit";
-    vm_address_t cursor = 0;
+    vm_address_t cursor = resume ? (vm_address_t)*resume : 0;
     for (; regions < RB_VM_REGIONS; regions++) {
-        if (!(regions % 64) && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start >= RB_VM_MS * 1000000ull) {
+        if (regions && !(regions % 64) && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start >= budget_ns) {
             status = "time-limit";
             break;
         }
@@ -1335,6 +1339,13 @@
                         status, regions, skipped, (unsigned long long)(h_anon * page_bytes >> 20),
                         (unsigned long long)(h_file * page_bytes >> 20), (unsigned long long)(g_anon * page_bytes >> 20),
                         (unsigned long long)(g_file * page_bytes >> 20), (unsigned long long)(crossing * page_bytes >> 20));
+    if (resume) {
+        const int continued = (regions == RB_VM_REGIONS || strcmp(status, "time-limit") == 0) && cursor > *resume;
+        if (used > 0 && (size_t)used < cap)
+            used += snprintf(out + used, cap - (size_t)used, "; slice %u", *slice + 1);
+        *resume = continued ? cursor : 0;
+        *slice = continued ? *slice + 1 : 0;
+    }
     for (int side = 0; side < 2; side++) {
         uint64_t *tags = side ? guest : host;
         for (int rank = 0; rank < 6 && used > 0 && (size_t)used < cap; rank++) {
