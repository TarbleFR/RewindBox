+        internal static string RbNoPaths(string line)
+        {
+            if (line == null || line.IndexOf('/') < 0)
+            {
+                return line;
+            }
+
+            StringBuilder o = null;
+            int copied = 0;
+
+            for (int i = 0; i < line.Length; i++)
+            {
+                bool tokenStart = i == 0 || !RbTokenChar(line[i - 1]);
+                int start = -1;
+
+                if (line[i] == '/' && (i == 0 || char.IsWhiteSpace(line[i - 1]) || RbPathStarts.IndexOf(line[i - 1]) >= 0) &&
+                    i + 1 < line.Length && !char.IsWhiteSpace(line[i + 1]) && RbPathEnds.IndexOf(line[i + 1]) < 0)
+                {
+                    start = i > 0 && line[i - 1] == '~' ? i - 1 : i;
+                }
+                else if (tokenStart && RbTokenChar(line[i]))
+                {
+                    int j = i;
+
+                    while (j < line.Length && RbTokenChar(line[j]))
+                    {
+                        j++;
+                    }
+
+                    if (j + 1 < line.Length && line[j] == ':' && line[j + 1] == '/')
