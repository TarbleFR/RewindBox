diff --git a/graphics/nvn/gfx/nvn/rb_pool_index.h b/graphics/nvn/gfx/nvn/rb_pool_index.h
new file mode 100644
index 0000000..be331f7
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_pool_index.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// Single edits of the pool address index: pool positions ordered by start
+// address. The includer defines RB_PIDX_LO(i), the start address of the pool
+// at position i, before this header. The pool table removes by moving its last
+// pool into the hole, so positions change as described at each function.
+
+// The pool at position `last` was appended: the table has last + 1 pools and
+// index[0..last) is sorted. Returns 0 and leaves the index as it was when
+// another pool starts at the same address: equal starts keep the full sort,
+// whose order among them the lookup's fallback scan does not depend on.
+static inline int rb_pidx_insert(int *index, int last) {
+    int lo = 0, hi = last;
+    uintptr_t address = RB_PIDX_LO(last);
+    while (lo < hi) {
+        int mid = lo + (hi - lo) / 2;
+        if (RB_PIDX_LO(index[mid]) < address) lo = mid + 1;
+        else hi = mid;
+    }
+    if (lo < last && RB_PIDX_LO(index[lo]) == address) return 0;
+    memmove(index + lo + 1, index + lo, (size_t)(last - lo) * sizeof *index);
+    index[lo] = last;
+    return 1;
+}
+
+// The pool at position `removed` was deleted and the pool that was at position
+// `count` (the last one) now stands there: the table has `count` pools and the
+// index still has count + 1 entries. Returns 0 when it does not hold `removed`.
+static inline int rb_pidx_remove(int *index, int count, int removed) {
+    int at = -1;
+    for (int i = 0; i <= count; i++) {
+        if (index[i] == removed) at = i;
+        else if (index[i] == count) index[i] = removed;   // the previous last pool moved into the hole
+    }
+    if (at < 0) return 0;
+    memmove(index + at, index + at + 1, (size_t)(count - at) * sizeof *index);
+    return 1;
+}
+
+// A second mutation before any lookup used to drop the pending edit, and the
+// next lookup sorted every pool again: a virtual run joined to its neighbour is
+// a removal and an addition, so it sorted each time. A mutation now applies the
+// pending edit first. A long burst with no lookup between (a scene being torn
+// down) stops doing so: one sort at the next lookup is cheaper than an O(n)
+// edit per mutation.
+enum { RB_PIDX_BURST = 32 };
+static inline int rb_pidx_flush_allowed(int valid, int pending, unsigned streak, int capacity, int pools) {
+    return !valid && pending && streak < RB_PIDX_BURST && capacity >= pools;
+}
diff --git a/graphics/nvn/tests/t_rb_pool_index.c b/graphics/nvn/tests/t_rb_pool_index.c
new file mode 100644
index 0000000..5605522
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_pool_index.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: Apache-2.0
+// Host-only checks of the single edits nvn_mtl.m applies to its pool address
+// index, replayed against a full sort after every step.
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+enum { CAP = 512 };
+static uintptr_t starts[CAP];
+#define RB_PIDX_LO(i) (starts[(i)])
+#include "../gfx/nvn/rb_pool_index.h"
+
+static int count, idx[CAP], valid, pending, removed_at, unique = 1;
+static unsigned streak, sorts, edits;
+static uint64_t seed = 0x9e3779b97f4a7c15ull;
+static uint64_t next(void) { seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17; return seed; }
+static int by_start(const void *a, const void *b) {
+    uintptr_t x = starts[*(const int *)a], y = starts[*(const int *)b];
+    return x < y ? -1 : x > y;
+}
+static void expect_sorted(void) {
+    int ref[CAP];
+    for (int i = 0; i < count; i++) ref[i] = i;
+    qsort(ref, (size_t)count, sizeof *ref, by_start);
+    for (int i = 0; i < count; i++) assert(idx[i] == ref[i]);
+}
+// The renderer's sequence: a mutation first applies the pending edit, then
+// records its own; a lookup applies the pending edit or sorts.
+static int apply(void) {
+    int edit = pending; pending = 0;
+    if (!edit) return 0;
+    return edit == 1 ? rb_pidx_insert(idx, count - 1) : rb_pidx_remove(idx, count, removed_at);
+}
+static void before_edit(void) {
+    if (rb_pidx_flush_allowed(valid, pending, streak, CAP, count) && apply()) { valid = 1; edits++; }
+    streak++;
+}
+static void add(uintptr_t start) {
+    before_edit();
+    pending = valid && unique ? 1 : 0; valid = 0;
+    starts[count++] = start;
+}
+static void del(int at) {
+    before_edit();
+    starts[at] = starts[--count];
+    pending = valid && unique ? 2 : 0; removed_at = at; valid = 0;
+}
+static void lookup(void) {
+    if (!valid) {
+        if (apply()) edits++;
+        else {
+            for (int i = 0; i < count; i++) idx[i] = i;
+            qsort(idx, (size_t)count, sizeof *idx, by_start);
+            unique = 1;
+            for (int i = 1; unique && i < count; i++) if (starts[idx[i - 1]] == starts[idx[i]]) unique = 0;
+            sorts++;
+        }
+        valid = 1;
+    }
+    streak = 0;
+    if (unique) expect_sorted();
+}
+
+int main(void) {
+    // Direct edits: head, middle, tail, the last pool removed, the moved pool renumbered.
+    starts[0] = 40; starts[1] = 10; starts[2] = 30; idx[0] = 1; idx[1] = 2; idx[2] = 0; count = 3;
+    starts[3] = 20; count = 4; assert(rb_pidx_insert(idx, 3)); expect_sorted();
+    starts[4] = 5; count = 5; assert(rb_pidx_insert(idx, 4)); expect_sorted();
+    starts[5] = 50; count = 6; assert(rb_pidx_insert(idx, 5)); expect_sorted();
+    starts[6] = 30; int before[CAP]; memcpy(before, idx, sizeof before);
+    assert(!rb_pidx_insert(idx, 6) && !memcmp(before, idx, sizeof before));   // an equal start is left to the full sort
+    starts[1] = starts[--count]; assert(rb_pidx_remove(idx, count, 1)); expect_sorted();   // position 5 moved into 1
+    --count; assert(rb_pidx_remove(idx, count, count)); expect_sorted();                  // the last pool itself
+    assert(!rb_pidx_remove(idx, count, 77));
+    assert(rb_pidx_flush_allowed(0, 1, 0, CAP, 4) && rb_pidx_flush_allowed(0, 2, RB_PIDX_BURST - 1, 4, 4));
+    assert(!rb_pidx_flush_allowed(1, 1, 0, CAP, 4) && !rb_pidx_flush_allowed(0, 0, 0, CAP, 4));
+    assert(!rb_pidx_flush_allowed(0, 1, RB_PIDX_BURST, CAP, 4) && !rb_pidx_flush_allowed(0, 1, 0, 3, 4));
+
+    // A joined virtual run is a removal and an addition with no lookup between:
+    // 2000 of them, among single edits, cost no sort after the first build.
+    count = 0; valid = pending = 0; streak = 0; unique = 1;
+    for (int i = 0; i < 200; i++) add((uintptr_t)(next() >> 20) * 4096);
+    lookup();
+    unsigned built = sorts;
+    for (int step = 0; step < 2000; step++) {
+        del((int)(next() % (unsigned)count));
+        add((uintptr_t)(next() >> 20) * 4096);
+        if (next() & 1) { add((uintptr_t)(next() >> 20) * 4096); lookup(); del((int)(next() % (unsigned)count)); }
+        lookup();
+    }
+    assert(sorts == built && edits >= 4000);
+
+    // A teardown burst stops editing after RB_PIDX_BURST mutations and pays one sort.
+    unsigned edits_before = edits;
+    while (count > 60) del((int)(next() % (unsigned)count));
+    lookup();
+    assert(sorts == built + 1 && edits - edits_before == RB_PIDX_BURST - 1);
+
+    // Two pools with one start: every later mutation sorts until the tie is gone.
+    add(starts[0]); lookup(); assert(!unique && sorts == built + 2);
+    add(123456789); lookup(); assert(sorts == built + 3);
+    del(count - 2); lookup(); assert(unique && sorts == built + 4);
+    add(987654321); lookup(); assert(sorts == built + 4);
+    printf("PASS pool address index: %u single edits, %u sorts over bursts, joins, a teardown and an equal start\n", edits, sorts);
+    return 0;
+}
