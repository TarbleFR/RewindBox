+        FILE *file = fopen(path.fileSystemRepresentation, "r");
+        if (!file) continue;
+        char row[2 * sizeof(pso_skey) + 8];
+        for (unsigned n = 0; n < 512 && keys.count < RB_STARTUP_KEYS && fgets(row, sizeof row, file); ++n) {
