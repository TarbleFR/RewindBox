new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_archive_preopen.inc
@@ -0,0 +1,188 @@
+// The session owns the index, opened archives and this serial I/O queue.
+// A live lookup only inspects published mappings. A prewarm worker can open
+// an archive itself without holding the mutex needed by other pipeline keys.
+enum rb_archive_source { RB_BUNDLE, RB_LOCAL, RB_LEGACY };
+enum { RB_STARTUP_KEYS = 64 };
+static BOOL rb_open_started;
+static dispatch_group_t rb_archive_jobs(void) {
+    static dispatch_group_t group;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ group = dispatch_group_create(); });
+    return group;
+}
+static BOOL rb_archive_key(NSString *key) {
+    if (![key isKindOfClass:NSString.class]) return NO;
+    const char *p = key.UTF8String;
+    if (!p) return NO;
+    if (*p == 'c' && key.length == 41) ++p;
+    return strlen(p) == 40 && strspn(p, "0123456789abcdef") == 40;
+}
+static NSMutableSet<NSString *> *rb_open_pending;
+static NSMutableOrderedSet<NSString *> *rb_startup_keys;
+static _Atomic unsigned rb_preopened, rb_ready_hits, rb_cold_submit;
+static dispatch_queue_t rb_archive_io(void) {
+    static dispatch_queue_t queue;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        queue = dispatch_queue_create("s2a.archive.open",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INITIATED, 0));
+    });
+    return queue;
+}
+
+// Called under g_par_mu. Resolve the current mapping again at publication:
+// a failed strict probe or a writer may have replaced it during the open.
+static NSString *rb_archive_mapping(NSString *key, enum rb_archive_source source, NSString **path) {
+    NSString *dir, *file, *cache;
+    if (source == RB_BUNDLE && [g_par_bhave containsObject:key]) {
+        dir = g_par_bdir; file = [key stringByAppendingPathExtension:@"metalarchive"];
+        cache = [@"b/" stringByAppendingString:key];
+    } else if (source == RB_LOCAL && [g_par_have containsObject:key]) {
+        dir = g_par_dir; file = g_par_bmap[key];
+        cache = file ? [@"f/" stringByAppendingString:file] : key;
+        if (!file) file = [key stringByAppendingPathExtension:@"metalarchive"];
+    } else if (source == RB_LEGACY && [g_par_legacy_have containsObject:key]) {
+        dir = g_par_legacy_dir; file = g_par_legacy_batches[key] ?: [key stringByAppendingPathExtension:@"metalarchive"];
+        cache = [@"legacy/" stringByAppendingString:file];
+    } else return nil;
+    if (path) *path = [dir stringByAppendingPathComponent:file];
+    return cache;
+}
+
+static id<MTLBinaryArchive> rb_archive_fetch(NSString *key, enum rb_archive_source source, BOOL submit) {
+    if (!key || !atomic_load_explicit(&g_par_initialized, memory_order_acquire)) return nil;
+    pthread_mutex_lock(&g_par_mu);
+    NSString *cache = rb_archive_mapping(key, source, NULL);
+    id<MTLBinaryArchive> archive = cache ? rb_archive_lookup(cache) : nil;
+    if (!cache || archive) {
+        pthread_mutex_unlock(&g_par_mu);
+        if (archive && submit) atomic_fetch_add_explicit(&rb_ready_hits, 1, memory_order_relaxed);
+        return archive;
+    }
+    if (submit) {
+        if (!rb_open_pending) rb_open_pending = [NSMutableSet set];
+        if (rb_open_pending.count < RB_STARTUP_KEYS && ![rb_open_pending containsObject:cache]) {
+            [rb_open_pending addObject:cache];
+            atomic_fetch_add_explicit(&rb_cold_submit, 1, memory_order_relaxed);
+            dispatch_group_async(rb_archive_jobs(), rb_archive_io(), ^{ @autoreleasepool {
+                rb_archive_fetch(key, source, NO);
+                pthread_mutex_lock(&g_par_mu);
+                [rb_open_pending removeObject:cache];
+                pthread_mutex_unlock(&g_par_mu);
+            }});
+        }
+        pthread_mutex_unlock(&g_par_mu);
+        return nil;
+    }
+    NSString *path = nil;
+    rb_archive_mapping(key, source, &path);
+    pthread_mutex_unlock(&g_par_mu);
+    MTLBinaryArchiveDescriptor *desc = [MTLBinaryArchiveDescriptor new];
+    desc.url = [NSURL fileURLWithPath:path];
+    id<MTLBinaryArchive> opened = [g_dev newBinaryArchiveWithDescriptor:desc error:nil];
+    CFArrayRef retired = NULL;
+    pthread_mutex_lock(&g_par_mu);
+    if ([cache isEqual:rb_archive_mapping(key, source, NULL)]) {
+        archive = rb_archive_lookup(cache);
+        if (!archive && opened) {
+            retired = rb_archive_store(cache, opened); archive = opened;
+        } else if (!archive && source == RB_LOCAL) {
+            [g_par_bmap removeObjectForKey:key]; [g_par_have removeObject:key];
+        } else if (!archive && source == RB_LEGACY) [g_par_legacy_have removeObject:key];
+        else if (!archive) [g_par_bhave removeObject:key];
+    }
+    pthread_mutex_unlock(&g_par_mu);
+    if (retired) CFRelease(retired);
+    return archive;
+}
+
+static NSString *rb_hot_index(void) {
+    if (!atomic_load_explicit(&g_par_initialized, memory_order_acquire)) return nil;
+    return [g_par_dir stringByAppendingPathComponent:@"startup-archives.plist"];
+}
+
+// Bounded input for a cache written by an interrupted or older app.
+static NSArray *rb_read_startup_keys(NSString *path) {
+    if (!path || [NSFileManager.defaultManager attributesOfItemAtPath:path error:nil].fileSize > 32768) return nil;
+    return [NSArray arrayWithContentsOfFile:path];
+}
+
+static void rb_archive_preopen_start(void) {
+    if (!RB_PAR_PREOPEN() || !g_dev || g_par_harvest) return;
+    pthread_mutex_lock(&g_par_mu);
+    if (!rb_open_started) {
+        rb_open_started = YES;
+        dispatch_group_async(rb_archive_jobs(), rb_archive_io(), ^{ @autoreleasepool {
+            if (!par_open_dir()) {
+                pthread_mutex_lock(&g_par_mu); rb_open_started = NO; pthread_mutex_unlock(&g_par_mu);
+                return;
+            }
+            NSString *path = rb_hot_index();
+            if (!path) return;
+            NSMutableOrderedSet *seeds = [NSMutableOrderedSet orderedSet];
+            for (id key in rb_read_startup_keys(path)) {
+                if (rb_archive_key(key)) [seeds addObject:key];
+                if (seeds.count == RB_STARTUP_KEYS) break;
+            }
+            if (seeds.count < RB_STARTUP_KEYS) RB_PAR_SEED_RECIPES(seeds);
+            NSArray *keys = seeds.array;
+            NSUInteger count = 0;
+            for (id key in keys) {
+                if (++count > RB_STARTUP_KEYS || !RB_PAR_PREOPEN_ROOM()) break;
+                if (!rb_archive_key(key)) continue;
+                for (enum rb_archive_source src = RB_BUNDLE; src <= RB_LEGACY; ++src)
+                    if (rb_archive_fetch(key, src, NO)) { atomic_fetch_add(&rb_preopened, 1); break; }
+            }
+            MLOG("[rb-archive-open] startup keys=%lu ready=%u", (unsigned long)keys.count, atomic_load(&rb_preopened));
+        }});
+    }
+    pthread_mutex_unlock(&g_par_mu);
+}
+
+static id<MTLBinaryArchive> rb_archive_get(NSString *key, enum rb_archive_source source) {
+    if (!key) return nil;
+    BOOL submit = RB_PAR_SUBMIT_THREAD();
+    if (!atomic_load_explicit(&g_par_initialized, memory_order_acquire)) {
+        if (submit) { rb_archive_preopen_start(); return nil; }
+        if (!par_open_dir()) return nil;
+    }
+    return rb_archive_fetch(key, source, submit);
+}
+
+static void rb_save_startup_keys(NSArray *keys) {
+    NSString *path = rb_hot_index();
+    if (!path || !keys.count) return;
+    NSMutableOrderedSet *merged = [NSMutableOrderedSet orderedSetWithArray:keys];
+    for (id old in rb_read_startup_keys(path)) {
+        if (merged.count >= RB_STARTUP_KEYS) break;
+        if (rb_archive_key(old)) [merged addObject:old];
+    }
+    NSArray *snapshot = merged.array;
+    if (![snapshot writeToFile:path atomically:YES])
+        MLOG("[rb-archive-open] could not persist %lu startup keys", (unsigned long)snapshot.count);
+}
+
+static void rb_archive_note_startup(NSString *key) {
+    if (!RB_PAR_PREOPEN() || par_write_in_place || !rb_archive_key(key) || g_par_harvest) return;
+    pthread_mutex_lock(&g_par_mu);
+    if (!rb_startup_keys) rb_startup_keys = [NSMutableOrderedSet orderedSet];
+    NSUInteger old = rb_startup_keys.count;
+    if (old < RB_STARTUP_KEYS) {
+        [rb_startup_keys addObject:key];
+        NSUInteger n = rb_startup_keys.count;
+        if (n != old && (n == 1 || n == 8 || n == 32 || n == RB_STARTUP_KEYS)) {
+            NSArray *keys = [rb_startup_keys.array copy];
+            dispatch_group_async(rb_archive_jobs(), rb_archive_io(), ^{ @autoreleasepool { rb_save_startup_keys(keys); }});
+        }
+    }
+    pthread_mutex_unlock(&g_par_mu);
+}
+
+// Called only after all shader and PSO producers have stopped, before paths reset.
+static void rb_archive_preopen_retire(void) {
+    if (!rb_open_started && !rb_startup_keys) return;
+    dispatch_sync(rb_archive_io(), ^{ @autoreleasepool { rb_save_startup_keys(rb_startup_keys.array); }});
+    MLOG("[rb-archive-open] preopened=%u submit_ready=%u submit_cold=%u",
+        atomic_exchange(&rb_preopened, 0), atomic_exchange(&rb_ready_hits, 0), atomic_exchange(&rb_cold_submit, 0));
+    rb_open_started = NO; rb_open_pending = nil; rb_startup_keys = nil;
+}
