diff --git a/graphics/nvn/gfx/nvn/rb_gpudiag.inc b/graphics/nvn/gfx/nvn/rb_gpudiag.inc
index 0e41871..f885466 100644
--- a/graphics/nvn/gfx/nvn/rb_gpudiag.inc
+++ b/graphics/nvn/gfx/nvn/rb_gpudiag.inc
@@ -90,3 +90,97 @@ static void rb_gpudiag_draw(const char *key,unsigned facts,unsigned known,unsign
     g_rb_gdiag.shaders[i].draws++; if (depth_test) g_rb_gdiag.shaders[i].depth_draws++;
 }
 static void rb_gpudiag_reset(void) { atomic_store(&g_rb_gpudiag_mode,-1); memset(&g_rb_gdiag,0,sizeof g_rb_gdiag); }
+
+// Read-only attachment ledger. It reports encoded consumers, not shader branch
+// execution. Overflow and remaining lifetimes are explicitly unresolved.
+static _Atomic int g_rb_passdiag_mode=-1;
+static int rb_passdiag_on(void) {
+    int v=atomic_load(&g_rb_passdiag_mode);
+    if (v<0) { const char *e=getenv("S2A_RB_PASS_DIAG"); v=e && !strcmp(e,"1"); atomic_store(&g_rb_passdiag_mode,v); }
+    return v;
+}
+typedef struct {
+    uintptr_t root; uint64_t serial, pass, bytes;
+    unsigned role, level, slice, width, height, samples, format, load, store;
+    int next, pending;
+} rb_pass_attachment;
+enum { RB_PD_RECORDS=8192, RB_PD_BUCKETS=1024 };
+static rb_pass_attachment g_rb_pd_rows[RB_PD_RECORDS], g_rb_pd_open[10];
+static int g_rb_pd_heads[RB_PD_BUCKETS], g_rb_pd_n, g_rb_pd_no;
+static uint64_t g_rb_pd_load_bytes, g_rb_pd_store_bytes, g_rb_pd_overflows;
+static unsigned rb_pd_bucket(uintptr_t root) { return (unsigned)((root>>4)^(root>>20))&(RB_PD_BUCKETS-1); }
+static uintptr_t rb_pd_root(id<MTLTexture> t, unsigned *level, unsigned *slice) {
+    while (t.parentTexture) { *level+=(unsigned)t.parentRelativeLevel; *slice+=(unsigned)t.parentRelativeSlice; t=t.parentTexture; }
+    return (uintptr_t)(__bridge void *)t;
+}
+static const char *rb_pd_load(unsigned a) { return a==MTLLoadActionLoad ? "load" : a==MTLLoadActionClear ? "clear" : a==MTLLoadActionDontCare ? "dontCare" : "unknown"; }
+static const char *rb_pd_store(unsigned a) { return a==MTLStoreActionStore ? "store" : a==MTLStoreActionDontCare ? "dontCare" : a==MTLStoreActionMultisampleResolve ? "resolve" : a==MTLStoreActionStoreAndMultisampleResolve ? "storeAndResolve" : "unknown"; }
+static void rb_passdiag_read(id<MTLTexture> t, unsigned role, unsigned level, unsigned slice, uint64_t consumer, const char *kind) {
+    if (!rb_passdiag_on() || !t) return;
+    unsigned nl=(unsigned)t.mipmapLevelCount, ns=(unsigned)t.arrayLength;
+    uintptr_t root=rb_pd_root(t,&level,&slice);
+    for (int at=g_rb_pd_heads[rb_pd_bucket(root)]-1;at>=0;at=g_rb_pd_rows[at].next) {
+        rb_pass_attachment *a=&g_rb_pd_rows[at];
+        if (!a->pending || a->root!=root || (role<10 && (a->role!=role || a->level!=level || a->slice!=slice))) continue;
+        if (role>=10 && (a->level<level || a->level>=level+nl || a->slice<slice || a->slice>=slice+MAX(ns,1u))) continue;
+        MLOG("[rb-pass-consumer] producer_pass=%llu serial=%llu role=%u level=%u slice=%u consumer_pass=%llu kind=%s scope=encoded-consumer-not-hardware-branch",
+             (unsigned long long)a->pass,(unsigned long long)a->serial,a->role,a->level,a->slice,(unsigned long long)consumer,kind);
+        a->pending=0;
+    }
+}
+static void rb_passdiag_unresolved(const char *reason) {
+    if (!rb_passdiag_on()) return;
+    uint64_t pending=0;
+    for (int i=0;i<g_rb_pd_n;i++) pending+=!!g_rb_pd_rows[i].pending;
+    MLOG("[rb-pass-coverage] reason=%s unresolved=%llu overflows=%llu load_bytes=%llu store_bytes=%llu scope=logical-not-DRAM",
+         reason,(unsigned long long)pending,(unsigned long long)g_rb_pd_overflows,(unsigned long long)g_rb_pd_load_bytes,(unsigned long long)g_rb_pd_store_bytes);
+}
+static void rb_passdiag_begin(MTL4RenderPassDescriptor *pd) {
+    if (!rb_passdiag_on()) return;
+    g_rb_pd_no=0;
+    for (unsigned role=0;role<10;role++) {
+        MTLRenderPassAttachmentDescriptor *c=role<8 ? pd.colorAttachments[role] : role==8 ? pd.depthAttachment : pd.stencilAttachment;
+        id<MTLTexture> t=c.texture; if (!t) continue;
+        uint64_t bytes=att_bytes(t,c.level);
+        if (t.pixelFormat==MTLPixelFormatDepth32Float_Stencil8) bytes=bytes/5*(role==8 ? 4 : role==9 ? 1 : 5);
+        bytes*=MAX((uint64_t)pd.renderTargetArrayLength,1ull);
+        unsigned level=(unsigned)c.level,slice=(unsigned)(t.textureType==MTLTextureType3D ? c.depthPlane : c.slice);
+        uint64_t serial=role<8 ? (R.rt.color[role] ? R.rt.color[role]->serial : 0) : (R.rt.depth ? R.rt.depth->serial : 0);
+        if (c.loadAction==MTLLoadActionLoad) rb_passdiag_read(t,role,level,slice,g_stat_pass,"attachment-load");
+        uintptr_t identity=rb_pd_root(t,&level,&slice);
+        g_rb_pd_open[g_rb_pd_no++]=(rb_pass_attachment){.root=identity,.serial=serial,.pass=g_stat_pass,.bytes=bytes,.role=role,.level=level,.slice=slice,
+            .width=(unsigned)MAX(c.texture.width>>c.level,1u),.height=(unsigned)MAX(c.texture.height>>c.level,1u),.samples=(unsigned)t.sampleCount,.format=(unsigned)t.pixelFormat,.load=(unsigned)c.loadAction,.store=(unsigned)c.storeAction};
+    }
+}
+static void rb_passdiag_store(unsigned role, unsigned action) {
+    if (!rb_passdiag_on()) return;
+    for (int i=0;i<g_rb_pd_no;i++) if (g_rb_pd_open[i].role==role) g_rb_pd_open[i].store=action;
+}
+static void rb_passdiag_end(void) {
+    if (!rb_passdiag_on()) return;
+    for (int i=0;i<g_rb_pd_no;i++) {
+        rb_pass_attachment a=g_rb_pd_open[i]; unsigned b=rb_pd_bucket(a.root); int at=g_rb_pd_heads[b]-1;
+        while (at>=0) { rb_pass_attachment *v=&g_rb_pd_rows[at]; if (v->root==a.root && v->role==a.role && v->level==a.level && v->slice==a.slice) break; at=v->next; }
+        if (at>=0 && g_rb_pd_rows[at].pending) {
+            MLOG("[rb-pass-consumer] producer_pass=%llu serial=%llu role=%u level=%u slice=%u consumer_pass=%llu kind=%s scope=encoded-overwrite-not-death-proof",
+                (unsigned long long)g_rb_pd_rows[at].pass,(unsigned long long)g_rb_pd_rows[at].serial,a.role,a.level,a.slice,(unsigned long long)a.pass,
+                a.load==MTLLoadActionClear ? "clear-before-observed-read" : a.load==MTLLoadActionDontCare ? "dontCare-before-observed-read" : "unresolved");
+        }
+        if (at<0) {
+            if (g_rb_pd_n==RB_PD_RECORDS) { g_rb_pd_overflows++; rb_passdiag_unresolved("capacity"); memset(g_rb_pd_heads,0,sizeof g_rb_pd_heads); g_rb_pd_n=0; }
+            at=g_rb_pd_n++; a.next=g_rb_pd_heads[b]-1; g_rb_pd_heads[b]=at+1;
+        } else a.next=g_rb_pd_rows[at].next;
+        a.pending=a.store==MTLStoreActionStore || a.store==MTLStoreActionStoreAndMultisampleResolve;
+        g_rb_pd_rows[at]=a;
+        if (a.load==MTLLoadActionLoad) g_rb_pd_load_bytes+=a.bytes;
+        if (a.pending) g_rb_pd_store_bytes+=a.bytes;
+        MLOG("[rb-pass-attachment] frame=%llu pass=%llu serial=%llu role=%u level=%u slice=%u width=%u height=%u samples=%u format=%u bytes=%llu load=%s store=%s",
+            (unsigned long long)atomic_load(&g_cur_frame),(unsigned long long)a.pass,(unsigned long long)a.serial,a.role,a.level,a.slice,a.width,a.height,a.samples,a.format,
+            (unsigned long long)a.bytes,rb_pd_load(a.load),rb_pd_store(a.store));
+    }
+    g_rb_pd_no=0;
+}
+static void rb_passdiag_reset(void) {
+    rb_passdiag_unresolved("session-end"); memset(g_rb_pd_heads,0,sizeof g_rb_pd_heads); g_rb_pd_n=g_rb_pd_no=0;
+    g_rb_pd_load_bytes=g_rb_pd_store_bytes=g_rb_pd_overflows=0; atomic_store(&g_rb_passdiag_mode,-1);
+}
