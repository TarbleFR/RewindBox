diff --git a/graphics/nvn/gfx/nvn/rb_thermal_pacing.h b/graphics/nvn/gfx/nvn/rb_thermal_pacing.h
new file mode 100644
index 0000000..f94eb81
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_thermal_pacing.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline int rb_thermal_threshold(int enabled, int nvn2, const char *value) {
+    if (!enabled) return 0;
+    if (!nvn2) return 2;
+    if (!value || !strcmp(value, "1")) return 1;
+    return !strcmp(value, "0") ? 0 : 2;
+}
+
+enum { RB_HEAT_SAMPLES = 24 };
+static inline double rb_thermal_p95(const double *samples) {
+    // Nearest rank 23 out of 24 is the second-highest sample.
+    double high = 0., next = 0.;
+    for (int i = 0; i < RB_HEAT_SAMPLES; i++) {
+        double v = samples[i];
+        if (!(v > 0) || !isfinite(v)) return -1.;
+        if (v >= high) { next = high; high = v; }
+        else if (v > next) next = v;
+    }
+    return next;
+}
+
+typedef struct { int hot; uint64_t cool_since, last_ns, last_frame; } rb_guest_heat;
+static inline int rb_thermal_observe(rb_guest_heat *s, int threshold, int state, uint64_t ns,
+                                     uint64_t frame, double gpu_p95_ms) {
+    int continuous = s->last_ns && ns > s->last_ns && ns - s->last_ns <= 1500000000ull && frame > s->last_frame;
+    s->last_ns = ns; s->last_frame = frame;
+    if (!threshold) { s->hot = 0; s->cool_since = 0; }
+    else if (state >= threshold) { s->hot = 1; s->cool_since = 0; }
+    else if (s->hot) {
+        int ready = threshold == 2 || (state == 0 && gpu_p95_ms > 0 && gpu_p95_ms < 14.5);
+        if (!ready) s->cool_since = 0;
+        else if (!s->cool_since || (threshold == 1 && !continuous)) s->cool_since = ns;
+        else if (ns >= s->cool_since && ns - s->cool_since >= 30000000000ull) {
+            s->hot = 0; s->cool_since = 0;
+        }
+    }
+    return s->hot;
+}
+
+// Period == constraint and preemptible == 1 for the acquire-thread declaration.
+// Compare the final tuple in Mach ticks, after conversion and clamping.
+typedef struct { uint32_t period, comp; } rb_rt_tuple;
+typedef struct {
+    rb_rt_tuple applied, requested, pending;
+    uint64_t pending_since, attempted;
+} rb_rt_gate;
+enum rb_rt_decision { RB_RT_SAME, RB_RT_WAIT, RB_RT_SET };
+
+static inline int rb_rt_equal(rb_rt_tuple a, rb_rt_tuple b) {
+    return a.period == b.period && a.comp == b.comp;
+}
+static inline enum rb_rt_decision rb_rt_consider(rb_rt_gate *s, rb_rt_tuple p, uint64_t now) {
+    if (rb_rt_equal(s->requested, p) || rb_rt_equal(s->applied, p)) {
+        s->pending.period = 0;
+        return RB_RT_SAME;
+    }
+    // XNU may raise computation to half of the constraint. Once the readback
+    // proves this floor on this thread at this period, equivalent requests can
+    // be suppressed without another set/get pair.
+    if (p.period == s->applied.period && s->requested.period == p.period &&
+        s->applied.comp > s->requested.comp && s->applied.comp == p.period / 2 &&
+        p.comp <= s->applied.comp) {
+        s->pending.period = 0;
+        return RB_RT_SAME;
+    }
+    if (!rb_rt_equal(s->pending, p)) { s->pending = p; s->pending_since = now; }
+    const uint64_t dwell = 250000000ull;
+    if ((s->requested.period && now - s->pending_since < dwell) ||
+        (s->attempted && now - s->attempted < dwell)) return RB_RT_WAIT;
+    s->attempted = now;
+    return RB_RT_SET;
+}
+static inline void rb_rt_accepted(rb_rt_gate *s, rb_rt_tuple requested, rb_rt_tuple effective) {
+    s->requested = requested; s->applied = effective; s->pending.period = 0;
+}
+
+#include <stdatomic.h>
+#include <stdlib.h>
+// Cached once per session. NVN2 is checked by callers after title registration.
+static inline int rb_pacing_setting(_Atomic int *cache, const char *name) {
+    int v = atomic_load_explicit(cache, memory_order_relaxed);
+    if (!v) {
+        const char *setting = getenv(name);
+        v = !setting || !strcmp(setting, "1") ? 2 : 1;
+        atomic_store_explicit(cache, v, memory_order_relaxed);
+    }
+    return v == 2;
+}
+
+enum { RB_TICK_NOTIFY, RB_TICK_EMPTY, RB_TICK_EARLY };
+static inline unsigned rb_tick_action(int enabled, unsigned waiters, int due) {
+    if (!enabled || waiters > 1) return RB_TICK_NOTIFY;
+    if (!waiters) return RB_TICK_EMPTY;
+    return due ? RB_TICK_NOTIFY : RB_TICK_EARLY;
+}
diff --git a/graphics/nvn/tests/t_rb_thermal_pacing.c b/graphics/nvn/tests/t_rb_thermal_pacing.c
new file mode 100644
index 0000000..9266084
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_thermal_pacing.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_thermal_pacing.h"
+#include "../gfx/nvn/rb_promotion.h"
+#include <assert.h>
+#include <stdio.h>
+
+static void thermal(void) {
+    assert(rb_thermal_threshold(1,1,NULL)==1);
+    assert(rb_thermal_threshold(1,1,"2")==2 && rb_thermal_threshold(1,1,"0")==0);
+    assert(rb_thermal_threshold(0,1,"1")==0 && rb_thermal_threshold(1,0,NULL)==2);
+    double raw[RB_HEAT_SAMPLES];
+    for (unsigned i=0;i<RB_HEAT_SAMPLES;++i) raw[i]=12.;
+    raw[0]=60.; assert(rb_thermal_p95(raw)==12.);
+    raw[1]=14.5; assert(rb_thermal_p95(raw)==14.5);
+    raw[2]=-1.; assert(rb_thermal_p95(raw)<0);
+    uint64_t t=1000000000ull, frame=100;
+    rb_guest_heat heat={0};
+    assert(rb_thermal_observe(&heat,1,1,t,frame,-1)==1);
+    for (unsigned i=0;i<120;++i) {
+        t+=500000000ull; frame+=20;
+        assert(rb_thermal_observe(&heat,1,0,t,frame,i==59 ? -1. : i==95 ? 14.5 : 13.)==1);
+    }
+    t+=31000000000ull; frame+=1;
+    assert(rb_thermal_observe(&heat,1,0,t,frame,12.)==1); // resume from suspension
+    for (unsigned i=1;i<=60;++i) {
+        t+=500000000ull; frame+=16;
+        assert(rb_thermal_observe(&heat,1,0,t,frame,12.)==(i!=60));
+    }
+    assert(!rb_thermal_observe(&heat,2,1,++t,++frame,50.));
+    assert(rb_thermal_observe(&heat,2,2,++t,++frame,-1.));
+    assert(rb_thermal_observe(&heat,2,1,++t,++frame,-1.));
+    assert(!rb_thermal_observe(&heat,2,1,t+30000000000ull,++frame,-1.));
+}
+
+static void scheduling(void) {
+    rb_rt_gate gate={0};
+    const rb_rt_tuple fast={16000,2000}, slow={32000,2000}, effective={16000,8000};
+    uint64_t now=1000000000ull; unsigned calls=0;
+    assert(rb_rt_consider(&gate, fast, now)==RB_RT_SET); ++calls;
+    rb_rt_accepted(&gate,fast,effective);
+    assert(rb_rt_consider(&gate,(rb_rt_tuple){16000,4000},now+1)==RB_RT_SAME);
+    for (unsigned i=0;i<11209;++i) {
+        now+=16000000ull;
+        enum rb_rt_decision decision=rb_rt_consider(&gate,i%2 ? fast : slow,now);
+        assert(decision==(i%2 ? RB_RT_SAME : RB_RT_WAIT));
+        calls+=decision==RB_RT_SET;
+    }
+    assert(calls==1);
+    assert(rb_rt_consider(&gate, slow,now+250000000ull)==RB_RT_SET);
+    rb_rt_accepted(&gate,slow,slow);
+    assert(rb_rt_consider(&gate,fast,now+251000000ull)==RB_RT_WAIT);
+    assert(rb_rt_consider(&gate,fast,now+501000000ull)==RB_RT_SET);
+    // A failed call stays retryable after the cooldown.
+    assert(rb_rt_consider(&gate,fast,now+510000000ull)==RB_RT_WAIT);
+    assert(rb_rt_consider(&gate,fast,now+751000000ull)==RB_RT_SET);
+    assert(rb_tick_action(1,0,0)==RB_TICK_EMPTY);
+    assert(rb_tick_action(1,1,0)==RB_TICK_EARLY);
+    assert(rb_tick_action(1,1,1)==RB_TICK_NOTIFY);
+    assert(rb_tick_action(1,2,0)==RB_TICK_NOTIFY);
+    assert(rb_tick_action(0,0,0)==RB_TICK_NOTIFY);
+    assert(!rb_display_wait_ready(101,100,2,0,0,1./30));
+    assert(rb_display_wait_ready(102,100,2,0,0,1./30));
+}
+
+int main(void) {
+    thermal(); scheduling();
+    puts("Guest DRS thermal entry/recovery and Mach policy debounce: passed");
+}
