diff --git a/b/runtime/src/rb_selfimg.c b/runtime/src/rb_selfimg.c
new file mode 100644
index 0000000..6d12e76
--- /dev/null
+++ b/runtime/src/rb_selfimg.c
@@ -0,0 +1,24 @@
+// RewindBox: Mach-O headers for code that used &_mh_execute_header. Linked as S2ArmEngine.framework
+// (a dylib) the engine cannot reference _mh_execute_header, and its own registration sections
+// (__DATA,swnvn / swhle / swgl / swglb / swvkb) and __TEXT live in the framework, not in the host
+// app's executable. In the S2Arm.app executable both functions return the executable's header,
+// so its behaviour is unchanged.
+#if defined(__APPLE__)
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+
+const struct mach_header_64 *s2a_rb_image_header(void) {
+    static const struct mach_header_64 *header;   // same value for every caller; a race only repeats the lookup
+    if (!header) {
+        Dl_info info;
+        header = dladdr((const void *)&s2a_rb_image_header, &info) && info.dli_fbase
+            ? (const struct mach_header_64 *)info.dli_fbase : (const struct mach_header_64 *)_dyld_get_image_header(0);
+    }
+    return header;
+}
+
+const struct mach_header_64 *s2a_rb_main_header(void) {
+    return (const struct mach_header_64 *)_dyld_get_image_header(0);
+}
+#endif
