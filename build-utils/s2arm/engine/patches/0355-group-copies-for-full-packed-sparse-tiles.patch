+// Compare the sparse decode against the address of every byte, including clipped tiles,
+// destination row padding and unaligned buffers. Each tile has independent storage.
+static void sparse_copy_cases(void) {
+    static const int formats[] = {0x01, 0x0d, 0x25, 0x42, 0x44, 0x8b};
+    const int saved_order = nvn_gob_switch2;
+    uint8_t *storage = malloc(65537);
+    if (!storage) abort();
+    for (size_t k = 1; k < 65537; k++) storage[k] = rnd();
+
+    for (int order = 0; order < 2; order++) {
+        nvn_gob_switch2 = order;
+        for (size_t f = 0; f < sizeof formats / sizeof formats[0]; f++) {
+            int bw, bh;
+            uint32_t bpb = nvn_fmt_bpb(formats[f], &bw, &bh);
+            for (unsigned shift = 0; shift <= 7; shift++) {
+                uint32_t tile_bytes = (128u >> shift) * 64, tile_rows = 8u << shift;
+                size_t pitch = tile_bytes + 13, size = pitch * tile_rows + 9;
+                nvn_texdesc d = { .target = 1, .format = formats[f], .flags = 0x20,
+                    .width = (tile_bytes / bpb + 1) * bw, .height = (tile_rows + 1) * bh,
+                    .depth = 1, .levels = 1, .pkg_layout = (int)shift + 1 };
+                uint8_t *expected = malloc(size), *got = malloc(size);
+                if (!expected || !got) abort();
+                for (unsigned ty = 0; ty <= 1; ty++) for (unsigned tx = 0; tx <= 2; tx++) {
+                    uint32_t width = tx == 0 ? tile_bytes : tx == 1 ? bpb : 0;
+                    uint32_t height = width == 0 ? 0 : ty == 0 ? tile_rows : 1;
+                    memset(expected, 0xCD, size);
+                    for (uint32_t y = 0; y < height; y++)
+                        for (uint32_t x = 0; x < width; x++)
+                            expected[3 + y * pitch + x] = storage[1 + nvn_bl_offset(x, y, 0, tile_bytes, tile_rows, shift, 0)];
+                    for (int grouped = 0; grouped <= 1; grouped++) {
+                        memset(got, 0xCD, size);
+                        uint32_t actual_width, actual_height;
+                        int status = nvn_deswizzle_tile_mode(&d, 0, tx, ty, storage + 1, got + 3,
+                            pitch, &actual_width, &actual_height, grouped);
+                        CHECK(!status && actual_width == width && actual_height == height && !memcmp(got, expected, size),
+                              "sparse order %d format %#x tileH %u xy %u,%u grouped %d", order, formats[f], shift, tx, ty, grouped);
+                    }
+                }
+                free(got); free(expected);
+            }
+        }
+    }
+    free(storage);
+    nvn_gob_switch2 = saved_order;
+}
+
 int main(void) {
+    sparse_copy_cases();
     printf("A round trip (random data, non-power-of-2 sizes)\n");
