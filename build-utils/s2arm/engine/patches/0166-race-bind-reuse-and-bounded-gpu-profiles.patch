+    if (!enabled || !rb_course_exact() || !dur_us) return;
+    unsigned k = (unsigned)(g_race_probe.count++ % 120);
+    double ms = f > 4 ? nvn_be_gpu_ms(f - 4) : -1;
+    uint32_t gpu = ms >= 0 ? (uint32_t)MIN(ms * 1000.0, 1e9) : 0;
+    g_race_probe.duration_sum += dur_us; g_race_probe.duration_sum -= g_race_probe.duration[k];
+    g_race_probe.draws_sum += draws; g_race_probe.draws_sum -= g_race_probe.draws[k];
+    g_race_probe.gpu_sum += gpu; g_race_probe.gpu_sum -= g_race_probe.gpu[k];
+    g_race_probe.valid_sum += ms >= 0; g_race_probe.valid_sum -= g_race_probe.valid[k];
+    g_race_probe.duration[k] = dur_us; g_race_probe.draws[k] = draws;
+    g_race_probe.gpu[k] = gpu; g_race_probe.valid[k] = ms >= 0;
+    if (g_race_probe.count < 120 || f < 1200 || f % 120 || g_race_probe.taken >= 3 ||
+        g_race_probe.draws_sum / 120 < 800 || g_race_probe.valid_sum < 60) return;
+    uint64_t now = now_ns();
+    if (!g_race_probe.started) g_race_probe.started = now;
+    double period = 1e6 * nvn_fps_period(1.0 / nvn_be_fps_target());
+    if (g_race_probe.duration_sum / 120.0 < period * 1.2) return;
