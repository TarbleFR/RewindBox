+    for (int k = 0; k < 11; k++) atomic_store_explicit(&rb_bind_published[k], v[k], memory_order_relaxed);
+    atomic_store_explicit(&rb_push_published[0], rb_push_same, memory_order_relaxed);
+    atomic_store_explicit(&rb_push_published[1], rb_push_changed, memory_order_relaxed);
+}
+void nvn_be_rb_bind_stats(uint64_t v[11]) {
+    for (int k = 0; k < 11; k++) v[k] = atomic_load_explicit(&rb_bind_published[k], memory_order_relaxed);
