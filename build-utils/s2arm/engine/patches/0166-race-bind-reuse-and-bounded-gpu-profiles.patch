+// Repeated CBUF binds need the same immutable pool-address metadata. Content,
+// deferred-update shadows, widening and bounds are still resolved on every draw.
+// No strong references: ordinary resident pools retain their existing lifetime.
+static uint64_t bp_now(void);
+static int rb_course_exact(void);
+static uint64_t rb_push_same, rb_push_changed;
