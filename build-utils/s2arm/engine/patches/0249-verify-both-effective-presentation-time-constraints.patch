+static inline int rb_mach_verified(int set_ok, int live, thread_time_constraint_policy_data_t request,
+                                    thread_time_constraint_policy_data_t effective,
+                                    mach_timebase_info_data_t timebase, int strict) {
+    uint32_t limit = strict ? request.computation : rb_mach_ticks(RB_RT_MAX_NS, timebase);
+    if (!rb_rt_verified(set_ok, live, effective.computation, limit)) return 0;
+    return !strict || (effective.constraint >= effective.computation && effective.constraint <= request.constraint);
+}
+
 static inline int rb_mach_timeshare(thread_t thread, kern_return_t *set_kr, kern_return_t *read_kr) {
     thread_extended_policy_data_t policy = {.timeshare=TRUE};
     *set_kr = thread_policy_set(thread,THREAD_EXTENDED_POLICY,(thread_policy_t)&policy,THREAD_EXTENDED_POLICY_COUNT);
