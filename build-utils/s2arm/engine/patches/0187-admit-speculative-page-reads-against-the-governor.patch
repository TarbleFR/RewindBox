+// Called only by optional readers. The demand probe has its own rb_wn_demand path.
+static _Atomic uint64_t rb_gov_prefetch_inflight, rb_gov_prefetch_skipped;
+static uint64_t rb_wn(const void *p, uint64_t n) {
+    if (!rb_gov_on()) return rb_wn_(p, n, NULL, NULL, 0, 0);
+    rb_gov_sample(0);
+    uint64_t limit = rb_gov_quota(RB_GOV_PREFETCH);
+    uint64_t old = atomic_load(&rb_gov_prefetch_inflight);
+    do {
+        if (old > limit || n > limit - old) {
+            atomic_fetch_add_explicit(&rb_gov_prefetch_skipped,n,memory_order_relaxed);
+            return RB_WN_NONE;
+        }
+    } while (!atomic_compare_exchange_weak(&rb_gov_prefetch_inflight,&old,old+n));
+    uint64_t probed = rb_wn_(p,n,NULL,NULL,0,0);
+    atomic_fetch_sub(&rb_gov_prefetch_inflight,n);
+    return probed;
+}
