+// A dirty GOB rectangle in a single-level 2D texture. Coordinates are bytes
+// across a block row and format-block rows down (also for native BC/ASTC).
+int nvn_deswizzle_rect_2d(const nvn_texdesc *d, const void *storage, size_t storage_size,
+                          uint32_t xbyte, uint32_t yrow, uint32_t width_bytes, uint32_t height,
+                          void *dst) {
+    if (!d || !storage || !dst || d->target != 1 || d->levels > 1 || (d->flags & 0x70) ||
+        d->samples > 1 || !width_bytes || !height || xbyte % 64 || yrow % 8) return -1;
+    uint32_t pitch, rows, slices, bpb, gobs;
+    uint64_t base;
+    unsigned th, td;
+    if (nvn_deswizzle_geom_ex(d, 0, 0, &pitch, &rows, &slices, &base, &th, &td, &bpb, &gobs) ||
+        td || slices != 1 || !gobs || gobs > UINT32_MAX / 64 || gobs * 64 < pitch ||
+        xbyte >= pitch || width_bytes > pitch - xbyte || yrow >= rows || height > rows - yrow ||
+        (size_t)width_bytes > SIZE_MAX / height || base > storage_size) return -1;
+
+    // The greatest GOB base in the rectangle has both the greatest column
+    // and greatest eight-row group. Validate its entire 512 bytes before copying.
+    uint32_t last_x = (xbyte + width_bytes - 1) & ~63u;
+    uint32_t last_y = (yrow + height - 1) & ~7u;
+    uint64_t last = nvn_bl_offset(last_x, last_y, 0, gobs * 64, rows, th, 0);
+    if (storage_size - base < 512 || last > storage_size - base - 512) return -1;
+    const uint8_t *src = (const uint8_t *)storage + base;
+    const int sw2 = nvn_gob_switch2 != 0;
+    for (size_t y = 0; y < height; y += 8) {
+        for (size_t x = 0; x < width_bytes; x += 64) {
+            const uint8_t *gob = src + nvn_bl_offset(xbyte + x, yrow + y, 0, gobs * 64, rows, th, 0);
+            uint8_t *out = (uint8_t *)dst + y * width_bytes + x;
+            size_t w = width_bytes - x < 64 ? width_bytes - x : 64;
+            size_t h = height - y < 8 ? height - y : 8;
+            if (w == 64 && h == 8) {
+                if (sw2) copy_gob_8x64_sw2_to_lin(gob, out, width_bytes);
+                else copy_gob_8x64_sw1_to_lin(gob, out, width_bytes);
+            } else {
+                for (size_t r = 0; r < h; ++r)
+                    for (size_t c = 0; c < w; c += 16)
+                        memcpy(out + r * width_bytes + c, gob + gob_off_mode(c, r, sw2),
+                               w - c < 16 ? w - c : 16);
+            }
+        }
+    }
+    return 0;
+}
