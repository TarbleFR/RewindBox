 extern void *h_nvnBootstrapLoader(const char *name);
+// The test thread owns the actual registration/enqueue mutex throughout the
+// bind. A blocking recorder cannot finish until after the assertion deadline.
+static void check_bind_during_registration(prog_t program) {
+    dispatch_semaphore_t returned = dispatch_semaphore_create(0);
+    os_unfair_lock_lock(&g_shpre_mu);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        nvn_be_prog_bound(&program);
+        dispatch_semaphore_signal(returned);
+    });
+    long timedOut = dispatch_semaphore_wait(returned, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
+    os_unfair_lock_unlock(&g_shpre_mu);
+    GPU_CHECK(!timedOut && !g_rb_bind_q && !g_rb_bind_jobs && !g_rb_bind_bytes);
+}
