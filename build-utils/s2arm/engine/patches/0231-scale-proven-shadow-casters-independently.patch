+    CHECK(rb_shadow_calls(F(CALL "; if(x) {" GATHER ";}" CALL ";"),"main0",v)==2);
+    CHECK(rb_shadow_is(v[0].texture,"map") && rb_shadow_is(v[0].sampler,"comparison"));
+    CHECK(rb_shadow_is(v[1].texture,"cascade") && rb_shadow_is(v[1].sampler,"pcf"));
+    CHECK(rb_shadow_calls(F("spvDescriptorSet0.map.sample(spvDescriptorSet0.comparison, uv);"),"main0",v)==0);
+    CHECK(rb_shadow_calls(F("spvDescriptorSet0.map.sample_compare(localSampler, uv,z);"),"main0",v)==0);
+    CHECK(rb_shadow_calls(F("spvDescriptorSet0.maps[i].sample_compare(spvDescriptorSet0.s, uv,z);"),"main0",v)==0);
+    CHECK(rb_shadow_calls(F("/*" CALL "*/ // " GATHER "\n \"" CALL "\";"),"main0",v)==0);
+    CHECK(rb_shadow_calls(F(CALL),"different",v)==0);
+    CHECK(rb_shadow_calls("vertex float main0(int x){" CALL ";}", "main0",v)==0);
+    CHECK(rb_shadow_calls("fragment float other(){" CALL ";}" F("return 1;"),"main0",v)==0);
+    CHECK(rb_shadow_calls(F("#if 0\n" CALL "\n#endif"),"main0",v)==0);
+    CHECK(rb_shadow_calls("fragment float main0(int x){" CALL ";", "main0",v)==0);
+}
+static void projection(void) {
+    const unsigned pct[]={100,85,75};
+    for (unsigned k=0;k<3;k++) {
+        unsigned p=pct[k]; double scale=p/100.0;
+        for (unsigned dim=1;dim<=1537;dim++) CHECK(rs_up(dim,scale)==(dim*p+99)/100);
+        CHECK(rs_up(960,scale)==(k==0?960:k==1?816:720));
+        CHECK(rs_up(540,scale)==(k==0?540:k==1?459:405));
+        CHECK(rs_up(1536,0.75)==1152); // independent of the 3D tier
+        double x=3,y=7,w=1531,h=1527;
+        rb_scale_viewport(scale,&x,&y,&w,&h);
+        CHECK(fabs(x-(double)(3*p)/100)<1e-9 && fabs(y-(double)(7*p)/100)<1e-9 &&
+              fabs(w-(double)(1531*p)/100)<1e-9 && fabs(h-(double)(1527*p)/100)<1e-9);
+        for (long j=0;j<48;j++) {
+            long sx=j,sy=3*j,sw=2*j+1,sh=j+5;
+            long x0=sx*p/100,y0=sy*p/100;
+            long x1=((sx+sw)*p+99)/100,y1=((sy+sh)*p+99)/100;
+            rs_rect(scale,&sx,&sy,&sw,&sh);
+            CHECK(sx==x0 && sy==y0 && sw==x1-x0 && sh==y1-y0);
+        }
+    }
+}
