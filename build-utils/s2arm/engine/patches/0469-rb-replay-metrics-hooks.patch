     int fam = 0; const MTLGPUFamily fams[] = {MTLGPUFamilyApple6, MTLGPUFamilyApple7, MTLGPUFamilyApple8, MTLGPUFamilyApple9};   // sparse textures: Apple6 on; placement sparse: Apple8 on, some Apple7
