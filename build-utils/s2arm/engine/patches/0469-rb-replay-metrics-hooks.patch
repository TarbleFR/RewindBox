--- a/graphics/nvn/gfx/nvn/nvn_rec.h
+++ b/graphics/nvn/gfx/nvn/nvn_rec.h
@@ -142,6 +142,14 @@ enum {
     RO_Q_BLOCK,
     RO_WAIT_EVENT,   // a[0] retained event, a[1] target value
 };
+// RewindBox (patch 0469): observation hooks of the hardware-independent replay metrics (build-utils/s2arm/engine/tests/t_rb_replay_metrics.m). Empty unless a test defines them
+//   before including nvn_mtl.m: S2A_REC_PUT_HOOK(op) for every record the submit thread makes, S2A_REC_EXEC_HOOK(r) for every record before the encode thread makes its call
+#ifndef S2A_REC_PUT_HOOK
+#define S2A_REC_PUT_HOOK(op) ((void)0)
+#endif
+#ifndef S2A_REC_EXEC_HOOK
+#define S2A_REC_EXEC_HOOK(r) ((void)0)
+#endif
 typedef struct { uint32_t op, nobj; uint64_t a[15]; } rec_t;   // the first nobj slots hold retained objects (0 for nil), released once the call is made
 enum { REC_BLK = 256 };
 typedef struct rec_blk { struct rec_blk *next; int n; rec_t r[REC_BLK]; } rec_blk;
@@ -217,6 +225,7 @@ static inline IMP rx_imp(uint32_t op, id o, SEL s) {
 #define RX_CALL(op, o, T, sel, ...) do { id rx_o_ = (o); if (rx_o_) ((T)rx_imp(op, rx_o_, @selector(sel)))(rx_o_, @selector(sel), __VA_ARGS__); } while (0)
 static void dlss_fx_run(id cb, const uint64_t *a);   // nvn_dlss.inc: a[0] scaler, a[1..4] color / depth / motion / output (retained by the record), the rest its parameters
 static void rec_exec(const rec_t *r) {
+    S2A_REC_EXEC_HOOK(r);   // RewindBox (patch 0469)
     const uint64_t *a = r->a; id e = g_rx_enc;
     switch (r->op) {
     case RO_CB_NEW: g_rx_cb = g_m3 ? [g_q3 commandBufferWithUnretainedReferences] : [g_dev newCommandBuffer]; break;   // Metal 3: as m3_cb
@@ -415,6 +424,7 @@ static void rec_lane_splice(void) {
     pthread_mutex_unlock(&g_rb_mu);
 }
 static rec_t *rec_put(uint32_t op, uint32_t nobj) {
+    S2A_REC_PUT_HOOK(op);   // RewindBox (patch 0469)
     if (g_rlane) { int k = g_rlane; rec_blk *b = g_lane_tail[k];
         if (!b || b->n == REC_BLK) { rec_blk *nb = rec_blk_get(); if (b) b->next = nb; else g_lane_head[k] = nb; g_lane_tail[k] = b = nb; }
         rec_t *r = &b->r[b->n++]; r->op = op; r->nobj = nobj; return r; }
