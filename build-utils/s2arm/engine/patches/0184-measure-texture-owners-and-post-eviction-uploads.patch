+int nvn_rb_texture_snapshot(rb_texture_stats *out) {
+    if (!rb_tex_budget_on() || !out) return -1;
+    memset(out, 0, sizeof *out);
+    out->budget = atomic_load(&rb_texture_budget);
+    out->volatileBytes = atomic_load(&rb_tex_volatile_bytes);
+    out->full = atomic_load(&rb_tex_full); out->partial = atomic_load(&rb_tex_partial);
+    out->evictionUploads = atomic_load(&rb_cold_repeat);
+    out->evictionGuestBytes = atomic_load(&rb_cold_repeat_bytes);
+    out->changedOrUnknown = atomic_load(&rb_cold_changed_repeat);
+    out->evicted = atomic_load(&rb_cold_evictions); out->madeVolatile = atomic_load(&rb_cold_volatile);
+    out->purged = atomic_load(&rb_cold_empty); out->sparesEvicted = atomic_load(&rb_spare_evictions);
+    out->stagingBytes = atomic_load(&rb_tex_staging);
+    os_unfair_lock_lock(&rb_tex_census_lock);
+    out->censusTextures = rb_tex_census_textures; out->censusHeaps = rb_tex_census_heaps;
+    out->censusNs = rb_tex_census_ns;
+    os_unfair_lock_unlock(&rb_tex_census_lock);
+    @autoreleasepool {
+        if (pthread_mutex_trylock(&g_res_mu)) return 0;
+        NSArray *objects = g_res_objects.allObjects;
+        pthread_mutex_unlock(&g_res_mu);
+        if (!objects) return 0;
+        NSHashTable *seen = nvn_mem_account_snapshot();
+        for (id obj in objects) {
+            unsigned kind = 0; id root = nvn_mem_account_root(obj, &kind);
+            if (!root || (kind != NVN_MEM_TEXTURE && kind != NVN_MEM_HEAP) || [seen containsObject:root]) continue;
+            [seen addObject:root];
+            if (kind == NVN_MEM_TEXTURE) out->residentTextures += [(id<MTLAllocation>)root allocatedSize];
+            else out->residentHeaps += [(id<MTLHeap>)root size];
+        }
+        out->residencyValid = 1;
+    }
+    return 0;
+}
