diff --git a/graphics/nvn/gfx/nvn/nvn_mtl.m b/graphics/nvn/gfx/nvn/nvn_mtl.m
index 5437540..8cfb2db 100644
--- a/graphics/nvn/gfx/nvn/nvn_mtl.m
+++ b/graphics/nvn/gfx/nvn/nvn_mtl.m
@@ -2552,6 +2552,20 @@ void nvn_be_alias_drop_pool(const void *pool) {
 // keeps its own reference, so the entry's reference is only unref'd while one does; otherwise the texture is retired (deferred until the submissions that used it complete).
 // Cached texture-ID views follow g_ser_gen. Caller holds g_smu
 enum { ALIAS_IDLE = 16 };
+// RewindBox (patch 0058): "the last ALIAS_IDLE submissions" also means the game's own submissions (nvn_be_submit), not only the back end's. Since the cross-queue ordering
+//   (nvn_xqueue.inc) a game submission that parks at an event wait is replayed in pieces, each a submission of the back end with its own fence, and patch 0053 parks Mario Kart
+//   World's two queues at each other's events: its engine log of 16 November (IPA 762) counts 24,353 parks in 9,000 game submissions, about 7.4 fences a frame where there
+//   were 2. Sixteen fences, eight frames of that game before, became two: a texture not looked up for two frames lost its place to the next texture made over its storage,
+//   and one made again there starts from zeros (tex_init_fill). An entry is now spared when it was looked up in the last ALIAS_IDLE fences, as before, or since the start of
+//   the game submission ALIAS_IDLE ago. Not measured: whether any picture defect came from it (the one-frame vegetation changes of that game were on IPA 760 too)
+static _Atomic uint64_t g_alias_gsub[ALIAS_IDLE], g_alias_gsub_n;   // g_fence + 1 at the start of each of the game's last ALIAS_IDLE submissions (a ring), and how many it made
+static void alias_game_submission(void) { uint64_t n = atomic_fetch_add(&g_alias_gsub_n, 1); atomic_store(&g_alias_gsub[n % ALIAS_IDLE], g_fence + 1); }   // nvn_be_submit, before the submission's first piece
+static int alias_recent(uint64_t at) {   // at: g_fence + 1 at a lookup, a creation or a GPU write (0 = none)
+    if (!at) return 0;
+    if (g_fence + 1 - at < ALIAS_IDLE) return 1;
+    uint64_t n = atomic_load(&g_alias_gsub_n);
+    return n >= ALIAS_IDLE && at >= atomic_load(&g_alias_gsub[n % ALIAS_IDLE]);   // the ring's oldest entry: the game submission ALIAS_IDLE ago
+}
 static uint64_t g_alias_taken;   // shared textures evicted when another texture took over their storage (for the memory report)
 static nvn_hmap g_ghost;   // defined below (finalized texture serials)
 static nvn_hmap g_ghost_active = {.klen = 8};   // finalized serials resolved while the current submission is encoded (serial → retained object), under g_smu; see ghost_finish_submission
@@ -2589,10 +2603,10 @@ static void alias_take_over(const alias_key *nk) {
         if (k.pool != nk->pool || !memcmp(&k, nk, sizeof k) || k.off >= hi) continue;
         nvn_texlayout kl; nvn_tex_layout(&k.d, &kl);
         uint64_t seen = (uint64_t)(uintptr_t)nvn_hm_get(&g_alias_seen, &k);
-        if (k.off + (int64_t)kl.size <= lo || (seen && g_fence + 1 - seen < ALIAS_IDLE)) continue;
+        if (k.off + (int64_t)kl.size <= lo || alias_recent(seen)) continue;
         if (serial_holds(&g_by_serial, (__bridge id)g_alias.vals[i])) {   // a live object's content stays unless it is idle and another texture wrote over it since its own last use / write
             uint64_t own = (uint64_t)(uintptr_t)nvn_hm_get(&g_alias_wrote, &k), last = MAX(seen, own);   // a live object resolves through the serial table (no lookup here): its own GPU writes say it is in use
-            if ((own && g_fence + 1 - own < ALIAS_IDLE) || !alias_overwritten(&k, k.off, k.off + (int64_t)kl.size, last)) continue; }
+            if (alias_recent(own) || !alias_overwritten(&k, k.off, k.off + (int64_t)kl.size, last)) continue; }
         ks[n++] = k;
     }
     for (uint32_t j = 0; j < n; j++) {
@@ -2628,7 +2642,7 @@ static int alias_orph_cand(uint32_t i, CFSetRef held, alias_key *k) {   // calle
     if (!g_alias.vals[i] || CFSetContainsValue(held, g_alias.vals[i])) return 0;
     memcpy(k, g_alias.keys + (size_t)i * g_alias.klen, sizeof *k);
     uint64_t seen = (uint64_t)(uintptr_t)nvn_hm_get(&g_alias_seen, k);
-    return !(seen && g_fence + 1 - seen < ALIAS_IDLE) && !(k->d.flags & (NVN_TEXTURE_FLAGS_DISPLAY | NVN_TEXTURE_FLAGS_VIDEO_DECODE));
+    return !alias_recent(seen) && !(k->d.flags & (NVN_TEXTURE_FLAGS_DISPLAY | NVN_TEXTURE_FLAGS_VIDEO_DECODE));
 }
 static CFMutableSetRef alias_held(void) {   // caller holds g_smu: what live objects and finalized serials still resolve to
     CFMutableSetRef held = CFSetCreateMutable(NULL, 0, NULL);
@@ -2689,7 +2703,7 @@ static void alias_orphan_pass(void) {
     }
     if (nr) { pthread_mutex_lock(&g_smu); CFMutableSetRef h2 = alias_held();
         for (uint32_t j = 0; j < nr; j++) { void *v = nvn_hm_get(&g_alias, &wr[j].k); uint64_t seen = (uint64_t)(uintptr_t)nvn_hm_get(&g_alias_seen, &wr[j].k);
-            if (!v || CFSetContainsValue(h2, v) || (seen && g_fence + 1 - seen < ALIAS_IDLE)) continue;   // taken up again meanwhile
+            if (!v || CFSetContainsValue(h2, v) || alias_recent(seen)) continue;   // taken up again meanwhile
             wbytes -= (int64_t)alias_orph_drop(&wr[j].k, 1); }
         CFRelease(h2); pthread_mutex_unlock(&g_smu); }
     if (g_orph_lv) { pthread_mutex_lock(&g_smu); int64_t d = wbytes - g_orph_noted; g_orph_noted = wbytes; pthread_mutex_unlock(&g_smu); if (d) g_orph_lv->note(g_orph_lv_me, d); }   // attribution: the ledger asks the largest holders first
