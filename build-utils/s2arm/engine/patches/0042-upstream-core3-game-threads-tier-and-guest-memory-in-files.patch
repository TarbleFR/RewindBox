+//   sessions whose guest memory was not in files. S2A_SYSCORE_QOS=utility / same still force either. Weak: the standalone tests link thread.c without vawin.c
+extern int s2a_guest_fd(void) __attribute__((weak));
+static int syscore_in_files(void) { return s2a_guest_fd && s2a_guest_fd() >= 0; }
+static int syscore_utility(void) {
+    const char *v = getenv("S2A_SYSCORE_QOS");
+    if (v && !strcmp(v, "utility")) return 1;
