diff --git a/graphics/nvn/gfx/nvn/rb_memory_governor.inc b/graphics/nvn/gfx/nvn/rb_memory_governor.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_memory_governor.inc
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+// One published word contains the tier and total MiB. All four quotas derive
+// from that word, so a pressure callback never publishes a partial allocation.
+enum { RB_GOV_PREFETCH, RB_GOV_UPLOAD, RB_GOV_TEXTURE, RB_GOV_PIPELINE };
+enum { RB_GOV_NORMAL, RB_GOV_WARN, RB_GOV_CRITICAL };
+static _Atomic unsigned rb_gov_plan = (128u << 2) | RB_GOV_WARN;
+static _Atomic uint64_t rb_gov_next, rb_gov_room = UINT64_MAX;
+static pthread_mutex_t rb_gov_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t rb_gov_warn_until, rb_gov_critical_until, rb_gov_recover_since;
+static int rb_gov_on(void) { return rb_tex_budget_on() && rb_pso_cap_on(); }
+static uint64_t rb_gov_share(unsigned plan, unsigned owner) {
+    static const unsigned weights[][4] = {{4,4,7,1},{0,3,12,1},{0,2,13,1}};
+    return ((uint64_t)(plan >> 2) << 20) / 16 * weights[plan & 3u][owner];
+}
+static uint64_t rb_gov_quota(unsigned owner) {
+    return rb_gov_share(atomic_load_explicit(&rb_gov_plan,memory_order_acquire),owner);
+}
+static void rb_gov_sample(unsigned long event) {
+#if TARGET_OS_IPHONE
+    uint64_t now = bp_now();
+    if (!event && now < atomic_load_explicit(&rb_gov_next,memory_order_relaxed)) return;
+    pthread_mutex_lock(&rb_gov_mu);
+    now = bp_now();
+    if (!event && now < atomic_load(&rb_gov_next)) { pthread_mutex_unlock(&rb_gov_mu); return; }
+    atomic_store(&rb_gov_next,now + 500 * NSEC_PER_MSEC);
+    uint64_t room = rb_ios_headroom();
+    atomic_store(&rb_gov_room,room);
+    if (event & DISPATCH_MEMORYPRESSURE_CRITICAL) rb_gov_critical_until = now + 15ull*NSEC_PER_SEC;
+    if (event & (DISPATCH_MEMORYPRESSURE_CRITICAL | DISPATCH_MEMORYPRESSURE_WARN))
+        rb_gov_warn_until = now + 30ull*NSEC_PER_SEC;
+    unsigned old = atomic_load(&rb_gov_plan), tier = RB_GOV_NORMAL;
+    if (now < rb_gov_critical_until || room <= (768ull << 20)) tier = RB_GOV_CRITICAL;
+    else if (now < rb_gov_warn_until || room == UINT64_MAX || room <= (2048ull << 20)) tier = RB_GOV_WARN;
+    unsigned before = old & 3u;
+    if (tier < before) {
+        uint64_t floor = before == RB_GOV_CRITICAL ? (1024ull << 20) : (2304ull << 20);
+        if (room == UINT64_MAX || room < floor) rb_gov_recover_since = 0;
+        else if (!rb_gov_recover_since) rb_gov_recover_since = now;
+        if (!rb_gov_recover_since || now - rb_gov_recover_since < 10ull*NSEC_PER_SEC) tier = before;
+    } else rb_gov_recover_since = 0;
+    if (tier != before) rb_gov_recover_since = 0;
+    unsigned ceiling = tier == RB_GOV_NORMAL ? 512 : tier == RB_GOV_WARN ? 128 : 32;
+    unsigned mib = room == UINT64_MAX ? 64 : (unsigned)MIN((uint64_t)ceiling,MAX(16ull,(room >> 20)/8));
+    mib = MIN(ceiling,(mib / 16) * 16);
+    unsigned plan = (mib << 2) | tier;
+    atomic_store_explicit(&rb_gov_plan,plan,memory_order_release);
+    if (event || plan != old) MLOG("[RB-MEM-GOV] owner=prefetch optional_reads=%s budget_bytes=%llu",
+        tier == RB_GOV_NORMAL ? "admitted" : "held", (unsigned long long)rb_gov_share(plan,RB_GOV_PREFETCH));
+    if (event || plan != old) MLOG("[RB-MEM-GOV] tier=%u event=%lu headroom_MiB=%lld total_MiB=%u ordered_quotas_bytes prefetch=%llu upload=%llu texture=%llu pipeline=%llu",
+        tier,event,room == UINT64_MAX ? -1ll : (long long)(room >> 20),mib,
+        (unsigned long long)rb_gov_share(plan,0),(unsigned long long)rb_gov_share(plan,1),
+        (unsigned long long)rb_gov_share(plan,2),(unsigned long long)rb_gov_share(plan,3));
+    pthread_mutex_unlock(&rb_gov_mu);
+#else
+    (void)event;
+#endif
+}
