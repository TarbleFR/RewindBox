 // Process launch switches. Pointers stay in their original allocator and ABI.
+static inline int rb_mem_gov_switch(void) {
+#if defined(__APPLE__) && TARGET_OS_IOS
+    static _Atomic int mode;
+    int v = atomic_load_explicit(&mode, memory_order_relaxed);
+    if (!v) {
+        const char *env = getenv("S2A_RB_MEM_GOV");
+        v = env && !strcmp(env, "0") ? -1 : 1;
+        atomic_store_explicit(&mode, v, memory_order_relaxed);
+    }
+    return v > 0;
+#else
+    return 0;
+#endif
+}
