+// S3: keep compressed depth storage free of PixelFormatView. Only a stencil
+// read materializes an independent Stencil8 plane; no depth copy, no per-pass
+// repacking, and the original combined texture stays the authoritative writer.
+// Caller is tex_by_id under g_rmu on the replay thread. Copies/fills/attachment
+// writes invalidate every cached stencil view overlapping the written storage.
+#define RB_STENCIL_SLOTS 4
+#define RB_STENCIL_BYTES (8ull<<20)
+@interface RBStencilPlane : NSObject { @public __weak id<MTLTexture> base; id<MTLTexture> plane; id<MTLBuffer> staging;
+    uintptr_t address; uint64_t length,bytes,stamp,fence; } @end
+@implementation RBStencilPlane @end
+static RBStencilPlane *g_rb_stencil_planes[RB_STENCIL_SLOTS];
+static pthread_mutex_t g_rb_stencil_mu=PTHREAD_MUTEX_INITIALIZER;
+static _Atomic unsigned g_rb_stencil_count;
+static uint64_t g_rb_stencil_bytes,g_rb_stencil_clock,g_rb_stencil_copies,g_rb_stencil_copied_bytes;
+static void rb_stencil_written(const tex_t *t) {
+    if (!t || !t->mem || !atomic_load_explicit(&g_rb_stencil_count,memory_order_relaxed)) return;
+    uintptr_t lo=(uintptr_t)t->mem; uint64_t len=t->L.size;
+    pthread_mutex_lock(&g_rb_stencil_mu); BOOL changed=NO;
+    for (unsigned i=0;i<RB_STENCIL_SLOTS;i++) { RBStencilPlane *p=g_rb_stencil_planes[i];
+        if (p && lo<p->address+p->length && p->address<lo+len) { changed=YES; break; }
+    }
+    pthread_mutex_unlock(&g_rb_stencil_mu);
+    // Separate planes have view_sa=0: neither the local nor additions-only view
+    // shortcut can keep them across this epoch. Other views keep their rules.
+    if (changed) atomic_fetch_add_explicit(&g_ser_gen,1,memory_order_release);
+}
+static void rb_stencil_remove(unsigned i) {
+    RBStencilPlane *p=g_rb_stencil_planes[i]; if (!p) return;
+    // Eviction is admitted only after the last consumer completes (or session
+    // drain). Do not turn a bounded cache into unbounded deferred allocations.
+    res_remove(p->plane); res_remove(p->staging);
+    g_rb_stencil_bytes-=p->bytes; g_rb_stencil_planes[i]=nil; atomic_fetch_sub(&g_rb_stencil_count,1);
+    atomic_fetch_add_explicit(&g_ser_gen,1,memory_order_release);
+}
+static id<MTLTexture> rb_stencil_plane(const tex_t *t,id<MTLTexture> base) {
+    if (!rb_ds_compress_on() || !on_sub_thread() || !t || !t->mem || !t->L.size ||
+        base.pixelFormat!=MTLPixelFormatDepth32Float_Stencil8 || base.storageMode!=MTLStorageModePrivate ||
+        base.textureType!=MTLTextureType2D || base.mipmapLevelCount!=1 || base.sampleCount!=1 ||
+        base.arrayLength!=1 || base.parentTexture || base.heap || base.buffer || base.isSparse || base.iosurface ||
+        (t->pool && ((t->pool->flags&NVN_MEMORY_POOL_FLAGS_VIRTUAL) || nvn_sparse_pool(t->pool)))) return nil;
+    // Feedback from the current attachment has per-draw snapshot semantics;
+    // leave it to the existing DS snapshot/PixelFormatView implementation.
+    if (R.rt.depth && R.rt.depth->mem &&
+        (uintptr_t)t->mem<(uintptr_t)R.rt.depth->mem+R.rt.depth->L.size &&
+        (uintptr_t)R.rt.depth->mem<(uintptr_t)t->mem+t->L.size) return nil;
+    if (!base.width || !base.height || base.width>4096 || base.height>4096) return nil;
+    NSUInteger row=(base.width+255)&~(NSUInteger)255, size=row*base.height;
+    uint64_t bytes=(uint64_t)size+(uint64_t)base.width*base.height;
+    if (bytes>RB_STENCIL_BYTES || !rb_metal_working_room() || rb_ios_headroom()<(512ull<<20)) return nil;
+    pthread_mutex_lock(&g_rb_stencil_mu);
+    RBStencilPlane *p=nil; unsigned slot=0;
+    for (unsigned i=0;i<RB_STENCIL_SLOTS;i++) {
+        RBStencilPlane *candidate=g_rb_stencil_planes[i];
+        if (candidate && candidate->base==base && candidate->address==(uintptr_t)t->mem && candidate->length==t->L.size) { p=candidate; slot=i; break; }
+    }
+    if (!p) {
+        uint64_t done=atomic_load_explicit(&g_done,memory_order_acquire);
+        slot=RB_STENCIL_SLOTS;
+        for (unsigned i=0;i<RB_STENCIL_SLOTS;i++) {
+            RBStencilPlane *candidate=g_rb_stencil_planes[i];
+            if (!candidate) { slot=i; break; }
+            if (candidate->fence<=done && (slot==RB_STENCIL_SLOTS || candidate->stamp<g_rb_stencil_planes[slot]->stamp)) slot=i;
+        }
+        if (slot==RB_STENCIL_SLOTS) { pthread_mutex_unlock(&g_rb_stencil_mu); return nil; }
+        rb_stencil_remove(slot);
+        MTLTextureDescriptor *d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatStencil8 width:base.width height:base.height mipmapped:NO];
+        d.storageMode=MTLStorageModePrivate; d.usage=MTLTextureUsageShaderRead;
+        p=[RBStencilPlane new]; p->plane=[g_dev newTextureWithDescriptor:d];
+        p->staging=[g_dev newBufferWithLength:size options:MTLResourceStorageModePrivate];
+        if (!p->plane || !p->staging) { pthread_mutex_unlock(&g_rb_stencil_mu); return nil; }
+        bytes=p->plane.allocatedSize+p->staging.allocatedSize;
+        if (bytes>RB_STENCIL_BYTES) { pthread_mutex_unlock(&g_rb_stencil_mu); return nil; }
+        for (unsigned i=0;g_rb_stencil_bytes+bytes>RB_STENCIL_BYTES && i<RB_STENCIL_SLOTS;i++)
+            if (g_rb_stencil_planes[i] && g_rb_stencil_planes[i]->fence<=done) rb_stencil_remove(i);
+        if (g_rb_stencil_bytes+bytes>RB_STENCIL_BYTES) { pthread_mutex_unlock(&g_rb_stencil_mu); return nil; }
+        p->base=base; p->address=(uintptr_t)t->mem; p->length=t->L.size; p->bytes=bytes;
+        res_add(p->plane); res_add(p->staging); g_rb_stencil_planes[slot]=p;
+        g_rb_stencil_bytes+=bytes; atomic_fetch_add(&g_rb_stencil_count,1);
+    }
+    p->stamp=++g_rb_stencil_clock; p->fence=g_fence+1;
+    pthread_mutex_unlock(&g_rb_stencil_mu);
+    // tex_mtl has already applied CPU uploads/alias resolution. The normal
+    // blit() barriers order both copies, including the staging write->read.
+    rb_passdiag_read(base,11,0,0,0,"stencil-plane");
+    [blit() copyFromTexture:base sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(base.width,base.height,1) toBuffer:p->staging destinationOffset:0
+        destinationBytesPerRow:row destinationBytesPerImage:size options:MTLBlitOptionStencilFromDepthStencil];
+    enc_b_copy_buffer_texture(blit(),p->staging,0,row,size,MTLSizeMake(base.width,base.height,1),p->plane,0,0,MTLOriginMake(0,0,0));
+    g_rb_stencil_copies++; g_rb_stencil_copied_bytes+=base.width*base.height;
+    if (g_rb_stencil_copies<=4 || !(g_rb_stencil_copies&(g_rb_stencil_copies-1)))
+        MLOG("[rb-stencil-plane] copies=%llu stencil_bytes=%llu retained_bytes=%llu; depth storage unchanged",
+             (unsigned long long)g_rb_stencil_copies,(unsigned long long)g_rb_stencil_copied_bytes,(unsigned long long)g_rb_stencil_bytes);
+    return p->plane;
+}
+static void rb_stencil_retire(void) {
+    pthread_mutex_lock(&g_rb_stencil_mu);
+    for (unsigned i=0;i<RB_STENCIL_SLOTS;i++) rb_stencil_remove(i);
+    g_rb_stencil_clock=g_rb_stencil_copies=g_rb_stencil_copied_bytes=0;
+    pthread_mutex_unlock(&g_rb_stencil_mu);
+}
