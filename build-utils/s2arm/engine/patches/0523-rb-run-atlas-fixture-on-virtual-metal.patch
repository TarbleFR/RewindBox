 #ifndef NVN_FEEDBACK_SOURCE
 #define NVN_FEEDBACK_SOURCE "../gfx/nvn/nvn_mtl.m"
 #endif
+static int feedback_tracked;
+static void feedback_track(void);
+#define S2A_NO_RESIDENCY_SET() (feedback_tracked = 1)
+#define S2A_REC_EXEC_HOOK(r) feedback_track()
 #include NVN_FEEDBACK_SOURCE
 
+// The Mac runner GPU has no residency sets. Use the existing replay fixture's
+// approach: declare the engine's real allocations on each render/compute encoder.
+static void feedback_track(void) {
+    static __unsafe_unretained id last;
+    if (!feedback_tracked) return;
+    if (!g_rx_enc) { last = nil; return; }
+    if (g_rx_enc == last) return;
+    last = g_rx_enc;
+    pthread_mutex_lock(&g_res_mu);
+    NSArray *allocations = g_res_objects.allObjects;
+    pthread_mutex_unlock(&g_res_mu);
+    const NSUInteger count = allocations.count;
+    if (!count) return;
+    __unsafe_unretained id<MTLResource> *resources = calloc(count, sizeof(*resources));
+    if (!resources) abort();
+    NSUInteger used = 0;
+    for (id allocation in allocations)
+        if ([allocation conformsToProtocol:@protocol(MTLResource)]) resources[used++] = allocation;
+    const MTLResourceUsage usage = MTLResourceUsageRead | MTLResourceUsageWrite;
+    if (used && [g_rx_enc conformsToProtocol:@protocol(MTLRenderCommandEncoder)])
+        [(id<MTLRenderCommandEncoder>)g_rx_enc useResources:resources count:used usage:usage
+                                                     stages:MTLRenderStageVertex | MTLRenderStageFragment];
+    else if (used && [g_rx_enc conformsToProtocol:@protocol(MTLComputeCommandEncoder)])
+        [(id<MTLComputeCommandEncoder>)g_rx_enc useResources:resources count:used usage:usage];
+    free(resources);
+}
