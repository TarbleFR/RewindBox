+}
+// An explicit end-of-life from the guest applies in either safe store path.
+// Call only after all other store proofs fail, so bytes belong to one reason.
+static int rb_terminal_discard(const sd_att *att) {
+    unsigned slot = att->depth ? 8u : (unsigned)att->idx;
+    if (slot > 8 || !(g_rb_discard_mask & (1u << slot))) return 0;
+    const tex_t *tex = att->depth ? R.rt.depth : R.rt.color[slot];
+    if (!rb_discard_unique(tex, &R.rt, (int)slot) || tex->serial != att->ser) return 0;
+    g_rb_discard_n++;
+    g_rb_discard_bytes += att->bytes;
+    if (!(g_rb_discard_n & (g_rb_discard_n - 1)))
+        MLOG("[tbdr] guest discard stores elided=%llu logical_bytes=%llu",
+             (unsigned long long)g_rb_discard_n, (unsigned long long)g_rb_discard_bytes);
     return 1;
 }
