 }
-#define S2AL(key) [s2a_l10n_bundle() localizedStringForKey:(key) value:nil table:@"S2ArmHost"]
+// RewindBox (patch 0018): a language's table may hold only some of the keys (fr.lproj: the diagnostics question). A key it does not hold is read
+//   from the English table, not shown as its raw id. Tables that hold every key (en, zh-Hans) are read as before.
+static inline NSString *s2a_l10n(NSString *key) {
+    NSBundle *bundle = s2a_l10n_bundle();
+    NSString *text = [bundle localizedStringForKey:key value:@"\x01" table:@"S2ArmHost"];
+    if (![text isEqualToString:@"\x01"]) return text;
+    static NSBundle *english; static dispatch_once_t once;
+    dispatch_once(&once, ^{ NSString *path = [bundle pathForResource:@"en" ofType:@"lproj"]; english = path ? [NSBundle bundleWithPath:path] : nil; });
+    return [(english ?: bundle) localizedStringForKey:key value:nil table:@"S2ArmHost"];
+}
+#define S2AL(key) s2a_l10n(key)
 // RewindBox: the same bundle for the engine's other own resources and Info.plist keys (load page, HUD, diagnostics, community patch
