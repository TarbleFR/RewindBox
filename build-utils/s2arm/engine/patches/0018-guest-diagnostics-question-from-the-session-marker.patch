+#if defined(__APPLE__) && TARGET_OS_IPHONE
+// The folder ios/diag.m writes the marker in (1 = d holds it): 进程级容器 Documents（s2a_docs.h）；RewindBox guest: the engine's log directory (launch context)
+static int mark_home(char *d, size_t n) {
+    int r = s2a_container_docs(d, n); if (r <= 0 || (size_t)r >= n) return 0;
+    if (s2a_rb_guest_on()) { const s2a_launch_ctx *lc = s2a_launch_ctx_get(); if (!lc || (size_t)snprintf(d, n, "%s", lc->log_dir) >= n) return 0; }
+    return 1;
+}
+#endif
