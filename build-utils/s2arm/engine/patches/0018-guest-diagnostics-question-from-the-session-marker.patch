 }
-void s2a_sesmark_set(const char *docs, int state) {
+// RewindBox (patch 0018): a session at rest. The in-game Quit of a RewindBox guest parks the session (patch 0010) instead of shutting the engine down, so the
+//   orderly shutdown that deletes the marker never runs: the marker stayed "fg" while the host app went on, and an end of that app in the foreground read, at
+//   the game's next start, as a Switch 2 session that did not end normally. A parked session is at rest: its marker is deleted, as at an orderly end, and not
+//   written while it rests. The app's foreground / background changes still come in (ios/app.m): the last one is kept and written when the session resumes.
+//   One lock over the state and the file, so that a change arriving while the session parks is not written after the deletion. S2Arm.app never rests
+static pthread_mutex_t g_mark_mu = PTHREAD_MUTEX_INITIALIZER;
+static int g_mark_rest, g_mark_last = S2A_SESMARK_FG;   // under g_mark_mu
+static void mark_write(const char *docs, int state) {
     char p[1100]; if (!mark_path(docs, p, sizeof p)) return;
     if (state == S2A_SESMARK_NONE) { if (unlink(p) && errno != ENOENT) LOG("【红】会话标记删除失败 errno=%d", errno); return; }
     int fd = open(p, O_WRONLY | O_CREAT | O_TRUNC, 0644); if (fd < 0) { LOG("【红】会话标记写入失败 errno=%d", errno); return; }
     ssize_t w = write(fd, state == S2A_SESMARK_BG ? "bg\n" : "fg\n", 3); (void)w; close(fd);
 }
+void s2a_sesmark_set(const char *docs, int state) {
+    pthread_mutex_lock(&g_mark_mu);
+    if (state != S2A_SESMARK_NONE) g_mark_last = state;
+    if (state == S2A_SESMARK_NONE || !g_mark_rest) mark_write(docs, state);
+    pthread_mutex_unlock(&g_mark_mu);
+}
+void s2a_sesmark_rest(const char *docs, int rest) {   // 1 = the session is parked, 0 = it resumed
+    pthread_mutex_lock(&g_mark_mu);
+    g_mark_rest = rest != 0;
+    mark_write(docs, rest ? S2A_SESMARK_NONE : g_mark_last);
+    pthread_mutex_unlock(&g_mark_mu);
+}
