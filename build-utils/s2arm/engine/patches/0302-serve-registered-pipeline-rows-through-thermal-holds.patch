 static inline int rb_spec_worker_allowed(int level, int worker) {
     return level == RB_SPEC_RUN || (level == RB_SPEC_ONE && worker == 0);
 }
+// A row the game registered in this session and drew in an earlier one is
+// requested work, not speculation: holding it does not avoid its build, the
+// first draw then makes it on the submit thread. Two lanes serve such rows
+// through Fair, one through Serious, none at Critical. Optional rows keep
+// their own admission, and the memory checks of the caller still apply.
+static inline unsigned rb_spec_registered_lanes(int thermal) {
+    return thermal <= 1 ? 2u : thermal == 2 ? 1u : 0u;
+}
+static inline int rb_spec_registered_worker(int thermal, int worker) {
+    return worker >= 0 && (unsigned)worker < rb_spec_registered_lanes(thermal);
+}
 
