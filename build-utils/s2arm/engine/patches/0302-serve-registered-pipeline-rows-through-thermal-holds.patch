--- a/graphics/nvn/tests/t_rb_spec_gate.c
+++ b/graphics/nvn/tests/t_rb_spec_gate.c
@@ -153,8 +153,26 @@ static void startup_parallelism(void) {
     rb_spec_publish_limit(&local,RB_SPEC_HOLD,2);
     assert(!rb_spec_admit_startup(&local,0,1));
 }
+// Rows the game registered are requested work. The strict policy holds every
+// optional row from Fair on (rb_spec_thermal_tier), and these lanes are what
+// stays open beside it.
+static void registered_lanes(void) {
+    for (int thermal = 0; thermal < 4; ++thermal) {
+        assert(rb_spec_thermal_tier(rb_spec_reason(thermal, 0, UINT64_MAX, 0), thermal, 1) ==
+               (thermal ? RB_SPEC_HOLD : RB_SPEC_RUN));
+        assert(!rb_spec_registered_worker(thermal, -1));   // a caller outside the worker pool
+        assert(!rb_spec_registered_worker(thermal, 2) && !rb_spec_registered_worker(thermal, 3));
+    }
+    assert(rb_spec_registered_lanes(0) == 2 && rb_spec_registered_lanes(1) == 2);
+    assert(rb_spec_registered_worker(1, 0) && rb_spec_registered_worker(1, 1));
+    assert(rb_spec_registered_lanes(2) == 1);
+    assert(rb_spec_registered_worker(2, 0) && !rb_spec_registered_worker(2, 1));
+    assert(rb_spec_registered_lanes(3) == 0 && !rb_spec_registered_worker(3, 0));
+    puts("PASS registered rows keep two lanes through Fair, one at Serious, none at Critical");
+}
 int main(void) {
     startup_parallelism();
+    registered_lanes();
     kart_limits();
     const uint64_t floor = 768ull << 20;
     assert(tier(0, 0, floor) == RB_SPEC_RUN);
