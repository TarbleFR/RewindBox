index 0000000..370fbac
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_present_profile.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#include "../host/rb_present_profile.h"
+#include <assert.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static void put(const void *bytes, size_t length) {
+    FILE *f = fopen("game.tsv", "wb");
+    assert(f && fwrite(bytes, 1, length, f) == length && !fclose(f));
+}
+
+int main(void) {
+    const char *program = "04007EF01F8AE000";
+    const char *build = "db93b0125f4850601d61c3edde012f8e";
+    const char *status = NULL;
+    char root[] = "/tmp/rb-pacing-XXXXXX";
+    assert(mkdtemp(root) && !chdir(root));
+    assert(rb_read_present_profile(root, program, build, &status) == -1 && !strcmp(status, "absent"));
+    assert(!mkdir("S2Arm", 0700) && !chdir("S2Arm") && !mkdir("profiles", 0700) && !chdir("profiles"));
+    assert(!mkdir(program, 0700) && !chdir(program) && !mkdir(build, 0700) && !chdir(build));
+    const char example[] = "# User-verified build\r\nprogram_id\t04007ef01f8ae000\r\npresent_interval\tdisplay\r\n";
+    put(example, sizeof example - 1);
+    assert(rb_read_present_profile(root, program, build, &status) == 1 && !strcmp(status, "explicit"));
+    assert(rb_read_present_profile(root, program, "11111111111111111111111111111111", &status) == -1);
+    assert(rb_read_present_profile(root, "../invalid", build, &status) == -1);
+    assert(!s2a_present_fps60_gate(1, "0"));
+    const char wrong[] = "program_id\t0400C3F00006E000\npresent_interval\tdisplay\n";
+    put(wrong, sizeof wrong - 1);
+    assert(rb_read_present_profile(root, program, build, &status) == 0 && !strcmp(status, "program-mismatch"));
+    const char bad[] = "program_id\t04007EF01F8AE000\npresent_interval_derived\tdisplay\n";
+    put(bad, sizeof bad - 1);
+    assert(rb_read_present_profile(root, program, build, &status) == 0 && !strcmp(status, "invalid"));
+    put(example, sizeof example); // embedded/trailing NUL
+    assert(rb_read_present_profile(root, program, build, &status) == 0 && !strcmp(status, "invalid"));
+    assert(!truncate("game.tsv", 1024 * 1024 + 1));
+    assert(rb_read_present_profile(root, program, build, &status) == 0 && !strcmp(status, "invalid"));
+    s2a_game_tsv p;
+    char err[160];
+    s2a_game_tsv_parse(bad, &p, err, sizeof err);
+    assert(!p.present_explicit && !s2a_present_packaged(&p, program, NULL) && !s2a_present_packaged(&p, program, "untested"));
+    assert(!s2a_present_packaged(&p, program, "need_l3") && s2a_present_packaged(&p, program, "ok"));
+    assert(s2a_present_packaged(&p, NULL, NULL)); // preserve standalone policy
+    s2a_game_tsv_parse(wrong, &p, err, sizeof err);
+    assert(p.present_explicit && !s2a_present_packaged(&p, program, "ok"));
+    s2a_game_tsv_parse("present_interval\tgame\npresent_interval\tdisplay\n", &p, err, sizeof err);
+    assert(p.present_explicit && !s2a_present_packaged(&p, program, "ok"));
+    s2a_game_tsv_parse("present_interval\t60\n", &p, err, sizeof err);
+    assert(err[0] && !s2a_present_packaged(&p, program, "ok"));
+    assert(!unlink("game.tsv") && !chdir("..") && !rmdir(build) && !chdir("..") && !rmdir(program));
+    assert(!chdir("..") && !rmdir("profiles") && !chdir("..") && !rmdir("S2Arm") && !chdir("/") && !rmdir(root));
+    puts("PASS cadence profile: build, program, malformed input, duplicate keys, L3 and FPS gate");
+}
