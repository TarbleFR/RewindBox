diff --git a/graphics/nvn/host/rb_present_profile.h b/graphics/nvn/host/rb_present_profile.h
new file mode 100644
index 0000000..0ca3eb9
--- /dev/null
+++ b/graphics/nvn/host/rb_present_profile.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include "game_tsv.h"
+#include <errno.h>
+
+// Scope a user-authored cadence choice to the actual program and executable.
+// Only explicit present_interval is imported. Other renderer options remain packaged.
+static inline int rb_profile_hex(const char *value, size_t n) {
+    return value && strlen(value) == n && strspn(value, "0123456789abcdefABCDEF") == n;
+}
+static inline int rb_read_present_profile(const char *docs, const char *program, const char *build,
+                                          const char **status) {
+    *status = "identity-unavailable";
+    if (!docs || !*docs || !rb_profile_hex(program, 16) || !rb_profile_hex(build, 32)) return -1;
+    char path[2048];
+    int n = snprintf(path, sizeof path, "%s/S2Arm/profiles/%s/%s/game.tsv", docs, program, build);
+    if (n < 0 || (size_t)n >= sizeof path) return -1;
+    // This is called on the guest present stack. Keep the full parse object on the heap.
+    s2a_game_tsv *g = malloc(sizeof *g);
+    if (!g) { *status = "allocation-failed"; return 0; }
+    char error[160];
+    errno = 0;
+    int loaded = s2a_game_tsv_load(path, g, error, sizeof error);
+    int mode;
+    if (!loaded && !error[0] && errno == ENOENT) { *status = "absent"; mode = -1; }
+    else if (!loaded || error[0] || !g->present_explicit) { *status = "invalid"; mode = 0; }
+    else if (strcasecmp(g->program_id, program)) { *status = "program-mismatch"; mode = 0; }
+    else { *status = "explicit"; mode = g->present_display; }
+    free(g);
+    return mode;
+}
