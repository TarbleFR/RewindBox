+// Only return control to a slower interval actually requested by the game.
+// Two completed GPU windows must miss the configured frame budget; the user's
+// cap and the simulation rate are never rewritten.
+typedef struct { unsigned slow; int follow; } rb_thermal_interval;
+static inline int rb_guest_interval_tick(rb_thermal_interval *state, int heat, int hz, double p95) {
+    if (heat < 2) { *state = (rb_thermal_interval){0}; return 0; }
+    if (!(p95 > 0.) || hz <= 0) return state->follow;
+    if (p95 > 1000. / hz) {
+        if (state->slow < 2) ++state->slow;
+        if (state->slow == 2) state->follow = 1;
+    } else state->slow = 0;
+    return state->follow;
+}
