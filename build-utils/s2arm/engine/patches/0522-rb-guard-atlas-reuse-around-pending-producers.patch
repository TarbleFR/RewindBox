diff --git a/graphics/nvn/gfx/nvn/nvn_mtl.m b/graphics/nvn/gfx/nvn/nvn_mtl.m
index 196854b..5a24ebc 100644
--- a/graphics/nvn/gfx/nvn/nvn_mtl.m
+++ b/graphics/nvn/gfx/nvn/nvn_mtl.m
@@ -27659,9 +27659,16 @@ static unsigned mtl_pf_chmask(MTLPixelFormat pf) {
 // A single-sample 2D colour region / channel mask uses the same typed clear triangle as attachment clears; unsupported targets and formats report a failure.
 static void clear_tex_tri(const p_clear_tex *c, id<MTLTexture> t, unsigned level, unsigned layer);
 static void clear_tex_impl(const p_clear_tex *c, int track_depth) {
-    if (track_depth && (g_nlc || R.clear_d || R.clear_s)) {
-        dsnap_stale_tex(c->tex);
-        track_depth = 0;
+    if (track_depth) {
+        int pending = g_nlc || R.clear_d || R.clear_s;
+        for (int i = 0; i < 8; ++i) pending |= R.clear_c[i];
+        if (pending || g_game_barrier || g_defer_replaying || g_fz.active ||
+            (g_enc && (g_pass_swrite || g_pass_geo || g_pass.layered || S.tf_on))) {
+            // A clear can flush pending work in addition to writing its declared view.
+            // With an unclassified producer restore the pre-flush invalidation.
+            dsnap_stale_tex(c->tex);
+            track_depth = 0;
+        }
     }
     if (!(c->mask & 0xf) || !c->r.width || !c->r.height) return;
     if (fold_copy_skip(c->tex, "texture clear")) return;
