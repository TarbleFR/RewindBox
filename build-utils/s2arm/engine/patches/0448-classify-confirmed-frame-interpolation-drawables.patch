diff --git a/graphics/nvn/gfx/nvn/rb_fi_present_stats.h b/graphics/nvn/gfx/nvn/rb_fi_present_stats.h
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_fi_present_stats.h
@@ -0,0 +1,112 @@
+// Opt-in diagnostics. One fixed-size table covers delayed Metal callbacks.
+// Each observation ID identifies one drawable across slot reuse and session changes.
+#ifndef RB_FI_PRESENT_STATS_H
+#define RB_FI_PRESENT_STATS_H
+
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+enum rb_fi_content { RB_FI_METALFX, RB_FI_DUP, RB_FI_PREVIOUS, RB_FI_CUT, RB_FI_GPU_ERROR, RB_FI_CONTENT_COUNT };
+enum { RB_FI_NOT_SUBMITTED = 0, RB_FI_GPU_READY = 1, RB_FI_DISPLAY_READY = 2, RB_FI_OBSERVATIONS = 64 };
+typedef struct {
+    uint64_t id;
+    unsigned events;
+    enum rb_fi_content content;
+    double display_s;
+} rb_fi_observation;
+typedef struct {
+    uint64_t registered, pending, overwritten, failed_submit, discarded, invalid_time, shown[RB_FI_CONTENT_COUNT];
+    double first_display_s, last_display_s;
+} rb_fi_counts;
+static pthread_mutex_t g_rb_fi_stats_lock = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic int g_rb_fi_stats_on = -1;
+static uint64_t g_rb_fi_stats_generation, g_rb_fi_stats_serial, g_rb_fi_stats_start_ns;
+static rb_fi_observation *g_rb_fi_observations;
+static rb_fi_counts g_rb_fi_counts;
+
+static uint64_t rb_fi_stats_clock_ns(void) {
+    struct timespec t;
+    if (clock_gettime(CLOCK_MONOTONIC, &t)) return 0;
+    return (uint64_t)t.tv_sec * 1000000000ull + t.tv_nsec;
+}
+static void rb_fi_stats_begin_session(void) {
+    const char *v = getenv("S2A_RB_FI_PRESENT_STATS");
+    int on = v && !strcmp(v, "1");
+    if (!on && atomic_load(&g_rb_fi_stats_on) <= 0) {
+        atomic_store(&g_rb_fi_stats_on, 0);
+        return;
+    }
+    pthread_mutex_lock(&g_rb_fi_stats_lock);
+    free(g_rb_fi_observations);
+    g_rb_fi_observations = on ? calloc(RB_FI_OBSERVATIONS, sizeof(*g_rb_fi_observations)) : NULL;
+    if (on && !g_rb_fi_observations) { MLOG("[rb-fi-present-v1] unavailable: capture allocation failed"); on = 0; }
+    g_rb_fi_counts = (rb_fi_counts){0};
+    g_rb_fi_stats_start_ns = on ? rb_fi_stats_clock_ns() : 0;
+    ++g_rb_fi_stats_generation;
+    atomic_store(&g_rb_fi_stats_on, on);
+    pthread_mutex_unlock(&g_rb_fi_stats_lock);
+}
+static inline uint64_t rb_fi_stats_reserve(void) {
+    if (atomic_load_explicit(&g_rb_fi_stats_on, memory_order_relaxed) <= 0) return 0;
+    pthread_mutex_lock(&g_rb_fi_stats_lock);
+    uint64_t id = 0;
+    if (g_rb_fi_observations) {
+        id = ++g_rb_fi_stats_serial;
+        rb_fi_observation *o = &g_rb_fi_observations[id % RB_FI_OBSERVATIONS];
+        if (o->id) g_rb_fi_counts.overwritten++;
+        else g_rb_fi_counts.pending++;
+        g_rb_fi_counts.registered++;
+        *o = (rb_fi_observation){.id = id};
+    }
+    pthread_mutex_unlock(&g_rb_fi_stats_lock);
+    return id;
+}
+static void rb_fi_stats_update(uint64_t id, unsigned event, enum rb_fi_content content, double display_s) {
+    pthread_mutex_lock(&g_rb_fi_stats_lock);
+    rb_fi_observation *o = g_rb_fi_observations ? &g_rb_fi_observations[id % RB_FI_OBSERVATIONS] : NULL;
+    if (o && o->id == id && !(o->events & event)) {
+        if (event == RB_FI_NOT_SUBMITTED) {
+            g_rb_fi_counts.failed_submit++; o->id = 0; g_rb_fi_counts.pending--;
+        } else {
+            if (event == RB_FI_GPU_READY) o->content = content;
+            else o->display_s = display_s;
+            o->events |= event;
+            if (o->events == (RB_FI_GPU_READY | RB_FI_DISPLAY_READY)) {
+                if (!isfinite(o->display_s)) g_rb_fi_counts.invalid_time++;
+                else if (o->display_s > 0) {
+                    g_rb_fi_counts.shown[o->content]++;
+                    if (!g_rb_fi_counts.first_display_s || o->display_s < g_rb_fi_counts.first_display_s) g_rb_fi_counts.first_display_s = o->display_s;
+                    if (o->display_s > g_rb_fi_counts.last_display_s) g_rb_fi_counts.last_display_s = o->display_s;
+                } else g_rb_fi_counts.discarded++;
+                o->id = 0; g_rb_fi_counts.pending--;
+            }
+        }
+    }
+    pthread_mutex_unlock(&g_rb_fi_stats_lock);
+}
+static void rb_fi_stats_report(int final) {
+    if (atomic_load_explicit(&g_rb_fi_stats_on, memory_order_relaxed) <= 0) return;
+    pthread_mutex_lock(&g_rb_fi_stats_lock);
+    rb_fi_counts counts = g_rb_fi_counts;
+    uint64_t gen = g_rb_fi_stats_generation, now = rb_fi_stats_clock_ns();
+    uint64_t wall_ns = g_rb_fi_stats_start_ns && now >= g_rb_fi_stats_start_ns ? now - g_rb_fi_stats_start_ns : 0;
+    if (final) {
+        atomic_store(&g_rb_fi_stats_on, 0);
+        free(g_rb_fi_observations); g_rb_fi_observations = NULL;
+    }
+    pthread_mutex_unlock(&g_rb_fi_stats_lock);
+    MLOG("[rb-fi-present-v1] session=%llu final=%d wall_ns=%llu classification_complete=%d registered=%llu pending=%llu overwritten=%llu failed_submit=%llu discarded=%llu invalid_time=%llu "
+         "displayed_metalfx=%llu displayed_duplicate=%llu displayed_previous=%llu displayed_cut=%llu displayed_unknown_gpu_error=%llu "
+         "first_midpoint_presented_s=%.9f last_midpoint_presented_s=%.9f confirmed_midpoint_span_s=%.9f",
+         (unsigned long long)gen, final, (unsigned long long)wall_ns,
+         !counts.pending && !counts.overwritten && !counts.invalid_time && !counts.shown[RB_FI_GPU_ERROR],
