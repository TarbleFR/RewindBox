+static void treg_sp_note(int tid, treg_t *rp, id<MTLTexture> base, uint64_t spq) {
+    const pool_t *p = rp->t.pool;
+    // S2Arm: no associated-object lookup to tell: Metal's isSparse (a placement sparse texture, as upstream's tex_upgrade tests it, 1d4b8e82 nvn_mtl.m:2889 at 0c078130), only for a
+    //   sparse virtual pool's texture and for that texture itself, not an sRGB / linear twin view (no look is made through one: its format would key the shared tiles, patch 0030).
+    //   pool->flags first, as tex_mtl_ reads it: only a virtual pool's texture pays nvn_sparse_pool (a read lock), only a sparse one the parentTexture / isSparse messages
+    int sp = base && p && (p->flags & NVN_MEMORY_POOL_FLAGS_VIRTUAL) && nvn_sparse_pool(p);
+    id<MTLTexture> par = sp ? base.parentTexture : nil;
+    // A twin view (tex_mtl_ made it of the other format's texture, srgb_twins) shows the parent's mappings, but nothing looks through it (patch 0030): its cached view has the tiles of
+    //   the parent's last look, which another ID or binding of the parent makes. Not flagged (a slow path would not look either); said, so that the gap is not silent (D3)
+    if (par && par.isSparse && srgb_twin_view(base) && g_treg_sp_twin++ < 4)
+        MLOG("RewindBox: texture ID %d ser=%llu format %#x: an sRGB / linear view of a placement sparse texture, not looked through: its cached view shows the tiles of the parent's last look, made when the parent itself is resolved (%llu so far)",
+             tid, (unsigned long long)rp->t.serial, rp->t.d.format, (unsigned long long)g_treg_sp_twin);
+    sp = sp && !par && base.isSparse;
+    if (!sp) { rp->view_sp = 0; return; }
+    // a9005a51: a look's mapping operations are the submit thread's (rec_queue_block). S2Arm: on_sub_thread only, as patch 0030's hooks (not before a session's first submission either)
+    int on = on_sub_thread();
+    // S2Arm: tex_mtl does not look on every path: a texture another serial made, taken from the sharing table (g_alias) at a serial's first resolution, or each time for a finalized
+    //   serial whose ID stays registered over live storage (tex_mtl_'s "shared" / "dead" returns). The entry's tex_t has that texture's sharing key (pool, storage, format, shape), so it
+    //   looks here; a second look with no new request reads one log count (sparse_look). A packaged one has no NvSparse on its texture (NvPkg ps): this finds none, its look is tex_mtl's (0028)
+    if (on && atomic_load_explicit(&g_sp_gpu_n, memory_order_relaxed)) sparse_gpu_look(&rp->t, base);
+    if (!rp->view_sp && g_treg_sp_ids++ < 16)
+        MLOG("RewindBox: texture ID %d ser=%llu %ux%ux%u format %#x: placement sparse, its cached view follows the pool's mappings (%llu IDs so far)",
+             tid, (unsigned long long)rp->t.serial, rp->t.d.width, rp->t.d.height, rp->t.d.depth, rp->t.d.format, (unsigned long long)g_treg_sp_ids);
+    rp->view_sp = 1; g_treg_sp_any = 1;
+    if (on) { rp->view_sp_seq = spq; rp->view_sp_ep = g_pkg_epoch; rp->view_sp_frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed); return; }   // spq TREG_SP_UNSEEN (just flagged): looked now, so current for this period; the next one takes the slow path once and records a count
+    rp->view_sp_seq = rp->view_sp_ep = TREG_SP_UNSEEN;   // off the submit thread nothing looked (tex_mtl_'s hooks skip it there): the submit thread's next use takes the slow path, which looks
+    if (g_treg_sp_off++ < 4)
+        MLOG("RewindBox: texture ID %d ser=%llu (placement sparse) resolved off the submit thread: no look there, its mappings are followed at its next use on the submit thread (%llu so far)",
+             tid, (unsigned long long)rp->t.serial, (unsigned long long)g_treg_sp_off);
+}
