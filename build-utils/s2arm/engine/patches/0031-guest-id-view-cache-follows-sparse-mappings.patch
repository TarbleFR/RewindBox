+// RewindBox (patch 0031): the texture ID view cache follows a sparse pool's mappings. After the idea of seedds/nxnative df9ca262 (MIT, Copyright (c) 2026 seedds; read at b16693b3; none of
+//   its code, which needs nvn_owner.m): a mapping request changes what a texture of a sparse pool reads (its page table) with no registration, serial change or guest write, so an ID's
+//   cached view (tex_by_id, tex_fast, tex_fast_rid) kept the tiles its placement sparse texture had mapped at its last look until something unrelated moved g_ser_gen and sent the ID down
+//   the slow path, where tex_mtl looks again (nvn_sparse_tiles.inc sparse_look, sparse_gpu_look). df9ca262 notes the serials a request overlaps (g_vnote, treg_sparse_notes → own_note);
+//   S2Arm has neither those notes nor ID epochs (any g_ser_gen move already sends every ID down the slow path), so here: a flag in the entry whose view's base is a placement sparse
+//   texture, and its pool's mapping log count (nvn_sparse_log_seq, patch 0026; declared in nvn_sparse_tiles.inc) taken before the look. Once a check period (g_pkg_epoch: a submission,
+//   split at waits on another queue, as for packaged textures' view_ep; df9ca262 notes at each submission's start) a flagged view is kept only while that count stands still; otherwise the
+//   ID takes the slow path and the look follows the mappings. An ID that is not flagged pays one byte load on the fast paths
+#define TREG_SP_UNSEEN (~0ull)   // no look on record (the view was made off the submit thread, or it was flagged just now): the next check period takes the slow path once
+// A flagged view also takes the slow path once this many frames have passed since its last look, mapping or not: a look that left tiles out of date (staging, a heap tile or host memory
+//   refused, nvn_sparse_tiles.inc sp_rescan) or a packaged texture's tiles written since (nvn_dirty_sparse_writes) is looked at again 60 frames on (sparse_look, check C4), and only
+//   when the texture is resolved; an ID that pool tables name is looked up again by pool_seen_scan at most this often, so its re-look can wait up to twice this
+#define TREG_SP_RELOOK 60
+static int g_treg_sp_any;   // an ID view was flagged this session: pool_seen_scan looks the IDs shaders read up again after a mapping (pool_session_reset starts it again)
+static uint64_t g_treg_sp_ids, g_treg_sp_moved, g_treg_sp_off, g_treg_sp_twin;   // views flagged, slow paths a moved log caused, flagged views made off the submit thread, twin views left unflagged (log lines; pool_session_reset)
+// A flagged view is current: found so in this check period, or its pool's log has not moved since the look and that look is less than TREG_SP_RELOOK frames old (then current for the
+//   rest of the period). Caller holds g_rmu.
+//   noinline: the inlined fast paths stay one byte load and one branch for an ID that is not flagged
+static __attribute__((noinline)) int treg_sp_fresh(treg_t *r) {
+    if (r->view_sp_ep == g_pkg_epoch) return 1;
+    if (atomic_load_explicit(&g_cur_frame, memory_order_relaxed) - r->view_sp_frame >= TREG_SP_RELOOK) return 0;   // the 60-frame re-look (sparse_look) runs on the slow path
+    if (nvn_sparse_log_seq(r->t.pool) != r->view_sp_seq) return 0;
+    r->view_sp_ep = g_pkg_epoch; return 1;
+}
+// After tex_by_id's slow path kept or made an ID's view: flag it when its base is a placement sparse texture, and on the submit thread record the log count taken before the look.
