+// RewindBox (patch 0109): 20 detailed first-use entries at IPA 785 frame 2841 accounted
+// for 2,580.8 ms waiting for queued Metal pipelines. Prioritize successful render
+// pipelines with a long first use on later runs. Keep the hints outside the manifests
+// exported to the shader tools, and batch writes off the submit thread.
+enum { RB_PSO_HOT_LIMIT = 64, RB_PSO_HOT_HISTORY = 256, RB_PSO_HOT_MS = 50 };
+static int rb_pso_hot_on(void) {
+    static int on;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ const char *e = getenv("S2A_RB_PSO_HOT_FIRST"); on = !(e && !strcmp(e, "0")); });
+    return on;
+}
+static NSString *rb_pso_hot_path(void) {
+    return [pso_user_path() stringByAppendingString:@".rb-priority"];
+}
+static NSMutableOrderedSet<NSString *> *rb_pso_hot_read(NSString *path) {
+    NSMutableOrderedSet<NSString *> *rows = [NSMutableOrderedSet orderedSet];
+    if (!path || [NSFileManager.defaultManager attributesOfItemAtPath:path error:nil].fileSize > 512 * 1024) return rows;
+    NSString *text = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+    for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+        if (line.length != sizeof(pso_skey) * 2 + 2 || ![line hasPrefix:@"R\t"] || [rows containsObject:line]) continue;
+        if (rows.count == RB_PSO_HOT_HISTORY) [rows removeObjectAtIndex:0];
+        [rows addObject:line];
+    }
+    return rows;
+}
+static void rb_pso_hot_note(const char *hex) {
+    NSString *path = rb_pso_hot_path();
+    if (!path) return;
+    NSString *row = [NSString stringWithFormat:@"R\t%s", hex];
+    static dispatch_queue_t queue;
+    static dispatch_once_t once;
+    static NSMutableDictionary<NSString *, NSMutableOrderedSet<NSString *> *> *pending;   // queue only
+    dispatch_once(&once, ^{
+        queue = dispatch_queue_create("rewindbox.pso-history",
+                                      dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, s2a_qos(S2A_QOS_IO_BG), 0));
+        pending = [NSMutableDictionary dictionary];
+    });
+    dispatch_async(queue, ^{ @autoreleasepool {
+        NSMutableOrderedSet<NSString *> *batch = pending[path];
+        if (!batch) {
+            batch = pending[path] = [NSMutableOrderedSet orderedSet];
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), queue, ^{ @autoreleasepool {
+                NSMutableOrderedSet<NSString *> *history = rb_pso_hot_read(path);
+                NSUInteger updated = 0;
+                for (NSString *item in pending[path]) {
+                    if ([history containsObject:item]) continue;
+                    if (history.count == RB_PSO_HOT_HISTORY) [history removeObjectAtIndex:0];
+                    [history addObject:item];
+                    updated++;
+                }
+                [pending removeObjectForKey:path];
+                if (updated) {
+                    NSString *body = [[history.array componentsJoinedByString:@"\n"] stringByAppendingString:@"\n"];
+                    BOOL written = [body writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil];
+                    MLOG("RewindBox (patch 0109): pipeline wait history added %lu rows (%lu kept, wrote %d)",
+                         (unsigned long)updated, (unsigned long)history.count, written);
+                }
+            } });
+        }
+        if (batch.count < RB_PSO_HOT_HISTORY) [batch addObject:row];
+    } });
+}
