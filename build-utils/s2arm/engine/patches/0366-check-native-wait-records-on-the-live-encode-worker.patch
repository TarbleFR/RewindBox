+static int rb_worker_sync_checks(void) {
+    alarm(30);
+    setenv("S2A_RB_ENC_RT", "0", 1);
+    g_m3 = 0; g_rec = 1; g_rb_queue_wait_mode = 1;
+    g_sub_thread = pthread_self(); atomic_store(&g_sub_thread_set, 1);
+    g_q4 = (id)[RBWaitQueue new]; g_cb = [DmRecCB new];
+    RBWaitEvent *event = [RBWaitEvent new];
+    __weak RBWaitEvent *kept = event;
+    // Proxy method recording starts dm-encode through rec_put. Queue blocks
+    // alone execute immediately until that worker has been started.
+    rec_t *first = rec_put(RO_Q_BLOCK, 1);
+    first->a[0] = rec_obj([^{ rb_order[rb_order_count++] = 1; } copy]);
+    queue_wait_event((__bridge void *)event, 1);
+    rec_queue_block(^{ rb_order[rb_order_count++] = 3; });
+    event = nil;
+    VERIFY(g_rb_started && rb_order_count == 0 && g_rb_cur->n == 3 && kept,
+           "real encode worker starts while the unpublished records remain owned by submit");
+    rec_handover(); rec_drain();
+    const unsigned expected[] = {1, 2, 3};
+    VERIFY(rb_order_count == 3 && !memcmp(rb_order, expected, sizeof expected),
+           "real encode worker consumes prior operation, native wait record and later operation in order");
+    VERIFY(rb_order_on_worker, "event wait API executes on dm-encode rather than submit");
+    VERIFY(!kept, "real encode worker releases the retained event before reporting idle");
+    g_cb = nil;
+    printf("Encode worker checks: %u/%u; real dm-encode, simulated queue API\n", checks - failures, checks);
+    return failures != 0;
+}
