+static int g_rb_vis_lazy_mode = -1;
+static _Atomic uint64_t g_rb_vis_unused_subs, g_rb_vis_reserves;
+static _Atomic uint64_t g_rb_vis_waits, g_rb_vis_wait_ns, g_rb_alloc_wait_ns;
+static int rb_vis_lazy(void) {
+    if (g_rb_vis_lazy_mode < 0) {
+        const char *value = getenv("S2A_RB_VISIBILITY_LAZY");
