+    return g_rb_vis_lazy_mode;
+}
+static void vis_reserve(void) {
+    if (g_vis) return;
+    int pick = -1;
+    uint64_t done = atomic_load_explicit(&g_done, memory_order_acquire);
+    for (int i = 0; i < g_vis_ring_n; i++)
+        if (g_vis_ring[i].fence <= done) { pick = i; break; }
+    if (pick < 0 && g_vis_ring_n < VIS_RING) pick = g_vis_ring_n++;
+    if (pick < 0) {
+        uint64_t oldest = UINT64_MAX;
+        for (int i = 0; i < VIS_RING; i++)
+            if (g_vis_ring[i].fence < oldest) { oldest = g_vis_ring[i].fence; pick = i; }
+        if (oldest > done) {
+            uint64_t start = now_ns();
+            int reached = nvn_be_wait(oldest, UINT64_MAX);
+            atomic_fetch_add_explicit(&g_rb_vis_waits, 1, memory_order_relaxed);
+            atomic_fetch_add_explicit(&g_rb_vis_wait_ns, now_ns() - start, memory_order_relaxed);
+            if (!reached) { rec_drain(); return; }
+        }
+    }
+    // Preserve the accumulated query result before any slot can be overwritten.
+    vis_fold();
+    g_vis_ring_i = pick;
+    g_vis_ring[pick].fence = UINT64_MAX;
+    if (!g_vis_ring[pick].buf) {
+        g_vis_ring[pick].buf = [g_dev newBufferWithLength:VIS_SLOTS * 8 options:MTLResourceStorageModeShared];
+        res_add(g_vis_ring[pick].buf);
+    }
+    g_vis = g_vis_ring[pick].buf;
+    atomic_fetch_add_explicit(&g_rb_vis_reserves, 1, memory_order_relaxed);
+}
