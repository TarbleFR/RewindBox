diff --git a/graphics/nvn/gfx/nvn/rb_ubo_versions.h b/graphics/nvn/gfx/nvn/rb_ubo_versions.h
new file mode 100644
index 0000000..2e1652c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_ubo_versions.h
@@ -0,0 +1,117 @@
+// Submit-thread only. Keep the bytes supplied by guest inline updates until
+// the corresponding submission completes. Opaque GPU writes carry a range,
+// never a CPU value. Saturation loses an optimization, never a dependency.
+#ifndef RB_UBO_VERSIONS_H
+#define RB_UBO_VERSIONS_H
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_UB_FRAMES = 5, RB_UB_PAGES = 64, RB_UB_PAGE = 4096, RB_UB_SPANS = 128 };
+typedef struct {
+    uint64_t fence, page;
+    uint8_t bytes[RB_UB_PAGE], valid[RB_UB_PAGE];
+} rb_ub_page;
+typedef struct {
+    uint64_t fence;
+    unsigned count;
+    int unknown;
+    struct { uint64_t lo, hi; } opaque[RB_UB_SPANS];
+    rb_ub_page pages[RB_UB_PAGES];
+} rb_ub_frame;
+typedef struct { rb_ub_frame frames[RB_UB_FRAMES]; } rb_ub_versions;
+
+static rb_ub_frame *rb_ub_begin(rb_ub_versions *ring, uint64_t fence) {
+    rb_ub_frame *frame = &ring->frames[fence % RB_UB_FRAMES];
+    frame->fence = fence;
+    frame->count = 0;
+    frame->unknown = 0;
+    return frame;
+}
+static void rb_ub_opaque(rb_ub_frame *f, uint64_t lo, uint64_t size) {
+    if (!f || f->unknown) return;
+    if (!size || size > UINT64_MAX - lo) { f->unknown = 1; return; }
+    uint64_t hi = lo + size;
+    // Coalesce adjacent/overlapping ranges. Keep disjoint ranges to avoid
+    // turning a large storage allocation into a false global hazard.
+    for (unsigned i = 0; i < f->count;) {
+        if (hi < f->opaque[i].lo || lo > f->opaque[i].hi) { ++i; continue; }
+        if (lo >= f->opaque[i].lo && hi <= f->opaque[i].hi) return;
+        if (lo > f->opaque[i].lo) lo = f->opaque[i].lo;
+        if (hi < f->opaque[i].hi) hi = f->opaque[i].hi;
+        f->opaque[i] = f->opaque[--f->count];
+        i = 0;
+    }
+    if (f->count == RB_UB_SPANS) { f->unknown = 1; return; }
+    f->opaque[f->count].lo = lo;
+    f->opaque[f->count++].hi = hi;
+}
+static rb_ub_page *rb_ub_find_page(rb_ub_frame *f, uint64_t page, int create) {
+    unsigned slot = (unsigned)((page * UINT64_C(11400714819323198485)) >> 58);
+    for (unsigned i = 0; i < RB_UB_PAGES; i++) {
+        rb_ub_page *p = &f->pages[(slot + i) % RB_UB_PAGES];
+        if (p->fence != f->fence) {
+            if (!create) return NULL;
+            p->fence = f->fence;
+            p->page = page;
+            memset(p->valid, 0, sizeof p->valid);
+            return p;
+        }
+        if (p->page == page) return p;
+    }
+    return NULL;
+}
+static void rb_ub_capture(rb_ub_frame *f, uint64_t lo, size_t size, const uint8_t *bytes) {
+    if (!f || f->unknown || !size) return;
+    if (size > RB_UB_PAGE * RB_UB_PAGES || size > UINT64_MAX - lo) { rb_ub_opaque(f, lo, size); return; }
+    while (size) {
+        unsigned offset = lo % RB_UB_PAGE;
+        size_t n = RB_UB_PAGE - offset;
+        if (n > size) n = size;
+        rb_ub_page *p = rb_ub_find_page(f, lo / RB_UB_PAGE, 1);
+        if (p) {
+            memcpy(p->bytes + offset, bytes, n);
+            memset(p->valid + offset, 1, n);
+        } else rb_ub_opaque(f, lo, n);
+        size -= n; bytes += n; lo += n;
+    }
+}
+// 'have' starts with the bytes replaced by this submission. Never even read
+// a guest byte while an older GPU write to that byte may still be executing.
+static int rb_ub_base(rb_ub_versions *ring, uint64_t done, uint64_t latest,
+                      uint64_t lo, uint64_t hi, uint8_t *out, uint8_t *have) {
+    if (hi <= lo || done > latest) return 0;
+    for (uint64_t fence = latest; fence > done; --fence) {
+        if (!memchr(have, 0, (size_t)(hi - lo))) return 1;
+        rb_ub_frame *f = &ring->frames[fence % RB_UB_FRAMES];
+        if (f->fence != fence || f->unknown) return 0;
+        for (unsigned i = 0; i < f->count; i++) {
+            uint64_t a = lo > f->opaque[i].lo ? lo : f->opaque[i].lo;
+            uint64_t b = hi < f->opaque[i].hi ? hi : f->opaque[i].hi;
+            if (a < b && memchr(have + (a-lo), 0, (size_t)(b-a))) return 0;
+        }
+        for (uint64_t pos = lo; pos < hi;) {
+            unsigned offset = pos % RB_UB_PAGE;
+            size_t n = RB_UB_PAGE - offset;
+            if (n > hi-pos) n = (size_t)(hi-pos);
+            rb_ub_page *p = rb_ub_find_page(f, pos / RB_UB_PAGE, 0);
+            if (p) for (size_t j = 0; j < n; ++j) {
+                size_t k = (size_t)(pos-lo) + j;
+                if (!have[k] && p->valid[offset+j]) {
+                    out[k] = p->bytes[offset+j]; have[k] = 1;
+                }
+            }
+            pos += n;
+        }
+    }
+    size_t n = (size_t)(hi-lo);
+    for (size_t i = 0; i < n;) {
+        uint8_t *start = memchr(have+i, 0, n-i);
+        if (!start) break;
+        size_t a = (size_t)(start-have);
+        uint8_t *end = memchr(start, 1, n-a);
+        i = end ? (size_t)(end-have) : n;
+        memcpy(out+a, (const uint8_t *)(uintptr_t)lo+a, i-a);
+    }
+    return 1;
+}
+#endif
