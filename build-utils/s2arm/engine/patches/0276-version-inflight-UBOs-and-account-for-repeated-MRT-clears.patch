diff --git a/graphics/nvn/tests/t_rb_ubo_versions.c b/graphics/nvn/tests/t_rb_ubo_versions.c
new file mode 100644
index 0000000..02ebc03
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_ubo_versions.c
@@ -0,0 +1,39 @@
+#include "../gfx/nvn/rb_ubo_versions.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+static rb_ub_versions versions;
+int main(void) {
+    const size_t n = 8192;
+    uint8_t *guest = mmap(NULL, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(guest != MAP_FAILED);
+    uint64_t addr = (uintptr_t)guest;
+    uint8_t old[32], fresh[16], have[32], out[32];
+    memset(old, 31, sizeof old); memset(fresh, 43, sizeof fresh);
+    rb_ub_frame *first = rb_ub_begin(&versions, 1);
+    rb_ub_capture(first, addr+4090, 32, old);
+    rb_ub_frame *second = rb_ub_begin(&versions, 2);
+    rb_ub_capture(second, addr+4100, 16, fresh);
+    // None of these guest bytes can be touched, even momentarily.
+    assert(mprotect(guest, n, PROT_NONE) == 0);
+    memset(have, 0, sizeof have);
+    assert(rb_ub_base(&versions, 0, 2, addr+4090, addr+4122, out, have));
+    for (size_t i=0; i<32; i++) assert(out[i] == (i>=10 && i<26 ? 43 : 31));
+    rb_ub_opaque(first, addr+4101, 2); // replaced by a known later writer
+    memset(have, 0, sizeof have);
+    assert(rb_ub_base(&versions, 0, 2, addr+4090, addr+4122, out, have));
+    rb_ub_opaque(second, addr+4091, 2);
+    memset(have, 0, sizeof have);
+    assert(!rb_ub_base(&versions, 0, 2, addr+4090, addr+4122, out, have));
+    memset(have, 0, sizeof have); have[1] = have[2] = 1; // newest inline bytes
+    assert(rb_ub_base(&versions, 0, 2, addr+4090, addr+4122, out, have));
+    // Reusing an unretired slot cannot supply its predecessor's bytes.
+    for (uint64_t f=3; f<=1+RB_UB_FRAMES; f++) rb_ub_begin(&versions, f);
+    memset(have, 0, sizeof have);
+    assert(!rb_ub_base(&versions, 0, 1+RB_UB_FRAMES, addr, addr+32, out, have));
+    assert(munmap(guest, n)==0);
+    puts("UBO versions: overlap, opaque writes, wrap and protected memory passed");
+}
