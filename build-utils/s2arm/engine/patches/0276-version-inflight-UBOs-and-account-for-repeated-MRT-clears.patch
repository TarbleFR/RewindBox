+      "vertex float4 v(uint i [[vertex_id]]) { float2 p[3]={{-1,-1},{3,-1},{-1,3}};return float4(p[i],0,1); }\n"
+      "fragment float4 f(constant float4 &color [[buffer(0)]]){return color;}";
+    id<MTLLibrary> lib = [dev newLibraryWithSource:src options:nil error:&error];
+    MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [lib newFunctionWithName:@"v"];
+    pd.fragmentFunction = [lib newFunctionWithName:@"f"];
+    pd.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    id<MTLRenderPipelineState> pipeline = [dev newRenderPipelineStateWithDescriptor:pd error:&error];
