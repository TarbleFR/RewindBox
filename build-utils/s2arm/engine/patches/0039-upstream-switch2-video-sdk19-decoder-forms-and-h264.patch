+int nvn2_h264_nals(const uint8_t *p, size_t n, size_t (*nal)[2], int cap) {
+    int k = 0;
+    if (n >= 3 && !p[0] && !p[1] && (p[2] == 1 || (n >= 4 && !p[2] && p[3] == 1))) {
