+            size_t sc = o; while (sc + 3 <= n && !(!p[sc] && !p[sc + 1] && p[sc + 2] == 1)) sc++;
+            if (sc + 3 > n) break;
+            size_t b = sc + 3, e = b; while (e + 3 <= n && !(!p[e] && !p[e + 1] && p[e + 2] <= 1)) e++;
