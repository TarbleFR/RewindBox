+// RewindBox (patch 0347): the system's shader cache (Library/Caches/com.apple.metal). A library the system compiled from the same source before comes back in about 1 ms: IPA 829
+//   test, Fire Emblem 321 libraries in 194 ms, Mario Kart World 3,893 in 3.4 s. The Zelda session of the same test compiled 2,042 in 332 s, 38 ms each at its start and about 400 ms in
+//   play, although most had been compiled in earlier sessions. Whether the cache had been emptied or was full is not known: its size, its file count and the free space are written
+//   at the prewarm's start and end, beside the prewarm's own compiles from source. Read only; S2A_RB_CACHE_REPORT=0 leaves the lines out
+static void rb_sys_cache_report(const char *when) {
+    const char *e = getenv("S2A_RB_CACHE_REPORT");
+    if (e && !strcmp(e, "0")) return;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{ @autoreleasepool {
+        NSFileManager *fm = NSFileManager.defaultManager;
+        NSURL *caches = [fm URLsForDirectory:NSCachesDirectory inDomains:NSUserDomainMask].firstObject;
+        if (!caches) return;
+        NSMutableArray<NSURL *> *roots = [NSMutableArray arrayWithObject:[caches URLByAppendingPathComponent:@"com.apple.metal" isDirectory:YES]];
+        NSString *bid = NSBundle.mainBundle.bundleIdentifier;
+        if (bid.length) [roots addObject:[[caches URLByAppendingPathComponent:bid isDirectory:YES] URLByAppendingPathComponent:@"com.apple.metal" isDirectory:YES]];
+        char user_cache[1024];   // review: on macOS the system keeps it in the user cache folder (DARWIN_USER_CACHE_DIR), not in Library/Caches
+        size_t uc = confstr(_CS_DARWIN_USER_CACHE_DIR, user_cache, sizeof user_cache);
+        if (uc > 1 && uc <= sizeof user_cache) {
+            NSURL *dar = [NSURL fileURLWithFileSystemRepresentation:user_cache isDirectory:YES relativeToURL:nil];
+            [roots addObject:[dar URLByAppendingPathComponent:@"com.apple.metal" isDirectory:YES]];
+            if (bid.length) [roots addObject:[[dar URLByAppendingPathComponent:bid isDirectory:YES] URLByAppendingPathComponent:@"com.apple.metal" isDirectory:YES]];
+        }
+        NSMutableSet<NSString *> *seen = [NSMutableSet set];
+        unsigned long long bytes = 0, files = 0; int found = 0, truncated = 0;
+        for (NSURL *root in roots) {
+            NSNumber *dir = nil;
+            NSString *path = root.URLByResolvingSymlinksInPath.path;
+            if (!path || [seen containsObject:path]) continue;
+            [seen addObject:path];
+            if (![root getResourceValue:&dir forKey:NSURLIsDirectoryKey error:nil] || !dir.boolValue) continue;
+            found++;
+            NSDirectoryEnumerator<NSURL *> *en = [fm enumeratorAtURL:root includingPropertiesForKeys:@[NSURLIsRegularFileKey, NSURLTotalFileAllocatedSizeKey] options:0 errorHandler:nil];
+            for (;;) { @autoreleasepool {
+                NSURL *u = [en nextObject];
+                if (!u) break;
+                NSNumber *reg = nil, *size = nil;
+                if (![u getResourceValue:&reg forKey:NSURLIsRegularFileKey error:nil] || !reg.boolValue) continue;
+                if ([u getResourceValue:&size forKey:NSURLTotalFileAllocatedSizeKey error:nil]) bytes += size.unsignedLongLongValue;
+                if (++files >= 100000) { truncated = 1; break; }
+            } }
+            if (truncated) break;
+        }
+        NSNumber *avail = nil;
+        [caches getResourceValue:&avail forKey:NSURLVolumeAvailableCapacityForImportantUsageKey error:nil];
+        MLOG("RewindBox (patch 0347): system shader cache %s: %s%.1f MB in %llu files%s; %.2f GB free on the volume for important use", when,
+             found ? "" : "no com.apple.metal folder, ", bytes / 1048576.0, files, truncated ? " (counting stopped at 100000 files)" : "",
+             avail ? avail.longLongValue / 1073741824.0 : -1.0);
+    } });
+}
