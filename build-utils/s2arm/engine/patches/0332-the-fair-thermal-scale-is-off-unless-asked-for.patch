 //   S2A_RB_RS_RETIRE=0: as before (the step always answers 0).
 #pragma once
 #include <stdint.h>
+#include <stdlib.h>
 #include <string.h>
 
+// RewindBox (patch 0332): the factor the Fair scale draws at, from S2A_RB_FAIR_SCALE. Unset, empty, malformed, below 0.5 or 1 and above: 1, the scale stays off.
+//   (Up to patch 0331 an unset value meant 0.85.)
+static inline double rb_fair_scale_factor(const char *value) {
+    if (!value || !*value) return 1.;
+    char *end = NULL;
+    double v = strtod(value, &end);
+    return end != value && !*end && v >= 0.5 && v < 1. ? v : 1.;
+}
