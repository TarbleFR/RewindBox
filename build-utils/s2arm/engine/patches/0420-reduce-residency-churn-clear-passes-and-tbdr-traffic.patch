+// RewindBox (patch 0420): fold a run of 2..N consecutive compatible clear groups
+// (e.g. per-target G-buffer clears) into a single clear-only render pass when all
+// planes satisfy the existing backing, exposure, non-overlap and tile-budget proofs.
+static int rb_clear_combine_run(const lc_group *groups, int start, int count) {
+    if (start + 1 >= count) return 0;
+    if (!g_cb || g_m3 || g_enc || g_nubd || g_nbcrt ||
+        g_imfit_npend || g_imwr_npend || g_rlane || g_rp_layered || g_fz.active || g_hoist_n ||
+        g_defer_replaying || g_rc_skip || g_vis_counting || g_rb_discard_mask || g_rb_next_clear_mask ||
+        g_wd > 0) return 0;
+    // Try multi-group folding (>2 consecutive disjoint groups) first.
+    if (start + 2 < count) {
+        RBClearPlan plan = {0};
+        int taken = 0;
+        if (rb_tile_scale_safe(&groups[start].rt, &groups[start + 1].rt) &&
+            rb_clear_include(&plan, &groups[start], 0)) {
+            taken = 1;
+            for (int k = start + 1; k < count; ++k) {
+                if (!rb_tile_scale_safe(&groups[start].rt, &groups[k].rt)) break;
+                RBClearPlan trial = plan;
+                if (!rb_clear_include(&trial, &groups[k], 0)) break;
+                plan = trial;
+                taken++;
+            }
+        }
+        if (taken >= 3) {
+            atomic_fetch_add_explicit(&g_rb_clear_candidates, (uint64_t)(taken - 1), memory_order_relaxed);
+            lc_apply(&plan.group);
+            g_rb_clear_expected = plan.native;
+            id encoder = rp_begin_ex(1);
+            g_rb_clear_expected = NULL;
+            if (encoder) {
+                rb_rp_end_at(__func__, __LINE__); g_lc_landed++;
+                atomic_fetch_add_explicit(&g_rb_clear_saved, (uint64_t)(taken - 1), memory_order_relaxed);
+                return taken;
+            }
+        }
+    }
+    return rb_clear_combine(&groups[start], &groups[start + 1]) ? 2 : 0;
+}
