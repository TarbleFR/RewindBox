+static void rb_ref_begin(void);
+static NSString *rb_ref_manifest(NSString *wire) { return [wire stringByAppendingPathComponent:@"pso_reference.tsv"]; }
+static NSString *rb_ref_files(NSString *manifest) {
+    return [manifest.stringByDeletingLastPathComponent stringByAppendingPathComponent:@"pso_reference.archives.tsv"];
+}
+static BOOL rb_ref_row(NSString *line, pso_skey *sk) {
+    return [line hasPrefix:@"R\t"] && line.length == 2 + 2 * sizeof *sk &&
+           !pso_skey_parse([line substringFromIndex:2].UTF8String, sk);
+}
+// Only accept canonical recipes whose *entire* 432-byte state yields a captured
+// archive identity. Shader names alone are insufficient. Scan incrementally so a
+// long personal manifest does not need to be loaded into memory for migration.
+static int rb_ref_materialize(NSString *wire, NSArray<NSString *> *sources,
+                              const struct rb_reference_target *targets, size_t count,
+                              rb_stage_cancel cancel, void *ctx) {
+    NSMutableOrderedSet *stageRows = [NSMutableOrderedSet orderedSet];
+    NSMutableDictionary *byPair = [NSMutableDictionary dictionary], *rows = [NSMutableDictionary dictionary];
+    NSMutableSet *wanted = [NSMutableSet set];
+    for (size_t i = 0; i < count; ++i) {
+        NSString *vs = @(targets[i].vs), *fs = @(targets[i].fs), *key = @(targets[i].archive);
+        [stageRows addObject:[NSString stringWithFormat:@"S\t%@\t0",vs]];
+        [stageRows addObject:[NSString stringWithFormat:@"S\t%@\t1",fs]];
+        [wanted addObject:key]; byPair[[NSString stringWithFormat:@"%@ %@",vs,fs]] = @YES;
+    }
+    for (NSString *path in sources) {
+        FILE *f = fopen(path.fileSystemRepresentation, "r"); if (!f) continue;
+        char buf[2 * sizeof(pso_skey) + 64]; unsigned lineNo = 0;
+        while (rows.count < wanted.count && fgets(buf,sizeof buf,f)) { @autoreleasepool {
+            if (!(lineNo++ % 128) && cancel && cancel(ctx)) { fclose(f); return 1; }
+            size_t len = strlen(buf); if (len && buf[len-1]=='\n') buf[--len]=0;
+            if (len != 2 + 2*sizeof(pso_skey) || buf[0]!='R' || buf[1]!='\t') continue;
+            pso_skey sk; if (pso_skey_parse(buf+2,&sk)) continue;
+            NSString *vs = warm_key(sk.vs,sizeof sk.vs), *fs = warm_key(sk.fs,sizeof sk.fs);
+            if (!byPair[[NSString stringWithFormat:@"%@ %@",vs,fs]]) continue;
+            NSString *digest = par_hash(&sk,sizeof sk);
+            if ([wanted containsObject:digest]) rows[digest] = @(buf);
+        } }
+        BOOL failed = ferror(f); fclose(f); if (failed) return -1;
+    }
+    if (cancel && cancel(ctx)) return 1;
+    NSMutableString *result = [NSMutableString stringWithFormat:@"# RewindBox reference 1 %@ %s %s %zu\n",
+                               @"0400C3F00006E000",rb_ref_build,DMSH_CHAIN,sizeof(pso_skey)];
+    for (size_t i=0; i<count; ++i) {
+        NSString *key = @(targets[i].archive);
+        if (rows[key]) [result appendFormat:@"%@\n",rows[key]];
+        else [result appendFormat:@"# missing\t%@\n",key];
+    }
+    for (NSString *row in stageRows) [result appendFormat:@"%@\n",row];
+    return [result writeToFile:rb_ref_manifest(wire) atomically:YES encoding:NSUTF8StringEncoding error:nil] ? 0 : -1;
+}
+struct rb_ref_callbacks { rb_stage_cancel cancel; rb_stage_progress progress; void *ctx; };
+static int rb_ref_checkpoint(void *opaque) {
+    struct rb_ref_callbacks *c = opaque;
+    for (;;) {
+        if (c->cancel && c->cancel(c->ctx)) return 1;
+        if (rb_spec_may(0)) return 0;
+        usleep(100000);
+    }
+}
+static void rb_ref_progress(void *opaque, uint64_t done, uint64_t total) {
+    struct rb_ref_callbacks *c = opaque;
+    if (c->progress) c->progress(c->ctx,done,total);
+}
