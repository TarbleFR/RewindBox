+// RewindBox. The public preparation API does file work before guest startup.
+// The same renderer that will draw owns the Metal device, compiler and workers.
+typedef int (*rb_stage_cancel)(void *);
+typedef int (*rb_stage_inflate)(const void *, size_t, void **, size_t *, size_t);
+typedef void (*rb_stage_progress)(void *, uint64_t, uint64_t);
+extern int rb_prepare_stage_inputs(const char *, const char *, const char *, rb_stage_cancel, void *,
+                                   uint64_t [8], rb_stage_inflate, rb_stage_progress) __attribute__((weak_import));
