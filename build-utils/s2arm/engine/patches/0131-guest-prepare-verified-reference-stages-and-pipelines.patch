+    if (![NSFileManager.defaultManager createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil]) return -1;
+    NSArray *sources = @[[assets stringByAppendingPathComponent:@"pso_manifest.tsv"],
+        [dir stringByAppendingPathComponent:@"pso_user.tsv.rb-priority"],[dir stringByAppendingPathComponent:@"pso_user.tsv"]];
+    struct rb_ref_callbacks callbacks = {cancel,progress,ctx};
+    int status = rb_ref_materialize(dir,sources,rb_mkw_targets,sizeof rb_mkw_targets/sizeof *rb_mkw_targets,rb_ref_checkpoint,&callbacks);
+    if (status) return status;
+    return rb_prepare_stage_inputs(data,wire,rb_ref_manifest(dir).fileSystemRepresentation,rb_ref_checkpoint,&callbacks,stats,inflate,rb_ref_progress);
+} }
+
+@interface RBReferenceProof : NSObject {
+@public NSString *path;
+    NSMutableSet *stages, *renders;
+    NSMutableDictionary<NSString *, MTLRenderPipelineDescriptor *> *descriptors;
+    uint64_t counts[6];
+    int state;
+    _Atomic long remaining;
+}
+@end
+@implementation RBReferenceProof @end
+static os_unfair_lock g_ref_lock = OS_UNFAIR_LOCK_INIT;
+static RBReferenceProof *g_ref;
+static void rb_ref_begin(void) {
+    os_unfair_lock_lock(&g_ref_lock); g_ref=nil; os_unfair_lock_unlock(&g_ref_lock);
+}
+static NSString *rb_ref_path(void) {
+    const char *env = getenv("S2A_RB_PREPARE_PROFILE");
+    return env && *env ? @(env) : nil;
+}
+// Called during warm_parse only for the explicitly selected reference manifest.
+static RBReferenceProof *rb_ref_open(NSString *path, NSString *text) {
+    RBReferenceProof *proof = [RBReferenceProof new]; proof->path = path;
+    proof->stages = [NSMutableSet set]; proof->renders = [NSMutableSet set];
+    proof->descriptors = [NSMutableDictionary dictionary];
+    for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+        if ([line hasPrefix:@"# missing\t"]) { ++proof->counts[5]; continue; }
+        if ([line hasPrefix:@"S\t"]) [proof->stages addObject:line];
+        pso_skey sk;
+        if (rb_ref_row(line,&sk)) [proof->renders addObject:par_hash(&sk,sizeof sk)];
+    }
+    proof->counts[0]=proof->stages.count; proof->counts[2]=proof->renders.count + proof->counts[5];
+    os_unfair_lock_lock(&g_ref_lock); g_ref=proof; os_unfair_lock_unlock(&g_ref_lock);
+    return proof;
+}
+static void rb_ref_shader(RBReferenceProof *proof) {
+    if (proof) { os_unfair_lock_lock(&g_ref_lock); ++proof->counts[1]; os_unfair_lock_unlock(&g_ref_lock); }
+}
+static BOOL rb_ref_pipeline(RBReferenceProof *proof, NSString *key, MTLRenderPipelineDescriptor *d) {
+    if (!proof || !key || !d || ![proof->renders containsObject:key]) return NO;
+    os_unfair_lock_lock(&g_ref_lock);
+    proof->descriptors[key]=[d copy]; proof->counts[3]=proof->descriptors.count;
+    os_unfair_lock_unlock(&g_ref_lock); return YES;
+}
+__attribute__((visibility("default"))) int s2a_rb_guest_prepare_gpu_status(uint64_t out[6]) {
+    os_unfair_lock_lock(&g_ref_lock);
+    RBReferenceProof *p=g_ref; int state=p ? p->state : 0;
+    if (out) { if (p) memcpy(out,p->counts,sizeof p->counts); else memset(out,0,6*sizeof *out); }
+    os_unfair_lock_unlock(&g_ref_lock); return state;
+}
+// Expose failure when an explicit migration is interrupted or cannot be parsed.
+static void rb_ref_abort(void) {
+    if (!rb_ref_path()) return;
+    os_unfair_lock_lock(&g_ref_lock); if (!g_ref) g_ref=[RBReferenceProof new];
+    if (!g_ref->state) g_ref->state=-1; os_unfair_lock_unlock(&g_ref_lock);
+}
+// Called off submit after the last warm worker has returned. g_warm_running
+// remains set until this bounded verification returns, including during stop.
+static void rb_ref_verify(RBReferenceProof *p) {
+    if (!p || !p->counts[0] || !p->counts[2] || !g_par_on) { rb_ref_abort(); return; }
+    // Wait only for this bounded set of exact keys, never for an unrelated
+    // archive queue or a sleeping worker. Yield to a required draw or HOLD.
+    uint64_t until=bp_now()+3000000000ull;
+    while (p->descriptors.count && bp_now()<until && !nvn_be_stopping() && !dm_gfx_session_stopping() &&
+           !atomic_load(&g_fu_waiting) && rb_spec_level()!=RB_SPEC_HOLD) {
+        pthread_mutex_lock(&g_par_mu);
+        BOOL pending=NO;
+        for (NSString *key in p->descriptors) if ([g_par_pending_keys containsObject:key]) { pending=YES; break; }
+        pthread_mutex_unlock(&g_par_mu);
+        if (!pending) break;
+        usleep(10000);
+    }
+    NSMutableString *files = [NSMutableString string];
+    for (NSString *key in p->descriptors) { @autoreleasepool {
+        if (nvn_be_stopping() || dm_gfx_session_stopping() || atomic_load(&g_fu_waiting) || rb_spec_level()==RB_SPEC_HOLD) break;
+        pthread_mutex_lock(&g_par_mu);
+        NSString *name=g_par_bmap[key] ?: [key stringByAppendingString:@".metalarchive"];
+        BOOL have=[g_par_have containsObject:key]; pthread_mutex_unlock(&g_par_mu);
+        if (!have) continue;
+        int lease=0; if (!rb_spec_take(0,&lease)) break;
+        NSString *path=[g_par_dir stringByAppendingPathComponent:name];
+        MTLBinaryArchiveDescriptor *ad=[MTLBinaryArchiveDescriptor new]; ad.url=[NSURL fileURLWithPath:path];
+        NSError *error=nil; id<MTLBinaryArchive> archive=[g_dev newBinaryArchiveWithDescriptor:ad error:&error];
+        MTLRenderPipelineDescriptor *d=[p->descriptors[key] copy];
+        if (archive) d.binaryArchives=@[archive];
+        id ps = archive ? [g_dev newRenderPipelineStateWithDescriptor:d options:MTLPipelineOptionFailOnBinaryArchiveMiss reflection:nil error:&error] : nil;
+        rb_spec_done(&lease);
+        if (ps) { [files appendFormat:@"%@\t%@\n",key,name]; os_unfair_lock_lock(&g_ref_lock); ++p->counts[4]; os_unfair_lock_unlock(&g_ref_lock); }
+    } }
+    BOOL ok=p->counts[0]==p->counts[1] && p->counts[2]==p->counts[3] && p->counts[3]==p->counts[4] && !p->counts[5];
+    if (ok) ok=[files writeToFile:rb_ref_files(p->path) atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    else [NSFileManager.defaultManager removeItemAtPath:rb_ref_files(p->path) error:nil];
+    os_unfair_lock_lock(&g_ref_lock); p->state=ok ? 1 : -1; [p->descriptors removeAllObjects]; os_unfair_lock_unlock(&g_ref_lock);
+    MLOG("RewindBox reference: real functions %llu/%llu, exact PSOs %llu/%llu, strict disk archive %llu, missing descriptors %llu, verified %d",
+        (unsigned long long)p->counts[1],(unsigned long long)p->counts[0],(unsigned long long)p->counts[3],
+        (unsigned long long)p->counts[2],(unsigned long long)p->counts[4],(unsigned long long)p->counts[5],ok);
+}
+
+// Run on the last reference worker, after it releases its ONE lease. The warm
+// worker group owns its lifetime and drains it on shutdown. No extra worker.
+static void rb_ref_task_done(RBReferenceProof *proof) {
+    if (proof && atomic_fetch_sub(&proof->remaining,1)==1) rb_ref_verify(proof);
+}
+
+static void rb_ref_bound(id ps) {
+    const void *raw=(__bridge const void *)ps;
+    NSString *digest=CFBridgingRelease(nvn_hm_del(&g_rb_seed_objects,&raw));
+    if (digest) MLOG("RewindBox reference: encoder bound exact prewarmed PSO %s at frame %llu",
+                     digest.UTF8String,(unsigned long long)atomic_load(&g_cur_frame));
+}
