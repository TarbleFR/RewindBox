new file mode 100644
index 0000000..d8350a7
--- /dev/null
+++ b/graphics/nvn/tests/rb_reference_gpu.inc
@@ -0,0 +1,105 @@
+// Reference input comes from two real draws in a different process. The next
+// install begins with an empty personal history. The two distinct vertices
+// share one fragment, as at frame 4815. The programs and pixels are synthetic.
+static NSString *const reference_vertex_b = @"6600000000000000_b";
+static void reference_boot(NSString *root) {
+    setenv("DM_PSO_USER",[[root stringByAppendingPathComponent:@"pso_user.tsv"] fileSystemRepresentation],1);
+    setenv("DM_NVN_SHMAP",[[root stringByAppendingPathComponent:@"shader_map.tsv"] fileSystemRepresentation],1);
+    setenv("DM_MSL_DIR",root.fileSystemRepresentation,1);
+    setenv("DM_MSL_FALLBACK",[[root stringByAppendingPathComponent:@"translation"] fileSystemRepresentation],1);
+    setenv("DM_PSO_PREPARE","1",1); setenv("DM_PSO_PREPARE_THREADS","1",1);
+    setenv("DM_NVN_FIRST_SKIP","0",1); setenv("DM_NVN_PSO_WAIT_MS","0",1);
+    setenv("S2A_RB_SPEC_GOVERN","0",1);
+    setenv("S2A_RB_PSO_TRANSITIONS","0",1);
+    setenv("S2A_RB_PSO_ARCHIVE_COALESCE","0",1);
+    unsetenv("DM_PSO_MANIFEST"); unsetenv("DM_PSO_ARCHIVE");
+    transition_device(); shmap_load();
+}
+static void reference_collect(NSString *root) {
+    stage_assets(root);
+    NSString *dir = [root stringByAppendingPathComponent:@"translation"];
+    NSString *from=[dir stringByAppendingPathComponent:stage_name(ST_VERTEX)];
+    NSString *to=[dir stringByAppendingPathComponent:reference_vertex_b];
+    for (NSString *extension in @[@"json",@"metal"])
+        GPU_CHECK([NSFileManager.defaultManager copyItemAtPath:[from stringByAppendingPathExtension:extension]
+            toPath:[to stringByAppendingPathExtension:extension] error:nil]);
+    FILE *map=fopen([root stringByAppendingPathComponent:@"shader_map.tsv"].fileSystemRepresentation,"a");
+    GPU_CHECK(map && fputs("original\t0\tvertex\t6600000000000000\n",map)>=0 && !fclose(map));
+    NSString *src=[NSString stringWithContentsOfFile:[to stringByAppendingPathExtension:@"metal"] encoding:NSUTF8StringEncoding error:nil];
+    write_test_text([to stringByAppendingPathExtension:@"metal"],[src stringByAppendingString:@"\n// second stage identity\n"]);
+    setenv("DM_PSO_ARCHIVE","0",1);
+    reference_boot(root);
+    demand_vertex_and_draw(stage_name(ST_VERTEX),ST_A,nil);
+    demand_vertex_and_draw(reference_vertex_b,ST_A,nil);
+    GPU_CHECK(!nvn_be_request_stop() && !nvn_be_shutdown_session());
+    NSString *user=[root stringByAppendingPathComponent:@"pso_user.tsv"], *record=[root stringByAppendingPathComponent:@"captured-reference.tsv"];
+    GPU_CHECK([NSFileManager.defaultManager moveItemAtPath:user toPath:record error:nil]);
+    [NSFileManager.defaultManager removeItemAtPath:[root stringByAppendingPathComponent:@"pipelines"] error:nil];
+}
+static void reference_check(NSString *root,BOOL missing,BOOL replay) {
+    NSString *record=[root stringByAppendingPathComponent:@"captured-reference.tsv"];
+    NSString *text=[NSString stringWithContentsOfFile:record encoding:NSUTF8StringEncoding error:nil];
+    NSMutableDictionary *digests=[NSMutableDictionary dictionary]; GPU_CHECK(text);
+    for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+        pso_skey sk; if (!rb_ref_row(line,&sk)) continue;
+        GPU_CHECK([warm_key(sk.fs,sizeof sk.fs) isEqual:stage_name(ST_A)]);
+        digests[warm_key(sk.vs,sizeof sk.vs)]=par_hash(&sk,sizeof sk);
+    }
+    NSArray *vertices=@[stage_name(ST_VERTEX),reference_vertex_b];
+    GPU_CHECK(digests.count==2 && digests[vertices[0]] && digests[vertices[1]]);
+    struct rb_reference_target target[2];
+    for (int i=0;i<2;i++) {
+        NSString *key=digests[vertices[i]];
+        target[i]=(struct rb_reference_target){[vertices[i] UTF8String],stage_name(ST_A).UTF8String,key.UTF8String};
+    }
+    if (missing) target[1].archive="0000000000000000000000000000000000000000";
+    uint64_t stats[8];
+    GPU_CHECK(s2a_rb_guest_prepare_graphics("0400C3F00006E000","wrong",NULL,NULL,NULL,NULL,stats,NULL,NULL)==2);
+    GPU_CHECK(!rb_ref_materialize(root,@[record],target,2,NULL,NULL));
+    GPU_CHECK(![NSFileManager.defaultManager fileExistsAtPath:[root stringByAppendingPathComponent:@"pso_user.tsv"]]);
+    setenv("S2A_RB_PREPARE_PROFILE",rb_ref_manifest(root).fileSystemRepresentation,1);
+    reference_boot(root);
+    while (atomic_load(&g_warm_running)) usleep(1000);
+    uint64_t gpu[6];
+    GPU_CHECK(s2a_rb_guest_prepare_gpu_status(gpu)==(missing ? -1 : 1));
+    GPU_CHECK(gpu[0]==3 && gpu[1]==3 && gpu[2]==2 && gpu[3]==2-missing && gpu[4]==2-missing && gpu[5]==missing);
+    if (replay) GPU_CHECK(atomic_load(&g_par_hits)>=2 && !atomic_load(&g_par_misses));
+    NSMutableDictionary *objects=[NSMutableDictionary dictionary];
+    os_unfair_lock_lock(&g_warm_lock);
+    for (WarmItem *w in g_warm_items) if (w->referenceKey) objects[w->vs_key]=w->object;
+    os_unfair_lock_unlock(&g_warm_lock);
+    GPU_CHECK(objects.count==2-missing);
+    demand_vertex_and_draw(vertices[0],ST_A,objects[vertices[0]]);
+    if (!missing) demand_vertex_and_draw(vertices[1],ST_A,objects[vertices[1]]);
+    GPU_CHECK(!g_rb_seed_objects.n);
+    GPU_CHECK(!nvn_be_request_stop() && !nvn_be_shutdown_session());
+    printf("PASS reference %s: functions %llu, exact PSOs %llu, strict disk PSOs %llu, missing %llu, correct GPU pixel\n",
+        missing?"unresolved":replay?"relaunch":"empty history",(unsigned long long)gpu[1],(unsigned long long)gpu[3],
+        (unsigned long long)gpu[4],(unsigned long long)gpu[5]);
+}
+static int reference_child(char *exe,NSString *root,char *mode) {
+    char *args[]={exe,"--reference-child",(char *)root.fileSystemRepresentation,mode,NULL};
+    pid_t child; int s=0;
+    if(posix_spawnp(&child,exe,NULL,NULL,args,environ)) return -1;
+    pid_t done; do { done=waitpid(child,&s,0); } while(done<0 && errno==EINTR);
+    return done==child && WIFEXITED(s)?WEXITSTATUS(s):-1;
+}
+static int reference_test_main(int argc,char **argv) { @autoreleasepool {
+    alarm(120);
+    if (argc==4 && !strcmp(argv[1],"--reference-child")) {
+        NSString *root=@(argv[2]);
+        if (!strcmp(argv[3],"collect")) reference_collect(root);
+        else reference_check(root,!strcmp(argv[3],"missing"),!strcmp(argv[3],"replay"));
+        return 0;
+    }
+    GPU_CHECK(argc==2 && !strcmp(argv[1],"--reference-gpu"));
+    char tmp[]="/tmp/rb-ref-XXXXXX"; GPU_CHECK(mkdtemp(tmp)); NSString *root=@(tmp);
+    GPU_CHECK(!reference_child(argv[0],root,"collect"));
+    for (NSString *mode in @[@"empty",@"replay",@"missing"]) {
+        [NSFileManager.defaultManager removeItemAtPath:[root stringByAppendingPathComponent:@"pso_user.tsv"] error:nil];
+        GPU_CHECK(!reference_child(argv[0],root,(char *)mode.UTF8String));
+    }
+    GPU_CHECK([NSFileManager.defaultManager removeItemAtPath:root error:nil]);
+    puts("PASS real reference capture, empty personal history, archive relaunch, missing descriptor");
+    return 0;
+} }
