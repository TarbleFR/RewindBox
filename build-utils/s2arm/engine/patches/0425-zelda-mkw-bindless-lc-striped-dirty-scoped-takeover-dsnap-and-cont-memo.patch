+// RewindBox (patch 0425): per-shader handle-source mask for generation-based rb_cont_reads_rt_memo
+// and bindless-aware lc_sampled. Captures every binding class that rb_cont_reads_rt resolves so
+// non-handle UBO / SSBO / sampler updates never defeat same-target continuation memoization.
+enum {
+    RB_CONT_F_TEX     = 1 << 0,   // reads S.tex[stage] (TEX / TBUF / TEXD / TEXA)
+    RB_CONT_F_IMG     = 1 << 1,   // reads S.img[stage] (IMG / TEX / TBUF / TEXA via tex_slot_h fallback)
+    RB_CONT_F_UNKNOWN = 1 << 2,   // TEXP or missing explicit bindings
+};
+typedef struct {
+    uint16_t ubo;       // UBO slots holding texture/image handles (TEXU / TBUFU / IMGU, incl. pair_reg)
+    uint8_t flags;      // RB_CONT_F_*
+    uint8_t built;      // 1 = initialized
+} rb_cont_masks;
+
+static inline void rb_cont_masks_add(rb_cont_masks *m, int kind, int n, int reg, int pair, int pair_reg) {
+    switch (rb_cont_binding_class(kind, n)) {
+        case RB_CONT_SLOT:
+        case RB_CONT_C2_ARRAY:
+            m->flags |= (RB_CONT_F_TEX | RB_CONT_F_IMG);
+            break;
+        case RB_CONT_SLOTS:
+            m->flags |= RB_CONT_F_TEX;
+            break;
+        case RB_CONT_IMAGE:
+            m->flags |= RB_CONT_F_IMG;
+            break;
+        case RB_CONT_UBO:
+            if (reg >= 0 && reg < 16) m->ubo |= (uint16_t)(1u << reg); else m->flags |= RB_CONT_F_UNKNOWN;
+            if (pair) {
+                if (pair_reg >= 0 && pair_reg < 16) m->ubo |= (uint16_t)(1u << pair_reg); else m->flags |= RB_CONT_F_UNKNOWN;
+            }
+            break;
+        case RB_CONT_UBO_ARRAY:
+            if (reg >= 0 && reg < 16) m->ubo |= (uint16_t)(1u << reg); else m->flags |= RB_CONT_F_UNKNOWN;
+            break;
+        case RB_CONT_UNKNOWN:
+            m->flags |= RB_CONT_F_UNKNOWN;
+            break;
+        default: break;
+    }
+}
+static inline int rb_cont_masks_reads_any(const rb_cont_masks *m) {
+    return m->ubo != 0 || m->flags != 0;
+}
+// Returns bitmask of matched entries in att[0..na-1] (capped at 64 entries) for per-clear conflict tracking.
+static inline uint64_t rb_cont_hit_mask(rb_cont_tex t, const rb_cont_tex *att, int na) {
+    uint64_t mask = 0;
+    for (int i = 0; i < na && i < 64; i++)
+        if ((t.serial && t.serial == att[i].serial) || (t.mem && t.mem == att[i].mem)) mask |= UINT64_C(1) << i;
+    return mask;
+}
