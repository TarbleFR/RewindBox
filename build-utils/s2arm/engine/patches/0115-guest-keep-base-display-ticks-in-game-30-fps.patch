 //   link's rate at each change. The 50 ms period (20 Hz) and DM_FPS=30 are unchanged; no limit: unchanged. S2A_RB_LINK_CAP30=0: 30 Hz under the limit, as before
 static int rb_link_cap30(void) { static int v = -1; if (v < 0) { const char *e = getenv("S2A_RB_LINK_CAP30"); v = !(e && !strcmp(e, "0")); } return v; }
+// RewindBox (patch 0115): IPA 786 dropped 82 and 96 on-screen frames in consecutive
+// windows of 300 after switching the link to 30 Hz at frame 2106. On-screen p99
+// reached 79.17 ms. Keep the display at its base rate in automatic game-30 mode,
+// as for a user cap in patch 0068. The guest still waits a 33.33 ms period.
+static int rb_link_game30_on(void) {
+    static int v = -1;   // present thread only
+    if (v < 0) { const char *e = getenv("S2A_RB_LINK_GAME30"); v = e && !strcmp(e, "1"); }
+    return v;
+}
