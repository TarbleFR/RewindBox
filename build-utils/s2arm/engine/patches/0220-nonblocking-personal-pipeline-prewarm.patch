+                (option && !strcmp(option, "1") ? 3 : 2);
+        atomic_store_explicit(&rb_pso_session_mode, value, memory_order_relaxed);
+    }
+    return value - 1;  // 0 outside the title, 1 control, 2 async
+#else
+    return 0;
+#endif
+}
+static int rb_async_pso(void) { return rb_pso_mode() == 2; }
