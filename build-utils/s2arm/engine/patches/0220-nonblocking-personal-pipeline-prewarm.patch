+static _Atomic int rb_pso_session_mode;
+static int rb_pso_mode(void) {
+#if TARGET_OS_IOS
+    if (g_m3) return 0;
+    int value = atomic_load_explicit(&rb_pso_session_mode, memory_order_relaxed);
