+                        cur = run[^1].EndLine + 1;
+                    }
+                    else
+                    {
+                        cur++;
+                    }
+                }
+            }
+            if (replace.Count == 0) return msl;
+            var outLines = new List<string>(lines.Length);
+            int nextIdx = 0;
+            foreach (var (sLine, eLine, rep) in replace)
+            {
+                while (nextIdx < sLine) outLines.Add(lines[nextIdx++]);
+                outLines.Add(rep);
+                nextIdx = eLine + 1;
+            }
+            while (nextIdx < lines.Length) outLines.Add(lines[nextIdx++]);
+            return string.Join('\n', outLines);
+        }
