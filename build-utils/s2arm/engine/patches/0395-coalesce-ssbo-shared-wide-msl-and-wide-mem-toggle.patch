+                            if (mod16 != 0 && mod16 != 8) break;
+                        }
+                        else
+                        {
+                            var first = run[0];
+                            int maxN = (first.Off & 15) == 0 ? 4 : 2;
+                            if (run.Count >= maxN) break;
