+                        sb.Append(f0.Ind).Append("if ").Append(cond).Append('\n')
+                          .Append(f0.Ind).Append("{\n")
+                          .Append(f0.Ind).Append("    ").Append(ptr).Append(" = ").Append(vec).Append('(').Append(vals).Append(");\n")
+                          .Append(f0.Ind).Append("}\n")
+                          .Append(f0.Ind).Append("else\n")
+                          .Append(f0.Ind).Append("{\n");
+                        foreach (var it in run)
