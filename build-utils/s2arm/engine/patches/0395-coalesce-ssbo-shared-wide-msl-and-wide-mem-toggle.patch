+                    {
+                        int N = run.Count;
+                        var f0 = run[0];
+                        string vec = "packed_uint" + N;
+                        var sb = new StringBuilder();
+                        foreach (var item in run)
+                            foreach (var pl in item.PrefixLines) sb.Append(pl).Append('\n');
+                        string cond = f0.Kind == 0
+                            ? $"(({f0.Len} >= {N}u) && ({f0.Iv} <= ({f0.Len} - {N}u)))"
+                            : $"({f0.Iv} <= {tgLen[f0.Target] - (uint)N}u)";
+                        string ptr = f0.Kind == 0
