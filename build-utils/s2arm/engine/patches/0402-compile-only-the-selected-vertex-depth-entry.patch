+static NSString *rb_vertex_prune(NSString *src, NSString *drop) {
+    // Only the generated, unprefixed vertex form is accepted. A second use of
+    // the name (including a call) keeps the original source conservatively.
+    NSString *escaped=[NSRegularExpression escapedPatternForString:drop];
+    NSRegularExpression *uses=[NSRegularExpression regularExpressionWithPattern:
+        [NSString stringWithFormat:@"\\b%@\\s*\\(",escaped] options:0 error:nil];
+    NSRange whole=NSMakeRange(0,src.length);
+    if ([uses numberOfMatchesInString:src options:0 range:whole]!=1) return src;
+    NSRegularExpression *entry=[NSRegularExpression regularExpressionWithPattern:
+        [NSString stringWithFormat:@"(?m)^vertex[ \\t]+[A-Za-z_][A-Za-z_0-9]*[ \\t]+%@\\s*\\(",escaped]
+        options:0 error:nil];
+    NSTextCheckingResult *match=[entry firstMatchInString:src options:0 range:whole];
+    if (!match) return src;
+    NSUInteger start=match.range.location, pos=NSMaxRange(match.range);
+    int depth=0, state=0, opened=0;
+    for (;pos<src.length;++pos) {
+        unichar c=[src characterAtIndex:pos], next=pos+1<src.length ? [src characterAtIndex:pos+1] : 0;
+        if (state==1) { if (c=='\n') state=0; continue; }
+        if (state==2) { if (c=='*' && next=='/') { ++pos; state=0; } continue; }
+        if (state==3 || state==4) {
+            if (c=='\\') { ++pos; continue; }
+            if ((state==3 && c=='"') || (state==4 && c=='\'')) state=0;
+            continue;
+        }
+        if (c=='/' && next=='/') { state=1; ++pos; continue; }
+        if (c=='/' && next=='*') { state=2; ++pos; continue; }
+        if (c=='"' || c=='\'') { state=c=='"' ? 3:4; continue; }
+        if (c=='#' || (!opened && c==';')) return src;
+        if (c=='{') { opened=1; ++depth; }
+        if (c=='}') {
+            if (!opened || depth<=0) return src;
+            if (!--depth) return [src stringByReplacingCharactersInRange:NSMakeRange(start,pos+1-start) withString:@""];
+        }
+    }
+    return src;
+}
+static id<MTLLibrary> rb_vertex_library(NSString *src,int stage,int layer,int depth,NSDictionary *j,NSError **error) {
+    if (stage!=0 || layer || !rb_vertex_entry_on() || [j[@"fn_prefix"] length] ||
+        j[@"entry_layer"] || ![j[@"entry"] isEqual:@"main0"] || ![j[@"entry_z"] isEqual:@"main0_z"])
