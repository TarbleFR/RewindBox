+// RewindBox (patch 0402), S2 first slice: compile only the depth convention
+// selected for this shader identity. The translated file and its fingerprint
+// remain intact; content-keyed Metal libraries isolate the compiled variants.
+static _Atomic int rb_vertex_entry_mode=-1;
+static _Atomic uint64_t rb_vertex_entry_cuts, rb_vertex_entry_fallbacks;
+static int rb_vertex_entry_on(void) {
+    int mode=atomic_load(&rb_vertex_entry_mode);
+    if (mode<0) {
+        const char *e=getenv("S2A_RB_VERTEX_ENTRY");
+        mode=e ? !strcmp(e,"1") : nvn_rb_thermal_scope();
+        atomic_store(&rb_vertex_entry_mode,mode);
+    }
+    return mode;
