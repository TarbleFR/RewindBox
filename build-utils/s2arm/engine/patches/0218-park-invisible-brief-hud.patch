+// RewindBox hides this label live from its own menu. Park its repeating refresh
+// while hidden or detached, retaining the frame history for an immediate reopen.
+@interface S2ArmBriefHUDLabel : UILabel
+@property(nonatomic, weak) NSTimer *refreshTimer;
+- (void)updateRefreshSchedule;
+@end
+
+@implementation S2ArmBriefHUDLabel
+- (void)updateRefreshSchedule {
+    self.refreshTimer.fireDate = self.hidden || !self.window ? NSDate.distantFuture : [NSDate dateWithTimeIntervalSinceNow:0.5];
+}
+- (void)setHidden:(BOOL)hidden {
+    BOOL changed = hidden != self.hidden;
+    [super setHidden:hidden];
+    if (changed) [self updateRefreshSchedule];
+}
+- (void)didMoveToWindow {
+    [super didMoveToWindow];
+    [self updateRefreshSchedule];
+}
+@end
