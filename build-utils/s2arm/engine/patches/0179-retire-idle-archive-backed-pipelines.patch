+
+// Only owners whose exact archive has already passed Metal's fail-on-miss
+// check can be retired. Keep a bounded ledger of outstanding identities.
+// If the ledger fills, keep more pipelines instead of losing recreations.
+enum { RB_RETIRED_LIMIT=8192 };
+static NSMutableSet *rb_retired;
+static os_unfair_lock rb_retired_lock=OS_UNFAIR_LOCK_INIT;
+static _Atomic NSUInteger rb_retired_count;
+static BOOL rb_retire_identity(NSString *key) {
+    if (!key) return NO;
+    os_unfair_lock_lock(&rb_retired_lock);
+    if (!rb_retired) rb_retired=[NSMutableSet set];
+    BOOL room=rb_retired.count<RB_RETIRED_LIMIT || [rb_retired containsObject:key];
+    if (room) [rb_retired addObject:key];
+    atomic_store(&rb_retired_count,rb_retired.count);
+    os_unfair_lock_unlock(&rb_retired_lock);
+    return room;
+}
+static void rb_recreated(NSString *key,id ps,uint64_t start) {
+    if (!start || !key || !atomic_load_explicit(&rb_retired_count,memory_order_relaxed)) return;
+    uint64_t elapsed=clock_gettime_nsec_np(CLOCK_UPTIME_RAW)-start;
+    os_unfair_lock_lock(&rb_retired_lock);
+    BOOL retired=[rb_retired containsObject:key];
+    if (retired && ps) [rb_retired removeObject:key];
+    atomic_store(&rb_retired_count,rb_retired.count);
+    os_unfair_lock_unlock(&rb_retired_lock);
+    if (!retired) return;
+    RBPSOLifetime *life=objc_getAssociatedObject(ps,&rb_pso_lifetime_key);
+    MLOG("[RB-PSO-RECREATE] id=%s elapsed_ns=%llu source=%s",key.UTF8String,
+         (unsigned long long)elapsed,!ps ? "failed" : life && life->archiveHit ? "binary_archive" : "compiler");
+}
