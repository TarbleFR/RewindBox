+static void rb_pso_scan(nvn_hmap *map,unsigned lane,uint64_t now) {
+    if (!map->n) return;
+    unsigned dropped=0, budget=MIN(map->cap,(uint32_t)RB_SCAN_SLOTS);
+    for (unsigned i=0;i<budget && dropped<RB_SCAN_DROPS;i++) {
+        uint32_t slot=rb_scan_cursor[lane] & (map->cap-1);
+        rb_scan_cursor[lane]=slot+1;
+        id obj=(__bridge id)map->vals[slot];
+        if (!obj) continue;
+        RBPSOLifetime *life=objc_getAssociatedObject(obj,&rb_pso_lifetime_key);
+        if (!life || !life->archiveHit || now<life->touched ||
+            now-life->touched<RB_IDLE_SECONDS*(uint64_t)NSEC_PER_SEC) continue;
+        if (!rb_retire_identity(life->identity)) continue;
+        defer_obj_unref(obj);
+        if (map==&g_pso) {
+            rb_forget_render_pointer(obj);
+            if (rb_heap_measure()) atomic_fetch_sub_explicit(&g_rb_pso_objects,life->bytes,memory_order_relaxed);
+        }
+        hm_del_id(map,map->keys+(size_t)slot*map->klen);
+        rb_scan_cursor[lane]=slot; dropped++; rb_drop_total++;
+    }
+}
+static void rb_pso_maintain(void) {
+    uint64_t now=clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (now<rb_next_scan) return;
+    rb_next_scan=now+50*NSEC_PER_MSEC;
+    rb_flush_binds(NO,now);
+    rb_pso_scan(&g_pso,0,now);
+    rb_pso_scan(&g_cps,1,now);
+    rb_pso_scan(&g_cps_se,2,now);
+    if (now>=rb_next_report) {
+        uint64_t v[4]; nvn_rb_pso_snapshot(v);
+        MLOG("[RB-PSO-CAP] render_live=%llu compute_live=%llu mesh_live=%llu shallow_bytes=%llu render_entries=%u compute_entries=%u variant_entries=%u evictions=%llu idle_s=%u",
+             (unsigned long long)v[0],(unsigned long long)v[1],(unsigned long long)v[2],(unsigned long long)v[3],
+             g_pso.n,g_cps.n,g_cps_se.n,(unsigned long long)rb_drop_total,RB_IDLE_SECONDS);
+        rb_next_report=now+60ull*NSEC_PER_SEC;
+    }
+}
+static void rb_pso_retirement_end(void) {
+    if (!rb_pso_cap_on()) return;
+    os_unfair_lock_lock(&rb_retired_lock);
+    rb_retired=nil; atomic_store(&rb_retired_count,0);
+    os_unfair_lock_unlock(&rb_retired_lock);
+    memset(rb_scan_cursor,0,sizeof rb_scan_cursor); rb_next_scan=rb_next_report=rb_drop_total=0;
+    // Variant keys contain session-local shader pointers.
+    nvn_hm_clear(&g_cps_se,hm_rel);
+}
