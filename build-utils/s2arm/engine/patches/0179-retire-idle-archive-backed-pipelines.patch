+static void rb_forget_render_pointer(id obj) {
+    const void *raw=(__bridge void *)obj;
+    nvn_hm_del(&g_rb_promoted_objects,&raw);
+    hm_del_id(&g_rb_seed_objects,&raw);
+    hm_del_id(&g_rb_draw_candidates,&raw);
+    if (t_rb_draw_pipeline==raw) t_rb_draw_pipeline=NULL;
+    if (t_course.ps==(uintptr_t)raw) t_course.ps=0;
+    os_unfair_lock_lock(&g_wu_lock);
+    for (unsigned i=0;i<g_course_attempts;i++)
