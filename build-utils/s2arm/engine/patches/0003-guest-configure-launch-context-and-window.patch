+// RewindBox guest (runtime/src/rb_guest.c): see s2a_launch_ctx.h. Checks and defaults of a context file (①); docs created level by level
+static int guest_abs(char *dst, const char *v, const char *key, char *why, size_t why_n) {
+    if (!v || v[0] != '/') { WHY("%s must be an absolute path", key); return -1; }
+    if (put(dst, v)) { WHY("%s is too long", key); return -1; }
+    return 0;
+}
+const char *s2a_launch_ctx_set_guest(const char *game_id, const char *images, const char *module_dir, const char *caps_dir,
+                                     const char *game_data, const char *ryu_data, const char *docs) {
+    static atomic_int once; static char why_buf[700]; char *why = why_buf; const size_t why_n = sizeof why_buf;
+    if (atomic_exchange(&once, 1)) return "the guest launch context can be given once per process";
+    s2a_launch_ctx *c = &g_guest_ctx; memset(c, 0, sizeof *c);
+    if (!game_id || !id_ok(game_id) || game_id[0] == '.' || strlen(game_id) >= sizeof c->game_id) {
+        WHY("game_id \"%s\" must be [A-Za-z0-9._-], not start with '.', and be shorter than %zu bytes", game_id ? game_id : "", sizeof c->game_id); return why; }
+    strcpy(c->game_id, game_id);
+    if (guest_abs(c->images, images, "images", why, why_n) || guest_abs(c->module_dir, module_dir, "module_dir", why, why_n)
+        || guest_abs(c->game_data, game_data, "game_data", why, why_n) || guest_abs(c->docs, docs, "docs", why, why_n)) return why;
+    if (caps_dir ? guest_abs(c->caps_dir, caps_dir, "caps_dir", why, why_n) : put(c->caps_dir, c->module_dir)) { if (!why[0]) WHY("module_dir is too long"); return why; }
+    if (ryu_data ? guest_abs(c->ryu_data, ryu_data, "ryu_data", why, why_n) : join(c->ryu_data, c->docs, "S2A/ryujinx")) { if (!why[0]) WHY("docs is too long"); return why; }
+    const char *home = getenv("HOME");
+    if (join(c->log_dir, home && *home ? home : ".", "Documents")) { WHY("HOME is too long"); return why; }   // host.log stays process level, as for ①
+    for (char *q = c->docs + 1; ; q++) {
+        if (*q && *q != '/') continue;
+        char k = *q; *q = 0; int bad = mkdir(c->docs, 0755) && errno != EEXIST; *q = k;
+        if (bad) { WHY("cannot create docs %s (errno %d)", c->docs, errno); return why; }
+        if (!k) break;
+    }
+    c->source = S2A_LCTX_FILE;
+    atomic_store(&g_guest_set, 1);
+    pthread_once(&g_once, decide);
+    if (atomic_load(&g_guest_used)) return NULL;
+    return atomic_load(&g_guest_seen) ? g_err : "the launch context was already frozen before the host gave it";
+}
