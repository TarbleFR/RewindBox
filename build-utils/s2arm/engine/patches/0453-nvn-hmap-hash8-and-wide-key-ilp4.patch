+// Specialized 8-byte hash: bit-exact with nvn_hm_hash(k, 8), zero loop/tail branches.
+static inline uint64_t nvn_hm_hash8(uint64_t w) {
+    uint64_t h = ((0x9e3779b97f4a7c15ull ^ 8ull) ^ w) * 0xff51afd7ed558ccdull;
+    h ^= h >> 32;
+    h ^= h >> 33;
+    h *= 0xc4ceb9fe1a85ec53ull;
+    h ^= h >> 33;
+    return h;
+}
+// Internal bucket hash: 4-lane ILP for large fixed-length keys (>= 32B, e.g. 344B pso_key),
+// breaking the 43-multiply serial dependency chain across Apple A18 Pro's 4 integer pipes.
+static inline uint64_t nvn_hm_slot_hash(const void *k, uint32_t len) {
+    if (len < 128) return nvn_hm_hash(k, len);
+    const uint8_t *p = (const uint8_t *)k;
+    uint64_t h0 = 0x9e3779b97f4a7c15ull ^ len;
+    uint64_t h1 = 0xbf58476d1ce4e5b9ull ^ len;
+    uint64_t h2 = 0x94d049bb133111ebull ^ len;
+    uint64_t h3 = 0xd6e8feb86659fd93ull ^ len;
+    for (; len >= 32; p += 32, len -= 32) {
+        uint64_t w0, w1, w2, w3;
+        memcpy(&w0, p, 8); memcpy(&w1, p + 8, 8);
+        memcpy(&w2, p + 16, 8); memcpy(&w3, p + 24, 8);
+        h0 = (h0 ^ w0) * 0xff51afd7ed558ccdull; h0 ^= h0 >> 32;
+        h1 = (h1 ^ w1) * 0xff51afd7ed558ccdull; h1 ^= h1 >> 32;
+        h2 = (h2 ^ w2) * 0xff51afd7ed558ccdull; h2 ^= h2 >> 32;
+        h3 = (h3 ^ w3) * 0xff51afd7ed558ccdull; h3 ^= h3 >> 32;
+    }
+    uint64_t h = h0 ^ (h1 * 0x94d049bb133111ebull) ^ (h2 * 0xbf58476d1ce4e5b9ull) ^ (h3 * 0xff51afd7ed558ccdull);
+    for (; len >= 8; p += 8, len -= 8) { uint64_t w; memcpy(&w, p, 8); h = (h ^ w) * 0xff51afd7ed558ccdull; h ^= h >> 32; }
+    if (len) { uint64_t w = 0; memcpy(&w, p, len); h = (h ^ w) * 0xff51afd7ed558ccdull; }
+    h ^= h >> 33; h *= 0xc4ceb9fe1a85ec53ull; h ^= h >> 33;
+    return h;
+}
+static inline int nvn_hm_eq(const uint8_t *a, const void *b, uint32_t len) {
+    if (len >= 8) {
+        uint64_t wa, wb;
+        memcpy(&wa, a, 8); memcpy(&wb, b, 8);
+        if (wa != wb) return 0;
+        if (len == 8) return 1;
+        return memcmp(a + 8, (const uint8_t *)b + 8, len - 8) == 0;
+    }
+    return memcmp(a, b, len) == 0;
+}
