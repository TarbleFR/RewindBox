diff --git a/runtime/src/rb_wait_latency.inc b/runtime/src/rb_wait_latency.inc
new file mode 100644
index 0000000..5866fce
--- /dev/null
+++ b/runtime/src/rb_wait_latency.inc
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+// Diagnostic only. No sleep duration, notification or guest deadline changes.
+static _Atomic int rb_latency_mode=-1;
+static _Atomic uint64_t rb_latency_count[2],rb_latency_sum[2],rb_latency_max[2],rb_latency_bins[2][6];
+static int rb_latency_on(void) {
+    int mode=atomic_load_explicit(&rb_latency_mode,memory_order_relaxed);
+    if (mode<0) { const char *e=getenv("S2A_RB_WAKE_LATENCY"); mode=e && !strcmp(e,"1"); atomic_store(&rb_latency_mode,mode); }
+    return mode;
+}
+static uint64_t rb_latency_now(void) {
+    int saved=errno; struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); errno=saved;
+    return (uint64_t)t.tv_sec*1000000000ull+(uint64_t)t.tv_nsec;
+}
+static void rb_latency_add(unsigned kind,uint64_t ns) {
+    atomic_fetch_add(&rb_latency_count[kind],1); atomic_fetch_add(&rb_latency_sum[kind],ns);
+    uint64_t old=atomic_load(&rb_latency_max[kind]);
+    while (ns>old && !atomic_compare_exchange_weak(&rb_latency_max[kind],&old,ns)) { }
+    unsigned bin=ns<=10000 ? 0 : ns<=50000 ? 1 : ns<=100000 ? 2 : ns<=500000 ? 3 : ns<=1000000 ? 4 : 5;
+    atomic_fetch_add(&rb_latency_bins[kind][bin],1);
+}
+void s2a_rb_wait_latency_reset(void) {
+    atomic_store(&rb_latency_mode,-1);
+    for (unsigned k=0;k<2;k++) { atomic_store(&rb_latency_count[k],0); atomic_store(&rb_latency_sum[k],0); atomic_store(&rb_latency_max[k],0);
+        for (unsigned b=0;b<6;b++) atomic_store(&rb_latency_bins[k][b],0); }
+}
+void s2a_rb_wait_latency_report(uint64_t frame,void (*emit)(const char *)) {
+    if (!rb_latency_on()) return;
+    char row[700];
+    for (unsigned k=0;k<2;k++) {
+        snprintf(row,sizeof row,"[rb-wake-latency] cumulative frame=%llu kind=%s sample_every=64 count=%llu sum_ns=%llu max_ns=%llu bins_10_50_100_500_1000_over_us=%llu/%llu/%llu/%llu/%llu/%llu",
+            (unsigned long long)frame,k ? "yield-sleep-overshoot" : "address-release-to-resume",
+            (unsigned long long)atomic_load(&rb_latency_count[k]),(unsigned long long)atomic_load(&rb_latency_sum[k]),(unsigned long long)atomic_load(&rb_latency_max[k]),
+            (unsigned long long)atomic_load(&rb_latency_bins[k][0]),(unsigned long long)atomic_load(&rb_latency_bins[k][1]),(unsigned long long)atomic_load(&rb_latency_bins[k][2]),
+            (unsigned long long)atomic_load(&rb_latency_bins[k][3]),(unsigned long long)atomic_load(&rb_latency_bins[k][4]),(unsigned long long)atomic_load(&rb_latency_bins[k][5]));
+        emit(row);
+    }
+}
