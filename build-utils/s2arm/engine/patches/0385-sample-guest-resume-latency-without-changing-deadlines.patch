+    wait_unlink(t); t->wkind = 0; t->wres = res; t->wake_t = thread_clock(); if (t->rb_latency_take) t->rb_latency_signal_ns=rb_latency_now(); __atomic_store_n(&t->woke, 1, __ATOMIC_RELEASE);
