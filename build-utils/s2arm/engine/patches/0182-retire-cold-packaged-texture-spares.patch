+// A spare is the previous whole-upload destination, never the authoritative
+// current texture. The existing upload either overwrites it completely or uses
+// a fresh allocation. Weak owners must not keep a finalized guest texture alive.
+enum { RB_SPARE_SLOTS = 128 };
+typedef struct { __weak NvPkg *owner; uint64_t frame, bytes; } rb_spare_entry;
+static rb_spare_entry rb_spares[RB_SPARE_SLOTS];
+static uint64_t rb_spare_held;
+static _Atomic uint64_t rb_spare_evictions;
+static void rb_spare_forget(int i, BOOL evict) {
+    rb_spare_entry *slot = &rb_spares[i];
+    NvPkg *owner = slot->owner;
+    if (evict && owner && owner->spare) {
+        defer_obj_release_at(owner->spare, owner->spare_fence);
+        owner->spare = nil;
+        atomic_fetch_add_explicit(&rb_spare_evictions, 1, memory_order_relaxed);
+    }
+    rb_spare_held -= slot->bytes;
+    slot->owner = nil;
+    slot->bytes = slot->frame = 0;
+}
+static void rb_spare_tend(uint64_t frame) {
+    for (int i = 0; i < RB_SPARE_SLOTS; ++i) {
+        rb_spare_entry *slot = &rb_spares[i];
+        if (slot->bytes && (!slot->owner || (frame >= slot->frame && frame - slot->frame >= 180)))
+            rb_spare_forget(i, YES);
+    }
+    while (rb_spare_held > rb_texture_share(3)) {
+        int oldest = -1;
+        for (int i = 0; i < RB_SPARE_SLOTS; ++i)
+            if (rb_spares[i].bytes && (oldest < 0 || rb_spares[i].frame < rb_spares[oldest].frame)) oldest = i;
+        if (oldest < 0) break;
+        rb_spare_forget(oldest, YES);
+    }
+}
+static void rb_spare_record(NvPkg *owner) {
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    int empty = -1, oldest = 0;
+    for (int i = 0; i < RB_SPARE_SLOTS; ++i) {
+        if (rb_spares[i].owner == owner) { rb_spare_forget(i, NO); empty = i; break; }
+        if (!rb_spares[i].owner && empty < 0) empty = i;
+        if (rb_spares[i].frame < rb_spares[oldest].frame) oldest = i;
+    }
+    int i = empty >= 0 ? empty : oldest;
+    rb_spare_forget(i, YES);
+    rb_spares[i].owner = owner;
+    rb_spares[i].frame = frame;
+    rb_spares[i].bytes = owner->spare.allocatedSize;
+    rb_spare_held += rb_spares[i].bytes;
+    if (!rb_spares[i].bytes) rb_spare_forget(i, YES);
+    if (rb_spare_held > rb_texture_share(3)) rb_spare_tend(frame);
+}
