+        // The index first, its stamp last: an interruption never leaves an index without a stamp, which would be taken for S2Arm's own
+        //   and read unchecked. When the index cannot be deleted its stamp stays, and the next start finds it stale again
+        internal static void RbForget(string indexPath)
+        {
+            try
+            {
+                File.Delete(indexPath);
+                File.Delete(indexPath + ".tmp");
+                File.Delete(indexPath + RbListSuffix);
+                File.Delete(indexPath + RbStampSuffix + ".tmp");
+                File.Delete(indexPath + RbStampSuffix);
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
+            {
