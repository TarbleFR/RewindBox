+        // RewindBox (patch 0014): the index of a game prepared without one. S2Arm writes romfs.s2aidx when it packs a game on a computer; a
+        //   game RewindBox prepares on the phone has none, so every start enumerated the RomFS directory and opened each file for its length
+        //   (Application.RomFsFromDirectory). Mario Kart World (0400C3F00006E000, 205,058 files, iPhone17,2, 13 Nov): 69.2 s of the start, at
+        //   each launch. The first start now writes the index with S2Arm's own writer (same file order, same LibHac layout: the image is the
+        //   one the directory build gives) and reads the image through it; later starts read the index.
+        //   An index written here is only as good as the tree it was written for, so it carries a stamp of that tree (romfs.s2aidx.rbtree):
+        //   every directory of romfs/ (the link's target when romfs/ is a link) with its modification time. Adding, removing, renaming or
+        //   replacing a file changes the time of its directory: the stamp no longer matches, the index is dropped and written again. A file
+        //   rewritten in place with another length is not seen by the stamp, but never read wrongly: the reader compares each file's length
+        //   with the index when it opens it and fails that read in red (Application.cs LazyHostFile, HostFileDataCorrupted), as for any
+        //   index. An index without a stamp is S2Arm's pack-time one and is trusted as before.
+        public const string RbStampSuffix = ".rbtree";
+
+        internal static string RbTreeStamp(string romfsDir)
+        {
+            string root = Path.GetFullPath(romfsDir);
+            System.IO.FileSystemInfo target = Directory.ResolveLinkTarget(root, true);
+
+            if (target != null)
+            {
+                root = target.FullName;
+            }
+
+            List<string> dirs = new(Directory.EnumerateDirectories(root, "*", SearchOption.AllDirectories));
+            dirs.Sort(StringComparer.Ordinal);
+            StringBuilder text = new();
+            text.Append("rb-romfs-tree 1\n").Append(Directory.GetLastWriteTimeUtc(root).Ticks).Append('\n');
+
+            foreach (string dir in dirs)
+            {
+                text.Append(Path.GetRelativePath(root, dir)).Append('\t').Append(Directory.GetLastWriteTimeUtc(dir).Ticks).Append('\n');
+            }
+
+            return text.ToString();
+        }
+
+        // true = the index next to the tree was written here (it has a stamp) and the tree is no longer the one it was written for
+        internal static bool RbStale(string romfsDir, string indexPath)
+        {
+            string stamp = indexPath + RbStampSuffix;
+
+            if (!File.Exists(stamp))
+            {
+                return false;
+            }
+
+            try
+            {
+                return File.ReadAllText(stamp, Encoding.UTF8) != RbTreeStamp(romfsDir);
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
+            {
+                return true;
+            }
+        }
+
+        internal static void RbForget(string indexPath)
+        {
+            try
+            {
+                File.Delete(indexPath + RbStampSuffix);
+                File.Delete(indexPath);
+                File.Delete(indexPath + ".tmp");
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
+            {
+            }
+        }
+
+        // Writes the index of romfsDir (stamp first: an interrupted write leaves a stamp without an index, never an index without a stamp) and
+        //   opens the image through it. null = not written (an overlay is present, whose lengths only the pack-time writer knows; the tree
+        //   changed meanwhile; the folder cannot be written): the caller builds the image from the directory, as before.
+        internal static IStorage RbWriteAndOpen(string romfsDir, string indexPath, string overlayDir)
+        {
+            if (OverlayFiles(overlayDir) != null)
+            {
+                return null;
+            }
+
+            try
+            {
+                string before = RbTreeStamp(romfsDir);
+                File.WriteAllText(indexPath + RbStampSuffix, before, Encoding.UTF8);
+                Write(romfsDir, indexPath);
+
+                if (RbTreeStamp(romfsDir) != before)
+                {
+                    throw new IOException("the RomFS tree changed while its index was written");
+                }
+
+                return Open(romfsDir, indexPath, null);
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException || e is InvalidDataException)
+            {
+                RbForget(indexPath);
+                Red.Note("RewindBox: RomFS index not written, the image is built from the directory at this start", e.GetType().Name + ": " + e.Message);
+                return null;
+            }
+        }
