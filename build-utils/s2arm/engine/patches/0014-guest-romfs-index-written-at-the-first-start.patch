+
+                    if (tab <= 0 || !long.TryParse(lines[i].AsSpan(tab + 1), out long ticks) ||
+                        Directory.GetLastWriteTimeUtc(Path.Combine(root, lines[i].Substring(0, tab))).Ticks != ticks)
+                    {
+                        return true;
+                    }
+                }
