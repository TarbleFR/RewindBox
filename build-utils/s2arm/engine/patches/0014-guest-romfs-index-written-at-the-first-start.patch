+        //   under its romfs/ folder): when the index of that folder is one written here, it is dropped, once, so that the next start writes
+        //   it again from the tree as it is. S2Arm's pack-time index is left as it is, and so is a folder read without an index
+        internal static void RbMismatch(string path)
+        {
