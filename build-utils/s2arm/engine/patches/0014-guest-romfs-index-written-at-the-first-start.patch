+        // RewindBox (patch 0014): the index of a game prepared without one. S2Arm writes romfs.s2aidx when it packs a game on a computer; a
+        //   game RewindBox prepares on the phone has none, so every start enumerated the RomFS directory and opened each file for its length
+        //   (Application.RomFsFromDirectory). Mario Kart World (0400C3F00006E000, 205,058 files, iPhone17,2): 69.2 s of every start (13 Nov,
+        //   IPA 733). The first start now writes the index and reads the image through it; later starts read the index.
+        //   One walk of the tree gives what the index needs: each file with its length, as S2Arm's own list mode takes them (Write with a
+        //   list: the same LibHac build, no file opened again), and each directory with its modification time, which is the tree's stamp
+        //   (romfs.s2aidx.rbtree). A length is the file's own (one lstat, with the entry); a link is opened for its target's length, as
+        //   S2Arm's writer does for every file. When every file is a link (the view of a game with an update: one link per file, this
+        //   game's case), the start that writes still opens each of them once, as a start did before; the gain is at the starts after it.
+        //   The first version of this patch (IPA 734) walked the tree three times and opened every file: 126.9 s for that start.
+        //   An index written here is only as good as the tree it was written for. Adding, removing, renaming or replacing an entry changes
+        //   the modification time of its directory, so the stamp lists every directory of the tree (the link's target when romfs/ is a
+        //   link) with that time, and a start reads those times again: no walk, one stat per directory. Any difference drops the index,
+        //   which is then written again. What the stamp does not see: a file rewritten in place with another length, and a file replaced
+        //   behind a link (the directory that changes is the export's, not the tree's). Neither is read wrongly: the reader compares each
+        //   file's length with the index when it opens it and fails that read in red (Application.cs LazyHostFile, HostFileDataCorrupted),
+        //   as for any index; for an index written here it is then dropped (RbMismatch), so the next start writes it from the tree as it is.
+        //   The stamp also holds the index's length, written once the index is on disk: an index cut short by a stop of the device is not
+        //   read. An index without a stamp is S2Arm's pack-time one, trusted as before.
+        public const string RbStampSuffix = ".rbtree";
+        public const string RbListSuffix = ".rblist";
+        public const string RbRefusedSuffix = ".rbno";
+        private const string RbStampHead = "rb-romfs-tree 2";
+        private const string RbStampPending = "index -";   // the stamp of an index that is being written: never current
+        private static readonly char[] RbLineBreaks = { '\n', '\r' };
+        private static readonly List<(string Root, string Index)> _rbOpened = new();   // the indexes written here that are in use, each with its romfs/ folder (RbMismatch); locked on itself
+
+        private static void RbInUse(string romfsDir, string indexPath, bool inUse)
+        {
+            lock (_rbOpened)
+            {
+                _rbOpened.RemoveAll(entry => entry.Index == indexPath);
+
+                if (inUse)
+                {
+                    _rbOpened.Add((Path.TrimEndingDirectorySeparator(Path.GetFullPath(romfsDir)) + Path.DirectorySeparatorChar, indexPath));
+                }
+            }
+        }
+
+        // The directory whose entries are the tree: romfs/ itself, or what it links to (a game without an update is one link to the export)
+        private static string RbRoot(string romfsDir)
+        {
+            string root = Path.GetFullPath(romfsDir);
+            System.IO.FileSystemInfo target = Directory.ResolveLinkTarget(root, true);
+            return target != null ? target.FullName : root;
+        }
+
+        // true = the index next to the tree was written here (it has a stamp) and is not to be read: the tree is no longer the one it was
+        //   written for, or the index is not the whole file the stamp was written after. directories = how many were looked at
+        internal static bool RbStale(string romfsDir, string indexPath, out int directories)
+        {
+            directories = 0;
+            string stamp = indexPath + RbStampSuffix;
+
+            if (!File.Exists(stamp))
+            {
+                return false;
+            }
+
+            try
+            {
+                string root = RbRoot(romfsDir);
+                string[] lines = File.ReadAllLines(stamp, Encoding.UTF8);
+
+                if (lines.Length < 3 || lines[0] != RbStampHead || !lines[1].StartsWith("index ", StringComparison.Ordinal) ||
