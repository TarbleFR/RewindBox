+        //   one). S2Arm's pack-time index (no stamp) is opened as before, and its failures are S2Arm's. One written here is opened only while
+        //   the tree is the one it was written for (RbStale), and one that does not read is dropped instead of stopping every start
+        internal static IStorage RbOpen(string romfsDir, string indexPath, string overlayDir, out int directories)
+        {
+            directories = 0;
+            RbInUse(romfsDir, indexPath, false);
+
+            if (!File.Exists(indexPath))
+            {
+                return null;
+            }
+
+            if (!File.Exists(indexPath + RbStampSuffix))
+            {
