+        // RewindBox (patch 0014): the index of a game prepared without one. S2Arm writes romfs.s2aidx when it packs a game on a computer; a
+        //   game RewindBox prepares on the phone has none, so every start enumerated the RomFS directory and opened each file for its length
+        //   (Application.RomFsFromDirectory). Mario Kart World (0400C3F00006E000, 205,058 files, iPhone17,2): 69.2 s of every start (13 Nov,
+        //   IPA 733). The first start now writes the index and reads the image through it; later starts read the index.
+        //   One walk of the tree gives what the index needs: each file with its length, as S2Arm's own list mode takes them (Write with a
+        //   list: the same LibHac build, no file opened), and each directory with its modification time, which is the tree's stamp
+        //   (romfs.s2aidx.rbtree). A length is the file's own (one lstat, with the entry); only a link is opened for its target's length, as
+        //   S2Arm's writer does for every file. The first version of this patch (IPA 734) walked the tree three times and opened every
+        //   file: 126.9 s for that start, against 69.2 s before it; a walk of this tree alone costs the phone 29.4 s cold (preparation
+        //   journal, 12 Nov) and opening a file about three times a stat.
+        //   An index written here is only as good as the tree it was written for. Adding, removing, renaming or replacing an entry changes
+        //   the modification time of its directory, so the stamp lists every directory of the tree (the link's target when romfs/ is a
+        //   link) with that time, and a start reads those times again: no walk, one stat per directory. Any difference drops the index,
+        //   which is then written again. A file rewritten in place with another length is not seen by the stamp, but never read wrongly:
+        //   the reader compares each file's length with the index when it opens it and fails that read in red (Application.cs
+        //   LazyHostFile, HostFileDataCorrupted), as for any index. An index without a stamp is S2Arm's pack-time one, trusted as before.
+        public const string RbStampSuffix = ".rbtree";
+        public const string RbListSuffix = ".rblist";
+        private const string RbStampHead = "rb-romfs-tree 1";
+        private static readonly char[] RbLineBreaks = { '\n', '\r' };
+
+        // The directory whose entries are the tree: romfs/ itself, or what it links to (a game without an update is one link to the export)
+        private static string RbRoot(string romfsDir)
+        {
+            string root = Path.GetFullPath(romfsDir);
+            System.IO.FileSystemInfo target = Directory.ResolveLinkTarget(root, true);
+            return target != null ? target.FullName : root;
+        }
+
+        // true = the index next to the tree was written here (it has a stamp) and the tree is no longer the one it was written for.
+        //   directories = how many were looked at
+        internal static bool RbStale(string romfsDir, string indexPath, out int directories)
+        {
+            directories = 0;
+            string stamp = indexPath + RbStampSuffix;
+
+            if (!File.Exists(stamp))
+            {
+                return false;
+            }
+
+            try
+            {
+                string root = RbRoot(romfsDir);
+                string[] lines = File.ReadAllLines(stamp, Encoding.UTF8);
+
+                if (lines.Length < 2 || lines[0] != RbStampHead || !long.TryParse(lines[1], out long rootTicks) ||
+                    Directory.GetLastWriteTimeUtc(root).Ticks != rootTicks)
+                {
+                    return true;
+                }
+
+                for (int i = 2; i < lines.Length; i++)
+                {
+                    int tab = lines[i].LastIndexOf('\t');
+                    directories++;
+
+                    if (tab <= 0 || !long.TryParse(lines[i].AsSpan(tab + 1), out long ticks) ||
+                        Directory.GetLastWriteTimeUtc(Path.Combine(root, lines[i].Substring(0, tab))).Ticks != ticks)
+                    {
+                        return true;
+                    }
+                }
+
+                return false;
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
+            {
+                return true;
+            }
+        }
+
+        internal static void RbForget(string indexPath)
+        {
+            try
+            {
+                File.Delete(indexPath + RbStampSuffix);
+                File.Delete(indexPath);
+                File.Delete(indexPath + ".tmp");
+                File.Delete(indexPath + RbListSuffix);
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException)
+            {
+            }
+        }
+
+        // Writes the index of romfsDir (stamp first: an interrupted write leaves a stamp without an index, never an index without a stamp) and
+        //   opens the image through it. null = not written (an overlay is present, whose lengths only the pack-time writer knows; a directory
+        //   of the tree is a link, or a name holds a line break, which the stamp and the list cannot hold; the tree changed meanwhile; the
+        //   folder cannot be written): the caller builds the image from the directory, as before. mark: the start mark of the walk (may be null)
+        internal static IStorage RbWriteAndOpen(string romfsDir, string indexPath, string overlayDir, Action<string> mark = null)
+        {
+            if (OverlayFiles(overlayDir) != null)
+            {
+                return null;
+            }
+
+            try
+            {
+                string root = RbRoot(romfsDir);
+                StringBuilder stamp = new();
+                stamp.Append(RbStampHead).Append('\n').Append(Directory.GetLastWriteTimeUtc(root).Ticks).Append('\n');   // the root's time, then the walk
+                List<string> dirs = new();
+                List<(string Rel, long Size)> files = new();
+
+                // The entries S2Arm's writer and the directory build enumerate (Directory.EnumerateFiles, all directories), with the directories
+                foreach (System.IO.FileSystemInfo entry in new System.IO.DirectoryInfo(root).EnumerateFileSystemInfos("*", SearchOption.AllDirectories))
+                {
+                    bool link = (entry.Attributes & System.IO.FileAttributes.ReparsePoint) != 0;
+                    string rel = Path.GetRelativePath(root, entry.FullName).Replace('\\', '/');
+
+                    if (link && entry is System.IO.DirectoryInfo)
+                    {
+                        throw new InvalidDataException("a directory of the RomFS tree is a link");
+                    }
+
+                    if (rel.IndexOfAny(RbLineBreaks) >= 0)
+                    {
+                        throw new InvalidDataException("a name of the RomFS tree holds a line break");
+                    }
+
+                    if (entry is System.IO.DirectoryInfo)
+                    {
+                        dirs.Add(rel + "\t" + entry.LastWriteTimeUtc.Ticks);   // read before the directory's own entries are (a change after it shows below)
+                    }
+                    else if (!IsHostJunk(entry.FullName))
+                    {
+                        long size;
+
+                        if (link)
+                        {
+                            // Measure the same target that IndexedStorage/LazyHostFile reads.
+                            using FileStream content = File.OpenRead(entry.FullName);
+                            size = content.Length;
+                        }
+                        else
+                        {
+                            size = ((System.IO.FileInfo)entry).Length;
+                        }
+
+                        files.Add((rel, size));
+                    }
+                }
+
+                dirs.Sort(StringComparer.Ordinal);
+
+                foreach (string dir in dirs)
+                {
+                    stamp.Append(dir).Append('\n');
+                }
+
+                File.WriteAllText(indexPath + RbStampSuffix, stamp.ToString(), new UTF8Encoding(false));
+
+                using (StreamWriter list = new(indexPath + RbListSuffix, false, new UTF8Encoding(false)))
+                {
+                    foreach ((string rel, long size) in files)
+                    {
+                        list.Write(size);
+                        list.Write('\t');
+                        list.Write(rel);
+                        list.Write('\n');
+                    }
+                }
+
+                mark?.Invoke($"RewindBox: RomFS tree walked ({files.Count} files, {dirs.Count} directories)");
+                Write(romfsDir, indexPath, indexPath + RbListSuffix);
+                File.Delete(indexPath + RbListSuffix);
+
+                if (RbStale(romfsDir, indexPath, out _))
+                {
+                    throw new IOException("the RomFS tree changed while its index was written");
+                }
+
+                return Open(romfsDir, indexPath, null);
+            }
+            catch (Exception e) when (e is IOException || e is UnauthorizedAccessException || e is InvalidDataException)
+            {
+                RbForget(indexPath);
+                Red.Note("RewindBox: RomFS index not written, the image is built from the directory at this start", e.GetType().Name + ": " + e.Message);
+                return null;
+            }
+        }
