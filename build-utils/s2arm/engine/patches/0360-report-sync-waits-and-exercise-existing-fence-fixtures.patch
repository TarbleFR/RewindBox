+    g_cb = [NSObject new]; g_q4 = (id)[RBWaitQueue new];
+    g_rb_queue_wait_mode = 1; g_rb_piece.held = 1;
+    RBWaitEvent *event = [RBWaitEvent new];
+    __weak RBWaitEvent *kept = event;
