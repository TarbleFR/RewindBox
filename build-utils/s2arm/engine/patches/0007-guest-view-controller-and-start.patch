+// ---------- RewindBox guest (runtime/src/rb_guest.h): the scene delegate's game path without UIApplicationMain / app / scene delegate ----------
+//   Another app loaded the engine (S2ArmEngine.framework) and owns UIKit, its windows and delegates. It presents the game view controller
+//   made here (what enterGame builds after a game is chosen) and calls s2a_rb_guest_start, which runs sceneDidBecomeActive → startHost on it.
+//   Nothing here is called in S2Arm.app.
+#include "rb_guest.h"
+int s2a_rb_guest_ready(void); int s2a_rb_guest_host_defer(void); void s2a_rb_guest_started(void); void s2a_rb_guest_terminating(int how);   // runtime/src
+__attribute__((visibility("default"), used)) UIViewController *s2a_rb_guest_make_view_controller(void) {
+    const char *no = !NSThread.isMainThread ? "not on the main thread" : !s2a_rb_guest_ready() ? "s2a_rb_guest_configure did not succeed"
+                   : g_rb_vc ? "already made (one game per process)" : NULL;
+    if (no) { LOG("【红】RewindBox guest: no view controller: %s", no); return nil; }
+    if (s2a_rb_guest_host_defer()) { LOG("【红】RewindBox guest: no view controller: the host start could not be registered"); return nil; }
+    atomic_store(&g_front_running, 1);   // the host owns UIKit: s2a_front_run (host_main.c, pack_apply.c) must never enter UIApplicationMain
+    s2a_boot_rebase("RewindBox: game view requested");   // like Play in the container library: boot time counts from here
+    LOG("RewindBox guest: %s", s2a_host_pre_ui_checks());
+    g_brightness = UIScreen.mainScreen.brightness;
+    CGSize z = UIScreen.mainScreen.bounds.size; double a = fmax(z.width, z.height), b = fmin(z.width, z.height);
+    if (b > 0) g_view_ratio = a / b;   // what the scene window gives in S2Arm (the widescreen load waits for it, screen_ratio)
+    S2AGameVC *vc = [S2AGameVC new]; vc.modalPresentationStyle = UIModalPresentationFullScreen;
+    vc.view.frame = CGRectMake(0, 0, a, b); vc.view.backgroundColor = UIColor.blackColor;   // landscape full screen, as it will be presented
+    g_root = vc.view; g_note_view = nil; g_rb_vc = vc;
+    { const char *e = getenv("S2A_PACK_APPLY_ONLY"); if (!g_msg && !(e && *e == '1')) s2a_loadpage_attach(vc.view); }
+    note_build();
+    if (g_help_args) help_build(g_help_args[0], g_help_args[1], g_help_args[2]);
+    dguard_show_pending();
+    LOG("RewindBox guest: game view controller ready (%.0fx%.0f points)", a, b);
+    return vc;
+}
+static int rb_start_host(char *error, size_t error_size) {   // startHost on the guest's controller (main thread); failures end the session
+    s2a_boot_entry entry = s2a_host_boot_take();
+    int input = entry ? s2a_ios_input_config_load() : 0, rc = 0;
+    const char *no = !entry ? "the host start was already taken" : input ? s2a_input_config_error_message(input) : NULL;
+    pthread_t th;
+    if (!no) {
+        s2a_log_session_start();
+        BOOT_MARK("RewindBox guest: start");
+        { uint64_t base, size; s2a_window_get(&base, &size);
+          LOG("RewindBox guest: window %#llx +%#llx reserved by s2a_rb_guest_configure (%s)", (unsigned long long)base, (unsigned long long)size, s2a_window_ok() ? "reserved" : "not reserved, left to the self-check page"); }
+        [[S2AAppDelegate new] startMonitoring];   // battery / lifecycle notifications / heartbeat / thermal; the method does not use its instance
+        prepare_game_view(g_rb_vc);
+        { void s2a_iml_probe_check(void); s2a_iml_probe_check(); }
+        // C# startup needs more than the 512 KB default pthread stack (as startHost)
+        pthread_attr_t at; rc = pthread_attr_init(&at);
+        if (!rc) { rc = pthread_attr_setstacksize(&at, 8 << 20); if (!rc) rc = pthread_create(&th, &at, deferred_host_thread, (void *)entry); pthread_attr_destroy(&at); }
+        if (rc) no = "the host thread could not be created";
+    }
+    if (no) {
+        if (error && error_size) snprintf(error, error_size, "%s (%d)", no, input ? input : rc);
+        LOG("【红】RewindBox guest: not started: %s (%d)", no, input ? input : rc);
+        s2a_rb_guest_ended(EXIT_FAILURE, no); return -1;
+    }
+    pthread_detach(th);
+    s2a_rb_guest_started();
+    LOG("RewindBox guest: host thread started");
+    return 0;
+}
+__attribute__((visibility("default"), used)) int s2a_rb_guest_start(char *error, size_t error_size) {
+    static int started;
+    if (error && error_size) error[0] = 0;
+    const char *no = !NSThread.isMainThread ? "not on the main thread" : !g_rb_vc ? "call s2a_rb_guest_make_view_controller first"
+                   : started ? "already started (one game per process)" : !g_rb_vc.view.window ? "the view controller is not in a window yet: present it first" : NULL;
+    if (no) { if (error && error_size) snprintf(error, error_size, "%s", no); LOG("【红】RewindBox guest: start refused: %s", no); return -1; }
+    started = 1;
+    // S2AAppDelegate applicationWillTerminate, through the notification (the app delegate is the host's); the shutdown returns to UIKit
+    [NSNotificationCenter.defaultCenter addObserverForName:UIApplicationWillTerminateNotification object:nil queue:nil usingBlock:^(NSNotification *n) { (void)n;
+        s2a_guest_run_mark(0); s2a_rb_guest_terminating(2);
+        if (s2a_host_boot_pending()) return;
+        s2a_controller_set_foreground(0); s2a_host_shutdown("iOS app terminating (RewindBox host)"); }];
+    if (s2a_ios_save_management_requested()) {   // as sceneDidBecomeActive: the save manager first (over the game view), then the host
+        UIViewController *m = s2a_ios_save_manager(^{ [g_rb_vc dismissViewControllerAnimated:NO completion:^{ rb_start_host(NULL, 0); }]; });
+        m.modalPresentationStyle = UIModalPresentationFullScreen;
+        [g_rb_vc presentViewController:m animated:NO completion:nil];
+        LOG("RewindBox guest: save management first; the host starts when it closes");
+        return 0;
+    }
+    return rb_start_host(error, error_size);
+}
