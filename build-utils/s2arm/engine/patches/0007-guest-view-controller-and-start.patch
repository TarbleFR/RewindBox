+// RewindBox guest (rb_guest.h, ios/app.m s2a_rb_guest_make_view_controller): main's iOS part without UIApplicationMain. The launch context,
+//   the window and the GC limit are already set by s2a_rb_guest_configure; this registers the same deferred host start, which the guest's
+//   s2a_rb_guest_start takes as the scene delegate's startHost does. 0 = registered
+int s2a_rb_guest_host_defer(void) {
+    static char *argv[] = {"S2Arm", NULL};
+    if (!s2a_launch_ctx_get()) { LOG("【红】RewindBox guest: launch context not available: %s", s2a_launch_ctx_error()); return -1; }
+    g_boot_argc = 1; g_boot_argv = argv;
+    return s2a_host_boot_defer(prewarmed_host_run, 1) == 1 ? 0 : -1;
+}
