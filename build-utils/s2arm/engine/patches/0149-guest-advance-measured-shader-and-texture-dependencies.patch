diff --git a/graphics/nvn/gfx/nvn/rb_texture_ahead.inc b/graphics/nvn/gfx/nvn/rb_texture_ahead.inc
index 18710df..722cbf2 100644
--- a/graphics/nvn/gfx/nvn/rb_texture_ahead.inc
+++ b/graphics/nvn/gfx/nvn/rb_texture_ahead.inc
@@ -13,7 +13,95 @@ static struct {
     unsigned in_frame;
 } g_tx_ahead = {.lock = PTHREAD_MUTEX_INITIALIZER};

+// Texture registration can precede the actual draw by thousands of frames.
+// Refresh clean host file pages near a recorded bind. A guest-editable bind
+// can also give a page hint, but only replay can decide what to upload.
+enum { RB_TX_PAGE_HINTS = 32, RB_TX_PAGE_ITEM = 1024 * 1024, RB_TX_PAGE_FRAME = 8 * RB_TX_PAGE_ITEM };
+static dispatch_queue_t g_tx_page_queue;
+static struct {
+    pthread_mutex_t lock;
+    unsigned pending, posted;
+    uint64_t post_frame, work_frame, work_bytes, pages, refreshed;
+    int enough_room;
+    _Atomic uint64_t recent[2048];
+} g_tx_page = {.lock = PTHREAD_MUTEX_INITIALIZER};
+
+static void rb_tx_page_run(uint32_t id_, uint64_t serial, uint64_t posted_frame) {
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    if (frame - posted_frame > 2 || dm_gfx_session_stopping() || rb_mem_low() ||
+        nvn_be_stopping() || atomic_load(&g_fu_waiting)) return;
+    if (frame != g_tx_page.work_frame) {
+        g_tx_page.work_frame = frame;
+        g_tx_page.work_bytes = 0;
+#if TARGET_OS_IPHONE
+        g_tx_page.enough_room = os_proc_available_memory() >= (UINT64_C(2) << 30);
+#else
+        g_tx_page.enough_room = 1;
+#endif
+    }
+    if (!g_tx_page.enough_room || g_tx_page.work_bytes >= RB_TX_PAGE_FRAME) return;
+    int lease = 0;
+    if (!rb_spec_take(0, &lease)) return;
+    const void *mem = NULL;
+    uint64_t bytes = 0;
+    if (!pthread_mutex_trylock(&g_rmu)) {
+        if (id_ < (unsigned)g_ntreg) {
+            const treg_t *r = &g_treg[id_];
+            const tex_t *t = &r->t;
+            if (r->ok && !r->gone && t->serial == serial && t->has_layout && t->mem &&
+                !t->d.flags && t->L.size && t->L.size <= RB_TX_PAGE_ITEM && !pthread_mutex_trylock(&g_smu)) {
+                if (nvn_hm_get(&g_tex_live, &serial) && !nvn_hm_get(&g_by_serial, &serial)) {
+                    mem = t->mem;
+                    bytes = t->L.size;
+                }
+                pthread_mutex_unlock(&g_smu);
+            }
+        }
+        pthread_mutex_unlock(&g_rmu);
+    }
+    if (mem && bytes <= RB_TX_PAGE_FRAME - g_tx_page.work_bytes) {
+        g_tx_page.work_bytes += bytes;
+        uint64_t pages = rb_wn(mem, bytes);
+        if (pages != RB_WN_NONE && pages) {
+            g_tx_page.pages += pages;
+            uint64_t n = ++g_tx_page.refreshed;
+            if (!(n & (n - 1))) MLOG("RewindBox texture bind page hints frame=%llu textures=%llu absent_host_pages=%llu",
+                 (unsigned long long)frame, (unsigned long long)n, (unsigned long long)g_tx_page.pages);
+        }
+    }
+    rb_spec_done(&lease);
+}
+
+void nvn_be_record_texture_pages(uint32_t id_) {
+    if (id_ >= (1u << 20) || !rb_course_exact() || !rb_park_compat() || !rb_pf_on() || !rb_wn_on() ||
+        dm_gfx_session_stopping() || nvn_be_stopping() || atomic_load(&g_fu_waiting)) return;
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    if (!frame) return;
+    uint64_t serial = atomic_load_explicit(&g_tser[id_], memory_order_acquire);
+    _Atomic uint64_t *recent = &g_tx_page.recent[id_ % 2048];
+    if (!serial || atomic_load_explicit(recent, memory_order_relaxed) == serial ||
+        pthread_mutex_trylock(&g_tx_page.lock)) return;
+    if (frame != g_tx_page.post_frame) { g_tx_page.post_frame = frame; g_tx_page.posted = 0; }
+    if (g_tx_page.pending < RB_TX_PAGE_HINTS && g_tx_page.posted < RB_TX_PAGE_HINTS &&
+        atomic_load_explicit(recent, memory_order_relaxed) != serial) {
+        static dispatch_once_t once;
+        dispatch_once(&once, ^{ g_tx_page_queue = dispatch_queue_create("rb.texture.bind.pages",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_DEFAULT, 0)); });
+        atomic_store_explicit(recent, serial, memory_order_relaxed);
+        ++g_tx_page.pending;
+        ++g_tx_page.posted;
+        dispatch_async(g_tx_page_queue, ^{ @autoreleasepool {
+            rb_tx_page_run(id_, serial, frame);
+            pthread_mutex_lock(&g_tx_page.lock);
+            --g_tx_page.pending;
+            pthread_mutex_unlock(&g_tx_page.lock);
+        } });
+    }
+    pthread_mutex_unlock(&g_tx_page.lock);
+}
+
 void nvn_be_record_texture_hint(uint32_t id_) {
+    nvn_be_record_texture_pages(id_);
     if (id_ >= (1u << 20)) return;
     uint64_t serial = atomic_load_explicit(&g_tser[id_], memory_order_relaxed);
     _Atomic uint64_t *recent = &g_tx_ahead.recent[id_ % 2048];
@@ -90,6 +178,12 @@ void nvn_be_advance_texture(void) {
 }

 static void rb_tx_reset(void) {
+    // The page queue has already drained with the other window readers.
+    g_tx_page.post_frame = g_tx_page.work_frame = g_tx_page.work_bytes = 0;
+    g_tx_page.pending = g_tx_page.posted = 0;
+    g_tx_page.pages = g_tx_page.refreshed = 0;
+    g_tx_page.enough_room = 0;
+    for (unsigned i = 0; i < 2048; ++i) atomic_store(&g_tx_page.recent[i], 0);
     pthread_mutex_lock(&g_tx_ahead.lock);
     g_tx_ahead.head = g_tx_ahead.count = g_tx_ahead.in_frame = 0;
     g_tx_ahead.bytes = g_tx_ahead.made = g_tx_ahead.frame = 0;
