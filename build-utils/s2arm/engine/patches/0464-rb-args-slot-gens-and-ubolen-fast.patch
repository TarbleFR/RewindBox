 }
+
+// RewindBox (patch 0464): per-stage monotonic slot generation clocks.
+// Each stage maintains a monotonic sequence number plus per-slot timestamps and
+// category watermarks; each shader captures only {seq, other_gen} (16 bytes).
+// Survives A->B->A program alternation and cross-pass boundaries without single-owner
+// eviction, enables skipping unchanged CBUF slots (including texture-less vertex
+// shaders), and tracks UBO size/presence changes for O(1) unclamped UBOLEN reuse.
+#define RB_ARGS_HAS_SLOT_GENS 1
+
+typedef struct {
+    uint64_t seq;
+    uint64_t other_gen;
+    uint64_t ubo_any;
+    uint64_t ssbo_any;
+    uint64_t tex_any;
+    uint64_t samp_any;
+    uint64_t ubo_size_gen;
+    uint64_t ubo[16];
+    uint64_t ssbo[16];
+    uint64_t tex[256];
+    uint64_t samp[128];
+} rb_args_stage_gens;
+
+typedef struct {
+    uint64_t seq;
+    uint64_t other_gen;
+} rb_args_slot_snap;
+
+typedef struct {
+    uint16_t ubo_dirty;
+    uint16_t ssbo_dirty;
+    uint8_t unchanged;
+    uint8_t partial_ok;
+    uint8_t tex_unchanged;
+    uint8_t samp_unchanged;
+} rb_args_diff;
+_Static_assert(sizeof(rb_args_diff) == 8, "rb_args_diff fits in a single 64-bit register");
+
+static inline void rb_args_stage_bump_other(rb_args_stage_gens *g) {
+    uint64_t s = ++g->seq;
+    g->other_gen = s;
+    g->ubo_size_gen++;
+}
+static inline void rb_args_stage_bump_all_other(rb_args_stage_gens g[6]) {
+    for (int st = 0; st < 6; st++) rb_args_stage_bump_other(&g[st]);
+}
+static inline void rb_args_stage_bump_ubo(rb_args_stage_gens *g, unsigned idx) {
+    if (idx < 16u) {
+        uint64_t s = ++g->seq;
+        g->ubo[idx] = s;
+        g->ubo_any = s;
+    } else {
+        rb_args_stage_bump_other(g);
+    }
+}
+static inline void rb_args_stage_bump_ssbo(rb_args_stage_gens *g, unsigned idx) {
+    if (idx < 16u) {
+        uint64_t s = ++g->seq;
+        g->ssbo[idx] = s;
+        g->ssbo_any = s;
+    } else {
+        rb_args_stage_bump_other(g);
+    }
+}
+static inline void rb_args_stage_bump_tex(rb_args_stage_gens *g, unsigned idx) {
+    if (idx < 256u) {
+        uint64_t s = ++g->seq;
+        g->tex[idx] = s;
+        g->tex_any = s;
+    } else {
+        rb_args_stage_bump_other(g);
+    }
+}
+static inline void rb_args_stage_bump_tex_range(rb_args_stage_gens *g, int first, int n) {
+    if (first < 0 || n < 0 || first + n > 256) {
+        rb_args_stage_bump_other(g);
+        return;
+    }
+    if (!n) return;
+    uint64_t s = ++g->seq;
+    g->tex_any = s;
+    for (int k = 0; k < n; k++) g->tex[(unsigned)(first + k)] = s;
+}
+static inline void rb_args_stage_bump_samp_range(rb_args_stage_gens *g, int first, int n) {
+    if (first < 0 || n < 0 || first + n > 128) {
+        rb_args_stage_bump_other(g);
+        return;
+    }
+    if (!n) return;
+    uint64_t s = ++g->seq;
+    g->samp_any = s;
+    for (int k = 0; k < n; k++) g->samp[(unsigned)(first + k)] = s;
+}
+static inline void rb_args_stage_capture(rb_args_slot_snap *snap, const rb_args_stage_gens *g) {
+    snap->seq = g->seq;
+    snap->other_gen = g->other_gen;
+}
+static inline rb_args_diff rb_args_stage_diff(const rb_args_stage_gens *g,
+                                              const rb_args_slot_snap *snap,
+                                              const rb_args_masks *sh) {
+    if (__builtin_expect(!sh || !sh->built || !snap->other_gen || snap->other_gen != g->other_gen || g->seq < snap->seq, 0))
+        return (rb_args_diff){.ubo_dirty = 0xffffu, .ssbo_dirty = 0xffffu};
+    const uint64_t seq = snap->seq;
+    if (g->seq == seq)
+        return (rb_args_diff){.unchanged = 1, .partial_ok = 1, .tex_unchanged = 1, .samp_unchanged = 1};
+    uint16_t ubo_d = 0, ssbo_d = 0;
+    if (g->ubo_any > seq && sh->ubo) {
+        for (uint32_t m = sh->ubo; m; m &= m - 1) {
+            unsigned r = (unsigned)__builtin_ctz(m);
+            if (g->ubo[r] > seq) ubo_d |= (uint16_t)(1u << r);
+        }
+    }
+    if (g->ssbo_any > seq && sh->ssbo) {
+        for (uint32_t m = sh->ssbo; m; m &= m - 1) {
+            unsigned r = (unsigned)__builtin_ctz(m);
+            if (g->ssbo[r] > seq) ssbo_d |= (uint16_t)(1u << r);
+        }
+    }
+    int tex_hit = 0;
+    if (g->tex_any > seq) {
+        if (sh->dyn_tex) {
+            tex_hit = 1;
+        } else {
+            for (int w = 0; w < 4 && !tex_hit; w++) {
+                for (uint64_t m = sh->tex[w]; m; m &= m - 1) {
+                    unsigned b = (unsigned)__builtin_ctzll(m);
+                    if (g->tex[(unsigned)w * 64u + b] > seq) { tex_hit = 1; break; }
+                }
+            }
+        }
+    }
+    int samp_hit = 0;
+    if (g->samp_any > seq) {
+        if (sh->dyn_samp) {
+            samp_hit = 1;
+        } else {
+            for (int w = 0; w < 2 && !samp_hit; w++) {
+                for (uint64_t m = sh->samp[w]; m; m &= m - 1) {
+                    unsigned b = (unsigned)__builtin_ctzll(m);
+                    if (g->samp[(unsigned)w * 64u + b] > seq) { samp_hit = 1; break; }
+                }
+            }
+        }
+    }
+    return (rb_args_diff){
+        .ubo_dirty = ubo_d,
+        .ssbo_dirty = ssbo_d,
+        .unchanged = (uint8_t)(!ubo_d && !ssbo_d && !tex_hit && !samp_hit),
+        .partial_ok = 1,
+        .tex_unchanged = (uint8_t)!tex_hit,
+        .samp_unchanged = (uint8_t)!samp_hit,
+    };
+}
+static inline int rb_args_kept_diff(unsigned kind, unsigned f1d, unsigned dtt, unsigned reg,
+                                    const rb_args_diff *diff, const rb_args_stage_gens *g,
+                                    const rb_args_slot_snap *snap) {
+    if (!rb_args_kept(kind, f1d, dtt)) return 0;
+    if (!diff || !diff->partial_ok) return 0;
+    if (kind == RB_AK_TEX || kind == RB_AK_SAMPT) {
+        if (diff->tex_unchanged) return 1;
+        return reg < 256u && g->tex[reg] <= snap->seq;
+    }
+    if (kind == RB_AK_SAMP) {
+        if (diff->samp_unchanged) return 1;
+        return reg < 128u && g->samp[reg] <= snap->seq;
+    }
+    return 1; // RB_AK_SAMPI: OP_BIND_IMG bumps other_gen so partial_ok == 0
+}
