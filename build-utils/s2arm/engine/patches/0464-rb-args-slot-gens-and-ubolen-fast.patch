diff --git a/graphics/nvn/gfx/nvn/rb_args_ubo.h b/graphics/nvn/gfx/nvn/rb_args_ubo.h
index 54a59e408..bde695679 100644
--- a/graphics/nvn/gfx/nvn/rb_args_ubo.h
+++ b/graphics/nvn/gfx/nvn/rb_args_ubo.h
@@ -267,3 +267,171 @@ static inline int rb_args_needs_rmu_lock(const rb_args_masks *m, int is_partial,
