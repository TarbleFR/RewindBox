+        full={{OP_CLEAR_COLOR,8+sizeof(p_clear_color)},{.mask=15,.rgba={0.125,0,0,1}}};
+    op_hdr end={OP_END,8};
+    _Alignas(8) unsigned char first[2*sizeof bind+sizeof partial+sizeof full+sizeof end];
+    _Alignas(8) unsigned char second[sizeof full+sizeof end];
