+    memcpy(w,&bind,sizeof bind); w+=sizeof bind; memcpy(w,&partial,sizeof partial); w+=sizeof partial;
+    memcpy(w,&bind,sizeof bind); w+=sizeof bind;
+    if (split) { memcpy(w,&end,sizeof end); w=second; }
+    memcpy(w,&full,sizeof full); w+=sizeof full; memcpy(w,&end,sizeof end);
+    uint64_t handles[]={(uintptr_t)first,(uintptr_t)second};
+    static queue_t queue;
+    if (exposed) nvn_be_reg_tex(7,&targets[0],NULL);
+    CHECK(rb_store_unexposed(&targets[0])==!exposed || !enabled);
+    uint64_t adjacent=atomic_load(&g_rb_adjacent_stores), sealed=atomic_load(&g_rb_live_stores);
+    nvn_be_submit(&queue,handles,split ? 2 : 1);
+    CHECK(nvn_be_wait(nvn_be_last_fence(),10000000000ull) && !mtl_last_commit_error());
+    CHECK(atomic_load(&g_rb_adjacent_stores)-adjacent==(unsigned)(enabled && !exposed && !split));
+    CHECK(atomic_load(&g_rb_live_stores)-sealed==(unsigned)(enabled && !exposed && split));
