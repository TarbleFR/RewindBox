diff --git a/graphics/nvn/gfx/nvn/rb_nvn2_tiles.h b/graphics/nvn/gfx/nvn/rb_nvn2_tiles.h
new file mode 100644
index 0000000..7257e31
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_nvn2_tiles.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <string.h>
+#include <strings.h>
+
+enum {
+    RB_TILE_STORE = 1u << 0, RB_TILE_LIVE = 1u << 1, RB_TILE_PRODUCER = 1u << 2,
+    RB_TILE_BATCH = 1u << 3, RB_TILE_STATS = 1u << 4, RB_TILE_READY = 1u << 5
+};
+
+// Only a hosted, identified NVN2 session running the direct Metal 4 queue.
+// The previous target retains its independent 810/811 controls.
+static inline unsigned rb_nvn2_tile_policy(int metal4, int nvn2, const char *title,
+                                           const char *master, const char *const controls[5]) {
+    if (!metal4 || !nvn2 || !title || strlen(title) != 16 ||
+        strspn(title, "0123456789abcdefABCDEF") != 16 || !strcasecmp(title, "04007EF01F8AE000") ||
+        (master && strcmp(master, "1"))) return 0;
+    unsigned flags = 0;
+    for (unsigned i = 0; i < 5; i++) {
+        unsigned bit = 1u << i;
+        if (controls[i] ? !strcmp(controls[i], "1") : bit != RB_TILE_STATS) flags |= bit;
+    }
+    return flags;
+}
