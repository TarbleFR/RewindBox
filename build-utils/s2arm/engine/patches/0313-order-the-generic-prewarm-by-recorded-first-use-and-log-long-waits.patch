+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0313): host-only checks of the generic prewarm list's order by recorded first use (gfx/nvn/rb_warm_order.h).
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../gfx/nvn/rb_warm_order.h"
+
+static rb_warm_slot row(int kind, int recorded, uint64_t frame, uint64_t wait) { return (rb_warm_slot){kind, recorded, frame, wait}; }
+static void order(const rb_warm_slot *s, unsigned n, unsigned *out) {
+    unsigned *tmp = malloc((n ? n : 1) * sizeof *tmp);
+    assert(tmp);
+    rb_warm_first_use_order(s, n, out, tmp);
+    free(tmp);
+}
+static void expect(const rb_warm_slot *s, unsigned n, const unsigned *want) {
+    unsigned got[64];
+    assert(n <= 64);
+    order(s, n, got);
+    for (unsigned i = 0; i < n; i++) {
+        if (got[i] != want[i]) { fprintf(stderr, "position %u: row %u, expected row %u\n", i, got[i], want[i]); assert(0); }
+    }
+}
+static uint64_t seed = 0x9e3779b97f4a7c15ull;
+static uint64_t next(void) { seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17; return seed; }
+
