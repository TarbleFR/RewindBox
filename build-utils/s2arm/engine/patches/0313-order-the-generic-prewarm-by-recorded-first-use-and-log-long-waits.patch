diff --git a/graphics/nvn/gfx/nvn/rb_warm_order.h b/graphics/nvn/gfx/nvn/rb_warm_order.h
new file mode 100644
index 0000000..e94d833
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_warm_order.h
@@ -0,0 +1,39 @@
+// RewindBox (patch 0313): the order of the generic prewarm list in a session with a draw history (nvn_mtl.m warm_parse_list). Pure C: tests/t_rb_warm_order.c.
+//   IPA 824 (Mario Kart World): the history's rows came after pso_user.tsv's rows, in hash order, and the rows that had waited before, past the first 64, came last of all,
+//   so 248 recorded pipelines first drawn in frames 300-600 were not built in time (0.94 s of waits). Now:
+//   1. compute and mesh rows, in list order (the history has no compute rows);
+//   2. the rows the history recorded, by the frame of their first draw (the earlier of its two records), then by their longest recorded wait;
+//   3. every other row, in list order.
+//   The sort is stable: rows that tie keep the list's order.
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+enum { RB_WARM_ROW_LIBRARY = 0, RB_WARM_ROW_RENDER = 1, RB_WARM_ROW_COMPUTE = 2, RB_WARM_ROW_MESH = 4 };
+typedef struct { int kind, recorded; uint64_t frame, wait; } rb_warm_slot;
+static inline int rb_warm_group(const rb_warm_slot *s) {
+    if (s->kind == RB_WARM_ROW_COMPUTE || s->kind == RB_WARM_ROW_MESH) return 0;
+    return s->recorded ? 1 : 2;
+}
+static inline int rb_warm_before(const rb_warm_slot *s, unsigned a, unsigned b) {   // a strictly before b (ties keep the list order)
+    int ga = rb_warm_group(&s[a]), gb = rb_warm_group(&s[b]);
+    if (ga != gb) return ga < gb;
+    if (ga != 1) return 0;
+    if (s[a].frame != s[b].frame) return s[a].frame < s[b].frame;
+    return s[a].wait > s[b].wait;
+}
+// out[i] = the index of the row placed i-th; tmp: n entries of scratch. Bottom-up merge sort: O(n log n), stable
+static inline void rb_warm_first_use_order(const rb_warm_slot *s, unsigned n, unsigned *out, unsigned *tmp) {
+    for (unsigned i = 0; i < n; i++) out[i] = i;
+    unsigned *src = out, *dst = tmp;
+    for (unsigned w = 1; w < n; w *= 2) {
+        for (unsigned lo = 0; lo < n; lo += 2 * w) {
+            unsigned mid = lo + w < n ? lo + w : n, hi = lo + 2 * w < n ? lo + 2 * w : n, i = lo, j = mid, k = lo;
+            while (i < mid && j < hi) dst[k++] = rb_warm_before(s, src[j], src[i]) ? src[j++] : src[i++];
+            while (i < mid) dst[k++] = src[i++];
+            while (j < hi) dst[k++] = src[j++];
+        }
+        unsigned *t = src; src = dst; dst = t;
+    }
+    if (src != out) memcpy(out, src, (size_t)n * sizeof *out);
+}
