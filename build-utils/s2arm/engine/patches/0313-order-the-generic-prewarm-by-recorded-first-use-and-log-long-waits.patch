+        row(RB_WARM_ROW_RENDER, 0, 0, 0),         // 1 pso_user render row the history does not hold
+        row(RB_WARM_ROW_COMPUTE, 0, 0, 0),        // 2 pso_user compute
+        row(RB_WARM_ROW_RENDER, 1, 900, 0),       // 3 history, first drawn at frame 900
+        row(RB_WARM_ROW_RENDER, 1, 10, 0),        // 4 frame 10
+        row(RB_WARM_ROW_RENDER, 1, 400, 0),       // 5 frame 400
+        row(RB_WARM_ROW_MESH, 1, 5, 0),           // 6 mesh row: kept with compute, ahead
+        row(RB_WARM_ROW_RENDER, 1, 400, 7000000), // 7 frame 400, waited 7 ms before: ahead of row 5
+        row(RB_WARM_ROW_LIBRARY, 0, 0, 0),        // 8 another library
+    };
+    const unsigned wa[] = {2, 6, 4, 7, 5, 3, 0, 1, 8};
+    expect(a, 9, wa);
+
+    // ② ties keep the list's order (stable), in every group
+    const rb_warm_slot b[] = {
+        row(RB_WARM_ROW_RENDER, 1, 50, 0), row(RB_WARM_ROW_LIBRARY, 0, 0, 0), row(RB_WARM_ROW_RENDER, 1, 50, 0),
+        row(RB_WARM_ROW_COMPUTE, 0, 0, 0), row(RB_WARM_ROW_LIBRARY, 0, 0, 0), row(RB_WARM_ROW_RENDER, 1, 50, 0), row(RB_WARM_ROW_COMPUTE, 0, 0, 0),
+    };
+    const unsigned wb[] = {3, 6, 0, 2, 5, 1, 4};
+    expect(b, 7, wb);
+
+    // ③ nothing recorded: the list's order with compute and mesh rows first
+    const rb_warm_slot c[] = { row(RB_WARM_ROW_LIBRARY, 0, 0, 0), row(RB_WARM_ROW_RENDER, 0, 0, 0), row(RB_WARM_ROW_MESH, 0, 0, 0) };
+    const unsigned wc[] = {2, 0, 1};
+    expect(c, 3, wc);
+
+    // ④ empty and single lists
+    unsigned one[1];
+    order(c, 0, one);
+    order(c, 1, one); assert(one[0] == 0);
+
+    // ⑤ 9,018 rows (IPA 824's hot list): a permutation, in group order, recorded rows by frame then by wait, ties in list order
+    enum { N = 9018 };
+    rb_warm_slot *s = malloc(N * sizeof *s); unsigned *o = malloc(N * sizeof *o), *seen = calloc(N, sizeof *seen);
+    assert(s && o && seen);
+    for (unsigned i = 0; i < N; i++) {
+        unsigned r = (unsigned)(next() % 10);
+        int kind = r < 3 ? RB_WARM_ROW_LIBRARY : r < 9 ? RB_WARM_ROW_RENDER : (next() & 1) ? RB_WARM_ROW_COMPUTE : RB_WARM_ROW_MESH;
+        s[i] = row(kind, kind == RB_WARM_ROW_RENDER && (next() % 4) != 0, next() % 1200, (next() % 3) ? 0 : next() % 50000000);
+    }
+    order(s, N, o);
+    for (unsigned i = 0; i < N; i++) { assert(o[i] < N && !seen[o[i]]); seen[o[i]] = 1; }
+    for (unsigned i = 1; i < N; i++) {
+        const rb_warm_slot *p = &s[o[i - 1]], *q = &s[o[i]];
+        int gp = rb_warm_group(p), gq = rb_warm_group(q);
+        assert(gp <= gq);
+        if (gp != gq) continue;
+        if (gp == 1 && (p->frame != q->frame || p->wait != q->wait)) {
+            assert(p->frame < q->frame || (p->frame == q->frame && p->wait > q->wait));
+            continue;
+        }
+        assert(o[i - 1] < o[i]);   // same group and same key: list order
+    }
+    puts("t_rb_warm_order: ok");
+    free(s); free(o); free(seen);
+    return 0;
+}
