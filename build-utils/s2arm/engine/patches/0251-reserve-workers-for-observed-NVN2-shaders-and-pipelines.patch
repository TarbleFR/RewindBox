diff --git a/graphics/nvn/tests/rb_observed_fixture.inc b/graphics/nvn/tests/rb_observed_fixture.inc
new file mode 100644
index 0000000000000000000000000000000000000000..6bd52e6ad673b7939700cff7302e582d8a281827
--- /dev/null
+++ b/graphics/nvn/tests/rb_observed_fixture.inc
@@ -0,0 +1,86 @@
+// Exercises the production two-lane queue and real DSH admission/translation.
+// The compiler stub can park precisely at the existing serialized compiler lock.
+#include <assert.h>
+static dispatch_time_t fixture_deadline(void) {
+    return dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC);
+}
+static void fixture_wait(dispatch_semaphore_t sem) {
+    assert(dispatch_semaphore_wait(sem, fixture_deadline()) == 0);
+}
+static void fixture_hold_lanes(dispatch_semaphore_t entered, dispatch_semaphore_t release) {
+    for (unsigned i=0; i<RB_OBSERVED_LANES; i++) {
+        assert(rb_observed_enqueue(^{
+            dispatch_semaphore_signal(entered);
+            fixture_wait(release);
+        }));
+    }
+    for (unsigned i=0; i<RB_OBSERVED_LANES; i++) fixture_wait(entered);
+}
+static void fixture_release_lanes(dispatch_semaphore_t release) {
+    for (unsigned i=0; i<RB_OBSERVED_LANES; i++) dispatch_semaphore_signal(release);
+}
+static void fixture_hash(char hex[17],const uint8_t *control,const uint8_t *bytes) {
+    uint8_t md[8]; nvn2_key(control,bytes,md);
+    for (int i=0; i<8; i++) snprintf(hex+2*i,3,"%02x",md[i]);
+}
+static int fixture_observed(void) {
+    char dir[]="/tmp/rb-observed-XXXXXX", name[17];
+    assert(mkdtemp(dir));
+    setenv("DM_MSL_FALLBACK",dir,1);
+    nvn2=1; write_out=1; fixture_workers=1;
+    uint8_t control[0xd8]={0}, bytes[256]={2};
+    uint32_t magic=NVN2_CTL_MAGIC, version=NVN2_CTL_VERSION, length=sizeof bytes;
+    memcpy(control,&magic,4); memcpy(control+4,&version,4); memcpy(control+0x44,&length,4);
+    fixture_hash(name,control,bytes);
+    dispatch_semaphore_t entered=dispatch_semaphore_create(0), release=dispatch_semaphore_create(0);
+
+    // Fair refuses a bind guess. Its permanent seen marker must not poison demand.
+    assert(dm_shader_bound(name,(uintptr_t)bytes,control)==1);
+    while (atomic_load(&g_dsh_bg_q)) usleep(1000);
+    assert(fixture_gate_calls==1 && compiler_calls==0);
+
+    fixture_hold_lanes(entered,release);
+    for (unsigned i=RB_OBSERVED_LANES; i<RB_OBSERVED_LIMIT; i++)
+        assert(rb_observed_enqueue(^{}));
+    assert(dsh_ahead_(name,(uintptr_t)bytes,control,0)==0);
+    assert(dsh_observed_bytes==0 && fixture_pool.full==1);
+    rb_observed_stop(&fixture_pool);
+    assert(!rb_observed_enqueue(^{}));
+    assert(!rb_observed_drain(&fixture_pool,DISPATCH_TIME_NOW));
+    fixture_release_lanes(release);
+    assert(rb_observed_drain(&fixture_pool,fixture_deadline()));
+    assert(fixture_pool.outstanding[0]+fixture_pool.outstanding[1]==0);
+    assert(fixture_pool.peak==RB_OBSERVED_LIMIT);
+    rb_observed_begin(&fixture_pool);
+
+    // Same CB key after saturation: exactly one owned copy and one translation.
+    fixture_hold_lanes(entered,release);
+    for (unsigned i=0;i<8;i++) assert(dsh_ahead_(name,(uintptr_t)bytes,control,0)==1);
+    assert(fixture_pool.accepted==3 && dsh_observed_bytes==sizeof control+sizeof bytes);
+    bytes[0]^=1; // Destroy guest input before the worker can access it.
+    fixture_release_lanes(release);
+    assert(rb_observed_drain(&fixture_pool,fixture_deadline()));
+    assert(compiler_calls==1 && g_dsh_ahead_ok==1 && fixture_stage_loads==1);
+    assert(dsh_observed_bytes==0);
+
+    // Optional work already inside the compiler when Fair arrives. An actual CB
+    // reference must join the resulting translation and still load the library.
+    fixture_hash(name,control,bytes);
+    fixture_comp_entered=dispatch_semaphore_create(0);
+    fixture_comp_release=dispatch_semaphore_create(0);
+    atomic_store(&fixture_allow_guess,1);
+    assert(dm_shader_bound(name,(uintptr_t)bytes,control)==1);
+    fixture_wait(fixture_comp_entered);
+    atomic_store(&fixture_allow_guess,0);
+    assert(dsh_ahead_(name,(uintptr_t)bytes,control,0)==1);
+    dispatch_semaphore_signal(fixture_comp_release);
+    assert(rb_observed_drain(&fixture_pool,fixture_deadline()));
+    assert(compiler_calls==2 && overlap==0 && fixture_stage_loads==2);
+    assert(dsh_observed_bytes==0 && g_dsh_ahead_dup>=1);
+    rb_observed_stop(&fixture_pool);
+    assert(rb_observed_drain(&fixture_pool,fixture_deadline()));
+    NSError *error=nil;
+    assert([[NSFileManager defaultManager] removeItemAtPath:@(dir) error:&error]);
+    puts("PASS two concurrent lanes, Fair demand after cancelled/in-flight speculation, dedup, memory bound, retry, teardown");
+    return 0;
+}
