diff --git a/graphics/nvn/gfx/nvn/rb_observed_pool.h b/graphics/nvn/gfx/nvn/rb_observed_pool.h
new file mode 100644
index 0000000000000000000000000000000000000000..caf153b5f5a6301f137e8510b4f3b509743b5b47
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_observed_pool.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <dispatch/dispatch.h>
+#include <Block.h>
+#include <pthread.h>
+#include <stdint.h>
+
+// Keep a place for new scene work even if all speculative workers are parked.
+// Each serial queue has one active compiler and a bounded backlog.
+enum { RB_OBSERVED_LANES = 2, RB_OBSERVED_LIMIT = 32 };
+typedef struct {
+    pthread_mutex_t mu;
+    dispatch_queue_t queue[RB_OBSERVED_LANES];
+    unsigned outstanding[RB_OBSERVED_LANES], peak, next;
+    uint64_t accepted, full;
+    int stopped;
+} rb_observed_pool;
+#define RB_OBSERVED_POOL_INIT { .mu = PTHREAD_MUTEX_INITIALIZER }
+
+static inline int rb_observed_submit(rb_observed_pool *pool, dispatch_block_t job) {
+    pthread_mutex_lock(&pool->mu);
+    unsigned outstanding = pool->outstanding[0]+pool->outstanding[1];
+    if (pool->stopped || outstanding >= RB_OBSERVED_LIMIT) {
+        if (!pool->stopped) pool->full++;
+        pthread_mutex_unlock(&pool->mu);
+        return 0;
+    }
+    unsigned lane = pool->next;
+    if (pool->outstanding[lane] > pool->outstanding[1-lane]) lane=1-lane;
+    pool->next=1-lane;
+    if (!pool->queue[lane])
+        pool->queue[lane]=dispatch_queue_create("s2arm.nvn2.observed",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,QOS_CLASS_USER_INITIATED,0));
+    pool->outstanding[lane]++; pool->accepted++;
+    if (++outstanding > pool->peak) pool->peak=outstanding;
+    dispatch_block_t rated=dispatch_block_create_with_qos_class(
+        DISPATCH_BLOCK_ENFORCE_QOS_CLASS,QOS_CLASS_USER_INITIATED,0,^{
+            @autoreleasepool { job(); }
+            pthread_mutex_lock(&pool->mu);
+            pool->outstanding[lane]--;
+            pthread_mutex_unlock(&pool->mu);
+        });
+    dispatch_async(pool->queue[lane],rated);
+#if !__has_feature(objc_arc)
+    Block_release(rated);
+#endif
+    pthread_mutex_unlock(&pool->mu);
+    return 1;
+}
+static inline void rb_observed_stop(rb_observed_pool *pool) {
+    pthread_mutex_lock(&pool->mu); pool->stopped=1; pthread_mutex_unlock(&pool->mu);
+}
+static inline int rb_observed_drain(rb_observed_pool *pool,dispatch_time_t deadline) {
+    dispatch_group_t done=dispatch_group_create();
+    pthread_mutex_lock(&pool->mu);
+    for (unsigned lane=0;lane<RB_OBSERVED_LANES;lane++)
+        if (pool->queue[lane]) dispatch_group_async(done,pool->queue[lane],^{});
+    pthread_mutex_unlock(&pool->mu);
+    int completed=!dispatch_group_wait(done,deadline);
+#if !__has_feature(objc_arc)
+    dispatch_release(done);
+#endif
+    return completed;
+}
+static inline void rb_observed_begin(rb_observed_pool *pool) {
+    pthread_mutex_lock(&pool->mu);
+    pool->stopped=0; pool->accepted=pool->full=0; pool->peak=0;
+    pthread_mutex_unlock(&pool->mu);
+}
