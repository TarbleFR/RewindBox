+            pthread_mutex_unlock(&dsh_observed_mu); return 1;
+        }
+        if (!dsh_observed[i].bytes && slot<0) slot=(int)i;
+    }
+    if (slot<0 || !bytes || bytes>(8u<<20)-dsh_observed_bytes) {
+        pthread_mutex_unlock(&dsh_observed_mu); return 0;
+    }
+    dsh_observed[slot].bytes=bytes; memcpy(dsh_observed[slot].key,hash,8); dsh_observed_bytes+=bytes;
+    pthread_mutex_unlock(&dsh_observed_mu);
+    char *path=strdup(out), *name=strdup(key);
+    uint8_t *data=malloc(bytes);
+    int accepted=0;
+    if (data && path && name && dsh_observed_read(data,control,nctl) &&
+        dsh_observed_read(data+nctl,(const void *)(uintptr_t)code,ncode)) {
+        accepted=rb_observed_enqueue(^{
+            uint32_t layout[4]={0,(uint32_t)st,nctl,ncode};
+            if (!nvn_be_stopping() && rb_nvn2_input_matches(name,layout,data)) {
+                mkdir(path,0755);
+                dsh_dump(name,data,nctl,(uint64_t)(uintptr_t)(data+nctl),ncode);
+                dsh_comp_fn comp=dsh_comp();
+                uint64_t start=now_ns();
+                // dsh_comp_locked rechecks the versioned files under the same translator
+                // mutex as synchronous demand, eager binds, and optional retranslation.
+                int rc=comp ? dsh_comp_locked(comp,name,st,data+nctl,ncode,data,nctl,path) : -1;
+                if (!rc) {
+                    if (t_dsh_src_made) {
+                        atomic_fetch_add(&g_dsh_ahead_ok,1);
+                        atomic_fetch_add(&g_dsh_ahead_ns,now_ns()-start);
+                    } else atomic_fetch_add(&g_dsh_ahead_dup,1);
+                    mtl_shmap_rt_add(name,dsh_nm[st]); rb_observed_stage_load(name,dsh_nm[st]);
