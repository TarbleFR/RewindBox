--- a/graphics/nvn/tests/rb_reference_gpu.inc
+++ b/graphics/nvn/tests/rb_reference_gpu.inc
@@ -98,8 +98,29 @@
     GPU_CHECK([NSFileManager.defaultManager moveItemAtPath:user toPath:record error:nil]);
     // Keep the old archives: the migration must rebuild these two copied targets once.
 }
+static void reference_varyings(NSString *root) {
+    const char *library=getenv("RB_TEST_NATIVE_VPAD");
+    GPU_CHECK(library && dlopen(library,RTLD_NOW|RTLD_GLOBAL) && dlsym(RTLD_DEFAULT,"s2a_dsh_vs_pad"));
+    NSString *shaderDir=[root stringByAppendingPathComponent:@"translation"];
+    NSArray *stages=@[stage_name(ST_VERTEX),reference_vertex_b,stage_name(ST_A)];
+    for (NSString *name in stages) {
+        BOOL vertex=![name isEqual:stage_name(ST_A)];
+        NSString *base=[shaderDir stringByAppendingPathComponent:name];
+        NSString *meta=[base stringByAppendingPathExtension:@"json"];
+        NSMutableDictionary *j=[[NSJSONSerialization JSONObjectWithData:[NSData dataWithContentsOfFile:meta] options:0 error:nil] mutableCopy];
+        j[vertex ? @"user_out" : @"user_in"]=vertex ? @[] : @[@5];
+        GPU_CHECK([[NSJSONSerialization dataWithJSONObject:j options:0 error:nil] writeToFile:meta atomically:YES]);
+        NSString *source = vertex ?
+            @"#include <metal_stdlib>\nusing namespace metal;\nstruct main0_out\n{\n    float4 pos [[position]];\n};\n"
+             "vertex main0_out main0(uint i [[vertex_id]]) { main0_out out = {}; const float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; out.pos=float4(p[i],0,1); return out; }" :
+            @"#include <metal_stdlib>\nusing namespace metal;\nstruct F {float4 v [[user(locn5)]];}; fragment float4 main0(F in [[stage_in]]) {return in.v.wzyw;}";
+        // The hardware default interpolator (0,0,0,1) must produce red.
+        write_test_text([base stringByAppendingPathExtension:@"metal"],source);
+    }
+}
 static void reference_check(NSString *root,NSString *mode) {
     BOOL active=[mode isEqual:@"active"];
+    if ([mode isEqual:@"padded"]) reference_varyings(root);
     BOOL missing=[mode isEqual:@"missing"], refused=[mode isEqual:@"refused"], replay=[mode isEqual:@"replay"];
     BOOL interrupted=[mode isEqual:@"interrupt"], resumed=[mode isEqual:@"resume"];
     reference_pause_mode=interrupted?2:[mode isEqual:@"empty"]?1:0;
@@ -191,6 +212,10 @@
