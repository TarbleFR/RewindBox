+// The 795 foreground batch had all the base functions, but the fixed-function
+// pair check deferred vertices with missing user locations to a later draw.
+static BOOL rb_warm_pair(NvShader *vs, NvShader *fs, NSString *recipe) {
+    uint32_t missing = pso_pair_miss(vs,fs);
+    if (!missing || vp_fn(vs,missing)) return YES;
+    if (!recipe || !vs || ![recipe length] || dm_gfx_session_stopping()) return NO;
+    // Serialise requests for different masks on the same vertex. A live
+    // compilation keeps ownership; the normal draw path can always retry.
+    @synchronized(vs) {
+        pthread_mutex_lock(&g_vp_mu);
+        uint32_t prior = vs->vp_mask;
+        uint32_t mask = prior | missing;
+        if (vs->vp_st == SE_READY && (prior & missing)==missing) {
+            pthread_mutex_unlock(&g_vp_mu); return YES;
+        }
+        if (vs->vp_st == SE_BUSY) { pthread_mutex_unlock(&g_vp_mu); return NO; }
+        int old = vs->vp_st; vs->vp_st = SE_BUSY;
+        pthread_mutex_unlock(&g_vp_mu);
+        uint8_t key[8]; BOOL valid=strnlen(vs->key,sizeof vs->key)>=16;
+        for (unsigned i=0;valid && i<8;i++) {
+            unsigned byte;
+            valid=sscanf(vs->key+2*i,"%2x",&byte)==1;
+            if (valid) key[i]=(uint8_t)byte;
+        }
+        char path[1200], why[300]="source unavailable";
+        id<MTLFunction> fn=nil;
+        if (valid && !dm_shader_vpad(key,0,NULL,mask,path,sizeof path)) {
+            ++t_rb_msl_n;
+            fn=vp_load_padded(vs,path,why,sizeof why);
+        }
+        pthread_mutex_lock(&g_vp_mu);
+        if (fn) { vs->vp_main=fn; vs->vp_mask=mask; vs->vp_st=SE_READY; }
+        else vs->vp_st=old;
+        pthread_mutex_unlock(&g_vp_mu);
+        MLOG("RewindBox reference vertex padding %s mask %#x recipe %s: %s",vs->key,mask,recipe.UTF8String,fn ? "ready" : why);
+        return fn!=nil;
+    }
+}
