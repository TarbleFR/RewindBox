+    if ([mode isEqual:@"padded"]) {
+        for (WarmItem *item in g_warm_items) if (item->referenceKey)
+            GPU_CHECK(vp_fn(item->vs,1u<<5) && pso_pair_miss(item->vs,item->fs)==(1u<<5));
+    }
     demand_vertex_and_draw(vertices[0],ST_A,objects[vertices[0]]);
     if (!missing) demand_vertex_and_draw(vertices[1],ST_A,objects[vertices[1]]);
     GPU_CHECK(!g_rb_seed_objects.n);
