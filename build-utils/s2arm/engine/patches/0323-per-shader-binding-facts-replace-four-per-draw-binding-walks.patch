diff --git a/graphics/nvn/gfx/nvn/rb_bind_facts.h b/graphics/nvn/gfx/nvn/rb_bind_facts.h
new file mode 100644
index 0000000..e9db1fb
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_bind_facts.h
@@ -0,0 +1,41 @@
+// RewindBox (patch 0323): what four per-draw walks over a shader's bindings ask, answered once per shader (nvn_mtl.m rb_shader_facts). Pure C: tests/t_rb_bind_facts.c.
+//   IPA 827 (Mario Kart World, iPhone A18 Pro, in a race): 1,000 to 2,058 draws a frame at about 40,000 submit-thread instructions each, on a core clocked at 1.3 to
+//   1.6 GHz once the device is at Fair. Every draw walked all bindings of all its stages in tba_prepare (a TEX binding fetched as 2D rows?), udc_note_draw (an image
+//   binding? a written one?), swrite_note (a written image or storage binding?) and, for the fragment stage, fb_prepare (which bindings are textures?), with a
+//   lock and unlock of the registration mutex per texture binding there. The answers depend only on the reflection, which nothing writes after the shader is loaded.
+//   Rule: the facts are made at a shader's first use and made again if its binding array or count is another (the tests build shaders by hand); each walk asks the
+//   facts and does exactly what its loop did. tex[] lists the TEX bindings in binding order, whatever their register (fb_prepare still tests the register); past
+//   RB_BF_TEX_MAX of them tex_over is set and fb_prepare walks all bindings as before. S2A_RB_BIND_FACTS=0: as before, the four loops.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_BF_TEX = 3, RB_BF_IMG = 4, RB_BF_SBUFP = 6, RB_BF_IMGA = 19, RB_BF_IMGU = 29, RB_BF_GMEM = 30,   // nvn_refl.h NVN_RB_* (asserted equal in nvn_mtl.m and in the test)
+       RB_BF_TYPE_2D = 2,                                                                                   // MTLTextureType2D (asserted in nvn_mtl.m)
+       RB_BF_TEX_MAX = 32 };
+typedef struct {
+    uint8_t ready;
+    uint8_t swrite;      // a binding with rw is IMG, IMGU, IMGA, SBUFP or GMEM (swrite_note)
+    uint8_t image;       // a binding is IMG or IMGU (udc_note_draw: the zero-source set)
+    uint8_t image_rw;    // … and has rw (udc_note_draw: image_write)
+    uint8_t f1d_tex2d;   // a TEX binding has f1d and declares a 2D texture (tba_prepare)
+    uint8_t tex_over;    // more TEX bindings than tex[] holds
+    uint8_t ntex;        // TEX bindings listed in tex[], in binding order (fb_prepare)
+    uint16_t tex[RB_BF_TEX_MAX];   // their indices in the binding array
+    uint32_t nb;         // the binding count the facts were made from
+    const void *src;     // … and the binding array
+} rb_bind_facts;
+
+static inline void rb_bind_facts_begin(rb_bind_facts *f, const void *src, uint32_t nb) { memset(f, 0, sizeof *f); f->src = src; f->nb = nb; }
+// One binding, in binding order. index: its place in the array
+static inline void rb_bind_facts_add(rb_bind_facts *f, unsigned index, unsigned kind, unsigned rw, unsigned f1d, unsigned dtt) {
+    if (rw && (kind == RB_BF_IMG || kind == RB_BF_IMGU || kind == RB_BF_IMGA || kind == RB_BF_SBUFP || kind == RB_BF_GMEM)) f->swrite = 1;
+    if (kind == RB_BF_IMG || kind == RB_BF_IMGU) { f->image = 1; if (rw) f->image_rw = 1; }
+    if (kind != RB_BF_TEX) return;
+    if (f1d && dtt == RB_BF_TYPE_2D) f->f1d_tex2d = 1;
+    if (f->ntex < RB_BF_TEX_MAX && index <= UINT16_MAX) f->tex[f->ntex++] = (uint16_t)index;
+    else f->tex_over = 1;
+}
+static inline void rb_bind_facts_end(rb_bind_facts *f) { f->ready = 1; }
+// 1 = the facts were made from this array and count (0 for a shader never examined, or one whose array was replaced)
+static inline int rb_bind_facts_current(const rb_bind_facts *f, const void *src, uint32_t nb) { return f->ready && f->src == src && f->nb == nb; }
