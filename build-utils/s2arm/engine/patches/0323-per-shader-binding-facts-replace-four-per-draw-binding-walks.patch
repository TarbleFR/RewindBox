+++ b/graphics/nvn/tests/t_rb_bind_facts.c
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0323): host-only checks of the per-shader binding facts (gfx/nvn/rb_bind_facts.h) against the four loops they stand for, copied here from
+//   nvn_mtl.m as they were (swrite_note, udc_note_draw's two, tba_prepare's test, fb_prepare's test), over the real binding record (nvn_refl.h).
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../gfx/nvn/nvn_refl.h"
+#include "../gfx/nvn/rb_bind_facts.h"
+
+_Static_assert((int)RB_BF_TEX == (int)NVN_RB_TEX && (int)RB_BF_IMG == (int)NVN_RB_IMG && (int)RB_BF_SBUFP == (int)NVN_RB_SBUFP && (int)RB_BF_IMGA == (int)NVN_RB_IMGA &&
+               (int)RB_BF_IMGU == (int)NVN_RB_IMGU && (int)RB_BF_GMEM == (int)NVN_RB_GMEM, "rb_bind_facts.h kinds");
+enum { TYPE_2D = 2, TYPE_3D = 7, NTEX = 256 };   // MTLTextureType2D / 3D, nvn_mtl.m NTEX
+
+// the glue of nvn_mtl.m rb_shader_facts_make
+static void facts_of(rb_bind_facts *f, const nvn_rbind *b, int nb) {
+    rb_bind_facts_begin(f, b, (uint32_t)nb);
+    for (int i = 0; i < nb; i++) rb_bind_facts_add(f, (unsigned)i, b[i].kind, b[i].rw, b[i].f1d, b[i].dtt);
+    rb_bind_facts_end(f);
+}
+// the loops as nvn_mtl.m had them
+static int ref_swrite(const nvn_rbind *b, int nb) {
+    for (int i = 0; i < nb; i++) if (b[i].rw && (b[i].kind == NVN_RB_IMG || b[i].kind == NVN_RB_IMGU || b[i].kind == NVN_RB_IMGA || b[i].kind == NVN_RB_SBUFP || b[i].kind == NVN_RB_GMEM)) return 1;
+    return 0;
+}
+static int ref_image(const nvn_rbind *b, int nb) { for (int i = 0; i < nb; i++) if (b[i].kind == NVN_RB_IMG || b[i].kind == NVN_RB_IMGU) return 1; return 0; }
+static int ref_image_rw(const nvn_rbind *b, int nb) { for (int i = 0; i < nb; i++) if ((b[i].kind == NVN_RB_IMG || b[i].kind == NVN_RB_IMGU) && b[i].rw) return 1; return 0; }
+static int ref_f1d(const nvn_rbind *b, int nb) {
+    for (int i = 0; i < nb; i++) { if (b[i].kind != NVN_RB_TEX || !b[i].f1d || b[i].dtt != TYPE_2D) continue; return 1; }
+    return 0;
+}
+static int ref_fb_list(const nvn_rbind *b, int nb, int *out) {   // fb_prepare: the bindings its loop does not skip, in order
+    int n = 0;
+    for (int i = 0; i < nb; i++) { if (b[i].kind != NVN_RB_TEX || b[i].reg >= NTEX) continue; out[n++] = i; }
+    return n;
+}
+static int facts_fb_list(const rb_bind_facts *f, const nvn_rbind *b, int *out) {   // the same through tex[], as fb_prepare walks it
+    int n = 0;
+    for (int k = 0; k < f->ntex; k++) { int i = f->tex[k]; if (b[i].kind != NVN_RB_TEX || b[i].reg >= NTEX) continue; out[n++] = i; }
+    return n;
+}
+static uint32_t rnd_state = 0x0323u;
+static uint32_t rnd(void) { rnd_state = rnd_state * 1664525u + 1013904223u; return rnd_state >> 8; }
+
+int main(void) {
+    rb_bind_facts f;
+    // ① no bindings: nothing set, ready, current for (NULL, 0) only
+    facts_of(&f, NULL, 0);
+    assert(f.ready && !f.swrite && !f.image && !f.image_rw && !f.f1d_tex2d && !f.tex_over && f.ntex == 0);
+    assert(rb_bind_facts_current(&f, NULL, 0));
+    nvn_rbind one[1] = {{0}};
+    assert(!rb_bind_facts_current(&f, one, 0) && !rb_bind_facts_current(&f, NULL, 1));
+    // … a record never examined (all zero, as a new shader object's) is not current, even for (NULL, 0)
+    rb_bind_facts z; memset(&z, 0, sizeof z);
+    assert(!rb_bind_facts_current(&z, NULL, 0));
+    // ② each kind alone, with and without rw, f1d 0 / 1 / 2, 2D and another type: every fact equals its loop
+    for (unsigned kind = 0; kind <= NVN_RB_SAMPP + 1; kind++) for (unsigned rw = 0; rw < 2; rw++) for (unsigned f1d = 0; f1d < 3; f1d++) for (unsigned t = 0; t < 2; t++) {
+        nvn_rbind b[1] = {{0}}; b[0].kind = (uint8_t)kind; b[0].rw = (uint8_t)rw; b[0].f1d = (uint8_t)f1d; b[0].dtt = t ? TYPE_2D : TYPE_3D;
+        facts_of(&f, b, 1);
+        assert(f.swrite == ref_swrite(b, 1) && f.image == ref_image(b, 1) && f.image_rw == ref_image_rw(b, 1) && f.f1d_tex2d == ref_f1d(b, 1));
+        assert(f.ntex == (kind == NVN_RB_TEX) && !f.tex_over);
+    }
+    // … the cases that must stay 0: rw on a kind that is not a store (CBUF, TEX, SAMP, UBOP, TBUF), f1d on a kind that is not TEX, f1d on a TEX declared 3D
+    { nvn_rbind b[5] = {{0}}; b[0].kind = NVN_RB_CBUF; b[1].kind = NVN_RB_TEX; b[2].kind = NVN_RB_SAMP; b[3].kind = NVN_RB_UBOP; b[4].kind = NVN_RB_TBUF;
+      for (int i = 0; i < 5; i++) { b[i].rw = 1; b[i].dtt = TYPE_2D; }
+      b[0].f1d = b[2].f1d = b[3].f1d = b[4].f1d = 1;
+      facts_of(&f, b, 5);
+      assert(!f.swrite && !f.image && !f.image_rw && !f.f1d_tex2d && f.ntex == 1 && f.tex[0] == 1);
+      b[1].f1d = 2; b[1].dtt = TYPE_3D; facts_of(&f, b, 5); assert(!f.f1d_tex2d);
+      b[1].dtt = TYPE_2D; facts_of(&f, b, 5); assert(f.f1d_tex2d); }
+    // … a read-only image is an image but neither a written image nor a store; a read-only storage buffer is no store
+    { nvn_rbind b[2] = {{0}}; b[0].kind = NVN_RB_IMGU; b[1].kind = NVN_RB_SBUFP; facts_of(&f, b, 2); assert(f.image && !f.image_rw && !f.swrite); }
+    // ③ random binding arrays (every kind, registers up to 300, up to 80 bindings): the facts and the fragment list equal the loops, order included
+    for (int round = 0; round < 20000; round++) {
+        int nb = (int)(rnd() % 81);
+        nvn_rbind *b = calloc((size_t)(nb ? nb : 1), sizeof *b); assert(b);
+        int ntex_all = 0;
+        for (int i = 0; i < nb; i++) {
+            b[i].kind = (uint8_t)(rnd() % 3 ? NVN_RB_CBUF + rnd() % NVN_RB_SAMPP : NVN_RB_TEX);   // a third of them textures
+            b[i].rw = (uint8_t)(rnd() % 4 == 0); b[i].f1d = (uint8_t)(rnd() % 8 == 0 ? 1 + rnd() % 2 : 0);
+            b[i].dtt = (uint8_t)(rnd() % 3 ? TYPE_2D : TYPE_3D); b[i].reg = (uint16_t)(rnd() % 301); b[i].aid = (uint16_t)i;
+            ntex_all += b[i].kind == NVN_RB_TEX;
+        }
+        facts_of(&f, b, nb);
+        assert(rb_bind_facts_current(&f, b, (uint32_t)nb));
+        assert(f.swrite == ref_swrite(b, nb) && f.image == ref_image(b, nb) && f.image_rw == ref_image_rw(b, nb) && f.f1d_tex2d == ref_f1d(b, nb));
+        assert(f.tex_over == (ntex_all > RB_BF_TEX_MAX));
+        assert(f.ntex == (ntex_all > RB_BF_TEX_MAX ? RB_BF_TEX_MAX : ntex_all));
+        if (!f.tex_over) {   // fb_prepare uses the list only then
+            int want[81], got[81], nw = ref_fb_list(b, nb, want), ng = facts_fb_list(&f, b, got);
+            assert(nw == ng);
+            for (int k = 0; k < nw; k++) assert(want[k] == got[k]);
+        }
+        free(b);
+    }
+    // ④ the list's capacity: 32 TEX bindings fit, the 33rd sets tex_over and the list stays the first 32
+    { nvn_rbind b[40] = {{0}}; for (int i = 0; i < 40; i++) b[i].kind = NVN_RB_TEX;
+      facts_of(&f, b, RB_BF_TEX_MAX); assert(!f.tex_over && f.ntex == RB_BF_TEX_MAX && f.tex[RB_BF_TEX_MAX - 1] == RB_BF_TEX_MAX - 1);
+      facts_of(&f, b, RB_BF_TEX_MAX + 1); assert(f.tex_over && f.ntex == RB_BF_TEX_MAX);
+      facts_of(&f, b, 40); assert(f.tex_over && f.ntex == RB_BF_TEX_MAX); }
+    // ⑤ a register changed in place after the facts were made (the engine's own fb_pin test moves a texture to slot 128): the list holds indices, the walk reads the
+    //   register as it is now, so a binding moved past the table is skipped and one moved inside it is kept
+    { nvn_rbind b[3] = {{0}}; b[0].kind = NVN_RB_TEX; b[0].reg = 0; b[1].kind = NVN_RB_SAMPT; b[2].kind = NVN_RB_TEX; b[2].reg = 5;
+      facts_of(&f, b, 3);
+      int got[3], want[3];
+      b[0].reg = 128; assert(facts_fb_list(&f, b, got) == 2 && ref_fb_list(b, 3, want) == 2 && got[0] == 0 && got[1] == 2);
+      b[2].reg = 300; assert(facts_fb_list(&f, b, got) == 1 && ref_fb_list(b, 3, want) == 1 && got[0] == want[0]); }
+    // ⑥ another array or another count: not current (made again by the caller)
+    { nvn_rbind a[2] = {{0}}, c[2] = {{0}}; facts_of(&f, a, 2);
+      assert(rb_bind_facts_current(&f, a, 2) && !rb_bind_facts_current(&f, c, 2) && !rb_bind_facts_current(&f, a, 1)); }
+    puts("t_rb_bind_facts: ok");
+    return 0;
+}
