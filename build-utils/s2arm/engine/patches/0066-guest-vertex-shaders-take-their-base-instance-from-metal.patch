+// RewindBox (patch 0066): the base instance the GPU wrote into the arguments of each indirect draw (and each live sub-draw of a masked multi-draw) whose vertex shader
+//   reads c0, read once its submission has run. PS1 / PS2 / PS4 of the 765 test: these draws (164 indirect draws and 152 sub-draws a frame in the capture of frame 2976)
+//   read c0 + 0x644 = 0 while their arguments hold a prefix sum, and no record showed the values (frames.txt keeps the instance counts' sum and hash only). Now each
+//   vertex shader met with a non-zero base is named once (64 at most: PS6's map of the palm and vegetation draws); a submission's line
+//   is written the first 4 times, then at powers of two; every 300 frames a line gives the draws a frame, those with a non-zero base, those of a vertex shader not
+//   rewritten (NvShader rb_bi 0), how many frames have other base instances than a frame among the 6 before with the same draw list and GPU-written counts (PS2: bases that
+//   move while nothing else does) and the last 12 frames' fingerprints of (record, base). The records go to the submission's commit blocks, apart from the frame
+//   signatures' words. S2A_RB_BINST_LOG=0 turns it off. Cost: 40 bytes a such draw on the replaying thread, two reads of guest memory each once the submission has run
+typedef struct { uint64_t ind, cnt, vs; uint32_t i; uint8_t el, bi; } rbb_rec;   // ind: the record (its base instance at + 16 when el, an indexed draw, else + 12); cnt: its multi-draw's count (0 = none), i: its place there; vs: fsig_shkey; bi: its rb_bi
+typedef struct { uint64_t frame; int n, cap; rbb_rec *r; } rbb_piece;   // a submission's records of one frame, malloc'd; its commit block reads and frees them
+typedef struct { _Atomic uint64_t frame, hash; _Atomic uint32_t n, nz, nu, late; } rbb_frame;   // frame: its number + 1 (0 = empty); hash: of (record, base); n: draws, nz: with a non-zero base, nu: of those not rewritten; late: RewindBox (patch 0066), its submissions read while a later main command buffer could run (rb_bi_land)
+enum { RBB_KEYS = 64, RBB_FR = 1024, RBB_CAP = 65536 };
+static rbb_frame g_rbb_fr[RBB_FR];
+static rbb_piece *g_rbb_cur; static uint64_t g_rbb_fence, g_rbb_win, g_rbb_lost;   // the replaying thread: the piece being filled, the fence it goes out with, the last window line, records not kept
+static struct { uint64_t vs; uint8_t on, bi; } g_rbb_last;   // the last such draw's vertex shader (rb_bi_note), with which mdx_next encodes the next draws of its multi-draw
+static os_unfair_lock g_rbb_lk = OS_UNFAIR_LOCK_INIT; static uint64_t g_rbb_keys[RBB_KEYS]; static int g_rbb_nkeys;   // the vertex shaders met with a non-zero base (commit blocks, under the lock)
+static _Atomic uint64_t g_rbb_draws, g_rbb_nz, g_rbb_unc, g_rbb_pieces;
+static int rbb_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("S2A_RB_BINST_LOG"); v = !(e && !strcmp(e, "0")); } return v; }
+static void rb_bi_land(const rbb_piece *p) {   // a commit block (a Metal completion thread): the submission has run
+    uint64_t f = p->frame; uint32_t nd = 0, nz = 0, nu = 0; uint64_t h = 0; char det[400]; size_t o = 0; int shown = 0; det[0] = 0;
+    int late = p->n && atomic_load(&g_seg_inflight) > 0;   // RewindBox (patch 0066): the commit blocks run once this submission's count is off g_seg_inflight: a later main command buffer is committed and may be running: its culling may write the words read below
+    for (int k = 0; k < p->n; k++) { const rbb_rec *r = &p->r[k];
+        if (r->cnt) { uint32_t c = 0; if (!nvn_host_readable(r->cnt, 4)) continue; memcpy(&c, (const void *)(uintptr_t)r->cnt, 4); if (r->i >= c) continue; }   // past its multi-draw's count: not drawn
+        uint64_t a = r->ind + (r->el ? 16 : 12); uint32_t v = 0; if (!nvn_host_readable(a, 4)) continue; memcpy(&v, (const void *)(uintptr_t)a, 4);
+        nd++; h += fsig_wmix((uint32_t)(r->ind ^ r->ind >> 32), v);
+        if (!v) continue;
+        nz++; if (!r->bi) nu++;
+        int fresh = 0; os_unfair_lock_lock(&g_rbb_lk);
+        { int j = 0; while (j < g_rbb_nkeys && g_rbb_keys[j] != r->vs) j++; if (j == g_rbb_nkeys && j < RBB_KEYS) { g_rbb_keys[g_rbb_nkeys++] = r->vs; fresh = g_rbb_nkeys; } }
+        os_unfair_lock_unlock(&g_rbb_lk);
+        if (fresh) MLOG("RewindBox: base instance (patch 0066): vertex shader %016llx draws indirectly with base instance %u in its arguments (record %#llx%s, frame %llu): %s; %d such vertex shaders so far",
+                        (unsigned long long)r->vs, v, (unsigned long long)r->ind, r->cnt ? ", of a multi-draw" : "", (unsigned long long)f,
+                        r->bi == 2 ? "its translation takes it from Metal" : r->bi == 1 ? "its translation does not read c0 + 0x644" : "it was not rewritten (the library container, S2A_RB_BASE_INSTANCE=0, or refused by Metal): if it reads c0 + 0x644 it gets 0", fresh);
+        if (shown < 6 && o < sizeof det) { int w = snprintf(det + o, sizeof det - o, " %016llx:%u%s", (unsigned long long)r->vs, v, r->bi == 2 ? "" : r->bi == 1 ? "(no read)" : "(not rewritten)"); if (w > 0) o += (size_t)w; shown++; }
+    }
+    if (p->n && atomic_load(&g_seg_inflight) > 0) late = 1;   // RewindBox (patch 0066): or one committed while they were read (not seen: one committed and reported back within the reads, or an mdi_wait piece, which g_seg_inflight does not count)
+    rbb_frame *fr = &g_rbb_fr[f % RBB_FR];
+    if (atomic_load(&fr->frame) == f + 1) { if (late) atomic_fetch_add(&fr->late, 1); atomic_fetch_add(&fr->hash, h); atomic_fetch_add(&fr->n, nd); atomic_fetch_add(&fr->nz, nz); atomic_fetch_add(&fr->nu, nu); }   // RewindBox (patch 0066): late, for rb_bi_window
