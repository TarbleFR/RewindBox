+    if (!nz) return;
+    uint64_t k = atomic_fetch_add(&g_rbb_pieces, 1) + 1;
+    if (k <= 4 || !(k & (k - 1))) MLOG("RewindBox: base instance (patch 0066): a submission of frame %llu drew %u indirect draws whose vertex shader reads c0, %u of them with a non-zero base instance in their arguments "
+                                       "(%u of a vertex shader not rewritten), the first (vertex shader:base):%s; %llu such submissions, %llu of %llu such draws with a non-zero base so far (%llu of a vertex shader not rewritten)%s",
+                                       (unsigned long long)f, nd, nz, nu, det, (unsigned long long)k, (unsigned long long)tz, (unsigned long long)td, (unsigned long long)tu,
+                                       late ? "; read while a later main command buffer could run: these values may be its writes" : "");   // RewindBox (patch 0066): late
+}
+static void rb_bi_window(uint64_t f) {   // the replaying thread: the 300 frames before the last three (whose submissions may still be on the GPU)
+    enum { W = 300, SHOW = 12 }; if (f < W + 3) return;
+    uint64_t dn = 0, dz = 0, du = 0; uint32_t nf = 0, same = 0, moved = 0, nlf = 0, nlate = 0; char det[400]; size_t o = 0; det[0] = 0;   // RewindBox (patch 0066): nlf, frames read late; nlate, frames left out of same / moved for it
+    for (uint64_t g = f - 3 - W; g < f - 3; g++) { rbb_frame *c = &g_rbb_fr[g % RBB_FR]; if (atomic_load(&c->frame) != g + 1) continue;
+        uint32_t n = atomic_load(&c->n); nf++; dn += n; dz += atomic_load(&c->nz); du += atomic_load(&c->nu); nlf += atomic_load(&c->late) != 0;   // RewindBox (patch 0066): nlf
+        if (g >= f - 3 - SHOW && o < sizeof det) { int w = snprintf(det + o, sizeof det - o, " %llu:%u/%u/%08llx", (unsigned long long)g, n, atomic_load(&c->nz), (unsigned long long)(atomic_load(&c->hash) & 0xffffffffull)); if (w > 0) o += (size_t)w; }
+        fsig_t *s = fsig_at(g); if (!s || !n) continue;
+        for (uint64_t d = 1; d <= 6 && d <= g; d++) { rbb_frame *q = &g_rbb_fr[(g - d) % RBB_FR]; fsig_t *t = fsig_at(g - d);   // the last of the 6 frames before with its draw list and GPU-written counts (the probe turns its faces every 3 or 6 frames)
+            if (atomic_load(&q->frame) != g - d + 1 || atomic_load(&q->n) != n || !t || t->hash != s->hash || atomic_load(&t->ghash) != atomic_load(&s->ghash)) continue;
+            if (atomic_load(&c->late) || atomic_load(&q->late)) { nlate++; break; }   // RewindBox (patch 0066): the records of either frame read while a later main command buffer could run: not compared
+            same++; moved += atomic_load(&q->hash) != atomic_load(&c->hash); break; }
+    }
+    if (nf) MLOG("RewindBox: base instance (patch 0066) up to frame %llu: %.1f indirect draws a frame whose vertex shader reads c0 over %u frames, %.1f of them with a non-zero base instance in their arguments (%.1f of a vertex shader not rewritten); "
+                 "of %u frames with the draw list and GPU-written counts of one of the 6 frames before, %u have other base instances in the same records (%u more left out: the records of either frame read while a later main command buffer could run; %u of the %u frames read so); "
+                 "%llu records not kept (so far); frame:draws/non-zero/fingerprint%s",   // RewindBox (patch 0066): nlate, nlf
+                 (unsigned long long)f, (double)dn / nf, nf, (double)dz / nf, (double)du / nf, same, moved, nlate, nlf, nf, (unsigned long long)g_rbb_lost, det);
+}
+static void rb_bi_put(uint64_t ind, int el, uint64_t cnt, int i) {   // the replaying thread
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    if (!g_rbb_cur || g_rbb_fence != g_fence || g_rbb_cur->frame != f || g_rbb_cur->n >= RBB_CAP) {   // another submission (g_fence moves at each commit) or frame: a new piece
+        g_rbb_cur = NULL;
+        rbb_piece *p = g_commit_blocks ? malloc(sizeof *p) : NULL; if (!p) { g_rbb_lost++; return; }
+        *p = (rbb_piece){f, 0, 0, NULL};
+        rbb_frame *fr = &g_rbb_fr[f % RBB_FR];
+        if (atomic_load(&fr->frame) != f + 1) { atomic_store(&fr->frame, 0); atomic_store(&fr->hash, 0); atomic_store(&fr->n, 0); atomic_store(&fr->nz, 0); atomic_store(&fr->nu, 0); atomic_store(&fr->late, 0); atomic_store(&fr->frame, f + 1); }   // RewindBox (patch 0066): late too
