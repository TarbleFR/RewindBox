+        g_rbb_cur = p; g_rbb_fence = g_fence;
+        if (f >= g_rbb_win + 300) { if (g_rbb_win) rb_bi_window(f); g_rbb_win = f; }
+    }
+    rbb_piece *p = g_rbb_cur;
+    if (p->n == p->cap) { int c = p->cap ? p->cap * 2 : 64; rbb_rec *r = realloc(p->r, (size_t)c * sizeof *r); if (!r) { g_rbb_lost++; return; } p->r = r; p->cap = c; }
+    p->r[p->n++] = (rbb_rec){ind, cnt, g_rbb_last.vs, (uint32_t)i, (uint8_t)el, g_rbb_last.bi};
+}
+static void rb_bi_note(NvShader *vs, const p_draw *dw, const p_draw_idx *di) {   // draw, before draw_emit (the replaying thread)
+    g_rbb_last.on = 0;
+    uint64_t ind = dw ? dw->ind : di ? di->ind : 0;
+    if (!ind || !vs || !vs->rf.drv_read[0] || !rbb_on() || !on_sub_thread()) return;
+    g_rbb_last.vs = fsig_shkey(vs); g_rbb_last.bi = vs->rb_bi; g_rbb_last.on = 1;
+    rb_bi_put(ind, !dw, dw ? dw->mdi_cnt : di->mdi_cnt, dw ? dw->mdi_i : di->mdi_i);
+}
+static void rb_bi_again(const p_draw *dw, const p_draw_idx *di) {   // mdx_next: the next draw of the multi-draw rb_bi_note saw last
+    if (g_rbb_last.on && (dw || di)) rb_bi_put(dw ? dw->ind : di->ind, !dw, dw ? dw->mdi_cnt : di->mdi_cnt, dw ? dw->mdi_i : di->mdi_i);
+}
