+// RewindBox (patch 0066): a vertex shader's base instance from Metal, not from the driver segment.
+//   GLSLC adds c0 + 0x644 (NVN's base instance word) to the instance ID where a vertex shader needs the absolute instance, and the translation keeps that read:
+//   (gl_InstanceIndex - gl_BaseInstance) + c0[0x644]. The host fills c0 + 0x644 from the draw's record (encode_args, g_draw_binst): right for a direct draw, 0 for an
+//   indirect one, whose base instance is in its arguments, which the GPU writes. On the console the driver's indirect-draw macro writes the arguments' base instance into
+//   c0 + 0x644 (Ryujinx's DrawManager sets HasConstantBufferDrawParameters for indirect and macro draws, and its translator then reads the built-in instead).
+//   Mario Kart World draws its vegetation and terrain indirectly from a GPU culling pass: a compute pass (0f682a39) writes each LOD bucket's arguments with a base instance
+//   from a prefix sum over atomics, another (41c33633) stores the instances at slot + base, and 45 vertex shaders (palm trunks 74b85bcc / 8b3b3ddc, fronds 68c42ab0, ferns
+//   129cd085, grass 6782f0f9, terrain 1e5d5ed8 / 8e02b0a6 with 76 sub-draws a multi-draw, the probe's vegetation) index them with this word (capture of frame 2976, IPA 765:
+//   164 indirect draws and 152 sub-draws a frame). Each such draw read instances [0, count) instead of its own, and which instances those were changed with the order of the
+//   atomics from one frame to the next while no draw list, count or LOD changed: the near palms gone for single frames (42 of the 168 recorded frames that show them).
+//   Metal's [[base_instance]] is the base instance of the draw as Metal draws it: the record's for a direct draw (the value the host writes into c0 + 0x644), the
+//   arguments' for an indirect one (NVN's indexed indirect record is MTLDrawIndexedPrimitivesIndirectArguments word for word; ixc's conversions copy it), each sub-draw's
+//   for a multi-draw. So in the entry points that rasterize (main0 / main0_z, and the layer entries main0_l / main0_lz, which prog_fold_gs makes the vertex function of the
+//   game's own draws, indirect ones included) each read of c0 + 0x644 becomes the built-in, declared when the entry point lacks it. Not in the geometry-capture main0_gs:
+//   geo_draw and tess_draw read its draw's arguments on the CPU and give first_instance both to c0 + 0x644 and to Metal. Applied when a translated vertex shader's source is
+//   compiled (shader_build, vp_build); a source Metal refuses so rewritten is built as translated, with a red line (rb_binst_refused). The pipeline archive keeps its keys
+//   (par_rkey hashes the shader keys and the state): each archived pipeline of these shaders misses once and is removed and written again (par_drop), so the first run after
+//   this patch, and the first after each change of S2A_RB_BASE_INSTANCE, compiles those pipelines again: measure pacing from the run after. S2A_RB_BASE_INSTANCE=0 keeps the
+//   driver segment's word. The draws whose arguments hold a non-zero base instance are counted and their vertex shaders named (rb_bi_land), and a frame capture's
+//   sh-<key>.metal is the source as compiled (rb_binst_copy)
+// RewindBox (patch 0066): replaces, in the entry points main0, main0_z, main0_l and main0_lz of a translated vertex shader, each read of c0 + 0x644 by Metal's base instance.
+//   Returns a malloc'd copy (NULL when nothing changed); *reads: reads replaced, *entries: entry points changed, *left: reads kept (main0_gs, or a read followed by a
+//   swizzle or name this does not know)
+static int rb_binst_idch(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
+static char *rb_binst_fix(const char *src, size_t len, unsigned *reads, unsigned *entries, unsigned *left) {
+    static const char kRead[] = "(*spvDescriptorSet0.vp_c0)._m0[100].y";   // c0 is float4 _m0[]: byte 0x644 = _m0[100].y
+    static const char kParam[] = ", uint rb_binst [[base_instance]]";
+    const size_t kl = sizeof kRead - 1;
+    *reads = *entries = *left = 0;
+    if (!src || !memmem(src, len, kRead, kl)) return NULL;
+    size_t cap = len + 4096, n = 0; char *out = malloc(cap); if (!out) return NULL;
+    #define RB_PUT(p, l) do { size_t l_ = (l); if (n + l_ + 1 > cap) { while (n + l_ + 1 > cap) cap *= 2; char *t_ = realloc(out, cap); if (!t_) { free(out); return NULL; } out = t_; } memcpy(out + n, (p), l_); n += l_; } while (0)
+    size_t i = 0;
+    while (i < len) {
+        // the next entry point header of interest
+        const char *h0 = NULL; size_t hl = 0; const char *best = NULL;
+        static const char *const heads[] = { "\nvertex main0_out main0(", "\nvertex main0_out main0_z(", "\nvertex main0l_out main0_l(", "\nvertex main0l_out main0_lz(" };
+        for (int k = 0; k < (int)(sizeof heads / sizeof *heads); k++) { const char *f = memmem(src + i, len - i, heads[k], strlen(heads[k])); if (f && (!best || f < best)) { best = f; hl = strlen(heads[k]); } }
+        if (!best) break;
+        h0 = best;
+        size_t po = (size_t)(h0 - src) + hl, p = po; int depth = 1;
+        while (p < len && depth) { if (src[p] == '(') depth++; else if (src[p] == ')') depth--; p++; }
+        if (depth) break;
+        size_t pe = p - 1;   // ')' closing the parameters
+        const char *bo = memchr(src + pe, '{', len - pe); if (!bo) break;
+        size_t b = (size_t)(bo - src), q = b + 1; depth = 1;
+        while (q < len && depth) { if (src[q] == '{') depth++; else if (src[q] == '}') depth--; q++; }
+        if (depth) break;
+        size_t be = q;   // one past the body's '}'
+        // reads in the body? (one followed by a swizzle or a name, ._m0[100].yz, is not this word alone: kept)
+        unsigned nr = 0; for (size_t s = b; s + kl <= be; ) { const char *f = memmem(src + s, be - s, kRead, kl); if (!f) break; s = (size_t)(f - src) + kl; nr += s >= be || !rb_binst_idch(src[s]); }
+        if (!nr) { RB_PUT(src + i, be - i); i = be; continue; }
+        // the base instance parameter's name, if the entry point has one
+        char name[64] = "rb_binst"; int have = 0;
+        const char *bi = memmem(src + po, pe - po, "[[base_instance]]", 17);
+        if (bi) { const char *e = bi; while (e > src + po && (e[-1] == ' ' || e[-1] == '\t')) e--; const char *s = e; while (s > src + po && ((s[-1] >= 'a' && s[-1] <= 'z') || (s[-1] >= 'A' && s[-1] <= 'Z') || (s[-1] >= '0' && s[-1] <= '9') || s[-1] == '_')) s--;
+                  if (e > s && (size_t)(e - s) < sizeof name) { memcpy(name, s, (size_t)(e - s)); name[e - s] = 0; have = 1; } }
+        char with[96]; int wl = snprintf(with, sizeof with, "as_type<float>(uint(%s))", name);
+        RB_PUT(src + i, pe - i);   // up to the ')' of the parameters
+        if (!have) { size_t z = po; while (z < pe && (src[z] == ' ' || src[z] == '\t' || src[z] == '\n')) z++; size_t c = z < pe ? 0 : 2; RB_PUT(kParam + c, sizeof kParam - 1 - c); }   // no comma before it in an empty list
+        for (size_t s = pe; s < be; ) { const char *f = memmem(src + s, be - s, kRead, kl); if (!f) { RB_PUT(src + s, be - s); break; } size_t t = (size_t)(f - src) + kl; RB_PUT(src + s, (size_t)(f - src) - s);
+            if (t < be && rb_binst_idch(src[t])) RB_PUT(kRead, kl); else RB_PUT(with, (size_t)wl); s = t; }
+        *reads += nr; (*entries)++; i = be;
+    }
+    if (i < len) RB_PUT(src + i, len - i);
+    out[n] = 0;
+    #undef RB_PUT
+    for (size_t s = 0; s + kl <= n; ) { const char *f = memmem(out + s, n - s, kRead, kl); if (!f) break; (*left)++; s = (size_t)(f - out) + kl; }
+    if (!*entries) { free(out); return NULL; }
+    return out;
+}
