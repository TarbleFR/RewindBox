+static void rb_vm_finish(RBVMAudit *s, NSString *status, NSString *reason)
+{
+    NSString *stop = rb_vm_stop_reason(s->generation);
+    if (stop) { status = @"cancelled"; reason = stop; }
+    if (![status isEqualToString:@"cancelled"] && rb_vm_legacy_busy()) {
+        if (rb_vm_add_u64(&s->legacy_wait_yields, 1)) {
+            // Never wait for the heartbeat on its queue, or on the UI queue.
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_MSEC),
+                rb_vm_queue(), ^{ rb_vm_finish(s, status, reason); });
+            return;
+        }
+        s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow";
+    }
+    // A cancellation captured earlier remains terminal even if another score
+    // closes before this block executes. Do not resume sampling after it.
+    NSDictionary *end_ledger = [status isEqualToString:@"cancelled"] || s->counter_overflow ?
+        @{ @"valid": @NO, @"reason": reason } : rb_vm_ledger(s->generation);
+    if ([end_ledger[@"reason"] isEqual:@"legacy_scan_active"]) {
+        if (rb_vm_add_u64(&s->legacy_wait_yields, 1)) {
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_MSEC),
+                rb_vm_queue(), ^{ rb_vm_finish(s, status, reason); });
+            return;
+        }
+        s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow";
+        end_ledger = @{ @"valid": @NO, @"reason": reason };
+    }
+    stop = rb_vm_stop_reason(s->generation);
+    if (stop) { status = @"cancelled"; reason = stop; }
+    uint64_t ended = rb_vm_now(), end_frame = 0;
+    BOOL end_frame_valid = rb_vm_alive(s->generation);
+    if (end_frame_valid) {
+        end_frame = s2a_ap_frames();
+        end_frame_valid = rb_vm_alive(s->generation);
+    }
+    NSArray<NSNumber *> *ordered_tags = [[s->tags allKeys] sortedArrayUsingSelector:@selector(compare:)];
+    const char *side_names[RB_VM_SIDES] = { "outside_guest_window", "inside_guest_window", "crossing_guest_window", "guest_window_unknown" };
+    for (NSNumber *tag in ordered_tags) {
+        const rb_vm_counts *groups = s->tags[tag].bytes;
+        for (unsigned group = 0; group < RB_VM_SIDES * 2; group++) {
+            if (!groups[group].n[RB_VM_REGIONS]) continue;
+            NSMutableDictionary *row = rb_vm_record(@"mapping_tag", s->identifier, s->generation);
+            row[@"tag"] = tag;
+            row[@"side"] = [NSString stringWithUTF8String:side_names[group / 2]];
+            row[@"external_pager_or_shadow"] = @((group & 1) != 0);
+            row[@"counts"] = rb_vm_counts_json(&groups[group]);
+            // Consumers only accept completeness after the final end record.
+            row[@"provisional_until_end"] = @YES;
+            rb_vm_json(row);
+        }
+    }
+    NSMutableDictionary *sharing = [NSMutableDictionary dictionary];
+    for (unsigned mode = 0; mode < 256; mode++)
+        if (s->share_modes[mode]) sharing[[NSString stringWithFormat:@"%u", mode]] = @(s->share_modes[mode]);
+    stop = rb_vm_stop_reason(s->generation);
+    if (stop) { status = @"cancelled"; reason = stop; }
+    NSMutableDictionary *end = rb_vm_record(@"end", s->identifier, s->generation);
+    end[@"status"] = status;
+    end[@"reason"] = reason;
+    end[@"complete"] = @([status isEqualToString:@"complete"] && s->reached_map_end);
+    end[@"reached_map_end"] = @(s->reached_map_end);
+    end[@"begin_record_emitted"] = @(s->began);
+    end[@"requested_ns"] = @(s->requested_ns);
+    end[@"requested_frame"] = s->requested_frame_valid ? @(s->requested_frame) : [NSNull null];
+    end[@"started_ns"] = @(s->started_ns);
+    end[@"started_frame"] = s->started_frame_valid ? @(s->started_frame) : [NSNull null];
+    end[@"ended_ns"] = @(ended);
+    end[@"ended_frame"] = end_frame_valid ? @(end_frame) : [NSNull null];
+    end[@"wall_ns"] = @(ended - s->started_ns);
+    end[@"wall_scope"] = @"worker_start_including_legacy_waits_through_end_ledger_excludes_mapping_logs";
+    uint64_t published = rb_vm_now();
+    end[@"published_ns"] = @(published);
+    end[@"mapping_log_publication_ns"] = @(published - ended);
+    end[@"busy_wall_ns_at_end_record"] = @(published - s->requested_ns);
+    end[@"query_ns"] = @(s->query_ns);
+    end[@"query_scope"] = @"mach_vm_region_recurse_only";
+    end[@"max_single_query_ns"] = @(s->maximum_query_ns);
+    end[@"walk_worker_cpu_ns"] = @(s->worker_cpu_ns);
+    end[@"cpu_samples_unavailable"] = @(s->cpu_samples_unavailable);
+    end[@"cpu_scope"] = @"walk_slices_only_excludes_begin_end_logging";
+    end[@"calls"] = @(s->calls);
+    end[@"leaf_regions"] = @(s->leaves);
+    end[@"submaps_descended"] = @(s->submaps);
+    end[@"max_depth"] = @(s->maximum_depth);
+    end[@"slices"] = @(s->slices);
+    end[@"legacy_wait_yields"] = @(s->legacy_wait_yields);
+    end[@"last_kr"] = @(s->last_kr);
+    end[@"counter_overflow"] = @(s->counter_overflow);
+    end[@"mapping_page_bytes"] = @((uint64_t)vm_page_size);
+    end[@"mapping_counts"] = rb_vm_counts_json(&s->total);
+    end[@"regions_by_share_mode"] = sharing;
+    end[@"ledger_end"] = end_ledger;
+    end[@"atomic_snapshot"] = @NO;
+    end[@"alias_deduplication"] = @"none";
+    end[@"mapping_sums_may_count_aliases"] = @YES;
+    end[@"mapping_and_task_ledgers_are_additive"] = @NO;
+    end[@"coverage"] = [status isEqualToString:@"complete"] && s->reached_map_end ?
+        @"all_leaf_regions_encountered_to_end_of_map_over_time" : @"partial_walk";
+    rb_vm_json(end);
+    atomic_store_explicit(&g_rb_vm_busy, false, memory_order_release);
+}
