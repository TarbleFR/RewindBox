+static void rb_vm_write_json(const char *prefix, NSDictionary *record)
+{
+    NSError *error = nil;
+    NSData *data = [NSJSONSerialization dataWithJSONObject:record options:0 error:&error];
+    if (data) {
+        NSString *line = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
+        if (line) { LOG("%s %s", prefix, line.UTF8String); return; }
+    }
+    // Only data supplied by this module enters records. Do not print NSError's
+    // description, private paths, map addresses, or the supplied id on failure.
+    LOG("%s {\"schema\":1,\"event\":\"error\",\"reason\":\"json_encoding_failed\"}", prefix);
+}
+
+static void rb_vm_json(NSDictionary *record) { rb_vm_write_json("[RB-BENCH-VM]", record); }
+
+static NSMutableDictionary *rb_vm_record(NSString *event, NSString *identifier, unsigned generation)
+{
+    return [@{ @"schema": @1, @"event": event, @"id": identifier,
+        @"generation": @(generation), @"phase": @"after_score" } mutableCopy];
+}
+
+static BOOL rb_vm_add_u64(uint64_t *target, uint64_t amount)
+{
+    if (amount > UINT64_MAX - *target) return NO;
+    *target += amount;
+    return YES;
+}
+
+static BOOL rb_vm_counts_fit(const rb_vm_counts *target, const rb_vm_counts *add)
+{
+    for (unsigned i = 0; i < RB_VM_COUNT; i++)
+        if (add->n[i] > UINT64_MAX - target->n[i]) return NO;
+    return YES;
+}
+
+static void rb_vm_counts_add(rb_vm_counts *target, const rb_vm_counts *add)
+{
+    for (unsigned i = 0; i < RB_VM_COUNT; i++) target->n[i] += add->n[i];
+}
+
+static NSDictionary *rb_vm_counts_json(const rb_vm_counts *c)
+{
+    return @{ @"regions": @(c->n[RB_VM_REGIONS]),
+        @"virtual_bytes": @(c->n[RB_VM_VIRTUAL_BYTES]),
+        @"resident_pages": @(c->n[RB_VM_RESIDENT_PAGES]),
+        @"compressed_logical_pages": @(c->n[RB_VM_COMPRESSED_PAGES]),
+        @"dirty_pages": @(c->n[RB_VM_DIRTY_PAGES]),
+        @"shared_now_private_pages": @(c->n[RB_VM_PRIVATE_PAGES]),
+        @"reusable_pages": @(c->n[RB_VM_REUSABLE_PAGES]),
+        @"reusable_count_unavailable_regions": @(c->n[RB_VM_REUSABLE_UNKNOWN]) };
+}
