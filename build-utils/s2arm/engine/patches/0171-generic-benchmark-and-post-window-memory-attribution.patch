+static void rb_vm_start(RBVMAudit *s)
+{
+    @autoreleasepool {
+        unsigned generation = s->generation;
+        NSString *stop = rb_vm_stop_reason(generation);
+        if (stop) { rb_vm_finish(s, @"cancelled", stop); return; }
+        if (rb_vm_legacy_busy()) {
+            if (!rb_vm_add_u64(&s->legacy_wait_yields, 1)) {
+                s->counter_overflow = YES;
+                rb_vm_finish(s, @"error", @"counter_overflow");
+                return;
+            }
+            // active stays true: new legacy scans refuse admission while the
+            // already-running heartbeat finishes on its independent queue.
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_MSEC),
+                rb_vm_queue(), ^{ rb_vm_start(s); });
+            return;
+        }
+        if (!s->tags) { rb_vm_finish(s, @"error", @"aggregation_allocation_failed"); return; }
+        uint64_t base = 0, size = 0;
+        s2a_window_get(&base, &size);
+        stop = rb_vm_stop_reason(generation);
+        if (stop) { rb_vm_finish(s, @"cancelled", stop); return; }
+        if (size > UINT64_MAX - base) { rb_vm_finish(s, @"error", @"guest_bounds_overflow"); return; }
+        s->guest_begin = base;
+        s->guest_end = base + size;
+        s->guest_bounds_known = size != 0;
+        s->begin_ledger = rb_vm_ledger(generation);
+        stop = rb_vm_stop_reason(generation);
+        if (stop) { rb_vm_finish(s, @"cancelled", stop); return; }
+        if ([s->begin_ledger[@"reason"] isEqual:@"legacy_scan_active"]) {
+            if (!rb_vm_add_u64(&s->legacy_wait_yields, 1)) {
+                s->counter_overflow = YES;
+                rb_vm_finish(s, @"error", @"counter_overflow");
+                return;
+            }
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_MSEC),
+                rb_vm_queue(), ^{ rb_vm_start(s); });
+            return;
+        }
+        NSMutableDictionary *r = rb_vm_record(@"begin", s->identifier, generation);
+        r[@"requested_ns"] = @(s->requested_ns);
+        r[@"requested_frame"] = s->requested_frame_valid ? @(s->requested_frame) : [NSNull null];
+        r[@"started_ns"] = @(s->started_ns);
+        r[@"started_frame"] = s->started_frame_valid ? @(s->started_frame) : [NSNull null];
+        r[@"guest_bounds_known"] = @(s->guest_bounds_known);
+        r[@"mapping_page_bytes"] = @((uint64_t)vm_page_size);
+        r[@"ledger_begin"] = s->begin_ledger;
+        r[@"atomic_snapshot"] = @NO;
+        r[@"alias_deduplication"] = @"none";
+        r[@"scan_reads_guest_bytes"] = @NO;
+        r[@"soft_slice_ns"] = @2000000;
+        r[@"yield_delay_ns"] = @25000000;
+        r[@"legacy_wait_yields"] = @(s->legacy_wait_yields);
+        r[@"time_or_region_completion_limit"] = @NO;
+        rb_vm_json(r);
+        s->began = YES;
+        rb_vm_slice(s);
+    }
+}
+
+int s2a_rb_vm_audit_active(void)
+{
+    // Paired with the post-CAS fence below. Benchmark admission publishes its
+    // generation before calling this a second time, so both sides cannot miss
+    // each other's admission store, including on ARM.
+    atomic_thread_fence(memory_order_seq_cst);
+    return atomic_load_explicit(&g_rb_vm_busy, memory_order_acquire) ? 1 : 0;
+}
+
+void s2a_rb_bench_after_window(const char *id)
+{
+    if (!rb_vm_enabled()) return;
+    // The post-score API owns the label, not a caller's temporary C string.
+    NSString *identifier = id ? [[NSString alloc] initWithUTF8String:id] : nil;
+    if (!identifier.length) {
+        dispatch_async(rb_vm_queue(), ^{
+            rb_vm_json(@{ @"schema": @1, @"event": @"rejected", @"reason": @"invalid_id" });
+        });
+        return;
+    }
+    unsigned generation = s2a_session_generation();
+    NSString *stop = rb_vm_stop_reason(generation);
+    bool expected = false;
+    if (stop || !atomic_compare_exchange_strong_explicit(&g_rb_vm_busy, &expected, true,
+            memory_order_acq_rel, memory_order_acquire)) {
+        dispatch_async(rb_vm_queue(), ^{
+            NSMutableDictionary *r = rb_vm_record(@"rejected", identifier, generation);
+            r[@"reason"] = stop ?: @"audit_already_active";
+            rb_vm_json(r);
+        });
+        return;
+    }
+    atomic_thread_fence(memory_order_seq_cst);
+    // This check follows active=1; collector admission checks active again
+    // after publishing its own nonzero generation. The worker checks as well.
+    stop = rb_vm_stop_reason(generation);
+    uint64_t requested_ns = rb_vm_now(), requested_frame = s2a_ap_frames();
+    BOOL requested_frame_valid = rb_vm_alive(generation);
+    dispatch_async(rb_vm_queue(), ^{
+        @autoreleasepool {
+            RBVMAudit *s = [RBVMAudit new];
+            if (!s) {
+                NSMutableDictionary *r = rb_vm_record(@"rejected", identifier, generation);
+                r[@"reason"] = @"audit_allocation_failed";
+                rb_vm_json(r);
+                atomic_store_explicit(&g_rb_vm_busy, false, memory_order_release);
+                return;
+            }
+            s->identifier = identifier;
+            s->generation = generation;
+            s->requested_ns = requested_ns;
+            s->requested_frame = requested_frame;
+            s->requested_frame_valid = requested_frame_valid;
+            s->started_ns = rb_vm_now();
+            s->tags = [NSMutableDictionary dictionary];
+            NSString *worker_stop = stop ?: rb_vm_stop_reason(generation);
+            if (worker_stop) { rb_vm_finish(s, @"cancelled", worker_stop); return; }
+            s->started_frame = s2a_ap_frames();
+            s->started_frame_valid = rb_vm_alive(generation);
+            rb_vm_start(s);
+        }
+    });
+}
