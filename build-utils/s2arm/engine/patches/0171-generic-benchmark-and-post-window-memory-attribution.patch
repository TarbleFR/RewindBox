+// Only rev0..rev3 fields are used; each requires both a known SDK layout and
+// sufficient returned count. Missing counters are not represented as zeros.
+// The caller owns generation checks and sampling; this function queries nothing.
+static NSMutableDictionary *rb_vm_ledger_values(const task_vm_info_data_t *info,
+    mach_msg_type_number_t count, kern_return_t kr, uint64_t sample_ns, uint64_t frame)
+{
+    NSMutableDictionary *r = [@{ @"valid": @NO, @"kr": @(kr), @"count": @(count),
+        @"sample_ns": @(sample_ns), @"frame": @(frame),
+        @"accounting_views_are_additive": @NO,
+        @"compressed_unit": @"logical_uncompressed_bytes" } mutableCopy];
+    if (kr != KERN_SUCCESS) { r[@"reason"] = @"task_info_failed"; return r; }
+    if (!info) { r[@"reason"] = @"missing_task_info"; return r; }
+#if defined(TASK_VM_INFO_REV0_COUNT)
+    if (count < TASK_VM_INFO_REV0_COUNT) { r[@"reason"] = @"short_task_info"; return r; }
+#else
+    r[@"reason"] = @"sdk_missing_rev0_layout";
+    return r;
+#endif
+    r[@"valid"] = @YES;
+    r[@"page_bytes"] = @(info->page_size);
+    r[@"resident_bytes"] = @((uint64_t)info->resident_size);
+    r[@"internal_bytes"] = @((uint64_t)info->internal);
+    r[@"external_bytes"] = @((uint64_t)info->external);
+    r[@"reusable_bytes"] = @((uint64_t)info->reusable);
+    r[@"compressed_logical_bytes"] = @((uint64_t)info->compressed);
+    r[@"region_count"] = @(info->region_count);
+#if defined(TASK_VM_INFO_REV1_COUNT)
+    if (count >= TASK_VM_INFO_REV1_COUNT)
+        r[@"phys_footprint_bytes"] = @((uint64_t)info->phys_footprint);
+#endif
+    r[@"ledger_tags_valid"] = @NO;
+#if defined(TASK_VM_INFO_REV3_COUNT)
+    if (count >= TASK_VM_INFO_REV3_COUNT) {
+        r[@"ledger_tags_valid"] = @YES;
+        // These are signed ledger balances and independent accounting views.
+        // In particular, compressed - graphics_compressed is not a CPU total.
+#define RB_LEDGER_CATEGORY(key, name) \
+        r[key] = @{ \
+            @"footprint_resident_bytes": @((int64_t)info->ledger_tag_##name##_footprint), \
+            @"footprint_compressed_logical_bytes": @((int64_t)info->ledger_tag_##name##_footprint_compressed), \
+            @"nofootprint_resident_bytes": @((int64_t)info->ledger_tag_##name##_nofootprint), \
+            @"nofootprint_compressed_logical_bytes": @((int64_t)info->ledger_tag_##name##_nofootprint_compressed) }
+        RB_LEDGER_CATEGORY(@"graphics", graphics);
+        RB_LEDGER_CATEGORY(@"media", media);
+        RB_LEDGER_CATEGORY(@"neural", neural);
+#undef RB_LEDGER_CATEGORY
+        r[@"network"] = @{
+            @"nonvolatile_bytes": @((int64_t)info->ledger_tag_network_nonvolatile),
+            @"nonvolatile_compressed_logical_bytes": @((int64_t)info->ledger_tag_network_nonvolatile_compressed),
+            @"volatile_bytes": @((int64_t)info->ledger_tag_network_volatile),
+            @"volatile_compressed_logical_bytes": @((int64_t)info->ledger_tag_network_volatile_compressed) };
+        r[@"purgeable"] = @{
+            @"nonvolatile_bytes": @((int64_t)info->ledger_purgeable_nonvolatile),
+            // 'novolatile' is the spelling in Apple's public task_info.h.
+            @"nonvolatile_compressed_logical_bytes": @((int64_t)info->ledger_purgeable_novolatile_compressed),
+            @"volatile_bytes": @((int64_t)info->ledger_purgeable_volatile),
+            @"volatile_compressed_logical_bytes": @((int64_t)info->ledger_purgeable_volatile_compressed) };
+    }
+#endif
+    return r;
+}
+
+// Each additional Mach call is guarded before and after; returned fields are
+// discarded if the session retired or a new timed score became active.
+static NSDictionary *rb_vm_ledger(unsigned generation)
+{
+    NSString *stop = rb_vm_stop_reason(generation);
+    if (stop) return @{ @"valid": @NO, @"reason": stop };
+    if (rb_vm_legacy_busy()) return @{ @"valid": @NO, @"reason": @"legacy_scan_active" };
+    task_vm_info_data_t info = {0};
+    mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+    uint64_t start = rb_vm_now();
+    kern_return_t kr = task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&info, &count);
+    uint64_t end = rb_vm_now(), frame = s2a_ap_frames();
+    stop = rb_vm_stop_reason(generation);
+    if (stop) return @{ @"valid": @NO, @"reason": stop,
+        @"kr": @(kr), @"sample_ns": @(end), @"query_ns": @(end - start) };
+    NSMutableDictionary *r = rb_vm_ledger_values(&info, count, kr, end, frame);
+    r[@"query_ns"] = @(end - start);
+    return r;
+}
+
+void s2a_rb_vm_ledgers_log(const task_vm_info_data_t *info,
+    mach_msg_type_number_t count, kern_return_t kr, unsigned generation,
+    uint64_t frame, uint64_t sample_ns)
+{
+    if (!rb_vm_ledgers_enabled() || !rb_vm_alive(generation)) return;
+    task_vm_info_data_t snapshot = {0};
+    BOOL have_info = info != NULL;
+    if (have_info && kr == KERN_SUCCESS) {
+        size_t bytes = sizeof(snapshot);
+        if (count < sizeof(snapshot) / sizeof(integer_t)) bytes = (size_t)count * sizeof(integer_t);
+        memcpy(&snapshot, info, bytes);
+    }
+    dispatch_async(rb_vm_queue(), ^{
+        @autoreleasepool {
+            if (!rb_vm_alive(generation)) return;
+            NSMutableDictionary *r = rb_vm_ledger_values(have_info ? &snapshot : NULL,
+                count, kr, sample_ns, frame);
+            r[@"schema"] = @1;
+            r[@"event"] = @"heartbeat_ledger";
+            r[@"generation"] = @(generation);
+            r[@"published_ns"] = @(rb_vm_now());
+            r[@"source"] = @"existing_heartbeat_task_info";
+            r[@"additional_mach_calls"] = @0;
+            if (rb_vm_alive(generation)) rb_vm_write_json("[RB-VM-LEDGER]", r);
+        }
+    });
+}
