@@ -0,0 +1,649 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+// Post-score VM metadata census; never faults guest bytes in for measurement.
+// The page counts are mapping observations across time, not a physical sum.
+// Public API layout/accounting reference: Apple XNU 12377.1.9,
+// f6217f891ac0bb64f3d375211650a4c1ff8ca1ea, task_info.h and vm_region.h.
+#import <Foundation/Foundation.h>
+#include <dispatch/dispatch.h>
+#include <mach/mach.h>
+#include <mach/vm_map.h>
+#include <mach/task_info.h>
+#include <mach/vm_region.h>
+#include <limits.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+#include "native.h"
+#include "s2a_session.h"
+#include "rb_vm_audit.h"
+
+// Use the public iOS VM API already compiled by vawin.c, with a 64-bit address range.
+_Static_assert(sizeof(vm_address_t) == 8 && sizeof(vm_size_t) == 8, "VM benchmark requires a 64-bit iOS target");
+
+uint64_t s2a_ap_frames(void);
+extern uint64_t s2a_rb_bench_generation(void) __attribute__((weak_import));
+extern int s2a_rb_bench_legacy_scan_active(void) __attribute__((weak_import));
+
+enum {
+    RB_VM_REGIONS, RB_VM_VIRTUAL_BYTES, RB_VM_RESIDENT_PAGES,
+    RB_VM_COMPRESSED_PAGES, RB_VM_DIRTY_PAGES, RB_VM_PRIVATE_PAGES,
+    RB_VM_REUSABLE_PAGES, RB_VM_REUSABLE_UNKNOWN, RB_VM_COUNT
+};
+typedef struct { uint64_t n[RB_VM_COUNT]; } rb_vm_counts;
+enum { RB_VM_OUTSIDE, RB_VM_INSIDE, RB_VM_CROSSING, RB_VM_UNKNOWN, RB_VM_SIDES };
+
+@interface RBVMAudit : NSObject {
+@public
+    NSString *identifier;
+    unsigned generation;
+    uint64_t requested_ns, requested_frame, started_ns, started_frame;
+    BOOL requested_frame_valid, started_frame_valid;
+    uint64_t guest_begin, guest_end;
+    BOOL guest_bounds_known;
+    vm_address_t cursor;
+    natural_t depth, maximum_depth;
+    uint64_t calls, leaves, submaps, slices, legacy_wait_yields, query_ns, maximum_query_ns;
+    uint64_t worker_cpu_ns, cpu_samples_unavailable;
+    uint64_t share_modes[256];
+    rb_vm_counts total;
+    NSMutableDictionary<NSNumber *, NSMutableData *> *tags;
+    NSDictionary *begin_ledger;
+    kern_return_t last_kr;
+    BOOL began, reached_map_end, counter_overflow;
+}
+@end
+@implementation RBVMAudit
+@end
+
+static atomic_bool g_rb_vm_busy;
+
+static uint64_t rb_vm_now(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
+
+static BOOL rb_vm_cpu_time(uint64_t *ns)
+{
+#ifdef CLOCK_THREAD_CPUTIME_ID
+    struct timespec value;
+    if (!clock_gettime(CLOCK_THREAD_CPUTIME_ID, &value) && value.tv_sec >= 0 &&
+        value.tv_nsec >= 0 && value.tv_nsec < 1000000000L &&
+        (uint64_t)value.tv_sec <= (UINT64_MAX - (uint64_t)value.tv_nsec) / 1000000000ull) {
+        *ns = (uint64_t)value.tv_sec * 1000000000ull + (uint64_t)value.tv_nsec;
+        return YES;
+    }
+#endif
+    *ns = 0;
+    return NO;
+}
+
+static BOOL rb_vm_enabled(void)
+{
+    static dispatch_once_t once;
+    static BOOL enabled;
+    dispatch_once(&once, ^{
+        const char *bench = getenv("S2A_RB_BENCH");
+        const char *audit = getenv("S2A_RB_VM_FULL_AUDIT");
+        const char *tags = getenv("S2A_RB_VM_TAGS");
+        enabled = !(bench && !strcmp(bench, "0")) &&
+                  !(audit && !strcmp(audit, "0")) &&
+                  !(tags && !strcmp(tags, "0"));
+    });
+    return enabled;
+}
+
+static dispatch_queue_t rb_vm_queue(void)
+{
+    static dispatch_once_t once;
+    static dispatch_queue_t queue;
+    dispatch_once(&once, ^{
+        queue = dispatch_queue_create("rb.bench.vm.audit",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+    });
+    return queue;
+}
+
+static BOOL rb_vm_ledgers_enabled(void)
+{
+    static dispatch_once_t once;
+    static BOOL enabled;
+    dispatch_once(&once, ^{
+        const char *bench = getenv("S2A_RB_BENCH");
+        const char *ledgers = getenv("S2A_RB_VM_LEDGERS");
+        enabled = !(bench && !strcmp(bench, "0")) &&
+                  !(ledgers && !strcmp(ledgers, "0"));
+    });
+    return enabled;
+}
+
+static BOOL rb_vm_alive(unsigned generation)
+{
+    return !s2a_session_stop_requested() &&
+           s2a_host_session_state() == S2A_SESSION_RUNNING &&
+           s2a_session_generation() == generation;
+}
+
+static BOOL rb_vm_score_active(void)
+{
+    return s2a_rb_bench_generation && s2a_rb_bench_generation() != 0;
+}
+
+static BOOL rb_vm_legacy_busy(void)
+{
+    return s2a_rb_bench_legacy_scan_active && s2a_rb_bench_legacy_scan_active() != 0;
+}
+
+static NSString *rb_vm_stop_reason(unsigned generation)
+{
+    if (!rb_vm_alive(generation)) return @"session_changed";
+    if (rb_vm_score_active()) return @"score_window_active";
+    return nil;
+}
