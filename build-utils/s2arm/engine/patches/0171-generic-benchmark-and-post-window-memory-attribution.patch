+        @"gc":gc, @"audio":rb_audio(&run.base,&last), @"sample_count":@(run.sample_n),
+        @"counter_observation_span_s":last.at_ns >= run.base.at_ns ? @(rb_seconds(last.at_ns-run.base.at_ns)) : NSNull.null,
+        @"memory":@{@"start":rb_memory(&run.base),@"end":rb_memory(&last)},
+        @"protocol_hash":@(hex), @"comparison_policy":@"same protocol and initial conditions; no comparison with runs missing this schema",
+        @"report_path":NSNull.null} mutableCopy];
+    char docs[4096]; int dn = s2a_container_docs(docs,sizeof docs);
+    NSString *path = nil; NSError *writeError = nil;
+    NSString *relative = [@"Diagnostics/S2Arm/benchmarks" stringByAppendingPathComponent:[identifier stringByAppendingPathExtension:@"json"]];
+    if (dn > 0 && (size_t)dn < sizeof docs) {
+        NSString *directory = [@(docs) stringByAppendingPathComponent:@"Diagnostics/S2Arm/benchmarks"];
+        if ([NSFileManager.defaultManager createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:&writeError])
+            path = [directory stringByAppendingPathComponent:[identifier stringByAppendingPathExtension:@"json"]];
+    }
+    if (path) {
+        summary[@"report_path"] = relative;
+        NSDictionary *document = @{@"schema":@1,@"protocol_id":RB_PROTOCOL,@"id":identifier,@"metadata":metadata,
+            @"initial_conditions":initial,@"comparison_protocol":protocol,@"summary":summary,@"samples":rows,
+            @"metric_notes":@[@"Frame quantiles use exact nearest-rank intervals with both endpoints inside the window; boundary gaps are censored lower bounds.",
+                @"Displayed FPS counts unique positive drawable.presentedTime timestamps; guest presents and registered callbacks have separate counts.",
+                @"Audio gap is an estimate from output shortfall; underruns and late callbacks do not prove audible silence.",
+                @"GC pause is a process cumulative completed-pause value, not every individual pause duration; versioned pressure alerts are observations, not proof of causality.",
+                @"Physical I/O/page-ins belong to the process; VM compression counters belong to the whole device.",
+                @"Metal allocation and graphics ledger footprint are not physical GPU residency."]};
+        NSData *data = [NSJSONSerialization dataWithJSONObject:document options:NSJSONWritingSortedKeys error:&writeError];
+        if (!data || ![data writeToFile:path options:NSDataWritingAtomic error:&writeError]) path = nil;
+    }
+    if (!path) {
+        NSMutableArray *failed = [reasons mutableCopy]; [failed addObject:@"report_write_failed"];
+        summary[@"reasons"] = failed; summary[@"comparable"] = @NO; summary[@"report_path"] = NSNull.null;
+    }
+    rb_log(summary);
+    pthread_mutex_lock(&g_rb_lock);
+    g_rb_last_summary = [summary copy]; g_rb.state = RB_FINALIZED;
+    g_rb_reasons = [summary[@"reasons"] mutableCopy];
+    g_rb_error = path ? nil : @"report_write_failed";
+    free(g_rb.frame); free(g_rb.display); g_rb.frame = NULL; g_rb.display = NULL;
+    pthread_mutex_unlock(&g_rb_lock);
+    if (s2a_rb_bench_after_window) s2a_rb_bench_after_window(identifier.UTF8String);
+}
+
+static NSDictionary *rb_status(void) {
+    static NSString *const names[] = {@"idle",@"preparing",@"running",@"draining",@"finalizing",@"finalized"};
+    pthread_mutex_lock(&g_rb_lock);
+    uint64_t now = rb_now(), stop = g_rb.end_ns ? g_rb.end_ns : MIN(now,g_rb.deadline_ns);
+    double elapsed = g_rb.start_ns && stop >= g_rb.start_ns ? rb_seconds(stop-g_rb.start_ns) : 0;
+    NSArray *reasons = g_rb_reasons ? [g_rb_reasons copy] : @[];
+    NSDictionary *result = @{@"available":rb_bool(g_rb_enabled), @"active":rb_bool(g_rb.state >= RB_PREPARING && g_rb.state <= RB_FINALIZING),
+        @"state":names[g_rb.state], @"id":g_rb_id ?: (id)NSNull.null, @"duration_seconds":@(RB_SECONDS),
+        @"elapsed_s":@(elapsed), @"comparable":rb_bool(g_rb.state != RB_IDLE && !g_rb.partial && !reasons.count),
+        @"reasons":reasons, @"lastsummary":g_rb_last_summary ?: (id)NSNull.null, @"error":g_rb_error ?: (id)NSNull.null};
+    pthread_mutex_unlock(&g_rb_lock); return result;
+}
+static int rb_abort_start(uint64_t generation, uint64_t *frames, uint64_t *display,
+                          dispatch_source_t timer, NSString *error, int code) {
+    // Every source reaching here was resumed with an infinite first deadline.
+    // Cancel it before ARC releases it; never release a suspended source.
+    if (timer) dispatch_source_cancel(timer);
+    if (g_rb_managed_active) g_rb_managed_active(0);
+    pthread_mutex_lock(&g_rb_lock);
+    if (g_rb.generation == generation && g_rb.state == RB_PREPARING) {
+        atomic_store_explicit(&g_rb_active,0,memory_order_release);
+        if (g_rb_timer == timer) g_rb_timer = nil;
+        memset(&g_rb,0,sizeof g_rb); g_rb.generation = generation;
+        g_rb.state = g_rb_last_summary ? RB_FINALIZED : RB_IDLE;
+        g_rb_id = g_rb_last_summary[@"id"];
+        g_rb_reasons = g_rb_last_summary ? [g_rb_last_summary[@"reasons"] mutableCopy] : [NSMutableArray array];
+        g_rb_error = error ?: @"benchmark_start_cancelled";
+    }
+    pthread_mutex_unlock(&g_rb_lock);
+    free(frames); free(display); return code;
+}
+static int rb_start(const char *json) {
+    if (![NSThread isMainThread]) return -4;
+    if (!json || strnlen(json,16385) > 16384) return -3;
+    NSData *data = [NSData dataWithBytes:json length:strlen(json)];
+    id parsed = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    if (![parsed isKindOfClass:NSDictionary.class]) return -3;
+    NSMutableDictionary *metadata = [parsed mutableCopy];
+    NSString *scenario = metadata[@"scenario"];
+    if (![scenario isKindOfClass:NSString.class] || ![scenario stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].length || scenario.length > 160) return -3;
+    if (metadata[@"duration_seconds"] && (![metadata[@"duration_seconds"] isKindOfClass:NSNumber.class] || [metadata[@"duration_seconds"] integerValue] != RB_SECONDS)) return -3;
+    if (metadata[@"protocol"] && ![metadata[@"protocol"] isEqual:RB_PROTOCOL]) return -3;
+    if (metadata[@"protocol_id"] && ![metadata[@"protocol_id"] isEqual:RB_PROTOCOL]) return -3;
+    unsigned engine_generation = s2a_session_generation();
+    uint64_t end_serial = atomic_load(&g_rb_end_serial);
+    pthread_mutex_lock(&g_rb_lock);
+    if (g_rb.state >= RB_PREPARING && g_rb.state <= RB_FINALIZING) { pthread_mutex_unlock(&g_rb_lock); return -5; }
+    if (!rb_engine_running(engine_generation)) {
+        g_rb_error = @"engine_session_not_running"; pthread_mutex_unlock(&g_rb_lock); return -8;
+    }
+    pthread_mutex_unlock(&g_rb_lock);
+    UIDevice.currentDevice.batteryMonitoringEnabled = YES;
+    NSDictionary *conditions = rb_conditions();
+    NSArray<NSString *> *refused = rb_initial_refusals(metadata,conditions);
+    if (refused.count) {
+        pthread_mutex_lock(&g_rb_lock); g_rb_error = [refused componentsJoinedByString:@","]; pthread_mutex_unlock(&g_rb_lock); return -8;
+    }
+    struct utsname machine;
+    if (!uname(&machine)) metadata[@"device_model"] = @(machine.machine);
+    metadata[@"os_version"] = UIDevice.currentDevice.systemVersion;
+    metadata[@"protocol"] = RB_PROTOCOL; metadata[@"protocol_id"] = RB_PROTOCOL; metadata[@"duration_seconds"] = @(RB_SECONDS);
+    metadata[@"diagnostics"] = rb_diagnostics();
+    NSDictionary *launchPreferences = [metadata[@"settings"] isKindOfClass:NSDictionary.class] ? metadata[@"settings"] : @{};
+    metadata[@"launch_preferences"] = launchPreferences;
+    metadata[@"settings"] = rb_settings(launchPreferences);
+    uint64_t *frames = calloc(RB_STAMPS,sizeof(uint64_t)), *display = calloc(RB_STAMPS,sizeof(uint64_t));
+    if (!frames || !display) { free(frames); free(display); return -7; }
+    pthread_mutex_lock(&g_rb_lock);
+    if (!rb_engine_running(engine_generation) || atomic_load(&g_rb_end_serial) != end_serial) {
+        g_rb_error = @"engine_session_changed_before_prepare";
+        pthread_mutex_unlock(&g_rb_lock); free(frames); free(display); return -8;
+    }
+    uint64_t generation = ++g_rb_next_generation;
+    g_rb.generation = generation; g_rb.engine_generation = engine_generation;
+    g_rb.state = RB_PREPARING; g_rb.prepare_cancelled = 0; g_rb_error = nil;
+    pthread_mutex_unlock(&g_rb_lock);
+    rb_install_observers();
+    if (g_rb_managed_active) g_rb_managed_active(1);
+    rb_sample base = rb_read_sample(0);
+    // A managed snapshot can wait for an in-flight GC. Recheck the actual start
+    // conditions afterwards; no stale "unplugged/nominal" admission is accepted.
+    conditions = rb_conditions(); refused = rb_initial_refusals(metadata,conditions);
+    pthread_mutex_lock(&g_rb_lock);
+    int prepare_ok = g_rb.generation == generation && g_rb.state == RB_PREPARING && !g_rb.prepare_cancelled &&
+        atomic_load(&g_rb_end_serial) == end_serial && rb_engine_running(engine_generation);
+    NSString *prepare_error = g_rb_error ?: @"engine_session_changed_during_prepare";
+    pthread_mutex_unlock(&g_rb_lock);
+    if (refused.count || !prepare_ok)
+        return rb_abort_start(generation,frames,display,nil,refused.count ? [refused componentsJoinedByString:@","] : prepare_error,-8);
+    metadata[@"settings"] = rb_settings(launchPreferences);
+    // Prepare a live but disarmed source before publishing the window. Once the
+    // public token is nonzero, stop/finalize must already own a cancellable timer.
+    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER,0,0,g_rb_queue);
+    if (!timer) return rb_abort_start(generation,frames,display,nil,@"timer_allocation_failed",-7);
+    dispatch_source_set_timer(timer,DISPATCH_TIME_FOREVER,DISPATCH_TIME_FOREVER,0);
+    dispatch_source_set_event_handler(timer, ^{ @autoreleasepool { rb_tick(generation); } });
+    dispatch_resume(timer);
+    uint64_t start = rb_now(); base.nominal_ns = start;
+    NSString *identifier = NSUUID.UUID.UUIDString.lowercaseString;
+    pthread_mutex_lock(&g_rb_lock);
+    if (g_rb.generation != generation || g_rb.state != RB_PREPARING || g_rb.prepare_cancelled ||
+        atomic_load(&g_rb_end_serial) != end_serial || !rb_engine_running(engine_generation)) {
+        NSString *why = g_rb_error ?: @"engine_session_changed_before_publish";
+        pthread_mutex_unlock(&g_rb_lock); return rb_abort_start(generation,frames,display,timer,why,-8);
+    }
+    memset(&g_rb,0,sizeof g_rb); g_rb.generation = generation; g_rb.engine_generation = engine_generation;
+    g_rb.frame = frames; g_rb.display = display; g_rb.state = RB_PREPARING;
+    g_rb.start_ns = start; g_rb.deadline_ns = start + RB_SECONDS * RB_NS; g_rb.next_sample_ns = start + 10 * RB_NS;
+    g_rb.mode_at_ns = g_rb.thermal_at_ns = start; g_rb.last_game_mode = g_rb.last_sent_mode = 3;
+    g_rb.thermal = [conditions[@"thermal_state"] intValue]; g_rb.base = base;
+    g_rb_metadata = [metadata copy]; g_rb_initial = conditions; g_rb_id = identifier; g_rb_error = nil; g_rb_reason = nil;
+    g_rb_reasons = [NSMutableArray array]; g_rb_sample_rows = [NSMutableArray arrayWithCapacity:18];
+    for (NSString *key in @[@"game_id",@"game_version",@"device_model",@"os_version",@"engine_build",@"app_build",@"cache_protocol"]) {
+        id v = metadata[key];
+        if (![v isKindOfClass:NSString.class] || ![v length] || [[v lowercaseString] isEqual:@"unknown"])
+            rb_add_reason_locked([@"metadata_missing_" stringByAppendingString:key]);
+    }
+    if (metadata[@"settings"][@"frameRateLimit"] == NSNull.null) rb_add_reason_locked(@"runtime_fps_unavailable");
+    if (metadata[@"settings"][@"docked"] == NSNull.null) rb_add_reason_locked(@"runtime_console_mode_unavailable");
+    if (metadata[@"settings"][@"performanceOverlay"] == NSNull.null) rb_add_reason_locked(@"overlay_state_unavailable");
+    NSDictionary *perturbing = metadata[@"diagnostics"][@"explicit_perturbing_flags"];
+    for (NSString *key in perturbing) if ([perturbing[key] boolValue]) rb_add_reason_locked([@"diagnostic_enabled_" stringByAppendingString:key]);
+    if (!g_rb_managed_active || !g_rb_managed_snapshot) rb_add_reason_locked(@"managed_provider_unavailable");
+    if (!(base.managed[0] & RB_BM_HAS_GC)) rb_add_reason_locked(@"managed_baseline_unavailable");
+    if (atomic_load(&g_rb_end_serial) != end_serial || !rb_engine_running(engine_generation)) {
+        pthread_mutex_unlock(&g_rb_lock);
+        return rb_abort_start(generation,frames,display,timer,@"engine_session_changed_before_publish",-8);
+    }
+    g_rb_timer = timer; g_rb.state = RB_RUNNING;
+    uint64_t now = rb_now(), first = start + RB_NS;
+    int64_t delay = first > now ? (int64_t)(first-now) : 0;
+    dispatch_source_set_timer(timer,dispatch_time(DISPATCH_TIME_NOW,delay),RB_NS,5000000);
+    atomic_store_explicit(&g_rb_active,generation,memory_order_release);
+    // Paired with each scan's publish-busy/fence/read-generation admission.
+    // Both sides must not miss the other side while starting simultaneously.
+    atomic_thread_fence(memory_order_seq_cst);
+    if (atomic_load(&g_rb_end_serial) != end_serial || !rb_engine_running(engine_generation)) {
+        atomic_store_explicit(&g_rb_active,0,memory_order_release);
+        g_rb.state = RB_PREPARING; g_rb.prepare_cancelled = 1;
+        pthread_mutex_unlock(&g_rb_lock);
+        return rb_abort_start(generation,frames,display,timer,@"engine_session_changed_at_publish",-8);
+    }
+    if (s2a_rb_bench_legacy_scan_active && s2a_rb_bench_legacy_scan_active()) rb_add_reason_locked(@"legacy_scan_overlapped_start");
+    if (s2a_rb_vm_audit_active && s2a_rb_vm_audit_active()) rb_add_reason_locked(@"vm_audit_overlapped_start");
+    NSArray *reasons = [g_rb_reasons copy];
+    pthread_mutex_unlock(&g_rb_lock);
+    NSDictionary *begin = @{@"type":@"begin",@"schema":@1,@"protocol_id":RB_PROTOCOL,@"id":identifier,
+        @"duration_target_s":@(RB_SECONDS),@"start_ns":@(start),@"metadata":g_rb_metadata,@"initial_conditions":conditions,
+        @"comparable":rb_bool(!reasons.count),@"reasons":reasons};
+    rb_log(begin);
+    return 0;
+}
+__attribute__((visibility("default"), used))
+int s2a_rb_guest_benchmark(int command, const char *metadata_json, char *out, size_t cap) {
+    @autoreleasepool {
+        pthread_once(&g_rb_once,rb_init);
+        int result = 0;
+        if (!g_rb_enabled) result = -2;
+        else if (command == 1) result = rb_start(metadata_json);
+        else if (command == 2) s2a_rb_bench_end("player_partial");
+        else if (command == 3) s2a_rb_bench_invalidate("menu_opened");
+        else if (command != 0) result = -3;
+        if (result < 0 && result != -8) {
+            pthread_mutex_lock(&g_rb_lock);
+            g_rb_error = result == -2 ? @"disabled" : result == -4 ? @"start_requires_main_thread" : result == -5 ? @"already_active" : result == -7 ? @"allocation_failed" : @"invalid_metadata_or_command";
+            pthread_mutex_unlock(&g_rb_lock);
+        }
+        if (out) {
+            NSData *encoded = [NSJSONSerialization dataWithJSONObject:rb_status() options:NSJSONWritingSortedKeys error:nil];
+            if (!encoded || !cap || encoded.length >= cap) { if (cap) out[0] = 0; return -6; }
+            memcpy(out,encoded.bytes,encoded.length); out[encoded.length] = 0;
+        }
+        return result;
+    }
+}
