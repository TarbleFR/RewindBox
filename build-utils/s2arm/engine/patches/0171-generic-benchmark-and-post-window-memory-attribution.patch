+            if (version != 1 || output == null || count < 24) return -1;
+            var values = new System.Span<ulong>(output, 24);
+            values.Clear();
+            try
+            {
+                values[1] = (ulong)System.GC.GetTotalAllocatedBytes(false);
+                values[2] = (ulong)System.GC.CollectionCount(0);
+                values[3] = (ulong)System.GC.CollectionCount(1);
+                values[4] = (ulong)System.GC.CollectionCount(2);
+                values[5] = (ulong)(System.GC.GetTotalPauseDuration().Ticks / 10);
+                values[0] = 1;
+                Ryujinx.Audio.Backends.Apple.S2ABenchmarkAudio.Snapshot(values);
+                return 0;
+            }
+            catch
+            {
+                values.Clear(); // unavailable is a validity bit, never a fake zero sample
+                return -1;
+            }
+        }
