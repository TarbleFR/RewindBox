+static void rb_vm_slice(RBVMAudit *s)
+{
+    @autoreleasepool {
+        uint64_t slice_begin = rb_vm_now(), cpu_begin = 0, cpu_end = 0;
+        BOOL cpu_valid = rb_vm_cpu_time(&cpu_begin);
+        NSString *status = nil, *reason = nil;
+        if (!rb_vm_add_u64(&s->slices, 1)) { s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow"; }
+        // These only determine when to yield, never truncate the census.
+        for (unsigned turn = 0; !status && turn < 64; turn++) {
+            NSString *stop = rb_vm_stop_reason(s->generation);
+            if (stop) { status = @"cancelled"; reason = stop; break; }
+            if (rb_vm_legacy_busy()) {
+                if (!rb_vm_add_u64(&s->legacy_wait_yields, 1)) {
+                    s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow";
+                }
+                break;
+            }
+            if (turn && rb_vm_now() - slice_begin >= 2000000ull) break;
+            vm_address_t address = s->cursor;
+            vm_size_t size = 0;
+            natural_t depth = s->depth;
+            vm_region_submap_info_data_64_t info = {0};
+            mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+            uint64_t query_begin = rb_vm_now();
+            kern_return_t kr = vm_region_recurse_64(mach_task_self(), &address, &size,
+                &depth, (vm_region_recurse_info_t)&info, &count);
+            uint64_t query_elapsed = rb_vm_now() - query_begin;
+            s->last_kr = kr;
+            // Count the cost of an in-flight call even if its metadata must be
+            // discarded after cancellation. No result fields are read yet.
+            stop = rb_vm_stop_reason(s->generation);
+            if (!rb_vm_add_u64(&s->calls, 1) || !rb_vm_add_u64(&s->query_ns, query_elapsed)) {
+                s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow"; break;
+            }
+            if (query_elapsed > s->maximum_query_ns) s->maximum_query_ns = query_elapsed;
+            if (stop) { status = @"cancelled"; reason = stop; break; }
+            if (kr == KERN_INVALID_ADDRESS) {
+                s->reached_map_end = YES; status = @"complete"; reason = @"end_of_map"; break;
+            }
+            if (kr != KERN_SUCCESS) { status = @"error"; reason = @"vm_region_recurse_failed"; break; }
+#if defined(VM_REGION_SUBMAP_INFO_V0_COUNT_64)
+            if (count < VM_REGION_SUBMAP_INFO_V0_COUNT_64) { status = @"error"; reason = @"short_region_info"; break; }
+#else
+            status = @"error"; reason = @"sdk_missing_region_layout"; break;
+#endif
+            if (!size) { status = @"error"; reason = @"zero_region_size"; break; }
+            if (size > UINT64_MAX - address) { status = @"error"; reason = @"address_overflow"; break; }
+            if (address < s->cursor) { status = @"error"; reason = @"mapping_changed_across_cursor"; break; }
+            if (depth > s->maximum_depth) s->maximum_depth = depth;
+            s->depth = depth; // Mach can return to a shallower map itself.
+            if (info.is_submap) {
+                if (depth == UINT_MAX) { status = @"error"; reason = @"depth_overflow"; break; }
+                if (!rb_vm_add_u64(&s->submaps, 1)) { s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow"; break; }
+                s->depth = depth + 1;
+                s->cursor = address; // descend at the same address, including tag 32
+                continue;
+            }
+            if (!rb_vm_leaf(s, address, size, &info, count)) {
+                status = @"error"; reason = s->counter_overflow ? @"counter_overflow" : @"aggregation_allocation_failed"; break;
+            }
+            s->cursor = address + size;
+        }
+        cpu_valid = rb_vm_cpu_time(&cpu_end) && cpu_valid && cpu_end >= cpu_begin;
+        if (cpu_valid) {
+            if (!rb_vm_add_u64(&s->worker_cpu_ns, cpu_end - cpu_begin)) {
+                s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow";
+            }
+        } else if (!rb_vm_add_u64(&s->cpu_samples_unavailable, 1)) {
+            s->counter_overflow = YES; status = @"error"; reason = @"counter_overflow";
+        }
+        if (status) { rb_vm_finish(s, status, reason); return; }
+        // A blocking Mach call may exceed the soft slice time. It cannot be
+        // preempted here; measured query duration is reported, not hidden.
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_MSEC), rb_vm_queue(), ^{ rb_vm_slice(s); });
+    }
+}
