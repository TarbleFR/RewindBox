             LOG("[能耗] %s; RewindBox: screen captured %d, focus %s", eb, rb_cap, (const char *[]){"active", "inactive (still in the foreground)", "background"}[app_state]); }
diff --git a/ios/rb_benchmark.h b/ios/rb_benchmark.h
new file mode 100644
--- /dev/null
+++ b/ios/rb_benchmark.h
@@ -0,0 +1,73 @@
+#pragma once
+// RewindBox generic, explicitly started observation window. No game policy changes.
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// command 0: status; 1: start (main thread, metadata JSON object); 2: finish partial;
+// 3: invalidate for menu_opened, continuing the measurement and the game.
+// 0 = success; negative = refused/error. Output is a NUL-terminated JSON object.
+// -2 disabled, -3 bad metadata, -4 start off main thread, -5 already active,
+// -6 output buffer too small, -7 allocation failure, -8 initial conditions not met
+// (including a post-window VM audit still running). NULL output is allowed.
+// Metadata: scenario, cold_confirmed, settings (APPLIED values), game_id,
+// game_version, device_model, os_version, engine_build, app_build, cache_protocol.
+// protocol/protocol_id, when supplied, must be rb-switch2-bench-v1.
+// The duration is 180 seconds. Departure requires cold confirmation, nominal
+// thermal state, battery known unplugged, foreground, no capture and LPM off.
+// Later condition changes make the result non-comparable; they never stop or
+// reconfigure the game. Missing game/build metadata also prevents comparison.
+int s2a_rb_guest_benchmark(int command, const char *metadata_json, char *out, size_t cap);
+
+// Pure getter: nonzero only while collecting, zero from window closure onward.
+// Callbacks already holding a token remain accepted during the bounded drain.
+uint64_t s2a_rb_bench_generation(void);
+// One call for each guest present, with CLOCK_UPTIME_RAW and the period ACTUALLY
+// sent to nvn_be_present (not the newly recomputed next-frame period).
+void s2a_rb_bench_frame(uint64_t uptime_ns, int game_interval, uint64_t sent_period_ns);
+// Call immediately before installing a drawable's addPresentedHandler. Capture
+// the returned token in that handler, and call presented exactly once for it.
+// No pending registration outside the collecting window. Never reuse a token.
+uint64_t s2a_rb_bench_present_begin(void);
+// >0: drawable.presentedTime, CACurrentMediaTime seconds; <=0: known discarded.
+// Old-session callbacks are rejected by generation, never applied to a new run.
+void s2a_rb_bench_presented(uint64_t generation, double presented_time_s);
+// end closes the window and starts a bounded callback drain; invalidate only
+// marks the result and continues observing (menu/settings/background/charging).
+void s2a_rb_bench_end(const char *reason);
+void s2a_rb_bench_invalidate(const char *reason);
+
+// Optional backend getter, called at most once per 10 s and at window bounds.
+// 0 = valid Metal allocation size. It is NOT physical GPU residency.
+int nvn_rb_bench_memory(uint64_t *metal_allocated_bytes);
+// Optional host callback, called after the JSON result is finalized, off the
+// frame path. The host may queue a full VM walk after the measured window.
+void s2a_rb_bench_after_window(const char *identifier);
+// Optional host guard: nonzero while the post-window VM audit is pending/running.
+int s2a_rb_vm_audit_active(void);
+int s2a_rb_bench_legacy_scan_active(void);
+
+// NativeAOT exports from the main Compose assembly; resolved lazily by dlsym.
+// Snapshot v1 is process-cumulative and does not consume reporter counters.
+enum { S2A_RB_BENCH_MANAGED_VERSION = 1, S2A_RB_BENCH_MANAGED_WORDS = 24 };
+enum {
+    RB_BM_VALID = 0, RB_BM_ALLOC_BYTES = 1,
+    RB_BM_GC0 = 2, RB_BM_GC1 = 3, RB_BM_GC2 = 4, RB_BM_GC_PAUSE_US = 5,
+    RB_BM_AUDIO_GAP_US = 6, RB_BM_AUDIO_UNDERRUNS = 7, RB_BM_AUDIO_PAUSES = 8,
+    RB_BM_AUDIO_LATE_BURSTS = 9, RB_BM_AUDIO_CALLBACKS = 10,
+    RB_BM_AUDIO_SUBMITTED_FRAMES = 11, RB_BM_AUDIO_PLAYED_FRAMES = 12,
+    RB_BM_AUDIO_SKIPPED_PERIODS = 13, RB_BM_AUDIO_RENDER_PERIOD_NS = 14,
+    RB_BM_AUDIO_GAP_GT100 = 15, RB_BM_AUDIO_GAP_GT200 = 16, RB_BM_AUDIO_GAP_GT500 = 17,
+    RB_BM_AUDIO_SESSIONS_SEEN = 18, RB_BM_AUDIO_ACTIVE_OUTPUTS = 19,
+    RB_BM_AUDIO_LAST_CALLBACK_NS = 20, RB_BM_AUDIO_REGISTRY_OVERFLOW = 21
+};
+enum { RB_BM_HAS_GC = 1, RB_BM_HAS_AUDIO = 2, RB_BM_HAS_RENDERER = 4 };
+int s2a_rb_bench_managed_snapshot(uint32_t version, uint64_t *out, uint32_t count);
+void s2a_rb_bench_managed_active(int active);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ios/rb_benchmark.m b/ios/rb_benchmark.m
new file mode 100644
--- /dev/null
+++ b/ios/rb_benchmark.m
@@ -0,0 +1,772 @@
+// RewindBox: an explicitly started observation window, not a game speed policy.
+#import <Foundation/Foundation.h>
+#import <UIKit/UIKit.h>
+#import <CommonCrypto/CommonDigest.h>
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <mach/task_info.h>
+#include <mach/vm_statistics.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/utsname.h>
+#include <time.h>
+#include "native.h"
+#include "s2a_docs.h"
+#include "s2a_session.h"
+#include "rb_benchmark.h"
+
+extern int s2a_rb_guest_session_over(void);
+
+// 弱链接[ios]：nvn_rb_bench_memory
+extern int nvn_rb_bench_memory(uint64_t *) __attribute__((weak_import));
+// 弱链接[ios]：s2a_rb_bench_after_window
+extern void s2a_rb_bench_after_window(const char *) __attribute__((weak_import));
+// 弱链接[ios]：s2a_rb_vm_audit_active
+extern int s2a_rb_vm_audit_active(void) __attribute__((weak_import));
+// 弱链接[ios]：s2a_rb_bench_legacy_scan_active
+extern int s2a_rb_bench_legacy_scan_active(void) __attribute__((weak_import));
+// 弱链接[ios]：s2a_disk_io
+extern int s2a_disk_io(uint64_t *, uint64_t *, uint64_t *, uint64_t *) __attribute__((weak_import));
+// 弱链接[ios]：nvn_fps_limit
+extern int nvn_fps_limit(void) __attribute__((weak_import));
+// 弱链接[ios]：dm_opmode
+extern int dm_opmode(void) __attribute__((weak_import));
+
+enum { RB_SECONDS = 180, RB_STAMPS = 65536, RB_SAMPLES = 20, RB_WORDS = S2A_RB_BENCH_MANAGED_WORDS };
+enum { RB_IDLE, RB_PREPARING, RB_RUNNING, RB_DRAINING, RB_FINALIZING, RB_FINALIZED };
+enum { RB_IO = 1, RB_VM = 2, RB_METAL = 4, RB_FOOTPRINT = 8, RB_COMPRESSED = 16, RB_GRAPHICS = 32, RB_GRAPHICS_COMPRESSED = 64 };
+static const uint64_t RB_NS = UINT64_C(1000000000);
+static NSString *const RB_PROTOCOL = @"rb-switch2-bench-v1";
+
+typedef struct {
+    uint64_t at_ns, read_ns, nominal_ns;
+    uint64_t io[4], vm[6], managed[RB_WORDS];
+    uint64_t metal, footprint, compressed, graphics, graphics_compressed;
+    unsigned valid;
+} rb_sample;
+typedef struct {
+    uint64_t generation, start_ns, end_ns, deadline_ns, close_ns;
+    uint64_t registered, completed, pending, discarded, outside, overflow, clock_errors;
+    uint64_t *frame, *display;
+    size_t frame_n, display_n;
+    uint64_t mode_ns[2][4], mode_at_ns, thermal_ns[5], thermal_at_ns;
+    int last_game_mode, last_sent_mode, thermal, state, partial, closing_sample_claimed, prepare_cancelled;
+    unsigned engine_generation;
+    uint64_t next_sample_ns;
+    rb_sample base, samples[RB_SAMPLES];
+    unsigned sample_n;
+} rb_run;
+
+static pthread_mutex_t g_rb_lock = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic uint64_t g_rb_active;
+static _Atomic uint64_t g_rb_end_serial;
+static _Atomic unsigned g_rb_stopped_engine;
+static rb_run g_rb;
+static uint64_t g_rb_next_generation;
+static NSDictionary *g_rb_metadata, *g_rb_initial, *g_rb_last_summary;
+static NSMutableArray<NSString *> *g_rb_reasons;
+static NSMutableArray<NSDictionary *> *g_rb_sample_rows;
+static NSString *g_rb_id, *g_rb_error, *g_rb_reason;
+static dispatch_queue_t g_rb_queue;
+static dispatch_source_t g_rb_timer;
+static int g_rb_enabled;
+static pthread_once_t g_rb_once = PTHREAD_ONCE_INIT;
+static int (*g_rb_managed_snapshot)(uint32_t, uint64_t *, uint32_t);
+static void (*g_rb_managed_active)(int);
+
+static uint64_t rb_now(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
+static double rb_seconds(uint64_t ns) { return (double)ns / 1e9; }
+static id rb_value(int available, uint64_t value) { return available ? @(value) : NSNull.null; }
+static NSNumber *rb_bool(int value) { return value ? @YES : @NO; }
+static int rb_engine_running(unsigned generation) {
+    // The generation checks bracket the separately read lifecycle state. A
+    // stop hook latches its owner before the retirement worker sets stop_requested.
+    return generation && s2a_session_generation() == generation &&
+        atomic_load(&g_rb_stopped_engine) != generation &&
+        s2a_host_session_state() == S2A_SESSION_RUNNING &&
+        !s2a_rb_guest_session_over() && !s2a_session_stop_requested() &&
+        s2a_session_generation() == generation && atomic_load(&g_rb_stopped_engine) != generation;
+}
+static void rb_add_reason_locked(NSString *reason) {
+    if (reason.length && ![g_rb_reasons containsObject:reason]) [g_rb_reasons addObject:reason];
+}
+static void rb_init(void) {
+    const char *e = getenv("S2A_RB_BENCH");
+    g_rb_enabled = !(e && !strcmp(e, "0"));
+    if (!g_rb_enabled) return;
+    dispatch_queue_attr_t attr = dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0);
+    g_rb_queue = dispatch_queue_create("dev.rewindbox.benchmark", attr);
+    g_rb_managed_snapshot = (int (*)(uint32_t, uint64_t *, uint32_t))dlsym(RTLD_DEFAULT, "s2a_rb_bench_managed_snapshot");
+    g_rb_managed_active = (void (*)(int))dlsym(RTLD_DEFAULT, "s2a_rb_bench_managed_active");
+}
+static void rb_log(NSDictionary *row) {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:row options:NSJSONWritingSortedKeys error:nil];
+    if (data) { NSString *s = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding]; LOG("[RB-BENCH] %s", s.UTF8String); }
+}
+
+// A real-time integral of the last requested/native mode and the sent period.
+// Late frames do not become a new "30 FPS mode" merely because they took 33 ms.
+static void rb_modes_until_locked(uint64_t t) {
+    uint64_t end = g_rb.end_ns ? g_rb.end_ns : g_rb.deadline_ns;
+    if (t > end) t = end;
+    if (t > g_rb.mode_at_ns) {
+        uint64_t dt = t - g_rb.mode_at_ns;
+        g_rb.mode_ns[0][g_rb.last_game_mode] += dt;
+        g_rb.mode_ns[1][g_rb.last_sent_mode] += dt;
+        g_rb.mode_at_ns = t;
+    }
+}
+static void rb_thermal_until_locked(uint64_t t) {
+    uint64_t end = g_rb.end_ns ? g_rb.end_ns : g_rb.deadline_ns;
+    if (t > end) t = end;
+    if (t > g_rb.thermal_at_ns) {
+        unsigned k = g_rb.thermal >= 0 && g_rb.thermal <= 3 ? (unsigned)g_rb.thermal : 4;
+        g_rb.thermal_ns[k] += t - g_rb.thermal_at_ns;
+        g_rb.thermal_at_ns = t;
+    }
+}
+uint64_t s2a_rb_bench_generation(void) { return atomic_load_explicit(&g_rb_active, memory_order_relaxed); }
+void s2a_rb_bench_frame(uint64_t t, int game_interval, uint64_t sent_period_ns) {
+    uint64_t generation = s2a_rb_bench_generation();
+    if (!generation) return;
+    pthread_mutex_lock(&g_rb_lock);
+    if (g_rb.state == RB_RUNNING && g_rb.generation == generation && t >= g_rb.start_ns && t < g_rb.deadline_ns) {
+        if (g_rb.frame_n && t < g_rb.frame[g_rb.frame_n - 1]) g_rb.clock_errors++;
+        if (g_rb.frame_n < RB_STAMPS) g_rb.frame[g_rb.frame_n++] = t; else g_rb.overflow++;
+        rb_modes_until_locked(t);
+        g_rb.last_game_mode = game_interval == 1 ? 0 : game_interval == 2 ? 1 : 2;
+        uint64_t d60 = sent_period_ns > 16666667 ? sent_period_ns - 16666667 : 16666667 - sent_period_ns;
+        uint64_t d30 = sent_period_ns > 33333333 ? sent_period_ns - 33333333 : 33333333 - sent_period_ns;
+        g_rb.last_sent_mode = d60 <= 1000 ? 0 : d30 <= 1000 ? 1 : 2;
+    }
+    pthread_mutex_unlock(&g_rb_lock);
+}
+uint64_t s2a_rb_bench_present_begin(void) {
+    uint64_t generation = s2a_rb_bench_generation();
+    if (!generation) return 0;
+    uint64_t now = rb_now();
+    pthread_mutex_lock(&g_rb_lock);
+    if (g_rb.state != RB_RUNNING || generation != g_rb.generation || now >= g_rb.deadline_ns) generation = 0;
+    else { g_rb.registered++; g_rb.pending++; }
+    pthread_mutex_unlock(&g_rb_lock);
+    return generation;
+}
+void s2a_rb_bench_presented(uint64_t generation, double presented_time_s) {
+    if (!generation) return;
+    pthread_mutex_lock(&g_rb_lock);
+    if (generation == g_rb.generation && (g_rb.state == RB_RUNNING || g_rb.state == RB_DRAINING)) {
+        if (!g_rb.pending) g_rb.clock_errors++;
+        else g_rb.pending--;
+        g_rb.completed++;
+        if (!isfinite(presented_time_s) || presented_time_s > (double)UINT64_MAX / 1e9) g_rb.clock_errors++;
+        else if (presented_time_s <= 0) g_rb.discarded++;
+        else {
+            uint64_t t = (uint64_t)(presented_time_s * 1e9);
+            uint64_t end = g_rb.end_ns ? g_rb.end_ns : g_rb.deadline_ns;
+            if (t < g_rb.start_ns || t >= end) g_rb.outside++;
+            else if (g_rb.display_n < RB_STAMPS) g_rb.display[g_rb.display_n++] = t;
+            else g_rb.overflow++;
+        }
+    }
+    pthread_mutex_unlock(&g_rb_lock);
+}
+void s2a_rb_bench_invalidate(const char *reason) {
+    if (!s2a_rb_bench_generation()) return;
+    @autoreleasepool {
+        NSString *why = reason ? [[NSString alloc] initWithBytes:reason length:strnlen(reason, 256) encoding:NSUTF8StringEncoding] : nil;
+        pthread_mutex_lock(&g_rb_lock);
+        if (g_rb.state == RB_RUNNING) rb_add_reason_locked(why.length ? why : @"conditions_changed");
+        pthread_mutex_unlock(&g_rb_lock);
+    }
+}
+
+static rb_sample rb_read_sample(uint64_t nominal_ns) {
+    rb_sample s = {0}; uint64_t start = rb_now(); s.nominal_ns = nominal_ns;
+    if (s2a_disk_io && !s2a_disk_io(&s.io[0], &s.io[1], &s.io[2], &s.io[3])) s.valid |= RB_IO;
+    vm_statistics64_data_t vm = {0}; mach_msg_type_number_t vc = HOST_VM_INFO64_COUNT;
+    mach_port_t host = mach_host_self();
+    kern_return_t kr = host_statistics64(host, HOST_VM_INFO64, (host_info64_t)&vm, &vc);
+    mach_port_deallocate(mach_task_self(), host);
+    if (kr == KERN_SUCCESS && (size_t)vc * sizeof(integer_t) >= offsetof(vm_statistics64_data_t,swapouts) + sizeof(vm.swapouts)) {
+        s.vm[0] = vm.compressions; s.vm[1] = vm.decompressions; s.vm[2] = vm.pageins;
+        s.vm[3] = vm.pageouts; s.vm[4] = vm.swapins; s.vm[5] = vm.swapouts; s.valid |= RB_VM;
+    }
+    task_vm_info_data_t vi = {0}; mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vi, &count) == KERN_SUCCESS) {
+#define RB_TASK_HAS(field) ((size_t)count * sizeof(natural_t) >= offsetof(task_vm_info_data_t, field) + sizeof(vi.field))
+        if (RB_TASK_HAS(phys_footprint)) { s.footprint = vi.phys_footprint; s.valid |= RB_FOOTPRINT; }
+        if (RB_TASK_HAS(compressed)) { s.compressed = vi.compressed; s.valid |= RB_COMPRESSED; }
+        if (RB_TASK_HAS(ledger_tag_graphics_footprint) && vi.ledger_tag_graphics_footprint >= 0) { s.graphics = (uint64_t)vi.ledger_tag_graphics_footprint; s.valid |= RB_GRAPHICS; }
+        if (RB_TASK_HAS(ledger_tag_graphics_footprint_compressed) && vi.ledger_tag_graphics_footprint_compressed >= 0) { s.graphics_compressed = (uint64_t)vi.ledger_tag_graphics_footprint_compressed; s.valid |= RB_GRAPHICS_COMPRESSED; }
+#undef RB_TASK_HAS
+    }
+    if (nvn_rb_bench_memory && !nvn_rb_bench_memory(&s.metal)) s.valid |= RB_METAL;
+    if (g_rb_managed_snapshot && g_rb_managed_snapshot(S2A_RB_BENCH_MANAGED_VERSION, s.managed, RB_WORDS)) memset(s.managed, 0, sizeof s.managed);
+    s.at_ns = rb_now(); s.read_ns = s.at_ns - start;
+    return s;
+}
+static id rb_delta(int valid, uint64_t a, uint64_t b) { return valid && b >= a ? @(b - a) : NSNull.null; }
+static id rb_managed_delta(const rb_sample *a, const rb_sample *b, unsigned bit, unsigned i) {
+    return rb_delta((a->managed[0] & b->managed[0] & bit) != 0, a->managed[i], b->managed[i]);
+}
+static NSDictionary *rb_memory(const rb_sample *s) {
+    return @{@"metal_allocated_bytes":rb_value(s->valid & RB_METAL, s->metal),
+             @"process_footprint_bytes":rb_value(s->valid & RB_FOOTPRINT, s->footprint),
+             @"process_compressed_logical_bytes":rb_value(s->valid & RB_COMPRESSED, s->compressed),
+             @"graphics_ledger_footprint_bytes":rb_value(s->valid & RB_GRAPHICS, s->graphics),
+             @"graphics_ledger_compressed_bytes":rb_value(s->valid & RB_GRAPHICS_COMPRESSED, s->graphics_compressed),
+             @"gpu_resident_physical_bytes":NSNull.null};
+}
+static NSDictionary *rb_gc(const rb_sample *a, const rb_sample *b) {
+    id p = rb_managed_delta(a, b, RB_BM_HAS_GC, RB_BM_GC_PAUSE_US);
+    id g0 = rb_managed_delta(a, b, RB_BM_HAS_GC, RB_BM_GC0);
+    id g2 = rb_managed_delta(a, b, RB_BM_HAS_GC, RB_BM_GC2);
+    double span = b->at_ns > a->at_ns ? rb_seconds(b->at_ns - a->at_ns) : 0;
+    int valid = p != NSNull.null && g0 != NSNull.null && g2 != NSNull.null && span > 0;
+    double duty = valid ? [p doubleValue] / (span * 1e6) : 0;
+    // Detection thresholds selected to expose the pressure reported for IPA796
+    // (~3% cumulative pause plus a collection avalanche), not to infer causality.
+    NSMutableArray<NSString *> *roles = [NSMutableArray array];
+    if (valid && duty >= 0.02) [roles addObject:@"pause_fraction"];
+    if (valid && [g0 doubleValue] * 10.0 / span >= 100.0) [roles addObject:@"gen0_rate"];
+    if (valid && [g2 doubleValue] * 10.0 / span >= 10.0) [roles addObject:@"gen2_rate"];
+    return @{@"allocated_bytes":rb_managed_delta(a,b,RB_BM_HAS_GC,RB_BM_ALLOC_BYTES),
+             @"gen0":g0,
+             @"gen1":rb_managed_delta(a,b,RB_BM_HAS_GC,RB_BM_GC1), @"gen2":g2,
+             @"pause_ms":p == NSNull.null ? p : @([p doubleValue] / 1000.0),
+             @"pause_fraction":valid ? @(duty) : NSNull.null,
+             @"pressure_alert":valid ? rb_bool(roles.count != 0) : NSNull.null,
+             @"pressure_alert_roles":valid ? roles : (id)NSNull.null,
+             @"threshold_version":@1,
+             @"thresholds":@{@"pause_fraction":@0.02,@"gen0_per_10s":@100,@"gen2_per_10s":@10}};
+}
+static NSDictionary *rb_audio(const rb_sample *a, const rb_sample *b) {
+    int valid = (a->managed[0] & b->managed[0] & RB_BM_HAS_AUDIO) != 0;
+    int seen = valid && (b->managed[RB_BM_AUDIO_CALLBACKS] > a->managed[RB_BM_AUDIO_CALLBACKS] ||
+        a->managed[RB_BM_AUDIO_ACTIVE_OUTPUTS] || b->managed[RB_BM_AUDIO_ACTIVE_OUTPUTS] ||
+        b->managed[RB_BM_AUDIO_SESSIONS_SEEN] > a->managed[RB_BM_AUDIO_SESSIONS_SEEN]);
+    id gap = seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_GAP_US) : NSNull.null;
+    uint64_t last = b->managed[RB_BM_AUDIO_LAST_CALLBACK_NS];
+    uint64_t since = last >= a->at_ns ? last : a->at_ns;
+    int age_known = last > 0 || (valid && b->managed[RB_BM_AUDIO_CALLBACKS] == a->managed[RB_BM_AUDIO_CALLBACKS]);
+    return @{@"observed_output":rb_bool(seen), @"gap_estimate_ms":gap == NSNull.null ? gap : @([gap doubleValue] / 1000.0),
+             @"underruns":seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_UNDERRUNS) : NSNull.null,
+             @"pauses":seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_PAUSES) : NSNull.null,
+             @"late_bursts":seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_LATE_BURSTS) : NSNull.null,
+             @"callbacks":seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_CALLBACKS) : NSNull.null,
+             @"skipped_render_periods":rb_managed_delta(a,b,RB_BM_HAS_RENDERER,RB_BM_AUDIO_SKIPPED_PERIODS),
+             @"render_period_ns":rb_value(b->managed[0] & RB_BM_HAS_RENDERER,b->managed[RB_BM_AUDIO_RENDER_PERIOD_NS]),
+             @"callback_gaps_gt100":seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_GAP_GT100) : NSNull.null,
+             @"callback_gaps_gt200":seen ? rb_managed_delta(a,b,RB_BM_HAS_AUDIO,RB_BM_AUDIO_GAP_GT200) : NSNull.null,
