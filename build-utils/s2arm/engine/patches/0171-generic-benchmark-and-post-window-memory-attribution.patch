+static BOOL rb_vm_leaf(RBVMAudit *s, vm_address_t address, vm_size_t size,
+    const vm_region_submap_info_data_64_t *info, mach_msg_type_number_t count)
+{
+    unsigned side = RB_VM_UNKNOWN;
+    if (s->guest_bounds_known) {
+        uint64_t end = address + size; // caller checked arithmetic first
+        side = address >= s->guest_end || end <= s->guest_begin ? RB_VM_OUTSIDE :
+            address >= s->guest_begin && end <= s->guest_end ? RB_VM_INSIDE : RB_VM_CROSSING;
+    }
+    unsigned bucket = side * 2 + (info->external_pager ? 1 : 0);
+    NSNumber *tag = @((uint32_t)info->user_tag); // all tags, including 32 and >255
+    NSMutableData *storage = s->tags[tag];
+    if (!storage) {
+        storage = [NSMutableData dataWithLength:RB_VM_SIDES * 2 * sizeof(rb_vm_counts)];
+        if (!storage) return NO;
+        s->tags[tag] = storage;
+    }
+    rb_vm_counts *by_category = storage.mutableBytes;
+    rb_vm_counts add = {0};
+    add.n[RB_VM_REGIONS] = 1;
+    add.n[RB_VM_VIRTUAL_BYTES] = size;
+    add.n[RB_VM_RESIDENT_PAGES] = info->pages_resident;
+    add.n[RB_VM_COMPRESSED_PAGES] = info->pages_swapped_out;
+    add.n[RB_VM_DIRTY_PAGES] = info->pages_dirtied;
+    add.n[RB_VM_PRIVATE_PAGES] = info->pages_shared_now_private;
+    add.n[RB_VM_REUSABLE_UNKNOWN] = 1;
+#if defined(VM_REGION_SUBMAP_INFO_V1_COUNT_64)
+    if (count >= VM_REGION_SUBMAP_INFO_V1_COUNT_64) {
+        add.n[RB_VM_REUSABLE_PAGES] = info->pages_reusable;
+        add.n[RB_VM_REUSABLE_UNKNOWN] = 0;
+    }
+#endif
+    if (!rb_vm_counts_fit(&s->total, &add) || !rb_vm_counts_fit(&by_category[bucket], &add) ||
+        s->share_modes[info->share_mode] == UINT64_MAX || s->leaves == UINT64_MAX) {
+        s->counter_overflow = YES;
+        return NO;
+    }
+    rb_vm_counts_add(&s->total, &add);
+    rb_vm_counts_add(&by_category[bucket], &add);
+    s->share_modes[info->share_mode]++;
+    s->leaves++;
+    return YES;
+}
