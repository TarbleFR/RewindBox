+
+// Strong implementation of the benchmark's optional post-window hook. The
+// caller must have closed its timed score before calling. Copies id before
+// returning; no VM query, wait, or guest-memory read runs on the caller.
+// S2A_RB_BENCH=0 or S2A_RB_VM_FULL_AUDIT=0 disables this work entirely.
+// S2A_RB_VM_TAGS=0 remains the master off switch for VM walks.
+void s2a_rb_bench_after_window(const char *id);
+
+// 1 from accepted request until its final JSON record has been emitted.
+// The heartbeat may use this to avoid overlapping its old 0108 VM walk.
+// Benchmark admission must check both before and after publishing its active
+// generation; reject admission if the latter check observes an active audit.
+// An already-admitted legacy walk is allowed to finish on its own queue; this
+// audit yields 25 ms while the optional legacy_scan_active getter remains set.
+int s2a_rb_vm_audit_active(void);
+
+// Copies only the supplied task_info result, then logs on the utility queue.
+// The caller captures generation before its Mach call, verifies it afterwards,
+// zero-initializes *info, and supplies the returned count/status. No second
+// task_info call or page scan. S2A_RB_VM_LEDGERS=0 or S2A_RB_BENCH=0 disables it.
+void s2a_rb_vm_ledgers_log(const task_vm_info_data_t *info,
+    mach_msg_type_number_t count, kern_return_t kr, unsigned generation,
+    uint64_t frame, uint64_t sample_ns);
+
+#ifdef __cplusplus
+}
+#endif
