@@ -9,3 +9,45 @@ static inline int dm_fi_should_interp(double declared_period, double gap) {
     if (!dm_fi_tier(declared_period)) return 0;
     return gap > 0 && gap <= declared_period * 1.25;
 }
+// RewindBox (patch 0421): adaptive frame interpolation for heavy 60-Hz games running at
+// 16–41 FPS (S2A_RB_FI_ALL=1 or s2a_rb_guest_set_frame_interp(2)). Uses EMA + hysteresis
+// so DisplayLink never flaps, and computes an effective period for MetalFX pacing without
+// altering guest simulation speed.
+typedef struct {
+    double ema_gap;
+    unsigned slow_run, fast_run;
+    int engaged;
+} dm_fi_adaptive;
+static inline void dm_fi_adaptive_reset(dm_fi_adaptive *st) {
+    if (!st) return;
+    st->ema_gap = 0; st->slow_run = 0; st->fast_run = 0; st->engaged = 0;
+}
+static inline int dm_fi_adaptive_observe(dm_fi_adaptive *st, double gap) {
+    if (!st) return 0;
+    if (gap >= 0.005 && gap <= 0.150) {
+        st->ema_gap = st->ema_gap > 0 ? st->ema_gap * 0.85 + gap * 0.15 : gap;
+        if (st->ema_gap >= 0.024) {
+            st->fast_run = 0;
+            if (++st->slow_run >= 8) st->engaged = 1;
+        } else if (st->ema_gap <= 0.020) {
+            st->slow_run = 0;
+            if (++st->fast_run >= 20) st->engaged = 0;
+        }
+    }
+    return st->engaged;
+}
+static inline int dm_fi_adaptive_should_interp(const dm_fi_adaptive *st, double declared_period, double gap, double *eff_period) {
+    if (dm_fi_tier(declared_period)) {
+        if (eff_period) *eff_period = declared_period;
+        return gap > 0 && gap <= declared_period * 1.45;
+    }
+    if (!st || !st->engaged || st->ema_gap <= 0) {
+        if (eff_period) *eff_period = declared_period;
+        return 0;
+    }
+    double ep = st->ema_gap;
+    if (ep < 1.0 / 36.0) ep = 1.0 / 36.0;
+    if (ep > 1.0 / 16.0) ep = 1.0 / 16.0;
+    if (eff_period) *eff_period = ep;
+    return gap > 0 && gap <= ep * 1.50;
+}
