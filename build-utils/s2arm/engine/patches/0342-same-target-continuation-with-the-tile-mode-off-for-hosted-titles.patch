+// RewindBox (patch 0342): same-target continuation with the tile mode off (rb_rt_cont.h). Hosted titles run with it off (patch 0296), and with it every SetRenderTargets of
+//   the targets already bound ended the pass: its attachments were stored whole and loaded again. IPA 830, Mario Kart World on an A18 Pro, 95 windows of 300 race frames:
+//   546 to 703 MB of attachment loads and stores a frame and 68 to 112 load-all store-all passes a frame; the 1248x700 main pass reopened 6 to 11 times a frame (IPA 824 pass
+//   profile, s2arm-pass-traffic-824.md). Upstream S2Arm took the continuation out of the tile mode (fb96ab7db, section 3: a SetRenderTargets of the same targets is no pass
+//   boundary; a draw of the continued pass that samples an attachment the pass wrote splits it). Its test of what a draw samples (draw_samples_rt) sees the bound slots only,
+//   and a hosted title reads most textures through handles in uniform buffers or tables: rb_cont_reads_rt resolves those as encode_args binds them. A pool indexed at run time
+//   (TEXP), a shader without a binding list or no program counts as reading. S2A_RB_RT_CONT=0: every SetRenderTargets ends the pass, as before
+#include "rb_rt_cont.h"
+static int rb_rt_cont_on(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("S2A_RB_RT_CONT"); v = !(e && !strcmp(e, "0"));
+        MLOG("RewindBox: same-target continuation with the tile mode off: %s (S2A_RB_RT_CONT%s)", v ? "on" : "off, every SetRenderTargets ends the pass", v ? "=0 turns it off" : "=0"); }
+    return v;
+}
+static uint64_t g_rb_cont_n, g_rb_cont_refused, g_rb_cont_split_read, g_rb_cont_split_unknown, g_rb_cont_split_tex;   // nvn_be_rt_cont_stats
+static int rb_cont_mode(void) { return !tbdr_on() && rb_rt_cont_on(); }   // the continuations of this patch (the tile mode keeps its own, with draw_samples_rt)
+static rb_cont_tex rb_cont_tid(int tid) {   // caller holds g_rmu
+    if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) return (rb_cont_tex){0, NULL};
+    return (rb_cont_tex){g_treg[tid].t.serial, g_treg[tid].t.mem};
+}
+// 1 = the draw may read an attachment whose content memory may not hold yet: a colour slot the open pass changed (g_fb_dirty; a slot loaded and not written, or not loaded
+//   and proven unwritten, is what memory holds) or the depth / stencil texture. *unknown: a binding could not be resolved (counted apart)
+static int rb_cont_reads_rt(NvProg *pr, int *unknown) {
+    *unknown = 0;
+    rb_cont_tex att[9]; int na = 0;
+    for (int k = 0; k < R.rt.n && k < 8; k++) if (R.rt.color[k] && g_fb_dirty[k]) att[na++] = (rb_cont_tex){R.rt.color[k]->serial, R.rt.color[k]->mem};
+    if (R.rt.depth) att[na++] = (rb_cont_tex){R.rt.depth->serial, R.rt.depth->mem};
+    if (!na) return 0;
+    if (!pr) { *unknown = 1; return 1; }
+    int hit = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int st = 0; st < 5 && !hit && !*unknown; st++) {
+        __unsafe_unretained NvShader *sh = pr->sh[st]; if (!sh) continue;
+        const int stage = sh->stage;
+        if (!sh->rb_explicit_bindings || stage < 0 || stage >= 6) { *unknown = 1; break; }
+        for (int i = 0; i < sh->rf.nb && !hit && !*unknown; i++) {
+            const nvn_rbind *b = &sh->rf.b[i];
+            switch (rb_cont_binding_class(b->kind, b->n)) {
+                case RB_CONT_SLOT: hit = rb_cont_hit(rb_cont_tid((int)(tex_slot_h(S.tex[stage], S.img[stage], b->reg) & 0xfffff)), att, na); break;
+                case RB_CONT_IMAGE: hit = b->reg < 32 && rb_cont_hit(rb_cont_tid((int)(S.img[stage][b->reg] & 0xfffff)), att, na); break;
+                case RB_CONT_UBO: hit = rb_cont_hit(rb_cont_tid(ubo_tex_id(ubo_packed(stage, b))), att, na); break;
+                case RB_CONT_UBO_ARRAY: for (int k = 0; k < b->n && !hit; k++) hit = rb_cont_hit(rb_cont_tid(ubo_tex_id(ubo_handle(stage, b->reg, 8 * k))), att, na); break;
+                case RB_CONT_C2_ARRAY: for (int k = 0; k < b->n && !hit; k++) hit = rb_cont_hit(rb_cont_tid((int)(c2_handle(stage, b->off + 8u * k) & 0xfffff)), att, na); break;
+                case RB_CONT_SLOTS: for (int k = 0; k < b->n && k < 128 && !hit; k++) {
+                        uint64_t hk = S.tex[stage][k] ? S.tex[stage][k] : S.tex[stage][NVN_SEPTEX_SLOT0 + k];
+                        hit = rb_cont_hit(rb_cont_tid((int)(hk & 0xfffff)), att, na); }
+                    break;
+                case RB_CONT_UNKNOWN: *unknown = 1; break;
+                default: break;
+            }
+        }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    return hit || *unknown;
+}
+static int rb_cont_external(const p_set_rt *r) {   // an attachment over display, video, linear or sparse storage (rb_cont_gate external)
+    const unsigned ext = NVN_TEXTURE_FLAGS_DISPLAY | NVN_TEXTURE_FLAGS_VIDEO_DECODE | NVN_TEXTURE_FLAGS_LINEAR | NVN_TEXTURE_FLAGS_LINEAR_RENDER_TARGET | NVN_TEXTURE_FLAGS_SPARSE;
+    for (int k = 0; k < r->n && k < 8; k++) if (r->color[k] && (r->color[k]->d.flags & ext)) return 1;
+    return r->depth && (r->depth->d.flags & ext);
+}
