diff --git a/graphics/nvn/gfx/nvn/rb_rt_cont.h b/graphics/nvn/gfx/nvn/rb_rt_cont.h
new file mode 100644
index 0000000..cebef47
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_rt_cont.h
@@ -0,0 +1,59 @@
+// RewindBox (patch 0342): same-target continuation with the tile mode off (hosted titles, patch 0296). Pure C, no Metal: the gate a SetRenderTargets of the targets already
+//   bound must pass to continue the open pass, and what a texture binding of a draw in the continued pass resolves to. nvn_mtl.m (rb_cont_reads_rt) does the lookups.
+//   Continuing needs no attachment liveness: memory never has to hold an attachment's content before the pass ends, unless a draw of the continued pass reads it. The draw
+//   that may read one is split off (the pass ends before it, as it ended at the SetRenderTargets before this patch).
+#pragma once
+#include <stdint.h>
+#include "nvn_refl.h"
+
+// How a binding of a draw names the texture it reads, as encode_args binds it
+enum {
+    RB_CONT_SKIP = 0,     // not a texture or image read: uniforms, samplers, storage and global memory (guest memory, which an attachment's tiles never reach; linear and
+                          //   other external attachments do not continue, rb_cont_gate below)
+    RB_CONT_SLOT,         // TEX / TBUF: the handle of texture slot reg (tex_slot_h)
+    RB_CONT_IMAGE,        // IMG: image slot reg
+    RB_CONT_UBO,          // a single TEXU / TBUFU / IMGU: the handle at byte off of uniform slot reg (ubo_packed)
+    RB_CONT_UBO_ARRAY,    // TEXU with n > 0: element k = the handle at byte 8k of uniform slot reg
+    RB_CONT_C2_ARRAY,     // TEXA: element k = the handle of the c2 word at byte off + 8k
+    RB_CONT_SLOTS,        // TEXD: element k = the texture of slot k (combined, else separate), k < 128
+    RB_CONT_UNKNOWN,      // TEXP: the pool indexed by an ID the shader reads at run time; cannot be resolved before the draw
+};
+static inline int rb_cont_binding_class(int kind, int n) {
+    switch (kind) {
+        case NVN_RB_TEX: case NVN_RB_TBUF: return RB_CONT_SLOT;
+        case NVN_RB_IMG: return RB_CONT_IMAGE;
+        case NVN_RB_TBUFU: case NVN_RB_IMGU: return RB_CONT_UBO;
+        case NVN_RB_TEXU: return n ? RB_CONT_UBO_ARRAY : RB_CONT_UBO;
+        case NVN_RB_TEXA: return RB_CONT_C2_ARRAY;
+        case NVN_RB_TEXD: return RB_CONT_SLOTS;
+        case NVN_RB_TEXP: return RB_CONT_UNKNOWN;
+        default: return RB_CONT_SKIP;
+    }
+}
+
+// A texture the draw reads against the attachments whose content memory may not hold yet: the same texture object (serial, any view of it) or another texture over the same
+//   storage start (mem; zero when unknown, never matched)
+typedef struct { uint64_t serial; const void *mem; } rb_cont_tex;
+static inline int rb_cont_hit(rb_cont_tex t, const rb_cont_tex *att, int n) {
+    for (int i = 0; i < n; i++)
+        if ((t.serial && t.serial == att[i].serial) || (t.mem && t.mem == att[i].mem)) return 1;
+    return 0;
+}
+
+// The SetRenderTargets gate. Anything this patch does not account for keeps ending the pass at the SetRenderTargets, as before
+typedef struct {
+    uint8_t on;              // S2A_RB_RT_CONT (default on)
+    uint8_t tile_mode;       // tbdr_on(): its own continuations, unchanged
+    uint8_t encoder_open, draw_pass, same_targets;   // g_enc; not a pass opened for clears only (g_enc_mode 1); rt_same
+    uint8_t clears_waiting;  // clears recorded for the next pass, or lazy clears (g_nlc)
+    uint8_t upgrades_waiting;   // image textures to upgrade when the next pass opens (img_fit / img_wr): a draw before that gets the dummy image
+    uint8_t layered, widen, external;   // layered pass; widescreen targets (g_wd); an attachment over display, video or linear storage
+    uint8_t next_clears;     // the next command clears: the pass ends there anyway, and the store of what it clears is skipped by the boundary path (g_rb_next_clear_mask)
+} rb_cont_gate;
+static inline int rb_cont_gate_ok(const rb_cont_gate *g) {
+    return g->on && !g->tile_mode && g->encoder_open && g->draw_pass && g->same_targets && !g->clears_waiting && !g->upgrades_waiting &&
+           !g->layered && !g->widen && !g->external && !g->next_clears;
+}
+// The scan that proves colour attachments unwritten to the pass end (pass_color_unwritten) must see the pass as long as the replay makes it: a SetRenderTargets of the same
+//   targets does not end it when continuations can happen. If the replay ends the pass there after all (a gate test fails), the proof covered more than the pass: still true
+static inline int rb_cont_scan_continues(int on, int tile_mode, int same_targets) { return on && !tile_mode && same_targets; }
