+        // A native recording snapshot carries user next to account/device. In named
+        // emulator exports, use only the identifier beside the matched title's data.
+        static string ImportProfile(List<(string kind, string dir)> areas, out bool ambiguous)
+        {
+            ambiguous = areas.Count(x => x.kind != "device") > 1 || areas.Count(x => x.kind == "device") > 1;
+            if (ambiguous) return null;
+            var area = areas.FirstOrDefault(x => x.kind != "device");
+            if (area.dir == null) return null;
+            string parent = Path.GetDirectoryName(area.dir);
+            string name = Path.GetFileName(area.dir);
+            string profile = null;
+            if (name is "account" or "save")
+            {
+                string user = Path.Combine(parent, "user");
+                if (File.Exists(user))
+                {
+                    if (new FileInfo(user).Length > 128) { ambiguous = true; return null; }
+                    profile = File.ReadAllText(user).Trim();
+                }
+            }
+            else if (area.kind == "account" && name == "0" && Hex16.IsMatch(Path.GetFileName(parent)))
+            {
+                byte[] extra = new byte[0x40];
+                using (var data = File.OpenRead(Path.Combine(parent, "ExtraData0"))) data.ReadExactly(extra);
+                profile = $"{BitConverter.ToUInt64(extra, 8):x16}{BitConverter.ToUInt64(extra, 16):x16}";
+            }
+            else if (area.kind == "account" && Hex16.IsMatch(name) && Hex32.IsMatch(Path.GetFileName(parent)))
+            {
+                profile = Path.GetFileName(parent);
+            }
+            if (profile == null) return null;
+            if (Hex32.IsMatch(profile) && profile.Any(c => c != '0')) return profile.ToLowerInvariant();
+            ambiguous = true;
+            return null;
+        }
