+static void rb_args_program_changed(int first, int end) {
+    if (rb_args_ubo_mode() != RB_ARGS_MODE_ON) {
+        args_dirty_all();
+        rb_args_cause_all(RB_ARGS_C_PROGRAM);
+        return;
+    }
+    for (int st = first; st < end; st++) {
+        g_rb_args_prog[st] = 1;
+        rb_args_cause(st, RB_ARGS_C_PROGRAM);
+    }
