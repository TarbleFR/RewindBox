+        static string PatchSlice(string src, int st, int end, List<(int Start, int End, string Repl)> edits, int firstPop)
+        {
+            int cap = end - st;
+            for (int e = firstPop; e < edits.Count; e++) cap += edits[e].Repl.Length - (edits[e].End - edits[e].Start);
+            var sb = new StringBuilder(Math.Max(cap, 0));
+            int cur = st;
+            for (int e = edits.Count - 1; e >= firstPop; e--)
+            {
+                var (es, ee, er) = edits[e];
+                if (es > cur) sb.Append(src, cur, es - cur);
+                sb.Append(er);
+                cur = ee;
+            }
+            if (end > cur) sb.Append(src, cur, end - cur);
+            return sb.ToString();
+        }
+        /// <summary>Apply non-overlapping reverse-ordered edits to src in a single O(L) pass.</summary>
+        static string ApplyEdits(string src, List<(int Start, int End, string Repl)> edits)
+        {
