+// RewindBox (patch 0319): the no-lock guard for a game that alternates intervals 1 and 2 (rb_adaptive_drs.h, rb_drs_escape_step). The bridge sets
+//   S2A_RB_DRS_NO_LOCK=1 for Mario Kart World. hle_nvn.c provides the interval of the game's last present.
+__attribute__((weak)) int nvn_rb_game_interval(void) { return 1; }
+static int rb_drs_guard_on(void) {
+    static int v = -1;   // completion handlers; the same value whoever reads it first
+    if (v < 0) {
+        const char *e = getenv("S2A_RB_DRS_NO_LOCK");
+        v = e && !strcmp(e, "1");
+        MLOG("[rb-guest-drs] no-lock guard %s (S2A_RB_DRS_NO_LOCK; patch 0319): no push below Serious, runs of fewer than %d frames past the 60 fps hold read the hold, "
+             "interval 2 reads the 60 fps hold until the game is back at 1 (%d frames at most, a rest of %d to %d frames after %d failures or a growing scene)",
+             v ? "on" : "off", RB_DRS_SPIKE_RUN, RB_DRS_ESCAPE_FRAMES, RB_DRS_ESCAPE_REST, RB_DRS_ESCAPE_REST_MAX, RB_DRS_ESCAPE_FAILS);
+    }
+    return v;
+}
+static rb_drs_escape g_rb_drs_escape;   // g_rb_floor_lock
+static _Atomic uint64_t g_rb_drs_over[DRS_N];   // by frame: the frame + 1 once one of its reports went past the 60 fps hold
+static _Atomic uint64_t g_rb_drs_spikes;   // reports past the hold that read it (rb_drs_spike_pass)
+static unsigned rb_drs_over_before(uint64_t f) {   // how many frames right before f went past the 60 fps hold, up to RB_DRS_SPIKE_RUN - 1
+    unsigned n = 0;
+    while (n + 1 < RB_DRS_SPIKE_RUN && f > n &&
+           atomic_load_explicit(&g_rb_drs_over[(f - 1 - n) % DRS_N], memory_order_relaxed) == f - n) ++n;
+    return n;
+}
+static int rb_drs_escape_now(uint64_t f) {
+    int allowed = atomic_load_explicit(&g_drs_state, memory_order_relaxed) < 3 && fps_override() <= 0 &&
+                  nvn_fps_limit() != 30 && !nvn_rb_video_paced();
+    int itv = nvn_rb_game_interval();
+    uint64_t px = rb_drs_scene_px(f);
+    os_unfair_lock_lock(&g_rb_floor_lock);
+    uint64_t escapes = g_rb_drs_escape.escapes, rests = g_rb_drs_escape.rests;
+    int on = rb_drs_escape_step(&g_rb_drs_escape, f, itv, px, allowed);
+    rb_drs_escape e = g_rb_drs_escape;
+    os_unfair_lock_unlock(&g_rb_floor_lock);
+    if ((e.escapes != escapes && (e.escapes <= 8 || !(e.escapes & (e.escapes - 1)))) || e.rests != rests)
+        MLOG("[rb-guest-drs] escape frame=%llu escapes=%llu returns=%llu fails=%llu ramps=%llu rests=%llu rest=%llu scene_px=%llu",
+             (unsigned long long)f, (unsigned long long)e.escapes, (unsigned long long)e.returns, (unsigned long long)e.fails,
+             (unsigned long long)e.ramps, (unsigned long long)e.rests, (unsigned long long)e.rest, (unsigned long long)px);
+    return on;
+}
+// A report past the frame's hold (or push): the frame's own time, except under the guard at 60 fps while fewer than RB_DRS_SPIKE_RUN frames in a row went past the 60 fps hold
+static uint64_t rb_drs_past(uint64_t f, uint64_t t, uint64_t top, uint64_t want, int spikes) {
+    if (!spikes || rb_drs_spike_pass(rb_drs_over_before(f))) return t;
+    uint64_t n = atomic_fetch_add_explicit(&g_rb_drs_spikes, 1, memory_order_relaxed) + 1;
+    if (!(n & (n - 1)) && n >= 16)
+        MLOG("[rb-guest-drs] spike reports=%llu frame=%llu ms=%.2f read_ms=%.2f", (unsigned long long)n, (unsigned long long)f,
+             (t - top) * (625./12e6), want * (625./12e6));
+    return top + want;
+}
