 }
+// RewindBox (patch 0319): a game that alternates present intervals 1 and 2 (Mario Kart World; the
+// bridge sets S2A_RB_DRS_NO_LOCK=1 for it) never settles at 30 fps. IPA 825, iPhone 16 Pro Max at
+// Fair, frame rate setting "no limit" in all four sessions: within six frames of a frame that read
+// more than 16.67 ms the game asked for interval 2 in 19 to 36 % of cases, after one in its band in
+// 4 to 7 %. Those reads were resolution pushes (18.675 and 20.5 ms) and runs of one or two slow
+// frames (17 of 31 runs in frames 6279-7300 of the first session). Held a second at interval 2, the engine went to its 30 fps
+// hold and the system ran the GPU slower at that pace: the game read 33 to 40 ms and stayed at 30 fps
+// (17 to 22 during a screen recording) until a trial or a relaunch. The guard:
+//   - no push at Nominal or Fair (rb_drs_guard_level); the game still lowers its size from the slow
+//     frames it reads, and Serious and Critical keep their pushes;
+//   - a frame past the 60 fps hold reads the hold unless the RB_DRS_SPIKE_RUN - 1 frames before it
+//     went past it too (rb_drs_spike_pass): a shader compile or an upload no longer reads as a slow GPU;
+//   - when the game moves to interval 2, its reports read the 60 fps hold (rb_drs_cap_ticks) until it
+//     is back at interval 1 (rb_drs_escape_step). In the first session a game at interval 2 for three
+//     to five frames reading 16.6 ms came back without changing its size (frames 6601 and 6900); after
+//     a long stay at interval 2 the same reads grew the scene from 1248x700 to 1300x728 in 28 frames
+//     (trial at frame 7184), each step remaking 17 to 28 shared textures. An escape therefore ends when
+//     the scene grows, after RB_DRS_ESCAPE_FRAMES frames without an answer, or when the game is back at
+//     interval 1. A game back at 2 within RB_DRS_ESCAPE_SETTLE frames counts a failure; a timeout waits
+//     RB_DRS_ESCAPE_RETRY frames; RB_DRS_ESCAPE_FAILS failures in a row or a growing scene rest the
+//     escapes RB_DRS_ESCAPE_REST frames, twice as long each time up to RB_DRS_ESCAPE_REST_MAX. While
+//     they rest the hold follows the engine's target as before, and the trial above still runs.
+enum { RB_DRS_SPIKE_RUN = 3 };
+enum { RB_DRS_ESCAPE_FRAMES = 12, RB_DRS_ESCAPE_SETTLE = 60, RB_DRS_ESCAPE_FAILS = 3, RB_DRS_ESCAPE_RETRY = 30,
+       RB_DRS_ESCAPE_REST = 90, RB_DRS_ESCAPE_REST_MAX = 360 };
+// The level the reports use under the guard: none below Serious.
+static inline unsigned rb_drs_guard_level(int guard, int serious, unsigned level) {
+    return guard && !serious ? 0u : level;
+}
+// Whether a frame past the 60 fps hold reads its own time; over_before: the frames right before it
+// that went past the hold too.
+static inline int rb_drs_spike_pass(unsigned over_before) {
+    return over_before + 1 >= RB_DRS_SPIKE_RUN;
+}
+// The ticks after a frame's first TIMESTAMP_TOP that a report of `ticks` reads under the 60 fps hold
+// whatever its time (the trial of patch 0309 and the escape): its own time in the frame's first half.
+static inline uint64_t rb_drs_cap_ticks(uint64_t ticks, uint64_t hold60) {
+    return ticks < hold60 / 2 ? ticks : hold60;
+}
+typedef struct {
+    uint64_t seen, until, back_at, at1, next_at, rest, start_px;   // seen, until, back_at, at1: a frame + 1
+    uint64_t escapes, returns, fails, ramps, rests;
+    unsigned fail_run;
+    int decision;
+} rb_drs_escape;
+static inline void rb_drs_escape_fail(rb_drs_escape *s, uint64_t frame, int grew, uint64_t wait) {
+    ++s->fails;
+    if (grew) ++s->ramps;
+    if (grew || ++s->fail_run >= RB_DRS_ESCAPE_FAILS) {
+        s->rest = !s->rest ? RB_DRS_ESCAPE_REST : s->rest * 2 < RB_DRS_ESCAPE_REST_MAX ? s->rest * 2 : RB_DRS_ESCAPE_REST_MAX;
+        s->next_at = frame + s->rest; s->fail_run = 0; ++s->rests;
+    } else {
+        s->next_at = frame + wait;
+    }
+}
+// Whether the reports of `frame` read the 60 fps hold whatever their time. itv: the interval of the
+// game's last present. pixels: the frame's scene (0 = not known). allowed: the guard is on, no user
+// limit of 30, no video pacing, not Critical. Only interval 2 is escaped: 3 and more are a choice.
+// RB_DRS_ESCAPE_SETTLE frames in a row below interval 2, for whatever reason, clear the failures, the
+// rest and its length.
+static inline int rb_drs_escape_step(rb_drs_escape *s, uint64_t frame, int itv, uint64_t pixels, int allowed) {
+    if (s->seen == frame + 1) return s->decision;
+    s->seen = frame + 1;
+    if (!allowed) { s->until = s->back_at = 0; return s->decision = 0; }
+    if (itv != 2) {
+        if (s->until) {
+            s->until = 0;
+            if (itv < 2) { ++s->returns; s->back_at = frame + 1; }
+        }
+        if (itv < 2) {
+            if (!s->at1) s->at1 = frame + 1;
+            if (frame + 1 - s->at1 >= RB_DRS_ESCAPE_SETTLE) { s->back_at = 0; s->fail_run = 0; s->rest = 0; s->next_at = 0; }
+        } else {
+            s->at1 = 0;
+        }
+        return s->decision = 0;
+    }
+    s->at1 = 0;
+    if (s->until) {
+        const int grew = pixels && s->start_px && pixels * 100 > s->start_px * 101;
+        if (frame + 1 < s->until && !grew) return s->decision = 1;
+        s->until = 0;
+        rb_drs_escape_fail(s, frame, grew, RB_DRS_ESCAPE_RETRY);
+        return s->decision = 0;
+    }
+    if (s->back_at) { s->back_at = 0; rb_drs_escape_fail(s, frame, 0, 0); }   // back at 2 before it settled at 1
+    if (frame < s->next_at) return s->decision = 0;
+    s->until = frame + 1 + RB_DRS_ESCAPE_FRAMES; s->start_px = pixels; ++s->escapes;
+    return s->decision = 1;
+}
