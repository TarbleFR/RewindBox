+// including control data past the key's 0x48 bytes. The live program address and
+// relocated record size are explicitly excluded by nvn2_key.
+static int rb_stage_same_live(const char *path, const uint32_t expected[4], const uint8_t *live) {
+    int fd = open(path, O_RDONLY | O_NONBLOCK);
+    if (fd < 0) return 0;
+    uint32_t h[4];
+    uint8_t control[NVN2_CTL_COPY], chunk[4096];
+    int ok = rb_stage_header(fd,h) && !memcmp(h,expected,sizeof h) && h[2] >= 0xd8 &&
+             h[2] <= sizeof control && rb_stage_read(fd,control,h[2]);
