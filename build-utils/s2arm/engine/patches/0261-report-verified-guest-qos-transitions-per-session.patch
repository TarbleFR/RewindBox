diff --git a/runtime/src/rb_guest_heat.h b/runtime/src/rb_guest_heat.h
index e949fad..d7f93c0 100644
--- a/runtime/src/rb_guest_heat.h
+++ b/runtime/src/rb_guest_heat.h
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: Apache-2.0
 #pragma once
 #include <stdint.h>
+#include <stdatomic.h>
 
 typedef struct { int secondary, reduced; } rb_guest_heat_role;
 
@@ -18,3 +19,22 @@ static inline int rb_guest_heat_change(rb_guest_heat_role *role, int hot) {
     role->reduced = hot;
     return hot ? 1 : -1;
 }
+
+// Each completed set_qos() has one owner and one outcome. The sum of verified
+// and failed is the number of attempts with readback, even during a snapshot.
+typedef struct { _Atomic uint64_t outcome[2][2]; } rb_guest_heat_counts;
+typedef struct { uint64_t verified, failed; } rb_guest_heat_result;
+static inline void rb_guest_heat_record(rb_guest_heat_counts *counts, int change, int verified) {
+    atomic_fetch_add_explicit(&counts->outcome[change<0][!!verified],1,memory_order_relaxed);
+}
+static inline rb_guest_heat_result rb_guest_heat_read(rb_guest_heat_counts *counts, unsigned restore) {
+    return (rb_guest_heat_result){
+        atomic_load_explicit(&counts->outcome[restore][1],memory_order_relaxed),
+        atomic_load_explicit(&counts->outcome[restore][0],memory_order_relaxed)
+    };
+}
+// Called before guest thread creation, after all owners of the last session have retired.
+static inline void rb_guest_heat_counts_reset(rb_guest_heat_counts *counts) {
+    for (unsigned i=0;i<2;i++) for (unsigned j=0;j<2;j++)
+        atomic_store_explicit(&counts->outcome[i][j],0,memory_order_relaxed);
+}
diff --git a/runtime/src/thread.c b/runtime/src/thread.c
index a2bbd9d..41ea336 100644
--- a/runtime/src/thread.c
+++ b/runtime/src/thread.c
@@ -866,9 +866,42 @@ static _Atomic unsigned rb_guest_down, rb_guest_up;
 static _Thread_local rb_guest_heat_role rb_heat_role;
 static _Thread_local int rb_frame_role;
 static _Thread_local uint64_t rb_qos_retry;
+static _Atomic int rb_heat_stats_enabled;
+static _Atomic int rb_heat_last_state=-1; // only the title/device/backend monitor publishes here
+static rb_guest_heat_counts rb_heat_counts;
+static pthread_mutex_t rb_heat_report_mu=PTHREAD_MUTEX_INITIALIZER;
+static void rb_guest_heat_stats_begin(void) {
+    const char *title=getenv("S2A_RB_DIRECT_GAME_ID"), *policy=getenv("S2A_RB_GUEST_QOS_THERMAL");
+    const char *stats=getenv("S2A_RB_GUEST_QOS_STATS");
+    int enabled=s2a_rb_guest_on() && title && !strcasecmp(title,"0400C3F00006E000") &&
+        (!policy || !strcmp(policy,"1")) && (!stats || !strcmp(stats,"1"));
+    pthread_mutex_lock(&rb_heat_report_mu);
+    rb_guest_heat_counts_reset(&rb_heat_counts);
+    atomic_store_explicit(&rb_heat_stats_enabled,enabled,memory_order_release);
+    pthread_mutex_unlock(&rb_heat_report_mu);
+}
+// Periodic reports use the existing frame sampler. Shutdown may emit an early
+// snapshot on a fatal exit; "joined" is final and deactivates this session.
+void s2a_guest_heat_stats_report(const char *phase, uint64_t frame) {
+    if (!atomic_load_explicit(&rb_heat_stats_enabled,memory_order_acquire)) return;
+    pthread_mutex_lock(&rb_heat_report_mu);
+    int thermal=atomic_load_explicit(&rb_heat_last_state,memory_order_relaxed);
+    if (atomic_load_explicit(&rb_heat_stats_enabled,memory_order_relaxed) && thermal>=0) {
+        rb_guest_heat_result down=rb_guest_heat_read(&rb_heat_counts,0), up=rb_guest_heat_read(&rb_heat_counts,1);
+        LOG("[RB-GUEST-QOS-STATS] phase=%s frame=%llu thermal=%d "
+            "down_attempted=%llu down_verified=%llu down_failed=%llu "
+            "restore_attempted=%llu restore_verified=%llu restore_failed=%llu",
+            phase,(unsigned long long)frame,thermal,(unsigned long long)(down.verified+down.failed),
+            (unsigned long long)down.verified,(unsigned long long)down.failed,
+            (unsigned long long)(up.verified+up.failed),(unsigned long long)up.verified,(unsigned long long)up.failed);
+    }
+    if (!strcmp(phase,"joined")) atomic_store_explicit(&rb_heat_stats_enabled,0,memory_order_release);
+    pthread_mutex_unlock(&rb_heat_report_mu);
+}
 
