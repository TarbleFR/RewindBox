-    if (set_qos(change > 0 ? QOS_CLASS_USER_INITIATED : QOS_CLASS_USER_INTERACTIVE)) {
+    int verified=set_qos(change > 0 ? QOS_CLASS_USER_INITIATED : QOS_CLASS_USER_INTERACTIVE);
+    if (atomic_load_explicit(&rb_heat_stats_enabled,memory_order_relaxed))
+        rb_guest_heat_record(&rb_heat_counts,change,verified);
+    if (verified) {
         rb_heat_role = next;
         rb_qos_retry = 0;
         if (rb_frame_role) rb_heat_role.secondary = 0;
@@ -1258,6 +1294,7 @@ uint32_t s2a_thread_main_init(void) {
     if (!t->handle) die("主线程句柄分配失败");
