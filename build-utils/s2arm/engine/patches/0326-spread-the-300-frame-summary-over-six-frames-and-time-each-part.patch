diff --git a/graphics/nvn/gfx/nvn/rb_report_spread.h b/graphics/nvn/gfx/nvn/rb_report_spread.h
new file mode 100644
index 0000000..1333b24
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_report_spread.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0326): the 300-frame summary in parts, one part a frame. Pure C: tests/t_rb_report_spread.c.
+//   IPA 827 (Mario Kart World, iPhone 16 Pro Max): the frame hook ran the whole summary (nvn_be_mem_stat, then tsummary) inside one present call. In the second session 21 of the
+//   26 window boundaries were long frames, 58 to 126 ms in a race (frames 4200 and 4800: 115.8 and 125.7 ms, 110 and 122 ms of them the presenting thread's CPU), and still
+//   23 to 34 ms out of a race at 3.2 to 3.8 GHz. The work stays on the presenting thread: nvn_be_mem_stat lets shared textures go between two submissions (alias_orphan_pass,
+//   rb_reuse_report) and takes the locks the submit path takes (g_rmu, g_smu, g_mu, g_res_mu), and tsummary reads that thread's own policy and windows. It is cut in
+//   RB_REPORT_PARTS parts instead, RB_REPORT_STRIDE frames apart, each one timed. A part keeps a window of exactly RB_REPORT_PERIOD frames and its lines keep the boundary
+//   frame they are named after (a multiple of RB_REPORT_PERIOD); only the timing part runs on the boundary itself, so its percentile windows are the frames they were.
+//   S2A_RB_REPORT_SPREAD=0: one block on the boundary frame, as before.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_REPORT_PERIOD = 300, RB_REPORT_STRIDE = 4 };
+// The parts, in the order they run. TIMING: tsummary less its power lines. POWER: power_line. The other four are nvn_be_mem_stat's.
+enum { RB_REPORT_TIMING, RB_REPORT_POWER, RB_REPORT_ORPHANS, RB_REPORT_COUNTS, RB_REPORT_REUSE, RB_REPORT_MEMORY, RB_REPORT_PARTS };
+// nvn_be_mem_stat's parts as nvn_be_mem_stat_part takes them: the unreferenced shared textures (alias_orphan_pass), the counter lines, the reuse pools and read-ahead
+// lines (rb_reuse_report lets idle kept textures go), and the capped memory line with what follows it.
+enum { RB_REPORT_MEM_ORPHANS = 1, RB_REPORT_MEM_COUNTS = 2, RB_REPORT_MEM_REUSE = 4, RB_REPORT_MEM_MEMORY = 8,
+       RB_REPORT_MEM_ALL = RB_REPORT_MEM_ORPHANS | RB_REPORT_MEM_COUNTS | RB_REPORT_MEM_REUSE | RB_REPORT_MEM_MEMORY };
+_Static_assert((RB_REPORT_PARTS - 1) * RB_REPORT_STRIDE < RB_REPORT_PERIOD, "the parts of one window end before the next boundary");
+
+// Whether `part` runs in the present that made the frame count `frame` (the count after the present, 1 for the first). spread 0: every part on the boundary.
+static inline int rb_report_due(uint64_t frame, unsigned part, int spread) {
+    if (part >= RB_REPORT_PARTS || frame < RB_REPORT_PERIOD) return 0;
+    return frame % RB_REPORT_PERIOD == (spread ? (uint64_t)part * RB_REPORT_STRIDE : 0);
+}
+// The boundary frame the part's lines are named after when it runs at `frame`.
+static inline uint64_t rb_report_label(uint64_t frame) { return frame - frame % RB_REPORT_PERIOD; }
+// The nvn_be_mem_stat bit of a part (0 for the two tsummary parts).
+static inline unsigned rb_report_mem_bit(unsigned part) {
+    return part == RB_REPORT_ORPHANS ? RB_REPORT_MEM_ORPHANS : part == RB_REPORT_COUNTS ? RB_REPORT_MEM_COUNTS :
+           part == RB_REPORT_REUSE ? RB_REPORT_MEM_REUSE : part == RB_REPORT_MEMORY ? RB_REPORT_MEM_MEMORY : 0;
+}
+// What the parts of one window took: wall clock and the thread's CPU time, in ns. `done`: one bit a part noted.
+typedef struct { uint64_t label, wall_ns[RB_REPORT_PARTS], cpu_ns[RB_REPORT_PARTS]; unsigned done; } rb_report_cost;
+// A part of the window `label` took wall_ns / cpu_ns. Returns 1 when this was the window's last part: the cost line is due.
+static inline int rb_report_cost_note(rb_report_cost *c, uint64_t label, unsigned part, uint64_t wall_ns, uint64_t cpu_ns) {
+    if (part >= RB_REPORT_PARTS) return 0;
+    if (c->label != label || part == RB_REPORT_TIMING) { memset(c, 0, sizeof *c); c->label = label; }   // a window begins with its first part (a session may have ended between two)
+    c->wall_ns[part] += wall_ns; c->cpu_ns[part] += cpu_ns; c->done |= 1u << part;
+    return part == RB_REPORT_PARTS - 1;
+}
+static inline uint64_t rb_report_cost_wall(const rb_report_cost *c) { uint64_t s = 0; for (unsigned i = 0; i < RB_REPORT_PARTS; ++i) s += c->wall_ns[i]; return s; }
+static inline uint64_t rb_report_cost_cpu(const rb_report_cost *c) { uint64_t s = 0; for (unsigned i = 0; i < RB_REPORT_PARTS; ++i) s += c->cpu_ns[i]; return s; }
+// The longest part: what one frame pays at most when the parts are spread.
+static inline uint64_t rb_report_cost_worst(const rb_report_cost *c) { uint64_t m = 0; for (unsigned i = 0; i < RB_REPORT_PARTS; ++i) if (c->wall_ns[i] > m) m = c->wall_ns[i]; return m; }
+// How many parts the window has noted (RB_REPORT_PARTS for a whole one; fewer after a session that began between two parts).
+static inline unsigned rb_report_cost_parts(const rb_report_cost *c) { unsigned n = 0; for (unsigned i = 0; i < RB_REPORT_PARTS; ++i) n += c->done >> i & 1u; return n; }
diff --git a/graphics/nvn/tests/t_rb_report_spread.c b/graphics/nvn/tests/t_rb_report_spread.c
new file mode 100644
index 0000000..7de4fa4
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_report_spread.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0326): host-only checks of the 300-frame summary's schedule and cost record (gfx/nvn/rb_report_spread.h).
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../gfx/nvn/rb_report_spread.h"
+
+int main(void) {
+    // S2A_RB_REPORT_SPREAD=0: every part on the boundary frame and on no other, as the frame hook's own tests (g_frame % 300 == 0, frame counts from 1).
+    for (uint64_t f = 1; f <= 3000; ++f)
+        for (unsigned p = 0; p < RB_REPORT_PARTS; ++p) {
+            assert(rb_report_due(f, p, 0) == (f % 300 == 0));
+            if (rb_report_due(f, p, 0)) assert(rb_report_label(f) == f);
+        }
+    // Spread: each part once a window, RB_REPORT_PERIOD frames after its last run, never two parts in one frame, none before frame 300, in the order of the enum,
+    // RB_REPORT_STRIDE frames apart, each named after the boundary just passed; the timing part on the boundary itself.
+    uint64_t last[RB_REPORT_PARTS] = {0}, runs[RB_REPORT_PARTS] = {0};
+    unsigned expect = 0;
+    for (uint64_t f = 1; f <= 3000; ++f) {
+        unsigned due = 0, which = 0;
+        for (unsigned p = 0; p < RB_REPORT_PARTS; ++p) if (rb_report_due(f, p, 1)) { ++due; which = p; }
+        assert(due <= 1);
+        if (!due) continue;
+        assert(f >= RB_REPORT_PERIOD && which == expect);
+        expect = (expect + 1) % RB_REPORT_PARTS;
+        assert(rb_report_label(f) % RB_REPORT_PERIOD == 0 && rb_report_label(f) + which * RB_REPORT_STRIDE == f);
+        if (last[which]) assert(f - last[which] == RB_REPORT_PERIOD);
+        last[which] = f; ++runs[which];
+        if (which == RB_REPORT_TIMING) assert(f % RB_REPORT_PERIOD == 0);
+    }
+    for (unsigned p = 0; p < RB_REPORT_PARTS; ++p) assert(runs[p] == 3000 / RB_REPORT_PERIOD || (runs[p] == 3000 / RB_REPORT_PERIOD - 1 && p));
+    assert(runs[RB_REPORT_TIMING] == 10 && !rb_report_due(299, 0, 1) && !rb_report_due(0, 0, 1) && !rb_report_due(0, 0, 0) && !rb_report_due(8, RB_REPORT_ORPHANS, 1));
+    assert(!rb_report_due(300, RB_REPORT_PARTS, 1) && !rb_report_due(300, RB_REPORT_PARTS, 0));   // no such part
+    // The last part of a window ends before the next boundary, whatever the stride.
+    assert((RB_REPORT_PARTS - 1) * RB_REPORT_STRIDE < RB_REPORT_PERIOD);
+    // nvn_be_mem_stat's four parts are four different bits that make RB_REPORT_MEM_ALL; the two tsummary parts have none.
+    unsigned bits = 0;
+    for (unsigned p = 0; p < RB_REPORT_PARTS; ++p) { unsigned b = rb_report_mem_bit(p); assert(!(bits & b)); bits |= b; }
+    assert(bits == RB_REPORT_MEM_ALL && !rb_report_mem_bit(RB_REPORT_TIMING) && !rb_report_mem_bit(RB_REPORT_POWER) && !rb_report_mem_bit(RB_REPORT_PARTS));
+    assert(rb_report_mem_bit(RB_REPORT_ORPHANS) == RB_REPORT_MEM_ORPHANS && rb_report_mem_bit(RB_REPORT_MEMORY) == RB_REPORT_MEM_MEMORY);
+    // The cost record: the block is the sum of its parts, the worst part is what one frame pays, the line is due with the last part.
+    rb_report_cost c;
+    memset(&c, 0, sizeof c);
+    static const uint64_t wall[RB_REPORT_PARTS] = {8100000, 5000000, 22100000, 1900000, 800000, 23500000};
+    for (unsigned p = 0; p < RB_REPORT_PARTS; ++p) {
+        const int last_part = rb_report_cost_note(&c, 4800, p, wall[p], wall[p] - 100000);
+        assert(last_part == (p == RB_REPORT_PARTS - 1) && rb_report_cost_parts(&c) == p + 1);
+    }
+    assert(c.label == 4800 && rb_report_cost_wall(&c) == 61400000 && rb_report_cost_cpu(&c) == 61400000 - 6 * 100000 && rb_report_cost_worst(&c) == 23500000);
+    // A new window starts from nothing; so does the first part of a window with the same name (a session that began again between two parts).
+    assert(!rb_report_cost_note(&c, 5100, RB_REPORT_TIMING, 7, 5));
+    assert(c.label == 5100 && rb_report_cost_wall(&c) == 7 && rb_report_cost_cpu(&c) == 5 && rb_report_cost_parts(&c) == 1);
+    assert(!rb_report_cost_note(&c, 5100, RB_REPORT_POWER, 3, 2) && rb_report_cost_wall(&c) == 10);
+    assert(!rb_report_cost_note(&c, 5100, RB_REPORT_TIMING, 1, 1) && rb_report_cost_wall(&c) == 1 && rb_report_cost_parts(&c) == 1);
+    assert(rb_report_cost_note(&c, 5400, RB_REPORT_MEMORY, 9, 9) && rb_report_cost_parts(&c) == 1 && rb_report_cost_wall(&c) == 9);   // a window whose other parts never ran
+    assert(!rb_report_cost_note(&c, 5400, RB_REPORT_PARTS, 1, 1) && rb_report_cost_wall(&c) == 9);   // no such part: nothing noted
+    puts("PASS report spread: one block with the switch off, six parts 4 frames apart from the boundary on, labels, memory bits, cost of the block and of its worst part");
+    return 0;
+}
