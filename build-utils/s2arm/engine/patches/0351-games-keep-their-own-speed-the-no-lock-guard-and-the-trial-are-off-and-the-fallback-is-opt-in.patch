+// RewindBox (patch 0351): opt-in, at the maintainer's request (every Switch 2 game tried ran slower than real time on IPA 834; a game that counts its intervals runs at half
+//   speed held two vsyncs a frame at interval 1). value: S2A_RB_FALLBACK30, "1" every eligible game; on_list: S2A_RB_FALLBACK30_ON, the games it lists; off_list:
+//   S2A_RB_FALLBACK30_OFF leaves out the games it lists, and "0" every game, whatever the others say. Not asked for: off
+enum { RB_FB30_NOT_ASKED, RB_FB30_SWITCH_OFF, RB_FB30_LISTED_OFF, RB_FB30_ALL, RB_FB30_LISTED_ON };   // the last two hold
+static inline int rb_fb30_wanted(const char *value, const char *on_list, const char *off_list, const char *id) {
+    if (value && !strcmp(value, "0")) return RB_FB30_SWITCH_OFF;
+    if (rb_fb30_listed(off_list, id)) return RB_FB30_LISTED_OFF;
+    if (value && !strcmp(value, "1")) return RB_FB30_ALL;
+    return rb_fb30_listed(on_list, id) ? RB_FB30_LISTED_ON : RB_FB30_NOT_ASKED;
+}
+static inline int rb_fb30_wanted_on(int wanted) { return wanted == RB_FB30_ALL || wanted == RB_FB30_LISTED_ON; }
