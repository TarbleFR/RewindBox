diff --git a/graphics/nvn/gfx/nvn/rb_speed_meter.h b/graphics/nvn/gfx/nvn/rb_speed_meter.h
new file mode 100644
index 0000000..caaf996
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_speed_meter.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: MIT
+// RewindBox (patch 0351): the [rb-speed] line, a measurement only: nothing here changes what a game sees or when its frames go. Pure C, fed by hle_nvn.c once a present
+//   (rb_speed_frame). Tests: tests/t_rb_speed_meter.c (kept out of the repository with the local fixtures of 0332+).
+//   On IPA 834 every Switch 2 game tried ran slower than real time (the maintainer). A game that advances by the present interval it picks (Mario Kart World advances one or
+//   two vsyncs a frame, s2arm-power-wall.md and its nxnative note) loses game time on every frame that takes longer than its interval; a game that measures real time does
+//   not. The line shows both clocks the game can go by, per second of wall time: the game time at the intervals it picked (each present counts its interval, at most
+//   RB_SPEED_CLAMP vsyncs, against its real time, at most RB_SPEED_CLAMP vsyncs: a compile stall or a stay in the background is not counted; the same without the bound),
+//   and the guest clock (what nn::os ticks read). IPA 830 logs (engine 0332-0340), 300-frame windows under 45 presents/s, game time at the intervals picked against real
+//   time: Mario Kart World 0.71 median (0.52 to 0.80, 45 % of the frames at interval 1) and 0.83 (0.69 to 0.89, 32 %), Fire Emblem 0.80 (interval 2 by design), Zelda 0.47
+//   (interval 1 only). With it, the intervals picked, the time from present to present in whole vsyncs, the pacing waits and the work between presents, what the game read
+//   from its TIMESTAMP reports after the hold and before it (both on the busy GPU clock of patch 0068, S2A_RB_TS_BUSY: a game that picks its interval from that time, as
+//   Mario Kart World, keeps interval 1 while it reads under 16.67 ms however long its frames take on the CPU; IPA 834 race: frame p50 17 to 21 ms, GPU busy p50 10 to 13 ms),
+//   whether the display link or frame interpolation presented the frames, and whether the hold of patch 0349 held them
+#pragma once
+#include <stdint.h>
+
+enum { RB_SPEED_CLAMP = 4 };   // vsyncs a present counts at most (rb_fallback30.h RB_FB30_DT_MAX)
+typedef struct {
+    unsigned presents, stalls;          // presents counted; those more than RB_SPEED_CLAMP vsyncs after the one before
+    int64_t asked_mv, real_mv;          // milli-vsyncs (1/60 000 s): the intervals picked and the real time, both at most RB_SPEED_CLAMP vsyncs a present
+    uint64_t asked_all_mv, real_all_ns; // the same, without the bound
+    unsigned itv[3];                    // presents at interval 1, 2, 3 or more (0 counts as 1)
+    unsigned hist[4];                   // present to present: up to 1.25, 2.25, 3.25 vsyncs, more
+    unsigned held, linked;              // presents the hold of patch 0349 held; presents made while the display link ran
+    double waits_ms, work_ms;           // pacing waits and work between presents, summed
+    double read_ms, gpu_ms; unsigned reads;   // what the game read from its TIMESTAMP reports, and the same reports before the hold, summed over the frames known
+} rb_speed_meter;
+static inline void rb_speed_meter_reset(rb_speed_meter *m) { *m = (rb_speed_meter){0}; }
+// One present. itv: the interval the game sent it at (before any hold); real_ns: the time since the previous present (0: none, nothing counted); waits_ns: the pacing
+//   waits since then (acquire and present queue); held: the hold of patch 0349 held it; linked: the display link ran
+static inline void rb_speed_meter_add(rb_speed_meter *m, int itv, uint64_t real_ns, uint64_t waits_ns, int held, int linked) {
+    if (!real_ns) return;
+    const int a = itv < 1 ? 1 : itv;
+    const double v = (double)real_ns * 60e-9;   // vsyncs
+    m->presents++;
+    m->asked_all_mv += (uint64_t)a * 1000; m->real_all_ns += real_ns;
+    m->asked_mv += (a < RB_SPEED_CLAMP ? a : RB_SPEED_CLAMP) * 1000;
+    m->real_mv += (int64_t)((v < RB_SPEED_CLAMP ? v : RB_SPEED_CLAMP) * 1000 + 0.5);
+    m->stalls += v > RB_SPEED_CLAMP;
+    m->itv[a >= 3 ? 2 : a - 1]++;
+    m->hist[v <= 1.25 ? 0 : v <= 2.25 ? 1 : v <= 3.25 ? 2 : 3]++;
+    m->held += !!held; m->linked += !!linked;
+    m->waits_ms += waits_ns / 1e6; m->work_ms += real_ns > waits_ns ? (real_ns - waits_ns) / 1e6 : 0;
+}
+// A frame's TIMESTAMP reports: the largest time after its first TIMESTAMP_TOP the game read, and that report before the hold (ms)
+static inline void rb_speed_meter_read(rb_speed_meter *m, double read_ms, double gpu_ms) {
+    if (!(read_ms > 0)) return;
+    m->read_ms += read_ms; m->gpu_ms += gpu_ms > 0 ? gpu_ms : 0; m->reads++;
+}
+// The game time at the intervals picked, per second of real time: bounded (stalls left out) or not (0: nothing counted)
+static inline double rb_speed_meter_ratio(const rb_speed_meter *m) { return m->real_mv > 0 ? (double)m->asked_mv / (double)m->real_mv : 0; }
+static inline double rb_speed_meter_ratio_all(const rb_speed_meter *m) { return m->real_all_ns ? m->asked_all_mv * (1e9 / 60000.) / (double)m->real_all_ns : 0; }
