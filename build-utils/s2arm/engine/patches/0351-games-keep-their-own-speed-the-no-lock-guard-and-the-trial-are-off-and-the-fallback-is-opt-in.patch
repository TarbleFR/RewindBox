+// RewindBox (patch 0351): the no-lock guard of patches 0319, 0327 and 0344 is off for every game unless S2A_RB_NO_LOCK_GUARD=1, at the maintainer's request: every Switch 2
+//   game tried on IPA 834 ran slower than real time under it. Mario Kart World advances by the present interval it picks (interval x 16.67 ms a frame; the IPA 834 log of four
+//   races went at 90.5, 81.5, 65 and 62 % of real time, at interval 1 below 60 fps, where the guard kept it), and the guard's escapes and spike reads, like the trial of
+//   patch 0309, made its reports read 16.6 ms for frames that took 25 to 40 ms. Off: neither the bridge's S2A_RB_DRS_NO_LOCK=1 for Mario Kart World nor a game seen to
+//   alternate (patch 0344) turns it on and no report past the hold reads less than its own time; at interval 2 the hold is patch 0350's (at the engine's 30 it reads a frame
+//   under 16.6 ms as it is, longer ones longer, never shorter). S2A_RB_NO_LOCK_GUARD=1: the guard as in patch 0350. The trial of patch 0309 is off unless S2A_RB_DRS_TRIAL=1
+static int rb_no_lock_guard_wanted(void) {
+    static int v = -1;   // completion handlers and the presenting thread; the same value whoever reads it first
+    if (v < 0) { const char *e = getenv("S2A_RB_NO_LOCK_GUARD"); v = e && !strcmp(e, "1");
+        MLOG("[rb-guest-drs] no-lock guard of patches 0319, 0327 and 0344: %s (S2A_RB_NO_LOCK_GUARD; patch 0351)", v ? "asked for, as in patch 0350 (S2A_RB_DRS_NO_LOCK and S2A_RB_NO_LOCK_SEEN say where)" :
+             "off for every game at the maintainer's request (the speed of every game tried on IPA 834 was wrong under it): each game keeps the interval it picks; S2A_RB_NO_LOCK_GUARD=1 turns it back on"); }
+    return v;
+}
+static int rb_drs_trial_wanted(void) {
+    static int v = -1;   // completion handlers; the same value whoever reads it first
+    if (v < 0) { const char *e = getenv("S2A_RB_DRS_TRIAL"); v = e && !strcmp(e, "1");
+        MLOG("[rb-guest-drs] trial of patch 0309 (30 frames of the 60 fps hold whatever the time): %s (S2A_RB_DRS_TRIAL; patch 0351)", v ? "asked for" : "off, the reports keep their own time; S2A_RB_DRS_TRIAL=1 turns it back on"); }
+    return v;
+}
+// RewindBox (patch 0351): whether the game picks intervals 1 and 2 itself, for hle_nvn.c's fallback of patch 0349 (rb_fb30_why), which left such a game alone through the
+//   guard: the bridge's title for it (S2A_RB_DRS_NO_LOCK=1, Mario Kart World) or a game seen to alternate (patch 0344's count). Held two vsyncs a frame at interval 1, a game
+//   that advances by its interval runs at half speed. The presenting thread
+int nvn_rb_picks_own_interval(void);
+int nvn_rb_picks_own_interval(void) {
+    static int kart = -1;
+    if (kart < 0) { const char *e = getenv("S2A_RB_DRS_NO_LOCK"); kart = e && !strcmp(e, "1"); }
+    return kart || atomic_load_explicit(&g_rb_drs_alternates, memory_order_relaxed);
+}
