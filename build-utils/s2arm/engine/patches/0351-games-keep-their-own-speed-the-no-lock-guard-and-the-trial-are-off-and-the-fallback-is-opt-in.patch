+// RewindBox (patch 0351): what a frame's TIMESTAMP reports told the game, for hle_nvn.c's [rb-speed] line: the largest time after the frame's first TIMESTAMP_TOP it read
+//   (after rb_drs_hold) and the same report before the hold, by frame (completion handlers; only while the hold of patch 0083 notes the TIMESTAMP_TOP). Both are on the busy
+//   GPU clock of patch 0068 (S2A_RB_TS_BUSY: the idle time between a frame's pieces left out), so a game that picks its interval from that time (Mario Kart World) keeps
+//   interval 1 while it reads under 16.67 ms, however long its frames take on the CPU (IPA 834 race: frame p50 17 to 21 ms, GPU busy p50 10 to 13 ms)
+static struct { _Atomic uint64_t frame, read, raw; } g_rb_reads[DRS_N];   // the frame + 1; 19.2 MHz ticks
+static void rb_read_note(uint64_t f, uint32_t type, uint64_t raw, uint64_t t) {
+    if (type != 0 || !raw) return;
+    const unsigned i = (unsigned)(f % DRS_N);
+    if (atomic_load(&g_drs[i].frame) != f + 1) return;
+    const uint64_t top = atomic_load(&g_drs[i].top);
+    if (!top || raw <= top || t <= top) return;
+    if (atomic_exchange(&g_rb_reads[i].frame, f + 1) != f + 1) { atomic_store(&g_rb_reads[i].read, 0); atomic_store(&g_rb_reads[i].raw, 0); }
+    uint64_t o = atomic_load(&g_rb_reads[i].read);
+    while (t - top > o && !atomic_compare_exchange_weak(&g_rb_reads[i].read, &o, t - top)) {}
+    o = atomic_load(&g_rb_reads[i].raw);
+    while (raw - top > o && !atomic_compare_exchange_weak(&g_rb_reads[i].raw, &o, raw - top)) {}
+}
+int nvn_rb_frame_read(uint64_t f, double *read_ms, double *gpu_ms);
+int nvn_rb_frame_read(uint64_t f, double *read_ms, double *gpu_ms) {
+    const unsigned i = (unsigned)(f % DRS_N);
+    if (atomic_load(&g_rb_reads[i].frame) != f + 1) return 0;
+    *read_ms = atomic_load(&g_rb_reads[i].read) * (625. / 12e6); *gpu_ms = atomic_load(&g_rb_reads[i].raw) * (625. / 12e6);
+    return *read_ms > 0;
+}
