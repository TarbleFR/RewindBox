diff --git a/graphics/nvn/gfx/nvn/rb_adaptive_drs.h b/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
index 9daf484..a38fc7c 100644
--- a/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
+++ b/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
@@ -268,3 +268,59 @@ static inline int rb_drs_escape_step(rb_drs_escape *s, uint64_t frame, int itv,
     s->until = frame + 1 + RB_DRS_ESCAPE_FRAMES; s->start_px = pixels; ++s->escapes;
     return s->decision = 1;
 }
+// RewindBox (patch 0327): three corrections of the no-lock guard above, from the two IPA 827 sessions (Mario Kart World, iPhone 16 Pro Max at Fair). Nothing of patch 0319
+// changes: its callers hand rb_drs_escape_step another scene size and another interval, and end a trial of patch 0309 early. Each has a switch of its own, on by default.
+//   (a) The scene of a whole frame. rb_drs_escape_step decides at a frame's first report, when the replaying thread has opened only the frame's first pass with a depth
+//       buffer, the game's 64x64 environment probe: 39 of the 54 "escape" lines said scene_px=4096 and 5 said 0. "The scene grows" compared those 4,096 pixels with the
+//       873,600 of a later frame read later in its replay (ramps=2 and ramps=1 with no growth at all, each a rest at once), and from one probe to the next it saw no growth.
+//       rb_drs_scene_pick: the scene of the frame before, else of the one before that. S2A_RB_DRS_FIX_SCENE=0: the frame's own scene so far, as before.
+//   (b) A trial ends when the scene has grown. A game at interval 2 that reads the 60 fps hold takes it for half its budget and grows its scene by 4 to 8 pixels a frame
+//       until it is back at interval 1: IPA 825 went from 1248x700 to 1300x728 in the 28 frames of one trial (13 steps, each remaking 17 to 28 shared textures, and a
+//       race's black flashes follow such steps), the first IPA 827 session from 1248x700 to 1264x708 around the trial of frame 3954. Both trials of that session were
+//       answered within 5 frames (frames 3954 and 6654, the game back at interval 1 at 3959 and 6659), the escapes of short stays in 3 to 5.
+//       rb_drs_trial_ramp_step therefore leaves a trial the RB_DRS_TRIAL_RAMP_AFTER frames of an escape whatever the scene, so that no trial the game would have answered is lost (a trial is the only way out of a 30 fps lock while the escapes rest), and ends it from
+//       then on once the scene of a whole frame is more than a hundredth larger than at the trial's first frame, the rule of the escapes: an unanswered trial stops growing
+//       the scene at its 12th frame instead of its 30th, and an answered one stops capping the reports of a game that is back at interval 1 with a larger scene. Under the
+//       guard only. The trial's doubled wait applies as after any trial the game did not answer. S2A_RB_DRS_FIX_TRIAL=0: RB_DRS_TRIAL_FRAMES frames whatever the scene.
+//   (c) One-frame requests. 445 of the 487 stays at interval 2 of the first session lasted one present (318 of 379 in the second): the game was back at 1 before a report
+//       of that frame could have brought it back. Each began an escape, and the next request six to eight frames later counted "back at 2 before it settled": 50 of 51
+//       escapes failed, 17 rests a session, rest=360 from frame 1183 on, the guard resting about 4,350 of 6,848 frames. The two real stays of 83 and 85 frames (from
+//       frames 3876 and 6574) began in a rest, and the engine's target went to 30 with the hold at 33.2 ms for 60 frames each, until a trial. rb_drs_guard_itv shows the
+//       guard interval 1 until RB_DRS_ESCAPE_ARM presents in a row were sent at interval 2 (rb_drs_itv_run): a one-frame request starts nothing, counts no failure and
+//       breaks no settle; a stay is escaped from its second present, long before the second at interval 2 after which the engine's target follows it to 30.
+//       S2A_RB_DRS_FIX_BLIP=0: the game's interval as it is, as before.
+// (a) before1, before2: the scenes of the frames one and two before the frame the reports belong to (0 = not known).
+static inline uint64_t rb_drs_scene_pick(uint64_t before1, uint64_t before2) {
+    return before1 ? before1 : before2;
+}
+// (b) trial: the trial (rb_drs_trial.trials) start_px was taken in; stops: the trials the growth ended.
+enum { RB_DRS_TRIAL_RAMP_AFTER = RB_DRS_ESCAPE_FRAMES };
+typedef struct { uint64_t trial, start_px, stops; } rb_drs_trial_ramp;
+// The trial's answer for a report of `frame` after the growth stop. on: rb_drs_trial_step's answer for it. pixels: the scene of the last whole frame (0 = not known; a
+// trial whose first frame did not know it starts from the first frame that does). A stop ends the trial for rb_drs_trial_step too: no frame is before `until` from here
+// on, and this frame's other reports read its stored answer.
+static inline int rb_drs_trial_ramp_step(rb_drs_trial *s, rb_drs_trial_ramp *r, uint64_t frame, int on, uint64_t pixels) {
+    if (!on) return 0;
+    if (r->trial != s->trials) { r->trial = s->trials; r->start_px = pixels; return 1; }
+    if (!r->start_px) { r->start_px = pixels; return 1; }
+    if (frame + RB_DRS_TRIAL_FRAMES < s->until + RB_DRS_TRIAL_RAMP_AFTER) return 1;   // its first RB_DRS_TRIAL_RAMP_AFTER frames (until: the first frame + RB_DRS_TRIAL_FRAMES)
+    if (!pixels || pixels * 100 <= r->start_px * 101) return 1;
+    s->until = frame; s->decision = 0; ++r->stops;
+    return 0;
+}
+// (c) run: the presents in a row the game has sent at interval 2 so far (0 while its last one was sent at another interval).
+enum { RB_DRS_ESCAPE_ARM = 2 };
+static inline unsigned rb_drs_itv_run(unsigned run, int interval) {
+    return interval == 2 ? (run < 0xffffu ? run + 1 : run) : 0;
+}
+// The interval rb_drs_escape_step is shown: 1 for a game at interval 2 that has not yet sent RB_DRS_ESCAPE_ARM presents in a row there.
+static inline int rb_drs_guard_itv(int itv, unsigned run) {
+    return itv == 2 && run < RB_DRS_ESCAPE_ARM ? 1 : itv;
+}
+// The frames whose reports found the game at interval 2 and showed the guard 1. seen: a frame + 1. Returns the count when `frame` is a new one, else 0.
+typedef struct { uint64_t seen, frames; } rb_drs_blip;
+static inline uint64_t rb_drs_blip_note(rb_drs_blip *b, uint64_t frame, int itv_game, int itv_guard) {
+    if (itv_game == itv_guard || b->seen == frame + 1) return 0;
+    b->seen = frame + 1;
+    return ++b->frames;
+}
diff --git a/graphics/nvn/tests/t_rb_adaptive_drs.c b/graphics/nvn/tests/t_rb_adaptive_drs.c
