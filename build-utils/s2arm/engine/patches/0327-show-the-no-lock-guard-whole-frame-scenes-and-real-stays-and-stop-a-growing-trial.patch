+    puts("PASS guest DRS guard fix a: the scene of the frame before or the one before it; no ramp from the 64x64 probe, a real one ends the escape at its second step");
+    // Fix (b): a trial has the frames of an escape whatever the scene; from then on it ends once the scene of a whole frame is more than a hundredth larger than at its first frame.
+    {
+        rb_drs_trial t2 = {0};
+        rb_drs_trial_ramp ramp = {0};
+        uint64_t k = 1000, c2 = 0;
