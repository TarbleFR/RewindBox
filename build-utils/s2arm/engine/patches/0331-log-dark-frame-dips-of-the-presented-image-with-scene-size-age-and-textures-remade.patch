+// RewindBox (patch 0331): a dark-frame probe ([rb-dark] lines; the rules are in rb_dark_probe.h, pure C: tests/t_rb_dark_probe.c). Mario Kart World on an iPhone with the A18 Pro
+//   GPU (IPA 827, two sessions) shows its lit scene going black for a frame or a few in races, the sky darker, the HUD and the flames intact. The flashes follow the game's scene-size steps:
+//   at each step 17 to 28 render-target textures take a new key and a new Metal texture that starts from zero, and live textures are dropped (1,760 textures made in 900 race
+//   frames of the first session after the install against 796 in 4,800 of the next one). No line tied one flash to one frame: the log had no per-frame record of the final image.
+//   The probe, on each Metal 4 present with a window: RB_DARK_ROWS one-row copies of the presented texture (rb_dark_rows: the middle of the picture, off the HUD's bands) into a
+//   shared buffer of the present slot, encoded in the present's own command buffer after its blit (the DM_NVN_REGLUM way: nothing waits for the GPU, the commit feedback reads
+//   the rows, and a slot's buffer is used again only after its present completed). Their mean luminance is judged in ticket order (rb_dark_probe_sample): an image under
+//   RB_DARK_PCT % of the median of the last RB_DARK_HIST images that were not dark is dark; at most RB_DARK_DIP_MAX dark images in a row, entered from and left to
+//   RB_DARK_BACK_PCT % of that level in one image each, are a dip: a "[rb-dark] dip" line with its frame, length and levels, the scene size and the frames since it changed,
+//   and the render-target textures made (tex_mtl_for_pass), dropped live (rb_alias_dead_note) and sampled before written (rb_fresh_read) in the dip's first frame and the
+//   RB_DARK_BACK before it. A run as short that fades in or out is "soft", a longer one "long", and one of RB_DARK_ADOPT images a "cut", taken as the new level (a hard cut
+//   to a dark scene, a fade out, a loading screen, a tunnel): none of them a flash, each one line when it ends. The first RB_DARK_SAY_DIPS dips and RB_DARK_SAY_OTHER others
+//   of each RB_DARK_WINDOW frames are written, the rest counted in the "[rb-dark] window" line. The picture is not changed.
+//   Cost, not measured on a device: a present gets one more compute encoder (two queue barriers, RB_DARK_ROWS copy commands; about 46 KB copied by the GPU from a 2560-wide
+//   source; an 8x8 render pass measured about 80 microseconds of GPU in the IPA 820 probes, a copy-only encoder is expected under that) and its feedback handler reads some
+//   1,400 texels; the replaying thread takes a lock for a few stores at each texture made or dropped and each new scene size, and a few loads at each pass's start. The table
+//   of new textures (rb_fresh_add) goes from 32 to RB_FRESH places: a size step makes up to 28 textures and a texture stays noted for 3 frames, so two steps close together
+//   can fill 32 places and the count of samplings before a write then misses some, which no line said; the window line now counts the textures left out (fresh_full). It also
+//   gives the GPU span of the present command buffers (present_cb_us, mean / max), the probe's encoder included. Default on for every title. S2A_RB_DARK_PROBE=0: as before
+//   (no encoder, no buffer, no handler, no note, 32 places; the only line is the one that says so)
+#include "rb_dark_probe.h"
+static os_unfair_lock g_rb_dark_lk = OS_UNFAIR_LOCK_INIT;   // a leaf lock: only the header's functions run under it
+static rb_dark_probe g_rb_dark;   // under g_rb_dark_lk
+static __strong id<MTLBuffer> g_rb_dark_buf[3];   // Metal 4 readback per present slot, as g_rl_buf (the presenting thread)
+static _Atomic uint64_t g_rb_dark_scene_key, g_rb_dark_fresh_full;   // the last frame and scene size noted (rb_dark_note_scene); new textures rb_fresh_add had no free place for
+static int rb_dark_on(void) {
+    static _Atomic int v = -1;   // any thread
+    int on = atomic_load_explicit(&v, memory_order_relaxed);
+    if (on < 0) {
+        const char *e = getenv("S2A_RB_DARK_PROBE");
+        on = !(e && !strcmp(e, "0"));
+        if (atomic_exchange(&v, on) < 0)   // the line once, whoever reads the switch first
+            MLOG("[rb-dark] probe %s (S2A_RB_DARK_PROBE; patch 0331): each Metal 4 present reads %d rows of the presented image back without waiting, an image under %d%% of the median "
+                 "of the last %d that were not dark is dark, up to %d dark images in a row entered from and left to %d%% of that level are a dip, written with the age of the scene's size "
+                 "and the render-target textures made, dropped and sampled before written in its frame and the %d before (%d dips and %d other runs in full per %d frames); S2A_RB_DARK_PROBE=0: as before",
+                 on ? "on" : "off", RB_DARK_ROWS, RB_DARK_PCT, RB_DARK_HIST, RB_DARK_DIP_MAX, RB_DARK_BACK_PCT, RB_DARK_BACK, RB_DARK_SAY_DIPS, RB_DARK_SAY_OTHER, RB_DARK_WINDOW);
+    }
+    return on;
+}
+static void rb_dark_note_tex(int kind, uint32_t w, uint32_t h, uint32_t d, uint32_t fmt) {   // any thread: a render-target texture made, dropped live or sampled before written, in the frame being replayed
+    if (!rb_dark_on()) return;
+    const uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    os_unfair_lock_lock(&g_rb_dark_lk); rb_dark_probe_tex(&g_rb_dark, f, kind, w, h, d, fmt); os_unfair_lock_unlock(&g_rb_dark_lk);
+}
+static void rb_dark_note_scene(uint64_t f, uint32_t w, uint32_t h) {   // the replaying thread, at a pass's start while the probe is on: frame f's largest colour target drawn with a depth buffer so far (the frame signature's)
+    const uint64_t key = (((f + 1) & 0xffffffull) << 40) | ((uint64_t)(w & 0xfffffu) << 20) | (uint64_t)(h & 0xfffffu);
+    if (atomic_load_explicit(&g_rb_dark_scene_key, memory_order_relaxed) == key) return;   // the frame and size of the pass before: no lock
+    atomic_store_explicit(&g_rb_dark_scene_key, key, memory_order_relaxed);
+    os_unfair_lock_lock(&g_rb_dark_lk); rb_dark_probe_scene(&g_rb_dark, f, w, h); os_unfair_lock_unlock(&g_rb_dark_lk);
+}
+static void rb_dark_session_reset(void) {   // nvn_session.inc: frame numbers start again at 0
+    os_unfair_lock_lock(&g_rb_dark_lk); memset(&g_rb_dark, 0, sizeof g_rb_dark); os_unfair_lock_unlock(&g_rb_dark_lk);
+    atomic_store_explicit(&g_rb_dark_scene_key, 0, memory_order_relaxed);
+}
+static int rb_dark_layout(MTLPixelFormat pf) {   // rb_dark_luma16's layout of a presented texture's texels; -1: not read
+    switch (pf) {
+        case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatRGBA8Unorm_sRGB: return RB_DARK_RGBA8;
+        case MTLPixelFormatBGRA8Unorm: case MTLPixelFormatBGRA8Unorm_sRGB: return RB_DARK_BGRA8;
+        case MTLPixelFormatRGB10A2Unorm: return RB_DARK_RGB10A2;
+        case MTLPixelFormatBGR10A2Unorm: return RB_DARK_BGR10A2;
+        default: return -1;
+    }
+}
+// present_now, Metal 4 with a window, after the present blit in the present's own command buffer: the rows of the presented texture into the slot's buffer, in an encoder
+//   between queue barriers as the blit's is (enc_c_begin_on). Returns the texels the feedback handler reads (0: this image is not read) and sets their layout
+static size_t rb_dark_encode(id cb, id<MTLTexture> src, const int crop[4], int slot, int *layout) {
+    uint32_t x0 = 0, w = 0, y[RB_DARK_ROWS];
+    const int lay = (src.sampleCount == 1 && src.textureType == MTLTextureType2D) ? rb_dark_layout(src.pixelFormat) : -1;
+    if (lay < 0) {
+        static int said;   // the presenting thread only
+        if (!said++) MLOG("[rb-dark] the presented image is not read: pixel format %lu, texture type %lu, %lu samples (RGBA8, BGRA8, RGB10A2 and BGR10A2 2D textures only)",
+                          (unsigned long)src.pixelFormat, (unsigned long)src.textureType, (unsigned long)src.sampleCount);
+        return 0;
+    }
+    const int n = rb_dark_rows((uint32_t)src.width, (uint32_t)src.height, crop, &x0, &w, y);
+    if (!n) return 0;
+    id<MTLBuffer> b = g_rb_dark_buf[slot];
+    if (!b) { b = g_rb_dark_buf[slot] = [g_dev newBufferWithLength:RB_DARK_BYTES options:MTLResourceStorageModeShared]; if (!b) return 0; res_add(b); }
+    id e = enc_c_begin_on(cb, YES);
+    for (int i = 0; i < n; i++)
+        [e copyFromTexture:src sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(x0, y[i], 0) sourceSize:MTLSizeMake(w, 1, 1) toBuffer:b destinationOffset:(NSUInteger)i * w * 4 destinationBytesPerRow:(NSUInteger)w * 4 destinationBytesPerImage:(NSUInteger)w * 4];
+    enc_end_on(e, YES);
+    *layout = lay;
+    return (size_t)n * w;
+}
+static void rb_dark_sampled(id<MTLBuffer> b, size_t texels, int layout, uint64_t frame, uint64_t ticket, double gpu0, double gpu1) {   // the present's commit feedback (any thread): the rows are in b; gpu0 to gpu1, the present command buffer's GPU span in seconds
+    char txt[4096];
+    const unsigned luma = rb_dark_luma16(b.contents, texels, RB_DARK_STRIDE, layout);
+    const uint64_t full = atomic_load_explicit(&g_rb_dark_fresh_full, memory_order_relaxed);
+    const double us = (gpu0 > 0 && gpu1 > gpu0) ? (gpu1 - gpu0) * 1e6 : 0;   // the window line's present_cb_us: what the present costs the GPU with the probe's encoder in it
+    os_unfair_lock_lock(&g_rb_dark_lk);
+    int n = rb_dark_probe_sample(&g_rb_dark, ticket, frame, luma, us > 4e9 ? 4000000000u : (uint32_t)us, full, txt, sizeof txt);
+    os_unfair_lock_unlock(&g_rb_dark_lk);
+    for (const char *l = txt; n-- > 0; l += strlen(l) + 1) MLOG("[rb-dark] %s", l);   // outside the lock
+}
