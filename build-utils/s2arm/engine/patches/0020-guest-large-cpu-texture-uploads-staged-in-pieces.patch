     MTLTextureDescriptor *d = tex_desc(t, 1);
     if (!d) return nil;
@@ -3400,7 +3465,20 @@ static id<MTLTexture> pkg_upload_(const tex_t *t, uint64_t *stamp, id<MTLTexture
     }
     if (rb) src = rb;   // RewindBox (patch 0016): what the game does not hold reads 0, as a sparse pool's unmapped pages do
     up_begin();
-    id<MTLBuffer> stg = [g_dev newBufferWithLength:total ? total : 16 options:MTLResourceStorageModeShared];
+    // RewindBox (patch 0020): one staging buffer up to RB_UP_PIECE, as before; a larger one, or one Metal refuses, goes in pieces (rb_up_pieces)
+    id<MTLBuffer> stg = total <= RB_UP_PIECE ? [g_dev newBufferWithLength:total ? total : 16 options:MTLResourceStorageModeShared] : nil;
+    if (!stg) {
+        uint64_t k = ++g_rb_up_split_n;
+        if (k <= 8 || !(k & (k - 1)))
+            MLOG("RewindBox: texture ser=%llu %ux%ux%u format %#x target %d levels %u layers %u uploaded on the CPU (%s) in pieces of at most %zu MB: %zu MB of staging in all, %s; "
+                 "%llu such textures so far", (unsigned long long)t->serial, t->d.width, t->d.height, t->d.depth, t->d.format, (int)t->d.target, t->d.levels, layers,
+                 sparse ? "a sparse virtual pool's" : rb ? "storage that cannot all be read" : unp ? "a format converted on the CPU" : lin ? "linear storage" : "no GPU deswizzle",
+                 RB_UP_PIECE >> 20, total >> 20, total <= RB_UP_PIECE ? "Metal refused it in one piece" : "more than one piece holds", (unsigned long long)k);
+        rb_up_pieces(t, mt, src, (unsigned)d.mipmapLevelCount, layers, unp, ubpp, bw, bh, bpb, total);
+        free(part); free(rb);
+        up_flush();
+        return mt;
+    }
     res_add(stg); up_keep_add(stg);
     size_t off = 0;
     int zb = zblock_on() && t->d.format >= 0x79 && t->d.format <= 0x94; if (zb) { g_zb_ser = t->serial; g_zb_n = (int)MIN(d.mipmapLevelCount, 16u); memset(g_zb, 0, sizeof g_zb); memset(g_zb_tot, 0, sizeof g_zb_tot); }
