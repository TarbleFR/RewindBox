diff --git a/graphics/nvn/gfx/nvn/rb_draw_store.h b/graphics/nvn/gfx/nvn/rb_draw_store.h
new file mode 100644
index 0000000..c17d29f
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_draw_store.h
@@ -0,0 +1,45 @@
+#ifndef RB_DRAW_STORE_H
+#define RB_DRAW_STORE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+enum { RB_DRAW_IO_BYTES = 64 * 1024 };
+
+// The supplied buffer lives through close. A same-directory temporary keeps
+// the prior checkpoint intact until all new bytes can be atomically installed.
+static inline FILE *rb_draw_file_open(const char *path, char **temporary, char *buffer) {
+    const char suffix[] = ".XXXXXX";
+    size_t length = strlen(path);
+    *temporary = malloc(length + sizeof suffix);
+    if (!*temporary) return NULL;
+    memcpy(*temporary, path, length);
+    memcpy(*temporary + length, suffix, sizeof suffix);
+    int fd = mkstemp(*temporary);
+    if (fd >= 0) {
+        FILE *file = fdopen(fd, "wb");
+        if (file) {
+            if (!setvbuf(file, buffer, _IOFBF, RB_DRAW_IO_BYTES)) return file;
+            fclose(file);
+        } else {
+            close(fd);
+        }
+        unlink(*temporary);
+    }
+    free(*temporary);
+    *temporary = NULL;
+    return NULL;
+}
+
+static inline int rb_draw_file_finish(FILE *file, char *temporary, const char *path, int ok) {
+    if (ok) ok = !fflush(file) && !fsync(fileno(file));
+    if (fclose(file)) ok = 0;
+    if (ok) ok = !rename(temporary, path);
+    if (!ok) unlink(temporary);
+    free(temporary);
+    return ok;
+}
+
+#endif
