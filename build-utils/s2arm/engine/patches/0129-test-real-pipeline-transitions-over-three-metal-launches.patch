diff --git a/graphics/nvn/tests/rb_pso_transition_gpu.inc b/graphics/nvn/tests/rb_pso_transition_gpu.inc
new file mode 100644
index 0000000..49a04f3
--- /dev/null
+++ b/graphics/nvn/tests/rb_pso_transition_gpu.inc
@@ -0,0 +1,230 @@
+// Integrated into t_nvn_warmbump. Run --transition-gpu to start two independent
+// three-process sequences. Only guest identity, test shaders and worker timing
+// are supplied. No history, manifest, queued index or pipeline is injected.
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
+extern char **environ;
+
+#define GPU_CHECK(x) do { if (!(x)) { fprintf(stderr, "transition GPU check failed at %s:%d: %s\n", __FILE__, __LINE__, #x); exit(1); } } while (0)
+static _Atomic int transition_worker_control;
+static dispatch_semaphore_t transition_ready, transition_proceed;
+static NSString *const stage_keys[] = {
+    @"1100000000000000", @"2200000000000000", @"3300000000000000", @"4400000000000000", @"5500000000000000"
+};
+enum { ST_VERTEX, ST_A, ST_B, ST_C, ST_URGENT };
+static const uint8_t pixels[][4] = { {0}, {255,0,0,255}, {0,255,0,255}, {0,0,255,255}, {255,255,0,255} };
+const char *s2a_dsh_xfp(void) { return "0123456789abcdef"; }
+
+static void transition_wait(dispatch_semaphore_t sem) {
+    GPU_CHECK(dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC)) == 0);
+}
+static void transition_test_before_pick(void) {
+    if (!atomic_load(&transition_worker_control)) return;
+    dispatch_semaphore_signal(transition_ready);
+    transition_wait(transition_proceed);
+}
+static void transition_step(void) {
+    dispatch_semaphore_signal(transition_proceed);
+    transition_wait(transition_ready);
+}
+static NSString *stage_name(int stage) { return [stage_keys[stage] stringByAppendingString:@"_b"]; }
+
+static void write_test_text(NSString *path, NSString *text) {
+    GPU_CHECK([text writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil]);
+}
+static void stage_assets(NSString *root) {
+    NSString *fallback = [root stringByAppendingPathComponent:@"translation"];
+    GPU_CHECK([NSFileManager.defaultManager createDirectoryAtPath:fallback withIntermediateDirectories:YES attributes:nil error:nil]);
+    GPU_CHECK([NSFileManager.defaultManager createDirectoryAtPath:[root stringByAppendingPathComponent:@"b-" DMSH_CHAIN]
+        withIntermediateDirectories:YES attributes:nil error:nil]);
+    NSMutableString *map = [NSMutableString string];
+    for (int i = ST_VERTEX; i <= ST_URGENT; i++) {
+        NSString *base = [fallback stringByAppendingPathComponent:stage_name(i)];
+        NSString *source = i == ST_VERTEX ?
+            @"#include <metal_stdlib>\nusing namespace metal;\nstruct V { float4 p [[position]]; }; vertex V main0(uint i [[vertex_id]]) {"
+             "const float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],0,1)}; }" :
+            [NSString stringWithFormat:@"#include <metal_stdlib>\nusing namespace metal;\n"
+             "fragment float4 main0() { return float4(%u,%u,%u,1); }", pixels[i][0]/255u, pixels[i][1]/255u, pixels[i][2]/255u];
+        write_test_text([base stringByAppendingString:@".metal"], source);
+        NSDictionary *j = @{@"chain":@DMSH_CHAIN, @"xfp":@(s2a_dsh_xfp()), @"route":@"B",
+                            @"stage": i == ST_VERTEX ? @"vs" : @"fs", @"entry":@"main0", @"bindings":@[]};
+        NSData *data = [NSJSONSerialization dataWithJSONObject:j options:0 error:nil];
+        GPU_CHECK(data && [data writeToFile:[base stringByAppendingString:@".json"] atomically:YES]);
+        [map appendFormat:@"original\t0\t%@\t%@\n", i == ST_VERTEX ? @"vertex" : @"fragment", stage_keys[i]];
+    }
+    write_test_text([root stringByAppendingPathComponent:@"shader_map.tsv"], map);
+}
+static void transition_device(void) {
+    // Tracked Metal 3 textures/buffers work on a paravirtual macOS runner that
+    // has no residency sets. Keep the guest renderer's actual pipeline paths.
+    s2a_mtl_slot_take("PSO transition GPU fixture");
+    g_dev = MTLCreateSystemDefaultDevice(); GPU_CHECK(g_dev);
+    g_m3 = 1;
+    g_q3 = [g_dev newCommandQueue]; g_q = g_q3; GPU_CHECK(g_q3);
+    state_reset();
+    g_pass.cfmt[0] = MTLPixelFormatRGBA8Unorm;
+    g_pass.samples = 1;
+}
+
+static void demand_and_draw(int stage, id<MTLRenderPipelineState> expected) {
+    NvProg *pr = [NvProg new];
+    pr->sh[0] = shader_get(stage_name(ST_VERTEX), 0);
+    pr->sh[1] = shader_get(stage_name(stage), 1);
+    GPU_CHECK(pr->sh[0] && pr->sh[1]);
+    id<MTLRenderPipelineState> ps = pso_get(pr, nil);
+    GPU_CHECK(ps && (!expected || ps == expected));
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+    td.usage = MTLTextureUsageRenderTarget;
+    td.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> target = [g_dev newTextureWithDescriptor:td];
+    id<MTLBuffer> readback = [g_dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    GPU_CHECK(target && readback);
+    MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = target;
+    pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    pass.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 0);
+    id<MTLCommandBuffer> cb = [g_q3 commandBuffer];
+    id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:pass]; GPU_CHECK(enc);
+    enc_r_pso((id)enc, ps);
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [enc endEncoding];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder]; GPU_CHECK(blit);
+    [blit copyFromTexture:target sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(1,1,1)
+         toBuffer:readback destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:256];
+    [blit endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    GPU_CHECK(cb.status == MTLCommandBufferStatusCompleted);
+    GPU_CHECK(!memcmp(readback.contents, pixels[stage], 4));
+}
+
+// Inspect the normal handoff without mutating or publishing it. shader_get()
+// on the subsequent demand calls the production warm_claim().
+static id<MTLRenderPipelineState> handed_pipeline(int stage, int predicted) {
+    id<MTLRenderPipelineState> object = nil;
+    os_unfair_lock_lock(&g_warm_lock);
+    for (WarmItem *item in g_warm_items) {
+        if (item->kind == 1 && item->transition == predicted && [item->fs_key isEqual:stage_name(stage)]) object = item->object;
+    }
+    os_unfair_lock_unlock(&g_warm_lock);
+    return object;
+}
+
+// Shared positive assertion. The red replay must reach this exact oracle after
+// completing the real urgent job, rather than fail at setup, compilation or draw.
+enum { RB_EXPECTED_PROMOTION_ABSENT = 73 };
+static void require_predicted_object(id warm) {
+    if (!warm && !g_rb_promoted && !g_rb_reused) {
+        fputs("missing learned PSO after urgent demand\n", stderr);
+        exit(RB_EXPECTED_PROMOTION_ABSENT);
+    }
+    GPU_CHECK(warm && g_rb_promoted == 1 && !g_rb_reused);
+}
+
+static int transition_launch(NSString *root, int launch, int divergent, int disableReplay) {
+    alarm(120);
+    if (launch == 1) stage_assets(root);
+    setenv("DM_PSO_USER", [[root stringByAppendingPathComponent:@"pso_user.tsv"] fileSystemRepresentation], 1);
+    setenv("DM_NVN_SHMAP", [[root stringByAppendingPathComponent:@"shader_map.tsv"] fileSystemRepresentation], 1);
+    setenv("DM_MSL_DIR", root.fileSystemRepresentation, 1);
+    setenv("DM_MSL_FALLBACK", [[root stringByAppendingPathComponent:@"translation"] fileSystemRepresentation], 1);
+    setenv("RB_TEST_GAME_BUILD", "ab0123456789abcd", 1);
+    setenv("S2A_RB_PSO_TRANSITIONS", disableReplay ? "0" : "1", 1);
+    setenv("S2A_RB_SPEC_GOVERN", "0", 1);   // isolate learning from the Mac's current heat
+    setenv("DM_PSO_ARCHIVE", "0", 1);        // archive reuse has its own GPU test
+    setenv("DM_NVN_FIRST_SKIP", "0", 1);
+    setenv("DM_NVN_PSO_FRAME_MS", "0", 1);
+    setenv("DM_NVN_PSO_WAIT_MS", "0", 1);   // alarm bounds failures, not compiler scheduling latency
+    setenv("DM_PSO_PREPARE", launch == 3 ? "0" : "1", 1);
+    setenv("DM_PSO_BG_THREADS", "1", 1);
+    unsetenv("DM_PSO_MANIFEST");
+    if (launch == 3) {
+        transition_ready = dispatch_semaphore_create(0); transition_proceed = dispatch_semaphore_create(0);
+        atomic_store(&transition_worker_control, 1);
+    }
+    transition_device();
+    shmap_load();       // reads/filters the on-disk user manifest, starts its real prewarm and index
+    if (launch < 3) {
+        while (atomic_load(&g_warm_running)) usleep(1000);
+        demand_and_draw(ST_A, nil);
+        demand_and_draw(launch == 2 && divergent ? ST_C : ST_B, nil);
+        demand_and_draw(launch == 2 && divergent ? ST_B : ST_C, nil);
+        demand_and_draw(ST_URGENT, nil);
+        GPU_CHECK(!g_rb_promoted && !g_rb_reused);
+        GPU_CHECK(g_rb_submit_trace && g_rb_submit_trace->current.count == 4);
+    } else {
+        transition_wait(transition_ready);
+        dispatch_sync(rb_trace_io(), ^{});    // fixture fits in one 128-row index slice
+        demand_and_draw(ST_A, nil);
+        warm_bump(stage_name(ST_VERTEX).UTF8String, stage_name(ST_URGENT).UTF8String);
+        transition_step();
+        GPU_CHECK(handed_pipeline(ST_URGENT, 0) && !g_rb_promoted && !g_rb_reused);
+        transition_step();
+        if (!divergent) {
+            id<MTLRenderPipelineState> warm = handed_pipeline(ST_B, 1);
+            require_predicted_object(warm);
+            demand_and_draw(ST_B, warm);
+            GPU_CHECK(g_rb_published == 1 && g_rb_reused == 1);
+            demand_and_draw(ST_B, warm);
+            GPU_CHECK(g_rb_reused == 1);
+        } else {
+            GPU_CHECK(!g_rb_promoted && !handed_pipeline(ST_B, 1) && !handed_pipeline(ST_C, 1));
+            demand_and_draw(ST_B, nil);
+            GPU_CHECK(!g_rb_reused);
+        }
+        atomic_store(&transition_worker_control, 0);
+        dispatch_semaphore_signal(transition_proceed);
+    }
+    GPU_CHECK(g_rb_submit_trace);
+    NSString *historyPath = g_rb_submit_trace->path;
+    GPU_CHECK(!nvn_be_request_stop() && !nvn_be_shutdown_session());
+    NSData *saved = [NSData dataWithContentsOfFile:historyPath];
+    const rb_pso_history *history = saved.bytes;
+    GPU_CHECK(rb_history_valid(history, saved.length));
+    GPU_CHECK(history->prior.count == (launch == 1 ? 0u : 4u));
+    GPU_CHECK(history->latest.count == (launch == 3 ? 2u : 4u));
+    alarm(0);
+    printf("PSO transition GPU %s launch %d: passed\n", divergent ? "divergent" : "consensus", launch);
+    return 0;
+}
+
+static int transition_child(char *exe, NSString *directory, int launch, int divergent, int disableReplay) {
+    char n[] = {(char)('0' + launch), 0}, d[] = {(char)('0' + divergent), 0};
+    char *args[] = {exe, disableReplay ? "--transition-no-replay" : "--transition-launch",
+                    (char *)directory.fileSystemRepresentation, n, d, NULL};
+    pid_t child;
+    if (posix_spawnp(&child, exe, NULL, NULL, args, environ)) return -1;
+    pid_t waited; int status = 0;
+    do { waited = waitpid(child, &status, 0); } while (waited < 0 && errno == EINTR);
+    return waited == child && WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+}
+
+static int transition_test_main(int argc, char **argv) { @autoreleasepool {
+    if (argc == 5 && (!strcmp(argv[1], "--transition-launch") || !strcmp(argv[1], "--transition-no-replay"))) {
+        int launch = atoi(argv[3]), divergent = atoi(argv[4]), disabled = !strcmp(argv[1], "--transition-no-replay");
+        GPU_CHECK(launch >= 1 && launch <= 3 && (divergent == 0 || divergent == 1));
+        GPU_CHECK(!disabled || (launch == 3 && !divergent));
+        return transition_launch(@(argv[2]), launch, divergent, disabled);
+    }
+    GPU_CHECK(argc == 2 && !strcmp(argv[1], "--transition-gpu"));
+    for (int divergent = 0; divergent <= 1; divergent++) {
+        char path[] = "/tmp/rb-pso-transitions-XXXXXX";
+        GPU_CHECK(mkdtemp(path));
+        NSString *root = @(path);
+        int ok = transition_child(argv[0], root, 1, divergent, 0) == 0 &&
+                 transition_child(argv[0], root, 2, divergent, 0) == 0;
+        if (ok && !divergent) {
+            NSString *control = [root stringByAppendingPathExtension:@"control"];
+            GPU_CHECK([NSFileManager.defaultManager copyItemAtPath:root toPath:control error:nil]);
+            int red = transition_child(argv[0], control, 3, 0, 1);
+            GPU_CHECK([NSFileManager.defaultManager removeItemAtPath:control error:nil]);
+            ok = red == RB_EXPECTED_PROMOTION_ABSENT;
+            if (ok) puts("PASS: disabled replay failed the exact promoted-object oracle");
+        }
+        if (ok) ok = transition_child(argv[0], root, 3, divergent, 0) == 0;
+        GPU_CHECK([NSFileManager.defaultManager removeItemAtPath:root error:nil]);
+        GPU_CHECK(ok);
+    }
+    puts("PASS: three-launch consensus, urgent registration, pixel readback and divergent GPU sequence");
+    return 0;
+} }
