diff --git a/graphics/nvn/tests/t_rb_pso_trace.c b/graphics/nvn/tests/t_rb_pso_trace.c
new file mode 100644
index 0000000..d5a7686
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_pso_trace.c
@@ -0,0 +1,53 @@
+// cc -std=c11 -O2 -Wall -Wextra -Werror t_rb_pso_trace.c -o t_rb_pso_trace
+#include "../gfx/nvn/rb_pso_trace.h"
+#include <assert.h>
+#include <stdio.h>
+
+static rb_pso_history disk, loaded, empty;
+static rb_pso_edges edges;
+static uint64_t seen[RB_TRACE_SLOTS];
+
+static void reopen(void) {
+    FILE *f = tmpfile();
+    assert(f && fwrite(&disk, sizeof disk, 1, f) == 1);
+    rewind(f);
+    assert(fread(&loaded, sizeof loaded, 1, f) == 1 && fgetc(f) == EOF && !ferror(f));
+    assert(rb_history_valid(&loaded, sizeof loaded));
+    fclose(f);
+}
+
+int main(void) {
+    const uint64_t first[] = {5, 11, 19, 23, 41};
+    const uint64_t second[] = {5, 11, 29, 23, 41};
+    rb_history_append(&disk, &empty, first, 2 * sizeof(uint64_t)); // first launch checkpoint
+    rb_history_append(&disk, &empty, first, sizeof first);        // same launch, not another vote
+    reopen();
+    assert(loaded.prior.count == 0 && loaded.latest.count == 5);
+    rb_trace_edges(&loaded.prior, &edges);
+    assert(!rb_edge_agrees(&edges, 5, 11));
+    rb_history_append(&disk, &loaded, second, sizeof second);
+    reopen();
+    rb_trace_edges(&loaded.prior, &edges);
+    size_t agreed = 0;
+    for (size_t i = 1; i < loaded.latest.count; i++)
+        agreed += rb_edge_agrees(&edges, loaded.latest.key[i-1], loaded.latest.key[i]);
+    assert(agreed == 2);
+    assert(rb_edge_agrees(&edges, 5, 11) && rb_edge_agrees(&edges, 23, 41));
+    assert(!rb_edge_agrees(&edges, 11, 29) && !rb_edge_agrees(&edges, 29, 23));
+    assert(!rb_edge_agrees(&edges, 5, 5) && !rb_edge_agrees(&edges, 0, 11));
+    assert(!rb_history_valid(&loaded, sizeof loaded - 1));
+    assert(!rb_history_valid(&loaded, sizeof loaded + 1));
+    loaded.latest.key[1] ^= 1;
+    assert(!rb_history_valid(&loaded, sizeof loaded));
+    loaded = disk;
+    loaded.latest.count = RB_TRACE_LIMIT + 1; loaded.checksum = rb_history_checksum(&loaded);
+    assert(!rb_history_valid(&loaded, sizeof loaded));
+    loaded = disk; loaded.format++;
+    assert(!rb_history_valid(&loaded, sizeof loaded));
+    for (uint64_t i = 1; i <= RB_TRACE_LIMIT; i++) {
+        assert(rb_trace_first(seen, i) && !rb_trace_first(seen, i));
+    }
+    assert(!rb_trace_first(seen, 0));
+    puts("PSO first-use traces: cold/hot, two sessions, consensus, bounded deduplication, damaged history passed");
+    return 0;
+}
