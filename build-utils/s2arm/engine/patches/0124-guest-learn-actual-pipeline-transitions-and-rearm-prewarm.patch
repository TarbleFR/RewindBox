diff --git a/graphics/nvn/gfx/nvn/rb_pso_trace.h b/graphics/nvn/gfx/nvn/rb_pso_trace.h
new file mode 100644
index 0000000..a14dc55
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_pso_trace.h
@@ -0,0 +1,58 @@
+// RewindBox: short histories of first demanded render pipelines. A history hit
+// is only a scheduling hint; the existing warm manifest owns every descriptor.
+#pragma once
+#include <stddef.h>
+#include "nvn_hmap.h"
+
+enum { RB_TRACE_LIMIT = 2048, RB_TRACE_SLOTS = RB_TRACE_LIMIT * 2 };
+typedef struct { uint64_t count, key[RB_TRACE_LIMIT]; } rb_pso_trace;
+typedef struct {
+    uint64_t format, checksum;
+    rb_pso_trace prior, latest;
+} rb_pso_history;
+
+// Fixed-size, at most half full. Zero is reserved for an empty slot.
+static inline size_t rb_trace_slot(const uint64_t *keys, uint64_t key) {
+    size_t i = nvn_hm_hash(&key, sizeof key) & (RB_TRACE_SLOTS - 1);
+    while (keys[i] && keys[i] != key) i = (i + 1) & (RB_TRACE_SLOTS - 1);
+    return i;
+}
+static inline int rb_trace_first(uint64_t *keys, uint64_t key) {
+    if (!key) return 0;
+    size_t i = rb_trace_slot(keys, key);
+    if (keys[i]) return 0;
+    keys[i] = key;
+    return 1;
+}
+static inline uint64_t rb_history_checksum(const rb_pso_history *h) {
+    return nvn_hm_hash(&h->prior, sizeof(*h) - offsetof(rb_pso_history, prior));
+}
+static inline int rb_history_valid(const rb_pso_history *h, size_t len) {
+    return len == sizeof(*h) && h->format == 1 && h->prior.count <= RB_TRACE_LIMIT &&
+           h->latest.count <= RB_TRACE_LIMIT && h->checksum == rb_history_checksum(h);
+}
+static inline void rb_history_append(rb_pso_history *out, const rb_pso_history *atLaunch,
+                                     const void *keys, size_t bytes) {
+    memset(out, 0, sizeof *out);
+    out->format = 1;
+    out->prior = atLaunch->latest;
+    out->latest.count = bytes / sizeof(uint64_t);
+    memcpy(out->latest.key, keys, bytes);
+    out->checksum = rb_history_checksum(out);
+}
+// Both traces contain first uses, each key at most once. Only an immediate
+// successor seen after the same predecessor on BOTH launches is eligible.
+typedef struct { uint64_t from[RB_TRACE_SLOTS], to[RB_TRACE_SLOTS]; } rb_pso_edges;
+static inline void rb_trace_edges(const rb_pso_trace *trace, rb_pso_edges *edges) {
+    for (size_t i = 1; i < trace->count; i++) {
+        uint64_t source = trace->key[i - 1];
+        if (!source || !trace->key[i] || source == trace->key[i]) continue;
+        size_t slot = rb_trace_slot(edges->from, source);
+        edges->from[slot] = source;
+        edges->to[slot] = trace->key[i];
+    }
+}
+static inline int rb_edge_agrees(const rb_pso_edges *edges, uint64_t source, uint64_t target) {
+    size_t slot = rb_trace_slot(edges->from, source);
+    return source && target && source != target && edges->from[slot] == source && edges->to[slot] == target;
+}
diff --git a/graphics/nvn/gfx/nvn/rb_pso_transitions.inc b/graphics/nvn/gfx/nvn/rb_pso_transitions.inc
new file mode 100644
index 0000000..50d6ae3
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_pso_transitions.inc
@@ -0,0 +1,195 @@
+// RewindBox: one replaceable suggestion for existing warm workers. No draw
+// decisions, descriptors or compiler jobs originate in the transition model.
+#include "rb_pso_trace.h"
+extern const char *s2a_main_build_id(void) __attribute__((weak_import));
+
+@interface RBPipelineTrace : NSObject {
+@public
+    NSString *path;
+    rb_pso_trace current;                           // submit thread only
+    uint64_t seenPSO[RB_TRACE_SLOTS], seenKey[RB_TRACE_SLOTS];
+    size_t objectCount;
+    rb_pso_history priorLaunches;                    // serial I/O queue only
+    os_unfair_lock writeLock;
+    NSData *pendingPrefix;
+    int writing;
+}
+@end
+@implementation RBPipelineTrace @end
+
+static dispatch_queue_t rb_trace_io(void) {
+    static dispatch_queue_t q;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        q = dispatch_queue_create("rewindbox.pso-transitions",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, s2a_qos(S2A_QOS_IO_BG), 0));
+    });
+    return q;
+}
+static RBPipelineTrace *g_rb_trace;
+static int g_rb_trace_initialized;
+static os_unfair_lock g_rb_trace_lock = OS_UNFAIR_LOCK_INIT;
+static RBPipelineTrace *rb_trace_session(void) {
+    os_unfair_lock_lock(&g_rb_trace_lock);
+    if (!g_rb_trace_initialized) {
+        g_rb_trace_initialized = 1;
+        const char *enable = getenv("S2A_RB_PSO_TRANSITIONS");
+        const char *build = s2a_main_build_id ? s2a_main_build_id() : NULL;
+        NSString *root = pso_user_path();
+        if ((!enable || strcmp(enable, "0")) && root && build && *build &&
+            strlen(build) <= 64 && strspn(build, "0123456789abcdefABCDEF") == strlen(build)) {
+            RBPipelineTrace *run = [RBPipelineTrace new];
+            run->path = [root stringByAppendingFormat:@".rb-trace-v1-%s-%s-%zu", build, DMSH_CHAIN, sizeof(pso_skey)];
+            g_rb_trace = run;
+            dispatch_async(rb_trace_io(), ^{ @autoreleasepool {
+                // One fixed-size read even if a damaged file reports a huge size.
+                FILE *f = fopen(run->path.fileSystemRepresentation, "rb");
+                if (!f) return;
+                rb_pso_history *h = &run->priorLaunches;
+                size_t bytes = fread(h, 1, sizeof *h, f);
+                if (fgetc(f) != EOF || ferror(f) || !rb_history_valid(h, bytes)) memset(h, 0, sizeof *h);
+                fclose(f);
+            } });
+        }
+    }
+    RBPipelineTrace *run = g_rb_trace;
+    os_unfair_lock_unlock(&g_rb_trace_lock);
+    return run;
+}
+static void rb_trace_write(RBPipelineTrace *run) {
+    for (;;) { @autoreleasepool {
+        os_unfair_lock_lock(&run->writeLock);
+        NSData *prefix = run->pendingPrefix;
+        run->pendingPrefix = nil;
+        if (!prefix) run->writing = 0;
+        os_unfair_lock_unlock(&run->writeLock);
+        if (!prefix) return;
+        rb_pso_history *h = calloc(1, sizeof *h);
+        if (!h) continue;
+        rb_history_append(h, &run->priorLaunches, prefix.bytes, prefix.length);
+        NSData *data = [NSData dataWithBytesNoCopy:h length:sizeof *h freeWhenDone:YES];
+        NSError *error = nil;
+        if (![data writeToFile:run->path options:NSDataWritingAtomic error:&error])
+            MLOG("RewindBox PSO transitions: checkpoint failed (%ld)", (long)error.code);
+    } }
+}
+static void rb_trace_save(RBPipelineTrace *run, int final) {
+    if (!run || run->current.count < 2) return;
+    // One write active and one replaceable prefix, even if the last batch
+    // arrives at capacity. No disk reads, writes or waits on submit.
+    NSData *prefix = [NSData dataWithBytes:run->current.key length:run->current.count * sizeof(uint64_t)];
+    os_unfair_lock_lock(&run->writeLock);
+    run->pendingPrefix = prefix;
+    if (!run->writing) {
+        run->writing = 1;
+        dispatch_async(rb_trace_io(), ^{ rb_trace_write(run); });
+    }
+    os_unfair_lock_unlock(&run->writeLock);
+    if (final) dispatch_sync(rb_trace_io(), ^{});   // only after the session drain
+}
+static NSDictionary<NSNumber *, NSNumber *> *g_rb_follow_rows; // immutable; g_wu_lock
+static _Atomic long g_rb_next_row;                              // one-based or zero
+static _Thread_local int g_rb_picked_hint;
+static _Atomic uint64_t g_rb_promoted;
+static uint64_t g_rb_published, g_rb_reused;
+static RBPipelineTrace *g_rb_submit_trace;
+static int g_rb_submit_initialized;
+
+static void rb_trace_scan(NSArray<WarmTask *> *tasks, NSDictionary *epoch, NSDictionary *targets,
+                          NSMutableDictionary *rows, NSUInteger offset) {
+    os_unfair_lock_lock(&g_wu_lock);
+    int active = g_wu_pairs == epoch;
+    os_unfair_lock_unlock(&g_wu_lock);
+    if (!active || !epoch || dm_gfx_session_stopping() || nvn_be_stopping()) return;
+    int busy = atomic_load(&g_fu_waiting) || rb_spec_level() != RB_SPEC_RUN;
+    NSUInteger end = busy ? offset : MIN(tasks.count, offset + 128);
+    for (; offset < end && rows.count < targets.count; offset++) {
+        WarmTask *t = tasks[offset];
+        if (t->kind != 1) continue;
+        NSData *data = t->rs.firstObject;
+        if (data.length != sizeof(pso_skey)) continue;
+        uint64_t key = nvn_hm_hash(data.bytes, sizeof(pso_skey));
+        NSNumber *src = targets[@(key)];
+        if (src) rows[src] = @(offset);
+    }
+    if (offset < tasks.count && rows.count < targets.count) {
+        __weak NSArray *weakTasks = tasks;
+        __weak NSDictionary *weakEpoch = epoch;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, busy ? 100 * NSEC_PER_MSEC : 0), rb_trace_io(), ^{ @autoreleasepool {
+            NSArray *nextTasks = weakTasks;
+            NSDictionary *nextEpoch = weakEpoch;
+            if (nextTasks && nextEpoch) rb_trace_scan(nextTasks, nextEpoch, targets, rows, offset);
+        } });
+        return;
+    }
+    os_unfair_lock_lock(&g_wu_lock);
+    if (g_wu_pairs == epoch) g_rb_follow_rows = rows;
+    os_unfair_lock_unlock(&g_wu_lock);
+}
+
+// Scan existing manifest rows in short slices. A finished or replaced list
+// invalidates its index; pressure pauses optional bookkeeping between slices.
+static void rb_trace_index(NSArray<WarmTask *> *tasks, NSDictionary *epoch) {
+    RBPipelineTrace *run = rb_trace_session();
+    if (!run) return;
+    dispatch_async(rb_trace_io(), ^{ @autoreleasepool {
+        const rb_pso_history *h = &run->priorLaunches;
+        if (h->prior.count < 2 || h->latest.count < 2) return;
+        rb_pso_edges *prior = calloc(1, sizeof *prior);
+        if (!prior) return;
+        rb_trace_edges(&h->prior, prior);
+        NSMutableDictionary<NSNumber *, NSNumber *> *byDestination = [NSMutableDictionary dictionary];
+        for (size_t j = 1; j < h->latest.count; j++) {
+            uint64_t src = h->latest.key[j-1], dst = h->latest.key[j];
+            if (rb_edge_agrees(prior, src, dst)) byDestination[@(dst)] = @(src);
+        }
+        free(prior);
+        if (!byDestination.count) return;
+        rb_trace_scan(tasks, epoch, byDestination, [NSMutableDictionary dictionaryWithCapacity:byDestination.count], 0);
+    } });
+}
+static void rb_trace_bound(id ps) {
+    const void *raw = (__bridge const void *)ps;
+    if (nvn_hm_del(&g_rb_promoted_objects, &raw)) {
+        ++g_rb_reused;
+        if (!(g_rb_reused & (g_rb_reused - 1)))
+            MLOG("RewindBox PSO transitions: %llu promoted, %llu warmed Metal objects bound",
+                 (unsigned long long)atomic_load(&g_rb_promoted), (unsigned long long)g_rb_reused);
+    }
+}
+static void rb_trace_used(id ps, const pso_key *k, NvShader *vs, NvShader *fs) {
+    if (!g_rb_submit_initialized) { g_rb_submit_trace = rb_trace_session(); g_rb_submit_initialized = 1; }
+    RBPipelineTrace *run = g_rb_submit_trace;
+    if (!run) { g_rb_observing = 0; return; }
+    // Called on successful render lookup, including a cached object. Exclude
+    // diagnostic/merged overrides that cannot use ordinary R rows.
+    if (run->objectCount >= RB_TRACE_LIMIT || !rb_trace_first(run->seenPSO, (uintptr_t)(__bridge void *)ps)) return;
+    if (++run->objectCount == RB_TRACE_LIMIT) g_rb_observing = 0;
+    pso_skey sk; pso_skey_from(k, vs, fs, 0, NULL, &sk);
+    uint64_t key = nvn_hm_hash(&sk, sizeof sk);
+    if (!rb_trace_first(run->seenKey, key)) return;
+    run->current.key[run->current.count++] = key;
+    if (run->current.count == 2 || !(run->current.count % 32)) rb_trace_save(run, 0);
+    if (!atomic_load_explicit(&g_warm_running, memory_order_relaxed)) return;
+    os_unfair_lock_lock(&g_wu_lock);
+    NSNumber *row = g_wu_pairs ? g_rb_follow_rows[@(key)] : nil;
+    long next = row && g_wu_claim && row.longValue < g_wu_n && !atomic_load(&g_wu_claim[row.longValue]) ? row.longValue + 1 : 0;
+    atomic_store(&g_rb_next_row, next);
+    os_unfair_lock_unlock(&g_wu_lock);
+}
+static void rb_trace_end(void) {
+    // Submit and warm workers are drained by the caller.
+    rb_trace_save(g_rb_submit_trace, 1);
+    if (g_rb_submit_trace)
+        MLOG("RewindBox PSO transitions: %llu first-used, %llu promoted, %llu published, %llu warmed Metal objects bound, %llu published but unused",
+             (unsigned long long)g_rb_submit_trace->current.count, (unsigned long long)atomic_load(&g_rb_promoted),
+             (unsigned long long)g_rb_published, (unsigned long long)g_rb_reused,
+             (unsigned long long)(g_rb_published - g_rb_reused));
+    g_rb_submit_trace = nil; g_rb_submit_initialized = 0;
+    os_unfair_lock_lock(&g_rb_trace_lock);
+    g_rb_trace = nil; g_rb_trace_initialized = 0;
+    os_unfair_lock_unlock(&g_rb_trace_lock);
+    os_unfair_lock_lock(&g_wu_lock); g_rb_follow_rows = nil; atomic_store(&g_rb_next_row, 0); os_unfair_lock_unlock(&g_wu_lock);
+    nvn_hm_clear(&g_rb_promoted_objects, NULL);
+    g_rb_published = g_rb_reused = 0; g_rb_observing = 1; atomic_store(&g_rb_promoted, 0);
+}
