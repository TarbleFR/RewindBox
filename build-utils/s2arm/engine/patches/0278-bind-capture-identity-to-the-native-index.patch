diff --git a/graphics/nvn/gfx/nvn/rb_capture_identity.h b/graphics/nvn/gfx/nvn/rb_capture_identity.h
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_capture_identity.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <CommonCrypto/CommonDigest.h>
+#include <stdint.h>
+#include <string.h>
+
+// S2ALIB v1 leaves bytes 20..23 and (on Metal) 36..47 unused.
+// RBC1 binds the exact UTF-8 identity row to this index; legacy v1 has a zero word.
+static int rb_capture_index_matches(const uint8_t *header, const char *identity) {
+    if (!header) return !identity;
+    if (!identity) {
+        uint32_t word;
+        memcpy(&word, header + 20, sizeof word);
+        return !word;
+    }
+    if (memcmp(header + 20, "RBC1", 4)) return 0;
+    uint8_t hash[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(identity, (CC_LONG)strlen(identity), hash);
+    return !memcmp(hash, header + 36, 12);
+}
