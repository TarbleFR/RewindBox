diff --git a/graphics/nvn/gfx/nvn/rb_working_set.h b/graphics/nvn/gfx/nvn/rb_working_set.h
index 0b097b5..f7294ec 100644
--- a/graphics/nvn/gfx/nvn/rb_working_set.h
+++ b/graphics/nvn/gfx/nvn/rb_working_set.h
@@ -12,9 +12,19 @@ static inline uint64_t rb_ws_room(uint64_t target, uint64_t metal, uint64_t proc
     uint64_t remaining = target > metal ? target - metal : 0;
     return remaining < process ? remaining : process;
 }
-// On iOS a device allocation total above installed unified RAM cannot be
-// interpreted as resident bytes. Use independently measured process headroom
-// for that sample. Unknown headroom must never open unbounded optional work.
+// The device's allocation total counts address space: buffers that wrap guest
+// memory, placement heaps and purgeable storage are reported in full whether
+// or not a page is resident (an iPhone showed 6265 MiB allocated beside a
+// footprint under 1 GiB and 5757 MiB of process headroom). Metal cannot hold
+// more resident bytes than the process is charged for, so the working-set test
+// takes the smaller figure. An unknown footprint leaves the device's figure.
+static inline uint64_t rb_ws_resident(uint64_t allocated, uint64_t footprint) {
+    if (footprint == UINT64_MAX) return allocated;
+    return allocated == UINT64_MAX || footprint < allocated ? footprint : allocated;
+}
+// On iOS a total above installed unified RAM cannot be interpreted as resident
+// bytes either. Use independently measured process headroom for that sample.
+// Unknown headroom must never open unbounded optional work.
 static inline int rb_ws_sample_valid(uint64_t allocated, uint64_t physical) {
     return allocated != UINT64_MAX && (!physical || allocated <= physical);
 }
