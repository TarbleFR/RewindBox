diff --git a/ios/s2a_l10n.h b/ios/s2a_l10n.h
--- a/ios/s2a_l10n.h
+++ b/ios/s2a_l10n.h
@@ -3,15 +3,28 @@
 //   含格式的串写 [NSString stringWithFormat:S2AL(@"…"), …]。两表键集合、占位符一致与代码引用由 tests/ios_l10n_test.sh 核对
 #pragma once
 #import <Foundation/Foundation.h>
+#include <dlfcn.h>
 
-#define S2AL(key) [NSBundle.mainBundle localizedStringForKey:(key) value:nil table:@"S2ArmHost"]
+// RewindBox: the bundle that holds these tables. S2Arm.app: the main bundle, as before. A RewindBox guest (runtime/src/rb_guest.c,
+//   looked up by name so that files built without it still link): the bundle of the image running this code, S2ArmEngine.framework,
+//   where guest.mk copies the same <lang>.lproj/S2ArmHost.strings (the host app's main bundle does not have them)
+static inline NSBundle *s2a_l10n_bundle(void) {
+    static NSBundle *bundle; static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        int (*guest)(void) = (int (*)(void))dlsym(RTLD_DEFAULT, "s2a_rb_guest_on"); Dl_info info; bundle = NSBundle.mainBundle;
+        if (guest && guest() && dladdr((const void *)&s2a_l10n_bundle, &info) && info.dli_fname)
+            bundle = [NSBundle bundleWithPath:@(info.dli_fname).stringByDeletingLastPathComponent] ?: NSBundle.mainBundle;
+    });
+    return bundle;
+}
+#define S2AL(key) [s2a_l10n_bundle() localizedStringForKey:(key) value:nil table:@"S2ArmHost"]
 
 // 按 App 语言选中英（#316）：与游戏进程 / Mac 端共用的 C 宏文案（runtime/include/s2a_direct_prompt.h、s2a_init_fail.h、s2a_selfcheck_page.h、s2a_dguard.h）
 //   只有中文原宏 + 英文 <宏>_EN 两份（规格里的由 launchers/shared/check_experience.py 核逐字一致），宿主显示处用 S2APICK(宏) 取一种。
 //   判据同字符串表的取法：主 bundle 的首选本地化以 zh 开头 = 中文，其余一律英文（开发区域 en）
 static inline BOOL s2a_l10n_zh(void) {
     static BOOL zh; static dispatch_once_t once;
-    dispatch_once(&once, ^{ zh = [NSBundle.mainBundle.preferredLocalizations.firstObject hasPrefix:@"zh"]; });
+    dispatch_once(&once, ^{ zh = [s2a_l10n_bundle().preferredLocalizations.firstObject hasPrefix:@"zh"]; });
     return zh;
 }
 #define S2APICK(macro) (s2a_l10n_zh() ? @macro : @macro##_EN)     // NSString *
