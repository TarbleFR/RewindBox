diff --git a/graphics/nvn/gfx/nvn/rb_cold_upload.inc b/graphics/nvn/gfx/nvn/rb_cold_upload.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_cold_upload.inc
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+// Submit-owned, never-bound copies of the recorded CPU-backed texture hints.
+// A nonempty slot reserves its serial even after eviction. On a collision we
+// skip speculative work; we never lose an eviction attribution to a collision.
+enum { RB_COLD_SLOTS = 256 };
+typedef struct {
+    NvPkg * __strong copy;
+    uint64_t serial, born, bytes, stamp, guestBytes;
+    uintptr_t pool, address;
+    unsigned registration;
+    BOOL isVolatile, discarded;
+} rb_cold_entry;
+static rb_cold_entry rb_cold[RB_COLD_SLOTS];
+static uint64_t rb_cold_held;
+static _Thread_local BOOL rb_capturing_upload;
+static _Thread_local unsigned rb_capture_registration;
+static BOOL rb_cold_rebuildable(const rb_cold_entry *e);
+static _Atomic uint64_t rb_cold_evictions, rb_cold_volatile, rb_cold_empty;
+static _Atomic uint64_t rb_cold_repeat, rb_cold_repeat_bytes, rb_cold_changed_repeat;
+static rb_cold_entry *rb_cold_slot(uint64_t serial) {
+    return &rb_cold[(serial ^ (serial >> 32)) % RB_COLD_SLOTS];
+}
+static BOOL rb_cold_room(const tex_t *t) {
+    uint64_t cap = rb_texture_share(1);
+    return !rb_cold_slot(t->serial)->serial && rb_cold_held < cap && t->L.size <= cap - rb_cold_held;
+}
+static void rb_cold_store(NvPkg *pk, const tex_t *t) {
+    rb_cold_entry *e = rb_cold_slot(t->serial);
+    e->registration = rb_capture_registration; e->serial = t->serial; e->copy = pk;
+    e->pool = (uintptr_t)t->pool; e->address = (uintptr_t)t->mem; e->guestBytes = t->L.size;
+    e->born = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    e->bytes = pk->tex.allocatedSize; e->stamp = pk->stamp;
+    rb_cold_held += e->bytes;
+}
+static void rb_cold_detach(rb_cold_entry *e, BOOL discarded) {
+    rb_cold_held -= e->bytes;
+    e->bytes = 0;
+    e->copy = nil; e->isVolatile = NO; e->discarded = discarded;
+    if (!discarded) e->serial = 0;
+}
+static void rb_cold_maintain(uint64_t frame) {
+    // up_flush increments pending before clearing the open batch and only the
+    // upload completion decrements it. Never wait, evict or purge an open upload.
+    if (g_up_cb || atomic_load(&g_up_pending)) return;
+    uint64_t cap = rb_texture_share(1);
+    rb_cold_entry *pending[4];
+    unsigned count = 0;
+    for (int i = 0; i < RB_COLD_SLOTS; ++i) {
+        rb_cold_entry *e = &rb_cold[i];
+        if (!e->copy || frame < e->born || frame - e->born < 60 ||
+            (e->isVolatile && frame - e->born < 300) || !rb_cold_rebuildable(e)) continue;
+        if (frame - e->born >= 300) {
+            rb_cold_detach(e, YES);
+            atomic_fetch_add_explicit(&rb_cold_evictions, 1, memory_order_relaxed);
+        } else if (count < 4 && !e->isVolatile && frame - e->born >= 60) {
+            id<MTLTexture> t = e->copy->tex;
+            if (t.parentTexture || t.buffer || t.heap || t.isSparse || t.storageMode != MTLStorageModePrivate) continue;
+            res_remove(t);
+            pending[count++] = e;
+        }
+    }
+    if (count) {
+        res_commit_(1);
+        for (unsigned j = 0; j < count; ++j) {
+            rb_cold_entry *e = pending[j];
+            [e->copy->tex setPurgeableState:MTLPurgeableStateVolatile];
+            e->isVolatile = YES;
+            atomic_fetch_add_explicit(&rb_cold_volatile, 1, memory_order_relaxed);
+        }
+    }
+    while (rb_cold_held > cap) {
+        rb_cold_entry *oldest = NULL;
+        for (int i = 0; i < RB_COLD_SLOTS; ++i)
+            if (rb_cold[i].copy && (!oldest || rb_cold[i].born < oldest->born) && rb_cold_rebuildable(&rb_cold[i])) oldest = &rb_cold[i];
+        if (!oldest) break;
+        rb_cold_detach(oldest, YES);
+        atomic_fetch_add_explicit(&rb_cold_evictions, 1, memory_order_relaxed);
+    }
+}
+static BOOL rb_cold_matches(const rb_cold_entry *e, const tex_t *t) {
+    return e->serial == t->serial && e->pool == (uintptr_t)t->pool &&
+           e->address == (uintptr_t)t->mem && e->guestBytes == t->L.size;
+}
+static NvPkg *rb_cold_claim(const tex_t *t) {
+    rb_cold_entry *e = rb_cold_slot(t->serial);
+    if (!rb_cold_matches(e, t) || !e->copy) return nil;
+    NvPkg *pk = e->copy;
+    if (e->isVolatile) {
+        if ([pk->tex setPurgeableState:MTLPurgeableStateNonVolatile] == MTLPurgeableStateEmpty) {
+            rb_cold_detach(e, YES);
+            atomic_fetch_add_explicit(&rb_cold_empty, 1, memory_order_relaxed);
+            return nil;
+        }
+        res_add(pk->tex);
+    }
+    // The original dirty-page path below validates or updates a promoted copy.
+    // Never use the former pool's dirty-span handle if its registration changed.
+    if (pk->span != nvn_dirty_span(t->mem, t->L.size)) pk->span = NULL;
+    rb_cold_detach(e, NO);
+    tex_put(t->serial, pk);
+    return pk;
+}
+static void rb_cold_uploaded(const tex_t *t, BOOL wasClean) {
+    rb_cold_entry *e = rb_cold_slot(t->serial);
+    if (!e->discarded || !rb_cold_matches(e, t)) return;
+    rb_cold_detach(e, NO);
+    atomic_fetch_add_explicit(&rb_cold_repeat, 1, memory_order_relaxed);
+    atomic_fetch_add_explicit(&rb_cold_repeat_bytes, t->L.size, memory_order_relaxed);
+    if (!wasClean) atomic_fetch_add_explicit(&rb_cold_changed_repeat, 1, memory_order_relaxed);
+}
