+// The VM exposes ordinary Metal blits. Force the opt-in policy only in this
+// standalone translation unit; exercise record, upload, flush and GPU readback.
+static int smooth_upload(void) {
+    rb_test_upload_options = YES;
+    setenv("S2A_RB_SPEC_GOVERN", "0", 1);
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice(); REQUIRE(device);
+    BOOL direct = NO;
+    if (@available(macOS 26.0, iOS 26.0, *)) {
+        MTLResidencySetDescriptor *rd = [MTLResidencySetDescriptor new]; rd.initialCapacity = 4;
+        direct = device.hasUnifiedMemory && [device supportsFamily:MTLGPUFamilyMetal4] &&
+            [device newResidencySetWithDescriptor:rd error:NULL] != nil &&
+            [device newMTL4CommandQueueWithDescriptor:[MTL4CommandQueueDescriptor new] error:NULL] != nil;
+    }
+    if (direct) {
+        mtl_init(); REQUIRE(!g_m3);
+        g_nvn_deswz_gpu = 0; // exercise the CPU-staged copy path on the real Metal 4 encoder
+    } else {
+        g_dev = device; g_m3 = 1; g_q = [g_dev newCommandQueue]; g_q3 = g_q; REQUIRE(g_q);
+        g_fence3 = [g_dev newFence]; g_keep = [NSMutableArray array];
+    }
+    printf("Upload readback backend=%s device=%s\n", direct ? "direct Metal 4" : "tracked Metal 3 (Metal 4 unavailable)", device.name.UTF8String);
+    g_sub_thread = pthread_self(); atomic_store(&g_sub_thread_set, 1);
+    static box pools[2]; static tex_t tex[2];
+    for (unsigned i = 0; i < 2; ++i) {
+        make_pool(&pools[i]); make_tex(&tex[i], &pools[i]); tex[i].has_layout = 1;
+        nvn_dirty_add_range(pools[i].mem, POOL);
+        nvn_be_reg_tex(10+i, &tex[i], NULL);
+        nvn_be_record_texture_hint(10+i); nvn_be_advance_texture();
+        REQUIRE(rb_hash_drain() == 0);
+        CHECK(!tex_get(tex[i].serial) && !g_up_cb, "hint %u never publishes a texture or allocates a GPU batch", i);
+    }
+    // Deliberately modify the entire guest layout after the hint, before normal
+    // dirty tracking begins. Correct output and page hashes must reflect the edit.
+    for (size_t j = 0; j < tex[1].L.size / 4; ++j) ((uint32_t *)tex[1].mem)[j] = 0xc0ffaabb;
+    if (direct) nvn_be_sub_begin();
+    else g_cb = [g_q3 commandBuffer];
+    id<MTLTexture> a = tex_mtl(&tex[0]), b = tex_mtl(&tex[1]);
+    REQUIRE(a && b);
+    CHECK(g_up_cb && g_nup_blits == 2, "two ordinary CPU first uploads share an open copy batch");
+    if (direct) {
+        uint64_t fence = nvn_be_sub_commit();
+        REQUIRE(nvn_be_wait(fence, 10000000000ull)); nvn_be_drain();
+    } else { wait_uploads(); g_cb = nil; }
+    uint64_t v[9];
+    REQUIRE(nvn_rb_upload_detail_take(v));
+    CHECK(v[RB_UT_PREPARED] == tex[0].L.size + tex[1].L.size &&
+          v[RB_UT_REUSED] == tex[0].L.size, "unchanged metadata used, changed snapshot rejected");
+    CHECK(v[RB_UT_JOINED] == 2 && v[RB_UT_BLITS] == 2, "joined first uses and encoded copies counted separately");
+    CHECK(!wrong_value(a, 0x11223344) && !wrong_value(b, 0xc0ffaabb),
+          "both textures initialized at first use, including the edit after the hint");
+    NvPkg *pk = tex_get(tex[1].serial);
+    uint64_t reference[RB_HASH_PAGES];
+    REQUIRE(pk && pk->ph && pk->nph <= RB_HASH_PAGES);
+    pkg_hash_pages(&tex[1], tex[1].mem, reference, pk->nph);
+    CHECK(!memcmp(reference, pk->ph, pk->nph * sizeof(*reference)), "dirty baseline uses the final page contents");
+    rb_tx_reset();
+    for (unsigned i = 0; i < RB_HASH_SLOTS; ++i) REQUIRE(!rb_hash_slots[i]);
+    return failures != 0;
+}
 int main(int argc, char **argv) {
     @autoreleasepool {
         setvbuf(stdout, NULL, _IOLBF, 0); alarm(120);
+        if (argc == 2 && !strcmp(argv[1], "--upload-smooth")) return smooth_upload();
         if (argc == 2 && !strcmp(argv[1], "--recorded-upload")) return recorded_upload();
         mtl_init(); printf("DEVICE %s backend=Metal%d deswizzle on GPU %d page %d\n", g_dev.name.UTF8String, g_m3 ? 3 : 4, g_nvn_deswz_gpu, getpagesize());
         REQUIRE(g_nvn_deswz_gpu);   // 被测的是 GPU 解交错的取源
diff --git a/graphics/nvn/tests/t_rb_upload_budget.c b/graphics/nvn/tests/t_rb_upload_budget.c
new file mode 100644
index 0000000..bd83449
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_upload_budget.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <assert.h>
+#include <stdio.h>
+#include "../gfx/nvn/rb_upload_budget.h"
+
+int main(void) {
+    rb_hash_budget b = {0};
+    assert(!rb_hash_reserve(&b, 10, RB_HASH_ITEM + 1));
+    for (unsigned n = 0; n < 4; ++n) assert(rb_hash_reserve(&b, 10, RB_HASH_ITEM));
+    assert(!rb_hash_reserve(&b, 10, 1));
+    assert(rb_hash_reserve(&b, 11, 1));
+    rb_hash_note_demand(&b, 11, 201u << 20);
+    assert(!rb_hash_reserve(&b, 11, 1));
+    for (unsigned n = 0; n < 8; ++n) assert(rb_hash_reserve(&b, 12, 1));
+    assert(!rb_hash_reserve(&b, 12, 1));
+    assert(rb_batch_fits(0, RB_BATCH_ITEM, UINT64_MAX));
+    assert(rb_batch_fits(RB_BATCH_BYTES - 1, 1, RB_BATCH_BYTES));
+    assert(!rb_batch_fits(RB_BATCH_BYTES, 1, UINT64_MAX));
+    assert(!rb_batch_fits(0, RB_BATCH_ITEM + 1, UINT64_MAX));
+    assert(!rb_batch_fits(UINT64_MAX, 1, RB_BATCH_BYTES));
+    assert(!rb_batch_fits(0, 1, 0));
+    assert(!rb_batch_fits(512, 256, 640));
+    puts("PASS first-upload budget, burst, quota, overflow, empty and rollover");
+    return 0;
+}
