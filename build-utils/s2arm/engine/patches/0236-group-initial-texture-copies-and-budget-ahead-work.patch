diff --git a/graphics/nvn/gfx/nvn/rb_upload_budget.h b/graphics/nvn/gfx/nvn/rb_upload_budget.h
new file mode 100644
index 0000000..6d8493b
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_upload_budget.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+
+enum { RB_HASH_ITEM = 256 * 1024, RB_HASH_SLOTS = 8, RB_HASH_FRAME = 4 * RB_HASH_ITEM,
+       RB_BATCH_ITEM = 1024 * 1024, RB_BATCH_BYTES = 2 * RB_BATCH_ITEM };
+typedef struct {
+    uint64_t frame;
+    unsigned charged, attempts;
+    uint64_t demand;
+} rb_hash_budget;
+
+static inline void rb_hash_frame(rb_hash_budget *b, uint64_t frame) {
+    if (frame != b->frame) *b = (rb_hash_budget){.frame = frame};
+}
+static inline void rb_hash_note_demand(rb_hash_budget *b, uint64_t frame, uint64_t bytes) {
+    rb_hash_frame(b, frame);
+    if (b->demand < (8u << 20)) b->demand += bytes > (8u << 20) ? (8u << 20) : bytes;
+}
+static inline int rb_hash_has_room(rb_hash_budget *b, uint64_t frame) {
+    rb_hash_frame(b, frame);
+    return b->demand < (8u << 20) && b->charged < RB_HASH_FRAME && b->attempts < 8;
+}
+static inline int rb_hash_reserve(rb_hash_budget *b, uint64_t frame, uint64_t bytes) {
+    if (!rb_hash_has_room(b, frame)) return 0;
+    if (!bytes || bytes > RB_HASH_ITEM || bytes > RB_HASH_FRAME - b->charged)
+        return 0;
+    b->charged += (unsigned)bytes;
+    ++b->attempts;
+    return 1;
+}
+
+static inline int rb_batch_fits(uint64_t held, uint64_t bytes, uint64_t quota) {
+    uint64_t limit = quota < RB_BATCH_BYTES ? quota : RB_BATCH_BYTES;
+    return bytes && bytes <= RB_BATCH_ITEM && held <= limit && bytes <= limit - held;
+}
diff --git a/graphics/nvn/gfx/nvn/rb_upload_hash.inc b/graphics/nvn/gfx/nvn/rb_upload_hash.inc
new file mode 100644
index 0000000..742878a
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_upload_hash.inc
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: Apache-2.0
+// This optional cache contains hash metadata and a comparison
+// image. Nothing here is ever bound to a draw. A byte-for-byte comparison at the
+// point of first use also handles untracked aliases and edits to a recorded bind.
+enum { RB_HASH_PAGES = RB_HASH_ITEM / 4096 + 1 };
+typedef struct {
+    uint64_t serial, hashes[RB_HASH_PAGES];
+    uintptr_t address;
+    uint32_t size, pages;
+    uint8_t data[RB_HASH_ITEM];
+} rb_hash_snapshot;
+static rb_hash_snapshot *rb_hash_slots[RB_HASH_SLOTS];
+static rb_hash_budget rb_hash_work;
+
+static dispatch_group_t rb_hash_jobs;
+static dispatch_queue_t rb_hash_queue;
+static pthread_mutex_t rb_hash_lock = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic uint64_t rb_hash_epoch;
+static _Atomic BOOL rb_hash_busy;
+
+static void rb_hash_clear(BOOL drain) {
+    // Session teardown has already retired the worker. During pressure, drop old
+    // publications without introducing a lock wait on the submit path.
+    atomic_fetch_add_explicit(&rb_hash_epoch, 1, memory_order_relaxed);
+    if (drain) pthread_mutex_lock(&rb_hash_lock);
+    else if (pthread_mutex_trylock(&rb_hash_lock)) return;
+    for (unsigned i = 0; i < RB_HASH_SLOTS; ++i) {
+        free(rb_hash_slots[i]);
+        rb_hash_slots[i] = NULL;
+    }
+    pthread_mutex_unlock(&rb_hash_lock);
+}
+static void rb_hash_reset(void) {
+    rb_hash_clear(YES);
+    rb_hash_work = (rb_hash_budget){0};
+}
+static int rb_hash_drain(void) {
+    return rb_hash_jobs && dispatch_group_wait(rb_hash_jobs, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC))
+        ? -ETIMEDOUT : 0;
+}
+
+static void rb_hash_stage(const tex_t *t, uint64_t epoch, BOOL trace) {
+    uintptr_t address = (uintptr_t)t->mem;
+    size_t page = nvn_dirty_page_size(), size = t->L.size;
+    if (!address || !size || size > RB_HASH_ITEM || page < 4096 || page != (size_t)getpagesize() ||
+        address > UINTPTR_MAX - size || dm_gfx_session_stopping() || rb_mem_low()) return;
+    uint32_t pages = page_count(t);
+    char resident[RB_HASH_PAGES];
+    if (!pages || pages > RB_HASH_PAGES ||
+        mincore((void *)(address & ~(page - 1)), (size_t)pages * page, resident)) return;
+    for (uint32_t i = 0; i < pages; ++i) if (!(resident[i] & 1)) return;
+    rb_hash_snapshot *s = malloc(sizeof(*s));
+    if (!s) return;
+    // The kernel handles concurrent unmaps. Eviction after mincore can block
+    // this utility worker only. It holds no renderer lock during the copy.
+    vm_size_t copied = 0;
+    if (vm_read_overwrite(mach_task_self(), address, size, (vm_address_t)s->data, &copied) == KERN_SUCCESS &&
+        copied == size && epoch == atomic_load_explicit(&rb_hash_epoch, memory_order_relaxed)) {
+        pkg_hash_pages(t, s->data, s->hashes, pages);
+        s->address = address;
+        s->size = (uint32_t)size;
+        s->pages = pages;
+        s->serial = t->serial;
+        unsigned slot = (unsigned)(t->serial % RB_HASH_SLOTS);
+        pthread_mutex_lock(&rb_hash_lock);
+        if (epoch == atomic_load_explicit(&rb_hash_epoch, memory_order_relaxed) && !dm_gfx_session_stopping()) {
+            rb_hash_snapshot *old = rb_hash_slots[slot];
+            rb_hash_slots[slot] = s;
+            s = old;
+            if (trace) rb_upload_add(RB_UT_PREPARED, size);
+        }
+        pthread_mutex_unlock(&rb_hash_lock);
+    }
+    free(s);
+}
+
+static void rb_hash_offer(const tex_t *t, uint64_t frame) {
+    // Only the submit owner posts jobs. Never queue behind an active kernel read.
+    if (atomic_load_explicit(&rb_hash_busy, memory_order_acquire) ||
+        !rb_hash_reserve(&rb_hash_work, frame, t->L.size)) return;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        rb_hash_queue = dispatch_queue_create("rb.texture.first-hash",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+        rb_hash_jobs = dispatch_group_create();
+    });
+    // Copy just the geometry used by page_count/pkg_hash_pages. The worker
+    // never looks back through the registration, texture or guest pool object.
+    tex_t geometry = {0};
+    geometry.serial = t->serial;
+    geometry.mem = t->mem;
+    geometry.L.size = t->L.size;
+    BOOL trace = rb_upload_trace_on();
+    uint64_t epoch = atomic_load_explicit(&rb_hash_epoch, memory_order_relaxed);
+    atomic_store_explicit(&rb_hash_busy, YES, memory_order_relaxed);
+    dispatch_group_async(rb_hash_jobs, rb_hash_queue, ^{
+        rb_hash_stage(&geometry, epoch, trace);
+        atomic_store_explicit(&rb_hash_busy, NO, memory_order_release);
+    });
+}
+
+static BOOL rb_hash_claim(const tex_t *t, const uint8_t *source, uint64_t *out, uint32_t pages) {
+    unsigned slot = (unsigned)(t->serial % RB_HASH_SLOTS);
+    if (pthread_mutex_trylock(&rb_hash_lock)) return NO;
+    rb_hash_snapshot *s = rb_hash_slots[slot];
+    if (s && s->serial == t->serial) rb_hash_slots[slot] = NULL;
+    else s = NULL;
+    pthread_mutex_unlock(&rb_hash_lock);
+    if (!s) return NO;
+    BOOL same = s->address == (uintptr_t)t->mem && s->size == t->L.size && s->pages == pages &&
+                !memcmp(source, s->data, s->size);
+    if (same) memcpy(out, s->hashes, pages * sizeof(*out));
+    free(s);
+    return same;
+}
