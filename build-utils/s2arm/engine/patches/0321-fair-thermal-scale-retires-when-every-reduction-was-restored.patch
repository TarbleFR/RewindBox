diff --git a/graphics/nvn/gfx/nvn/rb_rs_retire.h b/graphics/nvn/gfx/nvn/rb_rs_retire.h
new file mode 100644
index 0000000..cab19c2
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_rs_retire.h
@@ -0,0 +1,36 @@
+// RewindBox (patch 0321): when the Fair thermal render scale (patch 0277, nvn_rscale.inc rb_fair_sample) gives up for the session. Pure C: tests/t_rb_rs_retire.c.
+//   IPA 827 (Mario Kart World, iPhone A18 Pro): the first Fair state arms the 0.85 scale and rs_on() stays true for the rest of the session. In a race every storage the
+//   scale reduces is restored to the game's size within the same frames, for a reader or a sibling attachment that cannot take a reduced storage (second.log: the count
+//   of reductions and the count of restorations both reach 65), so nothing is drawn smaller, while each new target is created and copied twice more and every pass
+//   (rs_rts) and every texture binding of a full argument walk (rs_bind_check, rs_support) keeps asking. The same number of draws cost about 24 % more submit-thread
+//   instructions after the first Fair state than before it (scenes not identical: not proven to be this alone). In the menus some 1920x1080 targets do stay reduced
+//   (first.log, frames 2100 to 3300: 11 reductions, 2 restorations): there the scale works, and the rule below does not retire it while one is alive.
+//   Rule: the scale retires when the last RB_RS_RETIRE_RUN storages it reduced were each restored for such a refusal, with no reduction that held in between (a reduced
+//   storage freed still reduced, or one the thermal recovery restored), and no storage of any kind is left reduced (live == 0: rs_on() may only become false then, since a
+//   reduced storage read with rs_on() false would be taken for one of the game's size). Retired, the scale stays off until the next session.
+//   S2A_RB_RS_RETIRE=0: as before (the step always answers 0).
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_RS_RETIRE_RUN = 8 };
+typedef struct {
+    uint32_t reduced;     // storages the Fair scale reduced this session (the log line)
+    uint32_t refused;     // of them, restored because something could not take a reduced storage (the log line)
+    uint32_t run;         // refusals since the last reduction that held
+    uint64_t held_seen;   // the count of reductions that held, as of the last step
+    uint64_t pending;     // steps that found the run complete but a reduced storage still alive (the log line)
+} rb_rs_retire;
+
+static inline void rb_rs_retire_reset(rb_rs_retire *s) { memset(s, 0, sizeof *s); }
+static inline void rb_rs_retire_reduced(rb_rs_retire *s) { s->reduced++; }
+static inline void rb_rs_retire_refused(rb_rs_retire *s) { s->refused++; if (s->run < UINT32_MAX) s->run++; }
+static inline void rb_rs_retire_held(rb_rs_retire *s) { s->run = 0; }   // the thermal recovery restored one: its reduction held until the device cooled
+// One look, at the start of a submission (no pass open). on: the switch; armed: the Fair scale has reduced targets this session (rb_fair_seen); live: reduced storages alive
+//   right now, whoever reduced them; held: the running count of Fair reductions that ended still reduced. 1 = retire now
+static inline int rb_rs_retire_step(rb_rs_retire *s, int on, int armed, long live, uint64_t held) {
+    if (held != s->held_seen) { s->held_seen = held; s->run = 0; }   // one held since the last look: the scale does something, the run starts again
+    if (!on || !armed || s->run < RB_RS_RETIRE_RUN) return 0;
+    if (live != 0) { s->pending++; return 0; }   // not while a reduced storage exists (a negative count is a bookkeeping error: never retire on it)
+    return 1;
+}
diff --git a/graphics/nvn/tests/t_rb_rs_retire.c b/graphics/nvn/tests/t_rb_rs_retire.c
new file mode 100644
index 0000000..129bbd0
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_rs_retire.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0321): host-only checks of the rule that retires the Fair thermal render scale (gfx/nvn/rb_rs_retire.h).
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../gfx/nvn/rb_rs_retire.h"
+
+static void refuse(rb_rs_retire *s, int n) { for (int i = 0; i < n; i++) { rb_rs_retire_reduced(s); rb_rs_retire_refused(s); } }
+int main(void) {
+    rb_rs_retire s;
+    // ① the race of IPA 827: every reduction refused at once, nothing left reduced: retires at the 8th refusal, not before
+    rb_rs_retire_reset(&s);
+    for (int i = 1; i <= RB_RS_RETIRE_RUN; i++) {
+        refuse(&s, 1);
+        assert(rb_rs_retire_step(&s, 1, 1, 0, 0) == (i == RB_RS_RETIRE_RUN));
+    }
+    assert(s.reduced == RB_RS_RETIRE_RUN && s.refused == RB_RS_RETIRE_RUN && s.pending == 0);
+    // ② the switch at 0, or the scale never armed: never, whatever the run
+    rb_rs_retire_reset(&s); refuse(&s, 100);
+    assert(!rb_rs_retire_step(&s, 0, 1, 0, 0));
+    assert(!rb_rs_retire_step(&s, 1, 0, 0, 0));
+    assert(!rb_rs_retire_step(&s, 0, 0, 0, 0));
+    assert(rb_rs_retire_step(&s, 1, 1, 0, 0));
+    // ③ a reduced storage still alive: not now (rs_on() must stay true for it), counted as pending; retires once it is gone
+    rb_rs_retire_reset(&s); refuse(&s, RB_RS_RETIRE_RUN);
+    assert(!rb_rs_retire_step(&s, 1, 1, 1, 0) && s.pending == 1);
+    assert(!rb_rs_retire_step(&s, 1, 1, 3, 0) && s.pending == 2);
+    assert(!rb_rs_retire_step(&s, 1, 1, -1, 0) && s.pending == 3);   // a count gone negative never retires
+    assert(rb_rs_retire_step(&s, 1, 1, 0, 0));
+    // ④ a reduction that held (a storage freed still reduced: the menus of first.log) starts the run again
+    rb_rs_retire_reset(&s); refuse(&s, RB_RS_RETIRE_RUN - 1);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 0));
+    refuse(&s, 1);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 1) && s.run == 0);   // held moved 0 -> 1 between the two looks
+    refuse(&s, RB_RS_RETIRE_RUN - 1);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 1));
+    refuse(&s, 1);
+    assert(rb_rs_retire_step(&s, 1, 1, 0, 1));
+    // … also when it is seen while the switch is off or the scale not armed (the count is still followed)
+    rb_rs_retire_reset(&s); refuse(&s, RB_RS_RETIRE_RUN);
+    assert(!rb_rs_retire_step(&s, 0, 1, 0, 5) && s.run == 0 && s.held_seen == 5);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 5));
+    // ⑤ a storage the thermal recovery restored held too: the run starts again
+    rb_rs_retire_reset(&s); refuse(&s, RB_RS_RETIRE_RUN);
+    rb_rs_retire_held(&s);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 0));
+    refuse(&s, RB_RS_RETIRE_RUN);
+    assert(rb_rs_retire_step(&s, 1, 1, 0, 0));
+    // ⑥ reductions that are not refused do not count (a scale that works never retires)
+    rb_rs_retire_reset(&s);
+    for (int i = 0; i < 1000; i++) rb_rs_retire_reduced(&s);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 0) && s.reduced == 1000 && s.refused == 0);
+    // ⑦ a new session starts from nothing
+    refuse(&s, RB_RS_RETIRE_RUN);
+    rb_rs_retire_reset(&s);
+    assert(!rb_rs_retire_step(&s, 1, 1, 0, 0) && s.reduced == 0 && s.run == 0);
+    // ⑧ the run does not wrap
+    rb_rs_retire_reset(&s); s.run = UINT32_MAX; rb_rs_retire_refused(&s);
+    assert(s.run == UINT32_MAX && rb_rs_retire_step(&s, 1, 1, 0, 0));
+    puts("t_rb_rs_retire: ok");
+    return 0;
+}
