+++ b/graphics/nvn/tests/t_rb_stage_disk.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+set -eu
+root=$(cd "$(dirname "$0")/../../.." && pwd)
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+a=0000000000000001_b
+cat > "$work/$a.metal" <<'METAL'
+#include <metal_stdlib>
+using namespace metal;
+kernel void main0(device uint *value [[buffer(0)]]) { *value += 7; }
+METAL
+for key in "$a" 0000000000000002_b; do
+    echo '{"chain":"qualification","xfp":"fixture","stage":"cs"}' > "$work/$key.json"
+done
+echo '{"chain":"qualification","xfp":"old","stage":"cs"}' > "$work/0000000000000003_b.json"
+touch "$work/0000000000000123_bv.json" "$work/unrelated.json"
+ln -s "$work/$a.json" "$work/0000000000000004_b.json"
+tag=$(shasum -a 256 "$work/$a.metal" | cut -c1-40)
+python3 "$root/graphics/tools/direct/prepare_stage_air.py" "$work" --sdk macosx
+python3 "$root/graphics/tools/direct/prepare_stage_air.py" "$work" --sdk macosx | grep '0 binaries written, 1 reused'
+python3 "$root/graphics/tools/direct/prepare_stage_air.py" "$work" --sdk iphoneos
+xcrun --sdk macosx clang -std=gnu11 -fobjc-arc -Wall -Wextra -Werror "$root/graphics/nvn/tests/t_rb_stage_disk.m" -framework Foundation -framework Metal -o "$work/test"
+"$work/test" "$work" "$tag"
diff --git a/graphics/tools/direct/prepare_stage_air.py b/graphics/tools/direct/prepare_stage_air.py
new file mode 100644
index 0000000000000000000000000000000000000000..b5af408a93dd511a42d62b38a6ae236defedc92c
--- /dev/null
+++ b/graphics/tools/direct/prepare_stage_air.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Precompile exported MSL into a private, portable Metal IR cache for one platform.
+
+Example on a Mac with the Metal toolchain:
+    python3 graphics/tools/direct/prepare_stage_air.py /path/to/title/shaders --sdk iphoneos
+Copy the resulting rb-stage-air-v1-relaxed-invariant folder beside that title's
+_b.json files. The device also prewarms original translations without this cache.
+"""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+SUFFIX = 'rb-stage-air-v1-relaxed-invariant'
+SOURCE = re.compile(r'[0-9a-f]{16}_[a-zA-Z0-9_]+\.metal\Z')
+MAX_BLOB = 64 << 20
+
+
+def digest(data):
+    return hashlib.sha256(data).digest()
+
+
+def valid(path, tag):
+    if not path.is_file() or not 80 < path.stat().st_size <= MAX_BLOB:
+        return False
+    data = path.read_bytes()
+    return data[:48] == b'RBAIR001' + tag.encode() and data[48:80] == digest(data[80:])
+
+
+def prepare(source, sdk, destination, temp):
+    tag = digest(source).hex()[:40]
+    target = destination / (tag + '.airlib')
+    if valid(target, tag):
+        return False
+    msl, air, library = (temp / f'input.{suffix}' for suffix in ('metal', 'air', 'metallib'))
+    msl.write_bytes(source)
+    minimum = '-mios-version-min=18.0' if sdk == 'iphoneos' else '-mmacosx-version-min=15.0'
+    subprocess.run(['xcrun', '--sdk', sdk, 'metal', '-c', '-w', minimum,
+                    '-fmetal-math-mode=relaxed', '-fpreserve-invariance', str(msl), '-o', str(air)], check=True)
+    subprocess.run(['xcrun', '--sdk', sdk, 'metallib', str(air), '-o', str(library)], check=True)
+    if not 0 < library.stat().st_size <= MAX_BLOB - 80:
+        raise ValueError('Metal emitted an empty or oversized library')
+    binary = library.read_bytes()
+    with tempfile.NamedTemporaryFile(dir=destination, prefix='.air-', delete=False) as f:
+        tmp = Path(f.name)
+        try:
+            f.write(b'RBAIR001' + tag.encode() + digest(binary) + binary)
+            f.flush()
+            os.replace(tmp, target)
+        finally:
+            tmp.unlink(missing_ok=True)
+    return True
+
+
+def main():
+    a = argparse.ArgumentParser(description=__doc__)
+    a.add_argument('shaders', type=Path)
+    a.add_argument('--sdk', choices=('iphoneos', 'macosx'), default='iphoneos')
+    a.add_argument('--out', type=Path, help='Root for the resulting cache (default: source directory)')
+    args = a.parse_args()
+    files = sorted(p for p in args.shaders.iterdir() if SOURCE.fullmatch(p.name) and p.is_file() and not p.is_symlink())
+    if not files:
+        a.error('No exported translated stages found')
+    dest = (args.out or args.shaders) / SUFFIX / args.sdk
+    dest.mkdir(parents=True, exist_ok=True)
+    new = existing = 0
+    with tempfile.TemporaryDirectory() as td:
+        temp = Path(td)
+        rewrite = temp/'base-instance'
+        helper = Path(__file__).with_name('rb_stage_base_instance.c')
+        subprocess.run(['xcrun','--sdk','macosx','clang','-std=c11','-D_DARWIN_C_SOURCE',
+                        '-O2',str(helper),'-o',str(rewrite)], check=True)
+        for file in files:
+            raw = file.read_bytes()
+            variants = [raw]
+            if b'(*spvDescriptorSet0.vp_c0)._m0[100].y' in raw:
+                changed = subprocess.run([str(rewrite)],input=raw,capture_output=True,check=True).stdout
+                if changed != raw: variants.append(changed)
+            for source in variants:
+                if prepare(source,args.sdk,dest,temp):
+                    new += 1
+                else:
+                    existing += 1
+    print(f'{len(files)} sources, {new} binaries written, {existing} reused: {dest}')
+
+
+if __name__ == '__main__':
+    main()
