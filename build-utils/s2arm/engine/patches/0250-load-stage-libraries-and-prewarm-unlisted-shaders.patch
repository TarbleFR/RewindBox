+    const char *path = getenv("DM_MSL_FALLBACK");
+    if (!path || !*path) return;
+    NSString *root = @(path);
+    os_unfair_lock_lock(&g_shpre_mu);
+    if (atomic_load(&g_shpre_stopping)) { os_unfair_lock_unlock(&g_shpre_mu); return; }
+    if (!g_rb_disk_q) g_rb_disk_q = dispatch_queue_create("s2a.stage-disk",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,QOS_CLASS_UTILITY,0));
+    __block NSArray<WarmTask *> *recipes = tasks;
+    dispatch_async(g_rb_disk_q, ^{ @autoreleasepool {
+        if (nvn_be_stopping()) return;
+        if (prime) {
+            NSString *dir = [root stringByAppendingPathComponent:@RB_AIR_FOLDER "/iphoneos"];
+            BOOL isDir = NO;
+            if (![NSFileManager.defaultManager fileExistsAtPath:dir isDirectory:&isDir] || !isDir) dir = nil;
+            os_unfair_lock_lock(&g_rb_disk_mu);
+            g_rb_binary_dir = dir;
+            atomic_store_explicit(&g_rb_disk_online,dir != nil,memory_order_release);
+            os_unfair_lock_unlock(&g_rb_disk_mu);
+            MLOG("[rb-shader-disk] static_air_directory=%d",dir != nil);
+            return;
+        }
+        NSMutableSet<NSString *> *covered = [NSMutableSet set];
+        for (WarmTask *task in recipes) {
+            if (task->key) [covered addObject:task->key];
+            if (task->vkey) [covered addObject:task->vkey];
+            if (task->fkey) [covered addObject:task->fkey];
+            if (task->tkey) [covered addObject:task->tkey];
+        }
+        recipes = nil; // a long thermal pause must not retain every recipe
+        NSArray<NSString *> *keys = rb_unlisted_stages(root,covered,^BOOL{ return nvn_be_stopping(); });
+        if (nvn_be_stopping()) return;
+        covered = nil;
+        atomic_store(&g_rb_disk_unlisted,keys.count);
+        MLOG("[rb-shader-disk] unlisted=%lu disk_stage_scan=complete",(unsigned long)keys.count);
+        for (NSString *key in keys) { @autoreleasepool {
+            // Worker one never receives a ONE/low-power admission. Use the
+            // governor's condition wakeups, including synchronous teardown.
+            int lease = 0;
+            while (!nvn_be_stopping() && !dm_gfx_session_stopping()) {
+                uint64_t ticket = atomic_load(&g_spec_gate.epoch);
+                if (NSProcessInfo.processInfo.thermalState == NSProcessInfoThermalStateNominal &&
+                    (!rb_gov_on() || rb_gov_quota(RB_GOV_PREFETCH)) && rb_spec_take(1,&lease)) break;
+                rb_spec_park_worker(ticket,1);
+            }
+            if (!lease || nvn_be_stopping() || dm_gfx_session_stopping()) { rb_spec_done(&lease); break; }
+            static const int host[] = {0,1,5,2,3,4}; // vs, ps, cs, gs, ts, ms
+            int st = -1;
+            if (rb_translation_available(root.fileSystemRepresentation,key,fb_xfp(),1,&st) && st >= 0 && st < 6) {
+                int stage = host[st];
+                NvShader *shader = shader_load_depth(key,stage,0,
+                    stage_depth_moded(stage) && atomic_load(&g_depth_zero),NULL,NULL);
+                if (shader) atomic_fetch_add(&g_rb_disk_loaded,1);
+                else atomic_fetch_add(&g_rb_disk_invalid,1);
+            } else atomic_fetch_add(&g_rb_disk_invalid,1);
+            rb_spec_done(&lease);
+        } }
+        rb_stage_disk_stats();
+    } });
+    os_unfair_lock_unlock(&g_shpre_mu);
+}
diff --git a/graphics/nvn/gfx/nvn/rb_unlisted_stages.h b/graphics/nvn/gfx/nvn/rb_unlisted_stages.h
new file mode 100644
index 0000000000000000000000000000000000000000..bbba02a0d10804fd83f5deac1fb4fbb1e3626a12
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_unlisted_stages.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#import <Foundation/Foundation.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <string.h>
+// Only base stages have a standalone reflection. The padded/specialized
+// variants remain owned by their parent shader and pipeline recipe.
+#include <dirent.h>
+static NSArray<NSString *> *rb_unlisted_stages(NSString *root, NSSet<NSString *> *covered, BOOL (^stopping)(void)) {
+    DIR *dir = opendir(root.fileSystemRepresentation);
+    if (!dir) return @[];
+    NSMutableArray<NSString *> *result = [NSMutableArray array];
+    struct dirent *ent;
+    while ((!stopping || !stopping()) && (ent=readdir(dir))) {
+        const char *name = ent->d_name;
+        if (strlen(name) != 23 || strcmp(name+16,"_b.json") || strspn(name,"0123456789abcdef") != 16) continue;
+        NSString *key = [[NSString alloc] initWithBytes:name length:18 encoding:NSASCIIStringEncoding];
+        if ([covered containsObject:key]) continue;
+        struct stat st;
+        if (fstatat(dirfd(dir),name,&st,AT_SYMLINK_NOFOLLOW) || !S_ISREG(st.st_mode)) continue;
+        [result addObject:key];
+    }
+    closedir(dir);
+    [result sortUsingSelector:@selector(compare:)];
+    return result;
+}
diff --git a/graphics/nvn/tests/t_rb_stage_disk.m b/graphics/nvn/tests/t_rb_stage_disk.m
new file mode 100644
index 0000000000000000000000000000000000000000..aa96afb752ba2a05110d1dd2f0a0e394435d31d2
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_stage_disk.m
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MIT
+#import "../gfx/nvn/rb_stage_binary.h"
+#import "../gfx/nvn/rb_unlisted_stages.h"
+#define DMSH_CHAIN "qualification"
+#import "../gfx/nvn/rb_stage_reflection.h"
+
+static int check(BOOL condition,const char *name) {
+    if (!condition) fprintf(stderr,"FAIL: %s\n",name);
+    return condition ? 0 : 1;
+}
+int main(int argc,char **argv) {
+    if (argc != 3) return 2;
+    @autoreleasepool {
+        NSString *root=@(argv[1]), *tag=@(argv[2]);
+        NSArray *keys=rb_unlisted_stages(root,[NSSet setWithObject:@"0000000000000002_b"],nil);
+        if (check([keys isEqual:@[@"0000000000000001_b",@"0000000000000003_b"]],"complete, ordered orphan keys")) return 1;
+        int stage=-1;
+        if (check(rb_translation_available(argv[1],keys[0],"fixture",0,&stage) && stage==2,"current compute reflection")) return 1;
+        if (check(!rb_translation_available(argv[1],keys[1],"fixture",0,NULL),"stale translator excluded")) return 1;
+        id<MTLDevice> dev=MTLCreateSystemDefaultDevice();
+        NSString *dir=[root stringByAppendingPathComponent:@RB_AIR_FOLDER "/macosx"];
+        NSUInteger rejected=0;
+        id<MTLLibrary> lib=rb_read_stage_binary(dev,dir,tag,&rejected);
+        if (check(lib && !rejected,"platform loaded a persisted static library")) return 1;
+        NSError *error=nil;
+        id<MTLComputePipelineState> p=[dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"main0"] error:&error];
+        if (check(p!=nil,"create pipeline using persisted entry")) return 1;
+        id<MTLBuffer> b=[dev newBufferWithLength:sizeof(uint32_t) options:MTLResourceStorageModeShared];
+        *(uint32_t *)b.contents=5;
+        id<MTLCommandQueue> q=[dev newCommandQueue];
+        id<MTLCommandBuffer> cb=[q commandBuffer];
+        id<MTLComputeCommandEncoder> ce=[cb computeCommandEncoder];
+        [ce setComputePipelineState:p]; [ce setBuffer:b offset:0 atIndex:0];
+        [ce dispatchThreads:MTLSizeMake(1,1,1) threadsPerThreadgroup:MTLSizeMake(1,1,1)];
+        [ce endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        if (check(!cb.error && *(uint32_t *)b.contents==12,"persisted MSL produces expected pixels/data")) return 1;
+        NSString *missing=@"0000000000000000000000000000000000000000";
+        if (check(!rb_read_stage_binary(dev,dir,missing,&rejected) && !rejected,"absent entry remains a miss")) return 1;
+        NSString *path=[dir stringByAppendingPathComponent:[tag stringByAppendingPathExtension:@"airlib"]];
+        NSMutableData *bad=[[NSData dataWithContentsOfFile:path] mutableCopy];
+        ((uint8_t *)bad.mutableBytes)[bad.length-1]^=1;
+        if (check([bad writeToFile:path atomically:YES],"replace fixture")) return 1;
+        if (check(!rb_read_stage_binary(dev,dir,tag,&rejected) && rejected,"damaged binary rejected")) return 1;
+        puts("PASS matching/stale/unlisted translated stages, persisted executable shader, GPU output 12, absent and damaged binaries");
+        return 0;
+    }
+}
diff --git a/graphics/nvn/tests/t_rb_stage_disk.sh b/graphics/nvn/tests/t_rb_stage_disk.sh
