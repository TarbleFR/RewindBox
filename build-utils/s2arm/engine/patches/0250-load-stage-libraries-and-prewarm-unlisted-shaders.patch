index 0000000000000000000000000000000000000000..d08e19375c43ef9511b47fccf58062ab95b39c77
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_stage_binary.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <CommonCrypto/CommonDigest.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// AIR executable libraries are produced by the platform Metal compiler, not the
+// pipeline archive. Validate the exact MSL and binary bytes before using one.
+#define RB_AIR_FOLDER "rb-stage-air-v1-relaxed-invariant"
+static id<MTLLibrary> rb_read_stage_binary(id<MTLDevice> device, NSString *dir,
+                                            NSString *digest, NSUInteger *rejected) {
+    *rejected = 0;
+    if (digest.length != 40) return nil;
+    NSString *path = [dir stringByAppendingPathComponent:[digest stringByAppendingPathExtension:@"airlib"]];
+    int fd = open(path.fileSystemRepresentation, O_RDONLY | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) return nil;
+    struct stat st;
+    size_t header = 8+40+CC_SHA256_DIGEST_LENGTH;
+    if (fstat(fd,&st) || !S_ISREG(st.st_mode) || st.st_size <= (off_t)header ||
+        st.st_size > (64ll << 20)) { close(fd); *rejected = 1; return nil; }
+    size_t size = (size_t)st.st_size;
+    uint8_t *bytes = mmap(NULL,size,PROT_READ,MAP_PRIVATE,fd,0);
+    close(fd);
+    if (bytes == MAP_FAILED) { *rejected = 1; return nil; }
+    uint8_t sum[CC_SHA256_DIGEST_LENGTH];
+    size_t payload = size-header;
+    if (memcmp(bytes,"RBAIR001",8) || memcmp(bytes+8,digest.UTF8String,40) ||
+        memcmp(bytes+48,CC_SHA256(bytes+header,(CC_LONG)payload,sum),sizeof sum)) {
+        munmap(bytes,size); *rejected = 1; return nil;
+    }
+    dispatch_data_t data = dispatch_data_create(bytes+header,payload,NULL,^{ munmap(bytes,size); });
+    NSError *error=nil;
+    id<MTLLibrary> library=[device newLibraryWithData:data error:&error];
+    if (!library) *rejected = 1;
+    return library;
+}
