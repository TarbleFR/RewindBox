new file mode 100644
index 0000000000000000000000000000000000000000..b7dcf35694d17f7be3520c95d2cf96f467051f53
--- /dev/null
+++ b/graphics/tools/direct/rb_stage_base_instance.c
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: MIT
+// The host preparation tool feeds the same UTF-8 source as the runtime.
+#include "../../nvn/gfx/nvn/rb_base_instance_source.h"
+int main(void) {
+    char *src = NULL;
+    size_t size = 0;
+    ssize_t length = getdelim(&src,&size,'\0',stdin);
+    if (length < 0 || !feof(stdin)) { free(src); return 1; }
+    unsigned r,e,l;
+    char *out = rb_binst_fix(src,(size_t)length,&r,&e,&l);
+    size_t bytes = out ? strlen(out) : (size_t)length;
+    int success = fwrite(out ? out : src,1,bytes,stdout) == bytes && !fflush(stdout);
+    free(out); free(src); return success ? 0 : 1;
+}
