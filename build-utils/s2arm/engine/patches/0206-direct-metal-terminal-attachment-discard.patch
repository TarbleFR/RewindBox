diff --git a/graphics/nvn/gfx/nvn/nvn_rb_direct.h b/graphics/nvn/gfx/nvn/nvn_rb_direct.h
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_rb_direct.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+// The hosted launch context sets the identifier before command recording starts.
+static inline int rb_direct_option(_Atomic int *cached, const char *name)
+{
+    int mode = atomic_load_explicit(cached, memory_order_relaxed);
+    if (!mode) {
+        const char *title = getenv("S2A_RB_DIRECT_GAME_ID");
+        const char *option = getenv(name);
+        mode = title && !strcasecmp(title, "04007EF01F8AE000") &&
+               (!option || !strcmp(option, "1")) ? 2 : 1;
+        atomic_store_explicit(cached, mode, memory_order_relaxed);
+    }
+    return mode == 2;
+}
+
+static inline int rb_direct_discard(void)
+{
+    static _Atomic int mode;
+    return rb_direct_option(&mode, "S2A_RB_GPU_DISCARD");
+}
