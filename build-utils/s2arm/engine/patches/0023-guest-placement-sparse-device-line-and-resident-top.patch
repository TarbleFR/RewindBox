+// When to log it: the footprint risen by RB_TOP_STEP since the mark (at most RB_TOP_LINES lines), or force: a once-only event (RB_TOP_FORCED of them), logged whatever the growth
+//   and the count. Any thread holding none of g_res_mu, g_mu, g_smu
+static void rb_res_top_check(const char *why, int force) {
+    if (!force && atomic_load_explicit(&g_rb_top_lines, memory_order_relaxed) >= RB_TOP_LINES) return;
+    uint64_t fp, av; rb_up_mem(&fp, &av);
+    if (!fp) { static _Atomic int said; if (!atomic_exchange(&said, 1)) MLOG("RewindBox: resident top: the process's footprint could not be read (task_info), so no such line is logged"); return; }
+    uint64_t was = atomic_load(&g_rb_top_fp);
+    if (!force && !was) { atomic_compare_exchange_strong(&g_rb_top_fp, &was, fp); return; }   // no mark yet (the device line could not read one): this is the first
+    if (!force && fp + RB_TOP_STEP < was) { atomic_compare_exchange_strong(&g_rb_top_fp, &was, fp); return; }   // fallen more than a step below the mark: it follows, with no line
+    if (!force && fp < was + RB_TOP_STEP) return;
+    if (force) atomic_store(&g_rb_top_fp, fp);
+    else if (!atomic_compare_exchange_strong(&g_rb_top_fp, &was, fp)) return;   // another thread took this step
+    int n = atomic_fetch_add(&g_rb_top_lines, 1);
+    if (force || n < RB_TOP_LINES) res_top(why, fp, was, av, n + 1);
+}
+// Metal refused a staging buffer: forced at the first refusal, in one piece (pkg_upload_) or a piece (rb_up_refused), whichever comes first; a later one as any other call
+static void rb_res_top_refused(const char *why) { static _Atomic int once; rb_res_top_check(why, !atomic_exchange(&once, 1)); }
+// Upstream's res_top_once (seedds/nxnative 1d4b8e82, dm/gfx/nvn/nvn_mtl.m:491-497 at 0c078130): the first command buffer error that says OutOfMemory, forced. Called by
+//   mtl_gpu_cb_error, S2Arm's one entry for command buffer errors (main replay, segments, uploads, display, screenshots, the Vulkan and GL front ends), from Metal's completion
+//   handlers, which hold no lock at that call (those that take g_mu, g_smu or g_res_mu take it before and release it, or take it after), and no thread waits for a command
+//   buffer while holding one of the three (fence waits release g_mu in pthread_cond_timedwait). Off the submit thread res_top names no packaged texture and no staging.
+//   S2Arm adaptations: through rb_res_top_check, forced (one of RB_TOP_FORCED); Metal 3's MTLCommandBufferErrorOutOfMemory code counts too; no stop after 32 such failures
+//   within a minute (upstream's MDIE)
+static void rb_res_top_oom(NSError *e) {
+    static _Atomic int done;
+    if (!e || atomic_load_explicit(&done, memory_order_relaxed)) return;   // after the first, nothing more is read from an error
+    if (!([e.description containsString:@"OutOfMemory"] || ([e.domain isEqualToString:MTLCommandBufferErrorDomain] && e.code == MTLCommandBufferErrorOutOfMemory))) return;
+    if (!atomic_exchange(&done, 1)) rb_res_top_check("the first GPU out-of-memory error", 1);
+}
+static void rb_res_top_tick(void) {   // the start of a submission (submit thread): at most every RB_TOP_EVERY_NS
+    static _Atomic uint64_t last;
+    if (atomic_load_explicit(&g_rb_top_lines, memory_order_relaxed) >= RB_TOP_LINES) return;
+    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (now - atomic_load_explicit(&last, memory_order_relaxed) < RB_TOP_EVERY_NS) return;
+    atomic_store_explicit(&last, now, memory_order_relaxed);
+    rb_res_top_check("at the start of a submission", 0);
