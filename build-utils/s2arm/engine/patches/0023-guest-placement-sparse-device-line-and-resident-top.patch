+    switch (y) {
+        case MTLTextureType2D: return "2D"; case MTLTextureType2DArray: return "2D array"; case MTLTextureType3D: return "3D"; case MTLTextureTypeCube: return "cube";
+        case MTLTextureTypeCubeArray: return "cube array"; case MTLTextureType2DMultisample: return "2D multisample"; case MTLTextureType2DMultisampleArray: return "2D multisample array";
+        default: return "other";
+    }
+}
+typedef struct { const void *p; uint64_t z; } rb_top_buf;
+// A buffer of the open upload batch (g_up_keep): h where its bytes start; v 1 a zero-copy view of a pool's pages (up_tex_src; ga: their guest address), 2 of a finalized pool's, 0 staging
+typedef struct { const void *p; uintptr_t h; uint64_t ga; int v; } rb_top_keep;
+static int rb_top_keep_cmp(const void *a, const void *b) { uintptr_t x = ((const rb_top_keep *)a)->h, y = ((const rb_top_keep *)b)->h; return x < y ? -1 : x > y; }
+static void rb_top_keep_mark(rb_top_keep *kp, size_t nk, uintptr_t h0, uintptr_t h1, uint64_t g0, int v) {   // kp sorted by h: those whose bytes start in [h0, h1), the host bytes of a pool at guest g0
+    size_t lo = 0, hi = nk; while (lo < hi) { size_t m = (lo + hi) / 2; if (kp[m].h < h0) lo = m + 1; else hi = m; }
+    for (; lo < nk && kp[lo].h < h1; lo++) if (!kp[lo].v) { kp[lo].v = v; kp[lo].ga = g0 + (kp[lo].h - h0); }
+}
