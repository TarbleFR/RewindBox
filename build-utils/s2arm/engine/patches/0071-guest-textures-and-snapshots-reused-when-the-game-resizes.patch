+        if (g_rb_press_src) { dispatch_source_set_event_handler(g_rb_press_src, ^{ rb_low_from(atomic_load_explicit(&g_cur_frame, memory_order_relaxed), 1); rb_press_release(); }); dispatch_resume(g_rb_press_src); } });
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
