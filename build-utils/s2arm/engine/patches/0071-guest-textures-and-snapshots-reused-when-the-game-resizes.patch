+// RewindBox (patch 0071): memory pressure for this patch's reuse pools (shared textures below, snapshot storage with fb_prepare, the finalized-texture ring): a warning or critical
+//   event from the system (a dispatch source) or, on iOS, less than RB_REUSE_ROOM_MB left before the process limit (os_proc_available_memory, read once a frame; 0 = no limit known)
+//   makes them keep nothing new and let go what they keep. Any thread
+//   Review of 0071: the low state lasted one frame and only whichever pool looked in that frame saw an event, so in a steady scene, parked or in the background nothing was let go.
+//   Now the low state holds RB_PRESS_HOLD frames after an event or low headroom (rb_low_from); each start of one and each event moves g_rb_press, which every pool compares
+//   with what it last saw; the event handler itself lets the kept shared textures go and brings the ring down (rb_press_release, any frame or none)
+enum { RB_REUSE_ROOM_MB = 1024, RB_PRESS_HOLD = 600 };
+static _Atomic uint64_t g_rb_press, g_rb_low_n, g_rb_low_until;   // g_rb_press: events and starts of a low state; the low state lasts while g_cur_frame < g_rb_low_until
+static dispatch_source_t g_rb_press_src;
+static _Atomic int g_snp_give, g_snp_sweep;   // RewindBox (patch 0071 review): the snapshot pools let everything go (the low-region ledger) / their idle textures (the 300-frame report) at the next submission end (snp_maint)
+static void rb_press_release(void);   // the event handler's release (defined with the ring, after tex_put)
+static void rb_low_from(uint64_t f, int event) {   // any thread: a low state starts, or goes on, for RB_PRESS_HOLD frames from frame f
+    if (f >= atomic_load(&g_rb_low_until)) { atomic_fetch_add(&g_rb_low_n, 1); atomic_fetch_add(&g_rb_press, 1); }   // a new one: counted, and every pool lets go once
+    else if (event) atomic_fetch_add(&g_rb_press, 1);   // an event inside one: let go again
+    atomic_store(&g_rb_low_until, f + RB_PRESS_HOLD);
+}
+static int rb_mem_low(void) {
