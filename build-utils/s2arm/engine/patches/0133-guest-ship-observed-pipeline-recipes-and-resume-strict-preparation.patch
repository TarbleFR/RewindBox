 // Reference input comes from two real draws in a different process. The next
 // install begins with an empty personal history. The two distinct vertices
 // share one fragment, as at frame 4815. The programs and pixels are synthetic.
+static int reference_pause_mode;
+static int reference_pause_state;
+static int reference_other_lease;
+static void reference_test_key(uint64_t count) {
+    if (count!=1 || !reference_pause_mode) return;
+    atomic_store(&g_fu_waiting,1);
+    GPU_CHECK(rb_spec_take(0,&reference_other_lease));
+    rb_spec_publish(&g_spec_gate,RB_SPEC_HOLD);
+}
+static void reference_test_pause(int reason) {
+    if (!reference_pause_mode || !reason) return;
+    uint64_t counts[6]; GPU_CHECK(s2a_rb_guest_prepare_gpu_status(counts)==0 && counts[4]==1);
+    if (reason==1 && reference_pause_state==0) {
+        ++reference_pause_state; atomic_store(&g_fu_waiting,0);
+    } else if (reason==2 && reference_pause_state==1) {
+        ++reference_pause_state;
+        if (reference_pause_mode==2) GPU_CHECK(!nvn_be_request_stop());
+        else rb_spec_publish(&g_spec_gate,RB_SPEC_ONE);
+    } else if (reason==2 && reference_pause_state==2) {
+        ++reference_pause_state; rb_spec_done(&reference_other_lease); rb_spec_publish(&g_spec_gate,RB_SPEC_RUN);
+    }
