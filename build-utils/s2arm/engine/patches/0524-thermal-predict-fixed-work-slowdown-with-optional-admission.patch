diff --git a/graphics/nvn/gfx/nvn/rb_energy_predict.h b/graphics/nvn/gfx/nvn/rb_energy_predict.h
new file mode 100644
index 0000000..603f9b8
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_energy_predict.h
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include "rb_energy_guard.h"
+
+#define RB_ENERGY_PRED_AGE_NS UINT64_C(2000000000)
+#define RB_ENERGY_PRED_GAP_NS UINT64_C(10000000000)
+#define RB_ENERGY_PRED_SPACING_NS UINT64_C(1000000000)
+#define RB_ENERGY_PRED_SUSTAIN_NS UINT64_C(4000000000)
+#define RB_ENERGY_PRED_PREVENT_NS UINT64_C(6000000000)
+#define RB_ENERGY_PRED_RECOVER_NS UINT64_C(4000000000)
+
+enum {
+    RB_ENERGY_NORMAL, RB_ENERGY_WATCH, RB_ENERGY_PREVENT,
+    RB_ENERGY_SLOW, RB_ENERGY_RECOVER
+};
+
+typedef struct {
+    uint64_t seen_ns, last_ns, busy_since_ns, state_ns;
+    uint64_t reference_ns, calibration_min_ns, calibration_max_ns, calibration_sum_ns;
+    unsigned calibration_count, rises, slow, light, calm;
+    unsigned ratio_permille;
+    int trend_permille_s, state;
+} rb_energy_predictor;
+
+static inline void rb_energy_predict_clear(rb_energy_predictor *s) {
+    uint64_t seen = s->seen_ns, reference = s->reference_ns;
+    *s = (rb_energy_predictor){.seen_ns = seen, .reference_ns = reference};
+}
+
+static inline void rb_energy_predict_state(rb_energy_predictor *s, int state, uint64_t now) {
+    if (s->state != state) {
+        s->state = state;
+        s->state_ns = now;
+    }
+}
+
+// Confirm a lower envelope with three agreeing busy observations.
+// A warm launch can establish a relative envelope, never a known cold clock.
+static inline int rb_energy_predict_calibrate(rb_energy_predictor *s, uint64_t duration) {
+    if (s->reference_ns && duration * 10 >= s->reference_ns * 9) {
+        s->calibration_count = 0;
+        return 0;
+    }
+    uint64_t lo = s->calibration_min_ns < duration ? s->calibration_min_ns : duration;
+    uint64_t hi = s->calibration_max_ns > duration ? s->calibration_max_ns : duration;
+    if (!s->calibration_count || hi * 100 > lo * 115) {
+        s->calibration_min_ns = s->calibration_max_ns = s->calibration_sum_ns = duration;
+        s->calibration_count = 1;
+        return 0;
+    }
+    s->calibration_min_ns = lo;
+    s->calibration_max_ns = hi;
+    s->calibration_sum_ns += duration;
+    if (++s->calibration_count < 3) return 0;
+    s->reference_ns = s->calibration_sum_ns / 3;
+    s->calibration_count = 0;
+    return 1;
+}
+
+static inline unsigned rb_energy_predict_limit(const rb_energy_predictor *s) {
+    if (s->state == RB_ENERGY_PREVENT || s->state == RB_ENERGY_SLOW) return 1;
+    return s->state == RB_ENERGY_RECOVER ? 2u : 0u;
+}
+
+static inline void rb_energy_predict_expire(rb_energy_predictor *s, uint64_t now, int eligible) {
+    if (!eligible || (s->last_ns && (now < s->last_ns || now - s->last_ns > RB_ENERGY_PRED_GAP_NS))) {
+        rb_energy_predict_clear(s);
+    } else if (s->state == RB_ENERGY_PREVENT && now >= s->state_ns && now - s->state_ns >= RB_ENERGY_PRED_PREVENT_NS) {
+        s->calm = s->rises = 0;
+        rb_energy_predict_state(s, RB_ENERGY_RECOVER, now);
+    } else if (s->state == RB_ENERGY_RECOVER && now >= s->state_ns && now - s->state_ns >= RB_ENERGY_PRED_RECOVER_NS) {
+        s->calm = s->rises = 0;
+        rb_energy_predict_state(s, RB_ENERGY_NORMAL, now);
+    }
+}
+
+// A slope is evaluated only across independently submitted, corroborated
+// probes. Missing workload, absence of a probe and OS restrictions are unknown.
+static inline int rb_energy_predict_update(rb_energy_predictor *s, uint64_t now, uint64_t submitted,
+                                           uint64_t duration, int work, int eligible) {
+    rb_energy_predict_expire(s, now, eligible);
+    if (!submitted || submitted <= s->seen_ns || submitted > now) return 0;
+    s->seen_ns = submitted;
+    if (!eligible || now - submitted > RB_ENERGY_PRED_AGE_NS ||
+        !rb_energy_probe_valid(duration) ||
+        (s->last_ns && submitted - s->last_ns < RB_ENERGY_PRED_SPACING_NS)) return 0;
+
+    if (work != RB_ENERGY_WORK_BUSY) {
+        s->busy_since_ns = 0;
+        s->calibration_count = s->rises = s->slow = s->calm = 0;
+        s->trend_permille_s = 0;
+        if (work == RB_ENERGY_WORK_LIGHT) {
+            s->last_ns = submitted;
+            s->ratio_permille = 0;
+            if (s->light < 2) ++s->light;
+            if (s->light == 2 || s->state == RB_ENERGY_WATCH)
+                rb_energy_predict_state(s, RB_ENERGY_NORMAL, now);
+        } else {
+            s->light = 0;
+            s->ratio_permille = 0;
+        }
+        return 1;
+    }
+
+    s->light = 0;
+    if (!s->busy_since_ns) s->busy_since_ns = submitted;
+    int recalibrated = rb_energy_predict_calibrate(s, duration);
+    unsigned previous_ratio = s->ratio_permille;
+    uint64_t previous_ns = s->last_ns;
+    s->last_ns = submitted;
+    if (recalibrated) {
+        s->rises = s->slow = s->calm = 0;
+        rb_energy_predict_state(s, RB_ENERGY_NORMAL, now);
+        previous_ratio = 0;
+    }
+    s->ratio_permille = s->reference_ns ? (unsigned)(duration * 1000 / s->reference_ns) : 0;
+    s->trend_permille_s = previous_ratio && previous_ns ?
+        (int)(((int64_t)s->ratio_permille - previous_ratio) * INT64_C(1000000000) /
+              (int64_t)(submitted - previous_ns)) : 0;
+    if (!s->ratio_permille) return 1;
+
+    if (s->ratio_permille >= 1600) {
+        if (s->slow < 2) ++s->slow;
+    } else s->slow = 0;
+    if (s->ratio_permille <= 1150) {
+        if (s->calm < 2) ++s->calm;
+    } else s->calm = 0;
+
+    if (s->ratio_permille >= 1100 && s->trend_permille_s >= 25) {
+        if (s->rises < 2) ++s->rises;
+    } else s->rises = 0;
+
+    if (s->slow == 2) {
+        rb_energy_predict_state(s, RB_ENERGY_SLOW, now);
+    } else if (s->state == RB_ENERGY_SLOW) {
+        if (s->ratio_permille <= 1250) rb_energy_predict_state(s, RB_ENERGY_RECOVER, now);
+    } else if (s->state == RB_ENERGY_PREVENT || s->state == RB_ENERGY_RECOVER) {
+        if (s->calm == 2)
+            rb_energy_predict_state(s, s->state == RB_ENERGY_PREVENT ? RB_ENERGY_RECOVER : RB_ENERGY_NORMAL, now);
+    } else if (s->rises == 2 && s->ratio_permille >= 1200 && s->ratio_permille < 1600 &&
+               submitted - s->busy_since_ns >= RB_ENERGY_PRED_SUSTAIN_NS) {
+        rb_energy_predict_state(s, RB_ENERGY_PREVENT, now);
+    } else {
+        rb_energy_predict_state(s, s->rises ? RB_ENERGY_WATCH : RB_ENERGY_NORMAL, now);
+    }
+    return 1;
+}
