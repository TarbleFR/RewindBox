diff --git a/graphics/tools/direct/dsh/RbUniformExtents.cs b/graphics/tools/direct/dsh/RbUniformExtents.cs
new file mode 100644
index 0000000..9694d1a
--- /dev/null
+++ b/graphics/tools/direct/dsh/RbUniformExtents.cs
@@ -0,0 +1,52 @@
+// Bounds from the same typed SPIR-V passed to SPIRV-Cross. A missing binding
+// means "unknown": it can never shorten an allocation or a transfer.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.Json.Nodes;
+using S2A.DirectCompiler;
+
+namespace S2A.Dsh
+{
+    static class RbUniformExtents
+    {
+        internal static List<object> Analyze(byte[] spv, JsonArray buffers)
+        {
+            var rows = new List<object>();
+            // More than one descriptor for a guest slot requires a union. One
+            // dynamic or unmodelled descriptor disqualifies the entire slot.
+            foreach (var slotGroup in buffers.GroupBy(b => (int)b["slot"]))
+            {
+                int slot = slotGroup.Key;
+                if (slot != 1 && (slot < 3 || slot > 16)) continue;
+                int end = 0;
+                foreach (JsonNode b in slotGroup)
+                {
+                    int[][] ranges = DirectComputeC0Reads.Analyze(spv, 0, (int)b["binding"]);
+                    if (ranges == null) { end = -1; break; }
+                    foreach (int[] range in ranges)
+                    {
+                        if (range[0] < 0 || range[1] <= 0 || range[1] > 65536 || range[0] > 65536 - range[1])
+                        { end = -1; break; }
+                        end = Math.Max(end, range[0] + range[1]);
+                    }
+                    if (end < 0) break;
+                }
+                if (end > 0) rows.Add(new List<object> { (long)slot, (long)end });
+            }
+            return rows;
+        }
+
+        internal static void Record(PyDict reflection, byte[] spv, JsonObject resources, string source)
+        {
+            if (spv == null || resources["cbufs"] is not JsonArray buffers) return;
+            var rows = Analyze(spv, buffers);
+            if (rows.Count == 0) return;
+            reflection["rb_uniform_v1"] = new PyDict {
+                ["source_sha256"] = Convert.ToHexStringLower(Sha256.HashData(Encoding.UTF8.GetBytes(source))),
+                ["slots"] = rows
+            };
+        }
+    }
+}
