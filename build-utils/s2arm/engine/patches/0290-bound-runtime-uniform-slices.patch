+++ b/graphics/tools/direct/tests/rb_uniform_extents/Program.cs
@@ -0,0 +1,76 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Text.Json.Nodes;
+using System.Text.RegularExpressions;
+using S2A.Dsh;
+
+// Each Uniform has the translator's struct { vec4 data[N]; } ABI. Offsets
+// and result types are independent of the Metal unit used by the GPU test.
+static class Program
+{
+    static byte[] Spv(int c1Word, int uboWord, bool dynamic = false, bool escape = false, bool vector = false)
+    {
+        var w = new List<uint> { 0x07230203, 0x10000, 0, 3000, 0 };
+        void Op(uint op, params uint[] args) { w.Add(((uint)args.Length + 1) << 16 | op); w.AddRange(args); }
+        Op(21, 301, 32, 0); Op(22, 302, 32); Op(23, 303, 302, 4);
+        Op(43, 301, 310, 4100); Op(28, 304, 303, 310); Op(30, 305, 304);
+        Op(32, 306, 2, 305); Op(32, 307, 2, 302); Op(32, 308, 2, 303);
+        Op(71, 304, 6, 16); Op(72, 305, 0, 35, 0); Op(43, 301, 311, 0);
+        void Read(uint id, uint binding, int word, bool indirect, bool escapes, bool wide)
+        {
+            Op(71, id, 33, binding); Op(71, id, 34, 0); Op(59, 306, id, 2);
+            Op(43, 301, id+1, (uint)word / 4); Op(43, 301, id+2, (uint)word % 4);
+            uint index = indirect ? 2999u : id+1;
+            if (wide) Op(65, 308, id+3, id, 311, index);
+            else Op(65, 307, id+3, id, 311, index, id+2);
+            Op(61, wide ? 303u : 302u, id+4, id+3);
+            if (escapes) Op(83, 307, id+5, id+3);
+        }
+        Read(1500, 7, c1Word, false, false, false);
+        Read(1600, 9, uboWord, dynamic, escape, vector);
+        return MemoryMarshal.AsBytes(w.ToArray().AsSpan()).ToArray();
+    }
+
+    const string Preamble = "#include <metal_stdlib>\nusing namespace metal;\nstruct V { float4 p [[position]]; float2 rg; };\n";
+    const string VS = Preamble + "vertex V v(uint i [[vertex_id]], constant float *c [[buffer(0)]], constant float *u [[buffer(1)]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],0,1),float2(u[3],c[63])}; }";
+    const string FS = Preamble + "fragment float4 f(V in [[stage_in]], constant float *c [[buffer(0)]], constant float *u [[buffer(1)]]) { return float4(in.rg,u[1020],1-c[128]); }";
+
+    static void Main(string[] args)
+    {
+        Directory.CreateDirectory(args[0]);
+        string chain = Regex.Match(File.ReadAllText(args[1]), "DMSH_CHAIN \"([0-9a-f]+)\"").Groups[1].Value;
+        if (chain.Length == 0) throw new Exception("missing chain");
+        const string mapping = "[{\"slot\":1,\"binding\":7},{\"slot\":3,\"binding\":9}]";
+        var buffers = JsonNode.Parse(mapping).AsArray();
+        void Expect(byte[] spv, JsonArray map, string expected)
+        {
+            string actual = string.Join(",", RbUniformExtents.Analyze(spv,map).Cast<List<object>>().Select(row => string.Join("/",row)));
+            if (actual != expected) throw new Exception($"expected {expected}, got {actual}");
+        }
+        Expect(Spv(63,3), buffers,"1/256,3/16");
+        Expect(Spv(128,1020), buffers,"1/516,3/4084");
+        Expect(Spv(63,4,vector:true), buffers,"1/256,3/32");
+        Expect(Spv(63,4,dynamic:true), buffers,"1/256");
+        Expect(Spv(63,4,escape:true), buffers,"1/256");
+        Expect(Spv(63,16384), buffers,"1/256");
+        // Multiple descriptors alias one guest slot. Its upper bound must
+        // include all mapped reads; an unknown descriptor invalidates it.
+        var aliases = JsonNode.Parse("[{\"slot\":3,\"binding\":7},{\"slot\":3,\"binding\":9}]").AsArray();
+        Expect(Spv(128,1020), aliases,"3/4084");
+        Expect(Spv(128,0,dynamic:true), aliases,"");
+
+        void Write(string stage, string key, string src, byte[] spv)
+        {
+            var json = new PyDict { ["key"]=key, ["stage"]=stage, ["route"]="B", ["chain"]=chain, ["xfp"]="uniform-fixture" };
+            RbUniformExtents.Record(json,spv,new JsonObject {["cbufs"]=buffers.DeepClone()},src);
+            File.WriteAllText(Path.Combine(args[0],key+".json"),Py.Dumps(json));
+            File.WriteAllText(Path.Combine(args[0],key+".metal"),src);
+        }
+        Write("vs","0000000000000011_b",VS,Spv(63,3));
+        Write("ps","0000000000000022_b",FS,Spv(128,1020));
+        Console.WriteLine("PASS SPIR-V C1/UBO exact typed reads, vector width, alias union, dynamic, pointer escape, 64 KiB overflow; wrote two stage proofs");
+    }
+}
diff --git a/graphics/tools/direct/tests/rb_uniform_extents/native_translation.py b/graphics/tools/direct/tests/rb_uniform_extents/native_translation.py
new file mode 100644
index 0000000..b1196a1
--- /dev/null
+++ b/graphics/tools/direct/tests/rb_uniform_extents/native_translation.py
@@ -0,0 +1,51 @@
+"""Assert that the actual Ampere -> hardened SPIR-V -> MSL translator emits the proof."""
+import ctypes
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import struct
+import sys
+import tempfile
+
+
+def main():
+    spec = importlib.util.spec_from_file_location("ampere", "tests/ampere_isa/cases.py")
+    ampere = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(ampere)
+    # MOV R0,c[1][252]; MOV R1,c[3][4092]. Both outputs are observable.
+    from_c1 = ampere.alu(0x002, 5, 0, off=(38, 252), bank=(54, 1), m=(72, 0xf))
+    text, original = ampere.shader([from_c1, ampere.MOVC(1, 1023), ampere.MOVI(2, 3), ampere.MOVI(3, 4)])
+    control = bytearray(original)
+    code = text + bytes(range(256))
+    struct.pack_into("<II", control, 0x40, len(text), len(code))
+    key = hashlib.sha256(control[:0x48] + code).hexdigest()[:16]
+    with tempfile.TemporaryDirectory() as temp:
+        root = Path(temp)
+        facts = root / "game" / "shaders" / "direct"
+        facts.mkdir(parents=True)
+        (facts / "shader_facts.tsv").write_text(key + '\t{"fout":{"0":"uint"}}\n')
+        (facts / "shader_pairs.tsv").write_text("")
+        os.environ["S2A_GAME_DATA"] = str(root / "game")
+        os.environ["S2A_RB_UNIFORM_EXTENTS"] = "1"
+        translator = ctypes.CDLL(sys.argv[1])
+        compile_stage = translator.s2a_dsh_compile
+        p = ctypes.c_char_p
+        compile_stage.argtypes = [p, ctypes.c_int, p, ctypes.c_size_t, p, ctypes.c_size_t, p]
+        compile_stage.restype = ctypes.c_int
+        if compile_stage(key.encode(), 1, code, len(code), bytes(control), len(control), os.fsencode(root)):
+            raise RuntimeError("NVN2 fragment translation failed")
+        metadata = json.loads((root / f"{key}_b.json").read_bytes())
+        source = (root / f"{key}_b.metal").read_bytes()
+        proof = metadata.get("rb_uniform_v1", {})
+        if proof.get("source_sha256") != hashlib.sha256(source).hexdigest():
+            raise RuntimeError(f"source-bound reflection missing: slots={proof.get('slots')}")
+        ends = dict(proof["slots"])
+        if ends.get(1) != 256 or ends.get(3) != 4096:
+            raise RuntimeError(f"unexpected compiler bounds for two literal vec4.w loads: {ends}")
+        print("PASS NativeAOT Ampere fragment: constant 1 = 256, guest slot 3 = 4096, MSL digest matched")
+
+
+if __name__ == "__main__":
+    main()
