+// Reads the real output of the managed SPIR-V proof fixture in a fresh process.
+// Both stages alias one guest UBO at offset zero, but require different ranges.
+static int rb_uniform_pixels(NSString *dir) {
+    g_dev = MTLCreateSystemDefaultDevice();
+    id<MTLCommandQueue> queue = [g_dev newCommandQueue];
+    MTLRenderPipelineDescriptor *desc = [MTLRenderPipelineDescriptor new];
+    desc.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    NvShader *sh[2];
+    id<MTLBuffer> uniforms[2];
+    float guest[1024] = {0}; guest[3] = 1; guest[1020] = 1;
+    const size_t c1_lengths[2] = {4096,32};
+    const uint32_t c1_ends[2] = {256,516};
+    const uint32_t ub_ends[2] = {16,4096};
+    NSArray *keys = @[@"0000000000000011_b",@"0000000000000022_b"];
+    NSError *error = nil;
+    if (!queue) return 1;
+    for (int i = 0; i < 2; ++i) {
+        NSString *base = [dir stringByAppendingPathComponent:keys[i]];
+        NSData *bytes = [NSData dataWithContentsOfFile:[base stringByAppendingString:@".json"]];
+        if (!bytes) return 1;
+        NSDictionary *record = [NSJSONSerialization JSONObjectWithData:bytes options:0 error:&error];
+        NSString *source = [NSString stringWithContentsOfFile:[base stringByAppendingString:@".metal"]
+                                                    encoding:NSUTF8StringEncoding error:&error];
+        NvShader *s = [NvShader new]; sh[i] = s; s->stage = i;
+        strlcpy(s->key,[keys[i] UTF8String],sizeof s->key);
+        s->rf.nb = 2; s->rf.b = calloc(2,sizeof *s->rf.b);
+        s->rf.b[0].kind = NVN_RB_C1; s->rf.b[1].kind = NVN_RB_CBUF; s->rf.b[1].reg = 0;
+        s->rf.c1_len = c1_lengths[i]; s->rf.c1 = calloc(1,c1_lengths[i]); s->rf.has_c1 = 1;
+        if (!i) ((float *)s->rf.c1)[63] = 1;
+        rb_uniform_apply(s,record,source,"outdated-fingerprint");
+        rb_uniform_apply(s,record,[source stringByAppendingString:@" "],"uniform-fixture");
+        setenv("S2A_RB_UNIFORM_EXTENTS","0",1);
+        rb_uniform_apply(s,record,source,"uniform-fixture");
+        if (s->rb_c1_end || cb_len(s,0,sizeof guest) != sizeof guest) return 1;
+        setenv("S2A_RB_UNIFORM_EXTENTS","1",1);
+        rb_uniform_apply(s,record,source,"uniform-fixture");
+        if (s->rb_c1_end != c1_ends[i] || cb_len(s,0,sizeof guest) != ub_ends[i] ||
+            cb_len(s,1,sizeof guest) != sizeof guest || cb_len(s,0,8) != 8) return 1;
+        c1_store(s);
+        uniforms[i] = [g_dev newBufferWithBytes:guest length:cb_len(s,0,sizeof guest) options:MTLResourceStorageModeShared];
+        id<MTLLibrary> lib = [g_dev newLibraryWithSource:source options:nil error:&error];
+        if (!lib || !uniforms[i]) { fprintf(stderr,"uniform library: %s\n",error.localizedDescription.UTF8String); return 1; }
+        if (!i) desc.vertexFunction = [lib newFunctionWithName:@"v"];
+        else desc.fragmentFunction = [lib newFunctionWithName:@"f"];
+    }
+    if (sh[0]->c1buf != sh[1]->c1buf || sh[0]->c1off != 0 || sh[1]->c1off != 256 ||
+        g_c1_bank_off != 1024 || g_c1_data_bytes != 288 || g_c1_exclusive) return 1;
+    NvShader *unknown = [NvShader new]; unknown->rf.c1 = calloc(1,4); unknown->rf.c1_len = 4;
+    c1_store(unknown);
+    if (unknown->c1buf.length != C1_DECL_SIZE || g_c1_exclusive != 1) return 1;
+
+    id<MTLRenderPipelineState> pipeline = [g_dev newRenderPipelineStateWithDescriptor:desc error:&error];
+    if (!pipeline) { fprintf(stderr,"uniform pipeline: %s\n",error.localizedDescription.UTF8String); return 1; }
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+    td.usage = MTLTextureUsageRenderTarget; td.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> color = [g_dev newTextureWithDescriptor:td];
+    id<MTLBuffer> readback = [g_dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    if (!color || !readback) return 1;
+    id<MTLCommandBuffer> cb = [queue commandBuffer];
+    MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = color; pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:pass];
+    [enc setRenderPipelineState:pipeline];
+    [enc setVertexBuffer:sh[0]->c1buf offset:sh[0]->c1off atIndex:0]; [enc setVertexBuffer:uniforms[0] offset:0 atIndex:1];
+    [enc setFragmentBuffer:sh[1]->c1buf offset:sh[1]->c1off atIndex:0]; [enc setFragmentBuffer:uniforms[1] offset:0 atIndex:1];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [enc endEncoding];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    [blit copyFromTexture:color sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+       sourceSize:MTLSizeMake(1,1,1) toBuffer:readback destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:256];
+    [blit endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    const uint8_t expected[] = {255,255,255,255};
+    if (cb.status != MTLCommandBufferStatusCompleted || memcmp(readback.contents,expected,4)) return 1;
+    uint64_t stages, bindings, total;
+    rb_uniform_profile(&stages,&bindings,&total);
+    if (stages != 2 || bindings != 4 || total != 772) return 1;
+    rb_uniform_reset(); rb_uniform_profile(&stages,&bindings,&total);
+    if (stages || bindings || total) return 1;
+    puts("PASS GPU uniform bounds: shared guest input, vs=16 ps=4096; c1 ranges 256+516 in 1024 bank bytes, copied=288; opaque=65536; persisted SHA + ABI checked, pixel RGBA=ffffffff");
+    return 0;
+}
