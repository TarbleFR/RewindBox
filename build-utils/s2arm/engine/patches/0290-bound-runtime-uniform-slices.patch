diff --git a/graphics/nvn/gfx/nvn/rb_uniform_extents.inc b/graphics/nvn/gfx/nvn/rb_uniform_extents.inc
new file mode 100644
index 0000000..94cd70c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_uniform_extents.inc
@@ -0,0 +1,61 @@
+// The fallback stage JSON, shader key, translator fingerprint and original MSL
+// are loaded together. Never transfer bounds from one executable to another.
+static NSString *rb_uniform_source_sha(NSString *source) {
+    const char *bytes = source.UTF8String;
+    NSUInteger n = [source lengthOfBytesUsingEncoding:NSUTF8StringEncoding];
+    if (!bytes || !n || n > UINT32_MAX) return nil;
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(bytes,(CC_LONG)n,digest);
+    char hex[sizeof digest * 2 + 1];
+    static const char digits[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof digest; ++i) {
+        hex[2*i] = digits[digest[i] >> 4]; hex[2*i+1] = digits[digest[i] & 15];
+    }
+    hex[sizeof hex-1] = 0;
+    return @(hex);
+}
+
+static _Atomic uint64_t rb_uniform_stages, rb_uniform_bindings, rb_uniform_c1_bytes;
+static void rb_uniform_reset(void) {
+    atomic_store(&rb_uniform_stages,0); atomic_store(&rb_uniform_bindings,0); atomic_store(&rb_uniform_c1_bytes,0);
+}
+static void rb_uniform_profile(uint64_t *stages, uint64_t *bindings, uint64_t *c1_bytes) {
+    *stages = atomic_load(&rb_uniform_stages); *bindings = atomic_load(&rb_uniform_bindings);
+    *c1_bytes = atomic_load(&rb_uniform_c1_bytes);
+}
+
+static void rb_uniform_apply(NvShader *sh, NSDictionary *json, NSString *source, const char *xfp) {
+    NSDictionary *proof = json[@"rb_uniform_v1"];
+    if (![proof isKindOfClass:NSDictionary.class] || !rb_env_on("S2A_RB_UNIFORM_EXTENTS") ||
+        !xfp || ![json[@"xfp"] isEqual:@(xfp)] || ![json[@"chain"] isEqual:@DMSH_CHAIN] ||
+        ![json[@"key"] isEqual:@(sh->key)] || ![json[@"route"] isEqual:@"B"] ||
+        !source.length || ![proof[@"source_sha256"] isEqual:rb_uniform_source_sha(source)]) return;
+    static NSString *const stages[] = {@"vs", @"ps", nil, @"ts", @"ms", @"cs"};
+    if ((unsigned)sh->stage >= 6 || !stages[sh->stage] || ![json[@"stage"] isEqual:stages[sh->stage]] ||
+        sh->geo_vertices) return;
+    NSArray *rows = proof[@"slots"];
+    if (![rows isKindOfClass:NSArray.class] || rows.count > 15) return;
+    uint32_t ends[17] = {0};
+    for (id row in rows) {
+        if (![row isKindOfClass:NSArray.class] || [row count] != 2 ||
+            ![row[0] isKindOfClass:NSNumber.class] || ![row[1] isKindOfClass:NSNumber.class]) return;
+        double s = [row[0] doubleValue], e = [row[1] doubleValue];
+        if (!(s >= 1 && s <= 16 && s != 2 && e >= 4 && e <= C1_DECL_SIZE) ||
+            s != (int)s || e != (int)e || ((uint32_t)e & 3) || ends[(unsigned)s]) return;
+        ends[(unsigned)s] = (uint32_t)e;
+    }
+    unsigned count = 0;
+    for (int i = 0; i < sh->rf.nb; ++i) {
+        const nvn_rbind *b = &sh->rf.b[i];
+        if (b->kind == NVN_RB_C1 && ends[1]) { sh->rb_c1_end = ends[1]; ++count; }
+        if (b->kind == NVN_RB_CBUF && (unsigned)b->reg < 14 && ends[3+b->reg] && !sh->cb_ext[b->reg]) {
+            // Preserve a whole vec4 at the binding boundary even for a scalar lane.
+            sh->cb_ext[b->reg] = (ends[3+b->reg] + 15u) & ~15u;
+            ++count;
+        }
+    }
+    if (count) {
+        atomic_fetch_add(&rb_uniform_stages,1); atomic_fetch_add(&rb_uniform_bindings,count);
+        atomic_fetch_add(&rb_uniform_c1_bytes,sh->rb_c1_end);
+    }
+}
