+    int cap = rb_look_cap(), i = 0;   // RewindBox (patch 0081): RB_LOOK_AHEAD with the lanes, else PSO_AHEAD
+    for (; i < na && busy < cap; i++) { uint64_t k0 = g_pp_kicked; int past = busy >= PSO_AHEAD; pso_pend_kick(&qa[i].k, (__bridge NvShader *)qa[i].vs, (__bridge NvShader *)qa[i].fs, 0);   // RewindBox (patch 0069): 0, a guess: on the lanes
+        if (g_pp_kicked != k0) { busy++; if (past) rb_look_past_note(); } }   // RewindBox (patch 0081): past, handed where the former cap stopped
+    g_rb_look_left += (uint64_t)(na - i);   // RewindBox (patch 0081): found but left to their draw by the cap (unless queued already)
     memcpy(&S, &Ssave, sizeof S); R = Rsave; args_dirty_all(); g_pso_dirty = pso_dirty; g_dss_dirty = dss_dirty; prog_resolve();
     static uint64_t logged; if (g_pp_kicked > (uint64_t)kicked0 && (++logged <= 20 || !(logged & (logged - 1)))) {   // the first 20, then every power of two
