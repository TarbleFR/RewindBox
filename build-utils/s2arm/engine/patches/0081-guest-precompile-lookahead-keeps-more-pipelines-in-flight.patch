+             "before this one %llu lookaheads, %.1f ms on the submit thread, %llu tex_mtl calls; RewindBox: builds started at once for a draw %llu, by a lane %llu; "
+             "handed past the former cap of %d %llu, left to their draw by the cap %llu", (unsigned long long)logged,   // RewindBox (patch 0081): the last two counts
              draws, (int)g_pp_kicked - kicked0, (unsigned long long)g_pp_kicked, (unsigned long long)g_pp_taken, (unsigned long long)g_pp_dropped,
-             (unsigned long long)g_ppr_n, g_ppr_ns / 1e6, (unsigned long long)g_ppr_tex, (unsigned long long)qn, (unsigned long long)ql); }
+             (unsigned long long)g_ppr_n, g_ppr_ns / 1e6, (unsigned long long)g_ppr_tex, (unsigned long long)qn, (unsigned long long)ql,
+             PSO_AHEAD, (unsigned long long)g_rb_look_past, (unsigned long long)g_rb_look_left); }
