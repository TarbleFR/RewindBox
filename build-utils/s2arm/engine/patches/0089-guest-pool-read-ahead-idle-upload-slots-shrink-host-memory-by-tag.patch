+        uintptr_t s = MAX(c, lo), x = MIN(c + pm + 1, hi);
+        _Atomic uint32_t *slot = &g_pa_last[((c - (uintptr_t)wb) >> RB_PA_SHIFT) & (RB_PA_SLOTS - 1)];
+        uint32_t last = atomic_load_explicit(slot, memory_order_relaxed);
+        int ask = !last || fs - last >= (uint32_t)RB_PA_AGAIN;
