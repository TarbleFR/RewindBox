+        if (rhi > rlo) rb_pa_post(q, rlo, rhi, a, e);
+        rlo = rhi = 0;
+        if (ask < 0) { atomic_fetch_add_explicit(&g_pa_over, 1, memory_order_relaxed); return; }   // the frame's budget is spent: the rest is left to the uploads' own asks
+    }
+    if (rhi > rlo) rb_pa_post(q, rlo, rhi, a, e);
+}
