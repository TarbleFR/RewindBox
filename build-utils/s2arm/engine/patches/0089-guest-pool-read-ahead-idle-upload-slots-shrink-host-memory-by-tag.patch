+static _Atomic uint32_t g_pa_last[RB_PA_SLOTS];   // the frame + 1 (its low 32 bits) each piece of the window was last asked in; 0 = never
+static _Atomic uint64_t g_pa_budget, g_pa_runs, g_pa_bytes, g_pa_pages, g_pa_over, g_pa_unseen, g_pa_tex;   // g_pa_budget: the frame (its low 24 bits, << 40) | the bytes of pieces taken in it
