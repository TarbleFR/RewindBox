+    uintptr_t lo = a - plo > RB_PA_BEHIND ? a - RB_PA_BEHIND : plo, hi = phi - e > RB_PA_AHEAD ? e + RB_PA_AHEAD : phi, pm = ((uintptr_t)1 << RB_PA_SHIFT) - 1, rlo = 0, rhi = 0;
