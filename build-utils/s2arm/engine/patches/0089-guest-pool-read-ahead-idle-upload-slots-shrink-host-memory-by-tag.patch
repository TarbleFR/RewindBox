+// RewindBox (patch 0089): the host's own memory by VM tag: pages in memory, compressed and dirty, over the ranges s2a_low_tags walks (the low region from 4 GB up to the
+//   shared cache, and the window's tail); file-backed regions summed apart, whatever their tag. For the heartbeat's line (ios/app.m, every sixth heartbeat). IPA 779 (Mario
+//   Kart World, races): TASK_VM_INFO had 180-290 MB of anonymous memory in RAM and 900-1,160 MB compressed while the machine compressed 87,000-373,000 pages and decompressed
+//   about as many every 10 s, its CPU 29-64 % in the system; the .NET heap held 122-136 MB (patch 0076) and the renderer counts Metal's resident objects, but nothing said
+//   whose the rest was. Reads vm_region only, allocates nothing; the window itself (the guest's memory, TASK_VM_INFO external) is not walked
+void s2a_rb_mem_tags(char *out, size_t cap) {
+    enum { NTAG = 256 }; uint64_t res[NTAG] = {0}, cmp[NTAG] = {0}, drt[NTAG] = {0}, fres = 0, fcmp = 0, fdrt = 0, fvsz = 0; unsigned regions = 0;
+    uint64_t lo2 = g_ok ? g_base + g_size : 0, pg = (uint64_t)vm_page_size;
+    for (int seg = 0; seg < 2; seg++) {
+        vm_address_t a = seg ? lo2 : 0x100000000ull; uint64_t end = seg ? (lo2 ? 1ull << 39 : 0) : g_ok ? g_base : 1ull << 39;
+        while (a < end) {
+            vm_size_t sz = 0; natural_t depth = 0; vm_region_submap_info_data_64_t info; mach_msg_type_number_t cnt = VM_REGION_SUBMAP_INFO_COUNT_64;
+            if (vm_region_recurse_64(mach_task_self(), &a, &sz, &depth, (vm_region_recurse_info_t)&info, &cnt) != KERN_SUCCESS || a >= end || (!seg && info.user_tag == 32)) break;
+            regions++;
+            if (info.external_pager) { fres += info.pages_resident; fcmp += info.pages_swapped_out; fdrt += info.pages_dirtied; fvsz += sz; }
+            else { unsigned k = info.user_tag < NTAG ? info.user_tag : 0; res[k] += info.pages_resident; cmp[k] += info.pages_swapped_out; drt[k] += info.pages_dirtied; }
+            a += sz;
+        }
+    }
+    int o = snprintf(out, cap, "%u regions; file-backed: %llu MB in memory, %llu MB compressed, %llu MB dirty (%llu MB mapped)", regions, (unsigned long long)(fres * pg >> 20),
+                     (unsigned long long)(fcmp * pg >> 20), (unsigned long long)(fdrt * pg >> 20), (unsigned long long)(fvsz >> 20));
+    for (int r = 0; r < 8 && o > 0 && (size_t)o < cap; r++) {
+        int m = -1; for (int i = 0; i < NTAG; i++) if (res[i] + cmp[i] && (m < 0 || res[i] + cmp[i] > res[m] + cmp[m])) m = i;
+        if (m < 0) break;
+        o += snprintf(out + o, cap - (size_t)o, "; tag %d: %llu MB in memory, %llu MB compressed, %llu MB dirty", m, (unsigned long long)(res[m] * pg >> 20),
+                      (unsigned long long)(cmp[m] * pg >> 20), (unsigned long long)(drt[m] * pg >> 20));
+        res[m] = cmp[m] = 0;
+    }
+}
