diff --git a/graphics/nvn/host/rb_stage_input.h b/graphics/nvn/host/rb_stage_input.h
new file mode 100644
index 0000000..9728183
--- /dev/null
+++ b/graphics/nvn/host/rb_stage_input.h
@@ -0,0 +1,90 @@
+// RewindBox (patch 0123). Existing SIN1 files remain readable across app updates.
+#pragma once
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define DSH_IN_MAGIC 0x314e4953u
+
+static int rb_stage_read(int fd, void *data, size_t size) {
+    unsigned char *p = data;
+    while (size) {
+        ssize_t n = read(fd, p, size);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return 0;
+        p += n;
+        size -= (size_t)n;
+    }
+    return 1;
+}
+
+static int rb_stage_header(int fd, uint32_t h[4]) {
+    struct stat st;
+    return !fstat(fd, &st) && S_ISREG(st.st_mode) && rb_stage_read(fd, h, 16)
+        && h[0] == DSH_IN_MAGIC && h[1] <= 5 && h[2] >= 0x60 && h[2] <= (1u << 20)
+        && h[3] && h[3] < (1u << 24) && (uint64_t)st.st_size == 16ull + h[2] + h[3];
+}
+
+static int rb_stage_present(const char *path) {
+    uint32_t h[4];
+    int fd = open(path, O_RDONLY | O_NONBLOCK);
+    if (fd < 0) return 0;
+    int ok = rb_stage_header(fd, h);
+    close(fd);
+    return ok;
+}
+
+static int rb_stage_write(int fd, const void *data, size_t size) {
+    const unsigned char *p = data;
+    while (size) {
+        ssize_t n = write(fd, p, size);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return 0;
+        p += n;
+        size -= (size_t)n;
+    }
+    return 1;
+}
+
+static int rb_stage_publish(const char *path, int stage, const void *ctl, uint32_t nctl,
+                            const void *code, uint32_t ncode) {
+    char tmp[1232];
+    if (snprintf(tmp, sizeof tmp, "%s.tmp.XXXXXX", path) >= (int)sizeof tmp) return 0;
+    int fd = mkstemp(tmp);
+    if (fd < 0) return 0;
+    uint32_t h[4] = {DSH_IN_MAGIC, (uint32_t)stage, nctl, ncode};
+    int ok = rb_stage_write(fd, h, sizeof h) && rb_stage_write(fd, ctl, nctl)
+          && rb_stage_write(fd, code, ncode);
+    if (close(fd)) ok = 0;
+    if (ok && !rename(tmp, path)) return 1;
+    unlink(tmp);
+    return 0;
+}
+
+#include "../gfx/nvn/nvn2.h"
+
+static int rb_nvn2_input_stage(const uint8_t *control, uint32_t *ncode, uint32_t *nctl) {
+    static const int stages[8] = {0, 1, 3, -1, -1, 2, 4, 5};
+    uint32_t own;
+    memcpy(&own, control + 0x30, sizeof own);
+    *nctl = own >= 0xd8 && own <= NVN2_CTL_COPY ? own : 0xd8;
+    *ncode = nvn2_code_len(control);
+    unsigned type = control[0x56];
+    return type < 8 && *ncode && *ncode < (1u << 24) ? stages[type] : -1;
+}
+
+// The caller has read exactly h[2]+h[3] bytes. Check internal sizes before
+// nvn2_key uses the length contained inside the control block.
+static int rb_nvn2_input_matches(const char *key, const uint32_t h[4], const uint8_t *payload) {
+    uint32_t nc, nt;
+    if (h[2] < 0xd8 || h[2] > NVN2_CTL_COPY || !nvn2_ctl(payload)
+        || rb_nvn2_input_stage(payload, &nc, &nt) != (int)h[1] || nc != h[3] || nt != h[2]) return 0;
+    uint8_t md[8]; char actual[17];
+    nvn2_key(payload, payload + nt, md);
+    for (int i = 0; i < 8; ++i) snprintf(actual + 2 * i, 3, "%02x", md[i]);
+    return !strcmp(actual, key);
+}
