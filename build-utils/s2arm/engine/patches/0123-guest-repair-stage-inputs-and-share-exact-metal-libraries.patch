diff --git a/graphics/nvn/tests/t_rb_stage_input.c b/graphics/nvn/tests/t_rb_stage_input.c
new file mode 100644
index 0000000..c514c79
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_stage_input.c
@@ -0,0 +1,77 @@
+// RewindBox (patch 0123). POSIX file persistence and the production NVN2 key.
+// Linux: cc -std=c11 -D_POSIX_C_SOURCE=200809L -Wall -Wextra -pthread t_rb_stage_input.c -lcrypto -o t_stage
+#include <assert.h>
+#include <pthread.h>
+#include <signal.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include "../host/rb_stage_input.h"
+#ifdef __APPLE__
+#include <CommonCrypto/CommonDigest.h>
+#else
+#define OPENSSL_SUPPRESS_DEPRECATED
+#include <openssl/sha.h>
+#define CC_SHA256_DIGEST_LENGTH SHA256_DIGEST_LENGTH
+#define CC_SHA256_CTX SHA256_CTX
+#define CC_SHA256_Init SHA256_Init
+#define CC_SHA256_Update SHA256_Update
+#define CC_SHA256_Final SHA256_Final
+#endif
+#include "../gfx/nvn/nvn2_key.inc"
+
+enum { NT = 0xd8, NC = 512 };
+static char path[256], key[17];
+static uint8_t input[NT + NC];
+static void *publish(void *arg) {
+    (void)arg;
+    for (int i = 0; i < 16; i++)
+        assert(rb_stage_publish(path, 1, input, NT, input + NT, NC));
+    return NULL;
+}
+static void verify(void) {
+    uint32_t h[4]; uint8_t got[NT + NC];
+    int fd = open(path, O_RDONLY);
+    assert(fd >= 0 && rb_stage_header(fd, h) && h[2] == NT && h[3] == NC);
+    assert(rb_stage_read(fd, got, sizeof got) && !close(fd));
+    assert(!memcmp(got, input, sizeof got) && rb_nvn2_input_matches(key, h, got));
+    got[NT] ^= 1;
+    assert(!rb_nvn2_input_matches(key, h, got));
+    got[0x44] ^= 0x80;
+    assert(!rb_nvn2_input_matches(key, h, got));
+    got[0x44] ^= 0x80; got[NT] ^= 1;
+    h[1] = 0;
+    assert(!rb_nvn2_input_matches(key, h, got));
+}
+int main(void) {
+    char dir[] = "/tmp/rb_shader_input.XXXXXX";
+    assert(mkdtemp(dir));
+    uint32_t magic = NVN2_CTL_MAGIC, version = NVN2_CTL_VERSION, n = NC;
+    memcpy(input, &magic, 4); memcpy(input + 4, &version, 4); memcpy(input + 0x44, &n, 4);
+    input[0x56] = 1;
+    uint8_t md[8]; nvn2_key(input, input + NT, md);
+    for (int i = 0; i < 8; i++) snprintf(key + 2*i, 3, "%02x", md[i]);
+    snprintf(path, sizeof path, "%s/%s_b.in", dir, key);
+    assert(!rb_stage_present(path));
+    assert(rb_stage_publish(path, 1, input, NT, input + NT, NC));
+    pid_t child = fork(); assert(child >= 0);
+    if (!child) { verify(); _exit(0); }
+    int status; assert(waitpid(child, &status, 0) == child && WIFEXITED(status) && !WEXITSTATUS(status));
+    // An interrupted writer cannot truncate the committed file.
+    child = fork(); assert(child >= 0);
+    if (!child) {
+        struct rlimit lim = {32, 32};
+        assert(!setrlimit(RLIMIT_FSIZE, &lim)); signal(SIGXFSZ, SIG_IGN);
+        assert(!rb_stage_publish(path, 1, input, NT, input + NT, NC)); _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child && WIFEXITED(status) && !WEXITSTATUS(status));
+    verify();
+    assert(!truncate(path, 12) && !rb_stage_present(path));
+    assert(rb_stage_publish(path, 1, input, NT, input + NT, NC));
+    pthread_t workers[4];
+    for (int i = 0; i < 4; i++) assert(!pthread_create(&workers[i], NULL, publish, NULL));
+    for (int i = 0; i < 64; i++) verify();
+    for (int i = 0; i < 4; i++) assert(!pthread_join(workers[i], NULL));
+    verify(); assert(!unlink(path) && !rmdir(dir));
+    puts("PASS cold/warm SIN1, second process, interrupted write, corrupt key/length/stage, truncation repair, 64 concurrent publications");
+    return 0;
+}
