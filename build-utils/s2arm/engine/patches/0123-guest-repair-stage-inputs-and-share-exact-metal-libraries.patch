diff --git a/graphics/nvn/gfx/nvn/rb_stage_reflection.h b/graphics/nvn/gfx/nvn/rb_stage_reflection.h
new file mode 100644
index 0000000..b5f10e0
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_stage_reflection.h
@@ -0,0 +1,28 @@
+// RewindBox (patch 0123). Shared by the translator host and the Metal prewarm.
+// Parse the complete reflection: stage and translator fingerprint can follow a large
+// binding list. A truncated JSON prefix containing both fields is not usable.
+#pragma once
+#import <Foundation/Foundation.h>
+#include <sys/stat.h>
+
+static int rb_translation_available(const char *dir, NSString *name, const char *xfp,
+                                    int allow_binary, int *stage) {
+    if (!dir || !*dir || !xfp) return 0;
+    @autoreleasepool {
+        NSString *base = [@(dir) stringByAppendingPathComponent:name];
+        NSData *data = [NSData dataWithContentsOfFile:[base stringByAppendingPathExtension:@"json"]];
+        NSDictionary *j = data.length ? [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL] : nil;
+        if (![j isKindOfClass:NSDictionary.class] || ![j[@"chain"] isEqual:@DMSH_CHAIN] || ![j[@"xfp"] isEqual:@(xfp)]) return 0;
+        if (stage) {
+            static NSString *const stages[] = {@"vs", @"ps", @"cs", @"gs", @"ts", @"ms"};
+            *stage = -1;
+            for (int i = 0; i < 6; ++i) if ([stages[i] isEqual:j[@"stage"]]) { *stage = i; break; }
+        }
+        if ([j[@"stage"] isEqual:@"gs"] && [j[@"gs_slice"] isKindOfClass:NSDictionary.class]) return 1;
+        struct stat st;
+        if (!stat([base stringByAppendingPathExtension:@"metal"].fileSystemRepresentation, &st)
+            && S_ISREG(st.st_mode) && st.st_size > 0) return 1;
+        return allow_binary && !stat([base stringByAppendingPathExtension:@"metallib"].fileSystemRepresentation, &st)
+            && S_ISREG(st.st_mode) && st.st_size > 0;
+    }
+}
