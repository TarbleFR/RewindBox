+// RewindBox (patch 0123). Depth/layer select different functions in the same
+// library. Share only the exact post-rewrite MSL, with the same device and compile
+// options. Keep at most 16 recent libraries; the ordinary NvShader cache still owns
+// the distinct functions. The existing flight lock and priority donation protect
+// builds with overlapping requests. Failed Metal calls are never cached.
+enum { RB_RECENT_MSL = 16 };
+static NSString *g_rb_msl_keys[RB_RECENT_MSL];
+static id<MTLLibrary> g_rb_msl_libraries[RB_RECENT_MSL];
+
+static uint64_t flight_wait_locked(ShaderFlight *flight);
+
+static id<MTLLibrary> rb_compile_source(NSString *src, NSError **error) {
+    uint64_t start = bp_now();
+    id<MTLLibrary> lib = [g_dev newLibraryWithSource:src options:dm_msl_opts() error:error];
+    uint64_t elapsed = bp_now() - start;
+    atomic_fetch_add_explicit(&g_rb_msl_n, 1, memory_order_relaxed);
+    atomic_fetch_add_explicit(&g_rb_msl_ns, elapsed, memory_order_relaxed);
+    t_rb_msl_n++;
+    t_rb_msl_ns += elapsed;
+    return lib;
+}
+static id<MTLLibrary> rb_stage_library(NSString *src, int stage, NSError **error) {
+    t_lib_layer = [src containsString:@"render_target_array_index"];
+    if (!stage_depth_moded(stage)) return rb_compile_source(src, error);
+    const char *bytes = src.UTF8String;
+    if (!bytes) return rb_compile_source(src, error);
+    NSString *identity = [NSString stringWithFormat:@"lib/%p/%@", (__bridge void *)g_dev,
+                          par_hash(bytes, [src lengthOfBytesUsingEncoding:NSUTF8StringEncoding])];
+    unsigned slot = (unsigned)(identity.hash % RB_RECENT_MSL);
+    os_unfair_lock_lock(&g_shader_lock);
+    if ([g_rb_msl_keys[slot] isEqual:identity]) {
+        id<MTLLibrary> lib = g_rb_msl_libraries[slot];
+        os_unfair_lock_unlock(&g_shader_lock);
+        atomic_fetch_add(&g_rb_msl_shared, 1);
+        return lib;
+    }
+    ShaderFlight *flight = g_shader_flights[identity];
+    if (flight) {
+        flight_wait_locked(flight);
+        if (flight->library) atomic_fetch_add(&g_rb_msl_shared, 1);
+        return flight->library;
+    }
+    flight = [ShaderFlight new];
+    flight->builder = pthread_self();
+    flight->done = dispatch_group_create();
+    dispatch_group_enter(flight->done);
+    if (!g_shader_flights) g_shader_flights = [NSMutableDictionary dictionary];
+    g_shader_flights[identity] = flight;
+    os_unfair_lock_unlock(&g_shader_lock);
+
+    id<MTLLibrary> lib = rb_compile_source(src, error);
+    os_unfair_lock_lock(&g_shader_lock);
+    flight->library = lib;
+    if (lib) {
+        g_rb_msl_keys[slot] = identity;
+        g_rb_msl_libraries[slot] = lib;
+    }
+    [g_shader_flights removeObjectForKey:identity];
+    dispatch_group_leave(flight->done);
+    os_unfair_lock_unlock(&g_shader_lock);
+    return lib;
+}
