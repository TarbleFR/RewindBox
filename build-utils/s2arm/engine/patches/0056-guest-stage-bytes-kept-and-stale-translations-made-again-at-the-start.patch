+// RewindBox (patch 0056): translate a key again from the bytes kept beside its translation (the prewarm's workers, nvn_mtl.m warm_shader; never the submit thread). → 1 = its
+//   translation is this translator's now (made here, or by another thread meanwhile), 0 = no usable bytes or the translation failed (the key is then left to its first draw,
+//   which reports it). The file is checked against its own header before a byte reaches the translator
+int dm_shader_retranslate(const char *k16) {
+    const char *out = getenv("DM_MSL_FALLBACK"); char k[17], p[1200]; snprintf(k, sizeof k, "%.16s", k16);
+    if (!out || !*out || strlen(k) != 16) return 0;
+    if (dsh_have(out, k)) return 1;
+    dsh_comp_fn comp = dsh_comp(); if (!comp || !dsh_in_on()) return 0;
+    snprintf(p, sizeof p, "%s/%s_b.in", out, k);
+    int fd = open(p, O_RDONLY); if (fd < 0) return 0;
+    struct stat sb; uint32_t h[4] = {0}; uint8_t *b = NULL; size_t n = 0;
+    int ok = !fstat(fd, &sb) && read(fd, h, sizeof h) == (ssize_t)sizeof h && h[0] == DSH_IN_MAGIC && h[1] <= 5 && h[2] >= 0x60 && h[2] <= (1u << 20) && h[3] && h[3] < (1u << 24)
+             && (uint64_t)sb.st_size == sizeof h + (uint64_t)h[2] + h[3];
+    if (ok) { n = (size_t)h[2] + h[3]; b = malloc(n); ok = b && read(fd, b, n) == (ssize_t)n; }
+    close(fd);
+    if (!ok) { free(b); return 0; }
+    uint64_t t0 = now_ns();
+    int rc = dsh_comp_src_locked(comp, k, (int)h[1], b + h[2], h[3], b, h[2], out);
+    free(b);
+    atomic_fetch_add(&g_dsh_re_ns, now_ns() - t0);
+    if (rc) { uint64_t f = atomic_fetch_add(&g_dsh_re_fail, 1) + 1; if (f <= 4) LOG("RewindBox: a stale translation could not be made again at the start: %s (%s) rc=%d; left to its first draw", k, dsh_nm[h[1]], rc); return 0; }
+    uint64_t m = atomic_fetch_add(&g_dsh_re_n, 1) + 1;
+    if (m == 1 || !(m & (m - 1))) LOG("RewindBox: translations of an earlier translator made again at the start from their kept bytes: %llu so far (%.1f ms in all, %llu failed)",
+                                      (unsigned long long)m, atomic_load(&g_dsh_re_ns) / 1e6, (unsigned long long)atomic_load(&g_dsh_re_fail));
+    return 1;
+}
