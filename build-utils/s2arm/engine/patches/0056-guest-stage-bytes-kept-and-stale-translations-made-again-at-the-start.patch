+    char p[1200], tmp[1216]; snprintf(p, sizeof p, "%s/%s_b.in", out, k);
+    if (!access(p, F_OK)) return;
+    snprintf(tmp, sizeof tmp, "%s.tmp", p);
+    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644); if (fd < 0) return;
+    const uint32_t h[4] = {DSH_IN_MAGIC, (uint32_t)st, (uint32_t)nctl, (uint32_t)ncode};
+    int ok = write(fd, h, sizeof h) == (ssize_t)sizeof h && write(fd, ctl, nctl) == (ssize_t)nctl && write(fd, cd, ncode) == (ssize_t)ncode;
