+// RewindBox (patch 0056): a stage's own bytes are kept beside its translation (<key>_b.in: a 16-byte header, the control section, the code). A translation is current only
+//   for the translator that made it (dsh_have: the fingerprint xfp), and the bytes it was made from exist only while the game runs the program, so after an update whose
+//   translator changed nothing could be translated before its first draw: IPA 762 (patch 0051 changed one translator file), Mario Kart World on an iPhone17,2, 16 November:
+//   the prewarm built 0 shaders of the list's 2,668 keys (2,500 the session before), 992 stages were translated again while the game ran, one after the other (27.9 s in
+//   all, median 21 ms, the longest 625 ms), and the frames that took 500 ms and more had shader libraries built in them. With the bytes kept, the prewarm translates a stale
+//   key again before the game's first frame or beside it (dm_shader_retranslate, nvn_mtl.m warm_shader). Written once a key, after a translation that succeeded, under the
+//   translator's lock; a key translated before this patch gets its file the next time it is translated. S2A_RB_DSH_KEEP=0 turns the keeping off
+#define DSH_IN_MAGIC 0x314e4953u   // "SIN1"
+static int dsh_in_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("S2A_RB_DSH_KEEP"); v = !(e && !strcmp(e, "0")); } return v; }
+static void dsh_in_save(const char *out, const char *k, int st, const void *ctl, size_t nctl, const void *cd, size_t ncode) {
