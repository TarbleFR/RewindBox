+// RewindBox (patch 0056): whether a key's translation is this translator's already (1), or can be made again from the bytes kept beside it (2); 0 = neither. No file is read
+int dm_shader_kept(const char *k16) {
+    const char *out = getenv("DM_MSL_FALLBACK"); char k[17], p[1200]; snprintf(k, sizeof k, "%.16s", k16);
+    if (!out || !*out || strlen(k) != 16) return 0;
+    if (dsh_have(out, k)) return 1;
