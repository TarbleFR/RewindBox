+// A title-scoped run, in a fresh process. The packed D32 destination is never
+// attached. Read back the complete image so a clipped blit or a dropped write fails.
+static void direct_d32_copy(void) {
+    static uint8_t packed[1 << 20];
+    NVNtexture src, dst;
+    make_tex(&src, NVN_FORMAT_DEPTH32F, NVN_TEXTURE_FLAGS_COMPRESSIBLE);
+    texture_offset = (texture_offset + 65535) & ~(size_t)65535;
+    make_tex_pkg(&dst, NVN_FORMAT_DEPTH32F, 0, packed);
+    NVNcopyRegion full = {0, 0, 0, W, H, 1};
+    NVNcopyRegion sr = {4, 4, 0, 48, 32, 1};
+    NVNcopyRegion dr = {12, 8, 0, 36, 24, 1};
+    NVNbufferAddress address = API(nvnMemoryPoolGetBufferAddress)(&pool) + BUF_OFFSET;
+    begin();
+    API(nvnCommandBufferSetRenderTargets)(&commands, 0, NULL, NULL, &src, NULL);
+    API(nvnCommandBufferSetScissor)(&commands, 0, 0, W, H);
+    API(nvnCommandBufferClearDepthStencil)(&commands, 0.25f, 1, 0, 0);
+    API(nvnCommandBufferSetScissor)(&commands, 16, 8, 16, 16);
+    API(nvnCommandBufferClearDepthStencil)(&commands, 0.75f, 1, 0, 0);
+    API(nvnCommandBufferCopyTextureToTexture)(&commands, &src, NULL, &full, &dst, NULL, &full, 0);
+    API(nvnCommandBufferCopyTextureToBuffer)(&commands, &dst, NULL, &full, address, 0);
+    submit();
+    storage_is(&src, RS_BLACK, W, H);
+    const float *data = (float *)((uint8_t *)storage + BUF_OFFSET);
+    for (int y = 0; y < H; ++y) for (int x = 0; x < W; ++x)
+        REQUIRE(data[y * W + x] == ((x >= 16 && x < 32 && y >= 8 && y < 24) ? 0.75f : 0.25f));
+    begin();
+    API(nvnCommandBufferCopyTextureToTexture)(&commands, &src, NULL, &sr, &dst, NULL, &dr, 0);
+    API(nvnCommandBufferCopyTextureToBuffer)(&commands, &dst, NULL, &full, address, 0);
+    submit();
+    for (int y = 0; y < H; ++y) for (int x = 0; x < W; ++x) {
+        int sx = x, sy = y;
+        if (x >= dr.xoffset && x < dr.xoffset + dr.width && y >= dr.yoffset && y < dr.yoffset + dr.height) {
+            sx = sr.xoffset + (2 * (x - dr.xoffset) + 1) * sr.width / (2 * dr.width);
+            sy = sr.yoffset + (2 * (y - dr.yoffset) + 1) * sr.height / (2 * dr.height);
+        }
+        REQUIRE(data[y * W + x] == ((sx >= 16 && sx < 32 && sy >= 8 && sy < 24) ? 0.75f : 0.25f));
+    }
+    done();
+}
