     if (argc != 2 || (strcmp(argv[1], "scaled") && strcmp(argv[1], "off"))) { fprintf(stderr, "用法：t_nvn_rscale scaled | off\n"); return 2; }
     scaled = !strcmp(argv[1], "scaled");
     setenv("S2A_RES_SCALE", scaled ? "0.5" : "1", 1);
