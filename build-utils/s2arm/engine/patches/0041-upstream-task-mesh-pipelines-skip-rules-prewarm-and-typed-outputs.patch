+    "    for (uint n = lid; n < 3u; n += 1u)\n    {\n        dm_vertex_t v;\n        v.position = float4(float(n), 0.0, 0.5, 1.0);\n        v.a3 = float4(0.25);\n        dm_out.set_vertex(n, v);\n    }\n"
