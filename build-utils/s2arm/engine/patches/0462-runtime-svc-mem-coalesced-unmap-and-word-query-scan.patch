         // 八方2 要 62 GB 一段，只看到 ≤2 GB 的空闲段 → ResultOutOfVirtualAddressSpace 退出，10-20 M3 摸底）。整页（16 KB 一字节）相同就整页跳
+        const uint64_t aend = L.alias_base + L.alias_size;
         const uint8_t full = (uint8_t)((1u << (HPG >> 12)) - 1), want = on ? full : 0;
+        const uint64_t want64 = (uint64_t)want * 0x0101010101010101ull;
+        const uint64_t step8 = 8ull * HPG;
         while (lo > L.alias_base) {
-            if (!(lo & (HPG - 1)) && lo - HPG >= L.alias_base && *amask_at(lo - HPG) == want) { lo -= HPG; continue; }
+            if (!(lo & (HPG - 1))) {
+                while (lo - L.alias_base >= step8) {
+                    uint64_t w; memcpy(&w, amask_at(lo - step8), sizeof w);
+                    if (w != want64) break;
+                    lo -= step8;
+                }
+                if (lo - L.alias_base >= HPG && *amask_at(lo - HPG) == want) { lo -= HPG; continue; }
+                if (lo == L.alias_base) break;
+            }
             if ((*amask_at(lo - 0x1000) >> (((lo - 0x1000) & (HPG - 1)) >> 12) & 1) != on) break;
             lo -= 0x1000;
         }
-        while (hi < L.alias_base + L.alias_size) {
-            if (!(hi & (HPG - 1)) && hi + HPG <= L.alias_base + L.alias_size && *amask_at(hi) == want) { hi += HPG; continue; }
+        while (hi < aend) {
+            if (!(hi & (HPG - 1))) {
+                while (aend - hi >= step8) {
+                    uint64_t w; memcpy(&w, amask_at(hi), sizeof w);
+                    if (w != want64) break;
+                    hi += step8;
+                }
+                if (aend - hi >= HPG && *amask_at(hi) == want) { hi += HPG; continue; }
+                if (hi == aend) break;
+            }
             if ((*amask_at(hi) >> ((hi & (HPG - 1)) >> 12) & 1) != on) break;
             hi += 0x1000;
         }
@@ -1815,14 +1834,30 @@ static int svc_mem_impl(int num, uint64_t *regs, uint64_t orig) {
             if (run) perm_set(run, a + size, -1);
             if (a + size - L.alias_base > g_pk_alias_end) g_pk_alias_end = a + size - L.alias_base;
         } else {
+            // Coalesce contiguous freed HPG pages into batched pages_release / s2a_far_release runs (splits at file/anon boundary so punch_defer_locked never falls back).
+            uint64_t rlo = 0, rhi = 0, flo = 0, fhi = 0; int rfile = 0;
             for (uint64_t p = a; p < a + size; p += 0x1000) {
                 uint8_t *m = amask_at(p), bit = (uint8_t)(1u << ((p & (HPG - 1)) >> 12));
                 if (!(*m & bit)) continue;
                 *m &= (uint8_t)~bit; g_phys -= 0x1000;
