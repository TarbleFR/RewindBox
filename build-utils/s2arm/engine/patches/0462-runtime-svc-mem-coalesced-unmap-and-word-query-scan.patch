+                if (!*m) {
+                    uint64_t hp = p & ~(HPG - 1);
+                    if (hp >= we) {
+                        if (fhi == hp) fhi = hp + HPG;
+                        else { if (fhi > flo) s2a_far_release(flo, fhi - flo); flo = hp; fhi = hp + HPG; }
+                    } else {
+                        int inf = s2a_guest_in_file(hp, HPG);
+                        if (rhi == hp && rfile == inf) rhi = hp + HPG;
+                        else { if (rhi > rlo) pages_release(rlo, rhi - rlo); rlo = hp; rhi = hp + HPG; rfile = inf; }
+                        if (hp < rel_lo) rel_lo = hp;
+                        if (hp + HPG > rel_hi) rel_hi = hp + HPG;
+                    }
+                }
             }
+            if (fhi > flo) s2a_far_release(flo, fhi - flo);
+            if (rhi > rlo) pages_release(rlo, rhi - rlo);
             perm_set(a, a + size, -1);
         }
         if (wl > lo) backing_end_locked(lo, wl - lo, num == 0x2C, 1);
