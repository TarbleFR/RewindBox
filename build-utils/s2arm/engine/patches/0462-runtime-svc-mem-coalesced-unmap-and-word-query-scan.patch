 // 还页：影子页换成新的不可访问占位（物理页当场归还，再给出去是零页；同 svc_mem.c pages_release）
+// 按 CHUNK 内连续宿主影子地址合并还页，避免 16 Kio 逐页系统调用与 TLB 刷新。
 void s2a_far_release(uint64_t a, uint64_t n) {
-    for (uint64_t p = a; p < a + n; p += FPG) { uint8_t *h = g2h(p, NULL, NULL); if (h && !s2a_guest_zero((uint64_t)(uintptr_t)h, FPG) && mmap(h, FPG, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0) == MAP_FAILED) die("远端还页 errno=%d", errno); }
+    uint8_t *rlo = NULL; uint64_t rlen = 0, rchk = ~0ull;
+    for (uint64_t p = a; p < a + n; p += FPG) {
+        uint8_t *h = g2h(p, NULL, NULL);
+        uint64_t chk = (p >= g_lo) ? (p - g_lo) / CHUNK : ~0ull;
+        if (h && rlen && chk == rchk && rlo + rlen == h) { rlen += FPG; continue; }
+        if (rlen && !s2a_guest_zero((uint64_t)(uintptr_t)rlo, rlen) &&
+            mmap(rlo, rlen, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0) == MAP_FAILED)
+            die("远端还页 errno=%d", errno);
+        rlo = h; rlen = h ? FPG : 0; rchk = chk;
+    }
+    if (rlen && !s2a_guest_zero((uint64_t)(uintptr_t)rlo, rlen) &&
+        mmap(rlo, rlen, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0) == MAP_FAILED)
+        die("远端还页 errno=%d", errno);
 }
 
 // 点表：开放寻址（键 = pc，0 空），信号处理里只做原子操作
