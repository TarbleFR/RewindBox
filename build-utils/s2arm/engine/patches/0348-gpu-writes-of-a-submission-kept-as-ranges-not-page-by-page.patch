diff --git a/graphics/nvn/gfx/nvn/rb_gw_ranges.h b/graphics/nvn/gfx/nvn/rb_gw_ranges.h
new file mode 100644
index 0000000..dc949c5
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_gw_ranges.h
@@ -0,0 +1,107 @@
+// RewindBox (patch 0348): the GPU writes of a submission kept as byte ranges, not page by page. Pure C, no Metal: the submission's list, the live ranges and their
+//   overlap tests; nvn_mtl.m (sbw_note, sbw_hits, gw_commit, gw_check) uses them.
+//   sbw_note marked each 4 KB page that a submission's shaders, copies and reports may write in the page set g_sbwp, and gw_commit then stored those pages one by one, with the
+//   submission's fence, in the page table g_gw (65,536 slots of 24 bytes, scattered stores), where gw_check finds the pages that submissions still running write.
+//   Zelda TOTK (0400486024DEC000, three captures of its translation thread, 298 samples; docs/evidence/s2arm-power-wall.md, "Profil du fil de traduction de Zelda"): the end of
+//   a submission piece took 12 % of the thread, 9 % in the function itself, and 17 of its 27 samples fell on one address, which binary 830's disassembly places in gw_commit:
+//   the store of each page into g_gw. sbw_note took 4.7 %, about 14 % in all for this tracking. Its raw-memory shaders write many pages (their stores are noted as the whole
+//   pools learned, gml_take, at every draw that has them); Mario Kart World has no such shaders.
+//   A GPU write of RB_GWR_MIN_PAGES pages or more now stays one range: in the submission's list while the submission is encoded (sbw_note, sbw_hits), then among the live
+//   ranges with its submission's fence (gw_commit, gw_check): one entry, where it took one store a page. A range answers exactly as its pages answer in the page path, in both
+//   of gw_check's modes (rb_gwr_hit); a write the list or the live ranges have no room for goes page by page as before, never dropped. An answer can change only from
+//   "written" to "not written", and only where the page table said "written" for bytes that no noted write still running covers: two live pages met in one slot, the byte
+//   hull of two writes on one page, a page whose slot a later submission's write kept alive.
+#pragma once
+#include <stdint.h>
+
+enum {
+    RB_GWR_MIN_PAGES = 8,   // as PEND_SPAN, the span past which the index of queued writes already keeps a write whole, in a short list every lookup scans. A smaller write
+                            //   costs the page path at most 7 page-set entries and 7 table stores; a range costs every check one comparison while it lives, and a check walks up to
+                            //   16 pages of its own (UBP_MAX_BYTES)
+    RB_GWR_LIST = 64,       // = SBW_MEMO, the distinct writes sbw_note remembers in a submission: large writes kept whole per submission (a write that meets a kept one widens it,
+                            //   so the bindings of one pool take one entry); sbw_hits scans them
+    RB_GWR_LIVE = 128,      // committed ranges still running: two submissions of RB_GWR_LIST distinct ranges, as a range written again takes no entry of its own. gw_check scans
+                            //   the entries in use only: none for a game that writes no large range
+};
+
+typedef struct { uint64_t lo, last; } rb_gwr_span;   // bytes lo..last, last included (lo + n - 1: a write of n bytes that ends at the top of the address space has no end to store)
+
+static inline uint64_t rb_gwr_pages(uint64_t lo, uint64_t last) { return (last >> 12) - (lo >> 12) + 1; }
+// A write of n bytes at lo is kept whole: its size known (sbw_note takes size 0, not given, as a write anywhere before this), no wrap past the address space, RB_GWR_MIN_PAGES pages or more
+static inline int rb_gwr_large(uint64_t lo, uint64_t n) { return n && n <= UINT64_MAX - lo && rb_gwr_pages(lo, lo + n - 1) >= RB_GWR_MIN_PAGES; }
+
+// The page path's answer for one write of bytes lo..last to the query [qlo, qhi). The pages it looks at are qlo >> 12 to (qhi - 1) >> 12, as the loops of gw_check and sbw_hits
+//   walk them (none for an empty query on a page boundary; for qhi = 0, every page from qlo up). Page mode (exact 0: sbw_hits, gw_live): some page both span. Exact mode (gw_check
+//   with exact 1): on such a page, the write's bytes there, begin to end, against the query as gw_check tests them, which for a non-empty query is the overlap of the bytes.
+//   For a write the page path keeps by whole pages (rb_ub_ranges off), lo and last are its whole pages (rb_gwr_bounds) and both modes answer by page
+static inline int rb_gwr_hit(uint64_t lo, uint64_t last, uint64_t qlo, uint64_t qhi, int exact) {
+    if (exact && qlo < qhi) return qlo <= last && lo < qhi;
+    uint64_t a0 = qlo >> 12, a1 = (qhi - 1) >> 12, p0 = lo >> 12, p1 = last >> 12;
+    if (a0 > a1 || a1 < p0 || p1 < a0) return 0;
+    if (!exact) return 1;
+    // an empty or inverted query, which no exact caller makes: gw_check's test on each page both span, with the begin and end gw_put gives the write there
+    for (uint64_t pg = a0 > p0 ? a0 : p0, end = a1 < p1 ? a1 : p1;; pg++) {
+        uint64_t page = pg << 12, begin = lo > page ? lo - page : 0, stop = last - page < 4095 ? last - page + 1 : 4096;
+        if ((qlo <= page || qlo - page < stop) && qhi - page > begin) return 1;
+        if (pg == end) return 0;
+    }
+}
+
+// The submission's large GPU writes while it is encoded (nvn_mtl.m g_gwr_sub; pend_reset empties it with the page set)
+typedef struct { int n; rb_gwr_span r[RB_GWR_LIST]; } rb_gwr_list;
+static inline void rb_gwr_list_reset(rb_gwr_list *l) { l->n = 0; }
+// 1 = kept: a new range, or merged into a kept range it overlaps or touches (both are writes of this submission, so their union, one range, answers as both did);
+//   0 = no room: the caller notes it page by page
+static inline int rb_gwr_list_add(rb_gwr_list *l, uint64_t lo, uint64_t last) {
+    for (int i = 0; i < l->n; i++) {
+        rb_gwr_span *s = &l->r[i];
+        if ((lo <= s->last || lo - s->last == 1) && (s->lo <= last || s->lo - last == 1)) {
+            if (lo < s->lo) s->lo = lo;
+            if (last > s->last) s->last = last;
+            return 1;
+        }
+    }
+    if (l->n == RB_GWR_LIST) return 0;
+    l->r[l->n++] = (rb_gwr_span){lo, last};
+    return 1;
+}
+// sbw_hits: a page of [qlo, qhi) that a kept write touches, as the page set answers for the pages of the submission's GPU writes
+static inline int rb_gwr_list_hits(const rb_gwr_list *l, uint64_t qlo, uint64_t qhi) {
+    uint64_t a0 = qlo >> 12, a1 = (qhi - 1) >> 12;
+    if (a0 > a1) return 0;
+    for (int i = 0; i < l->n; i++) if (l->r[i].lo >> 12 <= a1 && a0 <= l->r[i].last >> 12) return 1;
+    return 0;
+}
+
+// Committed writes kept whole whose submission was not yet seen completed (nvn_mtl.m g_gwr_live): entries [0, n), each written until its fence completes
+typedef struct { uint64_t lo, last, fence; } rb_gwr_ent;
+typedef struct { int n; rb_gwr_ent e[RB_GWR_LIVE]; } rb_gwr_live;
+// The bytes the page path marks for a write: all of them with byte ranges in a page (rb_ub_ranges), its whole pages without
+static inline rb_gwr_span rb_gwr_bounds(rb_gwr_span s, int ranges) { return ranges ? s : (rb_gwr_span){s.lo & ~(uint64_t)4095, s.last | 4095}; }
+// Frees the entries whose submission has completed (fence <= done), before a commit adds its own
+static inline void rb_gwr_expire(rb_gwr_live *r, uint64_t done) {
+    for (int i = 0; i < r->n;) if (r->e[i].fence <= done) r->e[i] = r->e[--r->n]; else i++;
+}
+// A committed write of bytes b (rb_gwr_bounds), written until fence completes. 1 = kept: already held as long by an entry over the same bytes or more; or in an entry whose
+//   bytes all lie in b and whose fence is not later, which it takes over (b's write holds those bytes until fence too); or in a new entry. 0 = no room: the caller puts it page by page
+static inline int rb_gwr_put(rb_gwr_live *r, rb_gwr_span b, uint64_t fence) {
+    for (int i = 0; i < r->n; i++) {
+        rb_gwr_ent *e = &r->e[i];
+        if (e->lo <= b.lo && b.last <= e->last && e->fence >= fence) return 1;
+        if (b.lo <= e->lo && e->last <= b.last && e->fence <= fence) { *e = (rb_gwr_ent){b.lo, b.last, fence}; return 1; }
+    }
+    if (r->n == RB_GWR_LIVE) return 0;
+    r->e[r->n++] = (rb_gwr_ent){b.lo, b.last, fence};
+    return 1;
+}
+// gw_check: a range still written (fence > done) that the query meets, as the page path answers for its pages (rb_gwr_hit)
+static inline int rb_gwr_live_hits(const rb_gwr_live *r, uint64_t qlo, uint64_t qhi, int exact, uint64_t done) {
+    for (int i = 0; i < r->n; i++) { const rb_gwr_ent *e = &r->e[i]; if (e->fence > done && rb_gwr_hit(e->lo, e->last, qlo, qhi, exact)) return 1; }
+    return 0;
+}
+// Page by page when there is no room: the end of the piece of [lo, hi) that starts at lo and spans `most` pages at most, as gw_put keeps page by page only a range of
+//   GW_PAGES pages or fewer and takes a longer one as a write anywhere, which the pages of the page set never were. At the top of the address space, hi
+static inline uint64_t rb_gwr_piece_end(uint64_t lo, uint64_t hi, uint64_t most) {
+    uint64_t end = ((lo >> 12) + most) << 12;
+    return end <= lo || end > hi ? hi : end;
+}
