diff --git a/graphics/nvn/host/rb_priority_stage.inc b/graphics/nvn/host/rb_priority_stage.inc
new file mode 100644
index 0000000..82dc3f7
--- /dev/null
+++ b/graphics/nvn/host/rb_priority_stage.inc
@@ -0,0 +1,89 @@
+// Rebuild a witnessed stage once in its staging generation. DshCompiler removes
+// outputs before translating: never call it in a directory containing the user's
+// compatible files. A completed private product is also a restart checkpoint.
+static NSString *rb_stage_file_digest(NSString *path) {
+    int fd=open(path.fileSystemRepresentation,O_RDONLY|O_NONBLOCK|O_NOFOLLOW);
+    if (fd<0) return nil;
+    struct stat st;
+    if (fstat(fd,&st) || !S_ISREG(st.st_mode) || !st.st_size) { close(fd); return nil; }
+    CC_SHA256_CTX sha; CC_SHA256_Init(&sha);
+    uint8_t buf[32768]; ssize_t n;
+    while ((n=read(fd,buf,sizeof buf))!=0) {
+        if (n<0) { if (errno==EINTR) continue; close(fd); return nil; }
+        CC_SHA256_Update(&sha,buf,(CC_LONG)n);
+    }
+    close(fd);
+    uint8_t sum[32]; char hex[65]; CC_SHA256_Final(sum,&sha);
+    for (unsigned i=0;i<sizeof sum;i++) snprintf(hex+2*i,3,"%02x",sum[i]);
+    return @(hex);
+}
+
+static int rb_stage_product_name(NSString *name,NSString *key) {
+    if (![name.lastPathComponent isEqual:name] || ![name hasPrefix:[key stringByAppendingString:@"_"]]) return 0;
+    return [name.pathExtension isEqual:@"metal"] || [name.pathExtension isEqual:@"json"];
+}
+
+static NSDictionary *rb_stage_product_files(NSString *dir,NSString *key) {
+    NSArray *entries=[NSFileManager.defaultManager contentsOfDirectoryAtPath:dir error:NULL];
+    if (!entries || entries.count>128) return nil;
+    NSMutableDictionary *files=[NSMutableDictionary dictionary];
+    for (NSString *name in entries) {
+        if ([name isEqual:@"receipt.plist"]) continue;
+        if (!rb_stage_product_name(name,key)) return nil;
+        NSString *digest=rb_stage_file_digest([dir stringByAppendingPathComponent:name]);
+        if (!digest) return nil;
+        files[name]=digest;
+    }
+    return files.count ? files : nil;
+}
+
+// Missing outputs are atomically restored from the durable product. A process
+// interrupted between two renames resumes here before any guest can use the work.
+static int rb_stage_publish_products(NSDictionary *files,NSString *dir,NSString *out) {
+    for (NSString *name in files) {
+        NSString *src=[dir stringByAppendingPathComponent:name], *dst=[out stringByAppendingPathComponent:name];
+        if ([files[name] isEqual:rb_stage_file_digest(dst)]) continue;
+        NSString *tmp=[dst stringByAppendingString:@".rb-priority.tmp"];
+        unlink(tmp.fileSystemRepresentation);
+        if (link(src.fileSystemRepresentation,tmp.fileSystemRepresentation) ||
+            rename(tmp.fileSystemRepresentation,dst.fileSystemRepresentation)) { unlink(tmp.fileSystemRepresentation); return 0; }
+    }
+    return 1;
+}
+
+// 1 = ready (new or previously committed), 0 = translation/IO error,
+// -1 = cancellation. made counts an actual successful invocation in this call.
+static int rb_priority_stage(NSString *key,NSString *wire,NSString *out,rb_stage_batch *batch,
+                             uint32_t h[4],const uint8_t *input,int *made) {
+    *made=0;
+    const char *xfp=dsh_xfp();
+    if (!xfp || !*xfp) return 0;
+    char hex[65]; rb_row_digest((const char *)input,(size_t)h[2]+h[3],hex);
+    NSDictionary *identity=@{@"input":@(hex),@"xfp":@(xfp),@"chain":@DMSH_CHAIN,@"stage":@(h[1]),
+                             @"generation":wire.lastPathComponent};
+    NSFileManager *fm=NSFileManager.defaultManager;
+    NSString *root=[wire stringByAppendingPathComponent:@"priority-stages-v1"];
+    NSString *dir=[root stringByAppendingPathComponent:key], *receipt=[dir stringByAppendingPathComponent:@"receipt.plist"];
+    NSDictionary *meta=[NSDictionary dictionaryWithContentsOfFile:receipt];
+    NSDictionary *files=nil;
+    if ([meta[@"identity"] isEqual:identity]) {
+        files=rb_stage_product_files(dir,key);
+        if (![meta[@"files"] isEqual:files]) files=nil;
+    }
+    if (!files) {
+        NSString *tmp=[root stringByAppendingPathComponent:[key stringByAppendingString:@".work"]];
+        if ([fm fileExistsAtPath:tmp] && ![fm removeItemAtPath:tmp error:NULL]) return 0;
+        if (![fm createDirectoryAtPath:tmp withIntermediateDirectories:YES attributes:nil error:NULL]) return 0;
+        dsh_comp_fn compile=dsh_comp();
+        int stage=-1;
+        if (!compile || dsh_translate_locked(compile,key.UTF8String,h[1],input+h[2],h[3],input,h[2],tmp.fileSystemRepresentation,1) ||
+            !t_dsh_src_made || !dsh_current_stage(tmp.fileSystemRepresentation,key.UTF8String,&stage) || stage!=(int)h[1]) return 0;
+        files=rb_stage_product_files(tmp,key);
+        if (!files || ![@{@"identity":identity,@"files":files} writeToFile:[tmp stringByAppendingPathComponent:@"receipt.plist"] atomically:YES]) return 0;
+        if ([fm fileExistsAtPath:dir] && ![fm removeItemAtPath:dir error:NULL]) return 0;
+        if (rename(tmp.fileSystemRepresentation,dir.fileSystemRepresentation)) return 0;
+        *made=1;
+    }
+    if (rb_batch_cancel(batch)) return -1;
+    return rb_stage_publish_products(files,dir,out);
+}
