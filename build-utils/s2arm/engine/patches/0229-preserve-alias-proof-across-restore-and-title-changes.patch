+// Exercise the production public clear handlers, descriptor exposure and physical
+// sibling load counter. The explicit oracle reads both native planes after each CB.
+static int check_attachment_liveness(void) {
+    phase = "attachment-liveness";
+    setup();
+    image ds, color;
+    make_image_shape(&ds,NVN_FORMAT_DEPTH32F_STENCIL8,8,1,1);
+    make_image_shape(&color,NVN_FORMAT_RGBA8,4,0,1);
+    const int enabled = rb_live_on();
+    const tex_t *tex = (const tex_t *)&ds.object;
+    const struct { float d, expected_d; int dm, sm; uint8_t st, expected_s; unsigned bytes; } seq[] = {
+        {0.25f,0.25f,1,0xff,0x35,0x35,0},
+        {0.75f,0.75f,1,0,0,0x35,SIZE*SIZE},
+        {0,0.75f,0,0xff,0xa7,0xa7,4*SIZE*SIZE},
+        {0.5f,0.5f,1,0,0,0xa7,0},
+        {0,0.5f,0,0xff,0x2d,0x2d,0},
+    };
+    for (unsigned i=0; i<sizeof seq/sizeof seq[0]; i++) {
+        if (i==3) nvn_be_reg_tex(41,tex,NULL);
+        if (i==4) nvn_be_reg_tex(41,NULL,NULL); // its old bytes remain exposed
+        uint64_t before=atomic_load(&g_rb_plane_load_bytes);
+        begin();
+        API(nvnCommandBufferSetRenderTargets)(&commands,0,NULL,NULL,&ds.object,NULL);
+        API(nvnCommandBufferSetScissor)(&commands,0,0,SIZE,SIZE);
+        API(nvnCommandBufferClearDepthStencil)(&commands,seq[i].d,seq[i].dm,seq[i].st,seq[i].sm);
+        submit();
+        float depth[SIZE*SIZE]; uint8_t stencil[SIZE*SIZE];
+        read_planes_shape(&ds,0,0,depth,stencil,1);
+        for (unsigned x=0; x<SIZE*SIZE; x++) {
+            REQUIRE(depth[x]==seq[i].expected_d); REQUIRE(stencil[x]==seq[i].expected_s);
+        }
+        REQUIRE(atomic_load(&g_rb_plane_load_bytes)-before==(enabled ? seq[i].bytes : 0));
+    }
+    // The guest can read a private never-registered color on its own thread.
+    // Run after finish so that the expected bytes are ordered and deterministic.
+    begin();
+    const NVNtexture *colors[] = {&color.object};
+    const float rgba[] = {1,0,1,1};
+    API(nvnCommandBufferSetRenderTargets)(&commands,1,colors,NULL,NULL,NULL);
+    API(nvnCommandBufferClearColor)(&commands,0,rgba,15); submit();
+    const NVNtexture *read_target=&color.object;
+    dispatch_group_t done=dispatch_group_create();
+    dispatch_group_async(done,dispatch_get_global_queue(QOS_CLASS_DEFAULT,0),^{
+        NVNcopyRegion r={0,0,0,SIZE,SIZE,1};
+        uint8_t raw[SIZE*SIZE*4]; memset(raw,0xcd,sizeof raw);
+        API(nvnTextureReadTexels)(read_target,NULL,&r,raw);
+        for (unsigned i=0; i<SIZE*SIZE; i++)
+            REQUIRE(raw[4*i]==255 && raw[4*i+1]==0 && raw[4*i+2]==255 && raw[4*i+3]==255);
+    });
+    dispatch_group_wait(done,DISPATCH_TIME_FOREVER);
+    API(nvnTextureFinalize)(&ds.object); API(nvnTextureFinalize)(&color.object);
+    printf("PASS public NVN DS and off-submit ReadTexels checks=%u feature=%s\n",checks,
+           enabled ? "active" : "disabled (baseline only)");
+    return 0;
+}
