diff --git a/graphics/nvn/gfx/nvn/rb_present_hold.h b/graphics/nvn/gfx/nvn/rb_present_hold.h
new file mode 100644
index 0000000..09b4be2
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_present_hold.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+
+// A window starting at 30 Hz is native 30 until it requests a genuine 60 Hz
+// present. Keep the guest clock and acquire deadlines independent of this hold.
+enum { RB_PRESENT_HOLD_CONFIRM = 8 };
+typedef struct {
+    uint64_t ordinal, filtered_frames, sustained_runs;
+    unsigned armed, slow_run;
+} rb_present_hold;
+
+static inline uint64_t rb_window_hold_ns(rb_present_hold *s, uint64_t ordinal, int raw,
+                                         uint64_t period, int eligible) {
+    if (!eligible || ordinal != s->ordinal + 1) {
+        s->armed = 0;
+        s->slow_run = 0;
+    }
+    s->ordinal = ordinal;
+    if (eligible && raw == 1 && period >= 16666665 && period <= 16666668) {
+        s->armed = 1;
+        s->slow_run = 0;
+    } else if (eligible && s->armed && raw == 2 && period >= 33333331 && period <= 33333335) {
+        if (s->slow_run < RB_PRESENT_HOLD_CONFIRM) {
+            if (++s->slow_run == RB_PRESENT_HOLD_CONFIRM) ++s->sustained_runs;
+            else {
+                ++s->filtered_frames;
+                return 16666667;
+            }
+        }
+    } else {
+        s->armed = 0;
+        s->slow_run = 0;
+    }
+    return period;
+}
+
+static inline double rb_link_hold_deadline(int submitted, double target, double hold) {
+    return submitted && hold > 0.025 ? target + hold : 0.;
+}
diff --git a/graphics/nvn/tests/t_rb_display_hold.c b/graphics/nvn/tests/t_rb_display_hold.c
new file mode 100644
index 0000000..1a2a81b
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_display_hold.c
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_present_hold.h"
+#include <assert.h>
+#include <stdio.h>
+
+enum { FAST = 16666667, SLOW = 33333333 };
+static int held_on_next_tick(uint64_t hold) {
+    return 1.0 + FAST / 1e9 < rb_link_hold_deadline(1, 1.0, hold / 1e9) - .002;
+}
+int main(void) {
+    for (int enabled = 0; enabled <= 1; ++enabled) {
+        rb_present_hold s = {0};
+        uint64_t n = 0;
+        assert(held_on_next_tick(rb_window_hold_ns(&s, ++n, 2, SLOW, enabled)));
+        for (int burst = 1; burst <= 3; ++burst) {
+            assert(!held_on_next_tick(rb_window_hold_ns(&s, ++n, 1, FAST, enabled)));
+            for (int j = 0; j < burst; ++j)
+                assert(held_on_next_tick(rb_window_hold_ns(&s, ++n, 2, SLOW, enabled)) == !enabled);
+        }
+        rb_window_hold_ns(&s, ++n, 1, FAST, enabled);
+        for (int j = 1; j <= 12; ++j)
+            assert(held_on_next_tick(rb_window_hold_ns(&s, ++n, 2, SLOW, enabled)) ==
+                   (!enabled || j >= RB_PRESENT_HOLD_CONFIRM));
+        assert(s.sustained_runs == (unsigned)enabled);
+        assert(s.filtered_frames == (enabled ? 13u : 0u));
+        rb_window_hold_ns(&s, ++n, 1, FAST, enabled);
+        assert(rb_window_hold_ns(&s, ++n, 2, SLOW, 0) == SLOW); // video or user cap
+        assert(rb_window_hold_ns(&s, ++n, 2, SLOW, enabled) == SLOW);
+        rb_window_hold_ns(&s, ++n, 1, FAST, enabled);
+        n += 2;
+        assert(rb_window_hold_ns(&s, n, 2, SLOW, enabled) == SLOW);
+        assert(rb_window_hold_ns(&s, ++n, 3, 50000000, enabled) == 50000000);
+        assert(!rb_link_hold_deadline(0, 1., SLOW / 1e9));
+    }
+    puts("PASS display hold: A/B 1-3 frame bursts, sustained and native 30 Hz, caps, gaps and failed present");
+}
