+
+// RewindBox (patch 0436): 2-slot LRU depth snapshot metadata cache.
+// Keeps up to 2 unchanged depth attachments' snapshots valid across color-only passes and
+// alternating depth attachments (e.g. main 1280x720 depth + half-res/shadow depth in Zelda/MKW),
+// invalidating only the slot whose serial/memory range is written, cleared, copied, or whose
+// backing texture storage mutated (ser_mut), and invalidating any peer slot aliasing the same
+// backing Metal snapshot texture from dsnap_storage().
+enum { RB_DSNAP_SLOTS = 2 };
+
+typedef struct {
+    uint64_t ser, lo, hi, ser_mut, tick;
+    uintptr_t base, snap;
+    uint32_t tl, ts, nl;
+    uint8_t depth_valid, stencil_valid;
+} rb_dsnap_slot;
+
+static inline int rb_dsnap_cache_find(rb_dsnap_slot slots[RB_DSNAP_SLOTS],
+                                      uint64_t ser, uintptr_t base, uint32_t tl, uint32_t ts, uint32_t nl,
+                                      int want_st, uint64_t cur_ser_mut, uint64_t tick) {
+    for (int i = 0; i < RB_DSNAP_SLOTS; i++) {
+        rb_dsnap_slot *s = &slots[i];
+        const int valid = want_st ? s->stencil_valid : s->depth_valid;
+        if (valid && s->ser == ser && s->base == base && s->snap != 0 &&
+            s->tl == tl && s->ts == ts && s->nl == nl && s->ser_mut == cur_ser_mut) {
+            s->tick = tick;
+            return i;
+        }
+    }
+    return -1;
+}
+
+static inline int rb_dsnap_cache_pick(const rb_dsnap_slot slots[RB_DSNAP_SLOTS],
+                                      uint64_t ser, uintptr_t base, uint32_t tl, uint32_t ts, uint32_t nl) {
+    for (int i = 0; i < RB_DSNAP_SLOTS; i++) {
+        if (slots[i].ser == ser && slots[i].base == base &&
+            slots[i].tl == tl && slots[i].ts == ts && slots[i].nl == nl)
+            return i;
+    }
+    for (int i = 0; i < RB_DSNAP_SLOTS; i++) {
+        if (!slots[i].depth_valid && !slots[i].stencil_valid) return i;
+    }
+    return slots[0].tick <= slots[1].tick ? 0 : 1;
+}
+
+static inline void rb_dsnap_cache_publish(rb_dsnap_slot slots[RB_DSNAP_SLOTS], int idx,
+                                          uint64_t ser, uint64_t lo, uint64_t hi,
+                                          uintptr_t base, uintptr_t snap,
+                                          uint32_t tl, uint32_t ts, uint32_t nl,
+                                          uint64_t cur_ser_mut, uint64_t tick) {
+    // If dsnap_storage() handed out the same backing MTLTexture as another live slot
+    // (two depth buffers of identical shape), invalidate that peer slot before overwriting snap.
+    for (int j = 0; j < RB_DSNAP_SLOTS; j++) {
+        if (j != idx && slots[j].snap == snap) {
+            slots[j].depth_valid = 0;
+            slots[j].stencil_valid = 0;
+        }
+    }
+    rb_dsnap_slot *s = &slots[idx];
+    s->ser = ser; s->lo = lo; s->hi = hi; s->ser_mut = cur_ser_mut; s->tick = tick;
+    s->base = base; s->snap = snap; s->tl = tl; s->ts = ts; s->nl = nl;
+    s->depth_valid = 1; s->stencil_valid = 1;
+}
+
+static inline void rb_dsnap_cache_stale_all(rb_dsnap_slot slots[RB_DSNAP_SLOTS]) {
+    for (int i = 0; i < RB_DSNAP_SLOTS; i++) {
+        slots[i].depth_valid = 0;
+        slots[i].stencil_valid = 0;
+    }
+}
+
+static inline void rb_dsnap_cache_stale_range(rb_dsnap_slot slots[RB_DSNAP_SLOTS],
+                                              uint64_t dst, uint64_t size) {
+    for (int i = 0; i < RB_DSNAP_SLOTS; i++) {
+        if ((slots[i].depth_valid || slots[i].stencil_valid) &&
+            rb_dsnap_range_overlaps(slots[i].lo, slots[i].hi, dst, size)) {
+            slots[i].depth_valid = 0;
+            slots[i].stencil_valid = 0;
+        }
+    }
+}
+
+static inline void rb_dsnap_cache_stale_tex(rb_dsnap_slot slots[RB_DSNAP_SLOTS],
+                                            uint64_t t_ser, uint64_t t_lo, uint64_t t_size,
+                                            int depth_wrote, int stencil_wrote) {
+    if (!depth_wrote && !stencil_wrote) return;
+    for (int i = 0; i < RB_DSNAP_SLOTS; i++) {
+        if (!(slots[i].depth_valid || slots[i].stencil_valid)) continue;
+        if (rb_dsnap_tex_stales(slots[i].ser, slots[i].lo, slots[i].hi, t_ser, t_lo, t_size)) {
+            if (depth_wrote) {
+                slots[i].depth_valid = 0;
+                slots[i].stencil_valid = 0;
+            } else if (stencil_wrote) {
+                slots[i].stencil_valid = 0;
+            }
+        }
+    }
+}
