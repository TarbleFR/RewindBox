+++ b/graphics/nvn/gfx/nvn/rb_dsnap_rule.h
@@ -38,3 +38,100 @@ static inline int rb_dsnap_set_rt_stales(uint64_t d_ser, uint64_t cur_ser, uint6
     if (!d_ser || cur_ser != d_ser || new_ser != d_ser || !same_dview) return 1;
