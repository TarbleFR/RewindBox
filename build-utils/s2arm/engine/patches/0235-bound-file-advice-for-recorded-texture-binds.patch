+static uint64_t chunk;
+int s2a_guest_in_file(uint64_t a, uint64_t n) {
+    return a >= chunk && a < 3*chunk && n <= 3*chunk-a;
+}
+int s2a_guest_file_at(uint64_t a, uint64_t *off, uint64_t *remaining) {
+    assert(a >= chunk && a < 3*chunk);
+    ++resolutions;
+    *off = (a-chunk)%chunk;
+    *remaining = chunk-*off;
+    return fds[(a-chunk)/chunk];
+}
+static void darwin_file_test(void) {
+    chunk = getpagesize();
+    for (int i=0; i<2; ++i) {
+        char path[]="/tmp/rewrite-pager.XXXXXX";
+        fds[i]=mkstemp(path);
+        assert(fds[i] >= 0 && unlink(path) == 0 && ftruncate(fds[i], chunk) == 0);
+        assert(pwrite(fds[i], i ? "B" : "A", 1, 0) == 1);
+    }
+    assert(rb_guest_file_advise(0,chunk) == 0 && !resolutions);
+    assert(rb_guest_file_advise(UINTPTR_MAX-8,chunk) == 0 && !resolutions);
+    // Synthetic addresses are never dereferenced. Both files receive their own offset.
+    assert(rb_guest_file_advise(chunk,2*chunk) == 2*chunk && resolutions == 2);
+    for (int i=0; i<2; ++i) {
+        char value=0;
+        assert(pread(fds[i],&value,1,0) == 1 && value == (i ? 'B' : 'A'));
+        close(fds[i]);
+    }
+    puts("PASS Darwin F_RDADVISE across unlinked chunks with original bytes intact");
+}
+#endif
+int main(void) {
+#ifdef __APPLE__
+    darwin_file_test();
+#endif
+    const uint64_t page = 16384, item = RB_HINT_MAX_ITEM, room = RB_HINT_RESERVE + item;
+    rb_file_budget b = {0};
+    assert(!rb_file_hint_admit(&b,100,UINT64_MAX,page,item,page,0));
+    assert(!rb_file_hint_admit(&b,100,room-1,page,item,page,0));
+    assert(!rb_file_hint_admit(&b,100,room,page,item,page,1));
+    assert(!rb_file_hint_admit(&b,100,room,UINT64_MAX-page,2*page,page,0));
+    assert(!rb_file_hint_admit(&b,100,room,page,item+1,page,0));
+    assert(!b.started);
+    assert(rb_file_hint_admit(&b,100,room,page,item,page,0));
+    assert(rb_file_hint_admit(&b,100,room,page,item,page,0));
+    assert(!rb_file_hint_admit(&b,100,room,page,1,page,0));
+    assert(!rb_file_hint_admit(&b,99,room,page,1,page,0));
+    assert(!rb_file_hint_admit(&b,349,room,page,item,page,0));
+    assert(rb_file_hint_admit(&b,351,room,page,item,page,0));
+    assert(rb_file_hint_admit(&b,UINT64_MAX-1,room,page+1,page,page,0));
+    assert(b.credit == RB_HINT_BURST - 2*page);
+    assert(!rb_file_hint_admit(&b,UINT64_MAX-1,RB_HINT_RESERVE+page,page+1,page,page,0));
+    puts("PASS file-backed bind hints: headroom, pressure, byte and time limits, page rounding");
+}
