diff --git a/graphics/nvn/gfx/nvn/rb_file_hint.h b/graphics/nvn/gfx/nvn/rb_file_hint.h
new file mode 100644
index 0000000..400a57a
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_file_hint.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+
+enum {
+    RB_HINT_MAX_ITEM = 2 * 1024 * 1024,
+    RB_HINT_BURST = 4 * 1024 * 1024,
+    RB_HINT_RATE = 8 * 1024 * 1024
+};
+#define RB_HINT_RESERVE (UINT64_C(2) << 30)
+typedef struct { uint64_t tick_ms, credit; int started; } rb_file_budget;
+
+// Only the serial bind-hint worker owns this bucket. Charge all host pages
+// spanned (even if already resident), so unaligned tiny textures cannot bypass it.
+static inline int rb_file_hint_admit(rb_file_budget *b, uint64_t now_ms,
+                                     uint64_t room, uint64_t address, uint64_t size,
+                                     uint64_t page, int pressure) {
+    if (!size || size > RB_HINT_MAX_ITEM || !page || (page & (page - 1)) ||
+        !address || address > UINT64_MAX - size || room == UINT64_MAX || pressure)
+        return 0;
+    uint64_t prefix = address & (page - 1);
+    if (page > RB_HINT_BURST || size + prefix > UINT64_MAX - (page - 1)) return 0;
+    uint64_t cost = (size + prefix + page - 1) & ~(page - 1);
+    if (room < RB_HINT_RESERVE + cost) return 0;
+    if (!b->started) {
+        b->credit = RB_HINT_BURST;
+        b->tick_ms = now_ms;
+        b->started = 1;
+    } else if (now_ms > b->tick_ms) {
+        uint64_t dt = now_ms - b->tick_ms;
+        b->credit += dt >= 500 ? RB_HINT_BURST : dt * RB_HINT_RATE / 1000;
+        if (b->credit > RB_HINT_BURST) b->credit = RB_HINT_BURST;
+        b->tick_ms = now_ms;
+    }
+    if (cost > b->credit) return 0;
+    b->credit -= cost;
+    return 1;
+}
diff --git a/graphics/nvn/gfx/nvn/rb_file_hint_darwin.h b/graphics/nvn/gfx/nvn/rb_file_hint_darwin.h
new file mode 100644
index 0000000..29b17cf
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_file_hint_darwin.h
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+
+int s2a_guest_file_at(uint64_t address, uint64_t *offset, uint64_t *remaining);
+int s2a_guest_in_file(uint64_t address, uint64_t bytes);
+
+// The consumer owns the window lifetime. Work on file descriptors even if the
+// guest recycles a virtual address. File offsets restart at each chunk boundary.
+static inline size_t rb_guest_file_advise(uintptr_t address, size_t bytes) {
+    if (!bytes || address > UINTPTR_MAX - bytes || !s2a_guest_in_file(address, bytes)) return 0;
+    size_t done = 0;
+    while (done < bytes) {
+        uint64_t offset = 0, remaining = 0;
+        int fd = s2a_guest_file_at(address + done, &offset, &remaining);
+        size_t n = remaining < bytes - done ? (size_t)remaining : bytes - done;
+        if (fd < 0 || !n || n > INT_MAX || offset > INT64_MAX) break;
+        struct radvisory hint = {.ra_offset = (off_t)offset, .ra_count = (int)n};
+        if (fcntl(fd, F_RDADVISE, &hint) < 0) break;
+        done += n;
+    }
+    return done;
+}
