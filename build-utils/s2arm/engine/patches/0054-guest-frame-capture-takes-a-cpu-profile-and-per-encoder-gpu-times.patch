+// RewindBox (patch 0054): a window on request, written as raw addresses. The frame capture asks for one once its files are written (nvn_mtl.m cap_end): on the iPhone no start-up
+//   variable can aim a window at a race, and the framework's own functions are not exported, so a name per sample would be the nearest exported one's. <dir>/cpuprof.txt has the
+//   load address of every image (I lines) and of the game's modules (M lines: base, size, name), the sampled threads (T lines: slot, samples, name) and one S line per sample
+//   (slot, pc, then return addresses); the link map kept with each engine build turns the engine's offsets into functions. No path and no title in it. One window at a time,
+//   and none while S2A_CPUPROF runs its own. While it samples, the sampler suspends each running thread for a few microseconds, RQ_HZ times a second
+enum { RQ_HZ = 500, RQ_WAIT_S = 2 };
+static _Atomic int g_rq_busy; static char g_rq_dir[1024]; static double g_rq_secs;
+static void cp_raw_write(const char *dir, double secs) {
+    char p[1100]; snprintf(p, sizeof p, "%s/cpuprof.txt", dir);
+    FILE *f = fopen(p, "w");
+    if (!f) { LOG("RewindBox: CPU profile: cannot write cpuprof.txt beside the frame capture (%d samples lost)", g_ns); return; }
+    fprintf(f, "# RewindBox CPU profile (patch 0054): %.1f s at %d samples a second, %d samples of running threads. I: image load address, name. M: game module base, size, name. "
+               "T: thread slot, samples, name. S: thread slot, pc, return addresses (hex)\n", secs, (int)RQ_HZ, g_ns);
+    for (uint32_t i = 0, n = _dyld_image_count(); i < n; i++) {
+        const char *nm = _dyld_get_image_name(i), *b = nm ? strrchr(nm, '/') : NULL;
+        fprintf(f, "I %llx %s\n", (unsigned long long)(uintptr_t)_dyld_get_image_header(i), b ? b + 1 : nm ? nm : "?");
+    }
+    for (int i = 0; i < g_nmod; i++) fprintf(f, "M %llx %llx %.16s\n", (unsigned long long)(uintptr_t)g_mod[i].base, (unsigned long long)g_mod[i].size, g_mod[i].name);
+    for (int t = 0; t < g_nthr; t++) fprintf(f, "T %d %d %s\n", t, g_thr[t].n, g_thr[t].name);
+    for (int i = 0; i < g_ns; i++) {
+        fprintf(f, "S %u", (unsigned)g_s[i].thr);
+        for (int d = 0; d < g_s[i].n; d++) fprintf(f, " %llx", (unsigned long long)g_s[i].pc[d]);
+        fputc('\n', f);
+    }
+    int bad = ferror(f); if (fclose(f)) bad = 1;
+    LOG("RewindBox: CPU profile: %d samples of %d threads over %.1f s %s cpuprof.txt beside the frame capture", g_ns, g_nthr, secs, bad ? "NOT all written (a write failed) to" : "written to");
+}
+static void *cp_rq_main(void *arg) {
+    (void)arg; pthread_setname_np("s2a-cpuprof");
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    struct timespec w = {RQ_WAIT_S, 0}; nanosleep(&w, NULL);   // the capture stopped the picture for seconds: let the game run again first
+    g_ns = 0; g_nthr = 0; memset(g_thr, 0, sizeof g_thr);
+    double secs = cp_window(g_rq_secs, RQ_HZ, NULL);
+    cp_raw_write(g_rq_dir, secs);
+    free(g_s); g_s = NULL; g_ns = 0;
+    atomic_store(&g_rq_busy, 0);
     return NULL;
 }
+// 1: a window of secs seconds starts RQ_WAIT_S seconds from now and its samples go to <dir>/cpuprof.txt; 0: not started (one is running, S2A_CPUPROF has the table, no memory)
+int s2a_cpuprof_request(const char *dir, double secs) {
+    const char *e = getenv("S2A_CPUPROF");
+    if (!dir || !*dir || secs <= 0 || (e && *e) || atomic_exchange(&g_rq_busy, 1)) return 0;
+    if (!(g_s = calloc(CP_MAXS, sizeof *g_s))) { atomic_store(&g_rq_busy, 0); return 0; }
+    snprintf(g_rq_dir, sizeof g_rq_dir, "%s", dir); g_rq_secs = secs > 20 ? 20 : secs;
+    pthread_t t; pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setdetachstate(&a, PTHREAD_CREATE_DETACHED);
+    int rc = pthread_create(&t, &a, cp_rq_main, NULL);
+    pthread_attr_destroy(&a);
+    if (rc) { free(g_s); g_s = NULL; atomic_store(&g_rq_busy, 0); return 0; }
+    return 1;
+}
