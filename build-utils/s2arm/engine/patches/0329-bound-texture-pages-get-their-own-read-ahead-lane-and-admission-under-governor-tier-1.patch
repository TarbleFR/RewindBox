diff --git a/graphics/nvn/gfx/nvn/rb_bind_lane.h b/graphics/nvn/gfx/nvn/rb_bind_lane.h
new file mode 100644
index 0000000..a03de10
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_bind_lane.h
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0329): the page lane of bound textures (nvn_mtl.m rb_bind_lane.inc, rb_texture_ahead.inc, rb_read_ahead_feedback.inc). Pure C: tests/t_rb_bind_lane.c.
+//   IPA 827 (Mario Kart World, iPhone A18 Pro): the pages of a texture the game binds in a command buffer it is recording were never asked ahead. The memory governor
+//   was at tier 1 before frame 1 (559 MB of compressed memory, 875-1,049 MB later), whose read-ahead quota is 0; and the lane those hints were counted in had spent
+//   its 256 trial pages (4,194,304 bytes) on buffer ranges, which only a texture upload can find useful: 256 expired, 0 useful, stopped before frame 300 for the
+//   session. A race start then had 8-16 frames of 50-276 ms with 2,740-3,586 texture pages not in memory, read one texture at a time on the submit thread.
+//   This header holds what can be checked without a device:
+//   1. the switch (S2A_RB_BIND_LANE: on unless "0") and where the lane replaces patch 0319's path;
+//   2. the lane's own admission: governor tier 0 or 1, room known and at least RB_BL_ROOM, memory not low, thermal state under 2, lane open, a texture of at most
+//      RB_BL_ITEM, and a fixed budget of RB_BL_FRAME bytes of texture storage looked at a frame, RB_BL_POSTS hints a frame and RB_BL_TRIAL pages asked and not yet
+//      judged, each halved at every level of the lane;
+//   3. the cohort rule that moves the level: patch 0193's (half or fewer of the pages found in memory by their upload: one level down, and stopped at the last level,
+//      with no page found, or when too many outcomes are unknown), with four additions for a lane whose pages are read in the same frame anyway: a cohort under
+//      RB_BL_MIN_SAMPLE pages gives no verdict, a cohort wholly resolved closes at a quarter of its trial, three quarters found gives a level back, and a stopped
+//      lane tries again RB_BL_RETEST frames later at the last level;
+//   4. the two measurements of the 300-frame line: the frames between a texture's registration and its first upload, and whether that upload found its pages in memory.
+//   S2A_RB_BIND_LANE=0: as before (rb_bl_route answers 0: patch 0319's shared lane and quota; nothing of this header is called).
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+// ---- 1. the switch and the route
+static inline int rb_bl_switch(const char *value) { return !(value && !strcmp(value, "0")); }
+// The lane replaces patch 0319's bind hints only where the governor's feedback tables run (they judge it) and the hint is a madvise of the texture's own pages
+// (another title's file-descriptor advice keeps its token bucket and the shared lane). 0: patch 0319's path, untouched.
+static inline int rb_bl_route(int on, int governor, int file_only) { return on && governor && !file_only; }
+
+// ---- 2. the budget of a level and the admission
+enum { RB_BL_TIER_NORMAL, RB_BL_TIER_WARN, RB_BL_TIER_CRITICAL };   // rb_gov_plan.h's RB_GOV_NORMAL, RB_GOV_WARN, RB_GOV_CRITICAL
+enum { RB_BL_MAX_LEVEL = 2, RB_BL_POSTS = 256, RB_BL_TRIAL = 1024, RB_BL_MIN_SAMPLE = 32, RB_BL_RETEST = 3600 };
+#define RB_BL_ITEM  (UINT64_C(1) << 20)      // one texture's storage (rb_texture_ahead.inc's RB_TX_PAGE_ITEM)
+#define RB_BL_FRAME (UINT64_C(16) << 20)     // texture storage looked at in a frame at level 0
+#define RB_BL_ROOM  (UINT64_C(1024) << 20)   // room under the process limit below which nothing is asked
+static inline unsigned rb_bl_level(unsigned level) { return level > RB_BL_MAX_LEVEL ? (unsigned)RB_BL_MAX_LEVEL : level; }
+static inline unsigned rb_bl_posts(unsigned level) { return (unsigned)RB_BL_POSTS >> rb_bl_level(level); }
+static inline unsigned rb_bl_trial(unsigned level) { return (unsigned)RB_BL_TRIAL >> rb_bl_level(level); }
+static inline uint64_t rb_bl_frame_bytes(unsigned level) { return RB_BL_FRAME >> rb_bl_level(level); }
+// A cohort whose pages all have their outcome closes once it holds a quarter of the trial, without waiting to be full or 300 frames old: a race start asks
+// several trials in a few hundred frames (IPA 827: 2,740-3,586 pages in 100-200 frames), and a verdict on 64 pages or more is one the rule below accepts.
+static inline unsigned rb_bl_cohort_pages(unsigned level) { return rb_bl_trial(level) / 4; }
+
+// What the submit thread publishes for the recording threads, which read one word and take no lock: the level, and whether the lane is stopped.
+enum { RB_BL_WORD_STOPPED = 4 };
+static inline unsigned rb_bl_word(unsigned level, int stopped) { return rb_bl_level(level) | (stopped ? (unsigned)RB_BL_WORD_STOPPED : 0u); }
+// Hints the recording threads may post in a frame: none while the lane is stopped or the governor is at its critical tier.
+static inline unsigned rb_bl_post_limit(unsigned word, unsigned tier) {
+    if ((word & RB_BL_WORD_STOPPED) || tier >= RB_BL_TIER_CRITICAL) return 0;
+    return rb_bl_posts(word & 3u);
+}
+// One of a frame's posts, taken by several recording threads without a lock: `word` holds frame << 16 | the posts taken in that frame (another frame's
+// count starts at 0). 1 and *next (the word to store, by compare and swap) when one is left under `limit`; 0 when the frame's posts are spent.
+static inline int rb_bl_post_take(uint64_t word, uint64_t frame, unsigned limit, uint64_t *next) {
+    uint64_t now = frame << 16;
+    unsigned used = (word & ~UINT64_C(0xffff)) == now ? (unsigned)(word & 0xffff) : 0;
+    if (used >= limit || used >= 0xffff) return 0;
+    *next = now | (used + 1);
+    return 1;
+}
+// A recording thread posts a (texture ID, serial) once: the mark it leaves, never 0 (an empty mark).
+enum { RB_BL_MARKS = 65536 };
+static inline uint32_t rb_bl_tag(uint64_t serial) { uint32_t tag = (uint32_t)(serial ^ (serial >> 32)); return tag ? tag : 1u; }
+
+enum { RB_BL_ADMIT, RB_BL_NO_TIER, RB_BL_NO_ROOM, RB_BL_NO_LOW, RB_BL_NO_HEAT, RB_BL_NO_STOPPED, RB_BL_NO_FULL, RB_BL_NO_ITEM, RB_BL_NO_BUDGET, RB_BL_REASONS };
+typedef struct { unsigned tier, level; uint64_t room; int mem_low, thermal, stopped, full; } rb_bl_state;   // room: UINT64_MAX = not known; full: the trial is spent
+typedef struct { uint64_t frame, bytes; } rb_bl_budget;   // texture storage looked at in `frame` (the page queue is serial: one writer)
+// RB_BL_ADMIT (0) when the page worker may look at `bytes` of a texture's storage in `frame`; else why not. A refusal charges nothing.
+static inline int rb_bl_admit(rb_bl_budget *b, const rb_bl_state *s, uint64_t frame, uint64_t bytes) {
+    if (s->tier >= RB_BL_TIER_CRITICAL) return RB_BL_NO_TIER;
+    if (s->room == UINT64_MAX || s->room < RB_BL_ROOM) return RB_BL_NO_ROOM;
+    if (s->mem_low) return RB_BL_NO_LOW;
+    if (s->thermal >= 2) return RB_BL_NO_HEAT;
+    if (s->stopped) return RB_BL_NO_STOPPED;
+    if (s->full) return RB_BL_NO_FULL;
+    if (!bytes || bytes > RB_BL_ITEM) return RB_BL_NO_ITEM;
+    uint64_t used = b->frame == frame ? b->bytes : 0, limit = rb_bl_frame_bytes(s->level);
+    if (used > limit || bytes > limit - used) return RB_BL_NO_BUDGET;
+    b->frame = frame; b->bytes = used + bytes;
+    return RB_BL_ADMIT;
+}
+
+// ---- 3. the cohort rule
+// A closed cohort: `opened` pages asked, `hits` of them found in memory and read by their texture's upload, `unknown` with no outcome (their pool went, or the
+// upload did not read them). The rest were still absent at their upload, or never used in 300 frames.
+enum { RB_BL_KEEP, RB_BL_GROW, RB_BL_SHRINK, RB_BL_STOP };
+static inline int rb_bl_verdict(unsigned opened, unsigned hits, unsigned unknown, unsigned level) {
+    uint64_t n = opened, h = hits, u = unknown;
+    if (n < RB_BL_MIN_SAMPLE) return RB_BL_KEEP;   // too few pages to judge; they cost at most RB_BL_MIN_SAMPLE pages in 300 frames
+    if (2 * h > n) return (4 * h >= 3 * n && level) ? RB_BL_GROW : RB_BL_KEEP;
+    if (2 * (h + u) > n || !h || level >= RB_BL_MAX_LEVEL) return RB_BL_STOP;
+    return RB_BL_SHRINK;
+}
+typedef struct { unsigned level; int stopped; uint64_t stop_frame; } rb_bl_lane;   // what the feedback table keeps of this lane
+static inline int rb_bl_close(rb_bl_lane *l, unsigned opened, unsigned hits, unsigned unknown, uint64_t frame) {
+    int verdict = rb_bl_verdict(opened, hits, unknown, l->level);
+    if (verdict == RB_BL_GROW) l->level--;
+    else if (verdict == RB_BL_SHRINK) l->level++;
+    else if (verdict == RB_BL_STOP) { l->stopped = 1; l->stop_frame = frame; }
+    return verdict;
+}
+// 1 when a stopped lane opens again for one more trial, at the last level (RB_BL_TRIAL >> RB_BL_MAX_LEVEL pages at most before the next verdict).
+static inline int rb_bl_reopen(rb_bl_lane *l, uint64_t frame) {
+    if (!l->stopped || frame < l->stop_frame || frame - l->stop_frame < RB_BL_RETEST) return 0;
+    l->stopped = 0; l->level = RB_BL_MAX_LEVEL;
+    return 1;
+}
+
+// ---- 4. the measurements
+// Frames from a texture's first registration to its first upload, in RB_BL_BUCKETS classes: 0, 1, 2-3, 4-15, 16-63, 64-255, 256-1023, 1024 and more, not known.
+// One slot per hashed serial. A slot keeps its last registration, and the frame of the newest registration it let go (replaced, or taken by its upload): an upload
+// that does not find its registration there was registered no later than that frame, if it was registered at all. That places it in the last class when every
+// registration its slot let go is at least 1,024 frames old (a session registers about 30,900 packaged textures at its start, more than the table holds), and in
+// "not known" otherwise.
+enum { RB_BL_SLOTS = 8192, RB_BL_BUCKETS = 9, RB_BL_LEAD_FAR = 7, RB_BL_LEAD_UNKNOWN = 8 };
+#define RB_BL_NOT_LOOKED UINT64_MAX   // the upload did not look at its pages (not wholly in the window's files, or read through a sparse pool's page table)
+typedef struct { uint64_t serial; uint32_t frame1, gone1; } rb_bl_slot;   // frame + 1 of the serial's first registration; of the newest registration let go (0: none)
+typedef struct { rb_bl_slot slot[RB_BL_SLOTS]; } rb_bl_table;
+typedef struct { uint64_t registered, uploads[RB_BL_BUCKETS], with_absent[RB_BL_BUCKETS], absent_pages[RB_BL_BUCKETS], resident, absent, not_looked; } rb_bl_window;
+static inline unsigned rb_bl_slot_of(uint64_t serial) { return (unsigned)((serial * UINT64_C(0x9e3779b97f4a7c15)) >> 51); }   // 13 bits: RB_BL_SLOTS
+static inline uint32_t rb_bl_frame1(uint64_t frame) { return frame >= UINT32_MAX - 1 ? UINT32_MAX : (uint32_t)frame + 1; }
+static inline unsigned rb_bl_bucket(uint64_t lead) {
+    if (lead < 2) return (unsigned)lead;
+    if (lead < 4) return 2;
+    if (lead < 16) return 3;
+    if (lead < 64) return 4;
+    if (lead < 256) return 5;
+    return lead < 1024 ? 6 : RB_BL_LEAD_FAR;
+}
+static inline void rb_bl_note_registered(rb_bl_table *t, rb_bl_window *w, uint64_t serial, uint64_t frame) {
+    if (!serial) return;
+    rb_bl_slot *e = &t->slot[rb_bl_slot_of(serial)];
+    if (e->serial == serial) return;   // registered again (another ID): the first registration starts the lead, and counts once
+    if (e->serial && e->frame1 > e->gone1) e->gone1 = e->frame1;
+    e->serial = serial; e->frame1 = rb_bl_frame1(frame);
+    w->registered++;
+}
+// A first upload of `serial` (0: a texture this table does not follow) in `frame`, which found `absent_pages` of its pages not in memory (RB_BL_NOT_LOOKED:
+// not looked at). Returns the class it was counted in. A registration is taken once.
+static inline unsigned rb_bl_note_upload(rb_bl_table *t, rb_bl_window *w, uint64_t serial, uint64_t frame, uint64_t absent_pages) {
+    unsigned b = RB_BL_LEAD_UNKNOWN;
+    uint32_t now1 = rb_bl_frame1(frame);
+    if (serial) {
+        rb_bl_slot *e = &t->slot[rb_bl_slot_of(serial)];
+        if (e->serial == serial) {
+            if (now1 >= e->frame1) {
+                b = rb_bl_bucket(now1 - e->frame1);
+                if (e->frame1 > e->gone1) e->gone1 = e->frame1;
+                e->serial = 0; e->frame1 = 0;
+            }
+        } else if (e->gone1 && now1 >= e->gone1 && now1 - e->gone1 >= 1024) b = RB_BL_LEAD_FAR;
+    }
+    w->uploads[b]++;
+    if (absent_pages == RB_BL_NOT_LOOKED) w->not_looked++;
+    else if (absent_pages) { w->absent++; w->with_absent[b]++; w->absent_pages[b] += absent_pages; }
+    else w->resident++;
+    return b;
+}
diff --git a/graphics/nvn/gfx/nvn/rb_bind_lane.inc b/graphics/nvn/gfx/nvn/rb_bind_lane.inc
new file mode 100644
index 0000000..5c592ae
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_bind_lane.inc
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0329): the pages of bound textures get a lane and an admission of their own. IPA 827 (Mario Kart World, iPhone A18 Pro, two sessions): a race
+//   start had 8-16 frames marked cause=submit of 50-276 ms, 210-383 ms of them first uploads on the submit thread, which found 2,740-3,586 of their host pages not
+//   in memory (4,223-4,504 in the frame that switches to the race) and waited for them one texture at a time. The hint patch 0185 gives for a texture the game binds
+//   in a command buffer it is recording (nvn_be_record_texture_pages) never ran: (a) the memory governor was at tier 1 before frame 1 and for the whole session
+//   (559 MB of compressed memory at the start, 875-1,049 MB later, over its 512 MB mark), whose read-ahead quota is 0, which rb_ra_scale, rb_tx_page_run's
+//   enough_room, rb_wn and rb_ra_advise all read; (b) the fair thermal state holds its speculative lease (rb_spec_take); (c) the "recorded-bind" lane it shares
+//   with the game's buffer ranges (rb_guest_range.inc) had spent its 256 trial pages, 4,194,304 bytes, on those ranges before frame 1, and only a texture upload
+//   can find a page useful (rb_ra_observe): 256 expired, 0 useful, stopped before frame 300 for the session.
+//   Rule now, for these hints only: they are counted in a lane of their own (RA_TEXBIND, "texture-bind" on the [RB-READ-AHEAD] lines), which buffer ranges neither
+//   spend nor judge, and admitted by rb_bind_lane.h instead of the read-ahead quota: governor tier 0 or 1, at least 1 GiB of known room, memory not low, thermal
+//   state under 2, at most 16 MiB of texture storage looked at a frame, 256 hints a frame and 1,024 pages asked and not yet judged, textures of at most 1 MiB,
+//   all halved at each level the lane's own cohorts take away (patch 0193's rule, on at least 32 pages; stopped, it tries again 3,600 frames later at a quarter).
+//   A hint asks the pager for pages the texture's first upload reads in the same frame anyway (madvise, clean pages of the window's files): what is read, uploaded
+//   and drawn does not change, only when the read starts. The upload still looks at its own pages and asks for those still missing, as before.
+//   The 300-frame line adds the two measurements no log has: the frames from a texture's registration to its first upload, and how many first uploads found
+//   their pages in memory (for every title, whatever the lane does). The lane itself takes over only where the governor's feedback tables run and the hint is a
+//   madvise: with the governor off, or another title's file-descriptor advice, patch 0319's path runs as it did. Its other conditions stay: an exact course
+//   profile (rb_course_exact), S2A_RB_PARK_COMPAT=1, S2A_RB_TEX_PREFETCH, S2A_RB_WILLNEED and S2A_RB_TEX_PAGE_HINTS not 0.
+//   S2A_RB_BIND_LANE=0: as before (the shared lane, the quota, the lease, 32 hints and 8 MiB a frame; no table written, no 300-frame line).
+//   Memory: rb_bl_leads 128 KiB and rb_bl_marks 256 KiB, both static; pages asked and not yet judged: 1,024 at most (16 MiB of 16 KiB pages), clean file pages
+//   the system takes back first, and none asked at the governor's critical tier, with memory low, under 1 GiB of room or from the serious thermal state.
+#include "rb_bind_lane.h"
+static int rb_bl_on(void) {   // any thread: the same value whoever reads it first
+    static _Atomic int v = -1; int x = atomic_load_explicit(&v, memory_order_relaxed);
+    if (x < 0) { x = rb_bl_switch(getenv("S2A_RB_BIND_LANE")); int was = -1;
+        if (atomic_compare_exchange_strong(&v, &was, x)) MLOG("[rb-bind-lane] bound textures' page lane %s (S2A_RB_BIND_LANE; patch 0329): %s", x ? "on" : "off",
+            x ? "own lane and admission under governor tiers 0 and 1, registration-to-upload line every 300 frames" : "the shared recorded-bind lane and the read-ahead quota, as before"); }
+    return x;
+}
+_Static_assert(RB_BL_NOT_LOOKED == RB_WN_NONE, "a look that was not made reads the same in both");
+static _Atomic unsigned rb_bl_published;            // rb_bl_word(level, stopped) of the lane: stored under rb_ra_lock by the sweep, read by the recording threads
+static _Atomic uint32_t rb_bl_marks[RB_BL_MARKS];   // rb_bl_tag of the serial last posted for a texture ID (its low 16 bits): a hint is posted once
+static _Atomic int rb_bl_marked;                    // a mark was written this session (rb_bl_reset then clears them)
+static _Atomic uint64_t rb_bl_frame_posts;          // frame << 16 | the hints posted in it (rb_bl_post_take)
+static _Atomic unsigned rb_bl_pending;              // hints posted and not yet run by the page queue
+static rb_bl_budget rb_bl_work;                     // the page queue's (serial): texture storage looked at in the current frame
+static _Atomic uint64_t rb_bl_posted, rb_bl_looked, rb_bl_hint_pages, rb_bl_busy, rb_bl_stale, rb_bl_outside, rb_bl_retests, rb_bl_refused[RB_BL_REASONS];
+static os_unfair_lock rb_bl_lock = OS_UNFAIR_LOCK_INIT;
+static rb_bl_table rb_bl_leads;         // rb_bl_lock
+static rb_bl_window rb_bl_counts;       // rb_bl_lock: since the last line
+static _Thread_local uint64_t rb_bl_probe;   // what the last look of pkg_upload_ on this thread found (rb_wn_demand's answer)
+static void rb_bl_publish(unsigned level, int stopped) { atomic_store_explicit(&rb_bl_published, rb_bl_word(level, stopped), memory_order_relaxed); }
+static void rb_bl_registered(const tex_t *t) {   // nvn_be_reg_tex (the game's threads): a packaged texture's first registration starts its lead
+    if (!t->serial || !t->has_layout || !t->mem || !rb_bl_on()) return;
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    os_unfair_lock_lock(&rb_bl_lock);
+    rb_bl_note_registered(&rb_bl_leads, &rb_bl_counts, t->serial, frame);
+    os_unfair_lock_unlock(&rb_bl_lock);
+}
+static void rb_bl_first_upload(const tex_t *t, int sparse) {   // tex_mtl_for_pass, after t's first upload (pkg_upload_ left its look in rb_bl_probe; a sparse pool's texture has none)
+    if (!rb_bl_on()) return;
