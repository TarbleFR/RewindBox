 static int rb_u64_cmp(const void *a, const void *b) { uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b; return (x > y) - (x < y); }
+// Display callbacks are not necessarily ordered. Count each complete
+// presentation gap once even if it contains several acquisition waits.
+static int rb_wait_cmp(const void *a,const void *b) {
+    const rb_pipeline_wait *x=a,*y=b;
+    return (x->start>y->start)-(x->start<y->start);
+}
+static NSDictionary *rb_pipeline_gaps(const rb_run *run) {
+    size_t n=run->display_n;
+    if (!n) return nil;
+    qsort(run->display,n,sizeof *run->display,rb_u64_cmp);
+    qsort(rb_waits,rb_wait_count,sizeof *rb_waits,rb_wait_cmp);
+    size_t j=0; uint64_t matched=0,all=0,prev=run->display[0];
+    for (size_t i=1;i<n;i++) {
+        uint64_t end=run->display[i],gap=end-prev;
+        if (gap>100000000) {
+            all+=gap;
+            while (j<rb_wait_count && rb_waits[j].end<=prev) j++;
+            if (j<rb_wait_count && rb_waits[j].start<end) matched+=gap;
+        }
+        prev=end;
+    }
+    // The true duration of each boundary frame is unknown. Charge every
+    // nanosecond inside the window on both boundaries to the upper bound.
+    uint64_t edges=run->display[0]-run->start_ns+run->end_ns-prev;
+    return @{@"complete_long_display_ns":@(all),@"boundary_exposure_ns":@(edges),
+        @"all_causes_upper_bound_ns":@(all+edges),@"wait_scopes":@(rb_wait_count),
+        @"wait_overflow":rb_bool(rb_wait_overflow),
+        @"overlapping_long_display_ns":rb_value(!rb_wait_overflow,matched)};
+}
