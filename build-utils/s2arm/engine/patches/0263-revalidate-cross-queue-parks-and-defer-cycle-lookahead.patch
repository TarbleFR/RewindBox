+static void rb_publish_after_snapshot(void) {
+    if (!rb_publish_word) return;
+    volatile uint32_t *word = rb_publish_word;
+    rb_publish_word = NULL;
+    *word = 1;
+    nvn_be_event_written(word);
+}
