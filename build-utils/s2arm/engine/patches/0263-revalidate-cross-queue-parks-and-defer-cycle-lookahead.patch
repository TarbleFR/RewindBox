+// Virtual macOS devices can expose a real, tracked Metal queue without the
+// residency sets required by S2Arm. Replace just the Metal CB and the two blits.
+// The actual replay, event test, unwind, continuation, fences and cycle detection run.
+static id<MTLCommandQueue> tracked_q;
+static id<MTLCommandBuffer> tracked_cb;
+static id<MTLBuffer> tracked_pool;
+static void rb_test_xq_begin(void) {
+    if (!tracked_q) { nvn_be_sub_begin(); return; }
+    tracked_cb = [tracked_q commandBuffer]; REQUIRE(tracked_cb);
+    g_npost = 0; g_rc_skip = 0; g_rc_npend = 0;
+}
+static NSUInteger tracked_offset(uint64_t addr, uint64_t n) {
+    uintptr_t base = (uintptr_t)tracked_pool.contents;
+    REQUIRE(addr >= base && n <= tracked_pool.length && addr - base <= tracked_pool.length - n);
+    return (NSUInteger)(addr - base);
+}
+static int rb_test_xq_transfer(unsigned op, const void *data) {
+    if (!tracked_q || (op != OP_CLEAR_BUF && op != OP_COPY_B2B)) return 0;
+    id<MTLBlitCommandEncoder> enc = [tracked_cb blitCommandEncoder]; REQUIRE(enc);
+    if (op == OP_CLEAR_BUF) {
+        p_clear_buf c; memcpy(&c, data, sizeof c);
+        REQUIRE(c.value == ((c.value & 0xffu) * 0x01010101u));
+        [enc fillBuffer:tracked_pool range:NSMakeRange(tracked_offset(c.addr, c.size), c.size) value:(uint8_t)c.value];
+    } else {
+        uint64_t a[3]; memcpy(a, data, sizeof a);
+        [enc copyFromBuffer:tracked_pool sourceOffset:tracked_offset(a[0], a[2])
+                toBuffer:tracked_pool destinationOffset:tracked_offset(a[1], a[2]) size:a[2]];
+    }
+    [enc endEncoding]; return 1;
+}
+static uint64_t rb_test_xq_commit(void) {
+    if (!tracked_q) return nvn_be_sub_commit();
+    [tracked_cb commit]; [tracked_cb waitUntilCompleted];
+    REQUIRE(tracked_cb.status == MTLCommandBufferStatusCompleted && !tracked_cb.error);
+    for (int i=0; i<g_npost; i++) {
+        post_op op = g_post[i]; REQUIRE(op.kind == 1);
+        if (op.mode == 1) *op.val += op.v; else *op.val = op.v;
+        evs_landed(op.val);
+    }
+    g_npost=0; tracked_cb=nil; g_done=++g_fence;
+    return g_fence;
+}
