+                    if (!(g_noload_stop & (g_noload_stop - 1))) MLOG("RewindBox: attachment scans stopped at the bind of a program whose shaders are not loaded yet: %llu so far (those passes load their attachments; the scan loads no shader on the submit thread)", (unsigned long long)g_noload_stop);
+                    break; } }
+                state_op(hq.op, aq, hq.size); break; }
             default: state_op(hq.op, aq, hq.size); break;
         }
         if (stop) break;
