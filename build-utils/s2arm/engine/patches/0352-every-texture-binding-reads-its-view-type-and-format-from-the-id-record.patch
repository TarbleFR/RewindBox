new file mode 100644
index 0000000..5294e57
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_view_meta.h
@@ -0,0 +1,41 @@
+// RewindBox (patch 0352): a binding's texture type and pixel format from its texture ID's record instead of a message to the texture (nvn_mtl.m rb_vmeta_rec; the record
+//   is treg_t's view, view_tt and view_pf). Pure C: tests/t_rb_view_meta.c. Ported from nxnative c7e74a1f (MIT, "nvn/replay: cache view type and pixel format on
+//   treg_t"): full argument encodes, image bindings, the pool walk and handle tables messaged textureType and pixelFormat on every texture slot although both are
+//   immutable for an MTLTexture; read beside the view instead, submit CPU per draw fell 2.2 to 3.2 % (Mario Kart World on an Apple M6, about 1,960 draws a frame).
+//   Here the record has held both since upstream's P1-20 probe (tex_by_id writes them in the step that sets the view, the only place a view is set), and patch 0073 reads
+//   them for a texture slot's type and float-class tests (rb_tt / rb_pf). Every other read of a full walk still asked the texture: each element of an array of handles
+//   in a uniform buffer (Fire Emblem's arrays of 32, 29 of them textures, IPA 836), of a dynamic or driver-table array, a buffer texture slot, an image slot (its type
+//   twice, an integer class's format), a texture slot's 1D-rows test, and the pool tables' walk (twice an ID looked up again).
+// The key is the view object itself, not the ID, its serial or its pool: the record answers only for the object it holds, which it retains (no other object can take
+//   that address meanwhile), and it writes the type and format in the step that sets the view. Whatever changes what an ID reads lets its view go or replaces it before
+//   a binding can meet another object: registered again with another texture or view (a serial change) or unregistered, its pool or its texture finalized, its storage
+//   evicted or taken over (an alias), a re-upload or a format-view upgrade to a new texture, a placement sparse texture's mappings moved. tex_by_id's slow path keeps a
+//   view only when tex_mtl finds that same texture again (an upload in place changes neither its type nor its format). Any other object a binding holds (a view made for
+//   another type or class: tex_fit, img_fit, tex_float_fit; a same-pass snapshot, rows of a buffer texture, an expanded copy, a dummy) is asked, as before.
+//   No memory is added: the two fields were in every record already. All of it runs under g_rmu, which the submit (encode) thread holds for a whole binding walk
+#pragma once
+#include <stdatomic.h>
+#include <stdint.h>
+
+enum { RB_VMETA_HIT = 0, RB_VMETA_MISS, RB_VMETA_DROP, RB_VMETA_N };   // the counts: reads the record answered, reads asked of the texture, records that let their view go
+
+// Whether the record holding view (NULL: none, or an ID outside the table) answers for the bound texture t. on: S2A_RB_VIEW_META; early: a read patch 0073 already
+//   answers from the record (rb_tt / rb_pf), which it does with the switch off too
+static inline int rb_vmeta_answers(int on, int early, const void *view, const void *t) { return (on || early) && t && view == t; }
+
+// The count a read adds: RB_VMETA_HIT / RB_VMETA_MISS, -1 = none (the switch off)
+static inline int rb_vmeta_count(int on, int answered) { return on ? (answered ? RB_VMETA_HIT : RB_VMETA_MISS) : -1; }
+
+// The record lets its view go (dropped, or replaced on tex_by_id's slow path): with the switch on its type and format go with it and an invalidation is counted (1).
+//   Off: left as they were, as before (nothing reads them without the view)
+static inline int rb_vmeta_forget(int on, const void *view, uint8_t *tt, uint32_t *pf) {
+    if (!on || !view) return 0;
+    *tt = 0; *pf = 0;
+    return 1;
+}
+
+// One more of count k (k < 0: none). Every writer holds the same lock (g_rmu), so a relaxed load and store lose no count, and a reader without it (the frame hook's
+//   300-frame line) reads whole values
+static inline void rb_vmeta_bump(_Atomic uint64_t *n, int k) {
+    if (k >= 0) atomic_store_explicit(&n[k], atomic_load_explicit(&n[k], memory_order_relaxed) + 1, memory_order_relaxed);
+}
