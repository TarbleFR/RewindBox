new file mode 100644
index 0000000..1f16671
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_view_epoch.h
@@ -0,0 +1,28 @@
+#ifndef RB_VIEW_EPOCH_H
+#define RB_VIEW_EPOCH_H
+
+#include <stdint.h>
+
+enum { RB_VIEW_BUCKETS = 1024 };
+typedef struct {
+    uint64_t writes;
+    uint64_t bucket[RB_VIEW_BUCKETS];
+} rb_view_epoch;
+
+// A collision forces a regular lookup. A bucket never certifies another
+// serial's mutation as unrelated when even one unclassified change occurred.
+static inline unsigned rb_view_bucket(uint64_t serial) {
+    return (unsigned)((serial ^ (serial >> 17)) & (RB_VIEW_BUCKETS - 1));
+}
+static inline void rb_view_note(rb_view_epoch *epoch, uint64_t serial, uint64_t global) {
+    epoch->writes++;
+    epoch->bucket[rb_view_bucket(serial)] = global;
+}
+static inline int rb_view_epoch_reusable(uint64_t global, uint64_t before,
+                                         uint64_t additions, uint64_t local,
+                                         uint64_t before_local, uint64_t last_bucket) {
+    uint64_t scoped = local - before_local;
+    return scoped && last_bucket <= before && global - before == additions + scoped;
+}
+
+#endif
