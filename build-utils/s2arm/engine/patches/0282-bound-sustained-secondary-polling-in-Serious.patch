+// A longer sleep requires consecutive idle calls at one site. A different
+// system call, meaningful guest work, a role change or another site re-arms it.
+typedef struct {
+    uint64_t site, sequence, since;
+    int active;
+} rb_idle_round;
+
+static inline uint64_t rb_idle_sleep_ns(rb_idle_round *round, int eligible,
+                                       uint64_t site, uint64_t sequence, uint64_t now,
+                                       uint64_t ordinary) {
+    if (!eligible) {
+        round->active = 0;
+        return ordinary;
+    }
+    if (!round->active || round->site != site || sequence != round->sequence + 1 ||
+        now < round->since) {
+        round->active = 1;
+        round->site = site;
+        round->since = now;
+    }
+    round->sequence = sequence;
+    if (now - round->since >= 8000000 && ordinary < 1000000) return 1000000;
+    return ordinary;
+}
