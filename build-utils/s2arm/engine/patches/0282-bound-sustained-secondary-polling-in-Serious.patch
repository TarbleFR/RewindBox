+static void sustained_poll(void) {
+    rb_idle_round round = {0};
+    const uint64_t ordinary = 250000, site = 7;
+    uint64_t now = 0, seq = 0;
+    for (unsigned i=0; i<32; i++, now+=ordinary)
+        assert(rb_idle_sleep_ns(&round,1,site,++seq,now,ordinary)==ordinary);
+    assert(rb_idle_sleep_ns(&round,1,site,++seq,now,ordinary)==1000000);
+    assert(rb_idle_sleep_ns(&round,1,site+1,++seq,now,ordinary)==ordinary);
+    assert(rb_idle_sleep_ns(&round,1,site+1,++seq,now+8000000,ordinary)==1000000);
+    seq += 2;
+    assert(rb_idle_sleep_ns(&round,1,site+1,seq,now+16000000,ordinary)==ordinary);
+    assert(rb_idle_sleep_ns(&round,0,site+1,++seq,now+24000000,ordinary)==ordinary);
+    assert(rb_idle_sleep_ns(&round,1,site+1,++seq,now+32000000,ordinary)==ordinary);
+    assert(rb_idle_sleep_ns(&round,1,site+1,++seq,now+40000000,1500000)==1500000);
+    puts("PASS sustained guest idle: 8 ms stable site, bounded 1 ms delay, progress and eligibility reset");
+}
+
