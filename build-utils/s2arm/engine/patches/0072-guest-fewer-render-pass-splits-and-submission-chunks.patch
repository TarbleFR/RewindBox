+static void rb_xq_note(cmd_t *o, uint32_t op, const uint8_t *p) {
+    srec *r = o->rec; if (!r || r->rb_over) return;
+    if (op == OP_SIGNAL_EVENT) { volatile uint32_t *x; uint32_t m; memcpy(&x, p + 8, 8); memcpy(&m, p + 16, 4); if (m & NVN_EV_WAIT) return;
