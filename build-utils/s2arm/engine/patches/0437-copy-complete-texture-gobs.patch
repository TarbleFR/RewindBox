+// RewindBox (patch 0437): Copy complete 8-row GOBs in their physical order.
+// Processes one complete 512-byte GOB (4 contiguous 128B cache lines, 8 rows x 64 bytes) at a time
+// in sequential 128B cache-line order with compile-time constant offsets and pre-computed row pointers,
+// so move needs one block address per column instead of one per 16-byte piece.
+static inline void copy_gob_8x64_sw2_to_lin(const uint8_t * __restrict gob, uint8_t * __restrict row0, size_t pitch) {
+    uint8_t *r0 = row0, *r1 = r0 + pitch, *r2 = r1 + pitch, *r3 = r2 + pitch;
+    uint8_t *r4 = r3 + pitch, *r5 = r4 + pitch, *r6 = r5 + pitch, *r7 = r6 + pitch;
+    // Line 0 (bytes 0..127): rows 0..3 cols [0..31]
+    memcpy(r0,      gob +   0, 16); memcpy(r1,      gob +  16, 16);
+    memcpy(r2,      gob +  32, 16); memcpy(r3,      gob +  48, 16);
+    memcpy(r0 + 16, gob +  64, 16); memcpy(r1 + 16, gob +  80, 16);
+    memcpy(r2 + 16, gob +  96, 16); memcpy(r3 + 16, gob + 112, 16);
+    // Line 1 (bytes 128..255): rows 4..7 cols [0..31]
+    memcpy(r4,      gob + 128, 16); memcpy(r5,      gob + 144, 16);
+    memcpy(r6,      gob + 160, 16); memcpy(r7,      gob + 176, 16);
+    memcpy(r4 + 16, gob + 192, 16); memcpy(r5 + 16, gob + 208, 16);
+    memcpy(r6 + 16, gob + 224, 16); memcpy(r7 + 16, gob + 240, 16);
+    // Line 2 (bytes 256..383): rows 0..3 cols [32..63]
+    memcpy(r0 + 32, gob + 256, 16); memcpy(r1 + 32, gob + 272, 16);
+    memcpy(r2 + 32, gob + 288, 16); memcpy(r3 + 32, gob + 304, 16);
+    memcpy(r0 + 48, gob + 320, 16); memcpy(r1 + 48, gob + 336, 16);
+    memcpy(r2 + 48, gob + 352, 16); memcpy(r3 + 48, gob + 368, 16);
