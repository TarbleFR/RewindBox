+++ b/graphics/nvn/gfx/nvn/nvn2_codec.c
@@ -95,10 +95,33 @@ unsigned s2a_session_generation(void) __attribute__((weak));
 typedef struct { uint64_t ev; unsigned gen; } vi_vs_arg;
 static _Atomic int g_vi_vs_live;   // 活着的 vsync 线程数（单测读）
 int nvn2_vi_vsync_live(void) { return atomic_load(&g_vi_vs_live); }
+// RewindBox (patch 0341): the display link's vsync (nvn_mtl.m nvn_be_vi_vsync_wait; rb_vi_vsync.h). The weak stub stands in when no backend is linked (the codec's unit test)
+#include "rb_vi_vsync.h"
+__attribute__((weak)) int nvn_be_vi_vsync_wait(uint64_t *seen, uint64_t timeout_ns) { (void)seen; (void)timeout_ns; return 0; }
+static int rb_vi_link_on(void) {
+    static _Atomic int v = -1; int on = atomic_load(&v);
+    if (on < 0) { on = !rb_vi_link_asked_off(getenv("S2A_RB_VI_VSYNC_LINK"));
+        if (atomic_exchange(&v, on) < 0) LOG("[rb-vi-vsync] nn::vi vsync %s (S2A_RB_VI_VSYNC_LINK; patch 0341)", on ? "from the display link's 60 Hz ticks, the 60 Hz clock when the link gives none" : "from the 60 Hz clock alone, as before"); }
+    return on;
+}
 static void *vi_vsync_thread(void *p) {
     vi_vs_arg a = *(vi_vs_arg *)p; free(p);
     const uint64_t period = 1000000000ull / 60;
+    uint64_t seen = 0, linked = 0, clocked = 0; unsigned rest = 0;   // RewindBox (patch 0341)
     for (uint64_t next = mono_ns() + period;; next += period) {
+        if (!rest && rb_vi_link_on()) {   // RewindBox (patch 0341): the display's own vsync
+            const int ok = nvn_be_vi_vsync_wait(&seen, 2 * period);
+            rest = rb_vi_link_rest(1, ok);
+            if (ok) {
+                if (s2a_session_generation && s2a_session_generation() != a.gen) break;   // 这一局结束了
+                s2a_event_signal(a.ev);
+                if (!linked++) LOG("[rb-vi-vsync] the first vsync event from the display link (%llu from the clock before it)", (unsigned long long)clocked);
+                next = mono_ns();   // the clock goes on from this vsync if the link stops
+                continue;
+            }
+            seen = 0; next = mono_ns();   // none within two periods: the clock, from now, for a second
+        } else if (rest) rest--;
+        clocked++;
         uint64_t t = mono_ns(); if (next > t) { struct timespec ts = {(time_t)((next - t) / 1000000000ull), (long)((next - t) % 1000000000ull)}; nanosleep(&ts, NULL); }
         if (s2a_session_generation && s2a_session_generation() != a.gen) break;   // 这一局结束了
         s2a_event_signal(a.ev);
diff --git a/graphics/nvn/gfx/nvn/nvn_mtl.m b/graphics/nvn/gfx/nvn/nvn_mtl.m
