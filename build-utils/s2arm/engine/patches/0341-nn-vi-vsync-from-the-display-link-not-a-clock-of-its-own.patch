--- a/graphics/nvn/gfx/nvn/nvn_mtl.m
+++ b/graphics/nvn/gfx/nvn/nvn_mtl.m
@@ -257,6 +257,9 @@ static pthread_cond_t g_classic_work = PTHREAD_COND_INITIALIZER; // only the cla
 static pthread_cond_t g_link_cv = PTHREAD_COND_INITIALIZER;
 static pthread_mutex_t g_link_mu = PTHREAD_MUTEX_INITIALIZER;
 static uint64_t g_link_tick_ns, g_link_tick_n;
+#include "rb_vi_vsync.h"   // RewindBox (patch 0341)
+static pthread_cond_t g_rb_vi_cv = PTHREAD_COND_INITIALIZER;   // g_link_mu: the display's 60 Hz vsyncs for nn::vi (nvn_be_vi_vsync_wait)
+static uint64_t g_rb_vi_n, g_rb_vi_last; static int g_rb_vi_waiters;   // g_link_mu: vsyncs counted (never reset), the last one's time, vi threads waiting
 // 上一帧开工时的显示链接拍号（nvn_be_link_wait_tick，只有游戏上屏线程调）。逐局状态：与 g_link_tick_n 同处清零（nvn_session.inc）——
 //   11-04 进程内重启（设置页「立刻重启」）后拍号从 0 重数、它却留着上一局的约 5124，每帧都等满超时 2 拍 → 锁 30 帧，追平前约 85 秒（泰拉瑞亚 s04 两局）
 static uint64_t g_link_started_tick;
@@ -27032,6 +27035,7 @@ static void rb_release_link_rt(uint64_t now) {
     g_link_tick_ns = now_ns();
     g_rb_tick_target = exact_hz ? update.targetPresentationTimestamp : 0;
     g_link_tick_n++;
+    if (rb_vi_tick_vsync(g_link_tick_ns, &g_rb_vi_last)) { g_rb_vi_n++; if (g_rb_vi_waiters) pthread_cond_broadcast(&g_rb_vi_cv); }   // RewindBox (patch 0341): the next 60 Hz vsync for nn::vi (rb_vi_vsync.h)
     int filter = rb_tick_filter_enabled();
     int due = !filter || !g_rb_wait_step || rb_display_wait_ready(g_link_tick_n, g_link_started_tick,
                   g_rb_wait_step, g_rb_tick_target, g_rb_started_target, g_rb_wait_seconds);
@@ -27677,6 +27681,23 @@ int nvn_be_link_wait_tick(int vsyncs, uint64_t timeout_ns) {
 
 // The display's vsync for vi::GetDisplayVsyncEvent (hle_sdk16.c): returns 1 at the first display-link tick of the next 60 Hz vsync after *seen (the tick count it last returned, updated),
 // 0 when the link does not run, runs below 60 Hz (the 60 Hz event cannot come from it) or gives no tick within the timeout; the caller then keeps its own clock
+// RewindBox (patch 0341): defined (the Switch 2 path, nvn2_codec.c vi_vsync_thread). *seen = 0: from the next vsync on
+int nvn_be_vi_vsync_wait(uint64_t *seen, uint64_t timeout_ns) {
+    if (!nvn_be_link_active() || atomic_load(&g_link_stop)) return 0;
+    const int m = atomic_load(&g_link_mode); if (m == 3 || m == 4) return 0;   // 30 / 20 Hz: no 60 Hz vsync to give
+    struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += timeout_ns / 1000000000ull; ts.tv_nsec += timeout_ns % 1000000000ull;
+    if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+    pthread_mutex_lock(&g_link_mu);
+    if (!*seen) *seen = g_rb_vi_n;
+    g_rb_vi_waiters++;
+    int timeout = 0;
+    while (g_rb_vi_n <= *seen && !atomic_load(&g_link_stop) && !timeout) timeout = pthread_cond_timedwait(&g_rb_vi_cv, &g_link_mu, &ts) == ETIMEDOUT;
+    g_rb_vi_waiters--;
+    const int ok = g_rb_vi_n > *seen; if (ok) *seen = g_rb_vi_n;
+    pthread_mutex_unlock(&g_link_mu);
+    return ok;
+}
 
 static id<CAMetalDrawable> g_prefetched_drawable; // Used for compositing straight onto the drawable
 id<CAMetalDrawable> mtl_present_take_prefetched(void) { return g_prefetched_drawable; }
diff --git a/graphics/nvn/gfx/nvn/rb_vi_vsync.h b/graphics/nvn/gfx/nvn/rb_vi_vsync.h
new file mode 100644
index 0000000..a162ffe
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_vi_vsync.h
@@ -0,0 +1,20 @@
+// RewindBox (patch 0341): one vsync clock. Pure C.
+//   nn::vi's vsync event (nvn2_codec.c vi_vsync_thread) was signalled by a clock of its own, 1e9 / 60 = 16,666,666 ns a tick, while the display link that paces the
+//   acquire and the present runs on the panel's refresh (16.668 ms measured in the IPA 827 logs): the two drift apart by about 1.5 microseconds a tick, so a game frame
+//   started on the vi event starts at a slowly moving phase of the display's tick and, every so often, just after it. Out of races and at thermal state 0, 4 to 10 % of
+//   frames that were on time were still shown for two ticks (IPA 827), a cost of 4.3 to 6.3 % of the time (52 to 57 fps instead of 60); the drift is one of the two suspects
+//   (the other, the acquire sync, is patch 0333). The event now comes from the display link's own ticks: a tick at least RB_VI_MIN_NS after the last vsync is the next one
+//   (every tick at 60 Hz, every second one at 120 Hz, whatever rate the system picks within the link's range). The 60 Hz clock stays the fallback when the link does not
+//   run, is at 30 or 20 Hz or stops (a second's rest before it is tried again). S2A_RB_VI_VSYNC_LINK=0: the clock alone, as before.
+#pragma once
+#include <stdint.h>
+
+enum { RB_VI_MIN_NS = 12500000, RB_VI_LINK_REST = 60 };   // three quarters of a 60 Hz period; 60 Hz ticks of the fallback clock before the link is tried again
+static inline int rb_vi_link_asked_off(const char *value) { return value && value[0] == '0' && !value[1]; }
+// A display-link tick at now_ns: 1 = it is the next 60 Hz vsync (*last, the last vsync's time, updated; 0 = none yet).
+static inline int rb_vi_tick_vsync(uint64_t now_ns, uint64_t *last) {
+    if (*last && now_ns >= *last && now_ns - *last < RB_VI_MIN_NS) return 0;
+    *last = now_ns; return 1;
+}
+// The vsync thread's rest after a wait on the link (tried) that gave no vsync: RB_VI_LINK_REST ticks of the clock; none after one that gave one, or when not tried.
+static inline unsigned rb_vi_link_rest(int tried, int link_ok) { return tried && !link_ok ? RB_VI_LINK_REST : 0; }
