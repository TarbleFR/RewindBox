diff --git a/graphics/nvn/gfx/nvn/rb_pso_lifetime.inc b/graphics/nvn/gfx/nvn/rb_pso_lifetime.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_pso_lifetime.inc
@@ -0,0 +1,50 @@
+// Guest render, mesh and compute pipeline objects. An associated sentinel
+// follows every other strong owner, including Metal and deferred GPU releases.
+static char rb_pso_lifetime_key;
+static os_unfair_lock rb_pso_counter_lock = OS_UNFAIR_LOCK_INIT;
+static uint64_t rb_pso_live[3], rb_pso_live_bytes;
+enum { RB_RENDER, RB_COMPUTE, RB_MESH };
+
+@interface RBPSOLifetime : NSObject {
+@public
+    unsigned kind;
+    size_t bytes;
+    NSString *identity;
+    BOOL archiveHit;
+    // Submit-thread fields after publication.
+    uint64_t touched;
+    BOOL recorded;
+}
+@end
+@implementation RBPSOLifetime
+- (void)dealloc {
+    os_unfair_lock_lock(&rb_pso_counter_lock);
+    rb_pso_live[kind]--;
+    rb_pso_live_bytes -= bytes;
+    os_unfair_lock_unlock(&rb_pso_counter_lock);
+}
+@end
+
+// Called by the builder before publication, or by the sole submit-thread
+// owner on the unarchived fallback path. Never retains the pipeline.
+static void rb_pso_track(id ps, unsigned kind, NSString *key, BOOL hit) {
+    if (!rb_pso_cap_on() || !ps || objc_getAssociatedObject(ps,&rb_pso_lifetime_key)) return;
+    RBPSOLifetime *life = [RBPSOLifetime new];
+    life->kind = kind; life->identity = key; life->archiveHit = hit;
+    life->touched = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    life->bytes = rb_heap_size((__bridge void *)ps);
+    os_unfair_lock_lock(&rb_pso_counter_lock);
+    rb_pso_live[kind]++;
+    rb_pso_live_bytes += life->bytes;
+    os_unfair_lock_unlock(&rb_pso_counter_lock);
+    objc_setAssociatedObject(ps,&rb_pso_lifetime_key,life,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+int nvn_rb_pso_snapshot(uint64_t out[4]) {
+    if (!rb_pso_cap_on()) return -1;
+    os_unfair_lock_lock(&rb_pso_counter_lock);
+    memcpy(out, rb_pso_live, sizeof rb_pso_live);
+    out[3] = rb_pso_live_bytes;
+    os_unfair_lock_unlock(&rb_pso_counter_lock);
+    return 0;
+}
