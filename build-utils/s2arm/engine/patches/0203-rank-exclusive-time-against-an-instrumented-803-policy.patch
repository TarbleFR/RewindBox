+static inline int rb_lf_reference(void) {
+    static _Atomic int cache;
+    int value=atomic_load_explicit(&cache,memory_order_relaxed);
+    if (!value) {
+        const char *ref=getenv("S2A_RB_LONGFRAME_REFERENCE");
+        value=ref && !strcmp(ref,"1") && rb_808_on() ? 1 : -1;
+        atomic_store_explicit(&cache,value,memory_order_relaxed);
+    }
+    return value>0;
+}
