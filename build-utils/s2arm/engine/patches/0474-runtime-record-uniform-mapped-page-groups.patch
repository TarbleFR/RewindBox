 static void zero_sub(uint64_t p, uint64_t we) {
     memset(p < we ? (uint8_t *)p : s2a_far_g2h(p), 0, 0x1000);
 }
+
+// Record the portions of the request that were newly mapped. The caller has
+// already established the backing and cleared any deferred whole-page zeros.
+static void phys_mark_new(uint64_t a, uint64_t size, uint64_t we) {
+    static int bulk = -1;
+    if (bulk < 0) {
+        const char *e = getenv("S2A_RB_PHYS_MARK_BULK");
+        bulk = !(e && !strcmp(e, "0"));
+    }
+    uint64_t run = 0;
+    uint8_t was = 0;
+    uint64_t end = a + size;
+    const uint8_t full = (1u << (HPG >> 12)) - 1u;
+    for (uint64_t p = a; p < end; p += 0x1000) {
+        uint8_t *m = amask_at(p);
+        uint64_t offset = p & (HPG - 1);
+        if (p == a || !offset) {
+            was = *m;
+            if (!offset && end - p >= HPG && bulk) {
+                if (!was && g_phys + HPG <= g_mem_peak) {
+                    // Empty groups are already zero. Use the subpage path
+                    // when peak accounting could run inside the group.
+                    *m = full;
+                    g_phys += HPG;
+                    if (!run) run = p;
+                    p += HPG - 0x1000;
+                    continue;
+                }
+                if (was == full) {
+                    if (run) {
+                        perm_set(run, p, -1);
+                        run = 0;
+                    }
+                    p += HPG - 0x1000;
+                    continue;
+                }
+            }
+        }
+        uint8_t bit = (uint8_t)(1u << (offset >> 12));
+        if (!(*m & bit)) {
+            if (was) zero_sub(p, we);
+            *m |= bit;
+            g_phys += 0x1000;
+            if (g_phys > g_mem_peak) mem_peak_note();
+            if (!run) run = p;
+        } else if (run) {
+            perm_set(run, p, -1);
+            run = 0;
+        }
+    }
+    if (run) perm_set(run, end, -1);
+}
