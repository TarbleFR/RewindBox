     *bytes = ri.ri_diskio_byteswritten; return 0;
 }
+// RewindBox (patch 0036): the [写盘] line's counters from the same call: bytes written and read (ri_diskio_*), page-ins (ri_pageins, a count) and logical writes
+//   (ri_logical_writes, bytes), all since the process started. IPA 746 wrote 40.7 GB in about 6.5 minutes with the guest in one file: these say whether the kernel also reads
+//   the guest's pages back in. The fields of nxnative's [mem] guest file line (dm/host/hle_svc.c:190-195 at 0c078130). 0 = ok
+int s2a_disk_io(uint64_t *written, uint64_t *read, uint64_t *pageins, uint64_t *logical) {
+    struct rusage_info_v6 ri; if (proc_pid_rusage(getpid(), RUSAGE_INFO_V6, (rusage_info_t *)&ri) != 0) return -1;
+    *written = ri.ri_diskio_byteswritten; *read = ri.ri_diskio_bytesread; *pageins = ri.ri_pageins; *logical = ri.ri_logical_writes; return 0;
+}
