+//   segments until the next one would take it past the chunk size (a segment larger than that has a file to itself), and once GX_MAX are open the last one goes on growing
+#define GX_MAX 64
+static int g_gx_fd[GX_MAX]; static _Atomic int g_gx_n; static uint64_t g_gx_len;   // g_gx_len: the last extra file's size; all under g_gextra_mu (g_gx_n stored with release)
