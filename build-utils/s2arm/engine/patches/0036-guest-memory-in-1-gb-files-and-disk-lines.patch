+// Window offset → the file holding it, the offset in that file (*in) and the bytes from there to that file's end (*room). off < g_gf_span, files on
+static int gf_at(uint64_t off, uint64_t *in, uint64_t *room) {
+    int n = atomic_load_explicit(&g_gf_n, memory_order_acquire); if (n <= 0) { *in = *room = 0; return -1; }
+    uint64_t k = off / g_gf_chunk; if (k >= (uint64_t)n) k = (uint64_t)n - 1;
+    uint64_t fsz = (int)k == n - 1 ? g_gf_span - k * g_gf_chunk : g_gf_chunk;
+    *in = off - k * g_gf_chunk; *room = fsz - *in; return g_gf_fd[k];
+}
+// The file and offset behind window address a: the descriptor of the window file holding it (-1 = a is not in the file-backed window), *off = a's offset in that file,
+//   *room = the bytes from a to that file's end (a mapping of [a, a + n) takes one file when n <= *room)
+int s2a_guest_file_at(uint64_t a, uint64_t *off, uint64_t *room) {
+    if (g_gfd < 0 || a < g_base || a >= g_base + g_size) return -1;
+    uint64_t in, r; int fd = gf_at(a - g_base, &in, &r);
+    if (off) *off = in;
+    if (room) *room = r;
+    return fd;
+}
+// What the guest's files hold on disk (st_blocks * 512, window and extra files): *files = how many were asked, *bad = how many fstat refused (left out of the sum)
+uint64_t s2a_guest_file_alloc(int *files, int *bad) {
+    uint64_t sum = 0; int nf = 0, nb = 0; struct stat st;
+    int n = atomic_load_explicit(&g_gf_n, memory_order_acquire), nx = n > 1 ? atomic_load_explicit(&g_gx_n, memory_order_acquire) : 0;
+    for (int i = 0; i < n + nx; i++) { int fd = i < n ? g_gf_fd[i] : g_gx_fd[i - n]; nf++; if (fstat(fd, &st)) nb++; else sum += (uint64_t)st.st_blocks * 512ull; }
+    if (files) *files = nf;
+    if (bad) *bad = nb;
+    return sum;
+}
+// Each window file's size for a window of span bytes from S2A_GUEST_FILE_CHUNK_MB's value e (unset or empty: 1024): 0 = one file; at least GF_MIN_CHUNK, raised in whole MB so
+//   that at most GF_MAX files make the window; not under span = one file (the result is then span). *bad = 1 when e is not a whole number of MB (the default is taken)
+uint64_t s2a_guest_file_chunk(const char *e, uint64_t span, int *bad) {
+    uint64_t mb = 1024; *bad = 0;
+    if (e && *e) { char *end; errno = 0; unsigned long long v = strtoull(e, &end, 10); if (*end || errno || *e == '-') *bad = 1; else mb = v; }
+    if (!mb || !span || mb >= span >> 20) return span;
+    uint64_t c = mb << 20; if (c < GF_MIN_CHUNK) c = GF_MIN_CHUNK;
+    if ((span + c - 1) / c > GF_MAX) c = ((span + GF_MAX - 1) / GF_MAX + (1ull << 20) - 1) & ~((1ull << 20) - 1);
+    return c >= span ? span : c;
+}
