+//   six, with both frames' size and draw count, and whether the frame after agrees with the frame before there), or the words that differ (the first ten, as the three
+//   frames read them). A pass is told by its place in the frame, so a frame replayed in other pieces can shift the places: the line gives the three pass counts for that.
+//   Cost: one more hash a draw, 2,048 stores a frame. Not measured on a device
+enum { FPD_FRAMES = 16, FPD_PASSES = 256 };
+typedef struct { uint64_t hash; uint32_t draws; uint16_t w, h, fmt, pad; } fpd_pass;
+typedef struct { _Atomic uint64_t frame; uint32_t np, over; fpd_pass p[FPD_PASSES]; _Atomic uint32_t word[FSIG_ADDR]; } fpd_t;   // frame: its number + 1 (0 = empty); over: passes past FPD_PASSES
+static fpd_t g_fpd[FPD_FRAMES];
+static fpd_t *fpd_at(uint64_t f) { fpd_t *d = &g_fpd[f % FPD_FRAMES]; return atomic_load_explicit(&d->frame, memory_order_relaxed) == f + 1 ? d : NULL; }
+static void fpd_open(uint64_t f) {   // the replaying thread, with the frame's record (fsig_cur)
+    fpd_t *d = &g_fpd[f % FPD_FRAMES]; atomic_store(&d->frame, 0); d->np = d->over = 0;
+    for (int i = 0; i < FSIG_ADDR; i++) atomic_store_explicit(&d->word[i], 0, memory_order_relaxed);
+    atomic_store(&d->frame, f + 1);
+}
+static void fpd_passes(fpd_t *a, fpd_t *b, fpd_t *c, char *out, size_t n) {   // b is the odd frame, a the frame before it, c the frame after
+    uint32_t np = MIN(a->np, MIN(b->np, c->np)), nd = 0; size_t o = 0;
+    o += (size_t)snprintf(out, n, "passes %u / %u / %u%s", a->np, b->np, c->np, a->over || b->over || c->over ? " (more than the record holds)" : "");
+    for (uint32_t i = 0; i < np; i++) {
+        const fpd_pass *x = &a->p[i], *y = &b->p[i], *z = &c->p[i];
+        if (x->hash == y->hash && x->draws == y->draws) continue;   // by its draws alone: a game with a dynamic resolution draws the same list at another size from one frame to the next
+        if (++nd <= 6 && o < n) o += (size_t)snprintf(out + o, n - o, "; pass %u: %ux%u format %u with %u draws, in the odd frame %ux%u format %u with %u draws%s", i, x->w, x->h, x->fmt, x->draws,
+                                                      y->w, y->h, y->fmt, y->draws, x->hash == z->hash && x->draws == z->draws ? "" : " (the frame after differs from the frame before there too)");
+    }
+    if (o < n) snprintf(out + o, n - o, "; %u of the first %u passes differ from the frame before", nd, np);
+}
+static void fpd_words(fpd_t *a, fpd_t *b, fpd_t *c, uint32_t nw, char *out, size_t n) {
+    uint32_t nd = 0; size_t o = 0; if (nw > FSIG_ADDR) nw = FSIG_ADDR; if (n) out[0] = 0;
+    for (uint32_t i = 0; i < nw; i++) {
+        uint32_t x = atomic_load_explicit(&a->word[i], memory_order_relaxed), y = atomic_load_explicit(&b->word[i], memory_order_relaxed), z = atomic_load_explicit(&c->word[i], memory_order_relaxed);
+        if (x == y) continue;
+        if (++nd <= 10 && o < n) o += (size_t)snprintf(out + o, n - o, "%sword %u: %u / %u / %u", nd > 1 ? ", " : "", i, x, y, z);
+    }
+    if (o < n) snprintf(out + o, n - o, "%s%u of %u words differ from the frame before", nd ? "; " : "", nd, nw);
+}
