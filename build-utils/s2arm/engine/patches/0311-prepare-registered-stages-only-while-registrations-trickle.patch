+static inline int rb_reg_translation_name(const char *name, uint64_t *identity) {
+    static const char suffix[] = "_b.json";
+    if (!name || strlen(name) != 16 + sizeof suffix - 1 || strcmp(name + 16, suffix)) return 0;
