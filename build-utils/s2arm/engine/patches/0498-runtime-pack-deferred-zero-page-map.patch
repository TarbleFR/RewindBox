+// Clearing a replaced alias drops the mark without writing into the shared source.
+static void punch_clear_locked(uint64_t lo, uint64_t hi, int zero) {
+    if (!g_punch_pending_n || !L.win_size) return;
+    uint64_t we = L.win_base + L.win_size;
+    if (lo < L.win_base) lo = L.win_base;
+    if (hi > we) hi = we;
+    if (lo >= hi) return;
+    uint64_t first = (lo - L.win_base) / HPG, last = (hi - 1 - L.win_base) / HPG;
+    for (uint64_t w = first / 64; w <= last / 64; w++) {
+        uint64_t marked = g_punch_pend[w] & punch_mask(w, first, last);
+        if (!marked) continue;
+        g_punch_pend[w] &= ~marked;
+        unsigned count = __builtin_popcountll(marked);
+        g_punch_pending_n -= count;
+        if (!zero) {
+            g_punch_forget_n += count;
+            continue;
+        }
+        g_punch_inline_n += count;
+        while (marked) {
+            uint64_t page = w * 64 + __builtin_ctzll(marked);
+            memset((void *)(L.win_base + page * HPG), 0, HPG);
+            marked &= marked - 1;
+        }
+    }
+}
+static void punch_zero_locked(uint64_t lo, uint64_t hi) { punch_clear_locked(lo, hi, 1); }
+static void punch_forget_locked(uint64_t lo, uint64_t hi) { punch_clear_locked(lo, hi, 0); }
