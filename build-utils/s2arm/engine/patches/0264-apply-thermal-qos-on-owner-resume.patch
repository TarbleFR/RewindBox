diff --git a/runtime/tests/rb_guest_heat_owner.inc b/runtime/tests/rb_guest_heat_owner.inc
new file mode 100644
index 0000000..78a32c2
--- /dev/null
+++ b/runtime/tests/rb_guest_heat_owner.inc
@@ -0,0 +1,92 @@
+// Included by t_thread.c. The guest binding, wait table, return and hot clock
+// gate are the runtime's. Only the notification producer is driven by the test.
+// t_thread links the scheduler without the graphics timing observer or a
+// file-backed guest window. The production absence sentinels are both -1.
+int rb_lf_switch(int phase) { (void)phase; return -1; }
+int s2a_guest_fd(void) { return -1; }
+static int rb_test_hosted;
+int s2a_rb_guest_on(void) { return rb_test_hosted; }
+extern void s2a_guest_heat_publish(int);
+extern void s2a_guest_heat_stats_report(const char *,uint64_t);
+extern void s2a_guest_frame_qos_protect(void);
+extern void s2a_test_guest_heat_requests(unsigned [2]);
+extern void s2a_tick_wait(uint64_t);
+static _Atomic uint32_t rb_wait_word;
+static _Atomic int rb_phase, rb_ready, rb_completed;
+static qos_class_t rb_initial[3], rb_at_fair[3], rb_at_nominal[3];
+static uint64_t rb_wait_rc[3];
+
+static qos_class_t rb_test_current(void) {
+    qos_class_t got=QOS_CLASS_UNSPECIFIED;
+    int relative=0;
+    return pthread_get_qos_class_np(pthread_self(),&got,&relative) ? QOS_CLASS_UNSPECIFIED : got;
+}
+
+static void rb_owner(uint64_t role) {
+    rb_initial[role]=rb_test_current();
+    if (role==2) s2a_guest_frame_qos_protect();
+    uint64_t wait[31]={(uint64_t)&rb_wait_word,2,0,(uint64_t)-1};
+    svc_thread(0x34,wait);
+    rb_wait_rc[role]=wait[0];
+    // No intervening SVC or clock gate: the change must have taken effect on
+    // the return from the wait in which the producer switched from Nominal.
+    rb_at_fair[role]=rb_test_current();
+    for (int i=0;i<64;i++) s2a_tick_wait(0);
+    atomic_fetch_add(&rb_ready,1);
+    while (!atomic_load(&rb_phase)) sched_yield();
+    // No SVC between Fair and Nominal: this worker uses only the clock gate.
+    for (int i=0;i<64;i++) s2a_tick_wait(0);
+    rb_at_nominal[role]=rb_test_current();
+    atomic_fetch_add(&rb_completed,1);
+    uint64_t quit[31]={0};
+    svc_thread(0x0a,quit);
+}
+
+static int rb_owner_test(void) {
+    const char *setting=getenv("S2A_RB_GUEST_QOS_TRANSITIONS");
+    int enabled=!setting || !strcmp(setting,"1");
+    rb_test_hosted=1;
+    setenv("S2A_RB_DIRECT_GAME_ID","0400C3F00006E000",1);
+    setenv("S2A_RB_GUEST_QOS_THERMAL","1",1);
+    setenv("S2A_RB_GUEST_QOS_STATS","1",1);
+    setenv("S2A_CORES","0",1);
+    unsetenv("S2A_GUEST_QOS");
+    setenv("S2A_GAME_MAIN_QOS","interactive",1);
+    setenv("S2A_TICK_WAIT","0",1);
+    g_case="RB guest thermal owner";
+    signal(SIGALRM,timeout_kill); alarm(20);
+    pthread_key_create(&g_key18,NULL); pthread_key_create(&g_keytls,NULL);
+    pthread_key_create(&g_keytlr,NULL); pthread_key_create(&g_keygate,NULL);
+    s2a_thread_main_init(); // nx-81, then nx-82, nx-83, frame owner nx-84
+    s2a_guest_heat_publish(0);
+    // Initialize the clock-gate option before three simultaneous readers.
+    s2a_tick_wait(0);
+    for (unsigned i=0;i<3;i++) spawn(rb_owner,i,NULL);
+    while (s2a_test_waiters(3,(uint64_t)&rb_wait_word)!=3) usleep(1000);
+    s2a_guest_heat_publish(1);
+    uint64_t wake[31]={(uint64_t)&rb_wait_word,0,0,(uint64_t)-1};
+    svc_thread(0x35,wake);
+    CHECK(wake[0]==0,"signal registered secondary workers");
+    while (atomic_load(&rb_ready)!=3) usleep(1000);
+    unsigned requests[2];
+    s2a_test_guest_heat_requests(requests);
+    CHECK(requests[0]==(unsigned)enabled && !requests[1],"Fair attempted %u reductions, %u restores",requests[0],requests[1]);
+    CHECK(rb_test_current()==QOS_CLASS_USER_INTERACTIVE,"main retains interactive QoS at Fair");
+    for (unsigned i=0;i<3;i++) {
+        CHECK(!rb_wait_rc[i] && rb_initial[i]==QOS_CLASS_USER_INTERACTIVE,"nx-%u baseline and wait result",82+i);
+        CHECK(rb_at_fair[i]==(enabled && i==0 ? QOS_CLASS_USER_INITIATED : QOS_CLASS_USER_INTERACTIVE),
+              "nx-%u actual requested pthread QoS after Fair %#x",82+i,(unsigned)rb_at_fair[i]);
+    }
+    s2a_guest_heat_stats_report("fixture-fair",1);
+    s2a_guest_heat_publish(2);
+    s2a_guest_heat_publish(0);
+    atomic_store(&rb_phase,1);
+    while (atomic_load(&rb_completed)!=3) usleep(1000);
+    s2a_test_guest_heat_requests(requests);
+    CHECK(requests[0]==(unsigned)enabled && requests[1]==(unsigned)enabled,
+          "idempotent owner transitions across 128 polls: down=%u up=%u",requests[0],requests[1]);
+    for (unsigned i=0;i<3;i++) CHECK(rb_at_nominal[i]==QOS_CLASS_USER_INTERACTIVE,"nx-%u after Nominal",82+i);
+    s2a_guest_heat_stats_report("fixture-nominal",2);
+    printf("%s guest QoS pthread A/B %d; reduced_requests=%u restore_requests=%u\n",bad?"FAIL":"PASS",enabled,requests[0],requests[1]);
+    return !!bad;
+}
