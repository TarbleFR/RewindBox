         /// S2Arm: start the device anyway (prime floor could not be reached, e.g. a quiet game): latch primed so the
         /// caller's start gate opens. Only raises; never lowers.
         /// </summary>
+        // Runs on the pacing worker. The target bounds all queued synthetic PCM.
+        // Return its slot through the regular pump but never credit it as guest audio.
+        protected int FillGuardReserve(int targetBytes)
+        {
+            lock (_lock)
+            {
+                if (_suspended || _primed == 0 || _freeCount <= 1 || Samples.Length != 0 ||
+                    _inFlightBytes > targetBytes / 2) return 0;
+                int bytes = (int)Math.Min(_slotBytes, targetBytes - _inFlightBytes) / _bytesPerFrame * _bytesPerFrame;
+                if (bytes <= 0) return 0;
+                int slot = _free[--_freeCount];
+                SlotData(slot)[..bytes].Clear();
+                _filled[slot] = bytes;
+                _sampleBytes[slot] = 0;
+                Interlocked.Add(ref _inFlightBytes, bytes);
+                GuardSubmit(slot, bytes);
+                return bytes;
+            }
+        }
+
+        protected virtual void GuardSubmit(int slot, int bytes) => SubmitLocked(slot, bytes);
+        protected void SubmitGuardSlot(int slot, int bytes) => SubmitLocked(slot, bytes);
+
         public void ForcePrimed()
         {
             Volatile.Write(ref _primed, 1);
