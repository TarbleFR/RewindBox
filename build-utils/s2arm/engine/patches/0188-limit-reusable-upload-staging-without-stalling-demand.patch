 // The upload owner alone changes the slot array. A completion clears busy
 // after its buffers retire. The upcoming slot is left to up_alloc, which
 // can judge its actual request. Limit maintenance to one idle slot per check.
+// Only the submit/upload owner visits slot pointers; a GPU completion only
+// clears busy. The open batch and all busy slots keep their original ownership.
+static void rb_gov_trim_uploads(void) {
+    if (!rb_gov_on() || !on_sub_thread()) return;
+    static unsigned observed;
+    static uint64_t last = UINT64_MAX;
+    unsigned plan = atomic_load(&rb_gov_plan);
+    uint64_t frame = atomic_load(&g_cur_frame);
+    if (observed == plan && frame == last) return;
+    uint64_t cap = rb_gov_share(plan,RB_GOV_UPLOAD), held = 0, freed = 0;
+    for (unsigned i = 0; i < (unsigned)rb_up_n(); ++i) held += g_up_slot_blk[i].length;
+    for (unsigned i = 0; held > cap && i < (unsigned)rb_up_n(); ++i) {
+        if ((g_up_cb && i == g_up_cur_slot) || atomic_load(&g_up_alloc_busy[i])) continue;
+        id<MTLBuffer> buf = g_up_slot_blk[i];
+        if (!buf) continue;
+        held -= buf.length; freed += buf.length;
+        g_up_slot_blk[i] = nil;
+        res_remove(buf);
+    }
+    if (observed != plan) MLOG("[RB-MEM-GOV] owner=upload cap_bytes=%llu slot_bytes=%llu retired_bytes=%llu",
+        (unsigned long long)cap,(unsigned long long)held,(unsigned long long)freed);
+    observed = plan; last = frame;
+}
