+        s->wait = RB_DRS_FLOOR_RETRY;
+    } else {
+        s->wait = !s->wait ? RB_DRS_FLOOR_RETRY : s->wait * 2 < RB_DRS_FLOOR_RETRY_MAX ? s->wait * 2 : RB_DRS_FLOOR_RETRY_MAX;
