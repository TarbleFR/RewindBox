+// the floor from a menu whose scene never shrinks ("floor frame=1022
+// scene_px=2073600 floor_px=2073600 rests=1 resumes=0") and never pushed a
+// race again. A push that changes nothing is tried again after twice the wait,
+// up to RB_DRS_FLOOR_RETRY_MAX frames.
+enum { RB_DRS_FLOOR_STALL = 24, RB_DRS_FLOOR_RETRY = 600, RB_DRS_FLOOR_RETRY_MAX = 4800 };
