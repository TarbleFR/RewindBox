+        if (frame < s->retry_at) return 0;
+        if (pixels * 10 > s->stuck * 11) s->wait = 0;   // larger than where the last push ended: the first wait again
         s->resting = 0; s->run_min = 0; s->stall = 0; ++s->resumes;
     }
     if (s->counted == frame + 1) return 1;
     s->counted = frame + 1;
-    if (!s->run_min || pixels < s->run_min) { s->run_min = pixels; s->stall = 0; return 1; }
+    if (!s->run_min) { s->run_from = s->run_min = pixels; s->stall = 0; return 1; }
