Subject: [PATCH] 0377 Preserve syscall return and errno semantics in wake
 diagnostics

---
 runtime/include/rb_wake.h | 23 +++++++++++++++++------
 runtime/src/thread.c      | 32 ++++++++++++++++----------------
 2 files changed, 33 insertions(+), 22 deletions(-)

diff --git a/runtime/include/rb_wake.h b/runtime/include/rb_wake.h
index 0ec68b5..7c655db 100644
--- a/runtime/include/rb_wake.h
+++ b/runtime/include/rb_wake.h
@@ -22,12 +22,23 @@ static inline int64_t s2a_rb_wake_absolute(const struct timespec *t) {
 }
 // Counts API returns, not kernel interrupts. Signals count attempts, never an
 // inferred number of awakened threads. ns=-2 denotes a signal call.
-#define RB_WAKE_CALL(kind_, ns_, call_) __extension__ ({ \
-    static s2a_rb_wake_site rb_site_ = { __FILE__, kind_, __LINE__, 0 }; \
-    s2a_rb_wake_token rb_tok_ = {0}; \
-    if (__builtin_expect(atomic_load_explicit(&s2a_rb_wake_enabled,memory_order_relaxed),0)) \
-        rb_tok_ = s2a_rb_wake_begin(&rb_site_, (ns_)); \
-    int rb_result_ = (call_); if (rb_tok_.slot) s2a_rb_wake_end(rb_tok_, rb_result_); rb_result_; })
+// Condition variables return an errno value. Syscalls return a count/status and
+// use errno only for -1. Preserve both native return and errno in either case.
+#define RB_WAKE_IMPL(kind_, ns_, call_, status_) __extension__ ({ \
+    int rb_result_; \
+    if (__builtin_expect(!atomic_load_explicit(&s2a_rb_wake_enabled,memory_order_relaxed),1)) { \
+        rb_result_=(call_); \
+    } else { \
+        static s2a_rb_wake_site rb_site_ = { __FILE__, kind_, __LINE__, 0 }; \
+        int rb_before_errno_=errno; \
+        s2a_rb_wake_token rb_tok_=s2a_rb_wake_begin(&rb_site_, (ns_)); \
+        errno=rb_before_errno_; rb_result_=(call_); int rb_after_errno_=errno; \
+        if (rb_tok_.slot) s2a_rb_wake_end(rb_tok_, (status_)); \
+        errno=rb_after_errno_; \
+    } \
+    rb_result_; })
+#define RB_WAKE_CALL(kind_, ns_, call_) RB_WAKE_IMPL(kind_, ns_, call_, rb_result_)
+#define RB_WAKE_SYSCALL(kind_, ns_, call_) RB_WAKE_IMPL(kind_, ns_, call_, rb_result_<0 ? rb_after_errno_ : 0)
 
 #define RB_WAKE_SIGNAL_CALL(kind_, call_) __extension__ ({ \
     static s2a_rb_wake_site rb_site_ = { __FILE__, kind_, __LINE__, 0 }; \
