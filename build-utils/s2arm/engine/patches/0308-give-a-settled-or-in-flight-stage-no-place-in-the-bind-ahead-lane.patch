 void nvn_be_registered_stages(const prog_t *program) {
diff --git a/graphics/nvn/gfx/nvn/rb_registration_plan.h b/graphics/nvn/gfx/nvn/rb_registration_plan.h
new file mode 100644
index 0000000..a96982f
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_registration_plan.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// What the bind-ahead lane does with one registered stage (rb_registration.inc).
+// A game registers the same stage with many programs, and again at every load.
+// The lane used to queue each of them: an iPhone session built 460 variants out
+// of 1,024 queued registrations, and with 128 places 4,096 more were refused.
+// A stage the lane has settled, or holds in flight, takes no place.
+enum { RB_REG_ADMIT, RB_REG_KNOWN, RB_REG_IN_FLIGHT, RB_REG_FULL };
+static inline int rb_reg_verdict(int known, int in_flight, unsigned waiting, unsigned depth,
+                                 size_t bytes, size_t held, size_t limit) {
+    if (known) return RB_REG_KNOWN;
+    if (in_flight) return RB_REG_IN_FLIGHT;
+    return waiting < depth && held <= limit && bytes <= limit - held ? RB_REG_ADMIT : RB_REG_FULL;
+}
+
+// The stages the lane has settled this session: the 8-byte stage key with the
+// depth mode folded in. Open addressing, never emptied one by one. Past three
+// quarters full it takes no more, and a later stage is queued as before.
+enum { RB_REG_KNOWN_SLOTS = 1 << 15 };
+typedef struct { uint64_t slot[RB_REG_KNOWN_SLOTS]; unsigned count; } rb_reg_known;
+static inline uint64_t rb_reg_identity(const uint8_t key[8], int depth) {
+    uint64_t v;
+    memcpy(&v, key, sizeof v);
+    if (depth) v ^= UINT64_C(0x9e3779b97f4a7c15);
+    return v ? v : 1;
+}
+static inline unsigned rb_reg_slot(uint64_t identity) {
+    return (unsigned)((identity * UINT64_C(0xff51afd7ed558ccd)) >> 49) & (RB_REG_KNOWN_SLOTS - 1);
+}
+static inline int rb_reg_known_has(const rb_reg_known *set, uint64_t identity) {
+    for (unsigned i = rb_reg_slot(identity), n = 0; n < RB_REG_KNOWN_SLOTS; i = (i + 1) & (RB_REG_KNOWN_SLOTS - 1), ++n) {
+        if (set->slot[i] == identity) return 1;
+        if (!set->slot[i]) return 0;
+    }
+    return 0;
+}
+static inline int rb_reg_known_add(rb_reg_known *set, uint64_t identity) {
+    if (set->count >= RB_REG_KNOWN_SLOTS / 4 * 3) return 0;
+    for (unsigned i = rb_reg_slot(identity);; i = (i + 1) & (RB_REG_KNOWN_SLOTS - 1)) {
+        if (set->slot[i] == identity) return 1;
+        if (!set->slot[i]) { set->slot[i] = identity; ++set->count; return 1; }
+    }
+}
+
+// Two lanes while the device is at Fair or cooler, one above: the stage is
+// built at its first draw otherwise, on the submit thread. The second lane
+// takes a registration only when the first has more waiting.
+static inline unsigned rb_reg_lane(int thermal, unsigned first, unsigned second) {
+    return thermal <= 1 && first > second ? 1u : 0u;
+}
