diff --git a/graphics/nvn/tests/t_rb_registration_plan.c b/graphics/nvn/tests/t_rb_registration_plan.c
new file mode 100644
index 0000000..7447f0a
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_registration_plan.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_registration_plan.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+int main(void) {
+    const size_t limit = 8u << 20;
+    // A settled or in-flight stage takes no place, even with the lane full.
+    assert(rb_reg_verdict(1, 0, 128, 128, 4096, limit, limit) == RB_REG_KNOWN);
+    assert(rb_reg_verdict(1, 1, 0, 128, 4096, 0, limit) == RB_REG_KNOWN);
+    assert(rb_reg_verdict(0, 1, 128, 128, 4096, limit, limit) == RB_REG_IN_FLIGHT);
+    assert(rb_reg_verdict(0, 0, 0, 128, 4096, 0, limit) == RB_REG_ADMIT);
+    assert(rb_reg_verdict(0, 0, 127, 128, 4096, 0, limit) == RB_REG_ADMIT);
+    assert(rb_reg_verdict(0, 0, 128, 128, 4096, 0, limit) == RB_REG_FULL);
+    assert(rb_reg_verdict(0, 0, 3, 128, 4096, limit - 4096, limit) == RB_REG_ADMIT);
+    assert(rb_reg_verdict(0, 0, 3, 128, 4097, limit - 4096, limit) == RB_REG_FULL);
+    assert(rb_reg_verdict(0, 0, 3, 128, 1, limit + 1, limit) == RB_REG_FULL);   // no wrap of the room left
+
+    // The depth mode is part of the identity, and no identity is the empty slot.
+    const uint8_t key[8] = {1, 2, 3, 4, 5, 6, 7, 8}, zero[8] = {0};
+    assert(rb_reg_identity(key, 0) != rb_reg_identity(key, 1));
+    assert(rb_reg_identity(zero, 0) == 1 && rb_reg_identity(zero, 1));
+
+    rb_reg_known *set = calloc(1, sizeof *set);
+    assert(set && !rb_reg_known_has(set, rb_reg_identity(key, 0)));
+    assert(rb_reg_known_add(set, rb_reg_identity(key, 0)) && set->count == 1);
+    assert(rb_reg_known_add(set, rb_reg_identity(key, 0)) && set->count == 1);
+    assert(rb_reg_known_has(set, rb_reg_identity(key, 0)) && !rb_reg_known_has(set, rb_reg_identity(key, 1)));
+    // 20,000 stages: every one found again, none invented, colliding slots included.
+    uint64_t v = 0x243f6a8885a308d3ull;
+    for (unsigned i = 0; i < 20000; ++i) {
+        v = v * 6364136223846793005ull + 1442695040888963407ull;
+        assert(rb_reg_known_add(set, v | 1));
+    }
+    v = 0x243f6a8885a308d3ull;
+    for (unsigned i = 0; i < 20000; ++i) {
+        v = v * 6364136223846793005ull + 1442695040888963407ull;
+        assert(rb_reg_known_has(set, v | 1) && !rb_reg_known_has(set, (v | 1) ^ 2));
+    }
+    // Past three quarters full it refuses, keeps what it holds and still ends its searches.
+    for (uint64_t extra = 2; set->count < RB_REG_KNOWN_SLOTS / 4 * 3; extra += 2) rb_reg_known_add(set, extra << 20);
+    assert(!rb_reg_known_add(set, UINT64_C(0x7777777777777777)) && !rb_reg_known_has(set, UINT64_C(0x7777777777777777)));
+    assert(rb_reg_known_has(set, rb_reg_identity(key, 0)));
+    free(set);
+
+    // The second lane only under Fair or cooler, and only when the first has more waiting.
+    assert(rb_reg_lane(0, 0, 0) == 0 && rb_reg_lane(1, 0, 0) == 0);
+    assert(rb_reg_lane(0, 1, 0) == 1 && rb_reg_lane(1, 5, 4) == 1 && rb_reg_lane(1, 4, 4) == 0);
+    assert(rb_reg_lane(2, 9, 0) == 0 && rb_reg_lane(3, 9, 0) == 0);
+    puts("PASS bind-ahead plan: settled and in-flight stages take no place, byte and count bounds, known set, lanes by thermal state");
+}
