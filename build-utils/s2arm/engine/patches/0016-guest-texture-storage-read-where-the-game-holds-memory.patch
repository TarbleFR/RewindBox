+// RewindBox (patch 0016): a texture's storage is read where the game holds readable memory, and only there.
+//   Mario Kart World, iPhone17,2, 13 Nov (IPA 734, the first run past the first frame): at frame 308 the first upload of a texture bound by a draw
+//   (encode_args_ -> tex_by_id -> tex_mtl -> pkg_upload) hashed its storage page by page and stopped the process with SIGBUS on host page 87 of its 89, at
+//   0x78e7afc000 in the game's alias region: pages 0-86 were readable, that one was not (the game maps and unmaps physical memory there, svc 0x2c x410 and
+//   0x2d x430 by then; an unmapped host page is PROT_NONE). The storage read is the layout's whole size from the texture's address, whatever memory the game
+//   holds behind it: a texture whose pool was finalized and its memory unmapped while its ID stays registered, or one whose computed size runs past its pool,
+//   is read into memory that is not there (S2Arm's own #819, an iPad after 20-40 minutes, the same function; its #934 for the pool-table walk).
+//   Now the read asks first (rb_span_readable: Mach's regions, no memory touched). All readable, the usual case: nothing changes. Otherwise the host reads
+//   a private copy in which what cannot be read is zeros (rb_span_copy, through Mach as the crash handler's own reads: an error, not a fault), says so in red
+//   with the texture and where its storage lies among the live pools (rb_pkg_note), and uploads from that copy on the CPU. The layout and its size are not
+//   changed. Far alias storage (s2a_far_g2h) has no host pages of its own and is read as before.
+//   Covered: the upload and the partial re-upload (pkg_upload_, pkg_upload_rects), the content checks of a new texture (mem_any_touched, tex_init_fill), the
+//   GPU-write ledger (gpw_mark, gpw_stale), the checks at each use (tex_mtl_: the hashes of written pages, rb_pkg_same) and ReadTexels. Not covered: the
+//   development diagnostics that read a storage whole (DM_NVN_DIRTYCHECK, DM_NVN_TEXINFO, DM_NVN_ZBLOCK), and a page the game unmaps between the question
+//   and the read of readable storage.
+static int rb_span_readable(uintptr_t a, uint64_t n) {
+    if (!n) return 1;
+    if (s2a_far_g2h((uint64_t)a) || s2a_far_g2h((uint64_t)a + n - 1)) return 1;
+    vm_address_t r = (vm_address_t)a, end = (vm_address_t)(a + n);
+    while (r < end) {
+        vm_address_t ra = r; vm_size_t rs = 0; vm_region_basic_info_data_64_t vi; mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t obj = MACH_PORT_NULL;
+        if (vm_region_64(mach_task_self(), &ra, &rs, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&vi, &cnt, &obj) != KERN_SUCCESS) return 0;   // nothing is mapped from r on
+        if (ra > r || !rs || !(vi.protection & VM_PROT_READ)) return 0;   // a hole before the next region, or a region that cannot be read
+        r = ra + rs;
+    }
+    return 1;
+}
+// dst = [a, a + n) as the host may read it, host page by host page: a page that cannot be read is zeros. Returns the bytes not read; *first = the offset of the first of them.
+//   Not tried in one piece first: its callers have just found that the range cannot all be read, and that try copied what can be read twice
+static uint64_t rb_span_copy(uint8_t *dst, uintptr_t a, uint64_t n, uint64_t *first) {
+    uintptr_t pg = (uintptr_t)getpagesize(); uint64_t bad = 0;
+    if (first) *first = 0;
+    for (uint64_t o = 0; o < n;) {
+        uint64_t k = MIN(n - o, (uint64_t)(pg - ((a + o) & (pg - 1))));   // up to the end of this host page
+        vm_size_t got = 0;
+        if (vm_read_overwrite(mach_task_self(), (vm_address_t)(a + o), (vm_size_t)k, (vm_address_t)(dst + o), &got) != KERN_SUCCESS || got != k) {
+            memset(dst + o, 0, k); if (!bad && first) *first = o; bad += k; }
+        o += k;
+    }
+    return bad;
+}
+// Where a texture's storage lies among the live memory pools, for the log (the host's own table, no guest object is read): 0 = whole in one pool; 1 = it runs
