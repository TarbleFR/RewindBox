+    if (c == 0) snprintf(o, cap, "inside the live memory pool %#llx+%#llx", (unsigned long long)plo, (unsigned long long)psz);
+    else if (c == 1) snprintf(o, cap, "running %llu bytes past the end of the memory pool %#llx+%#llx that holds its first byte", (unsigned long long)over, (unsigned long long)plo, (unsigned long long)psz);
