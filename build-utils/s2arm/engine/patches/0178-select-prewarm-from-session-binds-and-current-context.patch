diff --git a/graphics/nvn/gfx/nvn/rb_pso_recent.inc b/graphics/nvn/gfx/nvn/rb_pso_recent.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_pso_recent.inc
@@ -0,0 +1,101 @@
+// Two completed gameplay sessions and this launch's actual encoder binds.
+// The serial history queue owns disk state. Bind callbacks never wait for it.
+enum { RB_RECENT_KEYS = 8192 };
+static NSArray *rb_previous_binds; // history queue, last completed nonempty session
+static NSSet *rb_recent_union;
+static NSString *rb_recent_file;
+static NSMutableOrderedSet *rb_bound_this_session; // submit thread
+static BOOL rb_recent_dirty;
+static uint64_t rb_recent_checkpoint;
+static _Thread_local BOOL rb_warm_context;
+
+static NSString *rb_bind_path(void) {
+    const char *build = s2a_main_build_id ? s2a_main_build_id() : NULL;
+    if (!build || !*build || strlen(build)>64 || strspn(build,"0123456789abcdefABCDEF")!=strlen(build)) return nil;
+    return [pso_user_path() stringByAppendingFormat:@".binds-%s-%s-v1.plist", build, DMSH_CHAIN];
+}
+static void rb_read_binds(NSString *path) {
+    if ([path isEqual:rb_recent_file]) return;
+    rb_recent_file = path; rb_previous_binds = @[]; rb_recent_union = nil;
+    if (!path) return;
+    NSDictionary *attr = [NSFileManager.defaultManager attributesOfItemAtPath:path error:nil];
+    if ([attr[NSFileSize] unsignedLongLongValue] > 4u*1024*1024) return;
+    NSArray *sessions = [NSArray arrayWithContentsOfFile:path];
+    if (sessions.count != 2) return;
+    NSMutableSet *keys = [NSMutableSet set];
+    for (id rows in sessions) {
+        if (![rows isKindOfClass:NSArray.class] || [rows count] > RB_RECENT_KEYS) return;
+        for (id row in rows) {
+            if (![row isKindOfClass:NSString.class] || ![row length] || [row length]>128) return;
+            [keys addObject:row];
+        }
+    }
+    rb_previous_binds = sessions.lastObject; rb_recent_union = keys;
+}
+static NSString *rb_mesh_identity(const pso_skey *sk, NSString *task, uint32_t pad) {
+    return [NSString stringWithFormat:@"m%@/%@/%x",par_hash(sk,sizeof *sk),task.length ? task : @"-",pad];
+}
+static void rb_pso_bound(id ps) {
+    if (!on_sub_thread()) return;
+    RBPSOLifetime *life = objc_getAssociatedObject(ps,&rb_pso_lifetime_key);
+    if (!life) return;
+    life->touched = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (life->recorded || !life->identity) return;
+    life->recorded = YES;
+    if (!rb_bound_this_session) rb_bound_this_session = [NSMutableOrderedSet orderedSet];
+    if ([rb_bound_this_session containsObject:life->identity]) return;
+    if (rb_bound_this_session.count == RB_RECENT_KEYS) [rb_bound_this_session removeObjectAtIndex:0];
+    [rb_bound_this_session addObject:life->identity]; rb_recent_dirty = YES;
+}
+static void rb_flush_binds(BOOL final, uint64_t now) {
+    if (!rb_pso_cap_on()) return;
+    if (rb_recent_dirty && (final || now>=rb_recent_checkpoint)) {
+        NSString *path = rb_bind_path();
+        if (path) {
+            NSArray *rows = [rb_bound_this_session.array copy];
+            dispatch_async(rb_trace_io(), ^{ @autoreleasepool {
+                rb_read_binds(path);
+                if (![@[rb_previous_binds,rows] writeToFile:path atomically:YES])
+                    MLOG("[RB-PSO-CAP] history_write_failed=1");
+            } });
+        }
+        rb_recent_dirty = NO;
+        rb_recent_checkpoint = now+60ull*NSEC_PER_SEC;
+    }
+    if (final) {
+        dispatch_sync(rb_trace_io(), ^{ rb_recent_file=nil; rb_previous_binds=nil; rb_recent_union=nil; });
+        rb_bound_this_session=nil; rb_recent_checkpoint=0;
+    }
+}
+static NSSet *rb_warm_recent(NSSet **legacy) {
+    NSString *path = rb_bind_path();
+    RBPipelineTrace *run = rb_trace_session();
+    __block NSSet *binds, *old;
+    dispatch_sync(rb_trace_io(), ^{
+        rb_read_binds(path); binds=rb_recent_union;
+        if (run && !binds) {
+            const rb_pso_history *h=&run->priorLaunches;
+            NSMutableSet *keys=[NSMutableSet set];
+            for (size_t i=0;i<h->latest.count;i++) [keys addObject:@(h->latest.key[i])];
+            for (size_t i=0;i<h->prior.count;i++) [keys addObject:@(h->prior.key[i])];
+            old=keys;
+        }
+    });
+    *legacy=old; return binds;
+}
+static BOOL rb_recent_task(WarmTask *t, NSSet *keys, NSSet *legacy) {
+    if (t->kind==2) {
+        NSData *bytes=[t->key dataUsingEncoding:NSUTF8StringEncoding];
+        NSMutableData *key=[bytes mutableCopy];
+        if (t->fc) { unsigned char fc=(unsigned char)('0'+t->fc); [key appendBytes:&fc length:1]; }
+        return [keys containsObject:[@"c" stringByAppendingString:par_hash(key.bytes,key.length)]];
+    }
+    NSData *row=t->rs.firstObject;
+    if (row.length!=sizeof(pso_skey)) return NO;
+    if (t->kind==4) return [keys containsObject:rb_mesh_identity(row.bytes,t->tkey,t->pad)];
+    if (legacy && [legacy containsObject:@(nvn_hm_hash(row.bytes,row.length))]) return YES;
+    return [keys containsObject:par_hash(row.bytes,row.length)];
+}
+static void rb_pso_maintain(void) {
+    rb_flush_binds(NO,clock_gettime_nsec_np(CLOCK_UPTIME_RAW));
+}
