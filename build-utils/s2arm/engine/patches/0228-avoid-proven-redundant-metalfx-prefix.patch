diff --git a/graphics/nvn/gfx/nvn/nvn_rb_fx_prefix.h b/graphics/nvn/gfx/nvn/nvn_rb_fx_prefix.h
new file mode 100644
index 0000000..3ede7ad
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_rb_fx_prefix.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+enum rb_fx_prefix { RB_FX_KEEP, RB_FX_CLOSE_COPY, RB_FX_AFTER_RENDER };
+
+// An open copy encoder still gets its complete end barrier. The internal copy dependency
+// would have no consuming command: the next operation is the end barrier itself.
+static inline enum rb_fx_prefix rb_fx_choose_prefix(int enabled, int copy_open, int uniform_pending,
+    int same_full_render, int alias, int pending_timestamp, int profile_can_attach)
+{
+    if (!enabled || uniform_pending) return RB_FX_KEEP;
+    if (copy_open) return RB_FX_CLOSE_COPY;
+    return same_full_render && !alias && !pending_timestamp && profile_can_attach
+           ? RB_FX_AFTER_RENDER : RB_FX_KEEP;
+}
diff --git a/graphics/nvn/tests/t_rb_fx_prefix.c b/graphics/nvn/tests/t_rb_fx_prefix.c
new file mode 100644
index 0000000..7651d97
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_fx_prefix.c
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/nvn_rb_fx_prefix.h"
+#include <assert.h>
+
+int main(void)
+{
+    for (unsigned i = 0; i < 128; ++i) {
+        int en = i & 1, open = i & 2, pending = i & 4, covered = i & 8;
+        int alias = i & 16, timestamp = i & 32, profile = i & 64;
+        enum rb_fx_prefix action = rb_fx_choose_prefix(en, open, pending, covered, alias, timestamp, profile);
+        if (action == RB_FX_CLOSE_COPY) assert(en && open && !pending);
+        if (action == RB_FX_AFTER_RENDER) assert(en && !open && !pending && covered && !alias && !timestamp && profile);
+        if ((!en || pending) || (!open && (!covered || alias || timestamp || !profile))) assert(action == RB_FX_KEEP);
+    }
+    assert(rb_fx_choose_prefix(1, 0, 0, 1, 0, 0, 1) == RB_FX_AFTER_RENDER);
+    assert(rb_fx_choose_prefix(1, 1, 0, 0, 1, 0, 0) == RB_FX_CLOSE_COPY);
+}
