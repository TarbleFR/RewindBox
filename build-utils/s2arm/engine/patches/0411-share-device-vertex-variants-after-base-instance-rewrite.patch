+        NSString *name=[src substringWithRange:[h rangeAtIndex:1]];
+        if (!end || entries[name]) return src;
+        entries[name]=@{ @"head":h, @"body":@(body), @"end":@(NSMaxRange(end.range)),
+            @"params":[src substringWithRange:[h rangeAtIndex:2]] };
+    }
+    NSDictionary *gl=entries[@"main0"], *z=entries[@"main0_z"];
+    if (!gl || !z || ![gl[@"params"] isEqual:z[@"params"]]) return src;
+    NSString *(^bodyOf)(NSDictionary *)=^NSString *(NSDictionary *e) {
+        NSUInteger a=[e[@"body"] unsignedIntegerValue], b=[e[@"end"] unsignedIntegerValue];
+        return [src substringWithRange:NSMakeRange(a,b-a)];
+    };
+    NSString *glbody=bodyOf(gl), *zbody=bodyOf(z);
+    NSString *depth=@"out.gl_Position.z = fma(out.gl_Position.z, 0.5, out.gl_Position.w * 0.5);";
+    NSString *line=[depth stringByAppendingString:@"\n    "];
+    if (![glbody containsString:line] ||
+        ![[glbody stringByReplacingOccurrencesOfString:line withString:@""] isEqual:zbody]) return src;
+    // Separate declarations from their stage attributes; split only at commas
+    // outside templates, parentheses and attributes. Unknown parameters fall back.
+    NSString *params=gl[@"params"]; NSMutableArray *parts=[NSMutableArray array];
+    NSInteger nesting=0; NSUInteger start=0;
+    for (NSUInteger i=0;i<params.length;i++) {
+        unichar c=[params characterAtIndex:i];
+        if (c=='<' || c=='(' || c=='[') nesting++;
+        else if (c=='>' || c==')' || c==']') { if (--nesting<0) return src; }
+        else if (c==',' && !nesting) { [parts addObject:[params substringWithRange:NSMakeRange(start,i-start)]]; start=i+1; }
+    }
+    if (nesting) return src;
+    [parts addObject:[params substringFromIndex:start]];
+    NSMutableArray *decl=[NSMutableArray array], *args=[NSMutableArray array];
+    NSRegularExpression *attrs=[NSRegularExpression regularExpressionWithPattern:@"\\s*\\[\\[[^\\]]*\\]\\]\\s*$" options:0 error:nil];
+    NSRegularExpression *nameRE=[NSRegularExpression regularExpressionWithPattern:@"[A-Za-z_][A-Za-z_0-9]*$" options:0 error:nil];
+    for (NSString *part in parts) {
+        if ([part containsString:@"function_constant"] || [part containsString:@"="]) return src;
+        NSString *d=[[attrs stringByReplacingMatchesInString:part options:0 range:NSMakeRange(0,part.length) withTemplate:@""] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+        NSTextCheckingResult *n=[nameRE firstMatchInString:d options:0 range:NSMakeRange(0,d.length)];
