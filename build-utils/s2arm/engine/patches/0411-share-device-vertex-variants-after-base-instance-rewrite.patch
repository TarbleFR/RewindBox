+// Shared vertex bodies, informed by nxnative b989137a51 (seedds, MIT).
+// Unlike that version, depth conversion remains before the widen epilogue at
+// EVERY original return. GS, TF and layer entry points remain whole copies.
+// This runs after base-instance rewriting, which must see the original bodies.
+static NSString *rb_vertex_unit(NSString *src) {
+    if ([src containsString:@"rb_vertex_body("] || [src containsString:@"rb_vertex_gl_depth"]) return src;
+    NSRegularExpression *headers=[NSRegularExpression regularExpressionWithPattern:
+        @"(?m)^vertex main0_out (main0|main0_z|main0_v|main0_zv)\\(([^\\n]*)\\)\\n\\{\\n" options:0 error:nil];
