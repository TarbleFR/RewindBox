+        [decl addObject:d]; [args addObject:[d substringWithRange:n.range]];
+    }
+    if (!args.count) return src;
+    NSString *callArgs=[args componentsJoinedByString:@", "];
+    NSMutableArray *edits=[NSMutableArray array];
+    for (NSString *name in @[@"main0",@"main0_z",@"main0_v",@"main0_zv"]) {
+        NSDictionary *e=entries[name]; if (!e) continue;
