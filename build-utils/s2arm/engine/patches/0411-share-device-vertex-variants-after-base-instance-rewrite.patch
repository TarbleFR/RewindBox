+    NSString *helper=[NSString stringWithFormat:@"static __attribute__((always_inline)) main0_out rb_vertex_body(%@, bool rb_vertex_gl_depth)\n{\n%@\n",[decl componentsJoinedByString:@", "],shared];
+    NSTextCheckingResult *h=gl[@"head"], *hz=z[@"head"];
+    [out insertString:helper atIndex:MIN(h.range.location,hz.range.location)];
+    return out;
+}
