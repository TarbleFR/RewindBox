+        NSString *original=isGL ? glbody:zbody, *body=bodyOf(e);
+        if (![body hasSuffix:original]) return src;
+        NSString *prefix=[body substringToIndex:body.length-original.length];
+        NSString *replacement=[NSString stringWithFormat:@"%@    return rb_vertex_body(%@, %@);\n}\n",prefix,callArgs,isGL ? @"true":@"false"];
+        [edits addObject:@{ @"start":e[@"body"], @"end":e[@"end"], @"text":replacement }];
+    }
+    [edits sortUsingComparator:^NSComparisonResult(NSDictionary *a,NSDictionary *b) { return [b[@"start"] compare:a[@"start"]]; }];
+    NSMutableString *out=[src mutableCopy];
+    for (NSDictionary *e in edits) { NSUInteger a=[e[@"start"] unsignedIntegerValue], b=[e[@"end"] unsignedIntegerValue];
