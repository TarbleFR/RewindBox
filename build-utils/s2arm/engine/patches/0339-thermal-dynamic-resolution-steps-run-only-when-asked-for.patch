diff --git a/graphics/nvn/gfx/nvn/rb_drs_thermal.h b/graphics/nvn/gfx/nvn/rb_drs_thermal.h
new file mode 100644
index 0000000..0a69270
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_drs_thermal.h
@@ -0,0 +1,8 @@
+// RewindBox (patch 0339): the thermal steps of the guest DRS run only when asked for (S2A_RB_DRS_THERMAL=1). Pure C.
+//   Patch 0087 made a hot iPhone push the game's resolution down: from the threshold state on, a frame's TIMESTAMP reports in the band read 18.7 or 20.5 ms instead of the
+//   16.6 ms hold, patch 0266 added an adaptive level on the GPU quantiles at Fair, patches 0307 and 0310 a floor learned from the pushes. Mario Kart World races sit at the
+//   game's own floor (1248x700) from the start, so a push can only make the game skip frames: at Serious those reads made it ask for present interval 2 in 19 to 36 % of the
+//   six frames after them (IPA 825), and at Fair the no-lock guard of patch 0319 keeps the level at 0, so they did nothing there (IPA 827: level=2 logged, 0 applied).
+//   Off, the reports keep patch 0083's hold (16.6 ms at 60 fps) at every thermal state; the state is still read for the guard, which runs no trial and no escape at Critical.
+#pragma once
+static inline int rb_drs_thermal_asked(const char *value) { return value && value[0] == '1' && !value[1]; }
