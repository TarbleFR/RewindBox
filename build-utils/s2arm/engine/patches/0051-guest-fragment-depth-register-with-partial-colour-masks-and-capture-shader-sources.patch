index ba58d65..60b2a23 100644
--- a/compat/tree/src/Ryujinx.Graphics.Shader/Translation/TranslatorContext.cs
+++ b/compat/tree/src/Ryujinx.Graphics.Shader/Translation/TranslatorContext.cs
@@ -165,7 +165,13 @@ namespace Ryujinx.Graphics.Shader.Translation
         internal int GetDepthRegister()
         {
             // The depth register is always two registers after the last color output.
-            return BitOperations.PopCount((uint)Definitions.OmapTargets) + 1;
+            // RewindBox (patch 0051): a colour target the shader writes takes four registers whatever its component mask: EmitterContext.PrepareForReturn reads component c of
+            //   the n-th written target from register 4 n + c. The sample mask and the depth follow the last of those blocks, so the depth is at 4 x written targets + 1.
+            //   Counting the mask's bits gave that register only when every written target writes all four components; with a partial mask (a one-channel output) it named a
+            //   register inside the colour blocks, and the shader's depth output was whatever that register held.
+            uint written = (uint)Definitions.OmapTargets;
+            written = (written | (written >> 1) | (written >> 2) | (written >> 3)) & 0x11111111u;   // one bit a written target
+            return BitOperations.PopCount(written) * 4 + 1;
         }
 
         public void SetLayerOutputAttribute(int attr)
