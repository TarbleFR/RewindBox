+            (unsigned long long)c.controls, (unsigned long long)c.reads, (unsigned long long)c.reads_ahead, c.reads_ahead ? (double)c.ahead_sum_us / 1e3 / (double)c.reads_ahead : 0., c.ahead_max_us / 1e3,
+            (unsigned long long)c.reads_unmatched, (unsigned long long)c.reports, (unsigned long long)c.held);
+}
