+// RewindBox (patch 0328): a bounded trace of the frames around the game's requests for present interval 2 (rb_interval_trace.h). IPA 827 (Mario Kart World, iPhone 16
+//   Pro Max): out of a race, at 11.5 ms of GPU time, the game asks for interval 2 for one present every 6 to 8 frames (445 of 487 stays lasted one present), each costs
+//   a display tick, and the log has nothing per frame but the time from one present to the next. Noted here: when each frame began (rb_itv_acquired), its present, its
+//   waits, the interval and the hold it went with (rb_itv_presented), the timestamp reports the completion handlers wrote for it before and after the report hold
+//   (nvn_rb_itv_report, called by nvn_mtl.m) and the game's conversions of them against the guest clock at that call (rb_itv_converted). 9 presents after a present sent at
+//   interval 2 that follows one sent at interval 1, rb_itv_presented writes the six frames around it ("[rb-itv] episode=F frame=..."), 4 episodes and one group of frames
+//   far from any request ("[rb-itv] control=F frame=...") per 300 frames at most, and "[rb-itv] up to frame N: ..." with the counts of each 300 frames. No time the
+//   game reads or waits changes, and a title that never alternates writes nothing after the switch's line. S2A_RB_ITV_TRACE=0: nothing noted, no line
+#include "rb_interval_trace.h"
+static rb_itv_trace g_rb_itv; static pthread_mutex_t g_rb_itv_mu = PTHREAD_MUTEX_INITIALIZER;   // g_rb_itv_mu: every use of g_rb_itv
+static int rb_itv_on(void) {   // any thread
+    static _Atomic int v;   // 0: not read yet, 1: off, 2: on
+    int s = atomic_load_explicit(&v, memory_order_relaxed);
+    if (!s) {
+        const char *e = getenv("S2A_RB_ITV_TRACE"); int zero = 0;
+        s = e && !strcmp(e, "0") ? 1 : 2;
+        if (atomic_compare_exchange_strong(&v, &zero, s))
+            LOG("[rb-itv] interval-2 episode trace %s (S2A_RB_ITV_TRACE; patch 0328): %d frames kept, %d episodes and one control group written per %d frames at most",
+                s == 2 ? "on" : "off", RB_ITV_RING, RB_ITV_PER_WINDOW, RB_ITV_WINDOW);
+    }
+    return s == 2;
+}
+static void rb_itv_acquired(void) {   // the pacing owner's acquire has returned: the frame begins (its first one counts)
+    if (!rb_itv_on()) return;
+    const uint64_t at = guest_ns(), f = g_frame;
+    pthread_mutex_lock(&g_rb_itv_mu); rb_itv_begin(&g_rb_itv, f, at); pthread_mutex_unlock(&g_rb_itv_mu);
+}
+void nvn_rb_itv_report(uint64_t frame, uint32_t type, uint64_t raw_ticks, uint64_t read_ticks);
+void nvn_rb_itv_report(uint64_t frame, uint32_t type, uint64_t raw_ticks, uint64_t read_ticks) {   // nvn_mtl.m's completion handlers, as they write a TIMESTAMP_TOP or TIMESTAMP report
+    if (!rb_itv_on()) return;
+    const uint64_t at = guest_ns();
+    pthread_mutex_lock(&g_rb_itv_mu); rb_itv_report_note(&g_rb_itv, frame, type, raw_ticks, read_ticks, at); pthread_mutex_unlock(&g_rb_itv_mu);
+}
+static void rb_itv_converted(uint64_t ticks) {   // nvnDeviceGetTimestampInNanoseconds: the game reads a report's time
+    if (!rb_itv_on()) return;
+    const uint64_t at = guest_ns(), f = g_frame;
+    pthread_mutex_lock(&g_rb_itv_mu); rb_itv_read_note(&g_rb_itv, f, ticks, at); pthread_mutex_unlock(&g_rb_itv_mu);
+}
+static double rb_itv_ms(int64_t us) { return us == INT64_MIN ? -1. : (double)us / 1e3; }   // -1: not known
+// One line a frame of the group around `centre` (g: rb_itv_group's copy), written by the presenting thread without the lock. Times in ms after the frame began (its first
+//   acquire returned), -1 = not known. reports: kind:raw/read/ahead, the time after the frame's first TIMESTAMP_TOP on the busy GPU clock, the time written (kind held:
+//   the report hold changed it), and the written time less the guest clock when it was written. reads: +frames later:value/ahead, a conversion of one of those reports
+//   by the game, its value after that TIMESTAMP_TOP and less the guest clock at the call (+: the game is told a time its clock has not reached)
+static void rb_itv_write(const char *kind, uint64_t centre, const rb_itv_frame *g) {
+    for (unsigned i = 0; i + 1 < RB_ITV_GROUP; i++) {
+        const rb_itv_frame *r = &g[i], *next = &g[i + 1];
+        const int rel = (int)i - RB_ITV_BEFORE;
+        const unsigned long long frame = (unsigned long long)(centre + i - RB_ITV_BEFORE);
+        if (!r->frame) { LOG("[rb-itv] %s=%llu frame=%llu rel=%d missing", kind, (unsigned long long)centre, frame, rel); continue; }
+        char line[1024]; size_t o = 0;
+        o += (size_t)snprintf(line + o, sizeof line - o, "[rb-itv] %s=%llu frame=%llu rel=%d itv=%u hold=%u next_begin_ms=%.2f acquire_wait_ms=%.2f queue_wait_ms=%.2f present_ms=%.2f top_ms=%.2f gpu_ms=%.2f..%.2f shown_ms=%.2f reports=",
+                              kind, (unsigned long long)centre, frame, rel, (unsigned)r->interval, (unsigned)r->hold, rb_itv_ms(rb_itv_after_begin_us(r, next->frame ? next->begin_ns : 0)),
+                              r->acquire_wait_us / 1e3, r->queue_wait_us / 1e3, rb_itv_ms(rb_itv_after_begin_us(r, r->present_ns)), rb_itv_ms(rb_itv_after_begin_us(r, r->top_ns)),
+                              rb_itv_ms(rb_itv_after_begin_us(r, r->gpu0_ns)), rb_itv_ms(rb_itv_after_begin_us(r, r->gpu1_ns)), rb_itv_ms(rb_itv_after_begin_us(r, r->shown_ns)));
+        for (unsigned k = 0; k < r->reports && o < sizeof line - 128; k++) {
+            const rb_itv_report *p = &r->report[k];
+            o += (size_t)snprintf(line + o, sizeof line - o, "%s%s:%.2f/%.2f/%+.2f", k ? "," : "", p->type == 0x10 ? "top" : p->read_ticks != p->raw_ticks ? "held" : "ts",
+                                  rb_itv_ms(rb_itv_after_top_us(r, p->raw_ticks)), rb_itv_ms(rb_itv_after_top_us(r, p->read_ticks)), p->ahead_us / 1e3);
+        }
+        if (o < sizeof line - 128) o += (size_t)snprintf(line + o, sizeof line - o, "%s reads=", r->reports_lost ? ",more" : "");
+        for (unsigned k = 0; k < r->reads && o < sizeof line - 128; k++)
+            o += (size_t)snprintf(line + o, sizeof line - o, "%s+%u:%.2f/%+.2f", k ? "," : "", (unsigned)r->read[k].lag, r->read[k].read_us / 1e3, r->read[k].ahead_us / 1e3);
+        if (r->reads_lost && o < sizeof line - 128) snprintf(line + o, sizeof line - o, ",more");
+        LOG("%s", line);
+    }
+}
+// The present of frame f, on the presenting thread before the frame's waits are cleared. t0: the present call (host clock). interval: what it was sent with (0: not sent
+//   to a window texture). hold_ns: what it was queued for on screen. late_ticket: the present ticket of frame f - 8, whose GPU span and display time are known by now
+static void rb_itv_presented(uint64_t f, uint64_t t0, int interval, uint64_t hold_ns, uint64_t late_ticket) {
+    if (!rb_itv_on()) return;
+    const uint64_t guest = guest_ns(), host = now_ns(), off = host > guest ? host - guest : 0;   // what the host clock is ahead of the guest clock: the time the guest clock stood still
+    uint64_t g0 = 0, g1 = 0, shown_ns = 0;
+    if (f >= 8) {
+        if (!nvn_be_gpu_span(f - 8, &g0, &g1)) g0 = g1 = 0;
+        const double shown = late_ticket ? nvn_be_presented_time(late_ticket) : 0;   // seconds on the host clock; 0 not known, -1 discarded
+        if (shown > 0) shown_ns = (uint64_t)(shown * 1e9);
+    }
+    static rb_itv_frame group[RB_ITV_PER_WINDOW + 1][RB_ITV_GROUP];   // the presenting thread: what this present has to write
+    uint64_t centre[RB_ITV_PER_WINDOW + 1] = {0};
+    unsigned n = 0; int control = 0;
+    rb_itv_counts c = {0};
+    pthread_mutex_lock(&g_rb_itv_mu);
+    const int summary = rb_itv_window(&g_rb_itv, f, &c);
+    rb_itv_present(&g_rb_itv, f, t0 > off ? t0 - off : 0, interval, (unsigned)((hold_ns * 60 + 500000000ull) / 1000000000ull), g_acq_wait_ns, g_pq_wait_ns);
+    if (f >= 8) rb_itv_late(&g_rb_itv, f - 8, g0 > off ? g0 - off : 0, g1 > off ? g1 - off : 0, shown_ns > off ? shown_ns - off : 0);
+    while (n < RB_ITV_PER_WINDOW && rb_itv_take(&g_rb_itv, f, &centre[n])) { rb_itv_group(&g_rb_itv, centre[n], group[n]); n++; }
+    if (rb_itv_control(&g_rb_itv, f, &centre[n])) { rb_itv_group(&g_rb_itv, centre[n], group[n]); control = 1; }
+    pthread_mutex_unlock(&g_rb_itv_mu);
+    for (unsigned i = 0; i < n; i++) rb_itv_write("episode", centre[i], group[i]);
+    if (control) rb_itv_write("control", centre[n], group[n]);
+    if (summary)
+        LOG("[rb-itv] up to frame %llu: episodes=%llu one_present=%llu written=%llu over_budget=%llu lost=%llu controls=%llu; timestamp reads=%llu ahead_of_guest_clock=%llu (mean %.2f ms, max %.2f ms) unmatched=%llu; reports=%llu held=%llu",
