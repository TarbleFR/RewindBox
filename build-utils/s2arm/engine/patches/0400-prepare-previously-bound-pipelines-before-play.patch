+static void rb_wait_known_prepare(void) {
+    if (!atomic_load(&g_rb_known_active) || atomic_exchange(&g_rb_known_waited,1)) return;
+    uint64_t start=bp_now();
+    int configured=prepare_max_ms();
+    uint64_t limit=(uint64_t)(configured>0 ? MIN(configured,30000) : 30000)*1000000ull;
+    const char *reason="completed";
+    int front=0;
+    DM_BLOCK_BEGIN();
+    for (;;) {
+        long left=atomic_load(&g_rb_known_pending), total=atomic_load(&g_rb_known_total);
+        if (!left) break;
+        if (nvn_be_stopping() || dm_gfx_session_stopping()) { reason="stop"; break; }
+        if (bp_now()-start>=limit) { reason="time_budget"; break; }
+        if (rb_cached_thermal()>=3 || !rb_metal_working_room() || !rb_registered_capacity() ||
+            bp_now()<atomic_load(&g_spec_pressure_until)) { reason="pressure"; break; }
+        if (atomic_load(&g_wp_play)) { reason="player"; break; }
+        // A subset is not the completion of the full warm-up catalogue.
+        if (total>0) {
+            int result=s2a_front_warm_tick(total-MAX(left,0),total+1);
+            front|=result>=0;
+            if (result==1) { reason="player"; break; }
+        }
+        usleep(50000);
+    }
+    DM_BLOCK_END();
+    if (front) s2a_front_warm_released();
+    MLOG("[rb-prepare-known] release=%s elapsed_ms=%.1f total=%ld ready=%ld failed=%ld pending=%ld",
+        reason,(bp_now()-start)/1e6,atomic_load(&g_rb_known_total),atomic_load(&g_rb_known_ready),
+        atomic_load(&g_rb_known_failed),atomic_load(&g_rb_known_pending));
