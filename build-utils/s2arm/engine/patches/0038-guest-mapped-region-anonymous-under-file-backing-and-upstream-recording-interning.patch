+                                 //   (8,340 MB, from sessions without file backing) would have kept the region in the files for good. A session that dies in the foreground
+                                 //   (killed at the memory limit, crash) turns it off for the next one (s2a_guest_run_died), so a carve that does not fit is not repeated
+static uint64_t g_gfile_room;    // the room left under the per-process limit when file backing was decided (0 = unknown)
+static uint64_t g_anon_lo, g_anon_hi;
+static int in_anon(uint64_t a, uint64_t n) { return g_anon_hi > g_anon_lo && a < g_anon_hi && a + n > g_anon_lo; }
