         @"staticConverted":@(RB_EXT_COUNT(rb_ext_records)),@"nativeUniqueRender":@(ordered.count),
         @"duplicateNativeRender":@(duplicates),@"missingStage":@(missing),@"ambiguousStage":@(ambiguous),
         @"translationRefused":@(refused),@"missingReflection":@(reflection),@"requiresVertexPadding":@(link),
         @"deferredNativeMissingInput":@(deferred.count),@"confirmedAbsentStages":@(absent.count),
         @"validStageMap":@(validMap),@"nativeUniqueCompute":@(computes.count),@"openingCommon":@(added[0]),@"openingKartnative":@(added[1]),
-        @"openingPlumber":@(added[2])};
+        @"openingPlumber":@(added[2])} mutableCopy];
