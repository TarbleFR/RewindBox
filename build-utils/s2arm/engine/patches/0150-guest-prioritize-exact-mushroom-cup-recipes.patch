+// The native inventory is rebuilt from the pinned manifests on this device.
+// Compare full recipes, preserving the original player log. warm_parse sees
+// the reference list first and schedules just one task for each exact row.
+static NSDictionary *rb_ext_observed_counts(NSString *wire, NSSet *external, NSSet *selected, NSSet *deferred) {
+    NSMutableSet *observed=[NSMutableSet setWithCapacity:RB_MKW_NEW_RECIPES];
+    for (size_t i=0;i<RB_MKW_NEW_RECIPES;i++)
+        [observed addObject:[NSString stringWithFormat:@"R\t%s",rb_mkw_targets[i].recipe]];
+    NSMutableSet *user=[NSMutableSet set];
+    NSString *path=[wire stringByAppendingPathComponent:@"pso_user.tsv"];
+    FILE *f=fopen(path.fileSystemRepresentation,"r");
+    BOOL known=f || errno==ENOENT;
+    if (f) {
+        char row[2*sizeof(pso_skey)+64];
+        while (fgets(row,sizeof row,f)) { @autoreleasepool {
+            size_t len=strlen(row);
+            if (len!=3+2*sizeof(pso_skey) || row[len-1]!='\n' || row[0]!='R' || row[1]!='\t') continue;
+            row[len-1]=0;
+            NSString *entry=@(row);
+            if (entry && [observed containsObject:entry]) [user addObject:entry];
+            if (user.count==observed.count) break;
+        } }
+        known=!ferror(f); fclose(f);
+    }
+    NSUInteger added=0,promoted=0,inExternal=0,unavailable=0;
+    for (NSString *row in observed) {
+        BOOL ext=[external containsObject:row];
+        inExternal+=ext;
+        if (![selected containsObject:row] || [deferred containsObject:row]) { unavailable++; continue; }
+        if (ext || [user containsObject:row]) promoted++;
+        else added++;
+    }
+    return @{@"observedNewCupRecipes":@(observed.count),@"observedInExternal":@(inExternal),
+        @"observedInUser":known ? @(user.count) : @(-1),@"observedPromoted":known ? @(promoted) : @(-1),
+        @"observedAdded":known ? @(added) : @(-1),@"observedDeferredMissingStage":@(unavailable)};
+}
