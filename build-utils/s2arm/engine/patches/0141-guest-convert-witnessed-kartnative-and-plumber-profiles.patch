@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Recorded 440-byte fixtures and negative semantic controls. Runs offline."""
+from pathlib import Path
+import hashlib
+import struct
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import rb_mkw_external_profile as external
+
+# Real captures at the revisions pinned by the generator. The recorded vertex
+# and fragment names are foreign until an on-device byte witness resolves them.
+REAL = [
+    ('kartnative', 335, '', 'b5902002a8b7d3d0391dff8c4e85275c27521ef3fa4bd50f0eda0b1c77f4ddf4'),
+    ('kartnative', 5823, '', '7187bbc83d6884c4a526aa6ce5e08fd0d1b5cd694db3b719ad0e86274d21c5b0'),
+    ('plumber', 3702, '', '969e6b5334a6088f8a4bfacef4bc6868ff3ee00090acc6fb0be263dfad60730f')
+]
+
+class ConverterTests(unittest.TestCase):
+    def test_actual_records(self):
+        for family, line, source_hex, normalized_sha in REAL:
+            with self.subTest(family=family,line=line):
+                src=bytes.fromhex(source_hex)
+                vs,fs,state=external.convert(src)
+                native=bytearray(432)
+                native[:24]=src[:24];native[24:48]=src[24:48];native[48:]=state
+                self.assertEqual(hashlib.sha256(native).hexdigest(),normalized_sha)
+                self.assertEqual(vs,int(src[:16],16))
+                self.assertEqual(fs,int(src[24:40],16) if src[24] else None)
+                # Pixel formats, depth/stencil, sample count, RGB/alpha
+                # equations and all 16 independent stream divisors.
+                self.assertEqual(struct.unpack_from("<13I",native,104),struct.unpack_from("<13I",src,104))
+                self.assertEqual(struct.unpack_from("<8Q",native,160),struct.unpack_from("<8Q",src,160))
+                self.assertEqual(struct.unpack_from("<32I",native,288),struct.unpack_from("<32I",src,288))
+    def test_unrepresentable_states(self):
+        src=bytes.fromhex(REAL[0][2])
+        for offset,v,reason in [(432,1,"alpha-test-function"),(436,1,"logic-operation"),
+                              (156,257,"alpha-to-coverage"),(88,7,"runtime-pointer"),
+                              (140,212,"depth-stencil"),(144,3,"samples"),(164,1<<5,"advanced-blending")]:
+            with self.subTest(offset=offset):
+                bad=bytearray(src)
+                if offset==164:v |= struct.unpack_from("<I",src,offset)[0]
+                struct.pack_into("<I",bad,offset,v)
+                with self.assertRaisesRegex(ValueError,reason):external.convert(bad)
+        with self.assertRaisesRegex(ValueError,"wrong-size"):external.convert(src[:432])
+    def test_shipped_table(self):
+        path=Path(__file__).resolve().parents[3]/"nvn/gfx/nvn/rb_external_data.inc"
+        self.assertEqual(hashlib.sha256(path.read_bytes()).hexdigest(),"ff1f509860af21cd9ec2adfd8df4b3527263bab704ddb1bcc952ad8556ba8949")
+
+if __name__=="__main__":
+    unittest.main()
