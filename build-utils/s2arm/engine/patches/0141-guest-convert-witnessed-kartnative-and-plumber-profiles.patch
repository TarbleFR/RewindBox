index 0000000..3b1015c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_external_profile.inc
@@ -0,0 +1,214 @@
+// Embedded descriptors are portable CPU-side render state from two MIT projects.
+// The translator can only resolve an upstream name by witnessing its original bytes.
+#include "rb_external_data.inc"
+#define RB_EXT_COUNT(a) (sizeof(a)/sizeof(a[0]))
+_Static_assert(sizeof(pso_skey)==432 && offsetof(pso_skey,vs_stage)==48 &&
+               offsetof(pso_skey,k)==88 && offsetof(pso_key,attr)==136 &&
+               offsetof(pso_key,stream)==200 && offsetof(pso_key,fsfn)==336,
+               "external profile requires the LP64 432-byte S2Arm ABI");
+static NSString *const rb_ext_table_identity=@"0400C3F00006E000\t9e244438c3d8ef1c703a6a85ef99c4f0";
+static NSString *rb_ext_stage_id(size_t index) {
+    return [NSString stringWithFormat:@"%c\t%016llx\t%u",rb_ext_stages[index].family,
+        (unsigned long long)rb_ext_stages[index].key,rb_ext_stages[index].stage];
+}
+static BOOL rb_ext_write_requests(NSString *wire) {
+    NSMutableString *requests=[NSMutableString stringWithFormat:@"# rb-external-stages-v1\t%@\n",rb_ext_table_identity];
+    for (size_t i=0;i<RB_EXT_COUNT(rb_ext_stages);i++) [requests appendFormat:@"%@\n",rb_ext_stage_id(i)];
+    return [requests writeToFile:[wire stringByAppendingPathComponent:@"external-stages.tsv"]
+                      atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+}
+static BOOL rb_ext_hex(NSString *s) {
+    const char *p=s.UTF8String;
+    return p && strlen(p)==16 && strspn(p,"0123456789abcdef")==16;
+}
+static NSDictionary *rb_ext_map(NSString *wire) {
+    NSString *path=[wire stringByAppendingPathComponent:@"external-stage-map.tsv"];
+    NSString *text=[NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:NULL];
+    NSArray *lines=[text componentsSeparatedByString:@"\n"];
+    if (![lines.firstObject isEqual:[@"# rb-external-stage-map-v1\t" stringByAppendingString:rb_ext_table_identity]]) return nil;
+    NSMutableDictionary *map=[NSMutableDictionary dictionary];
+    for (NSString *line in lines) { @autoreleasepool {
+        if (!line.length || [line hasPrefix:@"#"]) continue;
+        NSArray *c=[line componentsSeparatedByString:@"\t"];
+        if (c.count!=4 || (![c[0] isEqual:@"K"] && ![c[0] isEqual:@"P"]) || !rb_ext_hex(c[1]) ||
+            !([c[3] isEqual:@"-"] || [c[3] isEqual:@"?"] || [c[3] isEqual:@"!"] || rb_ext_hex(c[3]))) return nil;
+        NSString *key=[[c subarrayWithRange:NSMakeRange(0,3)] componentsJoinedByString:@"\t"];
+        NSString *previous=map[key];
+        map[key]=previous && ![previous isEqual:c[3]] ? @"!" : c[3];
+    } }
+    return map;
+}
+struct rb_ext_reflection { int attributes, colors; uint32_t inputs, outputs; uint8_t hasUser; };
+static BOOL rb_ext_refl(NSString *shaders,NSString *pack,NSString *key,int stage,NSMutableDictionary *cache,
+                        struct rb_ext_reflection *out) {
+    NSString *name=[NSString stringWithFormat:@"%@:%d",key,stage];
+    NSData *cached=cache[name];
+    if (!cached) {
+        NSString *leaf=[key stringByAppendingString:@"_b.json"];
+        NSData *data=[NSData dataWithContentsOfFile:[pack stringByAppendingPathComponent:leaf]];
+        if (!data) data=[NSData dataWithContentsOfFile:[shaders stringByAppendingPathComponent:leaf]];
+        NSDictionary *j=data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL] : nil;
+        nvn_refl rf; char err[160]; struct rb_ext_reflection r={.colors=-1};
+        BOOL fragment=[j isKindOfClass:NSDictionary.class] && ([j[@"stage"] isEqual:@"fs"] || [j[@"stage"] isEqual:@"ps"]);
+        if ([j isKindOfClass:NSDictionary.class] && [j[@"chain"] isEqual:@DMSH_CHAIN] &&
+            (stage ? fragment : [j[@"stage"] isEqual:@"vs"]) &&
+            !nvn_refl_from_json(j,&rf,err,sizeof err)) {
+            r.attributes=(int)rb_read_vertex_mask(&rf);
+            if (rf.color_known) r.colors=rf.color_mask;
+            r.inputs=rf.user_in; r.outputs=rf.user_out; r.hasUser=rf.has_user;
+            free(rf.b); free(rf.c1);
+            cached=[NSData dataWithBytes:&r length:sizeof r];
+        } else cached=[NSData data];
+        cache[name]=cached;
+    }
+    if (cached.length!=sizeof *out) return NO;
+    [cached getBytes:out length:sizeof *out]; return YES;
+}
+// Map both recorded shader identities before constructing a native key. The
+// shared normalizer reads the same native reflection masks as the draw path.
+static NSString *rb_ext_row(size_t i,NSString *vs,NSString *fs,struct rb_ext_reflection v,struct rb_ext_reflection f) {
+    pso_skey sk={0};
+    memcpy(&sk.vs_stage,rb_ext_layouts[rb_ext_records[i].layout],sizeof sk-48);
+    snprintf(sk.vs,sizeof sk.vs,"%s_b",vs.UTF8String);
+    if (fs) snprintf(sk.fs,sizeof sk.fs,"%s_b",fs.UTF8String);
+    pso_norm_masks(&sk.k,v.attributes,f.colors,0);
+    char hex[sizeof sk*2+1]; pso_skey_hex(&sk,hex);
+    return [NSString stringWithFormat:@"R\t%s",hex];
+}
+// Called only after rb_prepare_stage_inputs completed this generation. An
+// interrupted scan, a stale source preserved without input, a translation
+// failure and an unreadable asset must never downgrade a mandatory GPU proof.
+static NSSet<NSString *> *rb_ext_confirmed_absences(NSString *wire) {
+    NSDictionary *coverage=[NSDictionary dictionaryWithContentsOfFile:[wire stringByAppendingPathComponent:@"stage-scan-coverage.plist"]];
+    for (NSString *key in @[@"unavailableDictionary",@"corrupt",@"resourceLimits",@"ioErrors"]) {
+        id n=coverage[key];
+        if (![n isKindOfClass:NSNumber.class] || [n longLongValue]!=0) return nil;
+    }
+    NSNumber *total=coverage[@"unlocatedRequestedKeys"];
+    if (![total isKindOfClass:NSNumber.class] || total.longLongValue<=0) return nil;
+    NSString *report=[NSString stringWithContentsOfFile:[wire stringByAppendingPathComponent:@"stage-recovery.tsv"]
+                                              encoding:NSUTF8StringEncoding error:NULL];
+    NSArray *lines=[report componentsSeparatedByString:@"\n"];
+    if (![lines.firstObject isEqual:@"key\tprevious_source\tinput\ttranslation"]) return nil;
+    NSMutableSet *missing=[NSMutableSet set], *seen=[NSMutableSet set];
+    for (NSUInteger i=1;i<lines.count;i++) { @autoreleasepool {
+        NSString *line=lines[i]; if (!line.length) continue;
+        NSArray *c=[line componentsSeparatedByString:@"\t"];
+        if (c.count!=4 || !rb_ext_hex(c[0]) || [seen containsObject:c[0]]) return nil;
+        [seen addObject:c[0]];
+        if ([c[3] isEqual:@"not-located-in-partial-scan"]) return nil;
+        if (![c[3] isEqual:@"missing"]) continue;
+        if ((![c[1] isEqual:@"absent"] && ![c[1] isEqual:@"stale"]) || ![c[2] isEqual:@"unavailable"]) return nil;
+        [missing addObject:[c[0] stringByAppendingString:@"_b"]];
+    } }
+    return missing.count==total.unsignedLongLongValue ? missing : nil;
+}
+
+static NSString *rb_ext_filter_native(NSString *base,NSSet *missing,NSMutableOrderedSet<NSString *> *deferred) {
+    if (!missing.count) return base;
+    NSMutableString *out=[NSMutableString string];
+    for (NSString *line in [base componentsSeparatedByString:@"\n"]) { @autoreleasepool {
+        if (!line.length) continue;
+        pso_skey sk;
+        if (rb_ref_row(line,&sk) && ([missing containsObject:warm_key(sk.vs,sizeof sk.vs)] ||
+                                    [missing containsObject:warm_key(sk.fs,sizeof sk.fs)])) {
+            [deferred addObject:line];
+            [out appendFormat:@"# missing\t%@\n",par_hash(&sk,sizeof sk)];
+            continue;
+        }
+        if ([line hasPrefix:@"S\t"]) {
+            NSArray *fields=[line componentsSeparatedByString:@"\t"];
+            if (fields.count==3 && [missing containsObject:fields[1]]) continue;
+        }
+        [out appendFormat:@"%@\n",line];
+    } }
+    return out;
+}
+static int rb_ext_materialize(NSString *wire,NSString *pack,NSArray *sources,const struct rb_reference_target *targets,size_t targetCount,rb_stage_cancel cancel,void *ctx) {
+    NSDictionary *map=rb_ext_map(wire); BOOL validMap=map!=nil;
+    NSString *shaders=[wire stringByAppendingPathComponent:@"shaders"];
+    NSMutableArray<NSString *> *mapped=[NSMutableArray arrayWithCapacity:RB_EXT_COUNT(rb_ext_stages)];
+    NSMutableOrderedSet *computes=[NSMutableOrderedSet orderedSet];
+    for (size_t i=0;i<RB_EXT_COUNT(rb_ext_stages);i++) {
+        NSString *key=map[rb_ext_stage_id(i)] ?: @"-";
+        [mapped addObject:key];
+        if (rb_ext_stages[i].compute && rb_ext_hex(key))
+            [computes addObject:[NSString stringWithFormat:@"C\t%@_b",key]];
+    }
+    NSMutableDictionary *refl=[NSMutableDictionary dictionary], *families=[NSMutableDictionary dictionary];
+    NSMutableOrderedSet<NSString *> *ordered=[NSMutableOrderedSet orderedSet];
+    uint64_t missing=0,ambiguous=0,refused=0,reflection=0,link=0,duplicates=0;
+    for (size_t i=0;i<RB_EXT_COUNT(rb_ext_records);i++) { @autoreleasepool {
+        if (!(i%32) && cancel && cancel(ctx)) return 1;
+        NSString *vs=mapped[rb_ext_records[i].vs];
+        NSString *fs=rb_ext_records[i].fs==UINT16_MAX ? nil : mapped[rb_ext_records[i].fs];
+        if ([vs isEqual:@"!"] || [fs isEqual:@"!"]) { ambiguous++; continue; }
+        if ([vs isEqual:@"?"] || [fs isEqual:@"?"]) { refused++; continue; }
+        if (!rb_ext_hex(vs) || (fs && !rb_ext_hex(fs))) { missing++; continue; }
+        struct rb_ext_reflection v={0},f={.colors=-1};
+        if (!rb_ext_refl(shaders,pack,vs,0,refl,&v) || (fs && !rb_ext_refl(shaders,pack,fs,1,refl,&f))) {
+            reflection++; continue;
+        }
+        if ((v.hasUser&1) && (f.hasUser&2) && (f.inputs & ~v.outputs)) link++; // warm_task requests the exact padded vertex program
+        NSString *row=rb_ext_row(i,vs,fs,v,f);
+        unsigned bit=rb_ext_stages[rb_ext_records[i].vs].family=='K'?1u:2u;
+        if (families[row]) duplicates++;
+        families[row]=@([families[row] unsignedIntValue]|bit); [ordered addObject:row];
+    } }
+    NSString *path=[wire stringByAppendingPathComponent:@"pso_external.tsv"];
+    NSMutableString *inventory=[NSMutableString stringWithString:@"# RewindBox external profile 1\n"];
+    for (NSString *row in ordered) [inventory appendFormat:@"%@\n",row];
+    for (NSString *row in computes) [inventory appendFormat:@"%@\n",row];
+    if (![inventory writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:NULL]) return -1;
+    // Native observations, including a formerly missing exact draw, go first.
+    // Give the existing materializer the full attested external inventory too.
+    int rc=rb_ref_materialize(wire,[sources arrayByAddingObject:path],targets,targetCount,cancel,ctx);
+    if (rc) return rc;
+    NSString *mandatory=rb_ref_manifest(wire);
+    NSString *base=[NSString stringWithContentsOfFile:mandatory encoding:NSUTF8StringEncoding error:NULL]; if (!base) return -1;
+    NSSet *absent=rb_ext_confirmed_absences(wire);
+    NSMutableOrderedSet<NSString *> *deferred=[NSMutableOrderedSet orderedSet];
+    base=rb_ext_filter_native(base,absent,deferred);
+    if (deferred.count) {
+        // Keep these exact captured rows in the normal progressive inventory.
+        // A returning stage enters through the usual bind, translation, lookahead
+        // and archive path. The next warm also sees this same recipe on disk.
+        for (NSString *row in deferred) {
+            [inventory appendFormat:@"# deferred-native\t%@\n",[row substringFromIndex:2]];
+            if (![ordered containsObject:row]) [inventory appendFormat:@"%@\n",row];
+        }
+        if (![inventory writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:NULL]) return -1;
+    }
+    NSMutableSet *selected=[NSMutableSet setWithArray:[base componentsSeparatedByString:@"\n"]];
+    [selected addObjectsFromArray:deferred.array];  // the external tiers may not re-promote a confirmed absence
+
+    NSMutableString *result=[base mutableCopy];
+    NSUInteger added[3]={0,0,0}; const NSUInteger limits[3]={32,32,16};
+    // Both captures corroborate common states. Keep Kartnative's recorded order,
+    // then supplement its four-course route from the single-course capture.
+    for (unsigned tier=0;tier<3;tier++) {
+        unsigned mask=(unsigned[]){3,1,2}[tier];
+        for (NSString *row in ordered) {
+            if (added[tier]>=limits[tier]) break;
+            if ([families[row] unsignedIntValue]!=mask || [selected containsObject:row]) continue;
+            pso_skey sk; if (!rb_ref_row(row,&sk)) return -1;
+            [selected addObject:row]; [result appendFormat:@"%@\n",row]; added[tier]++;
+            for (NSUInteger s=0;s<2;s++) {
+                NSString *k=warm_key(s?sk.fs:sk.vs,sizeof sk.vs);
+                if (!k.length) continue;
+                NSString *line=[NSString stringWithFormat:@"S\t%@\t%lu",k,(unsigned long)s];
+                if (![selected containsObject:line]) { [selected addObject:line]; [result appendFormat:@"%@\n",line]; }
+            }
+        }
+    }
+    if (cancel && cancel(ctx)) return 1;
+    if (![result writeToFile:mandatory atomically:YES encoding:NSUTF8StringEncoding error:NULL]) return -1;
+    NSDictionary *report=@{@"kartnativeRender":@3429,@"plumberRender":@4238,@"unsupportedAlphaTest":@8,
+        @"staticConverted":@(RB_EXT_COUNT(rb_ext_records)),@"nativeUniqueRender":@(ordered.count),
+        @"duplicateNativeRender":@(duplicates),@"missingStage":@(missing),@"ambiguousStage":@(ambiguous),
+        @"translationRefused":@(refused),@"missingReflection":@(reflection),@"requiresVertexPadding":@(link),
+        @"deferredNativeMissingInput":@(deferred.count),@"confirmedAbsentStages":@(absent.count),
+        @"validStageMap":@(validMap),@"nativeUniqueCompute":@(computes.count),@"openingCommon":@(added[0]),@"openingKartnative":@(added[1]),
+        @"openingPlumber":@(added[2])};
+    return [report writeToFile:[wire stringByAppendingPathComponent:@"external-profile-counts.plist"] atomically:YES]?0:-1;
+}
