+        if (bad) return -1;
+        if (!k) break;
+    }
+    snprintf(logs, sizeof logs, "%s/logs", d);
+    if (mkdir(logs, 0755) && errno != EEXIST) return -1;
+    if (log_archive(d, "host.log")) return -1;
+    log_prune(logs);
+    snprintf(p, sizeof p, "%s/host.log", d);
+    int fd = open(p, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND, 0644);
