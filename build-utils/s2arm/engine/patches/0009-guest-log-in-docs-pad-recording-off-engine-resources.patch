+// <dir>/host.log with logfd_redirect's archive (<dir>/logs/host-<session start>.log, the newest 9 kept), on g_s2a_logfd and for MLOG;
+//   the descriptor number stays the constructor's, so threads that write meanwhile never see it closed
+static int rb_log_file(const char *dir) {
+    char d[1030], logs[1040], p[1050];
+    if (!dir || dir[0] != '/') { errno = EINVAL; return -1; }
+    if ((size_t)snprintf(d, sizeof d, "%s", dir) >= sizeof d) { errno = ENAMETOOLONG; return -1; }
+    for (char *q = d + 1; ; q++) {   // created level by level, as the launch context creates docs
+        if (*q && *q != '/') continue;
