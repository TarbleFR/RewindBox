diff --git a/graphics/nvn/gfx/nvn/rb_fence_wait.h b/graphics/nvn/gfx/nvn/rb_fence_wait.h
new file mode 100644
index 0000000..e298cbe
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_fence_wait.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <pthread.h>
+#include <stdint.h>
+
+// All fields and the completed-fence predicate are protected by the same mutex.
+typedef struct {
+    pthread_cond_t changed;
+    unsigned sleeping;
+    uint64_t earliest;
+    uint64_t pending_polls, sleeps, broadcasts, segment_completions_with_sleepers;
+} rb_fence_waiters;
+
+static inline int rb_fence_poll_locked(rb_fence_waiters *q, uint64_t done, uint64_t target) {
+    if (done >= target) return 1;
+    q->pending_polls++;
+    return 0;
+}
+
+static inline int rb_fence_sleep_locked(rb_fence_waiters *q, pthread_mutex_t *mutex,
+                                        uint64_t target, const struct timespec *deadline) {
+    if (!q->sleeping || target < q->earliest) q->earliest = target;
+    ++q->sleeping;
+    ++q->sleeps;
+    int result = pthread_cond_timedwait(&q->changed, mutex, deadline);
+    --q->sleeping;
+    return result;
+}
+
+static inline void rb_fence_advanced_locked(rb_fence_waiters *q, uint64_t done) {
+    if (q->sleeping && done >= q->earliest) {
+        // All sleepers are now runnable; any unsatisfied waiter registers its target
+        // again after checking the predicate under the mutex.
+        q->earliest = UINT64_MAX;
+        ++q->broadcasts;
+        pthread_cond_broadcast(&q->changed);
+    }
+}
