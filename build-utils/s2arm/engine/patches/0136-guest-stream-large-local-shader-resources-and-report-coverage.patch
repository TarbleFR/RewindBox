diff --git a/graphics/nvn/host/rb_stage_spill.h b/graphics/nvn/host/rb_stage_spill.h
new file mode 100644
index 0000000..6a36079
--- /dev/null
+++ b/graphics/nvn/host/rb_stage_spill.h
@@ -0,0 +1,76 @@
+// Temporary decoding of large resources. Both the active chain of scratch
+// mappings and each individual write have an enforced disk quota.
+#include <sys/mman.h>
+#if defined(__APPLE__)
+#include <sys/mount.h>
+#else
+#include <sys/statfs.h>
+#endif
+
+static int rb_spill_error(void) { return errno==ENOSPC || errno==EDQUOT ? -2 : -4; }
+
+static int rb_yaz0_fd(const uint8_t *b,size_t n,int fd,uint64_t limit,rb_local_scan *s,uint64_t *decoded) {
+    if (n<16) return 0;
+    uint32_t total=__builtin_bswap32(rb_u32(b+4));
+    if (!total) return 0;
+    if (total>limit) return -2;
+    uint8_t history[4096], output[65536];
+    size_t at=16,done=0,used=0;
+    while (done<total) {
+        if (at>=n) return 0;
+        unsigned flags=b[at++];
+        for (unsigned bit=128;bit && done<total;bit>>=1) {
+            if (at>=n) return 0;
+            unsigned count=1,distance=0,value=0;
+            if (flags&bit) value=b[at++];
+            else {
+                if (n-at<2) return 0;
+                unsigned v=b[at++]; distance=((v&15)<<8)+b[at++]+1; count=v>>4;
+                if (!count) { if (at>=n) return 0; count=b[at++]+18; } else count+=2;
+                if (distance>done || count>total-done) return 0;
+            }
+            while (count--) {
+                uint8_t next=distance?history[(done-distance)&4095]:(uint8_t)value;
+                history[done++&4095]=next; output[used++]=next;
+                if (used==sizeof output) {
+                    if (rb_scan_interrupted(s)) return -1;
+                    if (!rb_stage_write(fd,output,used)) return rb_spill_error();
+                    used=0;
+                }
+            }
+        }
+    }
+    if (used && !rb_stage_write(fd,output,used)) return rb_spill_error();
+    *decoded=done; return 1;
+}
+
+static int rb_stage_spill(rb_local_scan *s,const uint8_t *b,size_t n,unsigned depth,int zstd) {
+    if (!s->scratch || !s->disk_budget || (zstd && !s->spill)) return -2;
+    char tmp[1200];
+    if (snprintf(tmp,sizeof tmp,"%s/.stage-inflate-XXXXXX",s->scratch)>=(int)sizeof tmp) return -4;
+    int fd=mkstemp(tmp);
+    if (fd<0) return rb_spill_error();
+    if (unlink(tmp)) { close(fd); return -4; } // a terminated process cannot strand disk space
+    int rc=-4; uint64_t bytes=0;
+    struct statfs fs;
+    if (fstatfs(fd,&fs)) goto done;
+    uint64_t free_disk=(uint64_t)fs.f_bavail*(uint64_t)fs.f_bsize;
+    const uint64_t reserve=256ull<<20;
+    if (free_disk<=reserve) { rc=-2; goto done; }
+    uint64_t limit=s->disk_budget<free_disk-reserve ? s->disk_budget:free_disk-reserve;
+    if (rb_scan_interrupted(s)) { rc=-1; goto done; }
+    rc=zstd?s->spill(b,n,fd,limit,s->cancel,s->ctx,&bytes):rb_yaz0_fd(b,n,fd,limit,s,&bytes);
+    if (rc==1) {
+        if (!bytes || bytes>limit || bytes>SIZE_MAX) { rc=-2; goto done; }
+        void *mapped=mmap(NULL,(size_t)bytes,PROT_READ,MAP_PRIVATE,fd,0);
+        if (mapped==MAP_FAILED) { rc=errno==ENOMEM?-2:-4; goto done; }
+        madvise(mapped,(size_t)bytes,MADV_SEQUENTIAL);
+        s->disk_budget-=bytes; s->spooled++;
+        rb_scan_blob(s,mapped,(size_t)bytes,depth+1);
+        s->disk_budget+=bytes;
+        munmap(mapped,(size_t)bytes);
+    }
+done:
+    close(fd);
+    return rc;
+}
