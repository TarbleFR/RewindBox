+// RewindBox (patch 0095): IPA 783 Mario Kart World made 2,481,225 yields: 619,602 fresh
+// returns, 178,992 sleeps and 1,682,631 host scheduler yields. The five non-main top yielders
+// (all priority 44) spent 2,980 ms of sampled thread CPU in scheduler yields. For an unchanged
+// low-urgency worker polling at the same call site, begin the existing backoff at 125 µs while
+// cool or fair. The main thread, an explicit backoff setting, fresh rounds and the 50 µs hot
+// path keep their rules. S2A_RB_YIELD_WORKER_IDLE=0 restores the previous threshold.
+static _Atomic uint64_t g_yb_worker_early;
+static int rb_yield_worker_idle(void) {
+    static _Atomic int enabled = -1;
+    int value = atomic_load_explicit(&enabled, memory_order_relaxed);
+    if (value < 0) {
+        const char *setting = getenv("S2A_RB_YIELD_WORKER_IDLE");
+        const char *backoff = getenv("S2A_YIELD_BACKOFF");
+        value = setting && !strcmp(setting, "1") && (!backoff || !*backoff || !strcmp(backoff, "1"));
+        atomic_store_explicit(&enabled, value, memory_order_relaxed);
+    }
+    return value;
+}
