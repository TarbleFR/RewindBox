+    g_exec_next=(const uint8_t *)&end;
+    rb_test_release=dispatch_semaphore_create(0); rb_test_loads=dispatch_group_create();
+    tex_t c0={.serial=10},c1={.serial=11},depth={.serial=12};
+    c0.d.width=c1.d.width=depth.d.width=960; c0.d.height=c1.d.height=depth.d.height=540;
+    p_draw_idx di={.prim=4,.count=72,.instances=1};
+    R.has_rt=1; R.rt=(p_set_rt){.n=2,.color={&c0,&c1},.depth=&depth};
+    R.clear_c[0]=R.clear_c[1]=R.clear_d=1;
+    S.nattr=3; S.chmask.mask=0xff; S.ds.dt=1; S.ds.dw=0; S.ds.df=NVN_DEPTH_FUNC_EQUAL;
+    atomic_store(&g_cur_frame,100);
+    CHECK(rb_first_scene(&di),"MRT material over an existing depth prepass is eligible");
+    R.rt.n=0; CHECK(!rb_first_scene(&di),"depth-only shadow pass stays exact");
+    R.rt.n=1; CHECK(!rb_first_scene(&di),"independent single-color UI stays exact");
+    R.rt.n=2; di.count=3; CHECK(!rb_first_scene(&di),"fullscreen triangle stays exact"); di.count=72;
+    S.tf_on=1; CHECK(!rb_first_scene(&di),"transform feedback stays exact"); S.tf_on=0;
+    g_vis_counting=1; CHECK(!rb_first_scene(&di),"visibility query stays exact"); g_vis_counting=0;
+    uint64_t n=atomic_load(&g_rb_first_shlib_skips), msl=atomic_load(&g_bp_msl_n), waits=atomic_load(&g_shader_waits);
+    CHECK(rb_first_library_pair(pair,keys,rb_test_first_enqueue),"missing library returns while both workers are gated");
+    atomic_store(&g_cur_frame,101);
+    CHECK(rb_first_library_pair(pair,keys,rb_test_first_enqueue),"same pending library may skip the second frame");
+    atomic_store(&g_cur_frame,102);
+    CHECK(!rb_first_library_pair(pair,keys,rb_test_first_enqueue),"third frame requires the exact path");
+    CHECK(atomic_load(&g_rb_first_shlib_skips)==n+2 && atomic_load(&g_bp_msl_n)==msl &&
+          atomic_load(&g_shader_waits)==waits,"two real omissions, zero submit source builds and zero waits");
+    dispatch_semaphore_signal(rb_test_release); dispatch_semaphore_signal(rb_test_release);
+    REQUIRE(!dispatch_group_wait(rb_test_loads,dispatch_time(DISPATCH_TIME_NOW,30*NSEC_PER_SEC)));
+    atomic_store(&g_cur_frame,101);
+    CHECK(!rb_first_library_pair(pair,keys,rb_test_first_enqueue),"ready stages draw immediately even within the window");
+    vertex_gpu(shader_get(keys[0],0),0.25f,0);
+    g_exec_next=next; atomic_store(&g_cur_frame,original_frame);
+    memset(&R.rt,0,sizeof R.rt); R.has_rt=0; R.clear_d=0; R.clear_c[0]=R.clear_c[1]=0;
+    memset(&S.ds,0,sizeof S.ds); S.nattr=0; S.chmask.mask=0;
+    rb_test_loads=nil; rb_test_release=nil;
+}
