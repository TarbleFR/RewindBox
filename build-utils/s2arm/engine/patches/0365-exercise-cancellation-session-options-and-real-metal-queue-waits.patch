+// Empty Metal 4 command buffers require no residency set. Exercise the real
+// dm-encode worker and GPU event dependency even on a paravirtual CI device.
+static int rb_metal_sync_checks(void) {
+    alarm(30);
+    g_dev = MTLCreateSystemDefaultDevice();
+    if (!g_dev || ![g_dev respondsToSelector:@selector(newMTL4CommandQueueWithDescriptor:error:)]) {
+        puts("SKIP Metal 4 queue API unavailable"); return 77;
+    }
+    NSError *error = nil;
+    g_feedback_q = dispatch_queue_create("rb.sync-feedback", DISPATCH_QUEUE_SERIAL);
+    MTL4CommandQueueDescriptor *descriptor = [MTL4CommandQueueDescriptor new];
+    descriptor.feedbackQueue = g_feedback_q;
+    g_q4 = [g_dev newMTL4CommandQueueWithDescriptor:descriptor error:&error];
+    id<MTL4CommandAllocator> first = [g_dev newCommandAllocatorWithDescriptor:[MTL4CommandAllocatorDescriptor new] error:&error];
+    id<MTL4CommandAllocator> shared = [g_dev newCommandAllocatorWithDescriptor:[MTL4CommandAllocatorDescriptor new] error:&error];
+    if (!g_q4 || !first || !shared) {
+        printf("SKIP Metal 4 queue/allocator unavailable: %s\n", error.localizedDescription.UTF8String ?: "no detail");
+        return 77;
+    }
+    id<MTLSharedEvent> gate = [g_dev newSharedEvent], before = [g_dev newSharedEvent];
+    id<MTLSharedEvent> after = [g_dev newSharedEvent], tail = [g_dev newSharedEvent];
+    REQUIRE(gate && before && after && tail);
+    g_m3 = 0; g_rec = 1; g_rb_queue_wait_mode = 1;
+    g_sub_thread = pthread_self(); atomic_store(&g_sub_thread_set, 1);
+    setenv("S2A_RB_ENC_RT", "0", 1);
+    g_cb = rec_cb_new();
+    [g_cb beginCommandBufferWithAllocator:first]; [g_cb endCommandBuffer];
+    rec_commit(g_cb, nil); rec_signal(before, 1); rec_handover();
+    g_cb = rec_cb_new();
+    [g_cb beginCommandBufferWithAllocator:shared];
+    queue_wait_event((__bridge void *)gate, 1);
+    [g_cb endCommandBuffer]; rec_commit(g_cb, nil); rec_signal(after, 1);
+    // Sequential reuse without reset while the earlier CB is pending on gate.
+    g_cb = rec_cb_new();
+    [g_cb beginCommandBufferWithAllocator:shared]; [g_cb endCommandBuffer];
+    rec_commit(g_cb, nil); rec_signal(tail, 1); rec_drain(); g_cb = nil;
+    VERIFY([before waitUntilSignaledValue:1 timeoutMS:5000],
+           "GPU work committed before the recorded wait completes independently");
+    VERIFY(![after waitUntilSignaledValue:1 timeoutMS:50] && tail.signaledValue == 0,
+           "dependent GPU command buffers remain blocked on the real event");
+    gate.signaledValue = 1;
+    VERIFY([after waitUntilSignaledValue:1 timeoutMS:5000] && [tail waitUntilSignaledValue:1 timeoutMS:5000],
+           "both command buffers complete after event release with shared allocator storage");
+    VERIFY(atomic_load(&g_rb_queue_wait_records) == 1 && !atomic_load(&g_rb_queue_wait_drains),
+           "real encode worker executes the recorded GPU wait with no submit-thread drain");
+    printf("Metal 4 sync checks: %u/%u on %s\n", checks - failures, checks, g_dev.name.UTF8String);
+    return failures != 0;
+}
