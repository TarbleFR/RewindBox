diff --git a/graphics/nvn/gfx/nvn/rb_sparse_reclaim.inc b/graphics/nvn/gfx/nvn/rb_sparse_reclaim.inc
new file mode 100644
index 0000000..380ef59
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_sparse_reclaim.inc
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: Apache-2.0
+// Called only from the submit owner before it encodes draws. At most 256
+// virtual tiles and one empty heap are inspected per pass through a candidate.
+static void rb_sp_reclaim(NvSparse *s, uint64_t frame, uint64_t done) {
+    if (!s || !s->guest_pool || s->sess != g_sp_sess || s->gpu ||
+        s->last_fence > done || frame < s->last_frame || frame - s->last_frame < 180) return;
+    id<MTLTexture> texture = s->tex;
+    size_t count = (size_t)s->layers * s->per_layer;
+    if (!texture || !count) return;
+    // A valid live handle can be newly registered into a bindless pool from
+    // another thread. Only unmap a still-backed tile when the source has
+    // been finalized AND no registered descriptor or active stream holds it.
+    // An idle live texture may give back pages already unmapped by the guest.
+    int can_refault = s->source_only && !atomic_load(&s->opaque_access) && rb_sp_closed_source(s);
+    if (!can_refault && (done < g_fence || nvn_sparse_log_seq(s->guest_pool) == s->seq)) return;
+    sp_ops unmaps = {0};
+    sp_look c = { .s = s, .tex = texture, .ops = &unmaps };
+    pthread_mutex_lock(&g_sp_mu);
+    for (size_t step = 0, checks = MIN(count, (size_t)256); step < checks; ++step) {
+        size_t index = s->reclaim_cursor++;
+        if (s->reclaim_cursor >= count) s->reclaim_cursor = 0;
+        uint32_t *slot = &s->slot[index];
+        if (!*slot) continue;
+        const sp_tl *entry = sp_tl_of(*slot - 1);
+        if (entry->rc != 1 || entry->drawn || entry->p <= SP_GONE) continue;
+        uint32_t layer = (uint32_t)(index / s->per_layer), tile = (uint32_t)(index % s->per_layer);
+        uint32_t level = 0, x = 0, y = 0;
+        uint64_t offset = s->tail_off, length = s->layer_size - offset;
+        if (tile == s->tail_at) level = s->ntiled;
+        else {
+            while (level + 1 < s->ntiled && tile >= s->loff_t[level + 1]) ++level;
+            uint32_t local = tile - s->loff_t[level];
+            x = local % s->tiles_x[level]; y = local / s->tiles_x[level];
+            offset = s->loff[level] + (uint64_t)local * SP_TILE;
+            length = SP_TILE;
+        }
+        uint64_t address = s->guest_base + (uint64_t)layer * s->layer_size + offset;
+        int state = nvn_sparse_tile_state(s->guest_pool, address, length, s->gen, entry->stamp);
+        if (state < 0) continue; // Finalized or replaced virtual pool.
+        if (state & 1) {
+            // The typed submit lookup replays mappings and copies before the
+            // next use. An opaque (bindless / view) descriptor may bypass it.
+            if (!can_refault || atomic_load(&s->opaque_access) ||
+                nvn_sparse_tile_phys(s->guest_pool, address) != (const void *)entry->p ||
+                !rb_ws_tile_idle(frame, s->last_frame, done, s->last_fence, 0, entry->rc,
+                                 entry->drawn, !nvn_dirty_since((const void *)entry->p, SP_TILE, entry->stamp))) continue;
+        }
+        if (!sp_move_off(&c, slot, MTLRegionMake3D(x,y,0,1,1,1), level, layer)) break;
+        s->refault = 1;
+        ++rb_sp_reclaimed;
+    }
+    pthread_mutex_unlock(&g_sp_mu);
+    sp_queue(&c); // Queue owns the operations. Retired slots remain fenced.
+}
+
+static void rb_sparse_maintain(void) {
+    if (!rb_sparse_budget_on() || !atomic_load(&g_sp_heap_n)) return;
+    uint64_t budget = (uint64_t)rb_sparse_heap_target() * 256 * RB_WS_MIB;
+    unsigned tier = atomic_load(&rb_gov_plan) & 3u;
+    if (rb_sp_heap_bytes < budget && tier != RB_GOV_CRITICAL) return;
+    if (g_up_cb || atomic_load(&g_up_pending)) return;
+    uint64_t frame = atomic_load(&g_cur_frame);
+    if (frame == rb_sp_sweep_frame) return;
+    rb_sp_sweep_frame = frame;
+    uint64_t done = rc_done();
+    for (unsigned i = 0; i < 4; ++i)
+        rb_sp_reclaim(rb_sp_candidates[rb_sp_walk++ % RB_SP_TRACK], frame, done);
+
+    // Slot numbers of earlier heaps must remain stable for other aliases and
+    // pending unmaps. A trailing heap leaves residency only when every physical
+    // page (including unmaps on the queue) is on the completed free list.
+    id<MTLHeap> retired = nil;
+    pthread_mutex_lock(&g_sp_mu);
+    sp_reap_slots(done);
+    id<MTLHeap> tail = g_sp_heaps.lastObject;
+    if (tail) {
+        uint32_t first = (uint32_t)(g_sp_heaps.count - 1) * g_sp_ht;
+        size_t free_pages = 0;
+        for (size_t i = 0; i < g_sp_nfree; ++i) free_pages += g_sp_free[i] >= first;
+        if (free_pages == tail.size / SP_TILE) {
+            size_t keep = 0;
+            for (size_t i = 0; i < g_sp_nfree; ++i)
+                if (g_sp_free[i] < first) g_sp_free[keep++] = g_sp_free[i];
+            g_sp_nfree = keep;
+            retired = tail;
+            [g_sp_heaps removeLastObject];
+            atomic_fetch_sub(&g_sp_heap_n, 1);
+            rb_sp_heap_bytes -= tail.size;
+            ++rb_sp_retired;
+        }
+    }
+    pthread_mutex_unlock(&g_sp_mu);
+    if (retired) res_remove(retired);
+    static uint64_t last_report = UINT64_MAX;
+    if (last_report == UINT64_MAX || frame < last_report || frame - last_report >= 180 || retired) {
+        last_report = frame;
+        MLOG("[RB-MEM-GOV] sparse active_heaps=%u heap_MiB=%llu target_MiB=%llu metal_MiB=%llu mandatory_overflow=%llu retired_heaps=%llu reclaimed_tiles=%llu refaulted_textures=%llu",
+             atomic_load(&g_sp_heap_n), (unsigned long long)(rb_sp_heap_bytes >> 20),
+             (unsigned long long)(budget >> 20), (unsigned long long)(g_dev.currentAllocatedSize >> 20),
+             (unsigned long long)rb_sp_overflow, (unsigned long long)rb_sp_retired,
+             (unsigned long long)rb_sp_reclaimed, (unsigned long long)rb_sp_refaults);
+    }
+}
diff --git a/graphics/nvn/gfx/nvn/rb_working_set.h b/graphics/nvn/gfx/nvn/rb_working_set.h
new file mode 100644
index 0000000..ad03a48
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_working_set.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+
+#define RB_WS_MIB (UINT64_C(1) << 20)
+static inline uint64_t rb_ws_target(uint64_t recommended) {
+    const uint64_t cap = 5120 * RB_WS_MIB;
+    if (!recommended || recommended >= cap * 100 / 85 + 1) return cap;
+    return recommended * 85 / 100;
+}
+static inline uint64_t rb_ws_room(uint64_t target, uint64_t metal, uint64_t process) {
+    uint64_t remaining = target > metal ? target - metal : 0;
+    return remaining < process ? remaining : process;
+}
+// Placement resources receive up to one seventh of the device recommendation.
+// Express the target in 256-MiB units even if the user selects smaller heaps.
+static inline unsigned rb_ws_sparse_target(uint64_t recommended, unsigned tier) {
+    return tier >= 2 || recommended < UINT64_C(3) * 256 * 7 * RB_WS_MIB ? 2 : 3;
+}
+static inline int rb_ws_tile_idle(uint64_t frame, uint64_t last_frame, uint64_t done,
+                                  uint64_t needed_fence, int pinned, unsigned references,
+                                  int authoritative, int clean_backing) {
+    return !pinned && frame >= last_frame && frame - last_frame >= 180 &&
+           done >= needed_fence && references == 1 && !authoritative && clean_backing;
+}
+// Always fulfill a real mapping. Near the soft ceiling reserve only a small
+// increment, never another 256 MiB for a handful of mandatory pages.
+static inline unsigned rb_ws_heap_pages(unsigned configured, uint64_t committed,
+                                        uint64_t budget, uint64_t room) {
+    const uint64_t page = UINT64_C(65536);
+    uint64_t left = committed < budget ? budget - committed : 0;
+    if (room < left) left = room;
+    uint64_t pages = left / page;
+    if (pages >= configured) return configured;
+    if (pages >= 256) return (unsigned)pages;
+    return configured < 256 ? configured : 256;
+}
diff --git a/graphics/nvn/tests/t_rb_sparse_retire.m b/graphics/nvn/tests/t_rb_sparse_retire.m
new file mode 100644
index 0000000..86edf22
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_sparse_retire.m
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "../gfx/nvn/nvn_mtl.m"
+#define REQUIRE(e) do { if (!(e)) { fprintf(stderr,"sparse retire line %d: %s\n",__LINE__,#e); return 1; } } while (0)
+
+// Supply just the two driver gauges to exercise the production sampler against
+// the device trace, without allocating several GiB on a shared CI Mac.
+@interface RBMemoryGauge : NSObject
+@property(nonatomic) NSUInteger currentAllocatedSize, recommendedMaxWorkingSetSize;
+@end
+@implementation RBMemoryGauge
+@end
+
+// Use a real GPU transfer held behind a shared event. The production free
+// list and empty-heap collector must respect the same completed fence. This
+// exercises completion even on virtual Macs without sparse-placement support.
+int main(void) { @autoreleasepool {
+    g_m3 = 0;
+    setenv("S2A_RB_METAL_WORKING_SET","1",1);
+    setenv("S2A_RB_SPARSE_HEAP_BUDGET","1",1);
+    RBMemoryGauge *probe = [RBMemoryGauge new];
+    probe.recommendedMaxWorkingSetSize = 5461 * RB_WS_MIB;
+    probe.currentAllocatedSize = 4600 * RB_WS_MIB;
+    g_dev = (id<MTLDevice>)probe;
+    rb_gov_sample(0);
+    REQUIRE((atomic_load(&rb_gov_plan) & 3u) < RB_GOV_CRITICAL && rb_metal_working_room() > 0);
+    atomic_store(&rb_gov_next,0);
+    probe.currentAllocatedSize = 4650 * RB_WS_MIB;
+    rb_gov_sample(0);
+    REQUIRE((atomic_load(&rb_gov_plan) & 3u) == RB_GOV_CRITICAL && !rb_metal_working_room());
+    g_dev = MTLCreateSystemDefaultDevice();
+    REQUIRE(g_dev);
+    id<MTLCommandQueue> queue = [g_dev newCommandQueue];
+    id<MTLSharedEvent> gate = [g_dev newSharedEvent];
+    MTLHeapDescriptor *hd = [MTLHeapDescriptor new];
+    hd.size = 16 * RB_WS_MIB;
+    hd.storageMode = MTLStorageModePrivate;
+    hd.type = MTLHeapTypePlacement;
+    id<MTLHeap> heap = [g_dev newHeapWithDescriptor:hd];
+    REQUIRE(heap && gate && queue);
+    // A real resource in the last physical page stands in for a sparse mapping.
+    id<MTLBuffer> page = [heap newBufferWithLength:256 options:MTLResourceStorageModePrivate
+                                            offset:hd.size - SP_TILE];
+    id<MTLBuffer> observed = [g_dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = [queue commandBuffer];
+    REQUIRE(page && observed && cb);
+    [cb encodeWaitForEvent:gate value:1];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    [blit fillBuffer:page range:NSMakeRange(0,256) value:0x5c];
+    [blit copyFromBuffer:page sourceOffset:0 toBuffer:observed destinationOffset:0 size:256];
+    [blit endEncoding];
+    g_sp_ht = (uint32_t)(heap.size / SP_TILE);
+    g_sp_heaps = [NSMutableArray arrayWithObject:heap];
+    atomic_store(&g_sp_heap_n,1);
+    rb_sp_heap_bytes = heap.size;
+    g_sp_free = calloc(g_sp_ht,sizeof *g_sp_free);
+    REQUIRE(g_sp_free);
+    g_sp_freecap = g_sp_ht;
+    for (uint32_t i = 0; i + 1 < g_sp_ht; ++i) g_sp_free[g_sp_nfree++] = i;
+    g_sp_live = 1; g_fence = 0;
+    sp_slot_free(g_sp_ht - 1); // Retirement fence 1; not yet reusable.
+    dispatch_semaphore_t completed = dispatch_semaphore_create(0);
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> command) {
+        if (command.status == MTLCommandBufferStatusCompleted) {
+            pthread_mutex_lock(&g_mu); g_done = 1; pthread_mutex_unlock(&g_mu);
+        }
+        dispatch_semaphore_signal(completed);
+    }];
+    [cb commit];
+    rb_sparse_maintain();
+    REQUIRE(g_sp_heaps.count == 1 && g_sp_nlate == 1 && rb_sp_retired == 0);
+    gate.signaledValue = 1;
+    REQUIRE(!dispatch_semaphore_wait(completed,dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC)));
+    REQUIRE(cb.status == MTLCommandBufferStatusCompleted);
+    for (int i = 0; i < 256; ++i) REQUIRE(((uint8_t *)observed.contents)[i] == 0x5c);
+    atomic_fetch_add(&g_cur_frame,1);
+    rb_sparse_maintain();
+    REQUIRE(!g_sp_heaps.count && !g_sp_nlate && !g_sp_nfree && !rb_sp_heap_bytes && rb_sp_retired == 1);
+    free(g_sp_free); g_sp_free = NULL; free(g_sp_late); g_sp_late = NULL;
+    puts("sparse retire: the live heap survived the pending GPU fence and retired after validated readback");
+    return 0;
+} }
diff --git a/graphics/nvn/tests/t_rb_working_set.c b/graphics/nvn/tests/t_rb_working_set.c
new file mode 100644
index 0000000..7c297b4
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_working_set.c
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "../gfx/nvn/rb_working_set.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    const uint64_t mib = RB_WS_MIB;
+    const uint64_t recommended = 5461 * mib;
+    const uint64_t target = rb_ws_target(recommended);
+    assert(target == recommended * 85 / 100);
+    assert(rb_ws_target(0) == 5120 * mib && rb_ws_target(UINT64_MAX) == 5120 * mib);
+    assert(rb_ws_room(target, target - 1, 6000 * mib) == 1);
+    assert(rb_ws_room(target, 7794 * mib, 4466 * mib) == 0);
+    assert(rb_ws_room(target, 1, 29) == 29);
+    assert(rb_ws_sparse_target(recommended, 0) == 3);
+    assert(rb_ws_sparse_target(recommended, 2) == 2);
+    assert(rb_ws_sparse_target(4096 * mib, 0) == 2);
+    assert(rb_ws_heap_pages(4096, 0, 768 * mib, UINT64_MAX) == 4096);
+    assert(rb_ws_heap_pages(4096, 512 * mib, 768 * mib, 64 * mib) == 1024);
+    assert(rb_ws_heap_pages(4096, 768 * mib, 768 * mib, 0) == 256);
+    assert(!rb_ws_tile_idle(205, 26, 110, 110, 0, 1, 0, 1));
+    assert( rb_ws_tile_idle(206, 26, 110, 110, 0, 1, 0, 1));
+    assert(!rb_ws_tile_idle(206, 26, 109, 110, 0, 1, 0, 1));
+    assert(!rb_ws_tile_idle(206, 26, 110, 110, 1, 1, 0, 1));
+    assert(!rb_ws_tile_idle(206, 26, 110, 110, 0, 2, 0, 1));
+    assert(!rb_ws_tile_idle(206, 26, 110, 110, 0, 1, 1, 1));
+    assert(!rb_ws_tile_idle(206, 26, 110, 110, 0, 1, 0, 0));
+    puts("working set: verified Metal + process budgets, demand increments and sparse ownership");
+}
