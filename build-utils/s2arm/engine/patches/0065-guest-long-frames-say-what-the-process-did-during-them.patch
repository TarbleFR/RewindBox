diff --git a/graphics/nvn/gfx/nvn/hle_nvn.c b/graphics/nvn/gfx/nvn/hle_nvn.c
index f11921e..d1c4581 100644
--- a/graphics/nvn/gfx/nvn/hle_nvn.c
+++ b/graphics/nvn/gfx/nvn/hle_nvn.c
@@ -3121,7 +3121,14 @@ __attribute__((weak)) int dm_thermal_now(void) { return -1; }   // Strong defini
 __attribute__((weak)) int dm_low_power_now(void) { return 0; }   // Low Power Mode (iOS front_ios.m); off on the Mac
 // Per-frame ring for the long-frame log (GPU time only arrives 8 frames late, so store first and judge later)
 #define LFN 16
-typedef struct { uint64_t f; double fr, nv, t_s, make_ms, up_mb, up_ms; unsigned pso, lib, up, rup; } lf_rec;
+// RewindBox (patch 0065): what the process did during the frame, for the line. In the IPA 762 race (Mario Kart World, iPhone17,2) 178 of the 595 long frames from the start
+//   grid on, 13.6 s in all, came out at 60 to 450 ms with 7 to 30 ms in the engine's calls and 10 to 48 ms of GPU time, no pipeline, shader library or upload of note: the rest
+//   of the frame was spent before the game submitted, and the line did not say whether its threads computed, waited, took page faults or read storage. Now it gives the
+//   process's CPU time (all threads) and the presenting thread's during the frame, the page faults (those that read storage apart), the blocks read, the voluntary and
+//   involuntary context switches, the engine's write-protection faults and their mprotect time, and the display-link and present-queue waits. One getrusage call and
+//   one thread clock read a frame
+typedef struct { uint64_t f; double fr, nv, t_s, make_ms, up_mb, up_ms; unsigned pso, lib, up, rup;
+                 double cpu_ms, thr_ms, mp_ms, acq_ms, pq_ms; long flt, majflt, inblk, vcsw, ivcsw; unsigned wpf; } lf_rec;   // cpu_ms ... wpf: patch 0065 (thr_ms -1: the presenting thread changed)
 static lf_rec g_lf[LFN];
 __attribute__((weak)) void dm_longframe_note(const char *what) { LOG("[longframe] %s", what); }   // Default (graphics unit tests); the strong definition in the host's diag.c adds scene context and writes perf.txt
 extern void nvn_be_create_ns(uint64_t *lib_ns, uint64_t *pso_ns); extern uint64_t nvn_be_upload_bytes(void); extern void nvn_be_pkg_stats(uint64_t *uploads, uint64_t *reuploads);
@@ -3646,8 +3653,10 @@ NVN(nvnQueuePresentTexture, void, NVNqueue *q, NVNwindow *w, int idx) {
         static uint64_t pdo; uint64_t do_ = nvn_be_ds_omit(); trow(f, "@ds_omit", (double)(do_ - pdo)); pdo = do_;
         trow(f, "@use_call", (double)(uc_ - puc)); trow(f, "@use_skip", (double)(us_ - pus)); puc = uc_; pus = us_;
         static uint64_t pfa, pre_; uint64_t fa_, pr_, up_, re_; nvn_dirty_stats(&fa_, &pr_); nvn_be_pkg_stats(&up_, &re_);
+        unsigned rb_wpf = (unsigned)(fa_ - pfa);   // RewindBox (patch 0065): for the long-frame line
         trow(f, "@faults", (double)(fa_ - pfa)); trow(f, "@reuploads", (double)(re_ - pre_)); pfa = fa_; pre_ = re_;
         static uint64_t pmc, pmp, pmn; uint64_t mc_, mpg_, mn_; nvn_dirty_mp_stats(&mc_, &mpg_, &mn_);
+        double rb_mp_ms = (mn_ - pmn) / 1e6;   // RewindBox (patch 0065): for the long-frame line
         trow(f, "@mprotect_calls", (double)(mc_ - pmc)); trow(f, "@mprotect_pages", (double)(mpg_ - pmp)); trow(f, "@mprotect_ms", (mn_ - pmn) / 1e6); pmc = mc_; pmp = mpg_; pmn = mn_;
         double up_ms = nvn_be_upload_ns_take() / 1e6; trow(f, "@upload_ms", up_ms);
         trow(f, "@upload_gpu_ms", nvn_be_upload_gpu_ns_take() / 1e6);
@@ -3659,6 +3668,19 @@ NVN(nvnQueuePresentTexture, void, NVNqueue *q, NVNwindow *w, int idx) {
             lf_rec *r = &g_lf[f % LFN]; r->f = f; r->fr = fr; r->nv = nv; r->t_s = (now_ns() - g_t0_ns) / 1e9; r->pso = (unsigned)(pso_ - ppso); r->lib = (unsigned)(lib_ - plib);
             r->make_ms = ((lns - plns) + (pns - ppns)) / 1e6; r->up = (unsigned)(up - pup); r->rup = (unsigned)(rup - prup); r->up_mb = (ub - pub) / 1048576.0; r->up_ms = up_ms;
             plns = lns; ppns = pns; pup = up; prup = rup; pub = ub;
+            {   // RewindBox (patch 0065): what the process did during the frame
+                static struct rusage pru; static int have; static pthread_t pth; static uint64_t pcpu; struct rusage ru;
+                if (!getrusage(RUSAGE_SELF, &ru)) {
+                    if (have) { r->cpu_ms = ((double)(ru.ru_utime.tv_sec - pru.ru_utime.tv_sec) + (double)(ru.ru_stime.tv_sec - pru.ru_stime.tv_sec)) * 1e3 + ((double)(ru.ru_utime.tv_usec - pru.ru_utime.tv_usec) + (double)(ru.ru_stime.tv_usec - pru.ru_stime.tv_usec)) / 1e3;
+                        r->flt = ru.ru_minflt - pru.ru_minflt + ru.ru_majflt - pru.ru_majflt; r->majflt = ru.ru_majflt - pru.ru_majflt; r->inblk = ru.ru_inblock - pru.ru_inblock;
+                        r->vcsw = ru.ru_nvcsw - pru.ru_nvcsw; r->ivcsw = ru.ru_nivcsw - pru.ru_nivcsw; }
+                    else { r->cpu_ms = -1; r->flt = r->majflt = r->inblk = r->vcsw = r->ivcsw = -1; }
+                    pru = ru; have = 1; }
+                else { r->cpu_ms = -1; r->flt = r->majflt = r->inblk = r->vcsw = r->ivcsw = -1; }
+                uint64_t c = clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID); pthread_t th = pthread_self();
+                r->thr_ms = pcpu && pthread_equal(th, pth) ? (double)(c - pcpu) / 1e6 : -1; pth = th; pcpu = c;
+                r->wpf = rb_wpf; r->mp_ms = rb_mp_ms; r->acq_ms = g_acq_wait_ns / 1e6; r->pq_ms = g_pq_wait_ns / 1e6;
+            }
         }
         plib = lib_; ppso = pso_;
         trow(f, "@t_s", (now_ns() - g_t0_ns) / 1e9);
@@ -3673,9 +3695,13 @@ NVN(nvnQueuePresentTexture, void, NVNqueue *q, NVNwindow *w, int idx) {
           // "Long" is relative to recent conditions: when running steadily at 30 fps (menus / windowless host) or under sustained overload, every frame is > 20 ms; those are not long frames and must not flood the log - a frame has to be 40% above the sliding mean of the last 16 frames to count
           static double ef = 16.7, eg = 8; int lf = r->fr > 20.0 && r->fr > 1.4 * ef, lg = g > 16.7 && g > 1.3 * eg;
           if (r->f == f - 8) { ef += ((r->fr < 3 * ef ? r->fr : 3 * ef) - ef) / 16; eg += ((g < 3 * eg ? g : 3 * eg) - eg) / 16; }
-          if (on && r->f == f - 8 && f - 8 > 0 && (lf || lg)) { char b[512];
+          if (on && r->f == f - 8 && f - 8 > 0 && (lf || lg)) { char b[1024];   // RewindBox (patch 0065): 1024, the line is longer
               snprintf(b, sizeof b, "frame %llu (%.2f s) whole frame %.1f ms, submit+present %.1f ms, GPU %.1f ms; new pipelines %u + shader libraries %u, %.1f ms in all; texture uploads %u first + %u re-uploads, %.1f MB / %.1f ms",
                        (unsigned long long)r->f, r->t_s, r->fr, r->nv, g, r->pso, r->lib, r->make_ms, r->up, r->rup, r->up_mb, r->up_ms);
+              { size_t bl = strlen(b);   // RewindBox (patch 0065): the process during the frame (-1 = not known)
+                snprintf(b + bl, sizeof b - bl, "; process CPU %.1f ms (%.1f cores), presenting thread CPU %.1f ms; page faults %ld, %ld of them reading storage; blocks read %ld; context switches %ld voluntary, %ld involuntary; "
+                         "write-protection faults %u, %.1f ms in mprotect; display-link wait %.1f ms, present-queue wait %.1f ms", r->cpu_ms, r->cpu_ms >= 0 && r->fr > 0 ? r->cpu_ms / r->fr : -1.0, r->thr_ms,
+                         r->flt, r->majflt, r->inblk, r->vcsw, r->ivcsw, r->wpf, r->mp_ms, r->acq_ms, r->pq_ms); }
               // Visibility: during the time a long frame "comes out late", what stays on screen is the previous frame; if the previous frame was a loading screen (or this frame itself is one), all the player sees is the loading screen staying a bit longer, with no motion interrupted
               dm_longframe_note(b); } }
         uint64_t g0, g1; if (frame_rec() && nvn_be_gpu_span(f - 8, &g0, &g1)) { trow(f - 8, "@gpu_beg_ms", (g0 - g_t0_ns) / 1e6); trow(f - 8, "@gpu_end_ms", (g1 - g_t0_ns) / 1e6); } }
