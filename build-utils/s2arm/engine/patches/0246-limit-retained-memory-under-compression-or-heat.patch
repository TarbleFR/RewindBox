+// Request VM accounting only while the existing governor is active. One utility
+// job per second at most, no extra timer and no task_info call on the submit thread.
+static void rb_gov_probe_compression(uint64_t now) {
+    if (now < rb_gov_next_probe || atomic_exchange(&rb_gov_probe_pending,1)) return;
+    rb_gov_next_probe = now + NSEC_PER_SEC;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        task_vm_info_data_t info = {0};
+        mach_msg_type_number_t count = TASK_VM_INFO_REV0_COUNT;
+        kern_return_t kr = task_info(mach_task_self(),TASK_VM_INFO,(task_info_t)&info,&count);
+        uint64_t value = kr == KERN_SUCCESS && count >= TASK_VM_INFO_REV0_COUNT ?
+                         (uint64_t)info.compressed : UINT64_MAX;
+        atomic_store_explicit(&rb_gov_compressed,value,memory_order_release);
+        atomic_store(&rb_gov_probe_pending,0);
+    });
+}
