--- a/graphics/nvn/gfx/nvn/rb_gov_plan.h
+++ b/graphics/nvn/gfx/nvn/rb_gov_plan.h
@@ -3,6 +3,37 @@
 #include <stdint.h>
 enum { RB_GOV_PREFETCH, RB_GOV_UPLOAD, RB_GOV_TEXTURE, RB_GOV_PIPELINE };
 enum { RB_GOV_NORMAL, RB_GOV_WARN, RB_GOV_CRITICAL };
+// The pressure counter is TASK_VM_INFO.compressed in logical bytes for this process.
+typedef struct {
+    uint64_t below_since_ns;
+    int active;
+} rb_gov_stress_state;
+
+static inline int rb_gov_stressed(rb_gov_stress_state *state, uint64_t now_ns,
+                                  uint64_t compressed_bytes, int thermal) {
+    int known = compressed_bytes != UINT64_MAX;
+    if (thermal >= 1 || (known && compressed_bytes > (512ull << 20))) {
+        state->active = 1;
+        state->below_since_ns = 0;
+    } else if (state->active) {
+        if (thermal != 0 || !known || compressed_bytes > (448ull << 20)) {
+            state->below_since_ns = 0;
+        } else if (!state->below_since_ns || now_ns < state->below_since_ns) {
+            state->below_since_ns = now_ns;
+        } else if (now_ns - state->below_since_ns >= 10000000000ull) {
+            state->active = 0;
+            state->below_since_ns = 0;
+        }
+    }
+    return state->active;
+}
+
+static inline unsigned rb_gov_ceiling(unsigned tier, int stressed) {
+    if (tier == RB_GOV_CRITICAL) return 32;
+    if (stressed) return 96;
+    return tier == RB_GOV_WARN ? 128 : 512;
+}
+
 // The floor is published with the plan. Transfer its bytes from the texture
 // share, keeping the total exactly equal to the existing governor ceiling.
 #define RB_GOV_PSO_FLOOR (1u << 31)
