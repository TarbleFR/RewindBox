diff --git a/graphics/nvn/tests/t_rb_gov_stress.c b/graphics/nvn/tests/t_rb_gov_stress.c
new file mode 100644
index 0000000000000000000000000000000000000000..772c94d755d9363292f65196964310b34c93f2ec
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_gov_stress.c
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "../gfx/nvn/rb_gov_plan.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    const uint64_t mib = 1ull << 20, sec = 1000000000ull;
+    rb_gov_stress_state state = {0};
+    assert(!rb_gov_stressed(&state,sec,UINT64_MAX,0));
+    assert(!rb_gov_stressed(&state,2*sec,512*mib,0));
+    assert(rb_gov_stressed(&state,3*sec,512*mib+1,0));
+    assert(rb_gov_stressed(&state,4*sec,448*mib,0));
+    assert(rb_gov_stressed(&state,13*sec,448*mib,0));
+    assert(rb_gov_stressed(&state,14*sec,UINT64_MAX,0));
+    assert(rb_gov_stressed(&state,20*sec,448*mib,0));
+    assert(rb_gov_stressed(&state,30*sec,448*mib+1,0));
+    assert(rb_gov_stressed(&state,31*sec,0,0));
+    assert(rb_gov_stressed(&state,41*sec,0,1));
+    assert(rb_gov_stressed(&state,42*sec,0,0));
+    assert(rb_gov_stressed(&state,52*sec-1,0,0));
+    assert(!rb_gov_stressed(&state,52*sec,0,0));
+    for (int thermal=1;thermal<=3;thermal++) {
+        rb_gov_stress_state cold = {0};
+        assert(rb_gov_stressed(&cold,sec,UINT64_MAX,thermal));
+    }
+    assert(rb_gov_ceiling(RB_GOV_NORMAL,0)==512 && rb_gov_ceiling(RB_GOV_WARN,0)==128);
+    assert(rb_gov_ceiling(RB_GOV_CRITICAL,1)==32 && rb_gov_ceiling(RB_GOV_CRITICAL,0)==32);
+    for (int floor=0;floor<=1;floor++) {
+        // headroom_MiB=2533 was the previous return to Normal in the incident.
+        unsigned plan=rb_gov_make_plan(rb_gov_ceiling(RB_GOV_WARN,1),RB_GOV_WARN,2533*mib,floor,0);
+        assert(rb_gov_share(plan,RB_GOV_PREFETCH)==0);
+        assert(rb_gov_share(plan,RB_GOV_UPLOAD)==18*mib);
+        assert(rb_gov_share(plan,RB_GOV_TEXTURE)==(floor ? 54 : 72)*mib);
+        assert(rb_gov_share(plan,RB_GOV_PIPELINE)==(floor ? 24 : 6)*mib);
+        uint64_t sum=0;
+        for (unsigned i=0;i<4;i++) sum+=rb_gov_share(plan,i);
+        assert(sum==96*mib);
+    }
+    puts("PASS memory governor compression, Fair, recovery and owner quotas");
+}
