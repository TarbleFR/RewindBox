new file mode 100644
index 0000000..16d3fde
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_spec_gate.h
@@ -0,0 +1,80 @@
+#ifndef RB_SPEC_GATE_H
+#define RB_SPEC_GATE_H
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <time.h>
+
+enum { RB_SPEC_RUN, RB_SPEC_ONE, RB_SPEC_HOLD };
+enum { RB_SPEC_CLEAR, RB_SPEC_FAIR, RB_SPEC_LOW_POWER, RB_SPEC_HOT, RB_SPEC_LOW_MEMORY };
+// Unknown headroom is UINT64_MAX. For an iOS app, zero may mean that the
+// process limit has already been exceeded; an actual zero is a valid reading.
+static inline uint64_t rb_spec_headroom(uint64_t bytes, int app_or_measured) {
+    return bytes || app_or_measured ? bytes : UINT64_MAX;
+}
+static inline int rb_spec_reason(int thermal, int low_power, uint64_t available, uint64_t floor) {
+    if (thermal >= 2) return RB_SPEC_HOT;
+    if (available < floor) return RB_SPEC_LOW_MEMORY;
+    if (thermal == 1) return RB_SPEC_FAIR;
+    return low_power ? RB_SPEC_LOW_POWER : RB_SPEC_CLEAR;
+}
+static inline int rb_spec_tier(int why) {
+    if (why == RB_SPEC_HOT || why == RB_SPEC_LOW_MEMORY) return RB_SPEC_HOLD;
+    return why == RB_SPEC_CLEAR ? RB_SPEC_RUN : RB_SPEC_ONE;
+}
+static inline int rb_spec_worker_allowed(int level, int worker) {
+    return level == RB_SPEC_RUN || (level == RB_SPEC_ONE && worker == 0);
+}
+
+// Count active optional work, including work admitted in RUN. A transition
+// to ONE lets the old work finish before another producer takes a lease.
+static inline int rb_spec_admit(_Atomic unsigned *active, int level, int worker) {
+    if (!rb_spec_worker_allowed(level, worker)) return 0;
+    if (level == RB_SPEC_ONE) {
+        unsigned idle = 0;
+        return atomic_compare_exchange_strong(active, &idle, 1u);
+    }
+    atomic_fetch_add(active, 1u);
+    return 1;
+}
+
+// Record an epoch before checking the queue. A signal between that check and
+// the wait then makes the wait a no-op. Timed wakeups resample the sensors.
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t changed;
+    _Atomic uint64_t epoch;
+} rb_spec_gate;
+#define RB_SPEC_GATE_INITIALIZER { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, 0 }
+static inline void rb_spec_wake(rb_spec_gate *gate) {
+    pthread_mutex_lock(&gate->mutex);
+    atomic_fetch_add(&gate->epoch, 1);
+    pthread_cond_broadcast(&gate->changed);
+    pthread_mutex_unlock(&gate->mutex);
+}
+static inline void rb_spec_wait(rb_spec_gate *gate, uint64_t ticket) {
+    pthread_mutex_lock(&gate->mutex);
+    if (atomic_load(&gate->epoch) == ticket) {
+        struct timespec ts;
+#if defined(__APPLE__)
+        ts = (struct timespec){0, 250000000};
+        pthread_cond_timedwait_relative_np(&gate->changed, &gate->mutex, &ts);
+#else
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_nsec += 250000000;
+        if (ts.tv_nsec >= 1000000000) { ts.tv_nsec -= 1000000000; ts.tv_sec++; }
+        pthread_cond_timedwait(&gate->changed, &gate->mutex, &ts);
+#endif
+    }
+    pthread_mutex_unlock(&gate->mutex);
+}
+
+enum { RB_ROW_FREE, RB_ROW_CLAIMED, RB_ROW_PROMOTED };
+static inline int rb_promote_row(_Atomic(uint8_t) *row) {
+    uint8_t free_row = RB_ROW_FREE;
+    return atomic_compare_exchange_strong(row, &free_row, RB_ROW_PROMOTED);
+}
+static inline int rb_claim_row(_Atomic(uint8_t) *row) {
+    return atomic_exchange(row, RB_ROW_CLAIMED) != RB_ROW_CLAIMED;
+}
+#endif
