diff --git a/graphics/nvn/tests/t_rb_spec_gate.c b/graphics/nvn/tests/t_rb_spec_gate.c
new file mode 100644
index 0000000..ae939a0
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_spec_gate.c
@@ -0,0 +1,63 @@
+// Host-only admission and wakeup tests. Uses exactly the primitives included
+// by nvn_mtl.m; no Metal device or claims about device timings.
+#define _POSIX_C_SOURCE 200809L
+#include "../gfx/nvn/rb_spec_gate.h"
+#include <assert.h>
+#include <sched.h>
+#include <stdio.h>
+
+enum { WORKERS = 8 };
+static rb_spec_gate gate = RB_SPEC_GATE_INITIALIZER;
+static _Atomic unsigned active, ready, go, tried, finish;
+static _Atomic unsigned promoted, claimed, leases;
+static _Atomic(uint8_t) row;
+static void *race(void *unused) {
+    (void)unused;
+    uint64_t epoch = atomic_load(&gate.epoch);
+    atomic_fetch_add(&ready, 1);
+    while (!atomic_load(&go)) rb_spec_wait(&gate, epoch);
+    if (rb_promote_row(&row)) atomic_fetch_add(&promoted, 1);
+    if (rb_claim_row(&row)) atomic_fetch_add(&claimed, 1);
+    int mine = rb_spec_admit(&active, RB_SPEC_ONE, 0);
+    if (mine) atomic_fetch_add(&leases, 1);
+    atomic_fetch_add(&tried, 1);
+    for (;;) {
+        epoch = atomic_load(&gate.epoch);
+        if (atomic_load(&finish)) break;
+        rb_spec_wait(&gate, epoch);
+    }
+    if (mine) atomic_fetch_sub(&active, 1);
+    return NULL;
+}
+static int tier(int th, int power, uint64_t mem) {
+    return rb_spec_tier(rb_spec_reason(th, power, mem, 768ull << 20));
+}
+int main(void) {
+    const uint64_t floor = 768ull << 20;
+    assert(tier(0, 0, floor) == RB_SPEC_RUN);
+    assert(tier(0, 0, rb_spec_headroom(0, 1)) == RB_SPEC_HOLD);
+    assert(tier(0, 0, rb_spec_headroom(0, 0)) == RB_SPEC_RUN);
+    assert(tier(0, 0, rb_spec_headroom(floor, 1)) == RB_SPEC_RUN);
+    assert(tier(1, 0, UINT64_MAX) == RB_SPEC_ONE && tier(0, 1, UINT64_MAX) == RB_SPEC_ONE);
+    assert(tier(1, 1, floor - 1) == RB_SPEC_HOLD && tier(2, 1, 0) == RB_SPEC_HOLD);
+    assert(tier(3, 0, UINT64_MAX) == RB_SPEC_HOLD && tier(0, 0, floor + 1) == RB_SPEC_RUN);
+    assert(rb_spec_admit(&active, RB_SPEC_RUN, 2) && rb_spec_admit(&active, RB_SPEC_RUN, 0));
+    assert(!rb_spec_admit(&active, RB_SPEC_ONE, 0));
+    atomic_fetch_sub(&active, 2);
+    assert(!rb_spec_admit(&active, RB_SPEC_ONE, 1));
+    assert(!rb_spec_admit(&active, RB_SPEC_HOLD, 0) && !atomic_load(&active));
+    pthread_t workers[WORKERS];
+    for (unsigned i = 0; i < WORKERS; ++i) assert(!pthread_create(&workers[i], NULL, race, NULL));
+    while (atomic_load(&ready) != WORKERS) sched_yield();
+    atomic_store(&go, 1);
+    rb_spec_wake(&gate);
+    while (atomic_load(&tried) != WORKERS) sched_yield();
+    assert(atomic_load(&promoted) == 1 && atomic_load(&claimed) == 1);
+    assert(atomic_load(&leases) == 1 && atomic_load(&active) == 1);
+    atomic_store(&finish, 1);
+    rb_spec_wake(&gate);
+    for (unsigned i = 0; i < WORKERS; ++i) assert(!pthread_join(workers[i], NULL));
+    assert(!atomic_load(&active) && !rb_promote_row(&row) && !rb_claim_row(&row));
+    assert(rb_spec_admit(&active, RB_SPEC_RUN, 1));
+    puts("PASS thermal levels, unknown headroom, draining RUN, shared ONE lease, exclusive queue claims, all waiters released");
+}
