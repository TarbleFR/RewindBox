+static void rb_heap_ledger(unsigned generation, uint64_t frame, uint64_t sample_ns)
+{
+    static unsigned previous_generation;
+    static uint64_t next_ns;
+    if (!rb_heap_measure()) return;
+    if (previous_generation == generation && sample_ns < next_ns) return;
+    const uint64_t minute = 60000000000ull;
+    if (previous_generation != generation || !next_ns) next_ns = sample_ns;
+    next_ns += ((sample_ns - next_ns) / minute + 1) * minute;
+    previous_generation = generation;
+    vm_address_t *zones = NULL;
+    unsigned count = 0, emitted = 0;
+    uint64_t started = rb_vm_now();
+    kern_return_t status = malloc_get_all_zones(mach_task_self(), NULL, &zones, &count);
+    if (status == KERN_SUCCESS && zones) {
+        for (unsigned i = 0; i < count && rb_vm_alive(generation); ++i) {
+            malloc_zone_t *zone = (malloc_zone_t *)(uintptr_t)zones[i];
+            if (!zone || !zone->introspect || !zone->introspect->statistics) continue;
+            malloc_statistics_t stats = {0};
+            malloc_zone_statistics(zone, &stats);
+            const char *name = malloc_get_zone_name(zone);
+            rb_vm_write_json("[RB-VM-HEAP]", @{
+                @"event": @"malloc_zone", @"sample_ns": @(sample_ns),
+                @"generation": @(generation), @"zone_index": @(i),
+                @"name": name ? ([NSString stringWithUTF8String:name] ?: @"unknown") : @"unnamed",
+                @"size_in_use": @(stats.size_in_use), @"size_allocated": @(stats.size_allocated),
+                @"max_size_in_use": @(stats.max_size_in_use)
+            });
+            ++emitted;
+        }
+    }
+    if (!rb_vm_alive(generation)) return;
+    rb_vm_write_json("[RB-VM-HEAP]", @{
+        @"event": @"heap_census", @"schema": @1, @"generation": @(generation),
+        @"frame": @(frame), @"sample_ns": @(sample_ns), @"zone_status": @(status),
+        @"zone_count": @(count), @"zones_reported": @(emitted),
+        @"elapsed_ns": @(rb_vm_now() - started)
+    });
+}
+
 void s2a_rb_vm_ledgers_log(const task_vm_info_data_t *info,
     mach_msg_type_number_t count, kern_return_t kr, unsigned generation,
     uint64_t frame, uint64_t sample_ns)
@@ -296,7 +337,10 @@
             r[@"published_ns"] = @(rb_vm_now());
             r[@"source"] = @"existing_heartbeat_task_info";
             r[@"additional_mach_calls"] = @0;
