diff --git a/runtime/include/rb_heap.h b/runtime/include/rb_heap.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/rb_heap.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdatomic.h>
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#include <malloc/malloc.h>
+#endif
+
+// Process launch switches. Pointers stay in their original allocator and ABI.
+static inline int rb_heap_on(void)
+{
+#if defined(__APPLE__) && TARGET_OS_IOS
+    static _Atomic int cached;
+    int mode = atomic_load_explicit(&cached, memory_order_relaxed);
+    if (!mode) {
+        const char *trim = getenv("S2A_RB_HEAP_TRIM");
+        mode = trim && !strcmp(trim, "0") ? -1 : 1;
+        atomic_store_explicit(&cached, mode, memory_order_relaxed);
+    }
+    return mode > 0;
+#else
+    return 0;
+#endif
+}
+static inline int rb_heap_measure(void)
+{
+    if (!rb_heap_on()) return 0;
+    static _Atomic int cached;
+    int mode = atomic_load_explicit(&cached, memory_order_relaxed);
+    if (!mode) {
+        const char *value = getenv("S2A_RB_HEAP_LEDGER");
+        mode = value && !strcmp(value, "0") ? -1 : 1;
+        atomic_store_explicit(&cached, mode, memory_order_relaxed);
+    }
+    return mode > 0;
+}
+static inline size_t rb_heap_size(const void *p)
+{
+#ifdef __APPLE__
+    return p ? malloc_size(p) : 0;
+#else
+    (void)p;
+    return 0;
+#endif
+}
+// Called only by the thread owning the allocation, before publication/free.
+static inline void *rb_heap_acquire(_Atomic uint64_t *bytes, void *p)
+{
+    if (p && rb_heap_measure())
+        atomic_fetch_add_explicit(bytes, rb_heap_size(p), memory_order_relaxed);
+    return p;
+}
+static inline void rb_heap_free(_Atomic uint64_t *bytes, void *p)
+{
+    if (p && rb_heap_measure())
+        atomic_fetch_sub_explicit(bytes, rb_heap_size(p), memory_order_relaxed);
+    free(p);
+}
