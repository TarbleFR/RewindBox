+__attribute__((visibility("default"), used)) int s2a_rb_guest_parked(void) {
+    return s2a_rb_guest_on() && !atomic_load(&g_ended) && s2a_host_parked();
+}
+
+// Patch 0010: the resume's result, on the session control thread. A failed boot ends the session for the host (the session is
+//   FAILED; another game, or this one, needs a new process).
+static void resume_result(int result, const char *detail, void *context) {
+    (void)context;
+    if (!result) { LOG("RewindBox guest: the parked session resumed"); return; }
+    s2a_rb_guest_ended(EXIT_FAILURE, detail && *detail ? detail : "RewindBox: the parked session could not resume");
+}
+
+int s2a_rb_guest_resume_session(char *error, size_t error_size) {   // ios/app.m s2a_rb_guest_resume, once the view is shown
+    if (!s2a_rb_guest_parked()) return refuse(error, error_size, "the session is not parked");
+    int rc = s2a_host_resume(resume_result, NULL);
+    if (rc) return refuse(error, error_size, "the parked session could not resume now (%d)", rc);
+    LOG("RewindBox guest: resume requested");
+    return 0;
+}
