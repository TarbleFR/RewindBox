 __attribute__((visibility("default"), used)) void s2a_rb_guest_stop(const char *reason) {
     if (!s2a_rb_guest_on() || atomic_load(&g_ended)) return;
     const char *dup = strdup(reason && *reason ? reason : "RewindBox: stop requested"), *why = dup ? dup : "RewindBox: stop requested";   // kept: the shutdown logs it later
     if (!atomic_load(&g_started)) { s2a_rb_guest_ended(0, why); return; }   // nothing started yet: nothing to shut down
+    if (s2a_host_session_state() == S2A_SESSION_RESTARTING || s2a_session_retirement_busy()) {
+        // Patch 0010: a park, a resume or S2Arm's own restart is running; a shutdown on top of it would race its retirement
+        //   or its rebuild. The player can quit again once the game runs.
+        LOG("RewindBox guest: stop ignored (%s): a park, resume or restart is running", why);
+        free((void *)dup);
+        return;
+    }
     LOG("RewindBox guest: stop requested (%s)", why);
+    // Patch 0010: park when the host can resume and the engine can rebuild in-process (S2Arm's restart retirement, no rebuild)
+    if (dup && g_cfg.session_parked && s2a_session_rebuild_supported()) {   // park_result frees dup
+        int rc = s2a_host_park(park_result, (void *)why);
+        if (!rc) return;
+        LOG("RewindBox guest: no park (%d); orderly shutdown", rc);
+    }
     // Same path as the engine's own "quit game" (ios/save_transfer.m): a background queue, never the caller's thread
