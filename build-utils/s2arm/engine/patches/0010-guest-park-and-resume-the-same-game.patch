+// Patch 0010: the park's result, on the session control thread. Parked: tell the host. Refused or failed: the orderly shutdown
+//   as before the patch (it ends with session_ended), so a park never leaves the player without an end.
+static void park_result(int result, const char *detail, void *context) {
+    const char *why = context;
+    if (!result) {
+        LOG("RewindBox guest: session parked (%s); the same game can resume in this process", why);
+        s2a_logcon_flush();
+        if (g_cfg.session_parked) g_cfg.session_parked(why, g_cfg.parked_context);   // the host copies the reason
+        free((void *)why);
+        return;
+    }
+    if (s2a_session_retirement_busy()) {
+        // The retirement worker still owns the services and the GPU (a timeout): a shutdown now would dispose them twice.
+        //   The session ends for the host; this process cannot run another Switch 2 game.
+        LOG("【红】RewindBox guest: the park timed out (%s); the session ends without a shutdown", detail ? detail : "-");
+        s2a_rb_guest_ended(EXIT_FAILURE, detail && *detail ? detail : "RewindBox: the park timed out");
+        free((void *)why);
+        return;
+    }
+    LOG("【红】RewindBox guest: the park failed (%s); orderly shutdown instead", detail ? detail : "-");
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ s2a_host_shutdown(why); });
