--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_energy_guard.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include <stdint.h>
+
+#define RB_ENERGY_SAMPLE_AGE_NS UINT64_C(25000000000)
+#define RB_ENERGY_HOLD_NS UINT64_C(5000000000)
+#define RB_ENERGY_PROBE_MIN_NS UINT64_C(50000)
+#define RB_ENERGY_PROBE_MAX_NS UINT64_C(8000000)
+
+typedef struct {
+    uint64_t observed_ns;
+    uint64_t first_ns;
+    uint64_t baseline_ns;
+    uint64_t capped_since_ns;
+    unsigned over;
+    unsigned recovered;
+} rb_energy_guard;
+
+static inline int rb_energy_probe_valid(uint64_t duration) {
+    return duration >= RB_ENERGY_PROBE_MIN_NS && duration <= RB_ENERGY_PROBE_MAX_NS;
+}
+
+// The probe has a fixed workload. Game GPU time only corroborates that
+// optional work could compete with rendering. Neither value is a clock rate.
+static inline int rb_energy_update(rb_energy_guard *s, uint64_t now, uint64_t observed,
+                                   uint64_t gpu_probe, int busy, int nominal) {
+    if (s->observed_ns && (now < s->observed_ns || now - s->observed_ns > RB_ENERGY_SAMPLE_AGE_NS)) {
+        s->over = s->recovered = 0;
+        s->capped_since_ns = 0;
+        if (!s->baseline_ns) s->first_ns = 0;
+    }
+    if (!observed || observed <= s->observed_ns || observed > now || now - observed > RB_ENERGY_SAMPLE_AGE_NS ||
+        !rb_energy_probe_valid(gpu_probe))
+        return s->capped_since_ns != 0;
+    s->observed_ns = observed;
+    if (!s->baseline_ns) {
+        if (!nominal || !busy) { s->first_ns = 0; return 0; }
+        uint64_t smaller = s->first_ns < gpu_probe ? s->first_ns : gpu_probe;
+        uint64_t larger = s->first_ns > gpu_probe ? s->first_ns : gpu_probe;
+        if (smaller && larger * 4 <= smaller * 5) s->baseline_ns = (smaller + larger) / 2;
+        else s->first_ns = gpu_probe;
+        return 0;
+    }
+    if (!nominal) {
+        s->over = s->recovered = 0;
+        return s->capped_since_ns != 0;
+    }
+    if (gpu_probe * 4 <= s->baseline_ns * 5) {
+        s->over = 0;
+        if (s->recovered < 2) s->recovered++;
+        if (s->capped_since_ns && s->recovered == 2 &&
+            now - s->capped_since_ns >= RB_ENERGY_HOLD_NS)
+            s->capped_since_ns = 0;
+        if (!s->capped_since_ns && busy && gpu_probe < s->baseline_ns)
+            s->baseline_ns = (3 * s->baseline_ns + gpu_probe) / 4;
+    } else if (busy && gpu_probe * 5 >= s->baseline_ns * 8) {
+        s->recovered = 0;
+        if (s->over < 2) s->over++;
+        if (s->over == 2 && !s->capped_since_ns) s->capped_since_ns = now;
+    } else {
+        s->over = s->recovered = 0;
+    }
+    return s->capped_since_ns != 0;
+}
