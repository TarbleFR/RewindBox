+        if (atomic_compare_exchange_strong(&v, &was, x)) MLOG("RewindBox: speculative shader work follows heat, memory and Low Power Mode: %s (S2A_RB_SPEC_GOVERN; patch 0121)", x ? "on" : "off"); }
+    return x;
