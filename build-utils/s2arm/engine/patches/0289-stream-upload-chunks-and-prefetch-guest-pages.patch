diff --git a/graphics/nvn/tests/rb_upload_stream_gpu.inc b/graphics/nvn/tests/rb_upload_stream_gpu.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/tests/rb_upload_stream_gpu.inc
@@ -0,0 +1,67 @@
+// Force two small Fair chunks on the hosted GPU. A real shared event holds the
+// first upload until both command buffers have been built on the submit thread.
+static int rb_test_upload_stream(void) {
+    setenv("S2A_RB_UPLOAD_STAGING_RING","1",1);
+    rb_stage_test=1;
+    id<MTLDevice> device=MTLCreateSystemDefaultDevice(); REQUIRE(device);
+    BOOL direct=NO;
+    if (@available(macOS 26.0,iOS 26.0,*)) {
+        MTLResidencySetDescriptor *probe=[MTLResidencySetDescriptor new]; probe.initialCapacity=4;
+        direct=device.hasUnifiedMemory && [device supportsFamily:MTLGPUFamilyMetal4] &&
+            [device newResidencySetWithDescriptor:probe error:NULL] &&
+            [device newMTL4CommandQueueWithDescriptor:[MTL4CommandQueueDescriptor new] error:NULL];
+    }
+    if (direct) {
+        nvn_be_sub_begin();
+    } else {
+        s2a_mtl_slot_take("upload ring fixture");
+        g_dev=device; g_m3=1; g_q3=[device newCommandQueue]; g_q=g_q3;
+        g_fence3=[device newFence]; g_keep=[NSMutableArray array];
+        g_sub_thread=pthread_self(); atomic_store(&g_sub_thread_set,1);
+        g_cb=[g_q3 commandBuffer];
+    }
+    printf("Upload ring readback on %s (%s)\n",device.name.UTF8String,g_m3 ? "tracked Metal 3" : "direct Metal 4");
+    id main=g_cb; REQUIRE(main);
+    id<MTLSharedEvent> gate=nil;
+    id<MTLCommandBuffer> reserved=nil;
+    if (g_m3) {
+        reserved=[g_q3 commandBuffer]; REQUIRE(reserved); [reserved enqueue];
+    } else {
+        gate=[g_dev newSharedEvent]; REQUIRE(gate); [g_q4 waitForEvent:gate value:1];
+    }
+    MTLTextureDescriptor *desc=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+        width:64 height:1 mipmapped:NO];
+    desc.storageMode=MTLStorageModeShared;
+    id<MTLTexture> a=[g_dev newTextureWithDescriptor:desc], b=[g_dev newTextureWithDescriptor:desc];
+    REQUIRE(a && b); res_add(a); res_add(b);
+    size_t start;
+    id<MTLBuffer> first=rb_stage_take(16*RB_STAGE_MIB,&start,1);
+    REQUIRE(first && !start); size_t old=(size_t)rb_stage_current;
+    uint8_t *p=first.contents; memset(p,0x53,256);
+    REQUIRE(up_blit_add(first,start,256,256,MTLSizeMake(64,1,1),a,0,0));
+    id<MTLBuffer> second=rb_stage_take(1,&start,1);
+    REQUIRE(second && !start && first!=second && atomic_load(&rb_stage_busy[old]));
+    id<MTLBuffer> slice=rb_stage_take(256,&start,1);
+    CHECK(slice==second && start==256 && second.cpuCacheMode==MTLCPUCacheModeWriteCombined,
+          "crossing the chunk while the first upload waits uses a distinct shared write-combined buffer and aligned slice");
+    memset((uint8_t *)second.contents+start,0xad,256);
+    REQUIRE(up_blit_add(second,start,256,256,MTLSizeMake(64,1,1),b,0,0));
+    up_flush_cause(UP_BOUNDARY);
+    CHECK(g_cb==main && atomic_load(&rb_stage_completions)==0,"two blit command buffers leave the main command buffer open");
+    if (reserved) [reserved commit]; else gate.signaledValue=1;
+    rec_drain(); up_wait_zero(&g_up_pending);
+    uint8_t left[256]={0},right[256]={0};
+    [a getBytes:left bytesPerRow:256 fromRegion:MTLRegionMake2D(0,0,64,1) mipmapLevel:0];
+    [b getBytes:right bytesPerRow:256 fromRegion:MTLRegionMake2D(0,0,64,1) mipmapLevel:0];
+    unsigned wrong=0;
+    for (size_t i=0;i<256;i++) wrong+=left[i]!=0x53 || right[i]!=0xad;
+    CHECK(!wrong && atomic_load(&rb_stage_completions)==2,
+          "both upload completions retired, all 128 texture pixels match across the held fence");
+    CHECK(rb_stage_take(1,&start,1)==first && !start,"the completed first slot becomes reusable");
+    up_flush(); rec_drain(); up_wait_zero(&g_up_pending);
+    if (direct) {
+        uint64_t fence=nvn_be_sub_commit(); REQUIRE(nvn_be_wait(fence,10ull*NSEC_PER_SEC));
+    } else g_cb=nil;
+    rb_stage_retire(); res_remove(a); res_remove(b);
+    return failures!=0;
+}
