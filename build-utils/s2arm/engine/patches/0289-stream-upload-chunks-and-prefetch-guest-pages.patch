diff --git a/graphics/nvn/tests/t_rb_upload_stream.c b/graphics/nvn/tests/t_rb_upload_stream.c
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_upload_stream.c
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "../gfx/nvn/rb_stream_budget.h"
+#include "../gfx/nvn/rb_file_hint.h"
+#include <assert.h>
+#include <stdio.h>
+int main(void) {
+    uint64_t m=RB_STAGE_MIB,room=3ull<<30;
+    rb_stage_plan nominal=rb_stage_policy(0,room,UINT64_MAX,0);
+    rb_stage_plan fair=rb_stage_policy(1,room,UINT64_MAX,0);
+    assert(nominal.chunk==32*m && nominal.limit==128*m);
+    assert(fair.chunk==16*m && fair.limit==32*m);
+    assert(rb_stage_policy(2,room,UINT64_MAX,0).limit==16*m);
+    assert(rb_stage_policy(0,room,UINT64_MAX,1).limit==16*m);
+    assert(rb_stage_policy(0,room,20*m,0).limit==20*m);
+    assert(!rb_stage_policy(0,1024*m,UINT64_MAX,0).limit);
+    assert(rb_stage_policy(1,1028*m,UINT64_MAX,0).limit==4*m);
+    assert(!rb_stage_metal_limit(fair,16*m,0).limit);
+    assert(rb_stage_metal_limit(fair,16*m,3*m).limit==19*m);
+    assert(rb_stage_metal_limit(fair,16*m,UINT64_MAX).limit==32*m);
+    uint64_t off,n;
+    assert(rb_stage_slice(255,512,256,&off) && off==256);
+    assert(!rb_stage_slice(255,512,257,&off));
+    assert(!rb_stage_slice(UINT64_MAX,UINT64_MAX,1,&off));
+    assert(!rb_stage_slice(0,m,0,&off));
+    assert(rb_stream_window(0x1000,8192,4095,4097,&off,&n) && off==0x1fff && n==4097);
+    assert(!rb_stream_window(0x1000,8192,-1,1,&off,&n));
+    assert(!rb_stream_window(0x1000,8192,1,8192,&off,&n));
+    assert(!rb_stream_window(UINT64_MAX-7,64,8,1,&off,&n));
+    assert(!rb_stream_window(UINT64_MAX-7,64,0,8,&off,&n));
+    rb_stream_range seen={0x1fff,0x3000,100};
+    assert(rb_stream_recent(&seen,0x2000,4096,349));
+    assert(!rb_stream_recent(&seen,0x2000,4096,350));
+    assert(!rb_stream_recent(&seen,0x2000,4097,200));
+    assert(!rb_stream_recent(&seen,UINT64_MAX,1,200));
+    rb_file_budget shared={0};
+    assert(rb_file_hint_admit(&shared,1000,room,16384,2*m,16384,0));
+    assert(rb_file_hint_admit(&shared,1000,room,16384,2*m,16384,0));
+    assert(!rb_file_hint_admit(&shared,1000,room,16385,1,16384,0));
+    assert(!rb_file_hint_admit(&shared,1100,2ull<<30,16385,1,16384,0));
+    assert(rb_file_hint_admit(&shared,1100,room,16385,1,16384,0));
+    puts("PASS staging sizes, pressure/headroom quotas, overflow, boundary crossings, file windows, expiry, and shared read-ahead budget");
+}
