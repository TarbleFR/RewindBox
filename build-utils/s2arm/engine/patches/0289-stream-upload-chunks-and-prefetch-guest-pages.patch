diff --git a/graphics/nvn/gfx/nvn/rb_guest_hint.h b/graphics/nvn/gfx/nvn/rb_guest_hint.h
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_guest_hint.h
@@ -0,0 +1,7 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+enum { RB_RANGE_FLUSH, RB_RANGE_MAP, RB_RANGE_VERTEX, RB_RANGE_REPLAY, RB_RANGE_KINDS };
+typedef struct { uint64_t base,capacity; int64_t offset; uint64_t bytes; unsigned source; } rb_guest_hint;
+int nvn_be_guest_hint_on(void);
+void nvn_be_guest_range_hint(rb_guest_hint h);
diff --git a/graphics/nvn/gfx/nvn/rb_guest_range.inc b/graphics/nvn/gfx/nvn/rb_guest_range.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_guest_range.inc
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "rb_guest_hint.h"
+enum { RB_RANGE_RECENT=32, RB_RANGE_PENDING=8, RB_RANGE_POSTS=16, RB_RANGE_PERIOD_MS=100 };
+static pthread_mutex_t rb_ranges_lock=PTHREAD_MUTEX_INITIALIZER;
+static rb_stream_range rb_ranges[RB_RANGE_RECENT];
+static uint64_t rb_ranges_epoch,rb_ranges_window;
+static unsigned rb_ranges_cursor,rb_ranges_pending,rb_ranges_posts;
+static dispatch_queue_t rb_ranges_queue; // protected by rb_ranges_lock
+static _Atomic int rb_ranges_option;
+static _Atomic uint64_t rb_ranges_queued[RB_RANGE_KINDS],rb_ranges_duplicate,rb_ranges_refused,rb_ranges_advised;
+int nvn_be_guest_hint_on(void) {
+    return g_dev && !g_m3 &&
+        rb_pacing_setting(&rb_ranges_option,"S2A_RB_GUEST_RANGE_PREFETCH");
+}
+static void rb_range_read(uint64_t address,uint64_t bytes,uint64_t epoch,uint64_t posted) {
+    uint64_t now=bp_now()/NSEC_PER_MSEC;
+    if (dm_gfx_session_stopping() || nvn_be_stopping() || now-posted>=250 ||
+        epoch!=atomic_load(&rb_ra_backing_epoch) || atomic_load(&g_fu_waiting) ||
+        !rb_wn_on() || rb_cached_thermal()>=2 || rb_mem_low() || !rb_ra_scale(RA_BIND) ||
+        rb_metal_working_room()<bytes ||
+        !s2a_guest_in_file(address,bytes) || !rb_file_hint_admit(&rb_bind_budget,now,
+            rb_stream_headroom(),address,bytes,(unsigned)getpagesize(),0)) {
+        atomic_fetch_add_explicit(&rb_ranges_refused,1,memory_order_relaxed);
+        return;
+    }
+    // rb_wn runs mincore on the worker. F_RDADVISE applies to confirmed missing
+    // pages in current file descriptors, including splits between backing files.
+    uint64_t before=atomic_load_explicit(&rb_bind_advised,memory_order_relaxed);
+    rb_bind_fd_only=1;
+    (void)rb_wn((const void *)(uintptr_t)address,bytes,RA_BIND,epoch);
+    rb_bind_fd_only=0;
+    uint64_t after=atomic_load_explicit(&rb_bind_advised,memory_order_relaxed);
+    atomic_fetch_add_explicit(&rb_ranges_advised,after-before,memory_order_relaxed);
+}
+void nvn_be_guest_range_hint(rb_guest_hint h) {
+    uint64_t addr,length;
+    if (h.source>=RB_RANGE_KINDS || !rb_stream_window(h.base,h.capacity,h.offset,h.bytes,&addr,&length) ||
+        dm_gfx_session_stopping() || nvn_be_stopping() || pthread_mutex_trylock(&rb_ranges_lock)) return;
+    length=MIN(length,(uint64_t)RB_HINT_MAX_ITEM);
+    uint64_t now=bp_now()/NSEC_PER_MSEC,epoch=atomic_load(&rb_ra_backing_epoch);
+    if (rb_ranges_epoch!=epoch) { memset(rb_ranges,0,sizeof rb_ranges); rb_ranges_epoch=epoch; }
+    if (now-rb_ranges_window>=RB_RANGE_PERIOD_MS) { rb_ranges_posts=0; rb_ranges_window=now; }
+    // Cap producer submissions even when the worker can immediately reject
+    // anonymous ranges. Bind-heavy command lists must not wake it for every draw.
+    if (rb_ranges_pending>=RB_RANGE_PENDING || rb_ranges_posts>=RB_RANGE_POSTS || nvn_be_stopping()) {
+        atomic_fetch_add_explicit(&rb_ranges_refused,1,memory_order_relaxed);
+        pthread_mutex_unlock(&rb_ranges_lock);
+        return;
+    }
+    for (unsigned i=0;i<RB_RANGE_RECENT;++i) if (rb_stream_recent(&rb_ranges[i],addr,length,now)) {
+        atomic_fetch_add_explicit(&rb_ranges_duplicate,1,memory_order_relaxed);
+        pthread_mutex_unlock(&rb_ranges_lock);
+        return;
+    }
+    rb_ranges[rb_ranges_cursor++%RB_RANGE_RECENT]=(rb_stream_range){addr,addr+length,now};
+    rb_ranges_pending++; rb_ranges_posts++;
+    atomic_fetch_add_explicit(&rb_ranges_queued[h.source],1,memory_order_relaxed);
+    rb_ranges_queue=rb_guest_page_queue();
+    dispatch_async(rb_ranges_queue, ^{ @autoreleasepool {
+        rb_range_read(addr,length,epoch,now);
+        pthread_mutex_lock(&rb_ranges_lock);
+        rb_ranges_pending--;
+        pthread_mutex_unlock(&rb_ranges_lock);
+    }});
+    pthread_mutex_unlock(&rb_ranges_lock);
+}
+static void rb_range_mark(dispatch_group_t closing) {
+    pthread_mutex_lock(&rb_ranges_lock);
+    if (rb_ranges_queue) dispatch_group_async(closing,rb_ranges_queue,^{});
+    pthread_mutex_unlock(&rb_ranges_lock);
+}
+static void rb_range_reset(void) {
+    // All producers stopped and the marker retired before the old mapping can close.
+    rb_ranges_queue=nil; rb_ranges_cursor=rb_ranges_posts=0; rb_ranges_epoch=rb_ranges_window=0;
+    memset(rb_ranges,0,sizeof rb_ranges);
+    for (unsigned i=0;i<RB_RANGE_KINDS;++i) atomic_store(&rb_ranges_queued[i],0);
+    atomic_store(&rb_ranges_duplicate,0); atomic_store(&rb_ranges_refused,0);
+    atomic_store(&rb_ranges_advised,0); atomic_store(&rb_ranges_option,0);
+}
+static void rb_range_report(uint64_t frame) {
+    if (frame%300 || !nvn_be_guest_hint_on()) return;
+    MLOG("[rb-guest-pages] frame=%llu flush=%llu map=%llu record=%llu replay=%llu duplicate=%llu held=%llu file_bytes_advised=%llu",
+        (unsigned long long)frame,(unsigned long long)atomic_load(&rb_ranges_queued[RB_RANGE_FLUSH]),
+        (unsigned long long)atomic_load(&rb_ranges_queued[RB_RANGE_MAP]),(unsigned long long)atomic_load(&rb_ranges_queued[RB_RANGE_VERTEX]),
+        (unsigned long long)atomic_load(&rb_ranges_queued[RB_RANGE_REPLAY]),(unsigned long long)atomic_load(&rb_ranges_duplicate),
+        (unsigned long long)atomic_load(&rb_ranges_refused),(unsigned long long)atomic_load(&rb_ranges_advised));
+}
diff --git a/graphics/nvn/gfx/nvn/rb_stage_ring.inc b/graphics/nvn/gfx/nvn/rb_stage_ring.inc
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_stage_ring.inc
@@ -0,0 +1,136 @@
+// Submit is the sole allocator. Completion owns only the atomic busy flag.
+// The real upload CB already runs independently of the main CB and is
+// committed in the ordered stream after any sparse mapping it consumes.
+static _Atomic int rb_stage_option;
+static id<MTLBuffer> rb_stage_buffers[RB_STAGE_SLOTS];
+static _Atomic int rb_stage_busy[RB_STAGE_SLOTS];
+static uint64_t rb_stage_ticket[RB_STAGE_SLOTS], rb_stage_sequence;
+static int rb_stage_current=-1;
+static size_t rb_stage_used;
+static uint64_t rb_stage_held,rb_stage_peak,rb_stage_bytes,rb_stage_slices,rb_stage_rollovers,rb_stage_waits;
+static _Atomic uint64_t rb_stage_completions,rb_stage_other;
+static int rb_cached_thermal(void);
+#ifdef RB_TEST_FIRST_FRAME
+static int rb_stage_test; // exercises the same copy and completion on hosted Metal
+#endif
+static int rb_stage_enabled(void) {
+#ifdef RB_TEST_FIRST_FRAME
+    if (rb_stage_test) return rb_pacing_setting(&rb_stage_option,"S2A_RB_UPLOAD_STAGING_RING");
+#endif
+    return g_dev && !g_m3 && rb_pacing_setting(&rb_stage_option,"S2A_RB_UPLOAD_STAGING_RING");
+}
+static uint64_t rb_stream_headroom(void) {
+#if TARGET_OS_IPHONE
+    return rb_gov_on() ? atomic_load_explicit(&rb_gov_room,memory_order_relaxed) : rb_ios_headroom();
+#else
+    uint64_t limit=g_dev.recommendedMaxWorkingSetSize,used=g_dev.currentAllocatedSize;
+    return used<limit ? limit-used : 0;
+#endif
+}
+static rb_stage_plan rb_stage_current_plan(void) {
+#ifdef RB_TEST_FIRST_FRAME
+    if (rb_stage_test) return rb_stage_policy(1,4ull<<30,32*RB_STAGE_MIB,0);
+#endif
+    uint64_t room=rb_stream_headroom();
+    if (room==UINT64_MAX) room=0; // unavailable hosted memory reading
+    uint64_t quota=rb_gov_on()?rb_gov_quota(RB_GOV_UPLOAD):UINT64_MAX;
+    uint64_t other=atomic_load_explicit(&rb_stage_other,memory_order_relaxed)+g_up_keep_bytes;
+    for (int i=0;i<rb_up_n();i++) other+=g_up_slot_blk[i].length;
+    rb_stage_plan plan=rb_stage_policy(rb_cached_thermal(),room,quota>other ? quota-other : 0,rb_mem_low());
+    return rb_stage_metal_limit(plan,rb_stage_held,rb_metal_working_room());
+}
+// The governor samples at 2 Hz. Multiple streamed chunks can grow in one
+// interval, so check the device again only when about to allocate a new chunk.
+static int rb_stage_can_grow(uint64_t chunk) {
+#ifdef RB_TEST_FIRST_FRAME
+    if (rb_stage_test) return 1;
+#endif
+    if (!rb_working_set_on()) return 1;
+    uint64_t target=rb_ws_target(g_dev.recommendedMaxWorkingSetSize);
+    return chunk<=rb_metal_working_room() && chunk<=rb_ws_room(target,g_dev.currentAllocatedSize,UINT64_MAX);
+}
+static void rb_stage_trim(rb_stage_plan plan) {
+    for (int i=0;i<RB_STAGE_SLOTS;i++) {
+        if (i==rb_stage_current || atomic_load_explicit(&rb_stage_busy[i],memory_order_acquire)) continue;
+        id<MTLBuffer> b=rb_stage_buffers[i];
+        if (b && (b.length>plan.chunk || rb_stage_held>plan.limit)) {
+            rb_stage_held-=b.length;
+            res_remove(b); rb_stage_buffers[i]=nil;
+        }
+    }
+}
+// Safe only between independently recorded copies. Never call this after
+// up_tex_src has lent a resource to the current upload command buffer.
+static void rb_stage_boundary(size_t bytes) {
+    if (rb_stage_current<0 || !bytes || bytes>32*RB_STAGE_MIB || !on_sub_thread()) return;
+    uint64_t offset;
+    if (rb_stage_slice(rb_stage_used,rb_stage_buffers[rb_stage_current].length,bytes,&offset)) return;
+    up_flush_cause(UP_BATCH_LIMIT);
+    rb_stage_rollovers++;
+    if (g_rb_started) rec_publish(); // hand off only already-recorded blocks; no main commit or encoder wait
+}
+static void up_begin(void);
+static id<MTLBuffer> rb_stage_take(size_t bytes,size_t *offset,int may_roll) {
+    if (!rb_stage_enabled() || !on_sub_thread() || !bytes || bytes>32*RB_STAGE_MIB) return nil;
+    if (may_roll) rb_stage_boundary(bytes);
+    int slot=rb_stage_current;
+    if (slot<0) {
+        rb_stage_plan plan=rb_stage_current_plan();
+        rb_stage_trim(plan);
+        if (bytes>plan.chunk || plan.limit<plan.chunk) return nil;
+        int free_slot=-1,oldest=-1;
+        for (int i=0;i<RB_STAGE_SLOTS;i++) {
+            if (!atomic_load_explicit(&rb_stage_busy[i],memory_order_acquire)) {
+                if (rb_stage_buffers[i].length>=bytes) { slot=i; break; }
+                if (!rb_stage_buffers[i] && free_slot<0) free_slot=i;
+            } else if (rb_stage_buffers[i].length>=bytes &&
+                      (oldest<0 || rb_stage_ticket[i]<rb_stage_ticket[oldest])) oldest=i;
+        }
+        if (slot<0 && free_slot>=0 && rb_stage_held<=plan.limit-plan.chunk && rb_stage_can_grow(plan.chunk)) {
+            id<MTLBuffer> b=[g_dev newBufferWithLength:plan.chunk
+                options:MTLResourceStorageModeShared|MTLResourceCPUCacheModeWriteCombined];
+            if (b) {
+                slot=free_slot; rb_stage_buffers[slot]=b; res_add(b);
+                rb_stage_held+=b.length; rb_stage_peak=MAX(rb_stage_peak,rb_stage_held);
+            }
+        }
+        // Backpressure at the memory ceiling only waits for one actual upload.
+        // The encoder thread can submit it even inside a geometry recording lane.
+        if (slot<0 && oldest>=0 && may_roll) {
+            if (g_rb_started) rec_publish();
+            rb_stage_waits++; up_wait_zero(&rb_stage_busy[oldest]); slot=oldest;
+            if (rb_stage_buffers[slot].length>plan.chunk) return nil;
+        }
+        if (slot<0) return nil;
+        if (!g_up_cb) up_begin();
+        rb_stage_current=slot; rb_stage_used=0;
+        rb_stage_ticket[slot]=++rb_stage_sequence;
+        atomic_store_explicit(&rb_stage_busy[slot],1,memory_order_release);
+    }
+    uint64_t start;
+    if (!rb_stage_slice(rb_stage_used,rb_stage_buffers[slot].length,bytes,&start)) return nil;
+    *offset=(size_t)start; rb_stage_used=*offset+bytes;
+    rb_stage_bytes+=bytes; rb_stage_slices++;
+    return rb_stage_buffers[slot];
+}
+
+static void rb_stage_maintain(void) {
+    if (!rb_stage_held) return;
+    uint64_t frame=atomic_load_explicit(&g_cur_frame,memory_order_relaxed);
+    static uint64_t sampled=UINT64_MAX;
+    if (frame==sampled) return;
+    sampled=frame;
+    rb_stage_trim(rb_stage_current_plan());
+    if (frame%300==0)
+        MLOG("[rb-upload-ring] MiB=%llu peak_MiB=%llu copied_MiB=%llu slices=%llu upload_commits=%llu completed=%llu slot_waits=%llu",
+             (unsigned long long)(rb_stage_held>>20),(unsigned long long)(rb_stage_peak>>20),
+             (unsigned long long)(rb_stage_bytes>>20),(unsigned long long)rb_stage_slices,
+             (unsigned long long)rb_stage_rollovers,(unsigned long long)atomic_load(&rb_stage_completions),
+             (unsigned long long)rb_stage_waits);
+}
+static void rb_stage_retire(void) {
+    // session_wait_backend joined every upload completion before reaching here.
+    rb_stage_trim((rb_stage_plan){0});
+    rb_stage_peak=rb_stage_bytes=rb_stage_slices=rb_stage_rollovers=rb_stage_waits=0;
+    atomic_store(&rb_stage_completions,0); atomic_store(&rb_stage_option,0);
+}
diff --git a/graphics/nvn/gfx/nvn/rb_stream_budget.h b/graphics/nvn/gfx/nvn/rb_stream_budget.h
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_stream_budget.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+
+#define RB_STAGE_MIB (UINT64_C(1) << 20)
+enum { RB_STAGE_SLOTS = 4 };
+typedef struct { uint64_t chunk, limit; } rb_stage_plan;
+static inline rb_stage_plan rb_stage_policy(unsigned thermal, uint64_t room, uint64_t quota, int pressure) {
+    uint64_t chunk=(thermal || pressure ? 16 : 32)*RB_STAGE_MIB;
+    uint64_t limit=(pressure || thermal>=2 ? 1 : thermal ? 2 : RB_STAGE_SLOTS)*chunk;
+    if (quota<limit) limit=quota;
+    if (room<=1024*RB_STAGE_MIB) limit=0;
+    else if (room-1024*RB_STAGE_MIB<limit) limit=room-1024*RB_STAGE_MIB;
+    return (rb_stage_plan){chunk,limit};
+}
+// Device room is additional capacity beyond already allocated ring bytes.
+// Exhaustion asks the owner to return every idle slot; GPU-owned slots retire normally.
+static inline rb_stage_plan rb_stage_metal_limit(rb_stage_plan plan,uint64_t held,uint64_t room) {
+    if (!room) plan.limit=0;
+    else if (held<plan.limit && room<plan.limit-held) plan.limit=held+room;
+    return plan;
+}
+static inline int rb_stage_slice(uint64_t used,uint64_t capacity,uint64_t bytes,uint64_t *offset) {
+    if (!bytes || used>UINT64_MAX-255) return 0;
+    uint64_t start=(used+255)&~UINT64_C(255);
+    if (start>capacity || bytes>capacity-start) return 0;
+    *offset=start;
+    return 1;
+}
+typedef struct { uint64_t begin,end,tick; } rb_stream_range;
+static inline int rb_stream_window(uint64_t base,uint64_t capacity,int64_t offset,uint64_t size,
+                                   uint64_t *addr,uint64_t *length) {
+    if (!base || offset<0 || !size || (uint64_t)offset>=capacity || size>capacity-(uint64_t)offset ||
+        base>UINT64_MAX-(uint64_t)offset || base+(uint64_t)offset>UINT64_MAX-size) return 0;
+    *addr=base+(uint64_t)offset;
+    *length=size;
+    return 1;
+}
+static inline int rb_stream_recent(const rb_stream_range *recent,uint64_t a,uint64_t n,uint64_t ms) {
+    return n && a<=UINT64_MAX-n && recent->begin<=a && a+n<=recent->end &&
+           ms>=recent->tick && ms-recent->tick<250;
+}
