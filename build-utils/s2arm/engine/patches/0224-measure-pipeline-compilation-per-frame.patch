+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+
+// Relaxed cumulative counters, sampled once on presentation. Work finishing
+// concurrently can span samples; worker durations are not frame wall time.
+enum {
+    RB_PSO_HIT, RB_PSO_QUEUED, RB_PSO_SKIPPED, RB_PSO_SYNC,
+    RB_PSO_EARLY_R, RB_PSO_EARLY_C, RB_PSO_JOIN, RB_PSO_JOIN_NS,
+    RB_PSO_R_WARM_HIT, RB_PSO_R_WARM_MISS, RB_PSO_R_PLAY_HIT, RB_PSO_R_PLAY_MISS,
+    RB_PSO_C_WARM_HIT, RB_PSO_C_WARM_MISS, RB_PSO_C_PLAY_HIT, RB_PSO_C_PLAY_MISS,
+    RB_PSO_R_SUB_N, RB_PSO_R_SUB_NS, RB_PSO_R_BG_N, RB_PSO_R_BG_NS,
+    RB_PSO_C_SUB_N, RB_PSO_C_SUB_NS, RB_PSO_C_BG_N, RB_PSO_C_BG_NS,
+    RB_PSO_MSL_N, RB_PSO_MSL_NS, RB_PSO_COUNTERS
+};
+typedef struct { uint64_t value[RB_PSO_COUNTERS]; } rb_pso_activity;
