+        "compute_link_submit=%llu/%.2fms compute_link_worker=%llu/%.2fms "
+        "archive_hit_miss_render_warm=%llu/%llu render_play=%llu/%llu compute_warm=%llu/%llu compute_play=%llu/%llu",
+        label, (unsigned long long)f, s->mode == 2, (unsigned long long)v[RB_PSO_HIT],
+        (unsigned long long)v[RB_PSO_QUEUED], (unsigned long long)v[RB_PSO_SKIPPED],
+        (unsigned long long)v[RB_PSO_SYNC], (unsigned long long)v[RB_PSO_EARLY_R],
+        (unsigned long long)v[RB_PSO_EARLY_C], (unsigned long long)v[RB_PSO_JOIN], v[RB_PSO_JOIN_NS]/1e6,
+        (unsigned long long)v[RB_PSO_MSL_N], v[RB_PSO_MSL_NS]/1e6,
+        (unsigned long long)v[RB_PSO_R_SUB_N], v[RB_PSO_R_SUB_NS]/1e6,
+        (unsigned long long)v[RB_PSO_R_BG_N], v[RB_PSO_R_BG_NS]/1e6,
+        (unsigned long long)v[RB_PSO_C_SUB_N], v[RB_PSO_C_SUB_NS]/1e6,
+        (unsigned long long)v[RB_PSO_C_BG_N], v[RB_PSO_C_BG_NS]/1e6,
+        (unsigned long long)v[RB_PSO_R_WARM_HIT], (unsigned long long)v[RB_PSO_R_WARM_MISS],
+        (unsigned long long)v[RB_PSO_R_PLAY_HIT], (unsigned long long)v[RB_PSO_R_PLAY_MISS],
+        (unsigned long long)v[RB_PSO_C_WARM_HIT], (unsigned long long)v[RB_PSO_C_WARM_MISS],
+        (unsigned long long)v[RB_PSO_C_PLAY_HIT], (unsigned long long)v[RB_PSO_C_PLAY_MISS]);
+}
+
+static int dcmp(const void *, const void *);
+static void rb_pso_frame_sample(uint64_t frame) {
+    static double waits[TWIN];
+    static rb_pso_activity previous;
+    static rb_pso_sample window;
+    static unsigned frames;
+    rb_pso_activity now;
+    rb_pso_sample *s = &rb_pso_frames[frame % LFN];
+    s->mode = nvn_rb_pso_activity ? nvn_rb_pso_activity(&now) : 0;
+    if (!s->mode) { frames = 0; window.mode = 0; return; }
+    if (!frame || s->mode != window.mode) {
+        // First present establishes the boundary for gameplay deltas. Include
+        // boot work as labelled process totals, even with the first GPU sample pending.
+        s->counts = now;
+        rb_pso_emit("pso-first-present-process", frame, s);
+        memset(&window, 0, sizeof window);
+        memset(&s->counts, 0, sizeof s->counts);
+        window.mode = s->mode;
+        frames = 0;
+    } else {
+        for (unsigned i = 0; i < RB_PSO_COUNTERS; ++i) {
+            s->counts.value[i] = now.value[i] - previous.value[i];
+            window.counts.value[i] += s->counts.value[i];
+        }
+        waits[frames] = s->counts.value[RB_PSO_JOIN_NS] / 1e6;
+        if (++frames == TWIN) {
+            qsort(waits, frames, sizeof *waits, dcmp);
+            LOG("[pso-waits] frame=%llu samples=%u critical_join_p95_ms=%.2f critical_join_max_ms=%.2f",
+                (unsigned long long)frame, frames, waits[(frames * 95 + 99) / 100 - 1], waits[frames - 1]);
+            rb_pso_emit("pso-window", frame, &window);
+            memset(&window.counts, 0, sizeof window.counts);
+            frames = 0;
+        }
+    }
+    previous = now;
+}
