+#include "rb_pso_activity.h"
+int nvn_rb_pso_activity(rb_pso_activity *out) {
+    int mode = rb_pso_mode();
+    if (!mode) return 0;
+    nvn_rb_async_pso_snapshot(out->value);
+    rb_par_snapshot(out->value + RB_PSO_R_WARM_HIT);
+    out->value[RB_PSO_MSL_N] = atomic_load_explicit(&g_rb_msl_n, memory_order_relaxed);
+    out->value[RB_PSO_MSL_NS] = atomic_load_explicit(&g_rb_msl_ns, memory_order_relaxed);
+    return mode;
+}
