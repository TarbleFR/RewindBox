+static void clear_mip(tex_t *depth, unsigned level, float value, unsigned stencil) {
+    struct { op_hdr header; p_clear_tex clear; op_hdr end; } cmd = {
+        .header={OP_CLEAR_TEX,sizeof(op_hdr)+sizeof(p_clear_tex)}, .end={OP_END,sizeof(op_hdr)},
+        .clear={.tex=depth,.view={.set_levels=1,.base_level=level},.has_view=1,
+                .value_type=CLEAR_TEX_FLOAT,.r={0,0,0,4>>level,4>>level,1},.mask=0xf},
+    };
+    cmd.clear.c.f[0]=value; cmd.clear.c.u[1]=stencil;
+    nvn_be_exec((const uint8_t *)&cmd);
+}
+
+static void verify_depth_mip(id<MTLTexture> texture, unsigned level, float depth, uint8_t stencil) {
+    REQUIRE(texture);
+    unsigned w=4>>level;
+    id<MTLBuffer> buffer=[g_dev newBufferWithLength:512 options:MTLResourceStorageModeShared];
+    id<MTLCommandQueue> queue=[g_dev newCommandQueue];
+    id<MTLCommandBuffer> cb=[queue commandBuffer];
+    id<MTLBlitCommandEncoder> copy=[cb blitCommandEncoder];
+    REQUIRE(buffer && copy);
+    [copy copyFromTexture:texture sourceSlice:0 sourceLevel:level sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(w,w,1) toBuffer:buffer destinationOffset:0
+        destinationBytesPerRow:w*4 destinationBytesPerImage:w*w*4 options:MTLBlitOptionDepthFromDepthStencil];
+    [copy copyFromTexture:texture sourceSlice:0 sourceLevel:level sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(w,w,1) toBuffer:buffer destinationOffset:256
+        destinationBytesPerRow:w destinationBytesPerImage:w*w options:MTLBlitOptionStencilFromDepthStencil];
+    [copy endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    REQUIRE(cb.status==MTLCommandBufferStatusCompleted);
+    const float *depths=buffer.contents;
+    const uint8_t *stencils=(const uint8_t *)buffer.contents+256;
+    for (unsigned i=0;i<w*w;++i) {
+        REQUIRE(depths[i]==depth);
+        REQUIRE(stencils[i]==stencil);
+    }
+    CHECK(1,"mip %u: all %u depth and stencil values match",level,w*w);
+}
+
+static void shadow_atlas(id<MTLLibrary> library, NvProg *reader, tex_t *depth, tex_t *out,
+                         const p_draw *triangle) {
+    NvProg *caster=[NvProg new];
+    caster->sh[0]=reader->sh[0];
+    caster->sh[1]=shader(library,@"depth_only",1);
+    strlcpy(caster->sh[1]->key,"dddddddddddddddd_b",sizeof caster->sh[1]->key);
+    caster->sh[1]->rf.color_mask=0;
+    prog_t p={.magic=MAGIC('P','R','O','G'),.serial=nvn_new_serial()};
+    serial_put(p.serial,caster);
+    nvn_be_sub_begin(); state_reset(); S.prog=&p;
+    S.tex[1][0]=4; S.tex[1][1]=2;
+    targets(NULL,NULL,out); R.rt.n=0; R.rt.color[2]=NULL; R.rt.depth=depth;
+    view_t view={.set_levels=1,.base_level=0,.nlevels=1};
+    R.rt.dview=view; R.rt.has_dview=1;
+    nvn_be_reg_tex(4,depth,&view);
+    clear_mip(depth,0,0.25f,0x15);
+    uint64_t copies=g_fb_depth, bytes=g_fb_depth_bytes;
+    draw(triangle,NULL);
+    binding("depth-only fragment attachment",caster->sh[1],depth,1);
+    REQUIRE(g_fb_depth-copies==1);
+    const char *setting=getenv("S2A_RB_SHADOW_MIP_CACHE");
+    const int precise=setting && !strcmp(setting,"1") && !rb_dsnap_strict();
+    for (unsigned i=0;i<16;++i) {
+        clear_mip(depth,1,0.75f,(uint8_t)(0x20+i));
+        draw(triangle,NULL);
+    }
+    CHECK(g_fb_depth-copies==(precise ? 1 : 17),
+          "depth copies=%llu logical_snapshot_bytes=%llu after 16 disjoint clears",
+          (unsigned long long)(g_fb_depth-copies),(unsigned long long)(g_fb_depth_bytes-bytes));
+    clear_mip(depth,0,0.375f,0x42);
+    uint64_t before_overlap=g_fb_depth;
+    draw(triangle,NULL);
+    CHECK(g_fb_depth-before_overlap==1,"overlapping clear refreshes the snapshot");
+    id<MTLTexture> snapshot=g_dsnap.use.parentTexture ?: g_dsnap.use;
+    finish();
+    verify_depth_mip(snapshot,0,0.375f,0x42);
+    verify_depth_mip(tex_mtl(depth),0,0.375f,0x42);
+    verify_depth_mip(tex_mtl(depth),1,0.75f,0x2f);
+}
