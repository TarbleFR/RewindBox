diff --git a/graphics/nvn/gfx/nvn/rb_piece_hold.h b/graphics/nvn/gfx/nvn/rb_piece_hold.h
new file mode 100644
index 0000000..57b14cd
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_piece_hold.h
@@ -0,0 +1,35 @@
+// RewindBox (patch 0337): when the end of a submission piece waits for the encode thread. Pure C.
+//   A submit call (nvn_be_submit, nvn_be_xq_flush) replays its streams in pieces (nvn_xqueue.inc xq_piece): one, plus one for each queue a cross-queue event wait parked and
+//   the call resumes. Every piece ended with rec_drain, the submit thread waiting until dm-encode had made every recorded call. Mario Kart World, IPA 827, race: about 8 pieces a
+//   frame (2 submit calls, 5.6 to 6.0 resumed pieces), 0.43 to 0.49 ms a frame of that wait in the resumed pieces alone, on the thread the frame waits for.
+//   The wait guards nothing between two pieces of one call: a record holds a reference to every object it names (rec_obj), the next piece takes a command allocator, a
+//   visibility buffer and arena blocks only once the GPU is past their fence, which it can be only after dm-encode committed their work, the memory-pressure handler's idle
+//   release needs the GPU done with the last fence, and a segment cut (sub_cut) already commits mid-piece without the wait. So a piece followed by another of the same call
+//   only hands its records over (rec_handover); the call's end waits once, as before, so what follows a submit call (present, acquire, CPU waits, other threads) finds
+//   dm-encode idle exactly as in IPA 829. A piece outside a submit call (nvn_frame_rec.inc) keeps its wait. S2A_RB_PIECE_DRAIN=1 waits after every piece as before.
+#pragma once
+#include <stdint.h>
+
+typedef struct {
+    int depth;              // submit calls open on the submit thread (xq_force inside nvn_be_submit nests)
+    int each;               // S2A_RB_PIECE_DRAIN=1: every piece waits, as in IPA 829
+    uint64_t held;          // pieces handed over without a wait since the call began
+    uint64_t pieces_held;   // totals, for the 3000-submission line
+    uint64_t calls_waited;
+} rb_piece_hold;
+
+static inline int rb_piece_drain_each_asked(const char *value) { return value && value[0] == '1' && !value[1]; }
+static inline void rb_piece_call_enter(rb_piece_hold *h) { h->depth++; }
+// A piece ends: 1 = wait for the encode thread now (rec_drain), 0 = hand the records over only (rec_handover); the call's end waits.
+static inline int rb_piece_end_waits(rb_piece_hold *h) {
+    if (h->each || h->depth <= 0) return 1;
+    h->held++; h->pieces_held++;
+    return 0;
+}
+// A submit call returns: 1 = wait for the encode thread now (its pieces were handed over without a wait), 0 = nothing to wait for (or still inside an outer call).
+static inline int rb_piece_call_leave(rb_piece_hold *h) {
+    if (h->depth > 0) h->depth--;
+    if (h->depth || !h->held) return 0;
+    h->held = 0; h->calls_waited++;
+    return 1;
+}
