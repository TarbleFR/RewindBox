diff --git a/graphics/nvn/gfx/nvn/rb_fallback30.h b/graphics/nvn/gfx/nvn/rb_fallback30.h
new file mode 100644
index 0000000..4bab29a
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_fallback30.h
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: MIT
+// RewindBox (patch 0349): a steady 30 when a game cannot hold 60, with retries of 60. Pure C, no Metal: the decision hle_nvn.c (rb_fb30_frame) takes once a present and
+//   present_itv applies (rb_fb30_itv). Tests: tests/t_rb_fallback30.c (kept out of the repository with the local fixtures of 0332+).
+//   Four iPhone 16 Pro Max logs (engine 0332-0340). Zelda 0400486024DEC000 stays at present interval 1 in play and showed 28.5 fps there (median of 44 windows of 300 frames, all
+//   at thermal state Serious; 7.7 to 47.3): 79 % of its displayed intervals missed 16.7 ms, 21 % were 16.7 ms, 54 to 70 % 33.3 ms and 9 to 25 % 50 ms or more. Nothing reacted,
+//   as the game never asks for interval 2. In the 16 of those windows with a GPU p50 under 25 ms (35.1 fps, 63 % of the intervals late) at most 6.9 % of the intervals were
+//   50 ms or more: held two vsyncs at the same cost, at least 93 % would be on time at 33.3 ms. Games that hold 60 stay far from the entry: menus at 60 were 0.2 to 1.4 % late
+//   (Zelda), 0 to 12 % out of race (Mario Kart World, one transition window at 59 %); the in-game Zelda windows that kept 40 to 47 fps were 26 to 40 % late, the others 59 to 99 %.
+//   Entry, both at once: RB_FB30_ENTER_LATE of the last RB_FB30_WIN intervals of frames sent at interval 1 later than 16.77 ms (rb_display_deadline's rule; a frame the
+//   system discarded counts as late), and the median cost of the last frames (critical path or GPU time, as fstep_tick) at most 28.3 ms (0.85 x 33.3, nvn_fstep.h's FSTEP_FIT):
+//   30 has to be within reach. 20 of the 41 heavy Zelda windows had a GPU p50 of 16.9 to 27.9 ms; the other 21 (28.6 to 33.7 ms, 27.5 fps) stay as they are.
+//   Back to 60: a trial once RB_FB30_RUN frames in a row cost at most 14.2 ms (0.85 x 16.7), after a wait of 60 vsyncs doubled by each failed trial up to 480 (nvn_fstep.h's
+//   FSTEP_HOLD0 and FSTEP_HOLD_MAX); a probe whatever the cost after 600 vsyncs doubled by each failed probe up to 9600 (an iPhone lowers its GPU clock to a longer hold, so
+//   the cost at 30 may never fit 60 again: nvn_fstep.h, Breath of the Wild 14.4 -> ~25 ms of GPU at hold 2), whose first RB_FB30_GRACE frames may be late while the clock rises
+//   (FSTEP_GRACE). Both waits count in the hold from the entry or the end of the last trial or probe, the trial first when both are due.
+//   A trial or probe is judged on its own frames' intervals (the hold class 1; those still on screen from the hold come 8 presents late and do not count): it
+//   fails on RB_FB30_LATE_RUN late frames in a row, or when half of its RB_FB30_RUN frames are late (the entry's share); a return that does not hold RB_FB30_KEEP vsyncs (30 s)
+//   at 60 before the entry comes true again counts as a failure of its kind, and one that holds them sets both waits back to their start. The heavy Zelda phases lasted 3,300
+//   to 9,300 frames (110 to 330 s): 10, 20, 40, 80 then 160 s between probes make at most 5 failed probes a phase.
+//   Not eligible, at once: k = 1 and the windows start again (the waits keep their length)
+//   Review (24 November): the entry needs a full window of RB_FB30_WIN intervals and lateness the cost explains: the median cost above RB_FB30_FIT60_MS, so a loading
+//   screen or a menu transition of cheap late frames, or a game whose own CPU time (not in the cost) makes it late, is not held; 30 within reach is read on the GPU time,
+//   as the cost read at 60 counts the queue behind the previous frame. A trial or probe fails on RB_FB30_LATE_RUN = 5 late frames in a row (3 failed a phase that holds 60
+//   on one spike: real lateness comes in runs of 3 to 5, nvn_fstep.h); a present counts RB_FB30_DT_MAX vsyncs at most (a compile stall or a stay in the background is
+//   not time held, nor a return kept); a hold whose GPU time falls under RB_FB30_LIGHTER of the one at its last failed probe probes again from the first wait
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_FB30_WIN = 120, RB_FB30_ENTER_LATE = 60, RB_FB30_COSTS_MIN = 30, RB_FB30_RUN = 30, RB_FB30_GRACE = 30, RB_FB30_LATE_RUN = 5 };
+#define RB_FB30_LATE60_MS 16.77          // an interval of a frame sent at 16.67 ms is late past this (rb_display_deadline: a tenth of a millisecond of timestamp rounding)
+#define RB_FB30_LATE30_MS 33.43          // ... of a frame sent at 33.3 ms (counted for the log only)
+#define RB_FB30_FIT30_MS 28.3            // a cost that leaves room in 33.3 ms (0.85 x 33.3)
+#define RB_FB30_FIT60_MS 14.2            // a cost that leaves room in 16.7 ms (0.85 x 16.7)
+#define RB_FB30_TRIAL_WAIT0 60.0         // vsyncs (1/60 s) in the hold before a trial, doubled by each failed one
+#define RB_FB30_TRIAL_WAIT_MAX 480.0
+#define RB_FB30_PROBE_WAIT0 600.0        // vsyncs in the hold before a probe, doubled by each failed one
+#define RB_FB30_PROBE_WAIT_MAX 9600.0
+#define RB_FB30_KEEP 1800.0              // vsyncs at 60 after a return before it counts as kept
+#define RB_FB30_DT_MAX 4.0               // review: the vsyncs one present counts at most
+#define RB_FB30_LIGHTER 0.75             // review: a hold this much lighter on the GPU than at its last failed probe probes again from RB_FB30_PROBE_WAIT0
+
+enum { RB_FB30_WATCH, RB_FB30_HELD, RB_FB30_TRIAL, RB_FB30_PROBE };   // k = 2 in RB_FB30_HELD only
+enum { RB_FB30_EV_NONE, RB_FB30_EV_ENTER, RB_FB30_EV_TRIAL, RB_FB30_EV_PROBE, RB_FB30_EV_TRIAL_FAILED, RB_FB30_EV_PROBE_FAILED, RB_FB30_EV_TRIAL_HELD,
+       RB_FB30_EV_PROBE_HELD, RB_FB30_EV_KEPT, RB_FB30_EV_EXIT };
+typedef struct {
+    int mode;                                          // RB_FB30_WATCH, _HELD, _TRIAL, _PROBE
+    uint8_t late[RB_FB30_WIN]; int li, ln, nlate;      // the last intervals of frames sent at interval 1: 1 = late (ring, filled, late ones)
+    uint8_t fit[RB_FB30_WIN]; int fi, fn, nfit, nfit60; // the last frames: bit 0 = GPU time at most RB_FB30_FIT30_MS (nfit), bit 1 = cost at most RB_FB30_FIT60_MS (nfit60)
+    int fit_run;                                       // in the hold: costs in a row at most RB_FB30_FIT60_MS
+    double trial_wait, probe_wait, since;              // vsyncs: the waits, and the time in the hold since the entry or the end of the last trial or probe
+    int judged, tlate, late_run, grace;                // a trial or probe: its frames judged, late, late in a row; frames left of a probe's grace
+    int back;                                          // a return to 60 not kept yet: 1 a trial's, 2 a probe's (0 none)
+    double at60;                                       // vsyncs at 60 since the return or the watch began
+    double gpu60, gpu30;                               // GPU ms a frame at 60 (running mean, 1/32) and in the hold (1/8), for the log
+    double fail_gpu30;                                 // review: gpu30 at the last failed probe (0: none since the last reset)
+    uint64_t entries, trials, probes, trial_fails, probe_fails, kept, exits;
+    unsigned w_presents, w_held, w_n60, w_late60, w_n30, w_late30;   // the window of the caller's log line (rb_fb30_window_reset)
+    int event;                                         // RB_FB30_EV_* of the last step
+} rb_fb30;
+
+// S2A_RB_FALLBACK30: on when not set or any value but "0"
+static inline int rb_fb30_switch(const char *value) { return !(value && !strcmp(value, "0")); }
+// S2A_RB_FALLBACK30_OFF=<program id>[,<program id>...]: whether id is listed (separators , space ; tab; hexadecimal ids in either case), as nvn_mtl.m rb_no_lock_seen_listed
+static inline int rb_fb30_listed(const char *list, const char *id) {
+    if (!list || !id || !*id) return 0;
+    const size_t n = strlen(id);
+    for (const char *q = list; *q; ) {
+        while (*q == ',' || *q == ' ' || *q == ';' || *q == '\t') q++;
+        const char *e = q;
+        while (*e && *e != ',' && *e != ' ' && *e != ';' && *e != '\t') e++;
+        int same = (size_t)(e - q) == n;
+        for (size_t i = 0; same && i < n; i++) {
+            char x = q[i], y = id[i];
+            if (x >= 'a' && x <= 'z') x = (char)(x - 32);
+            if (y >= 'a' && y <= 'z') y = (char)(y - 32);
+            same = x == y;
+        }
+        if (same) return 1;
+        q = e;
+    }
+    return 0;
+}
+// The vsyncs present_itv follows: two while the fallback holds a game sent at interval 1 (k == 2), the game's own interval otherwise
+static inline int rb_fb30_itv(int itv, int k) { return itv < 2 && k == 2 ? 2 : itv; }
+static inline int rb_fb30_k(const rb_fb30 *s) { return s->mode == RB_FB30_HELD ? 2 : 1; }
+static inline void rb_fb30_ring(uint8_t *ring, int *i, int *n, int *count, int v) {
+    if (*n == RB_FB30_WIN) *count -= ring[*i]; else ++*n;
+    ring[*i] = (uint8_t)v; *count += v; *i = (*i + 1) % RB_FB30_WIN;
+}
+static inline void rb_fb30_clear_late(rb_fb30 *s) { s->li = s->ln = s->nlate = 0; }
+static inline void rb_fb30_clear_fit(rb_fb30 *s) { s->fi = s->fn = s->nfit = s->nfit60 = 0; s->fit_run = 0; }
+static inline void rb_fb30_fit(rb_fb30 *s, double cost_ms, double gpu_ms) {   // a frame's cost into the window (review: two bits, see fit)
+    const double g = gpu_ms > 0 ? gpu_ms : cost_ms;
+    const int v = (g <= RB_FB30_FIT30_MS) | (cost_ms <= RB_FB30_FIT60_MS) << 1;
+    if (s->fn == RB_FB30_WIN) { const int o = s->fit[s->fi]; s->nfit -= o & 1; s->nfit60 -= o >> 1; } else s->fn++;
+    s->fit[s->fi] = (uint8_t)v; s->nfit += v & 1; s->nfit60 += v >> 1; s->fi = (s->fi + 1) % RB_FB30_WIN;
+}
+static inline int rb_fb30_e1(const rb_fb30 *s) { return s->ln == RB_FB30_WIN && s->nlate >= RB_FB30_ENTER_LATE; }   // review: a full window
+// 30 within reach (the median GPU time at most RB_FB30_FIT30_MS) and the lateness explained by the cost (its median above RB_FB30_FIT60_MS: review)
+static inline int rb_fb30_e2(const rb_fb30 *s) { return s->fn >= RB_FB30_COSTS_MIN && 2 * s->nfit >= s->fn && 2 * s->nfit60 < s->fn; }
+static inline double rb_fb30_twice(double wait, double max) { return wait * 2 < max ? wait * 2 : max; }
+static inline void rb_fb30_window_reset(rb_fb30 *s) { s->w_presents = s->w_held = s->w_n60 = s->w_late60 = s->w_n30 = s->w_late30 = 0; }
+
+// Once a present. elig: the game may be held (every condition but the frames' own, hle_nvn.c rb_fb30_why). cls: the hold class, in vsyncs, of the interval judged at this
+//   present (rb_shown_hold: 1 = frames sent at 16.67 ms, 2 = at 33.3 ms; 0 = none), shown_ms that interval (< 0: discarded by the system; 0: not known). cost_ms: the cost
+//   of a frame whose GPU work completed since the last call (<= 0: none new), gpu_ms its GPU time. dt: vsyncs since the last call. Returns k, the vsyncs the next frames are held
+static inline int rb_fb30_step(rb_fb30 *s, int elig, unsigned cls, double shown_ms, double cost_ms, double gpu_ms, double dt) {
+    s->event = RB_FB30_EV_NONE;
+    if (!s->trial_wait) s->trial_wait = RB_FB30_TRIAL_WAIT0;
+    if (!s->probe_wait) s->probe_wait = RB_FB30_PROBE_WAIT0;
+    s->w_presents++;
+    if (!elig) {   // E0 dropped: the game's own interval at once
+        if (s->mode != RB_FB30_WATCH) { s->exits++; s->event = RB_FB30_EV_EXIT; }
+        s->mode = RB_FB30_WATCH; s->back = 0; s->at60 = 0;
+        rb_fb30_clear_late(s); rb_fb30_clear_fit(s);
+        return 1;
+    }
+    if (!(dt > 0)) dt = 0; else if (dt > RB_FB30_DT_MAX) dt = RB_FB30_DT_MAX;   // review: a stall is not time held
+    int late = -1;   // the interval of a frame sent at interval 1, judged against 16.77 ms (-1: none at this present)
+    if (cls == 1 && shown_ms != 0) { late = shown_ms < 0 || shown_ms > RB_FB30_LATE60_MS; s->w_n60++; s->w_late60 += (unsigned)late; }
+    else if (cls == 2 && shown_ms != 0) { s->w_n30++; s->w_late30 += shown_ms < 0 || shown_ms > RB_FB30_LATE30_MS; }
+    const int fresh = cost_ms > 0;
+    switch (s->mode) {
+    case RB_FB30_WATCH:
+        s->at60 += dt;
+        if (late >= 0) rb_fb30_ring(s->late, &s->li, &s->ln, &s->nlate, late);
+        if (fresh) {
+            rb_fb30_fit(s, cost_ms, gpu_ms);
+            if (gpu_ms > 0) s->gpu60 = s->gpu60 > 0 ? s->gpu60 + (gpu_ms - s->gpu60) / 32 : gpu_ms;
+        }
+        if (s->back && s->at60 >= RB_FB30_KEEP) {   // the return held: both waits start again
+            s->kept++; s->back = 0; s->trial_wait = RB_FB30_TRIAL_WAIT0; s->probe_wait = RB_FB30_PROBE_WAIT0; s->fail_gpu30 = 0; s->event = RB_FB30_EV_KEPT;
+        }
+        if (rb_fb30_e1(s) && rb_fb30_e2(s)) {
+            if (s->back == 1) { s->trial_fails++; s->trial_wait = rb_fb30_twice(s->trial_wait, RB_FB30_TRIAL_WAIT_MAX); }   // the trial's return did not hold
+            else if (s->back == 2) { s->probe_fails++; s->probe_wait = rb_fb30_twice(s->probe_wait, RB_FB30_PROBE_WAIT_MAX); }
+            s->back = 0; s->mode = RB_FB30_HELD; s->entries++;
+            s->since = 0; s->fit_run = 0; s->gpu30 = 0;   // the late ring stays for the caller's line: nothing reads it before a return or an exit clears it
+            s->event = RB_FB30_EV_ENTER;
+        }
+        break;
+    case RB_FB30_HELD:   // the intervals of frames sent at interval 1 here are those presented before the entry (8 presents late): no use
+        s->since += dt;
+        if (fresh) {
+            s->fit_run = cost_ms <= RB_FB30_FIT60_MS ? s->fit_run + 1 : 0;
+            if (gpu_ms > 0) s->gpu30 = s->gpu30 > 0 ? s->gpu30 + (gpu_ms - s->gpu30) / 8 : gpu_ms;
+            if (s->fail_gpu30 > 0 && s->gpu30 > 0 && s->gpu30 < RB_FB30_LIGHTER * s->fail_gpu30) { s->probe_wait = RB_FB30_PROBE_WAIT0; s->fail_gpu30 = 0; }   // review: a lighter phase
+        }
+        if (s->fit_run >= RB_FB30_RUN && s->since >= s->trial_wait) { s->mode = RB_FB30_TRIAL; s->trials++; s->grace = 0; s->event = RB_FB30_EV_TRIAL; }
+        else if (s->since >= s->probe_wait) { s->mode = RB_FB30_PROBE; s->probes++; s->grace = RB_FB30_GRACE; s->event = RB_FB30_EV_PROBE; }
+        if (s->mode != RB_FB30_HELD) { s->judged = s->tlate = s->late_run = 0; s->fit_run = 0; s->since = 0; }
+        break;
+    default:   // a trial or probe of 60, judged on its own frames
+        if (late < 0) break;
+        if (s->grace > 0) { s->grace--; break; }
+        s->judged++; s->tlate += late; s->late_run = late ? s->late_run + 1 : 0;
+        if (s->late_run >= RB_FB30_LATE_RUN || (s->judged >= RB_FB30_RUN && 2 * s->tlate >= s->judged)) {
+            if (s->mode == RB_FB30_PROBE) { s->probe_fails++; s->probe_wait = rb_fb30_twice(s->probe_wait, RB_FB30_PROBE_WAIT_MAX); s->fail_gpu30 = s->gpu30; s->event = RB_FB30_EV_PROBE_FAILED; }
+            else { s->trial_fails++; s->trial_wait = rb_fb30_twice(s->trial_wait, RB_FB30_TRIAL_WAIT_MAX); s->event = RB_FB30_EV_TRIAL_FAILED; }
+            s->mode = RB_FB30_HELD; s->fit_run = 0; s->since = 0;   // both waits count from the end of the last attempt
+        } else if (s->judged >= RB_FB30_RUN) {   // held: 60 from here, kept once it lasts RB_FB30_KEEP vsyncs
+            s->back = s->mode == RB_FB30_PROBE ? 2 : 1;
+            s->event = s->mode == RB_FB30_PROBE ? RB_FB30_EV_PROBE_HELD : RB_FB30_EV_TRIAL_HELD;
+            s->mode = RB_FB30_WATCH; s->at60 = 0;
+            rb_fb30_clear_late(s); rb_fb30_clear_fit(s);
+        }
+        break;
+    }
+    const int k = rb_fb30_k(s);
+    s->w_held += k == 2;
+    return k;
+}
