+++ b/graphics/nvn/gfx/nvn/rb_texture_ahead.inc
@@ -0,0 +1,99 @@
+// A recorded non-deferred sample is an early indication of real demand.
+// Keep only table coordinates. A registration may be replaced or destroyed
+// before replay. The submit owner resolves the identity again under g_rmu.
+enum { RB_TX_QUEUE = 128, RB_TX_MAX = 256 * 1024, RB_TX_SESSION = 32 * 1024 * 1024 };
+typedef struct { unsigned id; uint64_t serial; } rb_tx_hint;
+static struct {
+    pthread_mutex_t lock;
+    rb_tx_hint items[RB_TX_QUEUE];
+    unsigned head, count;
+    _Atomic unsigned pending;
+    _Atomic uint64_t recent[2048];
+    uint64_t bytes, made, frame;
+    unsigned in_frame;
+} g_tx_ahead = {.lock = PTHREAD_MUTEX_INITIALIZER};
+
+void nvn_be_record_texture_hint(uint32_t id_) {
+    if (id_ >= (1u << 20)) return;
+    uint64_t serial = atomic_load_explicit(&g_tser[id_], memory_order_relaxed);
+    _Atomic uint64_t *recent = &g_tx_ahead.recent[id_ % 2048];
+    if (!serial || atomic_load_explicit(recent, memory_order_relaxed) == serial) return;
+    if (pthread_mutex_trylock(&g_tx_ahead.lock)) return;
+    if (g_tx_ahead.count < RB_TX_QUEUE && atomic_load_explicit(recent, memory_order_relaxed) != serial) {
+        unsigned tail = (g_tx_ahead.head + g_tx_ahead.count) % RB_TX_QUEUE;
+        g_tx_ahead.items[tail] = (rb_tx_hint){id_, serial};
+        ++g_tx_ahead.count;
+        atomic_store_explicit(recent, serial, memory_order_relaxed);
+        atomic_store_explicit(&g_tx_ahead.pending, g_tx_ahead.count, memory_order_relaxed);
+    }
+    pthread_mutex_unlock(&g_tx_ahead.lock);
+}
+
+static int rb_tx_next(rb_tx_hint *h) {
+    if (pthread_mutex_trylock(&g_tx_ahead.lock)) return 0;
+    unsigned count = g_tx_ahead.count;
+    if (count) {
+        *h = g_tx_ahead.items[g_tx_ahead.head];
+        g_tx_ahead.head = (g_tx_ahead.head + 1) % RB_TX_QUEUE;
+        atomic_store_explicit(&g_tx_ahead.pending, --g_tx_ahead.count, memory_order_relaxed);
+    }
+    pthread_mutex_unlock(&g_tx_ahead.lock);
+    return count != 0;
+}
+
+// Only private, packaged data in ordinary texture-only memory. A pool ever
+// handed to the game as a GPU buffer can contain writes still in flight.
+static int rb_tx_eligible(const treg_t *r, uint64_t serial) {
+    const tex_t *t = &r->t;
+    if (!r->ok || r->gone || r->view || t->serial != serial || !t->has_layout ||
+        !t->mem || !t->pool || t->d.target != NVN_TEXTURE_TARGET_2D ||
+        t->d.flags || !t->L.size || t->L.size > RB_TX_MAX ||
+        t->pool->magic != MAGIC('P','O','O','L') ||
+        (t->pool->flags & (NVN_MEMORY_POOL_FLAGS_VIRTUAL | NVN_MEMORY_POOL_FLAGS_PHYSICAL)) ||
+        !nvn_dirty_tracked(t->mem, t->L.size) || !nvn_be_tex_is_live(serial) || tex_get(serial)) return 0;
+    pthread_mutex_lock(&g_mu);
+    int index = pool_find((uintptr_t)t->mem, t->L.size);
+    int ok = index >= 0 && !g_pools[index].res && !addr_meets(g_pools[index].lo, g_pools[index].hi);
+    pthread_mutex_unlock(&g_mu);
+    return ok;
+}
+
+void nvn_be_advance_texture(void) {
+    if (!atomic_load_explicit(&g_tx_ahead.pending, memory_order_relaxed) ||
+        !on_sub_thread() || dm_gfx_session_stopping() || g_cb || g_up_cb ||
+        g_tx_ahead.bytes >= RB_TX_SESSION || atomic_load(&g_up_pending)) return;
+    uint64_t frame = atomic_load(&g_cur_frame);
+    if (g_tx_ahead.frame != frame) { g_tx_ahead.frame = frame; g_tx_ahead.in_frame = 0; }
+    if (g_tx_ahead.in_frame >= 2 || rb_mem_low()) return;
+    if (pthread_mutex_trylock(&g_rmu)) return;
+    int lease = 0;
+    if (rb_spec_take(0, &lease)) {
+        rb_tx_hint h;
+        for (int i = 0; i < 4 && rb_tx_next(&h); ++i) {
+            if (h.id >= (unsigned)g_ntreg || !rb_tx_eligible(&g_treg[h.id], h.serial)) continue;
+            const tex_t *t = &g_treg[h.id].t;
+            if (t->L.size > RB_TX_SESSION - g_tx_ahead.bytes) break;
+            if (tex_mtl_(t)) {
+                g_tx_ahead.bytes += t->L.size;
+                ++g_tx_ahead.in_frame;
+                ++g_tx_ahead.made;
+                if (!(g_tx_ahead.made & (g_tx_ahead.made - 1)))
+                    MLOG("RewindBox: recorded texture binds uploaded ahead %llu, %llu bytes, frame %llu",
+                         (unsigned long long)g_tx_ahead.made, (unsigned long long)g_tx_ahead.bytes,
+                         (unsigned long long)frame);
+            }
+            break;
+        }
+        rb_spec_done(&lease);
+    }
+    pthread_mutex_unlock(&g_rmu);
+}
+
+static void rb_tx_reset(void) {
+    pthread_mutex_lock(&g_tx_ahead.lock);
+    g_tx_ahead.head = g_tx_ahead.count = g_tx_ahead.in_frame = 0;
+    g_tx_ahead.bytes = g_tx_ahead.made = g_tx_ahead.frame = 0;
+    atomic_store(&g_tx_ahead.pending, 0);
+    for (unsigned i = 0; i < 2048; ++i) atomic_store(&g_tx_ahead.recent[i], 0);
+    pthread_mutex_unlock(&g_tx_ahead.lock);
+}
