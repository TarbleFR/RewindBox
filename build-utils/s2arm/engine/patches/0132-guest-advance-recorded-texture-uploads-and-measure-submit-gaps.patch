+// Interval with no CPU inside an NVN submit or present, across all queues.
+// Call with a monotonic clock sampled under the caller's lock. A present
+// closes the preceding window at entry and immediately starts its own call.
+#ifndef RB_SUBMIT_GAP_H
+#define RB_SUBMIT_GAP_H
+#include <stdint.h>
+typedef struct { uint64_t total, longest; unsigned count; } rb_gap_sample;
+typedef struct { rb_gap_sample sample; unsigned active, started; uint64_t idle_since; } rb_gap_clock;
+static inline void rb_gap_enter(rb_gap_clock *c, uint64_t now) {
+    if (!c->active && c->started && now > c->idle_since) {
+        uint64_t d = now - c->idle_since;
+        c->sample.total += d;
+        if (d > c->sample.longest) c->sample.longest = d;
+        ++c->sample.count;
+    }
+    ++c->active;
+}
+static inline void rb_gap_leave(rb_gap_clock *c, uint64_t now) {
+    if (!--c->active) { c->idle_since = now; c->started = 1; }
+}
+static inline rb_gap_sample rb_gap_cut(rb_gap_clock *c) {
+    rb_gap_sample result = c->sample;
+    c->sample = (rb_gap_sample){0};
+    return result;
+}
+#endif
