+#include "../gfx/nvn/rb_submit_gap.h"
+#include <assert.h>
+#include <stdio.h>
+int main(void) {
+    rb_gap_clock c = {0};
+    rb_gap_enter(&c, 100);                   // first present
+    assert(rb_gap_cut(&c).total == 0);
+    rb_gap_enter(&c, 105);                   // overlapping submit
+    rb_gap_leave(&c, 110);
+    rb_gap_leave(&c, 120);
+    rb_gap_enter(&c, 150);
+    rb_gap_leave(&c, 163);
+    rb_gap_enter(&c, 170);                   // second present
+    rb_gap_sample s = rb_gap_cut(&c);
+    assert(s.count == 2 && s.total == 37 && s.longest == 30);
+    rb_gap_enter(&c, 171);                   // spans next boundary
+    rb_gap_leave(&c, 180);
+    rb_gap_enter(&c, 210);                   // no uncovered time
+    assert(rb_gap_cut(&c).count == 0);
+    rb_gap_leave(&c, 215);
+    rb_gap_leave(&c, 219);
+    rb_gap_enter(&c, 4219);
+    assert(rb_gap_cut(&c).longest == 4000);
+    puts("submit gap: overlapping calls, presentation cut, 4-second gap passed");
+}
