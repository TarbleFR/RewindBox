 #include <mach/mach_time.h>
 #include <stdatomic.h>
@@ -45,7 +46,13 @@ void s2a_hud_audio(int session, int64_t gap_ms_total, int64_t skipped) {
 //   读不到时按近 10 秒间隔的中位数算，行里写明口径
 // 帧率上限：与 graphics/nvn nvn_fps.c nvn_fps_parse、通用层 FramePacingPolicy 同口径，只认整串 0 或 24–1000 的十进制整数（别的值那两处起局就报红退出），
 //   不用 atoi（"30abc" 不能只进浮层）；浮层不链图形层，这里照抄一份
+static pthread_once_t g_live_fps_once = PTHREAD_ONCE_INIT; static int (*g_live_fps)(void);   // RewindBox (patch 0078): cap_fps
+static void live_fps_look(void) { g_live_fps = (int (*)(void))dlsym(RTLD_DEFAULT, "nvn_fps_limit"); }
 static int cap_fps(void) {
+    // RewindBox (patch 0078): the limit can change during play (nvn_fps.c s2a_rb_guest_set_fps_limit): the graphics layer's value when it is linked,
+    //   else S2A_FPS as before (the overlay does not link the graphics layer, hence the lookup by name)
+    pthread_once(&g_live_fps_once, live_fps_look);
+    if (g_live_fps) { int l = g_live_fps(); return l >= 24 && l <= 1000 ? l : 0; }
     const char *e = getenv("S2A_FPS"); int v = 0;
     if (!e || !*e) return 0;
     for (const char *p = e; *p; p++) { if (*p < '0' || *p > '9' || p - e >= 4) return 0; v = v * 10 + (*p - '0'); }
