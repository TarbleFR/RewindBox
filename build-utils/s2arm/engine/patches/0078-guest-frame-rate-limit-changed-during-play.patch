diff --git a/graphics/nvn/gfx/nvn/nvn_fps.c b/graphics/nvn/gfx/nvn/nvn_fps.c
index 26b2605..5f6927f 100644
--- a/graphics/nvn/gfx/nvn/nvn_fps.c
+++ b/graphics/nvn/gfx/nvn/nvn_fps.c
@@ -6,8 +6,12 @@
 #include <stdarg.h>   // RewindBox (patch 0068): fps_say
 #include <unistd.h>   // RewindBox (patch 0068): fps_say
 
+#include <stdatomic.h>   // RewindBox (patch 0078): the limit can change during play
 static pthread_once_t g_once = PTHREAD_ONCE_INIT;
-static int g_limit;
+// RewindBox (patch 0078): atomic, set once from S2A_FPS at the first read and again by s2a_rb_guest_set_fps_limit (RewindBox's in-game menu).
+//   Every reader takes it through nvn_fps_limit / nvn_fps_period* at each frame (present pacing link_sync, the present periods of egl.m, hle_vk.m,
+//   hle_nvn.c and nvn_mtl.m, the frame interval lines), so a new value is used from the next frame on
+static _Atomic int g_limit;
 // 只认十进制整数（不带符号、空格或尾随字符）；越界或别的写法返回 -1
 int nvn_fps_parse(const char *e) {
     if (!e || !*e) return -1;
@@ -37,11 +41,25 @@ static void fps_init(void) {
     if (!e) { fps_say("[s2a] [nvn] S2A_FPS 未设：不额外限帧 (no frame-rate limit; RewindBox patch 0068)"); return; }   // RewindBox (patch 0068): fps_say
     int v = nvn_fps_parse(e);
     if (v < 0) { fps_say("[s2a] [nvn] 【红】 S2A_FPS=%s：只接受 0（不限）或 %d–%d 的整数", e, NVN_FPS_MIN_HZ, NVN_FPS_MAX_HZ); abort(); }   // RewindBox (patch 0068): fps_say
-    g_limit = v;
-    if (g_limit) fps_say("[s2a] [nvn] S2A_FPS=%d：直连额外帧率上限，保留游戏交换间隔；DM_PRESENT_HZ / DM_FPS 不绕过此上限 (active frame-rate limit %d fps; RewindBox patch 0068)", g_limit, g_limit);   // RewindBox (patch 0068): fps_say
+    atomic_store(&g_limit, v);   // RewindBox (patch 0078): atomic
+    if (v) fps_say("[s2a] [nvn] S2A_FPS=%d：直连额外帧率上限，保留游戏交换间隔；DM_PRESENT_HZ / DM_FPS 不绕过此上限 (active frame-rate limit %d fps; RewindBox patch 0068)", v, v);   // RewindBox (patch 0068): fps_say
     else fps_say("[s2a] [nvn] S2A_FPS=0：不额外限帧 (no frame-rate limit; RewindBox patch 0068)");
 }
-int nvn_fps_limit(void) { pthread_once(&g_once, fps_init); return g_limit; }
+int nvn_fps_limit(void) { pthread_once(&g_once, fps_init); return atomic_load_explicit(&g_limit, memory_order_relaxed); }   // RewindBox (patch 0078): atomic
+// RewindBox (patch 0078): the frame-rate limit changed during play. RewindBox's in-game menu set S2A_FPS for the next start only, read once a process,
+//   so a change needed RewindBox to be closed and opened again (IPA 771 test: the player went from 30 to 60 that way). The host calls this on the main
+//   thread when the player picks a limit: 0 (none) or NVN_FPS_MIN_HZ to NVN_FPS_MAX_HZ, as S2A_FPS. Returns 0 when the value is in effect from the next frame,
+//   -1 for a value S2A_FPS would refuse, -2 when S2A_RB_LIVE_FPS=0 (the limit stays the one of the start, the old behaviour). Exported for the host
+//   (export_list.py GUEST_ENTRY_POINTS)
+static int rb_live_fps_on(void) { static _Atomic int v = -1; int o = atomic_load(&v); if (o < 0) { const char *e = getenv("S2A_RB_LIVE_FPS"); o = !(e && !strcmp(e, "0")); atomic_store(&v, o); } return o; }
+__attribute__((visibility("default"), used)) int s2a_rb_guest_set_fps_limit(int fps) {
+    if (fps != 0 && (fps < NVN_FPS_MIN_HZ || fps > NVN_FPS_MAX_HZ)) return -1;
+    pthread_once(&g_once, fps_init);
+    if (!rb_live_fps_on()) { fps_say("[s2a] [nvn] RewindBox: frame-rate limit %d asked during play, kept at %d until the next start (S2A_RB_LIVE_FPS=0; patch 0078)", fps, atomic_load(&g_limit)); return -2; }
+    int old = atomic_exchange(&g_limit, fps);
+    if (old != fps) fps_say("[s2a] [nvn] RewindBox: frame-rate limit changed during play: %d → %d fps (0 = none), from the next frame (S2A_RB_LIVE_FPS; patch 0078)", old, fps);
+    return 0;
+}
 double nvn_fps_period(double period) {
     int fps = nvn_fps_limit(); double limit = fps ? 1.0 / fps : 0;
     return period < limit ? limit : period;
