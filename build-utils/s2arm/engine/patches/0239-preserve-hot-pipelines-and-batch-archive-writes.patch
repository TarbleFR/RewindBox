index 0000000..22d9f84
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_gov_plan.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+enum { RB_GOV_PREFETCH, RB_GOV_UPLOAD, RB_GOV_TEXTURE, RB_GOV_PIPELINE };
+enum { RB_GOV_NORMAL, RB_GOV_WARN, RB_GOV_CRITICAL };
+// The floor is published with the plan. Transfer its bytes from the texture
+// share, keeping the total exactly equal to the existing governor ceiling.
+#define RB_GOV_PSO_FLOOR (1u << 31)
+static inline unsigned rb_gov_make_plan(unsigned mib, unsigned tier, uint64_t room, int protect, unsigned old) {
+    int floor = protect && room != UINT64_MAX && room >= (1000ull << 20) &&
+                (room >= (1500ull << 20) || (old & RB_GOV_PSO_FLOOR));
+    return (mib << 2) | tier | (floor ? RB_GOV_PSO_FLOOR : 0);
+}
+static inline uint64_t rb_gov_share(unsigned plan, unsigned owner) {
+    static const unsigned weights[][4] = {{4,4,7,1},{0,3,12,1},{0,2,13,1}};
+    uint64_t unit = ((uint64_t)((plan & ~RB_GOV_PSO_FLOOR) >> 2) << 20) / 16;
+    uint64_t value = unit * weights[plan & 3u][owner];
+    if ((plan & RB_GOV_PSO_FLOOR) && unit < (24ull << 20)) {
+        uint64_t transfer = (24ull << 20) - unit;
+        if (owner == RB_GOV_PIPELINE) value += transfer;
+        if (owner == RB_GOV_TEXTURE) value -= transfer;
+    }
+    return value;
+}
+static inline uint64_t rb_gov_pso_count(unsigned plan) {
+    return plan & RB_GOV_PSO_FLOOR ? 4096u : rb_gov_share(plan,RB_GOV_PIPELINE) / 4096u;
+}
+static inline unsigned rb_gov_pso_idle(unsigned plan, uint64_t bytes, uint64_t count) {
+    if (plan & RB_GOV_PSO_FLOOR) return 300;
+    return ((plan & 3u) || bytes > rb_gov_share(plan,RB_GOV_PIPELINE) || count > rb_gov_pso_count(plan)) ?
+           ((plan & 3u) == RB_GOV_CRITICAL ? 15 : 60) : 300;
+}
