diff --git a/graphics/nvn/tests/t_rb_direct_autoprofile.m b/graphics/nvn/tests/t_rb_direct_autoprofile.m
new file mode 100644
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_direct_autoprofile.m
@@ -0,0 +1,38 @@
+// Exercise the real on-disk record, its launch identity and the 120-present cadence gate.
+#import <Foundation/Foundation.h>
+#include <stdatomic.h>
+#include <pthread.h>
+#include "../gfx/nvn/dmsh_chain.h"
+#define MLOG(...) do { fprintf(stderr, __VA_ARGS__); fputc(10, stderr); } while (0)
+#include "../gfx/nvn/rb_direct_autoprofile.inc"
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "FAIL %s:%d %s\n", __FILE__, __LINE__, #c); return 1; } } while (0)
+int main(int argc, const char **argv) { @autoreleasepool {
+    CHECK(argc == 3);
+    NSString *user = [@(argv[1]) stringByAppendingPathComponent:@"pso_user.tsv"];
+    const char *program = "0400123456789000", *build = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    BOOL cold = !strcmp(argv[2], "cold"), other = !strcmp(argv[2], "other");
+    rb_profile_begin(user, program, other ? "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" : build);
+    dispatch_sync(rb_profile_io(), ^{});
+    CHECK(rb_profile_path && atomic_load(&rb_profile_ready));
+    if (cold) {
+        for (int i=0; i<119; ++i) nvn_rb_observe_direct_interval(1);
+        nvn_rb_observe_direct_interval(0);
+        for (int i=0; i<119; ++i) nvn_rb_observe_direct_interval(2);
+        dispatch_sync(rb_profile_io(), ^{});
+        CHECK(![NSFileManager.defaultManager fileExistsAtPath:rb_profile_path]);
+        atomic_store(&rb_profile_sparse, 1); atomic_store(&rb_profile_bindless, 1);
+        rb_profile_peak(&rb_profile_sparse_peak, 32768, 65536); rb_profile_peak(&rb_profile_bind_peak, 65536, 8192);
+        nvn_rb_observe_direct_interval(2);
+        dispatch_sync(rb_profile_io(), ^{});
+        CHECK([NSFileManager.defaultManager fileExistsAtPath:rb_profile_path]);
+    } else if (other) {
+        CHECK(!nvn_rb_boot_interval() && !atomic_load(&rb_seed_bind) && !atomic_load(&rb_seed_sparse));
+    } else {
+        CHECK(nvn_rb_boot_interval() == 2 && atomic_load(&rb_seed_sparse) == 32768 && atomic_load(&rb_seed_bind) == 8192);
+        for (int i=0; i<120; ++i) nvn_rb_observe_direct_interval(1);
+        CHECK(!nvn_rb_boot_interval());
+    }
+    rb_profile_retire();
+    CHECK(!nvn_rb_boot_interval() && !atomic_load(&rb_profile_ready));
+    puts("PASS scoped runtime profile"); return 0;
+} }
