new file mode 100644
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_direct_autoprofile.inc
@@ -0,0 +1,115 @@
+// Observations are hints for the next boot of this executable and translation
+// chain. The game and explicit cadence policy still own presentation timing.
+static _Atomic unsigned rb_profile_sparse, rb_profile_bindless;
+static _Atomic unsigned rb_profile_sparse_peak, rb_profile_bind_peak;
+static _Atomic unsigned rb_seed_sparse, rb_seed_bind, rb_seed_interval;
+static _Atomic int rb_profile_ready, rb_profile_collecting;
+static NSString *rb_profile_path;
+static NSDictionary *rb_profile_identity, *rb_saved_profile;
+static unsigned rb_interval_candidate, rb_interval_run, rb_first_interval;
+static unsigned rb_profile_frames;
+static _Atomic int rb_profile_boot_window;
+static pthread_mutex_t rb_profile_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static dispatch_queue_t rb_profile_io(void) {
+    static dispatch_once_t once; static dispatch_queue_t q;
+    dispatch_once(&once, ^{
+        q = dispatch_queue_create("s2a.profile", dispatch_queue_attr_make_with_qos_class(
+            DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+    });
+    return q;
+}
+
+static unsigned rb_profile_capacity(id number, unsigned minimum, unsigned maximum) {
+    if (![number isKindOfClass:NSNumber.class]) return 0;
+    uint64_t value = [number unsignedLongLongValue];
+    return value >= minimum && value <= maximum && !(value & (value - 1)) ? (unsigned)value : 0;
+}
+static void rb_profile_peak(_Atomic unsigned *peak, unsigned cells, unsigned cap) {
+    if (cells > cap) cells = cap;
+    unsigned old = atomic_load_explicit(peak, memory_order_relaxed);
+    while (cells > old && !atomic_compare_exchange_weak_explicit(peak, &old, cells,
+            memory_order_relaxed, memory_order_relaxed)) {}
+}
+static BOOL rb_profile_hex_id(const char *s, size_t length) {
+    return s && strlen(s) == length && strspn(s, "0123456789abcdefABCDEF") == length &&
+           strspn(s, "0") != length;
+}
+
+static void rb_profile_begin(NSString *user, const char *program, const char *build) {
+    if (!user.isAbsolutePath || !rb_profile_hex_id(program, 16) || !rb_profile_hex_id(build, 32)) return;
+    NSString *identity = [NSString stringWithFormat:@"%s-%s-%s", program, build, DMSH_CHAIN];
+    NSString *dir = [user.stringByDeletingLastPathComponent stringByAppendingPathComponent:@"profiles"];
+    NSString *path = [dir stringByAppendingPathComponent:[identity stringByAppendingPathExtension:@"plist"]];
+    NSDictionary *scope = @{@"schema": @1, @"program": @(program), @"build": @(build), @"chain": @DMSH_CHAIN};
+    pthread_mutex_lock(&rb_profile_lock);
+    if (!rb_profile_path) {
+        rb_profile_path = path; rb_profile_identity = scope;
+        atomic_store(&rb_profile_collecting, 1);
+        dispatch_async(rb_profile_io(), ^{ @autoreleasepool {
+            NSDictionary *record = [NSDictionary dictionaryWithContentsOfFile:path];
+            BOOL valid = [scope isEqual:record[@"identity"]];
+            if (valid) {
+                int interval = [record[@"interval"] isKindOfClass:NSNumber.class] ? [record[@"interval"] intValue] : 0;
+                atomic_store(&rb_seed_interval, interval == 1 || interval == 2 ? interval : 0);
+                if ([record[@"sparse"] isEqual:@YES]) atomic_store(&rb_seed_sparse, rb_profile_capacity(record[@"sparse_cells"], 4096, 65536));
+                if ([record[@"bindless"] isEqual:@YES]) atomic_store(&rb_seed_bind, rb_profile_capacity(record[@"reader_cells"], 1024, 8192));
+                rb_saved_profile = record;
+            }
+            MLOG("[rb-direct-profile] %s %s interval=%u sparse_cells=%u reader_cells=%u", [scope[@"program"] UTF8String],
+                 valid ? "restored" : "learning", atomic_load(&rb_seed_interval), atomic_load(&rb_seed_sparse), atomic_load(&rb_seed_bind));
+            atomic_store(&rb_profile_boot_window, 1);
+            atomic_store_explicit(&rb_profile_ready, 1, memory_order_release);
+        }});
+    }
+    pthread_mutex_unlock(&rb_profile_lock);
+}
+
+// Present-thread only. Learn the guest-requested interval across 120 consecutive
+// real gameplay presents. Cutscenes, video and forced host cadence do not vote.
+void nvn_rb_observe_direct_interval(int interval) {
+    if (!atomic_load_explicit(&rb_profile_ready, memory_order_acquire)) return;
+    if (rb_profile_frames != UINT_MAX) ++rb_profile_frames;
+    if (rb_profile_frames == 120) atomic_store(&rb_profile_boot_window, 0);
+    if (!rb_first_interval) {
+        if (interval != rb_interval_candidate || (interval != 1 && interval != 2)) rb_interval_run = 0;
+        rb_interval_candidate = interval;
+        if ((interval == 1 || interval == 2) && ++rb_interval_run >= 120) rb_first_interval = interval;
+    }
+    BOOL firstStable = rb_first_interval && rb_interval_run == 120;
+    if (!firstStable && rb_profile_frames % 120 != 0) return;
+    if (firstStable) ++rb_interval_run;
+    unsigned sparse = atomic_load(&rb_profile_sparse), bindless = atomic_load(&rb_profile_bindless);
+    unsigned sp = atomic_load(&rb_profile_sparse_peak), bl = atomic_load(&rb_profile_bind_peak);
+    unsigned cadence = rb_first_interval;
+    dispatch_async(rb_profile_io(), ^{ @autoreleasepool {
+        BOOL hasSparse = sparse || [rb_saved_profile[@"sparse"] isEqual:@YES];
+        BOOL hasBind = bindless || [rb_saved_profile[@"bindless"] isEqual:@YES];
+        unsigned interval = cadence ?: atomic_load(&rb_seed_interval);
+        if (!interval && !hasSparse && !hasBind) return;
+        NSDictionary *record = @{@"identity": rb_profile_identity, @"interval": @(interval),
+            @"sparse": @(hasSparse), @"bindless": @(hasBind), @"sparse_cells": @(MAX(sp, atomic_load(&rb_seed_sparse))),
+            @"reader_cells": @(MAX(bl, atomic_load(&rb_seed_bind)))};
+        if ([record isEqual:rb_saved_profile]) return;
+        NSString *dir = rb_profile_path.stringByDeletingLastPathComponent;
+        if ([NSFileManager.defaultManager createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil] &&
+                [record writeToFile:rb_profile_path atomically:YES]) {
+            rb_saved_profile = record;
+            MLOG("[rb-direct-profile] persisted interval=%u sparse=%u bindless=%u", interval, hasSparse, hasBind);
+        }
+    }});
+}
+
+int nvn_rb_boot_interval(void) { return atomic_load(&rb_profile_boot_window) ? (int)atomic_load(&rb_seed_interval) : 0; }
+
+static void rb_profile_retire(void) {
+    pthread_mutex_lock(&rb_profile_lock);
+    if (rb_profile_path) dispatch_sync(rb_profile_io(), ^{ rb_saved_profile = nil; });
+    rb_profile_path = nil; rb_profile_identity = nil; atomic_store(&rb_profile_collecting, 0);
+    atomic_store(&rb_profile_ready, 0); atomic_store(&rb_profile_boot_window, 0);
+    atomic_store(&rb_seed_interval, 0); atomic_store(&rb_seed_sparse, 0); atomic_store(&rb_seed_bind, 0);
+    atomic_store(&rb_profile_sparse_peak, 0); atomic_store(&rb_profile_bind_peak, 0);
+    atomic_store(&rb_profile_sparse, 0); atomic_store(&rb_profile_bindless, 0);
+    rb_first_interval = rb_interval_run = rb_interval_candidate = rb_profile_frames = 0;
+    pthread_mutex_unlock(&rb_profile_lock);
+}
