diff --git a/services/tests/rb_course_reads/Program.cs b/services/tests/rb_course_reads/Program.cs
new file mode 100644
index 0000000..6007cc2
--- /dev/null
+++ b/services/tests/rb_course_reads/Program.cs
@@ -0,0 +1,62 @@
+using System.Text;
+using LibHac.Fs;
+using S2A.Services;
+using Path = System.IO.Path;
+
+// The exact image/file offsets and UTF-8 paths come from the production index.
+var dir = Directory.CreateTempSubdirectory("rb-course-read");
+try
+{
+    string root = Path.Combine(dir.FullName, "romfs");
+    string index = Path.Combine(dir.FullName, RomFsIndex.FileName);
+    string[] files = { "Layout/CourseBtn_00.Nin_Ounce_NVN2.blarc.zs", "AI/RaceSequence.root.ainb",
+        "Banc/Race_FirstCircuit_A_00[Game03].bcett.byml.zs", "Banc/Race_Test2.bcett.byml.zs",
+        "Banc/Race_Test3.bcett.byml.zs", "Banc/Race_Test4.bcett.byml.zs", "Banc/Weather.bcett.byml.zs" };
+    foreach (string name in files)
+    {
+        string path = Path.Combine(root, name);
+        Directory.CreateDirectory(Path.GetDirectoryName(path));
+        File.WriteAllBytes(path, new byte[]{11, 22, 33, 44});
+    }
+    RomFsIndex.Write(root, index);
+    byte[] idx = File.ReadAllBytes(index);
+    int n = BitConverter.ToInt32(idx, 16), paths = 24 + 24*n;
+    var entries = new Dictionary<string,long>();
+    var offsets = new List<long>();
+    string imagePath = Path.Combine(dir.FullName,RomFsIndex.ImageName);
+    using (var image = File.Create(imagePath))
+    {
+        for (int i=0; i<n; ++i)
+        {
+            int at=20+24*i;
+            string path=Encoding.UTF8.GetString(idx, paths+BitConverter.ToInt32(idx,at+16),BitConverter.ToInt32(idx,at+20));
+            entries.Add(path, BitConverter.ToInt64(idx,at));
+            offsets.Add(image.Position);
+            image.Write(File.ReadAllBytes(Path.Combine(root,path)));
+        }
+    }
+    using (var m = new BinaryWriter(File.Create(Path.Combine(dir.FullName,RomFsIndex.ImageMapName))))
+    {
+        m.Write("S2ARIM01"u8); m.Write(new FileInfo(imagePath).Length);m.Write(n);
+        foreach(long offset in offsets)m.Write(offset);
+    }
+    var observed = new List<string>();
+    RomFsIndex.RouteObserver = p => observed.Add(Encoding.UTF8.GetString(p));
+    foreach (var source in new Func<IStorage>[] { () => RomFsIndex.Open(root,index), () => RomFsIndex.OpenImage(dir.FullName) })
+    {
+        observed.Clear();
+        using var s=source();
+        foreach(string name in files)
+        {
+            if (!s.Read(entries[name]+1,new byte[1]).IsSuccess() || !s.Read(entries[name],new byte[2]).IsSuccess())
+                throw new Exception("valid read failed");
+        }
+        if (!observed.SequenceEqual(files.Take(6)))throw new Exception("wrong course evidence from real storage reads");
+    }
+    File.WriteAllBytes(Path.Combine(root,files[2]),new byte[1]); observed.Clear();
+    using(var s=RomFsIndex.Open(root,index))
+        if (!s.Read(entries[files[2]],new byte[2]).IsFailure() || observed.Count!=0)
+            throw new Exception("incomplete source reported a route");
+    Console.WriteLine("PASS successful RomFS directory and image reads only, four independent circuit keys, partial and failed reads excluded");
+}
+finally { RomFsIndex.RouteObserver=null;dir.Delete(true); }
