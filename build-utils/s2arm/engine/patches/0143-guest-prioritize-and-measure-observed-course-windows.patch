+        i=warm_pick(&next,n,0,&lease);GPU_CHECK(i==0);rb_spec_done(&lease);
+        GPU_CHECK(warm_pick(&next,n,0,&lease)==-1);
+        warm_urgent_end();
+        puts("PASS cold selection: observed Kartnative order promotes exact Metal PSO before generic work on first launch, correct pixel");
+    } else if(launch<3) {
+        while(atomic_load(&g_warm_running)) usleep(1000);
+        demand_and_draw(ST_A,nil); // common menu pipeline, explicitly NOT a race observation
+        const char race[]="Banc/Race_FirstCircuit_A_00[Game03].bcett.byml.zs";
+        nvn_rb_route_read(race,sizeof race-1);
+        nvn_rb_course_frame(1,500000001,2,3,4,1,5,6);
+        GPU_CHECK(g_course_samples[0].count==1 && g_course_samples[0].slow100==1 && g_course_samples[0].slow500==1);
+        demand_and_draw(ST_B,nil);demand_and_draw(ST_B,nil);
+        GPU_CHECK(g_course_live.course[0].key[0] && !g_course_live.course[0].key[1]);
+        nvn_rb_course_frame(2,100000000,5,7,6,1,2,3);
+        GPU_CHECK(g_course_samples[3].count==1 && !g_course_samples[3].slow100 && g_course_samples[3].upload==5 &&
+                  g_course_samples[3].upload_gpu==7 && g_course_samples[3].xwait==1 && g_course_samples[3].msl==3);
+        demand_and_draw(ST_URGENT,nil); // second true course bind
+    } else {
+        transition_wait(transition_ready);dispatch_sync(rb_trace_io(),^{});
+        const char selection[]="Layout/CourseBtn_00.Nin_Ounce_NVN2.blarc.zs";
+        nvn_rb_route_read(selection,sizeof selection-1);
+        nvn_rb_course_frame(1,100000001,0,0,0,0,0,0);
+        GPU_CHECK(g_course_prior.starts==2 && atomic_load(&g_course_hints)==2);
+        warm_bump(stage_name(ST_VERTEX).UTF8String,stage_name(ST_URGENT).UTF8String);
+        transition_step();GPU_CHECK(handed_pipeline(ST_URGENT,0) && !handed_pipeline(ST_B,0));
+        transition_step();id warm=handed_pipeline(ST_B,0);GPU_CHECK(warm);
+        demand_and_draw(ST_B,warm); // includes comparison of read-back pixel
+        atomic_store(&transition_worker_control,0);dispatch_semaphore_signal(transition_proceed);
+        const char r1[]="Banc/Race_One.bcett.byml.zs",r2[]="Banc/Race_Two.bcett.byml.zs";
+        nvn_rb_route_read(r1,sizeof r1-1);nvn_rb_route_read(r2,sizeof r2-1);
+        nvn_rb_course_frame(2,500000000,0,0,0,0,0,0);
+        GPU_CHECK(g_course_current==RB_COURSE_UNKNOWN && !g_course_hints);
+    }
+    GPU_CHECK(!nvn_be_request_stop() && !nvn_be_shutdown_session());
+    return 0;
+}
+static int course_test_main(int argc,char **argv) {
+    if(argc==4 && !strcmp(argv[1],"--course-launch")) return course_test_child(@(argv[2]),atoi(argv[3]));
+    GPU_CHECK(argc==2 && !strcmp(argv[1],"--course-gpu"));
+    char root[]="/tmp/rb-course-gpu-XXXXXX";GPU_CHECK(mkdtemp(root));
+    for(int i=1;i<=4;++i) {
+        NSString *directory=@(root);
+        if(i==4) {
+            directory=[directory stringByAppendingPathComponent:@"fresh"];
+            GPU_CHECK([NSFileManager.defaultManager createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:NULL]);
+            GPU_CHECK([NSFileManager.defaultManager copyItemAtPath:[@(root) stringByAppendingPathComponent:@"pso_user.tsv"]
+                    toPath:[directory stringByAppendingPathComponent:@"fixture.tsv"] error:NULL]);
+        }
+        char n[2]={(char)('0'+i),0};char *args[]={argv[0],"--course-launch",(char *)directory.fileSystemRepresentation,n,NULL};
+        pid_t child;GPU_CHECK(!posix_spawnp(&child,argv[0],NULL,NULL,args,environ));
+        int status;pid_t waited;do { waited=waitpid(child,&status,0); } while(waited<0 && errno==EINTR);
+        GPU_CHECK(waited==child && WIFEXITED(status) && WEXITSTATUS(status)==0);
+    }
+    GPU_CHECK([NSFileManager.defaultManager removeItemAtPath:@(root) error:NULL]);
+    puts("PASS course asset windows: two real launches, exact priority after selection, urgent wins, correct Metal pixel and unknown boundary");
+    return 0;
+}
