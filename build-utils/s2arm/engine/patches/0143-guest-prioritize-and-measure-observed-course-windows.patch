diff --git a/graphics/nvn/gfx/nvn/rb_course_history.h b/graphics/nvn/gfx/nvn/rb_course_history.h
new file mode 100644
index 0000000..5bf2769
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_course_history.h
@@ -0,0 +1,76 @@
+// MKW 1.0.0 course cues. No guest paths or game payload are persisted.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <stddef.h>
+enum { RB_COURSES=32, RB_COURSE_KEYS=8, RB_COURSE_NAME=64,
+       RB_COURSE_UNKNOWN=-1, RB_COURSE_MENU=-2, RB_COURSE_SEQUENCE=-3,
+       RB_COURSE_IGNORE=-4, RB_COURSE_CONFLICT=-5 };
+typedef struct { char name[RB_COURSE_NAME]; uint64_t key[RB_COURSE_KEYS]; } rb_course_entry;
+typedef struct {
+    uint64_t version, checksum;
+    uint32_t starts, first;
+    rb_course_entry course[RB_COURSES];
+} rb_course_db;
+static inline int rb_course_token(const char *p,size_t n) {
+    if (!n || n>=RB_COURSE_NAME) return 0;
+    for (size_t i=0; i<n; ++i) {
+        char c=p[i]; if (!(('a'<=c&&c<='z') || ('A'<=c&&c<='Z') ||
+            ('0'<=c&&c<='9') || c=='_' || c=='[' || c==']' || c=='-')) return 0;
+    }
+    return 1;
+}
+static inline int rb_course_parse(const char *p,size_t n,char out[RB_COURSE_NAME]) {
+    const char menu[]="Layout/CourseBtn_00.Nin_Ounce_NVN2.blarc.zs", seq[]="AI/RaceSequence.root.ainb";
+    const char pre[]="Banc/Race_",ext[]=".bcett.byml.zs";
+    if (n==sizeof(menu)-1 && !memcmp(p,menu,n)) return RB_COURSE_MENU;
+    if (n==sizeof(seq)-1 && !memcmp(p,seq,n)) return RB_COURSE_SEQUENCE;
+    if (n<=sizeof(pre)+sizeof(ext)-2 || memcmp(p,pre,sizeof(pre)-1) || memcmp(p+n-sizeof(ext)+1,ext,sizeof(ext)-1))
+        return RB_COURSE_IGNORE;
+    size_t len=n-(sizeof(pre)+sizeof(ext)-2);
+    if (!rb_course_token(p+sizeof(pre)-1,len)) return RB_COURSE_IGNORE;
+    memcpy(out,p+sizeof(pre)-1,len); out[len]=0; return 0;
+}
+static inline int rb_course_slot(rb_course_db *db,const char *name) {
+    for (int i=0;i<RB_COURSES;++i) {
+        if (!db->course[i].name[0]) { memcpy(db->course[i].name,name,strlen(name)+1); return i; }
+        if (!strcmp(db->course[i].name,name)) return i;
+    }
+    return RB_COURSE_UNKNOWN;
+}
+static inline uint64_t rb_course_checksum(const rb_course_db *db) {
+    const unsigned char *p=(const unsigned char *)&db->starts;
+    uint64_t h=14695981039346656037ull;
+    for (size_t i=0;i<sizeof(*db)-offsetof(rb_course_db,starts);++i) { h^=p[i]; h*=1099511628211ull; }
+    return h;
+}
+static inline int rb_course_valid(const rb_course_db *db,size_t n) {
+    if (n!=sizeof(*db) || db->version!=1 || db->first>=RB_COURSES || db->starts>2 ||
+        db->checksum!=rb_course_checksum(db) || (db->starts&&!db->course[db->first].name[0])) return 0;
+    for (int i=0;i<RB_COURSES;++i) {
+        const rb_course_entry *e=&db->course[i];
+        const char *end=memchr(e->name,0,sizeof e->name);
+        if (!end || (e->name[0] && !rb_course_token(e->name,end-e->name))) return 0;
+    }
+    return 1;
+}
+static inline void rb_course_first(rb_course_db *db,unsigned slot) {
+    if (db->starts && db->first==slot) { if (db->starts<2) ++db->starts; }
+    else {db->first=slot; db->starts=1;}
+}
+static inline int rb_course_add(rb_course_entry *e,uint64_t key) {
+    if (!key) return 0;
+    for (int i=0;i<RB_COURSE_KEYS;++i) {
+        if (e->key[i]==key) return 0;
+        if (!e->key[i]) { e->key[i]=key; return 1; }
+    }
+    return 0;
+}
+typedef struct { unsigned count, slow100, slow500, libs; uint64_t ns,pso_wait,lib_wait;
+    double upload,upload_gpu,xlate,xwait,msl; } rb_course_sample;
+static inline void rb_course_sample_add(rb_course_sample *s,uint64_t ns,double upload,double upload_gpu,double xlate,double xwait,
+                                        unsigned libs,double msl,uint64_t pso_wait,uint64_t lib_wait) {
+    ++s->count; s->ns+=ns; s->slow100+=ns>100000000; s->slow500+=ns>500000000;
+    s->upload+=upload; s->upload_gpu+=upload_gpu; s->xlate+=xlate; s->xwait+=xwait; s->libs+=libs; s->msl+=msl;
+    s->pso_wait+=pso_wait; s->lib_wait+=lib_wait;
+}
