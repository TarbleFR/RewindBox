@@ -52,7 +52,7 @@ static int g_link_owns_layer, g_classic_busy;   // 暂定定义：同 nvn_mtl.m
 static int g_fi_inflight;                       // 已派出、两张画布还没交完的补帧任务数
 static int link_layer_busy(void) { return g_classic_busy || g_fi_inflight; }   // 显示链还不能挂图层
