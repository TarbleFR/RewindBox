+static uint64_t fsig_parse_key(NvShader *s) {
     uint64_t v = 0; int i = 0;
     for (; i < 16; i++) { unsigned ch = (unsigned char)s->key[i], d = ch - '0' < 10 ? ch - '0' : (ch | 32) - 'a' < 6 ? (ch | 32) - 'a' + 10 : 16; if (d > 15) break; v = v << 4 | d; }
     if (i == 16) return v ? v : 1;
     uint64_t a = 0, b = 0; memcpy(&a, s->key, 8); memcpy(&b, s->key + 8, 8); return a ^ b * 0x9e3779b97f4a7c15ull;
+}
+// RewindBox (patch 0114): IPA 785 frame-6000 window averaged 2,628 draws per
+// frame. The same immutable shader names were decoded for each draw's signature.
+// Compute once before publishing the object. Unprepared / test objects still use the parser.
+static void rb_keep_frame_key(NvShader *shader) {
+    static int enabled;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char *v = getenv("S2A_RB_FRAME_SHADER_KEY");
+        enabled = v && !strcmp(v, "1");
+    });
+    if (enabled) {
+        shader->rb_frame_key = fsig_parse_key(shader);
+        shader->rb_frame_key_ready = YES;
+    }
+}
+static uint64_t fsig_shkey(NvShader *s) {
+    if (!s) return 0;
+    if (s->rb_frame_key_ready) {
+        rb_frame_key_reads++;
+        return s->rb_frame_key;
+    }
+    return fsig_parse_key(s);
