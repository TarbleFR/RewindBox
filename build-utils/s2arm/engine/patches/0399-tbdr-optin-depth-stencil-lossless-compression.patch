+// RewindBox (patch 0399): opt-in Apple9 TBDR lossless depth-stencil compression (S2A_RB_DS_COMPRESS=1, default off).
+// Omitting MTLTextureUsagePixelFormatView on Depth32Float_Stencil8 allows lossless Z/S compression on Apple Silicon;
+// if a shader or scaled copy later requests an X32_Stencil8 view, tex_by_id / copy_t2t_ safely upgrades it in place
+// and remembers the storage key in g_ds_pfv_sticky so future allocations over the same storage take PixelFormatView up front.
+enum { DS_PFV_STICKY_CAP = 256 };
+static uint64_t g_ds_pfv_sticky[DS_PFV_STICKY_CAP];
+static unsigned g_ds_pfv_sticky_n;
+static os_unfair_lock g_ds_pfv_mu = OS_UNFAIR_LOCK_INIT;
+static _Atomic int g_rb_ds_compress_mode = -1;
+static _Atomic uint64_t g_rb_ds_compressed, g_rb_ds_sticky_hits, g_rb_ds_upgrades;
+static int rb_ds_compress_on(void) {
+    int x = atomic_load_explicit(&g_rb_ds_compress_mode, memory_order_relaxed);
+    if (x < 0) {
+        const char *e = getenv("S2A_RB_DS_COMPRESS");
+        x = (e && !strcmp(e, "1")) ? 1 : 0;
+        int was = -1;
+        if (atomic_compare_exchange_strong(&g_rb_ds_compress_mode, &was, x) && x)
+            MLOG("[rb-ds-compress] opt-in Depth32Float_Stencil8 lossless compression on (S2A_RB_DS_COMPRESS=1; patch 0399)");
+    }
+    return x;
+}
+static uint64_t ds_pfv_sticky_key(const tex_t *t) {
+    if (!t || !t->mem || !fmt_depth(t->d.format) || (t->pool && nvn_sparse_pool(t->pool))) return 0;
+    uint64_t k = (uint64_t)(uintptr_t)t->mem * 0x9E3779B97F4A7C15ull;
+    k ^= ((uint64_t)t->d.format << 48) ^ ((uint64_t)t->d.width << 32) ^ ((uint64_t)t->d.height << 16) ^ ((uint64_t)t->d.depth << 8) ^ (uint64_t)t->d.levels ^ ((uint64_t)t->d.target << 56);
+    k ^= k >> 29; k *= 0xBF58476D1CE4E5B9ull; k ^= k >> 32;
+    return k ? k : 1;
+}
+static int ds_pfv_sticky_has(const tex_t *t) {
+    uint64_t k = ds_pfv_sticky_key(t);
+    if (!k) return 0;
+    os_unfair_lock_lock(&g_ds_pfv_mu);
+    int found = 0;
+    if (g_ds_pfv_sticky_n) {
+        for (unsigned i = (unsigned)k & (DS_PFV_STICKY_CAP - 1), n = 0; n < DS_PFV_STICKY_CAP && g_ds_pfv_sticky[i]; i = (i + 1) & (DS_PFV_STICKY_CAP - 1), n++)
+            if (g_ds_pfv_sticky[i] == k) { found = 1; break; }
+    }
+    os_unfair_lock_unlock(&g_ds_pfv_mu);
+    return found;
+}
+static void ds_pfv_sticky_add(const tex_t *t) {
+    uint64_t k = ds_pfv_sticky_key(t);
+    if (!k) return;
+    os_unfair_lock_lock(&g_ds_pfv_mu);
+    for (unsigned i = (unsigned)k & (DS_PFV_STICKY_CAP - 1), n = 0; n < DS_PFV_STICKY_CAP && g_ds_pfv_sticky[i]; i = (i + 1) & (DS_PFV_STICKY_CAP - 1), n++)
+        if (g_ds_pfv_sticky[i] == k) { os_unfair_lock_unlock(&g_ds_pfv_mu); return; }
+    if (g_ds_pfv_sticky_n >= DS_PFV_STICKY_CAP / 2) { memset(g_ds_pfv_sticky, 0, sizeof g_ds_pfv_sticky); g_ds_pfv_sticky_n = 0; }
+    unsigned i = (unsigned)k & (DS_PFV_STICKY_CAP - 1);
+    while (g_ds_pfv_sticky[i]) i = (i + 1) & (DS_PFV_STICKY_CAP - 1);
+    g_ds_pfv_sticky[i] = k; g_ds_pfv_sticky_n++;
+    os_unfair_lock_unlock(&g_ds_pfv_mu);
+}
