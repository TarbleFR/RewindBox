diff --git a/runtime/tests/t_tdump_stress.c b/runtime/tests/t_tdump_stress.c
new file mode 100644
index 0000000..e73a624
--- /dev/null
+++ b/runtime/tests/t_tdump_stress.c
@@ -0,0 +1,43 @@
+// 全线程现场 s2a_dump_threads（压力）不能在「别的线程已挂起」时调要锁的函数（11-14 停帧看门打到一半断）。
+// 夹具：一条线程不停建 / 收线程（pthread 线程表锁，pthread_from_mach_thread_np 要它），一条不停 dlopen / dlclose（dyld 写锁，dladdr 要它），
+//   两条 malloc / free，一条阻塞在条件变量上；连打 300 次现场。
+// 期望（按原理，不跑被测实现推）：挂起期间只做内核调用的实现每次都打完（出「现场完」），30 秒看门不触发；
+//   挂起后边取边 dladdr 的旧实现会碰上被挂起的线程正持着 dyld 锁 → 本线程卡死 → 看门退出 2（负对照手动换回旧 tdump.c 看）
+#include "../src/native.h"
+#include <dlfcn.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+module_t *module_of(const void *p) { (void)p; return NULL; }
+int s2a_dump_threads(const char *why);
+static atomic_int g_stop;
+static void *noop(void *a) { return a; }
+static void *spin_threads(void *a) { (void)a; while (!atomic_load(&g_stop)) { pthread_t x; if (!pthread_create(&x, NULL, noop, NULL)) pthread_join(x, NULL); } return NULL; }
+static void *spin_dlopen(void *a) { (void)a; while (!atomic_load(&g_stop)) { void *h = dlopen("/usr/lib/libz.1.dylib", RTLD_NOW | RTLD_LOCAL); if (h) dlclose(h); } return NULL; }
+static void *spin_malloc(void *a) { (void)a; while (!atomic_load(&g_stop)) { void *p = malloc(4096); if (p) memset(p, 1, 64); free(p); } return NULL; }
+static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER; static pthread_cond_t cv = PTHREAD_COND_INITIALIZER;
+static void *block(void *a) { (void)a; pthread_mutex_lock(&mu); while (!atomic_load(&g_stop)) pthread_cond_wait(&cv, &mu); pthread_mutex_unlock(&mu); return NULL; }
+static void *watchdog(void *a) { (void)a; sleep(30); fprintf(stderr, "✗ t_tdump_stress：30 秒没打完 300 次现场（卡死）\n"); _exit(2); return NULL; }
+int main(void) {
+    char tmpl[] = "/tmp/t_tdump_stress_XXXXXX"; int fd = mkstemp(tmpl); if (fd < 0) return 1;
+    g_s2a_logfd = fd;   // 现场行写临时文件，事后数
+    pthread_t t[5];
+    pthread_create(&t[0], NULL, spin_threads, NULL); pthread_create(&t[1], NULL, spin_dlopen, NULL);
+    pthread_create(&t[2], NULL, spin_malloc, NULL); pthread_create(&t[3], NULL, spin_malloc, NULL);
+    pthread_create(&t[4], NULL, block, NULL);
+    pthread_t w; pthread_create(&w, NULL, watchdog, NULL);
+    int rounds = 300, min_threads = 1 << 30;
+    for (int i = 0; i < rounds; i++) { int n = s2a_dump_threads("t_tdump_stress"); if (n < min_threads) min_threads = n; }
+    atomic_store(&g_stop, 1); pthread_mutex_lock(&mu); pthread_cond_broadcast(&cv); pthread_mutex_unlock(&mu);
+    for (int i = 0; i < 5; i++) pthread_join(t[i], NULL);
+    lseek(fd, 0, SEEK_SET); size_t cap = 1 << 26; char *buf = malloc(cap); ssize_t len = read(fd, buf, cap - 1); close(fd); unlink(tmpl);
+    if (len < 0) len = 0; buf[len] = 0;
+    int heads = 0, tails = 0; for (char *p = buf; (p = strstr(p, "===== 全线程现场")); p++) heads++; for (char *p = buf; (p = strstr(p, "===== 现场完")); p++) tails++;
+    int ok = heads == rounds && tails == rounds && min_threads >= 7;   // 主线程 + 5 条夹具线程 + 看门线程（建收线程那条瞬时还会多一条）
+    printf("%s t_tdump_stress：%d 次现场，开头 %d / 结尾 %d（期望各 %d），每次至少 %d 条线程（期望 ≥ 7），没有卡死\n", ok ? "✓" : "✗", rounds, heads, tails, rounds, min_threads);
+    return ok ? 0 : 1;
+}
diff --git a/services/S2A.Services.Tests/AudioPerfEntryPoolTest.cs b/services/S2A.Services.Tests/AudioPerfEntryPoolTest.cs
new file mode 100644
index 0000000..ec60e32
--- /dev/null
+++ b/services/S2A.Services.Tests/AudioPerfEntryPoolTest.cs
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+using Ryujinx.Audio.Renderer.Dsp.Command;
+using Ryujinx.Audio.Renderer.Server.Performance;
+using Ryujinx.Common;
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+
+namespace S2A.Services.Tests
+{
+    // 音频性能统计条目池（#668：Mac 玩几分钟到十几分钟后音频线程托管 OOM，栈在 PerformanceCommand.Initialize → ConcurrentBag.LocalPush）。
+    //   CommandGenerator 每对 Start / End 命令只取一个 PerformanceEntryAddresses、两条命令共用；命令被复用时归还旧条目。
+    //   期望手算：每轮取 1 个、还 1 个，池里的条目数恒 ≤ 1、没有同一对象的多份。跑 1000 轮：
+    //   修前两条命令各还一次 → 每轮净涨 1，池里约 1000 个、全是重复引用；修后 ≤ 1、无重复
+    static class AudioPerfEntryPoolTest
+    {
+        const int Rounds = 1000;
+
+        static ConcurrentBag<PerformanceEntryAddresses> Items() =>
+            (ConcurrentBag<PerformanceEntryAddresses>)typeof(ObjectPool<PerformanceEntryAddresses>)
+                .GetField("_items", BindingFlags.NonPublic | BindingFlags.Instance)!
+                .GetValue(PerformanceEntryAddresses.PerformanceEntryAddressesPool)!;
+
+        [SoloTest("--audio-perf-entry-pool")]
+        private static int Run()
+        {
+            var pool = PerformanceEntryAddresses.PerformanceEntryAddressesPool;
+            pool.Clear();
+            var start = new PerformanceCommand();
+            var end = new PerformanceCommand();
+            for (int i = 0; i < Rounds; i++)
+            {
+                PerformanceEntryAddresses entry = pool.Allocate();   // 同 PerformanceManagerGeneric.GetNextEntry
+                start.Initialize(ref entry, PerformanceCommand.Type.Start, 0);   // 同 CommandBuffer.GeneratePerformance，命令从池里复用
+                end.Initialize(ref entry, PerformanceCommand.Type.End, 0);
+            }
+
+            var items = Items().ToArray();
+            int distinct = new HashSet<PerformanceEntryAddresses>(items, ReferenceEqualityComparer.Instance).Count;
+            int bad = 0;
+            bool small = items.Length <= 1;
+            if (!small) bad++;
+            Console.WriteLine($"{(small ? "✓" : "✗")} {Rounds} 轮 Start / End 共用条目后池里 {items.Length} 个（期望 ≤ 1，修前约 {Rounds}）");
+            bool unique = distinct == items.Length;
+            if (!unique) bad++;
+            Console.WriteLine($"{(unique ? "✓" : "✗")} 池里没有同一对象的多份：{items.Length} 个里不同对象 {distinct} 个");
+
+            // 负对照：End 被复用时确实归还了（不是两条都不还、靠漏掉对象让池子不涨）
+            pool.Clear();
+            start = new PerformanceCommand(); end = new PerformanceCommand();   // 新命令：上面循环里的 End 还拿着最后一轮的条目，复用时会先还那一个
+            PerformanceEntryAddresses held = pool.Allocate();
+            start.Initialize(ref held, PerformanceCommand.Type.Start, 0);
+            end.Initialize(ref held, PerformanceCommand.Type.End, 0);
+            PerformanceEntryAddresses none = null;
+            start.Initialize(ref none, PerformanceCommand.Type.Start, 0);
+            end.Initialize(ref none, PerformanceCommand.Type.End, 0);
+            var back = Items().ToArray();
+            bool returned = back.Length == 1 && ReferenceEquals(back[0], held);
+            if (!returned) bad++;
+            Console.WriteLine($"{(returned ? "✓" : "✗")} End 复用时把共用条目还回池里恰好一次（池里 {back.Length} 个）");
+
+            pool.Clear();
+            return bad == 0 ? 0 : 1;
+        }
+    }
+}
diff --git a/services/S2A.Services.Tests/CameraNoDeviceTest.cs b/services/S2A.Services.Tests/CameraNoDeviceTest.cs
new file mode 100644
index 0000000..f8b42dc
--- /dev/null
+++ b/services/S2A.Services.Tests/CameraNoDeviceTest.cs
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+using Ryujinx.HLE;
+using Ryujinx.HLE.HOS;
+using Ryujinx.HLE.HOS.Kernel.Process;
+using System;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+
+namespace S2A.Services.Tests
+{
+    // 诊断 #0148a6：Switch 2 摄像头会话（nn::camera::sdk::CreateCameraContext 给游戏的句柄）按「接口有、没插摄像头的主机」答。
+    // 期望值照 nxnative dm/host/hle_sf.c camera_answer（MIT）手写，不跑被测实现推：命令 3 / 4 成功；21 成功并复制 1 个事件句柄；
+    //   29（QueryDeviceConnection）与其它命令回 0x7c4（没检测到摄像头设备）；都不报红
+    static unsafe class CameraNoDeviceTest
+    {
+        static int _events;
+        static ulong EvCreate(uint* r, uint* w) { _events++; if (r != null) *r = 0x8100u + (uint)_events; return 0xE000u + (ulong)_events; }
+        static uint EvDup(ulong ev) => 0x9000;
+
+        static void Set(object o, string field, object v) =>
+            o.GetType().GetField($"<{field}>k__BackingField", BindingFlags.NonPublic | BindingFlags.Instance)!.SetValue(o, v);
+
+        [SoloTest("--camera-no-device")]
+        public static int Run()
+        {
+            var d = (Dispatcher)RuntimeHelpers.GetUninitializedObject(typeof(Dispatcher));
+            var device = (Switch)RuntimeHelpers.GetUninitializedObject(typeof(Switch));
+            Set(device, "Configuration", RuntimeHelpers.GetUninitializedObject(typeof(HleConfiguration)));
+            Set(d, "Device", device);
+            var server = new KProcess(null);
+            server.HandleTable.Initialize(32);
+            Set(d, "ServerProcess", server);
+            var target = new CameraNoDevice();
+            var create = Native.EventCreate; var dup = Native.EventDupRead;
+            int cases = 0, failures = 0;
+            long red0 = Red.Total;
+            try
+            {
+                Native.EventCreate = &EvCreate; Native.EventDupRead = &EvDup;
+                void Case(uint cmd, uint expected, int copies)
+                {
+                    cases++;
+                    byte* buffer = stackalloc byte[0x100];
+                    Msg.Cmif(cmd).Write(buffer);
+                    uint kr = target.Process(d, buffer, 0x100);
+                    Reply r = Reply.Parse(buffer);
+                    bool ok = kr == 0 && r.Result == expected && r.Copy.Count == copies && r.Move.Count == 0;
+                    if (!ok) failures++;
+                    Console.WriteLine($"{(ok ? "✓" : "✗")} 摄像头会话 命令 {cmd}：期望 结果 0x{expected:x}、复制句柄 {copies} → 内核 0x{kr:x}、结果 0x{r.Result:x}、复制 {r.Copy.Count}、移交 {r.Move.Count}");
+                }
+                Case(3, 0, 0);       // 打开设备
+                Case(21, 0, 1);      // 摄像头事件：永不触发的事件读端
+                Case(29, 0x7c4, 0);  // QueryDeviceConnection：没插
+                Case(7, 0x7c4, 0);   // 其它命令
+                Case(21, 0, 1);      // 再取一次事件：同一个事件再发读端
+                Case(4, 0, 0);       // 关闭
+            }
+            finally { Native.EventCreate = create; Native.EventDupRead = dup; }
+            cases++;
+            bool once = _events == 1, quiet = Red.Total == red0;
+            if (!(once && quiet)) failures++;
+            Console.WriteLine($"{(once && quiet ? "✓" : "✗")} 摄像头会话：原生事件只建 1 个（实 {_events}）、报红 +0（实 +{Red.Total - red0}）");
+            Console.WriteLine($"{(failures == 0 ? "✓" : "✗")} camera-no-device：{cases - failures}/{cases} 项符合");
+            return failures == 0 ? 0 : 1;
+        }
+    }
+}
diff --git a/services/S2A.Services.Tests/SharedFontDecryptTest.cs b/services/S2A.Services.Tests/SharedFontDecryptTest.cs
new file mode 100644
index 0000000..2519fcc
--- /dev/null
+++ b/services/S2A.Services.Tests/SharedFontDecryptTest.cs
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+using System;
+using System.Buffers.Binary;
+using System.IO;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+
+namespace S2A.Services.Tests
+{
+    // 共享字体解密（Ryujinx.HLE SharedFontManager.DecryptFont）对文件流只取一次长度（11-17 D-FCMF：Switch 2 游戏取内置字体 2010 等了 190 秒、黑屏，
+    //   玩家现场栈停在 fstat——上游循环条件每 4 字节取一次 Stream.Length，文件流上每次一次 fstat，17.5 MB 字体约 440 万次）。
+    //   期望值不跑被测实现：造一份 BFTTF（头 = 魔数 ^ 键、长度字、正文按公开格式每 4 字节异或 0x06186249），正文明文按下标手造；
+    //   计数流数 Length 被读几次。期望：解出的正文与明文逐字节同；Length 读 1 次（上游写法是 正文字数 + 1 次）
+    public static partial class Program
+    {
+        private sealed class LengthCountingStream(byte[] data) : MemoryStream(data, writable: false)
+        {
+            public int LengthReads;
+
+            public override long Length
+            {
+                get
+                {
+                    LengthReads++;
+                    return base.Length;
+                }
+            }
+        }
+
+        [SoloTest("--shared-font-decrypt")]
+        private static int SharedFontDecrypt()
+        {
+            const uint Key = 0x06186249, Magic = 0x18029a7f;
+            const int Words = 250_000;   // 1 MB 正文：上游写法要读 25 万次 Length
+            byte[] plain = new byte[Words * 4];
+            for (int i = 0; i < plain.Length; i++)
+            {
+                plain[i] = (byte)(i * 31 + 7);
+            }
+
+            byte[] file = new byte[8 + plain.Length];
+            BinaryPrimitives.WriteUInt32LittleEndian(file, Magic ^ Key);
+            BinaryPrimitives.WriteUInt32LittleEndian(file.AsSpan(4), BinaryPrimitives.ReverseEndianness((uint)plain.Length) ^ Key);
+            for (int w = 0; w < Words; w++)
+            {
+                BinaryPrimitives.WriteUInt32LittleEndian(file.AsSpan(8 + w * 4), BinaryPrimitives.ReadUInt32LittleEndian(plain.AsSpan(w * 4)) ^ Key);
+            }
+
+            Type mgr = typeof(Ryujinx.HLE.Switch).Assembly.GetType("Ryujinx.HLE.HOS.Services.Sdb.Pl.SharedFontManager", throwOnError: true)!;
+            MethodInfo decrypt = mgr.GetMethod("DecryptFont", BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance)!;
+            // 实例方法（上游写法）不读成员：造一个未初始化实例来调，负对照才能量到长度读取次数
+            object? self = decrypt.IsStatic ? null : RuntimeHelpers.GetUninitializedObject(mgr);
+
+            using LengthCountingStream stream = new(file);
+            byte[] got = (byte[])decrypt.Invoke(self, [stream])!;
+
+            int bad = 0;
+            if (got.Length != plain.Length)
+            {
+                bad++;
+            }
+            else
+            {
+                for (int i = 0; i < plain.Length; i++)
+                {
+                    bad += got[i] != plain[i] ? 1 : 0;
+                }
+            }
+
+            bool ok = bad == 0 && stream.LengthReads == 1;
+            Console.WriteLine($"{(ok ? "✓" : "✗")} 共享字体解密：正文 {plain.Length} 字节逐字节同（期望 0 处不同 → 真结果 {bad} 处）；文件长度读 {stream.LengthReads} 次（期望 1 次，上游写法 {Words + 1} 次）");
+            return ok ? 0 : 1;
+        }
+    }
+}
diff --git a/services/S2A.Services/CameraNoDevice.cs b/services/S2A.Services/CameraNoDevice.cs
new file mode 100644
index 0000000..244cfe3
--- /dev/null
+++ b/services/S2A.Services/CameraNoDevice.cs
@@ -0,0 +1,93 @@
+using Microsoft.IO;
+using Ryujinx.Common.Memory;
+using Ryujinx.HLE.HOS.Ipc;
+using Ryujinx.HLE.HOS.Kernel.Threading;
+using System;
+using System.Buffers;
+using System.Runtime.InteropServices;
+
+namespace S2A.Services
+{
+    // Switch 2 摄像头会话（GameChat 视频用的 USB 摄像头）：nn::camera::sdk::CreateCameraContext 本来向图形系统的用户会话（gsv）要一个到摄像头服务的会话、
+    //   当 UniqueNativeHandle（32 位句柄）交给游戏，游戏再用 SDK 的 HIPC 客户端经这个会话跟摄像头说话。宿主没有 gsv 会话，原先输出参数写 0：
+    //   游戏对句柄 0 发 SendSyncRequest，会话不在会话表 → sdk 中止（诊断 #0148a6：一款 Switch 2 游戏 0400C3F00006E000 在 iPad 上 5 局都在这里 Break）。
+    // 这里给一个真会话，按「接口有、没插摄像头的主机」答（做法与依据照 nxnative dm/host/hle_sf.c camera_answer，MIT）：
+    //   命令 3（打开设备，名字 "Default"）、4（关闭）成功；21（摄像头事件）复制一个永不触发的事件的读端；其余（含 29 QueryDeviceConnection）回 0x7c4 =「没检测到摄像头设备」。
+    sealed class CameraNoDevice : SessionTarget
+    {
+        private const uint NoDevice = 0x7c4;
+        private KEvent _event;
+        private static int s_said;
+
+        public override string Name => "camera(gsv)";
+
+        public override unsafe uint Process(Dispatcher d, byte* msg, int size)
+        {
+            IpcMessage request = new(new ReadOnlySpan<byte>(msg, Math.Min(size, 0x100)), (long)msg);
+            IpcMessage response = new();
+            Dispatcher.Streams s = Dispatcher.ThreadStreams;
+
+            if (request.Type is IpcMessageType.CmifCloseSession or IpcMessageType.TipcCloseSession) return 0;
+
+            if (request.Type is IpcMessageType.CmifControl or IpcMessageType.CmifControlWithContext)
+            {
+                s.Resp.SetLength(0);
+                Control(d, BitConverter.ToUInt32(request.RawData, 8), response, s);
+                response.RawData = s.Resp.ToArray();
+                Write(msg, response);
+                return 0;
+            }
+
+            if (request.Type is not (IpcMessageType.CmifRequest or IpcMessageType.CmifRequestWithContext))
+            {
+                Red.Report($"摄像头会话：消息类型未支持 {request.Type}");
+                return 0xF601;
+            }
+
+            uint cmd = BitConverter.ToUInt32(request.RawData, 8);
+            uint result = cmd switch { 3 or 4 or 21 => 0, _ => NoDevice };
+            int eventHandle = 0;
+
+            if (cmd == 21)
+            {
+                _event ??= new KEvent(d.Kernel);
+                var rc = d.ServerProcess.HandleTable.GenerateHandle(_event.ReadableEvent, out eventHandle);
+                if (rc != Ryujinx.Horizon.Common.Result.Success) { Red.Report($"摄像头会话：事件句柄分配失败 {rc.ErrorCode}"); result = NoDevice; eventHandle = 0; }
+            }
+
+            if (System.Threading.Interlocked.Exchange(ref s_said, 1) == 0)
+                Console.Error.WriteLine($"[s2a] 摄像头会话：宿主没有摄像头，按「没插摄像头」答（首个命令 {cmd} → 0x{result:x}；3 / 4 成功、21 给永不触发的事件、其余 0x7c4）");
+
+            s.Resp.SetLength(0);
+            s.Writer.Write(IpcMagic.Sfco);
+            s.Writer.Write((long)result);
+            response.Type = IpcMessageType.CmifResponse;
+            response.RawData = s.Resp.ToArray();
+
+            if (eventHandle != 0)
+            {
+                response.HandleDesc = IpcHandleDesc.MakeCopy(eventHandle);
+                uint kr = d.TranslateResponseHandles(response.HandleDesc);
+                if (kr != 0) return kr;
+            }
+
+            Write(msg, response);
+            return 0;
+        }
+
+        private static unsafe void Write(byte* msg, IpcMessage response)
+        {
+            RecyclableMemoryStream rs = response.GetStream((long)msg, 0);
+            try { rs.GetReadOnlySequence().CopyTo(new Span<byte>(msg, (int)rs.Length)); }
+            finally { MemoryStreamManager.Shared.ReleaseStream(rs); }
+        }
+
+        // 原生层 nn::camera::sdk::CreateCameraContext（graphics/nvn/gfx/nvn/nvn2.c）调：建一个摄像头会话，回游戏句柄（0 = 服务层没起）
+        [UnmanagedCallersOnly(EntryPoint = "S2A_CameraSessionOpen")]
+        private static uint Open()
+        {
+            Dispatcher d = Dispatcher.Instance;
+            return d == null ? 0 : d.NewSessionHandle(new CameraNoDevice());
+        }
+    }
+}
