+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <math.h>
+#include <stdatomic.h>
+#include <stdint.h>
+
+// A producer reserves one record at command-buffer creation or ticket enqueue.
+// The generation in each counter prevents an old reservation using a new budget.
+enum { RB_PT_FRAMES = 600, RB_PT_CB_CAP = 16384, RB_PT_PRESENT_CAP = 4096 };
+typedef struct {
+    _Atomic uint64_t session, first, cb, present;
+    _Atomic unsigned notified;
+} rb_pt_gate;
+static inline void rb_pt_configure(rb_pt_gate *g, uint64_t session, uint64_t first) {
+    atomic_store(&g->session, 0);
+    atomic_store(&g->first, first);
+    atomic_store(&g->cb, session << 16);
+    atomic_store(&g->present, session << 16);
+    atomic_store(&g->notified, 0);
+    atomic_store_explicit(&g->session, session, memory_order_release);
+}
+static inline uint64_t rb_pt_claim(rb_pt_gate *g, uint64_t session, uint64_t frame,
+                                   _Atomic uint64_t *counter, unsigned cap) {
+    uint64_t first = atomic_load_explicit(&g->first, memory_order_relaxed);
+    if (frame < first || frame - first >= RB_PT_FRAMES) return 0;
+    uint64_t word = atomic_load_explicit(counter, memory_order_relaxed);
+    while ((word >> 16) == session && (word & UINT16_MAX) <= cap) {
+        if (atomic_compare_exchange_weak_explicit(counter, &word, word + 1,
+                                                  memory_order_relaxed, memory_order_relaxed))
+            return (word & UINT16_MAX) < cap ? session : 0;
+    }
+    return 0;
+}
+static inline unsigned rb_pt_close(_Atomic uint64_t *counter) {
+    // Close reservations before taking the summary. Completion callbacks retain
+    // their original session and may emit rows after this point.
+    return atomic_fetch_or(counter, UINT64_C(1) << 63) & UINT16_MAX;
+}
+static inline int rb_pt_has_gpu(double prepared, double start, double end) {
+    return isfinite(prepared) && prepared > 0 && isfinite(start) && start >= prepared &&
+           isfinite(end) && end > start;
+}
