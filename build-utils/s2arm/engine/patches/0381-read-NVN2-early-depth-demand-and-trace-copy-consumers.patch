diff --git a/graphics/nvn/gfx/nvn/rb_guest_early.h b/graphics/nvn/gfx/nvn/rb_guest_early.h
new file mode 100644
index 0000000..de3377f
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_guest_early.h
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+// NVN2 driver fragment flag byte. Read only; no translator input is changed.
+// Reference: nxnative dm/gfx/tools/dmsh_ampere.py early_fragment_tests.
+// 0 unknown, 1 explicitly false, 2 explicitly true.
+static inline unsigned rb_guest_early_nvn2(const void *bytes,size_t length) {
+    if (!bytes || length<0x5c) return 0;
+    const uint8_t *p=bytes; uint32_t magic,version;
+    memcpy(&magic,p,4); memcpy(&version,p+4,4);
+    if (magic!=0x98761234u || version!=0xc9u) return 0;
+    return 1u+(p[0x5b]!=0);
+}
