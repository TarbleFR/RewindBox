+// RewindBox (patch 0075): machine-wide paging and CPU since the previous call, for the [写盘] line. Heartbeat queue only (serial): the statics need no lock
+static void rb_vm_line(char *out, size_t n) {
+    static uint64_t last[6], lcpu[3], lt; static int have_vm, have_cpu;
+    uint64_t t = clock_gettime_nsec_np(CLOCK_UPTIME_RAW); double dt = lt && t > lt ? (double)(t - lt) / 1e9 : 0; lt = t;
+    vm_statistics64_data_t vs; mach_msg_type_number_t vc = HOST_VM_INFO64_COUNT; size_t o = 0;
+    kern_return_t kr = host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t)&vs, &vc);
+    if (kr != KERN_SUCCESS) { o = (size_t)snprintf(out, n, "；RewindBox: machine VM not readable (kr=%d)", (int)kr); have_vm = 0; }
+    else {
+        uint64_t cur[6] = { vs.compressions, vs.decompressions, vs.swapins, vs.swapouts, vs.pageins, vs.pageouts }, d[6];
+        for (int i = 0; i < 6; i++) d[i] = have_vm && cur[i] >= last[i] ? cur[i] - last[i] : 0;
+        if (have_vm) o = (size_t)snprintf(out, n, "；RewindBox: machine VM over %.1f s (HOST_VM_INFO64, pages): compressions %llu, decompressions %llu, swapins %llu, swapouts %llu, pageins %llu, pageouts %llu",
+                                          dt, (unsigned long long)d[0], (unsigned long long)d[1], (unsigned long long)d[2], (unsigned long long)d[3], (unsigned long long)d[4], (unsigned long long)d[5]);
+        else o = (size_t)snprintf(out, n, "；RewindBox: machine VM counted from here (HOST_VM_INFO64)");
+        memcpy(last, cur, sizeof last); have_vm = 1;
+    }
+    natural_t nc = 0; processor_info_array_t pa = NULL; mach_msg_type_number_t pn = 0; uint64_t cpu[3] = {0, 0, 0};   // ticks over all cores: system, user + nice, all
+    if (host_processor_info(mach_host_self(), PROCESSOR_CPU_LOAD_INFO, &nc, &pa, &pn) == KERN_SUCCESS && nc && pa) {
+        processor_cpu_load_info_data_t *c = (processor_cpu_load_info_data_t *)pa;
+        for (natural_t i = 0; i < nc; i++) { uint64_t sy = c[i].cpu_ticks[CPU_STATE_SYSTEM], us = (uint64_t)c[i].cpu_ticks[CPU_STATE_USER] + c[i].cpu_ticks[CPU_STATE_NICE]; cpu[0] += sy; cpu[1] += us; cpu[2] += sy + us + c[i].cpu_ticks[CPU_STATE_IDLE]; }
+        if (o < n && have_cpu && cpu[2] > lcpu[2] && cpu[0] >= lcpu[0] && cpu[1] >= lcpu[1])
+            snprintf(out + o, n - o, "; machine CPU system %.0f%%, user %.0f%% (%u cores)", 100.0 * (double)(cpu[0] - lcpu[0]) / (double)(cpu[2] - lcpu[2]),
+                     100.0 * (double)(cpu[1] - lcpu[1]) / (double)(cpu[2] - lcpu[2]), (unsigned)nc);
+        memcpy(lcpu, cpu, sizeof lcpu); have_cpu = 1;
+    } else { if (o < n) snprintf(out + o, n - o, "; machine CPU not readable"); have_cpu = 0; }
+    if (pa) vm_deallocate(mach_task_self(), (vm_address_t)pa, pn * sizeof(integer_t));
+}
