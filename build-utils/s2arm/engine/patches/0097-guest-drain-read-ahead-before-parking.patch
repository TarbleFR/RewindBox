 // hle_nvn.c's long-frame line: pages texture reads found not in memory since the last call, those in pools without CPU access (L16: what a private backing of such pools could
 //   save), and the reads not looked at (not wholly in the window's files); all -1 where the window is not in files (s2a_guest_fd), where nothing is looked at
diff --git a/graphics/nvn/gfx/nvn/nvn_session.inc b/graphics/nvn/gfx/nvn/nvn_session.inc
--- a/graphics/nvn/gfx/nvn/nvn_session.inc
+++ b/graphics/nvn/gfx/nvn/nvn_session.inc
@@ -87,6 +87,22 @@
 int nvn_be_shutdown_session(void) {
     rb_sub_open(2);   // RewindBox (patch 0071): no idle release by the pressure handler from here to the next session's first submission end (it waits for one under way; nvn_mtl.m rb_press_release)
     int e = session_wait_backend(); if (e) { MLOG("【红】重启：Metal 工作仍持有旧会话 (%d)", e); return e; }
+    if (rb_park_compat()) {
+        // Guest/encode and upload producers are already retired by session_wait_backend.
+        dispatch_group_t reads = dispatch_group_create();
+        if (g_rb_tex_ahead_q) dispatch_group_async(reads, g_rb_tex_ahead_q, ^{});
+        if (g_rb_pool_ahead_q) dispatch_group_async(reads, g_rb_pool_ahead_q, ^{});
+        uint64_t begin = now_ns();
+        if (dispatch_group_wait(reads, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC))) {
+            MLOG("RewindBox (patch 0097): guest read-ahead did not drain");
+            return -ETIMEDOUT;
+        }
+        for (size_t i = 0; i < sizeof g_pf_recent / sizeof *g_pf_recent; i++) atomic_store(&g_pf_recent[i], 0);
+        for (size_t i = 0; i < sizeof g_pa_last / sizeof *g_pa_last; i++) atomic_store(&g_pa_last[i], 0);
+        atomic_store(&g_pf_budget, 0);
+        atomic_store(&g_pa_budget, 0);
+        MLOG("RewindBox (patch 0097): guest read-ahead drained in %.1f ms", (now_ns() - begin) / 1e6);
+    }
     // Keep completed immutable shader loads in the device cache. This also
     // consumes the old prefetch handoff before its pipeline maps are cleared.
     warm_claim();
