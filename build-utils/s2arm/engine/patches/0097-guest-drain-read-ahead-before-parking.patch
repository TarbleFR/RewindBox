+    dispatch_async(g_rb_tex_ahead_q, ^{ uint64_t k = rb_wn(p, n); atomic_fetch_add_explicit(&g_pf_pages, k == RB_WN_NONE ? 0 : k, memory_order_relaxed); atomic_fetch_sub_explicit(&g_pf_pend, (int64_t)n, memory_order_relaxed); });
