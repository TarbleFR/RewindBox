diff --git a/graphics/nvn/tests/t_rb_msl_coverage.py b/graphics/nvn/tests/t_rb_msl_coverage.py
new file mode 100644
index 0000000000000000000000000000000000000000..2c6c7bafb4dc942ee0b653390506bba1376ed909
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_msl_coverage.py
@@ -0,0 +1,48 @@
+"""Check every production Metal source-compilation selector reachable from direct NVN."""
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[3]
+NVN = ROOT / "graphics/nvn"
+INCLUDE = re.compile(r'^\s*#\s*(?:include|import)\s*"([^"\n]+)"', re.MULTILINE)
+NONCODE = re.compile(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|//[^\n]*|/\*.*?\*/', re.DOTALL)
+
+
+def direct_sources():
+    # Also scan sibling translation units: the deswizzle compiler is linked
+    # separately, so walking only nvn_mtl.m's textual inclusions misses it.
+    stack = [NVN / "host_adapt.m"]
+    for folder in (NVN / "gfx/nvn", NVN / "gfx/tex"):
+        stack.extend(p for p in folder.iterdir() if p.suffix in {".c", ".m", ".mm", ".cpp"})
+    seen = set()
+    while stack:
+        p = stack.pop().resolve()
+        if p in seen:
+            continue
+        seen.add(p)
+        src = p.read_text()
+        yield p, src
+        for local in INCLUDE.findall(src):
+            candidate = p.parent / local
+            if candidate.is_file():
+                stack.append(candidate)
+
+
+source_header = ROOT / "graphics/metal/mtl_source.h"
+raw = []
+text = {}
+for path, source in direct_sources():
+    text[path] = source
+    code = NONCODE.sub(" ", source)
+    raw.extend([path] * len(re.findall(r'\bnewLibraryWithSource\s*:',code)))
+assert raw == [source_header], [str(p.relative_to(ROOT)) for p in raw]
+header = text[source_header]
+assert "[device newLibraryWithSource:source options:options error:error]" in header
+engine = text[NVN / "gfx/nvn/nvn_mtl.m"]
+for helper in ("nvn_deswz_gpu_init_using", "s2a_lodbias_native_using"):
+    assert f"{helper}(g_dev,rb_compile_auxiliary)" in engine
+assert "#define WD_P2_COMPILE rb_compile_auxiliary" in text[NVN / "widen_glue.inc"]
+assert "make_library(dev," in text[NVN / "gfx/tex/nvn_deswizzle_gpu.m"]
+assert "make_library(dev," in text[ROOT / "graphics/metal/gal_samp_caps.h"]
+assert "rb_measure_source(g_dev,vs,dm_msl_opts(),&e,1)" in engine
+print(f"Checked {len(text)} direct NVN sources and includes. One synchronous Metal source gateway.")
