diff --git a/graphics/nvn/gfx/nvn/rb_attachment_ranges.h b/graphics/nvn/gfx/nvn/rb_attachment_ranges.h
new file mode 100644
index 0000000..bd7b198
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_attachment_ranges.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// Process-lifetime, conservative unions of guest backing bytes. The caller serializes
+// updates and queries. Keep an address exposed even when its descriptor is overwritten,
+// unregistered or reused by another resource. A full/ambiguous union fails closed.
+enum { RB_RANGE_LIMIT = 2048 };
+typedef struct { uintptr_t first, last; } rb_attachment_span; // both endpoints included
+typedef struct { rb_attachment_span spans[RB_RANGE_LIMIT]; unsigned n; int unknown; } rb_attachment_ranges;
+
+static inline int rb_attachment_span_make(uintptr_t address, uint64_t bytes, rb_attachment_span *out) {
+    if (!address || !bytes || bytes - 1 > UINTPTR_MAX - address) return 0;
+    *out = (rb_attachment_span){address, address + (uintptr_t)(bytes - 1)};
+    return 1;
+}
+static inline unsigned rb_range_start(const rb_attachment_ranges *r, uintptr_t first) {
+    unsigned lo = 0, hi = r->n;
+    while (lo < hi) {
+        unsigned mid = lo + (hi - lo) / 2;
+        if (r->spans[mid].last < first) lo = mid + 1;
+        else hi = mid;
+    }
+    return lo;
+}
+static inline int rb_range_hits(const rb_attachment_ranges *r, rb_attachment_span q) {
+    unsigned i = rb_range_start(r, q.first);
+    return r->unknown || (i < r->n && r->spans[i].first <= q.last);
+}
+static inline void rb_range_add(rb_attachment_ranges *r, uintptr_t address, uint64_t bytes) {
+    rb_attachment_span q;
+    if (r->unknown) return;
+    if (!rb_attachment_span_make(address, bytes, &q)) { r->unknown = 1; return; }
+    // Fold touching spans too, especially sequential tiles of virtual pools.
+    unsigned i = rb_range_start(r, q.first - 1), end = i;
+    while (end < r->n && (q.last == UINTPTR_MAX || r->spans[end].first <= q.last + 1)) {
+        if (r->spans[end].first < q.first) q.first = r->spans[end].first;
+        if (r->spans[end].last > q.last) q.last = r->spans[end].last;
+        ++end;
+    }
+    if (i == end && r->n == RB_RANGE_LIMIT) { r->unknown = 1; return; }
+    if (end != i + 1) memmove(&r->spans[i + 1], &r->spans[end], (r->n - end) * sizeof q);
+    r->spans[i] = q;
+    r->n = r->n - (end - i) + 1;
+}
diff --git a/graphics/nvn/gfx/nvn/rb_sealed_clear.h b/graphics/nvn/gfx/nvn/rb_sealed_clear.h
new file mode 100644
index 0000000..b01a0b9
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_sealed_clear.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "nvn_obj.h"
+
+// Only END transitions cross a list. Accept a single clear followed by a
+// proven materialization. A missing or cyclic continuation never proves death.
+static inline const uint8_t *rb_sealed_overwrite(const uint8_t *next, const uint8_t *const *returns,
+                                                 int ret, const uint64_t *following, int lists, int lazy_clear) {
+    const uint8_t *clear = NULL;
+    int rest = 0, crossed = 0, landing = 0;
+    for (int n = 0; next && n < 24; ++n) {
+        op_hdr h; memcpy(&h, next, sizeof h);
+        if (h.size < 8 || (h.size & 7)) return NULL;
+        if (h.op == OP_END && h.size == 8) {
+            if (ret) next = returns[--ret];
+            else if (rest < lists) next = (const uint8_t *)(uintptr_t)following[rest++];
+            else { landing = 1; break; } // sub_commit → rp_flush
+            crossed = 1; continue;
+        }
+        if (!clear) {
+            if ((h.op == OP_CLEAR_COLOR && h.size == 8 + sizeof(p_clear_color)) ||
+                (h.op == OP_CLEAR_DS && h.size == 8 + sizeof(p_clear_ds))) {
+                clear = next; next += h.size; continue;
+            }
+        } else if (h.op == OP_SET_RT && h.size >= 8 + sizeof(p_set_rt_c) && !lazy_clear) {
+            p_set_rt_c rt;
+            memcpy(&rt, next + sizeof h, sizeof rt);
+            if (rt.n > 8 || (rt.cmask >> rt.n) || (rt.vmask & ~rt.cmask) ||
+                (rt.dflags & ~(SET_RT_DEPTH | SET_RT_DVIEW)) ||
+                ((rt.dflags & SET_RT_DVIEW) && !(rt.dflags & SET_RT_DEPTH)) ||
+                h.size != sizeof h + set_rt_payload(&rt)) return NULL;
+            landing = 1; break;
+        }
+        return NULL;
+    }
+    return crossed && landing ? clear : NULL;
+}
diff --git a/graphics/nvn/tests/t_rb_attachment_liveness.c b/graphics/nvn/tests/t_rb_attachment_liveness.c
new file mode 100644
index 0000000..17660c9
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_attachment_liveness.c
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_attachment_ranges.h"
+#include "../gfx/nvn/rb_sealed_clear.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static int checks;
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "Failed line %d: %s\n", __LINE__, #x); exit(1); } ++checks; } while (0)
+static unsigned rng = 0x1b547;
+static unsigned random_word(void) { rng = rng * 1664525u + 1013904223u; return rng; }
+static void range_tests(void) {
+    rb_attachment_ranges table = {0};
+    rb_attachment_span q;
+    CHECK(!rb_attachment_span_make(0, 8, &q));
+    CHECK(!rb_attachment_span_make(42, 0, &q));
+    CHECK(!rb_attachment_span_make(UINTPTR_MAX - 1, 3, &q));
+    CHECK(rb_attachment_span_make(UINTPTR_MAX - 1, 2, &q));
+    rb_range_add(&table, UINTPTR_MAX, 1);
+    CHECK(rb_range_hits(&table, q));
+    rb_range_add(&table, 100, 4); rb_range_add(&table, 110, 1);
+    rb_range_add(&table, 104, 6);
+    CHECK(table.n == 2 && table.spans[0].first == 100 && table.spans[0].last == 110);
+    CHECK(!rb_range_hits(&table, (rb_attachment_span){111, 112}));
+    CHECK(rb_range_hits(&table, (rb_attachment_span){99, 100}));
+    int seen[4096] = {0};
+    memset(&table, 0, sizeof table);
+    for (int i = 0; i < 2000; i++) {
+        unsigned first = 1 + random_word() % 4000, n = 1 + random_word() % 32;
+        rb_range_add(&table, first, n);
+        for (unsigned k = first; k < first + n; k++) seen[k] = 1;
+        unsigned lo = 1 + random_word() % 4000, count = 1 + random_word() % 17;
+        int oracle = 0;
+        for (unsigned k = lo; k < lo + count; k++) oracle |= seen[k];
+        CHECK(rb_range_hits(&table, (rb_attachment_span){lo, lo + count - 1}) == oracle);
+    }
+    memset(&table, 0, sizeof table);
+    for (unsigned i = 0; i < RB_RANGE_LIMIT; i++) rb_range_add(&table, 1u + i * 4u, 1);
+    CHECK(!table.unknown);
+    rb_range_add(&table, 2, 1); CHECK(!table.unknown); // merge even when full
+    rb_range_add(&table, 1u + RB_RANGE_LIMIT * 4u, 1);
+    CHECK(table.unknown && rb_range_hits(&table, (rb_attachment_span){22, 22}));
+}
+static void list_tests(void) {
+    struct { op_hdr h; p_clear_color c; op_hdr end; } clear = {{OP_CLEAR_COLOR,8 + sizeof(p_clear_color)}, {0}, {OP_END,8}};
+    op_hdr end = {OP_END,8};
+    struct { op_hdr h; p_set_rt_c payload; } rt = {{OP_SET_RT,8 + sizeof(p_set_rt_c)}, {0}};
+    const uint8_t *returns[] = {(const uint8_t *)&clear};
+    uint64_t lists[] = {(uintptr_t)&clear, (uintptr_t)&rt};
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end, NULL,0,lists,1,1) == (const uint8_t *)&clear);
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end,returns,1,NULL,0,1) == (const uint8_t *)&clear);
+    CHECK(rb_sealed_overwrite((const uint8_t *)&clear,NULL,0,NULL,0,0) == NULL); // 0215's existing case
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,2,0) == (const uint8_t *)&clear);
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,2,1) == NULL); // unlanded lazy group
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end,NULL,0,NULL,0,1) == NULL);
+    for (unsigned op = 0; op < OP_COUNT_; ++op) {
+        if (op == OP_END || op == OP_SET_RT) continue;
+        op_hdr unknown = {op,8};
+        lists[1] = (uintptr_t)&unknown;
+        CHECK(rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,2,0) == NULL);
+    }
+    lists[1] = (uintptr_t)&rt;
+    rt.payload.dflags = SET_RT_DVIEW;
+    CHECK(!rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,2,0));
+    rt.payload.dflags = SET_RT_DEPTH;
+    CHECK(!rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,2,0));
+    rt.payload.dflags = 0; rt.payload.n = 9;
+    CHECK(!rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,2,0));
+    lists[0] = 0;
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end,NULL,0,lists,1,0) == NULL);
+    clear.h.size -= 8;
+    CHECK(rb_sealed_overwrite((const uint8_t *)&end,returns,1,NULL,0,1) == NULL);
+}
+int main(void) {
+    range_tests(); list_tests();
+    printf("PASS %d attachment range and sealed-list checks\n", checks);
+    return 0;
+}
diff --git a/graphics/nvn/tests/t_rb_clear_plane_metal.m b/graphics/nvn/tests/t_rb_clear_plane_metal.m
new file mode 100644
index 0000000..49b0c60
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_clear_plane_metal.m
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: MIT
+// xcrun clang -fobjc-arc -framework Foundation -framework Metal t_rb_clear_plane_metal.m -o plane-test
+// Read each aspect after clearing only its sibling, including across command buffers.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+enum { WIDTH = 16, HEIGHT = 12, ROW = 256, ASPECT_BYTES = ROW * HEIGHT };
+static int check_pass(id<MTLCommandQueue> queue, id<MTLTexture> t, id<MTLBuffer> out,
+                      int with_depth, int with_stencil, float depth, uint8_t stencil,
+                      float want_depth, uint8_t want_stencil) {
+    id<MTLCommandBuffer> cb = [queue commandBuffer];
+    MTLRenderPassDescriptor *pd = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (with_depth) {
+        pd.depthAttachment.texture = t;
+        pd.depthAttachment.loadAction = MTLLoadActionClear;
+        pd.depthAttachment.storeAction = MTLStoreActionStore;
+        pd.depthAttachment.clearDepth = depth;
+    }
+    if (with_stencil) {
+        pd.stencilAttachment.texture = t;
+        pd.stencilAttachment.loadAction = MTLLoadActionClear;
+        pd.stencilAttachment.storeAction = MTLStoreActionStore;
+        pd.stencilAttachment.clearStencil = stencil;
+    }
+    id<MTLRenderCommandEncoder> render = [cb renderCommandEncoderWithDescriptor:pd];
+    if (!render) return 0;
+    [render endEncoding];
+    id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+    if (!blit) return 0;
+    for (int i = 0; i < 2; i++)
+        [blit copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+                  sourceSize:MTLSizeMake(WIDTH,HEIGHT,1) toBuffer:out destinationOffset:i * ASPECT_BYTES
+       destinationBytesPerRow:ROW destinationBytesPerImage:ASPECT_BYTES
+                     options:i ? MTLBlitOptionStencilFromDepthStencil : MTLBlitOptionDepthFromDepthStencil];
+    [blit endEncoding];
+    [cb commit]; [cb waitUntilCompleted];
+    if (cb.status != MTLCommandBufferStatusCompleted) { NSLog(@"GPU error %@", cb.error); return 0; }
+    const uint8_t *bytes = [out contents];
+    for (int y = 0; y < HEIGHT; y++) for (int x = 0; x < WIDTH; x++) {
+        float d; memcpy(&d, &bytes[y * ROW + 4 * x], sizeof d);
+        uint8_t s = bytes[ASPECT_BYTES + y * ROW + x];
+        if (d != want_depth || s != want_stencil) {
+            fprintf(stderr,"pixel %d,%d has depth %.8g stencil %u; expected %.8g/%u\n",
+                    x,y,d,s,want_depth,want_stencil);
+            return 0;
+        }
+    }
+    return 1;
+}
+int main(void) {
+    @autoreleasepool {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        if (!device) { fprintf(stderr,"SKIP no Metal device\n"); return 77; }
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float_Stencil8
+                                                                                    width:WIDTH height:HEIGHT mipmapped:NO];
+        d.storageMode = MTLStorageModePrivate; d.usage = MTLTextureUsageRenderTarget;
+        id<MTLTexture> t = [device newTextureWithDescriptor:d];
+        id<MTLBuffer> out = [device newBufferWithLength:2 * ASPECT_BYTES options:MTLResourceStorageModeShared];
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        if (!t || !out || !queue) { fprintf(stderr,"SETUP FAIL combined depth/stencil resource\n"); return 2; }
+        if (!check_pass(queue,t,out,1,1,0.25f,0x35,0.25f,0x35) ||
+            !check_pass(queue,t,out,1,0,0.75f,0,0.75f,0x35) ||
+            !check_pass(queue,t,out,0,1,0,0xa7,0.75f,0xa7)) return 1;
+        puts("PASS combined depth/stencil readback across three passes and command buffers");
+        return 0;
+    }
+}
