+// Admit only subresources with no GOB, column or end-of-block-row padding.
+int nvn_rect_level_span(const nvn_texdesc *d, size_t size, unsigned level, unsigned layer,
+                        uint64_t first, uint64_t end, uint64_t variation, nvn_rect_level *out) {
+    if (!d || !out || (d->target != 1 && d->target != 4) || (d->flags & 0x70) ||
+        d->samples > 1 || !d->width || !d->height || level >= 32 || first >= end || end > size)
+        return -1;
+    nvn_rect_level g;
+    uint32_t slices, bpb;
+    unsigned td;
+    if (nvn_deswizzle_geom_ex(d, level, layer, &g.pitch, &g.rows, &slices, &g.base,
+                              &g.th, &td, &bpb, &g.gobs) || td || slices != 1 ||
+        g.th > 15 || !g.gobs || g.gobs > UINT32_MAX / 64 || g.gobs * 64 != g.pitch ||
+        !g.rows || (g.rows % (8u << g.th)) || g.base > first) return -1;
+
+    uint64_t bytes = (uint64_t)g.pitch * g.rows;
+    if (bytes > size - g.base) return -1;
+    g.end = g.base + bytes;
+    uint64_t offset = nvn_tex_level_offset(d, level), next = nvn_tex_level_offset(d, level + 1);
+    if (next <= offset || bytes != next - offset || end > g.end) return -1;
+    uint64_t column = UINT64_C(512) << g.th;
+    if (((first - g.base) | variation | (end - g.base)) & (column - 1)) return -1;
+    *out = g;
+    return 0;
+}
