diff --git a/runtime/src/rb_vparena.c b/runtime/src/rb_vparena.c
new file mode 100644
index 00000000..650549fc
--- /dev/null
+++ b/runtime/src/rb_vparena.c
@@ -0,0 +1,134 @@
+// RewindBox (patch 0013): the address arena of the NVN virtual pools.
+//
+// A virtual pool (graphics/nvn/gfx/nvn/hle_nvn.c vpool_reserve) needs an inaccessible host address range of its own: its
+// buffer and texture addresses are pool base + offset, and MapVirtual aliases physical pool pages into it. That range
+// used to come from mmap(NULL). When the window cannot hold the game's standard layout (runtime/src/vawin.c: the window
+// takes the largest hole below 2^39 and leaves 3 GiB below it to the host) every virtual pool then came out of those
+// 3 GiB, which Metal, malloc, the .NET GC and the host stacks of the game's threads also live in.
+// Mario Kart World (0400C3F00006E000, iPhone17,2, IPA 733, 13 Nov): 8 pools took 1016 MB, further ones asked for 1 GiB
+// each; the host hole went from 1717 MB to 5 MB, the reservations were halved (512 MB, 32 MB, 16 MB) and then refused
+// (errno 12), MapVirtual failed 219 times and pthread_create returned EAGAIN for the game's thread 162.
+//
+// vawin.c now reserves this arena below the window at the same moment as the window, and the pools are cut from it:
+// first fit by address, free ranges kept sorted and merged, one inaccessible host page after each range (two pools are
+// never adjacent, as two kernel mappings need not be), at most RBVP_MAXSEG pools at a time (a further one is refused). A released range is covered with a fresh inaccessible mapping
+// before it is reused, so no alias of the pool that held it survives. Nothing here commits memory: the arena is address
+// space only, and it is not counted in the host hole the low-address ledger reports.
+//
+// No engine header: this file is also compiled alone by RewindBox's test (test/s2arm_vp_arena_test.py).
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+
+enum { RBVP_MAXSEG = 4096 };
+#define RBVP_PAGE 16384ull   // the host page of Apple systems: a pool base must be on it for MapVirtual to alias
+typedef struct { uint64_t a, n; } rbvp_seg;
+static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
+static rbvp_seg g_free[RBVP_MAXSEG]; static int g_nfree;
+static rbvp_seg g_held[RBVP_MAXSEG]; static int g_nheld;   // the ranges handed out, sorted by address: a release is checked against it, never against the caller's length
+static uint64_t g_base, g_size, g_used, g_peak, g_maps, g_refused, g_refused_max, g_lost, g_badlen;
+static int held_at(uint64_t a) {   // index of the first held range at or above a (caller holds g_mu)
+    int lo = 0, hi = g_nheld; while (lo < hi) { int m = (lo + hi) / 2; if (g_held[m].a < a) lo = m + 1; else hi = m; } return lo;
+}
+
+static uint64_t span_of(uint64_t len) { return ((len + RBVP_PAGE - 1) & ~(RBVP_PAGE - 1)) + RBVP_PAGE; }   // the range and its guard page
+
+// Takes [base, base + size): the caller's own inaccessible reservation. Once.
+void s2a_rb_vp_init(uint64_t base, uint64_t size) {
+    pthread_mutex_lock(&g_mu);
+    uint64_t a = (base + RBVP_PAGE - 1) & ~(RBVP_PAGE - 1), e = (base + size) & ~(RBVP_PAGE - 1);
+    if (!g_size && e > a) { g_base = a; g_size = e - a; g_free[0] = (rbvp_seg){a, e - a}; g_nfree = 1; }
+    pthread_mutex_unlock(&g_mu);
+}
+int s2a_rb_vp_has(const void *p) { uint64_t a = (uint64_t)(uintptr_t)p; return g_size && a >= g_base && a < g_base + g_size; }
+uint64_t s2a_rb_vp_size(void) { return g_size; }
+
+// An inaccessible range of len bytes on a host page; NULL when there is no arena or no free range holds it (counted: the
+// caller says so in the log and falls back to the kernel's choice).
+void *s2a_rb_vp_map(uint64_t len) {
+    if (!g_size || !len || len > g_size) { if (g_size && len) { pthread_mutex_lock(&g_mu); g_refused++; if (len > g_refused_max) g_refused_max = len; pthread_mutex_unlock(&g_mu); } return NULL; }
+    uint64_t n = span_of(len); void *r = NULL;
+    pthread_mutex_lock(&g_mu);
+    for (int i = 0; g_nheld < RBVP_MAXSEG && i < g_nfree; i++) if (g_free[i].n >= n) {
+        uint64_t a = g_free[i].a; r = (void *)(uintptr_t)a;
+        if (g_free[i].n == n) { memmove(&g_free[i], &g_free[i + 1], (size_t)(g_nfree - i - 1) * sizeof *g_free); g_nfree--; }
+        else { g_free[i].a += n; g_free[i].n -= n; }
+        int h = held_at(a); memmove(&g_held[h + 1], &g_held[h], (size_t)(g_nheld - h) * sizeof *g_held); g_held[h] = (rbvp_seg){a, n}; g_nheld++;
+        g_used += n; if (g_used > g_peak) g_peak = g_used;
+        g_maps++; break;
+    }
+    if (!r) { g_refused++; if (len > g_refused_max) g_refused_max = len; }
+    pthread_mutex_unlock(&g_mu);
+    return r;
+}
+
+// Gives back a range s2a_rb_vp_map returned. 1 = it was the arena's: covered with an inaccessible mapping again (whatever
+// was aliased into it is gone) and free for the next pool; 0 = not the arena's, the caller unmaps it. The span covered
+// and freed is the one recorded when the range was handed out: a len that differs is counted, never trusted, and an
+// address inside the arena that is not the start of a held range is left alone (counted too; still 1, so that the caller
+// does not munmap a piece of the arena). A range that cannot be covered or recorded is not reused (counted as lost):
+// address space only, never memory.
+int s2a_rb_vp_unmap(void *p, uint64_t len) {
+    if (!p || !len || !s2a_rb_vp_has(p)) return 0;
+    uint64_t a = (uint64_t)(uintptr_t)p;
+    pthread_mutex_lock(&g_mu);
+    int h = held_at(a);
+    if (h >= g_nheld || g_held[h].a != a) { g_badlen++; pthread_mutex_unlock(&g_mu); return 1; }
+    uint64_t n = g_held[h].n; if (len > g_size || span_of(len) != n) g_badlen++;
+    memmove(&g_held[h], &g_held[h + 1], (size_t)(g_nheld - h - 1) * sizeof *g_held); g_nheld--;
+    int covered = mmap(p, n, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0) == p;
+    int i = 0; while (i < g_nfree && g_free[i].a < a) i++;
+    int ml = i > 0 && g_free[i - 1].a + g_free[i - 1].n == a, mr = i < g_nfree && a + n == g_free[i].a;
+    if (!covered) g_lost += n;
+    else if (ml && mr) { g_free[i - 1].n += n + g_free[i].n; memmove(&g_free[i], &g_free[i + 1], (size_t)(g_nfree - i - 1) * sizeof *g_free); g_nfree--; }
+    else if (ml) g_free[i - 1].n += n;
+    else if (mr) { g_free[i].a = a; g_free[i].n += n; }
+    else if (g_nfree < RBVP_MAXSEG) { memmove(&g_free[i + 1], &g_free[i], (size_t)(g_nfree - i) * sizeof *g_free); g_free[i] = (rbvp_seg){a, n}; g_nfree++; }
+    else g_lost += n;
+    g_used = g_used >= n ? g_used - n : 0;
+    pthread_mutex_unlock(&g_mu);
+    return 1;
+}
+
+// One line for the log: what the arena holds, what it refused. Empty when there is no arena. The crash report calls it too, possibly
+// on the thread that holds the lock: it then reads without it (numbers of that instant, nothing is written).
+void s2a_rb_vp_note(char *o, size_t cap) {
+    if (!cap) return;
+    o[0] = 0; if (!g_size) return;
+    int locked = !pthread_mutex_trylock(&g_mu);
+    uint64_t big = 0; int nf = g_nfree; if (nf > RBVP_MAXSEG) nf = RBVP_MAXSEG;
+    for (int i = 0; i < nf; i++) if (g_free[i].n > big) big = g_free[i].n;
+    snprintf(o, cap, "RewindBox: virtual pool arena %#llx +%llu MB: %llu pools alive in %.1f MB (peak %.1f MB, %llu reserved so far), largest free range %.1f MB in %d; "
+                     "refused %llu (largest %.1f MB), address lost %.1f MB, releases that did not match a held range %llu",
+             (unsigned long long)g_base, (unsigned long long)(g_size >> 20), (unsigned long long)g_nheld, g_used / 1048576.0, g_peak / 1048576.0, (unsigned long long)g_maps,
+             big / 1048576.0, g_nfree, (unsigned long long)g_refused, g_refused_max / 1048576.0, g_lost / 1048576.0, (unsigned long long)g_badlen);
+    if (locked) pthread_mutex_unlock(&g_mu);
+}
+
+// How much address space the window gives up below itself when it cannot hold the standard layout: *tail for the unified
+// allocator of vawin.c (host stacks of the game's threads, signal stacks, Ryujinx memory blocks, Metal shared buffers,
+// write-tracking tables; it has no range in that layout otherwise, so all of them took the host's 3 GiB), *vp for the
+// virtual pool arena above. Pure, so the test compiles it as is.
+//   fit        the hole the window is taken from (largest below 2^39)        host_below  what stays free for the host under the arenas
+//   need       the standard layout's span (s2a_layout_need)                  alias       the alias region's commitment in that span
+//   pool       the application pool (all the memory the game can map)        slack       what the layout adds in front of the alias region
+//   alias_first / unknown: the layout sizes the alias region from the window (layout.c: static hint in addr_need.tsv), or the game is
+//              not known yet: nothing is taken, the window is what it was
+// The window keeps the regions in front of the alias region (need - alias + slack) and one application pool of alias
+// region inside it: whatever the game maps there is backed by that pool, so everything it can map at once still has host
+// addresses when it is laid out from the region's base. What it maps higher goes to the far region, as before.
+uint64_t s2a_rb_host_arenas(uint64_t fit, uint64_t host_below, uint64_t need, uint64_t alias, uint64_t slack, uint64_t pool,
+                            int alias_first, uint64_t tail_want, uint64_t vp_want, uint64_t *tail, uint64_t *vp) {
+    const uint64_t G = 1ull << 30;
+    *tail = *vp = 0;
+    if (alias_first || !pool || need <= alias) return 0;
+    uint64_t keep = need - alias + slack + pool;
+    if (fit < host_below + keep + G) return 0;
+    uint64_t room = (fit - host_below - keep) & ~(G - 1);   // whole GiB: the window base stays GiB-aligned (layout.c)
+    if (tail_want && (tail_want & (G - 1)) == 0 && room >= tail_want) { *tail = tail_want; room -= tail_want; }
+    vp_want &= ~(G - 1);
+    *vp = room < vp_want ? room : vp_want;
+    return *tail + *vp;
+}
