-    if (!sz && g_fit >= MIN_WIN + HOST_BELOW) { at = fat + HOST_BELOW; want = g_fit - HOST_BELOW; g_keep_lo = fat;
+    uint64_t rb_tl = 0, rb_vp = 0, rb_extra = 0;   // RewindBox (patch 0013): [at - rb_extra, at) = tail allocator range, then virtual pool arena
