+// RewindBox (patch 0013): the host arenas below the window (runtime/src/rb_vparena.c). When the window cannot hold the standard layout the
+//   host kept 3 GiB below it and nothing else: the unified tail allocator had no range (the window's end is the alias region's far part),
+//   so the host stacks of the game's threads, the virtual pools of NVN and everything Metal, malloc and the GC map shared those 3 GiB.
+//   The window now gives up a range for the tail allocator (its own TL_TAKE) and one for the virtual pools right below its base, both
+//   reserved with it; the host's 3 GiB stay as they were, so the GC limit and the low-address ledger read the same hole as before.
+//   S2A_VP_ARENA_MB sets the virtual pool arena (default 16384, the size S2Arm gives its own iOS virtual pool area; 0 = none).
+#define RB_VP_ARENA (16ull << 30)
+#define RB_VAMM_ALIAS (63ull << 30)   // the alias region's commitment in the standard layout (layout.c VAMM_ALIAS)
+// rb_vparena.c's functions and layout.c's pool are taken by name, as this file takes s2a_app_pool and s2a_npdm_window_need: S2Arm's tests that
+//   link vawin.c alone have neither file, and then nothing is given up (the window is what it was)
+typedef uint64_t (*rb_arenas_fn)(uint64_t fit, uint64_t host_below, uint64_t need, uint64_t alias, uint64_t slack, uint64_t pool,
+                                 int alias_first, uint64_t tail_want, uint64_t vp_want, uint64_t *tail, uint64_t *vp);
+// 1 = the layout will size the alias region from the window for this game (svc_mem.c alias_first_hint: a static alias size in the
+//   addr_need.tsv next to main.npdm), or the game is not known here (several games in one container, no NPDM): the window is left alone
+static int tail_on(void);
+static int rb_alias_first(void) {
+    if (g_ctr || !g_npdm[0]) return 1;
+    char p[1100]; snprintf(p, sizeof p, "%s", g_npdm); char *sl = strrchr(p, '/'); if (!sl) return 1;
+    snprintf(sl + 1, sizeof p - (size_t)(sl + 1 - p), "addr_need.tsv");
+    FILE *f = fopen(p, "r"); if (!f) return 0;
+    char line[1024]; int hint = 0; const char *k = "别名区GB\t";
+    while (fgets(line, sizeof line, f)) if (!strncmp(line, k, strlen(k)) && strtoull(line + strlen(k), NULL, 10)) hint = 1;
+    fclose(f); return hint;
+}
+static uint64_t rb_arenas(uint64_t fit, uint64_t *tail, uint64_t *vp) {
+    *tail = *vp = 0;
+    rb_arenas_fn sizes = (rb_arenas_fn)dlsym(RTLD_DEFAULT, "s2a_rb_host_arenas"); uint64_t (*poolf)(void) = (uint64_t (*)(void))dlsym(RTLD_DEFAULT, "s2a_app_pool");
+    if (!sizes || !poolf || !dlsym(RTLD_DEFAULT, "s2a_rb_vp_init")) return 0;
+    const char *e = getenv("S2A_VP_ARENA_MB"); uint64_t want = e && *e ? strtoull(e, NULL, 10) << 20 : RB_VP_ARENA;
+    return sizes(fit, HOST_BELOW, g_need, RB_VAMM_ALIAS, S2A_FAR_SLACK + (1ull << 30), poolf(), rb_alias_first(), tail_on() ? TL_TAKE : 0, want, tail, vp);
+}
