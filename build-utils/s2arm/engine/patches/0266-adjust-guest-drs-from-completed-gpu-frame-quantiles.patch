diff --git a/graphics/nvn/gfx/nvn/rb_adaptive_drs.h b/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
new file mode 100644
index 0000000..b11f2cc
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_adaptive_drs.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "rb_thermal_pacing.h"
+#include <stdlib.h>
+
+enum { RB_DRS_LOOKBACK = 32 };
+
+typedef struct {
+    unsigned level, pressure_windows, recovery_windows;
+    uint64_t last_frame, windows, incomplete, up_steps, down_steps;
+} rb_adaptive_drs;
+
+static inline double rb_drs_target_ms(const char *value) {
+    if (!value || !*value) return 13.5;
+    char *end;
+    double target = strtod(value, &end);
+    if (end != value && !*end && target == 0.) return 0.;
+    return !*end && isfinite(target) && target >= 10. && target <= 15.5 ? target : 13.5;
+}
+
+// Use at least 24 completed frames within a disjoint group of 32. GPU
+// completion can lag without invalidating the entire observation.
+static inline int rb_drs_sample_due(const rb_adaptive_drs *s, uint64_t frame) {
+    return frame >= RB_DRS_LOOKBACK + 4 && frame >= s->last_frame &&
+           frame - s->last_frame >= RB_DRS_LOOKBACK;
+}
+static inline int rb_drs_quantiles(const double *samples, double *p50, double *p95) {
+    double sorted[RB_DRS_LOOKBACK];
+    unsigned count = 0;
+    *p50 = *p95 = -1.;
+    for (unsigned i = 0; i < RB_DRS_LOOKBACK; ++i) {
+        double value = samples[i];
+        if (!(value > 0.) || !isfinite(value)) continue;
+        unsigned j = count++;
+        while (j && sorted[j-1] > value) { sorted[j] = sorted[j-1]; --j; }
+        sorted[j] = value;
+    }
+    if (count < RB_HEAT_SAMPLES) return 0;
+    *p50 = (sorted[(count - 1) / 2] + sorted[count / 2]) * .5;
+    *p95 = sorted[(95 * count + 99) / 100 - 1];
+    return 1;
+}
+static inline void rb_drs_observe_gpu(rb_adaptive_drs *s, uint64_t frame, double target,
+                                      double p50, double p95) {
+    if (!rb_drs_sample_due(s, frame) || target <= 0.) return;
+    // Drop incomplete pressure/recovery streaks across a pause or missing windows.
+    if (s->last_frame && frame - s->last_frame > RB_DRS_LOOKBACK * 3) {
+        s->pressure_windows = s->recovery_windows = 0;
+    }
+    s->last_frame = frame;
+    if (!(p50 > 0.) || !(p95 >= p50)) {
+        ++s->incomplete;
+        s->pressure_windows = s->recovery_windows = 0;
+        return;
+    }
+    ++s->windows;
+    if (p95 > 15.5 || p50 > target) {
+        s->recovery_windows = 0;
+        if (s->level < 2 && ++s->pressure_windows == 2) {
+            ++s->level; ++s->up_steps; s->pressure_windows = 0;
+        }
+    } else if (p50 < target - 1. && p95 < 14.5) {
+        s->pressure_windows = 0;
+        if (s->level && ++s->recovery_windows == 8) {
+            --s->level; ++s->down_steps; s->recovery_windows = 0;
+        }
+    } else {
+        s->pressure_windows = s->recovery_windows = 0;
+    }
+}
+static inline uint64_t rb_drs_report_ticks(int hot, int fps, int cap, unsigned level, uint64_t hold) {
+    if (!hot) return hold;
+    if (cap > 0 && cap < 60) level = 0;
+    if (fps == 60 && level == 1) return UINT64_C(20500) * 192 / 10;
+    if (fps == 60 && level >= 2) return UINT64_C(22000) * 192 / 10;
+    return hold + hold / 8;
+}
diff --git a/graphics/nvn/tests/t_rb_adaptive_drs.c b/graphics/nvn/tests/t_rb_adaptive_drs.c
new file mode 100644
index 0000000..8bea581
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_adaptive_drs.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_adaptive_drs.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    assert(rb_drs_target_ms("0") == 0. && rb_drs_target_ms(NULL) == 13.5);
+    assert(rb_drs_target_ms("14") == 14. && rb_drs_target_ms("nan") == 13.5);
+    assert(rb_drs_target_ms("13ms") == 13.5);
+    double sample[RB_DRS_LOOKBACK], median, tail;
+    for (int i = 0; i < RB_DRS_LOOKBACK; ++i) sample[i] = RB_DRS_LOOKBACK-i;
+    assert(rb_drs_quantiles(sample, &median, &tail) && median == 16.5 && tail == 31.);
+    for (int i = 0; i < 8; ++i) sample[i] = -1.;
+    assert(rb_drs_quantiles(sample, &median, &tail) && median == 12.5 && tail == 23.);
+    sample[10] = NAN;
+    assert(!rb_drs_quantiles(sample, &median, &tail) && median < 0. && tail < 0.);
+    rb_adaptive_drs s = {0};
+    uint64_t f = 36;
+    rb_drs_observe_gpu(&s, f, 0., 16., 19.);
+    assert(!s.windows);
+    rb_drs_observe_gpu(&s, f, 13.5, 15.34, 18.5);
+    rb_drs_observe_gpu(&s, f + 1, 13.5, 15.34, 18.5);
+    assert(s.windows == 1 && !s.level);
+    rb_drs_observe_gpu(&s, f += 32, 13.5, 15.34, 18.5);
+    assert(s.level == 1);
+    rb_drs_observe_gpu(&s, f += 32, 13.5, 12.8, 16.2);
+    rb_drs_observe_gpu(&s, f += 32, 13.5, -1., -1.);
+    rb_drs_observe_gpu(&s, f += 32, 13.5, 12.8, 16.2);
+    assert(s.level == 1 && s.incomplete == 1);
+    rb_drs_observe_gpu(&s, f += 32, 13.5, 12.8, 16.2);
+    assert(s.level == 2 && s.up_steps == 2);
+    for (int i=0;i<12;++i) rb_drs_observe_gpu(&s,f+=32,13.5,13.2,15.2);
+    assert(s.level == 2);
+    for (int i=0;i<7;++i) rb_drs_observe_gpu(&s,f+=32,13.5,12.,13.9);
+    rb_drs_observe_gpu(&s,f+=128,13.5,12.,13.9);
+    assert(s.level == 2);
+    for (int i=0;i<7;++i) rb_drs_observe_gpu(&s,f+=32,13.5,12.,13.9);
+    assert(s.level == 1 && s.down_steps == 1);
+    assert(rb_drs_report_ticks(1,60,0,0,318720) == 358560);
+    assert(rb_drs_report_ticks(1,60,0,1,318720) == 393600);
+    assert(rb_drs_report_ticks(1,60,0,2,318720) == 422400);
+    assert(rb_drs_report_ticks(1,30,0,2,637440) == 717120);
+    assert(rb_drs_report_ticks(1,60,30,2,318720) == 358560); // live user cap
+    assert(rb_drs_report_ticks(0,60,0,2,318720) == 318720);
+    puts("PASS guest DRS: measured medians/tails, base/20.5/22 ms, disjoint samples, invalid windows, hysteresis, 30 Hz and off");
+}
