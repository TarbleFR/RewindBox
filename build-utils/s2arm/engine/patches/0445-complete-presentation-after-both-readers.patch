+// Each slot either reads the source until its GPU feedback, or skips it before
+// submission. A missing real drawable still leaves the input copy in flight.
+// g_pq_mu protects these entries. Admission limits pending tickets to RB_PRESENT_CAP.
+static uint64_t g_fi_finished_read[2][RB_PRESENT_CAP];
+static void fi_finish_read_locked(uint64_t ticket, int slot) {
+    unsigned index = (unsigned)(ticket % RB_PRESENT_CAP);
+    uint64_t *finished = &g_fi_finished_read[slot - 1][index];
+    if (*finished >= ticket) return;
+    *finished = ticket;
+    if (g_fi_finished_read[2 - slot][index] == ticket) rb_present_complete(ticket);
+}
+static void fi_skip_read(uint64_t ticket, int slot) {
+    pthread_mutex_lock(&g_pq_mu);
+    fi_finish_read_locked(ticket, slot);
+    RB_WAKE_CALL("present.signal", -2, pthread_cond_broadcast(&g_pq_cv));
+    pthread_mutex_unlock(&g_pq_mu);
+}
