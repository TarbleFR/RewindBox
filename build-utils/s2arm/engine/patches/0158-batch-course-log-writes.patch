+// Numeric course records already leave the frame thread in batches of 32.
+typedef struct {
+    char bytes[16384];
+    size_t used;
+} rb_course_log_buffer;
+
+static void rb_course_log_flush(rb_course_log_buffer *out) {
+    if (out->used) s2a_log_out(g_s2a_logfd2, out->bytes, out->used);
+    out->used = 0;
+}
+
+__attribute__((format(printf, 2, 3)))
+static int rb_course_log_append(rb_course_log_buffer *out, const char *fmt, ...) {
+    if (g_s2a_logfd2 <= 2) return 0; // standalone stderr, including pipes
+    size_t room = sizeof out->bytes - out->used;
+    va_list args;
+    va_start(args, fmt);
+    int n = vsnprintf(out->bytes + out->used, room, fmt, args);
+    va_end(args);
+    if (n < 0 || (size_t)n >= room) {
+        rb_course_log_flush(out); // only the preceding complete lines
+        return 0;
+    }
+    out->used += (size_t)n;
+    out->bytes[out->used++] = '\n';
+    return 1;
+}
+
+#define RB_COURSE_LOG(...) do { \
+    if (!rb_course_log_append(&out, "[dm] [nvn-mtl] " __VA_ARGS__)) MLOG(__VA_ARGS__); \
+} while (0)
