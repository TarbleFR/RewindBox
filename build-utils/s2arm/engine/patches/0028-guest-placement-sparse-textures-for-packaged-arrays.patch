+        (unsigned long long)t->serial, (unsigned long long)c.up, (unsigned long long)c.unmapped, (unsigned long long)live, (unsigned long long)peak, (unsigned long long)(peak * SP_TILE >> 20),
+        (unsigned long long)c.rounds, (unsigned long long)(c.staged >> 20)); }
