+// A look when the texture is resolved: only a new mapping request in its pool costs anything, or a write to a page behind a tile, which no game seen does to a tile it keeps mapped (none of 42,072
+// in Mario Kart World's first race): at most once a second, as the look goes over every mapped tile, so a rewritten tile can show its old content for that long (check C4: kept so)
+static inline void sparse_look(NvSparse *s, const tex_t *t) {
+    if (nvn_sparse_log_seq(t->pool) != s->seq) sparse_sync(s, t, 0);
+    if (atomic_load_explicit(&g_up_lost_n, memory_order_relaxed) && !s->gpu && up_lost_take(s->tex)) { sparse_sync(s, t, 3); return; }
+    if (s->rescan && atomic_load(&g_cur_frame) - s->rescan_frame >= 60) sparse_sync(s, t, 1);   // S2Arm (check C2): tiles left out of date for want of staging, a heap tile or host memory
+    if (!s->gpu && nvn_dirty_sparse_writes() != s->wseen && atomic_load(&g_cur_frame) - s->wframe >= 60) sparse_sync(s, t, 2);
+}
+// tex_mtl_'s packaged path (upstream 1d4b8e82, nvn_mtl.m:4420-4421 at 0c078130): t made placement sparse with its NvPkg (submit thread), or nil: it is made as before
+static NvPkg *sparse_pkg(const tex_t *t) {
+    id<MTLTexture> made = nil; NvSparse *ps = sparse_make(t, 0, &made);
+    if (!ps) return nil;
+    NvPkg *pk = [NvPkg new]; pk->ps = ps; pk->tex = made; pk->sparse = 1;
+    sparse_sync(ps, t, 1); tex_put(t->serial, pk);
+    return pk;
+}
+// S2Arm (check C7, after seedds/nxnative a9005a51 at b16693b3): a texture another thread needs first that would be made placement sparse is not made there: made on the submit
+//   thread's first use instead, nil until then. Made here it would be whole (1,451 or 5,803 MB for Mario Kart World's terrain) and kept: tex_mtl_ turned such a texture into a GPU texture
+static int sparse_off_sub(const tex_t *t) {
+    sp_geo g; char why[8]; if (!sp_check(t, 0, &g, why, sizeof why)) return 0;
+    static _Atomic uint64_t n; uint64_t k = atomic_fetch_add(&n, 1) + 1;
+    if (k <= 8 || !(k & (k - 1))) { char name[64] = ""; pthread_getname_np(pthread_self(), name, sizeof name);
+        MLOG("RewindBox: sparse texture ser=%llu %ux%ux%u format %#x first needed off the submit thread ('%s'): it would be made placement sparse (%llu MB whole), so it is not made there; nil until "
+             "the submit thread makes it (%llu so far)", (unsigned long long)t->serial, t->d.width, t->d.height, t->d.depth, t->d.format, name, (unsigned long long)(g.whole >> 20), (unsigned long long)k); }
+    return 1;
+}
+// S2Arm (check C6): the session's end (nvn_be_shutdown_session, nvn_session.inc), the GPU done (session_wait_backend) and the session's textures gone (the serial tables and the
+//   deferred releases, whose NvSparse deallocs put their slots back first): the heaps leave the residency set and go, the lists start again, ResourceAlias goes off (g_sp_heap_n), and
+//   an NvSparse alive past this gives nothing back (sess). RewindBox ends a session and starts the next in this process (patches 0006, 0010); the tables hold heap slots
+static void sp_session_end(void) {
+    pthread_mutex_lock(&g_sp_mu);
+    NSArray *heaps = g_sp_heaps; g_sp_heaps = nil; uint64_t live = g_sp_live, peak = g_sp_peak;
+    free(g_sp_free); g_sp_free = NULL; g_sp_nfree = g_sp_freecap = 0;
+    free(g_sp_late); g_sp_late = NULL; g_sp_nlate = g_sp_latecap = 0;
+    g_sp_live = g_sp_peak = 0; g_sp_sess++; atomic_store(&g_sp_heap_n, 0);
+    g_sp_nmade = g_sp_nwhole = 0; g_sp_looks = g_sp_nskip = 0;
+    pthread_mutex_unlock(&g_sp_mu);
+    uint64_t mb = 0; for (id<MTLHeap> h in heaps) { mb += h.size >> 20; res_remove(h); }
+    if (heaps.count || peak) MLOG("RewindBox: placement sparse tiles at the session's end: %lu heaps (%llu MB) given back; %llu tiles still mapped by textures alive past it (none expected), peak %llu tiles (%llu MB)",
+                                  (unsigned long)heaps.count, (unsigned long long)mb, (unsigned long long)live, (unsigned long long)peak, (unsigned long long)(peak * SP_TILE >> 20));
+}
