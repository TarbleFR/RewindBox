+    if (left) { uint64_t k = ++g_sp_nskip; if (k <= 8 || !(k & (k - 1))) { uint64_t fp, av; rb_up_mem(&fp, &av);   // S2Arm: what a look left out of date, counted
+        MLOG("【红】 RewindBox: sparse texture ser=%llu: %llu tiles left out of date in this look (staging refused %llu, no heap tile %llu%s, not decoded %llu, no host memory %llu): one not mapped reads 0, "
