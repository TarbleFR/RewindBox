+// RewindBox (patch 0344): whether a game the bridge did not put under the guard alternates present intervals 1 and 2 (a 60 fps title dropping frames, the pattern the
+// guard is built for): RB_DRS_TRIAL_CHANGES changes between 1 and 2 within RB_DRS_TRIAL_WINDOW frames, counted as the trial counts all of them. A game going between 2
+// and 3 (Donkey Kong Bananza: a period never stable for a second) is not one: each of its 3 -> 2 steps would start a fresh escape, which never backs off there. The
+// answer holds while such changes keep coming: none for RB_DRS_SEEN_IDLE frames (a title at 30 by design that went 1 <-> 2 in a menu or a video, then plays at 2) and
+// it is off again, the trial of patch 0309 still running. changes12: the 1 <-> 2 changes so far. seen, mark_frame, last_at: a frame + 1
+enum { RB_DRS_SEEN_IDLE = 1800 };
+typedef struct { uint64_t seen, mark_frame, mark_changes, prior_changes, last_changes, last_at; int on, ons, offs; } rb_drs_seen;
+static inline int rb_drs_seen_step(rb_drs_seen *s, uint64_t frame, uint64_t changes12) {
+    if (s->seen == frame + 1) return s->on;
+    s->seen = frame + 1;
+    if (!s->mark_frame || frame + 1 - s->mark_frame >= RB_DRS_TRIAL_WINDOW) {
+        s->prior_changes = s->mark_frame ? changes12 - s->mark_changes : 0;
+        s->mark_frame = frame + 1; s->mark_changes = changes12;
+    }
+    if (!s->last_at || changes12 != s->last_changes) { s->last_changes = changes12; s->last_at = frame + 1; }
+    if (changes12 - s->mark_changes + s->prior_changes >= RB_DRS_TRIAL_CHANGES) { if (!s->on) { s->on = 1; ++s->ons; } }
+    else if (s->on && frame + 1 >= s->last_at && frame + 1 - s->last_at >= RB_DRS_SEEN_IDLE) { s->on = 0; ++s->offs; }   // a report of an earlier frame never turns it off
+    return s->on;
+}
