+    const int stop_on = rb_drs_guard_active() && rb_drs_fix_trial_on();   // RewindBox (patch 0327): fix (b), under the guard only (rb_drs_trial_ramp_step); patch 0344: rb_drs_guard_active
     const uint64_t seen_px = stop_on ? rb_drs_scene_seen(f) : 0;
     const int answer_itv = stop_on ? nvn_rb_game_interval() : 2;   // RewindBox (patch 0327): the interval of the game's last present (2: the trial is not answered yet)
     os_unfair_lock_lock(&g_rb_floor_lock);
@@ -3137,6 +3153,9 @@ static int rb_drs_trial_now(uint64_t f, int fps) {
     const rb_drs_trial_ramp ramp = g_rb_drs_trial_ramp;
