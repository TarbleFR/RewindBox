 //   (b) only stops a trial the game has answered (rb_drs_trial_ramp_answered): an unanswered trial keeps its 30 frames.
 static int rb_drs_guard_on(void);
 __attribute__((weak)) int nvn_rb_game_interval(void);   // RewindBox (patch 0327): defined below, read by the trial's growth stop
+// RewindBox (patch 0344): the no-lock guard of patch 0319 for every game seen to alternate its present interval, not Mario Kart World alone. The bridge asks for the guard
+//   for that title only (S2A_RB_DRS_NO_LOCK=1, 0 for every other one), so another game that holds interval 2 for a second gets the 33.2 ms hold and never reads a time under
+//   its 60 fps budget again: it stays at 30 fps once the GPU is back at its clock, as Mario Kart World did before patch 0319 (s2arm-power-wall.md). The game is seen to
+//   alternate by the trial's own test (rb_drs_trial_step: 8 interval changes within 600 frames); a title that runs at 30 by design changes it a few times a session and keeps
+//   the hold at its own budget. Once seen, for the rest of the session. IPA 830, Mario Kart World under the guard: 76 of 80 escapes went back to interval 1 (the GPU then
+//   dropped it again: the iOS power cap, not the hold). S2A_RB_NO_LOCK_SEEN=0: the guard only where the bridge asks for it, as before
+static _Atomic int g_rb_drs_alternates;
+static int rb_no_lock_seen_on(void) {
+    static int v = -1;   // completion handlers; the same value whoever reads it first
+    if (v < 0) { const char *e = getenv("S2A_RB_NO_LOCK_SEEN"); v = !(e && !strcmp(e, "0"));
+        MLOG("[rb-guest-drs] no-lock guard for a game seen to alternate its interval: %s (S2A_RB_NO_LOCK_SEEN%s; patch 0344)", v ? "on" : "off", v ? "=0 turns it off" : "=0"); }
+    return v;
+}
+static int rb_drs_guard_active(void) {
+    return rb_drs_guard_on() || (rb_no_lock_seen_on() && atomic_load_explicit(&g_rb_drs_alternates, memory_order_relaxed));
+}
 static int rb_drs_fix_scene_on(void) {
     static int v = -1;
