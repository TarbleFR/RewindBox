+             (unsigned long long)changes, (unsigned long long)f, rb_drs_guard_on() ? "on already (S2A_RB_DRS_NO_LOCK=1)" : rb_no_lock_seen_on() ? "on from here" : "left off");
     if (tr.trials != trials && (tr.trials <= 8 || !(tr.trials & (tr.trials - 1))))
         MLOG("[rb-guest-drs] trial frame=%llu frames=%d waited=%llu trials=%llu kept=%llu",
              (unsigned long long)f, RB_DRS_TRIAL_FRAMES, (unsigned long long)tr.wait,
@@ -3290,7 +3309,7 @@ static uint64_t rb_drs_hold(uint64_t f, uint32_t type, uint64_t t) {   // the ti
     int fps = nvn_be_fps_target(); if (fps <= 0 || fps > 60) fps = 60;   // 30 / 60 (nvn_obj.h)
     const uint64_t hold60 = 16600000ull * 12 / 625;
     if (rb_drs_trial_now(f, fps)) return top + rb_drs_cap_ticks(t - top, hold60);   // RewindBox (patch 0309): the 60 fps hold whatever the time
-    const int guard = rb_drs_guard_on();   // RewindBox (patch 0319)
+    const int guard = rb_drs_guard_active();   // RewindBox (patch 0319); patch 0344: or a game seen to alternate (rb_drs_guard_active)
     if (guard) {
