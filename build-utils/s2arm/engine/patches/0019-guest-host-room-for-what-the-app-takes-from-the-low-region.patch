diff --git a/runtime/src/rb_hostroom.c b/runtime/src/rb_hostroom.c
new file mode 100644
index 000000000..c69e23d21
--- /dev/null
+++ b/runtime/src/rb_hostroom.c
@@ -0,0 +1,32 @@
+// RewindBox (patch 0019): what the host app's own images take from the low region is left to the host below the window.
+//   When the window cannot hold a game's standard layout, S2Arm leaves the host HOST_BELOW (3 GiB) below the window, and its sizing counts on the
+//   low region as well (vawin.c, HOST_BELOW's note: the host's addresses on iOS = about 1.8 GB of low region + that range; a Switch 2 game's host
+//   peak is 1.7-2.1 GB). In S2Arm's own app the low region [4 GiB, 6 GiB) is mostly free. In RewindBox the app's own binary and frameworks fill it:
+//   184 MB free there when the window is reserved (Mario Kart World, iPhone17,2, 13 Nov). The .NET GC then reserves its limit from the host's hole
+//   (gclimit.c): 870 MB at most when that hole is under 3712 MB, 2688 MB from there on. The hole is the 3 GiB and the 0-1023 MB in front of them
+//   that the window's 1 GiB alignment leaves, so which of the two it is changes from start to start: 2688 MB of 4094 MB that day (the same phone took
+//   the smaller one on five of its seven logged starts, holes of 3140-3304 MB). That left the host 1187 MB of addresses for Metal, malloc and the
+//   runtime: 166 MB at the lowest (second 90, the first 3D frames, with the ledger's warning "below the reserve"), 510 MB when the run stopped.
+//   So the host gets, below the window, what its low region lacks of what the layout counts on, in whole GiB, at most `most`, and only as much as
+//   leaves the tail allocator's range and the virtual pool arena their size (patch 0013). The window keeps what the layout needs in front of the
+//   alias region and one application pool of it (s2a_rb_host_arenas' own rule): the room comes from the part of the alias region that fits in the
+//   window, of which the game had touched 0.7 of 29.7 GiB. The GC limit is picked as if the room were not there (vawin.c s2a_rb_low_holes_less):
+//   it is the one S2Arm picks for that start, and every GiB given is the host's (counted, the room put every start over 3712 MB: with 2 GiB the
+//   starts that had the smaller limit gained 230 MB at most, and with one GiB they lost 794 MB or more).
+//   A pure function, so that the rule is run on a computer (test/s2arm_host_room_test.py).
+#include <stdint.h>
+
+#define RBH_GIB (1ull << 30)
+
+// low_free: free addresses in the low region; counted: what the layout counts on there; host_below: S2Arm's own share below the window;
+// arenas(host_below, ctx): what the window gives up for the two ranges of patch 0013 when the host's share is host_below (0: none).
+// Returns how much more than host_below the host gets (0: nothing, the window is as S2Arm and patch 0013 size it)
+uint64_t s2a_rb_host_more(uint64_t low_free, uint64_t counted, uint64_t most, uint64_t host_below, uint64_t (*arenas)(uint64_t host_below, void *ctx), void *ctx) {
+    if (!arenas || low_free >= counted) return 0;
+    uint64_t given = arenas(host_below, ctx);
+    if (!given) return 0;
+    uint64_t more = (counted - low_free + RBH_GIB - 1) & ~(RBH_GIB - 1);
+    if (more > most) more = most & ~(RBH_GIB - 1);
+    while (more && arenas(host_below + more, ctx) != given) more -= RBH_GIB;
+    return more;
+}
