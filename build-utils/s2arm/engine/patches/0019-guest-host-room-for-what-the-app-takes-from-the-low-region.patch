-    return sizes(fit, HOST_BELOW, g_need, RB_VAMM_ALIAS, S2A_FAR_SLACK + (1ull << 30), poolf(), rb_alias_first(), tail_on() ? TL_TAKE : 0, want, tail, vp);
+    return sizes(fit, host_below, g_need, RB_VAMM_ALIAS, S2A_FAR_SLACK + (1ull << 30), poolf(), rb_alias_first(), tail_on() ? TL_TAKE : 0, want, tail, vp);
+}
+static uint64_t rb_arenas(uint64_t fit, uint64_t *tail, uint64_t *vp) { return rb_arenas_at(fit, HOST_BELOW, tail, vp); }
+// RewindBox (patch 0019): what the low region lacks of what HOST_BELOW's sizing counts on there goes to the host below the window (rb_hostroom.c, taken
+//   by name as the arenas are). S2A_HOST_MORE_MB: its most, in MB (0 = none)
+#define RB_LOW_COUNTED (1843ull << 20)   // about 1.8 GB (HOST_BELOW's note)
+#define RB_HOST_MORE (2ull << 30)        // with it the host's hole stays far below what would make gclimit.c reserve 10 GB for the GC
+static uint64_t rb_arenas_cb(uint64_t host_below, void *ctx) { uint64_t t, v; return rb_arenas_at(*(const uint64_t *)ctx, host_below, &t, &v); }
+static uint64_t rb_host_more(uint64_t fit, uint64_t *low_free) {
+    uint64_t (*more)(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t (*)(uint64_t, void *), void *) =
+        (uint64_t (*)(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t (*)(uint64_t, void *), void *))dlsym(RTLD_DEFAULT, "s2a_rb_host_more");
+    uint64_t largest = 0; *low_free = 0; holes_in(0x100000000ull, 0x180000000ull, low_free, &largest);
+    const char *e = getenv("S2A_HOST_MORE_MB"); uint64_t most = e && *e ? strtoull(e, NULL, 10) << 20 : RB_HOST_MORE;
+    return more ? more(*low_free, RB_LOW_COUNTED, most, HOST_BELOW, rb_arenas_cb, &fit) : 0;
 }
