 static uint32_t page_count(const tex_t *t) { uintptr_t pg = nvn_dirty_page_size(), a = (uintptr_t)t->mem; return t->L.size ? (uint32_t)(((a + t->L.size - 1) & ~(pg - 1)) - (a & ~(pg - 1))) / (uint32_t)pg + 1 : 0; }
+// RewindBox (patch 0070): texture storage the host is about to read is asked of the pager in runs first. IPA 765 (Mario Kart World, iPhone17,2, guest memory in 39 window files of
+//   1 GB, the heap kept there by patch 0052's tier): long race frames with 30 first uploads or more had a median of 884 page reads from storage against 48 for those with fewer
+//   than 5 (81 reads per MB uploaded; f1805 133 MB in 869 ms with 8,111 reads), and in the f1858 profile the submit thread waited 0.58 s of 4 s in span_hash under tex_mtl_ (the
+//   hash of a texture's written pages) at heap addresses: storage the game wrote, written back to its file and dropped under memory pressure, read again one 16 KB fault at a time.
+//   Patch 0060 does not help there (no hole: 0.0 MB judged zeros in the race windows). Now the host pages of such a span that are not in memory (mincore) go to
+//   madvise(MADV_WILLNEED) in runs of up to 64 pages: the pager reads each run in one request without waiting, and the hash or the deswizzle that follows waits only for pages still
+//   on their way. Only spans wholly in the window's files (s2a_guest_in_file): on anonymous memory MADV_WILLNEED faults the pages in, which would make never-touched pages count in
+//   the footprint, and far alias storage has no host pages of its own. Asked before a first upload or a whole re-upload (pkg_upload_), before a partial one (pkg_upload_rects, the
+//   levels it reads), before the hash of the pages written since (tex_mtl_), and at registration on a queue of its own (rb_pf_post). What is read and uploaded does not change.
+//   S2A_RB_WILLNEED=0 turns the read-ahead off; the pages are still counted then (mincore), so that an A/B run keeps its measurement. Any thread; the counters are atomic. The
+//   per-frame count goes on the long-frame line (nvn_be_tex_absent_take: -1, not known, where the window is not in files), the totals every 300 frames (rb_wn_line)
+int s2a_guest_in_file(uint64_t a, uint64_t n); int s2a_guest_fd(void);   // native vawin.c (weak defaults below, with zp_build)
+void s2a_window_get(uint64_t *base, uint64_t *size) __attribute__((weak));   // native vawin.c; may be absent, as nvn_frame_rec.inc says (graphics unit tests have no guest window)
+static int rb_wn_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("S2A_RB_WILLNEED"); v = !(e && !strcmp(e, "0")); } return v; }
+#define RB_WN_MAX ((uint64_t)512 << 20)   // a larger span is not asked about (no texture's storage is that large in one piece)
+#define RB_WN_NONE UINT64_MAX             // rb_wn: the span was not looked at (not wholly in the window's files, far alias storage, or over RB_WN_MAX)
+static _Atomic uint64_t g_wn_frame, g_wn_frame_noacc, g_wn_frame_unseen, g_wn_tot, g_wn_tot_noacc, g_wn_tot_unseen, g_wn_runs, g_wn_calls, g_wn_chunk[64];   // pages found not in memory: this frame / in all (and those of pools without CPU access); reads not looked at; runs asked; spans looked at; per GB of the window
+// Whether host page [h, h + hp) of t's storage holds a page of bits (np pages, numbered as page_span's); every page without bits
+static int rb_wn_sel(const tex_t *t, const uint64_t *bits, long np, uintptr_t h, uintptr_t hp) {
+    if (!bits) return 1;
+    uintptr_t dp = nvn_dirty_page_size(), p0 = (uintptr_t)t->mem & ~(dp - 1);
+    if (h + hp <= p0) return 0;
+    for (long k = h > p0 ? (long)((h - p0) / dp) : 0, ke = (long)((h + hp - 1 - p0) / dp); k <= ke && k < np; k++) if (bits[k >> 6] >> (k & 63) & 1) return 1;
+    return 0;
+}
+// The host pages of [p, p + n) not in memory (with bits: only those holding a page of bits), asked to be read ahead (MADV_WILLNEED) in runs; returns how many there were, RB_WN_NONE
+//   when the span is not looked at. One window and far check for the span, then mincore by 64 host pages, skipping those that hold no selected page
+static uint64_t rb_wn_(const void *p, uint64_t n, const tex_t *t, const uint64_t *bits, long np) {
+    if (!n || !p) return 0;
+    if (n > RB_WN_MAX) return RB_WN_NONE;
+    uintptr_t pg = (uintptr_t)getpagesize(), a = (uintptr_t)p & ~(pg - 1), e = ((uintptr_t)p + n + pg - 1) & ~(pg - 1);
+    if (s2a_far_g2h((uint64_t)a) || s2a_far_g2h((uint64_t)e - 1) || !s2a_guest_in_file((uint64_t)a, (uint64_t)(e - a))) return RB_WN_NONE;
+    atomic_fetch_add_explicit(&g_wn_calls, 1, memory_order_relaxed);
+    int adv = rb_wn_on(); uint64_t absent = 0; char v[64], s[64];
+    for (uintptr_t c = a; c < e; c += sizeof v * pg) {
+        size_t m = (size_t)MIN((uintptr_t)sizeof v, (e - c) / pg), any = 0;
+        for (size_t i = 0; i < m; i++) any += (size_t)(s[i] = (char)rb_wn_sel(t, bits, np, c + i * pg, pg));
+        if (!any) continue;   // none of these pages is to be read
+        if (mincore((void *)c, m * pg, v)) break;   // not answered: the rest is read as before
+        for (size_t i = 0; i < m;) {
+            if (!s[i] || (v[i] & MINCORE_INCORE)) { i++; continue; }
+            size_t j = i; while (j < m && s[j] && !(v[j] & MINCORE_INCORE)) j++;
+            if (adv) { (void)madvise((void *)(c + i * pg), (j - i) * pg, MADV_WILLNEED); atomic_fetch_add_explicit(&g_wn_runs, 1, memory_order_relaxed); }   // advice: an error (a page the game unmapped since) changes nothing
+            absent += j - i; i = j;
+        }
+    }
+    return absent;
+}
+static uint64_t rb_wn(const void *p, uint64_t n) { return rb_wn_(p, n, NULL, NULL, 0); }
+static void rb_wn_note(const tex_t *t, uint64_t absent) {   // what a read of t's storage found (rb_wn), for the counts; reads t->pool as tex_mtl_ does (its callers' thread)
+    if (absent == RB_WN_NONE) { atomic_fetch_add_explicit(&g_wn_frame_unseen, 1, memory_order_relaxed); atomic_fetch_add_explicit(&g_wn_tot_unseen, 1, memory_order_relaxed); return; }
+    if (!absent) return;
+    int noacc = t->pool && (t->pool->flags & NVN_MEMORY_POOL_FLAGS_CPU_NO_ACCESS);
+    atomic_fetch_add_explicit(&g_wn_frame, absent, memory_order_relaxed); atomic_fetch_add_explicit(&g_wn_tot, absent, memory_order_relaxed);
+    if (noacc) { atomic_fetch_add_explicit(&g_wn_frame_noacc, absent, memory_order_relaxed); atomic_fetch_add_explicit(&g_wn_tot_noacc, absent, memory_order_relaxed); }
+    uint64_t wb = 0, ws = 0, a = (uint64_t)(uintptr_t)t->mem; if (s2a_window_get) s2a_window_get(&wb, &ws);
+    if (ws && a >= wb && a - wb < ws) atomic_fetch_add_explicit(&g_wn_chunk[((a - wb) >> 30) & 63], absent, memory_order_relaxed);   // which GB of the window (SL-2: which window files are read back)
+}
+// The pages of bits (np pages, numbered as page_span's: those written since the upload) asked ahead before tex_mtl_ hashes them: one look over the span from the first to the last
+//   (rb_wn_), not one per run of written pages (a texture written in scattered pages paid a window check and a mincore call per run, even all in memory)
+static void rb_wn_bits(const tex_t *t, const uint64_t *bits, long np) {
+    long k0 = -1, k1 = -1;
+    for (long w = 0; w < (np + 63) / 64; w++) if (bits[w]) { if (k0 < 0) k0 = w * 64 + __builtin_ctzll(bits[w]); k1 = w * 64 + 63 - __builtin_clzll(bits[w]); }
+    if (k0 < 0 || k0 >= np) return;
+    if (k1 >= np) k1 = np - 1;
+    const uint8_t *lo, *hi; size_t m0, m1; page_span(t, (size_t)k0, &lo, &m0); page_span(t, (size_t)k1, &hi, &m1);
+    if (hi + m1 > lo) rb_wn_note(t, rb_wn_(lo, (uint64_t)(hi + m1 - lo), t, bits, np));
+}
+// One level of one layer of t's storage, where nvn_deswizzle reads it (nvn_deswizzle_geom: layer × layer size + the level's offset), asked as rb_wn; the whole storage where no
+//   level offset is known (linear, buffer or unknown format: nvn_tex_level_offset 0). For pkg_upload_rects
+static uint64_t rb_wn_level(const tex_t *t, unsigned level, unsigned layer) {
+    uint64_t o = nvn_tex_level_offset(&t->d, level), e = nvn_tex_level_offset(&t->d, level + 1), b = (uint64_t)layer * t->L.layer_size + o;
+    if (e <= o) return rb_wn(t->mem, t->L.size);
+    if (b >= t->L.size) return 0;
+    return rb_wn(t->mem + b, MIN(b + (e - o), t->L.size) - b);
+}
+// RewindBox (patch 0070, SC2 / SL-3): a texture's storage is asked ahead as soon as the game registers it (nvn_be_reg_tex, the game's threads), on a serial queue of its own: the
+//   first upload, at the next submission that needs it (pool tables, a bind), then finds its pages on their way or in memory. Only a texture the host uploads from its storage
+//   (a packaged layout, or one the CPU wrote: tex_mtl_'s packaged): render targets, depth, images and the other GPU textures are made with no read, and their storage is often
+//   holes of the window files, which MADV_WILLNEED would fill with zero pages that patch 0060 then finds in memory and reads (it judged 89.4 MB and 49.7 MB of such storage zeros
+//   without a read at startup in the 765 log). Not for one already made, a sparse one (read through its page table), one over RB_PF_MAX_TEX, nor a repeat of a registration
+//   asked lately (1024 slots, written only once it is asked). At most RB_PF_FRAME bytes are asked a frame (g_cur_frame) and RB_PF_PENDING wait in the queue; the rest is left to
+//   the upload's own ask (rb_wn). This bounds the read-ahead itself: madvise returns once the reads are queued, so a queue bound alone bounded only the backlog. Pages read
+//   ahead and not used are clean file pages the system takes back first, but under memory pressure they still push others out: the frame budget. The queue is QOS_CLASS_DEFAULT
+//   (s2a_qos.h: a prefetch is DEFAULT): its reads go at I/O tier 0 as the submit thread's, not UTILITY's throttled tier 1, behind which a page the submit thread then needs
