+// RewindBox (patch 0070): red only when a texel's bytes cannot be read. IPA 765 (Mario Kart World, iPhone17,2): its 8 red lines of this kind were all 512x512 sparse textures of
+//   10 levels (flags 0x24) at loading, as on IPA 762, whose storage is whole 64 KB tiles (nvn_tex.c layer_bytes): RG16 0x160000 bytes in a pool of 0x156000, the first byte not read at
+//   +0x159000 while its levels end at +0x155c00 (R16 and BC4 the same way; 108 KB in all): only the tail's rounding lay past the game's memory. Bytes that all lie past the last
+//   level of the last layer (rb_tex_data_end, from nvn_tex_level_offset) are now a plain note, counted apart (g_rb_pad_*); the copy with its zeros is as before and t->L.size,
+//   which the tile layout needs, is not changed. A byte before that end keeps the red line
+static unsigned tex_layers(const tex_t *t);
+static uint64_t g_rb_pad_n, g_rb_pad_bytes;   // RewindBox (patch 0070): uploads where only bytes past the last level could not be read, and those bytes (submit thread, as above)
+static uint64_t rb_tex_data_end(const tex_t *t) {   // RewindBox (patch 0070): the end of the last layer's last level in its storage, without a sparse tail's rounding (L.size where no level offset is known)
+    unsigned nl = t->d.levels ? t->d.levels : 1, ly = tex_layers(t); uint64_t e = nvn_tex_level_offset(&t->d, nl), ls = t->L.layer_size ? t->L.layer_size : t->L.size;
+    if (!e) return t->L.size;   // linear, buffer or unknown format: one level at 0 (nvn_tex.c)
+    if (ly > 1) e += (uint64_t)(ly - 1) * ls;
+    return MIN(e, t->L.size);
+}
 static void rb_pkg_note(const tex_t *t, uint64_t bad, uint64_t first) {
+    if (first >= rb_tex_data_end(t)) {   // RewindBox (patch 0070): only padding past the last level (see rb_tex_data_end): no texel reads 0
+        uint64_t k = ++g_rb_pad_n; g_rb_pad_bytes += bad;
+        if (k <= 4 || !(k & (k - 1))) MLOG("RewindBox: texture ser=%llu %ux%ux%u format %#x levels %u flags %#x: %llu bytes past its last level (from +%#llx; its levels end at +%#llx of %llu bytes) are not in the game's memory and read as 0, no texel is missing; %llu such uploads and %llu KB so far",
+                                           (unsigned long long)t->serial, t->d.width, t->d.height, t->d.depth, t->d.format, t->d.levels, t->d.flags, (unsigned long long)bad, (unsigned long long)first,
+                                           (unsigned long long)rb_tex_data_end(t), (unsigned long long)t->L.size, (unsigned long long)k, (unsigned long long)(g_rb_pad_bytes >> 10));
+        return;
+    }
     uint64_t k = ++g_rb_unread_n; g_rb_unread_bytes += bad;
     char where[224]; int c = rb_pool_text(t, where, sizeof where);
     if (g_rb_case_n[c]++ >= 8) return;   // the first 8 of each case: what the log layer keeps of a red line (runtime/src/logcap.c; the case's words come first, so each case is a line of its own there)
@@ -4285,6 +4305,141 @@ static void page_span(const tex_t *t, size_t k, const uint8_t **lo, size_t *n) {
     uintptr_t b = MAX(a, p0 + k * pg), c = MIN(e, p0 + (k + 1) * pg); *lo = (const uint8_t *)b; *n = c > b ? c - b : 0;
