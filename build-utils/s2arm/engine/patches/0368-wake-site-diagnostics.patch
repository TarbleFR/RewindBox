diff --git a/runtime/include/rb_wake.h b/runtime/include/rb_wake.h
new file mode 100644
index 0000000..0ec68b5
--- /dev/null
+++ b/runtime/include/rb_wake.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include <stdint.h>
+#include <stdatomic.h>
+#include <time.h>
+#include <errno.h>
+typedef struct { const char *file, *kind; unsigned line; _Atomic unsigned slot; } s2a_rb_wake_site;
+typedef struct { unsigned slot, epoch; } s2a_rb_wake_token;
+extern _Atomic unsigned s2a_rb_wake_enabled;
+void s2a_rb_wake_configure(int enabled);
+s2a_rb_wake_token s2a_rb_wake_begin(s2a_rb_wake_site *, int64_t timeout_ns);
+void s2a_rb_wake_end(s2a_rb_wake_token, int result);
+void s2a_rb_wake_report(uint64_t frame, void (*emit)(const char *));
+static inline int64_t s2a_rb_wake_relative(const struct timespec *t) {
+    return t ? (int64_t)t->tv_sec * 1000000000ll + t->tv_nsec : -1;
+}
+static inline int64_t s2a_rb_wake_absolute(const struct timespec *t) {
+    struct timespec n; clock_gettime(CLOCK_REALTIME, &n);
+    int64_t left = (int64_t)(t->tv_sec - n.tv_sec) * 1000000000ll + t->tv_nsec - n.tv_nsec;
+    return left > 0 ? left : 0;
+}
+// Counts API returns, not kernel interrupts. Signals count attempts, never an
+// inferred number of awakened threads. ns=-2 denotes a signal call.
+#define RB_WAKE_CALL(kind_, ns_, call_) __extension__ ({ \
+    static s2a_rb_wake_site rb_site_ = { __FILE__, kind_, __LINE__, 0 }; \
+    s2a_rb_wake_token rb_tok_ = {0}; \
+    if (__builtin_expect(atomic_load_explicit(&s2a_rb_wake_enabled,memory_order_relaxed),0)) \
+        rb_tok_ = s2a_rb_wake_begin(&rb_site_, (ns_)); \
+    int rb_result_ = (call_); if (rb_tok_.slot) s2a_rb_wake_end(rb_tok_, rb_result_); rb_result_; })
+
+#define RB_WAKE_SIGNAL_CALL(kind_, call_) __extension__ ({ \
+    static s2a_rb_wake_site rb_site_ = { __FILE__, kind_, __LINE__, 0 }; \
+    if (__builtin_expect(atomic_load_explicit(&s2a_rb_wake_enabled,memory_order_relaxed),0)) \
+        (void)s2a_rb_wake_begin(&rb_site_, -2); \
+    (call_); })
diff --git a/runtime/src/rb_wake.inc b/runtime/src/rb_wake.inc
new file mode 100644
index 0000000..abc9e6c
--- /dev/null
+++ b/runtime/src/rb_wake.inc
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+// Included once by thread.c. Bounded, allocation-free after static site creation.
+#include "rb_wake.h"
+#include <stdio.h>
+#include <string.h>
+enum { RB_WAKE_SITES = 256 };
+typedef struct {
+    s2a_rb_wake_site *site;
+    _Atomic uint64_t waits, resumes, timeouts, signals, short_waits, errors;
+} rb_wake_counts;
+static rb_wake_counts rb_wake_rows[RB_WAKE_SITES];
+static pthread_mutex_t rb_wake_mu = PTHREAD_MUTEX_INITIALIZER;
+_Atomic unsigned s2a_rb_wake_enabled;
+static _Atomic unsigned rb_wake_epoch;
+static unsigned rb_wake_count;
+static _Atomic uint64_t rb_wake_dropped;
+void s2a_rb_wake_configure(int enabled) {
+    atomic_store_explicit(&s2a_rb_wake_enabled, 0, memory_order_release);
+    pthread_mutex_lock(&rb_wake_mu);
+    atomic_fetch_add(&rb_wake_epoch, 1);
+    for (unsigned i=0; i<rb_wake_count; i++) {
+        rb_wake_counts *p=&rb_wake_rows[i];
+        atomic_store(&p->waits,0); atomic_store(&p->resumes,0); atomic_store(&p->timeouts,0);
+        atomic_store(&p->signals,0); atomic_store(&p->short_waits,0); atomic_store(&p->errors,0);
+    }
+    atomic_store(&rb_wake_dropped,0);
+    pthread_mutex_unlock(&rb_wake_mu);
+    atomic_store_explicit(&s2a_rb_wake_enabled, !!enabled, memory_order_release);
+}
+s2a_rb_wake_token s2a_rb_wake_begin(s2a_rb_wake_site *site, int64_t timeout_ns) {
+    if (!atomic_load_explicit(&s2a_rb_wake_enabled,memory_order_relaxed)) return (s2a_rb_wake_token){0};
+    unsigned epoch=atomic_load_explicit(&rb_wake_epoch,memory_order_acquire);
+    unsigned slot=atomic_load_explicit(&site->slot,memory_order_acquire);
+    if (!slot) {
+        pthread_mutex_lock(&rb_wake_mu);
+        slot=atomic_load_explicit(&site->slot,memory_order_relaxed);
+        if (!slot && rb_wake_count<RB_WAKE_SITES) {
+            slot=++rb_wake_count; rb_wake_rows[slot-1].site=site;
+            atomic_store_explicit(&site->slot,slot,memory_order_release);
+        }
+        pthread_mutex_unlock(&rb_wake_mu);
+    }
+    if (!slot) { atomic_fetch_add(&rb_wake_dropped,1); return (s2a_rb_wake_token){0}; }
+    rb_wake_counts *p=&rb_wake_rows[slot-1];
+    if (timeout_ns == -2) { atomic_fetch_add_explicit(&p->signals,1,memory_order_relaxed); return (s2a_rb_wake_token){0}; }
+    atomic_fetch_add_explicit(&p->waits,1,memory_order_relaxed);
+    if (timeout_ns>=0 && timeout_ns<=1000000) atomic_fetch_add_explicit(&p->short_waits,1,memory_order_relaxed);
+    return (s2a_rb_wake_token){slot,epoch};
+}
+void s2a_rb_wake_end(s2a_rb_wake_token token, int result) {
+    if (!token.slot || token.epoch!=atomic_load_explicit(&rb_wake_epoch,memory_order_acquire)) return;
+    rb_wake_counts *p=&rb_wake_rows[token.slot-1];
+    atomic_fetch_add_explicit(&p->resumes,1,memory_order_relaxed);
+    if (result==ETIMEDOUT) atomic_fetch_add_explicit(&p->timeouts,1,memory_order_relaxed);
+    else if (result && result!=EINTR) atomic_fetch_add_explicit(&p->errors,1,memory_order_relaxed);
+}
+void s2a_rb_wake_report(uint64_t frame, void (*emit)(const char *)) {
+    if (!atomic_load_explicit(&s2a_rb_wake_enabled,memory_order_acquire)) return;
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t);
+    uint64_t ns=(uint64_t)t.tv_sec*1000000000ull+t.tv_nsec;
+    pthread_mutex_lock(&rb_wake_mu);
+    char row[512];
+    snprintf(row,sizeof row,"[rb-wake] cumulative frame=%llu mono_ns=%llu epoch=%u sites=%u dropped=%llu short_limit_ns=1000000 units=api-calls-not-kernel-wakeups",
+             (unsigned long long)frame,(unsigned long long)ns,atomic_load(&rb_wake_epoch),rb_wake_count,(unsigned long long)atomic_load(&rb_wake_dropped));
+    emit(row);
+    for (unsigned i=0; i<rb_wake_count; i++) {
+        rb_wake_counts *p=&rb_wake_rows[i];
+        uint64_t waits=atomic_load(&p->waits), signals=atomic_load(&p->signals);
+        if (!waits && !signals) continue;
+        const char *file=strrchr(p->site->file,'/'); file=file ? file+1 : p->site->file;
+        snprintf(row,sizeof row,"[rb-wake-site] cumulative frame=%llu epoch=%u site=%s:%u kind=%s waits=%llu returns=%llu timeouts=%llu signals=%llu short_waits=%llu errors=%llu",
+                 (unsigned long long)frame,atomic_load(&rb_wake_epoch),file,p->site->line,p->site->kind,
+                 (unsigned long long)waits,(unsigned long long)atomic_load(&p->resumes),(unsigned long long)atomic_load(&p->timeouts),
+                 (unsigned long long)signals,(unsigned long long)atomic_load(&p->short_waits),(unsigned long long)atomic_load(&p->errors));
+        emit(row);
+    }
+    pthread_mutex_unlock(&rb_wake_mu);
+}
