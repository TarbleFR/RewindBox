+++ b/graphics/nvn/gfx/nvn/rb_sh_range.h
@@ -0,0 +1,32 @@
+// RewindBox (patch 0338): the free range of an open command recording. Pure C.
+//   Every record that takes device bytes asks whether its bytes overwrite an ended recording (hle_nvn.c cmd_alloc_cb, sh_overwrite). The lock-free look at the page buckets
+//   skips the lock only when no live recording has a node on those pages; but the recording that ended just before, on the same command buffer, is indexed on the very page
+//   the next one writes, so with recordings under about 8 KB 81 to 100 % of the writes took g_sh_mu and walked a bucket (exact simulation of the index; Mario Kart World records
+//   6 to 43 commands a recording). A game recording on 3 to 5 threads at once convoys on that lock: the cpuprof_2 profile of the maintainer (engine 0319) has its contended
+//   samples at cmd_alloc_cb+0x2cc, the return of that pthread_mutex_lock.
+//   Here each open recording keeps [lo, hi): bytes of its current segment that no live recording's interval covers, set under g_sh_mu once the overwritten recordings are
+//   released (or with no lock when the buckets of those pages are empty, the old test), up to the next live interval, the end of the next page or the segment's end. A write
+//   inside it takes no lock: it can overwrite nothing. Only the command buffer that owns a segment writes into it while it records (NVN), and the range never leaves the
+//   segment, so no interval can appear in it meanwhile; it is forgotten when the segment changes (AddCommandMemory, a host-lent window). The writes that release recordings
+//   are the same ones as before. S2A_RB_SH_RANGE=0: every write looks at the buckets as before.
+#pragma once
+#include <stdint.h>
+
+typedef struct { uintptr_t lo, hi; } rb_sh_free;   // hi == 0: not known
+
+static inline int rb_sh_range_asked_off(const char *value) { return value && value[0] == '0' && !value[1]; }
+static inline void rb_sh_free_forget(rb_sh_free *f) { f->lo = f->hi = 0; }
+// A write of [lo, hi) can overwrite nothing: it lies in the free range.
+static inline int rb_sh_free_covers(const rb_sh_free *f, uintptr_t lo, uintptr_t hi) { return f->hi && lo >= f->lo && hi <= f->hi; }
+// How far a range set by a write ending at hi may reach: the end of the page after hi's, at most the segment's end gend (0: not known), never below hi.
+static inline uintptr_t rb_sh_free_cap(uintptr_t hi, uintptr_t gend, unsigned page_shift) {
+    uintptr_t cap = ((hi >> page_shift) + 2) << page_shift;
+    if (gend && cap > gend) cap = gend;
+    return cap < hi ? hi : cap;
+}
+// The range a write [lo, hi) leaves once what it overwrote is released: up to the lowest start of a live interval at or after hi (next; UINTPTR_MAX: none), at most cap.
+static inline void rb_sh_free_put(rb_sh_free *f, uintptr_t lo, uintptr_t hi, uintptr_t cap, uintptr_t next) {
+    uintptr_t e = next < cap ? next : cap;
+    if (e < hi) e = hi;
+    f->lo = lo; f->hi = e;
+}
