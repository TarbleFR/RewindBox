+    LOG("[rb-sh-range] up to frame %llu: %llu command writes, %llu outside their recording's free range (%.1f %%), %llu took the release lock (%.1f %%)", (unsigned long long)frame,
+        (unsigned long long)w, (unsigned long long)l, 100.0 * (double)l / (double)w, (unsigned long long)k, 100.0 * (double)k / (double)w);
+}
