+static int sh_pages_any(uintptr_t lo, uintptr_t hi) {   // the lock-free look of sh_overwrite: a live node in a bucket of a page of [lo, hi)
+    uintptr_t p0 = lo >> SH_PAGE_SHIFT, p1 = (hi - 1) >> SH_PAGE_SHIFT; int any = p1 - p0 >= SH_NBKT;
+    for (uintptr_t p = p0; !any && p <= p1; p++) any = __atomic_load_n(&g_sh_bkt[sh_hash(p)], __ATOMIC_ACQUIRE) != NULL;
+    return any;
+}
+static uintptr_t sh_next_live(uintptr_t hi, uintptr_t cap) {   // g_sh_mu held, after sh_kill_range(.., hi): the lowest start at or after hi, below cap, of a live interval
+    uintptr_t best = UINTPTR_MAX;
+    if (cap <= hi) return best;
+    for (uintptr_t p = hi >> SH_PAGE_SHIFT; p <= (cap - 1) >> SH_PAGE_SHIFT; p++)
+        for (snode *d = g_sh_bkt[sh_hash(p)]; d; d = d->next)
+            if (d->page == p && d->hi > hi && d->lo < cap && d->lo < best) best = d->lo < hi ? hi : d->lo;
+    return best;
+}
+static void sh_overwrite_rec(srec *r, uintptr_t lo, uintptr_t hi, uintptr_t gend) {
+    if (!r || !rb_sh_range_on()) { sh_overwrite(lo, hi); return; }
+    atomic_fetch_add_explicit(&g_rb_sh_writes, 1, memory_order_relaxed);
+    if (rb_sh_free_covers(&r->rb_fr, lo, hi)) return;
+    atomic_fetch_add_explicit(&g_rb_sh_looked, 1, memory_order_relaxed);
+    uintptr_t cap = rb_sh_free_cap(hi, gend, SH_PAGE_SHIFT);
+    if (!sh_pages_any(lo, cap)) { rb_sh_free_put(&r->rb_fr, lo, hi, cap, UINTPTR_MAX); return; }   // as sh_overwrite: nothing indexed on these pages
+    atomic_fetch_add_explicit(&g_rb_sh_locked, 1, memory_order_relaxed);
+    pthread_mutex_lock(&g_sh_mu); sh_kill_range(lo, hi); rb_sh_free_put(&r->rb_fr, lo, hi, cap, sh_next_live(hi, cap)); pthread_mutex_unlock(&g_sh_mu);
+}
+static void rb_sh_range_line(uint64_t frame) {   // every 1800 frames (dump_frame), when anything was asked
