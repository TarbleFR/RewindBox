+++ b/runtime/src/rb_yield_event.inc
@@ -0,0 +1,63 @@
+// RewindBox (patch 0403), S5 candidate. This is a host progress notification,
+// never a substitute for a guest lock/event predicate. Pure memory polling has
+// no notifier, so it ALWAYS retains a bounded timer. No event-owned allocation.
+#if defined(__APPLE__)
+static pthread_mutex_t rb_yield_event_mu=PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t rb_yield_event_cv=PTHREAD_COND_INITIALIZER;
+static _Atomic int rb_yield_event_mode=-1;
+static _Atomic unsigned rb_yield_event_waiters;
+static _Atomic uint64_t rb_yield_event_seq, rb_yield_event_waits, rb_yield_event_hits, rb_yield_event_timeouts, rb_yield_event_ns;
+static int rb_yield_event_on(void) {
+    int mode=atomic_load_explicit(&rb_yield_event_mode,memory_order_relaxed);
+    if (mode<0) {
+        const char *e=getenv("S2A_RB_YIELD_EVENT");
+        const char *cap=getenv("S2A_YIELD_BACKOFF");
+        mode=e && !strcmp(e,"1") && (!cap || !*cap || !strcmp(cap,"1"));
+        atomic_store(&rb_yield_event_mode,mode);
+    }
+    return mode;
+}
+static void rb_yield_event_notify(void) {
+    // Even with no waiter yet, advance the epoch to close registration races.
+    // Default-off has no mutex or system call on the wake path.
+    if (atomic_load_explicit(&rb_yield_event_mode,memory_order_relaxed)!=1) return;
+    atomic_fetch_add_explicit(&rb_yield_event_seq,1,memory_order_seq_cst);
+    if (!atomic_load_explicit(&rb_yield_event_waiters,memory_order_seq_cst)) return;
+    pthread_mutex_lock(&rb_yield_event_mu);
+    RB_WAKE_CALL("yield.event.signal",-2,pthread_cond_broadcast(&rb_yield_event_cv));
+    pthread_mutex_unlock(&rb_yield_event_mu);
+}
+static uint64_t rb_yield_event_sleep(uint64_t budget) {
+    // Snapshot then register: a notifier changes the epoch or signals after
+    // the atomic unlock-and-wait. No G lock is acquired here.
+    uint64_t seq=atomic_load_explicit(&rb_yield_event_seq,memory_order_seq_cst);
+    atomic_fetch_add_explicit(&rb_yield_event_waiters,1,memory_order_seq_cst);
+    pthread_mutex_lock(&rb_yield_event_mu);
+    uint64_t start=(uint64_t)now_mono_ns(), end=start+budget;
+    while (!atomic_load(&g_session_stop) && atomic_load(&rb_yield_event_seq)==seq) {
+        uint64_t now=(uint64_t)now_mono_ns();
+        if (now>=end) break;
+        uint64_t left=end-now;
+        struct timespec rel={(time_t)(left/1000000000ull),(long)(left%1000000000ull)};
+        int rc=RB_WAKE_CALL("yield.event",s2a_rb_wake_relative(&rel),
+                           pthread_cond_timedwait_relative_np(&rb_yield_event_cv,&rb_yield_event_mu,&rel));
+        if (rc && rc!=EINTR) break;
+    }
+    uint64_t elapsed=(uint64_t)now_mono_ns()-start;
+    int changed=atomic_load(&rb_yield_event_seq)!=seq;
+    pthread_mutex_unlock(&rb_yield_event_mu);
+    atomic_fetch_sub_explicit(&rb_yield_event_waiters,1,memory_order_seq_cst);
+    atomic_fetch_add(&rb_yield_event_waits,1);
+    atomic_fetch_add(changed ? &rb_yield_event_hits : &rb_yield_event_timeouts,1);
+    atomic_fetch_add(&rb_yield_event_ns,elapsed);
+    return elapsed;
+}
+static void rb_yield_event_reset(void) {
+    // Called only after the existing join proof: no sleeping old-session owner.
+    atomic_store(&rb_yield_event_mode,-1); atomic_store(&rb_yield_event_seq,0);
+    atomic_store(&rb_yield_event_waits,0); atomic_store(&rb_yield_event_hits,0);
+    atomic_store(&rb_yield_event_timeouts,0); atomic_store(&rb_yield_event_ns,0);
+}
+#else
+static void rb_yield_event_notify(void) {}
+#endif
