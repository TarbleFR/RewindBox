+// A report past the band lowers the game's size only while the game has a
+// smaller size to go to; at its smallest size the same report only makes it
+// skip frames. iPhone at Serious with every frame pushed: the scene stayed at
+// 1248x700 for 600 frames while 106 to 124 frames of each 300 were asked at
+// present interval 2. The floor is learned from what the pushes do:
+// RB_DRS_FLOOR_STALL pushed frames without a smaller scene end the push. It
+// resumes RB_DRS_FLOOR_RETRY frames later at the earliest, and only while the
+// scene is more than a tenth above the smallest size a push ended at.
+enum { RB_DRS_FLOOR_STALL = 24, RB_DRS_FLOOR_RETRY = 600 };
+typedef struct {
+    uint64_t floor, run_min, retry_at, counted, rests, resumes;
+    unsigned stall;
+    int resting;
+} rb_drs_floor;
+// Whether the reports of `frame`, whose scene covers `pixels`, go past the
+// band. A scene of unknown size (0) is pushed on every frame, as before.
+static inline int rb_drs_floor_push(rb_drs_floor *s, uint64_t frame, uint64_t pixels) {
+    if (!pixels) return 1;
+    if (s->resting) {
+        if (pixels * 10 <= s->floor * 11 || frame < s->retry_at) return 0;
+        s->resting = 0; s->run_min = 0; s->stall = 0; ++s->resumes;
+    }
+    if (s->counted == frame + 1) return 1;
+    s->counted = frame + 1;
+    if (!s->run_min || pixels < s->run_min) { s->run_min = pixels; s->stall = 0; return 1; }
+    if (++s->stall < RB_DRS_FLOOR_STALL) return 1;
+    s->resting = 1; s->retry_at = frame + RB_DRS_FLOOR_RETRY; ++s->rests;
+    if (!s->floor || s->run_min < s->floor) s->floor = s->run_min;
+    return 1;
+}
