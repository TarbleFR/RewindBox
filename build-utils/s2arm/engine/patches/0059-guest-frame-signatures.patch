+// ---------- RewindBox (patch 0059): frame signatures ----------
+// One record a frame of what the game asked the GPU for and what the back end made of it, the last FSIG_N frames in a ring: a hash of the draw list (each draw's vertex and
+// pixel shader and, for a direct draw, its counts), the draws by kind (indirect, of an indirect-count multi-draw, task / mesh), the draws skipped for a pipeline still being
+// built, the passes, the pieces the frame was committed in, the dispatches, the shared textures made and those evicted by a texture over their storage, the largest colour
+// target drawn with a depth buffer, the words the GPU wrote that decide what indirect draws draw (an indirect draw's instance count, a multi-draw's count; read from the pool
+// when the piece that drew with them has run), and the span of the timestamp reports written for the game (the first TIMESTAMP_TOP to the last other report: what a game
+// that measures its GPU time reads).
+// Why: Mario Kart World on an iPhone17,2 shows single frames whose vegetation is another set than the frames before and after (the recording of IPA 762, 16 November: 9 of 199
+// distinct frames; IPA 760: 5 of 288; the palms beside the start line give way to smaller ones farther off for one frame). The engine log of that run rules out the
+// cross-queue order (24,353 parks, none released by force), a present-interval change (none in those seconds) and, on IPA 760, draws skipped for a pipeline (one run of four
+// in 1,200 frames); a capture holds one frame, and none held such a frame. The records tell the two remaining kinds apart: the game itself issuing another draw list for a
+// frame, or the same list drawing from other GPU-written counts.
+// fsig_judge writes a line when a frame's draw list differs from the frames before and after it while those two agree, and another when three frames agree on the list but
+// the middle one's GPU-written words differ. A capture (cap_end) writes the ring to frames.txt in its folder. S2A_RB_FSIG=0 turns the records off.
+// Cost: three multiplies and a few stores a draw on the replaying thread, a memory read a GPU-written word in the completion handler. Not measured on a device
+typedef struct { _Atomic uint64_t frame; uint64_t hash; _Atomic uint64_t ghash, gsum, ts0, ts1; uint32_t draws, ind, mdi, mesh, skipped, passes, pieces, disp, texnew, taken, w, h, gwords; } fsig_t;   // frame: its number + 1 (0 = empty)
+enum { FSIG_N = 1024, FSIG_ADDR = 2048 };
+static fsig_t g_fsig[FSIG_N];
+static uint64_t g_fsig_addr[FSIG_ADDR]; static uint32_t g_fsig_seq[FSIG_ADDR]; static int g_fsig_naddr;   // the piece being replayed: its GPU-written words (address, place in the frame's list)
+static uint64_t g_fsig_frames, g_fsig_aba_list, g_fsig_aba_gpu;
+static int fsig_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("S2A_RB_FSIG"); v = !(e && !strcmp(e, "0")); } return v; }
+static fsig_t *fsig_at(uint64_t f) { fsig_t *c = &g_fsig[f % FSIG_N]; return atomic_load_explicit(&c->frame, memory_order_relaxed) == f + 1 ? c : NULL; }
+static void fsig_judge(uint64_t f) {   // frame f's record has just been opened: the three frames before it are whole; GPU-written words are judged two frames later (their handlers have run)
+    if (f < 8) return;
+    fsig_t *a = fsig_at(f - 3), *b = fsig_at(f - 2), *c = fsig_at(f - 1);
+    if (a && b && c && a->draws >= 64 && a->hash == c->hash && b->hash != a->hash) {
+        uint64_t k = ++g_fsig_aba_list;
+        if (k <= 24 || !(k & (k - 1))) MLOG("RewindBox: frame signature: the draw list of frame %llu differs from the frames before and after it, which agree: draws %u / %u / %u, indirect %u / %u / %u, of multi-draws %u / %u / %u, task / mesh %u / %u / %u, "
+            "skipped for a pipeline %u / %u / %u, passes %u / %u / %u, pieces %u / %u / %u, dispatches %u / %u / %u, shared textures made %u / %u / %u, scene %ux%u / %ux%u / %ux%u; %llu such frames of %llu so far",
+            (unsigned long long)(f - 2), a->draws, b->draws, c->draws, a->ind, b->ind, c->ind, a->mdi, b->mdi, c->mdi, a->mesh, b->mesh, c->mesh, a->skipped, b->skipped, c->skipped, a->passes, b->passes, c->passes,
+            a->pieces, b->pieces, c->pieces, a->disp, b->disp, c->disp, a->texnew, b->texnew, c->texnew, a->w, a->h, b->w, b->h, c->w, c->h, (unsigned long long)k, (unsigned long long)g_fsig_frames);
+    }
+    a = fsig_at(f - 5); b = fsig_at(f - 4); c = fsig_at(f - 3);
+    if (a && b && c && a->draws >= 64 && a->gwords && a->hash == b->hash && b->hash == c->hash) {
+        uint64_t ga = atomic_load(&a->ghash), gb = atomic_load(&b->ghash), gc = atomic_load(&c->ghash);
+        if (ga == gc && gb != ga) {
+            uint64_t k = ++g_fsig_aba_gpu;
+            if (k <= 24 || !(k & (k - 1))) MLOG("RewindBox: frame signature: frames %llu to %llu have one draw list, and the words the GPU wrote for its indirect draws differ in frame %llu from the two around it, which agree: "
+                "their sum %llu / %llu / %llu over %u words, scene %ux%u / %ux%u / %ux%u, shared textures made %u / %u / %u, evicted %u / %u / %u; %llu such frames of %llu so far",
+                (unsigned long long)(f - 5), (unsigned long long)(f - 3), (unsigned long long)(f - 4), (unsigned long long)atomic_load(&a->gsum), (unsigned long long)atomic_load(&b->gsum), (unsigned long long)atomic_load(&c->gsum), b->gwords,
+                a->w, a->h, b->w, b->h, c->w, c->h, a->texnew, b->texnew, c->texnew, a->taken, b->taken, c->taken, (unsigned long long)k, (unsigned long long)g_fsig_frames);
+        }
+    }
+}
+// Every 300 frames, what the game's resolution and frame-interval controller did over the 300 frames before the last three (whose reports may still be on their way): the scene
+//   sizes it drew at, how often the size changed from one frame to the next, the shared textures made and evicted over their storage, and the GPU time it read from its own
+//   timestamp reports. Mario Kart World on IPA 762 re-made 7 to 14 shared textures a frame in the windows where it aimed at 60 frames a second and none where it held 30
+static void fsig_window(uint64_t f) {
+    enum { W = 300, SZ = 48 }; if (f < W + 3) return;
+    uint32_t sw[SZ], sh[SZ]; int ns = 0, over = 0; uint32_t pw = 0, ph = 0, changes = 0, n = 0, wmin = 0, hmin = 0, wmax = 0, hmax = 0; uint64_t made = 0, taken = 0, pieces = 0;
+    static uint32_t span[W]; uint32_t nsp = 0;   // the replaying thread only
+    for (uint64_t g = f - 3 - W; g < f - 3; g++) { fsig_t *c = fsig_at(g); if (!c || !c->w) continue;
+        n++; made += c->texnew; taken += c->taken; pieces += c->pieces;
+        if (pw && (c->w != pw || c->h != ph)) changes++;
+        pw = c->w; ph = c->h;
+        if (!wmin || (uint64_t)c->w * c->h < (uint64_t)wmin * hmin) { wmin = c->w; hmin = c->h; }
+        if ((uint64_t)c->w * c->h > (uint64_t)wmax * hmax) { wmax = c->w; hmax = c->h; }
+        int k = 0; while (k < ns && (sw[k] != c->w || sh[k] != c->h)) k++;
+        if (k == ns) { if (ns < SZ) { sw[ns] = c->w; sh[ns] = c->h; ns++; } else over = 1; }
+        uint64_t t0 = atomic_load(&c->ts0), t1 = atomic_load(&c->ts1); if (t0 && t1 > t0 && nsp < W) span[nsp++] = (uint32_t)MIN((t1 - t0) * 625 / 12000, (uint64_t)UINT32_MAX);
+    }
+    if (!n) return;
+    for (uint32_t i = 1; i < nsp; i++) { uint32_t v = span[i]; uint32_t j = i; while (j && span[j - 1] > v) { span[j] = span[j - 1]; j--; } span[j] = v; }   // 300 values at most
+    MLOG("RewindBox: frame signatures up to frame %llu: %u frames drew a scene, from %ux%u to %ux%u in %d%s sizes, another size than the frame before in %u; shared textures made %.1f a frame and %.1f evicted over their storage, "
+         "%.1f pieces a frame; GPU time the game read from its timestamp reports: p10 %.2f / p50 %.2f / p90 %.2f ms over %u frames; frames with another draw list than the two around them %llu, with other GPU-written words %llu (so far)",
+         (unsigned long long)f, n, wmin, hmin, wmax, hmax, ns, over ? " or more" : "", changes, (double)made / n, (double)taken / n, (double)pieces / n,
+         nsp ? span[nsp / 10] / 1000.0 : 0.0, nsp ? span[nsp / 2] / 1000.0 : 0.0, nsp ? span[nsp * 9 / 10] / 1000.0 : 0.0, nsp, (unsigned long long)g_fsig_aba_list, (unsigned long long)g_fsig_aba_gpu);
+}
+static fsig_t *fsig_cur(void) {   // the record of the frame being replayed, for the thread that replays (it holds the submit lock); NULL on any other thread, which leaves the records alone
+    if (!on_sub_thread()) return NULL;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed); fsig_t *c = &g_fsig[f % FSIG_N];
+    if (atomic_load_explicit(&c->frame, memory_order_relaxed) != f + 1) {
+        atomic_store(&c->frame, 0); c->hash = 0xcbf29ce484222325ull; atomic_store(&c->ghash, 0); atomic_store(&c->gsum, 0); atomic_store(&c->ts0, 0); atomic_store(&c->ts1, 0);
+        c->draws = c->ind = c->mdi = c->mesh = c->skipped = c->passes = c->pieces = c->disp = c->texnew = c->taken = c->w = c->h = c->gwords = 0;
+        atomic_store(&c->frame, f + 1); g_fsig_frames++; fsig_judge(f);
+        if (f % 300 == 0) fsig_window(f);
+    }
+    return c;
+}
+#define FSIG(stmt) do { fsig_t *fc_ = fsig_on() ? fsig_cur() : NULL; if (fc_) { stmt; } } while (0)   // on the replaying thread, with fc_ the frame's record
+static void fsig_word(fsig_t *c, uint64_t addr) {   // a word the GPU wrote, read back when this piece has run (nvn_be_sub_commit)
+    if (g_fsig_naddr < FSIG_ADDR) { g_fsig_seq[g_fsig_naddr] = c->gwords; g_fsig_addr[g_fsig_naddr++] = addr; }
+    c->gwords++;
+}
+// A draw: vs / fs identify its shaders (fsig_shkey of their keys, carried as pointers), ind its indirect record (0 = direct), cnt the count of its indirect-count multi-draw
+static void fsig_draw(const void *vs, const void *fs, uint64_t ind, uint64_t cnt, uint32_t count, uint32_t instances, int mesh) {
+    fsig_t *c = fsig_on() ? fsig_cur() : NULL; if (!c) return;
+    uint64_t h = c->hash;
+    h = (h ^ (uint64_t)(uintptr_t)vs) * 0x100000001b3ull; h = (h ^ (uint64_t)(uintptr_t)fs) * 0x100000001b3ull; h = (h ^ (ind ? 1 : (uint64_t)count << 24 ^ instances)) * 0x100000001b3ull;
+    c->hash = h; c->draws++;
+    if (mesh) { c->mesh++; return; }
+    if (cnt) { c->mdi++; if (!g_fsig_naddr || g_fsig_addr[g_fsig_naddr - 1] != cnt) fsig_word(c, cnt); }   // the multi-draw's count once; records past it hold what was there before
+    else if (ind) { c->ind++; fsig_word(c, ind + 4); }   // the instance count of {count, instances, ...}, arrays and elements alike
+}
+static void fsig_draw_again(void) { FSIG(fc_->hash = (fc_->hash ^ 0x9e3779b97f4a7c15ull) * 0x100000001b3ull; fc_->draws++; fc_->mdi++); }   // the next draw of a multi-draw, encoded alone (mdx_next)
+// A GPU-written word's share of its frame's hash: its place in the frame and its value mixed together, so that the sum over the words (the pieces' handlers run in any
+//   order) tells a count that moved from one word to another from the same counts (a plain sum of place and value did not: caught by a run over made-up frames)
+static uint64_t fsig_wmix(uint32_t seq, uint32_t v) {
+    uint64_t x = ((uint64_t)seq + 1) * 0x9e3779b97f4a7c15ull ^ ((uint64_t)v + 0x632be59bd9b4e019ull) * 0xff51afd7ed558ccdull;
+    x ^= x >> 31; x *= 0xc4ceb9fe1a85ec53ull; x ^= x >> 29; return x;
+}
+static void fsig_ts(uint64_t f, uint64_t t, int top) {   // a timestamp report written for the game (completion handler): the frame's first TIMESTAMP_TOP and last other report
+    fsig_t *r = fsig_on() ? fsig_at(f) : NULL; if (!r || !t) return;
+    if (top) { uint64_t o = atomic_load(&r->ts0); while ((!o || t < o) && !atomic_compare_exchange_weak(&r->ts0, &o, t)) {} }
+    else { uint64_t o = atomic_load(&r->ts1); while (t > o && !atomic_compare_exchange_weak(&r->ts1, &o, t)) {} }
+}
+static void fsig_dump(const char *dir) {   // cap_end: the ring, oldest frame first
+    if (!fsig_on() || !dir || !dir[0]) return;
+    char p[1100]; snprintf(p, sizeof p, "%s/frames.txt", dir); FILE *f = fopen(p, "w"); if (!f) return;
+    fprintf(f, "# RewindBox frame signatures (patch 0059), oldest first. frame, draw-list hash, draws, indirect, of multi-draws, task/mesh, skipped for a pipeline, passes, pieces, dispatches, shared textures made, evicted over their storage, scene WxH, "
+               "GPU-written words, their sum, their hash, timestamp span reported to the game in microseconds (0 = none)\n");
+    uint64_t hi = 0; for (int i = 0; i < FSIG_N; i++) { uint64_t v = atomic_load(&g_fsig[i].frame); if (v > hi) hi = v; }
+    for (uint64_t v = hi > FSIG_N ? hi - FSIG_N + 1 : 1; v <= hi; v++) { fsig_t *c = fsig_at(v - 1); if (!c) continue;
+        uint64_t t0 = atomic_load(&c->ts0), t1 = atomic_load(&c->ts1);
+        fprintf(f, "%llu %016llx %u %u %u %u %u %u %u %u %u %u %ux%u %u %llu %016llx %llu\n", (unsigned long long)(v - 1), (unsigned long long)c->hash, c->draws, c->ind, c->mdi, c->mesh, c->skipped, c->passes, c->pieces, c->disp, c->texnew, c->taken,
+                c->w, c->h, c->gwords, (unsigned long long)atomic_load(&c->gsum), (unsigned long long)atomic_load(&c->ghash), t0 && t1 > t0 ? (unsigned long long)((t1 - t0) * 625 / 12000) : 0ull); }
+    fprintf(f, "# frames with another draw list than the two around them, which agree: %llu; with the same list and other GPU-written words: %llu; frames recorded: %llu\n",
+            (unsigned long long)g_fsig_aba_list, (unsigned long long)g_fsig_aba_gpu, (unsigned long long)g_fsig_frames);
+    fclose(f);
+}
