diff --git a/runtime/src/thread.c b/runtime/src/thread.c
index cde898c..5810c3f 100644
--- a/runtime/src/thread.c
+++ b/runtime/src/thread.c
@@ -1028,12 +1028,35 @@ static void wg_leave_self(void) {
 //   Metal encode thread and the uniform copy thread (SC9). 1 when this thread is in the workgroup
 int s2a_wg_join_thread(const char *who) { if (!wg_on() || g_wg_mode == 2) return 0; wg_join_self(who); return t_wg_joined == 1; }
 // 每上屏一帧（ap_host.c s2a_frame_presented，渲染线程）：首次在本线程加入；结束上一帧间隔、开始下一帧。fps = 当前标称帧率（0 = 还没报过，按 30）
+// RewindBox (patch 0088): no frame interval while ProcessInfo's thermal state is serious or critical; intervals again after 30 s at fair or below. The workgroup
+//   keeps the frame's threads on the performance cores at a high clock (S2Arm's 10-30 reading: 1.9 -> 3.5 GHz), the power the heat cannot take; without an interval
+//   the system clocks them by their load again, and patch 0087 steps the game's resolution down meanwhile. Read twice a second (dm_thermal_now; the render thread
+//   alone calls s2a_wg_frame). S2A_RB_WG_THERMAL=0: intervals under heat too, as before
+__attribute__((weak)) int dm_thermal_now(void);   // declared weak before this first use: the weak default below (patch 0087), strong in ios/app.m and runtime/src/host_main.c
+static int rb_wg_paused(void) {
+    static int on = -1, paused; static uint64_t at, cool_since;
+    if (on < 0) { const char *e = getenv("S2A_RB_WG_THERMAL"); on = !(e && !strcmp(e, "0")); }
+    if (!on) return 0;
+    uint64_t ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (at && ns - at < 500000000ull) return paused;
+    at = ns;
+    int st = dm_thermal_now();
+    if (st >= 2) {
+        cool_since = 0;
+        if (!paused) { paused = 1; LOG("RewindBox (patch 0088): thermal state %d: the frame workgroup takes no intervals until 30 s at fair or below (S2A_RB_WG_THERMAL)", st); }
+    } else if (paused) {
+        if (!cool_since) cool_since = ns;
+        else if (ns - cool_since >= 30000000000ull) { paused = 0; cool_since = 0; LOG("RewindBox (patch 0088): thermal state %d for 30 s: the frame workgroup takes its intervals again", st); }
+    }
+    return paused;
+}
 void s2a_wg_frame(int fps) {
     if (!wg_on()) return;
     if (!t_wg_joined) wg_join_self("渲染线程");
     if (t_wg_joined < 0) return;
     static int started;
     if (started) { int frc = os_workgroup_interval_finish(g_wg, NULL); if (frc) { static int n; if (!n++) LOG("【红】帧间隔工作组：interval_finish rc=%d", frc); } }
+    if (rb_wg_paused()) { started = 0; return; }   // RewindBox (patch 0088): the interval just finished, none started under heat
     uint64_t now = thread_clock(), per = g_wg_period;
     if (!per) { per = (uint64_t)(1e9 / (fps > 0 ? fps : 30) * g_wg_tb.denom / g_wg_tb.numer); }
     int rc = os_workgroup_interval_start(g_wg, now, now + per, NULL);
