@@ -15646,7 +15650,7 @@ static void rb_reuse_report(uint64_t frame) {
     uint64_t v[15] = {g_txr_kept, g_txr_back, g_txr_back_key, g_txr_out, g_txr_press, g_ghost_unheld, g_ghost_miss_gone, g_snp_depth.made, g_snp_color.made, g_fit_made, g_init_copy_n, atomic_load(&g_rb_low_n),
