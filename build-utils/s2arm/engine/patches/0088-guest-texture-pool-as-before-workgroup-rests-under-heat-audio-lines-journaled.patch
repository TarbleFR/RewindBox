+static int rb_txr_small_on(void) { static int v = -1; if (v < 0) { const char *e = getenv("S2A_RB_TXR_SMALL"); v = e && !strcmp(e, "1"); } return v; }   // read under g_smu: said by rb_reuse_report, after it lets the lock go; RewindBox (patch 0088): =1 only
 static uint64_t txr_bytes_cap(void) { return rb_txr_small_on() ? (48ull << 20) : TXR_BYTES; }
 static uint64_t txr_idle_frames(void) { return rb_txr_small_on() ? 120 : TXR_IDLE; }
