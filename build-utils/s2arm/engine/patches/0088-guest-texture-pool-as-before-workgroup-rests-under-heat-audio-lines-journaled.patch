                 _rbLogLine = hasRbLog && System.Environment.GetEnvironmentVariable("S2A_RB_SERVICE_LOG") != "0" && rbLogLine(null) != 0 ? rbLogLine : null;
                 Red.RbToJournal();
+                RbAudioLines.Install();   // RewindBox (patch 0088)
 
                 if (!hasUnseen && !explicitOwner)
                 {
@@ -468,4 +469,45 @@ namespace S2A.Services
             [DllImport(Lib)] public static extern int s2a_register_cs(CsApi* api);
         }
     }
+    // RewindBox (patch 0088): the audio backend writes its lines on stderr ([声]: Ryujinx.Audio.Backends.Apple S2AOutputDiag, the 10-second callback, underrun and gap
+    //   counters and the recoveries), and in a guest the process's stderr stays the host's: no journal holds them (IPA 779: sound cut now and then, nothing to read).
+    //   They now reach the engine's journal (host.log) through Native.RbLog as well; every line still goes to the stderr it had. Lines of no other kind are copied.
+    //   S2A_RB_AUDIO_LOG=0: stderr only, as before
+    internal sealed class RbAudioLines : System.IO.TextWriter
+    {
+        private readonly System.IO.TextWriter _was;
+
+        private RbAudioLines(System.IO.TextWriter was)
+        {
+            _was = was;
+        }
+
+        internal static void Install()
+        {
+            if (!Native.RbLogOn || System.Environment.GetEnvironmentVariable("S2A_RB_AUDIO_LOG") == "0")
+            {
+                return;
+            }
+
+            System.Console.SetError(new RbAudioLines(System.Console.Error));   // Console wraps it in its synchronized writer
+        }
+
+        public override System.Text.Encoding Encoding => _was.Encoding;
+
+        public override void Write(char value) => _was.Write(value);
+
+        public override void Write(string value) => _was.Write(value);
+
+        public override void WriteLine(string value)
+        {
+            if (value != null && value.StartsWith("[声]", System.StringComparison.Ordinal))
+            {
+                Native.RbLog(value);
+            }
+
+            _was.WriteLine(value);
+        }
+
+        public override void Flush() => _was.Flush();
+    }
 }
