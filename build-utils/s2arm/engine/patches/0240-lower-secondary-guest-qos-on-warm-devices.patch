 // 设 QoS 并读回核对：设不上（如 .NET 建的线程 EPERM）或读回不符就报红一次
-static void set_qos(qos_class_t want) {
+static int set_qos(qos_class_t want) {
     int rc = pthread_set_qos_class_self_np(want, 0); qos_class_t got = QOS_CLASS_UNSPECIFIED; int rp = 0;
     pthread_get_qos_class_np(pthread_self(), &got, &rp);
     if (rc || got != want) { static _Atomic int n; if (!atomic_fetch_add(&n, 1)) LOG("【红】游戏线程 QoS 设 %#x 失败：rc=%d 读回 %#x", want, rc, got); }
+    return !rc && got == want;
+}
+#include "rb_guest_heat.h"
+static _Atomic int rb_guest_hot;
+static _Atomic unsigned rb_guest_down, rb_guest_up;
+static _Thread_local rb_guest_heat_role rb_heat_role;
+static _Thread_local int rb_frame_role;
+static _Thread_local uint64_t rb_qos_retry;
+
+void s2a_guest_heat_publish(int state) {
+    if (state < 0 || state > 3) return;
+    int hot = state >= 1;
+    if (atomic_exchange_explicit(&rb_guest_hot, hot, memory_order_relaxed) != hot)
+        LOG("[RB-GUEST-QOS] thermal=%d secondary=%s reduced_requests=%u restore_requests=%u",
+            state, hot ? "USER_INITIATED" : "USER_INTERACTIVE",
+            atomic_load(&rb_guest_down), atomic_load(&rb_guest_up));
+}
+
+static void rb_guest_heat_apply(int hot) {
+    if (rb_frame_role) hot = 0;
+    if (rb_heat_role.reduced == hot) {
+        if (rb_frame_role) rb_heat_role.secondary = 0;
+        return;
+    }
+    if (rb_qos_retry && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) < rb_qos_retry) return;
+    rb_guest_heat_role next = rb_heat_role;
+    int change = rb_guest_heat_change(&next, hot);
+    if (!change) return;
+    atomic_fetch_add_explicit(change > 0 ? &rb_guest_down : &rb_guest_up, 1, memory_order_relaxed);
+    if (set_qos(change > 0 ? QOS_CLASS_USER_INITIATED : QOS_CLASS_USER_INTERACTIVE)) {
+        rb_heat_role = next;
+        rb_qos_retry = 0;
+        if (rb_frame_role) rb_heat_role.secondary = 0;
+    } else {
+        rb_qos_retry = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 1000000000ull;
+    }
 }
+
+void s2a_guest_frame_qos_protect(void) {
+    if (!rb_heat_role.secondary) return;
+    if (!rb_frame_role) rb_qos_retry = 0;
+    rb_frame_role = 1;
+    rb_guest_heat_apply(0);
+}
