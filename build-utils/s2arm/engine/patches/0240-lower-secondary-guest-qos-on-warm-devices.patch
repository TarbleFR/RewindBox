diff --git a/runtime/tests/t_rb_guest_heat.c b/runtime/tests/t_rb_guest_heat.c
new file mode 100644
index 0000000..4f69592
--- /dev/null
+++ b/runtime/tests/t_rb_guest_heat.c
@@ -0,0 +1,24 @@
+#include "../src/rb_guest_heat.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    rb_guest_heat_role worker = rb_guest_heat_worker(93, 0, 1, 0);
+    assert(!rb_guest_heat_change(&worker, 0));
+    assert(rb_guest_heat_change(&worker, 1) == 1);
+    assert(!rb_guest_heat_change(&worker, 1));
+    assert(rb_guest_heat_change(&worker, 0) == -1);
+    assert(!rb_guest_heat_change(&worker, 0));
+    rb_guest_heat_role keep[] = {
+        rb_guest_heat_worker(81, 1, 1, 0), rb_guest_heat_worker(83, 0, 1, 0),
+        rb_guest_heat_worker(174, 0, 0, 0), rb_guest_heat_worker(173, 0, 1, 1),
+        (rb_guest_heat_role){0}
+    };
+    for (unsigned i = 0; i < sizeof keep / sizeof *keep; ++i)
+        assert(!rb_guest_heat_change(&keep[i], 1));
+    assert(rb_guest_heat_change(&worker, 1) == 1);
+    assert(rb_guest_heat_change(&worker, 0) == -1);
+    worker.secondary = 0;
+    assert(!rb_guest_heat_change(&worker, 1));
+    puts("PASS guest thermal QoS: secondary Fair/Nominal, role promotion, explicit and file I/O tiers");
+}
