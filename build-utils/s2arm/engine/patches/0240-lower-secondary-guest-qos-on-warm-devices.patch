diff --git a/runtime/src/rb_guest_heat.h b/runtime/src/rb_guest_heat.h
new file mode 100644
index 0000000..e949fad
--- /dev/null
+++ b/runtime/src/rb_guest_heat.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <stdint.h>
+
+typedef struct { int secondary, reduced; } rb_guest_heat_role;
+
+// Guest ID 83 is the hot gameplay worker in the measured MKW configuration.
+// IDs are process-local. The title/device/backend gate is applied by the producer.
+static inline rb_guest_heat_role rb_guest_heat_worker(uint64_t id, int main_thread,
+                                                     int interactive, int explicit_qos) {
+    return (rb_guest_heat_role){!main_thread && id != 83 && interactive && !explicit_qos, 0};
+}
+
+// Positive requests USER_INITIATED, negative restores the previous USER_INTERACTIVE.
+// Called on the owner thread; repeated observations do not make scheduler calls.
+static inline int rb_guest_heat_change(rb_guest_heat_role *role, int hot) {
+    if (!role->secondary || role->reduced == hot) return 0;
+    role->reduced = hot;
+    return hot ? 1 : -1;
+}
