 // A zero comparison switch selects the 803 paths across the cumulative candidate.
+// An explicit arm runs the 803 policy baseline. An absent or invalid selector
+// keeps the cumulative build. Restart the process when switching arms.
+static inline int rb_cup_trial(void) {
+#if defined(__APPLE__) && TARGET_OS_IOS
+    static _Atomic int cached;
+    int state=atomic_load_explicit(&cached,memory_order_relaxed);
+    if (!state) {
+        const char *e=getenv("S2A_RB_ABLATE_CUP_PRIORITY");
+        state=e && !strcmp(e,"0") ? 2 : e && !strcmp(e,"1") ? 3 : 1;
+        atomic_store_explicit(&cached,state,memory_order_relaxed);
+    }
+    return state-2; // -1 cumulative, 0 control, 1 without course priority
+#else
+    return -1;
+#endif
+}
