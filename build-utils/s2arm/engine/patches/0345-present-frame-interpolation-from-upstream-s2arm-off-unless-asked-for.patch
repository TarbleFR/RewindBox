diff --git a/graphics/nvn/gfx/nvn/nvn_present_fi.inc b/graphics/nvn/gfx/nvn/nvn_present_fi.inc
new file mode 100644
index 0000000..71660a1
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_present_fi.inc
@@ -0,0 +1,473 @@
+// RewindBox (patch 0345): present frame interpolation, ported from upstream S2Arm 54c2f8870 (graphics/nvn/gfx/nvn/nvn_present_fi.inc, the version with its fixes
+//   of 11-14 to 11-23: interpolation on the present queue, two-level motion vectors, scene cuts, frames late by the rule still encoded, resources out of the residency
+//   set on a rebuild and only once the old command slots are done). A game that asks for 30 fps or less and keeps its pace is shown at 60: one MetalFX frame between
+//   each two of the game's, the game's own frame half a period later. A game that asks for 60 is never interpolated. Off unless asked for: S2A_RB_FI=1 (RewindBox's
+//   setting, S2ArmEngineBridgePlugin.m) or upstream's DM_PRESENT_FI=1; the in-game menu turns it on or off during play (s2a_rb_guest_set_frame_interp, at the end).
+//   Changes for this engine: no FSR 1 scaling filter here (its two branches are left out); no community frame-rate patch aspect (rb_fi_patch_aspect gives 0, the
+//   interpolated frame takes the input's aspect as the game frame does); the flip is the window origin this engine presents with (g_origin_ll); present_blit_m4
+//   takes no screen argument; the sampler comes from present_now's own present_pipeline call; auxiliary shaders compile through rb_compile_auxiliary; only a
+//   BGRA8Unorm layer is interpolated (the copy and mid-frame pipelines draw that format into the drawable)
+// 出图补帧（11-14 维护者手测后定，取代我方 60 帧；DM_PRESENT_FI=1 备好功能，iOS 设置页缺省写 1，开不开按这款的「补帧」开关当场定，s2a_fi_set_live）。给原本 30 帧的游戏在屏上补到 60 帧：游戏一帧不少画、节拍不动。
+// 流程：游戏每交一帧，出图线程在上屏那条 Metal 4 队列（g_q4）上一次编完、提交、不等 GPU：缩拷成输入图（BGRA8，按游戏画面比例、高 ≤ DM_PRESENT_FI_MAXH，缺省 1080）
+//   → 1/4 亮度图 → 块匹配运动矢量 → MetalFX 帧插值（MTL4FXFrameInterpolator，iOS / macOS 26）由上一帧与这一帧补出正中的一帧 → 画进画布上屏；再把真帧画进第二张画布：
+//   整画面插值，深度填常数 1、运动矢量填 0（同 devinhurry/nxnative fix/ios-framegen-reference 的 nvn_fg.inc，MIT；一台 iPhone 上一款 30 帧开放世界游戏实测 28.56 → 59.98 帧、GPU 15.36 ms）；
+//   先上补出来的帧，再隔半个游戏周期把游戏的原图直接画上屏（原分辨率），原图上屏的命令做完才把这一帧的票记完成。
+//   比 11-13 的 VideoToolbox 版少了 RGB ↔ YUV 两次转换（那一版只走流程就 +1.3 W）；MetalFX 在单独一条 Metal 命令队列上编码，输入图写完（Metal 4 回调）才编、做完才上屏。
+// 为什么在同一条队列上（11-17 改）：原先拷贝做完回调到 CPU、再在单独的 Metal 3 队列上编码插值，那时游戏下一帧的 GPU 工作已经在跑，两边分时共用 GPU。
+//   iPad M4（#1510 诊断 D-PRA5）每次插值 GPU 墙钟 7.4–9.0 ms、作业均 9 ms，预算 12 ms 超时跳过约 1/3，屏上 45–50 帧；同一插值单独跑在 M5 Max 上 1080p 只要 0.8 ms
+//   （1/4 尺寸运动矢量，按 GPU 核数折到 M4 约 3–4 ms）。现在插值在 GPU 上紧跟这一帧的画面、排在游戏下一帧之前，不再分时、CPU 不等，也就没有超时跳过；
+//   插值做完前真帧不会先上屏（同一队列按序），补出的帧先上、真帧隔半个游戏周期再上（presentAfterMinimumDuration）。
+// 只走 Metal 4 + 有窗口的出图线程（开着时从启动就不建显示链接）；系统不支持、任何一步建不出来就整段回退到原来的出图，报红一次。
+// 线程：全部在出图线程上编码（g_fi_enc_mu 护着与出图共用的状态：遍描述、管线缓存、驻留集提交）。
+// MetalFX 头由 nvn_mtl.m 先包含的 nvn_present_fx.inc 带进来（本文件只在它之后被包含；不在共用文件里再直接包含苹果头，分层规则 R-02）
+#include "nvn_fi_rule.h"   // 逐帧判定：只补 30 帧档或更低档、跑满的帧（dm_fi_should_interp）
+
+API_AVAILABLE(macos(26.0), ios(26.0))
+@interface NvPresentFI : NSObject {
+@public
+    int w, h; NSUInteger hw, hh; MTLPixelFormat hpf; uint64_t n;
+    id<MTLTexture> in_tex[2], mid_tex, depth, motion;   // 输入图两张轮换（这一帧 / 上一帧；同一队列按序，读写不会撞）、补出的帧、常数深度、运动矢量
+    id mfx;   // MTL4FXFrameInterpolator：编进上屏那条 Metal 4 队列的命令缓冲
+    id<MTLRenderPipelineState> psoCopy, psoMid;
+    id<MTLComputePipelineState> mvDown, mvDown2, mvMatch, mvSpread, mvCut; id<MTLTexture> luma[2], luma16[2]; id<MTLBuffer> mvBlocks, mvCoarse, mvSad, mvFlag, mvArgs; id mvTab; int qw, qh, bw, bh, cw16, ch16, cbw, cbh;   // 自算运动矢量（DM_PRESENT_FI_MV）：亮度图随输入图轮换，上一帧的不重算
+    id<MTLBuffer> uv[4]; id tab[4];   // 命令槽 1 写输入 + 插值 + 上补出的帧（uv/tab 0 写输入、2 上补出的帧），槽 2 上真帧（uv/tab 3）
+    id alloc[3], cb[3];   // Metal 4 分配器 / 命令缓冲（MTL4 棘轮：用 id，经 nvn_mtl.m 的 m4_* 包装）
+    dispatch_semaphore_t slot_free[3];
+    uint64_t last_seq, last_pair_seq, jobs;
+    uint64_t made, shown_mid, declined, last_in_ns, made_win0;   // declined：按规则不补的帧（60 帧档 / 跑不满），原图直接上屏
+    uint64_t unpaired, gpu_n, cuts; double gpu_sum, gpu_max; _Atomic uint64_t cut_seq;   // cuts / cut_seq：判成切镜头的次数 / 最近一次的帧号（完成回调里写；下一次插值据此重置历史）   // unpaired：上一帧没进输入图 / 没取到画布，这一帧只当下一帧的前一帧；gpu_*：插值那一槽（缩拷 + 运动矢量 + MetalFX + 画进画布）的 GPU 时间，完成回调里在 g_pq_mu 下累计（每 300 帧一行）
+}
+@end
+@implementation NvPresentFI
+@end
+
+__attribute__((weak)) int s2a_fps_source(void) { return 1; }   // runtime/src/caps.c 给强定义（2 = 社区帧率补丁开着）；图形单测不链宿主时按「补帧」
+static int g_fi_state = -1;   // -1 没读开关；0 关 / 已回退；1 开
+static id g_fi;               // NvPresentFI
+// 和显示链互斥（11-15 #ee56e7 / #1155：补帧开着时出图切到显示链模式，补帧任务在自己队列里照样 nextDrawable，Core Animation 抛
+//   CAMetalLayerInvalidOperation 整个 App 退出；切换前后新旧两路同时交帧 = 频闪）。经典出图线程取画布时 g_classic_busy、显示链挂图层前先占 g_link_owns_layer 再等它归零
+//   （nvn_mtl.m link_main）；补帧任务不在这套里。现在：派任务时在途数 +1、两张画布交完 -1，显示链等「经典出图空闲且没有在途补帧」才挂；
+//   任务取画布前看一眼图层归不归显示链，归了就不取、只记票完成（这一帧丢掉，不两路交帧）。以下都在 g_pq_mu 下
+static int g_link_owns_layer, g_classic_busy;   // 暂定定义：同 nvn_mtl.m 出图段那一行是同一对象
+static int g_fi_inflight;                       // 已派出、两张画布还没交完的补帧任务数
+static int link_layer_busy(void) { return g_classic_busy || g_fi_inflight; }   // 显示链还不能挂图层
+static int fi_may_take_drawable(void) { return !g_link_owns_layer; }           // 补帧任务这时能不能 nextDrawable
+static void fi_inflight_add(int d) { pthread_mutex_lock(&g_pq_mu); g_fi_inflight += d; if (d < 0) pthread_cond_broadcast(&g_pq_cv); pthread_mutex_unlock(&g_pq_mu); }
+// 局中当场开 / 关补帧（iOS 齿轮菜单「补帧」调 s2a_fi_set_live，起局按这款的设置设）。关 = 这一帧起走原出图路径（同社区帧率补丁暂停那支），开 = 接着补
+static _Atomic int g_fi_live = 1;
+__attribute__((visibility("default"))) void s2a_fi_set_live(int on) { atomic_store(&g_fi_live, on ? 1 : 0); }
+
+// 显示链跟着「这一帧补不补」走（审计 P1-188）：补 → 0（补帧任务自己取画布）；玩家局中关补帧 / 社区帧率补丁接手 → 回到不补帧时的出图方式（g_link_base），
+//   原出图路径照旧有显示链。补丁要的 120 Hz 链（2）归补丁管（runtime/src/cpatch.c fps_link），这里不动。切换由 link_sync 每帧对齐，
+//   显示链挂图层前等经典出图与在途补帧都交完（g_link_owns_layer，#ee56e7）
+static void fi_link_follow(int fi) {
+    if (g_dm_present_link == 2) return;
+    int want = fi ? 0 : g_link_base;
+    if (g_dm_present_link != want) { MLOG("present frame interpolation: display link %s", want ? "back on (not interpolating)" : "off (interpolating)"); g_dm_present_link = want; }
+}
+static int fi_wanted_now(void);
+static int fi_wanted(void) { int on = fi_wanted_now(); if (g_fi_state == 1) fi_link_follow(on); return on; }
+static int fi_wanted_now(void) {
+    if (g_fi_state < 0) { g_fi_state = rb_fi_requested() && !g_m3;   // RewindBox (patch 0345): S2A_RB_FI=1 or DM_PRESENT_FI=1 (nvn_mtl.m rb_fi_requested)
+        if (g_fi_state) { MLOG("present frame interpolation: on (S2A_RB_FI=1; RewindBox patch 0345, from upstream S2Arm), encoded on the present queue right after the game frame, display link off"); }
+        else MLOG("present frame interpolation: off (%s; RewindBox patch 0345)", g_m3 ? "Metal 3 backend" : "S2A_RB_FI=1 turns it on"); }
+    if (g_fi_state != 1) return 0;
+    // 帧率来源（runtime/include/caps.h s2a_fps_source：补丁 > 补帧 > 原帧率）：有开着的社区帧率补丁这一帧就不补、走原出图路径（显示链照常，补丁的 60–120 Hz 才生效）；
+    //   每帧按当下来源判，60 帧开关局中切换、补丁跟着开关变也随即跟上
+    { int live = atomic_load(&g_fi_live); static int lw = 1; if (live != lw) { MLOG("present frame interpolation: %s by the player (in-game switch)", live ? "on" : "off"); lw = live; } if (!live) return 0; }
+    int patch = s2a_fps_source() == 2; static int was = -1;
+    if (patch != was) { if (patch || was == 1) MLOG("present frame interpolation: %s", patch ? "paused, a community frame-rate patch is active (patch > interpolation)" : "resumed, no active frame-rate patch"); was = patch; }
+    return !patch;
+}
+// 放掉一份插值器自己进驻留集的贴图 / 缓冲（fi_tex、uv、运动矢量那几块）：驻留集持有它们，只把对象置空不会释放。
+//   诊断#D-YVDD（11-22 #2111，杀戮尖塔 iPhone）：游戏每帧把画面尺寸在 1263–1295 × 715–720 之间微调（屏幕震动），插值器跟着「画面比例变了、整个重建」几百次，
+//   旧的一套（两张输入、补出帧、深度、运动 + 运动矢量各块）一直挂在驻留集里，GPU 占用一路涨到约 10 GB 后被系统杀。出集在下一次 res_commit 生效；出集前先等在途的命令槽做完（fi_drain：Metal 4 命令缓冲不拉住资源）
+// 旧插值器还在 GPU 上跑的命令槽做完之前不能出驻留集、不能放：Metal 4 的命令缓冲不拉住它用到的资源，原先重建（画面尺寸变了，fi_get）当场出集、放掉，
+//   在途那一槽读到已放 / 不驻留的贴图 → GPU 缺页（MTL4 kIOGPUCommandBufferCallbackErrorPageFault），同队列别的命令缓冲连带被丢
+//   （11-23 iPhone：一款开放世界游戏开局 1920→1280 重建那一刻；#1449 同一处）。等三个槽各自的「做完」信号（fi_commit 的完成回调发），最多 2 秒；
