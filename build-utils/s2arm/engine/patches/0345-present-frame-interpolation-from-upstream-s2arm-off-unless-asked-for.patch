+    pd.vertexFunction = [lib newFunctionWithName:@"vs"]; pd.fragmentFunction = [lib newFunctionWithName:@"fsCopy"]; pd.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
