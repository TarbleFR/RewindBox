+    NvPresentFI *f = fi_get(layer, cw, ch); if (!f) return -1;
+    uint64_t now = FI_NOW_NS(); double gap = f->last_in_ns ? (now - f->last_in_ns) / 1e9 : 0; f->last_in_ns = now;
+    int allow = dm_fi_should_interp(period, gap);   // 游戏声明的节拍（period，由交换间隔折成）+ 这一帧是否跑满；60 帧档一律不补
+    uint64_t seq = f->n++; BOOL flip = atomic_load_explicit(&g_origin_ll, memory_order_relaxed) != 0;   // RewindBox (patch 0345): the window origin present_encode_m4 flips with
+    fi_crop cr = {0}; if (crop) { cr.has = 1; memcpy(cr.c, crop, sizeof cr.c); }
+    fi_inflight_add(1);   // 出图线程还在 g_classic_busy 里：显示链此刻挂不上
+    fi_job(f, layer, src, cr, flip, (int)(seq & 1), seq, period, ticket, 1, allow);
+    return 1;
+}
+
+// RewindBox (patch 0345): the in-game menu turns interpolation on or off during play (S2ArmEngineBridgePlugin.m). 0 = applied from the next frame; -1 = not
+//   ready in this session (launched without S2A_RB_FI=1: the setting takes effect at the next launch); -2 = this device or backend cannot interpolate (Metal 3, or
+//   MetalFX turned it off at its first frame: fi_off)
+__attribute__((visibility("default"), used)) int s2a_rb_guest_set_frame_interp(int on) {
+    if (g_fi_state < 0 && !rb_fi_requested()) return -1;
+    if (g_fi_state == 0) return rb_fi_requested() ? -2 : -1;
+    if (g_m3) return -2;
+    s2a_fi_set_live(on);
+    return 0;
+}
