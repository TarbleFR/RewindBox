index 0000000..dc3b095
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_draw_barriers.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MIT
+// RewindBox (patch 0353): draw passes ordered by the game's own barriers by default (nvn_mtl.m barrier_game). Pure C, no Metal: the setting that picks the mode, the bits
+//   of the game's barriers that give the next draw pass the full barrier, and how a draw pass begins (the counters of the residency line). Tests: tests/t_rb_draw_barriers.c
+//   (kept out of the repository with the local fixtures of 0332+).
+//   Why: every game ran with the full barrier between draw passes, each pass waiting for all earlier GPU work (IPA 836 logs, "draw-pass entry barriers full" per 300 frames:
+//   Mario Kart World 36,000 to 40,800 in play, Zelda 15,500 to 24,300 besides those saved by producer coverage). The relaxed mode was there (the profile key draw_barriers
+//   game) but no profile writes the key. nxnative measured Ocarina of Time: GPU 25 -> 18 ms (Mac, draw_barriers game), M1 Max 22.0-22.3 -> 20.2-20.4 ms with the bits rule
+//   below, one iPhone run 29.7 -> 27.2 ms, an M2 Air and an M4 Pro no change. Not measured here.
+//   The bits rule is nxnative e7750541 (MIT, Copyright (c) 2026 seedds; LiamPalmqvist's PR 2334 after AdyaGMD's PR 1970): NVN orders later vertex, task, mesh or
+//   indirect-argument fetch after earlier work only for ORDER_PRIMITIVES and ORDER_INDIRECT_DATA. ORDER_FRAGMENTS and ORDER_FRAGMENTS_TILED order later fragments only,
+//   which the relaxed end barrier gives (vertex, object, mesh and fragment stages before later fragment, dispatch and copy work). The INVALIDATE_* bits order nothing:
+//   TEXTURE and SHADER let the caches see writes that an order bit, a wait or the end of a submission already completed (the relaxed end barrier flushes to the device,
+//   and the next pass's fragment stage starts after it), TEXTURE_DESCRIPTOR concerns pools the replay reads on the CPU, and ZCULL has no Metal counterpart: none of them needs
+//   the full barrier. A bit NVN does not define (above INVALIDATE_ZCULL) takes the full barrier, which nxnative does not do.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// NVNbarrierBits (include/nvn.h; nvn_mtl.m checks that the values match). Plain constants: compared with NVN's enum without mixing two enumerations
+#define RB_BAR_ORDER_PRIMITIVES 0x1
+#define RB_BAR_ORDER_FRAGMENTS 0x2
+#define RB_BAR_ORDER_FRAGMENTS_TILED 0x4
+#define RB_BAR_ORDER_INDIRECT_DATA 0x8
+#define RB_BAR_INVALIDATE_TEXTURE 0x10
+#define RB_BAR_INVALIDATE_SHADER 0x20
+#define RB_BAR_INVALIDATE_TEXTURE_DESCRIPTOR 0x40
+#define RB_BAR_INVALIDATE_ZCULL 0x80
+// The bits the relaxed end barrier covers. The most common barriers: 0x12 (ORDER_FRAGMENTS | INVALIDATE_TEXTURE), 0x32 (and INVALIDATE_SHADER), both in the IPA 836 logs
+#define RB_BAR_RELAXED_BITS (RB_BAR_ORDER_FRAGMENTS | RB_BAR_ORDER_FRAGMENTS_TILED | RB_BAR_INVALIDATE_TEXTURE | RB_BAR_INVALIDATE_SHADER | \
+                             RB_BAR_INVALIDATE_TEXTURE_DESCRIPTOR | RB_BAR_INVALIDATE_ZCULL)
+// The bits of the game's barriers since the last draw pass began give the next draw pass the full barrier
+static inline int rb_bar_bits_full(uint32_t bits) { return (bits & ~(uint32_t)RB_BAR_RELAXED_BITS) != 0; }
+
+// The mode, 1 game / 0 full. dm: DM_NVN_BARRIER (upstream: any value that is not empty decides, game, anything else full); rb: S2A_RB_DRAW_BARRIERS (game or full, anything
+//   else is ignored); profile: the game's draw_barriers key, 1 game, 0 full, -1 not written (or not understood: game_tsv.h). Then the RewindBox default, game.
+//   *src: which of them decided (RB_DBAR_SRC_*)
+enum { RB_DBAR_SRC_DM, RB_DBAR_SRC_RB, RB_DBAR_SRC_PROFILE, RB_DBAR_SRC_DEFAULT };
+static inline int rb_draw_barriers_pick(const char *dm, const char *rb, int profile, int *src) {
+    int s, v;
+    if (dm && *dm) { s = RB_DBAR_SRC_DM; v = !strcmp(dm, "game"); }
+    else if (rb && (!strcmp(rb, "game") || !strcmp(rb, "full"))) { s = RB_DBAR_SRC_RB; v = !strcmp(rb, "game"); }
+    else if (profile >= 0) { s = RB_DBAR_SRC_PROFILE; v = profile != 0; }
+    else { s = RB_DBAR_SRC_DEFAULT; v = 1; }
+    if (src) *src = s;
+    return v;
+}
+
+// How a draw pass begins. game: the mode; last_relaxed: the last encoder ended on this command buffer was a draw pass with the relaxed end barrier (nvn_mtl.m
+//   g_last_end_relaxed: anything else in between, compute, copies, uploads, another kind of encoder, MetalFX, a GPU event wait that did not park, and a new command buffer,
+//   which is also where another NVN queue's work begins, clear it); bits: the game's barrier bits since the last draw pass began (g_game_barrier)
+enum {
+    RB_DBAR_RELAXED,        // without the full barrier, no game barrier since the last draw pass
+    RB_DBAR_RELAXED_BITS,   // without the full barrier, after game barriers the relaxed end barrier covers (the bits rule's gain)
+    RB_DBAR_BITS,           // the full barrier: a game barrier that orders primitives or indirect data (or a bit NVN does not define)
+    RB_DBAR_WORK,           // the full barrier: other work, a wait, a new command buffer or another queue since the last draw pass
+    RB_DBAR_MODE,           // the full barrier: draw_barriers full
+    RB_DBAR_COUNT
+};
+static inline int rb_draw_barrier_entry(int game, int last_relaxed, uint32_t bits) {
+    if (!game) return RB_DBAR_MODE;
+    if (!last_relaxed) return RB_DBAR_WORK;
+    if (rb_bar_bits_full(bits)) return RB_DBAR_BITS;
+    return bits ? RB_DBAR_RELAXED_BITS : RB_DBAR_RELAXED;
+}
+static inline int rb_draw_barrier_relaxed(int entry) { return entry == RB_DBAR_RELAXED || entry == RB_DBAR_RELAXED_BITS; }
