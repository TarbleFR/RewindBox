+            (source.first <= target.last && target.first <= source.last)) return 1;
+        pthread_mutex_lock(&g_smu);
+        id obj = hm_get_id(&g_by_serial, &t->serial);
+        pthread_mutex_unlock(&g_smu);
+        if ([obj conformsToProtocol:@protocol(MTLTexture)] && rs_root(obj) == storage) return 1;
+    }
+    return 0;
+}
+static int rs_shader_opaque(const NvShader *sh, int stage, rs_draw_guard *guard) {
+    if (!sh || !sh->rf.route_b || sh->rf.pool) return 1;
+    for (int k = 0; k < sh->rf.nb; ++k) {
+        const nvn_rbind *b = &sh->rf.b[k];
+        switch (b->kind) {
+        case NVN_RB_CBUF: case NVN_RB_SAMP: case NVN_RB_SAMPT: case NVN_RB_SAMPI:
+        case NVN_RB_SUPPORT: case NVN_RB_C1: case NVN_RB_DRV0: case NVN_RB_DRV2:
+        case NVN_RB_UVX: case NVN_RB_LB: case NVN_RB_UBOLEN: case NVN_RB_SBSZ: case NVN_RB_PUSH:
+            continue;
+        case NVN_RB_TEX: case NVN_RB_IMG: break;
+        default: return 1;
+        }
+        if (b->n || b->reg >= NTEX) return 1;
+        int tid = b->kind == NVN_RB_IMG ? img_tid(b, stage) :
+                  (int)(tex_slot_h(S.tex[stage], S.img[stage], b->reg) & 0xfffff);
+        if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+        const treg_t *entry = &g_treg[tid];
+        pthread_mutex_lock(&g_smu);
+        id obj = hm_get_id(&g_by_serial, &entry->t.serial);
+        id<MTLTexture> tex = [obj conformsToProtocol:@protocol(MTLTexture)] ? obj :
+                              [obj isKindOfClass:[NvPkg class]] ? ((NvPkg *)obj)->tex : nil;
+        pthread_mutex_unlock(&g_smu);
+        if (!tex || entry->t.has_layout || !entry->t.pool ||
+            (entry->t.pool->flags & NVN_MEMORY_POOL_FLAGS_VIRTUAL)) return 1;
+        id<MTLTexture> root = rs_root(tex);
+        NvRsInfo *info = rs_info(root);
+        if (!(entry->t.d.width == 960 && entry->t.d.height == 540) &&
+            !(info && info->cw == 960 && info->ch == 540)) continue;
+        if (stage == 1 && tid > 0 && b->kind == NVN_RB_TEX && !entry->has_v && !b->f1d &&
+            tex.textureType == MTLTextureType2D && b->dtt == MTLTextureType2D &&
+            tex.sampleCount == 1 && entry->t.d.target == NVN_TEXTURE_TARGET_2D) {
+            if (sh->size_abi && sh->size_exact && sh->exact == 1 && !sh->ts_lost &&
+                b->dpf == mtl_pf_dpf(tex.pixelFormat)) continue;
+            if (rs_normalized_read(sh, b, entry, tex, tex)) continue;
+        }
+        if (info && info->state == RS_SCALED) {
+            if (!guard->roots) guard->roots = [NSMutableArray array];
+            if (![guard->roots containsObject:root]) [guard->roots addObject:root];
+            unsigned why = b->kind == NVN_RB_IMG ? RS_REJECT_IMAGE : stage != 1 ? RS_REJECT_STAGE : RS_REJECT_FS;
+            rs_retain_note(&entry->t, root, why, sh->key, b->reg);
+        }
+        if (!guard->native_target && rs_active_alias(&entry->t, root)) guard->native_target = 1;
+    }
+    return 0;
+}
+
+static int rs_program_opaque(const NvProg *pr, int compute, rs_draw_guard *guarded) {
+    int native = !pr || pr->unres;
+    if (!native) {
+        pthread_mutex_lock(&g_rmu);
+        if (compute) native = rs_shader_opaque(pr->sh[5], 5, guarded);
+        else {
+            native = !pr->sh[0] || !pr->sh[1] || pr->sh[2] || pr->sh[3] || pr->sh[4] ||
+                     rs_shader_opaque(pr->sh[0], 0, guarded) || rs_shader_opaque(pr->sh[1], 1, guarded);
+        }
+        pthread_mutex_unlock(&g_rmu);
+    }
+    return native;
+}
+static int rs_prepare_work(const NvProg *pr, int compute) {
+    if (g_rs_native_draw) return 1;   // inherited from an enclosing GPU operation
+    if (!rs_on() || !rs_retain_on()) return 1;
+    int live = atomic_load_explicit(&g_rs_scene_count, memory_order_relaxed) != 0;
+    int possible = R.rt.depth && R.rt.depth->d.width == 960 && R.rt.depth->d.height == 540;
+    for (int k = 0; !possible && k < R.rt.n && k < 8; ++k)
+        possible = R.rt.color[k] && R.rt.color[k]->d.width == 960 && R.rt.color[k]->d.height == 540;
+    if (!live && !g_nlc && (!possible || compute)) return 1;
+    rs_draw_guard guarded = {0};
+    int native = rs_program_opaque(pr, compute, &guarded);
+    if (!native && !guarded.roots.count && !guarded.native_target) return 1;
+    // End the old producer and land pending clears before snapshotting roots:
+    // a deferred clear can itself create scaled storage. Prevent the consumer's
+    // pass from immediately putting an unknown input/feedback target back at scale.
+    g_rs_native_draw = native || guarded.native_target;
+    if (!live && !g_nlc) return 1;
+    uint64_t previous_generation = atomic_load_explicit(&g_ser_gen, memory_order_relaxed);
+    if (g_nlc) lc_land();
+    rp_flush();
+    if (!native && previous_generation != atomic_load_explicit(&g_ser_gen, memory_order_relaxed)) {
+        // Materializing an earlier clear can replace a root collected above.
+        // Consult the current holder again before choosing it for promotion.
+        guarded.roots = nil; guarded.native_target = 0;
+        native = rs_program_opaque(pr, compute, &guarded);
+        g_rs_native_draw = native || guarded.native_target;
+    }
+    NSArray *roots = guarded.roots;
+    if (native) {
+        os_unfair_lock_lock(&g_rs_scene_lock);
+        roots = g_rs_scene_roots.allObjects;
+        atomic_store_explicit(&g_rs_scene_count, (unsigned)roots.count, memory_order_relaxed);
+        os_unfair_lock_unlock(&g_rs_scene_lock);
+    }
+    if (native && roots.count)
+        atomic_fetch_add_explicit(&g_rs_opaque_promotions, roots.count, memory_order_relaxed);
+    for (id<MTLTexture> root in roots) {
+        NvRsInfo *old = rs_info(root);
+        if (old && old->state == RS_SCALED && !rs_rescale_to(root, 1.0, "incompatible shader preflight")) {
+            MLOG("【红】 [rscale-retain] blocked original GPU operation after a failed preflight promotion");
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static inline void rs_bind_check(id<MTLTexture> t, const NvShader *sh, int stage, int kind,
+                                 const nvn_rbind *binding, int tid, id<MTLTexture> original) {
     if (!t || !rs_on()) return;
-    if (kind == 2) rs_bad(t, "绑在存储图像槽");
-    else if (kind == 1) rs_bad(t, "被句柄数组读");
-    else if (nvn_stage != 1) rs_bad(t, "被顶点 / 计算等非片元阶段读");
-    else if (sh->exact != 1 || sh->ts_lost || (sh->size_abi && !sh->size_exact)) rs_bad(t, "被取图倍率不精确的片元着色器读");   // ABI2 非 exact（legacy_1x）同不精确
+    unsigned reason;
+    const char *why;
+    if (kind == 2) { reason = RS_REJECT_IMAGE; why = "绑在存储图像槽"; }
+    else if (kind == 1) { reason = RS_REJECT_INDIRECT; why = "被句柄数组读"; }
+    else if (stage != 1) { reason = RS_REJECT_STAGE; why = "被顶点 / 计算等非片元阶段读"; }
+    else if (sh->exact != 1 || sh->ts_lost || (sh->size_abi && !sh->size_exact)) {
+        reason = RS_REJECT_FS; why = "被取图倍率不精确的片元着色器读";
+    } else return;
+    if (rs_retain_on() && rs_state(t) == RS_SCALED && tid >= 0 && tid < g_ntreg && g_treg[tid].ok) {
+        const treg_t *entry = &g_treg[tid];
+        const tex_t *guest = &entry->t;
+        int slot = binding->reg;
+        if (reason == RS_REJECT_FS && rs_normalized_read(sh, binding, entry, t, original)) {
+            rs_retain_note(guest, t, RS_KEEP_READ, sh->key, slot);
+            return;
+        }
+        rs_retain_note(guest, t, reason, sh->key, slot);
+    }
+    rs_bad(t, why);
 }
