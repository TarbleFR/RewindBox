diff --git a/graphics/nvn/gfx/nvn/rb_scale_retain.h b/graphics/nvn/gfx/nvn/rb_scale_retain.h
new file mode 100644
index 0000000..daec92a
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_scale_retain.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// Only the exact diagnostic emitted by QuerySamplerType's missing 2D default.
+// Indirect handles and unknown spellings don't establish a direct guest slot.
+static inline int rb_scale_missing_slot(const char *s) {
+    const char prefix[] = "unknown_missing_fact:sampler_type:handle=";
+    if (!s || strncmp(s, prefix, sizeof prefix - 1)) return -1;
+    s += sizeof prefix - 1;
+    int digits = 0;
+    while ((*s >= '0' && *s <= '9') || (*s >= 'A' && *s <= 'F')) {
+        if (++digits > 8) return -1;
+        ++s;
+    }
+    const char suffix[] = ":cbuf=-1:slot=";
+    if (!digits || strncmp(s, suffix, sizeof suffix - 1)) return -1;
+    s += sizeof suffix - 1;
+    if (*s < '0' || *s > '9') return -1;
+    unsigned slot = 0;
+    while (*s >= '0' && *s <= '9') {
+        slot = slot * 10 + (unsigned)(*s++ - '0');
+        if (slot > 255) return -1;
+    }
+    return *s ? -1 : (int)slot;
+}
+
+static inline int rb_scale_retain_read(int missing_slot, int slot, int exact, int abi2_legacy,
+                                        int table_entries, int dropped, int fragcoord, int direct_2d) {
+    return missing_slot >= 0 && missing_slot == slot && exact == 1 && abi2_legacy &&
+           !table_entries && !dropped && !fragcoord && direct_2d;
+}
+
+// Match the planes that rp_begin_ex_ will physically attach. Mode 1 is the
+// clear-only encoder; 2 omits DS, and 3/4 use just one plane of the DS texture.
+static inline int rb_scale_active_plane(int mode, int depth, int clears, int duplicate) {
+    return !duplicate && (!depth || mode != 2) && (mode != 1 || clears);
+}
+
+static inline int rb_scale_ui_canvas(unsigned width, unsigned height) {
+    return width == 1920 && height == 1080;
+}
diff --git a/graphics/nvn/tests/t_rb_scale_preflight.m b/graphics/nvn/tests/t_rb_scale_preflight.m
new file mode 100644
index 0000000..068f7eb
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_scale_preflight.m
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+// Runs the real reflected binding lookup and uses an actual Metal allocation.
+// Compatible with the tracked Metal device provided by a virtual macOS host.
+#include "../gfx/nvn/nvn_mtl.m"
+#define REQUIRE(c) do { if (!(c)) { fprintf(stderr, "failed %s at %d\n", #c, __LINE__); return 1; } } while (0)
+
+int main(void) {
+    @autoreleasepool {
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        if (!device) return 77;
+        id<MTLTexture> color = [device newTextureWithDescriptor:
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                              width:720 height:405 mipmapped:NO]];
+        REQUIRE(color);
+        enum { SLOT = 2, TID = 7 };
+        static uint8_t bytes[1024];
+        static pool_t pool;
+        pool.mem = bytes; pool.size = sizeof bytes;
+        g_treg = calloc(TID + 1, sizeof *g_treg); g_ntreg = TID + 1;
+        REQUIRE(g_treg);
+        treg_t *entry = &g_treg[TID];
+        entry->ok = 1; entry->t.serial = 1234; entry->t.pool = &pool;
+        entry->t.mem = bytes; entry->t.L.size = sizeof bytes;
+        entry->t.d.target = NVN_TEXTURE_TARGET_2D;
+        entry->t.d.width = 960; entry->t.d.height = 540;
+        entry->t.d.levels = 1; entry->t.d.samples = 1;
+        hm_put_id(&g_by_serial, &entry->t.serial, color);
+        rs_set_info_at(color, RS_SCALED, 960, 540, 0.75);
+        S.tex[1][SLOT] = TID;
+
+        NvShader *fs = [NvShader new]; fs->rf.nb = 1; fs->rf.route_b = 1;
+        fs->rf.b = calloc(1, sizeof *fs->rf.b); REQUIRE(fs->rf.b);
+        nvn_rbind *b = fs->rf.b; b->kind = NVN_RB_TEX; b->reg = SLOT;
+        b->dtt = MTLTextureType2D; b->dpf = NVN_DPF_FLOAT;
+        fs->exact = 1; fs->size_abi = 1; fs->rs_missing_slot = SLOT + 1;
+        rs_draw_guard normalized = {0};
+        REQUIRE(!rs_shader_opaque(fs, 1, &normalized) && !normalized.roots.count);
+        // Same real texture, same slot, now accessed by an unproven integer fetch.
+        // The guard must return this root before the caller creates/uses the encoder.
+        fs->nts = 1;
+        rs_draw_guard integer = {0};
+        REQUIRE(!rs_shader_opaque(fs, 1, &integer));
+        REQUIRE(integer.roots.count == 1 && integer.roots.firstObject == color);
+        // A real active target must stay native during an opaque feedback draw.
+        R.rt.n = 1; R.rt.color[0] = &entry->t;
+        rs_draw_guard feedback = {0};
+        REQUIRE(!rs_shader_opaque(fs, 1, &feedback) && feedback.native_target);
+        REQUIRE(feedback.roots.count == 1 && feedback.roots.firstObject == color);
+        // An unresolved pool or buffer table cannot confine the operation to this root.
+        b->kind = NVN_RB_TEXP;
+        rs_draw_guard indirect = {0};
+        REQUIRE(rs_shader_opaque(fs, 1, &indirect));
+        puts("PASS actual Metal texture and binding preflight: sampled, integer access, feedback and opaque pool");
+    }
+    return 0;
+}
diff --git a/graphics/nvn/tests/t_rb_scale_retain.c b/graphics/nvn/tests/t_rb_scale_retain.c
new file mode 100644
index 0000000..a880a5c
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_scale_retain.c
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_scale_retain.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    assert(rb_scale_missing_slot("unknown_missing_fact:sampler_type:handle=2A:cbuf=-1:slot=12") == 12);
+    const char *invalid[] = {NULL, "", "unsupported_scaled_access:legacy_scale_helper",
+        "unknown_missing_fact:sampler_type:handle=A:cbuf=0:slot=12",
+        "unknown_missing_fact:sampler_type:handle=A:cbuf=-1:slot=256",
+        "unknown_missing_fact:sampler_type:handle=A:cbuf=-1:slot=12:value=2d",
+        "unknown_missing_fact:sampler_type:handle=:cbuf=-1:slot=12"};
+    for (unsigned i = 0; i < sizeof invalid / sizeof invalid[0]; ++i)
+        assert(rb_scale_missing_slot(invalid[i]) < 0);
+    assert(rb_scale_retain_read(12,12,1,1,0,0,0,1));
+    assert(!rb_scale_retain_read(-1,12,1,1,0,0,0,1));
+    assert(!rb_scale_retain_read(12,11,1,1,0,0,0,1));
+    assert(!rb_scale_retain_read(12,12,0,1,0,0,0,1));
+    assert(!rb_scale_retain_read(12,12,1,0,0,0,0,1));
+    assert(!rb_scale_retain_read(12,12,1,1,1,0,0,1));
+    assert(!rb_scale_retain_read(12,12,1,1,0,1,0,1));
+    assert(!rb_scale_retain_read(12,12,1,1,0,0,1,1));
+    assert(!rb_scale_retain_read(12,12,1,1,0,0,0,0));
+    assert(rb_scale_ui_canvas(1920,1080));
+    assert(!rb_scale_ui_canvas(960,540) && !rb_scale_ui_canvas(1536,1536));
+    // Bound 960x540 color + native-only D32: a color-only materialization
+    // sees only color, a draw sees both and must use a common factor.
+    assert(rb_scale_active_plane(1,0,1,0) && !rb_scale_active_plane(1,1,0,0));
+    assert(rb_scale_active_plane(0,0,0,0) && rb_scale_active_plane(0,1,0,0));
+    assert(!rb_scale_active_plane(1,0,0,0) && rb_scale_active_plane(1,1,1,0));
+    assert(!rb_scale_active_plane(2,1,1,0)); assert(rb_scale_active_plane(3,1,0,0));
+    assert(rb_scale_active_plane(4,1,0,0)); assert(!rb_scale_active_plane(0,0,1,1));
+    puts("PASS resolution retention: exact producer reason, confirmed binding and concrete pass planes");
+}
