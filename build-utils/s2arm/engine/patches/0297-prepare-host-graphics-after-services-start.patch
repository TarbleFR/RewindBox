diff --git a/runtime/src/rb_guest.h b/runtime/src/rb_guest.h
--- a/runtime/src/rb_guest.h
+++ b/runtime/src/rb_guest.h
@@ -59,9 +59,16 @@
     //   s2a_rb_guest_stop; called once per park, on an engine thread. NULL = never park.
     void (*session_parked)(const char *reason, void *context);
     void *parked_context;
+    // Optional. Cold launch only, after services initialize and before the guest can run.
+    // Called on the engine host thread with ended_context. Nonzero reports startup failure.
+    int (*prepare_graphics)(void *context);
 } s2a_rb_guest_config;
 
-// First engine call after dlopen, once per process. 0 = configured; -1 = refused, error (may be NULL) holds the reason.
+// Size of the config understood by this framework. Hosts can check a trailing
+// optional field before relying on it.
+uint32_t s2a_rb_guest_config_size(void);
+
+// Configure after dlopen, once per process. 0 = configured; -1 = refused, error (may be NULL) holds the reason.
 int s2a_rb_guest_configure(const s2a_rb_guest_config *config, char *error, size_t error_size);
 
 // Main thread, after s2a_rb_guest_configure: S2Arm's game view controller as its scene delegate builds it after a game is chosen
diff --git a/runtime/src/rb_guest.c b/runtime/src/rb_guest.c
--- a/runtime/src/rb_guest.c
+++ b/runtime/src/rb_guest.c
@@ -61,6 +61,13 @@
 
 int s2a_rb_guest_on(void) { return atomic_load(&g_on); }
 int s2a_rb_guest_session_over(void) { return atomic_load(&g_ended); }
+// Configuration is immutable by the time the cold host worker starts. This
+// callback never runs under a session mutex or against a parked generation.
+int s2a_rb_guest_run_graphics_startup(int services_ready) {
+    if (!g_cfg.prepare_graphics) return 0;
+    if (!services_ready || s2a_rb_guest_session_over()) return -1;
+    return g_cfg.prepare_graphics(g_cfg.ended_context);
+}
 int s2a_rb_guest_ready(void) { return atomic_load(&g_ready); }
 void s2a_rb_guest_started(void) { atomic_store(&g_started, 1); }
 
@@ -70,6 +77,10 @@
     if (error && n) snprintf(error, n, "%s", b);
     LOG("【红】RewindBox guest: %s", b);
     return -1;
+}
+
+__attribute__((visibility("default"), used)) uint32_t s2a_rb_guest_config_size(void) {
+    return sizeof(s2a_rb_guest_config);
 }
 
 __attribute__((visibility("default"), used)) int s2a_rb_guest_configure(const s2a_rb_guest_config *c, char *error, size_t error_size) {
@@ -94,6 +105,8 @@
     }
     memset(&g_cfg, 0, sizeof g_cfg);
     memcpy(&g_cfg, c, c->size < sizeof g_cfg ? c->size : sizeof g_cfg);
+    if (c->size < offsetof(s2a_rb_guest_config, prepare_graphics) + sizeof g_cfg.prepare_graphics)
+        g_cfg.prepare_graphics = NULL;
     // From here the image pack opens without code signature registration and game code goes through prepare_code (imgpack.c)
     atomic_store(&g_on, 1);
     const char *why = s2a_launch_ctx_set_guest(c->game_id, c->images, c->module_dir, c->caps_dir, c->game_data, c->ryu_data, c->docs);
