 // Only base stages have a standalone reflection. The padded/specialized
 // variants remain owned by their parent shader and pipeline recipe.
 #include <dirent.h>
-static NSArray<NSString *> *rb_unlisted_stages(NSString *root, NSSet<NSString *> *covered, BOOL (^stopping)(void)) {
+// Orphans go first. A listed suffix also captures stages referenced only by
+// recipes that the PSO budget can reject before loading their shaders.
+static NSArray<NSString *> *rb_disk_stage_candidates(NSString *root, NSSet<NSString *> *covered,
+                                                    BOOL includeListed, NSUInteger *orphans,
+                                                    BOOL (^stopping)(void)) {
+    *orphans = 0;
     DIR *dir = opendir(root.fileSystemRepresentation);
     if (!dir) return @[];
     NSMutableArray<NSString *> *result = [NSMutableArray array];
+    NSMutableArray<NSString *> *listed = includeListed ? [NSMutableArray array] : nil;
     struct dirent *ent;
     while ((!stopping || !stopping()) && (ent=readdir(dir))) {
         const char *name = ent->d_name;
         if (strlen(name) != 23 || strcmp(name+16,"_b.json") || strspn(name,"0123456789abcdef") != 16) continue;
         NSString *key = [[NSString alloc] initWithBytes:name length:18 encoding:NSASCIIStringEncoding];
-        if ([covered containsObject:key]) continue;
+        BOOL inManifest = [covered containsObject:key];
+        if (inManifest && !includeListed) continue;
         struct stat st;
         if (fstatat(dirfd(dir),name,&st,AT_SYMLINK_NOFOLLOW) || !S_ISREG(st.st_mode)) continue;
-        [result addObject:key];
+        if (inManifest) [listed addObject:key];
+        else [result addObject:key];
     }
     closedir(dir);
     [result sortUsingSelector:@selector(compare:)];
+    *orphans = result.count;
+    if (listed.count) {
+        [listed sortUsingSelector:@selector(compare:)];
+        [result addObjectsFromArray:listed];
+    }
     return result;
 }
