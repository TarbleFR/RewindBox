diff --git a/graphics/nvn/gfx/nvn/rb_audit_sample.h b/graphics/nvn/gfx/nvn/rb_audit_sample.h
new file mode 100644
index 0000000..6d34f7b
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_audit_sample.h
@@ -0,0 +1,22 @@
+// RewindBox (patch 0322): in which frames the passive audit probes P1-20 / P1-65 run (nvn_mtl.m p20_check, p65_count; audit #1534). Pure C: tests/t_rb_audit_sample.c.
+//   IPA 827 (Mario Kart World, iPhone A18 Pro, in a race): P1-20 compared 4,427 to 9,955 texture bindings a frame (4.4 to 5.7 per draw) and P1-65 counted 1,313 to 2,699
+//   bounds tables a frame (1.28 to 1.43 per draw), on the submit thread, whose instructions bound the frame rate once the device is at Fair; neither probe counted a
+//   hit in the 48 lines of the two sessions (the bounds table is capped since audit #1646, so P1-65 cannot count one any more).
+//   Rule: the probes run in every frame of the first RB_AUDIT_PERIOD (a session's first shaders, and the tests, are probed as before), then in the last RB_AUDIT_LIVE
+//   frames of every RB_AUDIT_PERIOD: the frames just before the audit line, which is written every 300 frames. The line states the sampling and the number of frames
+//   probed, so a count divided by the frames probed is still a per-frame rate. S2A_RB_AUDIT_SAMPLE=0: as before, every binding of every frame.
+#pragma once
+#include <stdint.h>
+
+enum { RB_AUDIT_PERIOD = 300, RB_AUDIT_LIVE = 4 };
+// 1 = the probes run in frame `frame`. sample: the switch (0 = every frame, as before)
+static inline int rb_audit_live(uint64_t frame, int sample) {
+    if (!sample) return 1;
+    return frame < RB_AUDIT_PERIOD || frame % RB_AUDIT_PERIOD >= RB_AUDIT_PERIOD - RB_AUDIT_LIVE;
+}
+// The frames probed so far, each counted once however many submissions it has (the audit line's "probed in N frames")
+typedef struct { uint64_t frames, last; int any; } rb_audit_frames;
+static inline void rb_audit_frame(rb_audit_frames *c, uint64_t frame) {
+    if (c->any && c->last == frame) return;
+    c->any = 1; c->last = frame; c->frames++;
+}
diff --git a/graphics/nvn/tests/t_rb_audit_sample.c b/graphics/nvn/tests/t_rb_audit_sample.c
new file mode 100644
index 0000000..8183699
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_audit_sample.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0322): host-only checks of the frames in which the passive audit probes run (gfx/nvn/rb_audit_sample.h).
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../gfx/nvn/rb_audit_sample.h"
+
+int main(void) {
+    // ① the switch at 0: every frame, as before
+    for (uint64_t f = 0; f < 3000; f++) assert(rb_audit_live(f, 0) == 1);
+    assert(rb_audit_live(UINT64_MAX, 0) == 1);
+    // ② sampled: all of the first 300 frames (frame 0 is where the engine's own probe test encodes)
+    for (uint64_t f = 0; f < RB_AUDIT_PERIOD; f++) assert(rb_audit_live(f, 1) == 1);
+    // ③ after them: exactly the last 4 frames of each 300, and never the frame the line is written in
+    for (uint64_t w = 1; w < 40; w++) {
+        int n = 0;
+        for (uint64_t f = w * RB_AUDIT_PERIOD; f < (w + 1) * RB_AUDIT_PERIOD; f++) {
+            int live = rb_audit_live(f, 1);
+            assert(live == (f % RB_AUDIT_PERIOD >= 296));
+            n += live;
+        }
+        assert(n == RB_AUDIT_LIVE);
+        assert(!rb_audit_live(w * RB_AUDIT_PERIOD, 1));            // 300, 600, …: not probed
+        assert(!rb_audit_live(w * RB_AUDIT_PERIOD + 295, 1));      // the frame before the sampled ones: not probed
+        assert(rb_audit_live(w * RB_AUDIT_PERIOD + 296, 1));
+        assert(rb_audit_live((w + 1) * RB_AUDIT_PERIOD - 1, 1));   // the frame just before the next line
+    }
+    // … any 300 consecutive frames past the first 300 hold exactly 4 probed ones
+    for (uint64_t s = RB_AUDIT_PERIOD; s < 5 * RB_AUDIT_PERIOD; s += 37) {
+        int n = 0;
+        for (uint64_t f = s; f < s + RB_AUDIT_PERIOD; f++) n += rb_audit_live(f, 1);
+        assert(n == RB_AUDIT_LIVE);
+    }
+    // ④ a frame far into a session, and any non-zero switch value reads as on
+    assert(!rb_audit_live(1000000, 1) && rb_audit_live(1000000 + 296 - 1000000 % 300, 1));
+    assert(!rb_audit_live(450, 2) && rb_audit_live(598, 2));
+    // ⑤ the frames probed: each counted once, whatever the number of submissions; a session that starts again at frame 0 counts on
+    rb_audit_frames c = {0, 0, 0};
+    rb_audit_frame(&c, 0); rb_audit_frame(&c, 0); rb_audit_frame(&c, 0);
+    assert(c.frames == 1);
+    rb_audit_frame(&c, 1); rb_audit_frame(&c, 1); rb_audit_frame(&c, 2);
+    assert(c.frames == 3);
+    rb_audit_frame(&c, 0);
+    assert(c.frames == 4 && c.last == 0);
+    // … driven as the engine does (a look per submission, three submissions a frame): 300 + 4 per later window
+    rb_audit_frames d = {0, 0, 0};
+    for (uint64_t f = 0; f < 10 * RB_AUDIT_PERIOD; f++) for (int sub = 0; sub < 3; sub++) if (rb_audit_live(f, 1)) rb_audit_frame(&d, f);
+    assert(d.frames == RB_AUDIT_PERIOD + 9 * RB_AUDIT_LIVE);
+    puts("t_rb_audit_sample: ok");
+    return 0;
+}
