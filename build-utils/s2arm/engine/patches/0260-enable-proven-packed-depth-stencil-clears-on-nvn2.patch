diff --git a/graphics/nvn/tests/rb_test_tile_platform.h b/graphics/nvn/tests/rb_test_tile_platform.h
new file mode 100644
index 0000000..7d0f975
--- /dev/null
+++ b/graphics/nvn/tests/rb_test_tile_platform.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// The host links the real NPDM reader. Use the same platform fixture shape
+// as t_vawin_container and check both its title and its platform decision.
+extern uint64_t s2a_npdm_pid(const char *);
+static void load_test_platform(void) {
+    uint8_t metadata[0x404] = {0};
+    const uint32_t aci = 0x80, acid = 0x100;
+    const uint64_t title = UINT64_C(0x0400C3F00006E000);
+    memcpy(metadata, "META", 4);
+    memcpy(metadata + 0x70, &aci, sizeof aci);
+    memcpy(metadata + 0x78, &acid, sizeof acid);
+    memcpy(metadata + aci, "ACI0", 4);
+    memcpy(metadata + aci + 0x10, &title, sizeof title);
+    memcpy(metadata + acid + 0x300, "ACID", 4);
+    char path[] = "/tmp/t_rb_tile_platform.XXXXXX";
+    int fd = mkstemp(path);
+    RB_PLATFORM_CHECK(fd >= 0);
+    RB_PLATFORM_CHECK(write(fd, metadata, sizeof metadata) == (ssize_t)sizeof metadata);
+    RB_PLATFORM_CHECK(close(fd) == 0);
+    uint64_t observed = s2a_npdm_pid(path);
+    RB_PLATFORM_CHECK(unlink(path) == 0);
+    RB_PLATFORM_CHECK(observed == title && nvn2_on());
+}
