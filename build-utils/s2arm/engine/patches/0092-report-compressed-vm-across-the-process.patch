+// RewindBox (patch 0092): in IPA 781 the old walk showed 173–179 MiB compressed during play while
+// TASK_VM_INFO reported about 1 GiB. Visit the top-level map on both sides of the shared cache and
+// inside the guest window. These are per-mapping VM counts (aliases can overlap), not a footprint.
+void s2a_rb_mem_tags_wide(char *out, size_t cap) {
+    enum { RB_VM_TAGS = 256, RB_VM_REGIONS = 8192, RB_VM_MS = 25 };
+    const uint64_t guest_start = g_ok ? g_base : 0, guest_end = guest_start ? guest_start + g_size : 0;
+    const uint64_t page_bytes = (uint64_t)vm_page_size;
+    const uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    uint64_t host[RB_VM_TAGS] = {0}, guest[RB_VM_TAGS] = {0};
+    uint64_t h_file = 0, g_file = 0, crossing = 0;
+    unsigned regions = 0, skipped = 0;
+    const char *status = "region-limit";
+    vm_address_t cursor = 0;
+    for (; regions < RB_VM_REGIONS; regions++) {
+        if (!(regions % 64) && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start >= RB_VM_MS * 1000000ull) {
+            status = "time-limit";
+            break;
+        }
+        vm_address_t address = cursor;
+        vm_size_t size = 0;
+        natural_t depth = 0;
+        vm_region_submap_info_data_64_t info;
+        mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+        kern_return_t result = vm_region_recurse_64(mach_task_self(), &address, &size, &depth,
+                                                   (vm_region_recurse_info_t)&info, &count);
+        if (result != KERN_SUCCESS || !size || address + size <= cursor) {
+            status = result == KERN_INVALID_ADDRESS ? "complete" : "interrupted";
+            break;
+        }
+        vm_address_t next = address + size;
+        if (address < cursor || info.is_submap || info.user_tag == 32) {
+            skipped++;
+        } else {
+            uint64_t compressed = info.pages_swapped_out;
+            unsigned tag = info.user_tag < RB_VM_TAGS ? info.user_tag : 0;
+            if (address >= guest_end || next <= guest_start) {
+                if (info.external_pager) h_file += compressed;
+                else host[tag] += compressed;
+            } else if (address >= guest_start && next <= guest_end) {
+                if (info.external_pager) g_file += compressed;
+                else guest[tag] += compressed;
+            } else {
+                crossing += compressed;
+            }
+        }
+        cursor = next;
+    }
+    uint64_t h_anon = 0, g_anon = 0;
+    for (unsigned i = 0; i < RB_VM_TAGS; i++) { h_anon += host[i]; g_anon += guest[i]; }
+    int used = snprintf(out, cap, "%s, %u regions (%u skipped); compressed mapping MiB: outside window anon %llu / file %llu, "
+                        "inside window anon %llu / file %llu, straddling %llu",
+                        status, regions, skipped, (unsigned long long)(h_anon * page_bytes >> 20),
+                        (unsigned long long)(h_file * page_bytes >> 20), (unsigned long long)(g_anon * page_bytes >> 20),
+                        (unsigned long long)(g_file * page_bytes >> 20), (unsigned long long)(crossing * page_bytes >> 20));
+    for (int side = 0; side < 2; side++) {
+        uint64_t *tags = side ? guest : host;
+        for (int rank = 0; rank < 6 && used > 0 && (size_t)used < cap; rank++) {
+            unsigned largest = 0;
+            for (unsigned i = 1; i < RB_VM_TAGS; i++) if (tags[i] > tags[largest]) largest = i;
+            if (!tags[largest]) break;
+            used += snprintf(out + used, cap - (size_t)used, "; %s tag %u %llu MiB", side ? "inside" : "outside", largest,
+                             (unsigned long long)(tags[largest] * page_bytes >> 20));
+            tags[largest] = 0;
+        }
+    }
+}
