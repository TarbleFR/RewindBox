+    assert(!rb_display_tick(&phase, 30, 1.532));
+    assert(rb_display_tick(&phase, 30, 1.5492));
+    assert(rb_display_tick(&phase, 60, 1.566));
+    // 2 old 60 Hz ticks becomes one physical 30 Hz callback while waiting.
+    assert(rb_display_wait_ready(11, 10, 2, 1+1.0/30, 1, 1.0/30));
+    assert(!rb_display_wait_ready(11, 10, 1, 1+1.0/60, 1, 1.0/30));
+    assert(rb_display_wait_ready(12, 10, 1, 1+2.0/60, 1, 1.0/30));
+    assert(!rb_display_wait_ready(10, 10, 1, 2, 1, 1.0/60));
+    assert(!rb_display_wait_ready(11, 10, 2, 0, 0, 1.0/30));
+    assert(rb_display_wait_ready(12, 10, 2, 0, 0, 1.0/30));
+    rb_present_samples first = {0}, second = {0};
+    for (unsigned n = 1; n <= 24; n++) {
+        unsigned index = n % RB_PRESENT_HISTORY;
+        first.tickets[index] = 400 + 2*n;
+        first.holds[index] = n == 13 ? 2 : 1;
+        second.tickets[index] = first.tickets[index]+1;
+        second.holds[index] = 2;
+        if (n < 10) continue;
+        unsigned seen = n-8;
+        assert(first.tickets[seen % RB_PRESENT_HISTORY] == 400 + 2*seen);
+        assert(second.tickets[(seen-1) % RB_PRESENT_HISTORY] == 401 + 2*(seen-1));
+        assert(rb_shown_hold(&first, seen) == (seen == 13 || seen == 14 ? 2u : 1u));
+        assert(rb_shown_hold(&second, seen) == 2);
+    }
+    _Atomic int cached = 0;
+    setenv("S2A_RB_DIRECT_GAME_ID","04007EF01F8AE000",1);
+    unsetenv("S2A_RB_PROMOTION_PACING");
+    assert(rb_direct_option(&cached,"S2A_RB_PROMOTION_PACING"));
+    setenv("S2A_RB_PROMOTION_PACING","0",1); cached = 0;
+    assert(!rb_direct_option(&cached,"S2A_RB_PROMOTION_PACING"));
+    setenv("S2A_RB_DIRECT_GAME_ID","other",1);
+    setenv("S2A_RB_PROMOTION_PACING","1",1); cached = 0;
+    assert(!rb_direct_option(&cached,"S2A_RB_PROMOTION_PACING"));
+    puts("ProMotion effective period, callback phase, missing refreshes, transitions and title scope: passed");
+}
