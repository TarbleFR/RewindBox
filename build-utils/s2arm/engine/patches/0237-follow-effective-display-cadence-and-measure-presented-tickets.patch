diff --git a/graphics/nvn/gfx/nvn/rb_promotion.h b/graphics/nvn/gfx/nvn/rb_promotion.h
new file mode 100644
index 0000000..4361f0b
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_promotion.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <math.h>
+#include <stdint.h>
+
+// The effective period already includes the guest interval, simulation policy and FPS cap.
+static inline int rb_promotion_mode(double period) {
+    if (fabs(period * 60 - 1) < 1e-6) return 1;
+    if (fabs(period * 30 - 1) < 1e-6) return 3;
+    return 0;
+}
+
+typedef struct { double next; int hz; } rb_display_phase;
+
+// The range is a request. If CA supplies 120 targets/s while a 60/30 request
+// settles, count only the appropriate targets, before waking the guest. A late
+// update never emits catch-up ticks. A rate switch starts a new phase.
+static inline int rb_display_tick(rb_display_phase *phase, int hz, double target) {
+    if (!hz || !(target > 0) || !isfinite(target)) {
+        *phase = (rb_display_phase){0};
+        return 1;
+    }
+    double period = 1.0 / hz;
+    if (phase->hz != hz || target > phase->next + period * 0.25) {
+        phase->hz = hz;
+        phase->next = target + period;
+        return 1;
+    }
+    if (target < phase->next - 0.001) return 0;
+    phase->next += period;
+    return 1;
+}
+
+// A rate change may happen while AcquireTexture is asleep. Account for the
+// actual difference between accepted display targets across that transition.
+static inline int rb_display_wait_ready(uint64_t tick, uint64_t previous_tick, uint64_t step,
+                                        double target, double previous_target, double period) {
+    if (tick <= previous_tick) return 0;
+    if (target > 0 && previous_target > 0 && target >= previous_target)
+        return target - previous_target >= period - 0.001;
+    return tick - previous_tick >= step;
+}
+
+// The delayed observer needs the current window ordinal minus eight and nine.
+// Retain the actual global backend ticket, effective hold and frame step.
+enum { RB_PRESENT_HISTORY = 10 };
+typedef struct {
+    uint64_t tickets[RB_PRESENT_HISTORY];
+    uint8_t holds[RB_PRESENT_HISTORY], steps[RB_PRESENT_HISTORY];
+} rb_present_samples;
+
+static inline unsigned rb_shown_hold(const rb_present_samples *samples, uint64_t ordinal) {
+    unsigned current = samples->holds[ordinal % RB_PRESENT_HISTORY];
+    unsigned previous = samples->holds[(ordinal - 1) % RB_PRESENT_HISTORY];
+    return current > previous ? current : previous;
+}
