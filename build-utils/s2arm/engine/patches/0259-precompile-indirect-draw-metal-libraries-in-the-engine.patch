diff --git a/graphics/tools/direct/build_indirect_libraries.sh b/graphics/tools/direct/build_indirect_libraries.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1db26e6c1518f0a03601364fd9d28b3747391318
--- /dev/null
+++ b/graphics/tools/direct/build_indirect_libraries.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Build four independent libraries. The two draw-count layouts share an entry name.
+set -eu
+destination=$1
+minimum=$2
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+xcrun --sdk macosx clang -std=c11 -Wall -Wextra -Werror \
+    "$(dirname "$0")/export_indirect_sources.c" -o "$work/export"
+(cd "$work" && ./export)
+mkdir -p "$destination"
+for source in "$work"/*.metal; do
+    name=$(basename "$source" .metal)
+    xcrun --sdk iphoneos metal "-mios-version-min=$minimum" -c "$source" -o "$work/$name.air"
+    xcrun --sdk iphoneos metallib "$work/$name.air" -o "$destination/$name.metallib"
+done
diff --git a/graphics/tools/direct/export_indirect_sources.c b/graphics/tools/direct/export_indirect_sources.c
new file mode 100644
index 0000000000000000000000000000000000000000..ddc66b20fda3dfe4d47e59a50a16c5168c41b2d3
--- /dev/null
+++ b/graphics/tools/direct/export_indirect_sources.c
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+// Run in a temporary build directory to export the exact built-in fallback MSL.
+#include <stdio.h>
+#include "../../nvn/gfx/nvn/rb_indirect_sources.h"
+
+int main(void) {
+    for (unsigned i = 0; i < RB_INDIRECT_SHADER_COUNT; ++i) {
+        char path[64];
+        int length = snprintf(path, sizeof(path), "%s.metal", rb_indirect_sources[i].name);
+        if (length < 0 || (size_t)length >= sizeof(path)) return 1;
+        FILE *out = fopen(path, "wb");
+        if (!out) { perror(path); return 1; }
+        int result = fputs(rb_indirect_sources[i].source, out);
+        if (fclose(out) || result == EOF) { perror(path); return 1; }
+    }
+    return 0;
+}
