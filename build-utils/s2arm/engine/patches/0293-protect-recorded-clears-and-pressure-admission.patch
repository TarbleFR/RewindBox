+// The recorded encoder is a proxy. Resolve the omitted initialization where
+// Metal actually creates the encoder, on the same command buffer and queue.
+static id rec_begin_render(id cb, id descriptor, id<MTLTexture> pending, int classic) {
+    id encoder = [(id<MTL4CommandBuffer>)cb renderCommandEncoderWithDescriptor:descriptor];
+    if (encoder || !pending) return encoder;
+    id d = classic ? (id)[MTLRenderPassDescriptor new] : (id)[MTL4RenderPassDescriptor new];
+    MTLRenderPassColorAttachmentDescriptor *color = [(MTL4RenderPassDescriptor *)d colorAttachments][0];
+    color.texture = pending;
+    color.loadAction = MTLLoadActionClear;
+    color.clearColor = MTLClearColorMake(0.,0.,0.,0.);
+    color.storeAction = MTLStoreActionStore;
+    id fallback = [(id<MTL4CommandBuffer>)cb renderCommandEncoderWithDescriptor:d];
+    if (!fallback) {
+        mtl_gpu_halt("could not initialize a new attachment after its render encoder failed");
+        return nil;
+    }
+    if (!classic) {
+        [(id<MTL4CommandEncoder>)fallback barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageAll visibilityOptions:MTL4VisibilityOptionDevice];
+        [(id<MTL4CommandEncoder>)fallback barrierAfterStages:MTLStageAll beforeQueueStages:MTLStageAll visibilityOptions:MTL4VisibilityOptionDevice];
+    }
+    [fallback endEncoding];
+    return nil;
+}
