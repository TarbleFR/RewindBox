+// Force the real replay-time failure once, then delegate the recovery pass
+// to a tracked Metal command buffer and inspect the actual pixel.
+@interface RbFailFirstPass : NSObject { @public id<MTLCommandBuffer> cb; unsigned calls; } @end
+@implementation RbFailFirstPass
+- (id)renderCommandEncoderWithDescriptor:(MTLRenderPassDescriptor *)d {
+    ++calls;
+    return calls==1 ? nil : [cb renderCommandEncoderWithDescriptor:d];
+}
+@end
+static void recorded_zero_failure(id<MTLDevice> device) {
+    MTLTextureDescriptor *desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR32Float
+        width:1 height:1 mipmapped:NO];
+    desc.storageMode = MTLStorageModeShared; desc.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> t = [device newTextureWithDescriptor:desc]; CHECK(t);
+    float pixel=4.f;
+    [t replaceRegion:MTLRegionMake2D(0,0,1,1) mipmapLevel:0 withBytes:&pixel bytesPerRow:4];
+    RbFailFirstPass *proxy = [RbFailFirstPass new];
+    id<MTLCommandQueue> queue = [device newCommandQueue]; proxy->cb = [queue commandBuffer];
+    CHECK(!rec_begin_render(proxy,[MTLRenderPassDescriptor new],t,1) && proxy->calls==2);
+    [proxy->cb commit]; [proxy->cb waitUntilCompleted]; CHECK(proxy->cb.status==MTLCommandBufferStatusCompleted);
+    [t getBytes:&pixel bytesPerRow:4 fromRegion:MTLRegionMake2D(0,0,1,1) mipmapLevel:0];
+    CHECK(pixel==0.f);
+    puts("PASS recorded first clear: failed real encoder restored zero on the GPU");
+}
