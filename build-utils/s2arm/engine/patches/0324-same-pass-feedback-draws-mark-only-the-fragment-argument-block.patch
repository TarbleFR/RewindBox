diff --git a/graphics/nvn/gfx/nvn/rb_fb_dirty.h b/graphics/nvn/gfx/nvn/rb_fb_dirty.h
new file mode 100644
index 0000000..21af572
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_fb_dirty.h
@@ -0,0 +1,30 @@
+// RewindBox (patch 0324): which argument blocks a draw that samples an attachment of its own pass must rebuild (nvn_mtl.m fb_prepare). Pure C: tests/t_rb_fb_dirty.c.
+//   Such a draw reads a copy or a narrowed view instead of the attachment: fb_prepare registers the substitution (the texture bound, the texture read instead and its
+//   resource ID) and encode_args applies it to the texture bindings of the fragment stage alone (nvn_stage == 1). Until now the draw marked every stage's block for a
+//   full rebuild, and the draw after it marked every stage again, to go back to the bindings as bound. IPA 827 (Mario Kart World, iPhone A18 Pro, in a race): 97 to
+//   169 draws a frame read such a substitution (second.log; 91 to 210 in first.log), almost all of them the same depth copy as the draw before, 4 to 8 new copies a
+//   frame; each one rebuilt its vertex and its fragment block in full, and so did the draw after each run.
+//   Rule: a block built under one substitution is the block for any later draw of the same pass with the same substitution, so only a change of substitution (one
+//   begins, ends, or names another texture, copy or resource ID, or the same ones in another order) marks a block, and only the fragment stage's. A new copy ends
+//   the pass, which rebuilds every block anyway. S2A_RB_FB_DIRTY_NARROW=0: as before (every stage, at each such draw and at the draw after it).
+#pragma once
+#include <stdint.h>
+
+enum { RB_FB_SUBST_MAX = 4,              // nvn_mtl.m g_fb_src / g_fb_use / g_fb_rid
+       RB_FB_ALL_STAGES = 0x3f,          // the six entries of g_args_dirty
+       RB_FB_FRAGMENT_STAGE = 1 << 1 };  // nvn_stage 1
+// A draw's substitution: n pairs in the order fb_prepare registered them; n == 0: the draw reads its bindings as bound
+typedef struct { int n; const void *src[RB_FB_SUBST_MAX], *use[RB_FB_SUBST_MAX]; uint64_t rid[RB_FB_SUBST_MAX]; } rb_fb_subst;
+
+static inline int rb_fb_subst_same(const rb_fb_subst *a, const rb_fb_subst *b) {
+    if (a->n != b->n) return 0;
+    for (int q = 0; q < a->n && q < RB_FB_SUBST_MAX; q++)   // the entries past n are not part of the substitution
+        if (a->src[q] != b->src[q] || a->use[q] != b->use[q] || a->rid[q] != b->rid[q]) return 0;
+    return 1;
+}
+// The stages (bit s = nvn_stage s) whose block must be rebuilt before this draw, given the substitution of the draw before (prev) and this draw's (cur).
+//   narrow 0: the rule before the patch, every stage when either draw substitutes. narrow 1: the fragment stage, when the two differ
+static inline unsigned rb_fb_dirty_mask(int narrow, const rb_fb_subst *prev, const rb_fb_subst *cur) {
+    if (!narrow) return prev->n || cur->n ? RB_FB_ALL_STAGES : 0;
+    return rb_fb_subst_same(prev, cur) ? 0 : RB_FB_FRAGMENT_STAGE;
+}
diff --git a/graphics/nvn/tests/t_rb_fb_dirty.c b/graphics/nvn/tests/t_rb_fb_dirty.c
new file mode 100644
index 0000000..679498b
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_fb_dirty.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0324): host-only checks of which argument blocks a draw sampling its own pass's attachment marks (gfx/nvn/rb_fb_dirty.h).
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "../gfx/nvn/rb_fb_dirty.h"
+
+static int tex_a, tex_b, copy_1, copy_2, copy_3;   // addresses stand for Metal textures
+static rb_fb_subst none(void) { rb_fb_subst s; memset(&s, 0, sizeof s); return s; }
+static rb_fb_subst one(const void *src, const void *use, uint64_t rid) { rb_fb_subst s = none(); s.n = 1; s.src[0] = src; s.use[0] = use; s.rid[0] = rid; return s; }
+static rb_fb_subst two(rb_fb_subst a, rb_fb_subst b) { rb_fb_subst s = a; s.n = 2; s.src[1] = b.src[0]; s.use[1] = b.use[0]; s.rid[1] = b.rid[0]; return s; }
+
+static uint32_t rnd_state = 0x0324u;
+static uint32_t rnd(void) { rnd_state = rnd_state * 1664525u + 1013904223u; return rnd_state >> 8; }
+
+int main(void) {
+    const rb_fb_subst N = none(), A = one(&tex_a, &copy_1, 11), A2 = one(&tex_a, &copy_1, 11);
+    const unsigned F = RB_FB_FRAGMENT_STAGE, ALL = RB_FB_ALL_STAGES;
+    // ① the narrow rule's table
+    assert(rb_fb_dirty_mask(1, &N, &N) == 0);        // no substitution before or now: nothing (the usual draw)
+    assert(rb_fb_dirty_mask(1, &N, &A) == F);        // one begins: the fragment block, to read the copy
+    assert(rb_fb_dirty_mask(1, &A, &A2) == 0);       // the same copy as the draw before (a run of halo draws): nothing
+    assert(rb_fb_dirty_mask(1, &A, &N) == F);        // it ends: the fragment block, back to the bindings as bound
+    { rb_fb_subst r = one(&tex_a, &copy_1, 12); assert(rb_fb_dirty_mask(1, &A, &r) == F); }    // another resource ID
+    { rb_fb_subst u = one(&tex_a, &copy_2, 11); assert(rb_fb_dirty_mask(1, &A, &u) == F); }    // another copy
+    { rb_fb_subst s = one(&tex_b, &copy_1, 11); assert(rb_fb_dirty_mask(1, &A, &s) == F); }    // another texture substituted
+    { rb_fb_subst B = one(&tex_b, &copy_2, 22), AB = two(A, B), BA = two(B, A), AB2 = two(A2, B);
+      assert(rb_fb_dirty_mask(1, &AB, &AB2) == 0);   // two pairs, the same
+      assert(rb_fb_dirty_mask(1, &AB, &BA) == F);    // the same pairs in another order: marked (the walk takes the first match)
+      assert(rb_fb_dirty_mask(1, &AB, &A) == F && rb_fb_dirty_mask(1, &A, &AB) == F);   // a prefix is another substitution
+      rb_fb_subst junk = A; junk.src[1] = &tex_b; junk.use[1] = &copy_3; junk.rid[1] = 99; junk.src[3] = &tex_a;
+      assert(rb_fb_dirty_mask(1, &A, &junk) == 0); } // entries past n do not count (g_fb_use keeps old views there)
+    // … never another stage than the fragment's
+    assert((rb_fb_dirty_mask(1, &N, &A) & ~F) == 0 && (rb_fb_dirty_mask(1, &A, &N) & ~F) == 0);
+    // ② the switch at 0: the rule before the patch, every stage whenever either draw substitutes
+    assert(rb_fb_dirty_mask(0, &N, &N) == 0);
+    assert(rb_fb_dirty_mask(0, &N, &A) == ALL && rb_fb_dirty_mask(0, &A, &A2) == ALL && rb_fb_dirty_mask(0, &A, &N) == ALL);
+    // ③ the narrow rule never marks where the old one did not, for any pair
+    { rb_fb_subst v[6] = {N, A, one(&tex_a, &copy_2, 12), one(&tex_b, &copy_3, 33), two(A, one(&tex_b, &copy_3, 33)), two(one(&tex_b, &copy_3, 33), A)};
+      for (int i = 0; i < 6; i++) for (int j = 0; j < 6; j++) {
+          unsigned n = rb_fb_dirty_mask(1, &v[i], &v[j]), o = rb_fb_dirty_mask(0, &v[i], &v[j]);
+          assert((n & ~o) == 0);
+          assert((n != 0) == (i != j));
+      } }
+    // ④ a replay of the engine's bookkeeping over random draws: with either rule a fragment block that is reused was built under the substitution of the draw that
+    //   reuses it (the old rule's guarantee, kept), and the narrow rule rebuilds no more often than the old one. Events: a draw (its substitution drawn from six,
+    //   repeated in runs), a draw skipped after fb_prepare (no encode: the mark must survive), another change that marks the stage, a new pass
+    { rb_fb_subst v[6] = {N, A, one(&tex_a, &copy_2, 12), one(&tex_b, &copy_3, 33), two(A, one(&tex_b, &copy_3, 33)), N};
+      rb_fb_subst prev = N, built_new = N, built_old = N;
+      int dirty_new = 1, dirty_old = 1, rebind = 0, cur = 0;
+      unsigned long rebuilt_new = 0, rebuilt_old = 0, reused_new = 0, reused_old = 0;
+      for (int step = 0; step < 400000; step++) {
+          unsigned e = rnd() % 100;
+          if (e < 4) { dirty_new = dirty_old = 1; continue; }              // a texture bind, a program change, a new pass…: both rules rebuild
+          if (rnd() % 4 == 0) cur = (int)(rnd() % 6);                      // else the same substitution as the draw before (runs)
+          const rb_fb_subst *s = &v[cur];
+          // fb_prepare, old rule (nvn_mtl.m as it was): the draw after a substituting one marks, and a substituting one marks
+          if (rebind) { dirty_old = 1; rebind = 0; }
+          if (s->n) { dirty_old = 1; rebind = 1; }
+          // fb_prepare, narrow rule
+          if (rb_fb_dirty_mask(1, &prev, s) & RB_FB_FRAGMENT_STAGE) dirty_new = 1;
+          prev = *s;
+          if (e < 12) continue;                                            // the draw returns before encoding (empty scissor, pipeline not ready)
+          // encode_args, fragment stage
+          if (dirty_old) { built_old = *s; dirty_old = 0; rebuilt_old++; } else { assert(rb_fb_subst_same(&built_old, s)); reused_old++; }
+          if (dirty_new) { built_new = *s; dirty_new = 0; rebuilt_new++; } else { assert(rb_fb_subst_same(&built_new, s)); reused_new++; }
+          assert(rb_fb_subst_same(&built_new, &built_old));                // both rules hand the GPU a block built for this draw's substitution
+      }
+      assert(rebuilt_new <= rebuilt_old && reused_new >= reused_old && reused_old > 0 && rebuilt_new > 0);
+      assert(reused_new > 2 * reused_old); }                               // and the narrow rule does reuse through runs of the same substitution
+    puts("t_rb_fb_dirty: ok");
+    return 0;
+}
