+    if (rb_fb_dirty_mask(1, &g_rb_fb_prev, &cur) & RB_FB_FRAGMENT_STAGE) { g_args_dirty[1] = 1; g_rb_fb_marks++; }
+    else if (cur.n) g_rb_fb_same++;
+    g_rb_fb_prev = cur;
 }
