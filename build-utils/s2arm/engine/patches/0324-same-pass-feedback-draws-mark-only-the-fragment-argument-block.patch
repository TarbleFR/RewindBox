+}
+// RewindBox (patch 0324): after the body, on each of its ways out (its three early returns register nothing: g_fb_n is 0 there): this draw's substitution, as
+//   encode_args will apply it (g_fb_n entries when g_fb_seq is this draw's), against the previous draw's. Different: the fragment stage's block is rebuilt (the mark
+//   stays until an encode consumes it, so a draw that returns before encoding loses nothing). The same: nothing is marked; whatever else changed has marked its own
+//   stage. S2A_RB_FB_DIRTY_NARROW=0: the body marked every stage as before, nothing here
+static void fb_prepare(NvProg *pr) {
+    fb_prepare_(pr);
+    if (!rb_fb_dirty_narrow_on()) return;
+    rb_fb_subst cur; memset(&cur, 0, sizeof cur);
+    if (g_fb_n && g_fb_seq == g_draw_seq) {
+        cur.n = g_fb_n < RB_FB_SUBST_MAX ? g_fb_n : RB_FB_SUBST_MAX;
+        for (int q = 0; q < cur.n; q++) { cur.src[q] = (__bridge const void *)g_fb_src[q]; cur.use[q] = (__bridge const void *)g_fb_use[q]; cur.rid[q] = g_fb_rid[q]; }
