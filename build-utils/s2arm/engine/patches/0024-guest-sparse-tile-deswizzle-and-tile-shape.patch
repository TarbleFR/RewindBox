+// RewindBox (patch 0024): the tiles of a sparse texture as this file lays it out (level_walk), for nvn_mtl.m's placement sparse textures (later patches), which map and
+//   decode each tile as 64 KB of storage of its own (nvn_deswizzle_tile) and the levels from the first untiled one as the mip tail.
+//   Ported (MIT, Copyright (c) 2026 seedds) from seedds/nxnative 933b6759 and f24e6b80 (dm/gfx/nvn/nvn_tex.c:207-223 at 0c078130), over this file's layout: upstream's
+//   nvn_tex.c is not taken (its packaged layout, MINIMAL_LAYOUT and LINEAR_RENDER_TARGET rules would change storage sizes in other games).
+//   S2Arm adaptations: level_walk shapes the tile with the layout's own block height (it has no tile_shape_h), and tiles nothing when the public query above has no
+//   tiled level (sparse_levels); and the answer is 0, with no tile, when the layout's tiles are not that query's, which the game reads (nvnTextureGetSparseTileLayout,
+//   patch 0012) and maps its tiles by. A size check cannot see a 64 KB tile of another shape (a packaged block height other than the query's page height) or a level the
+//   two count differently (the query halves texels, the layout counts blocks): the game's mapped pages would not be the layout's tiles. Such a texture stays whole; a
+//   caller that sees nvn_tex_sparse_layout's tile[0] != 0 and 0 here for a texture without LINEAR_RENDER_TARGET (0x40) logs the disagreement. With 0x40 it is no
+//   disagreement: the query (sparse_page tests 0x32 only, patch 0012, unchanged) reports tiles for SPARSE | LINEAR_RENDER_TARGET, which this file lays out linear (sparse_of)
+int nvn_tex_sparse_tiles(const nvn_texdesc *d, uint32_t *tw, uint32_t *th, uint32_t *td) {
+    fmt_t t = fmt_of(d->format);
+    unsigned dpl; int layered; uint32_t w, h, z;
+    shape(d, &dpl, &layered, &w, &h, &z);
+    *tw = *th = *td = 0;
+    uint32_t q[4]; nvn_tex_sparse_layout(d, q);   // S2Arm: the public query's answer
+    if (!sparse_of(d) || !t.bpb || !q[0]) return 0;   // S2Arm: laid out linear (0x40 too, which the query tiles), or no tiled level in the query, so none in level_walk (sparse_levels)
+    uint32_t sx, sy; samples_xy(d->samples, &sx, &sy);
+    nvn_texlayout L; nvn_tex_layout(d, &L);
+    uint32_t gw = 128u >> (L.tileH + L.tileD); if (!gw) gw = 1;   // GOB columns of a tile, as level_walk (S2Arm: the layout's block height)
+    uint32_t lw = gw * 64 / t.bpb * t.bw / sx, lh = dpl >= 2 ? (8u << L.tileH) * t.bh / sy : 1, ld = dpl >= 3 ? 1u << L.tileD : 1;
+    unsigned levels = d->levels ? d->levels : 1, n = 0;
+    for (; n < levels; n++) {   // the same test as level_walk's: a level at least one tile wide, high and deep
+        uint32_t lwb = blk(mip(w * sx, n), t.bw) * t.bpb, nh = dpl >= 2 ? blk(mip(h * sy, n), t.bh) : 1, nd = dpl >= 3 ? mip(z, n) : 1;
+        if (lwb < gw * 64 || nh < 8u << L.tileH || nd < 1u << L.tileD) break;
+    }
+    if (n != q[0] || lw != q[1] || lh != q[2] || ld != q[3]) return 0;   // S2Arm (check C13): not the tiles the game maps
+    *tw = lw; *th = lh; *td = ld;
+    return (int)n;
+}
