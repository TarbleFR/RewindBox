diff --git a/graphics/nvn/gfx/nvn/nvn_drs_fx_descriptor.h b/graphics/nvn/gfx/nvn/nvn_drs_fx_descriptor.h
new file mode 100644
index 0000000..20b5161
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_drs_fx_descriptor.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+// Prepared by a non-render worker. Synchronous initialization requests the underlying
+// MetalFX pipeline compilation before the scaler is published to the submit thread.
+API_AVAILABLE(macos(26.0), ios(26.0))
+static inline id<MTLFXTemporalScalerBase> rb_fx_make_temporal(Class cl,id<MTLDevice> dev,id compiler,
+    NSUInteger w,NSUInteger h,NSUInteger ow,NSUInteger oh,MTLPixelFormat cf,MTLPixelFormat df,
+    MTLPixelFormat mf,MTLPixelFormat of,BOOL autoExposure,BOOL reversed,float maxScale)
+{
+    MTLFXTemporalScalerDescriptor *td=[cl new];
+    td.inputWidth=w; td.inputHeight=h; td.outputWidth=ow; td.outputHeight=oh;
+    td.colorTextureFormat=cf; td.depthTextureFormat=df;
+    td.motionTextureFormat=mf; td.outputTextureFormat=of;
+    td.inputContentPropertiesEnabled=YES; td.inputContentMinScale=1; td.inputContentMaxScale=maxScale;
+    td.autoExposureEnabled=autoExposure;
+    td.requiresSynchronousInitialization=YES;   // finish MetalFX compilation on this worker
+    id<MTLFXTemporalScalerBase> s=[td newTemporalScalerWithDevice:dev compiler:compiler];
+    id<MTLFence> fence=s ? [dev newFence] : nil;
+    if (!fence) return nil;
+    s.fence=fence; s.depthReversed=reversed;
+    return s;
+}
+
+
+API_AVAILABLE(macos(26.0), ios(26.0))
+static inline id<MTLFXSpatialScalerBase> rb_fx_make_spatial(Class cl,id<MTLDevice> dev,id compiler,
+    NSUInteger w,NSUInteger h,NSUInteger ow,NSUInteger oh,MTLPixelFormat cf,MTLPixelFormat of,BOOL perceptual)
+{
+    MTLFXSpatialScalerDescriptor *sd=[cl new];
+    sd.inputWidth=w; sd.inputHeight=h; sd.outputWidth=ow; sd.outputHeight=oh;
+    sd.colorTextureFormat=cf; sd.outputTextureFormat=of;
+    sd.colorProcessingMode=perceptual ? MTLFXSpatialScalerColorProcessingModePerceptual : MTLFXSpatialScalerColorProcessingModeHDR;
+    id<MTLFXSpatialScalerBase> s=[sd newSpatialScalerWithDevice:dev compiler:compiler];
+    id<MTLFence> fence=s ? [dev newFence] : nil;
+    if (!fence) return nil;
+    s.fence=fence;
+    return s;
+}
diff --git a/graphics/nvn/gfx/nvn/nvn_drs_fx_extent.h b/graphics/nvn/gfx/nvn/nvn_drs_fx_extent.h
new file mode 100644
index 0000000..7bf6261
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_drs_fx_extent.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <math.h>
+
+static inline int rb_fx_extent_tier(unsigned w, unsigned h) {
+    if (w == 960 && h == 540) return 0;
+    if (w == 816 && h == 459) return 1;
+    if (w == 720 && h == 405) return 2;
+    return -1;
+}
+static inline unsigned rb_fx_tier_width(unsigned t) { const unsigned w[] = {960,816,720}; return t < 3 ? w[t] : 0; }
+static inline unsigned rb_fx_tier_height(unsigned t) { const unsigned h[] = {540,459,405}; return t < 3 ? h[t] : 0; }
+// Guest jitter and motion scales describe a displacement in guest input pixels.
+// A guest-driven change already expressed in its own pixels needs no conversion.
+static inline float rb_fx_physical_pixels(float guest, unsigned physicalExtent, unsigned guestExtent) {
+    return guest * ((float)physicalExtent / (float)guestExtent);
+}
+static inline int rb_fx_temporal_ratio(unsigned w,unsigned h,unsigned ow,unsigned oh,float max) {
+    return w && h && max >= (double)ow/w && max >= (double)oh/h;
+}
