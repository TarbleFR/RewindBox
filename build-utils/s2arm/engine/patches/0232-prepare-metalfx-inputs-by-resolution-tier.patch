+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/nvn_drs_fx_extent.h"
+#include <assert.h>
+int main(void) {
+    for (unsigned t=0;t<3;t++) {
+        unsigned w=rb_fx_tier_width(t), h=rb_fx_tier_height(t);
+        assert(rb_fx_extent_tier(w,h)==(int)t);
+        assert(rb_fx_temporal_ratio(w,h,1920,1080,2)==(t==0));
+        assert(rb_fx_temporal_ratio(w,h,1920,1080,3));
+        assert(rb_fx_extent_tier(w+1,h)==-1 && rb_fx_extent_tier(w,h+1)==-1);
+        assert(fabsf(rb_fx_physical_pixels(-960,w,960)+(float)w)<1.e-4f);
+        assert(fabsf(rb_fx_physical_pixels(540,h,540)-(float)h)<1.e-4f);
+        assert(rb_fx_physical_pixels(.25f,w,w)==.25f);
+        assert(fabsf(rb_fx_physical_pixels(-.375f,h,540)-(-.375f*(float)h/540.f))<1.e-6f);
+    }
+    assert(rb_fx_tier_width(3)==0 && rb_fx_tier_height(3)==0 && rb_fx_extent_tier(1920,1080)==-1);
+}
