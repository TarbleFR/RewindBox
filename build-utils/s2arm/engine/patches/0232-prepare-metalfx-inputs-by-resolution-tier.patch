+        }
+        NSError *error=nil;
+        id compiler=[dev newCompilerWithDescriptor:[MTL4CompilerDescriptor new] error:&error];
+        if (!compiler) return 1;
+        float max=[cls supportedInputContentMaxScaleForDevice:dev];
+        for (unsigned tier=0;tier<3;tier++) { @autoreleasepool {
+            NSUInteger w=rb_fx_tier_width(tier), h=rb_fx_tier_height(tier);
+            if (tier && [MTLFXSpatialScalerDescriptor supportsDevice:dev]) {
+                id<MTLFXSpatialScalerBase> sp=rb_fx_make_spatial([MTLFXSpatialScalerDescriptor class],dev,compiler,w,h,1920,1080,
+                    MTLPixelFormatRG11B10Float,MTLPixelFormatRG11B10Float,NO);
+                if (!sp || !sp.fence || sp.inputWidth!=w || sp.inputHeight!=h || sp.outputWidth!=1920 || sp.outputHeight!=1080) return 3;
+                printf("tier %u spatial inputs color=%lu depth=0 motion=0 output=%lu\n",tier,(unsigned long)sp.colorTextureUsage,(unsigned long)sp.outputTextureUsage);
+            }
+            if (!rb_fx_temporal_ratio(w,h,1920,1080,max)) { printf("tier %u: temporal excluded by %.2f, tested spatial above\n",tier,max); continue; }
+            id<MTLFXTemporalScalerBase> s=rb_fx_make_temporal(cls,dev,compiler,w,h,1920,1080,MTLPixelFormatRG11B10Float,
+                MTLPixelFormatDepth32Float,MTLPixelFormatRG16Float,MTLPixelFormatRG11B10Float,NO,YES,max);
+            if (!s || !s.fence || !s.depthReversed || s.inputWidth!=w || s.inputHeight!=h ||
+                s.outputWidth!=1920 || s.outputHeight!=1080) return 2;
+            printf("tier %u: %lux%lu -> 1920x1080, color=%lu depth=%lu motion=%lu output=%lu\n",tier,(unsigned long)w,(unsigned long)h,
+                (unsigned long)s.colorTextureUsage,(unsigned long)s.depthTextureUsage,
+                (unsigned long)s.motionTextureUsage,(unsigned long)s.outputTextureUsage);
+        }}
+        return 0;
+    }
+    return 77;
+}}
diff --git a/graphics/nvn/tests/t_rb_drs_fx_extent.c b/graphics/nvn/tests/t_rb_drs_fx_extent.c
new file mode 100644
index 0000000..14d3ebd
