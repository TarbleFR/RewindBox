+static void rb_sri_bind(const void *c, const tex_t *t) {   // game threads (recording)
+    if (t) { atomic_fetch_add(&g_rb_sri_bind, 1); atomic_store(&g_rb_sri_w, t->d.width); atomic_store(&g_rb_sri_h, t->d.height); atomic_store(&g_rb_sri_fmt, t->d.format); } else atomic_fetch_add(&g_rb_sri_unbind, 1);
+    pthread_mutex_lock(&g_rb_sri_mu);
+    int n = atomic_load(&g_rb_sri_n), k = 0; while (k < n && g_rb_sri[k].cmd != c) k++;
+    if (t && k == n && n < 16) { g_rb_sri[n].cmd = c; atomic_store(&g_rb_sri_n, n + 1); }
+    else if (!t && k < n) { g_rb_sri[k] = g_rb_sri[n - 1]; atomic_store(&g_rb_sri_n, n - 1); }
+    pthread_mutex_unlock(&g_rb_sri_mu);
+}
+static void rb_sri_rt(const void *c, const tex_t *t) {   // SetRenderTargets while some command buffer has a shading-rate image bound
+    pthread_mutex_lock(&g_rb_sri_mu);
+    int n = atomic_load(&g_rb_sri_n), k = 0; while (k < n && g_rb_sri[k].cmd != c) k++;
+    pthread_mutex_unlock(&g_rb_sri_mu);
+    if (k == n) return;
+    atomic_fetch_add(&g_rb_sri_rt, 1); if (t) atomic_fetch_add(&g_rb_sri_px, (uint64_t)t->d.width * t->d.height);
