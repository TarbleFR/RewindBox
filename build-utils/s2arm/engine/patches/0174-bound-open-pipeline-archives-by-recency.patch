+// Accessed under g_par_mu. All users take strong references under this same
+// lock. Only read-only, already serialized files enter this cache.
+enum { RB_OPEN_ARCHIVES = 128, RB_PRESSURE_OPEN_ARCHIVES = 8 };
+static NSMutableOrderedSet<NSString *> *g_rb_recent_archives;
+static void rb_archive_forget(NSString *key)
+{
+    [g_par_open removeObjectForKey:key];
+    if (rb_heap_on()) [g_rb_recent_archives removeObject:key];
+}
+// RewindBox: callers release this owned collection only after g_par_mu.
+// Retiring a cold Metal object must not hold up a concurrent first draw.
+static CFArrayRef rb_archive_limit(NSUInteger limit)
+{
+    if (g_rb_recent_archives.count <= limit) return NULL;
+    NSMutableArray *retired = [[NSMutableArray alloc] initWithCapacity:g_rb_recent_archives.count - limit];
+    while (g_rb_recent_archives.count > limit) {
+        NSString *key = g_rb_recent_archives.firstObject;
+        id archive = g_par_open[key];
+        if (archive) [retired addObject:archive];
+        rb_archive_forget(key);
+    }
+    return (CFArrayRef)CFBridgingRetain(retired);
+}
+static id<MTLBinaryArchive> rb_archive_lookup(NSString *key)
+{
+    id<MTLBinaryArchive> archive = g_par_open[key];
+    if (archive && rb_heap_on()) {
+        [g_rb_recent_archives removeObject:key];
+        [g_rb_recent_archives addObject:key];
+    }
+    return archive;
+}
+static CFArrayRef rb_archive_store(NSString *key, id<MTLBinaryArchive> archive)
+{
+    g_par_open[key] = archive;
+    if (!rb_heap_on()) return NULL;
+    if (!g_rb_recent_archives) g_rb_recent_archives = [NSMutableOrderedSet orderedSet];
+    [g_rb_recent_archives removeObject:key];
+    [g_rb_recent_archives addObject:key];
+    return rb_archive_limit(RB_OPEN_ARCHIVES);
+}
