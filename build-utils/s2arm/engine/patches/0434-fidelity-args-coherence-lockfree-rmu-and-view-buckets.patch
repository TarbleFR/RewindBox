+static inline int rb_args_whole_reuse_safe(int stage, const rb_args_masks *m,
+                                           uint64_t ab_mem_gen, uint64_t cur_mem_gen,
+                                           int ab_ub, int shadow_n, int had_ubd, int nubd) {
