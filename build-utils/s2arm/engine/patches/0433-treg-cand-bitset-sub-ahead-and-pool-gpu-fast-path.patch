new file mode 100644
index 0000000..5590358
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_treg_cand.h
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0433): lock-free packaged-texture candidate bitset for recorded bind hints and
+//   submission-level batched MADV_WILLNEED pre-scan, plus O(1) pool_gpu fast-path and
+//   mutation-scoped pool_seen_scan predicates. Pure C: host-testable without Metal.
+//   IPA 845 (iPhone A18 Pro):
+//   - Zelda (0400486024DEC000): rb-bind-lane posted 12,882 dispatch_async hints/300f with looked=0
+//     and busy=718 contending on g_rmu because rb_bl_record could not tell render targets or
+//     already-uploaded textures from unloaded packaged textures; pool_gpu ran 6,569,984 times
+//     (~1,000/frame, 2,108 ms cumulative CPU), taking mach_absolute_time() twice and locking
+//     g_pin_mu on every call even when g_pin_nnew == 0, while pool_seen_scan re-walked all
+//     g_seen_done entries (341,860 updates) on pure texture additions (g_ser_gen vs g_rb_ser_add).
+//   - Mario Kart World (0400C3F00006E000): F6090 (175 textures, 1,230 absent pages = 109.4 ms CPU)
+//     and F7746 (136 textures, 3,363 absent pages = 110.6 ms CPU) serialized flash page-ins one
+//     texture at a time during replay while thermal >= 2 held back rb-bind-lane.
+//   S2A_RB_SUB_AHEAD=0 disables the submission pre-scan (the bind-lane filter and pool_gpu fast
+//   path stay active and are behavior-preserving).
+#pragma once
+#include <stdatomic.h>
+#include <stdint.h>
+#include <string.h>
+
+enum {
+    RB_TREG_CAND_CAP = 1u << 20,
+    RB_TREG_CAND_WORDS = RB_TREG_CAND_CAP >> 6,
+    RB_TREG_CAND_EXCL_FLAGS = 0x1u | 0x2u | 0x20u, /* DISPLAY(0x1) | VIDEO_DECODE(0x2) | SPARSE(0x20) — static-asserted in nvn_mtl.m */
+    RB_SUB_AHEAD_MAX_OPS = 2048,
+    RB_SUB_AHEAD_MAX_TEX = 128,
+    RB_SUB_AHEAD_HASH = 256,
+    RB_SUB_AHEAD_MAX_DEPTH = 4
+};
+#define RB_SUB_AHEAD_MAX_BYTES (UINT64_C(64) << 20)
+
+typedef struct {
+    _Atomic uint64_t bits[RB_TREG_CAND_WORDS];
+    _Atomic uint32_t count;
+} rb_treg_cand_set;
+
+static inline int rb_sub_ahead_switch(const char *env) {
+    return !(env && !strcmp(env, "0"));
+}
+
+static inline int rb_treg_cand_eligible(int has_layout, int has_mem, uint64_t size,
+                                        uint32_t tex_flags, int is_virtual_pool, uint64_t max_bytes) {
+    return has_layout && has_mem && size > 0 && size <= max_bytes &&
+           !is_virtual_pool && !(tex_flags & (uint32_t)RB_TREG_CAND_EXCL_FLAGS);
+}
+
+static inline void rb_treg_cand_set_id(rb_treg_cand_set *s, uint32_t id_) {
+    if (id_ >= (uint32_t)RB_TREG_CAND_CAP) return;
+    uint64_t mask = UINT64_C(1) << (id_ & 63u);
+    uint64_t prev = atomic_fetch_or_explicit(&s->bits[id_ >> 6], mask, memory_order_release);
+    if (!(prev & mask)) atomic_fetch_add_explicit(&s->count, 1u, memory_order_relaxed);
+}
+
+static inline void rb_treg_cand_clear_id(rb_treg_cand_set *s, uint32_t id_) {
+    if (id_ >= (uint32_t)RB_TREG_CAND_CAP) return;
+    uint64_t mask = UINT64_C(1) << (id_ & 63u);
+    uint64_t cur = atomic_load_explicit(&s->bits[id_ >> 6], memory_order_relaxed);
+    if (!(cur & mask)) return;
+    uint64_t prev = atomic_fetch_and_explicit(&s->bits[id_ >> 6], ~mask, memory_order_relaxed);
+    if (prev & mask) atomic_fetch_sub_explicit(&s->count, 1u, memory_order_relaxed);
+}
+
+static inline int rb_treg_cand_test(const rb_treg_cand_set *s, uint32_t id_) {
+    if (id_ >= (uint32_t)RB_TREG_CAND_CAP) return 0;
+    return (int)((atomic_load_explicit(&s->bits[id_ >> 6], memory_order_acquire) >> (id_ & 63u)) & 1u);
+}
+
+static inline uint32_t rb_treg_cand_count(const rb_treg_cand_set *s) {
+    return atomic_load_explicit(&s->count, memory_order_relaxed);
+}
+
+static inline void rb_treg_cand_reset(rb_treg_cand_set *s) {
+    for (unsigned i = 0; i < (unsigned)RB_TREG_CAND_WORDS; i++) {
+        if (atomic_load_explicit(&s->bits[i], memory_order_relaxed))
+            atomic_store_explicit(&s->bits[i], 0, memory_order_relaxed);
+    }
+    atomic_store_explicit(&s->count, 0u, memory_order_release);
+}
+
+/* Open-addressed stack dedup set for submission pre-scan (stores tid + 1; 0 = empty). */
+static inline int rb_sub_ahead_dedup_add(uint32_t table[RB_SUB_AHEAD_HASH], uint32_t out[RB_SUB_AHEAD_MAX_TEX],
+                                         int *nout, uint32_t tid) {
+    if (*nout >= (int)RB_SUB_AHEAD_MAX_TEX) return 0;
+    uint32_t key = tid + 1u;
+    uint32_t slot = (tid * UINT32_C(2654435761)) & ((uint32_t)RB_SUB_AHEAD_HASH - 1u);
+    for (unsigned probe = 0; probe < (unsigned)RB_SUB_AHEAD_HASH; probe++) {
+        uint32_t cur = table[slot];
+        if (cur == key) return 0;
+        if (!cur) {
+            table[slot] = key;
+            out[(*nout)++] = tid;
+            return 1;
+        }
+        slot = (slot + 1u) & ((uint32_t)RB_SUB_AHEAD_HASH - 1u);
+    }
+    return 0;
+}
+
+/* pool_seen_scan recheck classification:
+ * - RB_POOL_RECHECK_NONE: neither serial mutations nor sparse mappings nor guest dirty writes moved.
+ * - RB_POOL_RECHECK_PKG_ONLY: only guest dirty writes moved -> only CPU-written (view_pkg) or unresolved (!view) IDs need recheck.
+ * - RB_POOL_RECHECK_ALL: a non-addition serial mutation or sparse mapping occurred -> recheck all seen IDs. */
+enum {
+    RB_POOL_RECHECK_NONE = 0,
+    RB_POOL_RECHECK_PKG_ONLY = 1,
+    RB_POOL_RECHECK_ALL = 2
+};
+
+static inline int rb_pool_seen_recheck_mode(uint64_t ser_mut, uint64_t seen_ser_mut,
+                                            uint64_t dirty, uint64_t seen_dirty,
+                                            int sparse_recheck) {
+    if (ser_mut != seen_ser_mut || sparse_recheck) return RB_POOL_RECHECK_ALL;
+    if (dirty != seen_dirty) return RB_POOL_RECHECK_PKG_ONLY;
+    return RB_POOL_RECHECK_NONE;
+}
+
+/* O(1) pool_gpu fast-path guard: all slow-path conditions are known clean and this call is not a log boundary. */
+static inline int rb_pool_gpu_fast_ok(int ptab_any, int ntreg_same, int nsreg_same,
+                                      uint32_t pin_nnew, uint32_t dirty0, uint32_t dirty1,
+                                      int seen_up_to_date, int left_up_to_date,
+                                      uint64_t next_calls) {
+    return ptab_any && ntreg_same && nsreg_same && !pin_nnew && !dirty0 && !dirty1 &&
+           seen_up_to_date && left_up_to_date && ((next_calls & 0x3fffu) != 0);
+}
