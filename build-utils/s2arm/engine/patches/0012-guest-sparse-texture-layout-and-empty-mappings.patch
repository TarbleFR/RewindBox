 NVN(nvnTextureGetDebugID, uint64_t, const NVNtexture *t) { return CTX(t)->serial; }
@@ -4006,6 +4015,13 @@ static int vpool_map(struct vpool *v, const map_req *r) {   // caller holds g_vp
