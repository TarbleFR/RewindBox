diff --git a/graphics/nvn/gfx/nvn/rb_fluid_pso_rule.h b/graphics/nvn/gfx/nvn/rb_fluid_pso_rule.h
new file mode 100644
index 0000000..e52e435
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_fluid_pso_rule.h
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0431): unified Fluid Pipelines wait/defer decision for
+// pso_pend_take_ex and pso_get_vs (nvn_mtl.m).
+//
+// IPA 845 (Mario Kart World, iPhone A18 Pro): 4 logged first-use waits of
+// 466.0, 535.1, 1226.1 and 2202.5 ms (plus 184.3 ms on filmed frame 7954) were
+// all skippable draws with storage_writes=0 while Fluid Pipelines (cap_ms=6)
+// was active. In patch 0419, fluid_cap required !may_skip, which flipped
+// !fluid_cap to 1 on skippable draws and forced required=1 under
+// rb_course_exact(), bypassing every timeout and blocking the submit thread
+// until compilation completed.
+//
+// Invariants preserved:
+//   - Strict mode (fluid_on == 0) or reference capture (ref_profile == 1):
+//     identical behavior to 0430.
+//   - Shaders writing storage buffers / images (storage_writes == 1) when not
+//     may_skip: never deferred by Fluid Pipelines (required preserved).
+//   - Fluid mode active (fluid_on && !ref_profile): every skippable draw and
+//     every non-storage-writing draw is never marked required, uses a single
+//     unified per-draw / per-frame fluid budget (cap = 2 * fluid_ms), and
+//     defers instead of falling back to synchronous compilation when the
+//     pending table cannot accept it and the frame fluid budget is exhausted.
+#pragma once
+#include <stdint.h>
+
+typedef struct {
+    int fluid_on;           // rb_fluid_pso_on()
+    int ref_profile;        // rb_ref_profile_on()
+    int may_skip;           // draw is skip-safe / skippable
+    int storage_writes;     // shader_writes(vs) || shader_writes(fs)
+    int course_exact;       // rb_course_exact()
+    int async_pso;          // rb_async_pso()
+    int observed_first;     // rb_observed_workers_on() && rb_first_draw_on()
+    int fluid_ms;           // rb_fluid_pso_ms() (default 6..12)
+    int64_t fluid_left_ms;  // rb_fluid_budget_left_ms()
+    int pso_wait_ms;        // DM_NVN_PSO_WAIT_MS (default 2000)
+    int pso_unsafe_ms;      // DM_NVN_PSO_UNSAFE_WAIT_MS (default 10000)
+    int late_wait;          // may_skip && g_rb_lw_take
+    int64_t late_left_ms;   // rb_late_left_ms()
+    int64_t frame_left_ms;  // pso_budget_left_ms() (INT64_MAX if none)
+    int done;               // pending slot already finished (1 = take without waiting)
+} rb_fluid_pso_in;
+
+typedef struct {
+    int fluid_active;       // 1 = Fluid Pipelines governs this draw
+    int fluid_cap;          // 1 = wait is bounded by the unified fluid budget
+    int required;           // 1 = unbounded wait until done or session stop
+    int immediate_defer;    // 1 = frame budget already spent -> return nil (timed_out = 2)
+    int wait_ms;            // effective timedwait cap in ms (0 = unbounded if !required)
+    int demand_boost;       // 1 = boost pending compile via ppq_demand_locked
+} rb_fluid_pso_out;
+
+static inline rb_fluid_pso_out rb_fluid_pso_decide(const rb_fluid_pso_in *in) {
+    rb_fluid_pso_out o = {0};
+    const int fluid_active = in->fluid_on && !in->ref_profile;
+    const int fluid_eligible = fluid_active && (in->may_skip || !in->storage_writes);
+    o.fluid_active = fluid_active;
+    o.fluid_cap = fluid_eligible;
+    o.required = !fluid_eligible &&
+        (in->course_exact || (!in->may_skip && (in->async_pso || in->observed_first)));
+    o.demand_boost = !in->may_skip || fluid_eligible;
+
+    if (in->done) {
+        o.wait_ms = 0;
+        return o;
+    }
+
+    if (fluid_eligible) {
+        if (in->fluid_left_ms <= 0) {
+            o.immediate_defer = 1;
+            o.wait_ms = 0;
+            return o;
+        }
+        int ms = in->fluid_ms > 0 ? in->fluid_ms : 1;
+        if (in->fluid_left_ms < ms) ms = (int)in->fluid_left_ms;
+        // Preserve late-wait 0 ms skip semantics (S2A_RB_LATE_BUDGET_MS=0 in fluid mode).
+        if (in->late_wait && in->late_left_ms <= 0) {
+            o.immediate_defer = 1;
+            o.wait_ms = 0;
+            return o;
+        }
+        if (in->late_wait && in->late_left_ms < ms) ms = (int)in->late_left_ms;
+        o.wait_ms = ms;
+        return o;
+    }
+
+    // Legacy / strict / storage-writing path: exact 0430 semantics.
+    int ms = in->may_skip ? in->pso_wait_ms : in->pso_unsafe_ms;
+    if (in->may_skip) {
+        int64_t left = in->late_wait ? in->late_left_ms : in->frame_left_ms;
+        int64_t cap = ms ? (int64_t)ms : INT64_MAX;
+        if (left < cap) {
+            if (left <= 0) {
+                o.immediate_defer = 1;
+                o.wait_ms = 0;
+                return o;
+            }
+            ms = (int)left;
+        }
+    }
+    o.wait_ms = ms;
+    return o;
+}
+
+// 1 = when pending queue could not hold the pipeline (ps == nil, !pp_late),
+// defer instead of running a synchronous compile on the submit thread.
+static inline int rb_fluid_pso_skip_sync(int fluid_on, int ref_profile,
+                                         int may_skip, int storage_writes,
+                                         int64_t fluid_left_ms, int64_t pso_left_ms) {
+    if (fluid_on && !ref_profile && (may_skip || !storage_writes))
+        return fluid_left_ms <= 0;
+    return may_skip && pso_left_ms <= 0;
+}
