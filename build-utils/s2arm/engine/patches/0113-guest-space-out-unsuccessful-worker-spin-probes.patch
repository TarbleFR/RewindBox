+// RewindBox (patch 0113): IPA 785 had 208,326 fruitless spins and 4,515 hits.
+// Only re-probes after the adaptive spin budget has already reached zero change.
+// Count skipped 16-wait probe slots under G. Ordinary word sleeps still wake immediately.
+static uint64_t rb_sp_skipped;
+static int rb_sparse_probe_on(void) {   // called under G
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("S2A_RB_IDLE_WAIT_PROBE");
+        const char *custom = getenv("S2A_RB_WAIT_SPIN");
+        on = v && !strcmp(v, "1") && !(custom && *custom);
+    }
+    return on;
+}
