--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_read_ahead_feedback.inc
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: Apache-2.0
+// One entry per host page for which the kernel accepted speculative advice.
+// Direct-map collisions suppress optional work. They never replace an unresolved page.
+enum { RA_REGISTER=1, RA_NEIGHBOUR, RA_BIND, RA_LANES=4, RA_SLOTS=8192, RA_TRIAL=256 };
+static const char *const rb_ra_names[RA_LANES]={"none","registration","pool-neighbour","recorded-bind"};
+typedef struct { uintptr_t address; uint64_t seq, observer; unsigned owner; BOOL pending, raced; } rb_ra_page;
+typedef struct { uint64_t issued, hit, absent, expired, duplicate, refused;
+    uint64_t firstFrame, cohorts; unsigned pending, opened, resolved, successes, level; BOOL stopped; } rb_ra_lane;
+static rb_ra_page rb_ra_pages[RA_SLOTS];
+static rb_ra_lane rb_ra_lanes[RA_LANES];
+static os_unfair_lock rb_ra_lock=OS_UNFAIR_LOCK_INIT;
+static _Atomic uint64_t rb_ra_sequence=1;
+static _Atomic unsigned rb_ra_open;
+static _Thread_local unsigned rb_ra_source;
+static _Thread_local BOOL rb_ra_spec_upload;
+typedef struct { uint32_t slot; uint64_t seq; BOOL resident; } rb_ra_candidate;
+typedef struct { uint64_t token; unsigned count; rb_ra_candidate page[(RA_LANES-1)*RA_TRIAL]; } rb_ra_read;
+static _Thread_local rb_ra_read rb_ra_thread;
+static unsigned rb_ra_slot(uintptr_t a,uintptr_t pg) { return (unsigned)((a/pg) % RA_SLOTS); }
+static void rb_ra_done(rb_ra_page *p,int outcome) {
+    rb_ra_lane *l=&rb_ra_lanes[p->owner];
+    l->resolved++;
+    if (outcome>0) { l->hit++; l->successes++; }
+    else if (!outcome) l->absent++; else l->expired++;
+    p->owner=0; p->observer=0; atomic_fetch_sub_explicit(&rb_ra_open,1,memory_order_relaxed);
+}
+// Called at most once per cohort deadline or completion from the submission owner.
+static void rb_ra_sweep(uint64_t frame,BOOL end) {
+    static uint64_t last;
+    if (!end && frame>=last && frame-last<30) return;
+    last=end ? 0 : frame;
+    os_unfair_lock_lock(&rb_ra_lock);
+    for (unsigned owner=1;owner<RA_LANES;owner++) {
+        rb_ra_lane *l=&rb_ra_lanes[owner];
+        if (!l->opened || l->pending) continue;
+        BOOL expired=end || (frame>=l->firstFrame && frame-l->firstFrame>=300);
+        if (!expired && (l->opened<RA_TRIAL || l->resolved<l->opened)) continue;
+        if (expired) for (unsigned i=0;i<RA_SLOTS;i++) if (rb_ra_pages[i].owner==owner) rb_ra_done(&rb_ra_pages[i],-1);
+        unsigned total=l->opened,hits=l->successes;
+        l->cohorts++;
+        MLOG("[RB-READ-AHEAD] source=%s closed=%u useful=%u fraction=%.4f level=%u stopped=%u issued_pages=%llu useful_pages=%llu absent_at_use=%llu unused_expired=%llu duplicate_suppressed=%llu unissued=%llu",
+            rb_ra_names[owner],total,hits,(double)hits/total,l->level,(unsigned)l->stopped,
+            (unsigned long long)l->issued,(unsigned long long)l->hit,(unsigned long long)l->absent,
+            (unsigned long long)l->expired,(unsigned long long)l->duplicate,(unsigned long long)l->refused);
+        l->opened=l->resolved=l->successes=0;
+    }
+    if (end) { memset(rb_ra_pages,0,sizeof rb_ra_pages);memset(rb_ra_lanes,0,sizeof rb_ra_lanes);atomic_store(&rb_ra_open,0); }
+    os_unfair_lock_unlock(&rb_ra_lock);
+}
+static unsigned rb_ra_scale(unsigned owner) {
+    if (!rb_gov_on()) return 1;
+    if (!rb_gov_quota(RB_GOV_PREFETCH)) return 0;
+    os_unfair_lock_lock(&rb_ra_lock); rb_ra_lane *l=&rb_ra_lanes[owner];
+    unsigned scale=l->stopped || l->opened+l->pending>=RA_TRIAL ? 0 : 1u<<l->level;
+    os_unfair_lock_unlock(&rb_ra_lock);return scale;
+}
+// The input run consists exclusively of file-backed pages found absent by mincore.
+// Split around outstanding hints and charge only pages accepted by madvise.
+static void rb_ra_advise(uintptr_t a,size_t pages,size_t pg,unsigned source) {
+    if (!rb_gov_quota(RB_GOV_PREFETCH)) return;
+    size_t i=0;
+    while (i<pages) {
+        os_unfair_lock_lock(&rb_ra_lock);
+        rb_ra_lane *l=&rb_ra_lanes[source];
+        unsigned quota=RA_TRIAL-l->opened-l->pending;
+        if (l->stopped || !quota || !rb_gov_quota(RB_GOV_PREFETCH)) { os_unfair_lock_unlock(&rb_ra_lock); break; }
+        rb_ra_page *p=&rb_ra_pages[rb_ra_slot(a+i*pg,pg)];
+        if (p->owner) {
+            if (p->address==a+i*pg) l->duplicate++; else l->refused++;
+            os_unfair_lock_unlock(&rb_ra_lock); i++; continue;
+        }
+        size_t n=1;
+        while (i+n<pages && n<quota && !rb_ra_pages[rb_ra_slot(a+(i+n)*pg,pg)].owner) n++;
+        uint64_t seq=atomic_fetch_add(&rb_ra_sequence,1);
+        for (size_t j=0;j<n;j++) {
+            uintptr_t addr=a+(i+j)*pg;
+            rb_ra_pages[rb_ra_slot(addr,pg)]=(rb_ra_page){.address=addr,.seq=seq,.owner=source,.pending=YES};
+        }
+        l->pending+=(unsigned)n;atomic_fetch_add(&rb_ra_open,(unsigned)n);
+        os_unfair_lock_unlock(&rb_ra_lock);
+        BOOL ok=rb_gov_quota(RB_GOV_PREFETCH) && !madvise((void *)(a+i*pg),n*pg,MADV_WILLNEED);
+        os_unfair_lock_lock(&rb_ra_lock);
+        for (size_t j=0;j<n;j++) {
+            p=&rb_ra_pages[rb_ra_slot(a+(i+j)*pg,pg)];
+            if (p->seq!=seq || !p->pending || p->owner!=source) continue;
+            l->pending--;p->pending=NO;
+            if (ok) {
+                if (!l->opened) l->firstFrame=atomic_load(&g_cur_frame);
+                l->opened++;l->issued++;
+                if (p->raced) rb_ra_done(p,0);
+            } else { l->refused++;p->owner=0;atomic_fetch_sub(&rb_ra_open,1); }
+        }
+        os_unfair_lock_unlock(&rb_ra_lock);i+=n;
+    }
+}
+static BOOL rb_ra_begin(BOOL demand) {
+    if (!rb_gov_on() || !demand || rb_ra_spec_upload || rb_ra_thread.token || !atomic_load(&rb_ra_open)) return NO;
+    rb_ra_thread.token=atomic_fetch_add(&rb_ra_sequence,1);rb_ra_thread.count=0;return YES;
+}
+static void rb_ra_observe(uintptr_t a,uintptr_t pg,size_t n,const char *resident,const char *selected) {
+    rb_ra_read *r=&rb_ra_thread;
+    if (!r->token || !atomic_load_explicit(&rb_ra_open,memory_order_relaxed)) return;
+    os_unfair_lock_lock(&rb_ra_lock);
+    for (size_t i=0;i<n;i++) {
+        if (selected && !selected[i]) continue;
+        uintptr_t addr=a+i*pg;unsigned slot=rb_ra_slot(addr,pg);rb_ra_page *p=&rb_ra_pages[slot];
+        if (p->owner && p->address==addr && p->pending) { p->raced=YES; continue; }
+        if (!p->owner || p->address!=addr || p->observer || r->count>=sizeof r->page/sizeof r->page[0]) continue;
+        p->observer=r->token;
+        r->page[r->count++]=(rb_ra_candidate){slot,p->seq,(resident[i]&MINCORE_INCORE)!=0};
+    }
+    os_unfair_lock_unlock(&rb_ra_lock);
+}
+static void rb_ra_finish(BOOL started,BOOL success) {
+    if (!started) return;
+    rb_ra_read *r=&rb_ra_thread;
+    os_unfair_lock_lock(&rb_ra_lock);
+    for (unsigned i=0;i<r->count;i++) {
+        rb_ra_candidate c=r->page[i];rb_ra_page *p=&rb_ra_pages[c.slot];
+        if (!p->owner || p->seq!=c.seq || p->observer!=r->token) continue;
+        if (success) rb_ra_done(p,c.resident); else p->observer=0;
+    }
+    os_unfair_lock_unlock(&rb_ra_lock);r->count=0;r->token=0;
+}
