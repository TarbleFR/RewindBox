new file mode 100644
index 0000000..cc42ecc
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_draw_history.inc
@@ -0,0 +1,233 @@
+// Cup profile observations are separate from the sealed configuration and from
+// render caches. Only an encoded Metal draw publishes a replayable recipe.
+enum { RB_DRAW_VERSION=1, RB_DRAW_LIMIT=16384, RB_DRAW_BATCH=192, RB_DRAW_FLUSH_FRAMES=120, RB_DRAW_CUE_FRAMES=600 };
+typedef struct {
+    pso_skey recipe;
+    char task[24]; // Empty for a vertex pipeline, "-" for mesh without a task.
+    uint32_t pad;
+    uint64_t wait_ns, frame;
+    uuid_t session;
+    char cue[RB_COURSE_NAME];
+    uint8_t prepared, phase; // 1: startup, 0: phase unavailable.
+} rb_draw_record;
+typedef struct {
+    rb_draw_record first, preferred;
+} rb_draw_history_entry;
+
+static os_unfair_lock g_rb_draw_batch_lock=OS_UNFAIR_LOCK_INIT;
+static NSMutableArray<NSData *> *g_rb_draw_batch; // submit and present may differ
+// Trace I/O queue. Keep failed checkpoints by path until they can be retried.
+static NSMutableDictionary<NSString *,NSMutableDictionary<NSString *,NSData *> *> *g_rb_draw_unsaved;
+static uuid_t g_rb_draw_session;
+static uint64_t g_rb_draw_cue_frame;
+static BOOL g_rb_draw_first_saved;
+static NSDictionary<NSString *,NSData *> *g_rb_draw_loaded;
+static NSString *g_rb_draw_loaded_path;
+
+
+static dispatch_queue_t rb_draw_io(void) {
+    static dispatch_queue_t queue;
+    static dispatch_once_t once;
+    dispatch_once(&once,^{
+        queue=dispatch_queue_create("rewindbox.pso-draw-history",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,s2a_qos(S2A_QOS_IO_BG),0));
+    });
+    return queue;
+}
+static NSString *rb_draw_path(void) {
+    return [pso_user_path() stringByAppendingString:@".draws-v1"];
+}
+static NSString *rb_draw_line(const rb_draw_record *record) {
+    char hex[sizeof(record->recipe)*2+1];
+    pso_skey_hex(&record->recipe,hex);
+    if (*record->task) return [NSString stringWithFormat:@"M\t%s\t%s\t%x",hex,record->task,record->pad];
+    return [NSString stringWithFormat:@"R\t%s",hex];
+}
+static BOOL rb_draw_valid(const rb_draw_record *r) {
+    const char *end=memchr(r->cue,0,sizeof r->cue);
+    const char *task=memchr(r->task,0,sizeof r->task);
+    if (!end || !task || !r->recipe.vs[0] || !memchr(r->recipe.vs,0,sizeof r->recipe.vs) ||
+        !memchr(r->recipe.fs,0,sizeof r->recipe.fs) ||
+        (end!=r->cue && !rb_course_token(r->cue,end-r->cue)) ||
+        (task!=r->task && !rb_course_token(r->task,task-r->task))) return NO;
+    if (r->recipe.merged || r->recipe.fz) {
+        if (*r->task || !r->recipe.merged || !r->recipe.fz || r->recipe.fz_desc.kind!=1) return NO;
+    }
+    return !r->recipe.k.vs && !r->recipe.k.fs && !r->recipe.k.fsfn && r->prepared<=1 && r->phase<=1;
+}
+static unsigned rb_draw_rank(const rb_draw_record *r) {
+    if (!strcmp(r->cue,"selection_asset")) return 3;
+    if (!strcmp(r->cue,"race_sequence_asset")) return 2;
+    return r->phase==1;
+}
+static BOOL rb_draw_preferred(const rb_draw_record *a,const rb_draw_record *b) {
+    unsigned lhs=rb_draw_rank(a),rhs=rb_draw_rank(b);
+    if (lhs!=rhs) return lhs>rhs;
+    if (a->wait_ns!=b->wait_ns) return a->wait_ns>b->wait_ns;
+    return !*b->cue && *a->cue;
+}
+// Called only off the submit thread. An unreadable established file is left
+// intact and retried, so a storage failure cannot erase earlier discoveries.
+static NSDictionary<NSString *,NSData *> *rb_draw_read(NSString *path) {
+    NSMutableDictionary *out=[NSMutableDictionary dictionary];
+    if (!path) return out;
+    FILE *f=fopen(path.fileSystemRepresentation,"rb");
+    if (!f) return errno==ENOENT ? out : nil;
+    const uint64_t expected[]={0x5242574244524157ull,RB_DRAW_VERSION,sizeof(rb_draw_history_entry)};
+    uint64_t header[3];
+    BOOL ok=fread(header,sizeof header,1,f)==1 && !memcmp(header,expected,sizeof header);
+    rb_draw_history_entry entry;
+    while (ok) {
+        size_t n=fread(&entry,1,sizeof entry,f);
+        if (!n) { ok=feof(f) && !ferror(f); break; }
+        if (n!=sizeof entry || out.count>=RB_DRAW_LIMIT) { ok=NO; break; }
+        if (!rb_draw_valid(&entry.first) || !rb_draw_valid(&entry.preferred) ||
+            memcmp(&entry.first.recipe,&entry.preferred.recipe,sizeof entry.first.recipe) ||
+            strcmp(entry.first.task,entry.preferred.task) || entry.first.pad!=entry.preferred.pad) continue;
+        out[rb_draw_line(&entry.first)]=[NSData dataWithBytes:&entry length:sizeof entry];
+    }
+    fclose(f);
+    return ok ? out : nil;
+}
+static void rb_draw_merge(NSMutableDictionary<NSString *,NSData *> *out,NSString *line,const rb_draw_record *r) {
+    NSData *old=out[line];
+    rb_draw_history_entry entry;
+    if (old) {
+        [old getBytes:&entry length:sizeof entry];
+        if (!rb_draw_preferred(r,&entry.preferred)) return;
+        entry.preferred=*r;
+    } else {
+        if (out.count>=RB_DRAW_LIMIT) return;
+        entry=(rb_draw_history_entry){.first=*r,.preferred=*r};
+    }
+    out[line]=[NSData dataWithBytes:&entry length:sizeof entry];
+}
+static void rb_draw_write(NSString *path,NSArray<NSData *> *batch) {
+    if (!path) return;
+    if (!g_rb_draw_unsaved) g_rb_draw_unsaved=[NSMutableDictionary dictionary];
+    NSMutableDictionary *pending=g_rb_draw_unsaved[path];
+    if (!pending) pending=g_rb_draw_unsaved[path]=[NSMutableDictionary dictionary];
+    for (NSData *data in batch) {
+        const rb_draw_record *r=data.bytes;
+        if (!rb_draw_valid(r)) continue;
+        NSString *line=rb_draw_line(r);
+        rb_draw_merge(pending,line,r);
+        uuid_string_t session; uuid_unparse_lower(r->session,session);
+        NSString *identity=par_hash(&r->recipe,sizeof r->recipe);
+        MLOG("RewindBox cup pipeline first draw frame=%llu key=%s session=%s kind=%s shader_a=%s shader_b=%s task=%s phase=%s course=unknown hint=%s wait_ns=%llu source=%s",
+            (unsigned long long)r->frame,identity.UTF8String,session,*r->task?"mesh":"render",r->recipe.vs,r->recipe.fs,r->task,
+            r->phase?"startup":"unknown",*r->cue?r->cue:"unknown",(unsigned long long)r->wait_ns,r->prepared?"prepared":"demand");
+    }
+    if (!pending.count) return;
+    NSDictionary *previous=[g_rb_draw_loaded_path isEqual:path] ? g_rb_draw_loaded : nil;
+    if (!previous) previous=rb_draw_read(path);
+    if (!previous) {
+        MLOG("RewindBox cup pipeline history: previous checkpoint unavailable; observed variants retained in memory");
+        return;
+    }
+    NSMutableDictionary *merged=[previous mutableCopy];
+    [pending enumerateKeysAndObjectsUsingBlock:^(NSString *line,NSData *data,BOOL *stop){
+        (void)stop;
+        const rb_draw_history_entry *entry=data.bytes;
+        rb_draw_merge(merged,line,&entry->first);
+        rb_draw_merge(merged,line,&entry->preferred);
+    }];
+    if ([merged isEqual:previous]) { [g_rb_draw_unsaved removeObjectForKey:path]; return; }
+    const uint64_t header[]={0x5242574244524157ull,RB_DRAW_VERSION,sizeof(rb_draw_history_entry)};
+    NSMutableData *output=[NSMutableData dataWithCapacity:sizeof header+merged.count*sizeof(rb_draw_history_entry)];
+    [output appendBytes:header length:sizeof header];
+    for (NSData *data in merged.objectEnumerator) [output appendData:data];
+    if ([output writeToFile:path options:NSDataWritingAtomic error:nil]) {
+        g_rb_draw_loaded_path=path; g_rb_draw_loaded=merged;
+        [g_rb_draw_unsaved removeObjectForKey:path];
+    } else {
+        MLOG("RewindBox cup pipeline history: checkpoint write deferred");
+    }
+}
+static NSDictionary<NSString *,NSData *> *rb_draw_warm_history(void) {
+    if (!rb_course_enabled()) return nil;
+    if (!rb_draw_path()) return nil;
+    return rb_draw_read(rb_draw_path());
+}
+static void rb_draw_flush(BOOL drain) {
+    NSString *path=rb_draw_path();
+    if (!path) return;
+    os_unfair_lock_lock(&g_rb_draw_batch_lock);
+    NSArray<NSData *> *batch=g_rb_draw_batch;
+    g_rb_draw_batch=nil;
+    os_unfair_lock_unlock(&g_rb_draw_batch_lock);
+    if (!batch.count && !drain) return;
+    void (^write)(void)=^{ @autoreleasepool { rb_draw_write(path,batch); } };
+    if (drain) dispatch_sync(rb_draw_io(),write);
+    else dispatch_async(rb_draw_io(),write);
+}
+static BOOL rb_draw_remember(id ps,const pso_skey *recipe,const char *task,uint32_t pad,uint64_t wait,BOOL prepared) {
+    if (!rb_course_exact() || !ps || !recipe->vs[0]) return NO;
+    if ((recipe->merged || recipe->fz) && (task || !recipe->merged || !recipe->fz || recipe->fz_desc.kind!=1)) return NO;
+    const void *raw=(__bridge const void *)ps;
+    if (hm_get_id(&g_rb_draw_candidates,&raw)) return YES;
+    rb_draw_record record={.recipe=*recipe,.pad=pad,.wait_ns=wait,.prepared=prepared};
+    if (task) snprintf(record.task,sizeof record.task,"%s",task);
+    hm_put_id(&g_rb_draw_candidates,&raw,[NSMutableData dataWithBytes:&record length:sizeof record]);
+    return YES;
+}
+static void rb_draw_encoded(id encoder) {
+    if (!t_rb_draw_pipeline || t_rb_draw_encoder!=(__bridge const void *)encoder) return;
+    const void *raw=t_rb_draw_pipeline;
+    t_rb_draw_pipeline=NULL;
+    NSMutableData *data=CFBridgingRelease(nvn_hm_del(&g_rb_draw_candidates,&raw));
+    if (!data) return;
+    rb_draw_record *record=data.mutableBytes;
+    record->frame=atomic_load_explicit(&g_cur_frame,memory_order_relaxed);
+    record->phase=record->frame==0;
+    if (uuid_is_null(g_rb_draw_session)) uuid_generate_random(g_rb_draw_session);
+    memcpy(record->session,g_rb_draw_session,sizeof record->session);
+    os_unfair_lock_lock(&g_wu_lock);
+    if (record->frame>=g_rb_draw_cue_frame && record->frame-g_rb_draw_cue_frame<RB_DRAW_CUE_FRAMES) {
+        if (g_course_current==RB_COURSE_MENU) memcpy(record->cue,"selection_asset",sizeof "selection_asset");
+        if (g_course_current==RB_COURSE_SEQUENCE) memcpy(record->cue,"race_sequence_asset",sizeof "race_sequence_asset");
+        if (g_course_current>=0) memcpy(record->cue,g_course_live.course[g_course_current].name,sizeof record->cue);
+    }
+    os_unfair_lock_unlock(&g_wu_lock);
+    os_unfair_lock_lock(&g_rb_draw_batch_lock);
+    if (!g_rb_draw_batch) g_rb_draw_batch=[NSMutableArray array];
+    [g_rb_draw_batch addObject:data];
+    BOOL full=g_rb_draw_batch.count>=RB_DRAW_BATCH;
+    os_unfair_lock_unlock(&g_rb_draw_batch_lock);
+    if (full || !g_rb_draw_first_saved) { g_rb_draw_first_saved=YES; rb_draw_flush(NO); }
+}
+static NSDictionary<NSString *,NSArray<NSNumber *> *> *g_rb_draw_route_rows;
+static NSArray<NSNumber *> *g_rb_draw_route;
+static NSUInteger g_rb_draw_route_next;
+static _Atomic int g_rb_draw_route_pending;
+static void rb_draw_route_locked(void) {
+    g_rb_draw_route=g_course_current>=0 ? g_rb_draw_route_rows[@(g_course_live.course[g_course_current].name)] : nil;
+    g_rb_draw_route_next=0;
+    atomic_store(&g_rb_draw_route_pending,g_rb_draw_route.count!=0);
+}
+static void rb_draw_cue_locked(uint64_t frame,BOOL transition) {
+    g_rb_draw_cue_frame=frame;
+    if (transition) rb_draw_route_locked();
+}
+static long rb_draw_route_take(void) {
+    if (!atomic_load_explicit(&g_rb_draw_route_pending,memory_order_relaxed)) return 0;
+    os_unfair_lock_lock(&g_wu_lock);
+    long row=0;
+    while (g_rb_draw_route_next<g_rb_draw_route.count) {
+        long next=g_rb_draw_route[g_rb_draw_route_next++].longValue;
+        if (g_wu_claim && next<=g_wu_n && atomic_load(&g_wu_claim[next-1])==RB_ROW_FREE) { row=next; break; }
+    }
+    atomic_store(&g_rb_draw_route_pending,g_rb_draw_route_next<g_rb_draw_route.count);
+    os_unfair_lock_unlock(&g_wu_lock);
+    return row;
+}
+static void rb_draw_frame(uint64_t frame) {
+    if (rb_course_exact() && !(frame%RB_DRAW_FLUSH_FRAMES)) rb_draw_flush(NO);
+}
+static void rb_draw_end(void) {
+    if (atomic_load_explicit(&g_course_exact,memory_order_relaxed)) rb_draw_flush(YES);
+    nvn_hm_clear(&g_rb_draw_candidates,hm_rel);
+    uuid_clear(g_rb_draw_session);
+    g_rb_draw_first_saved=NO;
+    g_rb_draw_cue_frame=0;
+}
