+    assert(rb_drs_report_ticks(1,0,30,0,0,637440) == 637440);
+    assert(rb_drs_report_ticks(1,0,30,0,2,637440) == 717120);
+    assert(rb_drs_report_ticks(1,1,30,0,0,637440) == 717120);
+    assert(rb_drs_report_ticks(1,0,60,30,2,318720) == 318720); // live user cap
+    assert(rb_drs_report_ticks(1,1,60,30,2,318720) == 358560);
+    assert(rb_drs_report_ticks(0,0,60,0,2,318720) == 318720 && rb_drs_report_ticks(0,1,60,0,2,318720) == 318720);
+    puts("PASS guest DRS: measured medians/tails, hold at Fair, 18.675/20.5 ms steps, Serious push, disjoint samples, invalid windows, hysteresis, 30 Hz and off");
 }
