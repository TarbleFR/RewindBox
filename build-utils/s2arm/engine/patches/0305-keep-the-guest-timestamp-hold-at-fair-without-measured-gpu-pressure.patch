-    puts("PASS guest DRS: measured medians/tails, base/20.5/22 ms, disjoint samples, invalid windows, hysteresis, 30 Hz and off");
+    // Fair without measured GPU pressure keeps the 16.6 ms hold; a raised level
+    // steps past the band to 18.675 then 20.5 ms; Serious pushes at every level.
+    assert(rb_drs_report_ticks(1,0,60,0,0,318720) == 318720);
+    assert(rb_drs_report_ticks(1,0,60,0,1,318720) == 358560);
+    assert(rb_drs_report_ticks(1,0,60,0,2,318720) == 393600);
+    assert(rb_drs_report_ticks(1,1,60,0,0,318720) == 358560);
+    assert(rb_drs_report_ticks(1,1,60,0,1,318720) == 358560);
