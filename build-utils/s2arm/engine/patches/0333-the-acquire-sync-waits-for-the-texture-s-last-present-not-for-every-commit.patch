+static int rb_acquire_fence_on(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("S2A_RB_ACQUIRE_FENCE");
+        v = !(e && !strcmp(e, "0"));
+        LOG("[rb-acquire] the acquire sync is published at %s (S2A_RB_ACQUIRE_FENCE; patch 0333)", v ? "the fence of the texture's last present" : "the last committed fence, as in IPA 829");
+    }
+    return v;
+}
+static void rb_acquire_line(void) {   // under g_rb_acq_mu
+    LOG("[rb-acquire] acquires %llu: published below the last fence %llu, texture never presented %llu, window not noted yet %llu; nvnSyncWait sleeps on an acquire sync %llu (%.1f ms), on another sync %llu (%.1f ms); S2A_RB_ACQUIRE_FENCE=%d",
+        (unsigned long long)g_rb_acq.acquires, (unsigned long long)g_rb_acq.older, (unsigned long long)g_rb_acq.never, (unsigned long long)g_rb_acq.unknown,
