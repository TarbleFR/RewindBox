diff --git a/graphics/nvn/gfx/nvn/rb_acquire_fence.h b/graphics/nvn/gfx/nvn/rb_acquire_fence.h
new file mode 100644
index 0000000..1636773
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_acquire_fence.h
@@ -0,0 +1,68 @@
+// RewindBox (patch 0333): the fence an acquired window texture is available at. Pure C.
+//   NVN hands nvnWindowAcquireTexture a sync that is signaled once the display is done with the texture. The host published the last committed fence there, that is every GPU
+//   command the game had submitted, the frame it just presented included: a game thread that waits for that sync on the CPU waits for the end of the previous frame on the GPU
+//   before it builds the next one, so CPU and GPU take turns instead of overlapping. IPA 827, Mario Kart World, iPhone A18 Pro, race at Fair: a game thread other than the
+//   presenting one slept on a fence 0.72 to 0.94 times a frame ([fence-wake] pendingPolls = positiveWaitSleeps), about 2 to 5 ms each; in a light scene running free the game
+//   took 18 ms a frame for 11.1 ms of GPU, with one such sleep a frame, and the sleep went away whenever the display tick paced it.
+//   Here the acquire publishes the fence noted when this texture was last presented: the work that drew into it then. The acquire has already waited for that present to be
+//   taken (nvn_be_present_wait on its ticket), and all GPU work runs on one Metal queue in order, so nothing the game records next can overtake the present's read of the texture.
+//   A texture of a known window that was never presented is available at once (0). A window the table does not know (no present noted yet) keeps the last fence, as before.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_ACQ_WINDOWS = 8, RB_ACQ_TEXTURES = 4, RB_ACQ_RECENT = 8 };
+typedef struct {
+    const void *win[RB_ACQ_WINDOWS];                  // NULL = free
+    uint64_t fence[RB_ACQ_WINDOWS][RB_ACQ_TEXTURES];  // fence noted at the texture's last present, 0 = not presented since the window was noted
+    uint64_t used[RB_ACQ_WINDOWS], clock;             // least recently used window is taken over when all slots are in use
+    const void *recent[RB_ACQ_RECENT];                // the syncs the last acquires published, to classify the waits on them (the [rb-acquire] line)
+    unsigned recent_i;
+    uint64_t acquires, older, unknown, never;         // acquires published: with a fence older than the last one, for a window not noted yet, for a texture never presented
+} rb_acq_table;
+
+static inline void rb_acq_reset(rb_acq_table *t) { memset(t, 0, sizeof *t); }
+static inline int rb_acq_find(const rb_acq_table *t, const void *win) {
+    if (!win) return -1;
+    for (int i = 0; i < RB_ACQ_WINDOWS; i++) if (t->win[i] == win) return i;
+    return -1;
+}
+// The window was initialized again (same object, new swap chain): it is unknown until its next present.
+static inline void rb_acq_forget(rb_acq_table *t, const void *win) {
+    int i = rb_acq_find(t, win);
+    if (i < 0) return;
+    t->win[i] = NULL; memset(t->fence[i], 0, sizeof t->fence[i]); t->used[i] = 0;
+}
+// A present of texture idx of win; fence = the last committed fence when the present was issued (the work that drew into the texture).
+static inline void rb_acq_note(rb_acq_table *t, const void *win, int idx, uint64_t fence) {
+    if (!win || idx < 0 || idx >= RB_ACQ_TEXTURES) return;
+    int i = rb_acq_find(t, win);
+    if (i < 0) {
+        int pick = 0;
+        for (int k = 0; k < RB_ACQ_WINDOWS; k++) {
+            if (!t->win[k]) { pick = k; break; }
+            if (t->used[k] < t->used[pick]) pick = k;
+        }
+        i = pick; t->win[i] = win; memset(t->fence[i], 0, sizeof t->fence[i]);
+    }
+    t->fence[i][idx] = fence; t->used[i] = ++t->clock;
+}
+// The fence to publish for an acquire of texture idx of win, given the last committed fence. Never above last.
+static inline uint64_t rb_acq_fence(rb_acq_table *t, const void *win, int idx, uint64_t last) {
+    t->acquires++;
+    int i = rb_acq_find(t, win);
+    if (i < 0 || idx < 0 || idx >= RB_ACQ_TEXTURES) { t->unknown++; return last; }
+    uint64_t f = t->fence[i][idx];
+    if (!f) t->never++;
+    if (f > last) f = last;
+    if (f < last) t->older++;
+    t->used[i] = ++t->clock;
+    return f;
+}
+// The sync an acquire published (for the wait classification); is s one of the last RB_ACQ_RECENT?
+static inline void rb_acq_published(rb_acq_table *t, const void *s) { if (s) t->recent[t->recent_i++ % RB_ACQ_RECENT] = s; }
+static inline int rb_acq_is_recent(const rb_acq_table *t, const void *s) {
+    if (!s) return 0;
+    for (int i = 0; i < RB_ACQ_RECENT; i++) if (t->recent[i] == s) return 1;
+    return 0;
+}
