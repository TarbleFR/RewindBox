+}
+static uint64_t rb_acquire_publish(const win_t *o, int idx, const NVNsync *s) {   // the fence an acquire of texture idx publishes
+    uint64_t last = nvn_be_last_fence(), f = last;
+    int on = rb_acquire_fence_on();
+    pthread_mutex_lock(&g_rb_acq_mu);
+    uint64_t got = rb_acq_fence(&g_rb_acq, o, idx, last);
+    if (on) f = got;
+    rb_acq_published(&g_rb_acq, s);
+    if (g_rb_acq.acquires % 1800 == 0) rb_acquire_line();
+    pthread_mutex_unlock(&g_rb_acq_mu);
+    return f;
+}
+static void rb_acquire_note(const win_t *o, int idx, uint64_t fence) {   // a present of texture idx, fence = the last committed fence when it was issued
+    pthread_mutex_lock(&g_rb_acq_mu); rb_acq_note(&g_rb_acq, o, idx, fence); pthread_mutex_unlock(&g_rb_acq_mu);
+}
+static void rb_acquire_sleep(const NVNsync *s, uint64_t ns) {
+    pthread_mutex_lock(&g_rb_acq_mu);
+    int k = rb_acq_is_recent(&g_rb_acq, s);
+    g_rb_acq_sleep_n[k]++; g_rb_acq_sleep_ns[k] += ns;
+    pthread_mutex_unlock(&g_rb_acq_mu);
+}
