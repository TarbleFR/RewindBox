diff --git a/graphics/nvn/host/rb_external_key.h b/graphics/nvn/host/rb_external_key.h
new file mode 100644
index 0000000..7d0b611
--- /dev/null
+++ b/graphics/nvn/host/rb_external_key.h
@@ -0,0 +1,30 @@
+// The reference producers hash different views of one validated NVN2 program.
+// kartnative 47f2d1d nvn_shader_key.h; plumber-racer-2 843170a hle_nvn.c:keys_hash.
+// No control-only key is a witness. S2Arm retains its own nvn2_key unchanged.
+#pragma once
+static int rb_external_key(char source,const uint8_t *ctl,size_t nt,const uint8_t *code,size_t nc,char hex[17]) {
+    if ((source!='K' && source!='P') || !ctl || nt<0xd8 || !nvn2_ctl(ctl) ||
+        !code || !nc || nc>=(1u<<24) || nvn2_code_len(ctl)!=nc) return 0;
+    CC_SHA256_CTX hash;
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256_Init(&hash);
+    if (source=='K') {
+        CC_SHA256_Update(&hash,ctl,0xd8);
+    } else {
+        uint8_t header[0x48];
+        memcpy(header,ctl,sizeof header); memset(header+0x30,0,4);
+        CC_SHA256_Update(&hash,header,sizeof header);
+    }
+    CC_SHA256_Update(&hash,code,(unsigned)nc);
+    CC_SHA256_Final(digest,&hash);
+    static const char digits[]="0123456789abcdef";
+    for (unsigned i=0;i<8;i++) { hex[2*i]=digits[digest[i]>>4]; hex[2*i+1]=digits[digest[i]&15]; }
+    hex[16]=0;
+    return 1;
+}
+
+// DSH translator IDs are not the stage numbers in a Metal warming row.
+static int rb_external_render_stage(int dsh) {
+    static const int render[]={0,1,5,2,3,4}; // vs, ps, cs, gs, task, mesh
+    return (unsigned)dsh<sizeof render/sizeof render[0] ? render[dsh] : -1;
+}
diff --git a/graphics/nvn/host/rb_external_stages.inc b/graphics/nvn/host/rb_external_stages.inc
new file mode 100644
index 0000000..41fa1c8
--- /dev/null
+++ b/graphics/nvn/host/rb_external_stages.inc
@@ -0,0 +1,141 @@
+// Scope the alias index to the exact external manifest, and rebuild each alias
+// from the control and GPU bytes observed in the user's own imported game.
+#include "rb_external_key.h"
+#define RB_EXT_HEADER "# rb-external-stages-v1\t0400C3F00006E000\t9e244438c3d8ef1c703a6a85ef99c4f0"
+#define RB_EXT_MAP_HEADER "# rb-external-stage-map-v1\t0400C3F00006E000\t9e244438c3d8ef1c703a6a85ef99c4f0"
+enum { RB_EXT_MAX = 16384 };
+@interface RBStageAliases : NSObject {
+@public
+    NSMutableOrderedSet<NSString *> *requested;
+    NSMutableDictionary<NSString *,NSString *> *resolved;
+    NSMutableDictionary<NSString *,NSNumber *> *inputStages;
+    NSMutableSet<NSString *> *conflicts;
+    NSMutableDictionary<NSString *,NSString *> *witnesses, *saved;
+    NSString *indexName;
+    unsigned active[2];
+    BOOL rejected;
+}
+@end
+@implementation RBStageAliases @end
+
+static NSString *rb_alias_id(char src,int stage,const char *hex) {
+    return [NSString stringWithFormat:@"%c%d%s",src,stage,hex];
+}
+static BOOL rb_read_external(NSString *wire,RBStageAliases *a) {
+    NSString *path=[wire stringByAppendingPathComponent:@"external-stages.tsv"];
+    FILE *f=fopen(path.fileSystemRepresentation,"r");
+    if (!f) return errno==ENOENT;
+    char line[128],hex[17]; unsigned size=0,expected=sizeof(RB_EXT_HEADER)-1;
+    CC_SHA256_CTX hc; CC_SHA256_Init(&hc);
+    a->requested=[NSMutableOrderedSet orderedSet]; a->resolved=[NSMutableDictionary dictionary];
+    a->witnesses=[NSMutableDictionary dictionary]; a->saved=[NSMutableDictionary dictionary];
+    a->inputStages=[NSMutableDictionary dictionary]; a->conflicts=[NSMutableSet set];
+    if (!fgets(line,sizeof line,f) || strncmp(line,RB_EXT_HEADER,expected) || strcmp(line+expected,"\n")) a->rejected=YES;
+    while (!a->rejected && fgets(line,sizeof line,f)) {
+        size=(unsigned)strlen(line);
+        if (size!=21 || (line[0]!='K' && line[0]!='P') || line[1]!='\t' || line[18]!='\t' ||
+            !strchr("01345",line[19]) || line[20]!='\n' || strspn(line+2,"0123456789abcdef")!=16 ||
+            a->requested.count>=RB_EXT_MAX) { a->rejected=YES; break; }
+        memcpy(hex,line+2,16); hex[16]=0;
+        [a->requested addObject:rb_alias_id(line[0],line[19]-'0',hex)];
+        a->active[line[0]=='P']=1;
+        CC_SHA256_Update(&hc,line,size);
+    }
+    int io=ferror(f); fclose(f);
+    if (io) return NO;
+    if (a->rejected) { [a->requested removeAllObjects]; a->active[0]=a->active[1]=0; return YES; }
+    unsigned char md[CC_SHA256_DIGEST_LENGTH]; CC_SHA256_Final(md,&hc);
+    char sha[65];
+    for (unsigned i=0;i<sizeof md;i++) snprintf(sha+2*i,3,"%02x",md[i]);
+    if (a->requested.count) a->indexName=[NSString stringWithFormat:@"stage-index-external-v1-%s.tsv",sha];
+    return YES;
+}
+static void rb_alias_record(RBStageAliases *a,NSString *alias,NSString *native) {
+    NSString *old=a->resolved[alias];
+    if (!old) a->resolved[alias]=native;
+    else if (![old isEqual:native]) a->resolved[alias]=@"!";
+}
+// S2Arm intentionally masks the live address and relocated length. Check all
+// remaining control bytes and the full code to catch stale inputs and prevent
+// two external candidates sharing a truncated native key from being conflated.
+static NSString *rb_alias_witness(const uint8_t *ctl,unsigned nt,const uint8_t *code,unsigned nc) {
+    uint8_t header[NVN2_CTL_COPY], md[CC_SHA256_DIGEST_LENGTH];
+    memcpy(header,ctl,nt); memset(header+0x20,0,8); memset(header+0x30,0,4);
+    CC_SHA256_CTX hc; CC_SHA256_Init(&hc); CC_SHA256_Update(&hc,header,nt);
+    CC_SHA256_Update(&hc,code,nc); CC_SHA256_Final(md,&hc);
+    char hex[65]; for (unsigned i=0;i<sizeof md;i++) snprintf(hex+2*i,3,"%02x",md[i]);
+    return @(hex);
+}
+static void rb_alias_expect(RBStageAliases *a,NSString *native,NSString *witness) {
+    NSString *old=a->witnesses[native];
+    if (!old) a->witnesses[native]=witness;
+    else if (![old isEqual:witness]) [a->conflicts addObject:native];
+}
+
+static int rb_alias_input(RBStageAliases *a,NSString *native,int stage,const char *out) {
+    if ([a->conflicts containsObject:native]) return -1;
+    NSNumber *known=a->inputStages[native];
+    if (!known) {
+        uint32_t h[4]; uint8_t *input=dsh_read_input(out,native.UTF8String,h,1);
+        if (!input) return 0;
+        a->saved[native]=rb_alias_witness(input,h[2],input+h[2],h[3]);
+        free(input); known=@(rb_external_render_stage((int)h[1])); a->inputStages[native]=known;
+    }
+    if (known.intValue!=stage) { [a->conflicts addObject:native]; return -1; }
+    return [a->saved[native] isEqual:a->witnesses[native]];
+}
+
+// Aliases are kept per pack-index row, alongside the original native-key
+// inventory. They are committed only for completed assets; cancellation repeats
+// at most the partial asset. The original native-only index remains readable.
+static BOOL rb_alias_candidate(RBStageAliases *a,NSMutableOrderedSet *entries,NSString *native,int dsh,
+                               const uint8_t *ctl,unsigned nt,const uint8_t *code,unsigned nc,int *overflow) {
+    if (!a->indexName) return NO;
+    int stage=rb_external_render_stage(dsh);
+    BOOL matched=NO; NSString *witness=nil;
+    for (int i=0;i<2;i++) {
+        char src=i?'P':'K', hex[17];
+        if (!a->active[i] || !rb_external_key(src,ctl,nt,code,nc,hex)) continue;
+        NSString *alias=rb_alias_id(src,stage,hex);
+        if (![a->requested containsObject:alias]) continue;
+        if (!witness) { witness=rb_alias_witness(ctl,nt,code,nc); rb_alias_expect(a,native,witness); }
+        rb_alias_record(a,alias,native);
+        NSString *entry=[NSString stringWithFormat:@"%@=%@:%@",alias,native,witness];
+        if ([entries containsObject:entry] || entries.count<RB_EXT_MAX) [entries addObject:entry];
+        else *overflow=1;
+        matched=YES;
+    }
+    return matched;
+}
+static int rb_cached_alias(RBStageAliases *a,char *token,NSMutableDictionary *asset,const char *out) {
+    if (!a->indexName || strlen(token)!=100 || token[18]!='=' || token[35]!=':' || (token[0]!='K' && token[0]!='P') ||
+        !strchr("01345",token[1]) || strspn(token+2,"0123456789abcdef")!=16 ||
+        strspn(token+19,"0123456789abcdef")!=16 || strspn(token+36,"0123456789abcdef")!=64) return -2;
+    token[18]=token[35]=0; NSString *alias=@(token), *native=@(token+19);
+    if (![a->requested containsObject:alias]) return -2;
+    NSString *old=asset[alias];
+    asset[alias]=old && ![old isEqual:native] ? @"!" : native;
+    rb_alias_expect(a,native,@(token+36));
+    return rb_alias_input(a,native,token[1]-'0',out);
+}
+static BOOL rb_alias_report(RBStageAliases *a,NSMutableSet *failed,NSString *wire) {
+    NSString *p=[wire stringByAppendingPathComponent:@"external-stage-map.tsv"];
+    if (!a->requested) { if (unlink(p.fileSystemRepresentation) && errno!=ENOENT) return NO; return YES; }
+    NSMutableString *text=[NSMutableString stringWithString:[@(RB_EXT_MAP_HEADER) stringByAppendingString:@"\n"]];
+    NSUInteger kept=0,missing=0,ambiguous=0,refused=0;
+    for (NSString *alias in a->requested) {
+        NSString *key=a->resolved[alias];
+        if (!key) { key=@"-"; missing++; }
+        else if ([key isEqual:@"!"] || [a->conflicts containsObject:key]) { key=@"!"; ambiguous++; }
+        else if ([failed containsObject:key]) { key=@"?"; refused++; }
+        else kept++;
+        const char *s=alias.UTF8String;
+        [text appendFormat:@"%c\t%s\t%c\t%@\n",s[0],s+2,s[1],key];
+    }
+    LOG("RewindBox: imported shader identities: %zu verified and ready, %zu unlocated in inspected resources, %zu ambiguous, %zu translation refusals, incompatible request %d",
+        (size_t)kept,(size_t)missing,(size_t)ambiguous,(size_t)refused,(int)a->rejected);
+    NSDictionary *counts=@{@"verifiedReady":@(kept),@"unlocated":@(missing),@"ambiguous":@(ambiguous),
+                           @"translationRefused":@(refused),@"incompatibleRequest":@(a->rejected)};
+    return [text writeToFile:p atomically:YES encoding:NSUTF8StringEncoding error:NULL] &&
+        [counts writeToFile:[wire stringByAppendingPathComponent:@"external-stage-counts.plist"] atomically:YES];
+}
