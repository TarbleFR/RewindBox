diff --git a/graphics/nvn/gfx/nvn/rb_dsnap_rule.h b/graphics/nvn/gfx/nvn/rb_dsnap_rule.h
new file mode 100644
index 0000000..fcb47fa
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_dsnap_rule.h
@@ -0,0 +1,18 @@
+// RewindBox (patch 0314): when a draw makes the same-pass depth copy (#387, nvn_mtl.m g_dsnap) stale, after upstream S2Arm 864e92cf1. Pure C: tests/t_rb_dsnap_rule.c.
+//   A draw writing depth always does. A stencil write only matters to a copy read through a stencil view (the copy is a texture of its own; a depth view of it holds the depth
+//   plane, which a stencil write leaves as it was), and it counts only when a stencil op is not KEEP (sd_note's wwhy 5). A deferred lighting pass (one light volume per draw,
+//   stencil test on, depth writes off, each draw sampling the depth) used to end the pass and copy the whole depth for every light. strict (DM_NVN_DSNAP_STRICT=1): the old rule,
+//   any stencil write mask
+#pragma once
+enum { RB_DSNAP_OP_KEEP = 0x1 };   // NVN_STENCIL_OP_KEEP
+typedef struct { int depth_test, depth_write, stencil_test; unsigned wmask_front, wmask_back; int ops[6]; } rb_dsnap_draw;   // ops: fail, zfail, zpass front then back
+static inline int rb_dsnap_stencil_writes(const rb_dsnap_draw *d, int strict) {
+    if (!d->stencil_test || !(d->wmask_front || d->wmask_back)) return 0;
+    if (strict) return 1;
+    for (int i = 0; i < 6; i++) if (d->ops[i] != RB_DSNAP_OP_KEEP) return 1;
+    return 0;
+}
+static inline int rb_dsnap_stales(const rb_dsnap_draw *d, int strict, int copy_reads_stencil) {
+    if (d->depth_test && d->depth_write) return 1;
+    return rb_dsnap_stencil_writes(d, strict) && (strict || copy_reads_stencil);
+}
