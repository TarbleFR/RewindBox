     S.ds.dt=1; S.ds.dw=1; S.ds.df=8; g_pso_dirty=1; draw(triangle,NULL);   // writes depth (and samples it: a fresh copy of the depth before this draw)
     S.ds.dw=0; g_pso_dirty=1; uint64_t c2=g_fb_depth; draw(triangle,NULL);
     CHECK(g_fb_depth-c2==1,"after a depth-writing draw the next sampling draw copies again (new copies %llu)",(unsigned long long)(g_fb_depth-c2));
+    // Stencil writes leave the depth plane a depth-view copy holds as it was: with the stencil test on and an op that writes (REPLACE on pass, write mask 0xff),
+    //   two more sampling draws still read the copy (a deferred lighting pass: one light volume per draw, stencil on, depth writes off). The old rule copied for each
+    uint64_t sc=g_fb_depth, sr=g_fb_depth_reuse, sp=g_stat_pass;
+    S.ds.st=1; S.st_wmask[0]=S.st_wmask[1]=0xff; S.ds.zpass_f=S.ds.zpass_b=NVN_STENCIL_OP_REPLACE; g_pso_dirty=1;
+    draw(triangle,NULL); draw(triangle,NULL);
+    CHECK(g_fb_depth==sc && g_fb_depth_reuse-sr==2 && g_stat_pass==sp,"stencil-writing draws sampling the depth: reuse the depth-view copy (new copies %llu, reuses %llu, passes opened %llu)",
+        (unsigned long long)(g_fb_depth-sc),(unsigned long long)(g_fb_depth_reuse-sr),(unsigned long long)(g_stat_pass-sp));
+    S.ds.st=0; S.ds.zpass_f=S.ds.zpass_b=NVN_STENCIL_OP_KEEP; g_pso_dirty=1;
     finish(); CHECK(!mtl_last_commit_error(),"depth attachment sampled in its own pass: submission completes without a Metal error");
     // Audit P2-247: a whole-surface depth clear with no pass open is only recorded (R.clear_d, folded into the next pass's load action). A draw sampling that depth in the pass must
     //   see the cleared value, as on the Switch the clear is in memory before the draw runs: the copy is taken after the clear lands. Expected 0.75 (the clear), never the old 0.25
diff --git a/graphics/nvn/tests/t_rb_dsnap_rule.c b/graphics/nvn/tests/t_rb_dsnap_rule.c
new file mode 100644
index 0000000..d6b99dd
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_dsnap_rule.c
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0314): host-only checks of the same-pass depth copy's staleness rule (gfx/nvn/rb_dsnap_rule.h, after upstream S2Arm 864e92cf1).
+#include <assert.h>
+#include <stdio.h>
+#include "../gfx/nvn/rb_dsnap_rule.h"
+
+enum { KEEP = RB_DSNAP_OP_KEEP, REPLACE = 0x3 };
+static rb_dsnap_draw draw(int dt, int dw, int st, unsigned wf, unsigned wb, int op) {
+    rb_dsnap_draw d = {dt, dw, st, wf, wb, {KEEP, KEEP, KEEP, KEEP, KEEP, KEEP}};
+    if (op) d.ops[2] = op;   // zpass front
+    return d;
+}
+int main(void) {
+    // ① a depth-writing draw stales the copy, whatever the view and the rule
+    rb_dsnap_draw w = draw(1, 1, 0, 0, 0, 0);
+    assert(rb_dsnap_stales(&w, 0, 0) && rb_dsnap_stales(&w, 1, 0) && rb_dsnap_stales(&w, 0, 1));
+    // … not when the depth test is off (no depth write happens)
+    rb_dsnap_draw nt = draw(0, 1, 0, 0, 0, 0);
+    assert(!rb_dsnap_stales(&nt, 0, 0));
+    // ② the deferred lighting draw: stencil test on, write mask 0xff, REPLACE on pass, depth writes off
+    rb_dsnap_draw light = draw(1, 0, 1, 0xff, 0xff, REPLACE);
+    assert(rb_dsnap_stencil_writes(&light, 0));
+    assert(!rb_dsnap_stales(&light, 0, 0));   // a depth-view copy stays current
+    assert(rb_dsnap_stales(&light, 0, 1));    // a stencil-view copy goes stale
+    assert(rb_dsnap_stales(&light, 1, 0));    // DM_NVN_DSNAP_STRICT=1: the old rule
+    // ③ a write mask with every op KEEP writes nothing: not even a stencil-view copy goes stale (the old rule still staled it)
+    rb_dsnap_draw keep = draw(1, 0, 1, 0xff, 0, 0);
+    assert(!rb_dsnap_stencil_writes(&keep, 0) && !rb_dsnap_stales(&keep, 0, 1));
+    assert(rb_dsnap_stales(&keep, 1, 0));
+    // ④ each of the six ops counts, front and back
+    for (int i = 0; i < 6; i++) {
+        rb_dsnap_draw d = draw(0, 0, 1, i < 3 ? 0xff : 0, i < 3 ? 0 : 0xff, 0);
+        d.ops[i] = REPLACE;
+        assert(rb_dsnap_stencil_writes(&d, 0) && rb_dsnap_stales(&d, 0, 1) && !rb_dsnap_stales(&d, 0, 0));
+    }
+    // ⑤ no stencil test, or a zero write mask: no stencil write
+    rb_dsnap_draw off = draw(1, 0, 0, 0xff, 0xff, REPLACE), mask0 = draw(1, 0, 1, 0, 0, REPLACE);
+    assert(!rb_dsnap_stales(&off, 0, 1) && !rb_dsnap_stales(&off, 1, 1));
+    assert(!rb_dsnap_stales(&mask0, 0, 1) && !rb_dsnap_stales(&mask0, 1, 1));
+    puts("t_rb_dsnap_rule: ok");
+    return 0;
+}
