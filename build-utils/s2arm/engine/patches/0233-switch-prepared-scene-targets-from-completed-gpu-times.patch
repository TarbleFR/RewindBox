+// Read the entire physical image, including the destination pixels outside a copied subrectangle.
+static void read_d32(NVNtexture *t, int w, int h, float *out) {
+    NVNcopyRegion full={0,0,0,w,h,1};
+    size_t bytes=(size_t)w*h*sizeof(float);
+    REQUIRE(BUF_OFFSET+bytes <= (4u<<20));
+    memset((char *)storage+BUF_OFFSET,0xff,bytes);
+    NVNbufferAddress address=API(nvnMemoryPoolGetBufferAddress)(&pool)+BUF_OFFSET;
+    begin(); API(nvnCommandBufferCopyTextureToBuffer)(&commands,t,NULL,&full,address,0); submit();
+    memcpy(out,(char *)storage+BUF_OFFSET,bytes);
+    int sw=0,sh=0;
+    REQUIRE(nvn_be_tex_storage_size(t,&sw,&sh)>=0 && sw==w && sh==h);
+    REQUIRE(API(nvnTextureGetFormat)(t)==NVN_FORMAT_DEPTH32F);
+}
+
+// At an exact rational texel boundary the GPU's float product may round one ULP
+// below it before uint2(st). No tolerance away from a mathematical boundary.
+static int nearest_axis(int pos, int src, int dst, int start, int out[2]) {
+    int n=(2*pos+1)*src, d=2*dst;
+    out[0]=start+n/d;
+    if (n%d || n/d==0) return 1;
+    out[1]=out[0]-1; return 2;
+}
+static void expect_d32(const float *source, int sw, const float *actual, int dw, int dh,
+                       NVNcopyRegion sr, NVNcopyRegion dr, float sentinel) {
+    unsigned ties=0;
+    for (int y=0;y<dh;y++) for (int x=0;x<dw;x++) {
+        float got=actual[y*dw+x];
+        if (x<dr.xoffset || x>=dr.xoffset+dr.width || y<dr.yoffset || y>=dr.yoffset+dr.height) {
+            REQUIRE(got==sentinel); continue;
+        }
+        int sx[2],sy[2];
+        int nx=nearest_axis(x-dr.xoffset,sr.width,dr.width,sr.xoffset,sx);
+        int ny=nearest_axis(y-dr.yoffset,sr.height,dr.height,sr.yoffset,sy);
+        int ok=0;
+        for (int j=0;j<ny;j++) for (int i=0;i<nx;i++) ok |= got==source[sy[j]*sw+sx[i]];
+        if (!ok) fprintf(stderr,"D32 mismatch at (%d,%d), got %.8f, nearest at (%d,%d) = %.8f\n",
+                         x,y,got,sx[0],sy[0],source[sy[0]*sw+sx[0]]);
+        REQUIRE(ok); ties+=nx>1 || ny>1;
+    }
+    printf("D32 %dx%d -> %dx%d, %u pixels exactly on a source texel boundary\n",sr.width,sr.height,dr.width,dr.height,ties);
+}
+static void d32_scene_tiers(void) {
+    const int widths[]={960,816,720},heights[]={540,459,405};
+    const unsigned route[]={0,1,2,1,0};
+    const float sentinel=0.9375f;
+    NVNtexture tex[3];
+    size_t bytes=(size_t)widths[0]*heights[0]*sizeof(float);
+    float *prev=malloc(bytes),*got=malloc(bytes);
+    REQUIRE(prev && got);
+    for (unsigned i=0;i<3;i++) {
+        make_tex_extent(&tex[i],NVN_FORMAT_DEPTH32F,NVN_TEXTURE_FLAGS_COMPRESSIBLE,NULL,widths[i],heights[i]);
+        REQUIRE(API(nvnTextureGetWidth)(&tex[i])==widths[i] && API(nvnTextureGetHeight)(&tex[i])==heights[i]);
+        // Materialize a renderable private depth target before any copy.
+        begin(); API(nvnCommandBufferSetRenderTargets)(&commands,0,NULL,NULL,&tex[i],NULL);
+        API(nvnCommandBufferSetScissor)(&commands,0,0,widths[i],heights[i]);
+        API(nvnCommandBufferClearDepthStencil)(&commands,sentinel,1,0,0); submit();
+    }
+    for (int y=0;y<heights[0];y++) for (int x=0;x<widths[0];x++)
+        prev[y*widths[0]+x]=(float)(1+y*widths[0]+x)*0x1p-20f; // every original pixel is distinct and exactly representable
+    memcpy((char *)storage+BUF_OFFSET,prev,bytes);
+    NVNcopyRegion full={0,0,0,widths[0],heights[0],1};
+    NVNbufferAddress address=API(nvnMemoryPoolGetBufferAddress)(&pool)+BUF_OFFSET;
+    begin(); API(nvnCommandBufferCopyBufferToTexture)(&commands,address,&tex[0],NULL,&full,0); submit();
+    read_d32(&tex[0],widths[0],heights[0],got); REQUIRE(!memcmp(prev,got,bytes));
+    for (unsigned i=1;i<sizeof(route)/sizeof(*route);i++) {
+        unsigned s=route[i-1],d=route[i];
+        NVNcopyRegion sr={0,0,0,widths[s],heights[s],1},dr={0,0,0,widths[d],heights[d],1};
+        begin(); API(nvnCommandBufferCopyTextureToTexture)(&commands,&tex[s],NULL,&sr,&tex[d],NULL,&dr,0); submit();
+        read_d32(&tex[d],widths[d],heights[d],got);
+        expect_d32(prev,widths[s],got,widths[d],heights[d],sr,dr,sentinel);
+        float *tmp=prev; prev=got; got=tmp; // source samples have already passed the independent nearest oracle
+    }
+    // Offset odd-sized regions and verify the clear sentinel surrounding the entire result.
+    NVNcopyRegion sr={7,13,0,753,415,1},dr={9,9,0,671,363,1};
+    begin(); API(nvnCommandBufferSetRenderTargets)(&commands,0,NULL,NULL,&tex[2],NULL);
+    API(nvnCommandBufferSetScissor)(&commands,0,0,widths[2],heights[2]);
+    API(nvnCommandBufferClearDepthStencil)(&commands,sentinel,1,0,0);
+    API(nvnCommandBufferCopyTextureToTexture)(&commands,&tex[0],NULL,&sr,&tex[2],NULL,&dr,0); submit();
+    read_d32(&tex[2],widths[2],heights[2],got); expect_d32(prev,widths[0],got,widths[2],heights[2],sr,dr,sentinel);
+    for (unsigned i=0;i<3;i++) API(nvnTextureFinalize)(&tex[i]);
+    free(prev); free(got); done();
+}
