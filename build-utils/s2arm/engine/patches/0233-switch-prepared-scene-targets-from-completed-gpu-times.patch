+// Only exact direct references can be republished. An upscale restores the
+// entire alias cohort (including a sharing-table-only root). A reduction needs
+// one effective serial and no other serial, package or derived storage owner.
+static BOOL rb_drs_source_locked(NvRBDrsBank *b, unsigned tier) {
+    unsigned flags=rb_drs_backing_locked(b,b->texture[b->active]);
+    // A pool argument table retains its resource IDs until its next scan. Direct
+    // texture-ID caches observe g_ser_gen, but the pool scan can run only once
+    // per submission. Its pin includes the root when a slot holds a format view.
+    if (!flags || (flags & RB_DRS_INDIRECT) || (tier && pool_pin_held((__bridge void *)b->texture[b->active]))) return NO;
+    return !tier || (rb_drs_live_locked(b) && (flags & RB_DRS_OWN) && !(flags & RB_DRS_FOREIGN));
+}
+static BOOL rb_drs_writable_locked(NvRBDrsBank *b,unsigned tier) {
+    id<MTLTexture> dst=b->texture[tier];
+    return dst && !rb_drs_backing_locked(b,dst) && !pool_pin_held((__bridge void *)dst);
+}
+static BOOL rb_drs_fx_locked(NvRBDrsBank *const fx[3], unsigned tier) {
+    for (unsigned i=0;i<3;i++) if (!rb_drs_source_locked(fx[i],tier)) return NO;
+    return YES;
+}
+static BOOL rb_drs_transition(unsigned tier) {
+    NvRBDrsBank *banks[RB_DRS_BANKS], *fx_banks[3]; unsigned previous[RB_DRS_BANKS], n=0;
+    NSUInteger usage[4]={0}; uint64_t fx[3]={0};
+    rb_drs_prune();
+    g_rb_drs_hold="metalfx-not-ready";
+    if (tier && (!rb_drs_fx_inputs(fx) || !rb_drs_input_ids(tier,rb_drs_fx_ready_mask(),fx) || !rb_drs_fx_usage(tier,usage))) return NO;
+    for (unsigned i=0;tier && i<3;i++) {
+        NvRBDrsBank *b=rb_drs_bank(fx[i]);
+        g_rb_drs_hold=!b ? "fx-input-not-admitted" : b->nativeOnly ? "fx-input-native-only" : "fx-usage-or-worker";
+        if (!b || b->nativeOnly || atomic_load_explicit(&b->ready,memory_order_acquire)!=1 ||
+            (usage[i]&~b->texture[tier].usage)) return NO;
+        fx_banks[i]=b;
+    }
+    uint64_t bytes=0, generation;
+    g_rb_drs_hold="alias-or-stale";
+    pthread_mutex_lock(&g_smu);
+    if (tier && !rb_drs_fx_locked(fx_banks,tier)) goto reject;
+    generation=g_ser_gen;
+    for (unsigned i=0;i<g_rb_drs_count;i++) {
+        NvRBDrsBank *b=g_rb_drs_banks[i];
+        if (b->active==tier || (!b->active && b->nativeOnly)) continue;
+        if (!b->active && !rb_drs_live_locked(b)) continue;
+        int ready=atomic_load_explicit(&b->ready,memory_order_acquire);
+        if (!b->active && ready<0) continue;  // permanently unavailable optional bank stays native
+        if (ready!=1) { g_rb_drs_hold="bank-preparation"; goto reject; }
+        if (!rb_drs_source_locked(b,tier) || !rb_drs_writable_locked(b,tier)) goto reject;
+        bytes+=b->texture[b->active].allocatedSize+b->texture[tier].allocatedSize;
+        previous[n]=b->active; banks[n++]=b;
+    }
+    pthread_mutex_unlock(&g_smu);
+    if (g_enc || !g_cb || !rb_drs_copy_budget(tier,n,bytes)) { g_rb_drs_hold="boundary-or-copy-budget"; return NO; }
+    enc_close_blit();
+    for (unsigned i=0;i<n;i++) {
+        rb_drs_enroll(banks[i]);
+        if (!rb_drs_copy(banks[i],previous[i],tier)) { g_rb_drs_hold="copy-encoder"; return NO; }
+    }
+    pthread_mutex_lock(&g_smu);
+    if (generation!=g_ser_gen || (tier && !rb_drs_fx_locked(fx_banks,tier))) goto reject;
+    for (unsigned i=0;i<n;i++)
+        if (!rb_drs_source_locked(banks[i],tier) || !rb_drs_writable_locked(banks[i],tier)) goto reject;
+    for (unsigned i=0;i<n;i++) {
+        NvRBDrsBank *b=banks[i];
+        rb_swap_storage_locked(b->texture[previous[i]],b->texture[tier]);
+        b->active=tier;
+    }
+    pthread_mutex_unlock(&g_smu);
+    for (unsigned i=0;i<n;i++)
+        rs_scene_replace(banks[i]->texture[previous[i]],banks[i]->texture[tier]);
+    g_rb_drs_hold="none";
+    return YES;
+reject:
+    pthread_mutex_unlock(&g_smu);
+    return NO;
+}
+static void rb_drs_log(unsigned from, unsigned to, const char *cause, uint64_t frame, double mean) {
+    MLOG("[rb-drs] frame=%llu cause=%s scale=%u->%u thermal=%d gpu_mean_ms=%.3f banks=%u migration_copies_total=%llu migration_backing_bytes_total=%llu held_total=%llu held_reason=%s",
+         (unsigned long long)frame,cause,rb_drs_percent(from),rb_drs_percent(to),g_rb_drs_heat,mean,
+         g_rb_drs_count,(unsigned long long)g_rb_drs_copies,(unsigned long long)g_rb_drs_bytes,(unsigned long long)g_rb_drs_blocked,g_rb_drs_hold);
