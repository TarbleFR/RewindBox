+// SPDX-License-Identifier: MIT
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { unsigned x,y,w,h; } Rect;
+static void check(int valid,const char *message) {
+    if (!valid) { fprintf(stderr,"D32 tracked failure: %s\n",message); exit(1); }
+}
+static void finish(id<MTLCommandBuffer> cb) {
+    [cb commit]; [cb waitUntilCompleted];
+    if (cb.status!=MTLCommandBufferStatusCompleted) {
+        fprintf(stderr,"D32 GPU error: %s\n",cb.error.localizedDescription.UTF8String); exit(1);
+    }
+}
+static NSUInteger pitch(NSUInteger w) { return (w*sizeof(float)+255u)&~(NSUInteger)255u; }
+static void readback(id<MTLCommandQueue> q,id<MTLTexture> tex,float *out) {
+    NSUInteger w=tex.width,h=tex.height,row=pitch(w);
+    id<MTLBuffer> buffer=[q.device newBufferWithLength:row*h options:MTLResourceStorageModeShared];
+    check(buffer!=nil,"readback allocation"); memset(buffer.contents,0xff,row*h);
+    id<MTLCommandBuffer> cb=[q commandBuffer]; id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];
+    [blit copyFromTexture:tex sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+               sourceSize:MTLSizeMake(w,h,1) toBuffer:buffer destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:row*h];
+    [blit endEncoding]; finish(cb);
+    for (NSUInteger y=0;y<h;y++) memcpy(out+y*w,(const char *)buffer.contents+y*row,w*sizeof(float));
+}
+static void upload(id<MTLCommandQueue> q,id<MTLTexture> texture,const float *pixels) {
+    NSUInteger w=texture.width,h=texture.height,row=pitch(w);
+    id<MTLBuffer> buffer=[q.device newBufferWithLength:row*h options:MTLResourceStorageModeShared];
+    check(buffer!=nil,"upload allocation");
+    for (NSUInteger y=0;y<h;y++) memcpy((char *)buffer.contents+y*row,pixels+y*w,w*sizeof(float));
+    id<MTLCommandBuffer> cb=[q commandBuffer]; id<MTLBlitCommandEncoder> blit=[cb blitCommandEncoder];
+    [blit copyFromBuffer:buffer sourceOffset:0 sourceBytesPerRow:row sourceBytesPerImage:row*h sourceSize:MTLSizeMake(w,h,1)
+               toTexture:texture destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    [blit endEncoding]; finish(cb);
+}
+static void draw(id<MTLCommandQueue> q,id<MTLRenderPipelineState> ps,id<MTLDepthStencilState> ds,
+                 id<MTLSamplerState> sampler,id<MTLTexture> src,id<MTLTexture> dst,Rect sr,Rect dr,int partial) {
+    id<MTLCommandBuffer> cb=[q commandBuffer];
+    MTLRenderPassDescriptor *rp=[MTLRenderPassDescriptor renderPassDescriptor];
+    rp.depthAttachment.texture=dst;
+    rp.depthAttachment.storeAction=MTLStoreActionStore;
+    if (partial) {
+        rp.depthAttachment.clearDepth=.9375; rp.depthAttachment.loadAction=MTLLoadActionClear;
+        id<MTLRenderCommandEncoder> e=[cb renderCommandEncoderWithDescriptor:rp]; check(e!=nil,"sentinel clear"); [e endEncoding];
+    }
+    rp.depthAttachment.loadAction=partial?MTLLoadActionLoad:MTLLoadActionDontCare;
+    id<MTLRenderCommandEncoder> e=[cb renderCommandEncoderWithDescriptor:rp]; check(e!=nil,"depth render encoder");
+    [e setRenderPipelineState:ps]; [e setDepthStencilState:ds];
+    float params[8]={(float)sr.x,(float)sr.y,(float)sr.w/dr.w,(float)sr.h/dr.h,
+                     (float)dr.x,(float)dr.y,(float)src.width,(float)src.height};
+    [e setFragmentTexture:src atIndex:0]; [e setFragmentSamplerState:sampler atIndex:0];
+    [e setFragmentBytes:params length:sizeof(params) atIndex:0];
+    [e setViewport:(MTLViewport){dr.x,dr.y,dr.w,dr.h,0,1}]; [e setScissorRect:(MTLScissorRect){dr.x,dr.y,dr.w,dr.h}];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; [e endEncoding]; finish(cb);
+}
+// The runtime casts the computed source texel to uint2. An exact rational edge may
+// round one float ULP below that edge; only in that case accept either adjacent texel.
+static int axis(unsigned j,unsigned sw,unsigned dw,unsigned start,unsigned out[2]) {
+    unsigned n=(2*j+1)*sw,d=2*dw; out[0]=start+n/d;
+    if (n%d || n/d==0) return 1;
+    out[1]=out[0]-1; return 2;
+}
+static void compare(const float *src,unsigned sw,const float *got,unsigned dw,unsigned dh,Rect sr,Rect dr) {
+    for (unsigned y=0;y<dh;y++) for (unsigned x=0;x<dw;x++) {
+        if (x<dr.x||x>=dr.x+dr.w||y<dr.y||y>=dr.y+dr.h) {
+            check(got[y*dw+x]==.9375f,"changed outer sentinel"); continue;
+        }
+        unsigned sx[2],sy[2]; int nx=axis(x-dr.x,sr.w,dr.w,sr.x,sx),ny=axis(y-dr.y,sr.h,dr.h,sr.y,sy),ok=0;
+        for(int j=0;j<ny;j++) for(int i=0;i<nx;i++) ok|=got[y*dw+x]==src[sy[j]*sw+sx[i]];
+        if (!ok) { fprintf(stderr,"D32 mismatch at (%u,%u): %.8f, expected nearest from (%u,%u) %.8f\n",
+                           x,y,got[y*dw+x],sx[0],sy[0],src[sy[0]*sw+sx[0]]); exit(1); }
+    }
+}
+int main(int argc,const char **argv) { @autoreleasepool {
+    check(argc==2,"missing production MSL");
+    id<MTLDevice> dev=MTLCreateSystemDefaultDevice(); check(dev!=nil,"no Metal device");
+    id<MTLCommandQueue> q=[dev newCommandQueue]; check(q!=nil,"no tracked command queue");
+    NSError *error=nil;
+    NSString *msl=[NSString stringWithContentsOfFile:[NSString stringWithUTF8String:argv[1]] encoding:NSUTF8StringEncoding error:&error];
+    check(msl!=nil,"reading production MSL");
+    id<MTLLibrary> lib=[dev newLibraryWithSource:msl options:nil error:&error];
+    if (!lib) { fprintf(stderr,"MSL compiler: %s\n",error.localizedDescription.UTF8String); return 1; }
+    MTLRenderPipelineDescriptor *desc=[MTLRenderPipelineDescriptor new];
+    desc.vertexFunction=[lib newFunctionWithName:@"vs"]; desc.fragmentFunction=[lib newFunctionWithName:@"fsd"];
+    desc.depthAttachmentPixelFormat=MTLPixelFormatDepth32Float;
+    id<MTLRenderPipelineState> ps=[dev newRenderPipelineStateWithDescriptor:desc error:&error];
+    check(ps!=nil,"production fsd pipeline");
+    MTLDepthStencilDescriptor *dsd=[MTLDepthStencilDescriptor new]; dsd.depthCompareFunction=MTLCompareFunctionAlways;
+    dsd.depthWriteEnabled=YES; id<MTLDepthStencilState> ds=[dev newDepthStencilStateWithDescriptor:dsd]; check(ds!=nil,"depth state");
+    MTLSamplerDescriptor *sd=[MTLSamplerDescriptor new]; sd.minFilter=sd.magFilter=MTLSamplerMinMagFilterNearest;
+    id<MTLSamplerState> sampler=[dev newSamplerStateWithDescriptor:sd]; check(sampler!=nil,"nearest sampler");
+    unsigned w[]={960,816,720},h[]={540,459,405},route[]={0,1,2,1,0}; id<MTLTexture> textures[3];
+    for(unsigned i=0;i<3;i++) {
+        MTLTextureDescriptor *td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:w[i] height:h[i] mipmapped:NO];
+        td.usage=MTLTextureUsageShaderRead|MTLTextureUsageRenderTarget; td.storageMode=MTLStorageModePrivate;
+        td.hazardTrackingMode=MTLHazardTrackingModeTracked;
+        textures[i]=[dev newTextureWithDescriptor:td];
+        check(textures[i] && textures[i].width==w[i] && textures[i].height==h[i] && textures[i].sampleCount==1 &&
+              textures[i].pixelFormat==MTLPixelFormatDepth32Float && textures[i].usage==td.usage,"texture descriptor differs");
+    }
+    size_t n=(size_t)w[0]*h[0],bytes=n*sizeof(float);
+    float *prev=malloc(bytes),*got=malloc(bytes); check(prev&&got,"CPU oracle allocation");
+    for(size_t i=0;i<n;i++) prev[i]=(float)(i+1)*0x1p-20f;
+    upload(q,textures[0],prev); readback(q,textures[0],got); check(!memcmp(prev,got,bytes),"seed depth data");
+    for(unsigned i=1;i<5;i++) { unsigned s=route[i-1],d=route[i];
+        Rect sr={0,0,w[s],h[s]},dr={0,0,w[d],h[d]};
+        draw(q,ps,ds,sampler,textures[s],textures[d],sr,dr,0); readback(q,textures[d],got);
+        compare(prev,w[s],got,w[d],h[d],sr,dr);
+        float *tmp=prev;prev=got;got=tmp;
+        printf("PASS D32 %ux%u -> %ux%u, %u pixels\n",w[s],h[s],w[d],h[d],w[d]*h[d]);
+    }
+    Rect sr={7,13,753,415},dr={9,9,671,363};
+    draw(q,ps,ds,sampler,textures[0],textures[2],sr,dr,1);readback(q,textures[2],got);
+    compare(prev,w[0],got,w[2],h[2],sr,dr);
+    printf("PASS D32 odd region and outer sentinel on %s\n",dev.name.UTF8String);
+    free(prev);free(got); return 0;
+}}
diff --git a/graphics/nvn/tests/t_rb_d32_tracked.py b/graphics/nvn/tests/t_rb_d32_tracked.py
new file mode 100644
index 0000000..00a517c
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_d32_tracked.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Compile and execute the backend's actual d32 shader with a tracked Metal queue, without NVN startup."""
+import ast
+import hashlib
+from pathlib import Path
+import subprocess
+import tempfile
+
+here=Path(__file__).resolve().parent
+root=here.parent/'gfx/nvn'
+candidates=[]
+for item in [root/'nvn_mtl.m',*root.glob('*.inc'),*root.glob('*.h')]:
+    if not item.exists(): continue
+    lines=item.read_text().splitlines()
+    for k,line in enumerate(lines):
+        if '"fragment D fsd(' not in line: continue
+        i=k
+        while i>=0 and '"#include <metal_stdlib>' not in lines[i]: i-=1
+        if i<0: raise ValueError('Production shader preamble not found')
+        fragments=[]
+        for index,l in enumerate(lines[i:]):
+            if index==0: l=l[l.index('"#include <metal_stdlib>'):]
+            l=l.strip()
+            if l.startswith('//'): continue
+            if not l.startswith('"'): raise ValueError('Unexpected MSL literal boundary')
+            end=l.endswith(';')
+            fragments.append(ast.literal_eval(l[:-1] if end else l))
+            if end:break
+        source=''.join(fragments)
+        if 'vertex V vs(' not in source or 'fragment D fsd(' not in source or 't.read(' not in source:
+            raise ValueError('Production nearest-depth entry point changed')
+        candidates.append(source)
+if len(candidates)!=1:raise ValueError('Expected exactly one production d32 MSL shader')
+source=candidates[0].encode()
+print('Production MSL SHA-256',hashlib.sha256(source).hexdigest(),flush=True)
+with tempfile.TemporaryDirectory() as tmp:
+    root=Path(tmp); msl=root/'copy.metal'; msl.write_bytes(source)
+    exe=root/'tracked-d32'
+    subprocess.run(['xcrun','clang','-fobjc-arc','-fblocks','-O2','-framework','Metal','-framework','Foundation',
+                    str(here/'t_rb_d32_tracked.m'),'-o',str(exe)],check=True)
+    subprocess.run([str(exe),str(msl)],check=True)
diff --git a/graphics/nvn/tests/t_rb_drs_control.c b/graphics/nvn/tests/t_rb_drs_control.c
new file mode 100644
index 0000000..22a8ce3
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_drs_control.c
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+#include "../gfx/nvn/rb_drs_control.h"
+#include <assert.h>
+#include <stdio.h>
+int main(void) {
+    rb_drs_control c={0}; enum rb_drs_reason why;
+    uint64_t t=1700; unsigned next=0;
+    for (unsigned i=0;i<60;i++) { next=rb_drs_observe(&c,t+=17,18.2,0,&why); }
+    assert(next==1 && why==RB_DRS_GPU_HIGH && c.tier==0);
+    rb_drs_applied(&c,next,t);
+    for (unsigned i=0;i<300;i++) assert(rb_drs_observe(&c,t+=17, i%2 ? 12.6 : 14.7,0,&why)==1);
+    assert(rb_drs_observe(&c,t+=17,11.0,1,&why)==2 && why==RB_DRS_FAIR);
+    assert(rb_drs_observe(&c,t+=17,-1,1,&why)==2);
+    rb_drs_applied(&c,2,t);
+    for (unsigned i=0;i<400;i++) assert(rb_drs_observe(&c,t+=17,11.0,1,&why)==2);
+    for (unsigned i=0;i<120;i++) assert(rb_drs_observe(&c,t+=17,11.0,0,&why)==2);
+    assert(rb_drs_observe(&c,t+=17,NAN,0,&why)==2);
+    for (unsigned i=0;i<250;i++) assert(rb_drs_observe(&c,t+=17,11.0,0,&why)==2);
+    assert(rb_drs_observe(&c,t+=800,11.0,0,&why)==2);
+    for (unsigned i=0;i<360;i++) next=rb_drs_observe(&c,t+=17,11.0,0,&why);
+    assert(next==1 && why==RB_DRS_HEADROOM);
+    rb_drs_applied(&c,0,t);
+    assert(rb_drs_observe(&c,t+=17,-1,2,&why)==2 && why==RB_DRS_SERIOUS);
+    assert(rb_drs_percent(0)==100 && rb_drs_percent(1)==85 && rb_drs_percent(2)==75);
+    const uint64_t live[]={4,7,9}, alias[]={4,7,4}, missing[]={0,7,9};
+    assert(rb_drs_input_ids(2,7,live) && !rb_drs_input_ids(2,3,live));
+    assert(!rb_drs_input_ids(1,7,alias) && !rb_drs_input_ids(1,7,missing));
+    assert(!rb_drs_copy_budget(1,0,0) && !rb_drs_copy_budget(2,2,(64ull<<20)+1));
+    assert(rb_drs_copy_budget(0,0,0) && rb_drs_copy_budget(1,2,64ull<<20));
+    puts("PASS DRS rolling window, missing samples, recovery dwell, Fair edge, Serious and pending actuator");
+}
