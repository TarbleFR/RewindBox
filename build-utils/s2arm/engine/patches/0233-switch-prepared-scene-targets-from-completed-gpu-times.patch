+// Uses the existing utility copy shader. Its pipeline, argument table, constants
+// and destination were all prepared before admission. No lazy shader or RT creation.
+static BOOL rb_drs_copy(NvRBDrsBank *b, unsigned source, unsigned destination) {
+    if (source==destination) return YES;
+    NvRBDrsTools *tools=g_rb_drs_tools;
+    id<MTLTexture> src=b->texture[source], dst=b->texture[destination];
+    if (!src || !dst || !tools || !b->enrolled) return NO;
+    BOOL depth=dst.pixelFormat==MTLPixelFormatDepth32Float;
+    MTL4RenderPassDescriptor *desc=pass_desc();
+    MTLRenderPassAttachmentDescriptor *attachment=depth ? (MTLRenderPassAttachmentDescriptor *)desc.depthAttachment : desc.colorAttachments[0];
+    attachment.texture=dst; attachment.loadAction=MTLLoadActionDontCare; attachment.storeAction=MTLStoreActionStore;
+    ser_gate(); id<MTL4RenderCommandEncoder> enc=enc_r_begin(desc);
+    if (!enc) return NO;
+    if (depth) [enc setDepthStencilState:tools->writeDepth];
+    enc_r_table(enc,tools->table,MTLRenderStageFragment);
+    tab_tex(tools->table,src,0); tab_samp(tools->table,tools->sampler,0);
+    tab_buf(tools->table,tools->params,256*(source*3+destination),0);
+    [enc setViewport:(MTLViewport){0,0,dst.width,dst.height,0,1}];
+    [enc setScissorRect:(MTLScissorRect){0,0,dst.width,dst.height}];
+    [enc setRenderPipelineState:b->pipe];
+    enc_r_draw(enc,MTLPrimitiveTypeTriangle,0,3); enc_r_end(enc);
+    args_dirty_all(); g_pso_dirty=g_dss_dirty=1; g_rb_drs_copies++;
+    g_rb_drs_bytes+=src.allocatedSize+dst.allocatedSize;
+    return YES;
