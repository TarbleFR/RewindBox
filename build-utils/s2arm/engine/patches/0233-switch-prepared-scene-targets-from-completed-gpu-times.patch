+// -1 lets normal fixed scaling handle this pass. Main targets enter as native
+// and retain their latest contents until the submit-thread transaction succeeds.
+static int rb_drs_rt_group(const tex_t *const *ts,int n,int native_draw) {
+    if (!rb_drs_enabled()) return -1;
+    BOOL main=NO, mixed=NO;
+    for (int i=0;i<n;i++) if (ts[i]->d.width==960 && ts[i]->d.height==540) main=YES;
+    if (!main) return -1;
+    for (int i=0;i<n;i++) {
+        const tex_t *t=ts[i];
+        if (t->d.width!=960 || t->d.height!=540) { mixed=YES; continue; }
+        NvRBDrsBank *b=rb_drs_bank(t->serial);
+        if (b) b->lastFrame=atomic_load_explicit(&g_cur_frame,memory_order_relaxed);
+        else if (!native_draw && rb_drs_fx_ready_mask()>1) rb_drs_prepare(t,tex_mtl(t));
+    }
+    if (!native_draw && !mixed && !g_rlane && !g_rp_layered && !g_wd && !g_enc && !g_nubd && !g_nlc)
+        rb_drs_tick();
+    BOOL reduced=NO;
+    double factor=0;
+    for (int i=0;i<n;i++) {
+        id<MTLTexture> physical=tex_mtl(ts[i]);
+        if (!physical) { mixed=YES; continue; }
+        double s=rs_of(physical);
+        if (factor>0 && s!=factor) mixed=YES;
+        factor=s;
+        if (s!=1.) reduced=YES;
+    }
+    if (reduced && (mixed || native_draw)) return rb_drs_restore(mixed ? "mixed-attachments" : "native-coordinate-draw");
+    return 1;
