+static BOOL rb_drs_restore(const char *why) {
+    unsigned from=g_rb_drs_control.tier;
+    if (g_enc) rp_end();
+    if (!rb_drs_transition(0)) return NO;
+    rb_drs_applied(&g_rb_drs_control,0,bp_now()/1000000ull);
+    rb_drs_log(from,0,why,atomic_load(&g_cur_frame),0);
+    return YES;
+}
+static id<MTLTexture> rb_drs_native_for(id<MTLTexture> root, const char *why) {
+    NvRBDrsBank *b=rb_drs_owner(root);
+    if (!b || (b->active && !rb_drs_restore(why ?: "incompatible-reader")) || b->active) return nil;
+    // An opaque shader describes this operation only. A resolved, incompatible
+    // direct reader is evidence about this particular target for the session.
+    if (why && !strcmp(why, "opaque-shader-preflight")) return b->texture[0];
+    b->nativeOnly=YES;
+    rs_set_info_at(b->texture[0],RS_BLACK,960,540,1.);
