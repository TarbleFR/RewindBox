new file mode 100644
index 0000000..d4dc02c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_drs_control.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+enum { RB_DRS_TIERS = 3, RB_DRS_WINDOW = 24 };
+enum rb_drs_reason { RB_DRS_HOLD, RB_DRS_GPU_HIGH, RB_DRS_FAIR, RB_DRS_SERIOUS, RB_DRS_HEADROOM };
+typedef struct {
+    double samples[RB_DRS_WINDOW], sum;
+    unsigned count, cursor, tier;
+    int previous_thermal, fair_pending;
+    uint64_t previous_ms, high_since, low_since, changed_ms;
+} rb_drs_control;
+
+static inline unsigned rb_drs_percent(unsigned tier) {
+    static const unsigned pct[] = {100,85,75};
+    return tier < RB_DRS_TIERS ? pct[tier] : 100;
+}
+static inline const char *rb_drs_cause(enum rb_drs_reason reason) {
+    static const char *const names[] = {"hold","gpu-over-budget","fair","serious","nominal-headroom"};
+    return names[reason];
+}
+// t is monotonic wall time (ms). Missing or stale GPU samples cannot earn a promotion.
+// A thermal edge is retained until the actuator acknowledges a completed switch.
+static inline unsigned rb_drs_observe(rb_drs_control *c, uint64_t t, double gpu_ms, int thermal,
+                                      enum rb_drs_reason *reason) {
+    *reason = RB_DRS_HOLD;
+    if (!t || t <= c->previous_ms) return c->tier;
+    if (c->previous_ms && t - c->previous_ms > 500) {
+        c->count = c->cursor = 0; c->sum = 0; c->high_since = c->low_since = 0;
+    }
+    c->previous_ms=t;
+    if (thermal >= 1 && c->previous_thermal < 1) c->fair_pending=1;
+    if (thermal < 1) c->fair_pending=0;
+    c->previous_thermal=thermal;
+    int valid=isfinite(gpu_ms) && gpu_ms>0 && gpu_ms<=250;
+    if (valid) {
+        if (c->count==RB_DRS_WINDOW) c->sum-=c->samples[c->cursor]; else ++c->count;
+        c->samples[c->cursor]=gpu_ms; c->sum+=gpu_ms; c->cursor=(c->cursor+1)%RB_DRS_WINDOW;
+    }
+    double avg=c->count ? c->sum/c->count : 0;
+    if (valid && c->count==RB_DRS_WINDOW && avg>=14.8) { if (!c->high_since) c->high_since=t; }
+    else c->high_since=0;
+    if (valid && c->count==RB_DRS_WINDOW && thermal==0 && avg<12.5) { if (!c->low_since) c->low_since=t; }
+    else c->low_since=0;
+    if (c->tier<2 && thermal>=2) { *reason=RB_DRS_SERIOUS; return 2; }
+    if (c->tier<2 && c->fair_pending) { *reason=RB_DRS_FAIR; return c->tier+1; }
+    if (t-c->changed_ms<1500) return c->tier;
+    if (c->tier<2 && c->high_since && t-c->high_since>=400) { *reason=RB_DRS_GPU_HIGH; return c->tier+1; }
+    if (c->tier && c->low_since && t-c->low_since>=5000) { *reason=RB_DRS_HEADROOM; return c->tier-1; }
+    return c->tier;
+}
+static inline void rb_drs_applied(rb_drs_control *c, unsigned tier, uint64_t t) {
+    c->tier=tier; c->changed_ms=t; c->high_since=c->low_since=0; c->fair_pending=0;
+    c->count=c->cursor=0; c->sum=0;
+}
+
+// A transition needs three different guest allocations and a scaler prepared for that exact level.
+static inline int rb_drs_input_ids(unsigned tier,unsigned ready,const uint64_t ids[3]) {
+    return tier>0 && tier<RB_DRS_TIERS && (ready & (1u<<tier)) && ids &&
+           ids[0] && ids[1] && ids[2] && ids[0]!=ids[1] && ids[0]!=ids[2] && ids[1]!=ids[2];
+}
+static inline int rb_drs_copy_budget(unsigned tier, unsigned banks, uint64_t backing_bytes) {
+    return tier<RB_DRS_TIERS && (!tier || (banks && backing_bytes <= (64ull<<20)));
+}
