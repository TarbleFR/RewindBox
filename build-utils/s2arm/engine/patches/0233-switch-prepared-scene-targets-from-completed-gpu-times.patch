diff --git a/graphics/nvn/tests/t_rb_drs_ownership.m b/graphics/nvn/tests/t_rb_drs_ownership.m
new file mode 100644
index 0000000..faa753e
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_drs_ownership.m
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+// Uses the engine registries and actual Metal parent texture relationships.
+// Runs with ordinary tracked Metal; no Metal 4 command queue or MetalFX required.
+#include "../gfx/nvn/nvn_mtl.m"
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "DRS ownership line %d: %s\n", __LINE__, #cond); return 1; } } while(0)
+int main(void) {
+    @autoreleasepool {
+        id<MTLDevice> device=MTLCreateSystemDefaultDevice();
+        if (!device) return 77;
+        MTLTextureDescriptor *d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:16 height:16 mipmapped:NO];
+        d.usage=MTLTextureUsageRenderTarget|MTLTextureUsageShaderRead|MTLTextureUsagePixelFormatView;
+        NvRBDrsBank *b=[NvRBDrsBank new];
+        b->serial=41; b->active=1; b->key.off=128;
+        b->texture[0]=[device newTextureWithDescriptor:d]; b->texture[1]=[device newTextureWithDescriptor:d];
+        id<MTLTexture> root=b->texture[1], native=b->texture[0];
+        id<MTLTexture> view=[root newTextureViewWithPixelFormat:MTLPixelFormatRGBA8Unorm_sRGB];
+        CHECK(root && native && view && rs_root(view)==root);
+        uint64_t foreign=45;
+        hm_put_id(&g_by_serial,&b->serial,root);
+        hm_put_id(&g_ghost,&b->serial,root); hm_put_id(&g_ghost_active,&b->serial,root);
+        hm_put_id(&g_alias,&b->key,root);
+        CHECK(rb_drs_backing_locked(b,root)==(RB_DRS_OWN|RB_DRS_ALIAS));
+        CHECK(rb_drs_source_locked(b,2));
+        // A view's pool entry pins both the view and its physical root.
+        void *keys[4]; int nk=pool_pin_keys((__bridge void *)view,keys);
+        atomic_store(&g_ptab_any,1);
+        for (int i=0;i<nk;i++) pin_add(keys[i],7);
+        CHECK(!rb_drs_source_locked(b,2));
+        pin_add((__bridge void *)native,8); CHECK(!rb_drs_writable_locked(b,0));
+        for (int i=0;i<nk;i++) pin_del(keys[i],7);
+        pin_del((__bridge void *)native,8); atomic_store(&g_ptab_any,0);
+        CHECK(rb_drs_source_locked(b,2) && rb_drs_writable_locked(b,0));
+        hm_put_id(&g_ghost,&foreign,root);
+        CHECK(!rb_drs_source_locked(b,2)); CHECK(rb_drs_source_locked(b,0));
+        hm_del_id(&g_ghost,&foreign);
+        hm_put_id(&g_ghost_active,&foreign,view);
+        CHECK(!rb_drs_source_locked(b,0)); hm_del_id(&g_ghost_active,&foreign);
+        NvPkg *package=[NvPkg new]; package->spare=root;
+        hm_put_id(&g_ghost,&foreign,package);
+        CHECK(!rb_drs_source_locked(b,0)); hm_del_id(&g_ghost,&foreign);
+        hm_del_id(&g_by_serial,&b->serial);
+        CHECK(rb_drs_live_locked(b)); CHECK(rb_drs_source_locked(b,2));
+        hm_del_id(&g_ghost,&b->serial); hm_del_id(&g_ghost_active,&b->serial);
+        g_rb_drs_banks[0]=b; g_rb_drs_count=1;
+        CHECK(!rb_drs_live_locked(b)); CHECK(!rb_drs_source_locked(b,2)); CHECK(rb_drs_source_locked(b,0));
+        rb_drs_prune(); CHECK(g_rb_drs_count==1);
+        hm_put_id(&g_by_serial,&b->serial,native); // serial replaced, old alias still resolves to root
+        CHECK(!rb_drs_live_locked(b)); CHECK(rb_drs_backing_locked(b,native)&RB_DRS_OWN);
+        hm_del_id(&g_by_serial,&b->serial); hm_del_id(&g_alias,&b->key);
+        rb_drs_prune(); CHECK(!g_rb_drs_count);
+        puts("PASS DRS live, ghost, active ghost, duplicate serial, foreign alias, packaged spare, derived view, alias-only restore and retired bank");
+    }
+    return 0;
+}
