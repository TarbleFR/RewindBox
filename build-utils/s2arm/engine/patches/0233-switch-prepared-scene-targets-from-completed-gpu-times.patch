+static void rb_drs_prepare(const tex_t *guest, id<MTLTexture> native) {
+    if (!guest || !guest->serial || !native ||
+        native.width!=960 || native.height!=540 || native.sampleCount!=1 || native.mipmapLevelCount!=1 ||
+        native.textureType!=MTLTextureType2D || native.storageMode!=MTLStorageModePrivate ||
+        native.parentTexture || native.iosurface || native.heap || native.buffer || native.framebufferOnly ||
+        native.isSparse || guest->has_layout || !guest->pool || (guest->pool->flags & NVN_MEMORY_POOL_FLAGS_VIRTUAL) ||
+        objc_getAssociatedObject(native,&g_atomic_root_key) || objc_getAssociatedObject(native,&g_twin_parent_key) ||
+        xv_present(guest->serial) ||
+        !(native.usage & MTLTextureUsageRenderTarget) || !(native.usage & MTLTextureUsageShaderRead) ||
+        (!rb_drs_color_format(native.pixelFormat) && native.pixelFormat!=MTLPixelFormatDepth32Float)) return;
+    for (unsigned i=0;i<g_rb_drs_count;i++)
+        if (g_rb_drs_banks[i]->texture[0]==native) return;
+    if (rs_state(native)==RS_BLACK || !rs_eligible(guest,native,NULL)) return;
+    pthread_mutex_lock(&g_smu);
+    BOOL direct=hm_get_id(&g_by_serial,&guest->serial)==native;
+    pthread_mutex_unlock(&g_smu);
+    uint64_t frame=atomic_load(&g_cur_frame);
+    if (!direct || !rb_drs_make_room(frame)) return;
+    NvRBDrsBank *b=[NvRBDrsBank new]; b->serial=guest->serial; b->lastFrame=frame; b->texture[0]=native; alias_key_of(&b->key,guest);
+    g_rb_drs_banks[g_rb_drs_count++]=b;
+    NvRBDrsTools *tools=rb_drs_tools();
+    id<MTLDevice> device=native.device;
+    dispatch_async(tools->queue, ^{ @autoreleasepool {
+        MTLPixelFormat fmt=native.pixelFormat;
+        BOOL depth=fmt==MTLPixelFormatDepth32Float;
+        NSNumber *key=@(fmt);
+        b->pipe=tools->pipes[key];
+        if (!b->pipe && tools->library) {
+            MTLRenderPipelineDescriptor *pd=[MTLRenderPipelineDescriptor new];
+            pd.vertexFunction=[tools->library newFunctionWithName:@"vs"];
+            pd.fragmentFunction=[tools->library newFunctionWithName:depth ? @"fsd" : @"fs"];
+            if (depth) pd.depthAttachmentPixelFormat=fmt; else pd.colorAttachments[0].pixelFormat=fmt;
+            NSError *err=nil; b->pipe=[device newRenderPipelineStateWithDescriptor:pd error:&err];
+            if (b->pipe) tools->pipes[key]=b->pipe;
+        }
+        BOOL valid=b->pipe && tools->params && tools->sampler && tools->writeDepth && tools->table;
+        for (unsigned t=1; valid && t<3; t++) {
+            MTLTextureDescriptor *d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt
+                width:rb_drs_width[t] height:rb_drs_height[t] mipmapped:NO];
+            d.resourceOptions=native.resourceOptions; d.usage=native.usage|MTLTextureUsageShaderRead|MTLTextureUsageRenderTarget;
+            b->texture[t]=[device newTextureWithDescriptor:d];
+            valid=b->texture[t]!=nil;
+            if (valid) rs_set_info_at(b->texture[t],RS_SCALED,960,540,rb_drs_percent(t)/100.);
+        }
+        atomic_store_explicit(&b->ready,valid ? 1 : -1,memory_order_release);
+    }});
+}
+static void rb_drs_enroll(NvRBDrsBank *b) {
+    if (!b->enrolled) {
+        res_add(b->texture[1]); res_add(b->texture[2]); res_add(g_rb_drs_tools->params);
+        b->enrolled=YES;
+    }
