+    }
+    if (g_rb_drs_tools) {
+        // A worker could still be preparing buffer zero. Drain on shutdown, never on submit.
+        dispatch_sync(g_rb_drs_tools->queue, ^{});
+        res_remove(g_rb_drs_tools->params);
+    }
+    g_rb_drs_tools=nil; g_rb_drs_count=0; g_rb_drs_frame=g_rb_drs_heat_ms=g_rb_drs_copies=g_rb_drs_blocked=g_rb_drs_bytes=0;
+    g_rb_drs_heat=0; g_rb_drs_retry_after=0; memset(&g_rb_drs_control,0,sizeof g_rb_drs_control);
+}
