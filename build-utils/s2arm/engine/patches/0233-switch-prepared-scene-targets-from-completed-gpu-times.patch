+static BOOL rb_drs_make_room(uint64_t frame) {
+    if (g_rb_drs_count<RB_DRS_BANKS) return YES;
+    rb_drs_prune();
+    if (g_rb_drs_count<RB_DRS_BANKS) return YES;
+    for (unsigned i=0;i<g_rb_drs_count;i++) {
+        NvRBDrsBank *b=g_rb_drs_banks[i];
+        if (b->active || !atomic_load_explicit(&b->ready,memory_order_acquire) ||
+            frame<=b->lastFrame || frame-b->lastFrame<300 || b->nativeOnly) continue;
+        rb_drs_remove(i,NO);
+        return YES;
+    }
+    return NO;
