+static void rb_drs_tick(void) {
+    uint64_t frame=atomic_load_explicit(&g_cur_frame,memory_order_relaxed);
+    if (!frame || frame==g_rb_drs_frame) return;
+    g_rb_drs_frame=frame;
+    uint64_t now=bp_now()/1000000ull;
+    if (now-g_rb_drs_heat_ms>=250) { g_rb_drs_heat=(int)NSProcessInfo.processInfo.thermalState; g_rb_drs_heat_ms=now; }
+    double gpu=frame>=8 ? nvn_be_gpu_ms(frame-8) : -1;
+    enum rb_drs_reason why;
+    unsigned before=g_rb_drs_control.tier;
+    unsigned to=rb_drs_observe(&g_rb_drs_control,now,gpu,g_rb_drs_heat,&why);
+    if (to==before || now<g_rb_drs_retry_after) return;
+    double avg=g_rb_drs_control.count ? g_rb_drs_control.sum/g_rb_drs_control.count : 0;
+    if (rb_drs_transition(to)) {
+        rb_drs_applied(&g_rb_drs_control,to,now);
+        rb_drs_log(before,to,rb_drs_cause(why),frame,avg);
+    } else {
