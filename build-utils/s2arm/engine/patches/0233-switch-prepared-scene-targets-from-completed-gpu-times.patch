+// Always sample the authoritative guest contents. A changed network can need
+// native inputs even when all three incoming buffers still have a reduced size.
+static int rb_drs_fx_align(const tex_t *inputs[3], id<MTLTexture> __strong tex[3]) {
+    for (int i=0;i<3;i++) {
+        if (!inputs[i] || !tex[i]) return 0;
+        if (tex[i].width==960 && tex[i].height==540 && rs_of(tex[i])==1.) continue;
+        NvRBDrsBank *b=rb_drs_owner(tex[i]);
+        if (!b || b->serial!=inputs[i]->serial || b->texture[b->active]!=tex[i]) return 0;
+    }
+    if (!rb_drs_restore("metalfx-native-cohort")) return 0;
+    for (int i=0;i<3;i++) {
+        tex[i]=tex_mtl(inputs[i]);
+        if (!tex[i] || tex[i].width!=960 || tex[i].height!=540 || rs_of(tex[i])!=1.) return 0;
+    }
+    return 1;
+}
+static void rb_drs_pool_reset(void) {
+    // Called after GPU/submit drain. Jobs only retain their own old objects,
+    // never session globals, and never publish resources to the residency set.
+    for (unsigned i=0;i<g_rb_drs_count;i++) {
+        NvRBDrsBank *b=g_rb_drs_banks[i];
+        if (b->enrolled) {
+            if (b->active) res_remove(b->texture[0]);
+            res_remove(b->texture[1]); res_remove(b->texture[2]);
