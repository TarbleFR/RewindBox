+#define ROW1 HASH "\t" FILE1 "\n"
+#define ROW2 "c" HASH "\t" FILE2 "\n"
+
+static void check_index(const char *data, size_t size) {
+    char key[42], name[80];
+    assert(rb_archive_index_next(&data, &size, key, name));
+    assert(!strcmp(key, HASH) && !strcmp(name, FILE1));
+    assert(rb_archive_index_next(&data, &size, key, name));
+    assert(!strcmp(key, "c" HASH) && !strcmp(name, FILE2));
+    assert(!rb_archive_index_next(&data, &size, key, name));
+}
+
+int main(void) {
+    const char bad[] = ROW1 HASH "\tbatch-a/b-1.metalarchive\n"
+        HASH "\tbatch-a-1.metalarchive\0trailing\n\xff\n" ROW2
+        HASH "\t" FILE1;
+    check_index(bad, sizeof bad - 1);
+    char path[] = "/tmp/rb-index-XXXXXX";
+    int fd = mkstemp(path);
+    assert(fd >= 0 && close(fd) == 0);
+    assert(rb_archive_index_append(path, ROW1));
+    // Interrupt at every byte of the next record, including the missing newline.
+    for (size_t cut = 1; cut < sizeof(ROW1) - 1; ++cut) {
+        FILE *f = fopen(path, "wb");
+        assert(f && fputs(ROW1, f) >= 0 && fwrite(ROW1, 1, cut, f) == cut && !fclose(f));
+        assert(rb_archive_index_append(path, ROW2));
+        f = fopen(path, "rb");
+        char buf[512];
+        assert(f);
+        size_t n = fread(buf, 1, sizeof buf, f);
+        assert(!ferror(f) && !fclose(f));
+        check_index(buf, n);
+    }
+    assert(unlink(path) == 0);
+    puts("archive index: 2 valid rows recovered around corrupt bytes and every interrupted append");
+    return 0;
+}
