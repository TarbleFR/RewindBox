+#!/bin/sh
+# Argument is the built t_nvn_pso_batch executable (macOS with a Metal device).
+set -eu
+test_bin=${1:?t_nvn_pso_batch executable required}
+state=$(mktemp -d)
+trap 'rm -rf "$state"' EXIT
+"$test_bin" --relaunch "$state" cold
+"$test_bin" --relaunch "$state" warm
+# A compatible app update keeps the game directory. Migrate a localized legacy stamp.
+python3 - "$state/pipelines/identity.json" <<'PYTHON'
+import json, pathlib, sys
+path = pathlib.Path(sys.argv[1])
+stamp = json.loads(path.read_text())
+stamp.pop("osBuild", None)
+stamp["os"] = "Version locale précédente"
+path.write_text(json.dumps(stamp))
+PYTHON
+"$test_bin" --relaunch "$state" warm
+# The stamp may be torn in an interrupted restore of a compatible installation.
+printf '{' > "$state/pipelines/identity.json"
+"$test_bin" --relaunch "$state" warm
+# Corrupt the archive indexed for the actual fixture key.
+for archive in "$state"/pipelines/batch-*.metalarchive; do printf 'truncated' > "$archive"; done
+"$test_bin" --relaunch "$state" cold
+"$test_bin" --relaunch "$state" warm
