diff --git a/graphics/nvn/gfx/nvn/rb_archive_index.h b/graphics/nvn/gfx/nvn/rb_archive_index.h
new file mode 100644
index 0000000..7a08b85
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_archive_index.h
@@ -0,0 +1,52 @@
+// batches.tsv is append-only. A torn row or a damaged byte invalidates only that row.
+#pragma once
+#include <stdio.h>
+#include <string.h>
+
+static inline int rb_archive_index_next(const char **cursor, size_t *left, char key[42], char name[80]) {
+    while (*left) {
+        const char *row = *cursor;
+        const char *end = memchr(row, '\n', *left);
+        if (!end) { *left = 0; return 0; }
+        size_t size = (size_t)(end - row);
+        *cursor = end + 1;
+        *left -= size + 1;
+        if (size < 42 || size >= 42 + 80) continue;
+        const char *tab = memchr(row, '\t', size);
+        if (!tab) continue;
+        size_t k = (size_t)(tab - row), n = (size_t)(end - tab - 1);
+        if (!(k == 40 || (k == 41 && row[0] == 'c')) || n >= 80 || n < 21) continue;
+        memcpy(key, row, k);
+        key[k] = 0;
+        const char *hash = key + (k == 41);
+        if (strspn(hash, "0123456789abcdef") != 40) continue;
+        memcpy(name, tab + 1, n);
+        name[n] = 0;
+        if (strlen(name) != n || strncmp(name, "batch-", 6)) continue;
+        const char *stamp = name + 6;
+        size_t h = strspn(stamp, "0123456789abcdef");
+        if (!h || stamp[h] != '-') continue;
+        const char *pid = stamp + h + 1;
+        size_t p = strspn(pid, "0123456789");
+        if (p && !strcmp(pid + p, ".metalarchive")) return 1;
+    }
+    return 0;
+}
+
+// Caller holds the archive writer's lock. Quarantine the last partial record so a
+// subsequent append cannot get spliced into it or turn it into a valid record.
+static inline int rb_archive_index_append(const char *path, const char *rows) {
+    FILE *f = fopen(path, "a+b");
+    if (!f) return 0;
+    int ok = fseek(f, 0, SEEK_END) == 0;
+    long end = ok ? ftell(f) : -1;
+    ok = end >= 0;
+    if (ok && end) {
+        ok = fseek(f, -1, SEEK_END) == 0;
+        int last = ok ? fgetc(f) : EOF;
+        ok = last != EOF && fseek(f, 0, SEEK_END) == 0;
+        if (ok && last != '\n') ok = fputs("!\n", f) >= 0;
+    }
+    if (ok) ok = fputs(rows, f) >= 0;
+    return fclose(f) == 0 && ok;
+}
diff --git a/graphics/nvn/tests/rb_archive_relaunch.inc b/graphics/nvn/tests/rb_archive_relaunch.inc
new file mode 100644
index 0000000..5992c5b
--- /dev/null
+++ b/graphics/nvn/tests/rb_archive_relaunch.inc
@@ -0,0 +1,56 @@
+// Run t_nvn_pso_batch --relaunch DIRECTORY cold|warm in separate processes.
+// This exercises the NVN archive (including the on-disk index), then reads back a
+// rendered pixel. A compiler/driver cache cannot satisfy the strict archive probe.
+static int rb_archive_relaunch(const char *directory, int expect_hit) {
+    NSString *root = @(directory);
+    REQUIRE(setenv("DM_PSO_USER", [root stringByAppendingPathComponent:@"pso_user.tsv"].fileSystemRepresentation, 1) == 0);
+    id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+    REQUIRE(dev);
+    g_dev = dev;
+    NSString *src = @"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 v(uint i [[vertex_id]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return float4(p[i],0,1); }\n"
+        "fragment float4 f(){ return float4(1,0,0,1); }";
+    NSError *error = nil;
+    id<MTLLibrary> lib = [dev newLibraryWithSource:src options:nil error:&error];
+    REQUIRE(lib);
+    MTLRenderPipelineDescriptor *d = [MTLRenderPipelineDescriptor new];
+    d.vertexFunction = [lib newFunctionWithName:@"v"];
+    d.fragmentFunction = [lib newFunctionWithName:@"f"];
+    d.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    NSString *key = par_hash("relaunch-fixture", sizeof("relaunch-fixture") - 1);
+    id<MTLRenderPipelineState> pipeline = par_render(d, key, &error);
+    REQUIRE(pipeline && g_par_on);
+    REQUIRE(atomic_load(&g_par_hits) == (unsigned)expect_hit);
+    REQUIRE(atomic_load(&g_par_misses) == (unsigned)!expect_hit);
+    if (!expect_hit) {
+        par_write_batch(@[@[key, d]]);
+        REQUIRE(atomic_load(&g_par_written) == 1);
+    }
+    MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+    td.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> target = [dev newTextureWithDescriptor:td];
+    id<MTLBuffer> readback = [dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    REQUIRE(target && readback);
+    id<MTLCommandQueue> queue = [dev newCommandQueue];
+    id<MTLCommandBuffer> cmd = [queue commandBuffer];
+    MTLRenderPassDescriptor *pd = [MTLRenderPassDescriptor renderPassDescriptor];
+    pd.colorAttachments[0].texture = target;
+    pd.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pd.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 1, 1);
+    pd.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:pd];
+    [enc setRenderPipelineState:pipeline];
+    [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [enc endEncoding];
+    id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+    [blit copyFromTexture:target sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+        sourceSize:MTLSizeMake(1,1,1) toBuffer:readback destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:256];
+    [blit endEncoding];
+    [cmd commit];
+    [cmd waitUntilCompleted];
+    REQUIRE(cmd.status == MTLCommandBufferStatusCompleted);
+    const unsigned char expected[] = {255, 0, 0, 255};
+    REQUIRE(!memcmp(readback.contents, expected, sizeof expected));
+    printf("%s: archive hit=%d pixel=ff0000ff\n", expect_hit ? "warm" : "cold/repair", expect_hit);
+    return 0;
+}
