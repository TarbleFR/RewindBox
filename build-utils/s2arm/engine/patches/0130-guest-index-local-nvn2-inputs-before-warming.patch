diff --git a/graphics/nvn/tests/t_rb_local_stage.c b/graphics/nvn/tests/t_rb_local_stage.c
new file mode 100644
index 0000000..03de9bc
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_local_stage.c
@@ -0,0 +1,68 @@
+// Portable malformed-record and exact identity checks on the parser used by iOS.
+#include <assert.h>
+#include "../host/rb_local_stage.h"
+#ifdef __APPLE__
+#include <CommonCrypto/CommonDigest.h>
+#else
+#define OPENSSL_SUPPRESS_DEPRECATED
+#include <openssl/sha.h>
+#define CC_SHA256_DIGEST_LENGTH SHA256_DIGEST_LENGTH
+#define CC_SHA256_CTX SHA256_CTX
+#define CC_SHA256_Init SHA256_Init
+#define CC_SHA256_Update SHA256_Update
+#define CC_SHA256_Final SHA256_Final
+#endif
+#include "../gfx/nvn/nvn2_key.inc"
+
+static void put32(uint8_t *p,uint32_t v) { memcpy(p,&v,4); }
+static void put64(uint8_t *p,uint64_t v) { memcpy(p,&v,8); }
+static uint8_t desired[8];
+static unsigned seen;
+static void candidate(void *arg,const uint8_t *ctl,unsigned nt,const uint8_t *code,unsigned nc,int stage) {
+    (void)arg;
+    uint8_t k[8]; nvn2_key(ctl,code,k);
+    assert(nt==0xd8 && nc==256 && stage==1 && !memcmp(k,desired,8));
+    seen++;
+}
+static void control(uint8_t *p,uint32_t own) {
+    put32(p,NVN2_CTL_MAGIC);put32(p+4,NVN2_CTL_VERSION);put32(p+0x30,own);put32(p+0x44,256);p[0x56]=1;
+}
+static void one(rb_local_scan *s,uint8_t *p,size_t len) {
+    seen=0; rb_scan_blob(s,p,len,0); assert(seen==1);
+}
+int main(void) {
+    rb_local_scan scan={.stage=candidate,.budget=64u<<20};
+    uint8_t d[2048]={0};
+    memcpy(d,"BNSH",4);memcpy(d+0x60,"grsc",4);put32(d+0x7c,1);put64(d+0x80,0x100);
+    put64(d+0x110,0x140);put64(d+0x140+8+4*8,0x200);
+    put64(d+0x208,0x300);put64(d+0x210,0x400);put32(d+0x218,256);put32(d+0x21c,0xd8);
+    control(d+0x300,0xd8);for (int i=0;i<256;i++) d[0x400+i]=(uint8_t)i;
+    nvn2_key(d+0x300,d+0x400,desired);
+    one(&scan,d,sizeof d);
+    for (size_t n=0;n<0x500;n++) { seen=0; rb_scan_blob(&scan,d,n,0); assert(!seen); }
+    put64(d+0x208,~0ull);seen=0;rb_scan_blob(&scan,d,sizeof d,0);assert(!seen);
+    memset(d,0,sizeof d);memcpy(d,"NDSR",4);
+    put32(d+24,0x100);put32(d+28,(0xd8<<4)|3);put32(d+32,0x400);put32(d+36,(256<<4)|4);
+    control(d+0x100,0xd8);for (int i=0;i<256;i++) d[0x400+i]=(uint8_t)i;
+    one(&scan,d,sizeof d);
+    memset(d,0,sizeof d);memcpy(d,"BAHS",4);put32(d+0x18,256);put32(d+0x1c,0x400);
+    put32(d+0x40,0x20);put32(d+0x44,1);put32(d+0x58,0xd8);put32(d+0x5c,0xb0);
+    control(d+0x100,0);for (int i=0;i<256;i++) d[0x400+i]=(uint8_t)i;
+    one(&scan,d,sizeof d);
+    put32(d+0x44,0);seen=0;rb_scan_blob(&scan,d,sizeof d,0);assert(!seen);
+    memset(d,0,sizeof d);control(d,0x180);for (int i=0;i<256;i++) d[0x180+i]=(uint8_t)i;
+    one(&scan,d,sizeof d);
+    put32(d+0x44,UINT32_MAX);seen=0;rb_scan_blob(&scan,d,sizeof d,0);assert(!seen);
+    memset(d,0,sizeof d);memcpy(d,"BTCDBTCD",8);put32(d+0x28,0xd8);put32(d+0x2c,256);
+    control(d+0x38+256,0xd8);for (int i=0;i<256;i++) d[0x38+i]=(uint8_t)i;
+    one(&scan,d,sizeof d);
+    memset(d,0,sizeof d);put32(d,DSH_IN_MAGIC);put32(d+4,1);put32(d+8,0xd8);put32(d+12,256);
+    control(d+16,0xd8);for (int i=0;i<256;i++) d[16+0xd8+i]=(uint8_t)i;
+    one(&scan,d,16+0xd8+256);
+    put32(d+4,0);seen=0;rb_scan_blob(&scan,d,16+0xd8+256,0);assert(!seen);
+    // An invalid Yaz0 back-reference cannot read before the start of output.
+    memset(d,0,sizeof d);memcpy(d,"Yaz0",4);d[7]=8;seen=0;
+    rb_scan_blob(&scan,d,18,0);assert(!seen && scan.unsupported);
+    puts("PASS exact NVN2 identities in BNSH, BAHS, NDSR, bare programs, S2Arm BTCD/SIN1, out-of-range pointers, truncated records and invalid Yaz0");
+    return 0;
+}
