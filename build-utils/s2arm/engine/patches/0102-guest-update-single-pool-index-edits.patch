 // The Legend of Zelda: Breath of the Wild keeps about 1760 memory pools alive and every buffer binding of every draw looks one up; the old full scan took about 4% of the submit thread's samples (mtl_gpu_addr 222 / 6 s). Adding / removing pools invalidates the index, which is re-sorted when next used. Caller holds g_mu
 static int *g_pidx; static int g_pidx_cap;
 static int pidx_cmp(const void *a, const void *b) { uintptr_t x = g_pools[*(const int *)a].lo, y = g_pools[*(const int *)b].lo; return x < y ? -1 : x > y; }
+// RewindBox (patch 0102): IPA 785 captured 11 pool_find and 7 pidx_cmp samples of
+// 94 active samples on nx-83 in frames 610–727. A single mutation between lookups
+// need not re-sort thousands of live pools. If starts can tie or edits accumulate,
+// use the original sort so overlap and equal-address selection stay identical.
+static int rb_pidx_on(void) {   // caller holds g_mu
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("S2A_RB_POOL_INDEX_UPDATE"); on = !(e && !strcmp(e, "0")); }
+    return on;
+}
+static int rb_pidx_update(void) {   // caller holds g_mu, capacity already checked
+    int edit = g_rb_pidx_edit;
+    g_rb_pidx_edit = 0;
+    if (!edit) return 0;
+    if (edit == 1) {
+        int last = g_npool - 1, lo = 0, hi = last;
+        uintptr_t address = g_pools[last].lo;
+        while (lo < hi) {
+            int mid = lo + (hi - lo) / 2;
+            if (g_pools[g_pidx[mid]].lo < address) lo = mid + 1;
+            else hi = mid;
+        }
+        if (lo < last && g_pools[g_pidx[lo]].lo == address) return 0;
+        memmove(g_pidx + lo + 1, g_pidx + lo, (size_t)(last - lo) * sizeof *g_pidx);
+        g_pidx[lo] = last;
+        return 1;
+    }
+    int removed = g_rb_pidx_removed, at = -1;
+    for (int i = 0; i <= g_npool; i++) {
+        if (g_pidx[i] == removed) at = i;
+        else if (g_pidx[i] == g_npool) g_pidx[i] = removed;   // previous last entry moved into the hole
+    }
+    if (at < 0) return 0;
+    memmove(g_pidx + at, g_pidx + at + 1, (size_t)(g_npool - at) * sizeof *g_pidx);
+    return 1;
+}
+static void rb_pidx_note(int updated) {   // independent of frame sampling
+    static uint64_t edits, sorts;
+    edits += updated != 0;
+    sorts += updated == 0;
+    uint64_t n = edits + sorts;
+    if (!(n & (n - 1)) && n >= 64)
+        MLOG("RewindBox: pool address index: %llu single edits applied, %llu full sorts (S2A_RB_POOL_INDEX_UPDATE)",
