-        for (int i = 0; i < g_npool; i++) g_pidx[i] = i;
-        qsort(g_pidx, (size_t)g_npool, sizeof *g_pidx, pidx_cmp); g_pidx_ok = 1;
+        int enabled = rb_pidx_on(), updated = enabled && rb_pidx_update();
+        if (!updated) {
+            for (int i = 0; i < g_npool; i++) g_pidx[i] = i;
+            qsort(g_pidx, (size_t)g_npool, sizeof *g_pidx, pidx_cmp);
+            g_rb_pidx_unique = enabled;
+            for (int i = 1; g_rb_pidx_unique && i < g_npool; i++)
+                if (g_pools[g_pidx[i - 1]].lo == g_pools[g_pidx[i]].lo) g_rb_pidx_unique = 0;
+        }
+        if (enabled) rb_pidx_note(updated);
+        g_pidx_ok = 1;
     }
     int lo = 0, hi = g_npool - 1, hit = -1;   // the last one whose start ≤ addr
     while (lo <= hi) { int m = (lo + hi) / 2; if (g_pools[g_pidx[m]].lo <= addr) { hit = m; lo = m + 1; } else hi = m - 1; }
