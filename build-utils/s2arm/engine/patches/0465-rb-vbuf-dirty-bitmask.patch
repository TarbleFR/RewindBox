new file mode 100644
index 000000000..8a0e820bb
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_draw_fast_rule.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0465): dirty/bound bitmask rule for bind_vbufs() (nvn_mtl.m).
+// Eliminates the per-draw 16-stream scan and redundant zero/push slot binds when
+// vertex streams are unchanged, while automatically invalidating streams whose
+// Metal vertex-table slots are overwritten by non-vbuf encoders (mesh slot 29 =
+// VB_SLOT(13), tessellation slots 20..25 = VB_SLOT(4..9), geometry capture slot
+// 13 = PUSH_SLOT, or slot 30 = zero buffer).
+#pragma once
+#include <stdint.h>
+
+// Inverse of VB_SLOT(st) = ((st) < 14 ? 16 + (st) : (st)).
+// Returns NVN vertex stream index 0..15 for Metal vertex-table slots 14..29, else -1.
+static inline int rb_vbuf_slot_to_stream(unsigned slot) {
+    if (slot >= 16u && slot <= 29u) return (int)(slot - 16u);
+    if (slot == 14u || slot == 15u) return (int)slot;
+    return -1;
+}
+
+// Called when code outside bind_vbufs() writes Metal vertex-table slot `slot`.
+// Re-dirties the aliased NVN stream (14..29) or aux slots (PUSH_SLOT=13, zero=30).
+static inline void rb_vbuf_note_external_write(unsigned slot, uint16_t *dirty_mask, uint8_t *aux_dirty) {
+    int st = rb_vbuf_slot_to_stream(slot);
+    if (st >= 0) *dirty_mask |= (uint16_t)(1u << st);
+    else if (slot == 13u || slot == 30u) *aux_dirty = 1;
+}
+
+// Consumes and returns the bitmask of bound vertex streams that must be resolved
+// and written to the vertex argument table on this draw. Forces all bound streams
+// dirty whenever g_pool_gen advances.
+static inline uint16_t rb_vbuf_dirty_mask_take(uint16_t *dirty_mask, uint16_t bound_mask,
+                                               uint64_t cur_pool_gen, uint64_t *last_pool_gen) {
+    uint16_t dm = *dirty_mask;
+    if (__builtin_expect(*last_pool_gen != cur_pool_gen, 0)) {
+        *last_pool_gen = cur_pool_gen;
+        dm |= bound_mask;
+    }
+    *dirty_mask = 0;
+    return (uint16_t)(dm & bound_mask);
+}
