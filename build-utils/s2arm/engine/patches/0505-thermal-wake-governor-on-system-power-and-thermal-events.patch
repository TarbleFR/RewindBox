+// Invalidate before waking; an epoch change also catches a worker that has
+// not yet parked. Only the sampler is needed until a changed plan is known.
+static inline void rb_spec_notify_sensor(rb_spec_gate *gate, _Atomic uint64_t *sampled) {
+    if (!atomic_exchange_explicit(sampled, 0, memory_order_acq_rel)) return;
+    pthread_mutex_lock(&gate->mutex);
+    atomic_fetch_add(&gate->epoch, 1);
+    RB_SPEC_DIAG("spec.signal", -2, pthread_cond_signal(&gate->primary));
+    pthread_mutex_unlock(&gate->mutex);
+}
 static inline int rb_spec_publish_plan_mode(rb_spec_gate *gate, int level, unsigned limit,
                                             int startup_floor, int energy_one) {
     pthread_mutex_lock(&gate->mutex);
