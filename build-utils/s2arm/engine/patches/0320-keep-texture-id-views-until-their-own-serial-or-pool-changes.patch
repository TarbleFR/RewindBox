+#include <stdint.h>
+
+// The serial tables since the view was validated. ser, add, local: g_ser_gen, g_rb_ser_add, g_view_epoch.writes; bucket: g_view_epoch.bucket[] of the view's serial, the
+//   value g_ser_gen took at the last move noted there; all four read under g_smu. seen_*: what the view recorded then (seen_add 0: not recorded)
+enum { RB_VS_SAME = 0, RB_VS_ADDS, RB_VS_SCOPED, RB_VS_OWN, RB_VS_GLOBAL };
+static inline int rb_vs_moves(uint64_t ser, uint64_t add, uint64_t local, uint64_t bucket, uint64_t seen_ser, uint64_t seen_add, uint64_t seen_local) {
+    if (!seen_add) return RB_VS_GLOBAL;
+    const uint64_t moved = ser - seen_ser, adds = add - seen_add, noted = local - seen_local;
+    if (moved != adds + noted) return RB_VS_GLOBAL;   // at least one move was neither an addition nor noted for a serial
+    if (!moved) return RB_VS_SAME;
+    if (!noted) return RB_VS_ADDS;
+    return bucket <= seen_ser ? RB_VS_SCOPED : RB_VS_OWN;   // a bucket holds several serials: a move noted for any of them counts as this one's
+}
+
+// The bytes of a CPU-written (packaged) texture since the view was validated. range: its pool's write count now, 0 = none stands for it; seen_range: the count taken
+//   before the look that found its pages clean, 0 = none was (not asked, or that look did not end clean)
+enum { RB_VS_DATA_NONE = 0, RB_VS_DATA_SAME, RB_VS_DATA_PERIOD, RB_VS_DATA_RANGE, RB_VS_DATA_WRITTEN, RB_VS_DATA_UNVOUCHED };
+static inline int rb_vs_data(int pkg, uint64_t dirty, uint64_t seen_dirty, uint64_t period, uint64_t seen_period, uint64_t range, uint64_t seen_range) {
+    if (!pkg) return RB_VS_DATA_NONE;                           // a GPU texture: guest writes do not concern it
+    if (dirty == seen_dirty) return RB_VS_DATA_SAME;            // no guest write to any protected page
+    if (period == seen_period) return RB_VS_DATA_PERIOD;        // looked at in this check period
+    if (range && range == seen_range) return RB_VS_DATA_RANGE;  // writes elsewhere: no page generation of its pool was stored
+    return range && seen_range ? RB_VS_DATA_WRITTEN : RB_VS_DATA_UNVOUCHED;
+}
+
+// What the view is
+enum {
+    RB_VS_GONE = 1,         // its memory pool was finalized (treg_t gone)
+    RB_VS_SPARSE = 2,       // placement sparse (view_sp): it follows its pool's mappings (patch 0031)
+    RB_VS_VIRTUAL = 4,      // a virtual (sparse) pool: a mapping request changes what it reads and moves neither count
+    RB_VS_COMPRESSED = 8,   // block-compressed: resolving it also takes the levels a GPU write left in an uncompressed texture over its storage (bcal_sync)
+    RB_VS_BC_QUIET = 16,    // (compressed) its storage is on record as resolved, and no such write is: the first one moves g_ser_gen unclassified
+    RB_VS_LIVE = 32,        // its texture object is live (not finalized), or is an external texture
+    RB_VS_SUBMIT = 64       // its last resolution ran on the submit thread, where a CPU-written texture is uploaded and looked at (elsewhere tex_mtl hands out what exists)
+};
+
+// Patch 0319's rule: 1 = the view stands (additions_only || local_only)
+static inline int rb_vs_before(int moves, int data, unsigned kind) {
+    if (kind & RB_VS_SPARSE) return 0;
+    if (data == RB_VS_DATA_NONE && (moves == RB_VS_SAME || moves == RB_VS_ADDS)) return 1;   // patch 0073
+    return moves == RB_VS_SCOPED && !(kind & (RB_VS_GONE | RB_VS_VIRTUAL | RB_VS_COMPRESSED)) &&
+           (data == RB_VS_DATA_NONE || data == RB_VS_DATA_SAME || data == RB_VS_DATA_PERIOD);   // patch 0163
+}
+
+// Patch 0320's rule: RB_VS_KEEP = the view stands, else why it is resolved again (the counts of the 300-frame line)
+enum { RB_VS_KEEP = 0, RB_VS_WHY_GLOBAL, RB_VS_WHY_OWN, RB_VS_WHY_WRITTEN, RB_VS_WHY_POOL, RB_VS_WHY_DEAD, RB_VS_WHY_OFFTHREAD, RB_VS_WHY_BC, RB_VS_WHY_UNVOUCHED, RB_VS_WHY_SPARSE, RB_VS_WHY_OTHER, RB_VS_WHY_N };
+static inline int rb_vs_why(int moves, int data, unsigned kind) {
+    if (kind & RB_VS_SPARSE) return RB_VS_WHY_SPARSE;
+    if (moves == RB_VS_GLOBAL) return RB_VS_WHY_GLOBAL;
+    if (moves == RB_VS_OWN) return RB_VS_WHY_OWN;
+    if (data == RB_VS_DATA_NONE && moves != RB_VS_SCOPED) return RB_VS_KEEP;          // patch 0073, as before
+    if (data == RB_VS_DATA_WRITTEN) return RB_VS_WHY_WRITTEN;                         // its pool was written: its pages decide
+    if (kind & (RB_VS_GONE | RB_VS_VIRTUAL)) return RB_VS_WHY_POOL;
+    if (!(kind & RB_VS_LIVE)) return RB_VS_WHY_DEAD;
+    if (!(kind & RB_VS_SUBMIT)) return RB_VS_WHY_OFFTHREAD;
+    if ((kind & RB_VS_COMPRESSED) && !(kind & RB_VS_BC_QUIET)) return RB_VS_WHY_BC;
+    if (data == RB_VS_DATA_UNVOUCHED) return RB_VS_WHY_UNVOUCHED;
+    if (moves == RB_VS_SAME && data != RB_VS_DATA_RANGE) return RB_VS_WHY_OTHER;      // tables and bytes as recorded: the inline test's case, not this rule's
+    return RB_VS_KEEP;   // tables unmoved and the pool's count standing; additions or other serials' moves with the bytes vouched for (or a GPU texture's)
+}
diff --git a/graphics/nvn/tests/t_rb_dirty_range.c b/graphics/nvn/tests/t_rb_dirty_range.c
new file mode 100644
index 0000000..c03bfc6
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_dirty_range.c
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0320): the write count per tracked range (nvn_dirty_range_writes) against the page generations it stands for (nvn_dirty_since), with real write
+//   faults. Built as t_dirty_chunk is: this file + gfx/nvn/nvn_dirty.c (runtime/tests/mk/rb_dirty_range.mk); no GPU, no game.
+#include "../gfx/nvn/nvn_dirty.h"
+#include <assert.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int (*g_hook)(void *, int, void *);
+static void (*g_prep)(void *, size_t);
+void dm_fault_hook_register(int (*fn)(void *addr, int is_write, void *uc)) { g_hook = fn; }
+void dm_guest_write_prep_register(void (*fn)(void *addr, size_t len)) { g_prep = fn; }
+static void host_prepare(void *addr, size_t len) { if (g_prep) g_prep(addr, len); }   // the host's unprotect before it writes guest memory (dm_guest_write_prepare)
+static void guest_write(uint8_t *p, uint8_t v) { *(volatile uint8_t *)p = v; }   // volatile: the store, and the write fault it may take, stay where the test puts them
+void dm_log(const char *fmt, ...) { (void)fmt; }
+static void on_sig(int s, siginfo_t *si, void *uc) { if (g_hook && g_hook(si->si_addr, 1, uc)) return; signal(s, SIG_DFL); }
+extern int (*nvn_dirty_mp_hook)(void *addr, size_t len, int prot);
+static int g_fail_unprotect;
+static const void *g_probe_span; static uint8_t *g_probe_mem; static size_t g_probe_len;
+static volatile uint64_t g_probe_seen; static volatile int g_probes;   // volatile: stored from the write fault's handler
+static int test_hook(void *addr, size_t len, int prot) {   // called by the tracker in place of each mprotect's start: for an unprotect, between rb_wseq_open and the generations
+    (void)addr; (void)len;
+    if (!(prot & PROT_WRITE)) return 0;
+    if (g_probe_mem) { g_probe_seen = nvn_dirty_range_writes(&g_probe_span, g_probe_mem, g_probe_len); g_probes++; }
+    return g_fail_unprotect;
+}
+
+// The reader's protocol (nvn_mtl.m tex_by_id): the count is taken before the look at the pages, and kept only when that look left the texture clean against its stamp;
+//   the same non-zero count later stands for "clean" without a look.
+typedef struct { const void *span; uint64_t count, stamp; uint8_t *mem; size_t len; } view;
+static void view_validate(view *v) {   // the slow path
+    const uint64_t c = nvn_dirty_range_writes(&v->span, v->mem, v->len);
+    if (nvn_dirty_since(v->mem, v->len, v->stamp)) { nvn_dirty_protect(v->mem, v->len); v->stamp = nvn_dirty_now(); }   // as a re-upload: protect, stamp, then read
+    v->count = c;
+}
+static int view_kept(view *v) { const uint64_t c = nvn_dirty_range_writes(&v->span, v->mem, v->len); return c && c == v->count; }
+
+static _Atomic int g_stop; static _Atomic unsigned long g_writes;
+static uint8_t *g_wr_mem; static size_t g_wr_pages, g_wr_pg;
+static void *writer(void *arg) {   // writes a page of one pool now and then: a fault each time that page was protected again
+    unsigned s = (unsigned)(uintptr_t)arg;
+    while (!atomic_load(&g_stop)) {
+        s = s * 1664525u + 1013904223u; guest_write(g_wr_mem + (s >> 8) % g_wr_pages * g_wr_pg, (uint8_t)s); atomic_fetch_add(&g_writes, 1);
+        for (volatile unsigned spin = (s >> 16) & 0x3ff; spin; spin--) {}   // an uneven pause, so that the reader's looks fall before, inside and after an unprotect
+    }
+    return NULL;
+}
+
+// S2A_RB_VIEW_SCOPE=0 / S2A_RB_VIEW_RANGE=0 (a process of its own: the switch is read once): no count, and the tracking itself as before
+static int off_child(const char *name) {
+    setenv(name, "0", 1);
+    const size_t pg = (size_t)getpagesize();
+    uint8_t *m = mmap(NULL, 16 * pg, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    if (m == MAP_FAILED) return 2;
+    nvn_dirty_add_range(m, 16 * pg);
+    const void *span = NULL;
+    if (nvn_dirty_range_writes(&span, m + 2 * pg, 8 * pg) != 0) return 3;
+    nvn_dirty_protect(m + 2 * pg, 8 * pg);
+    const uint64_t st = nvn_dirty_now();
+    guest_write(m + 3 * pg, 1);   // a write fault, handled as before
+    if (!nvn_dirty_since(m + 2 * pg, 8 * pg, st) || nvn_dirty_now() == st) return 4;
+    if (nvn_dirty_range_writes(&span, m + 2 * pg, 8 * pg) != 0) return 5;
+    return 0;
+}
+static void off_case(const char *name) {
+    fflush(stdout);
+    const pid_t pid = fork();
+    assert(pid >= 0);
+    if (!pid) _exit(off_child(name));
+    int st = 0;
+    assert(waitpid(pid, &st, 0) == pid);
+    assert(WIFEXITED(st) && WEXITSTATUS(st) == 0);
+}
+
+int main(void) {
+    struct sigaction sa = {0}; sa.sa_sigaction = on_sig; sa.sa_flags = SA_SIGINFO;
+    sigaction(SIGBUS, &sa, NULL); sigaction(SIGSEGV, &sa, NULL);
+    off_case("S2A_RB_VIEW_SCOPE"); off_case("S2A_RB_VIEW_RANGE");   // before this process registers its first pool
+    unsetenv("S2A_RB_VIEW_SCOPE"); unsetenv("S2A_RB_VIEW_RANGE");   // the default: on
+
+    const size_t pg = (size_t)getpagesize();
+    uint8_t *m = mmap(NULL, 320 * pg, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    assert(m != MAP_FAILED);
+    uint8_t *A = m, *B = m + 64 * pg, *C = m + 160 * pg;   // three pools, apart
+    const void *none = NULL;
+    assert(nvn_dirty_range_writes(&none, A + 2 * pg, 8 * pg) == 0);   // before any pool is registered
+    nvn_dirty_add_range(A, 32 * pg); nvn_dirty_add_range(B, 32 * pg); nvn_dirty_add_range(C, 32 * pg);
+
+    // 1. a tracked span has a count, its own range's
+    const void *sa_ = NULL, *sb_ = NULL, *sc_ = NULL;
+    const uint64_t a0 = nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg), b0 = nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg), c0 = nvn_dirty_range_writes(&sc_, C + 2 * pg, 8 * pg);
+    assert(a0 && b0 && c0 && a0 != b0 && b0 != c0 && a0 != c0);
+    assert(sa_ == nvn_dirty_span(A + 2 * pg, 8 * pg) && sb_ == nvn_dirty_span(B + 2 * pg, 8 * pg));
+
+    // 2. a write fault in A moves A's count and the global generation; B's and C's counts stand
+    nvn_dirty_protect(A + 2 * pg, 8 * pg); nvn_dirty_protect(B + 2 * pg, 8 * pg);
+    assert(nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg) == a0);   // protecting stores no generation
+    const uint64_t g0 = nvn_dirty_now();
+    guest_write(A + 3 * pg + 5, 1);
+    const uint64_t a1 = nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg);
+    assert(nvn_dirty_now() > g0);                                      // what sends every CPU-written texture ID down the slow path today
+    assert(a1 && a1 != a0);                                            // MUST still invalidate: the written pool
+    assert(nvn_dirty_range_writes(&sa_, A + 20 * pg, 4 * pg) == a1);   // ... for every span of it, written page or not
+    assert(nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg) == b0 && nvn_dirty_range_writes(&sc_, C + 2 * pg, 8 * pg) == c0);
+    assert(nvn_dirty_since(A + 2 * pg, 8 * pg, g0) == 1 && nvn_dirty_since(B + 2 * pg, 8 * pg, g0) == 0);   // as the page generations say
+    guest_write(A + 3 * pg + 6, 2);                                    // the page is writable now: no fault, no generation, no count (as before: its texture is already dirty)
+    assert(nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg) == a1);
+
+    // 3. a host pre-write (a file read into guest memory) is a write too
+    const uint64_t b1 = nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg);
+    host_prepare(B + 4 * pg, 16); guest_write(B + 4 * pg, 7);
+    assert(nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg) != b1);
+    assert(nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg) == a1);
+    const uint64_t b2 = nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg);
+    host_prepare(B + 20 * pg, 16);                                     // over pages nobody protected: nothing is unprotected, nothing moves
+    assert(nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg) == b2);
+
+    // 4. no count stands for: untracked memory, a span no single range holds, a span wholly inside the first or the last host page of its range
+    const void *sx = NULL;
+    assert(nvn_dirty_range_writes(&sx, m + 40 * pg, pg) == 0);
+    sx = NULL; assert(nvn_dirty_range_writes(&sx, A + 30 * pg, 40 * pg) == 0);
+    sx = NULL; assert(nvn_dirty_range_writes(&sx, A + 16, 64) == 0);
+    sx = NULL; assert(nvn_dirty_range_writes(&sx, A + 32 * pg - 128, 64) == 0);
+    sx = NULL; assert(nvn_dirty_range_writes(&sx, A + 16, 2 * pg) != 0);            // from the first page into the second
+    sx = NULL; assert(nvn_dirty_range_writes(&sx, A + 30 * pg + 16, 2 * pg - 32) != 0);   // from the one before the last into the last
+    sx = NULL; assert(nvn_dirty_range_writes(&sx, A + 2 * pg, 0) == 0);
+    sx = sb_; assert(nvn_dirty_range_writes(&sx, A + 2 * pg, 8 * pg) == a1 && sx == sa_);   // a handle of another range is looked up again
+
+    // 5. a pool removed, then registered again over the same memory: never the old count
+    const uint64_t c1 = nvn_dirty_range_writes(&sc_, C + 2 * pg, 8 * pg);
+    nvn_dirty_remove_range(C);
+    assert(nvn_dirty_range_writes(&sc_, C + 2 * pg, 8 * pg) == 0);
+    nvn_dirty_add_range(C, 32 * pg);
+    const uint64_t c2 = nvn_dirty_range_writes(&sc_, C + 2 * pg, 8 * pg);
+    assert(c2 && c2 != c1 && c2 != c0);
+    assert(nvn_dirty_replace_range(C, 32 * pg) == 1);   // new backing under the same address: every page generation is stored anew
+    const uint64_t c3 = nvn_dirty_range_writes(&sc_, C + 2 * pg, 8 * pg);
+    assert(c3 && c3 != c2 && c3 != c1);
+
+    // 6. two pools sharing one host page (4 KB-aligned pools on a 16 KB-page host): a neighbour's write into the shared page moves the count of the range
+    //    whose texture is protected there
+    uint8_t *D = m + 200 * pg, *E = D + 8 * pg - pg / 2;   // D ends, and E starts, inside page 207
+    nvn_dirty_add_range(D, 8 * pg - pg / 2); nvn_dirty_add_range(E, 8 * pg);
+    const void *sd = NULL, *se = NULL;
+    const uint64_t d0 = nvn_dirty_range_writes(&sd, D + pg, 6 * pg + pg / 4), e0 = nvn_dirty_range_writes(&se, E + pg, 4 * pg);
+    assert(d0 && e0 && sd != se);
+    nvn_dirty_protect(D + pg, 6 * pg + pg / 4);   // reaches D's last page, the shared one
+    guest_write(E + 8, 3);                         // E's bytes in that host page
+    assert(nvn_dirty_range_writes(&sd, D + pg, 6 * pg + pg / 4) != d0);
+    assert(nvn_dirty_range_writes(&se, E + pg, 4 * pg) == e0);   // E protected nothing there: none of its generations was stored
+
+    // 7. a pool that overlaps another past a shared edge page: two ranges may hold one span, so neither count stands for it
+    uint8_t *F = m + 240 * pg;
+    nvn_dirty_add_range(F, 16 * pg);
+    const void *sf = NULL;
+    assert(nvn_dirty_range_writes(&sf, F + 2 * pg, 4 * pg) != 0);
+    nvn_dirty_add_range(F + 4 * pg, 8 * pg);       // inside F
+    assert(nvn_dirty_range_writes(&sf, F + 2 * pg, 4 * pg) == 0);
+    sf = NULL; assert(nvn_dirty_range_writes(&sf, F + 5 * pg, 2 * pg) == 0);
+
+    // 8. while an unprotect is under way (its mprotect not yet returned, its generations not yet stored) no count stands for its range; after it, a new one does
+    nvn_dirty_mp_hook = test_hook;
+    nvn_dirty_protect(A + 2 * pg, 8 * pg);
+    const uint64_t a2 = nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg);
+    g_probe_mem = A + 2 * pg; g_probe_len = 8 * pg; g_probe_seen = ~0ull; g_probes = 0;
+    guest_write(A + 5 * pg, 9);                    // a write fault
+    assert(g_probes == 1 && g_probe_seen == 0);
+    g_probe_seen = ~0ull; host_prepare(A + 7 * pg, 8); assert(g_probes == 2 && g_probe_seen == 0);   // a host pre-write
+    g_probe_mem = NULL;
+    const uint64_t a3 = nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg);
+    assert(a3 && a3 != a2 && a3 != a1 && a3 != a0);
+
+    // 9. the reader's protocol under concurrent writes: "the same count" never hides a page the look would report, and the pool nobody writes is kept every time
+    g_wr_mem = A; g_wr_pages = 32; g_wr_pg = pg;
+    view v = {.mem = A + 2 * pg, .len = 20 * pg}; nvn_dirty_protect(v.mem, v.len); v.stamp = nvn_dirty_now(); view_validate(&v);
+    view q = {.mem = B + 2 * pg, .len = 20 * pg}; nvn_dirty_protect(q.mem, q.len); q.stamp = nvn_dirty_now(); view_validate(&q);
+    pthread_t th[2]; for (int i = 0; i < 2; i++) assert(!pthread_create(&th[i], NULL, writer, (void *)(uintptr_t)(i + 1)));
+    unsigned long kept_a = 0, kept_b = 0, looks = 0, late = 0, rounds = 0;
+    for (; rounds < 1500000 || atomic_load(&g_writes) < 4000; rounds++) {   // long enough for the writers to have run, however the threads are scheduled
+        if (view_kept(&v)) {
+            kept_a++;
+            // a write may land right after the count was read (as it may right after a look): it must then show at the next one
+            if (nvn_dirty_since(v.mem, v.len, v.stamp)) { late++; assert(!view_kept(&v)); }
+        } else { view_validate(&v); looks++; }
+        if (view_kept(&q)) kept_b++; else view_validate(&q);
+    }
+    atomic_store(&g_stop, 1); for (int i = 0; i < 2; i++) pthread_join(th[i], NULL);
+    assert(kept_b == rounds);
+    assert(looks > 0);   // the written pool was looked at again
+    view_validate(&v); view_validate(&v);
+    assert(view_kept(&v) && !nvn_dirty_since(v.mem, v.len, v.stamp));   // once the writers stop, a look validates it and it is kept
+    printf("  written pool: kept %lu of %lu (a write landed right after the count %lu times), looked at %lu times; unwritten pool: kept %lu\n", kept_a, rounds, late, looks, kept_b);
+
+    // 10. tracking unreliable (an mprotect failed): no count stands for anything, as nvn_dirty_since answers "written" from then on
+    nvn_dirty_protect(B + 2 * pg, 2 * pg);
+    assert(nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg) != 0);
+    g_fail_unprotect = 1; host_prepare(B + 2 * pg, 16); g_fail_unprotect = 0;
+    assert(nvn_dirty_tracking_unreliable());
+    assert(nvn_dirty_range_writes(&sb_, B + 2 * pg, 8 * pg) == 0 && nvn_dirty_range_writes(&sa_, A + 2 * pg, 8 * pg) == 0);
+    puts("t_rb_dirty_range: ok");
+    return 0;
+}
diff --git a/graphics/nvn/tests/t_rb_view_scope.c b/graphics/nvn/tests/t_rb_view_scope.c
new file mode 100644
index 0000000..e7b18e8
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_view_scope.c
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0320): host-only checks of the texture-ID view rule (gfx/nvn/rb_view_scope.h): patch 0319's rule in its terms, what the new rule adds and what it
+//   must still send to a resolution, and a replay of table moves and guest writes against a model of what a resolution would find.
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../gfx/nvn/rb_view_epoch.h"
+#include "../gfx/nvn/rb_view_scope.h"
+
+enum { ALL_KINDS = 128 };
+static const int k_moves[] = {RB_VS_SAME, RB_VS_ADDS, RB_VS_SCOPED, RB_VS_OWN, RB_VS_GLOBAL};
+static const int k_data[] = {RB_VS_DATA_NONE, RB_VS_DATA_SAME, RB_VS_DATA_PERIOD, RB_VS_DATA_RANGE, RB_VS_DATA_WRITTEN, RB_VS_DATA_UNVOUCHED};
+static int data_vouched(int d) { return d == RB_VS_DATA_NONE || d == RB_VS_DATA_SAME || d == RB_VS_DATA_PERIOD || d == RB_VS_DATA_RANGE; }
+
+// ---- 1. patch 0319's lines (nvn_mtl.m tex_by_id at abedf64), transcribed on the values they read ----
+typedef struct {
+    uint64_t sg, sa, local, latest, dg, period;                                // now, under g_smu / at entry
+    uint64_t view_ser, view_sa, view_local, view_dirty, view_ep;              // the entry
+    int view_pkg, view_sp, gone, virtual_pool, compressed;
+} raw_t;
+static int before_lines(const raw_t *r) {
+    if (!(r->view_sa && !r->view_sp)) return 0;
+    uint64_t adds = r->sa - r->view_sa;
+    int additions_only = !r->view_pkg && r->sg - r->view_ser == adds;
+    int local_only = !r->gone && !r->virtual_pool &&
+        !r->compressed &&
+        (!r->view_pkg || r->view_dirty == r->dg || r->view_ep == r->period) &&
+        rb_view_epoch_reusable(r->sg, r->view_ser, adds, r->local, r->view_local, r->latest);
+    return additions_only || local_only;
+}
+static unsigned raw_kind(const raw_t *r, unsigned extra) {
+    return (r->gone ? RB_VS_GONE : 0) | (r->view_sp ? RB_VS_SPARSE : 0) | (r->virtual_pool ? RB_VS_VIRTUAL : 0) | (r->compressed ? RB_VS_COMPRESSED : 0) | extra;
+}
+static void check_before(void) {
+    unsigned long n = 0, kept = 0;
+    const uint64_t latests[] = {0, 4, 5, 6, 9};
+    for (uint64_t sg = 5; sg <= 9; sg++) for (uint64_t view_sa = 0; view_sa <= 3; view_sa += 3) for (uint64_t sa = 3; sa <= 6; sa++)
+    for (uint64_t local = 2; local <= 5; local++) for (unsigned li = 0; li < 5; li++) for (unsigned f = 0; f < 128; f++) {
+        raw_t r = {.sg = sg, .sa = sa, .local = local, .latest = latests[li], .dg = 40, .period = 7, .view_ser = 5, .view_sa = view_sa, .view_local = 2,
+                   .view_dirty = (f & 1) ? 40 : 39, .view_ep = (f & 2) ? 7 : 6, .view_pkg = !!(f & 4), .view_sp = !!(f & 8), .gone = !!(f & 16), .virtual_pool = !!(f & 32), .compressed = !!(f & 64)};
+        const int moves = rb_vs_moves(r.sg, r.sa, r.local, r.latest, r.view_ser, r.view_sa, r.view_local);
+        const uint64_t moved = r.sg - r.view_ser, adds = r.sa - r.view_sa, noted = r.local - r.view_local;
+        const int lines = before_lines(&r);
+        for (unsigned extra = 0; extra < 8; extra++) {   // patch 0319 read none of these three
+            const unsigned kind = raw_kind(&r, (extra & 1 ? RB_VS_LIVE : 0) | (extra & 2 ? RB_VS_BC_QUIET : 0) | (extra & 4 ? RB_VS_SUBMIT : 0));
+            for (uint64_t range = 0; range <= 2; range++) for (uint64_t seen_range = 0; seen_range <= 2; seen_range++) {
+                const int data = rb_vs_data(r.view_pkg, r.dg, r.view_dirty, r.period, r.view_ep, range, seen_range);
+                // without a count the data classes are patch 0319's own test of the bytes
+                if (!range) assert((data == RB_VS_DATA_NONE || data == RB_VS_DATA_SAME || data == RB_VS_DATA_PERIOD) == (!r.view_pkg || r.view_dirty == r.dg || r.view_ep == r.period));
+                const int old_data = rb_vs_data(r.view_pkg, r.dg, r.view_dirty, r.period, r.view_ep, 0, 0);   // patch 0319 had no count
+                assert(old_data == data || data == RB_VS_DATA_RANGE || data == RB_VS_DATA_WRITTEN);
+                const int before = rb_vs_before(moves, old_data, kind);
+                // The counts are read together under g_smu and each addition or noted move is a move, so moved >= adds + noted; there the two agree exactly.
+                //   Elsewhere (counts that could not have been read together) the class rule only keeps less
+                if (r.view_sa && moved >= adds + noted && adds + noted >= adds) assert(before == lines);
+                assert(!before || lines);
+                n++; kept += (unsigned long)before;
+            }
+        }
+    }
+    assert(n > 100000 && kept > 1000);
+}
+
+// ---- 2. the new rule over every class ----
+static void check_rule(void) {
+    int seen_why[RB_VS_WHY_N] = {0};
+    unsigned long added = 0, dropped = 0;
+    for (unsigned mi = 0; mi < 5; mi++) for (unsigned di = 0; di < 6; di++) for (unsigned kind = 0; kind < ALL_KINDS; kind++) {
+        const int moves = k_moves[mi], data = k_data[di];
+        const int why = rb_vs_why(moves, data, kind);
+        const int keep = why == RB_VS_KEEP;
+        const int old_data = data == RB_VS_DATA_RANGE ? RB_VS_DATA_WRITTEN : data;   // what patch 0319 saw where the new rule sees an unmoved count
+        const int before = rb_vs_before(moves, old_data, kind);
+        assert(why >= 0 && why < RB_VS_WHY_N);
+        seen_why[why]++;
+        // MUST still be resolved again, whatever else holds
+        if (moves == RB_VS_GLOBAL) assert(why == RB_VS_WHY_GLOBAL || why == RB_VS_WHY_SPARSE);          // a move nobody classified
+        if (moves == RB_VS_OWN) assert(why == RB_VS_WHY_OWN || why == RB_VS_WHY_SPARSE);                // its own serial, or one sharing its bucket
+        if (kind & RB_VS_SPARSE) assert(why == RB_VS_WHY_SPARSE);                                         // placement sparse
+        if (data == RB_VS_DATA_WRITTEN) assert(!keep);                                                    // its pool was written
+        if (data == RB_VS_DATA_UNVOUCHED) assert(!keep);                                                  // guest writes somewhere and no count standing for it
+        // what patch 0073 kept stays kept (a GPU texture's view across additions): no ID of today's fast keeps goes back to the slow path for those
+        if (data == RB_VS_DATA_NONE && (moves == RB_VS_SAME || moves == RB_VS_ADDS) && !(kind & RB_VS_SPARSE)) assert(keep && before);
+        // everything else that is kept: a live object last resolved on the submit thread, an ordinary pool, bytes vouched for, nothing to copy into a compressed one
+        if (keep && !(data == RB_VS_DATA_NONE && moves != RB_VS_SCOPED)) {
+            assert(kind & RB_VS_LIVE);
+            assert(kind & RB_VS_SUBMIT);
+            assert(!(kind & (RB_VS_GONE | RB_VS_VIRTUAL)));
+            assert(!(kind & RB_VS_COMPRESSED) || (kind & RB_VS_BC_QUIET));
+            assert(data_vouched(data));
+            assert(moves == RB_VS_SAME || moves == RB_VS_ADDS || moves == RB_VS_SCOPED);
+            if (moves == RB_VS_SAME) assert(data == RB_VS_DATA_RANGE);
+        }
+        // against patch 0319: the only views it kept that are now resolved are, across noted moves (a Finalize is one now), a finalized object's and one last
+        //   resolved off the submit thread
+        if (before && !keep) { assert(moves == RB_VS_SCOPED && (!(kind & RB_VS_LIVE) ? why == RB_VS_WHY_DEAD : !(kind & RB_VS_SUBMIT) && why == RB_VS_WHY_OFFTHREAD)); dropped++; }
+        if (keep && !before) added++;
+    }
+    for (int w = 0; w < RB_VS_WHY_N; w++) assert(seen_why[w] > 0);
+    assert(added > 0 && dropped > 0);
+
+    const unsigned live = RB_VS_LIVE | RB_VS_SUBMIT, bc = live | RB_VS_COMPRESSED, bcq = bc | RB_VS_BC_QUIET;
+    // the race's case: a block-compressed CPU-written texture of a live object in an ordinary pool
+    assert(rb_vs_why(RB_VS_SAME, RB_VS_DATA_RANGE, bcq) == RB_VS_KEEP);       // a guest write in another pool, tables unmoved
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_RANGE, bcq) == RB_VS_KEEP);       // ... and textures made meanwhile
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_RANGE, bcq) == RB_VS_KEEP);     // ... and other textures finalized
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_SAME, bcq) == RB_VS_KEEP && rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_PERIOD, bcq) == RB_VS_KEEP);
+    assert(!rb_vs_before(RB_VS_SAME, RB_VS_DATA_WRITTEN, bcq) && !rb_vs_before(RB_VS_ADDS, RB_VS_DATA_SAME, bcq) && !rb_vs_before(RB_VS_SCOPED, RB_VS_DATA_SAME, bcq));   // none of them before
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_SAME, live) == RB_VS_KEEP && !rb_vs_before(RB_VS_ADDS, RB_VS_DATA_SAME, live));   // uncompressed CPU-written, across additions
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_NONE, bcq) == RB_VS_KEEP);      // a compressed GPU texture across noted moves
+    // and each reason it is not kept
+    assert(rb_vs_why(RB_VS_SAME, RB_VS_DATA_WRITTEN, bcq) == RB_VS_WHY_WRITTEN);        // the guest wrote its pool: the texture itself may have changed
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_WRITTEN, bcq) == RB_VS_WHY_WRITTEN);
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_WRITTEN, live) == RB_VS_WHY_WRITTEN);
+    assert(rb_vs_why(RB_VS_SAME, RB_VS_DATA_UNVOUCHED, bcq) == RB_VS_WHY_UNVOUCHED);    // no count (shared edge page, overlapping pool, unprotect under way, last look not clean, switch off)
+    assert(rb_vs_why(RB_VS_GLOBAL, RB_VS_DATA_SAME, bcq) == RB_VS_WHY_GLOBAL);          // a takeover, an eviction, an upgrade, ...
+    assert(rb_vs_why(RB_VS_GLOBAL, RB_VS_DATA_NONE, live) == RB_VS_WHY_GLOBAL);
+    assert(rb_vs_why(RB_VS_OWN, RB_VS_DATA_RANGE, bcq) == RB_VS_WHY_OWN);               // its own re-upload or Finalize
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_RANGE, bc) == RB_VS_WHY_BC);                // a GPU write through an uncompressed texture is, or may come to be, on record over its storage
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_SAME, bc) == RB_VS_WHY_BC);
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_RANGE, bcq & ~(unsigned)RB_VS_LIVE) == RB_VS_WHY_DEAD);   // a finalized object's descriptor still registered
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_NONE, 0) == RB_VS_WHY_DEAD && rb_vs_before(RB_VS_SCOPED, RB_VS_DATA_NONE, 0));
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_SAME, bcq & ~(unsigned)RB_VS_SUBMIT) == RB_VS_WHY_OFFTHREAD);   // last resolved off the submit thread: nothing was uploaded or looked at there
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_PERIOD, RB_VS_LIVE) == RB_VS_WHY_OFFTHREAD);
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_SAME, live | RB_VS_VIRTUAL) == RB_VS_WHY_POOL);            // a sparse pool: a mapping request moves no count
+    assert(rb_vs_why(RB_VS_SCOPED, RB_VS_DATA_SAME, live | RB_VS_GONE) == RB_VS_WHY_POOL);
+    assert(rb_vs_why(RB_VS_ADDS, RB_VS_DATA_NONE, RB_VS_SPARSE | live) == RB_VS_WHY_SPARSE);
+    assert(rb_vs_why(RB_VS_SAME, RB_VS_DATA_SAME, bcq) == RB_VS_WHY_OTHER);
+
+    // rb_vs_moves: additions, moves noted for others, the view's own bucket, a collision, an unclassified move, counts not taken
+    rb_view_epoch ep; memset(&ep, 0, sizeof ep);
+    uint64_t gen = 10, add = 4;
+    const uint64_t mine = 1000, other = 1001, clash = mine + RB_VIEW_BUCKETS * 131072ull;   // clash: another serial of mine's bucket
+    assert(rb_view_bucket(other) != rb_view_bucket(mine) && rb_view_bucket(clash) == rb_view_bucket(mine) && clash != mine);
+    const uint64_t s_gen = gen, s_add = add, s_local = ep.writes;
+#define MOVES() rb_vs_moves(gen, add, ep.writes, ep.bucket[rb_view_bucket(mine)], s_gen, s_add, s_local)
+    assert(MOVES() == RB_VS_SAME);
+    gen++; add++;                                    assert(MOVES() == RB_VS_ADDS);     // tex_put of a serial no table held
+    rb_view_note(&ep, other, ++gen);                 assert(MOVES() == RB_VS_SCOPED);   // another texture finalized (serial_del_kind, this patch) or re-uploaded
+    gen++; add++;                                    assert(MOVES() == RB_VS_SCOPED);
+    assert(rb_vs_moves(gen, add, ep.writes, ep.bucket[rb_view_bucket(mine)], s_gen, 0, s_local) == RB_VS_GLOBAL);   // counts not taken with the view
+    { rb_view_epoch e2 = ep; uint64_t g2 = gen; rb_view_note(&e2, mine, ++g2);
+      assert(rb_vs_moves(g2, add, e2.writes, e2.bucket[rb_view_bucket(mine)], s_gen, s_add, s_local) == RB_VS_OWN); }
+    { rb_view_epoch e2 = ep; uint64_t g2 = gen; rb_view_note(&e2, clash, ++g2);
+      assert(rb_vs_moves(g2, add, e2.writes, e2.bucket[rb_view_bucket(mine)], s_gen, s_add, s_local) == RB_VS_OWN); }
+    gen++;                                           assert(MOVES() == RB_VS_GLOBAL);   // S2A_RB_VIEW_SCOPE=0: what a texture's Finalize is, as before
+    rb_view_note(&ep, other, ++gen); gen++; add++;   assert(MOVES() == RB_VS_GLOBAL);   // nothing later undoes it
+#undef MOVES
+    // a move noted in the view's bucket before the view was validated does not count against it
+    { rb_view_epoch e2; memset(&e2, 0, sizeof e2); uint64_t g2 = 20; rb_view_note(&e2, mine, ++g2);
+      const uint64_t vg = g2, vl = e2.writes; rb_view_note(&e2, other, ++g2);
+      assert(rb_vs_moves(g2, 9, e2.writes, e2.bucket[rb_view_bucket(mine)], vg, 9, vl) == RB_VS_SCOPED); }
+
+    // rb_vs_data
+    assert(rb_vs_data(0, 2, 1, 2, 1, 0, 0) == RB_VS_DATA_NONE && rb_vs_data(0, 2, 1, 2, 1, 5, 4) == RB_VS_DATA_NONE);
+    assert(rb_vs_data(1, 7, 7, 2, 1, 5, 4) == RB_VS_DATA_SAME);
+    assert(rb_vs_data(1, 8, 7, 3, 3, 5, 4) == RB_VS_DATA_PERIOD);
+    assert(rb_vs_data(1, 8, 7, 3, 2, 5, 5) == RB_VS_DATA_RANGE);
+    assert(rb_vs_data(1, 8, 7, 3, 2, 6, 5) == RB_VS_DATA_WRITTEN);       // its pool written since
+    assert(rb_vs_data(1, 8, 7, 3, 2, 0, 5) == RB_VS_DATA_UNVOUCHED);     // no count now (an unprotect under way, tracking unreliable, the switch off)
+    assert(rb_vs_data(1, 8, 7, 3, 2, 5, 0) == RB_VS_DATA_UNVOUCHED);     // none taken at its last clean look
+    assert(rb_vs_data(1, 8, 7, 3, 2, 0, 0) == RB_VS_DATA_UNVOUCHED);     // never an "unmoved" count of 0
+}
+
+// ---- 3. a replay: table moves, guest writes and bindings against a model of what a resolution (tex_mtl) would do ----
+// Per texture the model holds what tex_mtl reads: whether a serial table holds it and which host texture (obj), its pages (written since its last look), the write
+//   generation at that look (NvPkg seen: with no guest write since, tex_mtl does not walk the pages again), its pool's mappings (a virtual pool), and the record of a GPU
+//   write through an uncompressed texture over its storage (compressed). The moves follow the patch's discipline: an addition moves both counts; a re-upload and, with
+//   the switch on, a Finalize are noted for their serial; everything else is unclassified. Two IDs read each texture.
+//   The oracle, at every view the patch's rule keeps and patch 0319's did not: a resolution now would give the view's host texture and would do nothing else (no
+//   upload, no mapping to follow, no level to copy). Mutants of the rule and of the stamps must each trip it.
+enum { NTEX = 96, NVIEW = 2 * NTEX, NPOOL = 8, NPROG = 8 };
+enum { MUT_NONE = 0, MUT_CLEAN_UNWALKED, MUT_KEEP_VIRTUAL, MUT_BC_ANY, MUT_FINALIZE_SILENT, MUT_ANY_THREAD, MUT_N };
+typedef struct {
+    uint64_t serial; int pool, pkg, compressed, live, in_table;
+    uint64_t obj;                         // the host texture a resolution gives
+    int page_dirty; uint64_t pk_seen;     // a page of it written since its last successful look or upload; the write generation at its last look
+    int standin;                          // (CPU-written) first needed off the submit thread: a GPU texture stands in until the submit thread uploads it
+    int bc_seen, bc_record, bc_unsynced;  // its storage on record as resolved; a GPU write on record over it; levels of that write not yet copied into it
+    uint64_t maps, maps_seen;             // (virtual pool) its mappings now, and at its last look
+} tex_m;
+typedef struct { int has; uint64_t seen_ser, seen_add, seen_local, seen_dirty, seen_period, seen_range; int pkg, bc_quiet, sub; uint64_t obj; } view_m;
+static struct {
+    tex_m t[NTEX]; view_m v[NVIEW];
+    uint64_t gen, add, dirty, period, wseq, next_serial, next_obj;
+    rb_view_epoch ep;
+    uint64_t pool_wseq[NPOOL]; int pool_virtual[NPOOL], pool_uncounted[NPOOL];   // uncounted: no count stands for its textures (a shared edge page, an overlapping pool)
+    unsigned rnd; int scope, mut;
+    unsigned long kept[RB_VS_GLOBAL + 1], kept_new, kept_range, why[RB_VS_WHY_N], fast, slow, reuploads, failed_uploads, bad;
+} M;
+static unsigned rnd(unsigned n) { M.rnd = M.rnd * 1664525u + 1013904223u; return (M.rnd >> 10) % n; }
+static void unclassified(void) { M.gen++; }
+static void noted(uint64_t serial) { rb_view_note(&M.ep, serial, ++M.gen); }
+static uint64_t range_now(const tex_m *t) { return M.pool_virtual[t->pool] || M.pool_uncounted[t->pool] ? 0 : M.pool_wseq[t->pool]; }   // nvn_dirty_range_writes
+static void put(tex_m *t) {   // tex_put
+    if (!t->in_table && t->live) { M.gen++; M.add++; } else unclassified();   // a live serial no table held; else a replacement, or a finalized serial (the ring)
+    t->in_table = 1;
+}
+// What tex_mtl would do now. look = 0: only say whether it would do anything but return the view's texture (the oracle); look = 1: do it. Returns that answer
+static int resolve_tex(tex_m *t, int look, int upload_fails, int on_submit_thread, int in_submission, int *walked_clean) {
+    int work = 0;
+    *walked_clean = 0;
+    if (!t->in_table) { work = 1; if (look) { t->obj = ++M.next_obj; put(t); t->page_dirty = 0; t->pk_seen = M.dirty; t->standin = t->pkg && !on_submit_thread; } }   // made (again): another host texture
+    else if (t->pkg && !on_submit_thread) { }                                                                 // off the submit thread: what exists is handed out, not looked at
+    else if (t->pkg && t->standin) { work = 1; if (look) { t->obj = ++M.next_obj; t->standin = 0; t->page_dirty = 0; t->pk_seen = M.dirty; unclassified(); } }   // uploaded at last: it replaces the stand-in (tex_put over a held serial)
+    else if (t->pkg) {
+        const int walked = M.dirty != t->pk_seen;   // tex_mtl: now == pk->seen, no walk
+        if (look) t->pk_seen = M.dirty;
+        if (walked && t->page_dirty) {
+            work = 1;
+            if (look && !upload_fails) { t->obj = ++M.next_obj; t->page_dirty = 0; noted(t->serial); M.reuploads++; }   // re-upload, noted for its serial (patch 0163)
+            else if (look) M.failed_uploads++;                                                                         // no memory for it: the old texture stays, its pages still dirty
+        } else if (walked || M.mut == MUT_CLEAN_UNWALKED) *walked_clean = !work;
+    }
+    if (M.pool_virtual[t->pool] && t->maps != t->maps_seen) { work = 1; if (look) t->maps_seen = t->maps; }   // its tiles / upload follow the mappings
+    if (t->compressed && on_submit_thread && in_submission) {   // bcal_sync: only there are the levels taken and the storage put on record
+        if (t->bc_unsynced) { work = 1; if (look) t->bc_unsynced = 0; }
+        if (look) t->bc_seen = 1;
+    }
+    return work;
+}
+static void resolve(int j) {   // tex_by_id's slow path
+    tex_m *t = &M.t[j % NTEX]; view_m *v = &M.v[j];
+    const uint64_t sg = M.gen, sa = M.add, sl = M.ep.writes, dg = M.dirty;   // taken before the look, as tex_by_id takes them
+    const uint64_t wq = M.scope && t->pkg ? range_now(t) : 0;                // ... and the pool's count
+    const int on_submit_thread = rnd(16) != 0, in_submission = rnd(8) != 0; int clean = 0;
+    resolve_tex(t, 1, rnd(8) == 0, on_submit_thread, in_submission, &clean);
+    v->has = 1; v->seen_ser = sg; v->seen_add = sa; v->seen_local = sl; v->seen_dirty = dg; v->seen_period = M.period; v->pkg = t->pkg; v->obj = t->obj;
+    v->seen_range = clean ? wq : 0;
+    v->bc_quiet = M.scope && t->compressed && t->bc_seen && !t->bc_record;   // rb_bcal_quiet
+    v->sub = on_submit_thread;
+    M.slow++;
+}
+static void use(int j) {   // a draw binds the ID
+    tex_m *t = &M.t[j % NTEX]; view_m *v = &M.v[j];
+    if (!v->has) { resolve(j); return; }
+    if (v->seen_ser == M.gen && (!v->pkg || v->seen_dirty == M.dirty || v->seen_period == M.period)) { M.fast++; return; }   // the inline test, as before
+    const uint64_t range = M.scope && v->pkg ? range_now(t) : 0;
+    const int moves = rb_vs_moves(M.gen, M.add, M.ep.writes, M.ep.bucket[rb_view_bucket(t->serial)], v->seen_ser, v->seen_add, v->seen_local);
+    const int data = rb_vs_data(v->pkg, M.dirty, v->seen_dirty, M.period, v->seen_period, range, v->seen_range);
+    unsigned kind = (M.pool_virtual[t->pool] ? RB_VS_VIRTUAL : 0) | (t->compressed ? RB_VS_COMPRESSED : 0) | (v->bc_quiet ? RB_VS_BC_QUIET : 0) | (t->live ? RB_VS_LIVE : 0) | (v->sub ? RB_VS_SUBMIT : 0);
+    const int before = rb_vs_before(moves, data == RB_VS_DATA_RANGE || data == RB_VS_DATA_WRITTEN || data == RB_VS_DATA_UNVOUCHED ? RB_VS_DATA_WRITTEN : data, kind);
+    unsigned asked = kind;
+    if (M.mut == MUT_KEEP_VIRTUAL) asked &= ~(unsigned)RB_VS_VIRTUAL;
+    if (M.mut == MUT_BC_ANY) asked |= RB_VS_BC_QUIET;
+    if (M.mut == MUT_ANY_THREAD) asked |= RB_VS_SUBMIT;
+    const int why = M.scope ? rb_vs_why(moves, data, asked) : before ? RB_VS_KEEP : RB_VS_WHY_OTHER;
+    if (why != RB_VS_KEEP) { M.why[why]++; resolve(j); return; }
+    int clean = 0;
+    // every kept view: the tables still hold the host texture it was validated against
+    if (!t->in_table || t->obj != v->obj) M.bad++;
+    if (!before) {
+        // kept by this patch alone: a resolution would do nothing. In a check period the bytes are not looked at twice, by the rule patch 0319 already has
+        tex_m probe = *t; if (data == RB_VS_DATA_PERIOD) probe.page_dirty = 0;
+        if (resolve_tex(&probe, 0, 0, 1, 1, &clean)) M.bad++;
+        M.kept_new++;
+    }
+    v->seen_ser = M.gen; v->seen_add = M.add; v->seen_local = M.ep.writes;
+    if (data == RB_VS_DATA_RANGE) { v->seen_dirty = M.dirty; v->seen_period = M.period; M.kept_range++; }
+    M.kept[moves]++;
+}
+static void replay(unsigned seed, int scope, int mut, unsigned long steps) {
+    memset(&M, 0, sizeof M);
+    M.rnd = seed; M.scope = scope; M.mut = mut; M.gen = 1; M.add = 1; M.dirty = 1; M.period = 1; M.next_serial = 100;
+    for (int p = 0; p < NPOOL; p++) { M.pool_wseq[p] = ++M.wseq; M.pool_virtual[p] = p == 6; M.pool_uncounted[p] = p == 7; }
+    for (int i = 0; i < NTEX; i++) M.t[i] = (tex_m){.serial = ++M.next_serial, .pool = i % NPOOL, .pkg = i % 5 != 0, .compressed = i % 3 != 0, .live = 1};
+    for (unsigned long s = 0; s < steps; s++) {
+        const unsigned e = rnd(10000); const int j = (int)rnd(NVIEW); tex_m *t = &M.t[j % NTEX];
+        if (e < 9000) use(j);
+        else if (e < 9400) { M.gen++; M.add++; }        // a texture no modelled ID reads is made and resolved: an addition
+        else if (e < 9550) {   // Finalize: its serial leaves the tables (serial_del_kind). Most of the time the game then registers a new object in the ID's place
+            if (t->live) {
+                t->live = 0;
+                if (t->in_table) { t->in_table = 0; if (M.mut == MUT_FINALIZE_SILENT) { /* nothing told */ } else if (M.scope) noted(t->serial); else unclassified(); }
+            }
+            if (rnd(5)) {
+                *t = (tex_m){.serial = ++M.next_serial, .pool = t->pool, .pkg = t->pkg, .compressed = t->compressed, .live = 1};
+                M.v[j % NTEX].has = M.v[j % NTEX + NTEX].has = 0;   // nvn_be_reg_tex with another texture drops the ID's view
+            }
+        }
+        else if (e < 9750) {   // the guest writes a protected page of this texture's pool: this texture's, or another's there
+            M.dirty++; if (!M.pool_virtual[t->pool]) M.pool_wseq[t->pool] = ++M.wseq;
+            if (rnd(3) == 0 && t->pkg) t->page_dirty = 1;
+        }
+        else if (e < 9900) M.period++;                   // the next submission, or a wait on another queue
+        else if (e < 9950) noted(900000 + rnd(NPROG));   // a program made or released
+        else if (e < 9955) {   // a move nobody classifies (takeover, eviction, upgrade, the ring letting go): serials leave the tables, their next resolution makes them anew
+            unclassified(); for (int k = 0; k < 3; k++) M.t[rnd(NTEX)].in_table = 0;
+        }
+        else if (e < 9965) {   // a GPU write through an uncompressed texture over a compressed one's storage (bcal_note): unclassified only where a compressed one was resolved
+            if (t->compressed) { t->bc_record = 1; t->bc_unsynced = 1; if (t->bc_seen) unclassified(); }
+        }
+        else if (M.pool_virtual[t->pool]) t->maps++;     // a mapping request in a virtual pool: no count moves
+    }
+}
+static void check_replay(void) {
+    unsigned long kept_new = 0, range = 0, why[RB_VS_WHY_N] = {0}, slow_on = 0, slow_off = 0, bad_mut[MUT_N] = {0};
+    for (unsigned seed = 1; seed <= 12; seed++) {
+        replay(seed, 0, MUT_NONE, 200000);   // patch 0319's rule and discipline (S2A_RB_VIEW_SCOPE=0)
+        assert(M.bad == 0 && M.kept_new == 0);
+        slow_off += M.slow;
+        replay(seed, 1, MUT_NONE, 200000);   // this patch's
+        assert(M.bad == 0);
+        assert(M.reuploads > 0 && M.failed_uploads > 0);   // textures the guest rewrote were found and uploaded again, or left to a later look
+        kept_new += M.kept_new; range += M.kept_range; slow_on += M.slow;
+        for (int w = 1; w < RB_VS_WHY_N; w++) why[w] += M.why[w];
+        for (int mut = MUT_NONE + 1; mut < MUT_N; mut++) { replay(seed, 1, mut, 200000); bad_mut[mut] += M.bad; }
+    }
+    assert(kept_new > 10000 && range > 1000);
+    assert(slow_on < slow_off);
+    assert(why[RB_VS_WHY_GLOBAL] && why[RB_VS_WHY_OWN] && why[RB_VS_WHY_WRITTEN] && why[RB_VS_WHY_POOL] && why[RB_VS_WHY_DEAD] && why[RB_VS_WHY_OFFTHREAD] && why[RB_VS_WHY_BC] && why[RB_VS_WHY_UNVOUCHED]);
+    // negative controls: each of these is wrong, and the replay shows it
+    assert(bad_mut[MUT_CLEAN_UNWALKED] > 0);        // a count recorded although that look did not walk the pages (an upload that failed just before left them dirty)
+    assert(bad_mut[MUT_KEEP_VIRTUAL] > 0);          // a virtual pool's texture kept across a mapping request
+    assert(bad_mut[MUT_BC_ANY] > 0);                // a compressed one kept with a GPU write on record, or its storage not on record as resolved
+    assert(bad_mut[MUT_FINALIZE_SILENT] > 0);       // a Finalize that moves nothing
+    assert(bad_mut[MUT_ANY_THREAD] > 0);            // a view last resolved off the submit thread kept: the upload its texture still waits for is put off
+    printf("  replay: resolutions %lu -> %lu; %lu views kept by this patch alone (%lu by their pool's write count); resolved again: unclassified move %lu, own bucket %lu, "
+           "pool written %lu, virtual pool %lu, finalized object %lu, off the submit thread %lu, compressed %lu, no count %lu\n", slow_off, slow_on, kept_new, range,
+           why[RB_VS_WHY_GLOBAL], why[RB_VS_WHY_OWN], why[RB_VS_WHY_WRITTEN], why[RB_VS_WHY_POOL], why[RB_VS_WHY_DEAD], why[RB_VS_WHY_OFFTHREAD], why[RB_VS_WHY_BC], why[RB_VS_WHY_UNVOUCHED]);
+}
+
+int main(void) {
+    check_before();
+    check_rule();
+    check_replay();
+    puts("t_rb_view_scope: ok");
+    return 0;
+}
