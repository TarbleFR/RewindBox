+    rb_gdiag_cut reasons[RB_GDIAG_CUTS];
+    rb_gdiag_shader shaders[RB_GDIAG_SHADERS];
+} g_rb_gdiag;
+static void rb_gpudiag_emit(void) {
+    if (!g_rb_gdiag.passes && !g_rb_gdiag.cuts) return;
+    unsigned long long frame=(unsigned long long)g_rb_gdiag.frame;
+    MLOG("[rb-gpudiag] frame=%llu passes=%llu cuts=%llu draws=%llu dropped_targets=%llu dropped_cuts=%llu",
+         frame,(unsigned long long)g_rb_gdiag.passes,(unsigned long long)g_rb_gdiag.cuts,
+         (unsigned long long)g_rb_gdiag.draws,(unsigned long long)g_rb_gdiag.dropped_targets,(unsigned long long)g_rb_gdiag.dropped_cuts);
+    for (unsigned i=0;i<g_rb_gdiag.nc;i++) {
+        rb_gdiag_cut *c=&g_rb_gdiag.reasons[i];
+        MLOG("[rb-gpudiag-cut] frame=%llu cause=%s:%u count=%u",frame,c->function,c->line,c->count);
+    }
+    for (unsigned i=0;i<g_rb_gdiag.nt;i++) {
+        rb_gdiag_target *t=&g_rb_gdiag.targets[i];
+        if (t->opens<2) continue;
+        MLOG("[rb-gpudiag-target] frame=%llu serial=%llu role=%s width=%u height=%u level=%u slice=%u opens=%u reopens=%u",
+             frame,(unsigned long long)t->serial,t->role ? "depth" : "color",t->w,t->h,t->level,t->slice,t->opens,t->opens-1);
+    }
+    // Per-key counts span 300 frames, while pass/cut/target rows describe one frame.
+    if (g_rb_gdiag.frame && !(g_rb_gdiag.frame%300)) {
+        for (unsigned i=0;i<g_rb_gdiag.ns;i++) {
+            rb_gdiag_shader *s=&g_rb_gdiag.shaders[i];
+            MLOG("[rb-gpudiag-shader] up_to_frame=%llu key=%s draws=%llu depth_test_draws=%llu source_known=%u explicit_early=%u discard=%u depth_output=%u sample_mask=%u pool_atomic_or=%u scope=existing-library-lexical-facts hardware_early_z=unmeasured",
+                 frame,s->key,(unsigned long long)s->draws,(unsigned long long)s->depth_draws,s->known,
+                 !!(s->facts&RB_MSL_EARLY),!!(s->facts&RB_MSL_DISCARD),!!(s->facts&RB_MSL_DEPTH),!!(s->facts&RB_MSL_SMASK),!!(s->facts&RB_MSL_POOL_ATOMIC));
+        }
+        MLOG("[rb-gpudiag-shader-coverage] up_to_frame=%llu keys=%u unknown_source_draws=%llu dropped_keys=%llu",
+             frame,g_rb_gdiag.ns,(unsigned long long)g_rb_gdiag.source_unknown,(unsigned long long)g_rb_gdiag.dropped_shaders);
+        g_rb_gdiag.ns=0; g_rb_gdiag.source_unknown=0; g_rb_gdiag.dropped_shaders=0;
+    }
+}
+static void rb_gpudiag_frame(uint64_t frame) {
+    if (g_rb_gdiag.frame==frame) return;
+    rb_gpudiag_emit();
+    g_rb_gdiag.frame=frame; g_rb_gdiag.passes=0; g_rb_gdiag.cuts=0; g_rb_gdiag.draws=0;
+    g_rb_gdiag.nt=0; g_rb_gdiag.nc=0; g_rb_gdiag.dropped_targets=0; g_rb_gdiag.dropped_cuts=0;
+}
+static void rb_gpudiag_target(uint64_t serial,unsigned level,unsigned slice,unsigned w,unsigned h,unsigned role) {
+    if (!serial) return;
+    unsigned i=0;
+    for (;i<g_rb_gdiag.nt;i++) { rb_gdiag_target *t=&g_rb_gdiag.targets[i]; if (t->serial==serial && t->level==level && t->slice==slice && t->role==role) break; }
+    if (i==g_rb_gdiag.nt) {
+        if (i==RB_GDIAG_TARGETS) { g_rb_gdiag.dropped_targets++; return; }
+        g_rb_gdiag.targets[g_rb_gdiag.nt++]=(rb_gdiag_target){serial,level,slice,w,h,role,0};
+    }
+    g_rb_gdiag.targets[i].opens++;
+}
+static void rb_gpudiag_cut(const char *function,unsigned line) {
+    if (!rb_gpudiag_on()) return;
+    g_rb_gdiag.cuts++;
+    unsigned i=0;
+    for (;i<g_rb_gdiag.nc;i++) if (g_rb_gdiag.reasons[i].function==function && g_rb_gdiag.reasons[i].line==line) break;
+    if (i==g_rb_gdiag.nc) {
+        if (i==RB_GDIAG_CUTS) { g_rb_gdiag.dropped_cuts++; return; }
+        g_rb_gdiag.reasons[g_rb_gdiag.nc++]=(rb_gdiag_cut){function,line,0};
+    }
+    g_rb_gdiag.reasons[i].count++;
+}
+static void rb_gpudiag_draw(const char *key,unsigned facts,unsigned known,int depth_test) {
+    if (!rb_gpudiag_on()) return;
+    g_rb_gdiag.draws++;
+    if (!known) g_rb_gdiag.source_unknown++;
+    unsigned i=0;
+    for (;i<g_rb_gdiag.ns;i++) if (!strcmp(g_rb_gdiag.shaders[i].key,key)) break;
+    if (i==g_rb_gdiag.ns) {
+        if (i==RB_GDIAG_SHADERS) { g_rb_gdiag.dropped_shaders++; return; }
+        rb_gdiag_shader *s=&g_rb_gdiag.shaders[g_rb_gdiag.ns++];
+        memset(s,0,sizeof *s); snprintf(s->key,sizeof s->key,"%s",key); s->facts=facts; s->known=known;
+    }
+    g_rb_gdiag.shaders[i].draws++; if (depth_test) g_rb_gdiag.shaders[i].depth_draws++;
+}
+static void rb_gpudiag_reset(void) { atomic_store(&g_rb_gpudiag_mode,-1); memset(&g_rb_gdiag,0,sizeof g_rb_gdiag); }
