new file mode 100644
index 0000000..8a192bf
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_gpu_facts.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 S2Arm contributors
+#pragma once
+#include <stddef.h>
+#include <string.h>
+enum { RB_MSL_EARLY=1, RB_MSL_DISCARD=2, RB_MSL_DEPTH=4, RB_MSL_SMASK=8, RB_MSL_POOL_ATOMIC=16 };
+// Lexical facts from existing MSL only, not proof of hardware early-Z execution.
+// Skip comments and quoted literals so comments cannot invent a blocker.
+static inline unsigned rb_gpu_msl_facts(const char *p) {
+    unsigned bits=0;
+    if (!p) return 0;
+    while (*p) {
+        if (p[0]=='/' && p[1]=='/') { while (*p && *p!='\n') p++; continue; }
+        if (p[0]=='/' && p[1]=='*') { p+=2; while (*p && !(p[0]=='*' && p[1]=='/')) p++; if (*p) p+=2; continue; }
+        if (*p=='"' || *p=='\'') { char quote=*p++; while (*p && *p!=quote) { if (*p=='\\' && p[1]) p++; p++; } if (*p) p++; continue; }
+        if ((*p>='a' && *p<='z') || (*p>='A' && *p<='Z') || *p=='_') {
+            const char *b=p++;
+            while ((*p>='a' && *p<='z') || (*p>='A' && *p<='Z') || (*p>='0' && *p<='9') || *p=='_') p++;
+            size_t n=(size_t)(p-b);
+#define RB_WORD(w) (n==sizeof(w)-1 && !memcmp(b,w,n))
+            if (RB_WORD("early_fragment_tests")) bits|=RB_MSL_EARLY;
+            else if (RB_WORD("discard_fragment")) bits|=RB_MSL_DISCARD;
+            else if (RB_WORD("sample_mask")) bits|=RB_MSL_SMASK;
+            else if (RB_WORD("depth")) {
+                const char *a=p; while (*a==' ' || *a=='\n' || *a=='\t') a++;
+                if (*a=='(') bits|=RB_MSL_DEPTH;
+            } else if (RB_WORD("atomic_fetch_or_explicit")) bits|=RB_MSL_POOL_ATOMIC;
+#undef RB_WORD
+        } else p++;
+    }
+    return bits;
+}
