+// RewindBox (patch 0432): bound history-priming MetalFX passes during sustained
+// GPU overloads. In IPA 845 (MKW), fi_job ran full motion-vector + MetalFX passes
+// (10.6-16.2 ms on g_q4) on every late declined frame (115-336 of 300 frames),
+// creating a self-reinforcing GPU stall spiral. Allow priming only on an isolated
+// single late frame in a 30-Hz tier; from the second consecutive declined frame
+// onward (or in adaptive mode), skip MetalFX so the GPU recovers immediately and
+// shouldResetHistory resets cleanly on the next on-pace pair.
+static inline int dm_fi_should_prime(int cont, int allow, double declared_period,
+                                     int fi_all, unsigned *consec_declined) {
+    if (allow || !cont) {
+        if (consec_declined) *consec_declined = 0;
+        return 0;
+    }
+    unsigned n = consec_declined ? ++(*consec_declined) : 1u;
+    if (fi_all && !dm_fi_tier(declared_period)) return 0;
+    return dm_fi_tier(declared_period) && n == 1u;
+}
+// RewindBox (patch 0432): DisplayLink handoff hysteresis for games that flicker
+// between present intervals 1 and 2 (MKW 845 logged 25+ display-link attach/detach
+// stalls per 900 frames). Manual off or community patch disables immediately via reset.
+typedef struct {
+    int active;
+    unsigned on_run, off_run;
+} dm_fi_link_hyst;
+static inline void dm_fi_link_hyst_reset(dm_fi_link_hyst *h) {
+    if (!h) return;
+    h->active = 0; h->on_run = 0; h->off_run = 0;
+}
+static inline int dm_fi_link_hyst_step(dm_fi_link_hyst *h, int want_tier) {
+    if (!h) return want_tier != 0;
+    if (want_tier) {
+        h->off_run = 0;
+        if (!h->active && ++h->on_run >= 2u) h->active = 1;
+    } else {
+        h->on_run = 0;
+        if (h->active && ++h->off_run >= 4u) h->active = 0;
+    }
+    return h->active;
+}
