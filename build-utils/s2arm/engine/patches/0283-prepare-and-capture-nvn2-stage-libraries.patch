diff --git a/graphics/nvn/gfx/nvn/rb_registration.inc b/graphics/nvn/gfx/nvn/rb_registration.inc
new file mode 100644
index 0000000..14e26f7
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_registration.inc
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: MIT
+// The guest may overwrite both pointers as soon as SetShaders returns. Only a
+// self-contained tentative snapshot may cross to a worker. Replay still hashes
+// the current bytes, and serial/psnap keys are never published here.
+extern int dm_shader_prepare_registration(const char *,const uint8_t *,uint32_t,
+                                          const uint8_t *,uint32_t) __attribute__((weak_import));
+static dispatch_queue_t g_rb_registration_q;
+static NSMutableSet<NSString *> *g_rb_registering; // protected by g_shpre_mu
+static size_t g_rb_registration_bytes;
+static unsigned g_rb_registration_count;
+static _Atomic uint64_t g_rb_registration_queued, g_rb_registration_loaded, g_rb_registration_msl;
+static _Atomic int g_rb_register_option;
+
+static void rb_register_shader(const NVNshaderData *sd, int depth) {
+    uint8_t control[NVN2_CTL_COPY] = {0};
+    if (!sd->data || !rb_first_read(sd->control,control,0xd8) || !nvn2_ctl(control)) return;
+    uint32_t ncode = nvn2_code_len(control), nctl;
+    memcpy(&nctl, control + 0x30, sizeof nctl);
+    if (nctl < 0xd8 || nctl > sizeof control) nctl = 0xd8;
+    if (nctl > 0xd8 && !rb_first_read((const uint8_t *)sd->control + 0xd8,control + 0xd8,nctl - 0xd8)) return;
+    const size_t bytes = (size_t)nctl + ncode;
+    const size_t limit = 8u << 20;
+    if (!ncode || bytes > limit || sd->data > UINTPTR_MAX - ncode || !rb_addr_mapped(sd->data,ncode)) return;
+    // Reserve before copying, including concurrent registering game threads.
+    os_unfair_lock_lock(&g_shpre_mu);
+    BOOL admitted = !atomic_load(&g_shpre_stopping) && g_rb_registration_count < 32 &&
+                    bytes <= limit - g_rb_registration_bytes;
+    if (admitted) { g_rb_registration_bytes += bytes; ++g_rb_registration_count; }
+    os_unfair_lock_unlock(&g_shpre_mu);
+    if (!admitted) return;
+
+    NSMutableData *snapshot = [NSMutableData dataWithLength:bytes];
+    uint8_t *payload = snapshot.mutableBytes;
+    NSString *key = nil;
+    if (payload && rb_first_read((const void *)(uintptr_t)sd->data,payload+nctl,ncode) &&
+        rb_code_set(payload+nctl,ncode)) {
+        uint8_t digest[8];
+        memcpy(payload,control,nctl);
+        nvn2_key(payload,payload+nctl,digest);
+        char hex[17];
+        for (int i=0;i<8;++i) snprintf(hex + 2*i,3,"%02x",digest[i]);
+        key = @(hex);
+    }
+    // Commands already bound, watched draws, and demanded PSOs use other
+    // workers. A burst of speculative registrations cannot occupy their queue.
+    os_unfair_lock_lock(&g_shpre_mu);
+    NSString *identity = key ? [key stringByAppendingFormat:@"/%d",depth] : nil;
+    if (!key || atomic_load(&g_shpre_stopping) || [g_rb_registering containsObject:identity]) {
+        g_rb_registration_bytes -= bytes;
+        --g_rb_registration_count;
+        os_unfair_lock_unlock(&g_shpre_mu);
+        return;
+    }
+    if (!g_rb_registration_q) {
+        g_rb_registration_q = dispatch_queue_create("s2a.nvn2.register",
+            dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,QOS_CLASS_USER_INITIATED,0));
+        g_rb_registering = [NSMutableSet set];
+    }
+    [g_rb_registering addObject:identity];
+    uint64_t queued = atomic_fetch_add(&g_rb_registration_queued,1) + 1;
+    dispatch_async(g_rb_registration_q, ^{ @autoreleasepool {
+        if (!nvn_be_stopping()) {
+            const uint8_t *ctl = snapshot.bytes, *code = ctl+nctl;
+            shmap_load();
+            NSString *stage = shmap_stage(key);
+            if ((!stage || !mtl_shlib_has(key.UTF8String)) && dm_shader_prepare_registration) {
+                BOOL translated = dm_shader_prepare_registration(key.UTF8String,ctl,nctl,code,ncode);
+                stage = translated ? shmap_stage(key) : nil;
+            }
+            if (stage) {
+                int st = stage_of(stage);
+                // Tensor networks use reflection only at dispatch. A successful
+                // speculative build must never substitute for that decision.
+                if (st >= 0 && !(st == 5 && nvn2_hmma_count(code,ncode))) {
+                    NSString *pc = [key stringByAppendingString:@"_b"];
+                    int built = 0;
+                    uint64_t before = t_rb_msl_n;
+                    if (shader_loadable(pc) && shader_load_depth(pc,st,0,stage_depth_moded(st) && depth,&built,NULL) && built)
+                        atomic_fetch_add(&g_rb_registration_loaded,1);
+                    atomic_fetch_add(&g_rb_registration_msl,t_rb_msl_n-before);
+                }
+            }
+        }
+        os_unfair_lock_lock(&g_shpre_mu);
+        [g_rb_registering removeObject:identity];
+        g_rb_registration_bytes -= bytes;
+        --g_rb_registration_count;
+        os_unfair_lock_unlock(&g_shpre_mu);
+    }});
+    os_unfair_lock_unlock(&g_shpre_mu);
+    if (!(queued & (queued-1))) MLOG("[rb-bind-ahead] registered=%llu variants_built=%llu msl_compiles=%llu",
+        (unsigned long long)queued,(unsigned long long)atomic_load(&g_rb_registration_loaded),
+        (unsigned long long)atomic_load(&g_rb_registration_msl));
+}
+
+void nvn_be_registered_stages(const prog_t *program) {
+    if (!g_dev || !shpre_on() || !rb_bind_ahead_on() || !nvn2_on() ||
+        !rb_pacing_setting(&g_rb_register_option,"S2A_RB_REGISTER_LIBRARIES")) return;
+    @autoreleasepool {
+        int depth = atomic_load(&g_depth_zero);
+        for (unsigned i=0; i<program->nstage && i<6; ++i) rb_register_shader(&program->sd[i],depth);
+    }
+}
+
+// Public Metal can persist PSOs through MTLBinaryArchive, but its executable
+// MTLLibrary has no byte export method. Save the *actual successful compiler
+// input* for Mac pack preparation, including variants synthesized in memory.
+// The binary reader verifies the same digest before newLibraryWithData:error:.
+static dispatch_queue_t g_rb_export_q;
+static size_t g_rb_export_units;
+static _Atomic int g_rb_export_option;
+static _Atomic unsigned g_rb_export_dropped, g_rb_export_failed;
+
+static void rb_capture_compiled_msl(NSString *source) {
+    if (!nvn2_on() || !rb_pacing_setting(&g_rb_export_option,"S2A_RB_CAPTURE_COMPILED_MSL")) return;
+    const char *fallback = getenv("DM_MSL_FALLBACK");
+    if (!fallback || !*fallback || !strcmp(fallback,"/dev/null")) return;
+    NSString *root = @(fallback);
+    NSUInteger units = source.length;  // UTF-16 units retained by this job
+    const size_t limit = 4u << 20;
+    os_unfair_lock_lock(&g_shpre_mu);
+    if (atomic_load(&g_shpre_stopping) || !units || units > limit - g_rb_export_units) {
+        if (units && !atomic_load(&g_shpre_stopping)) atomic_fetch_add(&g_rb_export_dropped,1);
+        os_unfair_lock_unlock(&g_shpre_mu);
+        return;
+    }
+    if (!g_rb_export_q) g_rb_export_q = dispatch_queue_create("s2a.nvn2.export-msl",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,QOS_CLASS_UTILITY,0));
+    g_rb_export_units += units;
+    dispatch_async(g_rb_export_q,^{ @autoreleasepool {
+        NSData *bytes = [source dataUsingEncoding:NSUTF8StringEncoding];
+        NSString *dir = [root stringByAppendingPathComponent:@"rb-compiled-msl-v1"];
+        NSString *tag = par_hash(bytes.bytes,bytes.length);
+        NSString *path = [dir stringByAppendingPathComponent:[tag stringByAppendingPathExtension:@"msl"]];
+        NSError *error = nil;
+        NSFileManager *fm = NSFileManager.defaultManager;
+        if (![fm fileExistsAtPath:path] &&
+            (![fm createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:&error] ||
+             ![bytes writeToFile:path options:NSDataWritingAtomic error:&error])) {
+            unsigned errors = atomic_fetch_add(&g_rb_export_failed,1) + 1;
+            if (!(errors & (errors-1))) MLOG("[rb-shader-disk] source_capture_failed=%u error=%s",errors,error.localizedDescription.UTF8String);
+        }
+        os_unfair_lock_lock(&g_shpre_mu);
+        g_rb_export_units -= units;
+        os_unfair_lock_unlock(&g_shpre_mu);
+    }});
+    os_unfair_lock_unlock(&g_shpre_mu);
+}
