 }
+// Owned, complete NVN2 registration snapshot. A racing draw uses the same
+// translator mutex and on-disk identity check. Publish only successful results.
+int dm_shader_prepare_registration(const char *key, const uint8_t *control, uint32_t nctl,
+                                   const uint8_t *code, uint32_t ncode) {
+    const char *out = getenv("DM_MSL_FALLBACK");
+    if (!out || !*out || !strcmp(out,"/dev/null") || nvn_be_stopping()) return 0;
+    uint32_t cs, bs;
+    int stage = rb_nvn2_input_stage(control,&bs,&cs);
+    if (stage < 0 || nctl != cs || ncode != bs) return 0;
+    int stored = -1;
+    if (!dsh_current_stage(out,key,&stored)) {
+        dsh_comp_fn compile = dsh_comp();
+        if (!compile || (mkdir(out,0755) && errno != EEXIST) ||
+            dsh_comp_locked(compile,key,stage,code,ncode,control,nctl,out) ||
+            !dsh_current_stage(out,key,&stored)) return 0;
+    }
+    if (stored != stage) return 0;
+    mtl_shmap_rt_add(key,dsh_nm[stage]);
+    return 1;
+}
 void dm_shader_miss(const uint8_t key[8], uint64_t code, const void *control) {
     char k[17]; for (int i = 0; i < 8; i++) snprintf(k + 2 * i, 3, "%02x", key[i]);
     if (!control || !code) { atomic_fetch_add_explicit(&g_dsh_skipped, 1, memory_order_relaxed); return; }
diff --git a/graphics/nvn/tests/rb_registration_gpu.inc b/graphics/nvn/tests/rb_registration_gpu.inc
new file mode 100644
index 0000000..19833e0
--- /dev/null
+++ b/graphics/nvn/tests/rb_registration_gpu.inc
@@ -0,0 +1,64 @@
+// Run in a fresh process. Both NVN registration entry points finish the
+// library before recording any command, even when the guest reuses its bytes.
+extern uint64_t s2a_npdm_pid(const char *path);
+extern void *h_nvnBootstrapLoader(const char *name);
+static int test_registered_library(NSString *root, BOOL enabled) { @autoreleasepool {
+    setenv("S2A_RB_REGISTER_LIBRARIES",enabled ? "1" : "0",1);
+    setenv("S2A_RB_STAGE_DISK_WARM","0",1);
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSString *shaders = [root stringByAppendingPathComponent:@"docs/wire/0000000000000042/shaders"];
+    GPU_CHECK([fm createDirectoryAtPath:shaders withIntermediateDirectories:YES attributes:nil error:nil]);
+    NSString *npdm = [root stringByAppendingPathComponent:@"fixture.npdm"];
+    uint8_t header[0x404] = {0};
+    memcpy(header,"META",4); memcpy(header+0x400,"ACID",4);
+    uint32_t offset=0x100; memcpy(header+0x78,&offset,sizeof offset);
+    GPU_CHECK([[NSData dataWithBytes:header length:sizeof header] writeToFile:npdm atomically:YES]);
+    (void)s2a_npdm_pid(npdm.fileSystemRepresentation);
+    GPU_CHECK(nvn2_on());
+    setenv("DM_MSL_FALLBACK",shaders.fileSystemRepresentation,1);
+    setenv("DM_MSL_DIR",root.fileSystemRepresentation,1);
+    NSString *map=[root stringByAppendingPathComponent:@"shader_map.tsv"];
+    write_test_text(map,@""); setenv("DM_NVN_SHMAP",map.fileSystemRepresentation,1);
+    g_dev=MTLCreateSystemDefaultDevice(); GPU_CHECK(g_dev);
+    // Back the synthetic guest address by a live, aligned pool.
+    uint8_t *code=NULL; GPU_CHECK(!posix_memalign((void **)&code,65536,65536));
+    memset(code,0,65536);
+    nvn_be_pool_add(code,65536);
+    uint32_t control[NVN2_CTL_COPY/4] = {NVN2_CTL_MAGIC,NVN2_CTL_VERSION};
+    control[0x44/4]=64; ((uint8_t *)control)[0x56]=5;
+    const char *entry[]={"nvnProgramSetShaders","nvnProgramSetShadersExt"};
+    NSString *source=@"#include <metal_stdlib>\nusing namespace metal; kernel void main0(device uint *v [[buffer(0)]]) { v[0]=7; }";
+    for (unsigned i=0;i<2;i++) {
+        code[0]=(uint8_t)(1+i);
+        uint8_t key[8]; nvn2_key(control,code,key);
+        char hex[17]; for (unsigned j=0;j<8;j++) snprintf(hex+2*j,3,"%02x",key[j]);
+        NSString *stage=[@(hex) stringByAppendingString:@"_b"];
+        NSString *base=[shaders stringByAppendingPathComponent:stage];
+        write_test_text([base stringByAppendingPathExtension:@"metal"],source);
+        NSDictionary *refl=@{@"chain":@DMSH_CHAIN,@"xfp":@(s2a_dsh_xfp()),@"route":@"B",
+            @"stage":@"cs",@"key":stage,@"entry":@"main0",@"bindings":@[]};
+        GPU_CHECK([[NSJSONSerialization dataWithJSONObject:refl options:0 error:nil]
+                   writeToFile:[base stringByAppendingPathExtension:@"json"] atomically:YES]);
+        NVNprogram program={0};
+        struct { NVNshaderData sd; uint64_t ext; } slot={{(uint64_t)(uintptr_t)code,control},0};
+        typedef NVNboolean (*set_fn)(NVNprogram *,int,const void *);
+        set_fn reg=(set_fn)h_nvnBootstrapLoader(entry[i]);
+        GPU_CHECK(reg && reg(&program,1,&slot));
+        code[0]+=64; // Subsequent replay must hash the changed guest code.
+        uint8_t actual[8]; GPU_CHECK(prog_key((const prog_t *)&program,0,actual) && memcmp(key,actual,8));
+        if (!enabled) { GPU_CHECK(!g_rb_registration_q && !g_rb_registration_queued); continue; }
+        GPU_CHECK(g_rb_registration_q);
+        dispatch_sync(g_rb_registration_q,^{});
+        GPU_CHECK(g_rb_registration_loaded==i+1 && g_rb_registration_count==0);
+        NvShader *built=g_shcache[shader_identity(stage,5,0,0)];
+        GPU_CHECK(built && built->fn && built->fn.functionType==MTLFunctionTypeKernel);
+    }
+    if (!enabled) { puts("PASS disabled registration leaves preparation until the recorded bind"); return 0; }
+    GPU_CHECK(g_rb_registration_msl>0 && !g_bp_msl_n);
+    GPU_CHECK(g_rb_export_q);
+    dispatch_sync(g_rb_export_q,^{});
+    NSArray *files=[fm contentsOfDirectoryAtPath:[shaders stringByAppendingPathComponent:@"rb-compiled-msl-v1"] error:nil];
+    GPU_CHECK(files.count>0 && !g_rb_export_failed && !g_rb_export_dropped);
+    puts("PASS registration and extended registration build Metal libraries before commands, keep mutable guest keys independent, and capture compiler inputs");
+    return 0;
+} }
