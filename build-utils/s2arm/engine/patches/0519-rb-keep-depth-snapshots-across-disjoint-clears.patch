+// Exact write into a known native texture subresource. A different texture
+// identity still goes through the guest backing-range alias check.
+static inline int rb_dsnap_outside_write(const rb_dsnap_slot *s, uint64_t ser, uintptr_t base,
+                                         uint32_t level, uint32_t first, uint32_t count) {
+    return ser && base && count && s->ser == ser && s->base == base && s->nl &&
+           (level < s->tl || level - s->tl >= s->nl ||
+            s->ts < first || s->ts - first >= count);
+}
