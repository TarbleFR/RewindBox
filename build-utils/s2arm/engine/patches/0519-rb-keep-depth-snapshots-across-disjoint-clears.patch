+static void dsnap_stale_depth_clear(const tex_t *t, id<MTLTexture> base,
+                                    uint32_t level, uint32_t first, uint32_t count) {
+    dsnap_flush_after();
+    uint64_t lo = (uint64_t)(uintptr_t)t->mem;
+    for (int i = 0; i < RB_DSNAP_SLOTS; ++i) {
+        rb_dsnap_slot *s = &g_dsnap.m[i];
+        if (rb_dsnap_outside_write(s, t->serial, (uintptr_t)(__bridge const void *)base, level, first, count))
+            continue;
+        if (rb_dsnap_tex_stales(s->ser, s->lo, s->hi, t->serial, lo, t->L.size))
+            s->depth_valid = s->stencil_valid = 0;
+    }
