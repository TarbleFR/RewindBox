+int nvn_prog_snap_fill_pair(const prog_t *snapshot, const uint8_t keys[6][8]) {
+    if (!snapshot || snapshot->nstage != 2 ||
+        nvn_prog_snap_get(snapshot->serial, NULL, NULL, NULL) != snapshot) return 0;
+    // Recording another bind can also publish keys. The pair is one decision:
+    // on a conflict neither half is added to the immutable serial snapshot.
+    pthread_mutex_lock(&g_ps_mu);
+    psnap_ent *entry = ps_find(atomic_load_explicit(&g_ps_tab, memory_order_relaxed), snapshot->serial);
+    const prog_keys_t *old = atomic_load_explicit(&entry->ks, memory_order_relaxed);
+    int valid = 1;
+    for (unsigned i = 0; i < 2; ++i)
+        if ((old->ok & (1u << i)) && memcmp(old->key[i], keys[i], 8)) valid = 0;
+    if (valid && (old->ok & 3) != 3) {
+        prog_keys_t *next = malloc(sizeof *next);
+        if (next) {
+            *next = *old;
+            memcpy(next->key, keys, 2 * sizeof next->key[0]);
+            next->ok |= 3;
+            atomic_store_explicit(&entry->ks, next, memory_order_release);
+        } else valid = 0;
+    }
+    pthread_mutex_unlock(&g_ps_mu);
+    return valid;
+}
