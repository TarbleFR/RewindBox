diff --git a/graphics/nvn/gfx/nvn/rb_cache_warm_rule.h b/graphics/nvn/gfx/nvn/rb_cache_warm_rule.h
new file mode 100644
index 0000000..9c17413
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_cache_warm_rule.h
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0435): universal cold/warm shader & pipeline cache coherence rules
+// shared by rb_stage_disk.inc and rb_registration.inc.
+//
+// Addresses two universal Switch 2 cache-warming stalls measured on IPA 845 (A18 Pro):
+//   1. [rb-shader-disk] required thermalState == Nominal (0) and worker 1 (refused under
+//      RB_SPEC_ONE at Fair), stranding 1,425 translated disk stages on Zelda and 1,593 on MKW
+//      once the device reached Fair (~15 s into play).
+//   2. [rb-bind-ahead] used a fixed RB_REGISTRATION_TRICKLE=16 cap even after startup prewarm
+//      completed, deferring 8,771 newly discovered gameplay shaders (causing 596-2,870 ms
+//      synchronous submit_guest_msl translation stalls on first pass into new tracks/biomes).
+//
+// Invariants preserved:
+//   - Startup prewarm & boot bursts (warm_running != 0 or frame < 60): exact patch 0311
+//     trickle=16 / 8 MiB behavior (never starves cold prewarm or breaks unit tests).
+//   - Serious/Critical thermal (thermal >= 2) or low memory (mem_low != 0): disk prewarm
+//     parks and bind-ahead falls back to minimal trickle=16 / no burst translation.
+//   - Burst CPU translation lane (s2a.nvn2.xlate) never invokes MTLCompilerService; it only
+//     translates NVN2 -> MSL+JSON to disk and yields to active submit-thread waits (g_fu_waiting).
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+
+enum {
+    RB_REG_TRICKLE_BOOT = 16,
+    RB_REG_TRICKLE_FAIR = 32,
+    RB_REG_TRICKLE_NOMINAL = 48,
+    RB_REG_BYTES_BOOT = 8u << 20,
+    RB_REG_BYTES_FAIR = 12u << 20,
+    RB_REG_BYTES_NOMINAL = 16u << 20,
+    RB_REG_XLATE_MAX = 128,
+    RB_REG_XLATE_BYTES = 16u << 20,
+    RB_REG_LIVE_MIN_FRAME = 60,
+    RB_DISK_FAIR_MIN_ROOM_MB = 1536,
+};
+
+// Decide whether rb_stage_disk may request a speculative lease now, and on which worker
+// (1 at Nominal to match existing behavior; 0 at Fair when startup prewarm and observed
+// first-use workers are idle and memory headroom >= 1536 MiB).
+static inline int rb_disk_warm_admit(int thermal, int listed, int warm_running,
+                                     int observed_busy, int fu_waiting, int mem_low,
+                                     uint64_t room_bytes, int gov_ok, int *worker_out) {
+    if (worker_out) *worker_out = 1;
+    if (!gov_ok || mem_low) return 0;
+    if (thermal <= 0) {
+        if (listed && observed_busy) return 0;
+        if (worker_out) *worker_out = 1;
+        return 1;
+    }
+    if (thermal == 1) {
+        if (observed_busy || fu_waiting || warm_running) return 0;
+        if (room_bytes != UINT64_MAX && room_bytes < ((uint64_t)RB_DISK_FAIR_MIN_ROOM_MB << 20))
+            return 0;
+        if (worker_out) *worker_out = 0;
+        return 1;
+    }
+    return 0;
+}
+
+// Adaptive bind-ahead trickle and CPU-only burst translation policy.
+// Only expands past boot trickle=16 during live gameplay after startup prewarm has finished.
+static inline void rb_reg_policy(int warm_running, uint64_t cur_frame, int thermal, int mem_low,
+                                 unsigned *trickle_out, size_t *byte_limit_out,
+                                 int *xlate_burst_ok_out) {
+    if (warm_running || cur_frame < RB_REG_LIVE_MIN_FRAME || thermal >= 2 || mem_low) {
+        *trickle_out = RB_REG_TRICKLE_BOOT;
+        *byte_limit_out = RB_REG_BYTES_BOOT;
+        *xlate_burst_ok_out = 0;
+        return;
+    }
+    if (thermal <= 0) {
+        *trickle_out = RB_REG_TRICKLE_NOMINAL;
+        *byte_limit_out = RB_REG_BYTES_NOMINAL;
+    } else {
+        *trickle_out = RB_REG_TRICKLE_FAIR;
+        *byte_limit_out = RB_REG_BYTES_FAIR;
+    }
+    *xlate_burst_ok_out = 1;
+}
+
+// 1 = admit a burst-overflow untranslated stage to the CPU-only NVN2->MSL translation queue.
+static inline int rb_reg_xlate_admit(int xlate_burst_ok, int already_translated,
+                                     int in_xlate_flight, unsigned xlate_waiting,
+                                     size_t bytes, size_t xlate_bytes) {
+    if (!xlate_burst_ok || already_translated || in_xlate_flight) return 0;
+    if (xlate_waiting >= RB_REG_XLATE_MAX) return 0;
+    if (xlate_bytes > RB_REG_XLATE_BYTES || bytes > RB_REG_XLATE_BYTES - xlate_bytes) return 0;
+    return 1;
+}
