+
+// RewindBox (patch 0424): per-shader used slot masks and per-stage modified slot masks.
+// Enables (1) whole-block reuse when only slots unread by the current owner changed,
+// (2) per-slot partial rebuilds on OP_BIND_TEX / OP_BIND_SAMP (re-walking only dirty slots),
+// (3) partial rebuilds for bindless-pool shaders (TEXP/SAMPP/DRV2 are never kept and re-walk)
+// and same-pass ABI2 size_abi shaders (keeping NVN_RB_SUPPORT when no texture/target changed).
+typedef struct {
+    uint64_t tex[4];      // 256 bits: texture slots read by TEX / SAMPT
+    uint64_t samp[2];     // 128 bits: separate sampler slots read by SAMP
+    uint16_t ubo;         // 16 bits: UBO slots read by CBUF / UBOP / *U / DRV0(compute)
+    uint16_t ssbo;        // 16 bits: SSBO slots read by SBUFP / SBSZ / DRV0
+    uint8_t built;        // 1 = initialized
+    uint8_t dyn_tex;      // 1 = reads texture slots dynamically (TEXD / TEXA / DRV2 / UVX / LB)
+    uint8_t dyn_samp;     // 1 = reads sampler slots dynamically (SAMPD / SAMPA / DRV2 / UVX / LB)
+    uint8_t has_img;      // 1 = reads/writes image slots (IMG / IMGA / SAMPI)
+} rb_args_masks;
+
+typedef struct {
+    uint64_t tex[4];
+    uint64_t samp[2];
+    uint16_t ubo;
+    uint16_t ssbo;
+    uint8_t other;        // 1 = non-maskable change (program, pool base, img, push, feedback, registry, reset)
+} rb_args_mod;
+
+static inline void rb_args_mod_clear(rb_args_mod *m) {
+    memset(m, 0, sizeof *m);
+}
+static inline void rb_args_mod_mark_other(rb_args_mod *m) {
+    m->other = 1;
+}
+static inline void rb_args_mod_all_other(rb_args_mod m[6]) {
+    for (int st = 0; st < 6; st++) m[st].other = 1;
+}
+static inline void rb_args_mod_ubo(rb_args_mod *m, unsigned idx) {
+    if (idx < 16) m->ubo |= (uint16_t)(1u << idx);
+    else m->other = 1;
+}
+static inline void rb_args_mod_ssbo(rb_args_mod *m, unsigned idx) {
+    if (idx < 16) m->ssbo |= (uint16_t)(1u << idx);
+    else m->other = 1;
+}
+static inline void rb_args_mod_tex_range(rb_args_mod *m, int first, int n) {
+    if (first < 0 || n < 0 || first + n > 256) { m->other = 1; return; }
+    for (int k = 0; k < n; k++) {
+        unsigned r = (unsigned)(first + k);
+        m->tex[r >> 6] |= UINT64_C(1) << (r & 63);
+    }
+}
+static inline void rb_args_mod_samp_range(rb_args_mod *m, int first, int n) {
+    if (first < 0 || n < 0 || first + n > 128) { m->other = 1; return; }
+    for (int k = 0; k < n; k++) {
+        unsigned r = (unsigned)(first + k);
+        m->samp[r >> 6] |= UINT64_C(1) << (r & 63);
+    }
+}
+static inline int rb_args_mod_any_tex(const rb_args_mod *m) {
+    return (m->tex[0] | m->tex[1] | m->tex[2] | m->tex[3]) != 0;
+}
+static inline int rb_args_mod_any_samp(const rb_args_mod *m) {
+    return (m->samp[0] | m->samp[1]) != 0;
+}
+static inline int rb_args_mod_hit_tex(const rb_args_mod *m, const rb_args_masks *sh) {
+    if (sh->dyn_tex) return rb_args_mod_any_tex(m);
+    return ((m->tex[0] & sh->tex[0]) | (m->tex[1] & sh->tex[1]) |
+            (m->tex[2] & sh->tex[2]) | (m->tex[3] & sh->tex[3])) != 0;
+}
+static inline int rb_args_mod_hit_samp(const rb_args_mod *m, const rb_args_masks *sh) {
+    if (sh->dyn_samp) return rb_args_mod_any_samp(m);
+    return ((m->samp[0] & sh->samp[0]) | (m->samp[1] & sh->samp[1])) != 0;
+}
+// 1 = none of the bindings read by sh have changed since sh last encoded this stage.
+static inline int rb_args_can_reuse_masked(const rb_args_mod *m, const rb_args_masks *sh) {
+    if (!sh->built || m->other) return 0;
+    if ((m->ubo & sh->ubo) || (m->ssbo & sh->ssbo)) return 0;
+    if (rb_args_mod_hit_tex(m, sh) || rb_args_mod_hit_samp(m, sh)) return 0;
+    return 1;
+}
+// 1 = in a partial rebuild, this binding's entry in rb_prev is still valid and can be skipped.
+// When mod == NULL, all kept bindings are skipped (classic UBO/SSBO-only partial rebuild).
+static inline int rb_args_kept_slot(unsigned kind, unsigned f1d, unsigned dtt, unsigned reg, const rb_args_mod *mod) {
+    if (!rb_args_kept(kind, f1d, dtt)) return 0;
+    if (!mod) return 1;
+    if (mod->other) return 0;
+    if (kind == RB_AK_TEX || kind == RB_AK_SAMPT)
+        return reg < 256 && !((mod->tex[reg >> 6] >> (reg & 63)) & 1ull);
+    if (kind == RB_AK_SAMP)
