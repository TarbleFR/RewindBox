+    return 1; // RB_AK_SAMPI: OP_BIND_IMG sets mod->other = 1
+}
+// Extended gate for patch 0424:
+// - allow_handle_partial: 1 when only maskable TEX/SAMP/UBO/SSBO binds changed (!mod->other,
+//   !size_abi, !sh->ab_ub, no dynamic tex/samp), so untouched TEX/SAMP slots are still kept.
+static inline int rb_args_why_v2(const rb_args_gate *g, int allow_compute, int cross_pass_ok,
+                                 int allow_handle_partial) {
+    if (g->mode == RB_ARGS_MODE_OFF) return RB_ARGS_WHY_OFF;
+    if (g->stage > 1 && !(allow_compute && g->stage == 5)) return RB_ARGS_WHY_STAGE;
+    if (g->walk_all) return RB_ARGS_WHY_MODE;
+    if (g->per_draw || !g->kept) return RB_ARGS_WHY_SHADER;
+    if (!g->have || (!g->same_pass && !cross_pass_ok) || !g->same_sub || !g->same_arena || !g->same_stage) return RB_ARGS_WHY_FIRST;
+    if (!g->same_views) return RB_ARGS_WHY_SERIAL;
+    if (g->dirty != RB_ARGS_CLEAN && g->dirty != RB_ARGS_UNIFORM) {
+        const uint8_t non_maskable = (uint8_t)(g->causes & ~(RB_ARGS_C_UNIFORM | RB_ARGS_C_STORAGE | RB_ARGS_C_HANDLES));
+        if (allow_handle_partial && !non_maskable && (g->causes & RB_ARGS_C_HANDLES)) {
+            if (!g->owner) return RB_ARGS_WHY_OWNER;
+            return RB_ARGS_PARTIAL;
+        }
+        if (g->causes & RB_ARGS_C_PROGRAM) return RB_ARGS_WHY_PROGRAM;
+        if (g->causes & RB_ARGS_C_HANDLES) return RB_ARGS_WHY_HANDLES;
+        if (g->causes & RB_ARGS_C_STORAGE) return RB_ARGS_WHY_STORAGE;
+        if (g->causes & RB_ARGS_C_PUSH) return RB_ARGS_WHY_PUSH;
+        if (g->causes & RB_ARGS_C_FEEDBACK) return RB_ARGS_WHY_FEEDBACK;
+        if (g->causes & RB_ARGS_C_REGISTRY) return RB_ARGS_WHY_REGISTRY;
+        return RB_ARGS_WHY_OTHER;
+    }
+    if (!g->owner) return RB_ARGS_WHY_OWNER;
+    return RB_ARGS_PARTIAL;
+}
