--- a/graphics/nvn/gfx/nvn/rb_args_ubo.h
+++ b/graphics/nvn/gfx/nvn/rb_args_ubo.h
@@ -116,3 +116,121 @@ static inline int rb_args_why_ex(const rb_args_gate *g, int allow_compute, int c
