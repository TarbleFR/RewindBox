+++ b/graphics/nvn/gfx/nvn/rb_replay_worker.inc
@@ -0,0 +1,120 @@
+// RewindBox S1. One ordered CPU replay owner; bounded queue and copied handle
+// arrays. No command memory is reclaimed while a job can still reference it.
+// Resource APIs join replay under the admission mutex, before changing objects.
+// GPU waits release admission so cross-queue producers remain able to submit.
+#define RB_REPLAY_JOBS 8
+#define RB_REPLAY_HANDLES 256
+typedef struct { NVNqueue *q; int n; uint64_t sequence; NVNcommandHandle handles[RB_REPLAY_HANDLES]; } rb_replay_job;
+static pthread_mutex_t rb_replay_mu=PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t rb_replay_cv=PTHREAD_COND_INITIALIZER;
+static pthread_mutex_t rb_replay_admission;
+static pthread_once_t rb_replay_once=PTHREAD_ONCE_INIT;
+static pthread_t rb_replay_thread;
+static rb_replay_job rb_replay_jobs[RB_REPLAY_JOBS];
+static unsigned rb_replay_head, rb_replay_count;
+static int rb_replay_running, rb_replay_closed, rb_replay_failed;
+static uint64_t rb_replay_sent, rb_replay_done, rb_replay_wait_ns;
+static void rb_replay_init_lock(void) {
+    pthread_mutexattr_t a; pthread_mutexattr_init(&a);
+    pthread_mutexattr_settype(&a,PTHREAD_MUTEX_RECURSIVE);
+    pthread_mutex_init(&rb_replay_admission,&a); pthread_mutexattr_destroy(&a);
+}
+static void rb_replay_join(void) {
+    if (rb_replay_worker_thread || !atomic_load_explicit(&rb_replay_pending,memory_order_acquire)) return;
+    uint64_t start=now_ns();
+    pthread_mutex_lock(&rb_replay_mu); uint64_t target=rb_replay_sent;
+    DM_BLOCK_BEGIN();
+    while (rb_replay_done<target) pthread_cond_wait(&rb_replay_cv,&rb_replay_mu);
+    DM_BLOCK_END();
+    rb_replay_wait_ns+=now_ns()-start;
+    pthread_mutex_unlock(&rb_replay_mu);
+}
+static rb_replay_guard rb_replay_enter(int hold) {
+    if (rb_replay_worker_thread) return (rb_replay_guard){0};
+    pthread_once(&rb_replay_once,rb_replay_init_lock);
+    pthread_mutex_lock(&rb_replay_admission);
+    rb_replay_join();
+    if (!hold) pthread_mutex_unlock(&rb_replay_admission);
+    return (rb_replay_guard){hold};
+}
+static void rb_replay_leave(rb_replay_guard *g) {
+    if (g->held) pthread_mutex_unlock(&rb_replay_admission);
+}
+static void *rb_replay_main(void *unused) {
+    (void)unused; rb_replay_worker_thread=1;
+#if defined(__APPLE__)
+    pthread_setname_np("rb-nvn-replay");
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE,0);
+#endif
+    for (;;) {
+        pthread_mutex_lock(&rb_replay_mu);
+        while (!rb_replay_count && !rb_replay_closed) pthread_cond_wait(&rb_replay_cv,&rb_replay_mu);
+        if (!rb_replay_count) { pthread_mutex_unlock(&rb_replay_mu); break; }
+        rb_replay_job job=rb_replay_jobs[rb_replay_head];
+        rb_replay_head=(rb_replay_head+1)%RB_REPLAY_JOBS; rb_replay_count--;
+        pthread_cond_broadcast(&rb_replay_cv); pthread_mutex_unlock(&rb_replay_mu);
+        dm_host_work++;
+        rb_submit_replay(job.q,job.n,job.handles);
+        // The lease was acquired before suspend could close admission.
+        gfx_leave();
+        pthread_mutex_lock(&rb_replay_mu);
+        rb_replay_done=job.sequence;
+        atomic_fetch_sub_explicit(&rb_replay_pending,1,memory_order_release);
+        pthread_cond_broadcast(&rb_replay_cv); pthread_mutex_unlock(&rb_replay_mu);
+    }
+    rb_replay_worker_thread=0; return NULL;
+}
+static int rb_replay_enqueue(NVNqueue *q,int n,const NVNcommandHandle *handles) {
+#if defined(__APPLE__)
+    // Host NVN2 only; frame capture keeps its synchronous recording contract.
+    if (!nvn_rb_thermal_scope() || nvn_frec_on() || n<=0 || n>RB_REPLAY_HANDLES || !handles) return 0;
+    pthread_mutex_lock(&rb_replay_mu);
+    if (rb_replay_closed || rb_replay_failed || dm_gfx_session_stopping()) { pthread_mutex_unlock(&rb_replay_mu); return 0; }
+    if (!rb_replay_running) {
+        int e=pthread_create(&rb_replay_thread,NULL,rb_replay_main,NULL);
+        if (e) { rb_replay_failed=1; pthread_mutex_unlock(&rb_replay_mu); LOG("[rb-replay] worker unavailable: %d; synchronous replay retained",e); return 0; }
+        rb_replay_running=1;
+        LOG("[rb-replay] ordered CPU worker active; capacity=%d, immutable streams retained",RB_REPLAY_JOBS);
+    }
+    DM_BLOCK_BEGIN();
+    while (rb_replay_count==RB_REPLAY_JOBS) pthread_cond_wait(&rb_replay_cv,&rb_replay_mu);
+    DM_BLOCK_END();
+    rb_replay_job *j=&rb_replay_jobs[(rb_replay_head+rb_replay_count)%RB_REPLAY_JOBS];
+    *j=(rb_replay_job){.q=q,.n=n,.sequence=++rb_replay_sent};
+    memcpy(j->handles,handles,(size_t)n*sizeof *handles);
+    // The guest API already owns a lease; this second lease belongs to the job.
+    pthread_mutex_lock(&g_susp_mu); g_inflight_api++; pthread_mutex_unlock(&g_susp_mu);
+    atomic_fetch_add_explicit(&rb_replay_pending,1,memory_order_release);
+    rb_replay_count++; pthread_cond_broadcast(&rb_replay_cv); pthread_mutex_unlock(&rb_replay_mu);
+    return 1;
+#else
+    (void)q; (void)n; (void)handles; return 0;
+#endif
+}
+NVN(nvnQueueSubmitCommands, void, NVNqueue *q, int n, const NVNcommandHandle *h) {
+    gfx_enter();
+    pthread_once(&rb_replay_once,rb_replay_init_lock);
+    pthread_mutex_lock(&rb_replay_admission);
+    if (!dm_gfx_session_stopping() && !rb_replay_enqueue(q,n,h)) {
+        rb_replay_join(); rb_submit_replay(q,n,h);
+    }
+    pthread_mutex_unlock(&rb_replay_admission); gfx_leave();
+}
+static void rb_replay_stop(void) {
+    pthread_once(&rb_replay_once,rb_replay_init_lock);
+    pthread_mutex_lock(&rb_replay_admission);
+    pthread_mutex_lock(&rb_replay_mu); rb_replay_closed=1;
+    int running=rb_replay_running;
+    pthread_cond_broadcast(&rb_replay_cv); pthread_mutex_unlock(&rb_replay_mu);
+    if (running) pthread_join(rb_replay_thread,NULL);
+    rb_replay_running=0;
+    LOG("[rb-replay] stopped: submitted=%llu completed=%llu admission_wait_ms=%.3f",
+        (unsigned long long)rb_replay_sent,(unsigned long long)rb_replay_done,rb_replay_wait_ns/1e6);
+    pthread_mutex_unlock(&rb_replay_admission);
+}
+static void rb_replay_begin(void) {
+    // Session reset runs only after the previous worker and GPU have joined.
+    rb_replay_head=rb_replay_count=0; rb_replay_closed=rb_replay_failed=0;
+    rb_replay_sent=rb_replay_done=rb_replay_wait_ns=0;
+    atomic_store(&rb_replay_pending,0); atomic_store(&rb_replay_shadow_pressure,0);
+}
