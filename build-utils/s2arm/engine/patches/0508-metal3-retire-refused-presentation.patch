+// Empty command buffers reference no indirect resources. Use a real Metal queue on virtual
+// GPUs that lack residency sets. Every other device still runs full production initialization.
+static int init_halt_fixture(void) {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (!device) { fprintf(stderr, "GPU halt fixture requires a Metal device\n"); return 0; }
+    if (![device.name localizedCaseInsensitiveContainsString:@"paravirtual"]) {
+        mtl_init();
+        return 1;
+    }
+    MTLResidencySetDescriptor *descriptor = [MTLResidencySetDescriptor new];
+    descriptor.initialCapacity = 4096;   // Same request as mtl_init().
+    NSError *error = nil;
+    if ([device respondsToSelector:@selector(newResidencySetWithDescriptor:error:)] &&
+        [device newResidencySetWithDescriptor:descriptor error:&error]) {
+        mtl_init();
+        return 1;
+    }
+    s2a_mtl_slot_take("GPU halt empty-buffer fixture");
+    g_dev = device;
+    g_m3 = 1;
+    g_q = [device newCommandQueue];
+    if (!g_q) { fprintf(stderr, "cannot create the Metal queue for the GPU halt fixture\n"); return 0; }
+    g_q3 = g_q;
+    printf("GPU halt fixture: real Metal 3 queue, empty command buffers on %s (%s)\n",
+           device.name.UTF8String, error.localizedDescription.UTF8String ?: "residency sets unavailable");
+    return 1;
+}
