 #include "pso_archive.h"   // S2Arm: per-pipeline binary archive (after MacNativeGames, MIT)
+static void rb_heap_pressure_relief(void)
+{
+#if TARGET_OS_IOS
+    // Same dispatch memorypressure source as 803. Never called by a draw or
+    // by the per-frame headroom poll. Drain temporary Objective-C references
+    // and leave all engine locks before asking libmalloc to release pages.
+    NSUInteger before, after;
+    @autoreleasepool {
+        pthread_mutex_lock(&g_par_mu);
+        before = g_rb_recent_archives.count;
+        rb_archive_limit(RB_PRESSURE_OPEN_ARCHIVES);
+        after = g_rb_recent_archives.count;
+        pthread_mutex_unlock(&g_par_mu);
+    }
+    size_t released = malloc_zone_pressure_relief(NULL, 0);
+    MLOG("[RB-HEAP-RELIEF] evicted_archive_files=%lu allocator_reported_bytes=%zu",
+         (unsigned long)(before - after), released);
+#endif
+}
