+static inline int rb_rt_release_due(rb_rt_fallback *s, uint64_t now) {
+    if (!s->blocked || s->confirmed || s->attempts >= 3 || now < s->next_retry) return 0;
+    ++s->attempts;
+    s->next_retry = now + (s->attempts == 1 ? 1000000000ull : 5000000000ull);
+    return 1;
