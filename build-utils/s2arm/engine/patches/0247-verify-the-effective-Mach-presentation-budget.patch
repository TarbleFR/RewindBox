diff --git a/graphics/nvn/tests/t_rb_present_mach.c b/graphics/nvn/tests/t_rb_present_mach.c
new file mode 100644
index 0000000000000000000000000000000000000000..a0a84d9cf44aef2a9b4024bba122b9bcfd279fae
--- /dev/null
+++ b/graphics/nvn/tests/t_rb_present_mach.c
@@ -0,0 +1,84 @@
+#include <inttypes.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/thread_policy.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "rb_present_mach.h"
+
+typedef struct {
+    uint64_t period_ns;
+    mach_timebase_info_data_t tb;
+    int ok;
+} trial;
+
+static uint64_t to_ns(uint32_t ticks, mach_timebase_info_data_t tb) {
+    return (uint64_t)ticks * tb.numer / tb.denom;
+}
+
+static void *exercise(void *arg) {
+    trial *test = arg;
+    thread_time_constraint_policy_data_t request = rb_mach_present_tuple(test->period_ns, test->tb);
+    uint64_t budget_ns = to_ns(request.computation, test->tb);
+    uint64_t deadline_ns = to_ns(request.constraint, test->tb);
+    uint64_t tick_ns = ((uint64_t)test->tb.numer + test->tb.denom - 1) / test->tb.denom;
+    uint64_t actual_period_ns = to_ns(request.period, test->tb);
+    if (actual_period_ns + tick_ns < test->period_ns || actual_period_ns > test->period_ns + tick_ns ||
+        budget_ns + tick_ns < 2000000 || budget_ns > 2000000 + tick_ns ||
+        deadline_ns > 4000000 || request.computation > request.constraint ||
+        request.constraint > request.period || !request.preemptible) return NULL;
+
+    thread_t self = mach_thread_self();
+    kern_return_t set_rt = thread_policy_set(self, THREAD_TIME_CONSTRAINT_POLICY,
+                                             (thread_policy_t)&request, THREAD_TIME_CONSTRAINT_POLICY_COUNT);
+    thread_time_constraint_policy_data_t effective = {0};
+    mach_msg_type_number_t count = THREAD_TIME_CONSTRAINT_POLICY_COUNT;
+    boolean_t get_default = FALSE;
+    kern_return_t read_rt = KERN_FAILURE;
+    if (set_rt == KERN_SUCCESS) {
+        read_rt = thread_policy_get(self, THREAD_TIME_CONSTRAINT_POLICY,
+                                    (thread_policy_t)&effective, &count, &get_default);
+    }
+    int bounded_rt = read_rt == KERN_SUCCESS && !get_default &&
+                     count == THREAD_TIME_CONSTRAINT_POLICY_COUNT && effective.computation > 0 &&
+                     to_ns(effective.computation, test->tb) <= 3000000;
+
+    // Clean up even if the kernel refused, promoted, or withheld the RT policy.
+    // Independently read back the scheduling mode after exercising the production fallback.
+    kern_return_t set_ts = KERN_FAILURE, read_ts = KERN_FAILURE;
+    int fallback_ok = rb_mach_timeshare(self, &set_ts, &read_ts);
+    thread_extended_policy_data_t extended = {0};
+    count = THREAD_EXTENDED_POLICY_COUNT;
+    boolean_t ext_default = FALSE;
+    kern_return_t verify_ts = thread_policy_get(self, THREAD_EXTENDED_POLICY,
+                                                (thread_policy_t)&extended, &count, &ext_default);
+    int timeshared = fallback_ok && set_ts == KERN_SUCCESS && read_ts == KERN_SUCCESS &&
+                     verify_ts == KERN_SUCCESS && !ext_default &&
+                     count == THREAD_EXTENDED_POLICY_COUNT && extended.timeshare;
+    // THREAD_TIME_CONSTRAINT_POLICY may be denied on a hosted runner; the only
+    // acceptable terminal states for the caller are bounded RT or verified timeshare.
+    test->ok = timeshared;
+    printf("period_ns=%" PRIu64 " requested_ns=%" PRIu64 " constraint_ns=%" PRIu64
+           " set_rt=%d read_rt=%d effective_ns=%" PRIu64 " bounded_rt=%d"
+           " set_timeshare=%d read_timeshare=%d independent_timeshare=%d path=%s\n",
+           test->period_ns, budget_ns, deadline_ns, set_rt, read_rt,
+           to_ns(effective.computation, test->tb), bounded_rt, set_ts, read_ts, timeshared,
+           bounded_rt ? "bounded-rt" : "fallback");
+    mach_port_deallocate(mach_task_self(), self);
+    return NULL;
+}
+
+int main(void) {
+    mach_timebase_info_data_t tb;
+    if (mach_timebase_info(&tb) != KERN_SUCCESS || !tb.numer || !tb.denom) return 1;
+    const uint64_t periods[] = {16666667, 33333333};
+    for (unsigned i = 0; i < sizeof(periods) / sizeof(periods[0]); ++i) {
+        trial test = {periods[i], tb, 0};
+        pthread_t thread;
+        if (pthread_create(&thread, NULL, exercise, &test) != 0 ||
+            pthread_join(thread, NULL) != 0 || !test.ok) return 1;
+    }
+    return 0;
+}
