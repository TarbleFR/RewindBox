index 0000000000000000000000000000000000000000..2245247ca2cf04fc732a8db54ec47838bfb7771c
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_present_mach.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "rb_thermal_pacing.h"
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/thread_policy.h>
+#include <stdio.h>
+
+static inline uint32_t rb_mach_ticks(uint64_t ns, mach_timebase_info_data_t tb) {
+    return (uint32_t)(ns * tb.denom / tb.numer);
+}
+
+static inline thread_time_constraint_policy_data_t rb_mach_present_tuple(
+    uint64_t period_ns, mach_timebase_info_data_t tb) {
+    uint64_t budget = period_ns < RB_PRESENT_COMP_NS ? period_ns : RB_PRESENT_COMP_NS;
+    return (thread_time_constraint_policy_data_t){
+        .period = rb_mach_ticks(period_ns,tb), .computation = rb_mach_ticks(budget,tb),
+        .constraint = rb_mach_ticks(rb_present_deadline(period_ns),tb), .preemptible = TRUE
+    };
+}
+
+static inline int rb_mach_timeshare(thread_t thread, kern_return_t *set_kr, kern_return_t *read_kr) {
+    thread_extended_policy_data_t policy = {.timeshare=TRUE};
+    *set_kr = thread_policy_set(thread,THREAD_EXTENDED_POLICY,(thread_policy_t)&policy,THREAD_EXTENDED_POLICY_COUNT);
+    mach_msg_type_number_t count = THREAD_EXTENDED_POLICY_COUNT;
+    boolean_t def = FALSE;
+    policy.timeshare = FALSE;
+    *read_kr = thread_policy_get(thread,THREAD_EXTENDED_POLICY,(thread_policy_t)&policy,&count,&def);
+    return *set_kr == KERN_SUCCESS && *read_kr == KERN_SUCCESS && !def &&
+           count == THREAD_EXTENDED_POLICY_COUNT && policy.timeshare;
+}
+
+// Only called by the pthread that made the declaration. A failed cleanup
+// never re-arms RT. Retries use subsequent callbacks/acquires, without timers.
+static inline int rb_mach_try_release(rb_rt_fallback *state, thread_t thread, uint64_t now,
+                                      char *note, size_t size) {
+    if (!rb_rt_release_due(state, now)) return 0;
+    kern_return_t set_kr, read_kr;
+    state->confirmed = rb_mach_timeshare(thread,&set_kr,&read_kr);
+    snprintf(note,size,"fallback=%s attempt=%u set_kr=%d read_kr=%d",
+             state->confirmed ? "timeshare_verified" :
+             state->attempts == 3 ? "timeshare_unconfirmed_final" : "timeshare_retry",
+             state->attempts,set_kr,read_kr);
+    return 1;
+}
