+// Hardware programming follows sustained demand. Guest present/acquire deadlines
+// keep their exact interval even while a host policy change is pending.
+enum { RB_CADENCE_MIN_FRAMES = 8, RB_PRESENT_COMP_NS = 2000000 };
+static inline uint64_t rb_present_budget(int hosted, uint64_t requested) {
+    return hosted ? RB_PRESENT_COMP_NS : requested;
+}
+#define RB_CADENCE_DWELL_NS UINT64_C(250000000)
+typedef struct {
+    uint64_t key, since, last_ns, frame;
+    unsigned frames;
+} rb_cadence_candidate;
+
+static inline int rb_cadence_stable(rb_cadence_candidate *c, uint64_t key, uint64_t frame, uint64_t now) {
+    if (!c->frames || c->key != key || frame < c->frame || frame - c->frame > 1 ||
+        now < c->last_ns || now - c->last_ns > RB_CADENCE_DWELL_NS) {
+        *c = (rb_cadence_candidate){.key = key, .since = now, .frames = 1};
+    } else if (frame == c->frame) {
+        return 0;
+    } else if (c->frames < RB_CADENCE_MIN_FRAMES) {
+        ++c->frames;
+    }
+    c->last_ns = now;
+    c->frame = frame;
+    return c->frames == RB_CADENCE_MIN_FRAMES && now - c->since >= RB_CADENCE_DWELL_NS;
+}
+
+static inline unsigned rb_display_interval(uint64_t ns) {
+    if (ns >= 16666665 && ns <= 16666668) return 1;
+    if (ns >= 33333331 && ns <= 33333335) return 2;
+    return 0;
+}
+static inline int rb_display_ready(rb_cadence_candidate *s, uint64_t period, uint64_t frame, uint64_t now) {
+    unsigned interval = rb_display_interval(period);
+    if (interval) return rb_cadence_stable(s, interval, frame, now);
+    s->frames = 0;
+    return 1;
