+static uint64_t par_read_inventory(NSString *dir, NSMutableSet *have, NSMutableDictionary *batches, NSUInteger *batchCount) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    uint64_t bytes = 0;
+    for (NSString *name in [fm contentsOfDirectoryAtPath:dir error:nil] ?: @[]) if ([name hasSuffix:@".metalarchive"] && ![name hasPrefix:@"batch-"]) {
+        [have addObject:name.stringByDeletingPathExtension];
+        bytes += [[fm attributesOfItemAtPath:[dir stringByAppendingPathComponent:name] error:nil] fileSize];
+    }
+    // Batch files (par_write_batch): batches.tsv holds key → file, later lines win (a key written again after a miss); a line whose file is gone is skipped
+    __attribute__((objc_precise_lifetime)) NSData *idx = [NSData dataWithContentsOfFile:[dir stringByAppendingPathComponent:@"batches.tsv"]
+                                        options:NSDataReadingMappedIfSafe error:nil];
+    NSMutableSet *bfiles = [NSMutableSet set];
+    const char *cursor = idx.bytes;
+    size_t left = idx.length;
+    char rawKey[42], rawName[80];
+    // Keep the mapped bytes alive until parsing finishes (ARC may release a local
+    // after its final message, even if C still holds an interior pointer).
+    while (rb_archive_index_next(&cursor, &left, rawKey, rawName)) {
+        NSString *key = @(rawKey), *file = @(rawName);
+        if (![bfiles containsObject:file]) {
+            if (![fm fileExistsAtPath:[dir stringByAppendingPathComponent:file]]) continue;
+            [bfiles addObject:file];
+        }
+        batches[key] = file;
+        [have addObject:key];
+    }
+    for (NSString *f in bfiles) bytes += [[fm attributesOfItemAtPath:[dir stringByAppendingPathComponent:f] error:nil] fileSize];
+    if (batchCount) *batchCount = bfiles.count;
+    return bytes;
+}
