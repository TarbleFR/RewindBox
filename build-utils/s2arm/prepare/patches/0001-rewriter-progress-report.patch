@@ -37,6 +37,26 @@ typedef struct {
 } s2a_rewrite_options;
 int s2a_rewrite_files_with_options(const s2a_rewrite_request* request,
                                  const s2a_rewrite_options* options, FILE* log);
+/* RewindBox (not in S2Arm): progress of the rewrites of the calling thread, for a progress bar.
+ * Only reports: no output byte depends on it. attempt is 1 for the first layout, 2... when a module
+ * is redone with a new layout. phase is one of S2A_PROGRESS_*; done / total count the phase's own
+ * units (instruction bytes, functions, rewrite units); total 0 = no count. Called on the rewriting
+ * thread, from inside the rewrite: it must not call the rewriter. NULL clears. */
+enum {
+  S2A_PROGRESS_LOAD = 1,     /* read and decompress the NSO */
+  S2A_PROGRESS_PREPASS,      /* optional tables, acquire / release upgrades, SDK address cuts */
+  S2A_PROGRESS_BOUNDARIES,   /* function starts and covered ranges (bytes of text) */
+  S2A_PROGRESS_SCAN,         /* sites to rewrite (bytes of text) */
+  S2A_PROGRESS_DATA,         /* data inside the text */
+  S2A_PROGRESS_ANALYZE,      /* functions with x18 sites */
+  S2A_PROGRESS_GENERATE,     /* windows, jumps and sites */
+  S2A_PROGRESS_LATE,         /* SDK address region, widescreen and late tables */
+  S2A_PROGRESS_SPINS,        /* spin loops (bytes of text) */
+  S2A_PROGRESS_OUTPUTS       /* layout and output files */
+};
+typedef void (*s2a_progress_fn)(void* context, int attempt, int phase, unsigned long long done,
+                                unsigned long long total);
+void s2a_rewrite_set_progress(s2a_progress_fn fn, void* context);
 #ifdef __cplusplus
 }
 #endif
