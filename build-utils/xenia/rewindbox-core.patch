diff --git a/src/xenia/ui/ios/CMakeLists.txt b/src/xenia/ui/ios/CMakeLists.txt
index 86c4105..92ed037 100644
--- a/src/xenia/ui/ios/CMakeLists.txt
+++ b/src/xenia/ui/ios/CMakeLists.txt
@@ -250,9 +250,15 @@ target_compile_options(xenia-ui-ios PRIVATE
 )
 
 # StateReporting (ios_state_reporting.mm) is new in iOS 27; the app runs on 26.
+# RewindBox embedded Core: linked only when the selected SDK has it (an iOS 26
+# SDK has no StateReporting.framework; ios_state_reporting.mm then reports nothing).
+execute_process(COMMAND xcrun --sdk iphoneos --show-sdk-path
+  OUTPUT_VARIABLE XE_NEO_IOS_SDK_PATH OUTPUT_STRIP_TRAILING_WHITESPACE)
+if(EXISTS "${XE_NEO_IOS_SDK_PATH}/System/Library/Frameworks/StateReporting.framework")
 target_link_options(xenia-ui-ios PUBLIC
   "SHELL:-weak_framework StateReporting"
 )
+endif()
 
 target_link_libraries(xenia-ui-ios PUBLIC
   xenia-apu-voice
