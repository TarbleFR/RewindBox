+// What the diagnostic thread keeps per boot (REWINDBOX_CAPTURE_914): the limits belong to one boot session, and a
+// request that cannot be served has a reason.
+struct boot_limits
+{
+	std::uint64_t session = ~0ull;
+	std::uint32_t putllc = 0; // captures started in this boot
+	std::uint32_t ppu = 0;
+
+	// True when `now` is another boot: the limits start again and a request left by the previous game is dropped.
+	bool enter(std::uint64_t now) noexcept
+	{
+		if (now == session)
+		{
+			return false;
+		}
+
+		session = now;
+		putllc = 0;
+		ppu = 0;
+		start_request::clear();
+		return true;
+	}
+};
+
+enum class refusal : std::uint8_t { none, limit_per_boot, previous_capture_not_exported };
+
+inline const char* refusal_name(refusal why) noexcept
+{
+	return why == refusal::limit_per_boot ? "limit_per_boot" : why == refusal::previous_capture_not_exported ? "previous_capture_not_exported" : "none";
+}
+
+// Diagnostic thread: serve one start request of the heavy PUTLLC trace. On refusal::none the capture collects and
+// boot.putllc is its number in this boot.
+inline refusal serve_putllc(boot_limits& boot, std::uint64_t now_tsc) noexcept
+{
+	if (boot.putllc >= putllc_trace::max_captures)
+	{
+		return refusal::limit_per_boot;
+	}
+
+	if (!putllc_trace::start(now_tsc))
+	{
+		return refusal::previous_capture_not_exported;
+	}
+
+	boot.putllc++;
+	return refusal::none;
+}
+
+// Diagnostic thread: may a PPU region profile start? The caller starts it and counts it on refusal::none.
+inline refusal admit_ppu(const boot_limits& boot, bool previous_still_running) noexcept
+{
+	if (previous_still_running)
+	{
+		return refusal::previous_capture_not_exported;
+	}
+
+	return boot.ppu >= ppu_profile::max_captures ? refusal::limit_per_boot : refusal::none;
+}
 } // namespace rpcs3::ios::capture912
