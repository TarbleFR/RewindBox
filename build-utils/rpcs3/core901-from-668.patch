+	void barrier_after_queue_stages(const object& encoder, u64 after, u64 before);
+
+	void end_encoding(const object& encoder);
+
+	// The CAMetalLayer the host attached, and its drawables (Metal 4 presentation through the queue).
+	void configure_layer(void* layer, const object& device, pixel_format format, u32 width, u32 height);
+	object layer_residency_set(void* layer);
+	object next_drawable(void* layer);
+	object drawable_texture(const object& drawable);
+	void wait_for_drawable(const object& queue, const object& drawable);
+	void signal_drawable(const object& queue, const object& drawable);
+	void present(const object& drawable);
