+	RBX_METAL4 object new_render_pipeline(const object& compiler, const render_pipeline_descriptor& descriptor, std::string& error)
+	{
+		@autoreleasepool
+		{
+			const auto function = [&](const std::string& name) -> MTL4LibraryFunctionDescriptor*
+			{
+				if (name.empty())
+				{
+					return nil;
+				}
+
+				MTL4LibraryFunctionDescriptor* result = [[MTL4LibraryFunctionDescriptor alloc] init];
+				result.library = as<id<MTLLibrary>>(descriptor.library);
+				result.name = string(name);
+				return result;
+			};
+
+			MTL4RenderPipelineDescriptor* desc = [[MTL4RenderPipelineDescriptor alloc] init];
+			desc.vertexFunctionDescriptor = function(descriptor.vertex_function);
+			desc.fragmentFunctionDescriptor = function(descriptor.fragment_function);
+			for (u32 index = 0; index < descriptor.color.size(); ++index)
+			{
+				const color_attachment_state& state = descriptor.color[index];
+				MTL4RenderPipelineColorAttachmentDescriptor* color = desc.colorAttachments[index];
+				color.pixelFormat = static_cast<MTLPixelFormat>(state.format);
+				color.blendingState = state.blending ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+				color.sourceRGBBlendFactor = static_cast<MTLBlendFactor>(state.source_rgb);
+				color.destinationRGBBlendFactor = static_cast<MTLBlendFactor>(state.destination_rgb);
+				color.rgbBlendOperation = static_cast<MTLBlendOperation>(state.rgb_operation);
+				color.sourceAlphaBlendFactor = static_cast<MTLBlendFactor>(state.source_alpha);
+				color.destinationAlphaBlendFactor = static_cast<MTLBlendFactor>(state.destination_alpha);
+				color.alphaBlendOperation = static_cast<MTLBlendOperation>(state.alpha_operation);
+				color.writeMask = static_cast<MTLColorWriteMask>(state.write_mask);
+			}
+			desc.rasterSampleCount = descriptor.sample_count;
+			desc.alphaToCoverageState = descriptor.alpha_to_coverage ? MTL4AlphaToCoverageStateEnabled : MTL4AlphaToCoverageStateDisabled;
+			if (!descriptor.label.empty())
+			{
+				desc.label = string(descriptor.label);
+			}
+
+			NSError* failure = nil;
+			const id<MTLRenderPipelineState> pipeline = [as<id<MTL4Compiler>>(compiler) newRenderPipelineStateWithDescriptor:desc
+				compilerTaskOptions:nil error:&failure];
+			if (!pipeline)
+			{
+				error = describe(failure);
+			}
+			return keep(pipeline);
+		}
+	}
