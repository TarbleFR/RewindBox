@@ -0,0 +1,561 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE: the native Metal 4 renderer's only view of Metal (iOS 26 or later).
+//
+// The renderer is plain C++; this header is its whole Metal surface. MTLAPIApple.mm implements it
+// with the Metal and QuartzCore frameworks (ARC). Keeping Objective-C out of the renderer lets the
+// same renderer code be compiled and tested on any host against another implementation of this
+// header. Every enumerator below has the numeric value of its Metal constant; MTLAPIApple.mm checks
+// each one at compile time, so a value never needs a translation table.
+
+#include "util/types.hpp"
+
+#include <array>
+#include <functional>
+#include <string>
+#include <string_view>
+
+namespace mtl
+{
+	// A retained Objective-C object, released when the last copy goes away. Copying retains.
+	class object
+	{
+	public:
+		object() noexcept = default;
+		object(const object& other) noexcept;
+		object& operator=(const object& other) noexcept;
+		object(object&& other) noexcept;
+		object& operator=(object&& other) noexcept;
+		~object();
+
+		// Takes ownership of a +1 reference.
+		static object adopt(void* retained) noexcept;
+		// Retains a reference owned elsewhere.
+		static object retain(void* unretained) noexcept;
+
+		void* get() const noexcept { return m_ptr; }
+		explicit operator bool() const noexcept { return m_ptr != nullptr; }
+		void reset() noexcept;
+
+	private:
+		void* m_ptr = nullptr;
+	};
+
+	enum class pixel_format : u32
+	{
+		invalid = 0,
+		a8_unorm = 1,
+		r8_unorm = 10,
+		r8_snorm = 12,
+		r8_uint = 13,
+		r16_unorm = 20,
+		r16_snorm = 22,
+		r16_uint = 23,
+		r16_float = 25,
+		rg8_unorm = 30,
+		rg8_snorm = 32,
+		b5g6r5_unorm = 40,
+		a1bgr5_unorm = 41,
+		abgr4_unorm = 42,
+		bgr5a1_unorm = 43,
+		r32_uint = 53,
+		r32_sint = 54,
+		r32_float = 55,
+		rg16_unorm = 60,
+		rg16_snorm = 62,
+		rg16_float = 65,
+		rgba8_unorm = 70,
+		rgba8_unorm_srgb = 71,
+		rgba8_snorm = 72,
+		rgba8_uint = 73,
+		bgra8_unorm = 80,
+		bgra8_unorm_srgb = 81,
+		rgb10a2_unorm = 90,
+		rg11b10_float = 92,
+		rgb9e5_float = 93,
+		bgr10a2_unorm = 94,
+		rg32_uint = 103,
+		rg32_float = 105,
+		rgba16_unorm = 110,
+		rgba16_snorm = 112,
+		rgba16_uint = 113,
+		rgba16_float = 115,
+		rgba32_uint = 123,
+		rgba32_float = 125,
+		bc1_rgba = 130,
+		bc1_rgba_srgb = 131,
+		bc2_rgba = 132,
+		bc2_rgba_srgb = 133,
+		bc3_rgba = 134,
+		bc3_rgba_srgb = 135,
+		depth16_unorm = 250,
+		depth32_float = 252,
+		stencil8 = 253,
+		depth24_unorm_stencil8 = 255,
+		depth32_float_stencil8 = 260,
+		x32_stencil8 = 261,
+	};
+
+	enum class texture_type : u32
+	{
+		type_1d = 0,
+		type_1d_array = 1,
+		type_2d = 2,
+		type_2d_array = 3,
+		type_2d_multisample = 4,
+		type_cube = 5,
+		type_cube_array = 6,
+		type_3d = 7,
+	};
+
+	enum texture_usage : u32
+	{
+		usage_unknown = 0,
+		usage_shader_read = 1,
+		usage_shader_write = 2,
+		usage_render_target = 4,
+		usage_pixel_format_view = 16,
+	};
+
+	enum class storage_mode : u32
+	{
+		shared = 0,
+		private_ = 2,
+		memoryless = 3,
+	};
+
+	enum class load_action : u32
+	{
+		dont_care = 0,
+		load = 1,
+		clear = 2,
+	};
+
+	enum class store_action : u32
+	{
+		dont_care = 0,
+		store = 1,
+		multisample_resolve = 2,
+		store_and_multisample_resolve = 3,
+	};
+
+	enum class primitive_type : u32
+	{
+		point = 0,
+		line = 1,
+		line_strip = 2,
+		triangle = 3,
+		triangle_strip = 4,
+	};
+
+	enum class index_type : u32
+	{
+		uint16 = 0,
+		uint32 = 1,
+	};
+
+	enum class compare_function : u32
+	{
+		never = 0,
+		less = 1,
+		equal = 2,
+		less_equal = 3,
+		greater = 4,
+		not_equal = 5,
+		greater_equal = 6,
+		always = 7,
+	};
+
+	enum class stencil_operation : u32
+	{
+		keep = 0,
+		zero = 1,
+		replace = 2,
+		increment_clamp = 3,
+		decrement_clamp = 4,
+		invert = 5,
+		increment_wrap = 6,
+		decrement_wrap = 7,
+	};
+
+	enum class blend_factor : u32
+	{
+		zero = 0,
+		one = 1,
+		source_color = 2,
+		one_minus_source_color = 3,
+		source_alpha = 4,
+		one_minus_source_alpha = 5,
+		destination_color = 6,
+		one_minus_destination_color = 7,
+		destination_alpha = 8,
+		one_minus_destination_alpha = 9,
+		source_alpha_saturated = 10,
+		blend_color = 11,
+		one_minus_blend_color = 12,
+		blend_alpha = 13,
+		one_minus_blend_alpha = 14,
+	};
+
+	enum class blend_operation : u32
+	{
+		add = 0,
+		subtract = 1,
+		reverse_subtract = 2,
+		min = 3,
+		max = 4,
+	};
+
+	enum color_write_mask : u32
+	{
+		write_none = 0,
+		write_alpha = 1,
+		write_blue = 2,
+		write_green = 4,
+		write_red = 8,
+		write_all = 15,
+	};
+
+	enum class cull_mode : u32
+	{
+		none = 0,
+		front = 1,
+		back = 2,
+	};
+
+	enum class winding : u32
+	{
+		clockwise = 0,
+		counter_clockwise = 1,
+	};
+
+	enum class triangle_fill_mode : u32
+	{
+		fill = 0,
+		lines = 1,
+	};
+
+	enum class depth_clip_mode : u32
+	{
+		clip = 0,
+		clamp = 1,
+	};
+
+	enum class sampler_min_mag_filter : u32
+	{
+		nearest = 0,
+		linear = 1,
+	};
+
+	enum class sampler_mip_filter : u32
+	{
+		not_mipmapped = 0,
+		nearest = 1,
+		linear = 2,
+	};
+
+	enum class sampler_address_mode : u32
+	{
+		clamp_to_edge = 0,
+		mirror_clamp_to_edge = 1,
+		repeat = 2,
+		mirror_repeat = 3,
+		clamp_to_zero = 4,
+		clamp_to_border_color = 5,
+	};
+
+	enum class sampler_border_color : u32
+	{
+		transparent_black = 0,
+		opaque_black = 1,
+		opaque_white = 2,
+	};
+
+	enum class visibility_result_mode : u32
+	{
+		disabled = 0,
+		boolean = 1,
+		counting = 2,
+	};
+
+	// Apple GPU families (MTLGPUFamilyApple7 = 1007 ...).
+	enum class gpu_family : u32
+	{
+		apple7 = 1007,
+		apple8 = 1008,
+		apple9 = 1009,
+		metal4 = 5002,
+	};
+
+	struct origin
+	{
+		u32 x = 0, y = 0, z = 0;
+	};
+
+	struct size3
+	{
+		u32 width = 0, height = 0, depth = 1;
+	};
+
+	struct region
+	{
+		origin at{};
+		size3 size{};
+	};
+
+	struct clear_color
+	{
+		f64 red = 0, green = 0, blue = 0, alpha = 0;
+	};
+
+	struct viewport
+	{
+		f64 x = 0, y = 0, width = 0, height = 0, znear = 0, zfar = 1;
+	};
+
+	struct scissor_rect
+	{
+		u32 x = 0, y = 0, width = 0, height = 0;
+	};
+
+	struct device_info
+	{
+		std::string name;
+		u64 registry_id = 0;
+		u64 max_buffer_length = 0;
+		bool unified_memory = false;
+		bool apple7 = false;
+		bool apple8 = false;
+		bool apple9 = false;
+		bool bc_texture_compression = false;
+		bool depth24_stencil8 = false;
+		bool metal4 = false;
+	};
+
+	struct texture_descriptor
+	{
+		texture_type type = texture_type::type_2d;
+		pixel_format format = pixel_format::invalid;
+		u32 width = 1, height = 1, depth = 1;
+		u32 mip_levels = 1, array_length = 1, sample_count = 1;
+		u32 usage = usage_shader_read;
+		storage_mode storage = storage_mode::private_;
+	};
+
+	struct sampler_descriptor
+	{
+		sampler_min_mag_filter min_filter = sampler_min_mag_filter::nearest;
+		sampler_min_mag_filter mag_filter = sampler_min_mag_filter::nearest;
+		sampler_mip_filter mip_filter = sampler_mip_filter::not_mipmapped;
+		sampler_address_mode address_s = sampler_address_mode::clamp_to_edge;
+		sampler_address_mode address_t = sampler_address_mode::clamp_to_edge;
+		sampler_address_mode address_r = sampler_address_mode::clamp_to_edge;
+		sampler_border_color border = sampler_border_color::transparent_black;
+		compare_function compare = compare_function::never;
+		bool compare_enabled = false;
+		u32 max_anisotropy = 1;
+		f32 lod_min = 0.f;
+		f32 lod_max = 1000.f;
+		bool normalized_coordinates = true;
+	};
+
+	struct render_pass_color_attachment
+	{
+		object texture;
+		u32 level = 0, slice = 0, depth_plane = 0;
+		object resolve_texture;
+		load_action load = load_action::load;
+		store_action store = store_action::store;
+		clear_color clear{};
+	};
+
+	struct render_pass_depth_attachment
+	{
+		object texture;
+		u32 level = 0, slice = 0;
+		load_action load = load_action::load;
+		store_action store = store_action::store;
+		f64 clear_depth = 1.0;
+	};
+
+	struct render_pass_stencil_attachment
+	{
+		object texture;
+		u32 level = 0, slice = 0;
+		load_action load = load_action::load;
+		store_action store = store_action::store;
+		u32 clear_stencil = 0;
+	};
+
+	struct render_pass_descriptor
+	{
+		static constexpr u32 max_color_attachments = 8;
+		std::array<render_pass_color_attachment, max_color_attachments> color{};
+		render_pass_depth_attachment depth{};
+		render_pass_stencil_attachment stencil{};
+		object visibility_result_buffer;
+		u32 render_target_width = 0, render_target_height = 0;
+		u32 default_raster_sample_count = 0;
+	};
+
+	struct color_attachment_state
+	{
+		pixel_format format = pixel_format::invalid;
+		bool blending = false; // Metal 4 BlendStateEnabled when true, BlendStateDisabled otherwise
+		blend_factor source_rgb = blend_factor::one, destination_rgb = blend_factor::zero;
+		blend_operation rgb_operation = blend_operation::add;
+		blend_factor source_alpha = blend_factor::one, destination_alpha = blend_factor::zero;
+		blend_operation alpha_operation = blend_operation::add;
+		u32 write_mask = write_all;
+	};
+
+	// Metal 4 pipelines name their functions in a library; depth and stencil formats come from the render pass.
+	struct render_pipeline_descriptor
+	{
+		object library;
+		std::string vertex_function;
+		std::string fragment_function;
+		std::array<color_attachment_state, render_pass_descriptor::max_color_attachments> color{};
+		u32 sample_count = 1;
+		bool alpha_to_coverage = false;
+		std::string label;
+	};
+
+	struct stencil_state
+	{
+		compare_function compare = compare_function::always;
+		stencil_operation stencil_fail = stencil_operation::keep;
+		stencil_operation depth_fail = stencil_operation::keep;
+		stencil_operation depth_stencil_pass = stencil_operation::keep;
+		u32 read_mask = 0xff;
+		u32 write_mask = 0xff;
+	};
+
+	struct depth_stencil_descriptor
+	{
+		compare_function depth_compare = compare_function::always;
+		bool depth_write = false;
+		bool stencil = false;
+		stencil_state front{};
+		stencil_state back{};
+	};
+
+	// Device. Every Metal 4 entry point below requires query_device(...).metal4 (iOS 26, Apple7 or later).
+	object create_system_default_device() noexcept;
+	device_info query_device(const object& device);
+
+	// Metal 4 command submission. A command buffer is encoded between begin and end with an allocator that
+	// the GPU no longer uses, then committed to its queue; an allocator is reset only after its work completed.
+	object new_command_queue(const object& device);
+	object new_command_allocator(const object& device);
+	void reset_command_allocator(const object& allocator);
+	object new_command_buffer(const object& device);
+	void begin_command_buffer(const object& command_buffer, const object& allocator, std::string_view label = {});
+	void end_command_buffer(const object& command_buffer);
+	void commit(const object& queue, const object& command_buffer);
+
+	// GPU progress: the queue signals the event once the work committed before the signal completed.
+	object new_shared_event(const object& device);
+	void signal_event(const object& queue, const object& event, u64 value);
+	u64 signaled_value(const object& event);
+	bool wait_signaled_value(const object& event, u64 value, u64 timeout_ms);
+
+	// Residency: with Metal 4 every allocation the GPU touches must be resident through a set the queue holds.
+	object new_residency_set(const object& device, u32 initial_capacity);
+	void residency_add(const object& set, const object& allocation);
+	void residency_remove(const object& set, const object& allocation);
+	void residency_commit(const object& set);
+	void queue_add_residency_set(const object& queue, const object& set);
+
+	// Buffers.
+	object new_buffer(const object& device, u64 length, storage_mode storage = storage_mode::shared);
+	void* buffer_contents(const object& buffer);
+	u64 buffer_length(const object& buffer);
+
+	// Textures.
+	object new_texture(const object& device, const texture_descriptor& descriptor);
+	object new_texture_view(const object& texture, pixel_format format);
+	void texture_replace_region(const object& texture, const region& area, u32 level, u32 slice, const void* bytes, u32 bytes_per_row, u32 bytes_per_image);
+	void texture_get_bytes(const object& texture, void* bytes, u32 bytes_per_row, u32 bytes_per_image, const region& area, u32 level, u32 slice);
+	size3 texture_size(const object& texture);
+	pixel_format texture_format(const object& texture);
+
+	// Samplers (created usable from argument tables).
+	object new_sampler(const object& device, const sampler_descriptor& descriptor);
+
+	// Argument tables: resources are bound by GPU address or resource ID and captured at each draw.
+	object new_argument_table(const object& device, u32 max_buffers, u32 max_textures, u32 max_samplers);
+	void table_set_buffer(const object& table, const object& buffer, u64 offset, u32 index);
+	void table_set_texture(const object& table, const object& texture, u32 index);
+	void table_set_sampler(const object& table, const object& sampler, u32 index);
+
+	// The Metal 4 compiler. A failure returns an empty object and fills error.
+	object new_compiler(const object& device);
+	object compile_library(const object& compiler, std::string_view source, std::string& error);
+	object new_render_pipeline(const object& compiler, const render_pipeline_descriptor& descriptor, std::string& error);
+	object new_depth_stencil_state(const object& device, const depth_stencil_descriptor& descriptor);
+
+	// Render command encoders. Every encoder is ended before the next one starts.
+	enum render_stages : u32
+	{
+		stage_vertex = 1,
+		stage_fragment = 2,
+	};
+
+	object begin_render_pass(const object& command_buffer, const render_pass_descriptor& descriptor, std::string_view label = {});
+	void set_render_pipeline(const object& encoder, const object& pipeline);
+	void set_argument_table(const object& encoder, const object& table, u32 stages);
+	void set_depth_stencil_state(const object& encoder, const object& state);
+	void set_stencil_reference(const object& encoder, u32 front, u32 back);
+	void set_viewport(const object& encoder, const viewport& area);
+	void set_scissor(const object& encoder, const scissor_rect& area);
+	void set_cull_mode(const object& encoder, cull_mode mode);
+	void set_front_facing(const object& encoder, winding front);
+	void set_fill_mode(const object& encoder, triangle_fill_mode mode);
+	void set_depth_clip_mode(const object& encoder, depth_clip_mode mode);
+	void set_depth_bias(const object& encoder, f32 bias, f32 slope_scale, f32 clamp);
+	void set_blend_color(const object& encoder, f32 red, f32 green, f32 blue, f32 alpha);
+	void set_visibility_result_mode(const object& encoder, visibility_result_mode mode, u64 offset);
+	void draw_primitives(const object& encoder, primitive_type type, u32 vertex_start, u32 vertex_count, u32 instance_count = 1);
+	void draw_indexed_primitives(const object& encoder, primitive_type type, u32 index_count, index_type indices, const object& index_buffer,
+		u64 index_offset, u64 index_length, u32 instance_count = 1);
+
+	// Compute command encoders: the Metal 4 home of copies and fills.
+	object begin_compute(const object& command_buffer, std::string_view label = {});
+	void copy_texture(const object& encoder, const object& source, u32 source_slice, u32 source_level, const region& source_area,
+		const object& destination, u32 destination_slice, u32 destination_level, const origin& destination_origin);
+	void copy_buffer_to_texture(const object& encoder, const object& source, u64 offset, u32 bytes_per_row, u32 bytes_per_image,
+		const size3& size, const object& destination, u32 slice, u32 level, const origin& destination_origin);
+	void copy_texture_to_buffer(const object& encoder, const object& source, u32 slice, u32 level, const region& source_area,
+		const object& destination, u64 offset, u32 bytes_per_row, u32 bytes_per_image);
+	void fill_buffer(const object& encoder, const object& buffer, u64 offset, u64 length, u8 value);
+
+	// Barriers: work of this encoder in `before` waits for the queue's earlier work in `after`.
+	enum barrier_stages : u64
+	{
+		barrier_vertex = 1,
+		barrier_fragment = 1u << 1,
+		barrier_tile = 1u << 2,
+		barrier_object = 1u << 3,
+		barrier_mesh = 1u << 4,
+		barrier_resource_state = 1u << 26,
+		barrier_dispatch = 1u << 27,
+		barrier_blit = 1u << 28,
+		barrier_acceleration_structure = 1u << 29,
+		barrier_machine_learning = 1u << 30,
+		barrier_all = 0x7fffffffffffffffull,
