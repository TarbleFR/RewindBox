+	object new_depth_stencil_state(const object& device, const depth_stencil_descriptor& descriptor)
+	{
+		@autoreleasepool
+		{
+			MTLDepthStencilDescriptor* desc = [[MTLDepthStencilDescriptor alloc] init];
+			desc.depthCompareFunction = static_cast<MTLCompareFunction>(descriptor.depth_compare);
+			desc.depthWriteEnabled = descriptor.depth_write;
+			if (descriptor.stencil)
+			{
+				const auto stencil = [](const stencil_state& state)
+				{
+					MTLStencilDescriptor* result = [[MTLStencilDescriptor alloc] init];
+					result.stencilCompareFunction = static_cast<MTLCompareFunction>(state.compare);
+					result.stencilFailureOperation = static_cast<MTLStencilOperation>(state.stencil_fail);
+					result.depthFailureOperation = static_cast<MTLStencilOperation>(state.depth_fail);
+					result.depthStencilPassOperation = static_cast<MTLStencilOperation>(state.depth_stencil_pass);
+					result.readMask = state.read_mask;
+					result.writeMask = state.write_mask;
+					return result;
+				};
+				desc.frontFaceStencil = stencil(descriptor.front);
+				desc.backFaceStencil = stencil(descriptor.back);
+			}
+			return keep([as<id<MTLDevice>>(device) newDepthStencilStateWithDescriptor:desc]);
+		}
+	}
