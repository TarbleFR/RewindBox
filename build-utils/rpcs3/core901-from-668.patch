+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE: the native Metal 4 renderer, stage M1 (see MTLGSRender.h).
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+#include "MTLPresent.h"
+
