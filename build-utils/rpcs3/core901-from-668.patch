index 0000000..d8dbe2b
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLAPIApple.mm
@@ -0,0 +1,921 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE: MTLAPI.h on the Metal 4 and QuartzCore frameworks (iOS 26). Compiled with ARC.
+//
+// Every Metal 4 function is declared available from iOS 26; the Core still loads on older systems,
+// where query_device() reports metal4 = false and the renderer refuses to start before any call here.
+//
+// Every function that may receive an autoreleased object runs inside its own autorelease pool: the
+// RSX thread is a plain C++ thread with no pool of its own. Objects handed back to the renderer are
+// retained into an mtl::object first, so they outlive the pool.
+
+#include "MTLAPI.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+#if !__has_feature(objc_arc)
+#error "MTLAPIApple.mm must be compiled with -fobjc-arc"
+#endif
+
+#include <utility>
+
+#define RBX_METAL4 API_AVAILABLE(ios(26.0), macos(26.0))
+
+namespace mtl
+{
+	// The enumerators of MTLAPI.h carry the numeric values of their Metal constants.
+	static_assert(static_cast<u32>(pixel_format::a8_unorm) == MTLPixelFormatA8Unorm);
