+	RBX_METAL4 object begin_render_pass(const object& command_buffer, const render_pass_descriptor& descriptor, std::string_view label)
+	{
+		@autoreleasepool
+		{
+			MTL4RenderPassDescriptor* desc = [[MTL4RenderPassDescriptor alloc] init];
+			for (u32 index = 0; index < descriptor.color.size(); ++index)
+			{
+				const render_pass_color_attachment& source = descriptor.color[index];
+				if (!source.texture)
+				{
+					continue;
+				}
+
+				MTLRenderPassColorAttachmentDescriptor* color = desc.colorAttachments[index];
+				color.texture = as<id<MTLTexture>>(source.texture);
+				color.level = source.level;
+				color.slice = source.slice;
+				color.depthPlane = source.depth_plane;
+				color.resolveTexture = as<id<MTLTexture>>(source.resolve_texture);
+				color.loadAction = static_cast<MTLLoadAction>(source.load);
+				color.storeAction = static_cast<MTLStoreAction>(source.store);
+				color.clearColor = MTLClearColorMake(source.clear.red, source.clear.green, source.clear.blue, source.clear.alpha);
+			}
+
+			if (descriptor.depth.texture)
+			{
+				desc.depthAttachment.texture = as<id<MTLTexture>>(descriptor.depth.texture);
+				desc.depthAttachment.level = descriptor.depth.level;
+				desc.depthAttachment.slice = descriptor.depth.slice;
+				desc.depthAttachment.loadAction = static_cast<MTLLoadAction>(descriptor.depth.load);
+				desc.depthAttachment.storeAction = static_cast<MTLStoreAction>(descriptor.depth.store);
+				desc.depthAttachment.clearDepth = descriptor.depth.clear_depth;
+			}
+
+			if (descriptor.stencil.texture)
+			{
+				desc.stencilAttachment.texture = as<id<MTLTexture>>(descriptor.stencil.texture);
+				desc.stencilAttachment.level = descriptor.stencil.level;
+				desc.stencilAttachment.slice = descriptor.stencil.slice;
+				desc.stencilAttachment.loadAction = static_cast<MTLLoadAction>(descriptor.stencil.load);
+				desc.stencilAttachment.storeAction = static_cast<MTLStoreAction>(descriptor.stencil.store);
+				desc.stencilAttachment.clearStencil = descriptor.stencil.clear_stencil;
+			}
+
+			desc.visibilityResultBuffer = as<id<MTLBuffer>>(descriptor.visibility_result_buffer);
+			if (descriptor.render_target_width && descriptor.render_target_height)
+			{
+				desc.renderTargetWidth = descriptor.render_target_width;
+				desc.renderTargetHeight = descriptor.render_target_height;
+			}
+			if (descriptor.default_raster_sample_count)
+			{
+				desc.defaultRasterSampleCount = descriptor.default_raster_sample_count;
+			}
+
+			const id<MTL4RenderCommandEncoder> encoder = [as<id<MTL4CommandBuffer>>(command_buffer) renderCommandEncoderWithDescriptor:desc];
+			if (encoder && !label.empty())
+			{
+				encoder.label = string(label);
+			}
+			return keep(encoder);
+		}
+	}
