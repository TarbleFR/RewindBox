+#include "util/asm.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+namespace mtl
+{
+	stage_counters& counters() noexcept
+	{
+		static stage_counters s_counters;
+		return s_counters;
+	}
+
+	namespace
+	{
+		constexpr u64 slow_wait_ms = 5000;
+	}
+}
+
+MTLGSRender::MTLGSRender(utils::serial* ar) noexcept
+	: GSRender(ar)
+{
+	m_device = mtl::create_system_default_device();
+	if (!m_device)
+	{
+		m_initialization_error = "No Metal device";
+		return;
+	}
+
+	m_device_info = mtl::query_device(m_device);
+	if (!m_device_info.metal4)
+	{
+		m_initialization_error = fmt::format("The Metal 4 renderer needs iOS 26 and a Metal 4 GPU (Apple7 or later); this device is '%s'", m_device_info.name);
+		m_device.reset();
+		return;
+	}
+
+	// What the renderer does not execute yet is counted, never assumed rendered.
+	backend_config.supports_multidraw = false;
+	backend_config.supports_hw_instanced_rendering = false;
+}
+
+MTLGSRender::~MTLGSRender() = default;
+
+u64 MTLGSRender::get_cycles()
+{
+	return thread_ctrl::get_cycles(static_cast<named_thread<MTLGSRender>&>(*this));
+}
+
+void MTLGSRender::on_init_thread()
+{
+	if (!m_device)
+	{
+		fmt::throw_exception("%s", m_initialization_error.empty() ? "No Metal device was created" : m_initialization_error);
+	}
+
+	GSRender::on_init_thread();
+	zcull_ctrl.reset(static_cast<::rsx::reports::ZCULL_control*>(this));
+
+	ensure(m_frame, "The Metal renderer needs the iOS display surface");
+#ifdef __APPLE__
+	// The iOS frame's handle is the CAMetalLayer of the display surface (rpcs3::ios::gs_frame::handle).
+	m_layer = m_frame->handle();
+#endif
+	ensure(m_layer, "The display surface has no CAMetalLayer");
+
+	m_queue = mtl::new_command_queue(m_device);
+	m_compiler = mtl::new_compiler(m_device);
+	m_event = mtl::new_shared_event(m_device);
+	m_residency = mtl::new_residency_set(m_device, 64);
+	ensure(m_queue && m_compiler && m_event && m_residency, "Metal 4 queue, compiler, event or residency set creation failed");
+
+	// The layer's drawables are resident through the layer's own set.
+	mtl::queue_add_residency_set(m_queue, m_residency);
+	if (const mtl::object layer_set = mtl::layer_residency_set(m_layer))
+	{
+		mtl::queue_add_residency_set(m_queue, layer_set);
+	}
+
+	update_drawable_size();
+
+	for (frame_slot& slot : m_frames)
+	{
+		slot.allocator = mtl::new_command_allocator(m_device);
+		slot.command_buffer = mtl::new_command_buffer(m_device);
+		slot.constants = mtl::new_buffer(m_device, 256, mtl::storage_mode::shared);
+		ensure(slot.allocator && slot.command_buffer && slot.constants, "Metal 4 frame resources");
+		make_resident(slot.constants);
+	}
+
+	m_present_table = mtl::new_argument_table(m_device, 1, 1, 1);
+	mtl::sampler_descriptor sampler{};
+	sampler.min_filter = mtl::sampler_min_mag_filter::linear;
+	sampler.mag_filter = mtl::sampler_min_mag_filter::linear;
+	m_present_sampler = mtl::new_sampler(m_device, sampler);
+	ensure(m_present_table && m_present_sampler, "Metal 4 presentation table or sampler");
+
+	std::string error;
+	if (!create_present_pipeline(error))
+	{
+		fmt::throw_exception("Metal presentation pipeline: %s", error);
+	}
+
+	rsx_log.notice("Metal 4 renderer M1: device '%s' (Apple7=%d Apple8=%d Apple9=%d, BC=%d, unified=%d), drawable %ux%u",
+		m_device_info.name, m_device_info.apple7, m_device_info.apple8, m_device_info.apple9, m_device_info.bc_texture_compression,
+		m_device_info.unified_memory, m_drawable_width, m_drawable_height);
+	rsx_log.warning("Metal 4 renderer M1: draws, clears and occlusion queries are not executed yet (counted in COREPROF METAL_M1)");
+}
+
+void MTLGSRender::on_exit()
+{
+	wait_idle();
+	GSRender::on_exit();
+
+	for (frame_slot& slot : m_frames)
+	{
+		slot = {};
+	}
+
+	m_present_pipeline.reset();
+	m_present_table.reset();
+	m_present_sampler.reset();
+	m_residency.reset();
+	m_event.reset();
+	m_compiler.reset();
+	m_queue.reset();
+}
+
+void MTLGSRender::begin()
+{
+	rsx::thread::begin();
+}
+
+void MTLGSRender::end()
+{
+	// Not rendered in M1: the draw's pipeline dependencies run (as for a skipped draw), and it is counted.
+	execute_nop_draw();
+	mtl::counters().draws_not_rendered.fetch_add(1, std::memory_order_relaxed);
+	rsx::thread::end();
+}
+
+void MTLGSRender::clear_surface(u32 /*arg*/)
+{
+	mtl::counters().clears_not_rendered.fetch_add(1, std::memory_order_relaxed);
+}
+
+void MTLGSRender::begin_occlusion_query(rsx::reports::occlusion_query_info* /*query*/)
+{
+	mtl::counters().occlusion_queries_not_measured.fetch_add(1, std::memory_order_relaxed);
+}
+
+void MTLGSRender::end_occlusion_query(rsx::reports::occlusion_query_info* /*query*/)
+{
+}
+
+bool MTLGSRender::check_occlusion_query_status(rsx::reports::occlusion_query_info* /*query*/)
+{
+	return true;
+}
+
+void MTLGSRender::get_occlusion_query_result(rsx::reports::occlusion_query_info* query)
+{
+	// The base class's value for a query nothing measured.
+	ZCULL_control::get_occlusion_query_result(query);
+}
+
+void MTLGSRender::discard_occlusion_query(rsx::reports::occlusion_query_info* /*query*/)
+{
+}
+
+bool MTLGSRender::create_present_pipeline(std::string& error)
+{
+	const mtl::object library = mtl::compile_library(m_compiler, mtl::present_pass::source, error);
+	if (!library)
+	{
+		return false;
+	}
+
+	mtl::render_pipeline_descriptor desc{};
+	desc.library = library;
+	desc.vertex_function = std::string(mtl::present_pass::vertex_function);
+	desc.fragment_function = std::string(mtl::present_pass::fragment_function);
+	desc.color[0].format = mtl::pixel_format::bgra8_unorm;
+	desc.label = "RSX present";
+	m_present_pipeline = mtl::new_render_pipeline(m_compiler, desc, error);
+	return static_cast<bool>(m_present_pipeline);
+}
+
+void MTLGSRender::update_drawable_size()
+{
+	const u32 width = static_cast<u32>(std::max(0, m_frame->client_width()));
+	const u32 height = static_cast<u32>(std::max(0, m_frame->client_height()));
+	if (width == m_drawable_width && height == m_drawable_height && width && height)
+	{
+		return;
+	}
+
+	m_drawable_width = width;
+	m_drawable_height = height;
+	mtl::configure_layer(m_layer, m_device, mtl::pixel_format::bgra8_unorm, width, height);
+}
+
+void MTLGSRender::make_resident(const mtl::object& allocation)
+{
+	mtl::residency_add(m_residency, allocation);
+	m_residency_dirty = true;
+}
+
+void MTLGSRender::evict(const mtl::object& allocation)
+{
+	mtl::residency_remove(m_residency, allocation);
+	m_residency_dirty = true;
+}
+
+void MTLGSRender::wait_for_slot(frame_slot& slot)
+{
+	if (!slot.fence)
+	{
+		return;
+	}
+
+	// Waits for the GPU, however long it takes; a slow wait is reported, never abandoned.
+	while (!mtl::wait_signaled_value(m_event, slot.fence, mtl::slow_wait_ms))
+	{
+		mtl::counters().slow_gpu_waits.fetch_add(1, std::memory_order_relaxed);
+		rsx_log.error("Metal 4 renderer: frame fence %llu not signalled after %llu ms (signalled %llu)", slot.fence, mtl::slow_wait_ms,
+			mtl::signaled_value(m_event));
+	}
+}
+
+void MTLGSRender::wait_idle()
+{
+	if (m_event && m_last_fence)
+	{
+		while (!mtl::wait_signaled_value(m_event, m_last_fence, mtl::slow_wait_ms))
+		{
+			mtl::counters().slow_gpu_waits.fetch_add(1, std::memory_order_relaxed);
+			rsx_log.error("Metal 4 renderer: waiting for the last frame (fence %llu)", m_last_fence);
+		}
+	}
+}
+
+bool MTLGSRender::upload_display_buffer(frame_slot& slot, u32 address, u32 width, u32 height, u32 pitch)
+{
+	if (!vm::check_addr(address, vm::page_readable, pitch * (height - 1) + width * 4))
+	{
+		return false;
+	}
+
+	if (!slot.upload || slot.upload_width != width || slot.upload_height != height)
+	{
+		if (slot.upload)
+		{
+			// The slot's previous frame has completed (wait_for_slot): the texture is idle.
+			evict(slot.upload);
+		}
+
+		mtl::texture_descriptor desc{};
+		desc.format = mtl::pixel_format::bgra8_unorm;
+		desc.width = width;
+		desc.height = height;
+		desc.usage = mtl::usage_shader_read;
+		desc.storage = mtl::storage_mode::shared;
+		slot.upload = mtl::new_texture(m_device, desc);
+		ensure(slot.upload, "Metal display buffer texture");
+		slot.upload_width = width;
+		slot.upload_height = height;
+		make_resident(slot.upload);
+	}
+
+	// As the Vulkan renderer's upload_image_simple: each big-endian A8R8G8B8 word stored as a native u32 (BGRA8).
+	m_staging.resize(static_cast<usz>(width) * height);
+	const u8* source = vm::_ptr<const u8>(address);
+	for (u32 row = 0; row < height; ++row)
+	{
+		mtl::present_pass::convert_row(source + static_cast<usz>(row) * pitch, m_staging.data() + static_cast<usz>(row) * width, width);
+	}
+
+	mtl::texture_replace_region(slot.upload, {{0, 0, 0}, {width, height, 1}}, 0, 0, m_staging.data(), width * 4, 0);
+	return true;
+}
+
+void MTLGSRender::present(frame_slot& slot, bool has_source, u32 source_width, u32 source_height)
+{
+	const mtl::object drawable = mtl::next_drawable(m_layer);
+	if (!drawable)
+	{
+		mtl::counters().drawable_misses.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+
+	if (m_residency_dirty)
+	{
+		mtl::residency_commit(m_residency);
+		m_residency_dirty = false;
+	}
+
+	mtl::reset_command_allocator(slot.allocator);
+	mtl::begin_command_buffer(slot.command_buffer, slot.allocator, "RSX frame");
+
+	mtl::render_pass_descriptor pass{};
+	pass.color[0].texture = mtl::drawable_texture(drawable);
+	pass.color[0].load = mtl::load_action::clear;
+	pass.color[0].store = mtl::store_action::store;
+	pass.color[0].clear = {0., 0., 0., 1.};
+	const mtl::object encoder = mtl::begin_render_pass(slot.command_buffer, pass, "RSX present");
+
+	if (has_source && source_width && source_height && m_drawable_width && m_drawable_height)
+	{
+		// Fit the display buffer in the drawable, keeping its aspect ratio.
+		const mtl::present_pass::rectangle fitted = mtl::present_pass::fit(source_width, source_height, m_drawable_width, m_drawable_height);
+		auto* rect = static_cast<f32*>(mtl::buffer_contents(slot.constants));
+		rect[0] = fitted.left;
+		rect[1] = fitted.bottom;
+		rect[2] = fitted.right;
+		rect[3] = fitted.top;
+
+		mtl::table_set_buffer(m_present_table, slot.constants, 0, 0);
+		mtl::table_set_texture(m_present_table, slot.upload, 0);
+		mtl::table_set_sampler(m_present_table, m_present_sampler, 0);
+		mtl::set_render_pipeline(encoder, m_present_pipeline);
+		mtl::set_argument_table(encoder, m_present_table, mtl::stage_vertex | mtl::stage_fragment);
+		mtl::draw_primitives(encoder, mtl::primitive_type::triangle_strip, 0, 4);
+	}
+
+	mtl::end_encoding(encoder);
+	mtl::end_command_buffer(slot.command_buffer);
+
+	mtl::wait_for_drawable(m_queue, drawable);
+	mtl::commit(m_queue, slot.command_buffer);
+	slot.fence = ++m_last_fence;
+	mtl::signal_event(m_queue, m_event, slot.fence);
+	mtl::signal_drawable(m_queue, drawable);
+	mtl::present(drawable);
+	mtl::counters().frames_presented.fetch_add(1, std::memory_order_relaxed);
+}
+
+void MTLGSRender::flip(const rsx::display_flip_info_t& info)
+{
+	if (info.skip_frame || !m_queue)
+	{
+		m_frame->flip(m_context, true);
+		rsx::thread::flip(info);
+		return;
+	}
+
+	update_drawable_size();
+
+	// The display buffer, as the Vulkan renderer reads it.
+	u32 width = display_buffers[info.buffer].width;
+	u32 height = display_buffers[info.buffer].height;
+	u32 pitch = display_buffers[info.buffer].pitch;
+	u32 format = CELL_GCM_TEXTURE_A8R8G8B8;
+	const auto& avconfig = g_fxo->get<rsx::avconf>();
+
+	if (!width)
+	{
+		width = avconfig.resolution_x;
+		height = avconfig.resolution_y;
+	}
+
+	if (avconfig.state)
+	{
+		format = avconfig.get_compatible_gcm_format();
+		if (!pitch)
+		{
+			pitch = width * avconfig.get_bpp();
+		}
+
+		const size2u video_frame_size = avconfig.video_frame_size();
+		width = std::min(width, video_frame_size.width);
+		height = std::min(height, video_frame_size.height);
+	}
+	else if (!pitch)
+	{
+		pitch = width * 4;
+	}
+
+	frame_slot& slot = m_frames[m_frame_index++ % frames_in_flight];
+	wait_for_slot(slot);
+
+	bool has_source = false;
+	if (info.buffer < display_buffers_count && width && height)
+	{
+		if (format != CELL_GCM_TEXTURE_A8R8G8B8 || pitch < width * 4)
+		{
+			mtl::counters().unsupported_display_formats.fetch_add(1, std::memory_order_relaxed);
+		}
+		else
+		{
+			const u32 address = rsx::get_address(display_buffers[info.buffer].offset, CELL_GCM_LOCATION_LOCAL);
+			has_source = upload_display_buffer(slot, address, width, height, pitch);
+		}
+	}
+
+	mtl::counters().frames_from_guest_memory.fetch_add(has_source ? 1 : 0, std::memory_order_relaxed);
+	mtl::counters().frames_without_source.fetch_add(has_source ? 0 : 1, std::memory_order_relaxed);
+	present(slot, has_source, width, height);
+
+	m_frame->flip(m_context);
+	rsx::thread::flip(info);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLGSRender.h b/rpcs3/Emu/RSX/Metal/MTLGSRender.h
new file mode 100644
index 0000000..c842caf
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLGSRender.h
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE: the native Metal 4 renderer (RSX commands -> Metal 4 -> Apple GPU), stage M1.
+//
+// M1 owns the Metal device, a Metal 4 command queue, its allocators, residency and the host's
+// CAMetalLayer, and presents the display buffer read from guest memory exactly as the Vulkan renderer
+// does when no surface holds it (big-endian A8R8G8B8 words stored as native BGRA8). Draws, clears and
+// occlusion queries are not executed yet: each one is counted (COREPROF METAL_M1) and none is faked
+// or reported as rendered. Requires iOS 26 and a Metal 4 GPU (Apple7 or later).
+
+#include "Emu/RSX/GSRender.h"
+#include "MTLAPI.h"
+
+#include <array>
+#include <atomic>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	// What the renderer has not executed yet, and what it presented; read and reset by the performance window.
+	struct stage_counters
+	{
+		std::atomic<u64> draws_not_rendered{0};
+		std::atomic<u64> clears_not_rendered{0};
+		std::atomic<u64> occlusion_queries_not_measured{0};
+		std::atomic<u64> frames_presented{0};
+		std::atomic<u64> frames_from_guest_memory{0};
+		std::atomic<u64> frames_without_source{0};
+		std::atomic<u64> unsupported_display_formats{0};
+		std::atomic<u64> drawable_misses{0};
+		std::atomic<u64> slow_gpu_waits{0};
+	};
+
+	stage_counters& counters() noexcept;
+}
+
+class MTLGSRender : public GSRender, public ::rsx::reports::ZCULL_control
+{
+public:
+	MTLGSRender(utils::serial* ar) noexcept;
+	MTLGSRender() noexcept : MTLGSRender(nullptr) {}
+	~MTLGSRender() override;
+
+	u64 get_cycles() final;
+
+protected:
+	void on_init_thread() override;
+	void on_exit() override;
+
+	void begin() override;
+	void end() override;
+	void clear_surface(u32 arg) override;
+	void flip(const rsx::display_flip_info_t& info) override;
+
+	// Not measured in M1: each query is counted, and the result is the base class's "no measurement".
+	void begin_occlusion_query(rsx::reports::occlusion_query_info* query) override;
+	void end_occlusion_query(rsx::reports::occlusion_query_info* query) override;
+	bool check_occlusion_query_status(rsx::reports::occlusion_query_info* query) override;
+	void get_occlusion_query_result(rsx::reports::occlusion_query_info* query) override;
+	void discard_occlusion_query(rsx::reports::occlusion_query_info* query) override;
+
+private:
+	static constexpr u32 frames_in_flight = 3;
+
+	// One frame of GPU work: reused once the queue has signalled its fence value.
+	struct frame_slot
+	{
+		mtl::object allocator;
+		mtl::object command_buffer;
+		mtl::object constants;   // the presentation rectangle
+		mtl::object upload;      // the display buffer read from guest memory
+		u32 upload_width = 0;
+		u32 upload_height = 0;
+		u64 fence = 0;
+	};
+
+	bool create_present_pipeline(std::string& error);
+	void update_drawable_size();
+	void wait_for_slot(frame_slot& slot);
+	bool upload_display_buffer(frame_slot& slot, u32 address, u32 width, u32 height, u32 pitch);
+	void present(frame_slot& slot, bool has_source, u32 source_width, u32 source_height);
+	void make_resident(const mtl::object& allocation);
+	void evict(const mtl::object& allocation);
+	void wait_idle();
+
+	std::string m_initialization_error;
+	mtl::device_info m_device_info;
+	mtl::object m_device;
+	mtl::object m_queue;
+	mtl::object m_compiler;
+	mtl::object m_event;
+	mtl::object m_residency;
+	mtl::object m_present_pipeline;
+	mtl::object m_present_table;
+	mtl::object m_present_sampler;
+	void* m_layer = nullptr;
+	u32 m_drawable_width = 0;
+	u32 m_drawable_height = 0;
+
+	std::array<frame_slot, frames_in_flight> m_frames{};
+	u64 m_frame_index = 0;
+	u64 m_last_fence = 0;
+	bool m_residency_dirty = false;
+	std::vector<u32> m_staging;
+};
diff --git a/rpcs3/Emu/RSX/Metal/MTLPresent.h b/rpcs3/Emu/RSX/Metal/MTLPresent.h
new file mode 100644
index 0000000..5003c16
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPresent.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE: the presentation pass of the native Metal 4 renderer, shared with its host test.
+//
+// The display buffer is converted exactly as the Vulkan renderer's upload_image_simple does: each
+// big-endian A8R8G8B8 word is stored as a native u32, i.e. BGRA8 bytes in memory. The pass draws a
+// quad covering `rect` (normalized device coordinates) that samples it; alpha is not shown.
+
+#include "util/types.hpp"
+
+#include <algorithm>
+#include <bit>
+#include <cstring>
+#include <string_view>
+
+namespace mtl::present_pass
+{
+	constexpr std::string_view vertex_function = "present_vertex";
+	constexpr std::string_view fragment_function = "present_fragment";
+
+	constexpr std::string_view source = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct present_vertex_out
+{
+	float4 position [[position]];
+	float2 uv;
+};
+
+vertex present_vertex_out present_vertex(uint vid [[vertex_id]], constant float4& rect [[buffer(0)]])
+{
+	const float2 corner = float2((vid & 1u) ? 1.0 : 0.0, (vid & 2u) ? 1.0 : 0.0);
+	present_vertex_out out;
+	out.position = float4(mix(rect.x, rect.z, corner.x), mix(rect.y, rect.w, corner.y), 0.0, 1.0);
+	out.uv = float2(corner.x, 1.0 - corner.y);
+	return out;
+}
+
+fragment float4 present_fragment(present_vertex_out in [[stage_in]], texture2d<float> image [[texture(0)]], sampler image_sampler [[sampler(0)]])
+{
+	return float4(image.sample(image_sampler, in.uv).rgb, 1.0);
+}
+)";
+
+	static_assert(std::endian::native == std::endian::little, "the BGRA8 byte order below assumes a little-endian host");
+
+	// One row of big-endian A8R8G8B8 guest words to native u32 values (BGRA8 bytes on little-endian hosts).
+	inline void convert_row(const u8* guest_row, u32* destination, u32 width) noexcept
+	{
+		for (u32 column = 0; column < width; ++column)
+		{
+			u32 word;
+			std::memcpy(&word, guest_row + static_cast<usz>(column) * 4, 4);
+			destination[column] = __builtin_bswap32(word);
+		}
+	}
+
+	// The quad that fits a source of the given size in the target, keeping its aspect ratio.
+	struct rectangle
+	{
+		f32 left = 0, bottom = 0, right = 0, top = 0;
+	};
+
+	inline rectangle fit(u32 source_width, u32 source_height, u32 target_width, u32 target_height) noexcept
+	{
+		if (!source_width || !source_height || !target_width || !target_height)
+		{
+			return {};
+		}
+
+		const f64 scale = std::min(static_cast<f64>(target_width) / source_width, static_cast<f64>(target_height) / source_height);
+		const f32 half_width = static_cast<f32>(source_width * scale / target_width);
+		const f32 half_height = static_cast<f32>(source_height * scale / target_height);
+		return {-half_width, -half_height, half_width, half_height};
+	}
+}
diff --git a/rpcs3/Emu/System.cpp b/rpcs3/Emu/System.cpp
index a0cf14d..8772353 100644
--- a/rpcs3/Emu/System.cpp
+++ b/rpcs3/Emu/System.cpp
@@ -2160,6 +2160,8 @@ game_boot_result Emulator::Load(const std::string& title_id, bool is_disc_patch,
