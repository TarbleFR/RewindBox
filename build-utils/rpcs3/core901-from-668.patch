+	RBX_METAL4 object compile_library(const object& compiler, std::string_view source, std::string& error)
+	{
+		@autoreleasepool
+		{
+			MTLCompileOptions* options = [[MTLCompileOptions alloc] init];
+			// The RSX shaders depend on IEEE behaviour (NaN, infinities, signed zero): no fast math.
+			options.mathMode = MTLMathModeSafe;
+			MTL4LibraryDescriptor* desc = [[MTL4LibraryDescriptor alloc] init];
+			desc.source = string(source);
+			desc.options = options;
+			NSError* failure = nil;
+			const id<MTLLibrary> library = [as<id<MTL4Compiler>>(compiler) newLibraryWithDescriptor:desc error:&failure];
+			if (!library)
+			{
+				error = describe(failure);
+			}
+			return keep(library);
+		}
