+	device_info query_device(const object& device)
+	{
+		@autoreleasepool
+		{
+			const id<MTLDevice> metal = as<id<MTLDevice>>(device);
+			device_info info;
+			if (!metal)
+			{
+				return info;
+			}
+
+			const char* name = metal.name.UTF8String;
+			info.name = name ? name : "";
+			info.registry_id = metal.registryID;
+			info.max_buffer_length = metal.maxBufferLength;
+			info.unified_memory = metal.hasUnifiedMemory;
+			info.apple7 = [metal supportsFamily:MTLGPUFamilyApple7];
+			info.apple8 = [metal supportsFamily:MTLGPUFamilyApple8];
+			info.apple9 = [metal supportsFamily:MTLGPUFamilyApple9];
+			if (@available(iOS 16.4, macOS 11.0, *))
+			{
+				info.bc_texture_compression = metal.supportsBCTextureCompression;
+			}
+#if TARGET_OS_OSX
+			info.depth24_stencil8 = metal.depth24Stencil8PixelFormatSupported;
+#endif
+			if (@available(iOS 26.0, macOS 26.0, *))
+			{
+				info.metal4 = [metal supportsFamily:MTLGPUFamilyMetal4];
+			}
+			return info;
+		}
+	}
