+// REWINDBOX_ZCULL_SLOT_WAKE_636: the pause of a guest that waits for its report slot (50-400 us between
+// two requests, REWINDBOX_ZCULL_ASYNC_READS_630) ends when the RSX thread releases a slot, instead of
+// running to its end while that slot is already final. The guest checks its own slot again and asks
+// again only as before: on its slot released or on the end of its pause. Same values, same requests.
+class slot_release_signal
+{
+	std::mutex m_mutex;
+	std::condition_variable m_cv;
+	std::atomic<std::uint64_t> m_epoch{0};
+	std::atomic<std::uint32_t> m_waiters{0};
+
+public:
+	std::uint64_t epoch() const noexcept
+	{
+		return m_epoch.load();
+	}
+
+	// RSX thread, after a slot of a locked page lost a pending report (outside the pages mutex).
+	void released() noexcept
+	{
+		m_epoch.fetch_add(1);
+
+		if (m_waiters.load())
+		{
+			std::lock_guard lock(m_mutex);
+			m_cv.notify_all();
+		}
+	}
+
+	// Guest thread: returns once the epoch differs from `seen`, or after `us`. Sequentially consistent
+	// epoch/waiter accesses: a release either sees this waiter or happens before its check.
+	void wait(std::uint64_t seen, std::uint64_t us) noexcept
+	{
+		m_waiters.fetch_add(1);
+		{
+			std::unique_lock lock(m_mutex);
+			m_cv.wait_for(lock, std::chrono::microseconds(us), [&]() { return m_epoch.load() != seen; });
+		}
+		m_waiters.fetch_sub(1);
+	}
+};
+
+inline slot_release_signal& slot_releases() noexcept
+{
+	static slot_release_signal s_signal;
+	return s_signal;
+}
