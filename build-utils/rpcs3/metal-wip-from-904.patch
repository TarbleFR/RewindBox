 }
+
+#ifdef RPCS3_IOS
+// M5: the iOS ZCULL hooks of VKGSRender (RSXZCULL.h, ios/IOSZcullWatched.h).
+
+u64 MTLGSRender::ios_open_cb_serial(rsx::reports::occlusion_query_info* query)
+{
+	// VKGSRender::ios_open_cb_serial: the open command buffer's serial while the query has host queries in it, under
+	// the condition on which sync_hint(zcull_sync) submits it (cb_has_occlusion_task, is_current, indices); 0
+	// otherwise. The recording fence is the command buffer's serial.
+	const auto& record = m_query_records[query->driver_handle];
+	const u64 recording = m_commands.last_submitted() + 1;
+	return (m_commands.recording() && m_query_cb_fence == recording && record.has_data && record.last_fence == recording) ? recording : 0;
+}
+
+rpcs3::ios::zcull_watched::arm_result MTLGSRender::ios_arm_watched_submit(rsx::reports::occlusion_query_info* query)
+{
+	// VKGSRender::ios_arm_watched_submit. Metal has no other early submission (CELL561), so an armed one is always
+	// a watched one; the per-frame cap and the frame's watched budget are the same.
+	namespace early = rpcs3::ios::early_submit;
+	namespace watched = rpcs3::ios::zcull_watched;
+	if (!early::enabled.load(std::memory_order_relaxed) || !early::at_pass_boundary.load(std::memory_order_relaxed))
+	{
+		return watched::arm_result::off;
+	}
+
+	if (!ios_open_cb_serial(query))
+	{
+		return watched::arm_result::submitted;
+	}
+
+	if (m_ios_armed_draws)
+	{
+		return watched::arm_result::joined;
+	}
+
+	if (m_ios_early_submits_this_frame >= early::max_per_frame || !m_ios_watched_budget.available(int_flip_index))
+	{
+		return watched::arm_result::capped;
+	}
+
+	m_ios_armed_draws = 1;
+	early::armed.fetch_add(1, std::memory_order_relaxed);
+	return watched::arm_result::armed;
+}
+
+void MTLGSRender::ios_watched_submit_at_boundary(bool after_textures)
+{
+	// VKGSRender::ios_early_submit_at_boundary: taken when no render pass is open and the recording is interruptible.
+	namespace early = rpcs3::ios::early_submit;
+	if (!m_ios_armed_draws)
+	{
+		return;
+	}
+
+	const bool pass_open = m_commands.kind() == mtl::command_context::encoder_kind::render;
+	if (!early::take_at_boundary(m_ios_armed_draws, pass_open, !m_offloader_deadlock))
+	{
+		return;
+	}
+
+	(after_textures ? early::boundary_textures : early::boundary_starts).fetch_add(1, std::memory_order_relaxed);
+	m_ios_watched_budget.consume();
+	auto& tally = rpcs3::ios::zcull_watched::counters();
+	(after_textures ? tally.taken_textures : tally.taken_start).fetch_add(1, std::memory_order_relaxed);
+	ios_take_watched_submit();
+}
+
+void MTLGSRender::ios_watched_submit_at_draw_end()
+{
+	// VKGSRender::ios_early_submit, the armed part: after max_deferred_draws more draws, at the end of a draw.
+	namespace early = rpcs3::ios::early_submit;
+	if (!m_ios_armed_draws || m_offloader_deadlock)
+	{
+		return;
+	}
+
+	if (early::at_draw_end(++m_ios_armed_draws) != early::deferral::fallback)
+	{
+		return;
+	}
+
+	early::fallback_submits.fetch_add(1, std::memory_order_relaxed);
+	m_ios_watched_budget.consume();
+	rpcs3::ios::zcull_watched::counters().fallback.fetch_add(1, std::memory_order_relaxed);
+	ios_take_watched_submit();
+}
+
+void MTLGSRender::ios_take_watched_submit()
+{
+	// VKGSRender::ios_take_early_submit
+	m_ios_armed_draws = 0;
+	flush_command_queue(false);
+	m_ios_early_submits_this_frame++;
+	rpcs3::ios::early_submit::submits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void MTLGSRender::ios_on_submit()
+{
+	// VKGSRender::flush_command_queue: any other submission carries the armed draws, and with them a watched report.
+	if (m_ios_armed_draws)
+	{
+		m_ios_armed_draws = 0;
+		rpcs3::ios::early_submit::disarmed.fetch_add(1, std::memory_order_relaxed);
+		rpcs3::ios::zcull_watched::counters().carried.fetch_add(1, std::memory_order_relaxed);
+	}
+}
+#endif
