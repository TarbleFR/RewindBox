diff --git a/rpcs3/ios/IOSWriterLockPhases.h b/rpcs3/ios/IOSWriterLockPhases.h
new file mode 100644
index 0000000..f9df30e
--- /dev/null
+++ b/rpcs3/ios/IOSWriterLockPhases.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+#include "IOSShardedCounter931.h"
+
+// REWINDBOX_WRITER_LOCK_PHASES_908: Black Ops II (BLES01717), IPA 694 device log, RANGELOCKPROF
+// wl_putllc=38814:229.833:0.956 (count:acquire_ms:hold_ms): an SPU PUTLLC that takes the heavyweight writer
+// lock waits about 5.9 us to acquire it and holds it 0.025 us. The acquisition has three phases (vm.cpp,
+// vm::writer_lock): the range-lock bit of the writer (bits), the range locks of other threads over the line
+// (ranges), and every running PPU thread reaching cpu_flag::wait after cpu_flag::memory (park). Counted for the
+// SPU PUTLLC source only, reported in RANGELOCKPROF as wl_putllc_phases=bits_ms:ranges_ms:park_ms,
+// wl_putllc_flagged (PPU threads asked to park), wl_putllc_slow_parks (parks over 50 us) and
+// wl_putllc_park_max_us. Measurement only: the lock protocol is unchanged.
+namespace rpcs3::ios::writer_lock_phases
+{
+// REWINDBOX_HOT_COUNTERS_931 (IOSShardedCounter931.h): one line per thread instead of six shared atomics.
+enum field_index : std::size_t { bits_field, ranges_field, park_field, flagged_field, slow_field, park_max_field, field_count };
+
+struct counters_t
+{
+	sharded::block<field_count> data{};
+	sharded::field<field_count> bits_ticks{&data, bits_field}, ranges_ticks{&data, ranges_field}, park_ticks{&data, park_field};
+	sharded::field<field_count> flagged{&data, flagged_field}, slow_parks{&data, slow_field};
+	sharded::field<field_count, true> park_max_ticks{&data, park_max_field};
+};
+
+inline counters_t counters;
+
+inline void record(std::uint64_t bits, std::uint64_t ranges, std::uint64_t park, std::uint64_t flagged, std::uint64_t slow_threshold) noexcept
+{
+	const std::size_t shard = sharded::shard_index();
+	counters.data.add_at(shard, bits_field, bits);
+	counters.data.add_at(shard, ranges_field, ranges);
+	counters.data.add_at(shard, park_field, park);
+	counters.data.add_at(shard, flagged_field, flagged);
+	if (park > slow_threshold)
+	{
+		counters.data.add_at(shard, slow_field, 1);
+	}
+	counters.data.raise_at(shard, park_max_field, park);
+}
+
+using sharded::take;
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::writer_lock_phases
diff --git a/rpcs3/ios/IOSWriterLockRecord931.h b/rpcs3/ios/IOSWriterLockRecord931.h
new file mode 100644
index 0000000..320abba
--- /dev/null
+++ b/rpcs3/ios/IOSWriterLockRecord931.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+#include "IOSWriterLockPhases.h"
+#include "IOSWriterParkSpin917.h"
+
+// REWINDBOX_WRITER_RECORD_AFTER_RELEASE_931: vm::writer_lock's constructor recorded the phases of an SPU PUTLLC lock
+// (REWINDBOX_WRITER_LOCK_PHASES_908, REWINDBOX_WRITER_PARK_SPIN_917) after its park loop, so while every PPU thread
+// was still parked behind the lock; CELL536 already publishes the lock's own counters after the release for that
+// reason ("Profiling must not keep guest PPU threads parked"). The constructor now keeps the measured phases in a
+// thread-local slot, and rpcs3::ios::record_writer_lock, which the destructor calls after releasing the lock on the
+// same thread, publishes them. Same values, same counters, same report; only the moment of the adds moves.
+namespace rpcs3::ios::writer_lock_record
+{
+struct pending_t
+{
+	std::uint64_t bits = 0, ranges = 0, park = 0, flagged = 0, slow_threshold = 0, ticks_per_second = 0;
+	bool budget_spent = false;
+	bool valid = false;
+};
+
+inline thread_local pending_t pending{};
+
+// Constructor of an SPU PUTLLC writer lock, after its park loop: keep the measured phases.
+inline void defer(std::uint64_t bits, std::uint64_t ranges, std::uint64_t park, std::uint64_t flagged, std::uint64_t slow_threshold,
+	std::uint64_t ticks_per_second, bool budget_spent) noexcept
+{
+	pending_t& slot = pending;
+	slot.bits = bits;
+	slot.ranges = ranges;
+	slot.park = park;
+	slot.flagged = flagged;
+	slot.slow_threshold = slow_threshold;
+	slot.ticks_per_second = ticks_per_second;
+	slot.budget_spent = budget_spent;
+	slot.valid = true;
+}
+
+// After the release, on the thread that held the lock: publish what the constructor kept, if anything.
+inline bool flush() noexcept
+{
+	pending_t& slot = pending;
+
+	if (!slot.valid)
+	{
+		return false;
+	}
+
+	slot.valid = false;
+	writer_lock_phases::record(slot.bits, slot.ranges, slot.park, slot.flagged, slot.slow_threshold);
+	writer_park::record_park(slot.park, slot.ticks_per_second, slot.budget_spent);
+	return true;
+}
+} // namespace rpcs3::ios::writer_lock_record
diff --git a/rpcs3/ios/IOSWriterParkSpin917.h b/rpcs3/ios/IOSWriterParkSpin917.h
new file mode 100644
index 0000000..c440d2c
--- /dev/null
+++ b/rpcs3/ios/IOSWriterParkSpin917.h
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+#include "IOSShardedCounter931.h"
+
+// REWINDBOX_WRITER_PARK_SPIN_917: how a writer waits for the PPU threads to park, and what the park costs.
+//
+// A data-changing PUTLLC with Accurate SPU Reservations takes vm::writer_lock: it publishes its exclusive bit, asks
+// every running PPU thread to park (cpu_flag::memory) and waits until each one shows cpu_flag::wait; while its bit is
+// set no PPU thread runs guest code. Call of Duty: Black Ops II in play, build 676 (PID 25658, session 3, windows 9 to
+// 17): 1.08 to 1.60 million such locks per 5 s window, 2.4 to 2.9 s of SPU thread time per window spent acquiring
+// them (1.8 to 2.5 us per lock) against 13 to 19 ms holding them, and 20 to 26 frames per second with no thread
+// saturated. God of War III, build 718 (session 5, window 16): 4,484 locks, the park phase 1.36 us per lock.
+//
+// The wait (vm.cpp, reservation_lock_wait) spins 128 iterations of the CPU's yield hint, a fraction of a
+// microsecond, then hands the core off with a system call (thread_switch) every 32 iterations. A PPU thread that
+// runs compiled code parks at its next block; one that is inside a host function (a system call of the guest, a
+// reservation helper) parks when it returns, which takes about as long as those 128 iterations or longer: the writer
+// then pays a hand-off although the thread it waits for is running, and may lose its core while its exclusive bit
+// keeps every PPU thread parked.
+//
+// With the lever on, the writer spins for `spin_budget_ns` before its first hand-off. The budget is a few times the
+// park phase measured above, so a PPU thread that is running parks within it; a PPU thread that is not on a core
+// still gets the hand-offs, at the same cadence, one budget later (against the 50 us and more such a park costs).
+// What the writer waits for is unchanged: every PPU thread parked before it stores, the lock held as before.
+namespace rpcs3::ios::writer_park
+{
+inline std::atomic<bool> spin_enabled{false};
+
+constexpr std::uint64_t spin_budget_ns = 8'000;
+// The clock is read at the first wait iteration and then every `clock_interval` iterations.
+constexpr std::uint64_t clock_interval = 16;
+
+struct waiter
+{
+	std::uint64_t begin = 0;
+	std::uint64_t steps = 0;
+	bool spent = false; // the budget is over: the caller's previous wait applies from here on
+
+	// One wait iteration. True: spin (the caller gives the CPU its hint and tests its condition again). False: the
+	// lever is off or the budget is over; the caller waits as before. `now()` is a monotonic clock in the unit of
+	// `budget`; it is not read by a wait that never happens.
+	// `interval`: REWINDBOX_THERMAL_POLICY_931 passes 1 when each iteration is an exclusive-monitor wait, whose length
+	// is not a few nanoseconds, so the budget is kept to the same clock time.
+	template <typename Clock>
+	bool spin(bool enabled, std::uint64_t budget, Clock&& now, std::uint64_t interval = clock_interval) noexcept
+	{
+		if (!enabled || spent)
+		{
+			return false;
+		}
+
+		if (!steps)
+		{
+			begin = now();
+		}
+		else if ((steps % interval) == 0 && now() - begin >= budget)
+		{
+			spent = true;
+			return false;
+		}
+
+		steps++;
+		return true;
+	}
+};
+
+// The park phase of the SPU PUTLLC writer locks of a report window, by duration.
+constexpr std::size_t buckets = 8;
+// Upper bounds in nanoseconds; the last bucket has none.
+constexpr std::uint64_t bucket_upper_ns[buckets - 1] = {500, 1'000, 2'000, 4'000, 8'000, 16'000, 50'000};
+
+constexpr std::size_t bucket_of(std::uint64_t park_ns) noexcept
+{
+	std::size_t index = 0;
+
+	while (index < buckets - 1 && park_ns >= bucket_upper_ns[index])
+	{
+		index++;
+	}
+
+	return index;
+}
+
+// REWINDBOX_HOT_COUNTERS_931 (IOSShardedCounter931.h): the writer's fields and the PPU threads' fields each keep one
+// line per thread instead of shared atomics (27 PPU threads leave a park together at the end of each writer lock).
+enum writer_field : std::size_t { slow_field = buckets, over_budget_field, writer_field_count };
+enum ppu_field : std::size_t { ppu_parks_field, ppu_park_ticks_field, main_parks_field, main_park_ticks_field, ppu_field_count };
+
+template <std::size_t... I>
+constexpr std::array<sharded::field<writer_field_count>, buckets> histogram_fields(sharded::block<writer_field_count>* owner, std::index_sequence<I...>) noexcept
+{
+	return {sharded::field<writer_field_count>{owner, I}...};
+}
+
+struct counters_t
+{
+	sharded::block<writer_field_count> writer{};
+	sharded::block<ppu_field_count> ppu{};
+	std::array<sharded::field<writer_field_count>, buckets> histogram = histogram_fields(&writer, std::make_index_sequence<buckets>{});
+	sharded::field<writer_field_count> slow_ticks{&writer, slow_field};   // the time of the parks of the last bucket (50 us and more)
+	sharded::field<writer_field_count> over_budget{&writer, over_budget_field}; // locks whose wait outlasted the spin budget (lever on)
+	// A PPU thread inside vm::passive_lock's wait (spin and timed waits): every PPU thread, and the first one.
+	sharded::field<ppu_field_count> ppu_parks{&ppu, ppu_parks_field}, ppu_park_ticks{&ppu, ppu_park_ticks_field};
+	sharded::field<ppu_field_count> main_parks{&ppu, main_parks_field}, main_park_ticks{&ppu, main_park_ticks_field};
+};
+
+inline counters_t counters;
+
+inline void record_park(std::uint64_t park_ticks, std::uint64_t ticks_per_second, bool budget_spent) noexcept
+{
+	const std::uint64_t park_ns = ticks_per_second == 1'000'000'000 ? park_ticks :
+		ticks_per_second ? static_cast<std::uint64_t>(static_cast<double>(park_ticks) * 1e9 / static_cast<double>(ticks_per_second)) : 0;
+	const std::size_t bucket = bucket_of(park_ns);
+	const std::size_t shard = sharded::shard_index();
+	counters.writer.add_at(shard, bucket, 1);
+
+	if (bucket == buckets - 1)
+	{
+		counters.writer.add_at(shard, slow_field, park_ticks);
+	}
+
+	if (budget_spent)
+	{
+		counters.writer.add_at(shard, over_budget_field, 1);
+	}
+}
+
+inline void record_ppu_park(bool first_ppu_thread, std::uint64_t ticks) noexcept
+{
+	const std::size_t shard = sharded::shard_index();
+	counters.ppu.add_at(shard, ppu_parks_field, 1);
+	counters.ppu.add_at(shard, ppu_park_ticks_field, ticks);
+
+	if (first_ppu_thread)
+	{
+		counters.ppu.add_at(shard, main_parks_field, 1);
+		counters.ppu.add_at(shard, main_park_ticks_field, ticks);
+	}
+}
+
+// REWINDBOX_PARK_SPIN_COMPARE_917 and REWINDBOX_BUSY_WAIT_REFERENCE_918: one export holds every side of the levers
+// in the same scene.
+//
+// What the spin budget and the busy wait scale are worth depends on the iPhone's scheduler and cannot be measured on
+// a host. With a lever's setting on Automatic, the 5 s report turns it off and on again between its windows, over
+// the running windows that showed frames: the first `lead` of a boot keep both on (the captures the report asks for
+// run there), then `compared` windows go by pairs through the four combinations (spin off, scale on), (spin on,
+// scale 1), (both off), (both on), twice; then `rest` windows with both on, and the same again, `cycles` times per
+// boot, so that a pass falls inside play whatever the time spent in menus. After that both stay on. Every side is
+// exact: off is the wait of Core 916 and the scale 1 iOS had. The park spin only alternates in a window that counted
+// at least `bound_heavy` heavy PUTLLC (elsewhere no writer lock waits and it stays on). RANGELOCKPROF prints
+// park_spin= and COREPROF SCHED918 busy_wait_scale= for the window they report; COREPROF PARKCMP917 prints each step.
+// With a setting Enabled or Disabled its lever never alternates.
+// REWINDBOX_LEVER_COMPARISON_ON_REQUEST_920: Cores 917 to 919 ran these passes whenever a lever's setting was Automatic,
+// the default, so a player played parts of the first ten minutes of every boot with a lever off. They now run only when
+// Lever Comparison Between Report Windows is Enabled (a diagnostic asked for on purpose); `allowed` and
+// `busy_wait_allowed` are false otherwise and both levers stay as their settings say.
+namespace compare
+{
+inline std::atomic<bool> allowed{false};           // the park spin setting is Automatic
+inline std::atomic<bool> busy_wait_allowed{false}; // the busy wait setting is Automatic, SPU Spin Timing is Reference
+inline std::atomic<std::uint64_t> busy_wait_scale_on{1}; // the scale the boot policy installed; 1 is the previous one
+inline std::atomic<bool> event_waits_allowed{false}; // REWINDBOX_THERMAL_POLICY_931: Event Waits When Hot is Automatic
+inline std::atomic<int> event_waits_forced{-1};      // REWINDBOX_THERMAL_POLICY_931: inside a step 0 off, 1 on; otherwise -1
+
+// The levers a PARKCMP917 line compares (REWINDBOX_THERMAL_POLICY_931 adds the event waits).
+constexpr const char* compared_name(bool spin, bool busy, bool events) noexcept
+{
+	return spin && busy && events ? "park_spin+busy_wait+event_waits" : spin && busy ? "park_spin+busy_wait" :
+		spin && events ? "park_spin+event_waits" : busy && events ? "busy_wait+event_waits" : spin ? "park_spin" : busy ? "busy_wait" :
+		events ? "event_waits" : "none";
+}
+
+inline constexpr std::uint64_t bound_heavy = 100'000; // heavy PUTLLC per report window: the bound of IOSAutoStorm917.h
+inline constexpr std::uint32_t lead = 6;
+inline constexpr std::uint32_t period = 2;
+inline constexpr std::uint32_t compared = 16;
+inline constexpr std::uint32_t rest = 22;
+inline constexpr std::uint32_t cycles = 3;
+
+// The levers of a step of a pass (1 to `compared`); step 0 is outside a pass: both on.
+constexpr bool park_spin_at(std::uint32_t step) noexcept
+{
+	return !step || ((step - 1) / period) % 2 != 0;
+}
+
+constexpr bool busy_wait_at(std::uint32_t step) noexcept
+{
+	const std::uint32_t pair = step ? ((step - 1) / period) % 4 : 3;
+	return pair == 0 || pair == 3;
+}
+
+// REWINDBOX_THERMAL_POLICY_931: the event waits are off for the first half of a pass and on for the second half, so with
+// the two levers above a pass of `compared` windows holds each of the eight combinations for `period` windows.
+constexpr bool event_waits_at(std::uint32_t step) noexcept
+{
+	return !step || ((step - 1) / (period * 4)) % 2 != 0;
+}
+
+struct tracker
+{
+	std::uint64_t session = ~0ull;
+	std::uint32_t windows = 0;       // running windows with frames reported in this boot, counted up to the last pass
+	std::uint32_t decided_step = 0;  // the step the levers of the next window follow; 0: both on
+	std::uint32_t decided_cycle = 0; // the pass that step belongs to (1 to `cycles`); 0 outside a pass
+	bool decided_storm = false;      // the window just reported counted at least `bound_heavy` heavy PUTLLC
+
+	// The pass and the step of the next counted window.
+	constexpr std::uint32_t upcoming_cycle() const noexcept
+	{
+		if (windows < lead)
+		{
+			return 0;
+		}
+
+		const std::uint32_t after_lead = windows - lead;
+		const std::uint32_t pass = after_lead / (compared + rest);
+		return pass < cycles && after_lead % (compared + rest) < compared ? pass + 1 : 0;
+	}
+
+	constexpr std::uint32_t upcoming_step() const noexcept
+	{
+		return upcoming_cycle() ? (windows - lead) % (compared + rest) + 1 : 0;
+	}
+
+	// One call per report window, after the window was reported. Returns the park spin of the next window; the busy
+	// wait scale of the next window is busy_wait_at(decided_step).
+	constexpr bool next(std::uint64_t now_session, bool running, std::uint64_t guest_flips, std::uint64_t heavy_putllc) noexcept
+	{
+		if (now_session != session)
+		{
+			session = now_session;
+			windows = 0;
+		}
+
+		if (!running || !guest_flips)
+		{
+			decided_step = 0;
+			decided_cycle = 0;
+			decided_storm = false;
+			return true;
+		}
+
+		if (windows < lead + cycles * (compared + rest))
+		{
+			windows++;
+		}
+
+		decided_cycle = upcoming_cycle();
+		decided_step = upcoming_step();
+		decided_storm = heavy_putllc >= bound_heavy;
+		return !decided_storm || park_spin_at(decided_step);
+	}
+};
+} // namespace compare
+} // namespace rpcs3::ios::writer_park
diff --git a/rpcs3/ios/IOSZcullLabelPage.h b/rpcs3/ios/IOSZcullLabelPage.h
new file mode 100644
index 0000000..0d8ecea
--- /dev/null
+++ b/rpcs3/ios/IOSZcullLabelPage.h
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_ZCULL_LABEL_PAGE_624: Build 622 logs (PID 1459, Assassin's Creed, session 3):
+// the ZCULL on-demand lever served 411 GCM label reads and 33 report reads in one
+// window, the guest thread TaskThread1 waited 422/469/456 ms in three seconds and the
+// lever tripped (wait_budget); the rest of the boot ran the upstream mode, 2,400-2,900
+// ZCULL syncs and 4.1-4.3 s of the RSX thread blocked per 5 s window, 13-17 FPS.
+// The labels (offset 0x0000) and notify slots (0x1000) of the RSX reports block share
+// the first host page with reports 0-703 (0x1400): with 16 KiB host pages every label
+// poll of the game faulted whenever one of those reports was pending, and each fault
+// wrote every claimed report. lv2 returns the block's address to the game
+// (sys_rsx_context_allocate, lpar_reports); every RSX, GCM and ZCULL address derives
+// from it. Placing the block so that its report array begins on a host page leaves the
+// labels and notify slots on a page that never holds a report: a label read never
+// waits, a report read still waits for its value. The PS3 layout of the block
+// (labels, notify, reports and their offsets in RsxDriverInfo) is unchanged.
+namespace rpcs3::ios::zcull_label_page
+{
+// The shift lv2 applied to the reports block of the running boot (0 without the lever),
+// for the COREPROF ZCULL624 line.
+inline std::atomic<std::uint32_t> g_applied_shift{0};
+
+// The offset to add to the block's address so that `report_offset` lands on a page
+// boundary of `page_size` bytes (0 when it already does, or for a page size that is
+// not a power of two).
+constexpr std::uint32_t offset(std::uint32_t report_offset, std::uint32_t page_size) noexcept
+{
+	if (page_size == 0 || (page_size & (page_size - 1)) != 0)
+	{
+		return 0;
+	}
+
+	const std::uint32_t remainder = report_offset % page_size;
+	return remainder ? page_size - remainder : 0;
+}
+}
+
+// REWINDBOX_ZCULL_COND_PREVIOUS_624: Build 622 logs (Black Ops II multiplayer): the RSX
+// thread waited for the occlusion result of a conditional render 112-123 times per 5 s
+// window, 0.9-1.2 s in all (8-10 ms each), on top of the forced report passes. MoltenVK
+// has no conditional rendering, so RPCS3 waits on the CPU for the GPU to finish the
+// query that predicates the draws. With the ZCULL on-demand lever, when that query is
+// still on the GPU and the report it writes already holds a non-zero value (the object
+// was visible at its previous evaluation), the draws are emitted now instead of
+// waiting; a report holding 0 still waits, so an object the game would show is never
+// hidden. An object hidden in this frame but visible in the previous one is drawn one
+// evaluation longer, behind whatever hides it.
+//
+// REWINDBOX_ZCULL_COND_NO_WAIT_627: Build 624 logs (PID 1893, Black Ops II, session 2):
+// 841-1,002 evaluations per window drew on the previous value, and the 88-120 that found a
+// report holding 0 still took 1.3-2.6 s of the RSX thread per window, 13-26 ms each: the
+// largest ZCULL cost left, at 28 % GPU occupancy. For a depth-tested draw, skipping is only an
+// optimization: a conditional render asks to leave out an object that its query found hidden,
+// and drawing it anyway leaves it hidden behind what hides it, at the price of its GPU time.
+// So with the setting, a query still on the GPU never waits for such a draw (`no_wait`),
+// whatever its report holds. A draw the depth test cannot hide (a flare or corona over the
+// scene) keeps the 624 rule: a report holding 0 waits, or the effect would show through walls.
+// A query already complete is evaluated as before, so an object known to be hidden is skipped.
+namespace rpcs3::ios::zcull_cond_previous
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> previous{0}; // evaluations that drew on the previous visible value
+	std::atomic<std::uint64_t> waited{0};   // evaluations that waited (not ready and report 0)
+	std::atomic<std::uint64_t> ready{0};    // evaluations whose query was already complete
+};
+
+inline counters_t& counters() noexcept
+{
+	static counters_t s_counters;
+	return s_counters;
+}
+
+enum class decision
+{
+	wait,     // wait for the query, as upstream
+	previous, // draw now: the report already shows the object visible
+};
+
+// The decision for a pending evaluation. `ready`: the newest query of the evaluation
+// has its result on the host (check_occlusion_query_status); `report_value`: the value
+// field of the report at the evaluation address (read through the unprotected view);
+// `no_wait`: REWINDBOX_ZCULL_COND_NO_WAIT_627.
+constexpr decision decide(bool lever, bool ready, std::uint32_t report_value, bool no_wait = false) noexcept
+{
+	return (lever && !ready && (report_value != 0 || no_wait)) ? decision::previous : decision::wait;
+}
+}
+
+// REWINDBOX_ZCULL_CONSERVATIVE_627: the mode where no report ever makes anything wait. A
+// queued report is written at once with a value that reads "visible", no page is locked,
+// no label waits, and the GPU result replaces it when the query completes, in the usual
+// update() pass. A guest that reads the report before that gets "visible" and draws the
+// object; one that reads it later gets the real value. It differs from Relaxed ZCULL
+// Sync, which leaves the previous bytes of the slot in place (Assassin's Creed BLES00158,
+// Build 612: torches and lights flickered). Whether a guest can see the difference between
+// "visible" and the real value is a device question: off for every title by default, and
+// the ZCULL On-Demand Reads lever keeps exact values.
+
+// REWINDBOX_ZCULL_FAULT_CENSUS_624: who reaches into a page ZCULL holds locked, for the
+// next reading of the Black Ops II "other" faults (Build 622: 60-120 per window, 885 ms
+// of guest waits, outside the GCM report block): the thread class of every on-demand
+// fault and the last address of an "other" fault. Counting changes no fault handling.
+namespace rpcs3::ios::zcull_fault_census
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> ppu{0};
+	std::atomic<std::uint64_t> spu{0};
+	std::atomic<std::uint32_t> other_last{0};     // guest address of the last "other" fault
+	std::atomic<std::uint32_t> other_last_spu{0}; // 1 when an SPU made it
+};
+
+inline counters_t& counters() noexcept
+{
+	static counters_t s_counters;
+	return s_counters;
+}
+}
diff --git a/rpcs3/ios/IOSZcullOnDemand.h b/rpcs3/ios/IOSZcullOnDemand.h
new file mode 100644
index 0000000..aeb21c1
--- /dev/null
+++ b/rpcs3/ios/IOSZcullOnDemand.h
@@ -0,0 +1,725 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+
+// REWINDBOX_ZCULL_ON_DEMAND_619: Assassin's Creed (BLES00158, BLUS30089), Build
+// 617 iPhone logs (PID 65755, session 1, windows 17-28): 2,203-2,911 waits per
+// 5 s window, 4.15-4.32 s in all, every one of them inside ZCULL_control::sync()
+// (COREPROF ZCULLWAIT616 sync=, all other paths 0), 14-17 FPS. Once a report
+// page holding a pending report is touched, upstream marks the whole location
+// "accessed" for the rest of the boot (disable_optimizations): every report
+// becomes critical and every label write with a pipe flush, WAIT_FOR_IDLE or
+// NOTIFY waits for the GPU to retire all of them, about 33 times per frame.
+// On iOS the host page is 16 KiB: the GCM labels (4 KiB), the notifies (1 KiB)
+// and local reports 0-703 share one page, so the RSX thread's own label read or
+// write is enough to trigger it. With the lever the report pages stay
+// protected; the RSX thread reaches the label area and locked report pages
+// through the unprotected view (ios/IOSRsxLabelAccess.h); a PPU/SPU access to
+// a page that still holds a pending report asks the RSX thread to write every
+// claimed report (the writes sync() does), waits for them, then unprotects the
+// page. The guest reads the same values; the labels no longer wait. A request
+// not picked up within 2 s, sustained guest waits (below) or more than 1,000
+// services per second return the boot to the upstream mode. Title scoped
+// (ios/IOSTitleLevers.h).
+//
+// REWINDBOX_ZCULL_DEMAND_GUARD_621: Build 620 logs (PID 66957, Assassin's Creed,
+// session 3): the lever served the menus, then at the first gameplay second it
+// served 54 label reads, 401.5 ms of guest waits against the 619 budget of
+// 400 ms in one second (max 23.9 ms), and tripped. The rest of the boot ran the
+// upstream mode it falls back to: 2,100-2,900 GPU syncs and 3.4-4.3 s of the
+// RSX thread blocked per 5 s window, 14-18 FPS. One busy second is not a reason
+// to take the more expensive path for the whole boot. A guest thread now trips
+// the lever when it waits more than 400 ms in each of 3 consecutive seconds, or
+// more than 900 ms over at least 16 waits in one second (a fault storm, not one
+// long wait behind a pipeline compile on the RSX thread); all guest
+// threads together trip it above 800 ms in each of 3 consecutive seconds (the
+// upstream mode cost the RSX thread 0.68-0.86 s per second in the same session).
+// The trip is recorded with its windows (trip_detail) for the COREPROF
+// ZCULLTRIP621 line; the pickup and service halves of each wait are counted.
+// Seconds are fixed one-second buckets of the clock: each wait adds to every
+// bucket it overlaps the part it overlaps, so a thread blocked in waits longer
+// than a second is counted in each second it is blocked (a review of the first
+// 621 rule found that waits more than 2 s apart never tripped), and a wait
+// that began in an earlier second adds nothing to the next one. The storm rule
+// counts at most 100 ms of each wait, so one long wait behind a pipeline
+// compile followed by ordinary reads is not a storm.
+//
+// REWINDBOX_ZCULL_WAIT_GUARD_627: Build 624 logs (PID 1893). With the labels on their own
+// page (624) the lever served only real report reads: Assassin's Creed window 9, 99 reads,
+// 9.6 ms each (0.02 ms pickup), the RSX thread blocked 0.95 s of 5 s, 57 FPS at 18 draws per frame. TaskThread1 then
+// waited 548/564/610 ms in three seconds and the lever tripped; the rest of the boot ran the
+// upstream mode: 2,000-2,700 syncs and 4.0-4.3 s of the RSX thread per 5 s window, 12-20 FPS in
+// the heavy scenes. The same trip happened in Black Ops II multiplayer (thread Backend,
+// 449/538/638 ms) and on Builds 620 and 622. A guest thread that reads a report has to wait
+// for the GPU in either mode: upstream makes it wait for the label instead, behind an RSX
+// thread blocked at every label. The wait budgets compare a guest thread against nothing that
+// the fallback improves, so for the lever's titles they no longer trip it. The storm rule and
+// the pickup and hard deadlines stay: they are the protection against a lever that does
+// not work. The ZCULL On-Demand Wait Guard setting restores the 621 rules (A/B test).
+//
+// REWINDBOX_ZCULL_ASYNC_READS_630: Build 629 logs (PID 3616, Core 627). The lever no longer trips,
+// and it changed nothing in the heavy scenes of Assassin's Creed: 19 FPS, 614-875 guest reads per
+// window, each one blocked 5-7 ms, 4.4 s of TaskThread1 per 5 s. One read cost 3.6 services
+// (2,238-2,640 per window, 1.9 ms each, one Metal command buffer each), because a read waits for
+// its whole page: the RSX thread keeps queueing reports on it, so the page is re-armed between the
+// service and the guest's check and the read asks again. Each service writes every claimed report,
+// the newest included, so the RSX, the CPU and the GPU run in series, and every command buffer
+// splits a render pass: 30 ms of GPU per frame at 24 submits, 12 ms at one submit for as many
+// draws. The GPU is busy 60 % of the time, the CPU cores are almost idle.
+// A guest read needs one report, not the page and not the newest draws:
+// - Per-slot pending counts on each locked page (16-byte report slots) say whether the memory the
+//   guest reads is final. When it is, the fault handler completes the access itself and nothing
+//   waits (ios/IOSGuestAccessEmulation.h): a report already written, or other data on the page.
+// - When it is not, the guest asks for that slot: the RSX thread only submits the command buffer
+//   that holds its query, if it is still open, polls the reports that are ready and goes back to
+//   the FIFO. The guest waits for its slot and asks again every few hundred microseconds, which
+//   also wakes a parked RSX thread.
+// An access the handler cannot complete, a page read more than emulation_budget times per
+// emulation_window_us (a fault costs more than a page unlock then) and a read still pending after
+// async_escalate_us take the 619 path: every claimed report, page by page. Values are exact on
+// every path. ZCULL Asynchronous Reads turns it off.
+namespace rpcs3::ios::zcull_on_demand
+{
+inline constexpr std::uint64_t pickup_deadline_us = 2'000'000;  // the RSX thread has not started the request
+inline constexpr std::uint64_t hard_deadline_us = 5'000'000;    // the request never completed
+inline constexpr std::uint64_t window_us = 1'000'000;
+inline constexpr std::uint32_t storm_services = 1'000;          // services per window
+inline constexpr std::uint64_t wait_budget_us = 400'000;        // one guest thread's wait per window (621: sustained)
+inline constexpr std::uint32_t sustained_windows = 3;           // consecutive windows above a budget
+inline constexpr std::uint64_t severe_wait_us = 900'000;        // one guest thread's wait in one window...
+inline constexpr std::uint32_t severe_min_waits = 16;          // ...over at least this many waits (a storm, not one
+                                                                // long wait behind an RSX pipeline compile)
+inline constexpr std::uint64_t global_budget_us = 800'000;      // all guest threads' wait per window (sustained)
+inline constexpr std::uint64_t severe_wait_cap_us = 100'000;    // the part of one wait the storm rule counts
+// REWINDBOX_ZCULL_ASYNC_READS_630
+inline constexpr std::uint64_t async_escalate_us = 30'000;      // a slot not final by then asks for every claimed report
+inline constexpr std::uint64_t async_poll_first_us = 50;        // first pause between two asks for a slot
+inline constexpr std::uint64_t async_poll_max_us = 400;
+inline constexpr std::uint32_t emulation_budget = 512;          // accesses completed by the handler, per page...
+inline constexpr std::uint64_t emulation_window_us = 16'000;    // ...and per window
+inline constexpr std::uint32_t report_slot_bytes = 16;
+inline constexpr std::uint32_t tracked_page_bytes = 16384;
+
+enum class trip_reason : std::uint32_t
+{
+	none = 0,
+	storm = 1,       // more than storm_services services in a window
+	wait_budget = 2, // guest threads waited more than wait_budget_us in a window
+	pickup = 3,      // a request was not picked up in time
+	hard = 4,        // a request picked up but not completed in time
+	wait_severe = 5, // REWINDBOX_ZCULL_DEMAND_GUARD_621: one guest thread blocked most of a window
+};
+
+inline const char* trip_reason_name(std::uint32_t reason) noexcept
+{
+	switch (static_cast<trip_reason>(reason))
+	{
+	case trip_reason::none: return "none";
+	case trip_reason::storm: return "storm";
+	case trip_reason::wait_budget: return "wait_budget";
+	case trip_reason::pickup: return "pickup";
+	case trip_reason::hard: return "hard";
+	case trip_reason::wait_severe: return "wait_severe";
+	}
+	return "other";
+}
+
+// REWINDBOX_ZCULL_DEMAND_GUARD_621: which windows tripped the lever (scope 1: one
+// guest thread, 2: all guest threads, 0: not a wait trip), in microseconds of wait.
+struct trip_detail
+{
+	std::uint32_t reason = 0;
+	std::uint32_t scope = 0;
+	std::uint64_t at_us = 0;
+	std::uint64_t windows_us[sustained_windows]{}; // oldest first; the last one is the window that tripped
+};
+
+// Process-wide counters of COREPROF ZCULLDEMAND619 (taken per window).
+struct tally
+{
+	std::atomic<std::uint64_t> faults_label{0};     // guest access at a label/notify offset of a page with a pending report
+	std::atomic<std::uint64_t> faults_report{0};    // ... at a report offset of the GCM report area
+	std::atomic<std::uint64_t> faults_other{0};     // ... elsewhere (main-memory reports)
+	std::atomic<std::uint64_t> stale{0};            // guest accesses to a page whose reports were all written
+	std::atomic<std::uint64_t> services{0};         // RSX thread: every claimed report written for a request
+	std::atomic<std::uint64_t> waits{0};            // guest waits that ended served or released
+	std::atomic<std::uint64_t> wait_us{0};
+	std::atomic<std::uint64_t> wait_max_us{0};
+	std::atomic<std::uint64_t> timeouts{0};
+	std::atomic<std::uint64_t> stops{0};
+	std::atomic<std::uint64_t> rsx_reads{0};        // RSX copies out of locked report pages, served by writing the reports
+	std::atomic<std::uint64_t> upstream_cell{0};    // upstream disable_optimizations after a PPU/SPU access
+	std::atomic<std::uint64_t> upstream_other{0};   // ... after an access by another thread
+	std::atomic<std::uint64_t> upstream_rsx_read{0};// ... after an RSX copy out of report memory
+	std::atomic<std::uint32_t> tripped{0};          // trip_reason of the current boot
+	// REWINDBOX_ZCULL_DEMAND_GUARD_621: the two halves of a served wait.
+	std::atomic<std::uint64_t> pickups{0};           // waits whose request the RSX thread was seen to pick up
+	std::atomic<std::uint64_t> pickup_us{0};         // request -> picked up by the RSX thread
+	std::atomic<std::uint64_t> pickup_max_us{0};
+	std::atomic<std::uint64_t> service_us{0};        // picked up -> reports written
+	std::atomic<std::uint64_t> service_max_us{0};
+	// REWINDBOX_ZCULL_READ_LEAD_659: for each guest access that finds its report slot pending, how
+	// long before it the RSX thread enqueued the slot's oldest pending report (the time a command
+	// buffer submitted at that report would already have had on the GPU).
+	std::atomic<std::uint64_t> leads{0};
+	std::atomic<std::uint64_t> lead_us{0};
+	std::atomic<std::uint64_t> lead_max_us{0};
+	std::atomic<std::uint64_t> leads_over_wait{0};   // leads of at least lead_reference_us
+	// REWINDBOX_ZCULL_COST_920: for the same accesses, how long before them the slot's newest pending report was
+	// queued: the read waits for that one last, and only a command buffer submitted early enough for it helps. The
+	// watched flush learns a slot when this is at least 1 ms (zcull_watched::min_lead_us).
+	std::atomic<std::uint64_t> newest_leads{0};
+	std::atomic<std::uint64_t> newest_lead_us{0};
+	std::atomic<std::uint64_t> newest_lead_max_us{0};
+	std::atomic<std::uint64_t> newest_leads_over_1ms{0};
+
+	static void raise_max(std::atomic<std::uint64_t>& max_value, std::uint64_t value) noexcept
+	{
+		std::uint64_t max = max_value.load(std::memory_order_relaxed);
+		while (value > max && !max_value.compare_exchange_weak(max, value, std::memory_order_relaxed)) {}
+	}
+
+	void add_wait(std::uint64_t us) noexcept
+	{
+		waits.fetch_add(1, std::memory_order_relaxed);
+		wait_us.fetch_add(us, std::memory_order_relaxed);
+		raise_max(wait_max_us, us);
+	}
+
+	// REWINDBOX_ZCULL_READ_LEAD_659: 15 ms, about the mean guest wait of Assassin's Creed on IPA 657.
+	static constexpr std::uint64_t lead_reference_us = 15000;
+
+	void add_newest_lead(std::uint64_t us) noexcept
+	{
+		newest_leads.fetch_add(1, std::memory_order_relaxed);
+		newest_lead_us.fetch_add(us, std::memory_order_relaxed);
+		raise_max(newest_lead_max_us, us);
+		if (us >= 1000)
+		{
+			newest_leads_over_1ms.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	void add_lead(std::uint64_t us) noexcept
+	{
+		leads.fetch_add(1, std::memory_order_relaxed);
+		lead_us.fetch_add(us, std::memory_order_relaxed);
+		raise_max(lead_max_us, us);
+		if (us >= lead_reference_us)
+		{
+			leads_over_wait.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	void add_halves(std::uint64_t pickup, std::uint64_t service) noexcept
+	{
+		pickups.fetch_add(1, std::memory_order_relaxed);
+		pickup_us.fetch_add(pickup, std::memory_order_relaxed);
+		service_us.fetch_add(service, std::memory_order_relaxed);
+		raise_max(pickup_max_us, pickup);
+		raise_max(service_max_us, service);
+	}
+};
+
+// Wait time per fixed one-second bucket of the clock (index = time / window_us),
+// for the last ring_size buckets. One guest thread's ring is thread_local (its
+// waits are sequential); the all-threads ring is shared under the gate's mutex,
+// where a wait reported late adds to the buckets still in the ring.
+inline constexpr std::uint32_t ring_size = sustained_windows + 1;
+struct wait_bucket
+{
+	std::uint64_t index = ~std::uint64_t{0};  // the bucket held, none at first
+	std::uint64_t waited_us = 0;              // wait time inside the bucket
+	std::uint64_t severe_us = 0;              // the same, at most severe_wait_cap_us per wait
+	std::uint32_t waits = 0;                  // waits that ended in the bucket
+};
+struct wait_ring
+{
+	wait_bucket buckets[ring_size]{};
+	std::uint64_t newest = 0;                 // newest bucket index + 1, 0 when none
+
+	// Adds the wait [now_us - us, now_us) to the buckets it overlaps; returns the
+	// bucket it ended in.
+	const wait_bucket& add(std::uint64_t us, std::uint64_t now_us) noexcept
+	{
+		const std::uint64_t begin = us < now_us ? now_us - us : 0;
+		const std::uint64_t last = now_us / window_us;
+		std::uint64_t first = begin / window_us;
+		if (last - first >= ring_size) first = last - (ring_size - 1);
+		for (std::uint64_t b = first; b <= last; b++)
+		{
+			auto& slot = buckets[b % ring_size];
+			if (slot.index != b)
+			{
+				if (slot.index != ~std::uint64_t{0} && slot.index > b) continue; // already reused by a newer bucket
+				slot = {};
+				slot.index = b;
+			}
+			const std::uint64_t lo = begin > b * window_us ? begin : b * window_us;
+			const std::uint64_t hi = now_us < (b + 1) * window_us ? now_us : (b + 1) * window_us;
+			const std::uint64_t part = hi > lo ? hi - lo : 0;
+			slot.waited_us += part;
+			slot.severe_us += part < severe_wait_cap_us ? part : severe_wait_cap_us;
+			if (b == last) slot.waits++;
+		}
+		if (last + 1 > newest) newest = last + 1;
+		return buckets[last % ring_size];
+	}
+
+	std::uint64_t waited(std::uint64_t b) const noexcept
+	{
+		const auto& slot = buckets[b % ring_size];
+		return slot.index == b ? slot.waited_us : 0;
+	}
+
+	// True when each of the sustained_windows complete buckets before the newest
+	// one holds more than `budget_us`; `history_us` gets them, oldest first. A
+	// bucket without waits (idle) breaks the run: nothing trips late.
+	bool sustained(std::uint64_t budget_us, std::uint64_t (&history_us)[sustained_windows]) const noexcept
+	{
+		if (newest < sustained_windows + 1) return false;
+		const std::uint64_t current = newest - 1;
+		bool over = true;
+		for (std::uint32_t i = 0; i < sustained_windows; i++)
+		{
+			history_us[i] = waited(current - sustained_windows + i);
+			over = over && history_us[i] > budget_us;
+		}
+		return over;
+	}
+};
+struct thread_wait_ring
+{
+	std::uint64_t generation = 0;            // the gate (boot) the ring belongs to
+	wait_ring ring{};
+};
+inline thread_local thread_wait_ring t_wait_ring{};
+inline std::atomic<std::uint64_t> g_gate_generation{0};
+
+// REWINDBOX_ZCULL_SLOT_WAKE_636: the pause of a guest that waits for its report slot (50-400 us between
+// two requests, REWINDBOX_ZCULL_ASYNC_READS_630) ends when the RSX thread releases a slot, instead of
+// running to its end while that slot is already final. The guest checks its own slot again and asks
+// again only as before: on its slot released or on the end of its pause. Same values, same requests.
+class slot_release_signal
+{
+	std::mutex m_mutex;
+	std::condition_variable m_cv;
+	std::atomic<std::uint64_t> m_epoch{0};
+	std::atomic<std::uint32_t> m_waiters{0};
+
+public:
+	std::uint64_t epoch() const noexcept
+	{
+		return m_epoch.load();
+	}
+
+	// RSX thread, after a slot of a locked page lost a pending report (outside the pages mutex).
+	void released() noexcept
+	{
+		m_epoch.fetch_add(1);
+
+		if (m_waiters.load())
+		{
+			std::lock_guard lock(m_mutex);
+			m_cv.notify_all();
+		}
+	}
+
+	// Guest thread: returns once the epoch differs from `seen`, or after `us`. Sequentially consistent
+	// epoch/waiter accesses: a release either sees this waiter or happens before its check.
+	void wait(std::uint64_t seen, std::uint64_t us) noexcept
+	{
+		m_waiters.fetch_add(1);
+		{
+			std::unique_lock lock(m_mutex);
+			m_cv.wait_for(lock, std::chrono::microseconds(us), [&]() { return m_epoch.load() != seen; });
+		}
+		m_waiters.fetch_sub(1);
+	}
+};
+
+inline slot_release_signal& slot_releases() noexcept
+{
+	static slot_release_signal s_signal;
+	return s_signal;
+}
+
+inline tally& counters() noexcept
+{
+	static tally s_tally;
+	return s_tally;
+}
+
+// REWINDBOX_ZCULL_ASYNC_READS_630: the pending reports of one locked page, per 16-byte slot, and the
+// accesses the fault handler completed there. Under the pages mutex.
+class page_slots
+{
+	std::uint16_t m_pending[tracked_page_bytes / report_slot_bytes]{};
+	std::uint32_t m_completed = 0;
+	std::uint64_t m_window_start_us = 0;
+	// REWINDBOX_ZCULL_READ_LEAD_659: when the oldest pending report of each slot was enqueued.
+	std::uint64_t m_enqueued_us[tracked_page_bytes / report_slot_bytes]{};
+	// REWINDBOX_ZCULL_WATCHED_FLUSH_660 (ios/IOSZcullWatched.h): ... and the newest, the one a read waits for last.
+	std::uint64_t m_newest_us[tracked_page_bytes / report_slot_bytes]{};
+
+	static constexpr std::uint32_t slot(std::uint32_t address) noexcept
+	{
+		return (address & (tracked_page_bytes - 1)) / report_slot_bytes;
+	}
+
+	// The slots of [address, address + size), inside the page of `address`.
+	static constexpr std::uint32_t last_slot(std::uint32_t address, std::uint32_t size) noexcept
+	{
+		const std::uint32_t offset = address & (tracked_page_bytes - 1);
+		const std::uint32_t last = offset + size - 1;
+		return (last < tracked_page_bytes ? last : tracked_page_bytes - 1) / report_slot_bytes;
+	}
+
+public:
+	void add(std::uint32_t address) noexcept
+	{
+		for (std::uint32_t i = slot(address); i <= last_slot(address, report_slot_bytes); i++)
+		{
+			m_pending[i]++;
+		}
+	}
+
+	// REWINDBOX_ZCULL_READ_LEAD_659: add() that also notes when a slot without pending reports
+	// receives one; the pending counts are those of add().
+	void add_at(std::uint32_t address, std::uint64_t now_us) noexcept
+	{
+		for (std::uint32_t i = slot(address); i <= last_slot(address, report_slot_bytes); i++)
+		{
+			if (!m_pending[i]++)
+			{
+				m_enqueued_us[i] = now_us;
+			}
+
+			m_newest_us[i] = now_us; // REWINDBOX_ZCULL_WATCHED_FLUSH_660
+		}
+	}
+
+	// The age of the oldest pending report of the slot at `address`, 0 when none is pending or
+	// its enqueue time is unknown.
+	std::uint64_t pending_age_us(std::uint32_t address, std::uint64_t now_us) const noexcept
+	{
+		const std::uint32_t i = slot(address);
+		return m_pending[i] && m_enqueued_us[i] && now_us > m_enqueued_us[i] ? now_us - m_enqueued_us[i] : 0;
+	}
+
+	// REWINDBOX_ZCULL_WATCHED_FLUSH_660: the age of the newest pending report of the slot at `address`, 0 when
+	// none is pending or its enqueue time is unknown.
+	std::uint64_t newest_age_us(std::uint32_t address, std::uint64_t now_us) const noexcept
+	{
+		const std::uint32_t i = slot(address);
+		return m_pending[i] && m_newest_us[i] && now_us > m_newest_us[i] ? now_us - m_newest_us[i] : 0;
+	}
+
+	void remove(std::uint32_t address) noexcept
+	{
+		for (std::uint32_t i = slot(address); i <= last_slot(address, report_slot_bytes); i++)
+		{
+			if (m_pending[i])
+			{
+				m_pending[i]--;
+			}
+		}
+	}
+
+	bool pending(std::uint32_t address, std::uint32_t size) const noexcept
+	{
+		for (std::uint32_t i = slot(address); i <= last_slot(address, size); i++)
+		{
+			if (m_pending[i])
+			{
+				return true;
+			}
+		}
+
+		return false;
+	}
+
+	// The base of the first pending slot of [address, address + size), 0 when none.
+	std::uint32_t first_pending(std::uint32_t address, std::uint32_t size) const noexcept
+	{
+		for (std::uint32_t i = slot(address); i <= last_slot(address, size); i++)
+		{
+			if (m_pending[i])
+			{
+				return (address & ~(tracked_page_bytes - 1)) + i * report_slot_bytes;
+			}
+		}
+
+		return 0;
+	}
+
+	// One more access completed by the handler, false when this page is over its budget.
+	bool take_completion(std::uint64_t now_us) noexcept
+	{
+		if (now_us - m_window_start_us >= emulation_window_us)
+		{
+			m_window_start_us = now_us;
+			m_completed = 0;
+		}
+
+		return ++m_completed <= emulation_budget;
+	}
+};
+
+// Request/serve handshake between faulting guest threads and the RSX thread.
+class gate
+{
+	std::atomic<std::uint64_t> m_requested{0};
+	std::atomic<std::uint64_t> m_picked{0};          // newest ticket the RSX thread started
+	std::atomic<std::uint64_t> m_served{0};          // newest ticket whose reports are written
+	std::atomic<std::uint32_t> m_tripped{0};
+	// REWINDBOX_ZCULL_ASYNC_READS_630
+	std::atomic<std::uint32_t> m_slot{0};            // the report slot of the newest slot request
+	std::atomic<std::uint64_t> m_full{0};            // newest ticket that needs every claimed report
+	std::uint64_t m_window_start_us = 0;             // RSX thread only
+	std::uint32_t m_window_services = 0;             // RSX thread only
+	// REWINDBOX_ZCULL_DEMAND_GUARD_621: the all-threads buckets (m_global_mutex) and
+	// the trip record.
+	std::mutex m_global_mutex;
+	wait_ring m_global_ring{};
+	std::uint64_t m_generation = 0;
+	mutable std::mutex m_trip_mutex;
+	trip_detail m_trip{};
+
+	static void raise(std::atomic<std::uint64_t>& value, std::uint64_t ticket) noexcept
+	{
+		std::uint64_t current = value.load(std::memory_order_relaxed);
+		while (current < ticket && !value.compare_exchange_weak(current, ticket, std::memory_order_acq_rel, std::memory_order_relaxed)) {}
+	}
+
+public:
+	gate() noexcept
+		: m_generation(g_gate_generation.fetch_add(1, std::memory_order_relaxed) + 1)
+	{
+		// One gate per renderer, that is per boot: the process-wide flag follows it.
+		counters().tripped.store(0, std::memory_order_relaxed);
+	}
+
+	gate(const gate&) = delete;
+	gate& operator=(const gate&) = delete;
+
+	// Guest thread: a new ticket, served once the RSX thread wrote every claimed report after it.
+	std::uint64_t request() noexcept
+	{
+		return m_requested.fetch_add(1, std::memory_order_acq_rel) + 1;
+	}
+
+	// REWINDBOX_ZCULL_ASYNC_READS_630: guest thread, a request for one report slot.
+	std::uint64_t request_slot(std::uint32_t slot_address) noexcept
+	{
+		m_slot.store(slot_address, std::memory_order_release);
+		return request();
+	}
+
+	// Guest thread: a request that needs every claimed report written.
+	std::uint64_t request_full() noexcept
+	{
+		const std::uint64_t ticket = request();
+		raise(m_full, ticket);
+		return ticket;
+	}
+
+	// RSX thread: the slot of the newest slot request.
+	std::uint32_t requested_slot() const noexcept
+	{
+		return m_slot.load(std::memory_order_acquire);
+	}
+
+	// RSX thread: a pending request needs every claimed report.
+	bool full_pending() const noexcept
+	{
+		return m_full.load(std::memory_order_acquire) > m_served.load(std::memory_order_relaxed);
+	}
+
+	// RSX thread: the newest ticket waiting to be served, 0 when none.
+	std::uint64_t pending() const noexcept
+	{
+		const std::uint64_t requested = m_requested.load(std::memory_order_acquire);
+		return requested != m_served.load(std::memory_order_relaxed) ? requested : 0;
+	}
+
+	// RSX thread, before the forced pass for `ticket`.
+	void pick(std::uint64_t ticket) noexcept
+	{
+		raise(m_picked, ticket);
+	}
+
+	// RSX thread, after every report claimed when `ticket` was read is written.
+	// Returns true when this service tripped the storm guard.
+	// REWINDBOX_ZCULL_ASYNC_READS_630: a slot request that only polled is not counted (`counted`):
+	// a guest asks again every few hundred microseconds while the GPU works.
+	bool serve(std::uint64_t ticket, std::uint64_t now_us, bool counted = true) noexcept
+	{
+		raise(m_picked, ticket);
+		raise(m_served, ticket);
+
+		if (!counted)
+		{
+			return false;
+		}
+
+		if (now_us - m_window_start_us >= window_us)
+		{
+			m_window_start_us = now_us;
+			m_window_services = 0;
+		}
+
+		return ++m_window_services > storm_services && trip(trip_reason::storm);
+	}
+
+	// Guest thread, after a served wait of `us` ending at `now_us`. Returns true when
+	// this wait tripped the lever (REWINDBOX_ZCULL_DEMAND_GUARD_621, see the top).
+	bool record_wait(std::uint64_t us, std::uint64_t now_us) noexcept
+	{
+		// This guest thread's buckets.
+		auto& own = t_wait_ring;
+		if (own.generation != m_generation)
+		{
+			own = {};
+			own.generation = m_generation;
+		}
+		const wait_bucket& ended = own.ring.add(us, now_us);
+		std::uint64_t history[sustained_windows]{};
+		if (own.ring.sustained(wait_budget_us, history) && trip(trip_reason::wait_budget, 1, now_us, history))
+		{
+			return true;
+		}
+		if (ended.severe_us > severe_wait_us && ended.waits >= severe_min_waits)
+		{
+			std::uint64_t severe[sustained_windows]{};
+			severe[sustained_windows - 1] = ended.severe_us;
+			if (trip(trip_reason::wait_severe, 1, now_us, severe))
+			{
+				return true;
+			}
+		}
+
+		// All guest threads' buckets.
+		bool sustained = false;
+		{
+			std::lock_guard lock(m_global_mutex);
+			m_global_ring.add(us, now_us);
+			sustained = m_global_ring.sustained(global_budget_us, history);
+		}
+		return sustained && trip(trip_reason::wait_budget, 2, now_us, history);
+	}
+
+	// The trip record of this boot (reason 0 while the lever works).
+	trip_detail trip_record() const noexcept
+	{
+		std::lock_guard lock(m_trip_mutex);
+		return m_trip;
+	}
+
+	bool is_picked(std::uint64_t ticket) const noexcept
+	{
+		return m_picked.load(std::memory_order_acquire) >= ticket;
+	}
+
+	bool is_served(std::uint64_t ticket) const noexcept
+	{
+		return m_served.load(std::memory_order_acquire) >= ticket;
+	}
+
+	// The first reason wins; returns true for the call that tripped.
+	bool trip(trip_reason reason) noexcept
+	{
+		const std::uint64_t none[sustained_windows]{};
+		return trip(reason, 0, 0, none);
+	}
+
+	bool trip(trip_reason reason, std::uint32_t scope, std::uint64_t now_us, const std::uint64_t (&windows_us)[sustained_windows]) noexcept
+	{
+		std::uint32_t expected = 0;
+		if (!m_tripped.compare_exchange_strong(expected, static_cast<std::uint32_t>(reason), std::memory_order_acq_rel))
+		{
+			return false;
+		}
+
+		{
+			std::lock_guard lock(m_trip_mutex);
+			m_trip.reason = static_cast<std::uint32_t>(reason);
+			m_trip.scope = scope;
+			m_trip.at_us = now_us;
+			for (std::uint32_t i = 0; i < sustained_windows; i++) m_trip.windows_us[i] = windows_us[i];
+		}
+
+		counters().tripped.store(static_cast<std::uint32_t>(reason), std::memory_order_relaxed);
+		return true;
+	}
+
+	bool tripped() const noexcept
+	{
+		return m_tripped.load(std::memory_order_acquire) != 0;
+	}
+};
+
+enum class wait_result
+{
+	served,    // the RSX thread wrote every report claimed at the request
+	released,  // the page no longer holds a pending report (written meanwhile)
+	stopped,   // emulation or renderer stopping
+	timed_out, // not picked up by pickup_deadline, or not completed by hard_deadline
+};
+
+// Guest thread: waits for `ticket`, measured from `started_us`. `released()` checks
+// the page, `stopped()` the emulator, `now_us()` the clock. A request the RSX thread
+// has picked up is waited for up to the hard deadline (a long pipeline compile or GPU
+// backlog is not a failure); one never picked up fails at the pickup deadline.
+// Spins briefly, then sleeps 50 us steps: the request costs one GPU round trip.
+// REWINDBOX_ZCULL_DEMAND_GUARD_621: `picked_at_us`, when given, receives the clock
+// at which the request was first seen picked up (the service time follows it).
+template <typename Released, typename Stopped, typename Now>
+wait_result wait_for(const gate& g, std::uint64_t ticket, std::uint64_t started_us, Released&& released, Stopped&& stopped, Now&& now_us,
+	std::uint64_t* picked_at_us = nullptr)
+{
+	for (unsigned step = 0;; step++)
+	{
+		if (picked_at_us && !*picked_at_us && g.is_picked(ticket))
+		{
+			*picked_at_us = now_us();
+		}
+
+		if (g.is_served(ticket))
+		{
+			return wait_result::served;
+		}
+
+		if (released())
+		{
+			return wait_result::released;
+		}
+
+		if (stopped())
+		{
+			return wait_result::stopped;
+		}
+
+		const std::uint64_t elapsed = now_us() - started_us;
+		if (elapsed >= hard_deadline_us || (elapsed >= pickup_deadline_us && !g.is_picked(ticket)))
+		{
+			return wait_result::timed_out;
+		}
+
+		if (step < 32)
+		{
+			std::this_thread::yield();
+		}
+		else
+		{
+			std::this_thread::sleep_for(std::chrono::microseconds(50));
+		}
+	}
+}
+}
diff --git a/rpcs3/ios/IOSZcullWatched.h b/rpcs3/ios/IOSZcullWatched.h
new file mode 100644
index 0000000..5c32c08
--- /dev/null
+++ b/rpcs3/ios/IOSZcullWatched.h
@@ -0,0 +1,430 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_ZCULL_WATCHED_FLUSH_660: IPA 657 logs (Core 655, PID 10471). Assassin's Creed waits
+// 32.0 ms per frame for ZCULL reports (window 1:42: ZCULLDEMAND619 waits=259:3779.8 ms, max 43.7)
+// for 30.5 ms of GPU work: MoltenVK publishes an occlusion result only when its whole command
+// buffer has completed, and the command buffer of a report is submitted only when a guest asks for
+// that report (ZCULLSYNC613: every command buffer besides the flip one is such a hint flush,
+// 344 = 118 + 226). Black Ops II waits 12.5 ms per report for the GPU side (window 3:16:
+// 1566.5 ms over 107 waits). The guest of these titles faults on a few report slots per frame
+// (ZCULLDEMAND619 faults report=259 per 118 frames).
+// - Learning (guest threads, fault handler, under the pages mutex). With the asynchronous reads of
+//   630 the handler knows the slot a guest waits for, and the page's slots record when their newest
+//   pending report was queued: the read waits for that one last. A slot waited for at least
+//   min_lead_us after that report is learned (a read closer to its report gains little from an
+//   earlier submission, and the RSX thread rarely reaches a pass boundary before it). A watched slot
+//   read again (waited for, or read final by the handler) stays watched, and the number of reports
+//   queued into it between two such reads is kept; a watched slot waited for closer than
+//   min_lead_us after its newest report is dropped. A slot no guest waited for or read for
+//   watch_frames frames is forgotten.
+// - Arming (RSX thread). When a report is queued into a watched slot as the last one expected
+//   before the next read (as many reports as between the last two reads), and the query that
+//   decides its value is still in the open command buffer, the backend arms the boundary submission
+//   of 659 for that buffer: taken at the next draw start or after the next draw's textures with no
+//   render pass open, at the end of a draw after max_deferred_draws more draws (the fallback), or
+//   carried by any other primary submission. The GPU-idle test of 561 does not apply (the guest
+//   reads this report), and at most max_watched_submits_per_frame such submissions are taken per
+//   frame (an arm another submission carries costs nothing and is not counted).
+//   REWINDBOX_ZCULL_WATCHED_OWN_BUDGET_919: that budget is its own. Until Core 918 a watched arm was
+//   also refused once the frame had used the 561 cap of early submissions (6), and a watched
+//   submission counted in that cap. The 561 submissions are speculative (the GPU was idle); a
+//   watched one is for a read the guest is known to make. IPA 676, Black Ops II, window 12:
+//   OPT561 early_submits=615 over 104 frames (5.9 per frame) and frame_capped_checks=72,019, so the
+//   cap is spent early in each frame and a watched arm after that point would be refused while the
+//   guest goes on to wait 8.3 ms per report (ZCULLDEMAND619 waits=72:594.1 ms). A frame now takes at
+//   most 6 early and 2 watched submissions; a watched submission leaves the 561 count as it was.
+// Only command buffer boundaries move: the guest still reads the GPU result of every report, written
+// in the same order; no report value, query or m_sync_tag is touched here.
+//
+// REWINDBOX_ZCULL_DEPTH_GUARD_660: Black Ops II windows 3:12-3:13 of the same logs record about
+// 140 submissions per frame in some frames (ZCULLSYNC613 hint_flushes 2,844 and 2,861 per window,
+// 2,686/2,671 render pass re-begins). The cause inferred is the queue-depth branch of
+// ZCULL_control::update(): above max_safe_queue_depth pending reports, every new report submits
+// the open command buffer for its query, a render pass split each time, while the reports at the
+// head of the queue are already on the GPU. At that limit the hint is now sent only while the
+// oldest pending query is still in the open command buffer (nothing can drain before it is
+// submitted), and after open_cb_skip_bound skipped hints for the same open command buffer: its
+// queries cannot complete before it is submitted (MoltenVK publishes results at the end of a
+// command buffer), so it is submitted at least every 256 queue-depth checks instead of at every
+// report; upstream applies again at or above depth_hard_cap pending reports. The 2,048 query slots
+// are not reserved: one report holds one query, so a reserve of free slots would end the guard as
+// soon as the depth branch runs. When the slots run out, allocate_new_query reads the oldest report
+// synchronously as upstream does (values exact). Host model of the reviews (not device numbers):
+// with more than 2,048 reports in flight per frame the guard makes those synchronous reads longer
+// (2,600 reports per frame: 45.8 -> 53.4 ms per frame) and the hint storm shorter (4,000: 156.8 ->
+// 77.0 ms; BO2-like 1,900 peak: 103.7 -> 75.2 ms), hence its own setting for an A/B on the device.
+// The guard applies only while the on-demand reads really run (not after a 619 trip or with accurate
+// RSX reservation access). Guest reads are served by their own paths (ios_service_read, sync(),
+// read_barrier()), which keep their hints.
+namespace rpcs3::ios::zcull_watched
+{
+inline constexpr std::uint32_t slot_bytes = 16;                   // a GCM report (zcull_on_demand::report_slot_bytes)
+inline constexpr std::uint32_t capacity = 32;                     // learned slots kept; the least recently read is replaced
+inline constexpr std::uint64_t watch_frames = 8;                  // frames a slot stays watched after its last wait or read
+inline constexpr std::uint32_t max_watched_submits_per_frame = 2; // watched submissions taken per frame, outside the 561 cap (919)
+inline constexpr std::uint64_t min_lead_us = 1000;                // report -> read time below which an earlier submission gains little
+inline constexpr std::uint32_t query_scan_limit = 64;             // pending writes scanned for the deciding or oldest query
+
+// REWINDBOX_ZCULL_DEPTH_GUARD_660
+inline constexpr std::uint32_t depth_limit = 1792;                // rsx::reports::max_safe_queue_depth (RSXZCULL.h), for the reports
+inline constexpr std::uint32_t depth_hard_cap = 8192;             // pending reports from which the upstream hint applies again
+inline constexpr std::uint32_t open_cb_skip_bound = 256;          // skipped hints for one open command buffer before one is sent
+inline constexpr std::uint64_t cb_unknown = ~std::uint64_t{0};    // the backend cannot tell (upstream behaviour)
+
+// Process-wide counters of COREPROF ZCULLWATCH660 and ZCULLDEPTH660 (taken per window).
+struct tally
+{
+	// REWINDBOX_ZCULL_WATCHED_FLUSH_660: the table.
+	std::atomic<std::uint64_t> learned{0};         // a guest waited, min_lead_us or more after its newest report, for a slot not watched
+	std::atomic<std::uint64_t> refreshed{0};       // a watched slot waited for or read final again
+	std::atomic<std::uint64_t> expired{0};         // watched slots forgotten after watch_frames
+	std::atomic<std::uint64_t> evicted{0};         // ... replaced while the table was full
+	std::atomic<std::uint64_t> short_leads{0};     // waits closer than min_lead_us after the newest report (not learned, or dropped)
+	std::atomic<std::uint32_t> watched_now{0};     // slots in the table at the last change
+	// ... the reports queued into watched slots (RSX thread).
+	std::atomic<std::uint64_t> watched_reports{0};
+	std::atomic<std::uint64_t> early_writes{0};    // ... with more reports expected before the next read: not armed
+	std::atomic<std::uint64_t> armed{0};           // ... that armed the boundary submission
+	std::atomic<std::uint64_t> joined{0};          // ... whose command buffer had a submission armed already
+	std::atomic<std::uint64_t> submitted{0};       // ... whose deciding query had left the open command buffer
+	std::atomic<std::uint64_t> no_query{0};        // ... without a query with draws to wait for
+	std::atomic<std::uint64_t> capped{0};          // ... over max_watched_submits_per_frame of the frame (919: not the 561 cap)
+	std::atomic<std::uint64_t> off{0};             // ... with early submission off or not in the boundary mode
+	// ... where the watched arms went (backend).
+	std::atomic<std::uint64_t> taken_start{0};     // taken at the start of a draw
+	std::atomic<std::uint64_t> taken_textures{0};  // ... after a draw's textures
+	std::atomic<std::uint64_t> fallback{0};        // ... at the end of a draw after max_deferred_draws draws
+	std::atomic<std::uint64_t> carried{0};         // ... carried by another primary submission
+	// REWINDBOX_ZCULL_DEPTH_GUARD_660: update() at the queue-depth limit, where upstream hints.
+	std::atomic<std::uint64_t> depth_checks{0};
+	std::atomic<std::uint64_t> depth_hints{0};          // hinted: oldest query in the open command buffer, first time there
+	std::atomic<std::uint64_t> depth_skip_submitted{0}; // not hinted: the oldest pending query is on the GPU
+	std::atomic<std::uint64_t> depth_skip_same_cb{0};   // not hinted: this command buffer had its hint
+	std::atomic<std::uint64_t> depth_hard_cap_hints{0}; // hinted as upstream: at or above depth_hard_cap
+	std::atomic<std::uint64_t> depth_unknown{0};        // hinted as upstream: no oldest query found or no answer
+	std::atomic<std::uint64_t> depth_open_cb_bound{0};  // hinted: open_cb_skip_bound hints skipped for this open command buffer
+	std::atomic<std::uint64_t> depth_peak{0};           // the most pending reports seen at the limit
+	// REWINDBOX_ZCULL_COST_920: what the watched submissions cost the RSX thread (the submission of the command
+	// buffer they end, its MoltenVK encoding included), in ticks of utils::get_tsc().
+	std::atomic<std::uint64_t> watched_submits{0};
+	std::atomic<std::uint64_t> watched_submit_ticks{0};
+	std::atomic<std::uint64_t> watched_submit_max_ticks{0};
+
+	void record_watched_submit(std::uint64_t ticks) noexcept
+	{
+		watched_submits.fetch_add(1, std::memory_order_relaxed);
+		watched_submit_ticks.fetch_add(ticks, std::memory_order_relaxed);
+		raise_max(watched_submit_max_ticks, ticks);
+	}
+
+	static void raise_max(std::atomic<std::uint64_t>& max_value, std::uint64_t value) noexcept
+	{
+		std::uint64_t max = max_value.load(std::memory_order_relaxed);
+		while (value > max && !max_value.compare_exchange_weak(max, value, std::memory_order_relaxed)) {}
+	}
+};
+
+inline tally& counters() noexcept
+{
+	static tally s_tally;
+	return s_tally;
+}
+
+constexpr std::uint32_t slot_of(std::uint32_t address) noexcept
+{
+	return address & ~(slot_bytes - 1);
+}
+
+enum class learn_result : std::uint8_t
+{
+	learned,     // a new watched slot
+	refreshed,   // a watched slot read again
+	short_lead,  // not watched: its report came too close before the read
+	dropped,     // was watched: the read followed its newest report too closely
+};
+
+// REWINDBOX_ZCULL_WATCHED_FLUSH_660: the report slots guests waited for. Under
+// ZCULL_control::m_pages_mutex: guest threads write it in the fault handler, the RSX thread reads
+// and counts in it when a report locks its page.
+class watched_slots
+{
+	struct entry
+	{
+		std::uint32_t slot = 0;
+		std::uint32_t writes = 0;          // reports queued into the slot since its last read
+		std::uint32_t per_read = 1;        // ... between its last two reads (1 when just learned)
+		std::uint64_t frame = 0;           // frame of the last wait or final read
+		std::uint64_t order = 0;           // ... and its rank among them (ties of a frame)
+	};
+
+	entry m_entries[capacity]{};
+	std::uint32_t m_count = 0;
+	std::uint64_t m_frame = 0;   // the RSX frame (rsx::thread::int_flip_index) at its last report
+	std::uint64_t m_filter = 0;  // one bit per (slot / slot_bytes) % 64 of the entries
+	std::uint64_t m_order = 0;
+
+	static constexpr std::uint64_t bit(std::uint32_t slot) noexcept
+	{
+		return std::uint64_t{1} << ((slot / slot_bytes) & 63);
+	}
+
+	bool live(const entry& e) const noexcept
+	{
+		return m_frame <= e.frame + watch_frames;
+	}
+
+	void publish() const noexcept
+	{
+		counters().watched_now.store(m_count, std::memory_order_relaxed);
+	}
+
+	void rebuild_filter() noexcept
+	{
+		m_filter = 0;
+		for (std::uint32_t i = 0; i < m_count; i++)
+		{
+			m_filter |= bit(m_entries[i].slot);
+		}
+	}
+
+	void remove(std::uint32_t index) noexcept
+	{
+		m_entries[index] = m_entries[--m_count];
+		rebuild_filter();
+		publish();
+	}
+
+	// Drops the slots not waited for or read for watch_frames frames.
+	void expire() noexcept
+	{
+		std::uint32_t kept = 0;
+		for (std::uint32_t i = 0; i < m_count; i++)
+		{
+			if (live(m_entries[i]))
+			{
+				m_entries[kept++] = m_entries[i];
+			}
+			else
+			{
+				counters().expired.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+
+		if (kept != m_count)
+		{
+			m_count = kept;
+			rebuild_filter();
+			publish();
+		}
+	}
+
+	std::uint32_t find(std::uint32_t slot) const noexcept
+	{
+		if (m_filter & bit(slot))
+		{
+			for (std::uint32_t i = 0; i < m_count; i++)
+			{
+				if (m_entries[i].slot == slot)
+				{
+					return i;
+				}
+			}
+		}
+
+		return capacity;
+	}
+
+	void read_again(entry& e) noexcept
+	{
+		e.per_read = e.writes ? e.writes : 1;
+		e.writes = 0;
+		e.frame = m_frame;
+		e.order = ++m_order;
+		counters().refreshed.fetch_add(1, std::memory_order_relaxed);
+	}
+
+public:
+	// RSX thread, a report queued at `address` locks its page: the clock moves to `frame` (expired slots
+	// are dropped once per frame). True when the slot is watched and this report is the last one expected
+	// before the slot's next read.
+	bool on_report(std::uint32_t address, std::uint64_t frame) noexcept
+	{
+		if (frame != m_frame)
+		{
+			m_frame = frame;
+			expire();
+		}
+
+		const std::uint32_t index = m_count ? find(slot_of(address)) : capacity;
+		if (index == capacity || !live(m_entries[index]))
+		{
+			return false;
+		}
+
+		entry& e = m_entries[index];
+		counters().watched_reports.fetch_add(1, std::memory_order_relaxed);
+		if (++e.writes < e.per_read)
+		{
+			counters().early_writes.fetch_add(1, std::memory_order_relaxed);
+			return false;
+		}
+
+		return true;
+	}
+
+	// Guest thread: its access waits for the slot at `address`, whose newest pending report was queued
+	// `lead_us` before (page_slots::newest_age_us).
+	learn_result learn(std::uint32_t address, std::uint64_t lead_us) noexcept
+	{
+		const std::uint32_t slot = slot_of(address);
+		if (const std::uint32_t index = find(slot); index != capacity)
+		{
+			entry& e = m_entries[index];
+			if (lead_us < min_lead_us)
+			{
+				remove(index);
+				counters().short_leads.fetch_add(1, std::memory_order_relaxed);
+				return learn_result::dropped;
+			}
+
+			read_again(e);
+			return learn_result::refreshed;
+		}
+
+		if (lead_us < min_lead_us)
+		{
+			counters().short_leads.fetch_add(1, std::memory_order_relaxed);
+			return learn_result::short_lead;
+		}
+
+		if (m_count == capacity)
+		{
+			std::uint32_t oldest = 0;
+			for (std::uint32_t i = 1; i < m_count; i++)
+			{
+				const entry& e = m_entries[i];
+				if (e.frame < m_entries[oldest].frame || (e.frame == m_entries[oldest].frame && e.order < m_entries[oldest].order))
+				{
+					oldest = i;
+				}
+			}
+
+			m_entries[oldest] = {};
+			m_entries[oldest].slot = slot;
+			m_entries[oldest].frame = m_frame;
+			m_entries[oldest].order = ++m_order;
+			rebuild_filter();
+			counters().evicted.fetch_add(1, std::memory_order_relaxed);
+		}
+		else
+		{
+			entry& e = m_entries[m_count++];
+			e = {};
+			e.slot = slot;
+			e.frame = m_frame;
+			e.order = ++m_order;
+			m_filter |= bit(slot);
+		}
+
+		counters().learned.fetch_add(1, std::memory_order_relaxed);
+		publish();
+		return learn_result::learned;
+	}
+
+	// Guest thread: its access read the slot at `address` final. A watched slot stays watched (the
+	// submissions that made it final keep it); any other slot is not learned.
+	bool refresh(std::uint32_t address) noexcept
+	{
+		if (const std::uint32_t index = find(slot_of(address)); index != capacity)
+		{
+			read_again(m_entries[index]);
+			return true;
+		}
+
+		return false;
+	}
+
+	std::uint32_t size() const noexcept
+	{
+		return m_count;
+	}
+};
+
+// Backend, RSX thread: the watched submissions taken in the current frame.
+struct frame_budget
+{
+	std::uint64_t frame = ~std::uint64_t{0};
+	std::uint32_t used = 0;
+
+	bool available(std::uint64_t now_frame) noexcept
+	{
+		if (now_frame != frame)
+		{
+			frame = now_frame;
+			used = 0;
+		}
+
+		return used < max_watched_submits_per_frame;
+	}
+
+	void consume() noexcept
+	{
+		used++;
+	}
+};
+
+// What the backend did with a watched report (VKGSRender::ios_arm_watched_submit).
+enum class arm_result : std::uint8_t
+{
+	off,        // early submission off, or not in the boundary mode: nothing armed
+	armed,      // the boundary submission of the open command buffer is armed
+	joined,     // a submission was already armed for it
+	submitted,  // the deciding query no longer has host queries in the open command buffer
+	capped,     // max_watched_submits_per_frame is used up for this frame (919: the 561 cap no longer refuses it)
+};
+
+// REWINDBOX_ZCULL_DEPTH_GUARD_660
+enum class depth_verdict : std::uint8_t
+{
+	hint,                // the oldest pending query is in the open command buffer, not hinted there yet
+	hard_cap,            // at or above depth_hard_cap: upstream
+	unknown,             // no oldest query found, or the backend cannot tell: upstream
+	front_submitted,     // the oldest pending query is on the GPU: no hint
+	same_command_buffer, // this command buffer had its guarded hint: no hint
+	open_cb_bound,       // open_cb_skip_bound hints were skipped for the open command buffer: hint
+};
+
+// pending: ptimer->async_tasks_pending; front_cb: the backend's serial of the open command buffer
+// holding the oldest pending query (0 when it was submitted, cb_unknown when unknown); last_cb: the
+// serial of the last guarded hint; open_cb_skips: hints already skipped for the open command buffer.
+constexpr depth_verdict decide_depth(std::uint32_t pending, std::uint64_t front_cb, std::uint64_t last_cb,
+	std::uint32_t open_cb_skips = 0) noexcept
+{
+	if (pending >= depth_hard_cap)
+	{
+		return depth_verdict::hard_cap;
+	}
+
+	if (front_cb == cb_unknown)
+	{
+		return depth_verdict::unknown;
+	}
+
+	if (front_cb == 0)
+	{
+		return open_cb_skips >= open_cb_skip_bound ? depth_verdict::open_cb_bound : depth_verdict::front_submitted;
+	}
+
+	return front_cb == last_cb ? depth_verdict::same_command_buffer : depth_verdict::hint;
+}
+
+constexpr bool depth_hint_sent(depth_verdict verdict) noexcept
+{
+	return verdict == depth_verdict::hint || verdict == depth_verdict::hard_cap || verdict == depth_verdict::unknown ||
+		verdict == depth_verdict::open_cb_bound;
+}
+}
