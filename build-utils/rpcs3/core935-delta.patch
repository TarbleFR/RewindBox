+
+inline std::array<diagnostics::EventCost, zcull_path_count> zcull_wait_ticks{};
+inline std::array<std::atomic<std::uint64_t>, zcull_path_count> zcull_gathers{};
+inline std::atomic<std::uint64_t> zcull_poll_deferred{0};
