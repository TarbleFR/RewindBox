+
+	// ~image hands the texture and its views to the deferred release (the GPU may still read them); so does the MSAA
+	// resolve image's (M4).
+	render_target::~render_target() = default;
+
+	image* render_target::get_surface(rsx::surface_access access_type)
+	{
+		last_rw_access_tag = rsx::get_shared_tag();
+
+		// M4: VK render_target::get_surface: transfers of a multisampled surface use its resolve image. A transfer barrier
+		// (memory_barrier) resolves it first (VK ensures it did); it exists after any transfer barrier.
+		if (sample_count > 1 && access_type.is_transfer())
+		{
+			if (!resolve_surface)
+			{
+				if (auto ctx = get_command_context())
+				{
+					// M5: created here, it is resolved before it is handed out (get_resolve_target_safe)
+					if (get_resolve_target_safe(*ctx) && (msaa_flags & rsx::surface_state_flags::require_resolve))
+					{
+						resolve(*ctx);
+					}
+				}
+			}
+
+			if (resolve_surface && !(msaa_flags & rsx::surface_state_flags::require_resolve))
+			{
+				// The surface's component layout may have changed since (a format change of the same native format):
+				// the resolve image is viewed with the same layout (VK clone_surface keeps them in step).
+				if (resolve_surface->native_component_map != native_component_map)
+				{
+					resolve_surface->set_native_component_layout(native_component_map);
+				}
+				return resolve_surface.get();
+			}
+
+			// The allocation or the resolve pass failed (counted, logged once): the multisampled image itself, which every
+			// transfer refuses (counted), so that no stale samples are copied.
+		}
+		// M4 end
+
+		return this;
+	}
+
+	u32 render_target::get_gcm_format() const
+	{
+		return is_depth_surface() ? rsx::get_compatible_gcm_format(get_surface_depth_format()).first :
+			rsx::get_compatible_gcm_format(get_surface_color_format()).first;
+	}
+
+	bool render_target::is_depth_surface() const
+	{
+		return is_depth_format(native_format);
+	}
+
+	bool render_target::matches_dimensions(u16 surface_width_, u16 surface_height_) const
+	{
+		// Use forward scaling to account for rounding and clamping errors (as the Vulkan renderer does)
+		const auto [scaled_w, scaled_h] = rsx::apply_resolution_scale<true>(resolution_scaling_config, surface_width_, surface_height_);
+		return (scaled_w == texture_width) && (scaled_h == texture_height);
+	}
+
+	void render_target::reset_surface_counters()
+	{
+		frame_tag = 0;
+	}
+
+	bool render_target::allocate(command_context& ctx, pixel_format format, u32 width_, u32 height_, bool depth, u8 samples)
+	{
+		texture_descriptor desc{};
+		desc.type = texture_type::type_2d;
+		desc.format = format;
+		desc.width = std::max(width_, 1u);
+		desc.height = std::max(height_, 1u);
+		// Pixel format views: the texture cache samples surfaces through swizzled views (depth included, and the
+		// stencil plane of a depth-stencil surface as X32_Stencil8) and reinterprets bit-compatible formats.
+		desc.usage = usage_render_target | usage_shader_read | usage_pixel_format_view;
+		desc.storage = storage_mode::private_;
+		static_cast<void>(depth);
+
+		// M4: multisampled surfaces
+		if (samples > 1)
+		{
+			desc.type = texture_type::type_2d_multisample;
+			desc.sample_count = samples;
+		}
+		// M4 end
+
+		if (!create(ctx, desc, rsx::RSX_FORMAT_CLASS_COLOR))
+		{
+			rsx_log.error("Metal: surface texture allocation failed (%ux%u, format %u, %u samples)", desc.width, desc.height, static_cast<u32>(format), samples);
+			if (samples > 1)
+			{
+				m4_count(get_m4_counters().msaa_allocation_failures);  // M4
+			}
+			return false;
+		}
+
+		if (samples > 1)
+		{
+			m4_count(get_m4_counters().msaa_surfaces);  // M4
+		}
+		g_surface_counters.created++;
+		return true;
+	}
+
+	bool render_target::load_memory(command_context& ctx)
+	{
+		// VKRenderTargets.cpp load_memory. The guest pixels (the samples side by side) are uploaded into the texture when
+		// it holds them 1:1 (no resolution scaling, one sample per pixel). Otherwise the destination is the surface, or
+		// the resolve image of a multisampled surface (M4): the upload writes it through when it holds the guest pixels
+		// 1:1, else goes into a typeless helper of the surface's format at the guest size, which copy_scaled_image then
+		// scales into it (linear for colour, nearest for depth), as the Vulkan renderer does.
+		if (!g_upload_heap)
+		{
+			log_once("surface-load-heap", "guest-memory load without an upload ring");
+			return false;
+		}
+
+		const u32 bpp = get_bpp();
+		const u32 width_px = surface_width * samples_x;
+		const u32 height_px = surface_height * samples_y;
+		if (!bpp || !rsx_pitch || !width_px || !height_px)
+		{
+			log_once("surface-load-format", fmt::format("guest-memory load of a surface without a guest layout (bpp %u, pitch %u)", bpp, rsx_pitch));
+			return false;
+		}
+
+		// The image the guest pixels go into, and the one they end in.
+		image* final_dst = this;
+		image* content = this;
+		if (resolution_scaling_config.scale_percent == 100 && spp == 1) [[likely]]
+		{
+			if (width_px != width() || height_px != height())
+			{
+				log_once("surface-load-size", fmt::format("guest-memory load of a %ux%u surface into a %ux%u texture refused", width_px, height_px, width(), height()));
+				return false;
+			}
+		}
+		else
+		{
+			// M4: a multisampled surface takes its samples through its resolve image ("Trigger unresolve", initialize_memory).
+			final_dst = (sample_count > 1) ? get_resolve_target_safe(ctx) : this;
+			if (!final_dst)
+			{
+				// The resolve image allocation failed (counted there).
+				return false;
+			}
+
+			content = final_dst;
+			if (final_dst->width() != width_px || final_dst->height() != height_px)
+			{
+				// Possible if MSAA is enabled with 100% resolution scale or surface dimensions are less than resolution scale
+				// threshold and no MSAA: written through. Otherwise the guest pixels go into a helper first (index 6: distinct
+				// from the transfer helpers that copy_scaled_image uses).
+				blit_engine* const engine = get_blit_engine();
+				content = engine ? engine->get_typeless_helper(ctx, format(), format_class(), width_px, height_px, 6) : nullptr;
+				if (!content)
+				{
+					log_once("surface-load-helper", "guest-memory load of a scaled surface without a helper image");
+					return false;
+				}
+			}
+		}
+
+		// Load Cell data
+		const bool is_swizzled = (raster_type == rsx::surface_raster_type::swizzle);
+		rsx::subresource_layout subres{};
+		subres.width_in_block = subres.width_in_texel = static_cast<u16>(width_px);
+		subres.height_in_block = subres.height_in_texel = static_cast<u16>(height_px);
+		subres.pitch_in_block = rsx_pitch / bpp;
+		subres.depth = 1;
+		subres.data = { vm::get_super_ptr<const std::byte>(base_addr), static_cast<std::span<const std::byte>::size_type>(rsx_pitch * height_px) };
+
+		std::vector<u8> detiled;
+		bool uploaded = false;
+		const auto range = get_memory_range();
+		if (auto tiled_region = rsx::get_current_renderer()->get_tiled_memory_region(range))
+		{
+			const u32 tile_pitch = tiled_region.tile->pitch;
+			if (!tile_pitch || (tile_pitch % bpp) || tile_pitch < width_px * bpp)
+			{
+				log_once("surface-load-tile-pitch", fmt::format("guest-memory load of a tiled surface with pitch 0x%x refused", tile_pitch));
+				return false;
+			}
+
+			// The Vulkan renderer detiles on the GPU (detile_memory_block, then a GPU-resident upload); so does this renderer
+			// with the tile decoder. Swizzled surfaces (whose texels are not rows of the tile pitch) and a missing decoder
+			// take the common CPU helper, the same layout (VKRenderTargets.cpp DEBUG_DMA_TILING path): linear rows at the
+			// tile pitch, which the upload layout then uses.
+			uploaded = !is_swizzled && upload_tiled_image(ctx, *g_upload_heap, content, tiled_region.base_address, tiled_region.tile->size, tile_pitch,
+				tiled_region.tile->bank, range.start, width_px, height_px, bpp, get_gcm_format());
+			if (!uploaded)
+			{
+				detiled.resize(usz{tile_pitch} * height_px);
+				if (!tiled_copy(tiled_region.base_address, tiled_region.tile->size, tile_pitch, tiled_region.tile->bank, range.start,
+					detiled.data(), tile_pitch, width_px, height_px, bpp, false))
+				{
+					log_once("surface-load-tile-pitch", fmt::format("guest-memory load of a tiled surface with pitch 0x%x refused", tile_pitch));
+					return false;
+				}
+				subres.pitch_in_block = tile_pitch / bpp;
+				subres.data = std::span<const std::byte>(reinterpret_cast<const std::byte*>(detiled.data()), detiled.size());
+			}
+		}
+
+		if (!uploaded)
+		{
+			upload_image(ctx, *g_upload_heap, content, { subres }, get_gcm_format(), is_swizzled, false);
+		}
+
+		// Write into final image
+		if (content != final_dst)
+		{
+			const areai src_area = { 0, 0, static_cast<s32>(width_px), static_cast<s32>(height_px) };
+			const areai dst_area = { 0, 0, static_cast<s32>(final_dst->width()), static_cast<s32>(final_dst->height()) };
+			if (!copy_scaled_image(ctx, content, final_dst, src_area, dst_area, 0, 0, 0, true,
+				aspect() == aspect_color ? blit_filter::linear : blit_filter::nearest))
+			{
+				// Refused (counted there): nothing of the surface was written.
+				return false;
+			}
+			g_surface_counters.scaled_memory_loads++;
+		}
+
+		g_surface_counters.memory_loads++;
+		return true;
+	}
+
+	void render_target::clear_memory(command_context& ctx)
+	{
+		// VKRenderTargets.cpp clear_memory: colour (0, 0, 0, 1), depth 1.0, stencil 255.
+		render_pass_descriptor pass{};
+		pass.render_target_width = texture_width;
+		pass.render_target_height = texture_height;
+
+		if (is_depth_surface())
+		{
+			pass.depth.texture = texture;
+			pass.depth.load = load_action::clear;
+			pass.depth.store = store_action::store;
+			pass.depth.clear_depth = 1.0;
+
+			if (has_stencil(native_format))
+			{
+				pass.stencil.texture = texture;
+				pass.stencil.load = load_action::clear;
+				pass.stencil.store = store_action::store;
+				pass.stencil.clear_stencil = 255;
+			}
+		}
+		else
+		{
+			pass.color[0].texture = texture;
+			pass.color[0].load = load_action::clear;
+			pass.color[0].store = store_action::store;
+			pass.color[0].clear = { 0., 0., 0., 1. };
+		}
+
+		ctx.begin_render(pass, 0, "surface clear");
+		ctx.end_encoder();
+
+		state_flags &= ~rsx::surface_state_flags::erase_bkgnd;
+		g_surface_counters.cleared++;
+	}
+
+	void render_target::initialize_memory(command_context& ctx, rsx::surface_access access)
+	{
+		const bool read_buffers_config = is_depth_surface() ?
+			!!g_cfg.video.read_depth_buffer :
+			!!g_cfg.video.read_color_buffers;
+
+		const bool should_read_buffers = (state_flags & rsx::surface_state_flags::force_data_load) || read_buffers_config;
+		if (should_read_buffers)
+		{
+			// VKRenderTargets.cpp initialize_memory: the surface is loaded from guest memory.
+			if (load_memory(ctx))
+			{
+				state_flags &= ~(rsx::surface_state_flags::erase_bkgnd | rsx::surface_state_flags::force_data_load);
+				// M4: VK load_memory: the samples were written into the resolve image ("Trigger unresolve")
+				msaa_flags = (sample_count > 1) ? rsx::surface_state_flags::require_unresolve : rsx::surface_state_flags::ready;
+				return;
+			}
+
+			// The load failed (logged once by its cause): counted, initialised as without loads.
+			g_surface_counters.memory_loads_not_implemented++;
+		}
+
+		clear_memory(ctx);
+
+		// M4: VK initialize_memory: the resolve image is cleared too when it is about to be read. Also when a transfer is
+		// about to write it (memory_write, the inheritance below) or when it exists: a later unresolve, or a read of a
+		// region no transfer covers, then carries the same initialisation (the Vulkan renderer leaves it undefined).
+		if (sample_count > 1 && (access.is_transfer_or_read() || access == rsx::surface_access::memory_write || resolve_surface))
+		{
+			clear_resolve_memory(ctx);
+		}
+		// M4 end
+
+		msaa_flags = rsx::surface_state_flags::ready;
+	}
+
+	void render_target::memory_barrier(command_context& ctx, rsx::surface_access access)
+	{
+		if (access == rsx::surface_access::gpu_reference)
+		{
+			// Only requires the object to exist for GPU usage (no spilling in this renderer).
+			return;
+		}
+
+		const bool is_depth = is_depth_surface();
+		const bool read_buffers_config = is_depth ? !!g_cfg.video.read_depth_buffer : !!g_cfg.video.read_color_buffers;
+		const bool should_read_buffers = (state_flags & rsx::surface_state_flags::force_data_load) || read_buffers_config;
+
+		if (should_read_buffers)
+		{
+			if (last_use_tag && state_flags == rsx::surface_state_flags::ready && !test())
+			{
+				state_flags |= rsx::surface_state_flags::erase_bkgnd;
+			}
+		}
+
+		if (old_contents.empty()) [[likely]]
+		{
+			if (state_flags & rsx::surface_state_flags::erase_bkgnd)
+			{
+				initialize_memory(ctx, access);
+
+				ensure(state_flags == rsx::surface_state_flags::ready);
+				on_write(rsx::get_shared_tag(), static_cast<rsx::surface_state_flags>(msaa_flags));
+			}
+
+			// M4: VK render_target::memory_barrier MSAA transitions
+			if (msaa_flags & rsx::surface_state_flags::require_resolve)
+			{
+				if (access.is_transfer())
+				{
+					// Only do this step when read access is required
+					resolve(ctx);
+				}
+			}
+			else if (msaa_flags & rsx::surface_state_flags::require_unresolve)
+			{
+				if (access == rsx::surface_access::shader_write)
+				{
+					// Only do this step when it is needed to start rendering
+					unresolve(ctx);
+				}
+			}
+			// M4 end
+
+			return;
+		}
+
+		// Memory transfers from the surfaces this one replaced or overlaps (VKRenderTargets.cpp: the blitter, which copies,
+		// reinterprets or scales as needed; M3.2).
+		blitter hw_blitter;
+		const auto dst_bpp = get_bpp();
+		// M4: a multisampled surface is written through its resolve image (VK target_image), the samples side by side.
+		if (sample_count > 1)
+		{
+			get_resolve_target_safe(ctx);
+		}
+		const u32 target_width = sample_count > 1 ? resolve_width() : texture_width;
+		const u32 target_height = sample_count > 1 ? resolve_height() : texture_height;
+		// M4 end
+		const unsigned first = prepare_rw_barrier_for_transfer(this);
+		const bool accept_all = (last_use_tag && test());
+		bool optimize_copy = true;
+		u64 newest_tag = 0;
+
+		for (auto i = first; i < old_contents.size(); ++i)
+		{
+			auto& section = old_contents[i];
+			auto src_texture = static_cast<render_target*>(section.source);
+			src_texture->memory_barrier(ctx, rsx::surface_access::transfer_read);
+
+			if (!accept_all && !src_texture->test()) [[likely]]
+			{
+				// If this surface is intact, accept all incoming data as it is guaranteed to be safe
+				// If this surface has not been initialized or is dirty, do not add more dirty data to it
+				continue;
+			}
+
+			const auto src_bpp = src_texture->get_bpp();
+			rsx::typeless_xfer typeless_info{};
+
+			if (src_texture->aspect() != aspect() ||
+				!images_are_bitcast_compatible(native_format, format_class(), src_texture->native_format, src_texture->format_class()))
+			{
+				typeless_info.src_is_typeless = true;
+				typeless_info.src_context = rsx::texture_upload_context::framebuffer_storage;
+				typeless_info.src_native_format_override = static_cast<u32>(native_format);
+				typeless_info.src_gcm_format = src_texture->get_gcm_format();
+				typeless_info.src_scaling_hint = f32(src_bpp) / dst_bpp;
+			}
+
+			section.init_transfer(this);
+			auto src_area = section.src_rect();
+			auto dst_area = section.dst_rect();
+
+			// M4: as the Vulkan renderer, the rectangles are in samples when MSAA is not disabled
+			if (g_cfg.video.antialiasing_level != msaa_level::none)
+			{
+				src_texture->transform_pixels_to_samples(src_area);
+				this->transform_pixels_to_samples(dst_area);
+			}
+			// M4 end
+
+			bool memory_load = true;
+			if (dst_area.x1 == 0 && dst_area.y1 == 0 &&
+				static_cast<u32>(dst_area.x2) == target_width && static_cast<u32>(dst_area.y2) == target_height)
+			{
+				// The whole surface is replaced
+				state_flags &= ~(rsx::surface_state_flags::erase_bkgnd);
+				msaa_flags = rsx::surface_state_flags::ready;
+
+				memory_load = false;
+				stencil_init_flags = src_texture->stencil_init_flags;
+			}
+			else if (state_flags & rsx::surface_state_flags::erase_bkgnd)
+			{
+				initialize_memory(ctx, rsx::surface_access::memory_write);
+				ensure(state_flags == rsx::surface_state_flags::ready);
+			}
+
+			// M4: VK memory_barrier: the resolve images carry the transfer
+			if (msaa_flags & rsx::surface_state_flags::require_resolve)
+			{
+				// Need to forward resolve this
+				resolve(ctx);
+			}
+
+			if (src_texture->sample_count > 1)
+			{
+				// Ensure a readable surface exists for the source
+				src_texture->get_resolve_target_safe(ctx);
+			}
+			// M4 end
+
+			if (hw_blitter.scale_image(ctx, src_texture->get_surface(rsx::surface_access::transfer_read), this->get_surface(rsx::surface_access::transfer_write),
+				src_area, dst_area, /*linear?*/false, typeless_info))
+			{
+				g_surface_counters.inherited_copies++;
+			}
+			else
+			{
+				// A transfer the blitter refuses (counted there too). The region keeps the initialisation the Vulkan
+				// renderer would have used without loads.
+				g_surface_counters.transfers_not_implemented++;
+				if (!memory_load)
+				{
+					state_flags |= rsx::surface_state_flags::erase_bkgnd;
+					initialize_memory(ctx, rsx::surface_access::memory_write);
+				}
+			}
+
+			optimize_copy = optimize_copy && !memory_load;
+			newest_tag = src_texture->last_use_tag;
+		}
+
+		if (!newest_tag) [[unlikely]]
+		{
+			// Underlying memory has been modified and we could not find valid data to fill it
+			clear_rw_barrier();
+
+			state_flags |= rsx::surface_state_flags::erase_bkgnd;
+			initialize_memory(ctx, access);
+			ensure(state_flags == rsx::surface_state_flags::ready);
+		}
+
+		on_write_copy(newest_tag, optimize_copy);
+
+		// M4: VK memory_barrier: rendering needs the multisampled texture up to date
+		if (access == rsx::surface_access::shader_write && sample_count > 1)
+		{
+			// Write barrier, must initialize
+			unresolve(ctx);
+		}
+		// M4 end
+	}
+
+	std::unique_ptr<render_target> surface_cache_traits::create_new_surface(
+		command_context& ctx,
+		u32 address,
+		rsx::surface_color_format format,
+		usz width, usz height, usz pitch,
+		rsx::surface_antialiasing antialias,
+		const rsx::surface_scaling_config_t& resolution_scaling_config)
+	{
+		const auto fmt = get_compatible_surface_format(format);
+		const auto [width_, height_] = rsx::apply_resolution_scale<true>(resolution_scaling_config, static_cast<u16>(width), static_cast<u16>(height));
+		const auto [samples, sample_layout] = surface_msaa(antialias);  // M4
+
+		auto rtt = std::make_unique<render_target>();
+		if (!rtt->allocate(ctx, fmt.format, width_, height_, false, samples))
+		{
+			return {};
+		}
+
+		rtt->image_format_class = rsx::RSX_FORMAT_CLASS_COLOR;
+		rtt->set_format(format);
+		rtt->set_aa_mode(antialias);
+		rtt->set_resolution_scaling_config(resolution_scaling_config);
+		rtt->sample_layout = sample_layout;  // M4
+		rtt->memory_usage_flags = rsx::surface_usage_flags::attachment;
+		rtt->state_flags = rsx::surface_state_flags::erase_bkgnd;
+		rtt->native_component_map = fmt.mapping;
+		rtt->rsx_pitch = static_cast<u32>(pitch);
+		rtt->native_pitch = static_cast<u32>(width) * get_format_block_size_in_bytes(format) * rtt->samples_x;
+		rtt->surface_width = static_cast<u16>(width);
+		rtt->surface_height = static_cast<u16>(height);
+		rtt->queue_tag(address);
+
+		rtt->add_ref();
+		return rtt;
+	}
+
+	std::unique_ptr<render_target> surface_cache_traits::create_new_surface(
+		command_context& ctx,
+		u32 address,
+		rsx::surface_depth_format2 format,
+		usz width, usz height, usz pitch,
+		rsx::surface_antialiasing antialias,
+		const rsx::surface_scaling_config_t& resolution_scaling_config)
+	{
+		const auto requested_format = get_compatible_depth_surface_format(format);
+		const auto [width_, height_] = rsx::apply_resolution_scale<true>(resolution_scaling_config, static_cast<u16>(width), static_cast<u16>(height));
+		const auto [samples, sample_layout] = surface_msaa(antialias);  // M4
+
+		auto ds = std::make_unique<render_target>();
+		if (!ds->allocate(ctx, requested_format, width_, height_, true, samples))
+		{
+			return {};
+		}
+
+		ds->image_format_class = rsx::classify_format(format);
+		ds->set_format(format);
+		ds->set_aa_mode(antialias);
+		ds->set_resolution_scaling_config(resolution_scaling_config);
+		ds->sample_layout = sample_layout;  // M4
+		ds->memory_usage_flags = rsx::surface_usage_flags::attachment;
+		ds->state_flags = rsx::surface_state_flags::erase_bkgnd;
+		ds->native_component_map = { swizzle::red, swizzle::red, swizzle::red, swizzle::red };
+		ds->native_pitch = static_cast<u32>(width) * get_format_block_size_in_bytes(format) * ds->samples_x;
+		ds->rsx_pitch = static_cast<u32>(pitch);
+		ds->surface_width = static_cast<u16>(width);
+		ds->surface_height = static_cast<u16>(height);
+		ds->queue_tag(address);
+
+		ds->add_ref();
+		return ds;
+	}
+
+	void surface_cache_traits::clone_surface(
+		command_context& ctx,
+		std::unique_ptr<render_target>& sink, render_target* ref,
+		u32 address, barrier_descriptor_t& prev,
+		const rsx::surface_scaling_config_t& scaling_config)
+	{
+		const bool initialize = !sink || !sink->has_refs();
+		if (sink && initialize)
+		{
+			prepare_for_reuse(ctx, sink.get());
+		}
+
+		if (!sink)
+		{
+			const auto [new_w, new_h] = rsx::apply_resolution_scale<true>(
+				scaling_config,
+				prev.width, prev.height,
+				ref->get_surface_width<rsx::surface_metrics::pixels>(), ref->get_surface_height<rsx::surface_metrics::pixels>());
+
+			sink = std::make_unique<render_target>();
+			if (!sink->allocate(ctx, ref->native_format, new_w, new_h, ref->is_depth_surface(), ref->samples()))  // M4: ref's sample count
+			{
+				sink.reset();
+				return;
+			}
+
+			sink->image_format_class = ref->format_class();
+		}
+
+		if (initialize)
+		{
+			sink->reset();
+			sink->msaa_flags = rsx::surface_state_flags::ready;
+			sink->add_ref();
+
+			sink->sample_layout = ref->sample_layout;
+			sink->resolution_scaling_config = scaling_config;
+
+			sink->set_aa_mode(ref->get_aa_mode());
+			sink->format_info = ref->format_info;
+			sink->memory_usage_flags = rsx::surface_usage_flags::storage;
+			sink->state_flags = rsx::surface_state_flags::erase_bkgnd;
+			sink->native_component_map = ref->native_component_map;
+			sink->stencil_init_flags = ref->stencil_init_flags;
+			sink->native_pitch = static_cast<u32>(prev.width) * ref->get_bpp() * ref->samples_x;
+			sink->rsx_pitch = ref->get_rsx_pitch();
+			sink->surface_width = prev.width;
+			sink->surface_height = prev.height;
+			sink->queue_tag(address);
+		}
+
+		sink->on_clone_from(ref);
+
+		if (!sink->old_contents.empty())
+		{
+			// Deal with this, likely only needs to clear
+			if (sink->surface_width > prev.width || sink->surface_height > prev.height)
+			{
+				sink->write_barrier(ctx);
+			}
+			else
+			{
+				sink->clear_rw_barrier();
+			}
+		}
+
+		prev.target = sink.get();
+		sink->set_old_contents_region(prev, false);
+	}
+
+	void surface_cache_traits::notify_surface_invalidated(const std::unique_ptr<render_target>& surface)
+	{
+		surface->frame_tag = g_current_frame_id;
+
+		if (!surface->old_contents.empty())
+		{
+			// TODO (as in the Vulkan renderer): retire the deferred writes
+			surface->clear_rw_barrier();
+		}
+
+		surface->release();
+	}
+
+	bool surface_cache_traits::int_surface_matches_properties(
+		const std::unique_ptr<render_target>& surface,
+		pixel_format format,
+		usz width, usz height,
+		rsx::surface_antialiasing antialias,
+		const rsx::surface_scaling_config_t& scaling_config,
+		bool check_refs)
+	{
+		if (check_refs && surface->has_refs())
+		{
+			// Surface may still have read refs from data 'copy'
+			return false;
+		}
+
+		return surface->native_format == format &&
+			surface->get_spp() == get_format_sample_count(antialias) &&
+			surface->matches_dimensions(static_cast<u16>(width), static_cast<u16>(height)) &&
+			surface->resolution_scaling_config == scaling_config;
+	}
+
+	void surface_cache_traits::write_render_target_to_memory(
+		command_context&,
+		buffer_object*,
+		render_target*,
+		u64, u64, u64)
+	{
+		// Reached only through rsx::surface_store::write_to_dma_buffers, which nothing calls in this RPCS3.
+		g_surface_counters.memory_writes_not_implemented++;
+	}
+
+	const object& surface_cache_traits::ctx_device(command_context& ctx)
+	{
+		return ctx.device();
+	}
+
+	void surface_cache::destroy()
+	{
+		invalidate_all();
+		invalidated_resources.clear();
+	}
+
+	void surface_cache::trim(u64 last_completed_frame)
+	{
+		for (auto& rtt : invalidated_resources)
+		{
+			ensure(rtt->frame_tag != 0);
+
+			if (rtt->has_refs())
+			{
+				// Still read by a pass being recorded.
+				continue;
+			}
+
+			if (rtt->frame_tag >= last_completed_frame)
+			{
+				// The frame that invalidated it may still use it.
+				continue;
+			}
+
+			if (!rtt->old_contents.empty())
+			{
+				rtt->clear_rw_barrier();
+			}
+
+			// Vulkan's threshold at low memory pressure. ~render_target hands the texture to the deferred release.
+			if (rtt->unused_check_count() >= 2)
+			{
+				rtt.reset();
+				g_surface_counters.released++;
+			}
+		}
+
+		invalidated_resources.remove_if([](const auto& rtt) { return !rtt; });
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLRenderTargets.h b/rpcs3/Emu/RSX/Metal/MTLRenderTargets.h
new file mode 100644
index 0000000..98890ef
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLRenderTargets.h
@@ -0,0 +1,326 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): render targets of the native Metal 4 renderer on RPCS3's shared surface store.
+//
+// rsx::surface_store keeps all the RSX memory logic (address overlap, inheritance of old contents, invalidation, the
+// same rules the Vulkan renderer runs on); these traits only create and update Metal textures, as VKRenderTargets.h
+// does for Vulkan images:
+//   - new surfaces are initialised exactly as the Vulkan renderer initialises them when guest-memory loads are off
+//     (the default): colour (0, 0, 0, 1), depth 1.0, stencil 255;
+//   - inherited contents are copied on the GPU when source and target have the same format and scale;
+//   - guest-memory loads ("Read Color/Depth Buffers", force_data_load) go through the texture upload path (M3.1),
+//     tiled ones detiled on the GPU by the tile decoder as VK detile_memory_block does (the common CPU tiling helper
+//     when it is unavailable); a resolution-scaled surface (or one whose texture does not hold the samples 1:1) is
+//     loaded into a helper at the guest size and scaled into it, as VK load_memory does;
+//   - surfaces are images (MTLTexture.h), so the texture cache samples and reads them back (MTLTextureCache.h).
+//   - inherited contents go through the blitter (MTLBlit.h): copies, bit reinterpretations and scaled copies (M3.2).
+// M4: at the "Auto" MSAA level a surface has its AA mode's sample count, with a resolve image (the samples side by side,
+// MTLResolve.h) that transfers, readbacks and guest-memory loads use, as the Vulkan renderer's resolve_surface; the
+// blitter's typeless reinterpretations include byte shuffles and depth <-> colour packing (MTLTypelessCopy.cpp).
+// Still counted, never faked: guest-memory loads that fail (no upload ring, unknown tile pitch, a refused transfer) and
+// transfers the blitter refuses (the region is initialised as above instead).
+
+#include "Emu/RSX/Common/surface_store.h"
+#include "MTLCommandContext.h"
+#include "MTLFormats.h"
+#include "MTLTexture.h"
+
+#include <atomic>
+#include <memory>
+#include <vector>
+
+namespace mtl
+{
+	struct surface_counters
+	{
+		std::atomic<u64> created{0};
+		std::atomic<u64> released{0};
+		std::atomic<u64> cleared{0};
+		std::atomic<u64> inherited_copies{0};
+		std::atomic<u64> transfers_not_implemented{0};
+		std::atomic<u64> memory_loads_not_implemented{0};   // a guest-memory load that failed (cause logged once)
+		std::atomic<u64> memory_writes_not_implemented{0};
+		std::atomic<u64> memory_loads{0};
+		std::atomic<u64> scaled_memory_loads{0};            // through a helper scaled into the surface (VK load_memory)
+	};
+
+	surface_counters& get_surface_counters();
+
+	// The upload ring the surfaces load guest memory through (set by the renderer; RSX thread only).
+	void set_upload_heap(data_heap* heap);
+	data_heap* get_upload_heap();
+
+	class render_target : public image, public rsx::render_target_descriptor<image*>
+	{
+	public:
+		u64 frame_tag = 0;            // frame id when invalidated, 0 if not invalid
+		u64 last_rw_access_tag = 0;   // timestamp when this object was last used
+		bool is_bound = false;        // bound for rendering
+
+		render_target() = default;
+		~render_target() override;
+
+		image* get_surface(rsx::surface_access access_type) override;
+		bool is_depth_surface() const override;
+		bool matches_dimensions(u16 surface_width, u16 surface_height) const;
+		void reset_surface_counters();
+		// The gcm texture format and byte order of this surface's data in guest memory.
+		u32 get_gcm_format() const;
+
+		// Allocates the texture (private storage, render target and shader read) and makes it resident.
+		// M4: `samples` > 1 makes it a 2D multisample texture.
+		bool allocate(command_context& ctx, pixel_format format, u32 texture_width, u32 texture_height, bool depth, u8 samples = 1);
+
+		// M4: MSAA (MTLResolve.cpp). The resolve image holds the samples side by side, single-sampled (VK resolve_surface);
+		// get_surface() returns it for transfers of a multisampled surface, as VK render_target::get_surface does, and
+		// texture_for() is that image's texture.
+		std::unique_ptr<image> resolve_surface;
+		u32 resolve_width() const { return texture_width * samples_x; }
+		u32 resolve_height() const { return texture_height * samples_y; }
+		image* get_resolve_target_safe(command_context& ctx);
+		void resolve(command_context& ctx);
+		void unresolve(command_context& ctx);
+		void clear_resolve_memory(command_context& ctx);
+		const object& texture_for(rsx::surface_access access) const;
+		// M4 end
+
+		// Synchronization (the command context inserts the hazard barriers between encoders)
+		void memory_barrier(command_context& ctx, rsx::surface_access access);
+		void read_barrier(command_context& ctx) { memory_barrier(ctx, rsx::surface_access::shader_read); }
+		void write_barrier(command_context& ctx) { memory_barrier(ctx, rsx::surface_access::shader_write); }
+
+	private:
+		void clear_memory(command_context& ctx);
+		bool load_memory(command_context& ctx);
+		void initialize_memory(command_context& ctx, rsx::surface_access access);
+	};
+
+	inline render_target* as_rtt(image* t)
+	{
+		return ensure(dynamic_cast<render_target*>(t));
+	}
+
+	inline const render_target* as_rtt(const image* t)
+	{
+		return ensure(dynamic_cast<const render_target*>(t));
+	}
+
+	inline render_target* try_as_rtt(image* t)
+	{
+		return dynamic_cast<render_target*>(t);
+	}
+
+	// A shared-storage buffer for the surface store's DMA blocks.
+	struct buffer_object
+	{
+		object buffer;
+		u64 length = 0;
+
+		u64 size() const { return length; }
+	};
+
+	struct surface_cache_traits
+	{
+		using surface_storage_type = std::unique_ptr<render_target>;
+		using surface_type = render_target*;
+		using buffer_object_storage_type = std::unique_ptr<buffer_object>;
+		using buffer_object_type = buffer_object*;
+		using command_list_type = command_context&;
+		using download_buffer_object = void*;
+		using barrier_descriptor_t = rsx::deferred_clipped_region<render_target*>;
+
+		static std::unique_ptr<render_target> create_new_surface(
+			command_context& ctx,
+			u32 address,
+			rsx::surface_color_format format,
+			usz width, usz height, usz pitch,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& resolution_scaling_config);
+
+		static std::unique_ptr<render_target> create_new_surface(
+			command_context& ctx,
+			u32 address,
+			rsx::surface_depth_format2 format,
+			usz width, usz height, usz pitch,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& resolution_scaling_config);
+
+		static bool is_reusable_surface(const render_target* surface, const render_target* ref)
+		{
+			return surface->texture && surface->native_format == ref->native_format && surface->is_depth_surface() == ref->is_depth_surface() &&
+				surface->samples() == ref->samples();  // M4: the Vulkan renderer's image usage differs by sample count
+		}
+
+		static void prepare_for_reuse(command_context&, render_target* surface)
+		{
+			surface->reset_surface_counters();
+			surface->last_rw_access_tag = 0;
+		}
+
+		static void clone_surface(
+			command_context& ctx,
+			std::unique_ptr<render_target>& sink, render_target* ref,
+			u32 address, barrier_descriptor_t& prev,
+			const rsx::surface_scaling_config_t& scaling_config);
+
+		static std::unique_ptr<render_target> convert_pitch(command_context&, std::unique_ptr<render_target>& src, usz)
+		{
+			// Same as the Vulkan renderer (TODO there too): the surface is re-initialised.
+			src->state_flags = rsx::surface_state_flags::erase_bkgnd;
+			return {};
+		}
+
+		static bool is_compatible_surface(const render_target* surface, const render_target* ref, u16 width, u16 height, u8 sample_count)
+		{
+			return (surface->native_format == ref->native_format &&
+				surface->get_spp() == sample_count &&
+				surface->get_surface_width() == width &&
+				surface->get_surface_height() == height);
+		}
+
+		static void prepare_surface_for_drawing(command_context& ctx, render_target* surface)
+		{
+			surface->memory_barrier(ctx, rsx::surface_access::gpu_reference);
+			surface->reset_surface_counters();
+			surface->memory_usage_flags |= rsx::surface_usage_flags::attachment;
+			surface->is_bound = true;
+		}
+
+		static void prepare_surface_for_sampling(command_context&, render_target* surface)
+		{
+			surface->is_bound = false;
+		}
+
+		static bool surface_is_pitch_compatible(const std::unique_ptr<render_target>& surface, usz pitch)
+		{
+			return surface->rsx_pitch == pitch;
+		}
+
+		static void int_invalidate_surface_contents(command_context&, render_target* surface, u32 address, usz pitch)
+		{
+			surface->rsx_pitch = static_cast<u32>(pitch);
+			surface->queue_tag(address);
+			surface->last_use_tag = 0;
+			surface->stencil_init_flags = 0;
+			surface->memory_usage_flags = rsx::surface_usage_flags::unknown;
+			surface->raster_type = rsx::surface_raster_type::linear;
+		}
+
+		static void invalidate_surface_contents(command_context& ctx, render_target* surface, rsx::surface_color_format format, u32 address, usz pitch)
+		{
+			surface->set_format(format);
+			surface->native_component_map = get_compatible_surface_format(format).mapping;
+			int_invalidate_surface_contents(ctx, surface, address, pitch);
+		}
+
+		static void invalidate_surface_contents(command_context& ctx, render_target* surface, rsx::surface_depth_format2 format, u32 address, usz pitch)
+		{
+			surface->set_format(format);
+			int_invalidate_surface_contents(ctx, surface, address, pitch);
+		}
+
+		static void notify_surface_invalidated(const std::unique_ptr<render_target>& surface);
+
+		static void notify_surface_persist(const std::unique_ptr<render_target>&)
+		{
+		}
+
+		static void notify_surface_reused(const std::unique_ptr<render_target>& surface)
+		{
+			surface->state_flags |= rsx::surface_state_flags::erase_bkgnd;
+			surface->add_ref();
+		}
+
+		static bool int_surface_matches_properties(
+			const std::unique_ptr<render_target>& surface,
+			pixel_format format,
+			usz width, usz height,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& scaling_config,
+			bool check_refs);
+
+		static bool surface_matches_properties(
+			const std::unique_ptr<render_target>& surface,
+			rsx::surface_color_format format,
+			usz width, usz height,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& scaling_config,
+			bool check_refs = false)
+		{
+			return int_surface_matches_properties(surface, get_compatible_surface_format(format).format, width, height, antialias, scaling_config, check_refs);
+		}
+
+		static bool surface_matches_properties(
+			const std::unique_ptr<render_target>& surface,
+			rsx::surface_depth_format2 format,
+			usz width, usz height,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& scaling_config,
+			bool check_refs = false)
+		{
+			return int_surface_matches_properties(surface, get_compatible_depth_surface_format(format), width, height, antialias, scaling_config, check_refs);
+		}
+
+		static void spill_buffer(std::unique_ptr<buffer_object>&)
+		{
+		}
+
+		static void unspill_buffer(std::unique_ptr<buffer_object>&)
+		{
+		}
+
+		static void write_render_target_to_memory(
+			command_context& ctx,
+			buffer_object* bo,
+			render_target* surface,
+			u64 dst_offset_in_buffer,
+			u64 src_offset_in_buffer,
+			u64 max_copy_length);
+
+		template <int BlockSize>
+		static buffer_object* merge_bo_list(command_context& ctx, std::vector<buffer_object*>& list)
+		{
+			// rsx::surface_store::write_to_dma_buffers is not called anywhere in this RPCS3, so this is never
+			// instantiated. Should it become reachable, the merged block must be filled by GPU copies (the source
+			// blocks may still be pending GPU writes); until then it is counted as a memory write not implemented.
+			u64 size = 0;
+			for (auto& bo : list)
+			{
+				size += bo ? bo->size() : BlockSize;
+				if (bo)
+				{
+					ctx.dispose(std::move(bo->buffer), false);
+					delete bo;
+				}
+			}
+
+			get_surface_counters().memory_writes_not_implemented++;
+			auto merged = new buffer_object();
+			merged->buffer = new_buffer(ctx_device(ctx), size, storage_mode::shared);
+			merged->length = size;
+			return merged;
+		}
+
+		static const object& ctx_device(command_context& ctx);
+
+		template <typename T>
+		static T* get(const std::unique_ptr<T>& obj)
+		{
+			return obj.get();
+		}
+	};
+
+	// The frame being recorded (1 for the first frame), stamped on surfaces the cache invalidates.
+	void set_current_frame_id(u64 frame_id);
+
+	class surface_cache : public rsx::surface_store<surface_cache_traits>
+	{
+	public:
+		void destroy();
+
+		// VKRenderTargets.cpp surface_cache::trim at low memory pressure: releases the invalidated surfaces that
+		// nothing references any more, once the frame that invalidated them is older than the last completed one.
+		void trim(u64 last_completed_frame);
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLResolve.cpp b/rpcs3/Emu/RSX/Metal/MTLResolve.cpp
new file mode 100644
index 0000000..e4dd48b
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLResolve.cpp
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): MSAA resolve and unresolve (VKResolveHelper.cpp, VKRenderTargets.cpp resolve/unresolve).
+
+#include "stdafx.h"
+#include "MTLResolve.h"
+
+#include "MTLCommandContext.h"
+#include "MTLM4Counters.h"
+#include "MTLM4Shaders.h"
+#include "MTLRenderTargets.h"
+
+namespace mtl
+{
+	namespace
+	{
+		msaa_resolver* g_resolver = nullptr;
+
+		struct resolve_params
+		{
+			s32 sample_count[2];
+			s32 stencil_mask;
+			s32 reserved;
+		};
+		static_assert(sizeof(resolve_params) == 16);
+
+		void log_failure(m4_failure kind, std::string_view what)
+		{
+			if (m4_first_failure(kind))
+			{
+				rsx_log.error("Metal M4: %s (counted in COREPROF METAL M4; logged once)", what);
+			}
+		}
+	}
+
+	void set_msaa_resolver(msaa_resolver* resolver)
+	{
+		g_resolver = resolver;
+	}
+
+	msaa_resolver* get_msaa_resolver()
+	{
+		return g_resolver;
+	}
+
+	bool msaa_resolver::create(command_context& ctx, const object& compiler, std::string& error)
+	{
+		const object& device = ctx.device();
+		m_device = device;
+		m_compiler = compiler;
+		m_pipelines.init(compiler);
+
+		// The resolve passes are exact copies of samples: safe math (no arithmetic on the values anyway).
+		m_library = compile_library(compiler, m4_shaders::resolve_library_source(), library_options{}, error);
+		if (!m_library)
+		{
+			return false;
+		}
+
+		m_table = new_argument_table(device, 1, 2, 1);  // a sampler entry so that no count is 0
+
+		depth_stencil_descriptor depth{};
+		depth.depth_compare = compare_function::always;
+		depth.depth_write = true;
+		m_depth_state = new_depth_stencil_state(device, depth);
+
+		// VK depthstencil_(un)resolve_EXT: always pass, replace on every outcome, all bits written; the reference is the
+		// fragment's stencil export.
+		depth.stencil = true;
+		depth.front.compare = compare_function::always;
+		depth.front.stencil_fail = stencil_operation::replace;
+		depth.front.depth_fail = stencil_operation::replace;
+		depth.front.depth_stencil_pass = stencil_operation::replace;
+		depth.front.read_mask = 0xff;
+		depth.front.write_mask = 0xff;
+		depth.back = depth.front;
+		m_depth_stencil_state = new_depth_stencil_state(device, depth);
+
+		for (const u32 samples : { 2u, 4u })
+		{
+			const auto grid = msaa::grid_for(samples);
+			m_params[samples] = new_buffer(device, sizeof(resolve_params), storage_mode::shared);
+			if (!m_params[samples])
+			{
+				break;
+			}
+
+			const resolve_params params{ { static_cast<s32>(grid.x), static_cast<s32>(grid.y) }, 0, 0 };
+			std::memcpy(buffer_contents(m_params[samples]), &params, sizeof(params));
+			ctx.make_resident(m_params[samples]);
+		}
+
+		if (!m_table || !m_depth_state || !m_depth_stencil_state || !m_params[2] || !m_params[4])
+		{
+			error = "resolve argument table, depth-stencil states or parameters";
+			m_library.reset();
+			return false;
+		}
+
+		return true;
+	}
+
+	void msaa_resolver::destroy(command_context& ctx)
+	{
+		m_pipelines.clear();
+		for (auto& params : m_params)
+		{
+			ctx.dispose(std::move(params), true);
+		}
+		m_depth_state.reset();
+		m_depth_stencil_state.reset();
+		m_table.reset();
+		m_library.reset();
+		m_compiler.reset();
+		m_device.reset();
+	}
+
+	const object& msaa_resolver::get_pipeline(pass kind, pixel_format format, u32 samples)
+	{
+		const u64 key = (static_cast<u64>(kind) << 40) | (static_cast<u64>(format) << 8) | samples;
+		const auto describe = [&](render_pipeline_descriptor& desc)
+		{
+			desc.library = m_library;
+			desc.vertex_function = "m4_resolve_vertex";
+			switch (kind)
+			{
+			case pass::color_resolve: desc.fragment_function = "m4_color_resolve"; break;
+			case pass::color_unresolve: desc.fragment_function = "m4_color_unresolve"; break;
+			case pass::depth_resolve: desc.fragment_function = "m4_depth_resolve"; break;
+			case pass::depth_unresolve: desc.fragment_function = "m4_depth_unresolve"; break;
+			case pass::depth_stencil_resolve: desc.fragment_function = "m4_depth_stencil_resolve"; break;
+			case pass::depth_stencil_unresolve: desc.fragment_function = "m4_depth_stencil_unresolve"; break;
+			}
+
+			if (kind == pass::color_resolve || kind == pass::color_unresolve)
+			{
+				desc.color[0].format = format;
+				desc.color[0].write_mask = write_all;
+			}
+
+			desc.sample_count = samples;
+			desc.label = fmt::format("MSAA %s", desc.fragment_function);
+		};
+
+		return m_pipelines.get(key, describe, [&](const render_pipeline_descriptor& desc, const std::string& error)
+		{
+			log_failure(m4_failure::resolve_pipeline, fmt::format("%s pipeline for format %u x%u: %s", desc.fragment_function,
+				static_cast<u32>(format), samples, error));
+		});
+	}
+
+	bool msaa_resolver::run(command_context& ctx, render_target& surface, bool unresolve)
+	{
+		const u32 samples = surface.samples();
+		image* const resolved = surface.resolve_surface.get();
+		if (samples <= 1 || !msaa::grid_for(samples).x || !m_params[samples] || !surface.texture || !resolved || !resolved->texture)
+		{
+			return false;
+		}
+
+		const bool depth = surface.is_depth_surface();
+		const bool stencil = depth && has_stencil(surface.native_format);
+
+		pass kind = unresolve ? pass::color_unresolve : pass::color_resolve;
+		if (stencil)
+		{
+			kind = unresolve ? pass::depth_stencil_unresolve : pass::depth_stencil_resolve;
+		}
+		else if (depth)
+		{
+			kind = unresolve ? pass::depth_unresolve : pass::depth_resolve;
+		}
+
+		const object& pipeline = get_pipeline(kind, surface.native_format, unresolve ? samples : 1);
+		if (!pipeline)
+		{
+			return false;
+		}
+
+		// The stencil plane is read through the images' X32_Stencil8 views (Depth32Float_Stencil8 is the only stencil
+		// format here).
+		image_view* stencil_source = nullptr;
+		if (stencil)
+		{
+			if (surface.native_format != pixel_format::depth32_float_stencil8)
+			{
+				return false;
+			}
+
+			stencil_source = unresolve ? resolved->get_view(rsx::default_remap_vector, aspect_stencil)
+				: surface.get_view(rsx::default_remap_vector, aspect_stencil);
+			if (!stencil_source)
+			{
+				return false;
+			}
+		}
+
+		const object& target = unresolve ? surface.texture : resolved->texture;
+		const object& source = unresolve ? resolved->texture : surface.texture;
+		const u32 width = unresolve ? surface.width() : surface.resolve_width();
+		const u32 height = unresolve ? surface.height() : surface.resolve_height();
+
+		// Every texel (resolve) or every sample (unresolve) of the target is written: its previous contents are not loaded.
+		render_pass_descriptor pass_desc{};
+		if (!depth)
+		{
+			pass_desc.color[0].texture = target;
+			pass_desc.color[0].load = load_action::dont_care;
+			pass_desc.color[0].store = store_action::store;
+		}
+		else
+		{
+			pass_desc.depth.texture = target;
+			pass_desc.depth.load = load_action::dont_care;
+			pass_desc.depth.store = store_action::store;
+			if (stencil)
+			{
+				pass_desc.stencil.texture = target;
+				pass_desc.stencil.load = load_action::dont_care;
+				pass_desc.stencil.store = store_action::store;
+			}
+		}
+		pass_desc.render_target_width = width;
+		pass_desc.render_target_height = height;
+
+		table_set_buffer(m_table, m_params[samples], 0, 0);
+		table_set_texture(m_table, source, 0);
+		if (stencil_source)
+		{
+			table_set_texture(m_table, stencil_source->handle(), 1);
+		}
+
+		const object* depth_stencil = depth ? (stencil ? &m_depth_stencil_state : &m_depth_state) : nullptr;
+		draw_transfer_quad(ctx, pass_desc, unresolve ? "MSAA unresolve" : "MSAA resolve", pipeline, depth_stencil, m_table, stage_fragment,
+			0, 0, width, height);
+		m4_count(unresolve ? get_m4_counters().unresolves : get_m4_counters().resolves);
+		return true;
+	}
+
+	bool msaa_resolver::resolve(command_context& ctx, render_target& surface)
+	{
+		return run(ctx, surface, false);
+	}
+
+	bool msaa_resolver::unresolve(command_context& ctx, render_target& surface)
+	{
+		return run(ctx, surface, true);
+	}
+
+	// render_target (MTLRenderTargets.h, M4 block)
+
+	image* render_target::get_resolve_target_safe(command_context& ctx)
+	{
+		if (!resolve_surface)
+		{
+			// VK render_target::get_resolve_target_safe: one sample, the samples side by side, same format, class and
+			// component layout. Pixel format views as every surface (the texture cache samples it through views).
+			texture_descriptor desc{};
+			desc.type = texture_type::type_2d;
+			desc.format = native_format;
+			desc.width = std::max(resolve_width(), 1u);
+			desc.height = std::max(resolve_height(), 1u);
+			desc.usage = usage_render_target | usage_shader_read | usage_pixel_format_view;
+			desc.storage = storage_mode::private_;
+
+			auto created = std::make_unique<image>();
+			if (!created->create(ctx, desc, format_class()))
+			{
+				m4_count(get_m4_counters().msaa_allocation_failures);
+				log_failure(m4_failure::msaa_allocation, fmt::format("MSAA resolve image allocation failed (%ux%u, format %u)",
+					desc.width, desc.height, static_cast<u32>(native_format)));
+				return nullptr;
+			}
+
+			created->set_native_component_layout(native_component_map);
+			created->set_name("MSAA resolve");
+			resolve_surface = std::move(created);
+
+			// M5: a new resolve image holds nothing yet. Unless it is about to carry newer data than the samples
+			// (require_unresolve), it is stale until resolved: no transfer reads it before a resolve pass writes it (a
+			// surface only cleared for rendering and then read has msaa_flags ready and no resolve image).
+			if (!(msaa_flags & rsx::surface_state_flags::require_unresolve))
+			{
+				msaa_flags |= rsx::surface_state_flags::require_resolve;
+			}
+		}
+
+		return resolve_surface.get();
+	}
+
+	void render_target::resolve(command_context& ctx)
+	{
+		// VK render_target::resolve. A pass that cannot run is counted and leaves the resolve texture marked stale.
+		auto* resolver = get_msaa_resolver();
+		if (resolver && get_resolve_target_safe(ctx) && resolver->resolve(ctx, *this))
+		{
+			msaa_flags &= ~(rsx::surface_state_flags::require_resolve);
+			return;
+		}
+
+		m4_count(get_m4_counters().resolve_failures);
+	}
+
+	void render_target::unresolve(command_context& ctx)
+	{
+		// VK render_target::unresolve (the resolve texture holds the newer data).
+		auto* resolver = get_msaa_resolver();
+		if (resolver && resolve_surface && resolver->unresolve(ctx, *this))
+		{
+			msaa_flags &= ~(rsx::surface_state_flags::require_unresolve);
+			return;
+		}
+
+		m4_count(get_m4_counters().resolve_failures);
+	}
+
+	void render_target::clear_resolve_memory(command_context& ctx)
+	{
+		// VK clear_memory(cmd, get_resolve_target_safe(cmd)): colour (0, 0, 0, 1), depth 1.0, stencil 255.
+		image* const resolved = get_resolve_target_safe(ctx);
+		if (!resolved)
+		{
+			return;
+		}
+		const object& target = resolved->texture;
+
+		render_pass_descriptor pass{};
+		pass.render_target_width = resolve_width();
+		pass.render_target_height = resolve_height();
+
+		if (is_depth_surface())
+		{
+			pass.depth.texture = target;
+			pass.depth.load = load_action::clear;
+			pass.depth.store = store_action::store;
+			pass.depth.clear_depth = 1.0;
+
+			if (has_stencil(native_format))
+			{
+				pass.stencil.texture = target;
+				pass.stencil.load = load_action::clear;
+				pass.stencil.store = store_action::store;
+				pass.stencil.clear_stencil = 255;
+			}
+		}
+		else
+		{
+			pass.color[0].texture = target;
+			pass.color[0].load = load_action::clear;
+			pass.color[0].store = store_action::store;
+			pass.color[0].clear = { 0., 0., 0., 1. };
+		}
+
+		ctx.begin_render(pass, 0, "surface resolve clear");
+		ctx.end_encoder();
+	}
+
+	const object& render_target::texture_for(rsx::surface_access access) const
+	{
+		// VK render_target::get_surface: transfers of a multisampled surface use its resolve texture, after the barrier
+		// that resolves it (memory_barrier(transfer_read)) or before the one that unresolves it (shader_write). None when
+		// that resolve failed (counted), as get_surface().
+		static const object no_texture{};
+		if (sample_count == 1 || !access.is_transfer())
+		{
+			return texture;
+		}
+
+		return (resolve_surface && !(msaa_flags & rsx::surface_state_flags::require_resolve)) ? resolve_surface->texture : no_texture;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLResolve.h b/rpcs3/Emu/RSX/Metal/MTLResolve.h
new file mode 100644
index 0000000..4d35ec4
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLResolve.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): MSAA surfaces of the native Metal 4 renderer, with the Vulkan renderer's semantics.
+//
+// At the "Auto" MSAA level a surface has the sample count of its RSX AA mode (VKRenderTargets.h create_new_surface) and
+// is a 2D multisample texture. Its resolve texture holds the same samples side by side (samples_x * width by samples_y *
+// height, single-sampled), the layout of the surface in guest memory; transfers and the presentation read it, and the
+// surface store's copies write it (VK render_target::get_surface). Rendering marks the resolve texture stale
+// (require_resolve); a transfer read resolves first; a write of the resolve texture marks the multisampled texture stale
+// (require_unresolve), unresolved before the next draw (VK render_target::memory_barrier).
+//
+// The passes are VKResolveHelper's, as Metal render passes (Metal has no writable multisampled storage textures):
+// colour, depth, and depth with stencil (stencil export, the Vulkan renderer's _EXT passes), the coordinate math of
+// Program/MSAA (MTLM4Math.h resolve_math), on the pipeline cache and quad draw of the blit engine's scaled copies
+// (MTLTransferPass.h). A pass whose pipeline cannot be built is counted and not executed.
+
+#include "MTLAPI.h"
+#include "MTLM4Math.h"
+#include "MTLTransferPass.h"
+
+#include <array>
+#include <string>
+
+namespace mtl
+{
+	class command_context;
+	class render_target;
+
+	class msaa_resolver
+	{
+	public:
+		bool create(command_context& ctx, const object& compiler, std::string& error);
+		void destroy(command_context& ctx);
+		bool ready() const { return !!m_library; }
+
+		// The multisampled texture into the resolve texture, and back.
+		bool resolve(command_context& ctx, render_target& surface);
+		bool unresolve(command_context& ctx, render_target& surface);
+
+	private:
+		enum class pass : u8
+		{
+			color_resolve,
+			color_unresolve,
+			depth_resolve,
+			depth_unresolve,
+			depth_stencil_resolve,
+			depth_stencil_unresolve,
+		};
+
+		const object& get_pipeline(pass kind, pixel_format format, u32 samples);
+		bool run(command_context& ctx, render_target& surface, bool unresolve);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		object m_depth_state;          // depth always, written
+		object m_depth_stencil_state;  // and stencil always, replaced, all bits
+		std::array<object, 5> m_params{};  // the sample counts by host sample count (2, 4)
+		transfer_pipeline_cache m_pipelines;  // the blit engine's pipeline machinery (MTLTransferPass.h)
+	};
+
+	// The resolver the render targets use (set by the renderer, as the command context).
+	void set_msaa_resolver(msaa_resolver* resolver);
+	msaa_resolver* get_msaa_resolver();
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp
new file mode 100644
index 0000000..9bfae2f
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp
@@ -0,0 +1,339 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2): SPIR-V -> MSL translation for the native Metal 4 renderer.
+// Built with exceptions enabled (SPIRV-Cross reports errors by throwing); no exception crosses this file.
+
+#include "MTLShaderTranslator.h"
+
+#include "Utilities/StrFmt.h"
+
+#include "spirv_msl.hpp"
+
+#include <algorithm>
+#include <exception>
+#include <string_view>
+
+namespace mtl
+{
+	namespace
+	{
+		namespace spvc = SPIRV_CROSS_NAMESPACE;
+		namespace spvh = SPIRV_CROSS_SPV_HEADER_NAMESPACE;
+
+		bool ends_with(std::string_view value, std::string_view suffix)
+		{
+			return value.size() >= suffix.size() && value.substr(value.size() - suffix.size()) == suffix;
+		}
+
+		// The stencil view of a redirected depth-stencil texture: the Vulkan renderer samples it with a nearest,
+		// clamp-to-border (integer opaque black) sampler of its own (VKDraw.cpp, m_stencil_mirror_sampler).
+		spvc::MSLConstexprSampler stencil_mirror_sampler()
+		{
+			spvc::MSLConstexprSampler sampler{};
+			sampler.coord = spvc::MSL_SAMPLER_COORD_NORMALIZED;
+			sampler.min_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mag_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mip_filter = spvc::MSL_SAMPLER_MIP_FILTER_NEAREST;
+			sampler.s_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.t_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.r_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.border_color = spvc::MSL_SAMPLER_BORDER_COLOR_OPAQUE_BLACK;
+			sampler.lod_clamp_min = 0.f;
+			sampler.lod_clamp_max = 1.f;
+			sampler.lod_clamp_enable = true;
+			return sampler;
+		}
+
+		// The depth-compare input (frag_depth): the Vulkan renderer binds it with vk::null_sampler() (nearest, repeat).
+		spvc::MSLConstexprSampler depth_input_sampler()
+		{
+			spvc::MSLConstexprSampler sampler{};
+			sampler.coord = spvc::MSL_SAMPLER_COORD_NORMALIZED;
+			sampler.min_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mag_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mip_filter = spvc::MSL_SAMPLER_MIP_FILTER_NEAREST;
+			sampler.s_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			sampler.t_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			sampler.r_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			return sampler;
+		}
+
+		bool is_stencil_mirror(const resource_slot& slot)
+		{
+			return slot.type == glsl::input_type_texture && ends_with(slot.name, "_stencil");
+		}
+
+		bool is_depth_input(const resource_slot& slot)
+		{
+			return slot.type == glsl::input_type_texture && slot.name == "frag_depth";
+		}
+
+		spvh::ExecutionModel model_of(shader_stage stage)
+		{
+			return stage == shader_stage::vertex ? spvh::ExecutionModelVertex : spvh::ExecutionModelFragment;
+		}
+
+		u32 set_of(shader_stage stage)
+		{
+			return stage == shader_stage::vertex ? glsl::binding_set_index_vertex : glsl::binding_set_index_fragment;
+		}
+
+		std::string describe(const resource_slot& slot)
+		{
+			return fmt::format("'%s' (set %u, binding %u)", slot.name, slot.set, slot.location);
+		}
+	}
+
+	std::vector<resource_slot> assign_slots(shader_stage stage, const std::vector<glsl::program_input>& inputs, std::string& error)
+	{
+		std::vector<resource_slot> slots;
+		slots.reserve(inputs.size());
+
+		const u32 stage_set = set_of(stage);
+		bool push_constants_seen = false;
+
+		for (const auto& input : inputs)
+		{
+			resource_slot slot{};
+			slot.set = input.set;
+			slot.location = input.location;
+			slot.type = input.type;
+			slot.name = input.name;
+
+			if (input.set != stage_set)
+			{
+				error = fmt::format("input %s is not in this stage's set %u", describe(slot), stage_set);
+				return {};
+			}
+
+			switch (input.type)
+			{
+			case glsl::input_type_push_constant:
+				if (push_constants_seen)
+				{
+					error = "more than one push constant block in one stage";
+					return {};
+				}
+				push_constants_seen = true;
+				slot.buffer = push_constant_buffer_slot;
+				break;
+			case glsl::input_type_uniform_buffer:
+			case glsl::input_type_storage_buffer:
+				if (input.location >= push_constant_buffer_slot)
+				{
+					error = fmt::format("buffer %s exceeds the %u buffer slots below the push constants", describe(slot), push_constant_buffer_slot);
+					return {};
+				}
+				slot.buffer = input.location;
+				break;
+			case glsl::input_type_texel_buffer:
+				slot.texture = input.location;
+				break;
+			case glsl::input_type_texture:
+				slot.texture = input.location;
+				if (!is_stencil_mirror(slot) && !is_depth_input(slot))
+				{
+					const int unit = get_texture_index(input.name);
+					if (unit < 0 || static_cast<u32>(unit) >= max_sampler_slots)
+					{
+						error = fmt::format("texture %s has no sampler slot (unit %d)", describe(slot), unit);
+						return {};
+					}
+					slot.sampler = static_cast<u32>(unit);
+				}
+				break;
+			case glsl::input_type_attachment:
+				// Programmable blending: framebuffer fetch of the colour attachment, nothing to bind.
+				break;
+			default:
+				error = fmt::format("input %s has no Metal mapping (type %u)", describe(slot), static_cast<u32>(input.type));
+				return {};
+			}
+
+			if (slot.texture != umax && slot.texture >= max_texture_slots)
+			{
+				error = fmt::format("texture %s exceeds %u texture slots", describe(slot), max_texture_slots);
+				return {};
+			}
+
+			for (const auto& other : slots)
+			{
+				const bool same_buffer = slot.buffer != umax && slot.buffer == other.buffer;
+				const bool same_texture = slot.texture != umax && slot.texture == other.texture;
+				if (same_buffer || same_texture)
+				{
+					error = fmt::format("inputs %s and %s share a Metal slot", describe(other), describe(slot));
+					return {};
+				}
+			}
+
+			slots.push_back(std::move(slot));
+		}
+
+		return slots;
+	}
+
+	translation_result translate_spirv_to_msl(std::span<const u32> spirv, shader_stage stage,
+		const std::vector<glsl::program_input>& inputs, const translation_options& options)
+	{
+		translation_result result{};
+		result.slots = assign_slots(stage, inputs, result.error);
+		if (!result.error.empty())
+		{
+			return result;
+		}
+
+		if (spirv.empty())
+		{
+			result.error = "empty SPIR-V";
+			return result;
+		}
+
+		const spvh::ExecutionModel model = model_of(stage);
+
+		try
+		{
+			spvc::CompilerMSL compiler(spirv.data(), spirv.size());
+
+			// The options MoltenVK uses for these shaders (MVKPipeline.mm, SPIRVToMSLConverter.cpp), Apple GPU, iOS.
+			auto msl_options = compiler.get_msl_options();
+			msl_options.platform = spvc::CompilerMSL::Options::iOS;
+			msl_options.set_msl_version(options.msl_major, options.msl_minor);
+			msl_options.pad_fragment_output_components = true;
+			msl_options.texture_buffer_native = true;
+			msl_options.swizzle_texture_samples = false;     // swizzles are texture views (native swizzle)
+			msl_options.argument_buffers = false;            // discrete slots: Metal 4 argument tables
+			msl_options.agx_manual_cube_grad_fixup = true;   // Apple GPUs
+			msl_options.ios_support_base_vertex_instance = true;
+			msl_options.texture_1D_as_2D = true;
+			msl_options.enable_point_size_builtin = options.point_primitives;
+			msl_options.enable_point_size_default = options.point_primitives;
+			msl_options.default_point_size = 1.0f;
+			msl_options.enable_frag_depth_builtin = options.depth_attachment;
+			msl_options.enable_frag_stencil_ref_builtin = options.stencil_attachment;
+			msl_options.enable_frag_output_mask = options.color_output_mask;
+			msl_options.additional_fixed_sample_mask = options.sample_mask;           // M4
+			msl_options.force_sample_rate_shading = options.sample_rate_shading;     // M4
+			msl_options.use_framebuffer_fetch_subpasses = true;
+			msl_options.replace_recursive_inputs = true;
+			msl_options.ios_use_simdgroup_functions = true;
+			msl_options.emulate_subgroups = false;
+			compiler.set_msl_options(msl_options);
+
+			auto common_options = compiler.get_common_options();
+			common_options.vertex.flip_vert_y = (stage == shader_stage::vertex) && options.flip_vertex_y;
+			common_options.vertex.fixup_clipspace = false;
+			compiler.set_common_options(common_options);
+
+			for (const auto& slot : result.slots)
+			{
+				if (slot.type == glsl::input_type_attachment)
+				{
+					continue;
+				}
+
+				spvc::MSLResourceBinding binding{};
+				binding.stage = model;
+				binding.count = 1;
+
+				if (slot.type == glsl::input_type_push_constant)
+				{
+					binding.desc_set = spvc::kPushConstDescSet;
+					binding.binding = spvc::kPushConstBinding;
+					result.uses_push_constants = true;
+				}
+				else
+				{
+					binding.desc_set = slot.set;
+					binding.binding = slot.location;
+				}
+
+				binding.msl_buffer = slot.buffer != umax ? slot.buffer : 0;
+				binding.msl_texture = slot.texture != umax ? slot.texture : 0;
+				binding.msl_sampler = slot.sampler != umax ? slot.sampler : 0;
+				compiler.add_msl_resource_binding(binding);
+
+				if (is_stencil_mirror(slot))
+				{
+					compiler.remap_constexpr_sampler_by_binding(slot.set, slot.location, stencil_mirror_sampler());
+				}
+				else if (is_depth_input(slot))
+				{
+					compiler.remap_constexpr_sampler_by_binding(slot.set, slot.location, depth_input_sampler());
+				}
+			}
+
+			// Every resource of the SPIR-V must have been listed by the decompiler.
+			const spvc::ShaderResources resources = compiler.get_shader_resources();
+			auto require_listed = [&](const spvc::SmallVector<spvc::Resource>& list, const char* kind)
+			{
+				for (const auto& resource : list)
+				{
+					const u32 set = compiler.get_decoration(resource.id, spvh::DecorationDescriptorSet);
+					const u32 location = compiler.get_decoration(resource.id, spvh::DecorationBinding);
+					const bool listed = std::any_of(result.slots.begin(), result.slots.end(), [&](const resource_slot& slot)
+					{
+						return slot.type != glsl::input_type_push_constant && slot.set == set && slot.location == location;
+					});
+
+					if (!listed)
+					{
+						result.error = fmt::format("%s '%s' (set %u, binding %u) was not listed by the decompiler", kind, resource.name, set, location);
+						return false;
+					}
+				}
+				return true;
+			};
+
+			if (!require_listed(resources.uniform_buffers, "uniform buffer") ||
+				!require_listed(resources.storage_buffers, "storage buffer") ||
+				!require_listed(resources.sampled_images, "sampled image") ||
+				!require_listed(resources.separate_images, "image") ||
+				!require_listed(resources.separate_samplers, "sampler") ||
+				!require_listed(resources.storage_images, "storage image") ||
+				!require_listed(resources.subpass_inputs, "subpass input"))
+			{
+				return result;
+			}
+
+			if (!resources.push_constant_buffers.empty() && !result.uses_push_constants)
+			{
+				result.error = "the shader declares push constants the decompiler did not list";
+				return result;
+			}
+
+			result.msl = compiler.compile();
+			result.entry_point = compiler.get_cleansed_entry_point_name("main", model);
+			result.position_invariant = compiler.is_position_invariant();
+
+			for (auto& slot : result.slots)
+			{
+				if (slot.type == glsl::input_type_attachment)
+				{
+					slot.used = true;
+					continue;
+				}
+
+				const u32 set = slot.type == glsl::input_type_push_constant ? spvc::kPushConstDescSet : slot.set;
+				const u32 location = slot.type == glsl::input_type_push_constant ? spvc::kPushConstBinding : slot.location;
+				slot.used = compiler.is_msl_resource_binding_used(model, set, location);
+			}
+
+			result.ok = true;
+		}
+		catch (const spvc::CompilerError& e)
+		{
+			result.error = fmt::format("SPIRV-Cross: %s", e.what());
+		}
+		catch (const std::exception& e)
+		{
+			result.error = fmt::format("SPIR-V to MSL: %s", e.what());
+		}
+
+		if (!result.ok)
+		{
+			result.msl.clear();
+		}
+
+		return result;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h
new file mode 100644
index 0000000..d6fb3a1
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): SPIR-V -> Metal Shading Language for the native Metal 4 renderer.
+//
+// The SPIR-V comes from RPCS3's Vulkan-flavoured GLSL (Metal decompilers, glslang). SPIRV-Cross (vendored as
+// rbx_spirv_cross, so it never collides with the copy inside MoltenVK) translates it with the options MoltenVK
+// uses for the same shaders today, and every resource the shader declares gets an explicit slot in the Metal 4
+// argument table of its stage. A shader that declares a resource the decompiler did not list is refused rather
+// than given an automatic slot.
+//
+// Slot assignment (documented contract with the draw code):
+//   buffers  (uniform, storage)        -> buffer slot  = GLSL binding location
+//   textures (sampled, texel buffers)  -> texture slot = GLSL binding location
+//   texture samplers                   -> sampler slot = RSX texture unit (tex0..15, vtex0..3)
+//   stencil mirrors, depth-compare input -> samplers baked into the shader (same states as the Vulkan renderer)
+//   push constants (one block per stage) -> buffer slot push_constant_buffer_slot, same bytes for both stages
+//   programmable-blend inputs          -> framebuffer fetch of the colour attachment (no slot)
+
+#include "MTLCommonDecompiler.h"
+
+#include <span>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	enum class shader_stage : u8
+	{
+		vertex,
+		fragment,
+	};
+
+	constexpr u32 push_constant_buffer_slot = 30;
+	constexpr u32 max_buffer_slots = 31;
+	constexpr u32 max_texture_slots = 64;
+	constexpr u32 max_sampler_slots = 16;
+
+	struct resource_slot
+	{
+		u32 set = 0;
+		u32 location = umax;
+		glsl::program_input_type type = glsl::input_type_undefined;
+		std::string name;
+		u32 buffer = umax;
+		u32 texture = umax;
+		u32 sampler = umax;   // umax: no runtime sampler (none needed, or baked into the shader)
+		bool used = false;    // the translated shader reads it
+	};
+
+	struct translation_options
+	{
+		bool flip_vertex_y = true;          // Vulkan clip space (y down) -> Metal (y up), as MoltenVK does by default
+		bool point_primitives = false;      // vertex: the pipeline draws points, so [[point_size]] is written
+		bool depth_attachment = true;       // fragment: a depth attachment exists, so [[depth]] may be written
+		bool stencil_attachment = false;    // fragment: a stencil attachment exists
+		u32 color_output_mask = 0xffffffffu;
+		u32 sample_mask = 0xffffffffu;      // M4: fragment: a fixed sample mask ANDed into the coverage (MoltenVK pSampleMask)
+		bool sample_rate_shading = false;   // M4: fragment: per-sample execution (MoltenVK minSampleShading)
+		u32 msl_major = 3;
+		u32 msl_minor = 2;
+	};
+
+	struct translation_result
+	{
+		bool ok = false;
+		std::string msl;
+		std::string error;
+		std::string entry_point;
+		bool position_invariant = false;    // compile with preserveInvariance
+		bool uses_push_constants = false;
+		std::vector<resource_slot> slots;
+	};
+
+	// Slots for every input of one stage, before translation (pure; also used by the draw code to bind).
+	std::vector<resource_slot> assign_slots(shader_stage stage, const std::vector<glsl::program_input>& inputs, std::string& error);
+
+	translation_result translate_spirv_to_msl(std::span<const u32> spirv, shader_stage stage,
+		const std::vector<glsl::program_input>& inputs, const translation_options& options);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTexture.cpp b/rpcs3/Emu/RSX/Metal/MTLTexture.cpp
new file mode 100644
index 0000000..abd9090
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTexture.cpp
@@ -0,0 +1,719 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M3.1): images, views and the CPU upload path of the native Metal 4 renderer
+// (vkutils/image.cpp and VKTexture.cpp upload_image counterparts).
+
+#include "stdafx.h"
+#include "MTLTexture.h"
+#include "MTLCommandContext.h"
+#include "MTLComputeTasks.h"
+#include "MTLM4Counters.h"
+#include "MTLTypelessCopy.h"
+
+#include "Emu/Memory/vm.h"
+#include "Emu/RSX/Common/io_buffer.h"
+#include "Emu/RSX/Common/tiled_dma_copy.hpp"
+#include "util/asm.hpp"
+
+#include <cstring>
+#include <mutex>
+#include <unordered_set>
+
+namespace mtl
+{
+	namespace
+	{
+		command_context* g_command_context = nullptr;
+		texture_counters g_texture_counters{};
+
+		texture_view_descriptor make_view_descriptor(const image& img, pixel_format format, const component_map& swizzle)
+		{
+			texture_view_descriptor desc{};
+			desc.format = format;
+			desc.type = img.view_type();
+			desc.base_level = 0;
+			desc.level_count = std::max(img.mipmaps(), 1u);
+			desc.base_slice = 0;
+			desc.slice_count = (img.type == texture_type::type_3d) ? 1 : std::max(img.layers(), 1u);
+			for (u32 i = 0; i < 4; ++i)
+			{
+				desc.swizzle[i] = static_cast<texture_swizzle>(swizzle[i]);
+			}
+			return desc;
+		}
+	}
+
+	void set_command_context(command_context* ctx)
+	{
+		g_command_context = ctx;
+	}
+
+	command_context* get_command_context()
+	{
+		return g_command_context;
+	}
+
+	texture_counters& get_texture_counters()
+	{
+		return g_texture_counters;
+	}
+
+	void log_once(const char* key, const std::string& message)
+	{
+		static std::mutex s_lock;
+		static std::unordered_set<std::string> s_seen;
+		std::lock_guard lock(s_lock);
+		if (s_seen.emplace(key).second)
+		{
+			rsx_log.error("Metal: %s (counted in COREPROF METAL; logged once)", message);
+		}
+	}
+
+	// image_view
+
+	image_view::image_view(mtl::image* owner, object handle, const texture_view_descriptor& desc, u32 aspect, u64 key)
+		: m_owner(owner), m_handle(std::move(handle)), m_desc(desc), m_aspect(aspect), m_key(key)
+	{
+		if (m_handle && g_command_context)
+		{
+			g_command_context->make_resident(m_handle);
+		}
+	}
+
+	image_view::~image_view()
+	{
+		if (m_handle && g_command_context)
+		{
+			// The GPU may still read it through an argument table: released after the recorded work completes.
+			g_command_context->dispose(std::move(m_handle), true);
+		}
+	}
+
+	image_view* image_view::as(pixel_format format)
+	{
+		if (format == m_desc.format || format == pixel_format::invalid)
+		{
+			return this;
+		}
+
+		component_map swizzle{};
+		for (u32 i = 0; i < 4; ++i)
+		{
+			swizzle[i] = static_cast<mtl::swizzle>(m_desc.swizzle[i]);
+		}
+
+		// Same remap and aspect, other format: replace the format bits of the key (view_key layout).
+		const u64 key = (m_key & ~(0xffffull << 40)) | (static_cast<u64>(static_cast<u32>(format) & 0xffff) << 40);
+		auto result = m_owner->get_view(format, swizzle, m_aspect, key);
+		return result ? result : this;
+	}
+
+	// image
+
+	image::~image()
+	{
+		release_views();
+		if (texture && g_command_context)
+		{
+			g_command_context->dispose(std::move(texture), true);
+		}
+	}
+
+	bool image::create(command_context& ctx, const texture_descriptor& desc, rsx::format_class format_class)
+	{
+		ensure(!texture);
+		texture = new_texture(ctx.device(), desc);
+		if (!texture)
+		{
+			g_texture_counters.image_allocation_failures++;
+			rsx_log.error("Metal: texture allocation failed (%ux%ux%u, %u levels, %u slices, type %u, format %u)",
+				desc.width, desc.height, desc.depth, desc.mip_levels, desc.array_length, static_cast<u32>(desc.type), static_cast<u32>(desc.format));
+			return false;
+		}
+
+		type = desc.type;
+		native_format = desc.format;
+		texture_width = desc.width;
+		texture_height = desc.height;
+		texture_depth = desc.depth;
+		mip_count = desc.mip_levels;
+		layer_count = (desc.type == texture_type::type_cube) ? 6 : desc.array_length;
+		sample_count = static_cast<u8>(desc.sample_count);
+		usage = desc.usage;
+		image_format_class = format_class;
+		ctx.make_resident(texture);
+		g_texture_counters.images_created++;
+		return true;
+	}
+
+	u32 image::aspect() const
+	{
+		if (!is_depth_format(native_format))
+		{
+			return native_format == pixel_format::stencil8 ? aspect_stencil : aspect_color;
+		}
+		return aspect_depth | (has_stencil(native_format) ? aspect_stencil : 0);
+	}
+
+	image_view* image::get_view(const rsx::texture_channel_remap_t& remap, u32 aspect_mask)
+	{
+		const u32 aspect_bits = aspect() & aspect_mask;
+		ensure(aspect_bits, "Metal: view of an aspect the image does not have");
+
+		// A stencil-only request of a depth-stencil image is its stencil plane (X32_Stencil8).
+		const bool stencil = (aspect_bits == aspect_stencil) && is_depth();
+		const pixel_format format = stencil ? pixel_format::x32_stencil8 : native_format;
+		const u64 key = view_key(native_component_map, remap, aspect_bits, format);
+		if (m_last_view && m_last_view_key == key)
+		{
+			return m_last_view;
+		}
+
+		return get_view(format, view_swizzle(native_component_map, remap), aspect_bits, key);
+	}
+
+	image_view* image::get_view(pixel_format format, const component_map& swizzle, u32 aspect_bits, u64 key)
+	{
+		if (auto found = m_views.find(key); found != m_views.end())
+		{
+			m_last_view_key = key;
+			return m_last_view = found->second.get();
+		}
+
+		const auto desc = make_view_descriptor(*this, format, swizzle);
+		object handle = new_texture_view(texture, desc);
+		if (!handle)
+		{
+			g_texture_counters.view_failures++;
+			log_once("view", fmt::format("texture view creation failed (format %u of %u, type %u, %ux%u)",
+				static_cast<u32>(format), static_cast<u32>(native_format), static_cast<u32>(type), texture_width, texture_height));
+			return nullptr;
+		}
+
+		g_texture_counters.views_created++;
+		auto view = std::make_unique<image_view>(this, std::move(handle), desc, aspect_bits, key);
+		auto result = view.get();
+		m_views.emplace(key, std::move(view));
+		m_last_view_key = key;
+		return m_last_view = result;
+	}
+
+	void image::set_native_component_layout(const component_map& layout)
+	{
+		if (layout != native_component_map)
+		{
+			// Views of the old layout go (the GPU may still read them: they are released through dispose()).
+			release_views();
+			native_component_map = layout;
+		}
+	}
+
+	void image::release_views()
+	{
+		m_views.clear();
+		m_last_view = nullptr;
+		m_last_view_key = 0;
+	}
+
+	// Staging
+
+	staging_allocation allocate_staging(command_context& ctx, data_heap& heap, u64 size)
+	{
+		staging_allocation result{};
+		size = std::max<u64>(size, 16);
+
+		// The ring makes room by submitting and waiting; anything larger than half of it gets its own buffer
+		// (VK grows its upload heap instead).
+		if (size < heap.size() / 2)
+		{
+			result.offset = heap.alloc<512>(static_cast<usz>(size));
+			result.buffer = heap.buffer;
+			result.data = heap.map<u8>(static_cast<usz>(result.offset));
+			return result;
+		}
+
+		result.buffer = new_buffer(ctx.device(), utils::align<u64>(size, 4096), storage_mode::shared);
+		ensure(result.buffer, "Metal: staging buffer allocation failed");
+		result.data = static_cast<u8*>(buffer_contents(result.buffer));
+		ctx.make_resident(result.buffer);
+		// Released once the work recorded so far (and this copy) has completed.
+		ctx.dispose(result.buffer, true);
+		g_texture_counters.upload_dedicated_buffers++;
+		return result;
+	}
+
+	bool tiled_copy(u32 tile_base, u32 tile_size, u32 tile_pitch, u8 tile_bank, u32 origin, u8* linear, u32 linear_pitch,
+		u32 width, u32 height, u32 bpp, bool encode)
+	{
+		// tile_texel_data's prime/factor decomposition of the pitch.
+		const auto [prime, factor] = get_tile_pitch_factors(tile_pitch);
+		if (!prime || !factor || origin < tile_base)
+		{
+			return false;
+		}
+
+		// Offsets are taken from the tile base (tile_rw_offset 0), so every texel's tiled address is inside the tile
+		// (tiled_dma_copy skips any beyond tile_size).
+		const rsx::detiler_config conf =
+		{
+			.prime = prime,
+			.factor = factor,
+			.num_tiles_per_row = prime * factor,
+			.tile_base_address = tile_base,
+			.tile_size = tile_size,
+			.tile_address_offset = origin - tile_base,
+			.tile_rw_offset = 0,
+			.tile_pitch = tile_pitch,
+			.tile_bank = tile_bank,
+			.image_width = width,
+			.image_height = height,
+			.image_pitch = linear_pitch,
+			.image_bpp = bpp,
+		};
+
+		char* tiled_data = vm::get_super_ptr<char>(tile_base);
+		char* linear_data = reinterpret_cast<char*>(linear);
+		const int op = encode ? 0 /* RSX_DMA_OP_ENCODE_TILE */ : 1 /* RSX_DMA_OP_DECODE_TILE */;
+		for (u32 row = 0; row < height; ++row)
+		{
+			for (u32 col = 0; col < width; ++col)
+			{
+				rsx::tiled_dma_copy(row, col, conf, tiled_data, linear_data, op);
+			}
+		}
+		return true;
+	}
+
+	// Uploads
+
+	namespace
+	{
+		// VKTexture.cpp calculate_upload_pitch with heap_align = 0 (packed rows, guest pitch kept when larger).
+		std::pair<u32, u32> calculate_upload_pitch(u32 gcm_format, const image& dst, const rsx::subresource_layout& layout,
+			const rsx::texture_uploader_capabilities& caps)
+		{
+			const u32 block_in_pixel = rsx::get_format_block_size_in_texel(gcm_format);
+			const u8 block_size_in_bytes = rsx::get_format_block_size_in_bytes(gcm_format);
+
+			u32 row_pitch = layout.border ? (layout.width_in_block * block_size_in_bytes) : (layout.pitch_in_block * block_size_in_bytes);
+			u32 upload_pitch_in_texel;
+
+			if (!rsx::is_compressed_host_format(caps, gcm_format))
+			{
+				const u32 host_texel_width = get_format_texel_width(dst.format());
+				const u32 host_packed_pitch = host_texel_width * layout.width_in_texel;
+				row_pitch = std::max<u32>(row_pitch, host_packed_pitch);
+				upload_pitch_in_texel = row_pitch / std::max(host_texel_width, 1u);
+			}
+			else
+			{
+				upload_pitch_in_texel = std::max<u32>(block_in_pixel * row_pitch / block_size_in_bytes, layout.width_in_texel);
+			}
+
+			return { row_pitch, upload_pitch_in_texel };
+		}
+
+		// The depth-stencil planes of uploaded D24S8 words (VKCompute.h cs_scatter_d24x8 / cs_scatter_d32x8).
+		void scatter_depth_stencil(const u8* src, u32 src_pitch, u32 width, u32 rows, bool depth_float, f32* depth, u8* stencil)
+		{
+			for (u32 y = 0; y < rows; ++y)
+			{
+				const u32* in = reinterpret_cast<const u32*>(src + static_cast<usz>(y) * src_pitch);
+				for (u32 x = 0; x < width; ++x)
+				{
+					const u32 value = in[x];
+					const u32 d24 = value >> 8;
+					depth[static_cast<usz>(y) * width + x] = depth_float ? std::bit_cast<f32>(d24f_to_f32_bits(d24)) : d24_to_f32(d24);
+					stencil[static_cast<usz>(y) * width + x] = static_cast<u8>(value & 0xff);
+				}
+			}
+		}
+	}
+
+	void upload_image(command_context& ctx, data_heap& heap, image* dst, const std::vector<rsx::subresource_layout>& layouts,
+		u32 gcm_format, bool is_swizzled, bool supports_bc)
+	{
+		ensure(dst && dst->texture);
+
+		rsx::texture_uploader_capabilities caps{};
+		caps.supports_byteswap = false;      // byteswap, deswizzle and DXT decoding on the CPU (no compute helpers yet)
+		caps.supports_vtc_decoding = false;
+		caps.supports_hw_deswizzle = false;
+		caps.supports_zero_copy = false;
+		caps.supports_dxt = supports_bc;
+		caps.alignment = 0;
+
+		const pixel_format format = dst->format();
+		const bool depth_stencil = format == pixel_format::depth32_float_stencil8;
+		const bool depth16_float = format == pixel_format::depth32_float && gcm_format == CELL_GCM_TEXTURE_DEPTH16_FLOAT;
+		const bool depth_float_class = dst->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32;
+		const bool compressed = rsx::is_compressed_host_format(caps, gcm_format);
+		const u32 host_bpp = compressed ? get_block_size(format) : get_texel_size(format);
+
+		if (!depth_stencil && !depth16_float && !compressed && !host_bpp)
+		{
+			g_texture_counters.uploads_unsupported_format++;
+			log_once("upload-format", fmt::format("texture upload into format %u (gcm 0x%x) is not supported", static_cast<u32>(format), gcm_format));
+			return;
+		}
+
+		transfer_scope scope(ctx, "texture upload");
+		for (const rsx::subresource_layout& layout : layouts)
+		{
+			if (layout.level >= dst->mipmaps())
+			{
+				rsx_log.error("Metal: invalid subresource definition for the output texture (mip level %u does not exist)", layout.level);
+				continue;
+			}
+
+			const auto [row_pitch, upload_pitch_in_texel] = calculate_upload_pitch(gcm_format, *dst, layout, caps);
+			caps.alignment = row_pitch;
+
+			const u32 rows = compressed ? layout.height_in_block : layout.height_in_texel;
+			const u64 image_linear_size = static_cast<u64>(row_pitch) * layout.depth * rows;
+
+			// Decode the guest data into staging memory (with 8 bytes of slack, as VK maps it). Depth formats get their
+			// converted planes in the same allocation: a second one could make room by reusing this one's space.
+			const u32 width = layout.width_in_texel;
+			const u32 plane_rows = rows * layout.depth;
+			const u64 decode_size = utils::align<u64>(image_linear_size + 8, 256);
+			const u64 depth_size = (depth_stencil || depth16_float) ? utils::align<u64>(static_cast<u64>(width) * 4 * plane_rows, 256) : 0;
+			const u64 stencil_size = depth_stencil ? static_cast<u64>(width) * plane_rows : 0;
+			auto staging = allocate_staging(ctx, heap, decode_size + depth_size + stencil_size);
+			u8* const mapped = staging.data;
+			auto io_buf = rsx::io_buffer([&](usz) -> std::tuple<void*, usz>
+			{
+				return { mapped, static_cast<usz>(image_linear_size) };
+			});
+
+			const auto opt = rsx::upload_texture_subresource(io_buf, layout, static_cast<int>(gcm_format), is_swizzled, caps);
+			ensure(!opt.require_upload, "Metal: zero-copy texture upload requested without support");
+
+			g_texture_counters.uploads++;
+			g_texture_counters.upload_bytes += image_linear_size;
+
+			const size3 size{ layout.width_in_texel, layout.height_in_texel, layout.depth };
+			const bool is_3d = dst->type == texture_type::type_3d;
+			const u32 slice = is_3d ? 0 : layout.layer;
+			const auto box = texture_box::make(layout.level, slice, 0, 0, 0, size.width, size.height, size.depth);
+
+			if (depth_stencil || depth16_float)
+			{
+				// Separate planes, converted with the Vulkan renderer's formulas.
+				f32* depth = reinterpret_cast<f32*>(mapped + decode_size);
+				u8* stencil = mapped + decode_size + depth_size;
+				const u64 depth_offset = staging.offset + decode_size;
+
+				if (depth_stencil)
+				{
+					scatter_depth_stencil(mapped, row_pitch, width, plane_rows, depth_float_class, depth, stencil);
+				}
+				else
+				{
+					for (u32 y = 0; y < plane_rows; ++y)
+					{
+						const u16* in = reinterpret_cast<const u16*>(mapped + static_cast<usz>(y) * row_pitch);
+						for (u32 x = 0; x < width; ++x)
+						{
+							depth[static_cast<usz>(y) * width + x] = std::bit_cast<f32>(e4m12_to_f32_bits(in[x]));
+						}
+					}
+				}
+
+				copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, depth_offset, width * 4, is_3d ? width * 4 * rows : 0,
+					size, dst->texture, slice, layout.level, {}, depth_stencil ? blit_depth_from_depth_stencil : blit_none);
+				if (depth_stencil)
+				{
+					// Same region, other plane: ordered after the depth plane (a new encoder).
+					copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, depth_offset + depth_size, width, is_3d ? width * rows : 0,
+						size, dst->texture, slice, layout.level, {}, blit_stencil_from_depth_stencil);
+				}
+				g_texture_counters.depth_uploads_converted++;
+				continue;
+			}
+
+			copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, staging.offset, row_pitch, is_3d ? row_pitch * rows : 0,
+				size, dst->texture, slice, layout.level, {});
+			static_cast<void>(upload_pitch_in_texel);
+		}
+
+		// The scope ends the encoder: the next user of this texture opens a new one, whose queue barrier waits for
+		// these copies.
+	}
+
+	bool upload_tiled_image(command_context& ctx, data_heap& heap, image* dst, u32 tile_base, u32 tile_size, u32 tile_pitch, u8 tile_bank,
+		u32 origin, u32 width, u32 height, u32 bpp, u32 gcm_format)
+	{
+		compute_tasks* const tasks = get_compute_tasks();
+		if (!tasks || !tasks->ready() || !tasks->tiling_ready() || !dst || !dst->texture)
+		{
+			return false;
+		}
+
+		// Formats upload_texture_subresource copies word by word, into a 2D image whose texel is the guest texel or one of
+		// copy_buffer_to_image's two depth conversions (D24S8 -> Depth32Float_Stencil8, D16F -> Depth32Float).
+		const u32 word_size = get_gpu_upload_word_size(gcm_format);
+		const pixel_format format = dst->format();
+		const bool depth_stencil = format == pixel_format::depth32_float_stencil8;
+		const bool depth16_float = format == pixel_format::depth32_float;
+		const bool texel_matches = depth_stencil ? (bpp == 4 && word_size == 4) :
+			depth16_float ? (gcm_format == CELL_GCM_TEXTURE_DEPTH16_FLOAT && bpp == 2) : (get_texel_size(format) == bpp);
+		if (!word_size || !texel_matches || !width || !height || dst->type != texture_type::type_2d || dst->samples() > 1 ||
+			width > dst->width() || height > dst->height() || is_compressed_format(format))
+		{
+			return false;
+		}
+
+		const auto factors = get_tile_pitch_factors(tile_pitch);
+		if (!factors.factor || origin < tile_base || u64{tile_pitch} < u64{width} * bpp)
+		{
+			return false;
+		}
+
+		const u32 tiles_per_row = factors.prime * factors.factor;
+		const u32 origin_offset = origin - tile_base;
+		const tile_span span = get_tile_span(tile_base, tile_size, tile_pitch, tiles_per_row, origin_offset, width, height, bpp);
+		if (span.end <= span.start)
+		{
+			return false;
+		}
+
+		// One staging allocation, as VK's scratch buffer: [the tiled bytes | the packed rows | depth plane | stencil plane].
+		const u32 tiled_length = span.end - span.start;
+		const u32 image_pitch = width * bpp;
+		const u64 linear_length = u64{image_pitch} * height;
+		const u64 texels = u64{width} * height;
+		const u64 linear_offset = utils::align<u64>(tiled_length, 256);
+		const u64 z_offset = utils::align<u64>(linear_offset + utils::align<u64>(linear_length, 4) + 8, 256);
+		const u64 s_offset = utils::align<u64>(z_offset + texels * 4 + 8, 256);
+		const u64 total = s_offset + utils::align<u64>(texels, 4) + 16;
+		if (total > (256ull << 20))
+		{
+			// The kernels address their data with 32-bit offsets.
+			return false;
+		}
+
+		// Taken before any encoder opens: the ring may make room by submitting.
+		auto staging = allocate_staging(ctx, heap, total);
+		if (staging.offset + total > 0xffffffffull)
+		{
+			return false;
+		}
+
+		// The tiled bytes as the decoder reads them (VK detile_memory_block: map_dma + load_dma of the tile rows), through
+		// the unprotected mirror.
+		std::memcpy(staging.data, vm::get_super_ptr<const u8>(tile_base + span.start), tiled_length);
+
+		const tile_decode_params params =
+		{
+			.factor = factors.factor,
+			.num_tiles_per_row = tiles_per_row,
+			.tile_base_address = tile_base,
+			.tile_size = tile_size,
+			.tile_address_offset = origin_offset,
+			.tile_rw_offset = span.start,
+			.tile_pitch = tile_pitch,
+			.tile_bank = tile_bank,
+			.image_width = width,
+			.image_height = height,
+			.image_pitch = image_pitch,
+			.image_bpp = bpp,
+			.tiled_offset = 0,
+			.tiled_length = tiled_length,
+			.linear_offset = static_cast<u32>(linear_offset),
+			.linear_words = static_cast<u32>(utils::aligned_div<u64>(linear_length, 4)),
+		};
+
+		// Nothing of dst is written before the last step: a refused step leaves it to the caller's CPU path.
+		if (!tasks->run_tile_decode(ctx, staging.buffer, staging.offset, params))
+		{
+			return false;
+		}
+
+		const u32 base = static_cast<u32>(staging.offset);
+		const u32 linear = base + static_cast<u32>(linear_offset);
+		const u32 linear_words_bytes = static_cast<u32>(utils::align<u64>(linear_length, 4));
+		if (word_size > 1 && !tasks->run_shuffle(ctx, (word_size == 4) ? compute_kernel::bswap_u32 : compute_kernel::bswap_u16, staging.buffer,
+			linear_words_bytes, linear))
+		{
+			return false;
+		}
+
+		transfer_scope scope(ctx, "tiled upload");
+		const size3 size{ width, height, 1 };
+		const auto box = texture_box::make(0, 0, 0, 0, 0, width, height);
+		if (depth_stencil)
+		{
+			// VK copy_buffer_to_image: the stencil block cleared, the D24S8 words scattered (unorm or float depth by
+			// class), then both planes.
+			fill_buffer(scope.encoder(nullptr, {}, nullptr, {}), staging.buffer, base + s_offset, utils::align<u64>(texels, 4), 0);
+			scope.split();
+			const auto kernel = get_depth_scatter_kernel(dst->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32);
+			if (!tasks->run_interleave(ctx, kernel, staging.buffer, linear, static_cast<u32>(texels * 4), base + static_cast<u32>(z_offset),
+				base + static_cast<u32>(s_offset)))
+			{
+				return false;
+			}
+
+			copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, base + z_offset, width * 4, 0, size, dst->texture, 0, 0, {},
+				blit_depth_from_depth_stencil);
+			copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, base + s_offset, width, 0, size, dst->texture, 0, 0, {},
+				blit_stencil_from_depth_stencil);
+			g_texture_counters.depth_uploads_converted++;
+		}
+		else if (depth16_float)
+		{
+			// VK copy_buffer_to_image: cs_fconvert_task<f16, f32> (whole words: an odd texel count converts the padding too)
+			if (!tasks->run_fconvert(ctx, compute_kernel::f16_to_f32, staging.buffer, linear, static_cast<u32>(utils::align<u64>(texels * 2, 4)),
+				base + static_cast<u32>(z_offset)))
+			{
+				return false;
+			}
+
+			copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, base + z_offset, width * 4, 0, size, dst->texture, 0, 0, {});
+			g_texture_counters.depth_uploads_converted++;
+		}
+		else
+		{
+			copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, linear, image_pitch, 0, size, dst->texture, 0, 0, {});
+		}
+
+		g_texture_counters.uploads++;
+		g_texture_counters.upload_bytes += linear_length;
+		m4_count(get_m4_counters().tile_decodes);
+		return true;
+	}
+
+	void clear_image(command_context& ctx, data_heap& heap, image* dst)
+	{
+		ensure(dst && dst->texture);
+		g_texture_counters.clears++;
+
+		if (dst->is_depth())
+		{
+			// VK clears temporary depth images to {1.f, 0}.
+			for (u32 level = 0; level < dst->mipmaps(); ++level)
+			{
+				for (u32 slice = 0; slice < dst->layers(); ++slice)
+				{
+					render_pass_descriptor pass{};
+					pass.depth.texture = dst->texture;
+					pass.depth.level = level;
+					pass.depth.slice = slice;
+					pass.depth.load = load_action::clear;
+					pass.depth.store = store_action::store;
+					pass.depth.clear_depth = 1.0;
+					if (dst->has_stencil_aspect())
+					{
+						pass.stencil = { dst->texture, level, slice, load_action::clear, store_action::store, 0 };
+					}
+					pass.render_target_width = std::max(dst->width() >> level, 1u);
+					pass.render_target_height = std::max(dst->height() >> level, 1u);
+					ctx.begin_render(pass, 0, "texture clear");
+					ctx.end_encoder();
+				}
+			}
+			return;
+		}
+
+		// Colour: a zeroed staging region copied into every level and slice.
+		const bool compressed = is_compressed_format(dst->format());
+		const u32 bpp = compressed ? get_block_size(dst->format()) : get_texel_size(dst->format());
+		if (!bpp)
+		{
+			log_once("clear-format", fmt::format("clear of texture format %u is not supported", static_cast<u32>(dst->format())));
+			return;
+		}
+
+		const auto row_bytes = [&](u32 width) { return compressed ? utils::aligned_div(width, 4u) * bpp : width * bpp; };
+		const auto row_count = [&](u32 height) { return compressed ? utils::aligned_div(height, 4u) : height; };
+		const bool is_3d = dst->type == texture_type::type_3d;
+		const u64 size = static_cast<u64>(row_bytes(dst->width())) * row_count(dst->height()) * (is_3d ? dst->depth() : 1);
+		auto zeros = allocate_staging(ctx, heap, size);
+		std::memset(zeros.data, 0, static_cast<usz>(size));
+
+		transfer_scope scope(ctx, "texture clear");
+		for (u32 level = 0; level < dst->mipmaps(); ++level)
+		{
+			const u32 w = std::max(dst->width() >> level, 1u);
+			const u32 h = std::max(dst->height() >> level, 1u);
+			const u32 d = is_3d ? std::max(dst->depth() >> level, 1u) : 1;
+			for (u32 slice = 0; slice < (is_3d ? 1 : dst->layers()); ++slice)
+			{
+				copy_buffer_to_texture(scope.for_write(dst->texture, texture_box::make(level, slice, 0, 0, 0, w, h, d)), zeros.buffer, zeros.offset,
+					row_bytes(w), is_3d ? row_bytes(w) * row_count(h) : 0, { w, h, d }, dst->texture, slice, level, {});
+			}
+		}
+	}
+
+	// transfer_scope
+
+	transfer_scope::transfer_scope(command_context& ctx, std::string_view label)
+		: m_ctx(ctx), m_label(label)
+	{
+		// A compute encoder opened before this scope may hold copies the scope does not know about.
+		if (m_ctx.kind() == command_context::encoder_kind::compute)
+		{
+			m_ctx.end_encoder();
+		}
+	}
+
+	transfer_scope::~transfer_scope()
+	{
+		if (m_ctx.kind() == command_context::encoder_kind::compute)
+		{
+			m_ctx.end_encoder();
+		}
+	}
+
+	bool transfer_scope::conflicts(const void* texture, const texture_box& box, bool write) const
+	{
+		for (const auto& entry : m_accesses)
+		{
+			if (entry.texture == texture && (write || entry.write) && entry.box.overlaps(box))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	void transfer_scope::split()
+	{
+		if (m_ctx.kind() == command_context::encoder_kind::compute)
+		{
+			m_ctx.end_encoder();
+		}
+		m_accesses.clear();
+		m_encoder = nullptr;
+	}
+
+	const object& transfer_scope::encoder(const object* src, const texture_box& src_box, const object* dst, const texture_box& dst_box)
+	{
+		// Another helper (a full ring submits) may have ended the encoder: nothing recorded so far is in the open one.
+		if (m_ctx.kind() != command_context::encoder_kind::compute || m_ctx.encoder().get() != m_encoder)
+		{
+			m_accesses.clear();
+		}
+
+		// (A copy whose own source and destination regions overlap is refused by the callers: no encoder orders that.)
+		const bool conflict = (src && conflicts(src->get(), src_box, false)) || (dst && conflicts(dst->get(), dst_box, true));
+		if (conflict)
+		{
+			m_ctx.end_encoder();
+			m_accesses.clear();
+			m_splits++;
+		}
+
+		const object& result = m_ctx.compute(m_label);
+		m_encoder = result.get();
+		if (src)
+		{
+			m_accesses.push_back({ src->get(), src_box, false });
+		}
+		if (dst)
+		{
+			m_accesses.push_back({ dst->get(), dst_box, true });
+		}
+		return result;
+	}
+}
