+}
+
+inline void count_zcull_gather() noexcept
+{
+    zcull_gathers[t_zcull_read_path < zcull_path_count ? t_zcull_read_path : zcull_poll].fetch_add(1, std::memory_order_relaxed);
+}
+
 // REWINDBOX_RSX_FRAME_PROFILE_V1: RPCS3's own per-frame RSX statistics
