+
+void MTLVertexDecompilerThread::insertOutputs(std::stringstream& OS, const std::vector<ParamType>& /*outputs*/)
+{
+	for (auto &i : reg_table)
+	{
+		if (i.need_declare)
+		{
+			// All outputs must be declared always to allow setting default values.
+			// NV4097_SET_SHADE_MODE applies to the front/back diffuse and specular colors.
+			const bool flat_color = (m_prog.ctrl & RSX_SHADER_CONTROL_FLAT_SHADING) &&
+				(i.name.starts_with("diff_color"sv) || i.name.starts_with("spec_color"sv));
+			OS << "layout(location=" << mtl::get_varying_register_location(i.name) << ") out "
+				<< (flat_color ? "flat " : "") << "vec4 " << i.name << ";\n";
+		}
+	}
+
+	if (!(m_prog.ctrl & RSX_SHADER_CONTROL_INTERPRETER_MODEL))
+	{
+		OS << "layout(location=" << mtl::get_varying_register_location("usr") << ") out flat uvec4 draw_params_payload;\n";
+	}
+}
+
+void MTLVertexDecompilerThread::insertFSExport(std::stringstream& OS)
+{
+	OS <<
+		"void write_fs_payload()\n"
+		"{\n"
+		"	draw_params_payload.x = get_draw_params().fs_constants_offset;\n"
+		"	draw_params_payload.y = get_draw_params().fs_context_offset;\n"
+		"	draw_params_payload.z = get_draw_params().fs_texture_base_index;\n"
+		"	draw_params_payload.w = get_draw_params().fs_stipple_pattern_offset;\n"
+		"}\n\n";
+}
+
+void MTLVertexDecompilerThread::insertMainStart(std::stringstream& OS)
+{
+	glsl::shader_properties properties2{};
+	properties2.domain = glsl::glsl_vertex_program;
+	properties2.require_lit_emulation = properties.has_lit_op;
+	properties2.require_clip_plane_functions = true;
+	properties2.emulate_zclip_transform = true;
+	properties2.emulate_depth_clip_only = m_caps.allow_float64;
+#ifdef RPCS3_IOS
+	// REWINDBOX_ZCLIP_WINDOW_Z_616 and REWINDBOX_ZCLIP_PINNED_AFFINE_619: the same title-scoped transforms as the
+	// Vulkan renderer (no float64 on Apple GPUs), resolved before the renderer exists, never during a frame.
+	properties2.emulate_zclip_fallback_window_z = !properties2.emulate_depth_clip_only &&
+		rpcs3::ios::get_experimental_policy().zclip_fallback_window_z;
+	properties2.emulate_zclip_fallback_pinned_affine = properties2.emulate_zclip_fallback_window_z &&
+		rpcs3::ios::get_experimental_policy().zclip_pinned_affine;
+#endif
+	properties2.low_precision_tests = m_caps.low_precision_rounding;
+#ifdef RPCS3_IOS
+	// REWINDBOX_POSITION_INVARIANCE_610: the scoped titles declare an invariant position, as on Vulkan; the Metal
+	// library is then compiled with preserveInvariance (translation_result::position_invariant).
+	properties2.require_explicit_invariance = (m_caps.low_precision_rounding ||
+		rpcs3::ios::get_experimental_policy().position_invariance) &&
+		g_cfg.video.shader_precision != gpu_preset_level::low;
+#else
+	properties2.require_explicit_invariance = m_caps.low_precision_rounding && g_cfg.video.shader_precision != gpu_preset_level::low;
+#endif
+	properties2.require_instanced_render = !!(m_prog.ctrl & RSX_SHADER_CONTROL_INSTANCED_CONSTANTS);
+
+	glsl::insert_glsl_legacy_function(OS, properties2);
+	glsl::insert_vertex_input_fetch(OS, glsl::glsl_rules_vulkan);
+
+	insertFSExport(OS);
+
+	// Declare global registers with optional initialization
+	std::string registers;
+	if (ParamType *vec4Types = m_parr.SearchParam(PF_PARAM_OUT, "vec4"))
+	{
+		for (auto &PI : vec4Types->items)
+		{
+			if (registers.length())
+				registers += ", ";
+			else
+				registers = "vec4 ";
+
+			registers += PI.name;
+
+			if (!PI.value.empty())
+			{
+				// Simplify default initialization
+				if (PI.value == "vec4(0.0, 0.0, 0.0, 0.0)")
+					registers += " = vec4(0.)";
+				else
+					registers += " = " + PI.value;
+			}
+		}
+	}
+
+	if (!registers.empty())
+	{
+		OS << registers << ";\n";
+	}
+
+	// Expand indexed uniform structs here. We don't need to commit registers - these are very rarely consumed anyway.
+	OS <<
+		"#define scale_offset_mat get_vertex_context().scale_offset_mat\n"
+		"#define transform_branch_bits get_vertex_context().transform_branch_bits\n"
+		"#define point_size get_vertex_context().point_size\n"
+		"#define z_near get_vertex_context().z_near\n"
+		"#define z_far get_vertex_context().z_far\n\n";
+
+	OS << "void vs_main()\n";
+	OS << "{\n";
+
+	//Declare temporary registers, ignoring those mapped to outputs
+	for (const ParamType& PT : m_parr.params[PF_PARAM_NONE])
+	{
+		for (const ParamItem& PI : PT.items)
+		{
+			if (PI.name.starts_with("dst_reg"))
+				continue;
+
+			OS << "	" << PT.type << " " << PI.name;
+			if (!PI.value.empty())
+				OS << " = " << PI.value;
+
+			OS << ";\n";
+		}
+	}
+
+	for (const ParamType& PT : m_parr.params[PF_PARAM_IN])
+	{
+		for (const ParamItem& PI : PT.items)
+		{
+			OS << "	vec4 " << PI.name << "= read_location(" << std::to_string(PI.location) << ");\n";
+		}
+	}
+
+	OS << "\nuint xform_constants_offset = get_draw_params().xform_constants_offset;\n\n";
+}
+
+void MTLVertexDecompilerThread::insertMainEnd(std::stringstream& OS)
+{
+	OS << "}\n\n";
+
+	OS << "void main ()\n";
+	OS << "{\n\n";
+
+	if (m_caps.emulate_conditional_rendering)
+	{
+		OS << "	if (cr_predicate_value == 0)\n";
+		OS << "	{\n";
+		OS << "		gl_Position = vec4(0., 0., 0., -1.);\n";
+		OS << "		return;\n";
+		OS << "}\n\n";
+	}
+
+	OS << "	vs_main();\n\n";
+
+	// FS payload
+	OS << "write_fs_payload();\n\n";
+
+	for (auto &i : reg_table)
+	{
+		if (!i.check_mask || i.test(rsx_vertex_program.output_mask))
+		{
+			if (m_parr.HasParam(PF_PARAM_OUT, "vec4", i.src_reg))
+			{
+				std::string condition = (!i.cond.empty()) ? "(" + i.cond + ") " : "";
+
+				if (condition.empty() || i.default_val.empty())
+				{
+					if (!condition.empty()) condition = "if " + condition;
+					OS << "	" << condition << i.name << " = " << i.src_reg << i.src_reg_mask << ";\n";
+				}
+				else
+				{
+					//Insert if-else condition
+					OS << "	" << i.name << " = " << condition << "? " << i.src_reg << i.src_reg_mask << ": " << i.default_val << ";\n";
+				}
+
+				// Register was marked for output and a properly initialized source register exists
+				// Nothing more to do
+				continue;
+			}
+		}
+
+		if (i.need_declare)
+		{
+			OS << "	" << i.name << " = vec4(0., 0., 0., 1.);\n";
+		}
+		else if (i.check_mask_value == CELL_GCM_ATTRIB_OUTPUT_MASK_POINTSIZE)
+		{
+			// Default point size if none was generated by the program
+			OS << "	gl_PointSize = point_size;\n";
+		}
+	}
+
+	OS << "	gl_Position = gl_Position * scale_offset_mat;\n";
+	OS << "	gl_Position = apply_zclip_xform(gl_Position, z_near, z_far);\n";
+	OS << "}\n";
+}
+
+void MTLVertexDecompilerThread::Task()
+{
+	m_shader = Decompile();
+	mtl_prog->inputs = std::move(inputs);
+}
+
+namespace mtl
+{
+	void vertex_program::Decompile(const RSXVertexProgram& prog, const shader_device_caps& caps)
+	{
+		use_last_provoking_vertex = !!(prog.ctrl & RSX_SHADER_CONTROL_FLAT_SHADING);
+
+		std::string source;
+		MTLVertexDecompilerThread decompiler(prog, source, *this, caps);
+		decompiler.Task();
+
+		has_indexed_constants = decompiler.properties.has_indexed_constants;
+		constant_ids = std::vector<u16>(decompiler.m_constant_ids.begin(), decompiler.m_constant_ids.end());
+		glsl_source = std::move(source);
+		spirv.clear();
+
+		std::lock_guard lock(translation_lock);
+		for (u32 i = 0; i < 2; ++i)
+		{
+			msl[i] = {};
+			library[i].reset();
+			library_error[i].clear();
+		}
+	}
+
+	bool vertex_program::Compile()
+	{
+		if (g_cfg.video.log_programs)
+		{
+			fs::write_file(fs::get_cache_dir() + "shaderlog/MetalVertexProgram" + std::to_string(id) + ".glsl", fs::rewrite, glsl_source);
+		}
+
+		spirv.clear();
+		std::string source = glsl_source;
+		if (!spirv::compile_glsl_to_spv(spirv, source, ::glsl::program_domain::glsl_vertex_program, ::glsl::glsl_rules_vulkan))
+		{
+			compile_error = "glslang refused the vertex program";
+			spirv.clear();
+			return false;
+		}
+
+		compile_error.clear();
+		return true;
+	}
+
+	const translation_result& vertex_program::get_msl(bool point_primitives) const
+	{
+		translation_result& result = msl[point_primitives ? 1 : 0];
+		if (!result.ok && result.error.empty())
+		{
+			translation_options options{};
+			options.point_primitives = point_primitives;
+			result = translate_spirv_to_msl(spirv, shader_stage::vertex, inputs, options);
+			if (!result.ok)
+			{
+				rsx_log.error("Metal: vertex program %u was not translated to MSL: %s", id, result.error);
+			}
+		}
+
+		return result;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLVertexProgram.h b/rpcs3/Emu/RSX/Metal/MTLVertexProgram.h
new file mode 100644
index 0000000..100c9c9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLVertexProgram.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): RSX vertex programs for the native Metal 4 renderer.
+// The decompiler emits the same Vulkan-flavoured GLSL as VKVertexProgram.cpp (bindings, vertex fetch from
+// texel buffers, draw parameters, z-clip transform), with the device facts taken from mtl::shader_device_caps.
+
+#include "Emu/RSX/Program/VertexProgramDecompiler.h"
+#include "Emu/RSX/Program/program_util.h"
+#include "MTLAPI.h"
+#include "MTLCommonDecompiler.h"
+#include "MTLShaderTranslator.h"
+
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	class vertex_program;
+}
+
+struct MTLVertexDecompilerThread : public VertexProgramDecompiler
+{
+	std::string& m_shader;
+	std::vector<mtl::glsl::program_input> inputs;
+	mtl::vertex_program* mtl_prog;
+	const mtl::shader_device_caps& m_caps;
+
+protected:
+	std::string getFloatTypeName(usz elementCount) override;
+	std::string getIntTypeName(usz elementCount) override;
+	std::string getFunction(FUNCTION f) override;
+	std::string compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1, bool scalar) override;
+
+	void insertHeader(std::stringstream& OS) override;
+	void insertInputs(std::stringstream& OS, const std::vector<ParamType>& inputs) override;
+	void insertConstants(std::stringstream& OS, const std::vector<ParamType>& constants) override;
+	void insertOutputs(std::stringstream& OS, const std::vector<ParamType>& outputs) override;
+	void insertMainStart(std::stringstream& OS) override;
+	void insertMainEnd(std::stringstream& OS) override;
+
+	void prepareBindingTable();
+	void insertFSExport(std::stringstream& OS);
+
+	const RSXVertexProgram& rsx_vertex_program;
+
+public:
+	MTLVertexDecompilerThread(const RSXVertexProgram& prog, std::string& shader, mtl::vertex_program& dst, const mtl::shader_device_caps& caps)
+		: VertexProgramDecompiler(prog)
+		, m_shader(shader)
+		, mtl_prog(&dst)
+		, m_caps(caps)
+		, rsx_vertex_program(prog)
+	{
+	}
+
+	void Task();
+};
+
+namespace mtl
+{
+	class vertex_program : public rsx::VertexProgramBase
+	{
+	public:
+		ParamArray parr;
+		std::vector<glsl::program_input> inputs;
+		bool use_last_provoking_vertex = false;
+
+		std::string glsl_source;
+		std::vector<u32> spirv;
+		std::string compile_error;
+
+		// Translations by primitive class: [0] everything but points, [1] points ([[point_size]] written), and the
+		// Metal libraries compiled from them. Filled on first use by any pipeline build, under the lock.
+		mutable std::mutex translation_lock;
+		mutable translation_result msl[2];
+		mutable object library[2];
+		mutable std::string library_error[2];
+
+		struct
+		{
+			u32 context_buffer_location = umax;        // Vertex program context
+			u32 cr_pred_buffer_location = umax;        // Conditional rendering predicate
+			u32 vertex_buffers_location = umax;        // Vertex input streams (3)
+			u32 cbuf_location = umax;                  // Vertex program constants register file
+			u32 instanced_lut_buffer_location = umax;  // Instancing redirection table
+			u32 instanced_cbuf_location = umax;        // Instancing constants register file
+			u32 vtex_location[4];                      // Vertex textures
+		} binding_table;
+
+		void Decompile(const RSXVertexProgram& prog, const shader_device_caps& caps);
+
+		// GLSL -> SPIR-V (glslang). False with compile_error set when glslang refuses the source.
+		bool Compile();
+
+		// SPIR-V -> MSL for one primitive class, translated once and kept. Caller holds translation_lock.
+		const translation_result& get_msl(bool point_primitives) const;
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp b/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp
new file mode 100644
index 0000000..98707e3
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp
@@ -0,0 +1,650 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): host unit test of the pure logic of stage M4 (no Metal device, no emulator):
+//   - the visibility slot pool, and the Vulkan renderer's occlusion query rules (check, gather) on segments, including
+//     the exactness of folding (a folded record answers exactly as the unfolded one, for random records);
+//   - the conversion arithmetic (MTLM4Math.h, the very tokens the MSL kernels compile) against independent references;
+//   - the MSAA resolve/unresolve coordinate math (both directions are inverse, and match the Vulkan compute passes);
+//   - the MSAA configuration (sample counts, grids, sample masks) and the compute dispatch parameters.
+//   - the typeless copy's kernel selection (VK copy_image_typeless, copy_image_to_buffer / copy_buffer_to_image).
+//   - the tile decoder (MTLM4Math.h tiling_math, run as the MSL kernel runs it, word by word) against the common CPU
+//     tiler (Common/tiled_dma_copy.hpp) for every RSX tile pitch, bank, texel size and odd region, and the tile span
+//     its staging copy holds.
+// With a directory argument it also writes the MSL libraries (m4_compute.metal, m4_resolve.metal) for Apple's offline
+// compiler: xcrun -sdk iphoneos metal -std=metal3.2 -target air64-apple-ios26.0 -Werror -Wno-unused-variable
+// -Wno-unused-but-set-variable -Wno-unused-function -c m4_compute.metal. Pure logic: no Metal, g++ or clang++.
+//
+//   S=<rpcs3 source root>
+//   c++ -std=gnu++20 -Wall -I "$S/rpcs3" -I "$S" -I "$S/rpcs3/Emu" -I "$S/3rdparty"
+//       "$S/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp" -o mtl_m4_unit_test
+//   ./mtl_m4_unit_test [MSL output directory]
+
+#include "Emu/RSX/Common/tiled_dma_copy.hpp"
+#include "Emu/RSX/Metal/MTLComputeTasks.h"
+#include "Emu/RSX/Metal/MTLM4Math.h"
+#include "Emu/RSX/Metal/MTLM4Shaders.h"
+#include "Emu/RSX/Metal/MTLQueries.h"
+#include "Emu/RSX/Metal/MTLTextureFormats.h"
+#include "Emu/RSX/Metal/MTLTypelessCopy.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace
+{
+	int g_failures = 0;
+	int g_checks = 0;
+
+	void check(bool condition, const char* what, long long a = 0, long long b = 0)
+	{
+		g_checks++;
+		if (!condition)
+		{
+			std::fprintf(stderr, "FAIL: %s (%lld, %lld)\n", what, a, b);
+			++g_failures;
+		}
+	}
+
+	using namespace mtl;
+	using namespace mtl::m4_math;
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_slot_pool()
+	{
+		visibility_slot_pool pool(4);
+		check(pool.capacity() == 4 && pool.available() == 4 && pool.in_use() == 0, "pool starts free");
+
+		const u32 a = pool.allocate(), b = pool.allocate(), c = pool.allocate(), d = pool.allocate();
+		check(a == 0 && b == 1 && c == 2 && d == 3, "slots in order", a, d);
+		check(pool.allocate() == umax, "exhausted pool returns umax");
+		check(pool.in_use() == 4, "all in use");
+
+		check(pool.release(b, 7), "release b at fence 7");
+		check(pool.release(a, 9), "release a at fence 9");
+		check(!pool.release(a, 9), "double release refused");
+		check(!pool.release(17, 1), "out of range release refused");
+		check(pool.pending() == 2 && pool.available() == 0, "released slots wait for their fence");
+
+		check(pool.collect(6) == 0, "nothing complete at 6");
+		check(pool.allocate() == umax, "pending slots are not reused");
+		check(pool.collect(8) == 1, "fence 7 completed at 8");
+		check(pool.allocate() == b, "b reused after its fence");
+		check(pool.collect(100) == 1 && pool.allocate() == a, "a reused after its fence");
+		check(pool.allocate() == umax, "full again");
+
+		// Out-of-order fences are all collected
+		pool.release(c, 30);
+		pool.release(d, 20);
+		check(pool.collect(25) == 1 && pool.allocate() == d, "the earlier fence first, whatever the release order");
+		check(pool.collect(30) == 1 && pool.allocate() == c, "the later fence next");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	// A reference model of the Vulkan renderer on per-command-buffer host queries (VKGSRender.cpp, RPCS3_IOS variant):
+	// each index has a value and an availability; is_current = the query's last command buffer is still recording.
+	struct vk_query
+	{
+		u32 value = 0;
+		u64 fence = 0;
+	};
+
+	bool vk_check(const std::vector<vk_query>& indices, bool is_current, u64 completed, bool precise)
+	{
+		if (indices.empty()) return true;
+		if (is_current) return false;
+		for (const auto& index : indices)
+		{
+			if (index.fence > completed) return false;
+			if (!precise && index.value) return true;
+		}
+		return true;
+	}
+
+	u32 vk_gather(const std::vector<vk_query>& indices, bool precise)
+	{
+		u32 result = 0;
+		for (const auto& index : indices)
+		{
+			result += index.value;
+			if (result && !precise) break;
+		}
+		return result;
+	}
+
+	void test_query_rules()
+	{
+		std::map<u32, u64> values;  // slot -> value
+		const auto read = [&](u32 slot) { return values[slot]; };
+
+		occlusion_record record{};
+		check(occlusion_ready(record, 10, 10, false, read), "no data: ready");
+		check(occlusion_gather(record, false, [](u64) {}, read) == 0, "no data: 0");
+
+		record.has_data = true;
+		record.segments = { { 0, 5 }, { 1, 6 } };
+		record.last_fence = 6;
+		values = { { 0, 0 }, { 1, 12 } };
+		check(!occlusion_ready(record, 5, 5, false, read), "last segment in the open command buffer: not ready");
+		check(!occlusion_ready(record, 6, 5, false, read), "second segment not complete: not ready");
+		check(occlusion_ready(record, 6, 6, false, read), "all complete: ready");
+
+		values = { { 0, 3 }, { 1, 12 } };
+		check(occlusion_ready(record, 6, 5, false, read), "first segment complete with samples: ready (non-precise)");
+		check(!occlusion_ready(record, 6, 5, true, read), "precise needs every segment");
+
+		u64 waited = 0;
+		const auto wait = [&](u64 fence) { waited = std::max(waited, fence); };
+		check(occlusion_gather(record, false, wait, read) == 3 && waited == 5, "non-precise stops at the first hit, waits only for it");
+		waited = 0;
+		check(occlusion_gather(record, true, wait, read) == 15 && waited == 6, "precise sums all, waits for all");
+
+		// 32-bit results, as Vulkan's
+		values = { { 0, 0x1'0000'0002ull }, { 1, 0xFFFF'FFFFull } };
+		check(occlusion_gather(record, true, wait, read) == 1u, "32-bit wrap of the sum", occlusion_gather(record, true, wait, read));
+
+		// Random records: the model and the implementation agree, and folding changes nothing.
+		std::mt19937_64 rng(902);
+		for (int iteration = 0; iteration < 20000; ++iteration)
+		{
+			const bool precise = rng() & 1;
+			const usz count = rng() % 6;
+			std::vector<vk_query> model;
+			occlusion_record r{};
+			std::map<u32, u64> slot_values;
+			u64 fence = 1 + rng() % 3;
+			for (usz n = 0; n < count; ++n)
+			{
+				fence += rng() % 3;  // never decreases
+				const u32 value = (rng() % 3 == 0) ? static_cast<u32>(rng() % 50) : 0;
+				model.push_back({ value, fence });
+				r.segments.push_back({ static_cast<u32>(n), fence });
+				slot_values[static_cast<u32>(n)] = value;
+			}
+			r.has_data = count > 0;
+			r.last_fence = count ? fence : 0;
+			const auto rd = [&](u32 slot) { return slot_values.at(slot); };
+
+			const u64 last_submitted = fence + (rng() % 2) - (count && (rng() % 4 == 0) ? 1 : 0);
+			const u64 completed = std::min<u64>(last_submitted, rng() % (fence + 2));
+			const bool is_current = r.last_fence > last_submitted;
+
+			const bool expected_ready = vk_check(model, is_current, completed, precise);
+			check(occlusion_ready(r, last_submitted, completed, precise, rd) == expected_ready, "ready matches the Vulkan model", iteration);
+			const u32 expected_value = vk_gather(model, precise);
+			check(occlusion_gather(r, precise, [](u64) {}, rd) == expected_value, "gather matches the Vulkan model", iteration);
+
+			// Fold at an earlier completion point, then ask again at the same and at a later point.
+			occlusion_record folded = r;
+			std::vector<std::pair<u32, u64>> released;
+			const u64 fold_point = std::min<u64>(completed, rng() % (fence + 2));
+			fold_completed(folded, fold_point, precise, rd, [&](u32 slot, u64 f) { released.emplace_back(slot, f); });
+			check(released.size() + folded.segments.size() == r.segments.size(), "every segment is either kept or released once", iteration);
+			std::set<u32> unique_slots;
+			for (const auto& [slot, f] : released) unique_slots.insert(slot);
+			for (const auto& s : folded.segments) unique_slots.insert(s.slot);
+			check(unique_slots.size() == r.segments.size(), "no slot released twice", iteration);
+			for (const auto& [slot, f] : released)
+			{
+				check(f == r.segments[slot].fence, "a slot is released with its own fence", iteration);
+			}
+
+			check(occlusion_ready(folded, last_submitted, completed, precise, rd) == expected_ready, "folding keeps readiness", iteration);
+			check(occlusion_ready(folded, last_submitted, last_submitted, precise, rd) ==
+				vk_check(model, is_current, last_submitted, precise), "folding keeps readiness later", iteration);
+			check(occlusion_gather(folded, precise, [](u64) {}, rd) == expected_value, "folding keeps the value", iteration);
+		}
+	}
