--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLBlit.cpp
@@ -0,0 +1,722 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M3.2): image transfers (VKTexture.cpp copy_image / copy_image_typeless / copy_scaled_image,
+// vk::blitter::scale_image counterparts). See MTLBlit.h.
+
+#include "stdafx.h"
+#include "MTLBlit.h"
+#include "MTLCommandContext.h"
+#include "MTLRenderTargets.h"
+
+#include "util/asm.hpp"
+
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		blit_engine* g_blit_engine = nullptr;
+
+		// The Vulkan blit: u = srcX0 + (x + 0.5 - dstX0) * (srcX1 - srcX0) / (dstX1 - dstX0), in texels, clamp to edge.
+		// [[position]] is the pixel centre (x + 0.5, y + 0.5) of the attachment.
+		constexpr std::string_view blit_source = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct blit_params
+{
+	float2 src_origin;
+	float2 scale;
+	float2 dst_origin;
+	float2 reserved;
+};
+
+struct blit_vertex_out
+{
+	float4 position [[position]];
+};
+
+vertex blit_vertex_out blit_vertex(uint vid [[vertex_id]])
+{
+	blit_vertex_out out;
+	out.position = float4((vid & 1u) ? 1.0 : -1.0, (vid & 2u) ? 1.0 : -1.0, 0.0, 1.0);
+	return out;
+}
+
+constexpr sampler blit_nearest_sampler(coord::pixel, filter::nearest, address::clamp_to_edge);
+constexpr sampler blit_linear_sampler(coord::pixel, filter::linear, address::clamp_to_edge);
+
+inline float2 blit_coord(float4 position, constant blit_params& p)
+{
+	return p.src_origin + (position.xy - p.dst_origin) * p.scale;
+}
+
+fragment float4 blit_nearest(blit_vertex_out in [[stage_in]], texture2d<float> src [[texture(0)]], constant blit_params& p [[buffer(0)]])
+{
+	return src.sample(blit_nearest_sampler, blit_coord(in.position, p));
+}
+
+fragment float4 blit_linear(blit_vertex_out in [[stage_in]], texture2d<float> src [[texture(0)]], constant blit_params& p [[buffer(0)]])
+{
+	return src.sample(blit_linear_sampler, blit_coord(in.position, p));
+}
+
+// Integer formats (no filtering: the Vulkan blit of an integer format is VK_FILTER_NEAREST): the texel floor(u) of the
+// unnormalized coordinate, clamped to the image (clamp to edge), read as it is.
+inline uint2 blit_nearest_texel(float4 position, constant blit_params& p, uint width, uint height)
+{
+	const float2 texel = clamp(floor(blit_coord(position, p)), float2(0.0), float2(float(width), float(height)) - 1.0);
+	return uint2(texel);
+}
+
+fragment uint4 blit_nearest_uint(blit_vertex_out in [[stage_in]], texture2d<uint, access::read> src [[texture(0)]], constant blit_params& p [[buffer(0)]])
+{
+	return src.read(blit_nearest_texel(in.position, p, src.get_width(), src.get_height()));
+}
+
+fragment int4 blit_nearest_sint(blit_vertex_out in [[stage_in]], texture2d<int, access::read> src [[texture(0)]], constant blit_params& p [[buffer(0)]])
+{
+	return src.read(blit_nearest_texel(in.position, p, src.get_width(), src.get_height()));
+}
+)";
+
+		struct blit_params
+		{
+			f32 src_origin[2];
+			f32 scale[2];
+			f32 dst_origin[2];
+			f32 reserved[2];
+		};
+
+		data_heap& staging_heap()
+		{
+			return *ensure(get_upload_heap(), "Metal: no upload heap for transfers");
+		}
+
+		// The values a colour format holds, as a blit reads and writes them (Vulkan: a blit converts between float and
+		// normalized formats; integer formats only blit to the same kind of integer format, with VK_FILTER_NEAREST).
+		enum class blit_values : u8
+		{
+			none,      // not a colour format a render pass writes: depth, stencil (copy_scaled_image's carriers), compressed
+			floating,  // normalized and float formats: sampled with the requested filter, written as float4
+			uint_,     // read (nearest) and written as uint4
+			sint_,     // read (nearest) and written as int4
+		};
+
+		blit_values get_blit_values(pixel_format format)
+		{
+			switch (format)
+			{
+			case pixel_format::r8_uint: case pixel_format::r16_uint: case pixel_format::r32_uint: case pixel_format::rg32_uint:
+			case pixel_format::rgba8_uint: case pixel_format::rgba16_uint: case pixel_format::rgba32_uint:
+				return blit_values::uint_;
+			case pixel_format::r32_sint:
+				return blit_values::sint_;
+			case pixel_format::stencil8: case pixel_format::x32_stencil8:
+				return blit_values::none;
+			default:
+				return (!is_compressed_format(format) && !is_depth_format(format) && get_texel_size(format) != 0) ? blit_values::floating : blit_values::none;
+			}
+		}
+
+		// The region of an area (flips removed).
+		struct abs_rect
+		{
+			u32 x, y, w, h;
+		};
+
+		abs_rect absolute(const areai& area)
+		{
+			return { static_cast<u32>(std::min(area.x1, area.x2)), static_cast<u32>(std::min(area.y1, area.y2)),
+				static_cast<u32>(area.width()), static_cast<u32>(area.height()) };
+		}
+
+		bool inside(const abs_rect& r, u32 w, u32 h)
+		{
+			return r.w && r.h && u64{r.x} + r.w <= w && u64{r.y} + r.h <= h;
+		}
+
+		u32 level_width(const image& img, u32 level) { return std::max(img.width() >> level, 1u); }
+		u32 level_height(const image& img, u32 level) { return std::max(img.height() >> level, 1u); }
+
+		// The copy-compatible source of a bit-compatible copy: the texture itself, or a view in dst's format.
+		const object* copy_source(image* src, image* dst)
+		{
+			if (src->format() == dst->format())
+			{
+				return &src->texture;
+			}
+
+			const auto raw = rsx::default_remap_vector.with_encoding(remap_identity_raw);
+			auto view = src->get_view(dst->format(), default_component_map, src->aspect(),
+				view_key(src->native_component_map, raw, src->aspect(), dst->format()));
+			return view ? &view->handle() : nullptr;
+		}
+	}
+
+	// M4: a multisampled image is never copied, sampled or written by a transfer: its surface's resolve image is (VK
+	// render_target::get_surface). Reaching one means the resolve image could not be made or resolved (counted there).
+	bool transferable(const image* src, const image* dst)
+	{
+		if (src->samples() > 1 || dst->samples() > 1)
+		{
+			get_texture_counters().typeless_not_implemented++;
+			log_once("transfer-msaa", "transfer of a multisampled image without its resolve image refused");
+			return false;
+		}
+		return true;
+	}
+
+	void set_blit_engine(blit_engine* engine)
+	{
+		g_blit_engine = engine;
+	}
+
+	blit_engine* get_blit_engine()
+	{
+		return g_blit_engine;
+	}
+
+	// blit_engine
+
+	bool blit_engine::create(const object& device, const object& compiler, bool float32_filtering, std::string& error)
+	{
+		m_device = device;
+		m_compiler = compiler;
+		m_float32_filtering = float32_filtering;
+		m_pipelines.init(compiler);  // M4
+		m_library = compile_library(compiler, blit_source, error);
+		m_table = new_argument_table(device, 1, 1, 1);
+		return m_library && m_table;
+	}
+
+	void blit_engine::destroy()
+	{
+		m_helpers.clear();
+		m_pipelines.clear();
+		m_table.reset();
+		m_library.reset();
+		m_compiler.reset();
+		m_device.reset();
+	}
+
+	const object& blit_engine::get_pipeline(pixel_format format, blit_filter filter)
+	{
+		// M4: the transfer pipeline cache (MTLTransferPass.h)
+		const u64 key = static_cast<u64>(format) | (static_cast<u64>(filter) << 32);
+		const blit_values values = get_blit_values(format);
+		return m_pipelines.get(key, [&](render_pipeline_descriptor& desc)
+		{
+			desc.library = m_library;
+			desc.vertex_function = "blit_vertex";
+			desc.fragment_function = (values == blit_values::uint_) ? "blit_nearest_uint" :
+				(values == blit_values::sint_) ? "blit_nearest_sint" :
+				(filter == blit_filter::linear) ? "blit_linear" : "blit_nearest";
+			desc.color[0].format = format;
+			desc.label = "RSX blit";
+		}, [&](const render_pipeline_descriptor&, const std::string& error)
+		{
+			log_once("blit-pipeline", fmt::format("blit pipeline for format %u: %s", static_cast<u32>(format), error));
+		});
+	}
+
+	image* blit_engine::get_typeless_helper(command_context& ctx, pixel_format format, rsx::format_class format_class, u32 w, u32 h, u32 index)
+	{
+		const u64 key = static_cast<u64>(format) | (static_cast<u64>(index) << 32);
+		auto& helper = m_helpers[key];
+		if (helper && helper->width() >= w && helper->height() >= h)
+		{
+			helper->image_format_class = format_class;
+			return helper.get();
+		}
+
+		// Grows like VK's typeless helpers; the old one is released once the work recorded so far completed.
+		const u32 new_w = std::max(w, helper ? helper->width() : 0u);
+		const u32 new_h = std::max(h, helper ? helper->height() : 0u);
+		texture_descriptor desc{};
+		desc.type = texture_type::type_2d;
+		desc.format = format;
+		desc.width = std::max(new_w, 1u);
+		desc.height = std::max(new_h, 1u);
+		desc.usage = usage_shader_read | usage_pixel_format_view | usage_render_target;
+		desc.storage = storage_mode::private_;
+
+		auto created = std::make_unique<image>();
+		if (!created->create(ctx, desc, format_class))
+		{
+			return nullptr;
+		}
+		created->set_name("typeless helper");
+		helper = std::move(created);
+		return helper.get();
+	}
+
+	bool blit_engine::blit(command_context& ctx, const image& src, const areai& src_area, const image& dst, u32 dst_level, u32 dst_slice, u32 dst_z,
+		const areai& dst_area, blit_filter filter)
+	{
+		auto& counters = get_texture_counters();
+		const auto s = absolute(src_area);
+		const auto d = absolute(dst_area);
+
+		const blit_values values = get_blit_values(dst.format());
+		if (&src == &dst || values == blit_values::none || !(dst.usage & usage_render_target) || src.aspect() != aspect_color ||
+			get_blit_values(src.format()) != values ||  // Vulkan: integer formats blit only to the same kind of integer format
+			src.samples() > 1 || dst.samples() > 1)  // M4: multisampled images are transferred through their resolve images
+		{
+			// (A render pass cannot sample the texture it renders to; depth and stencil go through copy_scaled_image's
+			// carriers; a compressed destination cannot be rendered, nor blitted by Vulkan.)
+			counters.scaled_not_implemented++;
+			log_once("blit-format", fmt::format("scaled transfer %u -> %u cannot be rendered (format or usage)", static_cast<u32>(src.format()), static_cast<u32>(dst.format())));
+			return false;
+		}
+
+		if (dst_area.is_flipped() || !inside(s, src.width(), src.height()) || !inside(d, level_width(dst, dst_level), level_height(dst, dst_level)))
+		{
+			rsx_log.error("Metal: blit request refused: the regions do not fit (src %d,%d-%d,%d of %ux%u, dst %d,%d-%d,%d of %ux%u)",
+				src_area.x1, src_area.y1, src_area.x2, src_area.y2, src.width(), src.height(),
+				dst_area.x1, dst_area.y1, dst_area.x2, dst_area.y2, level_width(dst, dst_level), level_height(dst, dst_level));
+			return false;
+		}
+
+		if (filter == blit_filter::linear && values != blit_values::floating)
+		{
+			// Integer formats are not filtered (Vulkan requires VK_FILTER_NEAREST for them).
+			filter = blit_filter::nearest;
+			counters.filters_downgraded++;
+		}
+
+		if (filter == blit_filter::linear && is_float32_format(src.format()) && !m_float32_filtering)
+		{
+			// Metal cannot filter 32-bit floats on this device.
+			filter = blit_filter::nearest;
+			counters.filters_downgraded++;
+		}
+
+		const auto& pipeline = get_pipeline(dst.format(), filter);
+		if (!pipeline)
+		{
+			counters.scaled_not_implemented++;
+			return false;
+		}
+
+		// Parameters first: the ring may make room by submitting, which ends any open encoder.
+		auto params = allocate_staging(ctx, staging_heap(), sizeof(blit_params));
+		blit_params p{};
+		p.src_origin[0] = static_cast<f32>(src_area.x1);
+		p.src_origin[1] = static_cast<f32>(src_area.y1);
+		p.scale[0] = blit_scale(src_area.x1, src_area.x2, dst_area.x1, dst_area.x2);
+		p.scale[1] = blit_scale(src_area.y1, src_area.y2, dst_area.y1, dst_area.y2);
+		p.dst_origin[0] = static_cast<f32>(dst_area.x1);
+		p.dst_origin[1] = static_cast<f32>(dst_area.y1);
+		std::memcpy(params.data, &p, sizeof(p));
+
+		render_pass_descriptor pass{};
+		pass.color[0].texture = dst.texture;
+		pass.color[0].level = dst_level;
+		pass.color[0].slice = dst_slice;
+		pass.color[0].depth_plane = dst_z;
+		pass.color[0].load = load_action::load;
+		pass.color[0].store = store_action::store;
+		pass.render_target_width = level_width(dst, dst_level);
+		pass.render_target_height = level_height(dst, dst_level);
+
+		table_set_buffer(m_table, params.buffer, params.offset, 0);
+		table_set_texture(m_table, src.texture, 0);
+		draw_transfer_quad(ctx, pass, "RSX blit", pipeline, nullptr, m_table, stage_vertex | stage_fragment, d.x, d.y, d.w, d.h);  // M4
+
+		counters.scaled_copies++;
+		return true;
+	}
+
+	// Transfers
+
+	namespace
+	{
+		bool copy_image_impl(transfer_scope& scope, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+		{
+			auto& counters = get_texture_counters();
+			if (src_area.is_flipped() || dst_area.is_flipped() || src_area.width() != dst_area.width() || src_area.height() != dst_area.height())
+			{
+				return false;
+			}
+
+			if (!transferable(src, dst))  // M4
+			{
+				return false;
+			}
+
+			const auto s = absolute(src_area);
+			const auto d = absolute(dst_area);
+			if (!inside(s, src->width(), src->height()) || !inside(d, level_width(*dst, dst_level), level_height(*dst, dst_level)))
+			{
+				rsx_log.error("Metal: copy request refused: the regions do not fit");
+				return false;
+			}
+
+			// One bit layout: the same format, or colour formats of one texel size (vkCmdCopyImage copies the bits of
+			// size-compatible formats).
+			const bool same = src->format() == dst->format();
+			const bool size_compatible = src->aspect() == aspect_color && dst->aspect() == aspect_color &&
+				!is_compressed_format(src->format()) && !is_compressed_format(dst->format()) &&
+				get_texel_size(src->format()) != 0 && get_texel_size(src->format()) == get_texel_size(dst->format());
+			if (!same && !size_compatible)
+			{
+				return false;
+			}
+
+			if (is_compressed_format(src->format()))
+			{
+				const bool aligned = !(s.x % 4) && !(s.y % 4) && !(d.x % 4) && !(d.y % 4) &&
+					((s.w % 4) == 0 || s.x + s.w == src->width()) && ((s.h % 4) == 0 || s.y + s.h == src->height());
+				if (!aligned)
+				{
+					counters.typeless_not_implemented++;
+					log_once("copy-compressed", "unaligned block-compressed region copy is not implemented");
+					return false;
+				}
+			}
+
+			const object* source = copy_source(src, dst);
+			if (!source)
+			{
+				counters.typeless_not_implemented++;
+				return false;
+			}
+
+			if (src == dst && texture_box::make(0, 0, s.x, s.y, 0, s.w, s.h).overlaps(texture_box::make(dst_level, dst_slice, d.x, d.y, dst_z, d.w, d.h)))
+			{
+				counters.typeless_not_implemented++;
+				log_once("copy-self", "overlapping copy of a texture onto itself is not implemented");
+				return false;
+			}
+
+			const auto& encoder = scope.encoder(&src->texture, texture_box::make(0, 0, s.x, s.y, 0, s.w, s.h),
+				&dst->texture, texture_box::make(dst_level, dst_slice, d.x, d.y, dst_z, d.w, d.h));
+			copy_texture(encoder, *source, 0, 0, { { s.x, s.y, 0 }, { s.w, s.h, 1 } }, dst->texture, dst_slice, dst_level, { d.x, d.y, dst_z });
+			counters.copies++;
+			if (!same)
+			{
+				counters.typeless_copies++;
+			}
+			return true;
+		}
+
+	}
+
+	bool copy_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+	{
+		transfer_scope scope(ctx, "image copy");
+		return copy_image_impl(scope, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+	}
+
+	bool copy_image(transfer_scope& scope, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+	{
+		return copy_image_impl(scope, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+	}
+
+	// M4: copy_image_typeless is in MTLTypelessCopy.cpp (VK's selection: the conversion kernels or the bits as they are).
+
+	bool copy_scaled_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level, u32 dst_slice, u32 dst_z, bool compatible_formats, blit_filter filter)
+	{
+		auto& counters = get_texture_counters();
+		blit_engine* engine = get_blit_engine();
+		compatible_formats |= (src->format() == dst->format());
+
+		if (!transferable(src, dst))  // M4
+		{
+			return false;
+		}
+
+		if (compatible_formats && !src_area.is_flipped() && !dst_area.is_flipped() &&
+			src_area.width() == dst_area.width() && src_area.height() == dst_area.height())
+		{
+			return copy_image(ctx, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+		}
+
+		if (!engine)
+		{
+			counters.scaled_not_implemented++;
+			return false;
+		}
+
+		// VKTexture.cpp copy_scaled_image: the bits of the source region go into a helper of the destination's format
+		// (copy_image_typeless, counted there when refused), which is then scaled into the destination in that format.
+		const auto scale_through_typeless = [&]() -> bool
+		{
+			const auto s = absolute(src_area);
+			image* const typeless = engine->get_typeless_helper(ctx, dst->format(), dst->format_class(), s.w, s.h, 5);
+			if (!typeless)
+			{
+				counters.scaled_not_implemented++;
+				return false;
+			}
+
+			areai helper_area = { 0, 0, static_cast<s32>(s.w), static_cast<s32>(s.h) };
+			const areai source_box = { static_cast<s32>(s.x), static_cast<s32>(s.y), static_cast<s32>(s.x + s.w), static_cast<s32>(s.y + s.h) };
+			if (!copy_image_typeless(ctx, src, typeless, source_box, helper_area))
+			{
+				return false;
+			}
+
+			// The flip happens in the scaling step, as for the carriers below.
+			if (src_area.x1 > src_area.x2) helper_area.flip_horizontal();
+			if (src_area.y1 > src_area.y2) helper_area.flip_vertical();
+			return copy_scaled_image(ctx, typeless, dst, helper_area, dst_area, dst_level, dst_slice, dst_z, true, filter);
+		};
+
+		if (src->aspect() == aspect_color)
+		{
+			if (dst->aspect() != aspect_color)
+			{
+				// Colour into depth or stencil: a Vulkan blit needs matching aspects, so the reinterpretation comes first
+				// (VK's order for a format mismatch below), then the scaling in the depth format (bits, never values).
+				return scale_through_typeless();
+			}
+
+			// vkCmdBlitImage: sampled and written as values (formats converted).
+			return engine->blit(ctx, *src, src_area, *dst, dst_level, dst_slice, dst_z, dst_area, filter);
+		}
+
+		// Depth and stencil (VKTexture.cpp copy_scaled_image): a format mismatch (a depth float mismatch, or a colour
+		// destination) needs a typeless conversion first ("format width should be equal RSX-side").
+		if (src->format() != dst->format())
+		{
+			return scale_through_typeless();
+		}
+
+		if (dst_area.is_flipped())
+		{
+			rsx_log.error("Metal: flipped depth blit destination refused");
+			return false;
+		}
+
+		const auto s = absolute(src_area);
+		const auto d = absolute(dst_area);
+		if (!inside(s, src->width(), src->height()) || !inside(d, level_width(*dst, dst_level), level_height(*dst, dst_level)))
+		{
+			rsx_log.error("Metal: depth blit refused: the regions do not fit");
+			return false;
+		}
+
+		// The carriers of the Vulkan renderer's 'safe' transport (bits, never values: no float interpolation of
+		// depth across a format change).
+		struct plane
+		{
+			u32 options;
+			pixel_format carrier;
+			u32 bpp;
+		};
+
+		plane planes[2]{};
+		u32 plane_count = 0;
+		switch (src->format())
+		{
+		case pixel_format::depth16_unorm:
+			planes[plane_count++] = { blit_none, pixel_format::r16_unorm, 2 };
+			break;
+		case pixel_format::depth32_float:
+			planes[plane_count++] = { blit_none, pixel_format::r32_float, 4 };
+			break;
+		case pixel_format::depth32_float_stencil8:
+			planes[plane_count++] = { blit_depth_from_depth_stencil, pixel_format::bgra8_unorm, 4 };
+			planes[plane_count++] = { blit_stencil_from_depth_stencil, pixel_format::r8_unorm, 1 };
+			break;
+		case pixel_format::stencil8:
+			// A stencil image: its one plane through the stencil carrier (VK's typeless_stencil, R8_UNORM).
+			planes[plane_count++] = { blit_none, pixel_format::r8_unorm, 1 };
+			break;
+		default:
+			counters.scaled_not_implemented++;
+			return false;
+		}
+
+		// The carrier region keeps the source's orientation; the flip happens in the scaling step.
+		areai carrier_src = { 0, 0, static_cast<s32>(s.w), static_cast<s32>(s.h) };
+		if (src_area.x1 > src_area.x2) carrier_src.flip_horizontal();
+		if (src_area.y1 > src_area.y2) carrier_src.flip_vertical();
+		const areai carrier_dst = { 0, 0, static_cast<s32>(d.w), static_cast<s32>(d.h) };
+
+		for (u32 i = 0; i < plane_count; ++i)
+		{
+			const auto& pl = planes[i];
+			image* from = engine->get_typeless_helper(ctx, pl.carrier, rsx::RSX_FORMAT_CLASS_COLOR, s.w, s.h, 2);
+			image* to = engine->get_typeless_helper(ctx, pl.carrier, rsx::RSX_FORMAT_CLASS_COLOR, d.w, d.h, 3);
+			if (!from || !to)
+			{
+				counters.scaled_not_implemented++;
+				return false;
+			}
+
+			const u32 src_row = s.w * pl.bpp;
+			const u32 dst_row = d.w * pl.bpp;
+			const u64 src_bytes = utils::align<u64>(u64{src_row} * s.h, 256);
+			auto staging = allocate_staging(ctx, staging_heap(), src_bytes + u64{dst_row} * d.h);
+			{
+				// 1. The plane's bits into the source carrier.
+				transfer_scope scope(ctx, "depth blit (in)");
+				copy_texture_to_buffer(scope.for_read(src->texture, texture_box::make(0, 0, s.x, s.y, 0, s.w, s.h)), src->texture, 0, 0,
+					{ { s.x, s.y, 0 }, { s.w, s.h, 1 } }, staging.buffer, staging.offset, src_row, 0, pl.options);
+				scope.split();
+				copy_buffer_to_texture(scope.for_write(from->texture, texture_box::make(0, 0, 0, 0, 0, s.w, s.h)), staging.buffer, staging.offset,
+					src_row, 0, { s.w, s.h, 1 }, from->texture, 0, 0, {});
+			}
+
+			// 2. Scaled from carrier to carrier.
+			if (!engine->blit(ctx, *from, carrier_src, *to, 0, 0, 0, carrier_dst, filter))
+			{
+				return false;
+			}
+
+			{
+				// 3. The bits back into the destination plane.
+				transfer_scope scope(ctx, "depth blit (out)");
+				copy_texture_to_buffer(scope.for_read(to->texture, texture_box::make(0, 0, 0, 0, 0, d.w, d.h)), to->texture, 0, 0,
+					{ { 0, 0, 0 }, { d.w, d.h, 1 } }, staging.buffer, staging.offset + src_bytes, dst_row, 0);
+				scope.split();
+				copy_buffer_to_texture(scope.for_write(dst->texture, texture_box::make(dst_level, dst_slice, d.x, d.y, dst_z, d.w, d.h)), staging.buffer,
+					staging.offset + src_bytes, dst_row, 0, { d.w, d.h, 1 }, dst->texture, dst_slice, dst_level, { d.x, d.y, dst_z }, pl.options);
+			}
+		}
+
+		counters.depth_scaled_copies++;
+		return true;
+	}
+
+	bool blitter::scale_image(command_context& cmd, image* src, image* dst, areai src_area, areai dst_area, bool interpolate, const rsx::typeless_xfer& xfer_info)
+	{
+		// vk::blitter::scale_image
+		image* real_src = src;
+		image* real_dst = dst;
+		auto& counters = get_texture_counters();
+		blit_engine* engine = get_blit_engine();
+		if (!src || !dst)
+		{
+			return false;
+		}
+
+		// Optimization pass; check for pass-through data transfer
+		if (!xfer_info.flip_horizontal && !xfer_info.flip_vertical && src_area.height() == dst_area.height())
+		{
+			auto src_w = src_area.width();
+			auto dst_w = dst_area.width();
+
+			if (xfer_info.src_is_typeless) src_w = static_cast<int>(src_w * xfer_info.src_scaling_hint);
+			if (xfer_info.dst_is_typeless) dst_w = static_cast<int>(dst_w * xfer_info.dst_scaling_hint);
+
+			if (src_w == dst_w)
+			{
+				// Final dimensions are a match
+				if (xfer_info.src_is_typeless || xfer_info.dst_is_typeless)
+				{
+					return copy_image_typeless(cmd, src, dst, src_area, dst_area);
+				}
+
+				if (!copy_image(cmd, src, dst, src_area, dst_area))
+				{
+					counters.typeless_not_implemented++;
+					log_once("blit-copy", fmt::format("unscaled blit %u -> %u has no bit-compatible copy", static_cast<u32>(src->format()), static_cast<u32>(dst->format())));
+					return false;
+				}
+				return true;
+			}
+		}
+
+		const bool supports_bc = false; // the typeless formats of the blit engine are never block-compressed
+		if (xfer_info.src_is_typeless)
+		{
+			const auto format = xfer_info.src_native_format_override ?
+				static_cast<pixel_format>(xfer_info.src_native_format_override) :
+				get_compatible_sampler_format(xfer_info.src_gcm_format, supports_bc);
+
+			if (format != src->format())
+			{
+				// Normalize input region (memory optimization)
+				const auto old_src_area = src_area;
+				src_area.y2 -= src_area.y1;
+				src_area.y1 = 0;
+				src_area.x2 = static_cast<int>(src_area.width() * xfer_info.src_scaling_hint);
+				src_area.x1 = 0;
+
+				// Transfer bits from src to typeless src
+				real_src = engine ? engine->get_typeless_helper(cmd, format, rsx::classify_format(xfer_info.src_gcm_format), src_area.width(), src_area.height(), 0) : nullptr;
+				if (!real_src || !copy_image_typeless(cmd, src, real_src, old_src_area, src_area))
+				{
+					return false;
+				}
+			}
+		}
+
+		// Save output region descriptor
+		const auto old_dst_area = dst_area;
+
+		if (xfer_info.dst_is_typeless)
+		{
+			const auto format = xfer_info.dst_native_format_override ?
+				static_cast<pixel_format>(xfer_info.dst_native_format_override) :
+				get_compatible_sampler_format(xfer_info.dst_gcm_format, supports_bc);
+
+			if (format != dst->format())
+			{
+				// Normalize output region (memory optimization). A distinct helper from the source one (index 1):
+				// VK places both in one image, one below the other, which a Metal render pass cannot sample and write.
+				dst_area.y2 -= dst_area.y1;
+				dst_area.y1 = 0;
+				dst_area.x2 = static_cast<int>(dst_area.width() * xfer_info.dst_scaling_hint);
+				dst_area.x1 = 0;
+
+				real_dst = engine ? engine->get_typeless_helper(cmd, format, rsx::classify_format(xfer_info.dst_gcm_format), dst_area.width(), dst_area.height(), 1) : nullptr;
+				if (!real_dst)
+				{
+					return false;
+				}
+			}
+		}
+
+		// Checks
+		if (src_area.x2 <= src_area.x1 || src_area.y2 <= src_area.y1 || dst_area.x2 <= dst_area.x1 || dst_area.y2 <= dst_area.y1)
+		{
+			rsx_log.error("Blit request consists of an empty region descriptor!");
+			return false;
+		}
+
+		if (src_area.x1 < 0 || src_area.x2 > static_cast<s32>(real_src->width()) || src_area.y1 < 0 || src_area.y2 > static_cast<s32>(real_src->height()))
+		{
+			rsx_log.error("Blit request denied because the source region does not fit!");
+			return false;
+		}
+
+		if (dst_area.x1 < 0 || dst_area.x2 > static_cast<s32>(real_dst->width()) || dst_area.y1 < 0 || dst_area.y2 > static_cast<s32>(real_dst->height()))
+		{
+			rsx_log.error("Blit request denied because the destination region does not fit!");
+			return false;
+		}
+
+		if (xfer_info.flip_horizontal)
+		{
+			src_area.flip_horizontal();
+		}
+
+		if (xfer_info.flip_vertical)
+		{
+			src_area.flip_vertical();
+		}
+
+		// VK ensures matching aspects here ("Incompatible source and destination format!"): the common code makes the
+		// depth side typeless (reconcile_depth_color_typeless). Should they differ, copy_scaled_image reinterprets the
+		// bits into the destination's format before it scales them (formats are not bitcast compatible across aspects).
+		if (!copy_scaled_image(cmd, real_src, real_dst, src_area, dst_area, 0, 0, 0,
+			images_are_bitcast_compatible(real_src->format(), real_src->format_class(), real_dst->format(), real_dst->format_class()),
+			interpolate ? blit_filter::linear : blit_filter::nearest))
+		{
+			return false;
+		}
+
+		if (real_dst != dst)
+		{
+			return copy_image_typeless(cmd, real_dst, dst, dst_area, old_dst_area);
+		}
+
+		return true;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLBlit.h b/rpcs3/Emu/RSX/Metal/MTLBlit.h
new file mode 100644
index 0000000..f4f7bbc
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLBlit.h
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M3.2): image transfers of the native Metal 4 renderer, the counterparts of VKTexture.cpp's
+// copy_image, copy_image_typeless, copy_scaled_image and vk::blitter (the blit engine's scale_image).
+//
+// Unscaled transfers are compute-encoder copies (a view of the source in the destination's format for bit-compatible
+// formats, a buffer for reinterpretations without a byte shuffle). Scaled transfers are what vkCmdBlitImage is:
+// a render pass over the destination region whose fragments sample the source with the requested filter at
+//     u = srcX0 + (x + 0.5 - dstX0) * (srcX1 - srcX0) / (dstX1 - dstX0)
+// in unnormalized texel coordinates with clamp-to-edge addressing (the Vulkan blit definition, mirrored when a source
+// region is flipped). Integer formats are read at the nearest texel, floor(u) clamped to the image, and written as
+// integers (Vulkan blits them with VK_FILTER_NEAREST, between integer formats of one signedness only). Depth and
+// stencil are scaled as the Vulkan renderer does on MoltenVK-class drivers: each plane goes through a buffer into a
+// colour carrier (D16 -> R16Unorm, D32F -> R32Float, the D32F_S8 depth plane -> BGRA8, its stencil plane and stencil
+// images -> R8Unorm), the carrier is scaled, and the result goes back into the plane, bit for bit. A scaled transfer
+// between formats of different aspects or depth formats reinterprets the bits into the destination's format first
+// (copy_image_typeless into a helper), then scales them in that format, as VK copy_scaled_image does for a mismatch.
+//
+// M4: reinterpretations that need a GPU byte shuffle or depth <-> colour packing run on the conversion kernels
+// (copy_image_typeless, MTLTypelessCopy.cpp: the one typeless copy of the renderer). A multisampled surface is
+// transferred through its resolve image (MTLResolve.h); a multisampled image reaching a transfer (its resolve image
+// could not be made or resolved, counted there) is refused and counted. The render pipelines and the quad draw are the
+// ones the MSAA resolve passes use (MTLTransferPass.h).
+
+#include "MTLTexture.h"
+#include "MTLTransferPass.h"  // M4
+
+#include "Utilities/geometry.h"
+
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+namespace mtl
+{
+	class command_context;
+
+	enum class blit_filter : u8
+	{
+		nearest,
+		linear,
+	};
+
+	// The render pipelines and scratch images of the scaled transfers; owned by the renderer (RSX thread only).
+	class blit_engine
+	{
+	public:
+		bool create(const object& device, const object& compiler, bool float32_filtering, std::string& error);
+		void destroy();
+
+		// Scales src_area of a colour image (level 0, slice 0; flipped when x1 > x2 or y1 > y2) into dst_area of a
+		// level/slice/plane of a colour image. False (counted) when the destination cannot be rendered to, or when
+		// one side is an integer format and the other is not (an invalid Vulkan blit).
+		bool blit(command_context& ctx, const image& src, const areai& src_area, const image& dst, u32 dst_level, u32 dst_slice, u32 dst_z,
+			const areai& dst_area, blit_filter filter);
+
+		// A scratch colour image of at least w x h (VK get_typeless_helper). Index 0 and 1 are distinct images, so a
+		// transfer can scale from one to the other.
+		image* get_typeless_helper(command_context& ctx, pixel_format format, rsx::format_class format_class, u32 w, u32 h, u32 index = 0);
+
+	private:
+		const object& get_pipeline(pixel_format format, blit_filter filter);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		bool m_float32_filtering = false;
+		transfer_pipeline_cache m_pipelines;  // M4: shared with the MSAA resolve passes
+		std::unordered_map<u64, std::unique_ptr<image>> m_helpers;
+	};
+
+	void set_blit_engine(blit_engine* engine);
+	blit_engine* get_blit_engine();
+
+	// M4: false (counted, logged once) when either image is multisampled: transfers use resolve images.
+	bool transferable(const image* src, const image* dst);
+
+	// VKTexture.cpp copy_image: an unscaled, unflipped copy between formats of one bit layout. False (counted) when
+	// the formats or regions do not allow it.
+	bool copy_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level = 0, u32 dst_slice = 0, u32 dst_z = 0);
+	// The same in a caller's transfer scope (copies batched in one encoder where they do not overlap).
+	bool copy_image(transfer_scope& scope, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level = 0, u32 dst_slice = 0, u32 dst_z = 0);
+
+	// VKTexture.cpp copy_image_typeless: the bits of src_area reinterpreted in dst's format, through a buffer.
+	// M4: with VK's selection (MTLTypelessCopy.cpp): the byte shuffle get_format_convert_flags asks for and the depth
+	// packing of copy_image_to_buffer / copy_buffer_to_image run on the conversion kernels; otherwise the bits are
+	// copied as they are. False (counted, the destination unchanged) when it cannot be done exactly.
+	bool copy_image_typeless(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level = 0, u32 dst_slice = 0, u32 dst_z = 0);
+
+	// VKTexture.cpp copy_scaled_image: compatible_formats as there (an unscaled copy is used when possible).
+	bool copy_scaled_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level, u32 dst_slice, u32 dst_z, bool compatible_formats, blit_filter filter);
+
+	// vk::blitter: the blit engine's transfers (rsx::texture_cache::upload_scaled_image) and surface inheritance.
+	struct blitter
+	{
+		bool scale_image(command_context& cmd, image* src, image* dst, areai src_area, areai dst_area, bool interpolate, const rsx::typeless_xfer& xfer_info);
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommandContext.cpp b/rpcs3/Emu/RSX/Metal/MTLCommandContext.cpp
new file mode 100644
index 0000000..8c85384
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommandContext.cpp
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): command recording, submission, residency and deferred release.
+
+#include "stdafx.h"
+#include "MTLCommandContext.h"
+
+namespace mtl
+{
+	void command_context::create(const object& device, const object& queue, const object& event, const object& residency)
+	{
+		m_device = device;
+		m_queue = queue;
+		m_event = event;
+		m_residency = residency;
+	}
+
+	void command_context::destroy()
+	{
+		if (recording())
+		{
+			submit(false);
+		}
+
+		wait_idle();
+		collect();
+		{
+			std::lock_guard lock(m_release_lock);
+			m_releases.clear();
+		}
+		m_encoder.reset();
+		m_command_buffer.reset();
+		m_allocator.reset();
+		m_residency.reset();
+		m_event.reset();
+		m_queue.reset();
+		m_device.reset();
+	}
+
+	void command_context::begin(const object& allocator, std::string_view label)
+	{
+		ensure(!recording());
+		m_command_buffer = new_command_buffer(m_device);
+		ensure(m_command_buffer, "Metal: command buffer creation failed");
+		m_allocator = allocator;
+		begin_command_buffer(m_command_buffer, allocator, label);
+	}
+
+	const object& command_context::begin_render(const render_pass_descriptor& pass, u64 pass_id, std::string_view label)
+	{
+		ensure(recording());
+		end_encoder();
+
+		m_encoder = begin_render_pass(m_command_buffer, pass, label);
+		ensure(m_encoder, "Metal: render encoder creation failed");
+		barrier_after_queue_stages(m_encoder, barrier_all, barrier_all);
+		m_kind = encoder_kind::render;
+		m_render_pass_id = pass_id;
+		m_counters.encoders_render.fetch_add(1, std::memory_order_relaxed);
+		return m_encoder;
+	}
+
+	const object& command_context::compute(std::string_view label)
+	{
+		ensure(recording());
+		if (m_kind == encoder_kind::compute)
+		{
+			return m_encoder;
+		}
+
+		end_encoder();
+		m_encoder = begin_compute(m_command_buffer, label);
+		ensure(m_encoder, "Metal: compute encoder creation failed");
+		barrier_after_queue_stages(m_encoder, barrier_all, barrier_all);
+		m_kind = encoder_kind::compute;
+		m_counters.encoders_compute.fetch_add(1, std::memory_order_relaxed);
+		return m_encoder;
+	}
+
+	void command_context::end_encoder()
+	{
+		if (m_encoder)
+		{
+			end_encoding(m_encoder);
+			m_encoder.reset();
+		}
+
+		m_kind = encoder_kind::none;
+		m_render_pass_id = 0;
+	}
+
+	u64 command_context::submit(bool early, const object& drawable)
+	{
+		if (!recording())
+		{
+			return m_last_submitted;
+		}
+
+		end_encoder();
+		commit_residency();
+		end_command_buffer(m_command_buffer);
+		if (drawable)
+		{
+			wait_for_drawable(m_queue, drawable);
+		}
+		commit(m_queue, m_command_buffer);
+		signal_event(m_queue, m_event, ++m_last_submitted);
+		if (drawable)
+		{
+			signal_drawable(m_queue, drawable);
+		}
+		m_command_buffer.reset();
+		m_has_dma_transfer = false;
+
+		m_counters.submissions.fetch_add(1, std::memory_order_relaxed);
+		if (early)
+		{
+			m_counters.early_submissions.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		return m_last_submitted;
+	}
+
+	void command_context::submit_and_continue()
+	{
+		ensure(m_allocator);
+		submit(true);
+		begin(m_allocator, "RSX frame (after readback)");
+	}
+
+	void command_context::submit_and_wait()
+	{
+		ensure(m_allocator);
+		const u64 value = submit(true);
+		wait(value);
+		collect();
+		begin(m_allocator, "RSX frame (after readback)");
+	}
+
+	u64 command_context::completed() const
+	{
+		return m_event ? signaled_value(m_event) : m_last_submitted.load();
+	}
+
+	void command_context::wait(u64 value)
+	{
+		if (!m_event || completed() >= value)
+		{
+			return;
+		}
+
+		m_counters.waits.fetch_add(1, std::memory_order_relaxed);
+		u32 slow = 0;
+		while (!wait_signaled_value(m_event, value, 5000))
+		{
+			// Never abandoned: the frame's results are needed. Counted and logged so a GPU hang is visible.
+			m_counters.slow_waits.fetch_add(1, std::memory_order_relaxed);
+			rsx_log.error("Metal: GPU work %llu not complete after %u s (completed %llu)", value, ++slow * 5, completed());
+		}
+	}
+
+	void command_context::wait_idle()
+	{
+		wait(m_last_submitted);
+	}
+
+	void command_context::make_resident(const object& allocation)
+	{
+		if (allocation && m_residency)
+		{
+			residency_add(m_residency, allocation);
+			m_residency_dirty = true;
+		}
+	}
+
+	void command_context::commit_residency()
+	{
+		if (m_residency_dirty && m_residency)
+		{
+			residency_commit(m_residency);
+			m_residency_dirty = false;
+		}
+	}
+
+	void command_context::dispose(object resource, bool resident)
+	{
+		if (!resource)
+		{
+			return;
+		}
+
+		// The work being recorded will be submitted as m_last_submitted + 1. From another thread this may be one
+		// submission early or late; one more keeps it safe in both cases.
+		std::lock_guard lock(m_release_lock);
+		const u64 safe_after = m_last_submitted + 2;
+		m_releases.push_back({ std::move(resource), safe_after, resident });
+	}
+
+	void command_context::collect()
+	{
+		std::lock_guard lock(m_release_lock);
+		if (m_releases.empty())
+		{
+			return;
+		}
+
+		const u64 done = completed();
+		while (!m_releases.empty() && m_releases.front().safe_after <= done)
+		{
+			auto& entry = m_releases.front();
+			if (entry.resident && m_residency)
+			{
+				residency_remove(m_residency, entry.resource);
+				m_residency_dirty = true;
+			}
+			m_releases.pop_front();
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommandContext.h b/rpcs3/Emu/RSX/Metal/MTLCommandContext.h
new file mode 100644
index 0000000..76e844c
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommandContext.h
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): what the native Metal 4 renderer is recording into.
+//
+// One MTL4 command buffer is open at a time, on the current frame's allocator (a frame may submit several: an early
+// submission for a readback or a full ring starts the next one on the same allocator). At most one encoder is open.
+// Metal 4 does not track hazards: every new encoder starts with a queue barrier after all stages of earlier work
+// (conservative and correct; narrower barriers are an optimisation for later, measured on the iPhone).
+// Metal 4 command buffers do not retain resources either: anything released while the GPU may still read it goes
+// through dispose(), which keeps it (and its residency) until the submission that could use it has completed.
+
+#include "MTLAPI.h"
+
+#include <atomic>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace mtl
+{
+	class command_context
+	{
+	public:
+		enum class encoder_kind : u8
+		{
+			none,
+			render,
+			compute,
+		};
+
+		// Atomic: wait() also runs on guest threads (a readback written back while a fault is handled there).
+		struct counters_t
+		{
+			std::atomic<u64> submissions{0};
+			std::atomic<u64> early_submissions{0};
+			std::atomic<u64> waits{0};
+			std::atomic<u64> slow_waits{0};
+			std::atomic<u64> encoders_render{0};
+			std::atomic<u64> encoders_compute{0};
+		};
+
+		void create(const object& device, const object& queue, const object& event, const object& residency);
+		void destroy();
+
+		const object& device() const { return m_device; }
+
+		// Recording
+		bool recording() const { return !!m_command_buffer; }
+		void begin(const object& allocator, std::string_view label);
+		const object& command_buffer() const { return m_command_buffer; }
+
+		// Encoders
+		encoder_kind kind() const { return m_kind; }
+		const object& encoder() const { return m_encoder; }
+		u64 render_pass_id() const { return m_render_pass_id; }
+		const object& begin_render(const render_pass_descriptor& pass, u64 pass_id, std::string_view label);
+		const object& compute(std::string_view label);
+		void end_encoder();
+
+		// Submission: ends the open encoder and the command buffer, commits it and signals the next event value.
+		// With a drawable, the queue waits for it before the work and signals it after (Metal 4 presentation).
+		u64 submit(bool early, const object& drawable = {});
+		// An early submission within the frame, waited for, then recording resumes on the same allocator (texture
+		// readbacks, VK's cleanup_after_dma_transfers). The open encoder, if any, is ended.
+		void submit_and_wait();
+		// An early submission within the frame, then recording resumes on the same allocator (no wait).
+		void submit_and_continue();
+		// The submission value the work being recorded will get (what a readback recorded now waits for).
+		u64 recording_value() const { return m_last_submitted + (recording() ? 1 : 0); }
+		// Set when a GPU -> guest memory copy was recorded and not submitted yet (VK cb_has_dma_transfer). Read by
+		// guest threads, which must never wait for such a copy (MTLGSRender::on_access_violation).
+		bool has_dma_transfer() const { return m_has_dma_transfer.load(); }
+		void set_dma_transfer() { m_has_dma_transfer = true; }
+		u64 last_submitted() const { return m_last_submitted; }
+		u64 completed() const;
+		// Waits for a submitted value. The wait is never abandoned: waits longer than 5 s are counted and logged.
+		void wait(u64 value);
+		void wait_idle();
+
+		// Residency of the renderer's allocations (rings, surfaces, textures).
+		void make_resident(const object& allocation);
+		void commit_residency();
+
+		// Deferred release: kept until the work recorded so far has completed. Thread-safe (a texture cache section
+		// may be destroyed by an invalidation on a faulting guest thread).
+		void dispose(object resource, bool resident);
+		void collect();
+
+		const counters_t& counters() const { return m_counters; }
+
+	private:
+		struct pending_release
+		{
+			object resource;
+			u64 safe_after = 0;
+			bool resident = false;
+		};
+
+		object m_device;
+		object m_queue;
+		object m_event;
+		object m_residency;
+		object m_command_buffer;
+		object m_allocator;
+		object m_encoder;
+		encoder_kind m_kind = encoder_kind::none;
+		u64 m_render_pass_id = 0;
+		std::atomic<u64> m_last_submitted{0};
+		bool m_residency_dirty = false;
+		std::atomic<bool> m_has_dma_transfer{false};
+		std::deque<pending_release> m_releases;
+		std::mutex m_release_lock;
+		counters_t m_counters{};
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp
new file mode 100644
index 0000000..4d918d2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "stdafx.h"
+#include "MTLCommonDecompiler.h"
+
+#include <array>
+#include <cctype>
+#include <cstdlib>
+#include <utility>
+
+namespace mtl
+{
+	// The same varying locations as the Vulkan decompilers (VKCommonDecompiler.cpp), so vertex and fragment
+	// programs translated separately still link by location.
+	static constexpr std::array<std::pair<std::string_view, int>, 17> varying_registers =
+	{ {
+		{ "tc0", 0 },
+		{ "tc1", 1 },
+		{ "tc2", 2 },
+		{ "tc3", 3 },
+		{ "tc4", 4 },
+		{ "tc5", 5 },
+		{ "tc6", 6 },
+		{ "tc7", 7 },
+		{ "tc8", 8 },
+		{ "tc9", 9 },
+		{ "diff_color", 10 },
+		{ "diff_color1", 11 },
+		{ "spec_color", 12 },
+		{ "spec_color1", 13 },
+		{ "fog_c", 14 },
+		{ "fogc", 14 },
+		{ "usr", 15 },
+	} };
+
+	int get_varying_register_location(std::string_view varying_register_name)
+	{
+		for (const auto& varying_register : varying_registers)
+		{
+			if (varying_register.first == varying_register_name)
+			{
+				return varying_register.second;
+			}
+		}
+
+		fmt::throw_exception("Unknown register name: %s", varying_register_name);
+	}
+
+	int get_texture_index(std::string_view name)
+	{
+		if (name.length() < 2)
+		{
+			fmt::throw_exception("Invalid texture name: '%s'", name);
+		}
+
+		constexpr int max_index_length = 2;
+		const int name_length = static_cast<int>(name.length());
+		std::string index;
+
+		for (int char_idx = name_length - max_index_length; char_idx < name_length; ++char_idx)
+		{
+			if (std::isdigit(static_cast<unsigned char>(name[char_idx])))
+			{
+				index += name[char_idx];
+			}
+		}
+
+		if (index.empty())
+		{
+			fmt::throw_exception("Invalid texture name: '%s'", name);
+		}
+
+		return std::atoi(index.c_str());
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h
new file mode 100644
index 0000000..96aa7e8
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): what the Metal decompilers declare for each translated RSX program.
+//
+// The Metal renderer reuses RPCS3's Vulkan-flavoured GLSL generation (the same text MoltenVK translates for
+// the Vulkan renderer today), compiles it to SPIR-V with glslang and translates the SPIR-V to MSL with
+// SPIRV-Cross. Nothing here depends on a Vulkan device or on Vulkan headers: the device facts the Vulkan
+// decompilers query are a capability record filled from the Metal device.
+
+#include "Emu/RSX/Program/GLSLTypes.h"
+#include "util/types.hpp"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace mtl
+{
+	namespace glsl
+	{
+		enum program_input_type : u32
+		{
+			input_type_uniform_buffer = 0,
+			input_type_texel_buffer,
+			input_type_texture,
+			input_type_storage_buffer,
+			input_type_push_constant,
+			input_type_attachment,
+
+			input_type_undefined = 0xffff'ffff
+		};
+
+		// Descriptor set numbers written in the generated GLSL ("set=0" vertex, "set=1" fragment).
+		enum binding_set_index : u32
+		{
+			binding_set_index_vertex = 0,
+			binding_set_index_fragment = 1,
+		};
+
+		struct program_input
+		{
+			::glsl::program_domain domain = ::glsl::glsl_invalid_program;
+			program_input_type type = input_type_undefined;
+			u32 set = 0;
+			u32 location = umax;
+			std::string name = "undefined";
+
+			// input_type_push_constant only: the byte range of the push constant block this stage declares.
+			u32 push_constant_offset = 0;
+			u32 push_constant_size = 0;
+
+			static program_input make(::glsl::program_domain domain, std::string name, program_input_type type, u32 set, u32 location)
+			{
+				program_input result{};
+				result.domain = domain;
+				result.type = type;
+				result.set = set;
+				result.location = location;
+				result.name = std::move(name);
+				return result;
+			}
+		};
+	}
+
+	// The device facts the RSX decompilers depend on, for the Metal device in use.
+	struct shader_device_caps
+	{
+		bool has_native_half_support = false;       // float16 arithmetic (Apple GPUs: yes; used only at low shader precision, as on Vulkan)
+		bool emulate_depth_compare = true;          // no D24S8: depth surfaces are D32F(+S8), shadow compares emulated as on MoltenVK
+		bool emulate_conditional_rendering = false; // conditional rendering resolved on the CPU, as on MoltenVK
+		bool allow_float64 = false;                 // Metal shading language has no double precision
+		bool low_precision_rounding = false;        // NVIDIA-only workaround
+	};
+
+	int get_varying_register_location(std::string_view varying_register_name);
+	int get_texture_index(std::string_view name);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLComputeTasks.cpp b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.cpp
new file mode 100644
index 0000000..2c0be18
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.cpp
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): conversion compute tasks of the native Metal 4 renderer (VKCompute.cpp).
+
+#include "stdafx.h"
+#include "MTLComputeTasks.h"
+
+#include "MTLCommandContext.h"
+#include "MTLM4Counters.h"
+#include "MTLM4Shaders.h"
+
+
+namespace mtl
+{
+	namespace
+	{
+		compute_tasks* g_compute_tasks = nullptr;
+
+		void log_failure(m4_failure kind, std::string_view what)
+		{
+			if (m4_first_failure(kind))
+			{
+				rsx_log.error("Metal M4: %s (counted in COREPROF METAL M4; logged once)", what);
+			}
+		}
+	}
+
+	void set_compute_tasks(compute_tasks* tasks)
+	{
+		g_compute_tasks = tasks;
+	}
+
+	compute_tasks* get_compute_tasks()
+	{
+		return g_compute_tasks;
+	}
+
+	bool compute_tasks::create(const object& device, const object& compiler, param_writer writer, std::string& error)
+	{
+		m_device = device;
+		m_compiler = compiler;
+		m_writer = std::move(writer);
+
+		// Safe math: the depth conversions divide and multiply exactly as written.
+		m_library = compile_library(compiler, m4_shaders::compute_library_source(), library_options{}, error);
+		if (!m_library)
+		{
+			log_failure(m4_failure::compute_library, fmt::format("conversion kernels do not compile: %s", error));
+			return false;
+		}
+
+		m_table = new_argument_table(device, 2, 1, 1);  // two buffers (a texture and a sampler entry so that no count is 0)
+		if (!m_table)
+		{
+			error = "conversion kernels argument table";
+			m_library.reset();
+			return false;
+		}
+
+		// The tile decoder: its own library, so that a failure there leaves the conversion kernels (and the tile decoder's
+		// CPU counterpart, which its callers fall back to) in place.
+		std::string tiling_error;
+		m_tiling_library = compile_library(compiler, m4_shaders::tiling_library_source(), library_options{}, tiling_error);
+		if (!m_tiling_library)
+		{
+			log_failure(m4_failure::tiling_library, fmt::format("the tile decoder does not compile (tiled loads detile on the CPU): %s", tiling_error));
+		}
+
+		return true;
+	}
+
+	void compute_tasks::destroy()
+	{
+		m_tile_decode_pipeline.reset();
+		m_tile_decode_failed = false;
+		m_tiling_library.reset();
+		m_pipelines = {};
+		m_pipeline_failed = {};
+		m_table.reset();
+		m_library.reset();
+		m_compiler.reset();
+		m_device.reset();
+		m_writer = nullptr;
+	}
+
+	const object& compute_tasks::get_pipeline(compute_kernel kernel)
+	{
+		const usz index = static_cast<usz>(kernel);
+		auto& pipeline = m_pipelines[index];
+		if (!pipeline && !m_pipeline_failed[index] && m_library)
+		{
+			const std::string_view name = m4_shaders::compute_kernel_names[index];
+			std::string error;
+			pipeline = new_compute_pipeline(m_compiler, m_library, name, name, error);
+			if (!pipeline)
+			{
+				m_pipeline_failed[index] = true;
+				log_failure(m4_failure::compute_pipeline, fmt::format("compute pipeline %s: %s", name, error));
+			}
+		}
+		return pipeline;
+	}
+
+	bool compute_tasks::dispatch(command_context& ctx, compute_kernel kernel, const object& data, u64 data_offset, const std::array<u32, 4>& params, u32 workgroups)
+	{
+		// The Vulkan dispatch covers workgroups * 256 invocations; a smaller pipeline limit only regroups them.
+		return dispatch_pipeline(ctx, get_pipeline(kernel), data, data_offset, params.data(), static_cast<u32>(sizeof(params)),
+			workgroups * compute_optimal_group_size);
+	}
+
+	bool compute_tasks::run_tile_decode(command_context& ctx, const object& data, u64 data_offset, const tile_decode_params& params)
+	{
+		if (!m_tile_decode_pipeline && !m_tile_decode_failed && m_tiling_library)
+		{
+			std::string error;
+			m_tile_decode_pipeline = new_compute_pipeline(m_compiler, m_tiling_library, m4_shaders::tile_decode_kernel_name,
+				m4_shaders::tile_decode_kernel_name, error);
+			if (!m_tile_decode_pipeline)
+			{
+				m_tile_decode_failed = true;
+				log_failure(m4_failure::compute_pipeline, fmt::format("compute pipeline %s: %s", m4_shaders::tile_decode_kernel_name, error));
+			}
+		}
+
+		if ((params.tiled_offset % 4) || (params.linear_offset % 4))
+		{
+			m4_count(get_m4_counters().compute_failures);
+			return false;
+		}
+
+		// One invocation per word of the linear output (VK: one per texel group of a row, over the tile-aligned rows).
+		return dispatch_pipeline(ctx, m_tile_decode_pipeline, data, data_offset, &params, static_cast<u32>(sizeof(params)), params.linear_words);
+	}
+
+	bool compute_tasks::dispatch_pipeline(command_context& ctx, const object& pipeline, const object& data, u64 data_offset, const void* params,
+		u32 params_size, u32 invocations)
+	{
+		if (!pipeline || !data || !m_writer || (data_offset % 4) != 0)
+		{
+			m4_count(get_m4_counters().compute_failures);
+			return false;
+		}
+
+		if (!invocations)
+		{
+			return true;
+		}
+
+		// Parameters first: the writer may submit to make room, which must not happen with the encoder open.
+		const auto [param_buffer, param_offset] = m_writer(params, params_size);
+		if (!param_buffer)
+		{
+			m4_count(get_m4_counters().compute_failures);
+			return false;
+		}
+
+		const u32 limit = query_compute_pipeline(pipeline).max_threads_per_threadgroup;
+		const dispatch_size size = get_dispatch_size(invocations, std::min(compute_optimal_group_size, std::max(limit, 1u)));
+
+		// A fresh encoder: commands of one Metal 4 encoder may overlap, the queue barrier of a new one orders this task
+		// after everything encoded before it; ending it orders what follows after the task.
+		ctx.end_encoder();
+		const object& encoder = ctx.compute("RSX conversion");
+		set_compute_pipeline(encoder, pipeline);
+		table_set_buffer(m_table, data, data_offset, 0);
+		table_set_buffer(m_table, param_buffer, param_offset, 1);
+		set_compute_argument_table(encoder, m_table);
+		dispatch_threadgroups(encoder, size.groups, size.threads);
+		ctx.end_encoder();
+
+		m4_count(get_m4_counters().compute_dispatches);
+		return true;
+	}
+
+	bool compute_tasks::run_shuffle(command_context& ctx, compute_kernel kernel, const object& data, u32 data_length, u32 data_offset)
+	{
+		ensure(get_kernel_family(kernel) == compute_kernel_family::shuffle);
+		return dispatch(ctx, kernel, data, data_offset, shuffle_params(data_length), compute_shuffle_workgroups(data_length));
+	}
+
+	bool compute_tasks::run_interleave(command_context& ctx, compute_kernel kernel, const object& data, u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset)
+	{
+		ensure(get_kernel_family(kernel) == compute_kernel_family::interleave);
+		ensure(stencil_offset > data_offset);
+
+		u32 bound_offset = 0;
+		const auto params = interleave_params(data_offset, data_length, zeta_offset, stencil_offset, bound_offset);
+		return dispatch(ctx, kernel, data, bound_offset, params, compute_shuffle_workgroups(data_length));
+	}
+
+	bool compute_tasks::run_fconvert(command_context& ctx, compute_kernel kernel, const object& data, u32 src_offset, u32 src_length, u32 dst_offset)
+	{
+		ensure(get_kernel_family(kernel) == compute_kernel_family::fconvert);
+
+		u32 bound_offset = 0;
+		const auto params = fconvert_params(kernel, src_offset, src_length, dst_offset, bound_offset);
+		return dispatch(ctx, kernel, data, bound_offset, params, compute_shuffle_workgroups(src_length));
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h
new file mode 100644
index 0000000..5681680
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the conversion compute tasks of the surface and texture paths (VKCompute.h / .cpp):
+// byte swaps, D24S8 <-> F32 depth conversions, depth-stencil gather/scatter (interleave) and the e4m12 float
+// conversions, as Metal compute kernels compiled at runtime from MSL (MTLM4Shaders.h) by the MTL4 compiler.
+//
+// Each run() takes the Vulkan task's run() arguments and dispatches over the same words with the same arithmetic
+// (MTLM4Math.h, shared with the host unit test). Accesses stay inside the bound range, as Vulkan's robust buffer access
+// keeps them. Each task is its own compute encoder: the next encoder of the command context waits for it, so a task's
+// results are visible to whatever is encoded after it, and it sees everything encoded before.
+// The caller keeps the data buffer resident and alive until the work completes (command_context::dispose).
+// The RSX tile decoder (RSXMemoryTiling.glsl, cs_tile_memcpy<decode>) is its own library and task (run_tile_decode),
+// used where the Vulkan renderer detiles on the GPU (detile_memory_block: tiled surface loads, tiled blit sources).
+// Not ported: the tile encoder (readbacks are tiled on the CPU at flush time, MTLTextureCache.cpp), the GPU deswizzle
+// (uploads deswizzle on the CPU while they copy guest memory into the staging ring, MTLTexture.cpp) and the
+// conditional-render aggregator (no hardware conditional rendering on Metal).
+
+#include "MTLAPI.h"
+
+#include <array>
+#include <functional>
+#include <string>
+#include <utility>
+
+namespace mtl
+{
+	class command_context;
+
+	enum class compute_kernel : u32
+	{
+		// cs_shuffle_*: value = data[index]; data[index] = f(value)
+		bswap_u16,                // cs_shuffle_16
+		bswap_u32,                // cs_shuffle_32
+		bswap_u16_u32,            // cs_shuffle_32_16
+		d24x8_to_f32,             // cs_shuffle_d24x8_f32
+		f32_to_d24x8_swapped,     // cs_shuffle_se_f32_d24x8
+		d24x8_to_d24x8_swapped,   // cs_shuffle_se_d24x8
+
+		// cs_interleave_task family
+		gather_d24x8,             // cs_gather_d24x8<false>
+		gather_d24x8_swapped,     // cs_gather_d24x8<true>
+		gather_d32x8,             // cs_gather_d32x8<false, false>
+		gather_d32x8_swapped,     // cs_gather_d32x8<true, false>
+		gather_d32fx8,            // cs_gather_d32x8<false, true>
+		gather_d32fx8_swapped,    // cs_gather_d32x8<true, true>
+		scatter_d24x8,            // cs_scatter_d24x8
+		scatter_d32x8,            // cs_scatter_d32x8<false>
+		scatter_d32fx8,           // cs_scatter_d32x8<true>
+
+		// cs_fconvert_task<From, To, _SwapSrc, _SwapDst>
+		f32_to_f16,
+		f32_to_f16_swap_src,
+		f32_to_f16_swap_dst,
+		f32_to_f16_swap_both,
+		f16_to_f32,
+		f16_to_f32_swap_src,
+		f16_to_f32_swap_dst,
+		f16_to_f32_swap_both,
+
+		count
+	};
+
+	enum class compute_kernel_family : u8
+	{
+		shuffle,
+		interleave,
+		fconvert,
+	};
+
+	constexpr compute_kernel_family get_kernel_family(compute_kernel kernel)
+	{
+		if (kernel <= compute_kernel::d24x8_to_d24x8_swapped) return compute_kernel_family::shuffle;
+		if (kernel <= compute_kernel::scatter_d32fx8) return compute_kernel_family::interleave;
+		return compute_kernel_family::fconvert;
+	}
+
+	// MoltenVK's compute_task settings in the Vulkan renderer (VKCompute.cpp compute_task::create).
+	constexpr u32 compute_optimal_group_size = 256;
+	constexpr u32 compute_optimal_kernel_size = 1;
+
+	constexpr u32 compute_aligned_div(u32 value, u32 alignment)
+	{
+		return static_cast<u32>((static_cast<u64>(value) + alignment - 1) / alignment);
+	}
+
+	// cs_shuffle_base::run: the work groups covering `data_length` bytes, one word per invocation.
+	constexpr u32 compute_shuffle_workgroups(u32 data_length)
+	{
+		return compute_aligned_div(data_length, compute_optimal_group_size * compute_optimal_kernel_size * 4);
+	}
+
+	// The dispatch of `invocations` threads in groups of `group_size` (VK compute_task::run), in two dimensions when one
+	// would exceed `max_groups_x` (compute_task::run(cmd, num_invocations), rounded up so that every group is covered:
+	// the kernels' invocation index is linear and bounded, extra groups do nothing).
+	struct dispatch_size
+	{
+		size3 groups{ 0, 1, 1 };
+		size3 threads{ 1, 1, 1 };
+	};
+
+	inline dispatch_size get_dispatch_size(u32 invocations, u32 group_size, u32 max_groups_x = 65535)
+	{
+		dispatch_size size{};
+		group_size = group_size ? group_size : 1;
+		size.threads = { group_size, 1, 1 };
+
+		const u32 groups = compute_aligned_div(invocations, group_size);
+		if (groups <= max_groups_x)
+		{
+			size.groups = { groups, 1, 1 };
+			return size;
+		}
+
+		u32 x = 1;
+		while (static_cast<u64>(x + 1) * (x + 1) <= groups && x < max_groups_x)
+		{
+			x++;
+		}
+		size.groups = { x, compute_aligned_div(groups, x), 1 };
+		return size;
+	}
+
+	// The parameter words of each family: the Vulkan push constants params[0], plus the bound range in words in w.
+	inline std::array<u32, 4> shuffle_params(u32 data_length)
+	{
+		// The bound range is data_length bytes: the whole words inside it are processed (robust access drops the rest).
+		const u32 words = data_length / 4;
+		return { words, 0, 0, words };
+	}
+
+	// cs_interleave_task::run; `bound_offset` is where the data is bound.
+	inline std::array<u32, 4> interleave_params(u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset, u32& bound_offset)
+	{
+		bound_offset = data_offset;
+		const u32 ssbo_length = stencil_offset + (data_length / 4) - data_offset;
+		return { data_length, zeta_offset - data_offset, stencil_offset - data_offset, ssbo_length / 4 };
+	}
+
+	// cs_fconvert_task::run
+	inline std::array<u32, 4> fconvert_params(compute_kernel kernel, u32 src_offset, u32 src_length, u32 dst_offset, u32& bound_offset)
+	{
+		const bool contract = kernel <= compute_kernel::f32_to_f16_swap_both;
+		const u32 from_size = contract ? 4 : 2;
+		const u32 to_size = contract ? 2 : 4;
+
+		u32 ssbo_length;
+		if (src_offset > dst_offset)
+		{
+			ssbo_length = (src_offset + src_length) - dst_offset;
+			bound_offset = dst_offset;
+		}
+		else
+		{
+			ssbo_length = (dst_offset - src_offset) + (src_length / from_size) * to_size;
+			bound_offset = src_offset;
+		}
+
+		return { src_length, src_offset - bound_offset, dst_offset - bound_offset, ssbo_length / 4 };
+	}
+
+	// VK cs_tile_memcpy<RSX_detiler_op::decode> parameters (RSX_detiler_config), as the decoder kernel reads them
+	// (MTLM4Shaders.h tiling_kernels, MTLM4Math.h m4_detile_source).
+	struct tile_decode_params
+	{
+		u32 factor;
+		u32 num_tiles_per_row;
+		u32 tile_base_address;
+		u32 tile_size;
+		u32 tile_address_offset;   // the image's first texel, from the tile base
+		u32 tile_rw_offset;        // where the tiled bytes start, from the tile base
+		u32 tile_pitch;
+		u32 tile_bank;
+		u32 image_width;
+		u32 image_height;
+		u32 image_pitch;           // bytes per row of the packed linear output
+		u32 image_bpp;
+		u32 tiled_offset;          // the tiled bytes, from the bound data offset (a multiple of 4)
+		u32 tiled_length;
+		u32 linear_offset;         // the linear output, from the bound data offset (a multiple of 4)
+		u32 linear_words;          // the words of the linear output (aligned_div(image_pitch * image_height, 4))
+	};
+	static_assert(sizeof(tile_decode_params) == 64);
+
+	class compute_tasks
+	{
+	public:
+		// Writes `size` bytes of parameters into GPU-visible memory; returns the buffer and offset. Called before the
+		// task's encoder is opened (it may submit to make room).
+		using param_writer = std::function<std::pair<object, u64>(const void* data, u32 size)>;
+
+		bool create(const object& device, const object& compiler, param_writer writer, std::string& error);
+		void destroy();
+		bool ready() const { return !!m_library; }
+
+		// VK cs_shuffle_base::run(cmd, data, data_length, data_offset)
+		bool run_shuffle(command_context& ctx, compute_kernel kernel, const object& data, u32 data_length, u32 data_offset = 0);
+		// VK cs_interleave_task::run(cmd, data, data_offset, data_length, zeta_offset, stencil_offset)
+		bool run_interleave(command_context& ctx, compute_kernel kernel, const object& data, u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset);
+		// VK cs_fconvert_task::run(cmd, data, src_offset, src_length, dst_offset)
+		bool run_fconvert(command_context& ctx, compute_kernel kernel, const object& data, u32 src_offset, u32 src_length, u32 dst_offset);
+
+		// VK cs_tile_memcpy<decode>::run: the tiled bytes and the linear output both in `data`, bound at data_offset.
+		bool tiling_ready() const { return m_tiling_library && !m_tile_decode_failed; }
+		bool run_tile_decode(command_context& ctx, const object& data, u64 data_offset, const tile_decode_params& params);
+
+	private:
+		const object& get_pipeline(compute_kernel kernel);
+		bool dispatch(command_context& ctx, compute_kernel kernel, const object& data, u64 data_offset, const std::array<u32, 4>& params, u32 workgroups);
+		bool dispatch_pipeline(command_context& ctx, const object& pipeline, const object& data, u64 data_offset, const void* params, u32 params_size,
+			u32 invocations);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		param_writer m_writer;
+		std::array<object, static_cast<usz>(compute_kernel::count)> m_pipelines{};
+		std::array<bool, static_cast<usz>(compute_kernel::count)> m_pipeline_failed{};
+		object m_tiling_library;
+		object m_tile_decode_pipeline;
+		bool m_tile_decode_failed = false;
+	};
+
+	// The tasks the surface and texture paths use (set by the renderer).
+	void set_compute_tasks(compute_tasks* tasks);
+	compute_tasks* get_compute_tasks();
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLDataHeap.h b/rpcs3/Emu/RSX/Metal/MTLDataHeap.h
new file mode 100644
index 0000000..bb306e9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLDataHeap.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): ring buffers of the native Metal 4 renderer (vertex streams, draw parameters,
+// contexts, constants, indices, uploads). The same allocator as the Vulkan renderer (rsx::data_heap) over one
+// shared-storage MTLBuffer: unified memory, so the CPU writes where the GPU reads, with no map, copy or flush.
+//
+// Space is reclaimed per frame: the renderer records each heap's position when it submits a frame and moves the
+// heap's GET position there once the frame's fence has signalled. A heap that is full asks the renderer to make
+// room (on_exhausted: submit, then wait for the GPU); it never overwrites memory the GPU may still read.
+
+#include "Emu/RSX/Common/ring_buffer_helper.h"
+#include "MTLAPI.h"
+
+#include <functional>
+
+namespace mtl
+{
+	class data_heap : public rsx::data_heap
+	{
+	public:
+		object buffer;
+
+		// Called with the requested size when an allocation would reach memory in use by the GPU. Returns true
+		// once the whole heap is free again (the renderer submitted its work and waited for it).
+		std::function<bool(usz)> on_exhausted;
+
+		void create(const object& device, usz size, const char* name, usz guard = 0x10000)
+		{
+			init(size, name, guard);
+			buffer = new_buffer(device, size, storage_mode::shared);
+			m_host = static_cast<u8*>(buffer_contents(buffer));
+			ensure(m_host, "Metal ring buffer allocation failed");
+		}
+
+		void destroy()
+		{
+			buffer.reset();
+			m_host = nullptr;
+		}
+
+		template <typename T = void>
+		T* map(usz offset, usz /*size*/ = 0) const
+		{
+			return reinterpret_cast<T*>(m_host + offset);
+		}
+
+		// Kept for symmetry with vk::data_heap call sites: shared storage needs no unmap.
+		void unmap() const
+		{
+		}
+
+		// Everything allocated so far may be reused (the GPU has finished with all of it).
+		void release_all()
+		{
+			reset_allocation_stats();
+		}
+
+		usz put_position() const
+		{
+			return get_current_put_pos_minus_one();
+		}
+
+		bool valid() const
+		{
+			return !!buffer;
+		}
+
+	protected:
+		bool grow(usz size) override
+		{
+			// rsx::data_heap::alloc() keeps the PUT position it computed before calling grow(), so only GET moves:
+			// once the renderer has waited for the GPU, the whole ring is free from PUT onwards (wrapping to 0).
+			if (size < m_size && on_exhausted && on_exhausted(size))
+			{
+				reset_allocation_stats();
+				return true;
+			}
+
+			return false;
+		}
+
+	private:
+		u8* m_host = nullptr;
+	};
+}
