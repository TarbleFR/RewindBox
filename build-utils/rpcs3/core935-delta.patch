+			auto limit = stop;
+			if (!seen)
 			{
-				// Pass the wake-up on to the next sleeping writer.
-				wake_one(starving);
+				limit = std::min(stop, std::chrono::steady_clock::time_point(std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::nanoseconds(grace))));
 			}
+
+			sleepers.fetch_add(1, std::memory_order_seq_cst);
+			sleep_while(starving, seen, limit - now);
+			sleepers.fetch_sub(1, std::memory_order_seq_cst);
+			slept = true;
 		}
 
 		seen = starving.load(std::memory_order_acquire);
+		grace = grace_until.load(std::memory_order_acquire);
+	}
+
+	// CELL579_GATE_SLEEP: pass the last starving waiter's wake-up on to the next
+	// sleeping writer. REWINDBOX_PPU_GRACE_664: when this writer leaves, not after
+	// each sleep: during a window the woken writer would only sleep again and wake
+	// the next one, until the window ends. A writer that waited for a window wakes
+	// every writer still asleep, so they leave together instead of one by one.
+	if (slept && !starving.load(std::memory_order_seq_cst) && sleepers.load(std::memory_order_seq_cst))
+	{
+		if (windowed)
+		{
+			wake_all(starving);
+		}
+		else
+		{
+			wake_one(starving);
+		}
+	}
+
+	if (window_only)
+	{
+		grace_deferrals.fetch_add(1, std::memory_order_relaxed);
+		grace_deferred_ns.fetch_add(static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count()), std::memory_order_relaxed);
 	}
 
 	return true;
 }
+
+// REWINDBOX_GATE_BEFORE_LINE_924: an accurate PUTLLC takes its line's reservation lock
+// (rsrv_unique_lock) and only then the writer lock, whose deferral above ran with that
+// line locked. During the window a
+// starving PPU opened on leaving, the first SPU to reach its writer lock therefore kept its
+// line locked for the whole window: a PPU whose next step is a conditional store on that
+// same line (ppu_store_reservation fails on a locked line) spent every window failing it.
+// IPA 724, Call of Duty: Black Ops II, pid 50194: the main thread waits for a semaphore, the
+// PPU thread Secondary holds a reservation on 0x2e208d8 whose word shows the lock of another
+// thread for 27 us across the dump, and six SPUs complete 1.5 million PUTLLC per second on
+// that line (7.5 million per 5 s window, none sleeping), 6010 windows opened and 8671 writer
+// locks deferred 115 us each in the same window; no frame for the rest of the session.
+// The deferral is now made before the line is locked, and the writer lock that follows does
+// not defer a second time. The same waits, in the same bound; the reservation time and the
+// line's contents are validated after it exactly as before (the lock is taken by the same
+// fetch_op, the comparison is made under the same writer lock). Nothing is skipped: a PUTLLC
+// whose line changed while it deferred fails, as it does when the line changes at any other
+// moment before its lock. A PPU's conditional store of a full line and a 128-byte store keep
+// the earlier order (they lock their line, then defer in the writer lock): neither is on the
+// path observed, and PPUThread.cpp is an input of the PPU cache identity.
+inline thread_local bool deferred_ahead = false;
+
+class ahead_scope
+{
+public:
+	// `active` false: no deferral here, and the writer lock defers as before.
+	explicit ahead_scope(bool active = true) noexcept
+		: m_active(active)
+	{
+		if (active)
+		{
+			defer_writer();
+			deferred_ahead = true;
+		}
+	}
+
+	ahead_scope(const ahead_scope&) = delete;
+	ahead_scope& operator=(const ahead_scope&) = delete;
+
+	~ahead_scope()
+	{
+		if (m_active)
+		{
+			deferred_ahead = false;
+		}
+	}
+
+private:
+	const bool m_active;
+};
+
+// vm::writer_lock: defers unless the caller did so before locking its line.
+inline void defer_writer_once() noexcept
+{
+	if (!deferred_ahead)
+	{
+		defer_writer();
+	}
+}
 }
diff --git a/rpcs3/ios/IOSPatchRelief932.h b/rpcs3/ios/IOSPatchRelief932.h
new file mode 100644
index 0000000..3f114e4
--- /dev/null
+++ b/rpcs3/ios/IOSPatchRelief932.h
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+// REWINDBOX_PATCH_RELIEF_932 (maintainer audit, 11 Nov 2026: share corrections between games under precise
+// conditions): a game patch that removes the reason the RPCS3 database turns an expensive setting on for a title also
+// removes the need for that setting. A rule names the patch, the setting, the value the database set and the value
+// the setting goes back to. It acts only when every condition holds, and the boot line PATCHRELIEF932 says what it
+// did or why it refused:
+// - the patch is applied in this boot: a main executable patch whose every entry was written, or, for a rule decided
+//   at boot, the patch enabled for this serial and version before any SPU program is compiled;
+// - the value comes from the database alone: it differs from the global value, the user's per-game settings do not
+//   name the setting (they always win) and no configuration file was chosen for this boot;
+// - a fresh boot: a savestate keeps the memory it was saved with, patched or not, so its settings are left as they are.
+// Turning the patch off in the game-patch list turns the rule off. Two rules, both shipped by ARMSX3 21863 with the
+// same patches (rpcs3/ios/IOSCanaryPatches932.h):
+// 1. gt6_mlaa_buffers: Gran Turismo 6 v01.22, "Disable MLAA" of its eight executables. The game reads every frame back
+//    for its SPU MLAA pass, which is why the database turns Write and Read Color Buffers on for every GT6 serial; with
+//    the pass gone nothing reads the frame. Applied with the patch, on the loader thread, before the renderer exists
+//    (ppu_load_exec applies the main executable patches before init_fxo_for_exec starts it).
+// 2. gta4_collision_xfloat: Grand Theft Auto IV, "ARMSX3 Approximate collision fix". The collision job starts its 14
+//    searches from 0x7FFFFFFF, a NaN under Approximate XFloat, which is why the database pins the game to Accurate (a
+//    cost on every SPU program); the patch starts them from FLT_MAX, the same value under both. Decided at boot, before
+//    any SPU compilation (the mode is read while compiling), and only for the executables the patch was written for:
+//    BLUS30682 v01.02 and BLUS30127 / NPUB30702 v01.08.
+namespace rpcs3::ios::patch_relief932
+{
+enum class setting : std::uint8_t
+{
+	write_color_buffers,
+	read_color_buffers,
+	spu_xfloat_accuracy,
+	count,
+};
+
+constexpr std::size_t setting_count = static_cast<std::size_t>(setting::count);
+
+constexpr const char* setting_name(setting s) noexcept
+{
+	switch (s)
+	{
+	case setting::write_color_buffers: return "write_color_buffers";
+	case setting::read_color_buffers: return "read_color_buffers";
+	case setting::spu_xfloat_accuracy: return "spu_xfloat_accuracy";
+	default: return "unknown";
+	}
+}
+
+// The key of the same setting in the user's per-game settings (RPCS3IOSSettings.cpp).
+constexpr std::string_view setting_key(setting s) noexcept
+{
+	switch (s)
+	{
+	case setting::write_color_buffers: return "gpu.write_color_buffers";
+	case setting::read_color_buffers: return "advanced.read_color_buffers";
+	case setting::spu_xfloat_accuracy: return "cpu.spu_xfloat_accuracy";
+	default: return {};
+	}
+}
+
+// Comma-separated keys, as game_setting_override_keys prints them.
+constexpr bool has_key(std::string_view keys, std::string_view key) noexcept
+{
+	while (!keys.empty())
+	{
+		const std::size_t comma = keys.find(',');
+		const std::string_view item = keys.substr(0, comma);
+		if (item == key)
+		{
+			return true;
+		}
+		if (comma == std::string_view::npos)
+		{
+			break;
+		}
+		keys.remove_prefix(comma + 1);
+	}
+	return false;
+}
+
+enum class refusal : std::uint8_t
+{
+	none,
+	not_fresh_boot,
+	explicit_config,
+	overrides_unknown,
+	user_choice,
+	not_database,
+	partial_apply,
+	version,
+};
+
+constexpr const char* refusal_name(refusal r) noexcept
+{
+	switch (r)
+	{
+	case refusal::none: return "none";
+	case refusal::not_fresh_boot: return "savestate";
+	case refusal::explicit_config: return "explicit_config";
+	case refusal::overrides_unknown: return "user_settings_unknown";
+	case refusal::user_choice: return "user_choice";
+	case refusal::not_database: return "not_from_database";
+	case refusal::partial_apply: return "patch_partially_applied";
+	case refusal::version: return "other_version";
+	default: return "unknown";
+	}
+}
+
+// What the boot knows about one setting, captured by Emulator::Load after every layer.
+struct setting_origin
+{
+	bool user_key = false;      // the user's per-game settings name it
+	bool from_database = false; // the global value differs and the value is the one the rule relieves
+};
+
+struct decision_inputs
+{
+	bool fresh_boot = false;
+	bool explicit_config = false;
+	bool overrides_known = false;
+	setting_origin origin{};
+	bool patch_complete = false;
+	bool version_ok = false;
+};
+
+// The order of the refusals is the order of the conditions above; the first one that fails is reported.
+constexpr refusal decide(const decision_inputs& in) noexcept
+{
+	if (!in.fresh_boot)
+	{
+		return refusal::not_fresh_boot;
+	}
+	if (in.explicit_config)
+	{
+		return refusal::explicit_config;
+	}
+	if (!in.overrides_known)
+	{
+		return refusal::overrides_unknown;
+	}
+	if (in.origin.user_key)
+	{
+		return refusal::user_choice;
+	}
+	if (!in.origin.from_database)
+	{
+		return refusal::not_database;
+	}
+	if (!in.patch_complete)
+	{
+		return refusal::partial_apply;
+	}
+	if (!in.version_ok)
+	{
+		return refusal::version;
+	}
+	return refusal::none;
+}
+
+// Rule 1.
+inline constexpr std::string_view gt6_description = "Disable MLAA";
+inline constexpr std::array<std::string_view, 8> gt6_hashes = {
+	"PPU-42367707f4caac2668f10cb46498f64bde9db440", "PPU-4f1e9acd7d98961b4b742fb324a2faba6212ea67",
+	"PPU-6ac472e1f334f54ec4753cde9e8e1515bfab4d17", "PPU-638ef307e2b35d593f599efec0dc0c37059a984b",
+	"PPU-80f0d67b29d3d17ac885a309a3fc4cd8dcf50658", "PPU-4213aba5ed17f7e3cd3f299fa44d9d9acef0ba18",
+	"PPU-6a7de7fdfd7e7cbd1031bf28a7104b29c308136c", "PPU-43e618448eed82aa96856338d072f1e4978c36a8",
+};
+
+constexpr bool is_gt6_mlaa_patch(std::string_view hash, std::string_view description) noexcept
+{
+	if (description != gt6_description)
+	{
+		return false;
+	}
+	for (const std::string_view known : gt6_hashes)
+	{
+		if (known == hash)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+// Rule 2.
+inline constexpr std::string_view gta4_hash = "SPU-d0a1508208613e2184fbd64906d34d5f07890033";
+inline constexpr std::string_view gta4_description = "ARMSX3 Approximate collision fix";
+
+struct serial_version
+{
+	std::string_view serial;
+	std::string_view app_version;
+};
+
+inline constexpr std::array<serial_version, 3> gta4_versions = {{
+	{"BLUS30682", "01.02"},
+	{"BLUS30127", "01.08"},
+	{"NPUB30702", "01.08"},
+}};
+
+constexpr bool is_gta4_serial(std::string_view serial) noexcept
+{
+	for (const serial_version& known : gta4_versions)
+	{
+		if (known.serial == serial)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+constexpr bool gta4_version_ok(std::string_view serial, std::string_view app_version) noexcept
+{
+	for (const serial_version& known : gta4_versions)
+	{
+		if (known.serial == serial && known.app_version == app_version)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+// Written by Emulator::Load on its loader thread before the executable is loaded; read by patch_engine::apply on
+// the same thread. Atomics only so that a read from another thread is never a data race.
+class boot_state
+{
+public:
+	static boot_state& instance() noexcept
+	{
+		static boot_state value;
+		return value;
+	}
+
+	void begin(bool fresh_boot, bool explicit_config, bool overrides_known, const std::array<setting_origin, setting_count>& origins) noexcept
+	{
+		m_fresh_boot.store(fresh_boot, std::memory_order_relaxed);
+		m_explicit_config.store(explicit_config, std::memory_order_relaxed);
+		m_overrides_known.store(overrides_known, std::memory_order_relaxed);
+		for (std::size_t i = 0; i < setting_count; i++)
+		{
+			m_user_key[i].store(origins[i].user_key, std::memory_order_relaxed);
+			m_from_database[i].store(origins[i].from_database, std::memory_order_relaxed);
+		}
+		m_applied.store(0, std::memory_order_relaxed);
+		m_armed.store(true, std::memory_order_release);
+	}
+
+	// After the executable is loaded nothing is relieved any more (a later apply() is a module or an SPU image).
+	void end_loading() noexcept { m_armed.store(false, std::memory_order_release); }
+	bool armed() const noexcept { return m_armed.load(std::memory_order_acquire); }
+
+	decision_inputs inputs(setting s, bool patch_complete, bool version_ok) const noexcept
+	{
+		const std::size_t i = static_cast<std::size_t>(s);
+		decision_inputs in;
+		in.fresh_boot = m_fresh_boot.load(std::memory_order_relaxed);
+		in.explicit_config = m_explicit_config.load(std::memory_order_relaxed);
+		in.overrides_known = m_overrides_known.load(std::memory_order_relaxed);
+		in.origin.user_key = m_user_key[i].load(std::memory_order_relaxed);
+		in.origin.from_database = m_from_database[i].load(std::memory_order_relaxed);
+		in.patch_complete = patch_complete;
+		in.version_ok = version_ok;
+		return in;
+	}
+
+	void count_applied() noexcept { m_applied.fetch_add(1, std::memory_order_relaxed); }
+	std::uint32_t applied() const noexcept { return m_applied.load(std::memory_order_relaxed); }
+
+private:
+	std::atomic<bool> m_armed{false}, m_fresh_boot{false}, m_explicit_config{false}, m_overrides_known{false};
+	std::array<std::atomic<bool>, setting_count> m_user_key{}, m_from_database{};
+	std::atomic<std::uint32_t> m_applied{0};
+};
+} // namespace rpcs3::ios::patch_relief932
diff --git a/rpcs3/ios/IOSPipelineQueue.h b/rpcs3/ios/IOSPipelineQueue.h
new file mode 100644
index 0000000..9772d6e
--- /dev/null
+++ b/rpcs3/ios/IOSPipelineQueue.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_PIPELINE_QUEUE_621: the graphics pipeline compile queue per profiler
+// window (COREPROF PIPEQUEUE621): jobs queued and built, the deepest queue,
+// the longest time a job waited before a compiler thread took it, the longest
+// build, and the draws the renderer skipped because their program was not
+// ready (VKDraw.cpp, asynchronous shader modes only: the synchronous modes
+// build inline and never skip). It sits beside the LLVM admission (JITMEM,
+// WAITPROF527 llvm_*) and the SPU busy waits (SPUWAIT551 getllar_poll,
+// PRESSURE547 spu_passive_waits), which have their own lines.
+namespace rpcs3::ios::pipeline_queue
+{
+struct counters
+{
+	std::atomic<std::uint64_t> queued{0}, completed{0}, skipped_draws{0};
+	std::atomic<std::uint64_t> depth_peak{0};
+	std::atomic<std::uint64_t> wait_total_tsc{0}, wait_max_tsc{0}, build_total_tsc{0}, build_max_tsc{0};
+};
+
+inline counters& stats() noexcept
+{
+	static counters s_counters;
+	return s_counters;
+}
+
+inline void raise(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+{
+	std::uint64_t current = value.load(std::memory_order_relaxed);
+	while (candidate > current && !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {}
+}
+
+inline void on_queued(std::uint32_t pending) noexcept
+{
+	stats().queued.fetch_add(1, std::memory_order_relaxed);
+	raise(stats().depth_peak, pending);
+}
+
+inline void on_completed(std::uint64_t wait_tsc, std::uint64_t build_tsc) noexcept
+{
+	auto& s = stats();
+	s.completed.fetch_add(1, std::memory_order_relaxed);
+	s.wait_total_tsc.fetch_add(wait_tsc, std::memory_order_relaxed);
+	s.build_total_tsc.fetch_add(build_tsc, std::memory_order_relaxed);
+	raise(s.wait_max_tsc, wait_tsc);
+	raise(s.build_max_tsc, build_tsc);
+}
+
+inline void on_skipped_draw() noexcept
+{
+	stats().skipped_draws.fetch_add(1, std::memory_order_relaxed);
+}
+
+struct window
+{
+	std::uint64_t queued = 0, completed = 0, skipped_draws = 0, depth_peak = 0;
+	std::uint64_t wait_total_tsc = 0, wait_max_tsc = 0, build_total_tsc = 0, build_max_tsc = 0;
+};
+
+inline window take() noexcept
+{
+	auto& s = stats();
+	window w;
+	w.queued = s.queued.exchange(0, std::memory_order_relaxed);
+	w.completed = s.completed.exchange(0, std::memory_order_relaxed);
+	w.skipped_draws = s.skipped_draws.exchange(0, std::memory_order_relaxed);
+	w.depth_peak = s.depth_peak.exchange(0, std::memory_order_relaxed);
+	w.wait_total_tsc = s.wait_total_tsc.exchange(0, std::memory_order_relaxed);
+	w.wait_max_tsc = s.wait_max_tsc.exchange(0, std::memory_order_relaxed);
+	w.build_total_tsc = s.build_total_tsc.exchange(0, std::memory_order_relaxed);
+	w.build_max_tsc = s.build_max_tsc.exchange(0, std::memory_order_relaxed);
+	return w;
+}
+}
diff --git a/rpcs3/ios/IOSReadbackPrediction.h b/rpcs3/ios/IOSReadbackPrediction.h
new file mode 100644
index 0000000..0246ac0
--- /dev/null
+++ b/rpcs3/ios/IOSReadbackPrediction.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_READBACK_PREDICTION_638: whether a guest read of a written-back surface found its data
+// already copied by the upstream speculative readback (texture_cache_predictor.h) or paid the copy at
+// fault time. Build 622 God of War III: READBACK555 fault_read 132 sections of 3.69 MB per 5 s window,
+// 554 ms. READBACK555 counts only the sections still unsynchronized at the read, so it cannot say
+// whether speculation never fired for them, fired and was wasted, or was capped. Five process-wide
+// counters, read once per window; no behavior, ordering or cache decision changes.
+namespace rpcs3::ios::readback::prediction
+{
+inline std::atomic<std::uint64_t> flushes{0};            // sections written back to guest memory
+inline std::atomic<std::uint64_t> speculative_copies{0}; // copies recorded ahead of a predicted read
+inline std::atomic<std::uint64_t> flushes_after_speculation{0}; // write-backs of a section whose upstream speculation flag is set (it survives a later write)
+inline std::atomic<std::uint64_t> mispredictions{0};     // a speculative copy overwritten before any read
+inline std::atomic<std::uint64_t> misses{0};             // a read that recorded its copy at fault time
+
+struct sample
+{
+	std::uint64_t flushes = 0, speculative_copies = 0, flushes_after_speculation = 0, mispredictions = 0, misses = 0;
+};
+
+inline void count(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline sample take() noexcept
+{
+	return {flushes.exchange(0, std::memory_order_relaxed), speculative_copies.exchange(0, std::memory_order_relaxed),
+		flushes_after_speculation.exchange(0, std::memory_order_relaxed), mispredictions.exchange(0, std::memory_order_relaxed),
+		misses.exchange(0, std::memory_order_relaxed)};
+}
+}
diff --git a/rpcs3/ios/IOSRenderPassCensus.h b/rpcs3/ios/IOSRenderPassCensus.h
new file mode 100644
index 0000000..a0001ca
--- /dev/null
+++ b/rpcs3/ios/IOSRenderPassCensus.h
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_RENDERPASS_CENSUS_652: why render passes end. IPA 643 Assassin's Creed (window 18): 51 render passes per
+// frame for 1401 draws. FEEDBACK610 counts the passes the draw path began and TEXCACHE621 the depth feedback barriers
+// (8.7 per frame), but no journal line said which code ended the other passes, nor whether the next pass resumed the
+// same framebuffer (a restart that a barrier or a copy forced) or bound another one (a target switch).
+// vk::end_renderpass records its caller's file and line (a std::source_location default argument: no call site
+// changes); vk::begin_renderpass, when it really begins a pass on a command buffer whose previous pass was ended,
+// attributes that begin to the site of the end, on the same framebuffer or another. The performance reporter prints
+// the totals and the busiest sites once per window (COREPROF RPASS652). The render pass helpers are not thread safe
+// by design (RSX thread); the counters are relaxed atomics only because the reporter thread exchanges them.
+// Counting changes no render pass, barrier, copy or command.
+namespace rpcs3::ios::renderpass_census
+{
+constexpr std::size_t site_capacity = 48;
+
+struct site
+{
+	std::atomic<const char*> file{nullptr};
+	std::atomic<std::uint32_t> line{0};
+	std::atomic<std::uint64_t> ends{0};         // passes this site ended
+	std::atomic<std::uint64_t> same_target{0};  // begins that followed an end here on the same framebuffer
+	std::atomic<std::uint64_t> other_target{0}; // begins that followed an end here on another framebuffer
+};
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> begins{0};       // passes vk::begin_renderpass really began
+	std::atomic<std::uint64_t> fresh{0};        // of which nothing had ended before on that command buffer
+	std::atomic<std::uint64_t> same_target{0};  // of which the previous pass ended on the same framebuffer
+	std::atomic<std::uint64_t> other_target{0}; // of which the previous pass ended on another framebuffer
+	std::atomic<std::uint64_t> overflow{0};     // ends of a site that found no free slot
+	std::array<site, site_capacity> sites{};
+};
+
+inline window_counters counters{};
+
+// REWINDBOX_PASS_SHAPE_910: Black Ops II, build 694 device log (Core 907), gameplay window 41 at 21.7 fps: the GPU
+// executes 35.8 ms per frame and is active over 46 of the frame's 52 ms (queue delay up to 26 ms), the RSX thread
+// waits for nothing and the PPU threads use 0.40 core: the frame is GPU-bound. 49 render passes begin per frame, 15
+// of them on the framebuffer the previous one ended on; every restart stores and reloads every attachment on the
+// Apple GPU. RPASS652 names the code that ended a pass; it does not say whether the pass had drawn anything. A pass
+// that ended without a draw, then began again on the same framebuffer, loaded and stored its attachments for nothing:
+// its begin can be deferred to the first draw. Counted per window (COREPROF RPASS652 ended_empty= ended_short=
+// same_target_after_empty=); decision: deferral of the begin if same_target_after_empty is a large share of same_target.
+struct shape_counters
+{
+	std::atomic<std::uint64_t> ended_empty{0};             // passes ended with no draw recorded in them
+	std::atomic<std::uint64_t> ended_short{0};             // passes ended with 1 to 3 draws
+	std::atomic<std::uint64_t> same_target_after_empty{0}; // begins on the framebuffer a pass without a draw ended on
+};
+inline shape_counters shape{};
+// Draws recorded since the last begin (RSX thread; relaxed atomic for the helpers' other callers).
+inline std::atomic<std::uint32_t> draws_in_pass{0};
+
+inline void note_draw() noexcept
+{
+	draws_in_pass.store(draws_in_pass.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+// Slot of a call site (single writer). A std::source_location file name is a string literal of its translation unit,
+// stable for the life of the program. -1 when the table is full.
+inline int slot(const char* file, std::uint32_t line) noexcept
+{
+	for (std::size_t index = 0; index < site_capacity; index++)
+	{
+		auto& entry = counters.sites[index];
+		const char* known = entry.file.load(std::memory_order_acquire);
+		if (known == nullptr)
+		{
+			entry.line.store(line, std::memory_order_relaxed);
+			entry.file.store(file, std::memory_order_release);
+			return static_cast<int>(index);
+		}
+		if (known == file && entry.line.load(std::memory_order_relaxed) == line)
+		{
+			return static_cast<int>(index);
+		}
+	}
+	return -1;
+}
+
+// The previous end on one command buffer: its framebuffer and site.
+struct last_end
+{
+	const void* framebuffer = nullptr;
+	int site = -1;
+	bool valid = false;
+	bool empty = false; // REWINDBOX_PASS_SHAPE_910: the ended pass had no draw
+};
+
+inline void on_end(last_end& previous, const void* framebuffer, const char* file, std::uint32_t line) noexcept
+{
+	const int index = slot(file, line);
+	add(index >= 0 ? counters.sites[index].ends : counters.overflow);
+	const std::uint32_t draws = draws_in_pass.exchange(0, std::memory_order_relaxed);
+	if (draws == 0)
+	{
+		add(shape.ended_empty);
+	}
+	else if (draws <= 3)
+	{
+		add(shape.ended_short);
+	}
+	previous = { framebuffer, index, true, draws == 0 };
+}
+
+inline void on_begin(last_end& previous, const void* framebuffer) noexcept
+{
+	add(counters.begins);
+	draws_in_pass.store(0, std::memory_order_relaxed);
+	if (previous.valid && previous.empty && previous.framebuffer == framebuffer)
+	{
+		add(shape.same_target_after_empty);
+	}
+	if (!previous.valid)
+	{
+		add(counters.fresh);
+		return;
+	}
+
+	const bool same = previous.framebuffer == framebuffer;
+	add(same ? counters.same_target : counters.other_target);
+	if (previous.site >= 0)
+	{
+		add(same ? counters.sites[previous.site].same_target : counters.sites[previous.site].other_target);
+	}
+	previous.valid = false;
+}
+}
diff --git a/rpcs3/ios/IOSRsxLabelAccess.h b/rpcs3/ios/IOSRsxLabelAccess.h
new file mode 100644
index 0000000..cd745c8
--- /dev/null
+++ b/rpcs3/ios/IOSRsxLabelAccess.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Emu/Memory/vm.h"
+#include "Emu/Cell/lv2/sys_rsx.h"
+#include "ios/RPCS3IOSExperimentalPolicy.h"
+
+// REWINDBOX_ZCULL_ON_DEMAND_619 (ios/IOSZcullOnDemand.h): the RSX thread's own
+// reads and writes of GCM labels, notifies and flip semaphores. On a 16 KiB host
+// page the label area shares its page with local reports 0-703, which ZCULL
+// protects while one of them is pending: through the protected view, an RSX
+// label access would fault and switch the location to the upstream mode for the
+// rest of the boot. With the lever, the RSX thread reaches the GCM label/report
+// area, and any page ZCULL holds locked, through the unprotected view: the bytes
+// are the same, the page stays protected for the guest threads, whose accesses
+// are served on demand. Elsewhere, and without the lever, the protected view
+// (upstream) is kept.
+namespace rpcs3::ios::zcull_on_demand
+{
+template <typename T, typename Thread>
+auto rsx_label_ptr(Thread* rsx, u32 address)
+{
+	if (rpcs3::ios::get_experimental_policy().zcull_on_demand &&
+		(address - rsx->label_addr < sizeof(RsxReports) || rsx->ios_zcull_page_locked(address)))
+	{
+		return vm::get_super_ptr<T>(address);
+	}
+
+	return vm::_ptr<T>(address);
+}
+}
