+inline thread_local unsigned t_zcull_read_path = zcull_poll;
+// What a forced read is for when update() runs with a sync address: a report
+// read barrier unless a conditional render evaluation says otherwise.
+inline thread_local unsigned t_zcull_forced_path = zcull_forced;
+
+class ZcullPathScope final
+{
+    unsigned& slot_;
+    unsigned previous_;
+public:
+    ZcullPathScope(unsigned& slot, unsigned value) noexcept : slot_(slot), previous_(slot) { slot_ = value; }
+    ~ZcullPathScope() noexcept { slot_ = previous_; }
+    ZcullPathScope(const ZcullPathScope&) = delete;
+    ZcullPathScope& operator=(const ZcullPathScope&) = delete;
