+	bool m_draw_buffers_stale = true;
+	bool m_encoder_state_dirty = true;
+	u64 m_render_pass_serial = 0;
+	struct { u32 width = 0, height = 0; } m_render_pass_size;
+	u32 m_subdraw_id = 0;
+
+	// Ring data a draw may reuse when its registers did not change. Re-uploaded at every frame and after a full
+	// ring made the renderer wait (the reclaimed space may then hold newer data).
