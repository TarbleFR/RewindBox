+++ b/rpcs3/ios/IOSEarlySubmit.h
@@ -48,4 +48,61 @@ constexpr verdict decide(bool on, std::uint32_t draws, std::uint32_t this_frame,
 
 	return gpu_idle ? verdict::submit : verdict::gpu_busy;
 }
+
+// REWINDBOX_EARLY_SUBMIT_BOUNDARY_659: at the end of a draw the render pass of
+// that draw is still open, and a submission there ends it: the next draw on the
+// same framebuffer stores and reloads every attachment again (a tile flush on
+// the Apple GPU). Assassin's Creed begins about 44 passes per frame (RPASS652),
+// so in the boundary mode a submission decided at the end of a draw is armed
+// and taken where no pass is open anyway: at the start of a later draw, or once
+// that draw's textures are prepared, when their transitions or copies ended the
+// pass. An armed submission that meets no such point is taken at the end of the
+// draw after max_deferred_draws more draws, as before. Any other primary
+// submission (flip, flush request, ZCULL sync hint) carries the armed draws and
+// disarms it. Commands, their order and their synchronization are unchanged;
+// only the boundary moves.
+inline std::atomic<bool> at_pass_boundary{false};
+
+// 32 draws: in a host model of these frames (5.9 us of recording and 20 us of GPU per draw), a window of
+// 16 to 64 draws costs at most 0.3 ms per frame against the end-of-draw submission when a split pass
+// costs 0.1 ms, and saves 0.5 to 1.5 ms when it costs 0.5 ms; 32 halves the passes split by early
+// submissions there (7.0 to 4.0 per frame).
+constexpr std::uint32_t max_deferred_draws = 32;
+
+// armed: submissions armed at an open pass; boundary_starts / boundary_textures: taken at
+// the start of a draw / after its textures; fallback_submits: taken at the end of a draw
+// after max_deferred_draws more draws; disarmed: carried by another primary submission.
+inline std::atomic<std::uint64_t> armed{0}, boundary_starts{0}, boundary_textures{0}, fallback_submits{0}, disarmed{0};
+
+enum class deferral : std::uint8_t
+{
+	none,      // not armed: decide() applies
+	wait,      // armed: keep looking for a point without an open pass
+	fallback,  // armed for more than max_deferred_draws draws: submit at the end of this draw
+};
+
+// armed_draws: draws ended since the submission was armed, this one included (0: not armed).
+constexpr deferral at_draw_end(std::uint32_t armed_draws) noexcept
+{
+	if (!armed_draws)
+	{
+		return deferral::none;
+	}
+
+	return armed_draws > max_deferred_draws ? deferral::fallback : deferral::wait;
+}
+
+// A submit verdict waits for a pass boundary only in the boundary mode and
+// while a render pass is open; otherwise it is taken at once.
+constexpr bool arm_instead(bool boundary_mode, bool pass_open) noexcept
+{
+	return boundary_mode && pass_open;
+}
+
+// At the start of a draw or after its textures: an armed submission is taken
+// when no render pass is open and the recording can be interrupted.
+constexpr bool take_at_boundary(std::uint32_t armed_draws, bool pass_open, bool interruptible) noexcept
+{
+	return armed_draws && !pass_open && interruptible;
+}
 }
diff --git a/rpcs3/ios/IOSEnergy931.h b/rpcs3/ios/IOSEnergy931.h
new file mode 100644
index 0000000..411b7ea
--- /dev/null
+++ b/rpcs3/ios/IOSEnergy931.h
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <initializer_list>
+#include <string>
+
+// REWINDBOX_ENERGY_931: what the system bills this process for, per 5 s report window, so that a thermal change is
+// judged on the iPhone by energy per frame and not by a host bench ("aucun gain iPhone inventé depuis un banc hôte").
+// Sources, read once per window by the report thread (RPCS3IOSPerformance.cpp, sample_energy):
+// - proc_pid_rusage(RUSAGE_INFO_V6) on the process itself: ri_energy_nj and ri_penergy_nj (energy the system
+//   attributes to its CPU work, all cores and the performance cores, in nanojoules), ri_user/system_time and their
+//   _ptime parts (Mach time units, converted with mach_timebase_info), cycles and instructions, interrupt and package
+//   idle wakeups, CPU time by QoS class;
+// - task_info TASK_POWER_INFO: timer wakeups whose deadline was at most 2 ms away (bin 1) and 2 to 5 ms (bin 2)
+//   (osfmk/kern/sched_prim.c, thread_unblock);
+// - task_info TASK_POWER_INFO_V2: the GPU utilisation counter and the switches between core clusters, printed raw.
+// COREPROF ENERGY931 prints differences between two consecutive windows of the same boot only; a source the system
+// refuses is printed as unavailable, never as 0. Core 932: a counter that went back makes its metric invalid
+// (REWINDBOX_ENERGY_VALIDITY_932) and the line adds the storage traffic of the window (REWINDBOX_DISK_IO_932).
+namespace energy931
+{
+struct sample
+{
+	bool rusage_valid = false, power_valid = false, power_v2_valid = false;
+	std::uint32_t timebase_numer = 1, timebase_denom = 1;
+	std::uint64_t energy_nj = 0, p_energy_nj = 0;
+	std::uint64_t user_ticks = 0, system_ticks = 0, p_user_ticks = 0, p_system_ticks = 0;
+	std::uint64_t cycles = 0, instructions = 0, p_cycles = 0;
+	std::uint64_t interrupt_wakeups = 0, idle_wakeups = 0;
+	std::uint64_t qos_user_interactive_ticks = 0, qos_user_initiated_ticks = 0, qos_default_ticks = 0, qos_utility_ticks = 0;
+	// REWINDBOX_DISK_IO_932 (from ARMSX3's journal): bytes the process read from and wrote to storage, bytes it wrote
+	// through the file system whether or not they reached the storage yet (logical writes), and page-ins
+	// (ri_diskio_bytesread, ri_diskio_byteswritten, ri_logical_writes, ri_pageins of the same rusage_info_v6).
+	std::uint64_t disk_read_bytes = 0, disk_write_bytes = 0, logical_write_bytes = 0, pageins = 0;
+	std::uint64_t timer_wakeups_2ms = 0, timer_wakeups_5ms = 0;
+	std::uint64_t gpu_time = 0, pset_switches = 0;
+
+	bool any_valid() const noexcept
+	{
+		return rusage_valid || power_valid || power_v2_valid;
+	}
+};
+
+// REWINDBOX_ENERGY_VALIDITY_932 (maintainer audit, 11 Nov 2026): a counter that went back between two windows is a
+// discontinuity (a reset, another accounting), not a saving. Its metric, and every metric derived from it, prints
+// "invalid", never 0; the line counts them (discontinuities=). A window without frames prints mj_per_frame=no_frames,
+// one without CPU time p_share=no_cpu and one without cycles ipc=no_cycles; 0 is printed only for a real difference
+// of 0. The energy is the CPU energy the system attributes to this process, not the battery's consumption; the GPU
+// value is a raw counter, not watts.
+struct difference
+{
+	std::uint64_t value = 0;
+	bool valid = false;
+};
+
+constexpr difference diff(std::uint64_t now, std::uint64_t before) noexcept
+{
+	return now >= before ? difference{now - before, true} : difference{0, false};
+}
+
+constexpr difference sum(difference a, difference b) noexcept
+{
+	return {a.value + b.value, a.valid && b.valid};
+}
+
+inline double ticks_to_ms(std::uint64_t ticks, std::uint32_t numer, std::uint32_t denom) noexcept
+{
+	return denom ? static_cast<double>(ticks) * static_cast<double>(numer) / static_cast<double>(denom) / 1e6 : 0.0;
+}
+
+// " key=<value>" with the given format, " key=invalid", or " key=<absent_word>" when absent_word is set.
+struct line_builder
+{
+	std::string text;
+	std::uint32_t discontinuities = 0;
+
+	void raw(const char* key, const char* word)
+	{
+		text += ' ';
+		text += key;
+		text += '=';
+		text += word;
+	}
+
+	void number(const char* key, bool valid, const char* format, double value, const char* absent_word = nullptr)
+	{
+		if (!valid)
+		{
+			discontinuities++;
+			raw(key, "invalid");
+			return;
+		}
+		if (absent_word)
+		{
+			raw(key, absent_word);
+			return;
+		}
+		char part[64];
+		std::snprintf(part, sizeof(part), format, value);
+		raw(key, part);
+	}
+
+	void count(const char* key, difference d)
+	{
+		if (!d.valid)
+		{
+			discontinuities++;
+			raw(key, "invalid");
+			return;
+		}
+		char part[32];
+		std::snprintf(part, sizeof(part), "%" PRIu64, d.value);
+		raw(key, part);
+	}
+};
+
+inline std::string format_line(std::uint64_t session, std::uint64_t window, bool comparable, const sample& before, const sample& now,
+	std::uint64_t frames)
+{
+	const char* status = comparable ? "available" : now.any_valid() ? "first_window" : "unavailable";
+	const bool rusage = comparable && before.rusage_valid && now.rusage_valid;
+	const bool power = comparable && before.power_valid && now.power_valid;
+	const bool power2 = comparable && before.power_v2_valid && now.power_v2_valid;
+
+	line_builder out;
+	char head[160];
+	std::snprintf(head, sizeof(head), "COREPROF ENERGY931 session=%" PRIu64 " window=%" PRIu64 " energy=%s frames=%" PRIu64,
+		session, window, status, frames);
+	out.text = head;
+
+	if (rusage)
+	{
+		const auto ms = [&](difference d) { return ticks_to_ms(d.value, now.timebase_numer, now.timebase_denom); };
+		const difference energy = diff(now.energy_nj, before.energy_nj), p_energy = diff(now.p_energy_nj, before.p_energy_nj);
+		const difference cpu = sum(diff(now.user_ticks, before.user_ticks), diff(now.system_ticks, before.system_ticks));
+		const difference p_cpu = sum(diff(now.p_user_ticks, before.p_user_ticks), diff(now.p_system_ticks, before.p_system_ticks));
+		const difference cycles = diff(now.cycles, before.cycles), instructions = diff(now.instructions, before.instructions);
+		const difference p_cycles = diff(now.p_cycles, before.p_cycles);
+		const double mj = static_cast<double>(energy.value) / 1e6;
+		out.number("cpu_energy_mj", energy.valid, "%.1f", mj);
+		out.number("p_energy_mj", p_energy.valid, "%.1f", static_cast<double>(p_energy.value) / 1e6);
+		out.number("mj_per_frame", energy.valid, "%.3f", frames ? mj / static_cast<double>(frames) : 0.0, frames ? nullptr : "no_frames");
+		out.number("cpu_ms", cpu.valid, "%.1f", ms(cpu));
+		out.number("p_cpu_ms", p_cpu.valid, "%.1f", ms(p_cpu));
+		out.number("p_share", cpu.valid && p_cpu.valid, "%.3f", cpu.value ? ms(p_cpu) / ms(cpu) : 0.0, cpu.value ? nullptr : "no_cpu");
+		out.number("mcycles", cycles.valid, "%.1f", static_cast<double>(cycles.value) / 1e6);
+		out.number("p_mcycles", p_cycles.valid, "%.1f", static_cast<double>(p_cycles.value) / 1e6);
+		out.number("minstructions", instructions.valid, "%.1f", static_cast<double>(instructions.value) / 1e6);
+		out.number("ipc", cycles.valid && instructions.valid, "%.3f",
+			cycles.value ? static_cast<double>(instructions.value) / static_cast<double>(cycles.value) : 0.0, cycles.value ? nullptr : "no_cycles");
+		out.count("interrupt_wakeups", diff(now.interrupt_wakeups, before.interrupt_wakeups));
+		out.count("idle_wakeups", diff(now.idle_wakeups, before.idle_wakeups));
+
+		// One field, four parts: each part is a number or "invalid".
+		std::string qos;
+		for (const difference d : {diff(now.qos_user_interactive_ticks, before.qos_user_interactive_ticks),
+			diff(now.qos_user_initiated_ticks, before.qos_user_initiated_ticks), diff(now.qos_default_ticks, before.qos_default_ticks),
+			diff(now.qos_utility_ticks, before.qos_utility_ticks)})
+		{
+			char part[32];
+			if (d.valid)
+			{
+				std::snprintf(part, sizeof(part), "%.1f", ms(d));
+			}
+			else
+			{
+				out.discontinuities++;
+				std::snprintf(part, sizeof(part), "invalid");
+			}
+			qos += qos.empty() ? "" : ":";
+			qos += part;
+		}
+		out.raw("qos_ms", qos.c_str());
+
+		// REWINDBOX_DISK_IO_932
+		const auto mib = [](difference d) { return static_cast<double>(d.value) / (1024.0 * 1024.0); };
+		const difference disk_read = diff(now.disk_read_bytes, before.disk_read_bytes);
+		const difference disk_write = diff(now.disk_write_bytes, before.disk_write_bytes);
+		const difference logical_write = diff(now.logical_write_bytes, before.logical_write_bytes);
+		out.number("disk_read_mib", disk_read.valid, "%.2f", mib(disk_read));
+		out.number("disk_write_mib", disk_write.valid, "%.2f", mib(disk_write));
+		out.number("logical_write_mib", logical_write.valid, "%.2f", mib(logical_write));
+		out.count("pageins", diff(now.pageins, before.pageins));
+	}
+	else
+	{
+		out.raw("rusage", "unavailable");
+	}
+
+	if (power)
+	{
+		out.count("timer_wakeups_2ms", diff(now.timer_wakeups_2ms, before.timer_wakeups_2ms));
+		out.count("timer_wakeups_5ms", diff(now.timer_wakeups_5ms, before.timer_wakeups_5ms));
+	}
+	else
+	{
+		out.raw("timer_wakeups", "unavailable");
+	}
+
+	if (power2)
+	{
+		out.count("gpu_utilisation_delta", diff(now.gpu_time, before.gpu_time));
+		out.count("pset_switches", diff(now.pset_switches, before.pset_switches));
+	}
+	else
+	{
+		out.raw("gpu_utilisation_delta", "unavailable");
+	}
+
+	char tail[48];
+	std::snprintf(tail, sizeof(tail), "%u", out.discontinuities);
+	out.raw("discontinuities", tail);
+	out.text += " units=energy_nj_billed_by_system,times_mach_timebase,gpu_raw scope=process_window";
+	return out.text;
+}
+} // namespace energy931
diff --git a/rpcs3/ios/IOSEventWait931.h b/rpcs3/ios/IOSEventWait931.h
new file mode 100644
index 0000000..d5b5ed6
--- /dev/null
+++ b/rpcs3/ios/IOSEventWait931.h
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#if !defined(__aarch64__)
+#include <chrono>
+#endif
+
+#include "IOSShardedCounter931.h" // REWINDBOX_EVENT_WAIT_LATENCY_932
+
+// REWINDBOX_THERMAL_POLICY_931 (IOSThermalPolicy931.h): one exclusive-monitor wait. LDAXR arms the monitor on the
+// watched word's line; if the word still holds `seen`, WFE halts the core (clock-gated) until a write by another
+// core to that line clears the monitor, an interrupt arrives, or the system sends an event (XNU's event stream, when
+// it enables one; Core 932 measures how long the waits last instead of assuming it, see below); CLREX then drops the
+// monitor. A word that changed since `seen` was read returns at once. The caller keeps its
+// loop: it tests its condition again after every call, so a spurious wake (another field of the same line written)
+// costs one more turn. Apple's libplatform spin locks wait the same way (src/os/lock.c, OS_LOCK_SPIN_PAUSE). Other
+// architectures (host builds) keep the CPU's pause hint.
+namespace rpcs3::ios::event_wait
+{
+inline std::uint32_t load32(const void* word) noexcept
+{
+	return __atomic_load_n(static_cast<const std::uint32_t*>(word), __ATOMIC_ACQUIRE);
+}
+
+inline std::uint64_t load64(const void* word) noexcept
+{
+	return __atomic_load_n(static_cast<const std::uint64_t*>(word), __ATOMIC_ACQUIRE);
+}
+
+inline void hint() noexcept
+{
+#if defined(__aarch64__)
+	__asm__ volatile("yield" ::: "memory");
+#elif defined(__x86_64__) || defined(__i386__)
+	__builtin_ia32_pause();
+#endif
+}
+
+// REWINDBOX_EVENT_WAIT_LATENCY_932 (maintainer audit, 11 Nov 2026: validate the event waits by their wake latency; the
+// Core 931 harness only proved that a wait ends within a global 5 s bound): how long each WFE actually slept, read on
+// the generic timer around it, in five buckets (under 2 us, under 16 us, under 128 us, under 1 ms, longer) and the
+// longest, summed per report window (THERMAL931 wfe_latency_us=, wfe_longest_us=). A WFE ends on a write to the watched
+// line, on an interrupt, or on an event of the system when it sends them; how soon on an iPhone is what this measures,
+// not an assumption. A request posted on another line (a stop, a flush) is only seen once the WFE has ended.
+inline constexpr std::size_t latency_buckets = 5;
+inline sharded::block<latency_buckets + 1> latency{}; // the last field is the longest, in microseconds
+
+constexpr std::size_t latency_bucket(std::uint64_t us) noexcept
+{
+	return us < 2 ? 0 : us < 16 ? 1 : us < 128 ? 2 : us < 1000 ? 3 : 4;
+}
+
+inline std::uint64_t counter_now() noexcept
+{
+#if defined(__aarch64__)
+	std::uint64_t value;
+	// REWINDBOX_EVENT_WAIT_COUNTER_935: one instruction per string. For an Apple target ';' starts a comment in the
+	// assembler, so "isb; mrs ..." read nothing and returned whatever the register held: on the IPA 726 logs every
+	// THERMAL931 line shows wfe_latency_us in the first and last buckets only and wfe_longest_us=18446744073.
+	// No ISB: this is a duration for a histogram, read twice around each WFE.
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r"(value));
+	return value;
+#else
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+#endif
+}
+
+inline std::uint64_t counter_hz() noexcept
+{
+#if defined(__aarch64__)
+	std::uint64_t value;
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(value));
+	return value;
+#else
+	return 1'000'000'000ull;
+#endif
+}
+
+inline void record_latency(std::uint64_t ticks) noexcept
+{
+	static const std::uint64_t hz = counter_hz();
+	const std::uint64_t us = hz ? ticks * 1'000'000ull / hz : 0;
+	const std::size_t shard = sharded::shard_index();
+	latency.add_at(shard, latency_bucket(us), 1);
+	latency.raise_at(shard, latency_buckets, us);
+}
+
+inline void once32(const void* word, std::uint32_t seen) noexcept
+{
+#if defined(__aarch64__)
+	std::uint32_t value;
+	__asm__ volatile("ldaxr %w0, [%1]" : "=&r"(value) : "r"(word) : "memory");
+	if (value == seen)
+	{
+		const std::uint64_t begin = counter_now();
+		__asm__ volatile("wfe" ::: "memory");
+		const std::uint64_t end = counter_now();
+		__asm__ volatile("clrex" ::: "memory");
+		record_latency(end - begin);
+		return;
+	}
+	__asm__ volatile("clrex" ::: "memory");
+#else
+	(void)word;
+	(void)seen;
+	hint();
+#endif
+}
+
+inline void once64(const void* word, std::uint64_t seen) noexcept
+{
+#if defined(__aarch64__)
+	std::uint64_t value;
+	__asm__ volatile("ldaxr %x0, [%1]" : "=&r"(value) : "r"(word) : "memory");
+	if (value == seen)
+	{
+		const std::uint64_t begin = counter_now();
+		__asm__ volatile("wfe" ::: "memory");
+		const std::uint64_t end = counter_now();
+		__asm__ volatile("clrex" ::: "memory");
+		record_latency(end - begin);
+		return;
+	}
+	__asm__ volatile("clrex" ::: "memory");
+#else
+	(void)word;
+	(void)seen;
+	hint();
+#endif
+}
+} // namespace rpcs3::ios::event_wait
