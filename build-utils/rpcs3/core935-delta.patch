+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE: the native Metal 4 renderer (RSX commands -> Metal 4 -> Apple GPU).
+//
+// Stage M1 owns the Metal device, a Metal 4 command queue, its allocators, residency and the host's CAMetalLayer,
+// and presents the display buffer read from guest memory exactly as the Vulkan renderer does when no surface holds
+// it. Stage M2.2 executes the draws: RSX programs through the Metal shader stack, the shared surface store for
+// render targets, ring buffers for vertex streams, draw parameters, contexts and constants, Metal 4 argument tables,
+// and presents the surface that holds the display buffer. Stage M3.1 samples real textures through RPCS3's common
+// texture cache (MTLTextureCache.h): CPU uploads, render-to-texture, samplers from the RSX registers, protection-
+// based invalidation and section readback ("Write Color Buffers"). What is not written yet is counted (COREPROF
+// METAL), never faked: the blit engine (M3.2), the GPU-only transfers listed in MTLTextureCache.h. Requires iOS 26
+// and a Metal 4 GPU (Apple7 or later).
+// M4: ZCULL occlusion queries and conditional rendering on their results (MTLQueries), MSAA surfaces with resolve and
+// unresolve (MTLResolve), the conversion compute kernels (MTLComputeTasks, also the typeless copies of the transfers),
+// the native overlays (MTLOverlays).
+
+#include "Emu/RSX/GSRender.h"
+#include "MTLAPI.h"
+#include "MTLCommandContext.h"
+#include "MTLDataHeap.h"
+#include "MTLPipelineState.h"
+#include "MTLProgramBuffer.h"
+#include "MTLRenderTargets.h"
+#include "MTLBlit.h"
+#include "MTLTextureCache.h"
+// M4
+#include "MTLComputeTasks.h"
+#include "MTLM4Counters.h"
+#include "MTLOverlays.h"
+#include "MTLQueries.h"
+#include "MTLResolve.h"
+// M4 end
+#include "MTLPipelineArchive.h"  // M5
+
+#include "Utilities/mutex.h"
+
+#include <list>
+
+#include <array>
+#include <atomic>
+#include <optional>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace mtl
+{
+	// What the renderer has done or not executed yet; read and reset by the performance window.
+	struct stage_counters
+	{
+		std::atomic<u64> draws_rendered{0};
+		std::atomic<u64> draws_skipped_program{0};       // program/pipeline missing (counted per draw, as Vulkan skips)
+		std::atomic<u64> draws_skipped_no_vertices{0};
+		std::atomic<u64> draws_cull_both_faces{0};       // triangles with both faces culled: nothing rasterized
+		std::atomic<u64> textures_not_bound{0};          // referenced, enabled units without a texture (neutral texture bound)
+		std::atomic<u64> textures_bound{0};
+		std::atomic<u64> flush_requests{0};              // guest-thread faults served by the RSX thread
+		std::atomic<u64> offloader_faults{0};            // DMA offloader faults handled without a flush (as VK)
+		std::atomic<u64> clears{0};
+		std::atomic<u64> logic_ops_not_applied{0};
+		std::atomic<u64> occlusion_queries_not_measured{0};
+		std::atomic<u64> frames_presented{0};
+		std::atomic<u64> frames_from_surface{0};
+		std::atomic<u64> frames_from_guest_memory{0};
+		std::atomic<u64> frames_without_source{0};
+		std::atomic<u64> unsupported_display_formats{0};
+		std::atomic<u64> drawable_misses{0};
+		std::atomic<u64> slow_gpu_waits{0};
+		std::atomic<u64> ring_exhaustions{0};
+	};
+
+	stage_counters& counters() noexcept;
+
+	// Per-draw upload result (VKVertexBuffers.cpp vertex_upload_info).
+	struct vertex_upload_info
+	{
+		primitive_type primitive = primitive_type::triangle;
+		u32 vertex_draw_count = 0;
+		u32 allocated_vertex_count = 0;
+		u32 first_vertex = 0;
+		u32 vertex_index_base = 0;
