+struct ppu_sampling
+{
+	std::vector<stx::shared_ptr<named_thread<ppu_thread>>> threads;
+	std::array<capture::ppu_profile::histogram, capture::ppu_profile::max_threads> tracked{};
+	std::array<std::array<std::pair<const char*, u32>, 8>, capture::ppu_profile::max_threads> wait_calls{};
+	u32 tracked_count = 0;
+	// REWINDBOX_SPU_PROFILE_923: the SPU threads listed when the capture started, one histogram each.
+	std::vector<stx::shared_ptr<named_thread<spu_thread>>> spu_threads;
+	std::array<capture::ppu_profile::histogram, rpcs3::ios::auto_spu_profile::max_threads> spu_tracked{};
+	std::array<std::array<std::pair<const char*, u32>, 6>, rpcs3::ios::auto_spu_profile::max_threads> spu_wait_calls{};
+	// REWINDBOX_SPU_WAIT_SITE_930: what each waiting sample waited on (spu_wait_calls is the last named call, not the wait).
+	std::array<std::array<u32, rpcs3::ios::spu_wait_site::count>, rpcs3::ios::auto_spu_profile::max_threads> spu_wait_sites{};
+	std::array<std::string, rpcs3::ios::auto_spu_profile::max_threads> spu_names;
+	u32 spu_count = 0;
+	u32 spu_listed = 0;
+	u64 others_running = 0;
+	u32 samples = 0;
+	u64 started_us = 0, ended_us = 0;
+	u64 session = 0;  // the boot session that armed this capture, and its number in that session
+	u32 number = 0;
+	u32 thread_count = 0;
+	std::array<std::string, capture::ppu_profile::max_threads> names;
+	std::atomic<bool> stop{false};
+	std::atomic<bool> done{false};
+	std::thread worker;
+
+	void run()
+	{
+		while (samples < capture::ppu_profile::max_samples && !stop.load(std::memory_order_relaxed) &&
+			Emu.GetStatus(false) == system_state::running)
+		{
+			for (const auto& ptr : threads)
+			{
+				const ppu_thread& ppu = *ptr;
+				u32 slot = tracked_count;
+
+				for (u32 i = 0; i < tracked_count; i++)
+				{
+					if (tracked[i].thread_id == ppu.id)
+					{
+						slot = i;
+						break;
+					}
+				}
+
+				const bool waiting = !!(ppu.state & cpu_flag::wait);
+
+				if (slot == tracked_count)
+				{
+					// Tracked: the first thread of the list (the title's main thread), then the first seen running.
+					if (tracked_count >= capture::ppu_profile::max_threads || (waiting && &ptr != &threads.front()))
+					{
+						others_running += !waiting;
+						continue;
+					}
+
+					tracked[tracked_count++].thread_id = ppu.id;
+				}
+
+				if (!waiting)
+				{
+					tracked[slot].add_running(ppu.cia);
+					continue;
+				}
+
+				tracked[slot].add_waiting();
+				const char* call = ppu.current_function;
+
+				for (auto& [name, count] : wait_calls[slot])
+				{
+					if (count == 0 || name == call)
+					{
+						name = call;
+						count++;
+						break;
+					}
+				}
+			}
+
+			// REWINDBOX_SPU_PROFILE_923: the same reads for the SPU threads (state, pc, the system call of a waiting one).
+			for (u32 i = 0; i < spu_count; i++)
+			{
+				const spu_thread& spu = *spu_threads[i];
+
+				if (!(spu.state & cpu_flag::wait))
+				{
+					spu_tracked[i].add_running(spu.pc);
+					continue;
+				}
+
+				spu_tracked[i].add_waiting();
+				{
+					// REWINDBOX_SPU_WAIT_SITE_930: the flags, the instruction at the pc saved before the blocking call and the
+					// last MFC command (racy reads of the sampled thread, as for pc above; nothing is written there).
+					namespace site = rpcs3::ios::spu_wait_site;
+					const auto flags = +spu.state;
+					site::state_bits bits;
+					bits.pause = !!(flags & cpu_flag::pause);
+					bits.suspend = !!(flags & cpu_flag::suspend);
+					bits.memory = !!(flags & cpu_flag::memory);
+					bits.debug = !!(flags & (cpu_flag::dbg_global_pause + cpu_flag::dbg_pause));
+					const u32 insn = spu._ref<u32>(spu.pc & 0x3fffc);
+					spu_wait_sites[i][site::classify(bits, insn, static_cast<u8>(spu.ch_mfc_cmd.cmd))]++;
+				}
+				const char* call = spu.current_func;
+
+				for (auto& [name, count] : spu_wait_calls[i])
+				{
+					if (count == 0 || name == call)
+					{
+						name = call;
+						count++;
+						break;
+					}
+				}
+			}
+
+			samples++;
+			std::this_thread::sleep_for(std::chrono::microseconds(1000));
+		}
