+// REWINDBOX_GPU_BACKGROUND_GATE_927, REWINDBOX_GPU_DEACTIVATION_GATE_928 (ios/IOSGpuBackgroundGate.h). The blocks are
+// given no queue, so they run on the thread that posts the notification, the main thread, inside the transition: the
+// gate is closed and the queues have settled when the application is deactivated, the background notification
+// finishes what is left, and nothing is committed again before the application is active.
+namespace rpcs3::ios::gpu_gate
+{
+void install_application_observers() noexcept
+{
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		@autoreleasepool
+		{
+			NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+			id resign = [center addObserverForName:UIApplicationWillResignActiveNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { gate::instance().app_will_resign_active(); }];
+			id background = [center addObserverForName:UIApplicationDidEnterBackgroundNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { gate::instance().app_entered_background(); }];
+			id active = [center addObserverForName:UIApplicationDidBecomeActiveNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { gate::instance().app_became_active(); }];
+			// Registered for the life of the process.
+			static_cast<void>(CFBridgingRetain(resign));
+			static_cast<void>(CFBridgingRetain(background));
+			static_cast<void>(CFBridgingRetain(active));
+			// REWINDBOX_BACKGROUND_PAUSE_931, REWINDBOX_THERMAL_POLICY_931: their own observers; the pause and the resume
+			// wait for the posting to return, so for the gate's settle and reopening above (RPCS3IOSPlatform.mm, below).
+			rpcs3::ios::background_pause::install_observers();
+
+			// The first renderer of the process may be created while the application is already inactive or in the
+			// background (a game started just before leaving): no notification will say so. The state is read on
+			// the main thread, where the notifications are posted, so the two cannot cross.
+			dispatch_async(dispatch_get_main_queue(), ^{
+				if (UIApplication.sharedApplication.applicationState != UIApplicationStateActive)
+				{
+					gate::instance().app_found_not_active();
+				}
+			});
+		}
+	});
+}
+}
