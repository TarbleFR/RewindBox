+	// M4: VKGSRender::sync_hint (flushes for ZCULL hints).
+	void sync_hint(rsx::FIFO::interrupt_hint hint, rsx::reports::sync_hint_payload_t payload) override;
+	// M4 end
+#ifdef RPCS3_IOS
+	// M5: the iOS ZCULL hooks of VKGSRender (REWINDBOX_ZCULL_DEPTH_GUARD_660, REWINDBOX_ZCULL_WATCHED_FLUSH_660,
+	// MTLQueries.cpp): the open command buffer's serial while a query is in it, and the boundary submission of that
+	// buffer armed for a watched report.
+	u64 ios_open_cb_serial(rsx::reports::occlusion_query_info* query) override;
+	rpcs3::ios::zcull_watched::arm_result ios_arm_watched_submit(rsx::reports::occlusion_query_info* query) override;
+#endif
+
+private:
+	static constexpr u32 frames_in_flight = 3;
+
+	// The rings whose space is reclaimed per frame.
