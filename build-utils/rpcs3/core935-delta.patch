diff --git a/rpcs3/ios/IOSFreezeChain916.h b/rpcs3/ios/IOSFreezeChain916.h
new file mode 100644
index 0000000..8046ddf
--- /dev/null
+++ b/rpcs3/ios/IOSFreezeChain916.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_FREEZE_CHAIN_916: two bounded walks of the stall dump, kept apart so that they are executed by a host test.
+//
+// 1. The threads queued on a kernel object, read from the object's own queue. The lwcond lines of Core 908 named a
+//    condition's waiters by r3 of the waiting threads, but _sys_lwcond_queue_wait stores its return value (0) in r3
+//    before it sleeps: on build 718 (Black Flag, PID 44597) twelve threads waited on lightweight conditions and no
+//    lwcond line was printed. The queue of the condition itself does not depend on a register.
+// 2. The return addresses of a waiting or polling PPU thread, from its stack back chain: where in the game the wait
+//    was asked from (the dump only had the address inside the system library). PowerPC 64-bit ELF ABI as the PS3 uses
+//    it: the doubleword at the stack pointer is the caller's stack pointer, and a function saves its return address
+//    at 16 bytes above the caller's stack pointer.
+namespace rpcs3::ios::freeze_chain
+{
+// first: the head of an intrusive queue; next(node) the following node or null; id(node) what to record.
+// Returns the number recorded (at most cap); `more` says whether the queue went on.
+template <typename Node, typename Next, typename Id>
+std::size_t queue_ids(const Node* first, Next&& next, Id&& id, std::uint32_t* out, std::size_t cap, bool& more)
+{
+	std::size_t count = 0;
+	more = false;
+
+	// A queue being changed while it is read without its lock would loop: the caller holds the object's lock, and the
+	// walk is bounded anyway.
+	std::size_t steps = 0;
+
+	for (const Node* node = first; node && steps < 64; node = next(node), steps++)
+	{
+		if (count == cap)
+		{
+			more = true;
+			break;
+		}
+
+		out[count++] = id(node);
+	}
+
+	return count;
+}
+
+// sp: the thread's stack pointer; readable(address) whether 8 bytes can be read there; read64(address) the big-endian
+// doubleword in host order. Writes the saved return addresses, innermost first; stops at an unreadable address, a
+// null or non-increasing back chain (the stack grows down: a caller's frame is above), or cap.
+template <typename Readable, typename Read64>
+std::size_t back_chain(std::uint64_t sp, Readable&& readable, Read64&& read64, std::uint32_t* out, std::size_t cap)
+{
+	std::size_t count = 0;
+
+	while (count < cap)
+	{
+		if (!sp || sp > 0xffffffffull || (sp & 15) || !readable(static_cast<std::uint32_t>(sp)))
+		{
+			break;
+		}
+
+		const std::uint64_t caller = read64(static_cast<std::uint32_t>(sp));
+
+		if (caller <= sp || caller > 0xffffffffull || caller - sp > 0x100000 || !readable(static_cast<std::uint32_t>(caller + 16)))
+		{
+			break;
+		}
+
+		out[count++] = static_cast<std::uint32_t>(read64(static_cast<std::uint32_t>(caller + 16)));
+		sp = caller;
+	}
+
+	return count;
+}
+} // namespace rpcs3::ios::freeze_chain
diff --git a/rpcs3/ios/IOSGow3MlaaPatch.h b/rpcs3/ios/IOSGow3MlaaPatch.h
new file mode 100644
index 0000000..df1f2ec
--- /dev/null
+++ b/rpcs3/ios/IOSGow3MlaaPatch.h
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+// REWINDBOX_GOW3_MLAA_100_916: the PPU half of the God of War III MLAA bypass, per executable.
+//
+// Build 718, BCES00510, PID 45272, sessions 4 and 5: the title's setting "God of War III MLAA Bypass" is Enabled
+// (boot policy gow3_mlaa=1), the executable is PPU-4d5c5150... (application 01.00) and COREPROF GOW3MLAA909 reports
+// that nothing was applied: the bypass knew the 01.03 executable only. In the slow windows the PPU main thread uses
+// 0.93 core and the SPU threads 2.99 cores, and every frame one SPU reads the 1280x720 colour buffer back
+// (READBACK555 fault_read 58 per window of 57 frames, 3.8 ms on average, 18 ms at most).
+//
+// RPCS3's patch repository holds "Disable MLAA" (authors illusion, ZEROx; patch version 3.0) for both executables:
+//   PPU-19724fde16a5b111b7b4d2a065f5dccaf8e01962 (01.03): [ byte, 0x52BF2F, 0 ], [ be32, 0x0023137c, 0x60000000 ]
+//   PPU-4d5c51503a81a327c2a99427390a395b8dcb3767 (01.00): [ byte, 0x52BF2F, 0 ], [ be32, 0x00231248, 0x60000000 ]
+// The be32 line removes one call (the author: "A few nop to the call 0x230c4c narrowed down to 0x0023137c"); the byte
+// is the game's own flag. The 01.03 pair is the one delivered since Build 351 (it clears the whole word 0x52bf2c, an
+// earlier version of the same patch) and is kept as it is. The 01.00 pair is applied only on that exact executable
+// and only if the word to replace is a relative call and the flag byte holds 0 or 1: any other content refuses the
+// whole pair and says so (COREPROF GOW3MLAA909 ppu=refused_guard), so a different executable is never patched.
+// Like every executable patch it is applied at a fresh boot; a savestate carries the memory of the boot it was made
+// from, and the report says whether that memory holds the patch (savestate_patched=).
+namespace rpcs3::ios::gow3_mlaa_patch
+{
+struct plan
+{
+	std::string_view executable; // "PPU-<sha1>"
+	std::string_view version;
+	std::uint32_t flag_address;  // one byte, set to 0
+	std::uint32_t call_address;  // one big-endian word, set to nop
+	bool guarded;                // check the content before writing
+	bool clear_flag_word;        // the delivered 01.03 form: the big-endian word that ends with the flag byte
+};
+
+constexpr std::uint32_t nop = 0x60000000;
+
+constexpr plan plans[] = {
+	{"PPU-19724fde16a5b111b7b4d2a065f5dccaf8e01962", "01.03", 0x0052bf2f, 0x0023137c, false, true},
+	{"PPU-4d5c51503a81a327c2a99427390a395b8dcb3767", "01.00", 0x0052bf2f, 0x00231248, true, false},
+};
+
+constexpr const plan* find(std::string_view executable) noexcept
+{
+	for (const plan& candidate : plans)
+	{
+		if (candidate.executable == executable)
+		{
+			return &candidate;
+		}
+	}
+
+	return nullptr;
+}
+
+// bl target: primary opcode 18, relative (AA = 0), link (LK = 1).
+constexpr bool is_relative_call(std::uint32_t word) noexcept
+{
+	return (word & 0xfc000003u) == 0x48000001u;
+}
+
+enum class outcome : std::uint8_t { applied, already_applied, refused_guard };
+
+struct result
+{
+	outcome what = outcome::refused_guard;
+	std::uint32_t call_word = 0; // the word found at call_address before any write
+	std::uint8_t flag_byte = 0;  // the byte found at flag_address before any write
+	std::uint32_t writes = 0;
+};
+
+// read32/write32 take a guest address and a host-order value of the big-endian word; read8/write8 one byte.
+// `wrote(address)` is called for each address whose content changed (the loader's list of applied patches).
+template <typename Read8, typename Read32, typename Write8, typename Write32, typename Wrote>
+result apply(const plan& p, Read8&& read8, Read32&& read32, Write8&& write8, Write32&& write32, Wrote&& wrote)
+{
+	result r;
+	r.call_word = read32(p.call_address);
+	r.flag_byte = read8(p.flag_address);
+
+	if (p.guarded)
+	{
+		const bool call_ok = r.call_word == nop || is_relative_call(r.call_word);
+		const bool flag_ok = r.flag_byte <= 1;
+
+		if (!call_ok || !flag_ok)
+		{
+			r.what = outcome::refused_guard;
+			return r;
+		}
+	}
+
+	if (p.clear_flag_word)
+	{
+		const std::uint32_t word_address = p.flag_address & ~3u;
+
+		if (read32(word_address) != 0)
+		{
+			write32(word_address, 0);
+			wrote(word_address);
+			r.writes++;
+		}
+	}
+	else if (r.flag_byte != 0)
+	{
+		write8(p.flag_address, 0);
+		wrote(p.flag_address);
+		r.writes++;
+	}
+
+	if (r.call_word != nop)
+	{
+		write32(p.call_address, nop);
+		wrote(p.call_address);
+		r.writes++;
+	}
+
+	r.what = r.writes ? outcome::applied : outcome::already_applied;
+	return r;
+}
+
+// Does this memory hold the patch (a savestate made from a boot that applied it)?
+template <typename Read8, typename Read32>
+bool present(const plan& p, Read8&& read8, Read32&& read32)
+{
+	return read32(p.call_address) == nop && read8(p.flag_address) == 0;
+}
+} // namespace rpcs3::ios::gow3_mlaa_patch
diff --git a/rpcs3/ios/IOSGow3MlaaReport.h b/rpcs3/ios/IOSGow3MlaaReport.h
new file mode 100644
index 0000000..a300a0d
--- /dev/null
+++ b/rpcs3/ios/IOSGow3MlaaReport.h
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+// REWINDBOX_GOW3_MLAA_REPORT_909: God of War III, build 694 device log: CONFIG_LAYERS mlaa_bypass=1 is the policy, not
+// the patch. The executable was PPU-4d5c51503a81... (app 01.00, the BCES00510 cache directory), while the PPU half of the
+// bypass is gated to PPU-19724fde... (01.03) and skipped on a savestate boot; only the SPU half (exact SPU image hashes)
+// can apply, and every frame still read back one 1280x720x4 surface and received five SPU writes of the label the RSX
+// waits on. This records what was actually applied (COREPROF GOW3MLAA909): the PPU decision, the SPU images of the title
+// checked, the ones patched, and the first distinct SPU image hashes that matched no patch.
+namespace rpcs3::ios::gow3_mlaa
+{
+enum class ppu_state : std::uint32_t
+{
+	unset = 0, applied, other_executable, savestate, policy_off,
+	refused_guard, // REWINDBOX_GOW3_MLAA_100_916: the executable is known, its content is not what the patch replaces
+	// REWINDBOX_GOW3_MLAA_SAVESTATE_922: the pair written into the restored memory of a savestate. Not produced since
+	// REWINDBOX_GOW3_MLAA_SAVESTATE_UNTOUCHED_929 (PPUModule.cpp); kept so the reports of builds 724 and 725 read the same.
+	savestate_applied
+};
+
+inline std::atomic<std::uint32_t> ppu{0};
+// REWINDBOX_GOW3_MLAA_100_916 (ios/IOSGow3MlaaPatch.h): the word found where the call is removed, the patch's version
+// of the application (0 = no patch for this executable, else 100 or 103), and for a savestate boot whether its
+// memory holds the patch (-1 = not a savestate boot or no patch for this executable).
+inline std::atomic<std::uint32_t> ppu_call_word{0}, ppu_patch_version{0};
+inline std::atomic<std::int32_t> savestate_patched{-1};
+inline std::atomic<std::uint64_t> spu_images{0}, spu_matched{0}, spu_words_patched{0};
+
+constexpr std::size_t hash_slots = 6;
+inline std::mutex hashes_mutex;
+inline std::array<std::array<char, 48>, hash_slots> unmatched{};
+inline std::size_t unmatched_count = 0;
+inline std::array<char, 48> executable{};
+
+inline void store(std::array<char, 48>& slot, std::string_view text) noexcept
+{
+	const std::size_t n = text.size() < slot.size() - 1 ? text.size() : slot.size() - 1;
+	std::memcpy(slot.data(), text.data(), n);
+	slot[n] = '\0';
+}
+
+inline void record_executable(std::string_view hash, ppu_state state) noexcept
+{
+	{
+		std::lock_guard lock(hashes_mutex);
+		store(executable, hash);
+	}
+	ppu.store(static_cast<std::uint32_t>(state), std::memory_order_relaxed);
+}
+
+inline void record_unmatched_spu(std::string_view hash) noexcept
+{
+	std::lock_guard lock(hashes_mutex);
+	for (std::size_t i = 0; i < unmatched_count; ++i)
+	{
+		if (std::string_view(unmatched[i].data()) == hash) return;
+	}
+	if (unmatched_count < hash_slots) store(unmatched[unmatched_count++], hash);
+}
+
+inline const char* ppu_name(std::uint32_t state) noexcept
+{
+	switch (static_cast<ppu_state>(state))
+	{
+	case ppu_state::applied: return "applied";
+	case ppu_state::other_executable: return "other_executable";
+	case ppu_state::savestate: return "savestate_memory";
+	case ppu_state::policy_off: return "policy_off";
+	case ppu_state::refused_guard: return "refused_guard";
+	case ppu_state::savestate_applied: return "savestate_applied";
+	default: return "unset";
+	}
+}
+
+// Comma-separated list of the unmatched SPU image hashes, and the executable hash.
+inline std::string unmatched_list()
+{
+	std::lock_guard lock(hashes_mutex);
+	std::string out;
+	for (std::size_t i = 0; i < unmatched_count; ++i)
+	{
+		if (i) out += ',';
+		out += unmatched[i].data();
+	}
+	return out.empty() ? std::string("-") : out;
+}
+
+inline std::string executable_hash()
+{
+	std::lock_guard lock(hashes_mutex);
+	return executable[0] ? std::string(executable.data()) : std::string("-");
+}
+} // namespace rpcs3::ios::gow3_mlaa
diff --git a/rpcs3/ios/IOSGpuBackgroundGate.h b/rpcs3/ios/IOSGpuBackgroundGate.h
new file mode 100644
index 0000000..9eba5d8
--- /dev/null
+++ b/rpcs3/ios/IOSGpuBackgroundGate.h
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+// REWINDBOX_GPU_BACKGROUND_GATE_927: iOS executes no Metal command buffer for an application in the background. One
+// committed there fails with MTLCommandBufferErrorNotPermitted, and MoltenVK then reports the device and the physical
+// device lost, whatever MVK_CONFIG_RESUME_LOST_DEVICE says (MVKQueue::handleMTLCommandBufferError, MVKQueue.mm:234-241):
+// the next Vulkan call ends the RSX thread. Nothing told the renderer about the transition; it kept submitting until
+// iOS suspended the process.
+//
+// IPA 650, Assassin's Creed, pid 8767, asynchronous MoltenVK submits: "Device lost" raised by vkGetQueryPoolResults at
+// 1793814730.525, HOST_STATE app=background recorded at 1793814730.555 by the host's own observer of
+// UIApplicationDidEnterBackgroundNotification. It is the only device loss of the device journals. A command buffer
+// had therefore been refused at least 30 ms before that observer ran: iOS does not wait for the application to have
+// handled the background notification.
+//
+// REWINDBOX_GPU_DEACTIVATION_GATE_928: the gate follows the procedure of Apple's Metal documentation ("Preparing your
+// Metal app to run in the background"): when the application is deactivated, stop sending work to Metal ("you've some
+// time before the system restricts your app from using Metal"); when it enters the background, make sure everything
+// committed is scheduled before returning; enable the code again only once the application is reactivated. Core 927
+// closed the gate at the background notification only, which the journal above shows can be too late.
+//
+// The Core listens to the application itself (RPCS3IOSPlatform.mm), on the thread that posts, inside each transition:
+// - UIApplicationWillResignActiveNotification closes the gate. A thread about to submit, present, acquire an image
+//   or wait for the device parks before the call. The posting thread waits for the calls already inside, then for
+//   everything queued so far to be encoded and executed (the renderer's settle function: an empty submission with a
+//   fence on each queue). Each wait is bounded. When a call is still inside after its limit the settle is skipped,
+//   because the queues are not the posting thread's to use then.
+// - UIApplicationDidEnterBackgroundNotification finishes what the deactivation left: nothing when it settled; a wait,
+//   without any new submission, for the fences a settle left unsignalled; the whole procedure when no settle ran or
+//   when the settle never reached the queues.
+// - UIApplicationDidBecomeActiveNotification opens the gate and the parked calls run, in their order.
+// Nothing is dropped, skipped or reordered: the calls happen later. While the application is inactive (Control
+// Centre, the application switcher, a system alert) the picture therefore stands still and the game waits for its
+// renderer; it goes on when the application is active again.
+// A thread of an emulator that is being stopped does not park (the bypass function): stopping while inactive or in
+// the background goes on as it did before the gate existed.
+namespace rpcs3::ios::gpu_gate
+{
+// The patience of the thread that closes the gate (iOS gives the transition about five seconds in all).
+inline constexpr std::chrono::milliseconds in_flight_limit{500};
+inline constexpr std::chrono::milliseconds settle_limit{1000};
+
+// A parked call looks at the bypass function this often.
+inline constexpr std::chrono::milliseconds park_slice{100};
+
+// Since boot (COREPROF GPUGATE928).
+inline std::atomic<std::uint64_t> deactivations{0}, backgrounds{0}, found_not_active{0};
+inline std::atomic<std::uint64_t> closes{0}, opens{0};
+inline std::atomic<std::uint64_t> parks{0}, park_us{0}, park_bypasses{0};
+inline std::atomic<std::uint64_t> in_flight_timeouts{0};
+inline std::atomic<std::uint64_t> settles{0}, settle_us{0}, settle_timeouts{0};
+// Second attempts of a closing whose settle timed out (the background notification after the deactivation).
+inline std::atomic<std::uint64_t> settle_waits{0}, settle_wait_us{0}, settle_wait_timeouts{0};
+
+inline std::uint64_t elapsed_us(std::chrono::steady_clock::time_point since) noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now() - since).count());
+}
+
+// Encoded and executed, or the limit passed: returns whether everything queued before the call completed. resume:
+// an earlier call since the gate closed returned false. The fences that call left are then waited for without a new
+// submission; only when it left none (it never reached the queues) is the whole settle done now.
+using settle_function = bool (*)(std::chrono::milliseconds limit, bool resume);
+// Called by a parked thread: whether that thread must go on although the gate is closed (its emulator is stopping).
+using bypass_function = bool (*)();
+
+class gate
+{
+	std::mutex m_mutex;
+	std::condition_variable m_opened; // parked calls
+	std::condition_variable m_idle;   // the thread that closes
+	bool m_closed = false;
+	std::uint32_t m_inside = 0;
+
+	// Held while the settle function runs, so the renderer that owns it cannot go away under it.
+	std::mutex m_settle_mutex;
+	settle_function m_settle = nullptr;
+	// Since the gate closed: a settle ran, and it saw everything complete.
+	bool m_settle_ran = false;
+	bool m_settled = false;
+	std::atomic<bypass_function> m_bypass{nullptr};
+
+public:
+	static gate& instance() noexcept
+	{
+		static gate s_gate;
+		return s_gate;
+	}
+
+	// Before a call that gives work to the GPU. Parks while the gate is closed.
+	void enter() noexcept
+	{
+		std::unique_lock lock(m_mutex);
+		if (m_closed)
+		{
+			const auto begin = std::chrono::steady_clock::now();
+			bool parked = false;
+			for (;;)
+			{
+				// Looked at before the first wait too: a stopping emulator makes many calls and none of them waits.
+				const bypass_function bypass = m_bypass.load(std::memory_order_relaxed);
+				if (bypass && bypass())
+				{
+					park_bypasses.fetch_add(1, std::memory_order_relaxed);
+					break;
+				}
+
+				if (!parked)
+				{
+					parked = true;
+					parks.fetch_add(1, std::memory_order_relaxed);
+				}
+
+				if (m_opened.wait_for(lock, park_slice, [this] { return !m_closed; }))
+				{
+					break;
+				}
+			}
+
+			if (parked)
+			{
+				park_us.fetch_add(elapsed_us(begin), std::memory_order_relaxed);
+			}
+		}
+
+		++m_inside;
+	}
+
+	// After the call.
+	void leave() noexcept
+	{
+		bool idle = false;
+		{
+			std::lock_guard lock(m_mutex);
+			idle = --m_inside == 0;
+		}
+
+		if (idle)
+		{
+			m_idle.notify_all();
+		}
+	}
+
+	// No new call enters from now on. Returns whether the calls already inside left within the limit.
+	bool close(std::chrono::milliseconds limit = in_flight_limit) noexcept
+	{
+		std::unique_lock lock(m_mutex);
+		if (!m_closed)
+		{
+			m_closed = true;
+			closes.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		const bool idle = m_idle.wait_for(lock, limit, [this] { return m_inside == 0; });
+		if (!idle)
+		{
+			in_flight_timeouts.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		return idle;
+	}
+
+	void open() noexcept
+	{
+		{
+			std::lock_guard lock(m_mutex);
+			if (!m_closed)
+			{
+				return;
+			}
+
+			m_closed = false;
+			opens.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		m_opened.notify_all();
+
+		// The next closing starts from nothing settled. Never held together with m_mutex.
+		std::lock_guard lock(m_settle_mutex);
+		m_settle_ran = m_settled = false;
+	}
+
+	bool closed() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return m_closed;
+	}
+
+	// The renderer gives its settle function once its device exists and takes it back (null) before the device
+	// goes; taking it back waits for a settle in progress.
+	void set_settle(settle_function settle) noexcept
+	{
+		std::lock_guard lock(m_settle_mutex);
+		m_settle = settle;
+		// Another renderer, or none: what the previous one settled says nothing about this one.
+		m_settle_ran = m_settled = false;
+	}
+
+	// A function that never goes away (it is looked at by parked threads without a lock), or null.
+	void set_bypass(bypass_function bypass) noexcept
+	{
+		m_bypass.store(bypass, std::memory_order_relaxed);
+	}
+
+private:
+	// No new call from now on; the calls inside leave; then what is queued completes. Bounded at every step.
+	void stop_and_settle() noexcept
+	{
+		if (!close())
+		{
+			// A call is still inside (counted): the queues are in use, nothing more can be asked of them from here.
+			return;
+		}
+
+		std::lock_guard lock(m_settle_mutex);
+		if (!m_settle || m_settled)
+		{
+			return;
+		}
+
+		const auto begin = std::chrono::steady_clock::now();
+		const bool resume = m_settle_ran;
+		m_settle_ran = true;
+		m_settled = m_settle(settle_limit, resume);
+		if (!resume)
+		{
+			settles.fetch_add(1, std::memory_order_relaxed);
+			settle_us.fetch_add(elapsed_us(begin), std::memory_order_relaxed);
+			if (!m_settled)
+			{
+				settle_timeouts.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+		else
+		{
+			// A settle of this closing already timed out (background notification after the deactivation).
+			settle_waits.fetch_add(1, std::memory_order_relaxed);
+			settle_wait_us.fetch_add(elapsed_us(begin), std::memory_order_relaxed);
+			if (!m_settled)
+			{
+				settle_wait_timeouts.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+	}
+
+public:
+	// The application is being deactivated: on the posting thread. From here on nothing new goes to the GPU.
+	void app_will_resign_active() noexcept
+	{
+		deactivations.fetch_add(1, std::memory_order_relaxed);
+		stop_and_settle();
+	}
+
+	// The observers were installed while the application was not active (main thread): the same as a deactivation
+	// whose notification came before anyone listened.
+	void app_found_not_active() noexcept
+	{
+		found_not_active.fetch_add(1, std::memory_order_relaxed);
+		stop_and_settle();
+	}
+
+	// The application entered the background: on the posting thread, before the transition finishes. Only what the
+	// deactivation could not finish is left to do.
+	void app_entered_background() noexcept
+	{
+		backgrounds.fetch_add(1, std::memory_order_relaxed);
+		stop_and_settle();
+	}
+
+	void app_became_active() noexcept
+	{
+		open();
+	}
+};
+
+// A call that gives work to the GPU, on this thread. A pass inside another one of the same thread is the same call.
+inline thread_local std::uint32_t pass_depth = 0;
+
+class pass
+{
+public:
+	pass() noexcept
+	{
+		if (pass_depth++ == 0)
+		{
+			gate::instance().enter();
+		}
+	}
+
+	~pass()
+	{
+		if (--pass_depth == 0)
+		{
+			gate::instance().leave();
+		}
+	}
+
+	pass(const pass&) = delete;
+	pass& operator=(const pass&) = delete;
+};
+
+// Implemented in RPCS3IOSPlatform.mm: registers the three application observers, once per process.
+void install_application_observers() noexcept;
+} // namespace rpcs3::ios::gpu_gate
diff --git a/rpcs3/ios/IOSGpuMemoryPacking.h b/rpcs3/ios/IOSGpuMemoryPacking.h
new file mode 100644
index 0000000..2bd4633
--- /dev/null
+++ b/rpcs3/ios/IOSGpuMemoryPacking.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_GPU_MEMORY_PACKING_925: the Vulkan memory allocator (VMA) carves every allocation under half a block out
+// of 64 MiB blocks (VRAMBudgetPolicy.h), and on an Apple GPU MoltenVK backs each block with one placement MTLHeap of
+// that size: a block is physical memory for as long as one allocation lives in it. Upstream picks VMA's fastest
+// strategy until the allocator's load exceeds 75 % of the heap, and the heap MoltenVK reports is the unified memory of
+// the device (7.4 GiB), so on iOS the fastest strategy is the only one ever used.
+//
+// IPA 724, Call of Duty: Black Ops II, pid 50194, session 8 (JITMEM, one sample per 5 s): the bytes allocated reach
+// 805 MiB after 2 minutes and stay there (777-813 MiB), while the blocks go from 648 to 1136 MiB in steps of 64 MiB
+// and the unused part of the blocks from 45 to 360 MiB; the kernel's graphics ledger (COREPROF MEMPARTS923) follows the
+// blocks, not the allocations (ledger minus blocks: 198, 209, 250-290 MiB; ledger minus allocations: 293, 448,
+// 580 MiB), and the footprint goes from 3.40 to 4.06 GB. The textures the title streams are allocated and released all
+// the time, in every size; each release leaves a hole only an allocation of that size or smaller can take.
+//
+// With the lever on:
+// - an allocation of `dedicated_from` bytes or more gets device memory of its own (VMA dedicated memory, as it already
+//   does unasked above half a block): its memory goes back to the system when it is released, and it leaves no hole;
+// - the smaller ones are placed in the smallest free range that fits (VMA's minimum-memory strategy, the one upstream
+//   switches to under pressure) instead of the first one found.
+// What is allocated, when, and its contents do not change; only where the allocator places it.
+// Host experiment on the pinned VMA 3.3.0 behind a mock device (test/rpcs3_gpu_memory_packing925_test.py), a Black Ops
+// II-shaped load (521 MiB that stay, textures of 16 KiB to 4 MiB allocated and released at random up to 290 MiB):
+// unused block bytes 166-204 MiB before, 28-51 MiB after. Not measured on an iPhone.
+namespace rpcs3::ios::gpu_memory_packing
+{
+inline std::atomic<bool> enabled{false};
+
+// Allocations from this size up get memory of their own.
+inline constexpr std::uint64_t dedicated_from = 1024 * 1024;
+
+constexpr bool wants_dedicated(bool lever_on, std::uint64_t size) noexcept
+{
+	return lever_on && size >= dedicated_from;
+}
+
+// Since boot: allocations this lever gave memory of their own, and their bytes (COREPROF GPUPACK925).
+inline std::atomic<std::uint64_t> dedicated_allocations{0};
+inline std::atomic<std::uint64_t> dedicated_bytes{0};
+
+inline void note_dedicated(std::uint64_t size) noexcept
+{
+	dedicated_allocations.fetch_add(1, std::memory_order_relaxed);
+	dedicated_bytes.fetch_add(size, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::gpu_memory_packing
diff --git a/rpcs3/ios/IOSGpuTiming.h b/rpcs3/ios/IOSGpuTiming.h
new file mode 100644
index 0000000..b42617f
--- /dev/null
+++ b/rpcs3/ios/IOSGpuTiming.h
@@ -0,0 +1,870 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+// REWINDBOX_GPU_TIMING_621: GPU execution time of the RSX primary command
+// buffers, read after their submission completed, never waited for.
+//
+// Path (Core 619, MoltenVK 1.4.2 db66022 plus the RewindBox patches):
+// VKGSRender::close_and_submit_command_buffer -> vk::queue_submit ->
+// vkQueueSubmit -> MVKQueueCommandBufferSubmission (one MTLCommandBuffer per
+// submission) -> Metal. What that MoltenVK exposes after completion:
+//  - MTLCommandBuffer GPUStartTime/GPUEndTime: read nowhere by MoltenVK, and
+//    VK_EXT_metal_objects exports devices, queues, buffers, textures, IOSurfaces
+//    and shared events, not command buffers: unreachable without patching it.
+//  - vkGetPerformanceStatisticsMVK: queue.mtlCommandBufferExecution is a CPU
+//    interval from commit to the completion handler, aggregated over the
+//    process: not GPU time, not per submission.
+//  - Vulkan timestamp queries: on Apple GPUs (stage-boundary counter sampling)
+//    MoltenVK defers every vkCmdWriteTimestamp to the end of the current Metal
+//    encoder batch and samples it at the start of a one-byte blit pass that
+//    waits for the previous encoders (MVKCommandEncoder::
+//    encodeTimestampStageCounterSamples). A pair at the start and end of a
+//    command buffer therefore brackets its GPU work. Results come from an
+//    MTLCounterSampleBuffer after the command buffer completed. If MoltenVK
+//    could not create that buffer it falls back to one CPU time at completion:
+//    both values are then equal (counted as zero_duration, never as GPU time).
+//  - VK_EXT_calibrated_timestamps: pairs a GPU timestamp with a host time
+//    (-[MTLDevice sampleTimestamps:gpuTimestamp:]). Two pairs seconds apart
+//    give the GPU tick rate against the host TSC, checked rather than assumed
+//    (MoltenVK reports timestampPeriod 1.0 on Apple GPUs), and place GPU times
+//    on the host clock (queue delay = GPU start - RSX submit).
+// This header holds the bookkeeping only (no Vulkan): one producer, the RSX
+// thread, and one reader, the profiler report. Results are read without the
+// WAIT bit: a submission whose fence has not signalled stays pending.
+namespace rpcs3::ios::gpu_timing
+{
+inline constexpr std::uint32_t slot_count = 512;      // VK_MAX_ASYNC_CB_COUNT primary chunks, two queries each
+inline constexpr std::uint32_t frame_capacity = 512;  // RSX frames kept for the slow-frame lookup
+inline constexpr std::uint32_t sweep_limit = 64;      // results read per frame end at most
+inline constexpr std::uint64_t calibration_period_us = 2'000'000;
+inline constexpr std::uint64_t calibration_min_baseline_us = 500'000;
+inline constexpr std::uint64_t queue_delay_tolerance_us = 500;
+
+enum class state : std::uint32_t
+{
+	off = 0,        // no renderer session
+	active = 1,
+	no_pool = 2,    // the timestamp query pool could not be created
+	no_support = 3, // timestampComputeAndGraphics is false / no valid bits
+	disabled = 4,   // switched off by the experimental setting
+};
+
+inline const char* state_name(state value) noexcept
+{
+	switch (value)
+	{
+	case state::active: return "active";
+	case state::no_pool: return "no_pool";
+	case state::no_support: return "no_support";
+	case state::disabled: return "disabled";
+	default: return "off";
+	}
+}
+
+// What a frame's GPU value is worth.
+enum class frame_status : std::uint32_t
+{
+	not_found = 0, // no record for this session and frame (before the probe, or evicted)
+	none = 1,      // the frame submitted no primary command buffer
+	untimed = 2,   // none of its submissions carried timestamps
+	pending = 3,   // timed submissions still running or not yet read
+	partial = 4,   // every timed submission read, some submissions untimed or unavailable
+	complete = 5,  // every submission of the frame measured
+};
+
+inline const char* frame_status_name(frame_status value) noexcept
+{
+	switch (value)
+	{
+	case frame_status::none: return "no_submit";
+	case frame_status::untimed: return "untimed";
+	case frame_status::pending: return "pending";
+	case frame_status::partial: return "partial";
+	case frame_status::complete: return "complete";
+	default: return "not_found";
+	}
+}
+
+// GPU timestamps of one submission. available: both queries were written.
+struct sample
+{
+	bool available = false;
+	std::uint64_t begin = 0, end = 0;
+};
+
+// Union of GPU busy intervals taken in submission order: a command buffer
+// that starts before the previous one ended only adds what extends past it,
+// so overlapping submissions are never counted twice.
+struct busy_union
+{
+	std::uint64_t merged_end = 0;
+	std::uint64_t last_begin = 0;
+	bool any = false;
+
+	// Returns the ticks this interval adds; out_of_order when it starts before
+	// the previous one (one Metal queue starts command buffers in order).
+	std::uint64_t add(std::uint64_t begin, std::uint64_t end, bool& out_of_order) noexcept
+	{
+		out_of_order = any && begin < last_begin;
+		if (!any || begin > last_begin) last_begin = begin;
+		any = true;
+		if (end <= begin) return 0;
+		if (begin >= merged_end)
+		{
+			merged_end = end;
+			return end - begin;
+		}
+		if (end > merged_end)
+		{
+			const std::uint64_t added = end - merged_end;
+			merged_end = end;
+			return added;
+		}
+		return 0;
+	}
+};
+
+// GPU ticks against host TSC ticks, from calibrated timestamp pairs. The host
+// time of a pair is the middle of the TSC reads around the Vulkan call; half
+// their distance is its uncertainty.
+class calibration
+{
+public:
+	struct point
+	{
+		std::uint64_t gpu = 0, tsc = 0, half_span = 0;
+	};
+
+	void reset() noexcept { *this = {}; }
+
+	void add(std::uint64_t gpu, std::uint64_t tsc_before, std::uint64_t tsc_after) noexcept
+	{
+		if (tsc_after < tsc_before) return;
+		const point value{gpu, tsc_before + (tsc_after - tsc_before) / 2, (tsc_after - tsc_before) / 2};
+		if (!m_count++)
+		{
+			m_first = value;
+		}
+		m_latest = value;
+	}
+
+	std::uint64_t count() const noexcept { return m_count; }
+	const point& latest() const noexcept { return m_latest; }
+
+	// GPU ticks per TSC tick once the two points are min_baseline_tsc apart and
+	// the GPU clock moved forward with the host clock.
+	bool rate(std::uint64_t min_baseline_tsc, double& gpu_per_tsc, double& relative_uncertainty) const noexcept
+	{
+		if (m_count < 2 || m_latest.tsc <= m_first.tsc || m_latest.gpu <= m_first.gpu) return false;
+		const std::uint64_t baseline = m_latest.tsc - m_first.tsc;
+		if (baseline < min_baseline_tsc) return false;
+		gpu_per_tsc = static_cast<double>(m_latest.gpu - m_first.gpu) / static_cast<double>(baseline);
+		relative_uncertainty = static_cast<double>(m_first.half_span + m_latest.half_span) / static_cast<double>(baseline);
+		return true;
+	}
+
+private:
+	std::uint64_t m_count = 0;
+	point m_first{}, m_latest{};
+};
+
+// Per-window counters, read and cleared by the profiler report.
+struct window
+{
+	state probe = state::off;
+	std::uint64_t session = 0;
+	std::uint64_t queue_submits = 0; // every vkQueueSubmit of the process (any queue, any thread)
+	std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0, not_ready = 0;
+	std::uint64_t late_dropped = 0, stop_dropped = 0, overrun = 0, invalid = 0, zero_duration = 0;
+	std::uint64_t order_violations = 0, frame_evicted = 0, pending = 0;
+	std::uint64_t busy_ticks = 0, sum_ticks = 0, max_ticks = 0;
+	std::uint64_t queue_delay_samples = 0, queue_delay_sum_tsc = 0, queue_delay_max_tsc = 0, domain_violations = 0;
+	std::uint64_t probe_tsc = 0, probe_reads = 0, calibrations = 0, calibration_failures = 0;
+	std::uint64_t frames_gpu_over_33ms = 0, frames_gpu_over_50ms = 0, frames_measured = 0;
+	// Units: calibrated GPU ticks per TSC tick when available, otherwise the
+	// Vulkan timestampPeriod (nanoseconds per GPU tick) as reported.
+	bool calibrated = false;
+	double gpu_per_tsc = 0.0, calibration_uncertainty = 0.0, period_ns = 0.0;
+	std::uint64_t tsc_frequency = 0;
+
+	// Microseconds of a GPU tick count.
+	double ticks_us(std::uint64_t ticks) const noexcept
+	{
+		if (calibrated && gpu_per_tsc > 0.0 && tsc_frequency)
+			return static_cast<double>(ticks) / gpu_per_tsc * 1'000'000.0 / static_cast<double>(tsc_frequency);
+		return static_cast<double>(ticks) * period_ns / 1000.0;
+	}
+
+	double tsc_us(std::uint64_t ticks) const noexcept
+	{
+		return tsc_frequency ? static_cast<double>(ticks) * 1'000'000.0 / static_cast<double>(tsc_frequency) : 0.0;
+	}
+};
+
+// GPU record of one RSX frame (the RSX work between two frame ends).
+struct frame_view
+{
+	frame_status status = frame_status::not_found;
+	std::uint64_t flip = 0;
+	std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0;
+	double busy_us = -1.0, sum_us = -1.0, span_us = -1.0, max_us = -1.0, queue_delay_max_us = -1.0;
+};
+
+class tracker
+{
+	struct slot
+	{
+		bool begun = false;   // the begin timestamp was recorded in the current use
+		bool pending = false; // submitted, results not processed yet
+		std::uint64_t serial = 0, epoch = 0, session = 0, submit_tsc = 0;
+	};
+
+	// Frame record as published to the reader (seqlock: odd while written).
+	struct published_frame
+	{
+		std::atomic<std::uint64_t> seq{0};
+		std::atomic<std::uint64_t> epoch{0}, flip{0}, session{0};
+		std::atomic<std::uint64_t> submits{0}, timed{0}, untimed{0}, resolved{0}, unavailable{0};
+		std::atomic<std::uint64_t> busy{0}, sum{0}, span_begin{0}, span_end{0}, max{0};
+		std::atomic<std::uint64_t> queue_delay_max{0}, queue_delay_valid{0};
+	};
+
+	struct frame_shadow
+	{
+		std::uint64_t epoch = 0, flip = 0, session = 0;
+		std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0;
+		std::uint64_t busy = 0, sum = 0, span_begin = 0, span_end = 0, max = 0;
+		std::uint64_t queue_delay_max = 0, queue_delay_valid = 0;
+		bool counted = false; // entered the >33/>50 ms window tallies
+	};
+
+	struct counters
+	{
+		std::atomic<std::uint64_t> queue_submits{0};
+		std::atomic<std::uint64_t> submits{0}, timed{0}, untimed{0}, resolved{0}, unavailable{0}, not_ready{0};
+		std::atomic<std::uint64_t> late_dropped{0}, stop_dropped{0}, overrun{0}, invalid{0}, zero_duration{0};
+		std::atomic<std::uint64_t> order_violations{0}, frame_evicted{0};
+		std::atomic<std::uint64_t> busy{0}, sum{0}, max{0};
+		std::atomic<std::uint64_t> queue_delay_samples{0}, queue_delay_sum{0}, queue_delay_max{0}, domain_violations{0};
+		std::atomic<std::uint64_t> probe_tsc{0}, probe_reads{0}, calibrations{0}, calibration_failures{0};
+		std::atomic<std::uint64_t> frames_over_33{0}, frames_over_50{0}, frames_measured{0};
+	};
+
+public:
+	// Renderer construction, RSX thread, before any submission of the session.
+	void begin_session(std::uint64_t session, state probe, double period_ns, std::uint64_t tsc_frequency) noexcept
+	{
+		for (auto& value : m_slots) value = {};
+		for (auto& value : m_fifo) value = 0;
+		for (auto& value : m_shadow) value = {};
+		m_union = {};
+		m_calibration.reset();
+		m_owner_calibrated = false;
+		m_owner_gpu_per_tsc = 0.0;
+		m_next_serial = 1;
+		m_oldest_serial = 1;
+		m_epoch = 1;
+		m_session = session;
+		m_tsc_frequency = tsc_frequency;
+		open_epoch(m_epoch);
+		m_pending.store(0, std::memory_order_relaxed);
+		m_period_bits.store(bits(period_ns), std::memory_order_relaxed);
+		m_tsc_frequency_published.store(tsc_frequency, std::memory_order_relaxed);
+		m_calibrated.store(0, std::memory_order_relaxed);
+		m_published_session.store(session, std::memory_order_relaxed);
+		m_state.store(static_cast<std::uint32_t>(probe), std::memory_order_release);
+	}
+
+	// Renderer destruction, RSX thread: results never read are dropped and
+	// counted; nothing is attributed to the next session.
+	void end_session() noexcept
+	{
+		std::uint64_t dropped = 0;
+		for (auto& value : m_slots)
+		{
+			dropped += value.pending;
+			value = {};
+		}
+		m_counters.stop_dropped.fetch_add(dropped, std::memory_order_relaxed);
+		m_pending.store(0, std::memory_order_relaxed);
+		m_session = 0;
+		m_state.store(static_cast<std::uint32_t>(state::off), std::memory_order_release);
+	}
+
+	bool active() const noexcept
+	{
+		return m_state.load(std::memory_order_relaxed) == static_cast<std::uint32_t>(state::active);
+	}
+
+	// ---- RSX thread ----------------------------------------------------
+
+	// The previous use of `index` must be processed before its queries are
+	// reset: read(index) returns its sample (the chunk's fence completed, the
+	// renderer waited for it as before). Older pending submissions go first so
+	// results are taken in submission order.
+	template <typename Read>
+	void release_slot(std::uint32_t index, Read&& read)
+	{
+		if (index >= slot_count || !m_slots[index].pending) return;
+		const std::uint64_t target = m_slots[index].serial;
+		while (m_oldest_serial <= target)
+		{
+			const std::uint32_t oldest = m_fifo[m_oldest_serial % slot_count];
+			slot& entry = m_slots[oldest];
+			if (entry.pending && entry.serial == m_oldest_serial)
+			{
+				const sample result = read(oldest);
+				m_counters.probe_reads.fetch_add(1, std::memory_order_relaxed);
+				process(entry, result);
+			}
+			m_oldest_serial++;
+		}
+	}
+
+	// The begin timestamp of `index` was recorded.
+	void on_begin(std::uint32_t index) noexcept
+	{
+		if (index < slot_count) m_slots[index].begun = true;
+	}
+
+	bool begun(std::uint32_t index) const noexcept
+	{
+		return index < slot_count && m_slots[index].begun;
+	}
+
+	// The recording of `index` was submitted without its pair (untimed).
+	void clear_begun(std::uint32_t index) noexcept
+	{
+		if (index < slot_count) m_slots[index].begun = false;
+	}
+
+	// The command buffer of `index`, closed with its end timestamp, was handed
+	// for submission at submit_tsc (RSX thread, before vkQueueSubmit).
+	void on_submit(std::uint32_t index, std::uint64_t submit_tsc) noexcept
+	{
+		if (index >= slot_count) return;
+		slot& entry = m_slots[index];
+		if (entry.pending)
+		{
+			// Never expected (release_slot runs at every begin): count, do not mix.
+			m_counters.overrun.fetch_add(1, std::memory_order_relaxed);
+			abandon(entry);
+		}
+		entry.begun = false;
+		entry.pending = true;
+		entry.serial = m_next_serial++;
+		entry.epoch = m_epoch;
+		entry.session = m_session;
+		entry.submit_tsc = submit_tsc;
+		m_fifo[entry.serial % slot_count] = index;
+		m_pending.fetch_add(1, std::memory_order_relaxed);
+		m_counters.submits.fetch_add(1, std::memory_order_relaxed);
+		m_counters.timed.fetch_add(1, std::memory_order_relaxed);
+		frame_shadow& frame = shadow(m_epoch);
+		frame.submits++;
+		frame.timed++;
+		publish(m_epoch);
+	}
+
+	// A submission without timestamps (heap sync, async streaming, probe off).
+	void on_untimed_submit(std::uint64_t count = 1) noexcept
+	{
+		m_counters.submits.fetch_add(count, std::memory_order_relaxed);
+		m_counters.untimed.fetch_add(count, std::memory_order_relaxed);
+		frame_shadow& frame = shadow(m_epoch);
+		frame.submits += count;
+		frame.untimed += count;
+		publish(m_epoch);
+	}
+
+	// Frame-end sweep, oldest first. complete(index) tells whether the chunk's
+	// fence signalled (no wait); read(index) reads its queries without waiting.
+	// Stops at the first submission still running or not yet readable.
+	template <typename Complete, typename Read>
+	void collect(Complete&& complete, Read&& read, std::uint32_t limit = sweep_limit)
+	{
+		for (std::uint32_t done = 0; done < limit && m_oldest_serial < m_next_serial;)
+		{
+			const std::uint32_t oldest = m_fifo[m_oldest_serial % slot_count];
+			slot& entry = m_slots[oldest];
+			if (!entry.pending || entry.serial != m_oldest_serial)
+			{
+				m_oldest_serial++;
+				continue;
+			}
+			if (!complete(oldest)) return;
+			const sample result = read(oldest);
+			m_counters.probe_reads.fetch_add(1, std::memory_order_relaxed);
+			done++;
+			if (!result.available)
+			{
+				// Fence signalled before MoltenVK marked the queries: retry later.
+				m_counters.not_ready.fetch_add(1, std::memory_order_relaxed);
+				return;
+			}
+			process(entry, result);
+			m_oldest_serial++;
+		}
+	}
+
+	// The RSX frame `flip` ended (rsx::thread::on_frame_end, the frame trace record).
+	// The epoch closes there, before int_flip_index advances and before the next
+	// flip's present: record F holds frame F-1's present and frame F's draws, the
+	// same interval as the frame trace and its waits. Stored as flip + 1 (0 = open).
+	void on_frame(std::uint64_t flip) noexcept
+	{
+		frame_shadow& frame = shadow(m_epoch);
+		frame.flip = flip + 1;
+		count_frame(frame); // every submission may already have been read
+		publish(m_epoch);
+		open_epoch(++m_epoch);
+	}
+
+	void add_calibration(std::uint64_t gpu, std::uint64_t tsc_before, std::uint64_t tsc_after) noexcept
+	{
+		m_counters.calibrations.fetch_add(1, std::memory_order_relaxed);
+		m_calibration.add(gpu, tsc_before, tsc_after);
+		double rate = 0.0, uncertainty = 0.0;
+		const std::uint64_t min_baseline = m_tsc_frequency / 1'000'000 * calibration_min_baseline_us;
+		if (m_calibration.rate(min_baseline, rate, uncertainty))
+		{
+			m_owner_calibrated = true;
+			m_owner_gpu_per_tsc = rate;
+			m_rate_bits.store(bits(rate), std::memory_order_relaxed);
+			m_uncertainty_bits.store(bits(uncertainty), std::memory_order_relaxed);
+			m_calibrated.store(1, std::memory_order_release);
+		}
+	}
+
+	void calibration_failed() noexcept
+	{
+		m_counters.calibration_failures.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	void add_probe_cost(std::uint64_t tsc_ticks) noexcept
+	{
+		m_counters.probe_tsc.fetch_add(tsc_ticks, std::memory_order_relaxed);
+	}
+
+	std::uint64_t pending() const noexcept { return m_pending.load(std::memory_order_relaxed); }
+
+	// Any thread: one vkQueueSubmit (vk::queue_submit_impl), the coverage denominator.
+	void on_queue_submit() noexcept
+	{
+		m_counters.queue_submits.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// ---- profiler report ------------------------------------------------
+
+	window take_window() noexcept
+	{
+		window result;
+		result.probe = static_cast<state>(m_state.load(std::memory_order_acquire));
+		result.session = m_published_session.load(std::memory_order_relaxed);
+		const auto take = [](std::atomic<std::uint64_t>& value) { return value.exchange(0, std::memory_order_relaxed); };
+		result.queue_submits = take(m_counters.queue_submits);
+		result.submits = take(m_counters.submits);
+		result.timed = take(m_counters.timed);
+		result.untimed = take(m_counters.untimed);
+		result.resolved = take(m_counters.resolved);
+		result.unavailable = take(m_counters.unavailable);
+		result.not_ready = take(m_counters.not_ready);
+		result.late_dropped = take(m_counters.late_dropped);
+		result.stop_dropped = take(m_counters.stop_dropped);
+		result.overrun = take(m_counters.overrun);
+		result.invalid = take(m_counters.invalid);
+		result.zero_duration = take(m_counters.zero_duration);
+		result.order_violations = take(m_counters.order_violations);
+		result.frame_evicted = take(m_counters.frame_evicted);
+		result.busy_ticks = take(m_counters.busy);
+		result.sum_ticks = take(m_counters.sum);
+		result.max_ticks = take(m_counters.max);
+		result.queue_delay_samples = take(m_counters.queue_delay_samples);
+		result.queue_delay_sum_tsc = take(m_counters.queue_delay_sum);
+		result.queue_delay_max_tsc = take(m_counters.queue_delay_max);
+		result.domain_violations = take(m_counters.domain_violations);
+		result.probe_tsc = take(m_counters.probe_tsc);
+		result.probe_reads = take(m_counters.probe_reads);
+		result.calibrations = take(m_counters.calibrations);
+		result.calibration_failures = take(m_counters.calibration_failures);
+		result.frames_gpu_over_33ms = take(m_counters.frames_over_33);
+		result.frames_gpu_over_50ms = take(m_counters.frames_over_50);
+		result.frames_measured = take(m_counters.frames_measured);
+		result.pending = m_pending.load(std::memory_order_relaxed);
+		units(result);
+		return result;
+	}
+
+	// The GPU record of RSX frame `flip` in `session`, converted with the
+	// current units. Never blocks the producer: a record being written is
+	// retried a few times, then reported as not found.
+	frame_view lookup(std::uint64_t session, std::uint64_t flip) const noexcept
+	{
+		frame_view view;
+		view.flip = flip;
+		if (!session) return view;
+		window scale;
+		units(scale);
+		for (const auto& entry : m_frames)
+		{
+			for (int attempt = 0; attempt < 4; ++attempt)
+			{
+				const std::uint64_t before = entry.seq.load(std::memory_order_acquire);
+				if (before & 1) continue;
+				frame_shadow copy;
+				copy.epoch = entry.epoch.load(std::memory_order_relaxed);
+				copy.flip = entry.flip.load(std::memory_order_relaxed);
+				copy.session = entry.session.load(std::memory_order_relaxed);
+				copy.submits = entry.submits.load(std::memory_order_relaxed);
+				copy.timed = entry.timed.load(std::memory_order_relaxed);
+				copy.untimed = entry.untimed.load(std::memory_order_relaxed);
+				copy.resolved = entry.resolved.load(std::memory_order_relaxed);
+				copy.unavailable = entry.unavailable.load(std::memory_order_relaxed);
+				copy.busy = entry.busy.load(std::memory_order_relaxed);
+				copy.sum = entry.sum.load(std::memory_order_relaxed);
+				copy.span_begin = entry.span_begin.load(std::memory_order_relaxed);
+				copy.span_end = entry.span_end.load(std::memory_order_relaxed);
+				copy.max = entry.max.load(std::memory_order_relaxed);
+				copy.queue_delay_max = entry.queue_delay_max.load(std::memory_order_relaxed);
+				copy.queue_delay_valid = entry.queue_delay_valid.load(std::memory_order_relaxed);
+				std::atomic_thread_fence(std::memory_order_acquire);
+				if (entry.seq.load(std::memory_order_relaxed) != before) continue;
+				if (copy.flip != flip + 1 || copy.session != session) break;
+				frame_view found = make_view(copy, scale);
+				found.flip = flip;
+				return found;
+			}
+		}
+		return view;
+	}
+
+	static frame_view make_view(const frame_shadow& copy, const window& scale) noexcept
+	{
+		frame_view view;
+		view.flip = copy.flip;
+		view.submits = copy.submits;
+		view.timed = copy.timed;
+		view.untimed = copy.untimed;
+		view.resolved = copy.resolved;
+		view.unavailable = copy.unavailable;
+		if (!copy.submits) view.status = frame_status::none;
+		else if (!copy.timed) view.status = frame_status::untimed;
+		else if (copy.timed > copy.resolved + copy.unavailable) view.status = frame_status::pending;
+		else if (copy.resolved == copy.submits) view.status = frame_status::complete;
+		else view.status = frame_status::partial;
+		if (copy.resolved)
+		{
+			view.busy_us = scale.ticks_us(copy.busy);
+			view.sum_us = scale.ticks_us(copy.sum);
+			view.max_us = scale.ticks_us(copy.max);
+			view.span_us = copy.span_end > copy.span_begin ? scale.ticks_us(copy.span_end - copy.span_begin) : 0.0;
+			if (copy.queue_delay_valid) view.queue_delay_max_us = scale.tsc_us(copy.queue_delay_max);
+		}
+		return view;
+	}
+
+private:
+	static std::uint64_t bits(double value) noexcept
+	{
+		std::uint64_t result = 0;
+		std::memcpy(&result, &value, sizeof(result));
+		return result;
+	}
+
+	static double real(std::uint64_t value) noexcept
+	{
+		double result = 0.0;
+		std::memcpy(&result, &value, sizeof(result));
+		return result;
+	}
+
+	void units(window& result) const noexcept
+	{
+		result.period_ns = real(m_period_bits.load(std::memory_order_relaxed));
+		result.tsc_frequency = m_tsc_frequency_published.load(std::memory_order_relaxed);
+		result.calibrated = m_calibrated.load(std::memory_order_acquire) != 0;
+		if (result.calibrated)
+		{
+			result.gpu_per_tsc = real(m_rate_bits.load(std::memory_order_relaxed));
+			result.calibration_uncertainty = real(m_uncertainty_bits.load(std::memory_order_relaxed));
+		}
+	}
+
+	frame_shadow& shadow(std::uint64_t epoch) noexcept
+	{
+		return m_shadow[epoch % frame_capacity];
+	}
+
+	void open_epoch(std::uint64_t epoch) noexcept
+	{
+		frame_shadow& frame = shadow(epoch);
+		frame = {};
+		frame.epoch = epoch;
+		frame.session = m_session;
+		publish(epoch);
+	}
+
+	void publish(std::uint64_t epoch) noexcept
+	{
+		const frame_shadow& frame = shadow(epoch);
+		published_frame& entry = m_frames[epoch % frame_capacity];
+		const std::uint64_t seq = entry.seq.load(std::memory_order_relaxed);
+		entry.seq.store(seq + 1, std::memory_order_relaxed);
+		std::atomic_thread_fence(std::memory_order_release);
+		entry.epoch.store(frame.epoch, std::memory_order_relaxed);
+		entry.flip.store(frame.flip, std::memory_order_relaxed);
+		entry.session.store(frame.session, std::memory_order_relaxed);
+		entry.submits.store(frame.submits, std::memory_order_relaxed);
+		entry.timed.store(frame.timed, std::memory_order_relaxed);
+		entry.untimed.store(frame.untimed, std::memory_order_relaxed);
+		entry.resolved.store(frame.resolved, std::memory_order_relaxed);
+		entry.unavailable.store(frame.unavailable, std::memory_order_relaxed);
+		entry.busy.store(frame.busy, std::memory_order_relaxed);
+		entry.sum.store(frame.sum, std::memory_order_relaxed);
+		entry.span_begin.store(frame.span_begin, std::memory_order_relaxed);
+		entry.span_end.store(frame.span_end, std::memory_order_relaxed);
+		entry.max.store(frame.max, std::memory_order_relaxed);
+		entry.queue_delay_max.store(frame.queue_delay_max, std::memory_order_relaxed);
+		entry.queue_delay_valid.store(frame.queue_delay_valid, std::memory_order_relaxed);
+		entry.seq.store(seq + 2, std::memory_order_release);
+	}
+
+	static void raise(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+	{
+		std::uint64_t current = value.load(std::memory_order_relaxed);
+		while (candidate > current && !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {}
+	}
+
+	void abandon(slot& entry) noexcept
+	{
+		if (!entry.pending) return;
+		entry.pending = false;
+		m_pending.fetch_sub(1, std::memory_order_relaxed);
+		m_counters.unavailable.fetch_add(1, std::memory_order_relaxed);
+		if (entry.session != m_session) return;
+		if (m_epoch - entry.epoch >= frame_capacity) return;
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch) return;
+		frame.unavailable++;
+		publish(entry.epoch);
+	}
+
+	void process(slot& entry, const sample& result) noexcept
+	{
+		if (!result.available)
+		{
+			abandon(entry);
+			return;
+		}
+
+		entry.pending = false;
+		m_pending.fetch_sub(1, std::memory_order_relaxed);
+
+		// A result of an earlier renderer session is never attributed.
+		if (entry.session != m_session)
+		{
+			m_counters.late_dropped.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+
+		if (result.end < result.begin)
+		{
+			m_counters.invalid.fetch_add(1, std::memory_order_relaxed);
+			abandon_frame(entry);
+			return;
+		}
+
+		const std::uint64_t duration = result.end - result.begin;
+		if (!duration) m_counters.zero_duration.fetch_add(1, std::memory_order_relaxed);
+		bool out_of_order = false;
+		const std::uint64_t added = m_union.add(result.begin, result.end, out_of_order);
+		if (out_of_order) m_counters.order_violations.fetch_add(1, std::memory_order_relaxed);
+		m_counters.resolved.fetch_add(1, std::memory_order_relaxed);
+		m_counters.busy.fetch_add(added, std::memory_order_relaxed);
+		m_counters.sum.fetch_add(duration, std::memory_order_relaxed);
+		raise(m_counters.max, duration);
+
+		// Queue delay: GPU start on the host clock minus the RSX submit time.
+		bool delay_valid = false;
+		std::uint64_t delay = 0;
+		if (m_owner_calibrated && m_owner_gpu_per_tsc > 0.0)
+		{
+			const auto& anchor = m_calibration.latest();
+			const double offset = (static_cast<double>(result.begin) - static_cast<double>(anchor.gpu)) / m_owner_gpu_per_tsc;
+			const double start_tsc = static_cast<double>(anchor.tsc) + offset;
+			const double difference = start_tsc - static_cast<double>(entry.submit_tsc);
+			const double tolerance = static_cast<double>(anchor.half_span) +
+				static_cast<double>(m_tsc_frequency) * queue_delay_tolerance_us / 1'000'000.0;
+			if (difference < -tolerance)
+			{
+				m_counters.domain_violations.fetch_add(1, std::memory_order_relaxed);
+			}
+			else
+			{
+				delay_valid = true;
+				delay = difference > 0.0 ? static_cast<std::uint64_t>(difference) : 0;
+				m_counters.queue_delay_samples.fetch_add(1, std::memory_order_relaxed);
+				m_counters.queue_delay_sum.fetch_add(delay, std::memory_order_relaxed);
+				raise(m_counters.queue_delay_max, delay);
+			}
+		}
+
+		if (m_epoch - entry.epoch >= frame_capacity)
+		{
+			m_counters.frame_evicted.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch)
+		{
+			m_counters.frame_evicted.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+		frame.resolved++;
+		frame.busy += added;
+		frame.sum += duration;
+		frame.max = std::max(frame.max, duration);
+		frame.span_begin = frame.resolved == 1 ? result.begin : std::min(frame.span_begin, result.begin);
+		frame.span_end = std::max(frame.span_end, result.end);
+		if (delay_valid)
+		{
+			frame.queue_delay_max = frame.queue_delay_valid ? std::max(frame.queue_delay_max, delay) : delay;
+			frame.queue_delay_valid = 1;
+		}
+		count_frame(frame);
+		publish(entry.epoch);
+	}
+
+	void abandon_frame(const slot& entry) noexcept
+	{
+		m_counters.unavailable.fetch_add(1, std::memory_order_relaxed);
+		if (m_epoch - entry.epoch >= frame_capacity) return;
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch) return;
+		frame.unavailable++;
+		publish(entry.epoch);
+	}
+
+	// A closed frame whose every submission was measured joins the window's
+	// GPU frame tallies once.
+	void count_frame(frame_shadow& frame) noexcept
+	{
+		if (frame.counted || !frame.flip || !frame.submits || frame.resolved != frame.submits) return;
+		frame.counted = true;
+		m_counters.frames_measured.fetch_add(1, std::memory_order_relaxed);
+		window scale;
+		units(scale);
+		const double busy_us = scale.ticks_us(frame.busy);
+		if (busy_us > 33'333.0) m_counters.frames_over_33.fetch_add(1, std::memory_order_relaxed);
+		if (busy_us > 50'000.0) m_counters.frames_over_50.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// RSX-thread state.
+	std::array<slot, slot_count> m_slots{};
+	std::array<std::uint32_t, slot_count> m_fifo{};
+	std::array<frame_shadow, frame_capacity> m_shadow{};
+	busy_union m_union{};
+	calibration m_calibration{};
+	bool m_owner_calibrated = false;
+	double m_owner_gpu_per_tsc = 0.0;
+	std::uint64_t m_next_serial = 1, m_oldest_serial = 1, m_epoch = 1, m_session = 0, m_tsc_frequency = 0;
+
+	// Shared with the reader.
+	std::array<published_frame, frame_capacity> m_frames{};
+	counters m_counters{};
+	std::atomic<std::uint64_t> m_pending{0};
+	std::atomic<std::uint32_t> m_state{0};
+	std::atomic<std::uint64_t> m_published_session{0};
+	std::atomic<std::uint64_t> m_period_bits{0}, m_rate_bits{0}, m_uncertainty_bits{0};
+	std::atomic<std::uint64_t> m_tsc_frequency_published{0};
+	std::atomic<std::uint32_t> m_calibrated{0};
+};
+
+// What explains one slow RSX frame (cause_rule=v2, printed with the values it
+// read). The RSX-thread waits are sequential on that thread: CPU wait for a GPU
+// fence, blocking pipeline compile, presentation (drawable acquisition and
+// present), vkQueueSubmit (Metal encoding with synchronous MoltenVK submits), the
+// guest semaphore the RSX waited for and (v2) the occlusion query results ZCULL
+// waited for. The semaphore wait excludes the ZCULL, fence and submit waits the
+// RSX thread made inside the acquire (nv406e, frame_trace::nested_wait_ticks), so
+// a ZCULL request served from inside an acquire is counted once, as zcull_sync.
+// GPU execution runs beside them.
+//  1. GPU busy measured for every submission of the frame and >= 75 % of the
+//     interval: gpu_execution (measured).
+//  2. Otherwise the largest wait if it is >= 25 % of the interval (measured),
+//     except a fence wait whose GPU side is not fully measured (partial).
+//  3. Otherwise rsx_or_guest_cpu: RSX command processing or a guest that did
+//     not feed the FIFO (inferred: no wait explains it).
+struct frame_explanation
+{
+	const char* cause = "rsx_or_guest_cpu";
+	const char* certainty = "inferred";
+	const char* dominant = "none";
+	double dominant_ms = 0.0;
+	double waits_ms = 0.0;
+	double other_ms = 0.0;
+};
+
+inline frame_explanation explain_frame(double interval_ms, double fence_ms, double pipeline_ms, double presentation_ms,
+	double submit_ms, double semaphore_ms, double zcull_ms, const frame_view& gpu) noexcept
+{
+	frame_explanation result;
+	// REWINDBOX_ZCULL_FRAME_621 (cause_rule=v2): the RSX thread's waits for occlusion
+	// query results join the candidates. Build 620 logs: Assassin's Creed lost
+	// 4.1-4.3 s of every 5 s window there and Black Ops II 1.1-1.9 s, while v1
+	// could only infer rsx_or_guest_cpu for those frames.
+	const struct
+	{
+		const char* name;
+		double ms;
+	} waits[] = {
+		{"cpu_wait_gpu_fence", fence_ms},
+		{"pipeline_compile", pipeline_ms},
+		{"presentation", presentation_ms},
+		{"submit_encode", submit_ms},
+		{"guest_semaphore", semaphore_ms},
+		{"zcull_sync", zcull_ms},
+	};
+	for (const auto& wait : waits)
+	{
+		const double value = wait.ms > 0.0 ? wait.ms : 0.0;
+		result.waits_ms += value;
+		if (value > result.dominant_ms)
+		{
+			result.dominant_ms = value;
+			result.dominant = wait.name;
+		}
+	}
+	result.other_ms = interval_ms > result.waits_ms ? interval_ms - result.waits_ms : 0.0;
+	if (!(interval_ms > 0.0)) return result;
+
+	const bool gpu_complete = gpu.status == frame_status::complete && gpu.busy_us >= 0.0;
+	if (gpu_complete && gpu.busy_us / 1000.0 >= 0.75 * interval_ms)
+	{
+		result.cause = "gpu_execution";
+		result.certainty = "measured";
+		return result;
+	}
+	if (result.dominant_ms >= 0.25 * interval_ms)
+	{
+		result.cause = result.dominant;
+		const bool fence = result.dominant == waits[0].name;
+		result.certainty = fence && !gpu_complete ? "partial" : "measured";
+	}
+	return result;
+}
+
+inline tracker& instance() noexcept
+{
+	static tracker s_tracker;
+	return s_tracker;
+}
+}
diff --git a/rpcs3/ios/IOSGuestAccessEmulation.h b/rpcs3/ios/IOSGuestAccessEmulation.h
new file mode 100644
index 0000000..493d4d3
--- /dev/null
+++ b/rpcs3/ios/IOSGuestAccessEmulation.h
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_ZCULL_ASYNC_READS_630 (ios/IOSZcullOnDemand.h): a guest access to a page ZCULL holds
+// locked can be completed by the access violation handler instead of being retried, for the
+// memory that page still has final: the handler reads or writes the unprotected view and steps
+// over the instruction. Utilities/Thread.cpp decodes the instruction before the RSX handler runs
+// (decode_a64_mem_inst, the decoder of the RawSPU MMIO path, plus the integer pairs below, which
+// LLVM forms from two neighbouring guest loads) and completes it afterwards when the RSX handler
+// sets `emulate`. Everything else keeps the retry: atomics and SIMD, writeback forms, an unaligned
+// access, an access that crosses the page.
+namespace rpcs3::ios::guest_access
+{
+struct access
+{
+	std::uint32_t size = 0;  // bytes of the access (both registers of a pair), 0: not completable
+	bool emulate = false;    // set by the RSX handler: complete it, do not retry it
+};
+
+inline thread_local access t_access{};
+
+// REWINDBOX_GUEST_ACCESS_FP_LR_636: a register the handler may read or write through the context. Darwin's
+// thread state holds X0-X28 in __x[29]; X29 (FP) and X30 (LR) are separate fields, so GPR(context, 29/30)
+// would index past __x. An access naming either keeps the retry. 31 is XZR (data, index) or SP (base,
+// refused by its callers).
+constexpr bool context_register(std::uint32_t reg) noexcept
+{
+	return reg < 29 || reg == 31;
+}
+
+// The operands of a scalar load or store decode_a64_mem_inst() accepted, for the address the
+// instruction computes: the fault address alone says nothing about an access that starts below it.
+struct single_operands
+{
+	std::uint32_t rn = 31;
+	bool indexed = false;     // register offset
+	std::uint32_t rm = 31;
+	std::uint32_t option = 3; // 010 UXTW, 011 LSL, 110 SXTW, 111 SXTX
+	std::uint32_t shift = 0;
+	std::int64_t offset = 0;  // immediate forms
+};
+
+constexpr single_operands decode_single_operands(std::uint32_t inst) noexcept
+{
+	single_operands r{};
+	const std::uint32_t size = inst >> 30;
+	r.rn = (inst >> 5) & 31;
+
+	if ((inst & 0x3B000000u) == 0x39000000u)
+	{
+		r.offset = static_cast<std::int64_t>((inst >> 10) & 0xfff) << size; // unsigned immediate, scaled
+	}
+	else if ((inst & 0x3B204C00u) == 0x38204800u)
+	{
+		r.indexed = true;
+		r.rm = (inst >> 16) & 31;
+		r.option = (inst >> 13) & 7;
+		r.shift = ((inst >> 12) & 1) ? size : 0;
+	}
+	else
+	{
+		const std::int32_t imm9 = static_cast<std::int32_t>((inst >> 12) & 511); // unscaled
+		r.offset = imm9 >= 256 ? imm9 - 512 : imm9;
+	}
+
+	return r;
+}
+
+// The index of a register-offset form, from the value of Rm.
+constexpr std::uint64_t index_value(const single_operands& operands, std::uint64_t rm) noexcept
+{
+	switch (operands.option)
+	{
+	case 2: rm &= 0xffffffffu; break;
+	case 6: rm = static_cast<std::uint64_t>(static_cast<std::int64_t>(static_cast<std::int32_t>(rm))); break;
+	default: break;
+	}
+
+	return rm << operands.shift;
+}
+
+// LDP, LDPSW and STP of general registers, signed offset, no writeback.
+struct pair_access
+{
+	bool valid = false;
+	bool load = false;
+	bool sign_extend = false; // LDPSW
+	std::uint32_t element = 0; // bytes of one register
+	std::uint32_t rt = 0, rt2 = 0, rn = 0;
+	std::int32_t offset = 0;
+};
+
+constexpr pair_access decode_pair(std::uint32_t inst) noexcept
+{
+	pair_access r{};
+
+	// opc[31:30] 101 V[26]=0 010 L[22] imm7[21:15] Rt2[14:10] Rn[9:5] Rt[4:0]
+	if ((inst & 0x3F800000u) != 0x29000000u)
+	{
+		return r;
+	}
+
+	const std::uint32_t opc = inst >> 30;
+	const bool load = ((inst >> 22) & 1) != 0;
+
+	if (opc == 3 || (opc == 1 && !load))
+	{
+		return r; // reserved, STGP
+	}
+
+	r.load = load;
+	r.sign_extend = opc == 1;
+	r.element = opc == 2 ? 8 : 4;
+	r.rt = inst & 31;
+	r.rn = (inst >> 5) & 31;
+	r.rt2 = (inst >> 10) & 31;
+
+	const std::int32_t imm7 = static_cast<std::int32_t>((inst >> 15) & 127);
+	r.offset = (imm7 >= 64 ? imm7 - 128 : imm7) * static_cast<std::int32_t>(r.element);
+	r.valid = !(load && r.rt == r.rt2); // CONSTRAINED UNPREDICTABLE
+	return r;
+}
+
+// An aligned element of guest memory, one access, as the instruction would have made it.
+inline std::uint64_t read_element(const std::uint8_t* memory, std::uint32_t size) noexcept
+{
+	switch (size)
+	{
+	case 1: return __atomic_load_n(memory, __ATOMIC_RELAXED);
+	case 2: return __atomic_load_n(reinterpret_cast<const std::uint16_t*>(memory), __ATOMIC_RELAXED);
+	case 4: return __atomic_load_n(reinterpret_cast<const std::uint32_t*>(memory), __ATOMIC_RELAXED);
+	default: return __atomic_load_n(reinterpret_cast<const std::uint64_t*>(memory), __ATOMIC_RELAXED);
+	}
+}
+
+inline void write_element(std::uint8_t* memory, std::uint32_t size, std::uint64_t value) noexcept
+{
+	switch (size)
+	{
+	case 1: __atomic_store_n(memory, static_cast<std::uint8_t>(value), __ATOMIC_RELAXED); break;
+	case 2: __atomic_store_n(reinterpret_cast<std::uint16_t*>(memory), static_cast<std::uint16_t>(value), __ATOMIC_RELAXED); break;
+	case 4: __atomic_store_n(reinterpret_cast<std::uint32_t*>(memory), static_cast<std::uint32_t>(value), __ATOMIC_RELAXED); break;
+	default: __atomic_store_n(reinterpret_cast<std::uint64_t*>(memory), value, __ATOMIC_RELAXED); break;
+	}
+}
+}
diff --git a/rpcs3/ios/IOSIdleWindows916.h b/rpcs3/ios/IOSIdleWindows916.h
new file mode 100644
index 0000000..a5b9596
--- /dev/null
+++ b/rpcs3/ios/IOSIdleWindows916.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_IDLE_WINDOWS_916: the 5 s report of a stopped emulation.
+//
+// Build 718, PID 45272: the exported performance journal (1,577,669 bytes, one 2 MiB rotation) holds windows 15 to 64
+// of session 5 and nothing of sessions 1 to 4; windows 18 to 64 were written after the game was stopped (phase=stopped,
+// state=0, every counter 0), 54 lines and about 30 KiB each: 1,442,924 bytes, 91.5 % of the file. Those lines pushed
+// the windows of Black Ops II and Assassin's Creed, the ones the capture was made for, out of the rotation.
+// A stopped window after the first one keeps its FRAMEPROF527 line (the freeze and progress clocks read it) and one
+// COREPROF IDLE916 line; the counters it would have printed are still taken, so the next running window starts clean.
+namespace rpcs3::ios::idle_windows
+{
+struct tracker
+{
+	std::uint32_t consecutive = 0; // stopped windows without a guest flip in a row, this one included
+
+	// True when this window's detail lines are left out: the second and later stopped windows of a row.
+	// The first one is printed in full: it holds what the stop itself did.
+	bool compact(bool stopped_phase, std::uint64_t guest_flips) noexcept
+	{
+		if (!stopped_phase || guest_flips)
+		{
+			consecutive = 0;
+			return false;
+		}
+
+		if (consecutive != ~0u)
+		{
+			consecutive++;
+		}
+
+		return consecutive >= 2;
+	}
+};
+} // namespace rpcs3::ios::idle_windows
diff --git a/rpcs3/ios/IOSInPassReadTransition.h b/rpcs3/ios/IOSInPassReadTransition.h
new file mode 100644
index 0000000..138df00
--- /dev/null
+++ b/rpcs3/ios/IOSInPassReadTransition.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_IN_PASS_READ_TRANSITION_655: Assassin's Creed, IPA 653 (Core 652) device log, gameplay at 24-29 FPS with
+// the GPU 70-78 % busy: 44-53 render passes begin per frame, 13-19 of them on the framebuffer the previous pass ended
+// on (COREPROF RPASS652). vk::change_image_layout ends 28-36 passes per frame, 4-11 of which the next draw begins
+// again on the same framebuffer: an image the next draw samples (a render target rendered earlier, a texture uploaded
+// earlier) changes to SHADER_READ_ONLY_OPTIMAL while the pass is open, and the transition ended the pass. On the Apple
+// GPU every restart stores every attachment of the pass to memory and loads it back.
+//
+// A transition to SHADER_READ_ONLY_OPTIMAL of an image that is not an attachment of the open pass is now recorded
+// inside the pass. Its writer (an earlier pass or copy) is in an earlier Metal encoder: the patched MoltenVK makes
+// the open render encoder wait for the barrier's stage fences, as the next encoder would have after a restart
+// (MVKCmdPipelineBarrier, build-utils/rpcs3/patches/moltenvk-1.4.2-deferred-cache.patch; without a residency set
+// Metal tracks the hazard itself). Kept only when:
+// - the title policy enables it (Automatic: Assassin's Creed) and the linked MoltenVK defines
+//   rbx_mvk_in_pass_read_barrier_waits() (weak reference, checked once per boot);
+// - the transition goes to SHADER_READ_ONLY_OPTIMAL from a color or depth attachment layout or a transfer layout,
+//   with the full access masks of the standard transition and no queue family transfer;
+// - the open pass was begun by the draw path, whose framebuffer attachments are known, and the image is none of them.
+// Anything else ends the pass exactly as before. Counted per window (COREPROF RPASS655).
+extern "C" __attribute__((weak)) int rbx_mvk_in_pass_read_barrier_waits(void);
+
+namespace rpcs3::ios::in_pass_read
+{
+// Resolved once per boot (title policy and the MoltenVK hook); read by the RSX thread.
+inline std::atomic<bool> enabled{false};
+
+inline bool moltenvk_waits_in_pass() noexcept
+{
+	return rbx_mvk_in_pass_read_barrier_waits != nullptr && rbx_mvk_in_pass_read_barrier_waits() >= 1;
+}
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> kept_color{0};       // kept open: COLOR_ATTACHMENT_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
+	std::atomic<std::uint64_t> kept_depth{0};       // kept open: DEPTH_STENCIL_ATTACHMENT_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
+	std::atomic<std::uint64_t> kept_transfer{0};    // kept open: TRANSFER_DST/SRC_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
+	std::atomic<std::uint64_t> ended_attachment{0}; // read transition of an attachment of the open pass: ended
+	std::atomic<std::uint64_t> ended_unknown{0};    // read transition while the open pass's attachments are unknown: ended
+	std::atomic<std::uint64_t> ended_layout{0};     // read transition from another layout or with other masks/queues: ended
+	std::atomic<std::uint64_t> ended_disabled{0};   // read transition while the lever is off: ended
+	std::atomic<std::uint64_t> ended_other{0};      // transition to another layout with the pass open: ended
+	// REWINDBOX_PASS_SHAPE_910: ended_other by the layout asked for (Black Ops II: 26 per frame, RPASS652
+	// image_helpers.cpp). Attachment layouts are target switches; transfer layouts are uploads and copies recorded
+	// while a pass is open (candidates for recording before the pass); GENERAL is a feedback loop.
+	std::atomic<std::uint64_t> to_color{0}, to_depth{0}, to_transfer_dst{0}, to_transfer_src{0}, to_general{0};
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+}
diff --git a/rpcs3/ios/IOSJitLoad.h b/rpcs3/ios/IOSJitLoad.h
new file mode 100644
index 0000000..5344bda
--- /dev/null
+++ b/rpcs3/ios/IOSJitLoad.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_FAST_JIT_LOAD_634: Build 629 logs, every module already in the cache (no compilation).
+// Black Ops II multiplayer waits 3.19 s for 86 objects, Assassin's Creed 4.44 s for 175, the
+// largest part of a boot, on one thread of a 6-core phone:
+// - ppu_cache_read: 390 MB inflated for 212 MB of objects. The check pass inflates each object to
+//   validate it, keeps 32 MiB of them, and the link inflates the others a second time;
+// - ppu_object_load 1.13 s, ppu_finalize 1.42 s (323 ms at most): MCJIT engines, one per 25
+//   objects, used in turn although nothing is shared between them but the arena allocator;
+// - each object is copied whole (getObjectForDebug) for this JIT event listener, whose only reader
+//   writes a dump into a folder that does not exist on the iPhone, and once more for the GDB
+//   listener of MCJIT.
+// The check pass and the link run on up to link_workers threads, one engine per thread at a time,
+// and the bytes the check pass inflated reach the link when the memory headroom allows it. Same
+// objects, same relocations, same code: only the order the engines are filled in changes, and
+// each engine still links its own objects in the same order.
+//
+// REWINDBOX_JIT_OBJECT_RELEASE_634: MCJIT keeps every object file for its whole life, although
+// the sections are copied to the arena when the object is added and relocations read them there,
+// and the GDB listener it registers on every engine keeps a second copy of each one. The second
+// copy goes with the listener, for a debugger that reads __jit_debug_descriptor.
+// 212 MB for Assassin's Creed (128 MB for Black Ops II multiplayer) plus every SPU object (87 MB
+// over the three sessions of the logs), never read again: they turn cold and join the 1 GB the
+// system compresses, which still counts in the footprint. The compiler keeps these bytes itself
+// and frees them after finalizeObject. The file object left in MCJIT holds a dangling pointer that
+// MCJIT only uses as a key when it unregisters the object (MCJIT::notifyFreeingObject).
+namespace rpcs3::ios::jit_load
+{
+inline std::atomic<bool> fast_load{false};      // experimental.fast_jit_load
+inline std::atomic<bool> release_bytes{false};  // experimental.jit_object_release
+
+inline constexpr std::uint32_t link_workers = 4; // the 2 performance and 2 efficiency cores of the phone: the game is not running yet
+inline constexpr std::size_t minimum_window_bytes = 32ull << 20;
+inline constexpr std::size_t maximum_window_bytes = 256ull << 20;
+
+// Inflated object bytes kept between the check pass and the link.
+inline std::atomic<std::size_t> window_limit{minimum_window_bytes};
+
+constexpr std::size_t window_bytes(std::uint64_t headroom_bytes) noexcept
+{
+	return static_cast<std::size_t>(std::clamp<std::uint64_t>(headroom_bytes / 8, minimum_window_bytes, maximum_window_bytes));
+}
+}
diff --git a/rpcs3/ios/IOSLoadOpClear907.h b/rpcs3/ios/IOSLoadOpClear907.h
new file mode 100644
index 0000000..d0f45ef
--- /dev/null
+++ b/rpcs3/ios/IOSLoadOpClear907.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_LOAD_OP_CLEAR_907: Assassin's Creed (BLES00158), IPA 676 device log, gameplay at 25-28 FPS with the GPU
+// busy 77-84 % (about 30 ms of GPU work per frame): 44-48 render passes begin per frame (COREPROF RPASS652), every one
+// created with load-op LOAD for every attachment (VKRenderPass.cpp). A guest clear that is the first command on its
+// framebuffer begins such a pass and then records vkCmdClearAttachments, which MoltenVK executes as a triangle draw
+// (MVKCmdClearAttachments::encode): the Apple GPU first loads the whole attachment from memory into tile memory, then
+// overwrites every pixel of it.
+//
+// When the clear covers the whole framebuffer (render area = framebuffer), every bound color buffer with the full
+// write mask (fast clear) and/or whole depth/stencil aspects, on single-sample targets, and no pass is open on this
+// framebuffer, the pass now begins with load-op CLEAR for exactly those attachments and the same clear values. The
+// result in every pixel is the clear value in both cases, written before any draw of the pass, so the image the game
+// sees is identical; only the load from memory and the clear draw are gone. The other attachments keep LOAD. Anything
+// else (scissored or partial clears, masked channels, MSAA, a pass already open on the framebuffer) records vkCmdClearAttachments exactly as before. Counted per window
+// (COREPROF LOADCLEAR907).
+namespace rpcs3::ios::load_op_clear
+{
+// Resolved once per boot (title policy); read by the RSX thread.
+inline std::atomic<bool> enabled{false};
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> passes{0};          // passes begun with load-op CLEAR
+	std::atomic<std::uint64_t> color{0};           // ... clearing the color attachments
+	std::atomic<std::uint64_t> depth{0};           // ... clearing depth
+	std::atomic<std::uint64_t> stencil{0};         // ... clearing stencil
+	std::atomic<std::uint64_t> kept_open_pass{0};  // vkCmdClearAttachments kept: a pass is open on this framebuffer
+	std::atomic<std::uint64_t> kept_partial{0};    // ... the clear is scissored, masked or MSAA
+	std::atomic<std::uint64_t> kept_disabled{0};   // ... the title policy has the lever off
+};
+
+inline window_counters counters;
+
+inline void add(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::load_op_clear
diff --git a/rpcs3/ios/IOSLocalProfile933.h b/rpcs3/ios/IOSLocalProfile933.h
new file mode 100644
index 0000000..4fc4649
--- /dev/null
+++ b/rpcs3/ios/IOSLocalProfile933.h
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <system_error>
+
+// REWINDBOX_LOCAL_PROFILE_933 (maintainer audit, 11 Nov 2026, priority 3: keep the decisions validated for a game on
+// this device for its later launches): what the Core learned about a title, in config/local_profiles/<serial>.txt.
+// - Keyed by the serial and the game version (PARAM.SFO APP_VER, which a game update changes). A profile of another
+//   version or format, or a file that is too large or not understood, is ignored and replaced; it never stops a boot.
+// - Bounded: at most max_bytes, a closed set of decisions with closed values; an unknown decision line is skipped
+//   (a later Core may add one) and counted.
+// - Written whole and atomically (fs::pending_file, ios/IOSLocalProfileStore933.h), only when a decision is learned or
+//   withdrawn, and on its first `validation_writes` validations (a boot that validates it again writes nothing).
+// - A learned decision acts only where the title's setting is Automatic and the Core's title list does not already
+//   decide; the user's setting, global or per game, always wins. It takes effect at the next boot, never mid-session.
+//
+// REWINDBOX_LEARNED_PREFETCH_933, first learned decision (shares a validated correction by mechanism instead of a
+// title list): the SPU object prefetch of Core 616 (ios/IOSSpuObjectPrefetch.h) reads a title's cached SPU objects
+// into memory on a utility thread from the runtime's creation, so that a compile thread takes their bytes instead of
+// opening thousands of small files. Black Ops II spent 4.3 s of a 5 s window opening 7,162 objects (Build 614) and
+// takes them in 0.02 ms from memory; Assassin's Creed read 4,000 in its first minute, 0.4 to 0.7 ms each. Both are on
+// the title list. Any other title that shows the same cost learns the prefetch:
+// - learn: a report window with the prefetch off in which the compile threads spent at least evidence_min_us reading
+//   at least evidence_min_reads SPU objects (JITPROF spu_cache_read, the same file read and inflate), at least half of
+//   them for compiles of play (SPUPROF gameplay_attempts), not of the boot warm-up;
+// - validate: a later boot with the learned prefetch serves at least validate_min_hits objects from memory;
+// - withdraw: a boot with the learned prefetch that ran withdraw_after_windows reports and served less than
+//   withdraw_max_hit_permille of the planned objects (memory held for nothing); only windows with presented frames
+//   count, so a pause or the background never withdraws it. A withdrawn decision stays withdrawn for this game
+//   version. A boot whose store did not start (SPU cache off, no object on disk) plans nothing: its decision neither
+//   validates nor withdraws, and holds no memory.
+// - The first report window of a boot's session is not used, nor any window reported before it: the reporter starts
+//   its session when the renderer is created, after the title policy, and the JIT and prefetch counters are exchanged
+//   only by the report, so these windows can hold the end of the previous boot (a game started within 5 s of another).
+// Same bytes, same validation, same link as the disk path: guest code is unchanged.
+// The JITPROF counters were read by no decision before (Utilities/JITPhaseProfile.h still says so); this rule reads the
+// spu_cache_read figures of a window after the reporter has exchanged them, to decide the next boot, never the current
+// one and never code generation.
+namespace rpcs3::ios::local_profile933
+{
+inline constexpr std::string_view header = "rewindbox-local-profile 1";
+inline constexpr std::size_t max_bytes = 4096;
+inline constexpr std::size_t max_version_size = 16;
+
+inline constexpr std::uint64_t evidence_min_reads = 200;
+inline constexpr std::uint64_t evidence_min_us = 500'000; // a tenth of a 5 s report window
+inline constexpr std::uint64_t validate_min_hits = 500;
+inline constexpr std::uint32_t withdraw_after_windows = 24; // two minutes of reports
+inline constexpr std::uint64_t withdraw_min_planned = 100;
+inline constexpr std::uint64_t withdraw_max_hit_permille = 10;
+inline constexpr std::uint32_t validation_writes = 3;
+
+enum class state : std::uint8_t
+{
+	none,
+	on,
+	withdrawn,
+};
+
+constexpr const char* state_name(state value) noexcept
+{
+	switch (value)
+	{
+	case state::on: return "on";
+	case state::withdrawn: return "withdrawn";
+	default: return "none";
+	}
+}
+
+struct prefetch_record
+{
+	state value = state::none;
+	std::uint32_t validated = 0;      // boots in which the learned prefetch served the title's reads
+	std::uint64_t evidence_reads = 0; // the window that taught it: SPU objects read by the compile threads
+	std::uint64_t evidence_ms = 0;    // and the time they spent reading them
+	std::uint32_t withdrawn_planned = 0, withdrawn_hits = 0; // what the withdrawing boot planned and served
+};
+
+struct profile
+{
+	std::string serial, version;
+	prefetch_record prefetch;
+	std::uint32_t skipped_lines = 0; // decisions of a later Core, kept out
+};
+
+enum class load_status : std::uint8_t
+{
+	absent,
+	loaded,
+	other_version,
+	malformed,
+	too_large,
+	unreadable,
+	not_a_title, // no serial or no version: nothing is read or written
+};
+
+constexpr const char* load_status_name(load_status value) noexcept
+{
+	switch (value)
+	{
+	case load_status::absent: return "absent";
+	case load_status::loaded: return "loaded";
+	case load_status::other_version: return "other_version";
+	case load_status::malformed: return "malformed";
+	case load_status::too_large: return "too_large";
+	case load_status::unreadable: return "unreadable";
+	case load_status::not_a_title: return "not_a_title";
+	default: return "unknown";
+	}
+}
+
+// The serial names the file: four capital letters and five digits (BLES01717), nothing else.
+constexpr bool valid_serial(std::string_view serial) noexcept
+{
+	if (serial.size() != 9)
+	{
+		return false;
+	}
+	for (std::size_t i = 0; i < 9; i++)
+	{
+		const char c = serial[i];
+		if (i < 4 ? !(c >= 'A' && c <= 'Z') : !(c >= '0' && c <= '9'))
+		{
+			return false;
+		}
+	}
+	return true;
+}
+
+// APP_VER ("01.02") or VERSION: one token, digits, letters, dots, dashes and underscores, with at least one digit.
+// Emulator::Load names a title without either "Unknown": such a title has no version a game update would change, so it
+// gets no profile.
+constexpr bool valid_version(std::string_view version) noexcept
+{
+	if (version.empty() || version.size() > max_version_size)
+	{
+		return false;
+	}
+	bool digit = false;
+	for (const char c : version)
+	{
+		if (!((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '.' || c == '-' || c == '_'))
+		{
+			return false;
+		}
+		digit = digit || (c >= '0' && c <= '9');
+	}
+	return digit;
+}
+
+namespace detail
+{
+// Splits off the next space-separated token.
+constexpr std::string_view next_token(std::string_view& rest) noexcept
+{
+	while (!rest.empty() && rest.front() == ' ')
+	{
+		rest.remove_prefix(1);
+	}
+	const std::size_t end = rest.find(' ');
+	const std::string_view token = rest.substr(0, end);
+	rest.remove_prefix(end == std::string_view::npos ? rest.size() : end);
+	return token;
+}
+
+template <typename T>
+bool number(std::string_view text, T& out) noexcept
+{
+	if (text.empty() || text.size() > 20)
+	{
+		return false;
+	}
+	T value{};
+	const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+	if (error != std::errc{} || end != text.data() + text.size())
+	{
+		return false;
+	}
+	out = value;
+	return true;
+}
+
+// "name=value" with a decimal value.
+template <typename T>
+bool field(std::string_view token, std::string_view name, T& out) noexcept
+{
+	return token.size() > name.size() + 1 && token.substr(0, name.size()) == name && token[name.size()] == '=' &&
+		number(token.substr(name.size() + 1), out);
+}
+
+inline bool parse_prefetch(std::string_view rest, prefetch_record& out) noexcept
+{
+	const std::string_view value = next_token(rest);
+	prefetch_record record{};
+	if (value == "on")
+	{
+		record.value = state::on;
+	}
+	else if (value == "withdrawn")
+	{
+		record.value = state::withdrawn;
+	}
+	else
+	{
+		return false;
+	}
+	if (!field(next_token(rest), "validated", record.validated) || !field(next_token(rest), "evidence_reads", record.evidence_reads) ||
+		!field(next_token(rest), "evidence_ms", record.evidence_ms) || !field(next_token(rest), "withdrawn_planned", record.withdrawn_planned) ||
+		!field(next_token(rest), "withdrawn_hits", record.withdrawn_hits) || !next_token(rest).empty())
+	{
+		return false;
+	}
+	out = record;
+	return true;
+}
+} // namespace detail
+
+inline std::string serialize(const profile& p)
+{
+	std::string text{header};
+	text += "\nserial ";
+	text += p.serial;
+	text += "\nversion ";
+	text += p.version;
+	text += '\n';
+	if (p.prefetch.value != state::none)
+	{
+		text += "spu_object_prefetch ";
+		text += state_name(p.prefetch.value);
+		text += " validated=" + std::to_string(p.prefetch.validated);
+		text += " evidence_reads=" + std::to_string(p.prefetch.evidence_reads);
+		text += " evidence_ms=" + std::to_string(p.prefetch.evidence_ms);
+		text += " withdrawn_planned=" + std::to_string(p.prefetch.withdrawn_planned);
+		text += " withdrawn_hits=" + std::to_string(p.prefetch.withdrawn_hits);
+		text += '\n';
+	}
+	return text;
+}
+
+// Reads a profile written for this serial and version. Anything else leaves `out` as an empty profile of this
+// serial and version, so that the next write replaces the file.
+inline load_status parse(std::string_view text, std::string_view serial, std::string_view version, profile& out)
+{
+	out = profile{std::string{serial}, std::string{version}, {}, 0};
+	if (text.size() > max_bytes)
+	{
+		return load_status::too_large;
+	}
+
+	profile read{std::string{serial}, std::string{version}, {}, 0};
+	bool have_header = false, have_serial = false, have_version = false, have_prefetch = false;
+	std::size_t line_number = 0;
+
+	while (!text.empty())
+	{
+		const std::size_t end = text.find('\n');
+		if (end == std::string_view::npos)
+		{
+			return load_status::malformed; // every line ends with a newline: a cut file is not read
+		}
+		std::string_view line = text.substr(0, end);
+		text.remove_prefix(end + 1);
+
+		if (line_number++ == 0)
+		{
+			if (line != header)
+			{
+				return load_status::malformed;
+			}
+			have_header = true;
+			continue;
+		}
+
+		std::string_view rest = line;
+		const std::string_view key = detail::next_token(rest);
+		if (key == "serial")
+		{
+			const std::string_view value = detail::next_token(rest);
+			if (have_serial || !valid_serial(value) || !detail::next_token(rest).empty())
+			{
+				return load_status::malformed;
+			}
+			if (value != serial)
+			{
+				return load_status::malformed; // another title's file under this name
+			}
+			have_serial = true;
+		}
+		else if (key == "version")
+		{
+			const std::string_view value = detail::next_token(rest);
+			if (have_version || !valid_version(value) || !detail::next_token(rest).empty())
+			{
+				return load_status::malformed;
+			}
+			if (value != version)
+			{
+				return load_status::other_version;
+			}
+			have_version = true;
+		}
+		else if (key == "spu_object_prefetch")
+		{
+			if (have_prefetch || !detail::parse_prefetch(rest, read.prefetch))
+			{
+				return load_status::malformed;
+			}
+			have_prefetch = true;
+		}
+		else if (!key.empty() && key.find('=') == std::string_view::npos)
+		{
+			read.skipped_lines++;
+		}
+		else
+		{
+			return load_status::malformed;
+		}
+	}
+
+	if (!have_header || !have_serial || !have_version)
+	{
+		return load_status::malformed;
+	}
+	out = std::move(read);
+	return load_status::loaded;
+}
+
+// One report window, as RPCS3IOSPerformance.cpp reads it.
+struct window_input
+{
+	bool prefetch_active = false;       // the store was started at this boot
+	std::uint64_t cache_reads = 0;      // JITPROF spu_cache_read events of the window
+	std::uint64_t cache_read_us = 0;    // and their exclusive time
+	std::uint64_t prefetch_hits = 0;    // objects the store served from memory in the window
+	std::uint64_t prefetch_planned = 0; // objects the store planned at boot
+	std::uint64_t frames = 0;           // frames presented in the window (0: paused, in the background or frozen)
+	std::uint64_t gameplay_compiles = 0; // SPUPROF gameplay_attempts: SPU compiles outside the boot warm-up
+	std::uint64_t session = 0;           // the report's session (COREPROF session=)
+};
+
+enum class verdict : std::uint8_t
+{
+	none,
+	learned,
+	validated,
+	withdrawn,
+};
+
+constexpr const char* verdict_name(verdict value) noexcept
+{
+	switch (value)
+	{
+	case verdict::learned: return "learned";
+	case verdict::validated: return "validated";
+	case verdict::withdrawn: return "withdrawn";
+	default: return "none";
+	}
+}
+
+// The learning of one boot. Called from the report thread only.
+class prefetch_rule
+{
+	bool m_eligible = false;   // Automatic, and the title list does not decide
+	bool m_learned_on = false; // this boot runs the learned prefetch
+	bool m_settled = false;    // validated or withdrawn at this boot: nothing more to decide
+	bool m_session_seen = false;
+	std::uint64_t m_session = 0;
+	std::uint32_t m_windows = 0;
+	std::uint64_t m_hits = 0;
+
+public:
+	void begin(bool eligible, bool learned_on) noexcept
+	{
+		*this = prefetch_rule{};
+		m_eligible = eligible;
+		m_learned_on = eligible && learned_on;
+	}
+
+	bool eligible() const noexcept { return m_eligible; }
+	bool learned_on() const noexcept { return m_learned_on; }
+
+	verdict observe(const window_input& in, prefetch_record& record) noexcept
+	{
+		if (!m_eligible || m_settled)
+		{
+			return verdict::none;
+		}
+
+		// A window of another session than the last one seen is the first of a new session, or one reported before it:
+		// it may hold counts of the previous boot.
+		if (!m_session_seen || in.session != m_session)
+		{
+			m_session_seen = true;
+			m_session = in.session;
+			return verdict::none;
+		}
+
+		if (!m_learned_on)
+		{
+			// The reads must come from the compiles of play: the boot warm-up reads every recorded object on its own
+			// workers before the game runs (God of War III, Build 694: 1,810 objects in 1.85 s, all warm-up), and
+			// the prefetch does not shorten that wait.
+			if (record.value != state::none || in.prefetch_active || in.cache_reads < evidence_min_reads || in.cache_read_us < evidence_min_us ||
+				in.gameplay_compiles * 2 < in.cache_reads)
+			{
+				return verdict::none;
+			}
+			record = prefetch_record{state::on, 0, in.cache_reads, in.cache_read_us / 1000, 0, 0};
+			m_settled = true;
+			return verdict::learned;
+		}
+
+		// Hits count whenever they come; only a window in which the game presented frames counts towards the
+		// withdrawal, so that a pause or the background never withdraws a decision.
+		m_hits += in.prefetch_hits;
+		m_windows += in.frames ? 1u : 0u;
+		if (m_hits >= validate_min_hits)
+		{
+			m_settled = true;
+			if (record.validated >= validation_writes)
+			{
+				return verdict::none; // validated often enough: nothing to write
+			}
+			record.validated++;
+			return verdict::validated;
+		}
+		if (m_windows >= withdraw_after_windows && in.prefetch_planned >= withdraw_min_planned &&
+			m_hits * 1000 < in.prefetch_planned * withdraw_max_hit_permille)
+		{
+			record.value = state::withdrawn;
+			record.withdrawn_planned = static_cast<std::uint32_t>(in.prefetch_planned > UINT32_MAX ? UINT32_MAX : in.prefetch_planned);
+			record.withdrawn_hits = static_cast<std::uint32_t>(m_hits);
+			m_settled = true;
+			return verdict::withdrawn;
+		}
+		return verdict::none;
+	}
+};
+} // namespace rpcs3::ios::local_profile933
diff --git a/rpcs3/ios/IOSLocalProfileStore933.h b/rpcs3/ios/IOSLocalProfileStore933.h
new file mode 100644
index 0000000..2047c56
--- /dev/null
+++ b/rpcs3/ios/IOSLocalProfileStore933.h
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSLocalProfile933.h"
+#include "Utilities/File.h"
+
+#include <mutex>
+#include <string>
+#include <string_view>
+
+// REWINDBOX_LOCAL_PROFILE_933 (ios/IOSLocalProfile933.h): the profile file and the profile of the running boot.
+// Emulator::Load reads it before the title policy is resolved; the policy resolution starts the boot's learning; the
+// report thread feeds each window and writes the file when a decision is learned, withdrawn or validated (its first
+// validation_writes times). One mutex: the boot thread and the report thread never hold it for longer than a small file
+// write, and it takes no other lock.
+namespace rpcs3::ios::local_profile933
+{
+// Beside config.yml and the configuration database cache (config/).
+inline std::string directory()
+{
+	return fs::get_config_dir(true) + "local_profiles/";
+}
+
+inline std::string path_for(std::string_view serial)
+{
+	return directory() + std::string{serial} + ".txt";
+}
+
+struct observation
+{
+	verdict outcome = verdict::none;
+	prefetch_record record{};
+	bool saved = false;
+	std::uint64_t hits = 0, planned = 0;
+};
+
+class current
+{
+	mutable std::mutex m_mutex;
+	load_status m_status = load_status::not_a_title;
+	profile m_profile{};
+	prefetch_rule m_rule{};
+
+	// Whole file, written to a temporary name and renamed over the old one.
+	static bool save(const profile& value)
+	{
+		const std::string text = serialize(value);
+		if (text.size() > max_bytes || !fs::create_path(directory()))
+		{
+			return false;
+		}
+		fs::pending_file destination{path_for(value.serial)};
+		return destination.file && destination.file.write(text.data(), text.size()) == text.size() && destination.commit();
+	}
+
+public:
+	static current& instance()
+	{
+		static current value;
+		return value;
+	}
+
+	// At boot, before the title policy is resolved. Nothing is read for a boot without a game serial and version.
+	load_status load(std::string_view serial, std::string_view version)
+	{
+		std::lock_guard lock(m_mutex);
+		m_rule.begin(false, false);
+		m_profile = profile{};
+		if (!valid_serial(serial) || !valid_version(version))
+		{
+			return m_status = load_status::not_a_title;
+		}
+
+		m_profile.serial = std::string{serial};
+		m_profile.version = std::string{version};
+		const std::string path = path_for(serial);
+		if (!fs::is_file(path))
+		{
+			return m_status = load_status::absent;
+		}
+
+		fs::file file{path, fs::read};
+		if (!file)
+		{
+			return m_status = load_status::unreadable;
+		}
+		if (file.size() > max_bytes)
+		{
+			return m_status = load_status::too_large;
+		}
+		const std::string text = file.to_string();
+		return m_status = parse(text, serial, version, m_profile);
+	}
+
+	load_status status() const
+	{
+		std::lock_guard lock(m_mutex);
+		return m_status;
+	}
+
+	prefetch_record prefetch() const
+	{
+		std::lock_guard lock(m_mutex);
+		return m_profile.prefetch;
+	}
+
+	std::uint32_t skipped_lines() const
+	{
+		std::lock_guard lock(m_mutex);
+		return m_profile.skipped_lines;
+	}
+
+	// From the title policy: whether this boot may learn (Automatic, no title list decision) and whether it runs the
+	// learned prefetch. A boot without a title learns nothing.
+	void begin_boot(bool eligible, bool learned_on)
+	{
+		std::lock_guard lock(m_mutex);
+		m_rule.begin(eligible && m_status != load_status::not_a_title, learned_on);
+	}
+
+	// From the report thread, once per window.
+	observation observe(const window_input& in)
+	{
+		std::lock_guard lock(m_mutex);
+		observation result;
+		prefetch_record record = m_profile.prefetch;
+		result.outcome = m_rule.observe(in, record);
+		result.hits = in.prefetch_hits;
+		result.planned = in.prefetch_planned;
+		if (result.outcome != verdict::none)
+		{
+			m_profile.prefetch = record;
+			m_profile.skipped_lines = 0; // the file is rewritten from what this Core understands
+			result.saved = save(m_profile);
+		}
+		result.record = m_profile.prefetch;
+		return result;
+	}
+};
+} // namespace rpcs3::ios::local_profile933
