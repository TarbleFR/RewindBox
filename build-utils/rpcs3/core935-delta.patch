+// REWINDBOX_BACKGROUND_PAUSE_931 (ios/IOSBackgroundPause931.h): the pause and the resume run on their own serial queue,
+// never on the main thread that posts the notifications (Emu.Pause may wait for the main thread), one after the other.
+// Each is first sent through the main queue: the notification center calls a notification's observers one after the
+// other on the main thread, in an order it does not document, and a block on the main queue runs only once the
+// posting has returned, so after the GPU gate's observer of the same notification has settled the queues
+// (background) or reopened the gate (active). The gate's observers wait with bounded fence waits, never a run loop.
+namespace rpcs3::ios::background_pause
+{
+namespace
+{
+dispatch_queue_t pause_queue() noexcept
+{
+	static dispatch_queue_t queue = dispatch_queue_create("rpcs3.background-pause", DISPATCH_QUEUE_SERIAL);
+	return queue;
+}
+}
+
+void request_pause() noexcept
+{
+	// Decided on the main thread, once a posting in progress has returned: only while the application is in the
+	// background there (a request that arrives once it is active again is dropped), then on the serial queue.
+	dispatch_async(dispatch_get_main_queue(), ^{
+		if (UIApplication.sharedApplication.applicationState != UIApplicationStateBackground)
+		{
+			return;
+		}
+
+		dispatch_async(pause_queue(), ^{
+			state::instance().pause_if_running([] { return rpcs3_ios_pause_emulation() == RPCS3_IOS_OK; });
+		});
+	});
+}
+
+void app_entered_background() noexcept
+{
+	state::instance().set_background(true);
+	request_pause();
+}
+
+void app_became_active() noexcept
+{
+	state::instance().set_background(false);
+	dispatch_async(dispatch_get_main_queue(), ^{
+		dispatch_async(pause_queue(), ^{
+			state::instance().resume_if_ours([] { return rpcs3_ios_resume_emulation() == RPCS3_IOS_OK; });
+		});
+	});
+}
+
+// REWINDBOX_BACKGROUND_PAUSE_TRANSITION_932: the emulation just entered the running state. In the background, a pause
+// not made yet is asked now; request_pause decides on the main thread and refuses it if the application came back.
+void on_emulation_running() noexcept
+{
+	state::instance().ask_on_running([] { request_pause(); });
+}
+
+// Called from gpu_gate::install_application_observers (the first Vulkan device of the process, on the thread that creates
+// it), once; the blocks run on the thread that posts the notification.
+void install_observers() noexcept
+{
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		@autoreleasepool
+		{
+			NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+			id paused = [center addObserverForName:UIApplicationDidEnterBackgroundNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { app_entered_background(); }];
+			id resumed = [center addObserverForName:UIApplicationDidBecomeActiveNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { app_became_active(); }];
+			// REWINDBOX_THERMAL_POLICY_931 (ios/IOSThermalPolicy931.h): the state the system posts, read once now.
+			id thermal = [center addObserverForName:NSProcessInfoThermalStateDidChangeNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { rpcs3::ios::thermal::set_state(static_cast<int>(NSProcessInfo.processInfo.thermalState)); }];
+			rpcs3::ios::thermal::set_state(static_cast<int>(NSProcessInfo.processInfo.thermalState));
+			// Registered for the life of the process.
+			static_cast<void>(CFBridgingRetain(paused));
+			static_cast<void>(CFBridgingRetain(resumed));
+			static_cast<void>(CFBridgingRetain(thermal));
+
+			// Installed with the first Vulkan device: a game started just before leaving finds the application already in
+			// the background, and no notification will say so. Read on the main thread, where they are posted.
+			dispatch_async(dispatch_get_main_queue(), ^{
+				if (UIApplication.sharedApplication.applicationState == UIApplicationStateBackground)
+				{
+					state::instance().set_background(true);
+					request_pause();
+				}
+			});
+		}
+	});
+}
+}
