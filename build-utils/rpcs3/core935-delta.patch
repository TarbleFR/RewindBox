+
+#include "Emu/RSX/Common/TextureUtils.h"
+#include "Emu/RSX/RSXThread.h"
+#include "Emu/Memory/vm.h"
+#include "Emu/system_config.h"
+
+namespace mtl
+{
+	namespace
+	{
+		surface_counters g_surface_counters{};
+		data_heap* g_upload_heap = nullptr;
+		u64 g_current_frame_id = 1;
+
+		// M4: VKRenderTargets.h create_new_surface: the AA mode's sample count at the "Auto" MSAA level, one sample (and
+		// the null sample layout) otherwise. The descriptor's sample metrics always keep the RSX AA mode: they define the
+		// guest-memory layout of the surface (pitch, extent).
+		std::pair<u8, rsx::surface_sample_layout> surface_msaa(rsx::surface_antialiasing antialias)
+		{
+			const bool msaa_auto = g_cfg.video.antialiasing_level == msaa_level::_auto;
+			const u8 samples = static_cast<u8>(msaa::host_samples(msaa_auto, get_format_sample_count(antialias)));
+			return { samples, msaa_auto ? rsx::surface_sample_layout::ps3 : rsx::surface_sample_layout::null };
+		}
+		// M4 end
+	}
+
+	surface_counters& get_surface_counters()
+	{
+		return g_surface_counters;
+	}
+
+	void set_upload_heap(data_heap* heap)
+	{
+		g_upload_heap = heap;
+	}
+
+	data_heap* get_upload_heap()
+	{
+		return g_upload_heap;
+	}
+
+	void set_current_frame_id(u64 frame_id)
+	{
+		g_current_frame_id = std::max<u64>(frame_id, 1);
