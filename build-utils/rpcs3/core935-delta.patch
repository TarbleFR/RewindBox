diff --git a/rpcs3/ios/IOSThermalPolicy931.h b/rpcs3/ios/IOSThermalPolicy931.h
new file mode 100644
index 0000000..041a100
--- /dev/null
+++ b/rpcs3/ios/IOSThermalPolicy931.h
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+#include "IOSShardedCounter931.h"
+#include "IOSWriterParkSpin917.h" // compare::event_waits_forced, set by the report thread inside a comparison step
+
+// REWINDBOX_THERMAL_POLICY_931: the Core follows the iPhone's thermal state (ProcessInfo.thermalState, posted by
+// the system: 0 nominal, 1 fair, 2 serious, 3 critical) and, once the device is hot, changes HOW some short waits
+// wait, never WHAT they wait for. Black Ops II (IPA 725) reaches state 2 after about 35 s of play and stays there;
+// its frame rate falls from about 45 to about 30 while the work per frame stays the same.
+//
+// "Event waits when hot" (Automatic: from state 2): three waits that spin on a core for a few microseconds (the
+// writer's park spin of REWINDBOX_WRITER_PARK_SPIN_917, the PPU passive-lock spin before its timed wait, the RSX FIFO
+// idle wait before its park) wait instead with the ARM exclusive monitor (LDAXR then WFE): the core is clock-gated
+// until another core writes the watched line (the very write the wait is for) or the system's event stream ends the
+// WFE, which XNU enables as the WFE timeout (osfmk/arm64/machine_routines.c, _enable_timebase_event_stream). Each wait
+// keeps its condition, its time bound and its fallback. Below state 2, and with the setting Disabled, every wait is
+// exactly the previous one. With Lever Comparison Between Report Windows Enabled, the setting Automatic alternates by
+// window with the two levers of Cores 917 and 918 (IOSWriterParkSpin917.h, compare::event_waits_at).
+namespace rpcs3::ios::thermal
+{
+inline std::atomic<int> state{-1};                // thermalState, -1 until the platform has read it
+inline std::atomic<std::uint8_t> setting{0};      // 0 Automatic, 1 Enabled, 2 Disabled (boot policy)
+inline std::atomic<std::uint64_t> state_changes{0};
+inline constexpr int automatic_from = 2;          // serious
+
+constexpr bool decide(std::uint8_t mode, int thermal_state, int forced) noexcept
+{
+	if (forced >= 0)
+	{
+		return forced != 0;
+	}
+
+	return mode == 1 ? true : mode == 2 ? false : thermal_state >= automatic_from;
+}
+
+inline bool event_waits() noexcept
+{
+	return decide(setting.load(std::memory_order_relaxed), state.load(std::memory_order_relaxed),
+		writer_park::compare::event_waits_forced.load(std::memory_order_relaxed));
+}
+
+// REWINDBOX_SPU_IDLE_BACKOFF_935 (ios/IOSSpuIdleBackoff935.h): the lengthened idle waits of SPU threads follow the
+// same setting, but not the thermal state: they are on unless "Event Waits When Hot" is Disabled, and inside a
+// comparison step they are what the step says, so a comparison between report windows measures both together.
+constexpr bool decide_idle_backoff(std::uint8_t mode, int forced) noexcept
+{
+	return forced >= 0 ? forced != 0 : mode != 2;
+}
+
+inline bool idle_backoff() noexcept
+{
+	return decide_idle_backoff(setting.load(std::memory_order_relaxed),
+		writer_park::compare::event_waits_forced.load(std::memory_order_relaxed));
+}
+
+// Platform observer (RPCS3IOSPlatform.mm): the state the system posted.
+// REWINDBOX_THERMAL_LEDGER_932 (maintainer audit, 11 Nov 2026): THERMAL931 classified a report window by the state
+// read at its end, so a window that heated up in its middle counted whole in the hotter state. The ledger keeps the
+// time spent in each state and the number of transitions; a report takes one snapshot per window and prints the
+// state at the start and at the end, the time in each state and whether the window was mixed. A mixed window cannot
+// be split (the energy line is per window): the analyzer leaves it out of every per-state comparison.
+// Slots: 0 unknown (no state read yet), 1 nominal, 2 fair, 3 serious, 4 critical.
+inline constexpr std::size_t ledger_slots = 5;
+
+constexpr std::size_t ledger_slot(int thermal_state) noexcept
+{
+	return thermal_state >= 0 && thermal_state <= 3 ? static_cast<std::size_t>(thermal_state) + 1 : 0;
+}
+
+struct ledger_snapshot
+{
+	bool valid = false;
+	int state = -1;
+	std::uint64_t changes = 0;
+	std::uint64_t time_ns[ledger_slots] = {};
+};
+
+class ledger
+{
+public:
+	// Called on every notified state (the platform observer, any thread) with a steady clock.
+	void record(int thermal_state, std::uint64_t now_ns) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		account(now_ns);
+		if (thermal_state != m_state)
+		{
+			m_state = thermal_state;
+			m_changes++;
+		}
+	}
+
+	ledger_snapshot snapshot(std::uint64_t now_ns) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		account(now_ns);
+		ledger_snapshot out;
+		out.valid = true;
+		out.state = m_state;
+		out.changes = m_changes;
+		for (std::size_t i = 0; i < ledger_slots; i++)
+		{
+			out.time_ns[i] = m_time_ns[i];
+		}
+		return out;
+	}
+
+private:
+	void account(std::uint64_t now_ns) noexcept
+	{
+		if (m_since_ns && now_ns > m_since_ns)
+		{
+			m_time_ns[ledger_slot(m_state)] += now_ns - m_since_ns;
+		}
+		if (now_ns > m_since_ns)
+		{
+			m_since_ns = now_ns;
+		}
+	}
+
+	std::mutex m_mutex;
+	int m_state = -1;
+	std::uint64_t m_since_ns = 0;
+	std::uint64_t m_changes = 0;
+	std::uint64_t m_time_ns[ledger_slots] = {};
+};
+
+inline ledger state_ledger;
+
+inline std::uint64_t steady_now_ns() noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline void set_state(int thermal_state) noexcept
+{
+	if (state.exchange(thermal_state, std::memory_order_relaxed) != thermal_state)
+	{
+		state_changes.fetch_add(1, std::memory_order_relaxed);
+	}
+	state_ledger.record(thermal_state, steady_now_ns()); // REWINDBOX_THERMAL_LEDGER_932
+}
+
+// One report window seen through two consecutive snapshots of the ledger.
+struct window_view
+{
+	bool known = false;               // both snapshots exist
+	int begin_state = -1, end_state = -1;
+	std::uint64_t changes = 0;
+	std::uint64_t ms[ledger_slots] = {};
+	bool mixed = false;               // a transition happened, or more than one state held time
+
+	std::size_t states_with_time() const noexcept
+	{
+		std::size_t n = 0;
+		for (const std::uint64_t value : ms)
+		{
+			n += value ? 1 : 0;
+		}
+		return n;
+	}
+};
+
+inline window_view view_between(const ledger_snapshot& before, const ledger_snapshot& now) noexcept
+{
+	window_view out;
+	if (!before.valid || !now.valid)
+	{
+		return out;
+	}
+	out.known = true;
+	out.begin_state = before.state;
+	out.end_state = now.state;
+	out.changes = now.changes >= before.changes ? now.changes - before.changes : 0;
+	for (std::size_t i = 0; i < ledger_slots; i++)
+	{
+		out.ms[i] = now.time_ns[i] >= before.time_ns[i] ? (now.time_ns[i] - before.time_ns[i]) / 1'000'000 : 0;
+	}
+	out.mixed = out.changes != 0 || out.states_with_time() > 1 || out.begin_state != out.end_state;
+	return out;
+}
+
+// The event waits of a window: constant when forced by a comparison step or by the setting; under Automatic they
+// follow the state, so a window that held time on both sides of the serious threshold is mixed.
+inline const char* event_waits_window(const window_view& window, std::uint8_t mode, int forced) noexcept
+{
+	if (forced >= 0)
+	{
+		return forced ? "on" : "off";
+	}
+	if (mode == 1 || mode == 2)
+	{
+		return mode == 1 ? "on" : "off";
+	}
+	if (!window.known)
+	{
+		return "unknown";
+	}
+	const std::uint64_t below = window.ms[0] + window.ms[ledger_slot(0)] + window.ms[ledger_slot(1)];
+	const std::uint64_t above = window.ms[ledger_slot(2)] + window.ms[ledger_slot(3)];
+	if (below && above)
+	{
+		return "mixed";
+	}
+	if (above || (!below && window.end_state >= automatic_from))
+	{
+		return "on";
+	}
+	return "off";
+}
+
+// Waits that took the event path, by site, for COREPROF THERMAL931 (per thread shards: no shared line on hot paths).
+enum site : std::size_t { writer_park, ppu_passive, rsx_idle, site_count };
+inline sharded::block<site_count> event_wait_counts{};
+
+inline void count(site where) noexcept
+{
+	event_wait_counts.add(where, 1);
+}
+
+inline const char* state_name(int thermal_state) noexcept
+{
+	switch (thermal_state)
+	{
+	case 0: return "nominal";
+	case 1: return "fair";
+	case 2: return "serious";
+	case 3: return "critical";
+	default: return "unknown";
+	}
+}
