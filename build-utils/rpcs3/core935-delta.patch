+	object::object(const object& other) noexcept
+		: m_ptr(other.m_ptr ? const_cast<void*>(CFRetain(other.m_ptr)) : nullptr)
+	{
+	}
+
+	object& object::operator=(const object& other) noexcept
+	{
+		if (this != &other)
+		{
+			void* const previous = m_ptr;
+			m_ptr = other.m_ptr ? const_cast<void*>(CFRetain(other.m_ptr)) : nullptr;
+			if (previous)
+			{
+				CFRelease(previous);
+			}
+		}
+		return *this;
+	}
+
+	object::object(object&& other) noexcept
+		: m_ptr(std::exchange(other.m_ptr, nullptr))
+	{
+	}
+
+	object& object::operator=(object&& other) noexcept
+	{
+		if (this != &other)
+		{
+			reset();
+			m_ptr = std::exchange(other.m_ptr, nullptr);
+		}
+		return *this;
+	}
+
+	object::~object()
+	{
+		reset();
+	}
+
+	object object::adopt(void* retained) noexcept
+	{
+		object result;
+		result.m_ptr = retained;
+		return result;
+	}
+
+	object object::retain(void* unretained) noexcept
+	{
+		object result;
+		result.m_ptr = unretained ? const_cast<void*>(CFRetain(unretained)) : nullptr;
+		return result;
+	}
+
+	void object::reset() noexcept
+	{
+		if (void* const previous = std::exchange(m_ptr, nullptr))
+		{
+			CFRelease(previous);
+		}
+	}
