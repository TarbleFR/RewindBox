+		ZCULL_control::ios_fault ZCULL_control::ios_on_demand_fault(u32 address, u32 page_address, u32 location)
+		{
+			// PPU or SPU thread inside the access violation handler (vm::temporary_unlock done).
+			namespace od = rpcs3::ios::zcull_on_demand;
+			auto& tally = od::counters();
+			const u64 started = get_system_time();
+			bool requested = false;
+			u64 requested_at = 0; // REWINDBOX_ZCULL_DEMAND_GUARD_621: the latest request
+			u64 picked_at = 0;    // ... and when the RSX thread was seen to pick it up
+			// The pickup and service halves of every request of this fault (a page re-armed between
+			// a service and the guest's check takes another request), up to `halves_at`.
+			u64 pickup_sum = 0, service_sum = 0, halves_at = 0;
+			bool any_picked = false;
+			// REWINDBOX_ZCULL_ASYNC_READS_630 (ios/IOSZcullOnDemand.h): the access violation handler
+			// decoded the instruction; `slots` while this access only needs its own memory.
+			auto& access = rpcs3::ios::guest_access::t_access;
+			bool slots = rpcs3::ios::get_experimental_policy().zcull_async_reads && access.size != 0 &&
+				static_cast<u64>(utils::get_page_size()) == od::tracked_page_bytes;
+			u64 poll_us = od::async_poll_first_us;
+			u32 pending_slot = address & ~(od::report_slot_bytes - 1); // the slot this access waits for
+			bool lead_taken = false; // REWINDBOX_ZCULL_READ_LEAD_659: once per fault
+
+			const auto page_released = [&]()
+			{
+				reader_lock lock(m_pages_mutex);
+				const auto found = m_locked_pages[location].find(page_address);
+				return found == m_locked_pages[location].end() || !found->second.has_refs();
+			};
+
+			const auto slots_released = [&]()
+			{
+				reader_lock lock(m_pages_mutex);
+				const auto found = m_locked_pages[location].find(page_address);
+				return found == m_locked_pages[location].end() || !found->second.has_refs() ||
+					!found->second.ios_slots.pending(address, access.size);
+			};
+
+			const auto finish = [&](ios_fault result)
+			{
+				if (requested && result == ios_fault::handled)
+				{
+					const u64 now = get_system_time();
+					tally.add_wait(now - started);
+
+					if (any_picked && now >= halves_at)
+					{
+						tally.add_halves(pickup_sum, service_sum + (now - halves_at));
+					}
+
+					// REWINDBOX_ZCULL_WAIT_GUARD_627: the wait rules only run with the guard on.
+					if (rpcs3::ios::get_experimental_policy().zcull_wait_guard && m_ios_demand.record_wait(now - started, now))
+					{
+						rsx_log.warning("ZCULL on-demand reads: guest waits tripped the lever (%s), upstream mode for the rest of this boot.",
+							od::trip_reason_name(m_ios_demand.trip_record().reason));
+						ios_log_trip();
+					}
+				}
+
+				return result;
+			};
+
+			while (true)
+			{
+				{
+					std::scoped_lock lock(m_pages_mutex);
+					auto& block = m_locked_pages[location];
+					const auto found = block.find(page_address);
+
+					if (found == block.end() || found->second.prot == utils::protection::rw)
+					{
+						// Not a ZCULL page (upstream returns false), or unlocked meanwhile
+						// (served, or the upstream mode of another access unlocked the location).
+						return finish((requested || m_pages_accessed[location]) ? ios_fault::handled : ios_fault::not_ours);
+					}
+
+					if (!m_pages_accessed[location] && !found->second.has_refs())
+					{
+						// Every report of the page is written: unlock it, the next report locks it again.
+						utils::memory_protect(vm::base(page_address), utils::get_page_size(), utils::protection::rw);
+						block.erase(found);
+
+						if (!requested)
+						{
+							tally.stale.fetch_add(1, std::memory_order_relaxed);
+						}
+
+						return finish(ios_fault::handled);
+					}
+
+					// REWINDBOX_ZCULL_ASYNC_READS_630: this memory is final, the page is held by other
+					// reports. The handler completes the access; `stale` counts these too.
+					if (slots && !m_pages_accessed[location] && !found->second.ios_slots.pending(address, access.size))
+					{
+						if (found->second.ios_slots.take_completion(get_system_time()))
+						{
+							access.emulate = true;
+
+							if (!requested)
+							{
+								tally.stale.fetch_add(1, std::memory_order_relaxed);
+
+								// REWINDBOX_ZCULL_WATCHED_FLUSH_660: a watched slot read final stays watched.
+								if (rpcs3::ios::get_experimental_policy().zcull_watched_flush)
+								{
+									m_ios_watched.refresh(address);
+								}
+							}
+
+							return finish(ios_fault::handled);
+						}
+
+						slots = false; // a page this busy costs less unlocked
+					}
+					else if (slots)
+					{
+						pending_slot = found->second.ios_slots.first_pending(address, access.size);
+
+						// REWINDBOX_ZCULL_READ_LEAD_659: the age of the report this access waits for.
+						if (!lead_taken)
+						{
+							lead_taken = true;
+							if (const u64 lead = found->second.ios_slots.pending_age_us(pending_slot, get_system_time()))
+							{
+								tally.add_lead(lead);
+
+								// REWINDBOX_ZCULL_COST_920: the report this read waits for last.
+								tally.add_newest_lead(found->second.ios_slots.newest_age_us(pending_slot, get_system_time()));
+							}
+
+							// REWINDBOX_ZCULL_WATCHED_FLUSH_660 (ios/IOSZcullWatched.h): this guest waits for the slot; the table
+							// learns it, or drops it, by how long before this read the slot's newest report was queued.
+							if (rpcs3::ios::get_experimental_policy().zcull_watched_flush)
+							{
+								m_ios_watched.learn(pending_slot, found->second.ios_slots.newest_age_us(pending_slot, get_system_time()));
+							}
+						}
+					}
+				}
+
+				if (m_pages_accessed[location] && get_system_time() - started < od::pickup_deadline_us)
+				{
+					// Another access is switching the location to the upstream mode, which
+					// unlocks every page of it: wait for that instead of failing the access.
+					std::this_thread::yield();
+					continue;
+				}
+
+				if (m_pages_accessed[location] || m_ios_demand.tripped())
+				{
+					return finish(ios_fault::upstream);
+				}
+
+				if (!requested)
+				{
+					// Where the guest reached into the page: a GCM label or notify, a GCM report, other memory.
+					const u32 offset = address - rsx::get_current_renderer()->label_addr;
+					(offset < ::offset32(&RsxReports::report) ? tally.faults_label : offset < sizeof(RsxReports) ? tally.faults_report : tally.faults_other)
+						.fetch_add(1, std::memory_order_relaxed);
+
+					// REWINDBOX_ZCULL_FAULT_CENSUS_624: the thread class, and where an "other" fault reached.
+					auto& census = rpcs3::ios::zcull_fault_census::counters();
+					const auto fault_cpu = get_current_cpu_thread();
+					const bool fault_spu = fault_cpu && fault_cpu->get_class() == thread_class::spu;
+					(fault_spu ? census.spu : census.ppu).fetch_add(1, std::memory_order_relaxed);
+
+					if (offset >= sizeof(RsxReports))
+					{
+						census.other_last.store(address, std::memory_order_relaxed);
+						census.other_last_spu.store(fault_spu ? 1u : 0u, std::memory_order_relaxed);
+					}
+				}
+
+				// REWINDBOX_ZCULL_ASYNC_READS_630: ask for this slot, or, as before, for every claimed report.
+				const bool slot_request = slots && get_system_time() - started < od::async_escalate_us;
+
+				// Ask the RSX thread to write every claimed report (sync() through pipe_flush_interrupt).
+				const u64 ticket = slot_request ? m_ios_demand.request_slot(pending_slot) : m_ios_demand.request_full();
+				requested = true;
+				requested_at = get_system_time();
+				picked_at = 0;
+
+				auto thr = rsx::get_current_renderer();
+				thr->m_eng_interrupt_mask |= rsx::pipe_flush_interrupt;
+				rpcs3::ios::rsx_idle_park::wake();
+
+				const auto stopped_now = [&]() { return Emu.IsStopped() || thr->is_stopped(); };
+				const auto clock_now = []() { return get_system_time(); };
+				const auto result = slots
+					? od::wait_for(m_ios_demand, ticket, slot_request ? requested_at : started, slots_released, stopped_now, clock_now, &picked_at)
+					: od::wait_for(m_ios_demand, ticket, started, page_released, stopped_now, clock_now, &picked_at);
+
+				if (result == od::wait_result::served || result == od::wait_result::released)
+				{
+					const u64 t = get_system_time();
+					if (picked_at && picked_at >= requested_at && t >= picked_at)
+					{
+						pickup_sum += picked_at - requested_at;
+						service_sum += t - picked_at;
+						any_picked = true;
+					}
+					else if (t >= requested_at)
+					{
+						pickup_sum += t - requested_at;
+					}
+					halves_at = t;
+				}
+
+				if (result == od::wait_result::stopped)
+				{
+					tally.stops.fetch_add(1, std::memory_order_relaxed);
+					return finish(ios_fault::upstream);
+				}
+
+				if (result == od::wait_result::timed_out)
+				{
+					tally.timeouts.fetch_add(1, std::memory_order_relaxed);
+					const bool picked = m_ios_demand.is_picked(ticket);
+					const bool tripped_now = m_ios_demand.trip(picked ? od::trip_reason::hard : od::trip_reason::pickup);
+					rsx_log.error("ZCULL on-demand read of page 0x%x not %s in %u ms, upstream mode for the rest of this boot.",
+						page_address, picked ? "completed" : "picked up", static_cast<u32>((get_system_time() - started) / 1000));
+					if (tripped_now) ios_log_trip(); // REWINDBOX_ZCULL_DEMAND_GUARD_621
+					return finish(ios_fault::upstream);
+				}
+
+				// REWINDBOX_ZCULL_ASYNC_READS_630: the RSX thread took the slot request and went back to
+				// the FIFO; the GPU has the query. A pause before asking again.
+				if (slot_request && result == od::wait_result::served)
+				{
+					// REWINDBOX_ZCULL_SLOT_WAKE_636: the pause ends early when this slot is released meanwhile.
+					const u64 pause_end = get_system_time() + poll_us;
+
+					for (;;)
+					{
+						const u64 seen = od::slot_releases().epoch();
+
+						if (slots_released())
+						{
+							break;
+						}
+
+						const u64 now = get_system_time();
+
+						if (now >= pause_end || stopped_now())
+						{
+							break;
+						}
+
+						od::slot_releases().wait(seen, pause_end - now);
+					}
+
+					poll_us = std::min(poll_us * 2, od::async_poll_max_us);
+				}
+
+				// served or released: check the page again
+			}
+		}
+#endif
