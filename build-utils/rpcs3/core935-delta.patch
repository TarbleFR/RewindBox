diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Counters.h b/rpcs3/Emu/RSX/Metal/MTLM4Counters.h
new file mode 100644
index 0000000..b946890
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Counters.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): what stage M4 executed, and what it could not execute (counted, logged once, never
+// replaced by a guess). Reported by MTLGSRender::report_counters as the "COREPROF METAL M4" line.
+
+#include "util/types.hpp"
+
+#include <atomic>
+
+namespace mtl
+{
+	struct m4_counters
+	{
+		// ZCULL / occlusion queries (MTLQueries.cpp)
+		std::atomic<u64> queries_begun{0};
+		std::atomic<u64> query_segments{0};          // visibility slots counted (one per query per render encoder)
+		std::atomic<u64> query_results{0};           // results gathered from the GPU
+		std::atomic<u64> query_discards{0};
+		std::atomic<u64> query_hard_syncs{0};        // a result read while its work was still being recorded (VK: hard sync)
+		std::atomic<u64> query_gpu_waits{0};         // a gather that had to wait for the GPU
+		std::atomic<u64> query_hint_flushes{0};      // zcull_sync / conditional render hints that submitted the work
+		std::atomic<u64> query_slot_exhaustions{0};  // the visibility pool was full (ZCULL sync, then exact folding)
+		std::atomic<u64> query_folded_segments{0};
+
+		// MSAA (MTLResolve.cpp)
+		std::atomic<u64> msaa_surfaces{0};
+		std::atomic<u64> resolves{0};
+		std::atomic<u64> unresolves{0};
+		std::atomic<u64> resolve_failures{0};        // no pipeline for the format: not executed, counted
+		std::atomic<u64> msaa_allocation_failures{0};
+		std::atomic<u64> msaa_feedback_direct{0};    // a multisampled attachment sampled in its own pass, no snapshot
+
+		// Conversion kernels (MTLComputeTasks.cpp)
+		std::atomic<u64> compute_dispatches{0};
+		std::atomic<u64> compute_failures{0};        // kernel or pipeline unavailable: not executed, counted
+		std::atomic<u64> typeless_conversions{0};    // VK copy_image_typeless through the kernels (MTLTypelessCopy.cpp)
+		std::atomic<u64> tile_decodes{0};            // tiled guest memory detiled by the tile decoder (VK detile_memory_block)
+
+		// Native overlays (MTLOverlays.cpp)
+		std::atomic<u64> overlay_frames{0};
+		std::atomic<u64> overlay_views{0};
+		std::atomic<u64> overlay_draws{0};
+		std::atomic<u64> overlay_failures{0};        // the overlay pipeline is unavailable: views not drawn, counted
+	};
+
+	m4_counters& get_m4_counters() noexcept;
+
+	// One log line per kind of failure for the whole run; the counters keep counting.
+	enum class m4_failure : u32
+	{
+		query_slots_exhausted,
+		resolve_pipeline,
+		msaa_allocation,
+		compute_library,
+		compute_pipeline,
+		overlay_pipeline,
+		tiling_library,
+		count
+	};
+
+	// True the first time `kind` is reported.
+	bool m4_first_failure(m4_failure kind) noexcept;
+
+	inline void m4_count(std::atomic<u64>& counter, u64 amount = 1) noexcept
+	{
+		counter.fetch_add(amount, std::memory_order_relaxed);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Math.h b/rpcs3/Emu/RSX/Metal/MTLM4Math.h
new file mode 100644
index 0000000..0162fec
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Math.h
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the arithmetic of the M4 GPU kernels, written once and compiled twice.
+//
+// MTL_M4_DUAL_SOURCE(name, code) compiles `code` as C++ in mtl::m4_math (the host unit test calls it) and keeps the
+// very same tokens as text in mtl::m4_source::name, which MTLM4Shaders.h places in the Metal Shading Language
+// libraries the renderer compiles at runtime. Every function is the Vulkan renderer's GLSL on scalars, operator for
+// operator:
+//   - conversion_math: Program/GLSLSnippets/ShuffleBytes.glsl (byte swaps, D24 <-> F32 depth) and the interleave and
+//     e4m12 conversion kernels of VKCompute.h / VKCompute.cpp;
+//   - resolve_math: the coordinate and sample-index math of Program/MSAA/*ResolvePass.glsl and *UnresolvePass.glsl;
+//   - tiling_math: the RSX tile addressing of Program/GLSLSnippets/RSXMemoryTiling.glsl (the tile decoder).
+// Only the two bit casts differ by language (std::bit_cast here, as_type<> in MSL). The code must stay a subset that
+// means the same in C++ and in MSL: 32-bit unsigned/signed integers, float, no vectors, no preprocessor lines.
+// The stringized text loses its line breaks, so the code holds no // comments.
+
+#include <bit>
+#include <cstdint>
+#include <string_view>
+
+#define MTL_M4_DUAL_SOURCE(name, ...) \
+	namespace mtl::m4_math \
+	{ \
+		__VA_ARGS__ \
+	} \
+	namespace mtl::m4_source \
+	{ \
+		inline constexpr std::string_view name = #__VA_ARGS__; \
+	}
+
+namespace mtl::m4_math
+{
+	using uint = std::uint32_t;
+	static_assert(sizeof(float) == 4);
+
+	// floatBitsToUint / uintBitsToFloat
+	inline uint m4_as_uint(float value) { return std::bit_cast<uint>(value); }
+	inline float m4_as_float(uint value) { return std::bit_cast<float>(value); }
+}
+
+namespace mtl::m4_source
+{
+	// The MSL definitions of the two bit casts.
+	inline constexpr std::string_view bit_casts =
+		"inline uint m4_as_uint(float value) { return as_type<uint>(value); }\n"
+		"inline float m4_as_float(uint value) { return as_type<float>(value); }\n";
+}
+
+// ShuffleBytes.glsl macros (bswap_u16, bswap_u32, bswap_u16_u32, d24_to_f32, f32_to_d24, d24f_to_f32, f32_to_d24f,
+// d24x8_to_f32, d24x8_to_d24x8_swapped, f32_to_d24x8_swapped), the gather/scatter work kernels of
+// cs_gather_d24x8 / cs_gather_d32x8 / cs_scatter_d24x8 / cs_scatter_d32x8 (VKCompute.h, VKCompute.cpp) and the e4m12
+// helpers of cs_fconvert_task (unpack_e4m12_pack16, pack_e4m12_pack16), per component.
+MTL_M4_DUAL_SOURCE(conversion_math,
+	inline uint m4_bswap_u16(uint bits) { return (bits & 0xFF) << 8 | (bits & 0xFF00) >> 8 | (bits & 0xFF0000) << 8 | (bits & 0xFF000000) >> 8; }
+	inline uint m4_bswap_u32(uint bits) { return (bits & 0xFF) << 24 | (bits & 0xFF00) << 8 | (bits & 0xFF0000) >> 8 | (bits & 0xFF000000) >> 24; }
+	inline uint m4_bswap_u16_u32(uint bits) { return (bits & 0xFFFF) << 16 | (bits & 0xFFFF0000) >> 16; }
+
+	inline uint m4_d24_to_f32(uint bits) { return m4_as_uint(float(bits) / 16777215.f); }
+	inline uint m4_f32_to_d24(uint bits) { return uint(m4_as_float(bits) * 16777215.f); }
+	inline uint m4_d24f_to_f32(uint bits) { return (bits << 7); }
+	inline uint m4_f32_to_d24f(uint bits) { return (bits >> 7); }
+	inline uint m4_d24x8_to_f32(uint bits) { return m4_d24_to_f32(bits >> 8); }
+	inline uint m4_d24x8_to_d24x8_swapped(uint bits) { return (bits & 0xFF00) | (bits & 0xFF0000) >> 16 | (bits & 0xFF) << 16; }
+	inline uint m4_f32_to_d24x8_swapped(uint bits) { return m4_d24x8_to_d24x8_swapped(m4_f32_to_d24(bits)); }
+
+	inline uint m4_stencil_shift(uint index) { return (index % 4) * 8; }
+	inline uint m4_gather_stencil(uint stencil_word, uint index) { return (stencil_word >> m4_stencil_shift(index)) & 0xFF; }
+	inline uint m4_gather_d24x8(uint depth_word, uint stencil_word, uint index) { return ((depth_word & 0x00FFFFFF) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_gather_d32x8(uint depth_word, uint stencil_word, uint index) { return (m4_f32_to_d24(depth_word) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_gather_d32fx8(uint depth_word, uint stencil_word, uint index) { return (m4_f32_to_d24f(depth_word) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_scatter_d24(uint value) { return (value >> 8); }
+	inline uint m4_scatter_d32(uint value) { return m4_d24_to_f32(value >> 8); }
+	inline uint m4_scatter_d32f(uint value) { return m4_d24f_to_f32(value >> 8); }
+	inline uint m4_scatter_stencil(uint value, uint index) { return (value & 0xFF) << m4_stencil_shift(index); }
+
+	inline uint m4_unpack_e4m12_lo(uint value) { return ((value & 0xFFFF) << 11) + (120 << 23); }
+	inline uint m4_unpack_e4m12_hi(uint value) { return (((value >> 16) & 0xFFFF) << 11) + (120 << 23); }
+	inline uint m4_pack_e4m12_pack16(uint x, uint y) { return (((x - (120 << 23)) >> 11) & 0xFFFF) | (((y - (120 << 23)) >> 11) << 16); }
+)
+
+// Program/MSAA: the resolve passes map each texel of the single-sampled image (the samples side by side) to a pixel
+// and a sample of the multisampled image; the unresolve passes map each sample back. int as in the GLSL (ivec2).
+MTL_M4_DUAL_SOURCE(resolve_math,
+	inline int m4_resolve_source(int resolve_coord, int samples) { return resolve_coord / samples; }
+	inline int m4_resolve_sample_index(int resolve_x, int resolve_y, int samples_x, int samples_y) { return (resolve_x % samples_x) + ((resolve_y % samples_y) * samples_y); }
+	inline int m4_unresolve_target_x(int pixel_x, int sample_id, int samples_x) { return (pixel_x * samples_x) + (sample_id % samples_x); }
+	inline int m4_unresolve_target_y(int pixel_y, int sample_id, int samples_x, int samples_y) { return (pixel_y * samples_y) + (sample_id / samples_x); }
+)
+
+// RSXMemoryTiling.glsl do_memory_op and its CPU port Common/tiled_dma_copy.hpp: the offset from the tile base of the
+// texel at (row, col) of a linear region inside an RSX tile, operator for operator. The bank distribution table
+// { 0, 1, 2, 3, 2, 3, 0, 1, 1, 2, 3, 0, 3, 0, 1, 2 } is written as arithmetic (row r of the table adds the 2-bit reversal
+// of r to the column, modulo 4), so that the code holds no array. m4_detile_source is the decoder's gather: for byte
+// linear_byte of the packed linear image (rows image_pitch bytes apart), the byte of the tiled data (which starts
+// tile_rw_offset bytes after the tile base and is tiled_length bytes long) it comes from: the texel's tiled offset plus
+// the byte's place in the texel, as tiled_dma_copy copies a texel's bytes. ~0u for the bytes tiled_dma_copy does not
+// write (outside the image rows, or a texel whose tiled offset is outside the tile): those stay zero.
+MTL_M4_DUAL_SOURCE(tiling_math,
+	inline uint m4_tile_bank_lookup(uint index)
+	{
+		const uint table_row = (index >> 2) & 3;
+		return ((index & 3) + (((table_row & 1) << 1) | (table_row >> 1))) & 3;
+	}
+
+	inline uint m4_tile_offset(uint row, uint col, uint factor, uint num_tiles_per_row, uint tile_base_address, uint tile_address_offset,
+		uint tile_pitch, uint tile_bank, uint image_bpp)
+	{
+		const uint row_offset = (row * tile_pitch) + tile_base_address + tile_address_offset;
+		const uint this_address = row_offset + (col * image_bpp);
+		const uint texel_offset = (this_address - tile_base_address) / 256;
+		const uint tile_x = texel_offset % num_tiles_per_row;
+		const uint tile_y = (texel_offset / num_tiles_per_row) / 64;
+		const uint tile_id = tile_y * num_tiles_per_row + tile_x;
+		const uint tile_selector = (tile_id + (tile_base_address >> 14)) & 0x3ffff;
+		const uint row_address = (tile_selector >> 2) & 0xffff;
+		uint bank_selector = 0;
+		if (factor == 1)
+		{
+			bank_selector = (tile_selector & 3);
+		}
+		else if (factor == 2)
+		{
+			bank_selector = m4_tile_bank_lookup(((tile_selector + ((tile_y & 1) << 1)) & 3) * 4 + (tile_y & 3));
+		}
+		else if (factor >= 4)
+		{
+			bank_selector = m4_tile_bank_lookup((tile_selector & 3) * 4 + (tile_y & 3));
+		}
+		bank_selector = (bank_selector + tile_bank) & 3;
+		uint column_selector = 0;
+		const uint line_offset_in_tile = (texel_offset / num_tiles_per_row) % 64;
+		column_selector |= ((line_offset_in_tile >> 3) & 0x7) << 7;
+		column_selector |= ((this_address >> 5) & 0x7) << 4;
+		column_selector |= ((line_offset_in_tile >> 0) & 0x3) << 2;
+		const uint partition_selector = (((line_offset_in_tile >> 2) & 1) + ((this_address >> 6) & 1)) & 1;
+		uint tile_address = 0;
+		tile_address |= ((row_address >> 0) & 0xFFFF) << 16;
+		tile_address |= ((bank_selector >> 0) & 0x3) << 14;
+		tile_address |= ((column_selector >> 4) & 0x3F) << 8;
+		tile_address |= ((partition_selector >> 0) & 0x1) << 7;
+		tile_address |= ((column_selector >> 2) & 0x3) << 5;
+		tile_address |= ((this_address >> 0) & 0x1F) << 0;
+		tile_address ^= (((tile_address >> 12) ^ ((bank_selector ^ tile_selector) & 1) ^ (tile_address >> 14)) & 1) << 9;
+		tile_address ^= ((tile_address >> 11) & 1) << 10;
+		return tile_address - tile_base_address;
+	}
+
+	inline uint m4_detile_source(uint linear_byte, uint factor, uint num_tiles_per_row, uint tile_base_address, uint tile_size,
+		uint tile_address_offset, uint tile_rw_offset, uint tile_pitch, uint tile_bank, uint image_width, uint image_height,
+		uint image_pitch, uint image_bpp, uint tiled_length)
+	{
+		const uint row = linear_byte / image_pitch;
+		const uint in_row = linear_byte % image_pitch;
+		if (row >= image_height || in_row >= image_width * image_bpp)
+		{
+			return 0xFFFFFFFFu;
+		}
+		const uint tile_base_offset = m4_tile_offset(row, in_row / image_bpp, factor, num_tiles_per_row, tile_base_address, tile_address_offset,
+			tile_pitch, tile_bank, image_bpp);
+		if (tile_base_offset >= tile_size || tile_base_offset < tile_rw_offset)
+		{
+			return 0xFFFFFFFFu;
+		}
+		const uint source = tile_base_offset - tile_rw_offset + (in_row % image_bpp);
+		return (source < tiled_length) ? source : 0xFFFFFFFFu;
+	}
+)
+
+// MSAA configuration (C++ only).
+namespace mtl::msaa
+{
+	// samples_x, samples_y of a sample count: rsx::surface_descriptor::set_spp and VK depth_resolve_base::
+	// update_sample_configuration (2 samples side by side, 4 samples as 2x2). {0, 0} for a count the RSX has not.
+	struct sample_grid
+	{
+		std::uint32_t x = 0;
+		std::uint32_t y = 0;
+	};
+
+	constexpr sample_grid grid_for(std::uint32_t samples)
+	{
+		switch (samples)
+		{
+		case 1: return { 1, 1 };
+		case 2: return { 2, 1 };
+		case 4: return { 2, 2 };
+		default: return { 0, 0 };
+		}
+	}
+
+	// VKRenderTargets.h create_new_surface: a surface has the AA mode's sample count (get_format_sample_count) at the
+	// "Auto" MSAA level, and one sample otherwise.
+	constexpr std::uint32_t host_samples(bool msaa_auto, std::uint32_t rsx_samples)
+	{
+		return msaa_auto ? rsx_samples : 1;
+	}
+
+	// The sample mask a pipeline applies (Vulkan pSampleMask = the RSX mask, for more than one sample), restricted to the
+	// samples that exist; all_samples when it masks nothing (no shader sample mask output is then needed).
+	constexpr std::uint32_t all_samples = 0xffffffffu;
+
+	constexpr std::uint32_t pipeline_sample_mask(std::uint32_t samples, std::uint32_t rsx_mask)
+	{
+		if (samples <= 1 || samples >= 32)
+		{
+			return all_samples;
+		}
+
+		const std::uint32_t existing = (1u << samples) - 1;
+		return ((rsx_mask & existing) == existing) ? all_samples : (rsx_mask & existing);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Renderer.cpp b/rpcs3/Emu/RSX/Metal/MTLM4Renderer.cpp
new file mode 100644
index 0000000..94573e6
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Renderer.cpp
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): the stage M4 parts of the native Metal 4 renderer's lifetime: creation and release of the
+// query buffer, MSAA resolve passes, conversion kernels and overlay renderer, the overlay views of each presented frame,
+// and the COREPROF METAL M4 counters.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/Overlays/overlay_manager.h"
+#include "Emu/system_config.h"
+#include "Emu/system_utils.hpp"
+
+#include <array>
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		std::array<std::atomic<bool>, static_cast<usz>(m4_failure::count)> g_reported_failures{};
+	}
+
+	m4_counters& get_m4_counters() noexcept
+	{
+		static m4_counters s_counters;
+		return s_counters;
+	}
+
+	bool m4_first_failure(m4_failure kind) noexcept
+	{
+		return !g_reported_failures[static_cast<usz>(kind)].exchange(true, std::memory_order_relaxed);
+	}
+}
+
+void MTLGSRender::init_m4_config()
+{
+	// As the Vulkan renderer when MSAA is not disabled: multisampling, alpha to coverage (also at one sample) and alpha to
+	// one (MoltenVK reports it) are the GPU's. Surfaces are multisampled at the "Auto" level (MTLRenderTargets.cpp).
+	const bool msaa_enabled = g_cfg.video.antialiasing_level != msaa_level::none;
+	backend_config.supports_hw_msaa = msaa_enabled;
+	backend_config.supports_hw_a2c = msaa_enabled;
+	backend_config.supports_hw_a2c_1spp = msaa_enabled;
+	backend_config.supports_hw_a2one = msaa_enabled;
+
+	// The native interface (message, save data, trophy and OSK dialogs, notices, the performance overlay). rsx::thread
+	// creates its display manager for the OpenGL and Vulkan renderers only (with the same boot music); the Metal renderer
+	// draws it as well.
+	if (g_cfg.misc.use_native_interface && !m_overlay_manager)
+	{
+		m_overlay_manager = g_fxo->init<rsx::overlays::display_manager>(0);
+		if (!m_overlay_manager)
+		{
+			m_overlay_manager = g_fxo->try_get<rsx::overlays::display_manager>();
+		}
+		else if (g_cfg.misc.play_music_during_boot)
+		{
+			if (const std::string audio_path = rpcs3::utils::get_game_content_path(game_content_type::content_sound); !audio_path.empty())
+			{
+				m_overlay_manager->start_audio(audio_path);
+			}
+		}
+	}
+}
+
+void MTLGSRender::init_m4()
+{
+	init_queries();
+
+	std::string error;
+	if (m_resolver.create(m_commands, m_compiler, error))
+	{
+		mtl::set_msaa_resolver(&m_resolver);
+	}
+	else if (mtl::m4_first_failure(mtl::m4_failure::resolve_pipeline))
+	{
+		// Every resolve or unresolve is then counted as not executed (resolve_failures).
+		rsx_log.error("Metal M4: the MSAA resolve library is unavailable: %s (counted in COREPROF METAL M4)", error);
+	}
+
+	error.clear();
+	const auto write_params = [this](const void* data, u32 size) -> std::pair<mtl::object, u64>
+	{
+		auto& ring = m_rings[ring_push_constants];
+		const usz offset = ring.alloc<32>(size);
+		std::memcpy(ring.map(offset), data, size);
+		return { ring.buffer, offset };
+	};
+
+	if (m_compute_tasks.create(m_device, m_compiler, write_params, error))
+	{
+		mtl::set_compute_tasks(&m_compute_tasks);
+	}
+	else
+	{
+		rsx_log.error("Metal M4: the conversion kernels are unavailable: %s (every task is counted as not executed)", error);
+	}
+
+	if (m_overlay_manager)
+	{
+		error.clear();
+		if (!m_overlay_renderer.create(m_device, m_compiler, !g_cfg.video.disable_msl_fast_math, error) &&
+			mtl::m4_first_failure(mtl::m4_failure::overlay_pipeline))
+		{
+			// The views are then counted and not drawn (overlay_failures); the guest's dialogs keep working.
+			rsx_log.error("Metal M4: the overlay pipeline is unavailable: %s (counted in COREPROF METAL M4)", error);
+		}
+	}
+
+	rsx_log.notice("Metal 4 renderer M4: occlusion queries (%u visibility slots), MSAA %s (resolve passes %s), conversion kernels %s, overlays %s",
+		query_slot_count, backend_config.supports_hw_msaa ? "on" : "off", m_resolver.ready() ? "ready" : "unavailable",
+		m_compute_tasks.ready() ? "ready" : "unavailable", m_overlay_manager ? (m_overlay_renderer.ready() ? "ready" : "unavailable") : "off");
+}
+
+void MTLGSRender::destroy_m4()
+{
+	m_overlay_renderer.destroy(m_commands);
+
+	mtl::set_compute_tasks(nullptr);
+	m_compute_tasks.destroy();
+
+	mtl::set_msaa_resolver(nullptr);
+	m_resolver.destroy(m_commands);
+
+	destroy_queries();
+}
+
+void MTLGSRender::prepare_overlays(const areau& image_area)
+{
+	m_overlay_renderer.clear_prepared();
+
+	if (!m_overlay_manager)
+	{
+		return;
+	}
+
+	// VKGSRender frame cleanup: the images of the overlays that were closed
+	if (m_overlay_manager->has_dirty())
+	{
+		m_overlay_manager->lock_shared();
+
+		std::vector<u32> uids_to_dispose;
+		uids_to_dispose.reserve(m_overlay_manager->get_dirty().size());
+
+		for (const auto& view : m_overlay_manager->get_dirty())
+		{
+			m_overlay_renderer.remove_temp_resources(m_commands, view->uid);
+			uids_to_dispose.push_back(view->uid);
+		}
+
+		m_overlay_manager->unlock_shared();
+		m_overlay_manager->dispose(uids_to_dispose);
+	}
+
+	if (!m_overlay_manager->has_visible())
+	{
+		return;
+	}
+
+	// VKGSRender render_overlays: window-space views cover the drawable, the others the presented image.
+	std::lock_guard lock(*m_overlay_manager);
+
+	const areau display_area = { 0, 0, m_drawable_width, m_drawable_height };
+	for (const auto& view : m_overlay_manager->get_views())
+	{
+		const areau render_area = view->use_window_space ? display_area : image_area;
+		m_overlay_renderer.prepare(m_commands, m_rings[ring_attrib], render_area, m_drawable_width, m_drawable_height, *view.get());
+	}
+
+	mtl::m4_count(mtl::get_m4_counters().overlay_frames);
+}
+
+void MTLGSRender::report_m4_counters()
+{
+	const auto& m = mtl::get_m4_counters();
+	const auto load = [](const std::atomic<u64>& value) { return value.load(std::memory_order_relaxed); };
+
+	rsx_log.notice("COREPROF METAL M4 queries=%llu segments=%llu results=%llu discards=%llu hard_syncs=%llu gpu_waits=%llu hint_flushes=%llu "
+		"slot_exhaustions=%llu folded=%llu slots_free=%u slots_pending=%u | msaa_surfaces=%llu resolves=%llu unresolves=%llu "
+		"resolve_failures=%llu msaa_alloc_failures=%llu msaa_feedback_direct=%llu | compute=%llu compute_failures=%llu typeless_conversions=%llu tile_decodes=%llu | overlay_frames=%llu overlay_views=%llu "
+		"overlay_draws=%llu overlay_failures=%llu",
+		load(m.queries_begun), load(m.query_segments), load(m.query_results), load(m.query_discards), load(m.query_hard_syncs),
+		load(m.query_gpu_waits), load(m.query_hint_flushes), load(m.query_slot_exhaustions), load(m.query_folded_segments),
+		m_query_slots.available(), m_query_slots.pending(),
+		load(m.msaa_surfaces), load(m.resolves), load(m.unresolves), load(m.resolve_failures), load(m.msaa_allocation_failures), load(m.msaa_feedback_direct),
+		load(m.compute_dispatches), load(m.compute_failures), load(m.typeless_conversions), load(m.tile_decodes),
+		load(m.overlay_frames), load(m.overlay_views), load(m.overlay_draws), load(m.overlay_failures));
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Shaders.h b/rpcs3/Emu/RSX/Metal/MTLM4Shaders.h
new file mode 100644
index 0000000..9ae45eb
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Shaders.h
@@ -0,0 +1,379 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the Metal Shading Language libraries of stage M4, compiled at runtime by the MTL4
+// compiler (MTLComputeTasks.cpp, MTLResolve.cpp). Header-only and free of renderer dependencies, so a host tool can
+// write them out for Apple's offline compiler (xcrun metal) and the host unit test can check their text.
+//
+// The arithmetic is MTLM4Math.h (the same tokens the unit test runs as C++). The kernels add what Vulkan gets from the
+// descriptor: every storage-buffer access is bounded by the bound range (`words`), as the Vulkan renderer's robust
+// buffer access bounds it; inside the range each kernel reads and writes exactly what the GLSL kernel does.
+
+#include "MTLM4Math.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+
+namespace mtl::m4_shaders
+{
+	constexpr std::string_view prelude =
+		"#include <metal_stdlib>\n"
+		"using namespace metal;\n\n";
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// Conversion kernels (VKCompute.h). Buffer 0: the data (uint words, bound at the task's data offset), buffer 1: the
+	// parameters, uint4 as the Vulkan push constants params[0] plus the bound length in words:
+	//   shuffles:    x = word count (data_length / 4), w = word count
+	//   interleave:  x = data_length (bytes), y = zeta offset (bytes), z = stencil offset (bytes), w = bound words
+	//   fconvert:    x = source length (bytes), y = source offset, z = destination offset (bytes), w = bound words
+	// The invocation index is ShuffleBytes.glsl linear_invocation_id() with KERNEL_SIZE 1 (MoltenVK's optimal kernel size).
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view compute_kernels = R"(
+inline uint m4_linear_invocation_id(uint3 global_id, uint3 grid_size)
+{
+	return (global_id.y * grid_size.x) + global_id.x;
+}
+
+inline uint m4_load(device uint* data, uint words, uint index)
+{
+	return (index < words) ? data[index] : 0u;
+}
+
+inline void m4_store(device uint* data, uint words, uint index, uint value)
+{
+	if (index < words)
+	{
+		data[index] = value;
+	}
+}
+
+inline void m4_atomic_or(device uint* data, uint words, uint index, uint value)
+{
+	if (index < words)
+	{
+		atomic_fetch_or_explicit((device atomic_uint*)(data + index), value, memory_order_relaxed);
+	}
+}
+
+#define M4_KERNEL_ARGS device uint* data [[buffer(0)]], constant uint4& params [[buffer(1)]], uint3 global_id [[thread_position_in_grid]], uint3 grid_size [[threads_per_grid]]
+
+// cs_shuffle_16, cs_shuffle_32, cs_shuffle_32_16, cs_shuffle_d24x8_f32, cs_shuffle_se_f32_d24x8, cs_shuffle_se_d24x8:
+// value = data[index]; data[index] = f(value);
+#define M4_SHUFFLE_KERNEL(name, function) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= params.x) return; \
+	const uint value = m4_load(data, params.w, index); \
+	m4_store(data, params.w, index, function(value)); \
+}
+
+M4_SHUFFLE_KERNEL(m4_bswap_u16_kernel, m4_bswap_u16)
+M4_SHUFFLE_KERNEL(m4_bswap_u32_kernel, m4_bswap_u32)
+M4_SHUFFLE_KERNEL(m4_bswap_u16_u32_kernel, m4_bswap_u16_u32)
+M4_SHUFFLE_KERNEL(m4_d24x8_to_f32_kernel, m4_d24x8_to_f32)
+M4_SHUFFLE_KERNEL(m4_f32_to_d24x8_swapped_kernel, m4_f32_to_d24x8_swapped)
+M4_SHUFFLE_KERNEL(m4_d24x8_to_d24x8_swapped_kernel, m4_d24x8_to_d24x8_swapped)
+
+inline uint m4_identity(uint value)
+{
+	return value;
+}
+
+// cs_gather_d24x8<_SwapBytes>, cs_gather_d32x8<_SwapBytes, _DepthFloat>
+#define M4_GATHER_KERNEL(name, combine, store_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint z_offset = params.y >> 2; \
+	const uint s_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint depth_word = m4_load(data, params.w, index + z_offset); \
+	const uint stencil_word = m4_load(data, params.w, (index / 4) + s_offset); \
+	m4_store(data, params.w, index, store_transform(combine(depth_word, stencil_word, index))); \
+}
+
+M4_GATHER_KERNEL(m4_gather_d24x8_kernel, m4_gather_d24x8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d24x8_swapped_kernel, m4_gather_d24x8, m4_bswap_u32)
+M4_GATHER_KERNEL(m4_gather_d32x8_kernel, m4_gather_d32x8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d32x8_swapped_kernel, m4_gather_d32x8, m4_bswap_u32)
+M4_GATHER_KERNEL(m4_gather_d32fx8_kernel, m4_gather_d32fx8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d32fx8_swapped_kernel, m4_gather_d32fx8, m4_bswap_u32)
+
+// cs_scatter_d24x8, cs_scatter_d32x8<_DepthFloat>: the stencil words are expected cleared (atomicOr), as in Vulkan.
+#define M4_SCATTER_KERNEL(name, depth_function) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint z_offset = params.y >> 2; \
+	const uint s_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint value = m4_load(data, params.w, index); \
+	m4_store(data, params.w, index + z_offset, depth_function(value)); \
+	m4_atomic_or(data, params.w, (index / 4) + s_offset, m4_scatter_stencil(value, index)); \
+}
+
+M4_SCATTER_KERNEL(m4_scatter_d24x8_kernel, m4_scatter_d24)
+M4_SCATTER_KERNEL(m4_scatter_d32x8_kernel, m4_scatter_d32)
+M4_SCATTER_KERNEL(m4_scatter_d32fx8_kernel, m4_scatter_d32f)
+
+// cs_fconvert_task<f32, f16, _SwapSrc, _SwapDst>: two source words make one destination word.
+#define M4_CONTRACT_KERNEL(name, source_transform, destination_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint in_offset = params.y >> 2; \
+	const uint out_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint src_offset = (index * 2) + in_offset; \
+	const uint dst_offset = index + out_offset; \
+	const uint x = source_transform(m4_load(data, params.w, src_offset)); \
+	const uint y = source_transform(m4_load(data, params.w, src_offset + 1)); \
+	m4_store(data, params.w, dst_offset, destination_transform(m4_pack_e4m12_pack16(x, y))); \
+}
+
+M4_CONTRACT_KERNEL(m4_f32_to_f16_kernel, m4_identity, m4_identity)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_src_kernel, m4_bswap_u32, m4_identity)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_dst_kernel, m4_identity, m4_bswap_u16)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_both_kernel, m4_bswap_u32, m4_bswap_u16)
+
+// cs_fconvert_task<f16, f32, _SwapSrc, _SwapDst>: one source word makes two destination words.
+#define M4_EXPAND_KERNEL(name, source_transform, destination_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint in_offset = params.y >> 2; \
+	const uint out_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint src_offset = index + in_offset; \
+	const uint dst_offset = (index * 2) + out_offset; \
+	const uint x = source_transform(m4_load(data, params.w, src_offset)); \
+	m4_store(data, params.w, dst_offset, destination_transform(m4_unpack_e4m12_lo(x))); \
+	m4_store(data, params.w, dst_offset + 1, destination_transform(m4_unpack_e4m12_hi(x))); \
+}
+
+M4_EXPAND_KERNEL(m4_f16_to_f32_kernel, m4_identity, m4_identity)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_src_kernel, m4_bswap_u16, m4_identity)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_dst_kernel, m4_identity, m4_bswap_u32)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_both_kernel, m4_bswap_u16, m4_bswap_u32)
+)";
+
+	// The kernels, in mtl::compute_kernel order (MTLComputeTasks.h).
+	constexpr std::array<std::string_view, 23> compute_kernel_names =
+	{
+		"m4_bswap_u16_kernel",
+		"m4_bswap_u32_kernel",
+		"m4_bswap_u16_u32_kernel",
+		"m4_d24x8_to_f32_kernel",
+		"m4_f32_to_d24x8_swapped_kernel",
+		"m4_d24x8_to_d24x8_swapped_kernel",
+		"m4_gather_d24x8_kernel",
+		"m4_gather_d24x8_swapped_kernel",
+		"m4_gather_d32x8_kernel",
+		"m4_gather_d32x8_swapped_kernel",
+		"m4_gather_d32fx8_kernel",
+		"m4_gather_d32fx8_swapped_kernel",
+		"m4_scatter_d24x8_kernel",
+		"m4_scatter_d32x8_kernel",
+		"m4_scatter_d32fx8_kernel",
+		"m4_f32_to_f16_kernel",
+		"m4_f32_to_f16_swap_src_kernel",
+		"m4_f32_to_f16_swap_dst_kernel",
+		"m4_f32_to_f16_swap_both_kernel",
+		"m4_f16_to_f32_kernel",
+		"m4_f16_to_f32_swap_src_kernel",
+		"m4_f16_to_f32_swap_dst_kernel",
+		"m4_f16_to_f32_swap_both_kernel",
+	};
+
+	inline std::string compute_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::bit_casts;
+		source += m4_source::conversion_math;
+		source += "\n";
+		source += compute_kernels;
+		return source;
+	}
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// RSX tile decoder (VKCompute.h cs_tile_memcpy<decode>, Program/GLSLSnippets/RSXMemoryTiling.glsl; its CPU port is
+	// Common/tiled_dma_copy.hpp). Its own library, so that the conversion kernels never depend on it. Buffer 0: the data
+	// (uint words, bound at the task's data offset) holding the tiled bytes and the linear output; buffer 1: the 16
+	// parameter words of mtl::tile_decode_params (MTLComputeTasks.h). One invocation per word of the packed linear image:
+	// each of its bytes comes from its texel's tiled address (MTLM4Math.h m4_detile_source), so every texel size and row
+	// length decodes whole (the GLSL kernel decodes 4 / bpp texels per invocation by read-modify-write of shared words,
+	// from its first column), and the bytes tiled_dma_copy does not write are zero, as in the CPU decoder's buffer.
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view tiling_kernels = R"(
+inline uint m4_tiling_invocation_id(uint3 global_id, uint3 grid_size)
+{
+	return (global_id.y * grid_size.x) + global_id.x;
+}
+
+kernel void m4_tile_decode_kernel(device uint* data [[buffer(0)]], constant uint* params [[buffer(1)]],
+	uint3 global_id [[thread_position_in_grid]], uint3 grid_size [[threads_per_grid]])
+{
+	const uint word = m4_tiling_invocation_id(global_id, grid_size);
+	if (word >= params[15])
+	{
+		return;
+	}
+
+	uint value = 0;
+	for (uint byte_index = 0; byte_index < 4; ++byte_index)
+	{
+		const uint source = m4_detile_source((word * 4) + byte_index, params[0], params[1], params[2], params[3], params[4], params[5],
+			params[6], params[7], params[8], params[9], params[10], params[11], params[13]);
+		if (source != 0xFFFFFFFFu)
+		{
+			const uint index = params[12] + source;
+			value |= ((data[index >> 2] >> ((index & 3) * 8)) & 0xFF) << (byte_index * 8);
+		}
+	}
+
+	data[(params[14] >> 2) + word] = value;
+}
+)";
+
+	constexpr std::string_view tile_decode_kernel_name = "m4_tile_decode_kernel";
+
+	inline std::string tiling_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::tiling_math;
+		source += "\n";
+		source += tiling_kernels;
+		return source;
+	}
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// MSAA resolve and unresolve passes (VKResolveHelper, Program/MSAA). Every pass draws the 4-vertex strip of
+	// GenericVSPassthrough.glsl over the whole target; buffer 0 holds the Vulkan push constants (int2 sample_count).
+	// Resolve: each texel of the single-sampled image takes one sample of the multisampled image. Unresolve: each sample
+	// (the pass runs per sample through [[sample_id]], as the Vulkan pass at sample shading rate 1) takes one texel back.
+	// Colour passes are render passes here (Metal has no multisampled storage images): same coordinates, same samples.
+	// Depth and stencil go through the fragment depth and stencil exports (the _EXT passes; Apple GPUs export stencil).
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view resolve_passes = R"(
+struct m4_resolve_params
+{
+	int2 sample_count;
+	int stencil_mask;
+	int reserved;
+};
+
+struct m4_fullscreen_vertex
+{
+	float4 position [[position]];
+};
+
+constant float2 m4_passthrough_positions[4] = { float2(-1., -1.), float2(1., -1.), float2(-1., 1.), float2(1., 1.) };
+
+vertex m4_fullscreen_vertex m4_resolve_vertex(uint vertex_id [[vertex_id]])
+{
+	m4_fullscreen_vertex out;
+	out.position = float4(m4_passthrough_positions[vertex_id % 4], 0., 1.);
+	return out;
+}
+
+struct m4_depth_output
+{
+	float depth [[depth(any)]];
+};
+
+struct m4_depth_stencil_output
+{
+	float depth [[depth(any)]];
+	uint stencil [[stencil]];
+};
+
+inline uint2 m4_resolve_pixel(float4 position, int2 samples)
+{
+	const int2 out_coord = int2(position.xy);
+	return uint2(m4_resolve_source(out_coord.x, samples.x), m4_resolve_source(out_coord.y, samples.y));
+}
+
+inline uint m4_resolve_sample(float4 position, int2 samples)
+{
+	const int2 out_coord = int2(position.xy);
+	return uint(m4_resolve_sample_index(out_coord.x, out_coord.y, samples.x, samples.y));
+}
+
+inline uint2 m4_unresolve_texel(float4 position, uint sample_id, int2 samples)
+{
+	const int2 pixel_coord = int2(position.xy);
+	return uint2(m4_unresolve_target_x(pixel_coord.x, int(sample_id), samples.x),
+		m4_unresolve_target_y(pixel_coord.y, int(sample_id), samples.x, samples.y));
+}
+
+// ColorResolvePass.glsl
+fragment float4 m4_color_resolve(float4 position [[position]], texture2d_ms<float, access::read> multisampled [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	return multisampled.read(m4_resolve_pixel(position, params.sample_count), m4_resolve_sample(position, params.sample_count));
+}
+
+// ColorUnresolvePass.glsl
+fragment float4 m4_color_unresolve(float4 position [[position]], uint sample_id [[sample_id]], texture2d<float, access::read> resolve [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	return resolve.read(m4_unresolve_texel(position, sample_id, params.sample_count));
+}
+
+// DepthResolvePass.glsl
+fragment m4_depth_output m4_depth_resolve(float4 position [[position]], depth2d_ms<float, access::read> fs0 [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	m4_depth_output out;
+	out.depth = fs0.read(m4_resolve_pixel(position, params.sample_count), m4_resolve_sample(position, params.sample_count));
+	return out;
+}
+
+// DepthUnresolvePass.glsl
+fragment m4_depth_output m4_depth_unresolve(float4 position [[position]], uint sample_id [[sample_id]], depth2d<float, access::read> fs0 [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	m4_depth_output out;
+	out.depth = fs0.read(m4_unresolve_texel(position, sample_id, params.sample_count));
+	return out;
+}
+
+// DepthStencilResolvePass.glsl
+fragment m4_depth_stencil_output m4_depth_stencil_resolve(float4 position [[position]], depth2d_ms<float, access::read> fs0 [[texture(0)]],
+	texture2d_ms<uint, access::read> fs1 [[texture(1)]], constant m4_resolve_params& params [[buffer(0)]])
+{
+	const uint2 in_coord = m4_resolve_pixel(position, params.sample_count);
+	const uint sample_index = m4_resolve_sample(position, params.sample_count);
+	m4_depth_stencil_output out;
+	out.depth = fs0.read(in_coord, sample_index);
+	out.stencil = fs1.read(in_coord, sample_index).x;
+	return out;
+}
+
+// DepthStencilUnresolvePass.glsl
+fragment m4_depth_stencil_output m4_depth_stencil_unresolve(float4 position [[position]], uint sample_id [[sample_id]],
+	depth2d<float, access::read> fs0 [[texture(0)]], texture2d<uint, access::read> fs1 [[texture(1)]], constant m4_resolve_params& params [[buffer(0)]])
+{
+	const uint2 pixel_coord = m4_unresolve_texel(position, sample_id, params.sample_count);
+	m4_depth_stencil_output out;
+	out.depth = fs0.read(pixel_coord);
+	out.stencil = fs1.read(pixel_coord).x;
+	return out;
+}
+)";
+
+	inline std::string resolve_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::resolve_math;
+		source += "\n";
+		source += resolve_passes;
+		return source;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp b/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp
new file mode 100644
index 0000000..9e0b043
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M5): the renderer side of the shader and pipeline caches (MTLPipelineCache.h): the RSX
+// program cache on disk (rsx::shaders_cache, as VKGSRender) with its boot precompile, and the Metal 4 pipeline archive.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/rsx_cache.h"
+#include "Emu/RSX/Overlays/Shaders/shader_loading_dialog_native.h"
+#include "Emu/cache_utils.hpp"
+#include "Emu/system_config.h"
+
+namespace
+{
+	// The title's Metal cache directory (trailing separator); empty when the on-disk shader cache is off.
+	std::string metal_cache_directory()
+	{
+		if (g_cfg.video.disable_on_disk_shader_cache)
+		{
+			return {};
+		}
+
+		std::string path = rpcs3::cache::get_ppu_cache();
+		if (path.empty())
+		{
+			return {};
+		}
+		return path + std::string(mtl::pipeline_cache::program_cache_directory);
+	}
+}
+
+void MTLGSRender::open_pipeline_archive()
+{
+	// Before the compiler exists: the compiler captures into the archive's serializer.
+	mtl::pipeline_cache::archive_identity identity;
+	identity.device = m_device_info.name;
+	identity.system = mtl::system_version();
+	m_metal_cache_directory = metal_cache_directory();
+	m_pipeline_archive.open(m_device, m_metal_cache_directory, identity);
+}
+
+void MTLGSRender::create_program_cache()
+{
+	// VKGSRender: rsx::shaders_cache over the program cache, in Metal's own directory with Metal's record version.
+	m_shaders_cache = std::make_unique<shader_cache>(*m_prog_buffer, std::string(mtl::pipeline_cache::program_cache_class),
+		mtl::pipeline_cache::program_cache_version(sizeof(mtl::pipeline_props)), mtl::pipeline_cache::program_cache_directory);
+}
+
+void MTLGSRender::store_program(const mtl::pipeline_props& props, const RSXVertexProgram& vp, const RSXFragmentProgram& fp)
+{
+	// VKGSRender's program cache callback: the program was linked; the record is written by the cache's writer thread.
+	if (m_shaders_cache)
+	{
+		m_shaders_cache->store(props, vp, fp);
+	}
+}
+
+void MTLGSRender::load_program_cache()
+{
+	// VKGSRender::on_init_thread: every record of earlier sessions is built before the first draw, with the native
+	// interface's progress dialog (or the host's, the frame hidden meanwhile).
+	if (!m_shaders_cache)
+	{
+		return;
+	}
+
+	m_pipeline_archive.begin_boot();
+	mtl::set_pipeline_build_origin(mtl::pipeline_build_origin::boot);
+	if (!m_overlay_manager)
+	{
+		m_frame->hide();
+		m_shaders_cache->load(nullptr);
+		m_frame->show();
+	}
+	else
+	{
+		rsx::shader_loading_dialog_native dlg(this);
+		m_shaders_cache->load(&dlg);
+	}
+	mtl::set_pipeline_build_origin(mtl::pipeline_build_origin::draw);
+
+	// What the boot compiled is checkpointed now, by the worker (the Vulkan renderer's NEOSTATION_BUILD266 checkpoint),
+	// unless the emulation stopped during the precompile.
+	m_pipeline_archive.end_boot(!Emu.IsStopped());
+}
+
+void MTLGSRender::close_pipeline_caches()
+{
+	// VKGSRender::on_exit: every record the draws queued reaches disk; then the last archive checkpoint (no pipeline is
+	// built after this point).
+	if (m_shaders_cache)
+	{
+		m_shaders_cache->flush_pending_writes();
+		m_shaders_cache.reset();
+	}
+	m_pipeline_archive.close();
+}
+
+void MTLGSRender::report_m5_counters()
+{
+	const auto load = [](const std::atomic<u64>& value) { return static_cast<unsigned long long>(value.load(std::memory_order_relaxed)); };
+	const auto& p = mtl::get_pipeline_counters();
+	const auto& a = mtl::get_pipeline_archive_counters();
+	const auto& c = mtl::get_pipeline_cache_counters();
+	rsx_log.notice("COREPROF METAL M5 program_cache=%s boot_pipelines=%llu draw_pipelines=%llu archive=%s archive_hits=%llu archive_misses=%llu "
+		"archive_uncaptured=%llu archive_rejected=%llu checkpoints=%llu checkpoint_bytes=%llu checkpoint_failures=%llu archive_unavailable=%llu",
+		m_metal_cache_directory.empty() ? "off" : "on", load(p.boot_pipelines), load(p.draw_pipelines), m_pipeline_archive.state_name(), load(a.hits), load(a.misses),
+		load(a.uncaptured), load(c.rejections), load(c.checkpoints), load(c.checkpoint_bytes), load(c.checkpoint_failures), load(c.unavailable));
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h b/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h
new file mode 100644
index 0000000..2449a50
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the GLSL of the native overlay pipeline (MTLOverlays.h) and its resource contract, for the
+// renderer and for the shader stack host test (GLSL -> SPIR-V -> MSL on the host, then Apple's offline compiler).
+//
+// The sources are the Vulkan renderer's (Program/GLSLSnippets/OverlayRenderVS.glsl, OverlayRenderFS.glsl) with its own
+// replacements (VKOverlays.cpp ui_overlay_renderer::ui_overlay_renderer), then the Metal resource adaptation: the vertex
+// attribute becomes the same 16-byte vertex read from a storage buffer at gl_VertexIndex, the fragment textures move to
+// the fragment descriptor set (MTLShaderTranslator slot contract). Nothing else changes.
+
+#include "MTLCommonDecompiler.h"
+
+#include "Utilities/StrFmt.h"
+#include "Utilities/StrUtil.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace mtl::overlay_shaders
+{
+	constexpr u32 vertex_push_constants_size = 68;    // VK ui_overlay_renderer::vertex_push_constants_size
+	constexpr u32 fragment_push_constants_size = 60;  // VK ui_overlay_renderer::fragment_push_constants_size
+	constexpr u32 push_constants_size = vertex_push_constants_size + fragment_push_constants_size;
+
+	inline constexpr std::string_view vertex_source =
+#include "Emu/RSX/Program/GLSLSnippets/OverlayRenderVS.glsl"
+		;
+
+	inline constexpr std::string_view fragment_source =
+#include "Emu/RSX/Program/GLSLSnippets/OverlayRenderFS.glsl"
+		;
+
+	// The Metal resource adaptation: exact declarations, each expected exactly once.
+	inline constexpr std::string_view vertex_attribute = "layout(location=0) in vec4 in_pos;";
+	inline constexpr std::string_view vertex_storage =
+		"layout(set=0, binding=0, std430) readonly buffer OverlayVertices { vec4 overlay_vertices[]; };\n"
+		"#define in_pos overlay_vertices[gl_VertexIndex]";
+	inline constexpr std::string_view fragment_texture_2d = "layout(set=0, binding=0) uniform sampler2D fs0;";
+	inline constexpr std::string_view fragment_texture_2d_metal = "layout(set=1, binding=0) uniform sampler2D fs0;";
+	inline constexpr std::string_view fragment_texture_array = "layout(set=0, binding=1) uniform sampler2DArray fs1;";
+	inline constexpr std::string_view fragment_texture_array_metal = "layout(set=1, binding=1) uniform sampler2DArray fs1;";
+
+	inline bool replace_once(std::string& text, std::string_view from, std::string_view to, std::string& error)
+	{
+		const usz position = text.find(from);
+		if (position == std::string::npos || text.find(from, position + 1) != std::string::npos)
+		{
+			error = fmt::format("the overlay shader source does not declare '%s' exactly once", from);
+			return false;
+		}
+
+		text.replace(position, from.size(), to);
+		return true;
+	}
+
+	// Empty with `error` set when a source no longer has the declarations the adaptation expects.
+	inline std::string vertex_glsl(std::string& error)
+	{
+		std::string source = fmt::replace_all(std::string(vertex_source),
+		{
+			{ "%preprocessor", "// %preprocessor" },
+			{ "%push_block", "push_constant" }
+		});
+
+		if (!replace_once(source, vertex_attribute, vertex_storage, error))
+		{
+			return {};
+		}
+		return source;
+	}
+
+	inline std::string fragment_glsl(std::string& error)
+	{
+		std::string source = fmt::replace_all(std::string(fragment_source),
+		{
+			{ "%preprocessor", "// %preprocessor" },
+			{ "%push_block_offset", "layout(offset=68)" },
+			{ "%push_block", "push_constant" }
+		});
+
+		if (!replace_once(source, fragment_texture_2d, fragment_texture_2d_metal, error) ||
+			!replace_once(source, fragment_texture_array, fragment_texture_array_metal, error))
+		{
+			return {};
+		}
+		return source;
+	}
+
+	// The resources the translator binds (MTLShaderTranslator.h): buffer 0 the vertices, the push constant block of both
+	// stages at push_constant_buffer_slot (68 bytes of vertex configuration, then the fragment's 60), fs0 / fs1 at texture
+	// slots 0 / 1 with samplers 0 / 1.
+	inline std::vector<glsl::program_input> vertex_inputs()
+	{
+		auto push = glsl::program_input::make(::glsl::glsl_vertex_program, "push_constants", glsl::input_type_push_constant,
+			glsl::binding_set_index_vertex, 0);
+		push.push_constant_size = vertex_push_constants_size;
+		return
+		{
+			glsl::program_input::make(::glsl::glsl_vertex_program, "overlay_vertices", glsl::input_type_storage_buffer,
+				glsl::binding_set_index_vertex, 0),
+			push,
+		};
+	}
+
+	inline std::vector<glsl::program_input> fragment_inputs()
+	{
+		auto push = glsl::program_input::make(::glsl::glsl_fragment_program, "push_constants", glsl::input_type_push_constant,
+			glsl::binding_set_index_fragment, 0);
+		push.push_constant_offset = vertex_push_constants_size;
+		push.push_constant_size = fragment_push_constants_size;
+		return
+		{
+			glsl::program_input::make(::glsl::glsl_fragment_program, "fs0", glsl::input_type_texture, glsl::binding_set_index_fragment, 0),
+			glsl::program_input::make(::glsl::glsl_fragment_program, "fs1", glsl::input_type_texture, glsl::binding_set_index_fragment, 1),
+			push,
+		};
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlays.cpp b/rpcs3/Emu/RSX/Metal/MTLOverlays.cpp
new file mode 100644
index 0000000..5cf8a14
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlays.cpp
@@ -0,0 +1,517 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): native overlays of the native Metal 4 renderer (VKOverlays.cpp ui_overlay_renderer).
+
+#include "stdafx.h"
+#include "MTLOverlays.h"
+#include "MTLOverlayShaders.h"
+
+#include "MTLCommandContext.h"
+#include "MTLCommonDecompiler.h"
+#include "MTLDataHeap.h"
+#include "MTLM4Counters.h"
+#include "MTLShaderTranslator.h"
+
+#include "Emu/Cell/timers.hpp"
+#include "Emu/RSX/Overlays/overlays.h"
+#include "Emu/RSX/Program/RSXOverlay.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		const resource_slot* find_slot(const std::vector<resource_slot>& slots, std::string_view name)
+		{
+			for (const auto& slot : slots)
+			{
+				if (slot.name == name)
+				{
+					return &slot;
+				}
+			}
+			return nullptr;
+		}
+
+		template <typename T>
+		void write_floats(std::array<f32, 32>& buffer, usz& position, const T& values)
+		{
+			for (const f32 value : values)
+			{
+				buffer[position++] = value;
+			}
+		}
+	}
+
+	bool ui_overlay_renderer::create(const object& device, const object& compiler, bool fast_math, std::string& error)
+	{
+		m_device = device;
+
+		const std::string vs = overlay_shaders::vertex_glsl(error);
+		const std::string fs = vs.empty() ? std::string{} : overlay_shaders::fragment_glsl(error);
+		if (vs.empty() || fs.empty())
+		{
+			return false;
+		}
+
+		std::vector<u32> vs_spirv, fs_spirv;
+		std::string vs_text = vs, fs_text = fs;
+		if (!spirv::compile_glsl_to_spv(vs_spirv, vs_text, ::glsl::glsl_vertex_program, ::glsl::glsl_rules_vulkan) ||
+			!spirv::compile_glsl_to_spv(fs_spirv, fs_text, ::glsl::glsl_fragment_program, ::glsl::glsl_rules_vulkan))
+		{
+			error = "glslang refused the overlay shaders";
+			return false;
+		}
+
+		translation_options vertex_options{};
+		const auto vertex = translate_spirv_to_msl(vs_spirv, shader_stage::vertex, overlay_shaders::vertex_inputs(), vertex_options);
+
+		translation_options fragment_options{};
+		fragment_options.depth_attachment = false;
+		fragment_options.stencil_attachment = false;
+		fragment_options.color_output_mask = 1;
+		const auto fragment = translate_spirv_to_msl(fs_spirv, shader_stage::fragment, overlay_shaders::fragment_inputs(), fragment_options);
+
+		if (!vertex.ok || !fragment.ok)
+		{
+			error = fmt::format("overlay shaders not translated: %s", !vertex.ok ? vertex.error : fragment.error);
+			return false;
+		}
+
+		const object vertex_library = compile_library(compiler, vertex.msl, { fast_math, vertex.position_invariant }, error);
+		const object fragment_library = vertex_library ? compile_library(compiler, fragment.msl, { fast_math, false }, error) : object{};
+		if (!vertex_library || !fragment_library)
+		{
+			return false;
+		}
+
+		const auto* vertices = find_slot(vertex.slots, "overlay_vertices");
+		const auto* fs0 = find_slot(fragment.slots, "fs0");
+		const auto* fs1 = find_slot(fragment.slots, "fs1");
+		if (!vertices || !fs0 || !fs1)
+		{
+			error = "overlay shader slots missing";
+			return false;
+		}
+
+		m_vertex_buffer_slot = vertices->buffer;
+		m_texture_slots = { fs0->texture, fs1->texture };
+		m_sampler_slots = { fs0->sampler, fs1->sampler };
+		m_vertex_constants_slot = push_constant_buffer_slot;
+		m_fragment_constants_slot = push_constant_buffer_slot;
+
+		// VK ui_overlay_renderer: one colour attachment, all channels written, blend (src_alpha, zero, 1 - src_alpha, one, add, add)
+		render_pipeline_descriptor desc{};
+		desc.vertex_library = vertex_library;
+		desc.fragment_library = fragment_library;
+		desc.vertex_function = vertex.entry_point;
+		desc.fragment_function = fragment.entry_point;
+		auto& color = desc.color[0];
+		color.format = pixel_format::bgra8_unorm;
+		color.blending = true;
+		color.source_rgb = blend_factor::source_alpha;
+		color.source_alpha = blend_factor::zero;
+		color.destination_rgb = blend_factor::one_minus_source_alpha;
+		color.destination_alpha = blend_factor::one;
+		color.rgb_operation = blend_operation::add;
+		color.alpha_operation = blend_operation::add;
+		color.write_mask = write_all;
+		desc.sample_count = 1;
+		desc.label = "RSX overlays";
+		m_pipeline = new_render_pipeline(compiler, desc, error);
+		if (!m_pipeline)
+		{
+			return false;
+		}
+
+		m_vertex_table = new_argument_table(device, max_buffer_slots, max_texture_slots, max_sampler_slots);
+		m_fragment_table = new_argument_table(device, max_buffer_slots, max_texture_slots, max_sampler_slots);
+
+		// VK overlay_pass::load_program: clamp to edge, linear (ui_overlay_renderer's filter), one level
+		sampler_descriptor sampler{};
+		sampler.min_filter = sampler_min_mag_filter::linear;
+		sampler.mag_filter = sampler_min_mag_filter::linear;
+		m_sampler = new_sampler(device, sampler);
+
+		// VK binds vk::null_image_view for both units when a command has no texture.
+		texture_descriptor null_desc{};
+		null_desc.format = pixel_format::bgra8_unorm;
+		null_desc.usage = usage_shader_read;
+		null_desc.storage = storage_mode::shared;
+		m_null_2d = new_texture(device, null_desc);
+		null_desc.type = texture_type::type_2d_array;
+		m_null_2d_array = new_texture(device, null_desc);
+
+		if (!m_vertex_table || !m_fragment_table || !m_sampler || !m_null_2d || !m_null_2d_array)
+		{
+			error = "overlay argument tables, sampler or null textures";
+			m_pipeline.reset();
+			return false;
+		}
+
+		const u32 zero = 0;
+		texture_replace_region(m_null_2d, {{0, 0, 0}, {1, 1, 1}}, 0, 0, &zero, 4, 4);
+		texture_replace_region(m_null_2d_array, {{0, 0, 0}, {1, 1, 1}}, 0, 0, &zero, 4, 4);
+		return true;
+	}
+
+	void ui_overlay_renderer::destroy(command_context& ctx)
+	{
+		for (auto* cache : { &m_resources, &m_fonts, &m_temp_images })
+		{
+			for (auto& [key, entry] : *cache)
+			{
+				ctx.dispose(std::move(entry.texture), true);
+			}
+			cache->clear();
+		}
+
+		m_draws.clear();
+		ctx.dispose(std::move(m_null_2d), true);
+		ctx.dispose(std::move(m_null_2d_array), true);
+		m_pipeline.reset();
+		m_vertex_table.reset();
+		m_fragment_table.reset();
+		m_sampler.reset();
+		m_ring_buffer.reset();
+		m_device.reset();
+		m_resources_loaded = false;
+	}
+
+	const ui_overlay_renderer::texture_entry& ui_overlay_renderer::upload(command_context& ctx, std::unordered_map<u64, texture_entry>& cache,
+		u64 key, u32 width, u32 height, u32 layers, bool font, const void* pixels, u32 owner_uid)
+	{
+		// VK upload_simple_texture: R8 for fonts, B8G8R8A8 for images (the shader reads .bgra), at least one texel; an
+		// image without data is uploaded as zeros.
+		auto& entry = cache[key];
+		if (entry.texture)
+		{
+			ctx.dispose(std::move(entry.texture), true);
+		}
+
+		const u32 upload_width = std::max(width, 1u);
+		const u32 upload_height = std::max(height, 1u);
+		const u32 upload_layers = std::max(layers, 1u);
+		const u32 pitch = font ? upload_width : upload_width * 4;
+		const usz layer_size = static_cast<usz>(pitch) * upload_height;
+
+		texture_descriptor desc{};
+		desc.type = upload_layers > 1 ? texture_type::type_2d_array : texture_type::type_2d;
+		desc.format = font ? pixel_format::r8_unorm : pixel_format::bgra8_unorm;
+		desc.width = upload_width;
+		desc.height = upload_height;
+		desc.array_length = upload_layers;
+		desc.usage = usage_shader_read;
+		desc.storage = storage_mode::shared;
+		entry.texture = new_texture(m_device, desc);
+		ensure(entry.texture, "Metal overlay texture");
+
+		std::vector<u8> zeros;
+		const u8* source = static_cast<const u8*>(pixels);
+		if (!source || !width || !height)
+		{
+			zeros.resize(layer_size * upload_layers);
+			source = zeros.data();
+		}
+
+		for (u32 layer = 0; layer < upload_layers; ++layer)
+		{
+			texture_replace_region(entry.texture, {{0, 0, 0}, {upload_width, upload_height, 1}}, 0, layer, source + layer * layer_size,
+				pitch, static_cast<u32>(layer_size));
+		}
+
+		ctx.make_resident(entry.texture);
+		entry.width = upload_width;
+		entry.height = upload_height;
+		entry.layers = upload_layers;
+		entry.owner_uid = owner_uid;
+		return entry;
+	}
+
+	void ui_overlay_renderer::load_resources(command_context& ctx)
+	{
+		// VK ui_overlay_renderer::init: the standard resources, keyed from 1 in load order (rsx::overlays::image_resource_id).
+		rsx::overlays::resource_config configuration;
+		configuration.load_files();
+
+		u64 storage_key = 1;
+		for (const auto& res : configuration.texture_raw_data)
+		{
+			upload(ctx, m_resources, storage_key++, res->w, res->h, 1, false, res->get_data(), umax);
+		}
+
+		configuration.free_resources();
+		m_resources_loaded = true;
+	}
+
+	void ui_overlay_renderer::remove_temp_resources(command_context& ctx, u32 uid)
+	{
+		for (auto it = m_temp_images.begin(); it != m_temp_images.end();)
+		{
+			if (it->second.owner_uid == uid)
+			{
+				ctx.dispose(std::move(it->second.texture), true);
+				it = m_temp_images.erase(it);
+				continue;
+			}
+			++it;
+		}
+	}
+
+	const ui_overlay_renderer::texture_entry* ui_overlay_renderer::find_font(command_context& ctx, const rsx::overlays::font* font)
+	{
+		const auto image_size = font->get_glyph_data_dimensions();
+		const u64 key = reinterpret_cast<u64>(font);
+
+		if (const auto found = m_fonts.find(key); found != m_fonts.end() && found->second.texture &&
+			found->second.width == image_size.width && found->second.height == image_size.height && found->second.layers == image_size.depth)
+		{
+			return &found->second;
+		}
+
+		const std::vector<u8>& bytes = font->get_glyph_data();
+		return &upload(ctx, m_fonts, key, image_size.width, image_size.height, image_size.depth, true, bytes.data(), umax);
+	}
+
+	const ui_overlay_renderer::texture_entry* ui_overlay_renderer::find_temp_image(command_context& ctx, const rsx::overlays::image_info_base* desc, u32 owner_uid)
+	{
+		const bool dirty = std::exchange(desc->dirty, false);
+		const u64 key = reinterpret_cast<u64>(desc);
+
+		if (const auto cached = m_temp_images.find(key); cached != m_temp_images.end() && cached->second.texture && !dirty)
+		{
+			return &cached->second;
+		}
+
+		// New or changed: a new texture (the previous one is released once the GPU no longer reads it).
+		return &upload(ctx, m_temp_images, key, desc->w, desc->h, 1, false, desc->get_data(), owner_uid);
+	}
+
+	void ui_overlay_renderer::prepare(command_context& ctx, data_heap& ring, const areau& viewport, u32 target_width, u32 target_height,
+		rsx::overlays::overlay& ui)
+	{
+		if (!m_pipeline)
+		{
+			// Not drawn (counted); the overlay's own state still advances as it would on the Vulkan renderer.
+			m4_count(get_m4_counters().overlay_failures);
+			ui.update(get_system_time());
+			return;
+		}
+
+		if (!m_resources_loaded)
+		{
+			load_resources(ctx);
+		}
+
+		m_ring_buffer = ring.buffer;
+
+		// VK ui_overlay_renderer::run
+		ui.set_render_viewport(
+			static_cast<u16>(std::min<u32>(viewport.width(), std::numeric_limits<u16>::max())),
+			static_cast<u16>(std::min<u32>(viewport.height(), std::numeric_limits<u16>::max())));
+		const color4f scale_offset(ui.get_virtual_width(), ui.get_virtual_height(), 1.f, 1.f);
+		const coordf view_area = { { static_cast<f32>(viewport.x1), static_cast<f32>(viewport.y1) }, { static_cast<f32>(viewport.width()), static_cast<f32>(viewport.height()) } };
+
+		std::array<object, 2> image_views{ m_null_2d, m_null_2d_array };
+
+		if (ui.status_flags & rsx::overlays::status_bits::invalidate_image_cache)
+		{
+			remove_temp_resources(ctx, ui.uid);
+			ui.status_flags.clear(rsx::overlays::status_bits::invalidate_image_cache);
+		}
+
+		// The viewport and scissor of overlay_pass::set_up_viewport, the scissor inside the target as Metal requires.
+		mtl::viewport area{ static_cast<f64>(viewport.x1), static_cast<f64>(viewport.y1), static_cast<f64>(viewport.width()), static_cast<f64>(viewport.height()), 0., 1. };
+		scissor_rect scissor{};
+		scissor.x = std::min(viewport.x1, target_width);
+		scissor.y = std::min(viewport.y1, target_height);
+		scissor.width = std::min(viewport.width(), target_width - scissor.x);
+		scissor.height = std::min(viewport.height(), target_height - scissor.y);
+
+		const auto compiled = ui.get_compiled();
+		for (const auto& command : compiled.draw_commands)
+		{
+			const u32 vertex_count = static_cast<u32>(command.verts.size());
+
+			auto texture_type = rsx::overlays::texture_sampling_mode::texture2D;
+			auto sdf_config = command.config.sdf_config;
+			sdf_config.transform(static_cast<areaf>(viewport), { scale_offset.x, scale_offset.y });
+
+			const texture_entry* source = nullptr;
+			switch (command.config.texture_ref)
+			{
+			case rsx::overlays::image_resource_id::game_icon:
+			case rsx::overlays::image_resource_id::backbuffer:
+				// TODO in the Vulkan renderer as well: drawn without a texture
+			case rsx::overlays::image_resource_id::none:
+				texture_type = rsx::overlays::texture_sampling_mode::none;
+				break;
+			case rsx::overlays::image_resource_id::font_file:
+				source = find_font(ctx, command.config.font_ref);
+				texture_type = source->layers == 1
+					? rsx::overlays::texture_sampling_mode::font2D
+					: rsx::overlays::texture_sampling_mode::font3D;
+				break;
+			case rsx::overlays::image_resource_id::raw_image:
+				source = find_temp_image(ctx, static_cast<const rsx::overlays::image_info_base*>(command.config.external_data_ref), ui.uid);
+				break;
+			default:
+				if (const auto found = m_resources.find(command.config.texture_ref); found != m_resources.end())
+				{
+					source = &found->second;
+				}
+				break;
+			}
+
+			if (source)
+			{
+				image_views[source->layers > 1 ? 1 : 0] = source->texture;
+			}
+
+			if (!vertex_count)
+			{
+				continue;
+			}
+
+			draw_item item{};
+			item.primitives = static_cast<u32>(command.config.primitives);
+			item.vertex_count = vertex_count;
+			item.textures = image_views;
+			item.area = area;
+			item.scissor = scissor;
+
+			// overlay_pass::upload_vertex_data
+			const usz vertex_bytes = static_cast<usz>(vertex_count) * sizeof(command.verts[0]);
+			static_assert(sizeof(command.verts[0]) == 16);
+			item.vertex_offset = ring.alloc<256>(vertex_bytes);
+			std::memcpy(ring.map(item.vertex_offset), command.verts.data(), vertex_bytes);
+
+			if (command.config.primitives == rsx::overlays::primitive_type::triangle_fan && vertex_count >= 3)
+			{
+				// Metal has no fans: the same triangles, (0, n, n + 1), as an index list.
+				item.index_count = (vertex_count - 2) * 3;
+				item.index_offset = ring.alloc<256>(static_cast<usz>(item.index_count) * sizeof(u16));
+				u16* indices = ring.map<u16>(item.index_offset);
+				for (u32 n = 1; n + 1 < vertex_count; ++n)
+				{
+					*indices++ = 0;
+					*indices++ = static_cast<u16>(n);
+					*indices++ = static_cast<u16>(n + 1);
+				}
+			}
+
+			// ui_overlay_renderer::update_uniforms, byte for byte
+			std::array<f32, 32> push{};
+			usz pos = 0;
+			write_floats(push, pos, scale_offset.rgba);
+			write_floats(push, pos, command.config.color.rgba);
+			push[pos++] = view_area.width;
+			push[pos++] = view_area.height;
+			push[pos++] = view_area.x;
+			push[pos++] = view_area.y;
+			push[pos++] = command.config.clip_rect.x1;
+			push[pos++] = command.config.clip_rect.y1;
+			push[pos++] = command.config.clip_rect.x2;
+			push[pos++] = command.config.clip_rect.y2;
+
+			rsx::overlays::vertex_options vert_opts{};
+			push[pos++] = std::bit_cast<f32>(vert_opts.disable_vertex_snap(command.config.disable_vertex_snap).get());
+			ensure(pos == overlay_shaders::vertex_push_constants_size / sizeof(f32));
+
+			rsx::overlays::fragment_options frag_opts{};
+			const u32 frag_config = frag_opts
+				.texture_mode(texture_type)
+				.clip_fragments(command.config.clip_region)
+				.pulse_glow(command.config.pulse_glow)
+				.set_sdf(sdf_config.func)
+				.get();
+
+			push[pos++] = std::bit_cast<f32>(frag_config);
+			push[pos++] = command.config.get_sinus_value();
+			push[pos++] = static_cast<f32>(command.config.blur_strength) * 0.01f;
+			push[pos++] = sdf_config.hx;
+			push[pos++] = sdf_config.hy;
+			push[pos++] = sdf_config.br;
+			push[pos++] = sdf_config.bw;
+			push[pos++] = sdf_config.cx;
+			push[pos++] = sdf_config.cy;
+			push[pos++] = 0.f;
+			push[pos++] = 0.f;
+			write_floats(push, pos, sdf_config.border_color.rgba);
+			ensure(pos == overlay_shaders::push_constants_size / sizeof(f32));
+
+			item.constants_offset = ring.alloc<256>(overlay_shaders::push_constants_size);
+			std::memcpy(ring.map(item.constants_offset), push.data(), overlay_shaders::push_constants_size);
+
+			m_draws.push_back(std::move(item));
+			m4_count(get_m4_counters().overlay_draws);
+		}
+
+		ui.update(get_system_time());
+		m4_count(get_m4_counters().overlay_views);
+	}
+
+	void ui_overlay_renderer::encode(const object& encoder)
+	{
+		if (m_draws.empty())
+		{
+			return;
+		}
+
+		set_render_pipeline(encoder, m_pipeline);
+		set_cull_mode(encoder, cull_mode::none);
+
+		for (const auto& item : m_draws)
+		{
+			set_viewport(encoder, item.area);
+			set_scissor(encoder, item.scissor);
+
+			table_set_buffer(m_vertex_table, m_ring_buffer, item.vertex_offset, m_vertex_buffer_slot);
+			table_set_buffer(m_vertex_table, m_ring_buffer, item.constants_offset, m_vertex_constants_slot);
+			table_set_buffer(m_fragment_table, m_ring_buffer, item.constants_offset, m_fragment_constants_slot);
+			for (u32 unit = 0; unit < 2; ++unit)
+			{
+				if (m_texture_slots[unit] != umax)
+				{
+					table_set_texture(m_fragment_table, item.textures[unit], m_texture_slots[unit]);
+				}
+				if (m_sampler_slots[unit] != umax)
+				{
+					table_set_sampler(m_fragment_table, m_sampler, m_sampler_slots[unit]);
+				}
+			}
+			set_argument_table(encoder, m_vertex_table, stage_vertex);
+			set_argument_table(encoder, m_fragment_table, stage_fragment);
+
+			switch (static_cast<rsx::overlays::primitive_type>(item.primitives))
+			{
+			case rsx::overlays::primitive_type::quad_list:
+				// VK ui_overlay_renderer::emit_geometry: quads as disjoint 4-vertex triangle strips
+				for (u32 first = 0; first + 4 <= item.vertex_count; first += 4)
+				{
+					draw_primitives(encoder, primitive_type::triangle_strip, first, 4);
+				}
+				break;
+			case rsx::overlays::primitive_type::triangle_strip:
+				draw_primitives(encoder, primitive_type::triangle_strip, 0, item.vertex_count);
+				break;
+			case rsx::overlays::primitive_type::line_list:
+				draw_primitives(encoder, primitive_type::line, 0, item.vertex_count);
+				break;
+			case rsx::overlays::primitive_type::line_strip:
+				draw_primitives(encoder, primitive_type::line_strip, 0, item.vertex_count);
+				break;
+			case rsx::overlays::primitive_type::triangle_fan:
+				if (item.index_count)
+				{
+					draw_indexed_primitives(encoder, primitive_type::triangle, item.index_count, index_type::uint16, m_ring_buffer,
+						item.index_offset, static_cast<u64>(item.index_count) * sizeof(u16));
+				}
+				break;
+			}
+		}
+
+		m_draws.clear();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlays.h b/rpcs3/Emu/RSX/Metal/MTLOverlays.h
new file mode 100644
index 0000000..499f9af
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlays.h
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the native interface (rsx::overlays: message, save data, trophy and OSK dialogs,
+// shader compilation notices, the performance overlay) drawn by the native Metal 4 renderer over the presented frame,
+// as VKOverlays.cpp ui_overlay_renderer draws it for the Vulkan renderer.
+//
+// The shaders are the Vulkan renderer's own (Program/GLSLSnippets/OverlayRenderVS.glsl and OverlayRenderFS.glsl),
+// compiled at runtime through the renderer's shader stack (glslang, then SPIRV-Cross with the RSX programs' options).
+// Only their resource declarations are adapted: the vertex attribute becomes a read of the same 16-byte vertices from a
+// storage buffer at gl_VertexIndex (Metal 4 pipelines here have no vertex descriptor), and the fragment textures move to
+// the fragment descriptor set of the translator's slot contract. The push constants keep their Vulkan byte layout
+// (68 bytes of vertex configuration, then 60 bytes of fragment configuration) in one block shared by both stages.
+//
+// The textures (font atlases, the standard icons, the images overlays pass) use a minimal local upload path, not the
+// texture cache: shared-storage textures written by the CPU when they are created. A changed image gets a new texture
+// (the previous one is released once the GPU is done with it), so no texture is rewritten while a frame may read it.
+
+#include "MTLAPI.h"
+
+#include "Utilities/geometry.h"
+
+#include <array>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+namespace rsx::overlays
+{
+	struct overlay;
+	class font;
+	struct image_info_base;
+}
+
+namespace mtl
+{
+	class command_context;
+	class data_heap;
+
+	class ui_overlay_renderer
+	{
+	public:
+		bool create(const object& device, const object& compiler, bool fast_math, std::string& error);
+		void destroy(command_context& ctx);
+		bool ready() const { return !!m_pipeline; }
+
+		// VKGSRender's frame-end cleanup: the images of overlays that were closed are released.
+		void remove_temp_resources(command_context& ctx, u32 uid);
+
+		// Prepares the draws of one overlay view (VK ui_overlay_renderer::run) into the ring, before the presentation pass
+		// is opened: the ring may then still make room by submitting.
+		void prepare(command_context& ctx, data_heap& ring, const areau& viewport, u32 target_width, u32 target_height,
+			rsx::overlays::overlay& ui);
+
+		// Encodes the prepared draws into the open presentation pass and forgets them.
+		void encode(const object& encoder);
+		void clear_prepared() { m_draws.clear(); }
+		bool has_prepared() const { return !m_draws.empty(); }
+
+	private:
+		struct texture_entry
+		{
+			object texture;
+			u32 width = 0, height = 0, layers = 0;
+			u32 owner_uid = umax;
+		};
+
+		struct draw_item
+		{
+			u32 primitives = 0;                  // rsx::overlays::primitive_type
+			u32 vertex_count = 0;
+			u64 vertex_offset = 0;               // in the ring
+			u64 index_offset = 0;                // triangle fans: 16-bit indices in the ring
+			u32 index_count = 0;
+			u64 constants_offset = 0;            // the push constant block in the ring
+			std::array<object, 2> textures{};   // fs0 (2D), fs1 (2D array)
+			viewport area{};
+			scissor_rect scissor{};
+		};
+
+		const texture_entry& upload(command_context& ctx, std::unordered_map<u64, texture_entry>& cache, u64 key, u32 width, u32 height,
+			u32 layers, bool font, const void* pixels, u32 owner_uid);
+		const texture_entry* find_font(command_context& ctx, const rsx::overlays::font* font);
+		const texture_entry* find_temp_image(command_context& ctx, const rsx::overlays::image_info_base* desc, u32 owner_uid);
+		void load_resources(command_context& ctx);
+
+		object m_device;
+		object m_pipeline;
+		object m_vertex_table;
+		object m_fragment_table;
+		object m_sampler;
+		object m_null_2d;
+		object m_null_2d_array;
+		object m_ring_buffer;                    // the ring the prepared draws point into
+		u32 m_vertex_buffer_slot = umax;
+		u32 m_vertex_constants_slot = umax;
+		u32 m_fragment_constants_slot = umax;
+		std::array<u32, 2> m_texture_slots{ umax, umax };
+		std::array<u32, 2> m_sampler_slots{ umax, umax };
+		bool m_resources_loaded = false;
+
+		std::unordered_map<u64, texture_entry> m_resources;    // standard icons (resource_config), by image_resource_id
+		std::unordered_map<u64, texture_entry> m_fonts;        // by font
+		std::unordered_map<u64, texture_entry> m_temp_images;  // by image_info_base, with the overlay that owns it
+		std::vector<draw_item> m_draws;
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.cpp b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.cpp
new file mode 100644
index 0000000..bdd1c5d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.cpp
@@ -0,0 +1,393 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M5): the title's Metal 4 pipeline binaries (see MTLPipelineArchive.h, MTLPipelineCache.h).
+
+#include "stdafx.h"
+#include "MTLPipelineArchive.h"
+
+#include "MTLTexture.h"
+
+#include "Utilities/File.h"
+#include "Utilities/Thread.h"
+
+#include <chrono>
+#include <vector>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace mtl
+{
+	namespace
+	{
+		pipeline_cache_counters g_cache_counters{};
+
+		u64 now_us()
+		{
+			return static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+				std::chrono::steady_clock::now().time_since_epoch()).count());
+		}
+
+		// The checkpoint's file operations on disk (the unit test fakes the same interface).
+		struct disk_ops final : pipeline_cache::file_ops
+		{
+			const object& serializer;
+
+			explicit disk_ops(const object& value) : serializer(value) {}
+
+			bool read_text(const std::string& path, std::string& text) override
+			{
+				fs::file file(path);
+				if (!file)
+				{
+					return false;
+				}
+				text = file.to_string();
+				return true;
+			}
+
+			bool write_text(const std::string& path, std::string_view text) override
+			{
+				fs::file file(path, fs::rewrite);
+				return file && file.write(text.data(), text.size()) == text.size();
+			}
+
+			bool serialize(const std::string& path) override
+			{
+				std::string error;
+				if (!write_pipeline_archive(serializer, path, error))
+				{
+					log_once("archive-serialize", fmt::format("Metal 4 pipeline archive serialization failed: %s", error));
+					return false;
+				}
+				return true;
+			}
+
+			bool sync(const std::string& path) override
+			{
+				// POSIX directly: a failed sync is a failed checkpoint (counted), never a fatal error.
+				const int fd = ::open(path.c_str(), O_RDONLY);
+				if (fd < 0)
+				{
+					return false;
+				}
+				const bool ok = ::fsync(fd) == 0;
+				::close(fd);
+				return ok;
+			}
+
+			u64 size(const std::string& path) override
+			{
+				fs::stat_t info{};
+				return (fs::get_stat(path, info) && !info.is_directory) ? info.size : 0;
+			}
+
+			bool rename(const std::string& from, const std::string& to) override
+			{
+				return fs::rename(from, to, true);
+			}
+
+			bool remove(const std::string& path) override
+			{
+				return fs::remove_file(path) || !fs::is_file(path);
+			}
+		};
+
+		void reject(const std::string& path, std::string_view why)
+		{
+			g_cache_counters.rejections++;
+			log_once("archive-rejected", fmt::format("Metal 4 pipeline archive %s rejected (%s): removed, rebuilt from this session's pipelines", path, why));
+			fs::remove_file(path);
+		}
+	}
+
+	pipeline_cache_counters& get_pipeline_cache_counters()
+	{
+		return g_cache_counters;
+	}
+
+	pipeline_archive::~pipeline_archive()
+	{
+		close();
+	}
+
+	const char* pipeline_archive::state_name() const
+	{
+		switch (m_state)
+		{
+		case state::off: return "off";
+		case state::unavailable: return "unavailable";
+		case state::fresh: return "fresh";
+		case state::loaded: return "loaded";
+		}
+		return "unknown";
+	}
+
+	void pipeline_archive::open(const object& device, const std::string& directory, const pipeline_cache::archive_identity& identity)
+	{
+		ensure(!m_worker.joinable());
+		m_state = state::off;
+		if (directory.empty())
+		{
+			rsx_log.notice("Metal 4 pipeline archive: off (the on-disk shader cache is disabled or the title has no cache directory)");
+			return;
+		}
+
+		if (!fs::create_path(directory))
+		{
+			g_cache_counters.unavailable++;
+			log_once("archive-directory", fmt::format("Metal 4 pipeline archive: the directory %s cannot be created", directory));
+			return;
+		}
+
+		m_paths = pipeline_cache::make_archive_paths(directory, identity);
+		m_identity_text = pipeline_cache::identity_text(identity);
+		const std::string base = pipeline_cache::archive_base_name(identity);
+
+		// Every archive file of the directory: another identity's is rejected, an interrupted checkpoint's removed.
+		bool archive_exists = false;
+		bool identity_exists = false;
+		std::vector<std::string> stale;
+		for (const auto& entry : fs::dir(directory))
+		{
+			if (entry.is_directory)
+			{
+				continue;
+			}
+
+			switch (pipeline_cache::classify_file(entry.name, base))
+			{
+			case pipeline_cache::file_role::unrelated: break;
+			case pipeline_cache::file_role::current_archive: archive_exists = true; break;
+			case pipeline_cache::file_role::current_identity: identity_exists = true; break;
+			case pipeline_cache::file_role::other_archive: reject(directory + entry.name, "another GPU, system or archive version"); break;
+			case pipeline_cache::file_role::other_identity:
+			case pipeline_cache::file_role::leftover_temp: stale.push_back(directory + entry.name); break;
+			}
+		}
+
+		for (const auto& path : stale)
+		{
+			fs::remove_file(path);
+		}
+
+		std::string identity_on_disk;
+		if (identity_exists)
+		{
+			fs::file file(m_paths.identity);
+			identity_on_disk = file ? file.to_string() : std::string{};
+		}
+
+		switch (pipeline_cache::check_archive(archive_exists, identity_exists, identity_on_disk, m_identity_text))
+		{
+		case pipeline_cache::archive_state::usable:
+		{
+			std::string error;
+			m_archive = open_pipeline_archive(device, m_paths.archive, error);
+			if (!m_archive)
+			{
+				reject(m_paths.archive, fmt::format("Metal cannot open it: %s", error));
+			}
+			break;
+		}
+		case pipeline_cache::archive_state::absent:
+			break;
+		case pipeline_cache::archive_state::no_identity:
+			reject(m_paths.archive, "no identity sidecar");
+			break;
+		case pipeline_cache::archive_state::identity_mismatch:
+			reject(m_paths.archive, "its identity differs");
+			fs::remove_file(m_paths.identity);
+			break;
+		}
+
+		m_serializer = new_pipeline_serializer(device);
+		if (!m_serializer)
+		{
+			// Pipelines still use the loaded archive; nothing new is captured or written.
+			g_cache_counters.unavailable++;
+			log_once("archive-serializer", "Metal 4 pipeline archive: no pipeline data set serializer, pipeline binaries are not saved");
+			m_state = state::unavailable;
+		}
+		else
+		{
+			m_state = m_archive ? state::loaded : state::fresh;
+		}
+
+		set_pipeline_lookup_archive(m_archive);
+		m_checkpoint_misses = get_pipeline_archive_counters().misses.load();
+		m_last_checkpoint_us = now_us();
+		m_forced_pending = false;
+		m_keep_loaded = false;
+
+		if (m_serializer)
+		{
+			m_stop = false;
+			m_request = false;
+			m_busy = false;
+			m_worker = std::thread([this]() { worker_main(); });
+		}
+
+		rsx_log.notice("Metal 4 pipeline archive: %s (%s)", state_name(), m_paths.archive);
+	}
+
+	u64 pipeline_archive::new_pipelines() const
+	{
+		const u64 misses = get_pipeline_archive_counters().misses.load(std::memory_order_relaxed);
+		const u64 base = m_checkpoint_misses.load(std::memory_order_relaxed);
+		return misses > base ? misses - base : 0;
+	}
+
+	void pipeline_archive::begin_boot()
+	{
+		m_boot = true;
+	}
+
+	void pipeline_archive::end_boot(bool completed)
+	{
+		m_boot = false;
+		if (!completed && m_archive)
+		{
+			// The serializer holds only the records rebuilt before the stop: writing it would replace the complete
+			// archive with a part of it.
+			m_keep_loaded = true;
+			rsx_log.notice("Metal 4 pipeline archive: the boot precompile was interrupted, the loaded archive is kept unchanged");
+			return;
+		}
+
+		m_forced_pending = true;
+		tick();
+	}
+
+	void pipeline_archive::tick()
+	{
+		if (!m_worker.joinable() || m_keep_loaded)
+		{
+			return;
+		}
+
+		bool busy;
+		{
+			// Only flags: the worker never holds the lock while it writes.
+			std::lock_guard lock(m_mutex);
+			busy = m_busy || m_request;
+		}
+
+		pipeline_cache::checkpoint_state status;
+		status.now_us = now_us();
+		status.last_us = m_last_checkpoint_us.load(std::memory_order_relaxed);
+		status.new_pipelines = new_pipelines();
+		status.forced = m_forced_pending;
+		status.boot_in_progress = m_boot.load(std::memory_order_relaxed);
+		status.worker_busy = busy;
+
+		const auto reason = pipeline_cache::decide_checkpoint(m_policy, status);
+		if (reason == pipeline_cache::checkpoint_reason::none)
+		{
+			if (!status.new_pipelines)
+			{
+				m_forced_pending = false;  // nothing to force
+			}
+			return;
+		}
+
+		dispatch(reason == pipeline_cache::checkpoint_reason::forced);
+	}
+
+	void pipeline_archive::dispatch(bool forced)
+	{
+		if (forced)
+		{
+			m_forced_pending = false;
+		}
+
+		// The pipelines compiled from here on belong to the next checkpoint (back to this one's if it fails).
+		m_previous_misses = m_checkpoint_misses.load();
+		m_checkpoint_misses = get_pipeline_archive_counters().misses.load();
+		m_last_checkpoint_us = now_us();
+		{
+			std::lock_guard lock(m_mutex);
+			m_request = true;
+		}
+		m_wake.notify_one();
+	}
+
+	void pipeline_archive::worker_main()
+	{
+		thread_ctrl::set_native_priority(-1);
+
+		std::unique_lock lock(m_mutex);
+		while (true)
+		{
+			m_wake.wait(lock, [this]() { return m_request || m_stop; });
+			if (!m_request)
+			{
+				break;
+			}
+
+			m_request = false;
+			m_busy = true;
+			lock.unlock();
+			write();
+			lock.lock();
+			m_busy = false;
+			m_idle.notify_all();
+		}
+	}
+
+	void pipeline_archive::write()
+	{
+		disk_ops ops(m_serializer);
+		const auto result = pipeline_cache::write_checkpoint(ops, m_paths, m_identity_text);
+		if (result.ok())
+		{
+			g_cache_counters.checkpoints++;
+			g_cache_counters.checkpoint_bytes += result.bytes;
+			return;
+		}
+
+		// The pipelines of the failed checkpoint stay new: a later one (rate-limited from now) writes them again.
+		g_cache_counters.checkpoint_failures++;
+		m_checkpoint_misses = m_previous_misses.load();
+		m_last_checkpoint_us = now_us();
+		log_once("archive-checkpoint", fmt::format("Metal 4 pipeline archive checkpoint failed at its %s step: the previous archive stays",
+			pipeline_cache::checkpoint_step_name(result.failed)));
+	}
+
+	void pipeline_archive::close()
+	{
+		if (!m_worker.joinable())
+		{
+			end_pipeline_capture();
+			set_pipeline_lookup_archive({});
+			m_archive.reset();
+			m_serializer.reset();
+			return;
+		}
+
+		// The last checkpoint: after any running one, with everything compiled since it started.
+		{
+			std::unique_lock lock(m_mutex);
+			m_idle.wait(lock, [this]() { return !m_busy && !m_request; });
+		}
+
+		m_boot = false;
+		if (new_pipelines() && !m_keep_loaded)
+		{
+			dispatch(true);
+		}
+
+		{
+			std::unique_lock lock(m_mutex);
+			m_idle.wait(lock, [this]() { return !m_busy && !m_request; });
+			m_stop = true;
+		}
+		m_wake.notify_one();
+		m_worker.join();
+
+		end_pipeline_capture();
+		set_pipeline_lookup_archive({});
+		m_archive.reset();
+		m_serializer.reset();
+		m_state = state::off;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.h b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.h
new file mode 100644
index 0000000..bb01940
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.h
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M5): the title's Metal 4 pipeline binaries (the rules are MTLPipelineCache.h).
+//
+// open() validates the title's archive (another identity, a missing sidecar or a file Metal cannot open is rejected:
+// counted, removed, rebuilt), hands it to every pipeline creation as a lookup (mtl::set_pipeline_lookup_archive), and
+// creates the serializer the renderer's compiler captures into. tick(), once per frame on the RSX thread, only reads
+// counters and the clock; a due checkpoint goes to the worker thread, which writes the archive atomically. close()
+// writes the last checkpoint and joins the worker (the end of the session). An archive that Metal cannot capture
+// (no serializer) is counted and logged once, and the session runs without one.
+
+#include "MTLAPI.h"
+#include "MTLPipelineCache.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace mtl
+{
+	struct pipeline_cache_counters
+	{
+		std::atomic<u64> rejections{0};          // archives (or their sidecars) of another identity, or unusable
+		std::atomic<u64> checkpoints{0};         // archives written
+		std::atomic<u64> checkpoint_bytes{0};
+		std::atomic<u64> checkpoint_failures{0};
+		std::atomic<u64> unavailable{0};         // sessions without a serializer or a cache directory
+	};
+
+	pipeline_cache_counters& get_pipeline_cache_counters();
+
+	class pipeline_archive
+	{
+	public:
+		enum class state : u8
+		{
+			off,          // the on-disk shader cache is disabled, or no title cache directory
+			unavailable,  // Metal created no serializer: nothing captured, nothing written
+			fresh,        // no usable archive: this session's pipelines build a new one
+			loaded,       // the archive is the lookup of every pipeline creation
+		};
+
+		pipeline_archive() = default;
+		pipeline_archive(const pipeline_archive&) = delete;
+		pipeline_archive& operator=(const pipeline_archive&) = delete;
+		~pipeline_archive();
+
+		// `directory` (the title's Metal cache, with a trailing separator) is empty when the cache is off.
+		void open(const object& device, const std::string& directory, const pipeline_cache::archive_identity& identity);
+		const object& serializer() const { return m_serializer; }
+		state get_state() const { return m_state; }
+		const char* state_name() const;
+
+		void begin_boot();  // the boot precompile starts: no checkpoint until end_boot()
+		// The boot precompile ended: a forced checkpoint of what it compiled. An interrupted one (the emulation stopped)
+		// rebuilt only part of the records: a loaded archive is then kept as it is for the whole session.
+		void end_boot(bool completed);
+		void tick();        // RSX thread, once per frame: never blocks, never writes
+		void close();       // the final checkpoint, then the worker stops (blocking)
+
+	private:
+		u64 new_pipelines() const;
+		void dispatch(bool forced);
+		void worker_main();
+		void write();
+
+		state m_state = state::off;
+		object m_serializer;
+		object m_archive;
+		pipeline_cache::archive_paths m_paths;
+		std::string m_identity_text;
+		pipeline_cache::checkpoint_policy m_policy{};
+
+		// The archive misses (compiled pipelines) counted when the last checkpoint started, and before it.
+		std::atomic<u64> m_checkpoint_misses{0};
+		std::atomic<u64> m_previous_misses{0};
+		std::atomic<u64> m_last_checkpoint_us{0};
+		std::atomic<bool> m_boot{false};
+		bool m_keep_loaded = false;     // an interrupted boot over a loaded archive: no checkpoint this session
+		bool m_forced_pending = false;  // RSX thread only
+
+		std::thread m_worker;
+		std::mutex m_mutex;
+		std::condition_variable m_wake;
+		std::condition_variable m_idle;
+		bool m_request = false;   // guarded by m_mutex
+		bool m_busy = false;      // guarded by m_mutex
+		bool m_stop = false;      // guarded by m_mutex
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineCache.h b/rpcs3/Emu/RSX/Metal/MTLPipelineCache.h
new file mode 100644
index 0000000..a0fd34c
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineCache.h
@@ -0,0 +1,353 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M5): the rules of the Metal renderer's shader and pipeline caches, as pure functions (no
+// Metal, no file system; unit-tested on any host by tests/mtl_m5_unit_test.cpp).
+//
+// Both caches live under the title's cache directory, apart from every Vulkan file:
+//   - the RSX program cache is the Vulkan renderer's model (rsx::shaders_cache): raw RSX vertex and fragment programs
+//     and pipeline_props records, rebuilt into pipelines at boot before the first draw. Metal keeps it in
+//     shaders_cache/metal/ (raw/, pipelines/metal/<version>/). Vulkan uses shaders_cache/raw, shaders_cache/pipelines/
+//     vulkan, shaders_cache/spirv.pack and shaders_cache/vk_pipeline_cache.bin and reads nothing below metal/; Metal
+//     reads and writes nothing outside it. The iOS game library counts and clears shaders_cache/ as a whole.
+//   - the Metal 4 pipeline binaries: an MTL4PipelineDataSetSerializer attached to the compiler captures the binary of
+//     every pipeline it builds; checkpoints write the captured set as an MTL4Archive file, which the next session's
+//     pipeline creations look up first (a pipeline the archive does not hold is compiled as without it). The file name
+//     holds the hash of the archive's identity (format version, GPU, OS version and build) and a sidecar file holds the
+//     identity itself: an archive of another identity, or one without its sidecar, is rejected (counted, removed) and
+//     rebuilt from this session's pipelines.
+// Checkpoints are written by a worker, rate-limited (decide_checkpoint), atomically (write_checkpoint: temporary file,
+// sync, rename), never during the boot precompile (that archive would lack the records not rebuilt yet) and never by
+// the draw path.
+
+#include "util/types.hpp"
+
+#include <string>
+#include <string_view>
+
+namespace mtl::pipeline_cache
+{
+	// -----------------------------------------------------------------------------------------------------------------
+	// The RSX program cache (the rsx::shaders_cache arguments)
+
+	constexpr std::string_view program_cache_directory = "shaders_cache/metal/";  // relative to the title's cache
+	constexpr std::string_view program_cache_class = "metal";                     // pipelines/<class>/<version>/
+	constexpr u32 program_record_version = 1;  // bump when pipeline_props changes meaning without changing size
+
+	// The records' version directory: the record version and the size of pipeline_props (rsx::shaders_cache also
+	// removes records of another size; a new directory never reads old ones at all).
+	inline std::string program_cache_version(usz props_size)
+	{
+		return "v" + std::to_string(program_record_version) + "-p" + std::to_string(props_size);
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// Archive identity
+
+	constexpr u32 archive_format_version = 1;  // bump to reject every archive written before
+	constexpr std::string_view archive_prefix = "pipelines-";
+	// A Metal binary archive keeps the metallib extension Metal's archives use; a temporary file keeps the final
+	// extension too (".partial" before it), in case the serializer or the loader goes by the extension.
+	constexpr std::string_view archive_extension = ".metallib";
+	constexpr std::string_view identity_extension = ".identity";
+	constexpr std::string_view partial_infix = ".partial";
+
+	struct archive_identity
+	{
+		u32 version = archive_format_version;
+		std::string device;   // MTLDevice name
+		std::string system;   // operating system version and build
+	};
+
+	// One field per line: a line break inside a field cannot forge another field.
+	inline std::string identity_field(std::string_view value)
+	{
+		std::string result(value);
+		for (char& c : result)
+		{
+			if (c == '\n' || c == '\r')
+			{
+				c = ' ';
+			}
+		}
+		return result;
+	}
+
+	// The sidecar's text, compared byte for byte.
+	inline std::string identity_text(const archive_identity& identity)
+	{
+		std::string text = "RPCS3 Metal 4 pipeline archive\n";
+		text += "version=" + std::to_string(identity.version) + "\n";
+		text += "device=" + identity_field(identity.device) + "\n";
+		text += "system=" + identity_field(identity.system) + "\n";
+		return text;
+	}
+
+	constexpr u64 fnv1a64(std::string_view data)
+	{
+		u64 hash = 0xcbf29ce484222325ull;
+		for (const char c : data)
+		{
+			hash ^= static_cast<u8>(c);
+			hash *= 0x100000001b3ull;
+		}
+		return hash;
+	}
+
+	// "pipelines-<16 hex digits of the identity hash>"
+	inline std::string archive_base_name(const archive_identity& identity)
+	{
+		constexpr char digits[] = "0123456789abcdef";
+		const u64 hash = fnv1a64(identity_text(identity));
+		std::string name(archive_prefix);
+		for (int shift = 60; shift >= 0; shift -= 4)
+		{
+			name += digits[(hash >> shift) & 0xf];
+		}
+		return name;
+	}
+
+	struct archive_paths
+	{
+		std::string archive;         // <directory>pipelines-<hash>.metallib
+		std::string archive_temp;    // <directory>pipelines-<hash>.partial.metallib
+		std::string identity;        // <directory>pipelines-<hash>.identity
+		std::string identity_temp;   // <directory>pipelines-<hash>.partial.identity
+	};
+
+	// `directory` ends with a separator.
+	inline archive_paths make_archive_paths(std::string_view directory, const archive_identity& identity)
+	{
+		const std::string base = std::string(directory) + archive_base_name(identity);
+		archive_paths paths;
+		paths.archive = base + std::string(archive_extension);
+		paths.archive_temp = base + std::string(partial_infix) + std::string(archive_extension);
+		paths.identity = base + std::string(identity_extension);
+		paths.identity_temp = base + std::string(partial_infix) + std::string(identity_extension);
+		return paths;
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// Validation and rejection
+
+	// What a file of the cache directory is to this session.
+	enum class file_role : u8
+	{
+		unrelated,        // not an archive file (the program cache's raw/ and pipelines/, the SPIR-V pack, anything else)
+		current_archive,  // this identity's archive
+		current_identity, // this identity's sidecar
+		other_archive,    // another identity's archive: rejected (counted) and removed
+		other_identity,   // another identity's sidecar: removed with it
+		leftover_temp,    // an interrupted checkpoint's temporary file: removed
+	};
+
+	constexpr bool ends_with(std::string_view text, std::string_view suffix)
+	{
+		return text.size() >= suffix.size() && text.substr(text.size() - suffix.size()) == suffix;
+	}
+
+	constexpr file_role classify_file(std::string_view name, std::string_view base_name)
+	{
+		if (name.substr(0, archive_prefix.size()) != archive_prefix)
+		{
+			return file_role::unrelated;
+		}
+
+		const bool archive = ends_with(name, archive_extension);
+		const bool identity = ends_with(name, identity_extension);
+		if (!archive && !identity)
+		{
+			return file_role::unrelated;
+		}
+
+		const std::string_view stem = name.substr(0, name.size() - (archive ? archive_extension.size() : identity_extension.size()));
+		if (ends_with(stem, partial_infix))
+		{
+			return file_role::leftover_temp;
+		}
+
+		if (stem == base_name)
+		{
+			return archive ? file_role::current_archive : file_role::current_identity;
+		}
+		return archive ? file_role::other_archive : file_role::other_identity;
+	}
+
+	// Whether this identity's archive may be handed to Metal (which may still fail to open it: a rejection too).
+	enum class archive_state : u8
+	{
+		usable,             // archive and sidecar present, the sidecar holds this identity
+		absent,             // no archive: built from this session's pipelines (not a rejection)
+		no_identity,        // an archive without its sidecar: rejected
+		identity_mismatch,  // a sidecar that does not hold this identity (damaged, or a hash collision): rejected
+	};
+
+	constexpr archive_state check_archive(bool archive_exists, bool identity_exists, std::string_view identity_on_disk, std::string_view expected)
+	{
+		if (!archive_exists)
+		{
+			return archive_state::absent;
+		}
+		if (!identity_exists)
+		{
+			return archive_state::no_identity;
+		}
+		return identity_on_disk == expected ? archive_state::usable : archive_state::identity_mismatch;
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// Checkpoint rate limit
+
+	struct checkpoint_policy
+	{
+		u64 interval_us = 180'000'000;     // a trickle of new pipelines is written within this time
+		u64 burst = 64;                    // or as soon as this many are new
+		u64 min_spacing_us = 15'000'000;   // never two checkpoints closer than this (a compile storm)
+	};
+
+	enum class checkpoint_reason : u8
+	{
+		none,
+		interval,
+		burst,
+		forced,   // the end of the boot precompile, the end of the session
+	};
+
+	struct checkpoint_state
+	{
+		u64 now_us = 0;
+		u64 last_us = 0;            // the last checkpoint's start, or the session's
+		u64 new_pipelines = 0;      // compiled (not from the archive) since the last checkpoint started
+		bool forced = false;
+		bool boot_in_progress = false;
+		bool worker_busy = false;
+	};
+
+	constexpr checkpoint_reason decide_checkpoint(const checkpoint_policy& policy, const checkpoint_state& state)
+	{
+		// Nothing new: the archive on disk already holds every pipeline of this session (or there are none).
+		if (!state.new_pipelines || state.worker_busy)
+		{
+			return checkpoint_reason::none;
+		}
+
+		if (state.forced)
+		{
+			return checkpoint_reason::forced;
+		}
+
+		if (state.boot_in_progress)
+		{
+			return checkpoint_reason::none;
+		}
+
+		const u64 elapsed = state.now_us >= state.last_us ? state.now_us - state.last_us : 0;
+		if (elapsed < policy.min_spacing_us)
+		{
+			return checkpoint_reason::none;
+		}
+
+		if (state.new_pipelines >= policy.burst)
+		{
+			return checkpoint_reason::burst;
+		}
+
+		return elapsed >= policy.interval_us ? checkpoint_reason::interval : checkpoint_reason::none;
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// The atomic checkpoint sequence, through its file operations (the seam the unit test fakes)
+
+	struct file_ops
+	{
+		virtual ~file_ops() = default;
+		virtual bool read_text(const std::string& path, std::string& text) = 0;        // false when absent
+		virtual bool write_text(const std::string& path, std::string_view text) = 0;   // creates or truncates
+		virtual bool serialize(const std::string& path) = 0;                          // the serializer writes the archive
+		virtual bool sync(const std::string& path) = 0;                               // the data on storage
+		virtual u64 size(const std::string& path) = 0;                                // 0 when absent
+		virtual bool rename(const std::string& from, const std::string& to) = 0;      // atomic replace
+		virtual bool remove(const std::string& path) = 0;                             // true when absent afterwards
+	};
+
+	enum class checkpoint_step : u8
+	{
+		done,
+		identity_write,
+		identity_rename,
+		serialize,
+		sync,
+		empty,
+		rename,
+	};
+
+	struct checkpoint_result
+	{
+		checkpoint_step failed = checkpoint_step::done;
+		u64 bytes = 0;
+
+		bool ok() const { return failed == checkpoint_step::done; }
+	};
+
+	// 1. The sidecar, unless it holds this identity already: temporary file, sync, rename.
+	// 2. The archive: a leftover temporary file is removed, the serializer writes a new one, sync, it must not be empty,
+	//    rename over the archive. On any failure the temporary file is removed and the archive on disk stays the
+	//    previous complete one; a crash at any point leaves either the previous or the new archive, never a partial one.
+	inline checkpoint_result write_checkpoint(file_ops& ops, const archive_paths& paths, std::string_view identity)
+	{
+		const auto fail = [&](checkpoint_step step, const std::string& temp)
+		{
+			ops.remove(temp);
+			return checkpoint_result{ step, 0 };
+		};
+
+		std::string current;
+		if (!ops.read_text(paths.identity, current) || current != identity)
+		{
+			if (!ops.write_text(paths.identity_temp, identity) || !ops.sync(paths.identity_temp))
+			{
+				return fail(checkpoint_step::identity_write, paths.identity_temp);
+			}
+			if (!ops.rename(paths.identity_temp, paths.identity))
+			{
+				return fail(checkpoint_step::identity_rename, paths.identity_temp);
+			}
+		}
+
+		ops.remove(paths.archive_temp);
+		if (!ops.serialize(paths.archive_temp))
+		{
+			return fail(checkpoint_step::serialize, paths.archive_temp);
+		}
+		if (!ops.sync(paths.archive_temp))
+		{
+			return fail(checkpoint_step::sync, paths.archive_temp);
+		}
+
+		const u64 bytes = ops.size(paths.archive_temp);
+		if (!bytes)
+		{
+			return fail(checkpoint_step::empty, paths.archive_temp);
+		}
+		if (!ops.rename(paths.archive_temp, paths.archive))
+		{
+			return fail(checkpoint_step::rename, paths.archive_temp);
+		}
+		return { checkpoint_step::done, bytes };
+	}
+
+	constexpr const char* checkpoint_step_name(checkpoint_step step)
+	{
+		switch (step)
+		{
+		case checkpoint_step::done: return "done";
+		case checkpoint_step::identity_write: return "identity write";
+		case checkpoint_step::identity_rename: return "identity rename";
+		case checkpoint_step::serialize: return "serialization";
+		case checkpoint_step::sync: return "sync";
+		case checkpoint_step::empty: return "empty archive";
+		case checkpoint_step::rename: return "rename";
+		}
+		return "unknown";
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp b/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp
new file mode 100644
index 0000000..7255ee2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): RSX fixed-function state -> Metal 4 pipeline, depth-stencil and encoder state.
+
+#include "stdafx.h"
+#include "MTLPipelineState.h"
+#include "MTLM4Math.h"  // M4
+
+#include "Emu/RSX/Utils/color_utils.hpp"
+#include "Emu/RSX/Utils/rsx_utils.h"
+#include "Emu/RSX/rsx_methods.h"
+
+namespace mtl
+{
+	compare_function get_compare_function(rsx::comparison_function op)
+	{
+		switch (op)
+		{
+		case rsx::comparison_function::never: return compare_function::never;
+		case rsx::comparison_function::greater: return compare_function::greater;
+		case rsx::comparison_function::less: return compare_function::less;
+		case rsx::comparison_function::less_or_equal: return compare_function::less_equal;
+		case rsx::comparison_function::greater_or_equal: return compare_function::greater_equal;
+		case rsx::comparison_function::equal: return compare_function::equal;
+		case rsx::comparison_function::not_equal: return compare_function::not_equal;
+		case rsx::comparison_function::always: return compare_function::always;
+		}
+		fmt::throw_exception("Unknown compare op: 0x%x", static_cast<u32>(op));
+	}
+
+	stencil_operation get_stencil_operation(rsx::stencil_op op)
+	{
+		switch (op)
+		{
+		case rsx::stencil_op::keep: return stencil_operation::keep;
+		case rsx::stencil_op::zero: return stencil_operation::zero;
+		case rsx::stencil_op::replace: return stencil_operation::replace;
+		case rsx::stencil_op::incr: return stencil_operation::increment_clamp;
+		case rsx::stencil_op::decr: return stencil_operation::decrement_clamp;
+		case rsx::stencil_op::invert: return stencil_operation::invert;
+		case rsx::stencil_op::incr_wrap: return stencil_operation::increment_wrap;
+		case rsx::stencil_op::decr_wrap: return stencil_operation::decrement_wrap;
+		}
+		fmt::throw_exception("Unknown stencil op: 0x%x", static_cast<u32>(op));
+	}
+
+	blend_factor get_blend_factor(rsx::blend_factor factor)
+	{
+		switch (factor)
+		{
+		case rsx::blend_factor::one: return blend_factor::one;
+		case rsx::blend_factor::zero: return blend_factor::zero;
+		case rsx::blend_factor::src_alpha: return blend_factor::source_alpha;
+		case rsx::blend_factor::dst_alpha: return blend_factor::destination_alpha;
+		case rsx::blend_factor::src_color: return blend_factor::source_color;
+		case rsx::blend_factor::dst_color: return blend_factor::destination_color;
+		case rsx::blend_factor::constant_color: return blend_factor::blend_color;
+		case rsx::blend_factor::constant_alpha: return blend_factor::blend_alpha;
+		case rsx::blend_factor::one_minus_src_color: return blend_factor::one_minus_source_color;
+		case rsx::blend_factor::one_minus_dst_color: return blend_factor::one_minus_destination_color;
+		case rsx::blend_factor::one_minus_src_alpha: return blend_factor::one_minus_source_alpha;
+		case rsx::blend_factor::one_minus_dst_alpha: return blend_factor::one_minus_destination_alpha;
+		case rsx::blend_factor::one_minus_constant_alpha: return blend_factor::one_minus_blend_alpha;
+		case rsx::blend_factor::one_minus_constant_color: return blend_factor::one_minus_blend_color;
+		case rsx::blend_factor::src_alpha_saturate: return blend_factor::source_alpha_saturated;
+		}
+		fmt::throw_exception("Unknown blend factor 0x%x", static_cast<u32>(factor));
+	}
+
+	blend_operation get_blend_operation(rsx::blend_equation op)
+	{
+		// The signed equations have no host equivalent; the Vulkan renderer emulates them the same way.
+		switch (op)
+		{
+		case rsx::blend_equation::add_signed:
+			rsx_log.error("blend equation add_signed used. Emulating using FUNC_ADD");
+			[[fallthrough]];
+		case rsx::blend_equation::add: return blend_operation::add;
+		case rsx::blend_equation::reverse_add_signed:
+			rsx_log.error("blend equation reverse_add_signed used. Emulating using FUNC_ADD");
+			return blend_operation::add;
+		case rsx::blend_equation::subtract: return blend_operation::subtract;
+		case rsx::blend_equation::reverse_subtract_signed:
+			rsx_log.error("blend equation reverse_subtract_signed used. Emulating using FUNC_REVERSE_SUBTRACT");
+			[[fallthrough]];
+		case rsx::blend_equation::reverse_subtract: return blend_operation::reverse_subtract;
+		case rsx::blend_equation::min: return blend_operation::min;
+		case rsx::blend_equation::max: return blend_operation::max;
+		}
+		fmt::throw_exception("Unknown blend op: 0x%x", static_cast<u32>(op));
+	}
+
+	winding get_winding(rsx::front_face face)
+	{
+		switch (face)
+		{
+		case rsx::front_face::cw: return winding::clockwise;
+		case rsx::front_face::ccw: return winding::counter_clockwise;
+		}
+		fmt::throw_exception("Unknown front face value: 0x%x", static_cast<u32>(face));
+	}
+
+	native_primitive get_native_primitive(rsx::primitive_type primitive)
+	{
+		switch (primitive)
+		{
+		case rsx::primitive_type::points: return { primitive_type::point, false };
+		case rsx::primitive_type::lines: return { primitive_type::line, false };
+		case rsx::primitive_type::line_loop: return { primitive_type::line_strip, true };
+		case rsx::primitive_type::line_strip: return { primitive_type::line_strip, false };
+		case rsx::primitive_type::triangles: return { primitive_type::triangle, false };
+		case rsx::primitive_type::triangle_strip:
+		case rsx::primitive_type::quad_strip: return { primitive_type::triangle_strip, false };
+		case rsx::primitive_type::triangle_fan:
+		case rsx::primitive_type::quads:
+		case rsx::primitive_type::polygon: return { primitive_type::triangle, true };
+		}
+		fmt::throw_exception("Unsupported primitive topology 0x%x", static_cast<u8>(primitive));
+	}
+
+	topology_class get_topology_class(rsx::primitive_type primitive)
+	{
+		switch (get_native_primitive(primitive).type)
+		{
+		case primitive_type::point: return topology_class::point;
+		case primitive_type::line:
+		case primitive_type::line_strip: return topology_class::line;
+		default: return topology_class::triangle;
+		}
+	}
+
+	color_attachment_state color_blend_key::attachment_state() const
+	{
+		color_attachment_state state{};
+		state.format = static_cast<pixel_format>(format);
+		state.blending = !!blend;
+		state.source_rgb = static_cast<blend_factor>(source_rgb);
+		state.destination_rgb = static_cast<blend_factor>(destination_rgb);
+		state.rgb_operation = static_cast<blend_operation>(rgb_operation);
+		state.source_alpha = static_cast<blend_factor>(source_alpha);
+		state.destination_alpha = static_cast<blend_factor>(destination_alpha);
+		state.alpha_operation = static_cast<blend_operation>(alpha_operation);
+		state.write_mask = write_mask;
+		return state;
+	}
+
+	depth_stencil_descriptor depth_stencil_key::descriptor() const
+	{
+		depth_stencil_descriptor desc{};
+		desc.depth_compare = static_cast<compare_function>(depth_compare);
+		desc.depth_write = !!depth_write;
+		desc.stencil = !!stencil;
+		for (const auto& [src, dst] : { std::pair{ &front, &desc.front }, std::pair{ &back, &desc.back } })
+		{
+			dst->compare = static_cast<compare_function>(src->compare);
+			dst->stencil_fail = static_cast<stencil_operation>(src->stencil_fail);
+			dst->depth_fail = static_cast<stencil_operation>(src->depth_fail);
+			dst->depth_stencil_pass = static_cast<stencil_operation>(src->depth_stencil_pass);
+			dst->read_mask = src->read_mask;
+			dst->write_mask = src->write_mask;
+		}
+		return desc;
+	}
+
+	pipeline_props decode_pipeline_props(const rsx::rsx_state& regs, const attachment_layout& attachments,
+		rsx::primitive_type primitive, bool supports_hw_a2c, bool supports_hw_a2one, bool force_disable_blending)
+	{
+		pipeline_props props{};
+		props.color_count = attachments.color_count;
+		props.depth_attachment = attachments.depth ? 1 : 0;
+		props.stencil_attachment = attachments.stencil ? 1 : 0;
+		props.sample_count = attachments.samples;
+		props.topology = static_cast<u8>(get_topology_class(primitive));
+
+		const auto host_write_mask = rsx::get_write_output_mask(regs.surface_color());
+		for (u8 index = 0; index < attachments.color_count; ++index)
+		{
+			auto& color = props.color[index];
+			color.format = static_cast<u16>(attachments.color[index]);
+
+			bool color_mask_b = regs.color_mask_b(index);
+			bool color_mask_g = regs.color_mask_g(index);
+			bool color_mask_r = regs.color_mask_r(index);
+			bool color_mask_a = regs.color_mask_a(index);
+
+			switch (regs.surface_color())
+			{
+			case rsx::surface_color_format::b8:
+				rsx::get_b8_colormask(color_mask_r, color_mask_g, color_mask_b, color_mask_a);
+				break;
+			case rsx::surface_color_format::g8b8:
+				rsx::get_g8b8_r8g8_colormask(color_mask_r, color_mask_g, color_mask_b, color_mask_a);
+				break;
+			default:
+				break;
+			}
+
+			color.write_mask =
+				((color_mask_r && host_write_mask[0]) ? write_red : 0) |
+				((color_mask_g && host_write_mask[1]) ? write_green : 0) |
+				((color_mask_b && host_write_mask[2]) ? write_blue : 0) |
+				((color_mask_a && host_write_mask[3]) ? write_alpha : 0);
+		}
+
+		// LogicOp and Blend are mutually exclusive. If both are enabled, LogicOp takes precedence (Vulkan renderer).
+		if (regs.logic_op_enabled())
+		{
+			props.logic_op_requested = 1;
+		}
+		else if (!force_disable_blending)
+		{
+			if (const auto blend_enabled = regs.blend_enabled_mask())
+			{
+				const auto source_rgb = get_blend_factor(regs.blend_func_sfactor_rgb());
+				const auto source_alpha = get_blend_factor(regs.blend_func_sfactor_a());
+				const auto destination_rgb = get_blend_factor(regs.blend_func_dfactor_rgb());
+				const auto destination_alpha = get_blend_factor(regs.blend_func_dfactor_a());
+				const auto rgb_operation = get_blend_operation(regs.blend_equation_rgb());
+				const auto alpha_operation = get_blend_operation(regs.blend_equation_a());
+
+				for (u8 index = 0; index < attachments.color_count; ++index)
+				{
+					if (blend_enabled & (1u << index))
+					{
+						auto& color = props.color[index];
+						color.blend = 1;
+						color.source_rgb = static_cast<u8>(source_rgb);
+						color.destination_rgb = static_cast<u8>(destination_rgb);
+						color.rgb_operation = static_cast<u8>(rgb_operation);
+						color.source_alpha = static_cast<u8>(source_alpha);
+						color.destination_alpha = static_cast<u8>(destination_alpha);
+						color.alpha_operation = static_cast<u8>(alpha_operation);
+					}
+				}
+			}
+		}
+
+		// vk::graphics_pipeline_state::set_multisample_state: the enables follow the registers, not msaa_enabled().
+		if (supports_hw_a2c || attachments.samples > 1)
+		{
+			props.alpha_to_coverage = regs.msaa_alpha_to_coverage_enabled() ? 1 : 0;
+			props.alpha_to_one = (regs.msaa_alpha_to_one_enabled() && supports_hw_a2one) ? 1 : 0;
+
+			// M4: the sample mask (Vulkan pSampleMask, applied for more than one sample; a fixed sample mask of the
+			// fragment shader on Metal, as MoltenVK) and minSampleShading 1 (per-sample fragment shading).
+			const u32 mask = msaa::pipeline_sample_mask(attachments.samples, regs.msaa_sample_mask());
+			props.sample_mask = (mask == msaa::all_samples) ? u16{0xffff} : static_cast<u16>(mask);
+			props.sample_shading = attachments.samples > 1 ? 1 : 0;
+			// M4 end
+		}
+
+		return props;
+	}
+
+	depth_stencil_key decode_depth_stencil(const rsx::rsx_state& regs, bool stencil_attachment)
+	{
+		depth_stencil_key key{};
+
+		if (regs.depth_test_enabled())
+		{
+			// Like stencil, depth write is meaningless without depth test
+			key.depth_write = regs.depth_write_enabled() ? 1 : 0;
+			key.depth_compare = static_cast<u8>(get_compare_function(regs.depth_func()));
+		}
+
+		if (stencil_attachment && regs.stencil_test_enabled())
+		{
+			const auto make_face = [](rsx::comparison_function compare, rsx::stencil_op fail, rsx::stencil_op zfail, rsx::stencil_op zpass, u8 read_mask, u8 write_mask)
+			{
+				depth_stencil_key::face face{};
+				face.compare = static_cast<u8>(get_compare_function(compare));
+				face.stencil_fail = static_cast<u8>(get_stencil_operation(fail));
+				face.depth_fail = static_cast<u8>(get_stencil_operation(zfail));
+				face.depth_stencil_pass = static_cast<u8>(get_stencil_operation(zpass));
+				face.read_mask = read_mask;
+				face.write_mask = write_mask;
+				return face;
+			};
+
+			key.stencil = 1;
+			key.front = make_face(regs.stencil_func(), regs.stencil_op_fail(), regs.stencil_op_zfail(), regs.stencil_op_zpass(),
+				regs.stencil_func_mask(), regs.stencil_mask());
+			key.back = regs.two_sided_stencil_test_enabled()
+				? make_face(regs.back_stencil_func(), regs.back_stencil_op_fail(), regs.back_stencil_op_zfail(), regs.back_stencil_op_zpass(),
+					regs.back_stencil_func_mask(), regs.back_stencil_mask())
+				: key.front;
+		}
+
+		return key;
+	}
+
+	raster_state decode_raster_state(const rsx::rsx_state& regs)
+	{
+		raster_state state{};
+		state.front = get_winding(regs.front_face_mode());
+
+		if (regs.cull_face_enabled())
+		{
+			switch (regs.cull_face_mode())
+			{
+			case rsx::cull_face::back: state.cull = cull_mode::back; break;
+			case rsx::cull_face::front: state.cull = cull_mode::front; break;
+			case rsx::cull_face::front_and_back: state.cull_both_faces = true; break;
+			}
+		}
+
+		state.depth_clip = (regs.depth_clamp_enabled() || !regs.depth_clip_enabled()) ? depth_clip_mode::clamp : depth_clip_mode::clip;
+
+		if (regs.poly_offset_fill_enabled())
+		{
+			// vkCmdSetDepthBias(constant = offset_bias, clamp = 0, slope = offset_scale), as MoltenVK forwards it.
+			state.depth_bias = regs.poly_offset_bias();
+			state.depth_bias_slope = regs.poly_offset_scale();
+		}
+
+		if (regs.stencil_test_enabled())
+		{
+			state.stencil_front_reference = regs.stencil_func_ref();
+			state.stencil_back_reference = regs.two_sided_stencil_test_enabled() ? regs.back_stencil_func_ref() : regs.stencil_func_ref();
+		}
+
+		if (regs.blend_enabled_mask())
+		{
+			state.blend_color = rsx::get_constant_blend_colors();
+		}
+
+		return state;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineState.h b/rpcs3/Emu/RSX/Metal/MTLPipelineState.h
new file mode 100644
index 0000000..080f0f4
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineState.h
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): RSX fixed-function state for the native Metal 4 renderer.
+//
+// The RSX registers are decoded exactly as the Vulkan renderer decodes them (VKGSRender.cpp decode_rsx_state,
+// VKDraw.cpp update_draw_state) and then converted the way MoltenVK converts the resulting Vulkan state:
+//   - pipeline_props: what a Metal render pipeline bakes in (attachment formats, blending, write masks, sample
+//     count, alpha-to-coverage/one, primitive class, the fragment variant's depth/stencil outputs);
+//   - depth_stencil_key: one MTLDepthStencilState (compare, write, stencil ops and masks; Metal has no dynamic
+//     stencil masks);
+//   - raster_state: per-draw encoder state (cull, winding, depth clip, depth bias, stencil references, blend colour).
+// Vulkan front faces map to the same Metal winding because the vertex shaders flip Y (MoltenVK's convention).
+// Features neither Metal nor the MoltenVK path on iPhone offer (logic ops, depth bounds before Apple10, wide lines)
+// behave as on that path and are counted by the renderer.
+
+#include "MTLAPI.h"
+
+#include "Emu/RSX/gcm_enums.h"
+
+#include <array>
+#include <type_traits>
+
+namespace rsx
+{
+	struct rsx_state;
+}
+
+namespace mtl
+{
+	// MTLPrimitiveTopologyClass
+	enum class topology_class : u8
+	{
+		unspecified = 0,
+		point = 1,
+		line = 2,
+		triangle = 3,
+	};
+
+	// The program cache hashes pipeline properties as raw bytes (rpcs3::hash_struct), so the keys hold only
+	// u8/u16 fields with no padding (checked below); enum values are stored as their Metal numbers.
+	struct color_blend_key
+	{
+		u16 format = 0;          // pixel_format
+		u8 write_mask = 0;       // color_write_mask bits
+		u8 blend = 0;
+		u8 source_rgb = static_cast<u8>(blend_factor::one);
+		u8 destination_rgb = static_cast<u8>(blend_factor::zero);
+		u8 rgb_operation = static_cast<u8>(blend_operation::add);
+		u8 source_alpha = static_cast<u8>(blend_factor::one);
+		u8 destination_alpha = static_cast<u8>(blend_factor::zero);
+		u8 alpha_operation = static_cast<u8>(blend_operation::add);
+
+		bool operator==(const color_blend_key&) const = default;
+		color_attachment_state attachment_state() const;
+	};
+
+	struct pipeline_props
+	{
+		std::array<color_blend_key, 4> color{};
+		u8 color_count = 0;
+		u8 depth_attachment = 0;
+		u8 stencil_attachment = 0;
+		u8 sample_count = 1;
+		u8 alpha_to_coverage = 0;
+		u8 alpha_to_one = 0;
+		u8 topology = static_cast<u8>(topology_class::triangle);
+		u8 logic_op_requested = 0;  // RSX logic op: not available (as with MoltenVK); blending stays off
+		// M4: VK set_multisample_state / set_multisample_shading_rate(1) for more than one sample: the RSX sample mask
+		// (restricted to the existing samples, 0xffff when it masks nothing) and per-sample shading.
+		u16 sample_mask = 0xffff;
+		u8 sample_shading = 0;
+		u8 reserved_m4 = 0;
+		// M4 end
+
+		bool operator==(const pipeline_props&) const = default;
+	};
+
+	static_assert(sizeof(color_blend_key) == 10 && sizeof(pipeline_props) == 52);  // M4: 48 + sample mask and shading
+	static_assert(std::has_unique_object_representations_v<pipeline_props>, "pipeline_props must have no padding");
+
+	struct depth_stencil_key
+	{
+		struct face
+		{
+			u8 compare = static_cast<u8>(compare_function::always);
+			u8 stencil_fail = static_cast<u8>(stencil_operation::keep);
+			u8 depth_fail = static_cast<u8>(stencil_operation::keep);
+			u8 depth_stencil_pass = static_cast<u8>(stencil_operation::keep);
+			u8 read_mask = 0xff;
+			u8 write_mask = 0xff;
+
+			bool operator==(const face&) const = default;
+		};
+
+		u8 depth_compare = static_cast<u8>(compare_function::always);
+		u8 depth_write = 0;
+		u8 stencil = 0;
+		u8 reserved = 0;
+		face front{};
+		face back{};
+
+		bool operator==(const depth_stencil_key&) const = default;
+		depth_stencil_descriptor descriptor() const;
+	};
+
+	static_assert(std::has_unique_object_representations_v<depth_stencil_key>, "depth_stencil_key must have no padding");
+
+	struct raster_state
+	{
+		cull_mode cull = cull_mode::none;
+		bool cull_both_faces = false;   // Vulkan FRONT_AND_BACK: triangles rasterize nothing (MoltenVK disables rasterization)
+		winding front = winding::counter_clockwise;
+		depth_clip_mode depth_clip = depth_clip_mode::clip;
+		f32 depth_bias = 0.f;
+		f32 depth_bias_slope = 0.f;
+		f32 depth_bias_clamp = 0.f;
+		u32 stencil_front_reference = 0;
+		u32 stencil_back_reference = 0;
+		std::array<f32, 4> blend_color{};
+	};
+
+	// Conversions (VK helper -> MoltenVK mapping).
+	compare_function get_compare_function(rsx::comparison_function op);
+	stencil_operation get_stencil_operation(rsx::stencil_op op);
+	blend_factor get_blend_factor(rsx::blend_factor factor);
+	blend_operation get_blend_operation(rsx::blend_equation op);
+	winding get_winding(rsx::front_face face);
+	topology_class get_topology_class(rsx::primitive_type primitive);
+
+	// Metal primitive for an RSX primitive, and whether an index buffer must emulate it (VKVertexBuffers.cpp,
+	// the __APPLE__ table: triangle fans, quads, polygons and line loops are emulated).
+	struct native_primitive
+	{
+		primitive_type type;
+		bool emulated;
+	};
+	native_primitive get_native_primitive(rsx::primitive_type primitive);
+
+	struct attachment_layout
+	{
+		std::array<pixel_format, 4> color{};
+		u8 color_count = 0;
+		bool depth = false;
+		bool stencil = false;
+		u8 samples = 1;
+	};
+
+	pipeline_props decode_pipeline_props(const rsx::rsx_state& regs, const attachment_layout& attachments,
+		rsx::primitive_type primitive, bool supports_hw_a2c, bool supports_hw_a2one, bool force_disable_blending);
+
+	depth_stencil_key decode_depth_stencil(const rsx::rsx_state& regs, bool stencil_attachment);
+
+	raster_state decode_raster_state(const rsx::rsx_state& regs);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPresent.h b/rpcs3/Emu/RSX/Metal/MTLPresent.h
new file mode 100644
index 0000000..4973e36
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPresent.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE: the presentation pass of the native Metal 4 renderer, shared with its host test.
+//
+// The display buffer is converted exactly as the Vulkan renderer's upload_image_simple does: each
+// big-endian A8R8G8B8 word is stored as a native u32, i.e. BGRA8 bytes in memory. The pass draws a
+// quad covering `rect` (normalized device coordinates) that samples it; alpha is not shown.
+
+#include "util/types.hpp"
+
+#include <algorithm>
+#include <bit>
+#include <cstring>
+#include <string_view>
+
+namespace mtl::present_pass
+{
+	constexpr std::string_view vertex_function = "present_vertex";
+	constexpr std::string_view fragment_function = "present_fragment";
+
+	constexpr std::string_view source = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct present_vertex_out
+{
+	float4 position [[position]];
+	float2 uv;
+};
+
+struct present_params
+{
+	float4 rect;       // left, bottom, right, top in clip space
+	float4 uv_scale;   // xy: the displayed fraction of the source texture (a surface may be larger than the buffer)
+};
+
+vertex present_vertex_out present_vertex(uint vid [[vertex_id]], constant present_params& params [[buffer(0)]])
+{
+	const float2 corner = float2((vid & 1u) ? 1.0 : 0.0, (vid & 2u) ? 1.0 : 0.0);
+	present_vertex_out out;
+	out.position = float4(mix(params.rect.x, params.rect.z, corner.x), mix(params.rect.y, params.rect.w, corner.y), 0.0, 1.0);
+	out.uv = float2(corner.x, 1.0 - corner.y) * params.uv_scale.xy;
+	return out;
+}
+
+fragment float4 present_fragment(present_vertex_out in [[stage_in]], texture2d<float> image [[texture(0)]], sampler image_sampler [[sampler(0)]])
+{
+	return float4(image.sample(image_sampler, in.uv).rgb, 1.0);
+}
+)";
+
+	static_assert(std::endian::native == std::endian::little, "the BGRA8 byte order below assumes a little-endian host");
+
+	// One row of big-endian A8R8G8B8 guest words to native u32 values (BGRA8 bytes on little-endian hosts).
+	inline void convert_row(const u8* guest_row, u32* destination, u32 width) noexcept
+	{
+		for (u32 column = 0; column < width; ++column)
+		{
+			u32 word;
+			std::memcpy(&word, guest_row + static_cast<usz>(column) * 4, 4);
+			destination[column] = __builtin_bswap32(word);
+		}
+	}
+
+	// The quad that fits a source of the given size in the target, keeping its aspect ratio.
+	struct rectangle
+	{
+		f32 left = 0, bottom = 0, right = 0, top = 0;
+	};
+
+	// The constants of present_vertex (buffer 0).
+	struct parameters
+	{
+		rectangle rect{};
+		f32 uv_scale[4] = { 1.f, 1.f, 0.f, 0.f };
+	};
+	static_assert(sizeof(parameters) == 32);
+
+	inline rectangle fit(u32 source_width, u32 source_height, u32 target_width, u32 target_height) noexcept
+	{
+		if (!source_width || !source_height || !target_width || !target_height)
+		{
+			return {};
+		}
+
+		const f64 scale = std::min(static_cast<f64>(target_width) / source_width, static_cast<f64>(target_height) / source_height);
+		const f32 half_width = static_cast<f32>(source_width * scale / target_width);
+		const f32 half_height = static_cast<f32>(source_height * scale / target_height);
+		return {-half_width, -half_height, half_width, half_height};
+	}
+
+	// REWINDBOX_METAL_STRETCH_934: Stretch To Display Area fills the drawable, as the Vulkan renderer does
+	// (VKPresent.cpp keeps the aspect ratio only when the setting is off). An empty source or target draws nothing.
+	inline rectangle place(u32 source_width, u32 source_height, u32 target_width, u32 target_height, bool stretch) noexcept
+	{
+		if (!stretch || !source_width || !source_height || !target_width || !target_height)
+		{
+			return fit(source_width, source_height, target_width, target_height);
+		}
+		return {-1.f, -1.f, 1.f, 1.f};
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp
new file mode 100644
index 0000000..e0144d4
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): program cache traits and pipeline builds of the native Metal 4 renderer.
+
+#include "stdafx.h"
+#include "MTLProgramBuffer.h"
+
+namespace mtl
+{
+	namespace
+	{
+		pipeline_environment g_environment{};
+		pipeline_counters g_counters{};
+		std::atomic<pipeline_build_origin> g_build_origin{ pipeline_build_origin::draw };  // M5
+
+		u32 find_slot(const std::vector<resource_slot>& slots, u32 location, u32 resource_slot::*member)
+		{
+			for (const auto& slot : slots)
+			{
+				if (slot.location == location && slot.type != glsl::input_type_push_constant)
+				{
+					return slot.*member;
+				}
+			}
+			return umax;
+		}
+	}
+
+	void set_pipeline_environment(const pipeline_environment& environment)
+	{
+		g_environment = environment;
+	}
+
+	const pipeline_environment& get_pipeline_environment()
+	{
+		return g_environment;
+	}
+
+	pipeline_counters& get_pipeline_counters()
+	{
+		return g_counters;
+	}
+
+	void set_pipeline_build_origin(pipeline_build_origin origin)
+	{
+		g_build_origin.store(origin, std::memory_order_relaxed);  // M5
+	}
+
+	u32 program::vertex_buffer_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::buffer); }
+	u32 program::vertex_texture_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::texture); }
+	u32 program::vertex_sampler_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::sampler); }
+	u32 program::fragment_buffer_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::buffer); }
+	u32 program::fragment_texture_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::texture); }
+	u32 program::fragment_sampler_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::sampler); }
+
+	bool program::fragment_reads_push_constants() const
+	{
+		for (const auto& slot : fragment_slots)
+		{
+			if (slot.type == glsl::input_type_push_constant)
+			{
+				return slot.used;
+			}
+		}
+		return false;
+	}
+
+	void MTLTraits::recompile_fragment_program(const RSXFragmentProgram& RSXFP, fragment_program_type& fragmentProgramData, usz ID)
+	{
+		fragmentProgramData.Decompile(RSXFP, g_environment.caps);
+		fragmentProgramData.id = static_cast<u32>(ID);
+		g_counters.fragment_programs++;
+
+		if (!fragmentProgramData.Compile())
+		{
+			g_counters.glsl_failures++;
+			rsx_log.error("Metal: fragment program %u: %s", fragmentProgramData.id, fragmentProgramData.compile_error);
+		}
+	}
+
+	void MTLTraits::recompile_vertex_program(const RSXVertexProgram& RSXVP, vertex_program_type& vertexProgramData, usz ID)
+	{
+		vertexProgramData.Decompile(RSXVP, g_environment.caps);
+		vertexProgramData.id = static_cast<u32>(ID);
+		g_counters.vertex_programs++;
+
+		if (!vertexProgramData.Compile())
+		{
+			g_counters.glsl_failures++;
+			rsx_log.error("Metal: vertex program %u: %s", vertexProgramData.id, vertexProgramData.compile_error);
+		}
+	}
+
+	void MTLTraits::validate_pipeline_properties(const vertex_program_type&, const fragment_program_type& fp, pipeline_properties& properties)
+	{
+		// Explicitly disable writing to undefined registers (as VKTraits does with the colour write masks).
+		for (u32 index = 0; index < properties.color.size(); ++index)
+		{
+			if (!fp.output_color_masks[index])
+			{
+				properties.color[index].write_mask = 0;
+			}
+		}
+	}
+
+	MTLTraits::pipeline_type* MTLTraits::build_pipeline(
+		const vertex_program_type& vertexProgramData,
+		const fragment_program_type& fragmentProgramData,
+		const pipeline_properties& pipelineProperties,
+		bool /*compile_async*/,
+		std::function<pipeline_type*(pipeline_storage_type&)> callback)
+	{
+		auto result = std::make_unique<program>();
+		const auto& props = pipelineProperties;
+
+		object vertex_library;
+		object fragment_library;
+		std::string vertex_entry;
+		std::string fragment_entry;
+
+		// Vertex stage: one translation per primitive class, one library per translation.
+		{
+			const bool points = props.topology == static_cast<u8>(topology_class::point);
+			const u32 variant = points ? 1 : 0;
+
+			std::lock_guard lock(vertexProgramData.translation_lock);
+			if (vertexProgramData.spirv.empty())
+			{
+				result->error = fmt::format("vertex program %u has no SPIR-V (%s)", vertexProgramData.id, vertexProgramData.compile_error);
+			}
+			else if (const auto& msl = vertexProgramData.get_msl(points); !msl.ok)
+			{
+				g_counters.translation_failures++;
+				result->error = fmt::format("vertex program %u: %s", vertexProgramData.id, msl.error);
+			}
+			else
+			{
+				auto& library = vertexProgramData.library[variant];
+				auto& library_error = vertexProgramData.library_error[variant];
+				if (!library && library_error.empty())
+				{
+					library = compile_library(g_environment.compiler, msl.msl, { g_environment.fast_math, msl.position_invariant }, library_error);
+					if (!library)
+					{
+						g_counters.library_failures++;
+						rsx_log.error("Metal: vertex program %u does not compile: %s", vertexProgramData.id, library_error);
+					}
+				}
+
+				if (library)
+				{
+					vertex_library = library;
+					vertex_entry = msl.entry_point;
+					result->vertex_slots = msl.slots;
+				}
+				else
+				{
+					result->error = fmt::format("vertex program %u: %s", vertexProgramData.id, library_error);
+				}
+			}
+		}
+
+		// Fragment stage: one translation per render-pass variant.
+		if (result->error.empty())
+		{
+			fragment_variant_key key{};
+			key.depth_attachment = !!props.depth_attachment;
+			key.stencil_attachment = !!props.stencil_attachment;
+			// Only outputs with a colour attachment (MoltenVK's enable_frag_output_mask); alpha-to-coverage needs output 0.
+			key.color_output_mask = props.color_count ? ((1u << props.color_count) - 1) : (props.alpha_to_coverage ? 1u : 0u);
+			// M4: MSAA sample mask and per-sample shading (pipeline_props, VK set_multisample_state)
+			key.sample_mask = (props.sample_mask == 0xffff) ? 0xffffffffu : props.sample_mask;
+			key.sample_rate_shading = !!props.sample_shading;
+
+			std::lock_guard lock(fragmentProgramData.translation_lock);
+			if (fragmentProgramData.spirv.empty())
+			{
+				result->error = fmt::format("fragment program %u has no SPIR-V (%s)", fragmentProgramData.id, fragmentProgramData.compile_error);
+			}
+			else if (auto& variant = fragmentProgramData.get_variant(key); !variant.msl.ok)
+			{
+				g_counters.translation_failures++;
+				result->error = fmt::format("fragment program %u: %s", fragmentProgramData.id, variant.msl.error);
+			}
+			else
+			{
+				if (!variant.library && variant.library_error.empty())
+				{
+					variant.library = compile_library(g_environment.compiler, variant.msl.msl, { g_environment.fast_math, false }, variant.library_error);
+					if (!variant.library)
+					{
+						g_counters.library_failures++;
+						rsx_log.error("Metal: fragment program %u does not compile: %s", fragmentProgramData.id, variant.library_error);
+					}
+				}
+
+				if (variant.library)
+				{
+					fragment_library = variant.library;
+					fragment_entry = variant.msl.entry_point;
+					result->fragment_slots = variant.msl.slots;
+				}
+				else
+				{
+					result->error = fmt::format("fragment program %u: %s", fragmentProgramData.id, variant.library_error);
+				}
+			}
+		}
+
+		if (result->error.empty())
+		{
+			render_pipeline_descriptor desc{};
+			desc.vertex_library = vertex_library;
+			desc.fragment_library = fragment_library;
+			desc.vertex_function = vertex_entry;
+			desc.fragment_function = fragment_entry;
+			for (u32 index = 0; index < props.color_count && index < props.color.size(); ++index)
+			{
+				desc.color[index] = props.color[index].attachment_state();
+			}
+			desc.sample_count = props.sample_count;
+			desc.alpha_to_coverage = !!props.alpha_to_coverage;
+			desc.alpha_to_one = !!props.alpha_to_one;
+			desc.input_topology = props.topology;
+			desc.label = fmt::format("RSX vp%u fp%u", vertexProgramData.id, fragmentProgramData.id);
+
+			std::string error;
+			result->pipeline = new_render_pipeline(g_environment.compiler, desc, error);
+			if (result->pipeline)
+			{
+				g_counters.pipelines++;
+				// M5
+				(g_build_origin.load(std::memory_order_relaxed) == pipeline_build_origin::boot ? g_counters.boot_pipelines : g_counters.draw_pipelines)++;
+			}
+			else
+			{
+				result->error = fmt::format("pipeline vp%u fp%u: %s", vertexProgramData.id, fragmentProgramData.id, error);
+			}
+		}
+
+		if (!result->error.empty())
+		{
+			g_counters.pipeline_failures++;
+			rsx_log.error("Metal: %s", result->error);
+		}
+
+		return callback(result);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h
new file mode 100644
index 0000000..6c61986
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): the program cache of the native Metal 4 renderer.
+//
+// RPCS3's shared program_state_cache (the one the Vulkan and OpenGL renderers use) keys vertex and fragment
+// programs by their microcode and pipelines by (programs, pipeline_props). MTLTraits plugs the Metal stack in:
+// decompile + glslang on first sight of a program, SPIR-V -> MSL and MTL4 library compilation on first use of a
+// translation variant (both cached on the program), and one MTLRenderPipelineState per key. A program or pipeline
+// that fails is kept with its error (logged once) and its draws are skipped and counted by the renderer, exactly
+// as the Vulkan renderer skips draws whose program is not available.
+
+#include "Emu/RSX/Program/ProgramStateCache.h"
+#include "MTLAPI.h"
+#include "MTLFragmentProgram.h"
+#include "MTLPipelineState.h"
+#include "MTLShaderTranslator.h"
+#include "MTLVertexProgram.h"
+
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	// What a program cache build needs from the renderer; set once by MTLGSRender::on_init_thread.
+	struct pipeline_environment
+	{
+		object device;
+		object compiler;
+		shader_device_caps caps{};
+		bool fast_math = true;   // !g_cfg.video.disable_msl_fast_math, read when the renderer starts
+	};
+
+	void set_pipeline_environment(const pipeline_environment& environment);
+	const pipeline_environment& get_pipeline_environment();
+
+	struct pipeline_counters
+	{
+		std::atomic<u64> vertex_programs{0};
+		std::atomic<u64> fragment_programs{0};
+		std::atomic<u64> glsl_failures{0};
+		std::atomic<u64> translation_failures{0};
+		std::atomic<u64> library_failures{0};
+		std::atomic<u64> pipelines{0};
+		std::atomic<u64> pipeline_failures{0};
+		// M5: pipelines built by the boot precompile of the program cache, and by draws (cache misses)
+		std::atomic<u64> boot_pipelines{0};
+		std::atomic<u64> draw_pipelines{0};
+	};
+
+	pipeline_counters& get_pipeline_counters();
+
+	// M5: who builds the pipelines now (the boot precompile runs on the RSX thread before the first draw).
+	enum class pipeline_build_origin : u8
+	{
+		draw,
+		boot,
+	};
+	void set_pipeline_build_origin(pipeline_build_origin origin);
+
+	// A linked program: the render pipeline state for one key, with both stages' argument-table slots.
+	class program
+	{
+	public:
+		object pipeline;
+		std::vector<resource_slot> vertex_slots;
+		std::vector<resource_slot> fragment_slots;
+		std::string error;
+
+		bool valid() const { return !!pipeline; }
+
+		// The Metal slot of a GLSL (set, binding) of each stage, or umax when the stage does not declare it.
+		u32 vertex_buffer_slot(u32 location) const;
+		u32 vertex_texture_slot(u32 location) const;
+		u32 vertex_sampler_slot(u32 location) const;
+		u32 fragment_buffer_slot(u32 location) const;
+		u32 fragment_texture_slot(u32 location) const;
+		u32 fragment_sampler_slot(u32 location) const;
+		bool fragment_reads_push_constants() const;
+	};
+
+	struct MTLTraits
+	{
+		using vertex_program_type = mtl::vertex_program;
+		using fragment_program_type = mtl::fragment_program;
+		using pipeline_type = mtl::program;
+		using pipeline_storage_type = std::unique_ptr<mtl::program>;
+		using pipeline_properties = mtl::pipeline_props;
+
+		static void recompile_fragment_program(const RSXFragmentProgram& RSXFP, fragment_program_type& fragmentProgramData, usz ID);
+		static void recompile_vertex_program(const RSXVertexProgram& RSXVP, vertex_program_type& vertexProgramData, usz ID);
+		static void validate_pipeline_properties(const vertex_program_type& vp, const fragment_program_type& fp, pipeline_properties& properties);
+		static pipeline_type* build_pipeline(
+			const vertex_program_type& vertexProgramData,
+			const fragment_program_type& fragmentProgramData,
+			const pipeline_properties& pipelineProperties,
+			bool compile_async,
+			std::function<pipeline_type*(pipeline_storage_type&)> callback);
+	};
+
+	struct program_cache : public program_state_cache<MTLTraits>
+	{
+		program_cache(decompiler_callback_t callback)
+		{
+			notify_pipeline_compiled = callback;
+		}
+
+		u64 get_hash(const mtl::pipeline_props& props)
+		{
+			return rpcs3::hash_struct<mtl::pipeline_props>(props);
+		}
+
+		u64 get_hash(const RSXVertexProgram& prog)
+		{
+			return program_hash_util::vertex_program_utils::get_vertex_program_ucode_hash(prog);
+		}
+
+		u64 get_hash(const RSXFragmentProgram& prog)
+		{
+			return program_hash_util::fragment_program_utils::get_fragment_program_ucode_hash(prog);
+		}
+
+		bool check_cache_missed() const
+		{
+			return m_cache_miss_flag;
+		}
+
+		// M5: the rsx::shaders_cache backend (VKProgramBuffer.h): a record's programs, then its pipeline, built without
+		// a disk notification (the record exists already).
+		void preload_programs(rsx::program_cache_hint_t* cache_hint, const RSXVertexProgram& vp, const RSXFragmentProgram& fp)
+		{
+			search_vertex_program(cache_hint, vp);
+			search_fragment_program(cache_hint, fp);
+		}
+
+		void add_pipeline_entry(const RSXVertexProgram& vp, const RSXFragmentProgram& fp, mtl::pipeline_props& props)
+		{
+			get_graphics_pipeline(nullptr, vp, fp, props, false, false);
+		}
+		// M5 end
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLQueries.cpp b/rpcs3/Emu/RSX/Metal/MTLQueries.cpp
new file mode 100644
index 0000000..c0c9077
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLQueries.cpp
@@ -0,0 +1,522 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): ZCULL occlusion queries of the native Metal 4 renderer (see MTLQueries.h), and what the
+// Vulkan renderer does around them: ZCULL sync hints, report pages, semaphore waits and native UI flips.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/system_config.h"
+#ifdef RPCS3_IOS
+#include "ios/IOSEarlySubmit.h"     // M5
+#include "ios/IOSRsxSyncProfile.h"  // M5
+#endif
+
+#include <atomic>
+#include <cstring>
+
+namespace
+{
+	bool precise_zpass_count()
+	{
+		return !!g_cfg.video.precise_zpass_count;
+	}
+}
+
+void MTLGSRender::init_queries()
+{
+	m_query_buffer = mtl::new_buffer(m_device, static_cast<u64>(query_slot_count) * sizeof(u64), mtl::storage_mode::shared);
+	ensure(m_query_buffer, "Metal visibility result buffer");
+	std::memset(mtl::buffer_contents(m_query_buffer), 0, static_cast<usz>(query_slot_count) * sizeof(u64));
+	m_commands.make_resident(m_query_buffer);
+
+	m_query_slots.reset(query_slot_count);
+	m_query_records.assign(rsx::reports::occlusion_query_count, {});
+
+	// VKGSRender::VKGSRender: each RSX query slot names its record.
+	for (u32 n = 0; n < rsx::reports::occlusion_query_count; ++n)
+	{
+		m_occlusion_query_data[n].driver_handle = n;
+	}
+}
+
+void MTLGSRender::destroy_queries()
+{
+	m_query_records.clear();
+	m_query_slots.reset(0);
+	m_commands.dispose(std::move(m_query_buffer), true);
+	m_active_query_info = nullptr;
+	m_occlusion_query_active = false;
+	m_query_segment_pass = 0;
+}
+
+u64 MTLGSRender::query_slot_value(u32 slot) const
+{
+	// Read after the submission that writes the slot has signalled (an acquire fence follows every completion read).
+	return static_cast<const volatile u64*>(mtl::buffer_contents(m_query_buffer))[slot];
+}
+
+bool MTLGSRender::query_segment_open() const
+{
+	return m_query_segment_pass && m_commands.kind() == mtl::command_context::encoder_kind::render &&
+		m_commands.render_pass_id() == m_query_segment_pass;
+}
+
+void MTLGSRender::release_query_record(mtl::occlusion_record& record)
+{
+	// A slot becomes reusable once the submission that writes it has completed.
+	for (const auto& segment : record.segments)
+	{
+		ensure(m_query_slots.release(segment.slot, segment.fence));
+	}
+	record.clear();
+}
+
+void MTLGSRender::fold_queries(bool all)
+{
+	const u64 completed = m_commands.completed();
+	std::atomic_thread_fence(std::memory_order_acquire);
+
+	const bool precise = precise_zpass_count();
+	const auto read = [this](u32 slot) { return query_slot_value(slot); };
+	const auto release = [this](u32 slot, u64 fence) { ensure(m_query_slots.release(slot, fence)); };
+
+	u32 folded = 0;
+	if (all)
+	{
+		for (auto& record : m_query_records)
+		{
+			if (!record.segments.empty())
+			{
+				folded += mtl::fold_completed(record, completed, precise, read, release);
+			}
+		}
+	}
+	else if (m_occlusion_query_active)
+	{
+		folded += mtl::fold_completed(m_query_records[m_active_query_info->driver_handle], completed, precise, read, release);
+	}
+
+	m_query_slots.collect(completed);
+	if (folded)
+	{
+		mtl::m4_count(mtl::get_m4_counters().query_folded_segments, folded);
+	}
+}
+
+bool MTLGSRender::reserve_query_slot()
+{
+	if (!m_occlusion_query_active)
+	{
+		return true;
+	}
+
+	const auto& record = m_query_records[m_active_query_info->driver_handle];
+	if (record.decided(precise_zpass_count()) || (query_segment_open() && !m_render_pass_dirty))
+	{
+		// No new segment: the value is known, or this encoder keeps counting.
+		return true;
+	}
+
+	if (m_query_slots.available() || m_query_slots.collect(m_commands.completed()))
+	{
+		return true;
+	}
+
+	// VKDraw.cpp emit_geometry: out of free occlusion slots, a ZCULL hard sync retires the pending reports.
+	mtl::m4_count(mtl::get_m4_counters().query_slot_exhaustions);
+	if (mtl::m4_first_failure(mtl::m4_failure::query_slots_exhausted))
+	{
+		rsx_log.warning("[Performance Warning] Out of free occlusion slots. Forcing hard sync. (Metal M4: logged once, counted in COREPROF METAL M4)");
+	}
+
+	ZCULL_control::sync(this);
+	if (m_query_slots.collect(m_commands.completed()) || m_query_slots.available())
+	{
+		return true;
+	}
+
+	// Where the Vulkan renderer would force a result of 1: every recorded segment completes, and the completed prefix of
+	// each query is read now (the same additions, in the gather's order) and its slots freed.
+	flush_command_queue(true);
+	fold_queries(true);
+	return m_query_slots.available() > 0;
+}
+
+void MTLGSRender::begin_query_segment(const mtl::object& encoder)
+{
+	if (!m_occlusion_query_active)
+	{
+		return;
+	}
+
+	auto& record = m_query_records[m_active_query_info->driver_handle];
+	const u64 fence = m_commands.last_submitted() + 1;  // the submission being recorded
+
+	// VK set_sync_command_buffer / cb_has_occlusion_task: the query now has work in this command buffer.
+	record.last_fence = fence;
+	m_query_cb_fence = fence;
+
+	if (record.decided(precise_zpass_count()) || query_segment_open())
+	{
+		return;
+	}
+
+	const u32 slot = m_query_slots.allocate();
+	ensure(slot != umax, "Metal: no visibility slot after reserve_query_slot");
+
+	// Not written by the GPU any more (its submission completed): zeroed, then accumulated into by this encoder.
+	static_cast<volatile u64*>(mtl::buffer_contents(m_query_buffer))[slot] = 0;
+
+	record.segments.push_back({ slot, fence });
+	record.has_data = true;
+	mtl::set_visibility_result_mode(encoder, mtl::visibility_result_mode::counting, static_cast<u64>(slot) * sizeof(u64));
+	m_query_segment_pass = m_render_pass_serial;
+	mtl::m4_count(mtl::get_m4_counters().query_segments);
+}
+
+void MTLGSRender::suspend_query_segment()
+{
+	if (query_segment_open())
+	{
+		mtl::set_visibility_result_mode(m_commands.encoder(), mtl::visibility_result_mode::disabled, 0);
+	}
+
+	m_query_segment_pass = 0;
+}
+
+void MTLGSRender::begin_occlusion_query(rsx::reports::occlusion_query_info* query)
+{
+	ensure(!m_occlusion_query_active);
+
+	query->result = 0;
+	m_active_query_info = query;
+	m_occlusion_query_active = true;
+	m_query_segment_pass = 0;
+
+	// The slot was freed by a read or a discard; nothing measured before belongs to this query.
+	auto& record = m_query_records[query->driver_handle];
+	if (record.has_data || !record.segments.empty())
+	{
+		release_query_record(record);
+	}
+
+	mtl::m4_count(mtl::get_m4_counters().queries_begun);
+}
+
+void MTLGSRender::end_occlusion_query(rsx::reports::occlusion_query_info* query)
+{
+	ensure(query == m_active_query_info);
+
+	// NOTE (VK): flushing the queue is very expensive, do not flush just because query stopped
+	suspend_query_segment();
+
+	m_occlusion_query_active = false;
+	m_active_query_info = nullptr;
+}
+
+bool MTLGSRender::check_occlusion_query_status(rsx::reports::occlusion_query_info* query)
+{
+	if (!query->num_draws)
+	{
+		return true;
+	}
+
+	const auto& record = m_query_records[query->driver_handle];
+	const u64 completed = m_commands.completed();
+	std::atomic_thread_fence(std::memory_order_acquire);
+
+	return mtl::occlusion_ready(record, m_commands.last_submitted(), completed, precise_zpass_count(),
+		[this](u32 slot) { return query_slot_value(slot); });
+}
+
+void MTLGSRender::get_occlusion_query_result(rsx::reports::occlusion_query_info* query)
+{
+	auto& record = m_query_records[query->driver_handle];
+	if (!record.has_data)
+	{
+		return;
+	}
+
+	if (query->num_draws)
+	{
+		if (record.last_fence > m_commands.last_submitted())
+		{
+			// The work is still being recorded: submit it (VK flush_command_queue + busy_wait)
+			mtl::m4_count(mtl::get_m4_counters().query_hard_syncs);
+			flush_command_queue(false);
+			m_zcull_flush_pending = false;
+
+			rsx_log.warning("[Performance warning] Unexpected ZCULL read caused a hard sync");
+		}
+
+		const auto wait = [this](u64 fence)
+		{
+			if (m_commands.completed() < fence)
+			{
+				mtl::m4_count(mtl::get_m4_counters().query_gpu_waits);
+				m_commands.wait(fence);
+			}
+			std::atomic_thread_fence(std::memory_order_acquire);
+		};
+
+		query->result += mtl::occlusion_gather(record, precise_zpass_count(), wait, [this](u32 slot) { return query_slot_value(slot); });
+		mtl::m4_count(mtl::get_m4_counters().query_results);
+	}
+
+	release_query_record(record);
+}
+
+void MTLGSRender::discard_occlusion_query(rsx::reports::occlusion_query_info* query)
+{
+	if (m_active_query_info == query)
+	{
+		end_occlusion_query(query);
+	}
+
+	auto& record = m_query_records[query->driver_handle];
+	if (!record.has_data)
+	{
+		return;
+	}
+
+	release_query_record(record);
+	mtl::m4_count(mtl::get_m4_counters().query_discards);
+}
+
+void MTLGSRender::sync_hint(rsx::FIFO::interrupt_hint hint, rsx::reports::sync_hint_payload_t payload)
+{
+	// VKGSRender::sync_hint
+	rsx::thread::sync_hint(hint, payload);
+
+	if (!m_commands.recording() || m_query_cb_fence != m_commands.last_submitted() + 1)
+	{
+		// Occlusion queries not enabled in the command buffer being recorded, do nothing
+		return;
+	}
+
+	// Occlusion test result evaluation is coming up, avoid a hard sync
+	switch (hint)
+	{
+	case rsx::FIFO::interrupt_hint::conditional_render_eval:
+	{
+		// If a flush request is already enqueued, do nothing
+		if (m_zcull_flush_pending)
+		{
+			return;
+		}
+
+		// If the result is not going to be read by CELL, do nothing
+		const auto ref_addr = static_cast<u32>(payload.address);
+		if (!zcull_ctrl->is_query_result_urgent(ref_addr))
+		{
+			// No effect on CELL behaviour, it will be faster to handle this in RSX code
+			return;
+		}
+
+		// OK, cell will be accessing the results, probably.
+		// Try to avoid flush spam, it is more costly to flush the CB than it is to just upload the vertex data
+		const auto now = get_system_time();
+		if ((now - m_last_cond_render_eval_hint) > 50)
+		{
+			// Schedule a sync on the next loop iteration
+			m_zcull_flush_pending = true;
+		}
+
+		m_last_cond_render_eval_hint = now;
+		break;
+	}
+	case rsx::FIFO::interrupt_hint::zcull_sync:
+	{
+		// Check if the required report is synced to this CB
+		const auto& record = m_query_records[payload.query->driver_handle];
+		if (!record.has_data || record.last_fence <= m_commands.last_submitted())
+		{
+			return;
+		}
+
+		// Unavoidable hard sync coming up, flush immediately
+		flush_command_queue(false);
+		mtl::m4_count(mtl::get_m4_counters().query_hint_flushes);
+#ifdef RPCS3_IOS
+		rpcs3::ios::rsx_sync::zcull_hint_flushes.fetch_add(1, std::memory_order_relaxed);  // M5: as VKGSRender
+#endif
+
+		// Clear without wait
+		m_zcull_flush_pending = false;
+		break;
+	}
+	}
+}
+
+// The ZCULL parts of MTLGSRender::do_local_task and on_semaphore_acquire_wait (MTLGSRender.cpp), as VKGSRender has
+// them; the report-page faults reach zcull_ctrl->on_access_violation from MTLGSRender::on_access_violation.
+
+bool MTLGSRender::service_zcull_flush()
+{
+	// VKGSRender::do_local_task: the flush scheduled by a conditional render evaluation hint (m_flush_requests); true
+	// when it ran (the texture cache update then waits for the next iteration, as there)
+	if (!m_zcull_flush_pending)
+	{
+		return false;
+	}
+
+	m_zcull_flush_pending = false;
+	flush_command_queue(false);
+	return true;
+}
+
+bool MTLGSRender::zcull_semaphore_wait_pending() const
+{
+	return m_zcull_flush_pending || (m_eng_interrupt_mask & rsx::pipe_flush_interrupt);
+}
+
+void MTLGSRender::service_zcull_semaphore_wait()
+{
+#ifdef RPCS3_IOS
+	// VKGSRender::on_semaphore_acquire_wait (RPCS3_IOS): the outer FIFO loop normally updates ZCULL. An acquire blocks
+	// that loop: completed reports must also progress here, or a PPU producer waiting for them can never release this
+	// acquire. Throttled as in the Vulkan renderer.
+	if ((++m_semaphore_wait_polls & 15) != 0)
+	{
+		return;
+	}
+
+	const u64 now = get_system_time();
+	if (now < m_next_semaphore_service)
+	{
+		return;
+	}
+
+	m_next_semaphore_service = now + 1'000;
+	if (zcull_ctrl)
+	{
+		zcull_ctrl->update(this);
+	}
+#endif
+}
+
+void MTLGSRender::service_native_ui_flip(rsx::FIFO::state state)
+{
+	// VKGSRender::do_local_task: the native interface asks for frames when the guest does not present (dialogs over a
+	// paused or waiting game).
+	if (state == rsx::FIFO::state::lock_wait || !m_overlay_manager)
+	{
+		return;
+	}
+
+	const auto should_ignore = in_begin_end && state != rsx::FIFO::state::empty;
+	if ((async_flip_requested & flip_request::native_ui) && !should_ignore && !is_stopped())
+	{
+		flush_command_queue(true);
+		rsx::display_flip_info_t info{};
+		info.buffer = current_display_buffer;
+		flip(info);
+	}
+}
+
+#ifdef RPCS3_IOS
+// M5: the iOS ZCULL hooks of VKGSRender (RSXZCULL.h, ios/IOSZcullWatched.h).
+
+u64 MTLGSRender::ios_open_cb_serial(rsx::reports::occlusion_query_info* query)
+{
+	// VKGSRender::ios_open_cb_serial: the open command buffer's serial while the query has host queries in it, under
+	// the condition on which sync_hint(zcull_sync) submits it (cb_has_occlusion_task, is_current, indices); 0
+	// otherwise. The recording fence is the command buffer's serial.
+	const auto& record = m_query_records[query->driver_handle];
+	const u64 recording = m_commands.last_submitted() + 1;
+	return (m_commands.recording() && m_query_cb_fence == recording && record.has_data && record.last_fence == recording) ? recording : 0;
+}
+
+rpcs3::ios::zcull_watched::arm_result MTLGSRender::ios_arm_watched_submit(rsx::reports::occlusion_query_info* query)
+{
+	// VKGSRender::ios_arm_watched_submit. Metal has no other early submission (CELL561), so an armed one is always
+	// a watched one; the per-frame cap and the frame's watched budget are the same.
+	namespace early = rpcs3::ios::early_submit;
+	namespace watched = rpcs3::ios::zcull_watched;
+	if (!early::enabled.load(std::memory_order_relaxed) || !early::at_pass_boundary.load(std::memory_order_relaxed))
+	{
+		return watched::arm_result::off;
+	}
+
+	if (!ios_open_cb_serial(query))
+	{
+		return watched::arm_result::submitted;
+	}
+
+	if (m_ios_armed_draws)
+	{
+		return watched::arm_result::joined;
+	}
+
+	if (m_ios_early_submits_this_frame >= early::max_per_frame || !m_ios_watched_budget.available(int_flip_index))
+	{
+		return watched::arm_result::capped;
+	}
+
+	m_ios_armed_draws = 1;
+	early::armed.fetch_add(1, std::memory_order_relaxed);
+	return watched::arm_result::armed;
+}
+
+void MTLGSRender::ios_watched_submit_at_boundary(bool after_textures)
+{
+	// VKGSRender::ios_early_submit_at_boundary: taken when no render pass is open and the recording is interruptible.
+	namespace early = rpcs3::ios::early_submit;
+	if (!m_ios_armed_draws)
+	{
+		return;
+	}
+
+	const bool pass_open = m_commands.kind() == mtl::command_context::encoder_kind::render;
+	if (!early::take_at_boundary(m_ios_armed_draws, pass_open, !m_offloader_deadlock))
+	{
+		return;
+	}
+
+	(after_textures ? early::boundary_textures : early::boundary_starts).fetch_add(1, std::memory_order_relaxed);
+	m_ios_watched_budget.consume();
+	auto& tally = rpcs3::ios::zcull_watched::counters();
+	(after_textures ? tally.taken_textures : tally.taken_start).fetch_add(1, std::memory_order_relaxed);
+	ios_take_watched_submit();
+}
+
+void MTLGSRender::ios_watched_submit_at_draw_end()
+{
+	// VKGSRender::ios_early_submit, the armed part: after max_deferred_draws more draws, at the end of a draw.
+	namespace early = rpcs3::ios::early_submit;
+	if (!m_ios_armed_draws || m_offloader_deadlock)
+	{
+		return;
+	}
+
+	if (early::at_draw_end(++m_ios_armed_draws) != early::deferral::fallback)
+	{
+		return;
+	}
+
+	early::fallback_submits.fetch_add(1, std::memory_order_relaxed);
+	m_ios_watched_budget.consume();
+	rpcs3::ios::zcull_watched::counters().fallback.fetch_add(1, std::memory_order_relaxed);
+	ios_take_watched_submit();
+}
+
+void MTLGSRender::ios_take_watched_submit()
+{
+	// VKGSRender::ios_take_early_submit
+	m_ios_armed_draws = 0;
+	flush_command_queue(false);
+	m_ios_early_submits_this_frame++;
+	rpcs3::ios::early_submit::submits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void MTLGSRender::ios_on_submit()
+{
+	// VKGSRender::flush_command_queue: any other submission carries the armed draws, and with them a watched report.
+	if (m_ios_armed_draws)
+	{
+		m_ios_armed_draws = 0;
+		rpcs3::ios::early_submit::disarmed.fetch_add(1, std::memory_order_relaxed);
+		rpcs3::ios::zcull_watched::counters().carried.fetch_add(1, std::memory_order_relaxed);
+	}
+}
+#endif
diff --git a/rpcs3/Emu/RSX/Metal/MTLQueries.h b/rpcs3/Emu/RSX/Metal/MTLQueries.h
new file mode 100644
index 0000000..813a77e
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLQueries.h
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): ZCULL occlusion queries of the native Metal 4 renderer, on Metal visibility results with
+// the Vulkan renderer's semantics (VKGSRender.cpp begin/end/check/get/discard_occlusion_query, VKQueryPool.cpp).
+//
+// An RSX query (rsx::reports::occlusion_query_info) is measured in segments. A segment is one 8-byte slot of the
+// renderer's visibility result buffer, counted (MTLVisibilityResultModeCounting) by the draws of one render encoder:
+// Metal visibility counting ends with its encoder, as the Vulkan renderer's host query ends with its command buffer, so
+// a query open across encoders or submissions gets one segment in each. Slots are zeroed by the CPU before use and the
+// passes accumulate into them; clears are not counted (vkCmdClearAttachments is not a draw).
+//
+// Results are those of the GPU, read only once the submission that recorded a segment has signalled the renderer's
+// shared event, with the Vulkan renderer's rules:
+//   - check: not ready while the query's last segment is in the command buffer being recorded (VK is_current); then the
+//     segments oldest first: one not complete makes the query not ready, one with samples makes it ready unless the
+//     exact count is requested (Precise ZCULL), all complete make it ready (the RPCS3_IOS variant, which never waits);
+//   - gather: the segments oldest first, each one waited for, summed as Vulkan's 32-bit results, stopping at the first
+//     sample unless the exact count is requested.
+// A slot is reused only after the submission that writes it has completed. When the pool is exhausted, the renderer
+// does what the Vulkan renderer does (a ZCULL hard sync) and then folds the completed prefix of each query: the same
+// additions in the same order, done earlier, so the result is unchanged (where Vulkan would force a result of 1).
+
+#include "util/types.hpp"
+
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace mtl
+{
+	// The slots of the visibility result buffer.
+	class visibility_slot_pool
+	{
+	public:
+		explicit visibility_slot_pool(u32 capacity = 0)
+		{
+			reset(capacity);
+		}
+
+		void reset(u32 capacity)
+		{
+			m_capacity = capacity;
+			m_free.clear();
+			m_pending.clear();
+			m_in_use.assign(capacity, false);
+			m_free.reserve(capacity);
+			for (u32 slot = capacity; slot > 0; --slot)
+			{
+				m_free.push_back(slot - 1);
+			}
+		}
+
+		u32 capacity() const { return m_capacity; }
+		u32 available() const { return static_cast<u32>(m_free.size()); }
+		u32 pending() const { return static_cast<u32>(m_pending.size()); }
+		u32 in_use() const { return m_capacity - available() - pending(); }
+
+		// A free slot, or umax when every slot is in use or waiting for its submission.
+		u32 allocate()
+		{
+			if (m_free.empty())
+			{
+				return umax;
+			}
+
+			const u32 slot = m_free.back();
+			m_free.pop_back();
+			m_in_use[slot] = true;
+			return slot;
+		}
+
+		// The slot may be written by the GPU until `fence` has completed. False for a slot that is not in use.
+		bool release(u32 slot, u64 fence)
+		{
+			if (slot >= m_capacity || !m_in_use[slot])
+			{
+				return false;
+			}
+
+			m_in_use[slot] = false;
+			m_pending.emplace_back(fence, slot);
+			return true;
+		}
+
+		// Makes the slots whose submissions have completed free again; returns how many.
+		u32 collect(u64 completed)
+		{
+			u32 count = 0;
+			for (usz index = 0; index < m_pending.size();)
+			{
+				if (m_pending[index].first <= completed)
+				{
+					m_free.push_back(m_pending[index].second);
+					m_pending[index] = m_pending.back();
+					m_pending.pop_back();
+					count++;
+					continue;
+				}
+				index++;
+			}
+			return count;
+		}
+
+	private:
+		std::vector<u32> m_free;
+		std::vector<std::pair<u64, u32>> m_pending;  // fence, slot
+		std::vector<bool> m_in_use;
+		u32 m_capacity = 0;
+	};
+
+	struct occlusion_segment
+	{
+		u32 slot = 0;
+		u64 fence = 0;  // the submission that records it (the command context's shared event value)
+	};
+
+	// What the renderer measured for one RSX query (VK occlusion_data).
+	struct occlusion_record
+	{
+		std::vector<occlusion_segment> segments;  // oldest first; fences never decrease
+		u32 folded = 0;           // the gathered value of the segments already read (see fold_completed)
+		bool has_data = false;    // a segment was recorded since the query began (VK: indices not empty)
+		u64 last_fence = 0;       // the submission of the last segment (VK: the command buffer to wait for)
+
+		// Precise counting off and a sample already found: later segments cannot change the value (VK stops there).
+		bool decided(bool precise) const
+		{
+			return !precise && folded != 0;
+		}
+
+		void clear()
+		{
+			segments.clear();
+			folded = 0;
+			has_data = false;
+			last_fence = 0;
+		}
+	};
+
+	// VKGSRender::check_occlusion_query_status (RPCS3_IOS variant) for a query with draws. `read(slot)` is the slot's
+	// value and is called only for a segment whose submission has completed.
+	template <typename Read>
+	bool occlusion_ready(const occlusion_record& record, u64 last_submitted, u64 completed, bool precise, Read&& read)
+	{
+		if (!record.has_data)
+		{
+			return true;
+		}
+
+		if (record.last_fence > last_submitted)
+		{
+			// The query is in the command buffer being recorded
+			return false;
+		}
+
+		if (record.decided(precise))
+		{
+			return true;
+		}
+
+		for (const auto& segment : record.segments)
+		{
+			if (segment.fence > completed)
+			{
+				return false;
+			}
+
+			if (!precise && read(segment.slot))
+			{
+				// Ready and known: the gather stops at this hit without waiting
+				return true;
+			}
+		}
+
+		return true;
+	}
+
+	// VKGSRender::get_occlusion_query_result's gather (after the submission of the query's work): `wait(fence)` returns
+	// once that submission has completed, `read(slot)` is the slot's value. Vulkan returns 32-bit results.
+	template <typename Wait, typename Read>
+	u32 occlusion_gather(const occlusion_record& record, bool precise, Wait&& wait, Read&& read)
+	{
+		u32 result = record.folded;
+		if (record.decided(precise))
+		{
+			return result;
+		}
+
+		for (const auto& segment : record.segments)
+		{
+			wait(segment.fence);
+			result += static_cast<u32>(read(segment.slot));
+			if (result && !precise)
+			{
+				// We only need one hit unless precise zcull is requested
+				break;
+			}
+		}
+
+		return result;
+	}
+
+	// Reads the completed prefix of a record into `folded`, exactly as the gather would read it, and releases those
+	// slots. Once the value is decided (a sample found, precise counting off), the remaining segments are released
+	// unread: the gather never reads them. Returns the number of segments released.
+	template <typename Read, typename Release>
+	u32 fold_completed(occlusion_record& record, u64 completed, bool precise, Read&& read, Release&& release)
+	{
+		usz index = 0;
+		for (; index < record.segments.size() && !record.decided(precise); ++index)
+		{
+			const auto& segment = record.segments[index];
+			if (segment.fence > completed)
+			{
+				break;
+			}
+
+			record.folded += static_cast<u32>(read(segment.slot));
+			release(segment.slot, segment.fence);
+		}
+
+		if (record.decided(precise))
+		{
+			for (usz rest = index; rest < record.segments.size(); ++rest)
+			{
+				release(record.segments[rest].slot, record.segments[rest].fence);
+			}
+			index = record.segments.size();
+		}
+
+		record.segments.erase(record.segments.begin(), record.segments.begin() + index);
+		return static_cast<u32>(index);
+	}
+}
