+	}
+
+	ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu capture=%u part=end", session, s_ppu_captures);
+
+	// REWINDBOX_SPU_PROFILE_923: the SPU threads of the same capture.
+	ios_freeze_dump.notice("COREPROF SPUPROF923 session=%llu capture=%u part=begin samples=%u period_us=1000 elapsed_us=%llu spu_threads=%u "
+		"tracked=%u region_bytes=256 pc_scope=last_compiled_chunk_entry_or_call_out top_fields=region:samples:first_pc "
+		"wait_calls_scope=last_named_call wait_sites_scope=flags_then_instruction_at_saved_pc", session, s_ppu_captures,
+		run.samples, run.ended_us - run.started_us, run.spu_listed, run.spu_count);
+
+	for (u32 i = 0; i < run.spu_count; i++)
+	{
+		const auto& h = run.spu_tracked[i];
+		std::string calls;
+
+		for (const auto& [call, count] : run.spu_wait_calls[i])
+		{
+			if (count)
+			{
+				fmt::append(calls, "%s%s:%u", calls.empty() ? "" : ",", sanitize_token(call ? call : "guest_code"), count);
+			}
+		}
+
+		// REWINDBOX_SPU_WAIT_SITE_930: every site with at least one waiting sample, in the classifier's order.
+		std::string sites;
+
+		for (u32 k = 0; k < rpcs3::ios::spu_wait_site::count; k++)
+		{
+			if (const u32 n = run.spu_wait_sites[i][k])
+			{
+				fmt::append(sites, "%s%s:%u", sites.empty() ? "" : ",", rpcs3::ios::spu_wait_site::names[k], n);
+			}
+		}
+
+		std::string line = fmt::format("COREPROF SPUPROF923 session=%llu capture=%u part=thread id=0x%x name=%s running=%llu "
+			"waiting=%llu same_pc=%llu distinct=%u overflow=%llu wait_sites=%s wait_calls=%s top=%s", session, s_ppu_captures, h.thread_id,
+			run.spu_names[i].empty() ? std::string("-") : sanitize_token(run.spu_names[i]), h.running, h.waiting, h.same_pc, h.distinct, h.overflow,
+			sites.empty() ? std::string("-") : sites, calls.empty() ? std::string("-") : calls, h.top(24));
+		ios_freeze_dump.notice("%s", bound_line(line));
+	}
+
+	ios_freeze_dump.notice("COREPROF SPUPROF923 session=%llu capture=%u part=end", session, s_ppu_captures);
+}
+}
+
+void rewindbox_capture912_tick(unsigned long long session)
+{
+	const system_state status = Emu.GetStatus(false);
+	const bool running = status == system_state::running;
+	namespace trace = capture::putllc_trace;
+
+	if (s_boot.enter(session))
+	{
+		// Another boot: the per-boot limits start again, a start request of the previous game starts nothing, and a
+		// capture of the previous boot ends now; it is exported under the session that started it.
+
+		if (trace::is_collecting())
+		{
+			s_putllc_end = "session_change";
+			trace::stop();
+		}
+
+		if (s_ppu)
+		{
+			s_ppu->stop.store(true, std::memory_order_relaxed);
+		}
+	}
+
+	// The explicit start: the host wrote "Enabled" to the capture's setting when its in-game menu closed
+	// (ios/IOSCapture912.h, start_request). A request that cannot be served says why in the journal.
+	// REWINDBOX_AUTO_STORM_CAPTURE_917: the report's own request for the trace is served like the host's.
+	const bool start_putllc_menu = capture::start_request::take(capture::start_request::putllc, running);
+	const bool start_putllc_auto = capture::start_request::take(capture::start_request::auto_putllc, running);
+	const bool start_putllc = start_putllc_menu || start_putllc_auto;
+	const char* const putllc_trigger = start_putllc_menu ? "menu_closed" : "auto_heavy_putllc";
+	// REWINDBOX_AUTO_PPU_PROFILE_916: the report's own request is served like the host's, and says so in trigger=.
+	const bool start_ppu_menu = capture::start_request::take(capture::start_request::ppu, running);
+	const bool start_ppu_auto = capture::start_request::take(capture::start_request::auto_ppu, running);
+	const bool start_ppu_storm = capture::start_request::take(capture::start_request::auto_ppu_storm, running); // REWINDBOX_AUTO_STORM_CAPTURE_917
+	const bool start_ppu_spu = capture::start_request::take(capture::start_request::auto_spu, running); // REWINDBOX_SPU_PROFILE_923
+	const bool start_ppu = start_ppu_menu || start_ppu_auto || start_ppu_storm || start_ppu_spu;
+	const char* const ppu_trigger_917 = start_ppu_menu ? "menu_closed" : start_ppu_auto ? "auto_ppu_bound" : "auto_heavy_putllc";
+	const char* const ppu_trigger = start_ppu_spu && !start_ppu_menu && !start_ppu_auto && !start_ppu_storm ? "auto_spu_bound" : ppu_trigger_917;
+	bool putllc_started = false;
+
+	// Heavy PUTLLC trace.
+	if (start_putllc)
+	{
+		const capture::refusal why = capture::serve_putllc(s_boot, utils::get_tsc());
+
+		if (why != capture::refusal::none)
+		{
+			ios_freeze_dump.notice("COREPROF PUTLLCTRACE912 session=%llu part=refused reason=%s max=%u trigger=%s", session, capture::refusal_name(why),
+				trace::max_captures, putllc_trigger);
+		}
+		else
+		{
+			putllc_started = true;
+			s_putllc_started_us = get_system_time();
+			s_putllc_session = session;
+			s_putllc_number = s_boot.putllc;
+			ios_freeze_dump.notice("COREPROF PUTLLCTRACE912 session=%llu capture=%u part=armed trigger=%s capacity=%u max_threads=%u max_ms=%u",
+				s_putllc_session, s_putllc_number, putllc_trigger, static_cast<u32>(trace::capacity), static_cast<u32>(trace::max_threads),
+				static_cast<u32>(trace::max_capture_ns / 1'000'000));
+		}
+	}
+
+	if (putllc_started)
+	{
+	}
+	else if (trace::is_collecting())
+	{
+		const u64 elapsed = get_system_time() - s_putllc_started_us;
+
+		if (trace::full() || elapsed * 1000 >= trace::max_capture_ns || !running)
+		{
+			s_putllc_end = trace::full() ? "full" : running ? "time" : "not_running";
+			trace::stop();
+		}
+	}
+	else if (trace::quiescent())
+	{
+		for (const std::string& line : trace::format_capture(s_putllc_number, s_putllc_session, utils::get_tsc_freq(),
+			get_system_time() - s_putllc_started_us, s_putllc_end))
+		{
+			ios_freeze_dump.notice("%s", line);
+		}
+
+		trace::release();
+	}
+
+	// PPU region profile.
+	if (s_ppu)
+	{
+		if (start_ppu)
+		{
+			ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu part=refused reason=%s max=%u trigger=%s", session,
+				capture::refusal_name(capture::admit_ppu(s_boot, true)), capture::ppu_profile::max_captures, ppu_trigger);
+		}
+
+		if (!running)
+		{
+			s_ppu->stop.store(true, std::memory_order_relaxed);
+		}
+
+		if (s_ppu->done.load(std::memory_order_acquire))
+		{
+			s_ppu->worker.join();
+			emit_ppu_profile(*s_ppu);
+			delete s_ppu;
+			s_ppu = nullptr;
+		}
+	}
+	else if (start_ppu && capture::admit_ppu(s_boot, false) != capture::refusal::none)
+	{
+		ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu part=refused reason=%s max=%u trigger=%s", session,
+			capture::refusal_name(capture::admit_ppu(s_boot, false)), capture::ppu_profile::max_captures, ppu_trigger);
+	}
+	else if (start_ppu)
+	{
+		auto run = std::make_unique<ppu_sampling>();
+
+		{
+			// The same try-locked reader pattern as the freeze dump: a busy lock skips this capture.
+			std::shared_lock idm_reader(id_manager::g_mutex, std::try_to_lock);
+
+			if (idm_reader.owns_lock() && g_fxo->is_init<id_manager::id_map<named_thread<ppu_thread>>>())
+			{
+				idm::select<named_thread<ppu_thread>>([&](u32 id, named_thread<ppu_thread>&)
+				{
+					if (auto ptr = idm::get_unlocked<named_thread<ppu_thread>>(id))
+					{
+						run->threads.emplace_back(std::move(ptr));
+					}
+				}, idm::unlocked);
+
+				// REWINDBOX_SPU_PROFILE_923: the SPU threads, under the same reader.
+				if (g_fxo->is_init<id_manager::id_map<named_thread<spu_thread>>>())
+				{
+					idm::select<named_thread<spu_thread>>([&](u32 id, named_thread<spu_thread>&)
+					{
+						run->spu_listed++;
+
+						if (run->spu_count < rpcs3::ios::auto_spu_profile::max_threads)
+						{
+							if (auto ptr = idm::get_unlocked<named_thread<spu_thread>>(id))
+							{
+								run->spu_threads.emplace_back(std::move(ptr));
+								run->spu_count++;
+							}
+						}
+					}, idm::unlocked);
+				}
+			}
+		}
+
+		if (!run->threads.empty())
+		{
+			run->started_us = get_system_time();
+			run->session = session;
+			run->number = ++s_boot.ppu;
+			const u32 listed = static_cast<u32>(run->threads.size());
+			s_ppu = run.release();
+			s_ppu->worker = std::thread([state = s_ppu] { state->run(); });
+			ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu capture=%u part=armed trigger=%s threads=%u max_samples=%u",
+				session, s_ppu->number, ppu_trigger, listed, capture::ppu_profile::max_samples);
+		}
+		else
+		{
+			// The thread list is read under a try-lock; busy, or no PPU thread yet.
+			ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu part=refused reason=thread_list_unavailable trigger=%s", session, ppu_trigger);
+		}
+	}
 }
diff --git a/rpcs3/ios/RPCS3IOSFreezeDump.h b/rpcs3/ios/RPCS3IOSFreezeDump.h
index 214e4fe..411dec0 100644
--- a/rpcs3/ios/RPCS3IOSFreezeDump.h
+++ b/rpcs3/ios/RPCS3IOSFreezeDump.h
@@ -15,4 +15,16 @@
 // reason names the trigger ("no_frames"), seconds_without_frames the time since
 // the last presented frame and busiest_group_cores the average cores of the
 // busiest thread group over the reporter window that triggered the dump.
-void neostation_freeze_dump(const char* reason, double seconds_without_frames, double busiest_group_cores);
+//
+// REWINDBOX_FREEZE_EPISODE_621 (RPCS3IOSFreezeEpisode.h): called once per freeze
+// episode by the profiler sampler; episode= joins the dump to its FREEZE_EPISODE
+// lines, a waits summary line follows the begin line, a guest-fault freeze
+// (frozen state) is dumped too, and the inside rate limit is 10 s.
+// Returns true when the dump was logged (false: not running, idm lock busy, rate limit).
+bool neostation_freeze_dump(const char* reason, double seconds_without_frames, double busiest_group_cores,
+	unsigned long long episode = 0);
+
+// REWINDBOX_CAPTURE_912 (ios/IOSCapture912.h): called by the profiler sampler every sample (500 ms). Starts an armed
+// capture when the emulation leaves a pause, stops it by itself, and logs its bounded "COREPROF PUTLLCTRACE912" /
+// "COREPROF PPUPROF912" lines. Does nothing when neither capture is armed (their boot settings are off).
+void rewindbox_capture912_tick(unsigned long long session);
diff --git a/rpcs3/ios/RPCS3IOSFreezeEpisode.h b/rpcs3/ios/RPCS3IOSFreezeEpisode.h
new file mode 100644
index 0000000..655b3e7
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSFreezeEpisode.h
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_FREEZE_EPISODE_621: a freeze is an episode, not a 5 s window.
+// The profiler sampler (every 500 ms, RPCS3IOSPerformance.cpp) feeds the
+// emulator state and the guest flip count. The no-frame clock only advances
+// while the emulator runs: time paused, loading, stopping and the gaps of an
+// iOS suspension (no sample for more than 2 s) are kept apart, so an episode
+// that began before a pause keeps its evidence across any number of pauses and
+// resumes, and a pause alone never makes one.
+//  - begin: no guest flip for 3 s of running time while a thread group uses at
+//    least half a core (no_frames_busy, the Build 487 trigger), or for 6 s with
+//    less activity (no_frames_idle, a quiet freeze), or the emulator froze on a
+//    guest fault (emulator_frozen). The no-frame triggers are armed by the first
+//    guest flip of the session: a boot that compiles before its first frame is
+//    loading, not a freeze. One FREEZE_DUMP per episode: requested at the begin,
+//    retried on the following samples until the dump reports it was taken
+//    (dump_taken), never more often than every 10 s across episodes.
+//  - update: every 10 s of episode time for the first minute, then every 60 s.
+//  - end: recovered once guest flips come back steadily (10 flips over at
+//    least 1 s of running time), or stopped with the session. A later stall is
+//    a new episode with its own dump.
+// The host (Rpcs3Diagnostics.mm) adds what the Core cannot see: whether its
+// menu was open and whether the app was in the background.
+namespace rpcs3::ios::freeze_episode
+{
+inline constexpr std::uint64_t busy_begin_us = 3'000'000;
+inline constexpr std::uint64_t idle_begin_us = 6'000'000;
+inline constexpr double busy_cores = 0.5;
+inline constexpr std::uint64_t suspend_gap_us = 2'000'000;
+inline constexpr std::uint64_t recover_span_us = 1'000'000;
+inline constexpr std::uint64_t recover_flips = 10;
+inline constexpr std::uint64_t early_update_us = 10'000'000;
+inline constexpr std::uint64_t late_update_us = 60'000'000;
+inline constexpr std::uint64_t early_window_us = 60'000'000;
+inline constexpr std::uint64_t min_dump_interval_us = 10'000'000;
+
+enum class emu : std::uint32_t
+{
+	running = 0,
+	paused = 1,  // Emu.Pause (debugger, frame capture); RewindBox's menu does not pause
+	frozen = 2,  // Emu.Pause(true) after a guest access violation
+	loading = 3, // ready, starting, loading
+	stopped = 4, // stopping, stopped
+};
+
+enum class event : std::uint32_t
+{
+	none = 0,
+	begin = 1,
+	update = 2,
+	end = 3,
+};
+
+inline const char* event_name(event value) noexcept
+{
+	switch (value)
+	{
+	case event::begin: return "begin";
+	case event::update: return "update";
+	case event::end: return "end";
+	default: return "none";
+	}
+}
+
+struct tick
+{
+	std::uint64_t now_us = 0;     // steady clock
+	emu state = emu::running;
+	std::uint64_t guest_flips = 0; // monotonic count of guest flips
+	double busiest_cores = 0.0;    // busiest thread group of this sample
+};
+
+struct report
+{
+	event what = event::none;
+	std::uint64_t episode = 0;
+	const char* reason = "";   // no_frames_busy | no_frames_idle | emulator_frozen
+	const char* outcome = "";  // open | recovered | stopped
+	bool dump = false;         // take the FREEZE_DUMP of this episode now (also on a sample without event)
+	bool dump_suppressed = false; // the 10 s floor delays the dump of this episode
+	double no_frames_s = 0.0;      // running time without a guest flip when the episode began
+	double episode_s = 0.0;        // running time since the episode began
+	double paused_s = 0.0;         // paused or frozen wall time inside the episode
+	double suspended_s = 0.0;      // sampling gaps over 2 s inside the episode (iOS suspension)
+	double loading_s = 0.0;        // loading-state wall time inside the episode
+	std::uint32_t pauses = 0, suspensions = 0;
+	std::uint64_t flips_during = 0; // guest flips seen while the episode was open
+	double busiest_cores = 0.0;     // at begin, then the current sample
+	double begin_busiest_cores = 0.0;
+	double last_flip_age_s = 0.0;   // wall time since the last guest flip
+};
+
+class tracker
+{
+public:
+	void reset() noexcept { *this = {}; }
+
+	report observe(const tick& sample) noexcept
+	{
+		report result;
+		if (!m_started)
+		{
+			m_started = true;
+			m_previous_us = sample.now_us;
+			m_flips = sample.guest_flips;
+			m_last_flip_wall_us = sample.now_us;
+			m_previous_state = sample.state;
+			return result;
+		}
+
+		const std::uint64_t gap = sample.now_us > m_previous_us ? sample.now_us - m_previous_us : 0;
+		m_previous_us = sample.now_us;
+		const bool suspended = gap > suspend_gap_us;
+		const bool running = sample.state == emu::running;
+
+		if (m_open)
+		{
+			if (suspended)
+			{
+				m_suspended_us += gap;
+				m_suspensions++;
+			}
+			else if (sample.state == emu::paused || sample.state == emu::frozen)
+			{
+				m_paused_us += gap;
+			}
+			else if (sample.state == emu::loading)
+			{
+				m_loading_us += gap;
+			}
+			if (sample.state == emu::paused && m_previous_state != emu::paused)
+			{
+				m_pauses++;
+			}
+		}
+		m_previous_state = sample.state;
+
+		if (running && !suspended)
+		{
+			m_active_us += gap;
+		}
+
+		if (sample.guest_flips != m_flips)
+		{
+			const std::uint64_t delta = sample.guest_flips > m_flips ? sample.guest_flips - m_flips : 1;
+			m_flips = sample.guest_flips;
+			m_armed = true;
+			m_last_flip_active_us = m_active_us;
+			m_last_flip_wall_us = sample.now_us;
+			if (m_open)
+			{
+				m_flips_during += delta;
+				if (!m_recovering)
+				{
+					m_recovering = true;
+					m_recover_since_us = m_active_us;
+					m_recover_flips = 0;
+				}
+				m_recover_flips += delta;
+			}
+		}
+		else if (m_open && m_recovering && m_active_us - m_last_flip_active_us >= recover_span_us)
+		{
+			m_recovering = false; // flips stopped again before the recovery held
+		}
+
+		if (sample.state == emu::stopped)
+		{
+			if (m_open) return close("stopped", sample);
+			m_last_flip_active_us = m_active_us;
+			return result;
+		}
+
+		if (m_open)
+		{
+			if (m_recovering && m_recover_flips >= recover_flips && m_active_us - m_recover_since_us >= recover_span_us)
+			{
+				return close("recovered", sample);
+			}
+
+			const std::uint64_t elapsed = episode_us();
+			const std::uint64_t period = elapsed < early_window_us ? early_update_us : late_update_us;
+			if (elapsed >= m_next_update_us)
+			{
+				m_next_update_us = elapsed + period;
+				fill(result, event::update, "open", sample);
+			}
+			request_dump(result, sample.now_us);
+			return result;
+		}
+
+		const std::uint64_t idle = m_active_us - m_last_flip_active_us;
+		const char* reason = nullptr;
+		if (sample.state == emu::frozen)
+			reason = "emulator_frozen";
+		else if (m_armed && running && idle >= busy_begin_us && sample.busiest_cores >= busy_cores)
+			reason = "no_frames_busy";
+		else if (m_armed && running && idle >= idle_begin_us)
+			reason = "no_frames_idle";
+		if (!reason) return result;
+
+		m_open = true;
+		m_episode++;
+		m_reason = reason;
+		m_wall_clock = sample.state == emu::frozen;
+		m_begin_active_us = m_active_us;
+		m_begin_frozen_us = sample.now_us;
+		m_no_frames_us = idle;
+		m_paused_us = m_suspended_us = m_loading_us = 0;
+		m_pauses = m_suspensions = 0;
+		m_flips_during = 0;
+		m_recovering = false;
+		m_begin_cores = sample.busiest_cores;
+		m_next_update_us = early_update_us;
+		m_dump_pending = true;
+		fill(result, event::begin, "open", sample);
+		request_dump(result, sample.now_us);
+		result.dump_suppressed = !result.dump;
+		return result;
+	}
+
+	// The dump of the open episode was taken (neostation_freeze_dump returned true).
+	void dump_taken(std::uint64_t now_us) noexcept
+	{
+		m_dump_pending = false;
+		m_last_dump_us = now_us ? now_us : 1;
+	}
+
+	// The session ended (profiler reset or Core stop) with an episode open.
+	report stop(std::uint64_t now_us) noexcept
+	{
+		report result;
+		if (!m_open) return result;
+		tick sample;
+		sample.now_us = now_us;
+		sample.state = emu::stopped;
+		return close("stopped", sample);
+	}
+
+	bool open() const noexcept { return m_open; }
+	std::uint64_t episodes() const noexcept { return m_episode; }
+
+private:
+	std::uint64_t episode_us() const noexcept
+	{
+		const std::uint64_t running = m_active_us - m_begin_active_us;
+		// A guest-fault freeze keeps the emulator out of the running state: its
+		// episode time is wall time.
+		return m_wall_clock ? m_previous_us - m_begin_frozen_us : running;
+	}
+
+	void fill(report& result, event what, const char* outcome, const tick& sample) const noexcept
+	{
+		result.what = what;
+		result.episode = m_episode;
+		result.reason = m_reason ? m_reason : "";
+		result.outcome = outcome;
+		result.no_frames_s = static_cast<double>(m_no_frames_us) / 1e6;
+		result.episode_s = static_cast<double>(episode_us()) / 1e6;
+		result.paused_s = static_cast<double>(m_paused_us) / 1e6;
+		result.suspended_s = static_cast<double>(m_suspended_us) / 1e6;
+		result.loading_s = static_cast<double>(m_loading_us) / 1e6;
+		result.pauses = m_pauses;
+		result.suspensions = m_suspensions;
+		result.flips_during = m_flips_during;
