@@ -0,0 +1,1058 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE: the native Metal 4 renderer (see MTLGSRender.h): device, frames, rings, presentation.
+// The draw path is in MTLDraw.cpp, vertex and index uploads in MTLVertexBuffers.cpp.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+#include "MTLPresent.h"
+
+#include "Emu/IdManager.h"
+#include "Emu/Memory/vm.h"
+#include "Emu/Memory/vm_locking.h"
+#include "Emu/RSX/Host/MM.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+#include "Emu/RSX/rsx_cache.h"  // M5: the program cache on disk (MTLM5Renderer.cpp)
+#include "Emu/RSX/RSXOffload.h"
+#include "Emu/RSX/gcm_enums.h"
+#include "Emu/RSX/Utils/rsx_utils.h"
+#include "Emu/system_config.h"
+#include "util/asm.hpp"
+
+#ifdef RPCS3_IOS
+#include "ios/IOSRsxIdlePark.h"
+#endif
+
+#include <algorithm>
+#include <cstring>
+
+namespace mtl
+{
+	stage_counters& counters() noexcept
+	{
+		static stage_counters s_counters;
+		return s_counters;
+	}
+
+	namespace
+	{
+		// Ring sizes: the Vulkan renderer's initial sizes (VKGSRenderTypes.hpp), which it can grow; these rings
+		// make room by waiting for the GPU instead (counted).
+		constexpr usz ring_sizes_mb[] =
+		{
+			64, // attrib (persistent + volatile vertex streams)
+			16, // index
+			16, // vertex env
+			16, // vertex layout (draw parameters)
+			16, // fragment env
+			16, // fragment texture params
+			16, // fragment constants
+			16, // transform constants
+			16, // raster env (stipple)
+			16, // instancing
+			4,  // push constants
+			64, // texture upload (VK_TEXTURE_UPLOAD_RING_BUFFER_SIZE_M)
+		};
+
+		constexpr const char* ring_names[] =
+		{
+			"metal attrib", "metal index", "metal vertex env", "metal vertex layout", "metal fragment env",
+			"metal fragment texture params", "metal fragment constants", "metal transform constants",
+			"metal raster env", "metal instancing", "metal push constants", "metal texture upload",
+		};
+	}
+}
+
+MTLGSRender::MTLGSRender(utils::serial* ar) noexcept
+	: GSRender(ar)
+{
+	m_device = mtl::create_system_default_device();
+	if (!m_device)
+	{
+		m_initialization_error = "No Metal device";
+		return;
+	}
+
+	m_device_info = mtl::query_device(m_device);
+	if (!m_device_info.metal4)
+	{
+		m_initialization_error = fmt::format("The Metal 4 renderer needs iOS 26 and a Metal 4 GPU (Apple7 or later); this device is '%s'", m_device_info.name);
+		m_device.reset();
+		return;
+	}
+
+	// The same backend facts as the Vulkan renderer on MoltenVK, except where Metal is the reason.
+	backend_config.supports_multidraw = true;               // subranges are drawn one by one
+	backend_config.supports_hw_instanced_rendering = true;
+	backend_config.supports_programmable_blending = true;   // framebuffer fetch on Apple GPUs
+	backend_config.supports_last_provoking_vertex = false;  // Metal has no last-vertex convention: smooth fallback, as Vulkan without the extension
+	backend_config.supports_normalized_barycentrics = true;
+	backend_config.supports_hw_msaa = false;                // M4: set by init_m4_config() below
+	backend_config.supports_hw_a2c = false;
+	backend_config.supports_hw_a2c_1spp = false;
+	backend_config.supports_hw_a2one = false;
+	backend_config.supports_hw_renormalization = false;     // NVIDIA only
+	backend_config.supports_hw_conditional_render = false;  // resolved on the CPU, as on MoltenVK
+	backend_config.supports_passthrough_dma = false;
+	backend_config.supports_host_gpu_labels = false;
+	backend_config.supports_asynchronous_compute = false;
+
+	init_m4_config();  // M4: MSAA backend facts, the native interface's display manager (MTLM4Renderer.cpp)
+}
+
+MTLGSRender::~MTLGSRender() = default;
+
+u64 MTLGSRender::get_cycles()
+{
+	return thread_ctrl::get_cycles(static_cast<named_thread<MTLGSRender>&>(*this));
+}
+
+void MTLGSRender::on_init_thread()
+{
+	if (!m_device)
+	{
+		fmt::throw_exception("%s", m_initialization_error.empty() ? "No Metal device was created" : m_initialization_error);
+	}
+
+	GSRender::on_init_thread();
+	zcull_ctrl.reset(static_cast<::rsx::reports::ZCULL_control*>(this));
+
+	ensure(m_frame, "The Metal renderer needs the iOS display surface");
+#ifdef __APPLE__
+	// The iOS frame's handle is the CAMetalLayer of the display surface (rpcs3::ios::gs_frame::handle).
+	m_layer = m_frame->handle();
+#endif
+	ensure(m_layer, "The display surface has no CAMetalLayer");
+
+	m_queue = mtl::new_command_queue(m_device);
+	open_pipeline_archive();  // M5: the title's pipeline binaries, before the compiler that captures into them
+	m_compiler = mtl::new_compiler(m_device, m_pipeline_archive.serializer());
+	m_event = mtl::new_shared_event(m_device);
+	m_residency = mtl::new_residency_set(m_device, 256);
+	ensure(m_queue && m_compiler && m_event && m_residency, "Metal 4 queue, compiler, event or residency set creation failed");
+
+	// The layer's drawables are resident through the layer's own set.
+	mtl::queue_add_residency_set(m_queue, m_residency);
+	if (const mtl::object layer_set = mtl::layer_residency_set(m_layer))
+	{
+		mtl::queue_add_residency_set(m_queue, layer_set);
+	}
+
+	m_commands.create(m_device, m_queue, m_event, m_residency);
+	mtl::set_command_context(&m_commands);
+
+	update_drawable_size();
+
+	for (frame_slot& slot : m_frames)
+	{
+		slot.allocator = mtl::new_command_allocator(m_device);
+		slot.constants = mtl::new_buffer(m_device, 256, mtl::storage_mode::shared);
+		ensure(slot.allocator && slot.constants, "Metal 4 frame resources");
+		m_commands.make_resident(slot.constants);
+	}
+
+	// Rings
+	for (u32 index = 0; index < ring_count; ++index)
+	{
+		m_rings[index].create(m_device, mtl::ring_sizes_mb[index] * 0x100000, mtl::ring_names[index]);
+		m_rings[index].on_exhausted = [this](usz size) { return on_ring_exhausted(size); };
+		m_commands.make_resident(m_rings[index].buffer);
+	}
+
+	m_texel_buffer_alignment = std::max<u64>(mtl::texture_buffer_alignment(m_device, mtl::pixel_format::r8_uint), 16);
+	m_texel_window_size = m_rings[ring_attrib].size();
+
+	// Argument tables: one per stage, every slot the translator may assign.
+	m_vertex_table = mtl::new_argument_table(m_device, mtl::max_buffer_slots, mtl::max_texture_slots, mtl::max_sampler_slots);
+	m_fragment_table = mtl::new_argument_table(m_device, mtl::max_buffer_slots, mtl::max_texture_slots, mtl::max_sampler_slots);
+	ensure(m_vertex_table && m_fragment_table, "Metal 4 argument tables");
+
+	// Neutral resources: an empty texel buffer and one zeroed texture per dimension (until the texture cache).
+	{
+		const mtl::object zeros = mtl::new_buffer(m_device, 4096, mtl::storage_mode::shared);
+		std::memset(mtl::buffer_contents(zeros), 0, 4096);
+		m_commands.make_resident(zeros);
+		m_null_texture_buffer = mtl::new_texture_buffer(zeros, mtl::pixel_format::r8_uint, 0, 4096);
+		m_commands.make_resident(m_null_texture_buffer);
+		// The buffer stays alive through the texture view.
+
+		const mtl::texture_type types[] = { mtl::texture_type::type_2d, mtl::texture_type::type_2d, mtl::texture_type::type_cube, mtl::texture_type::type_3d };
+		for (u32 index = 0; index < 4; ++index)
+		{
+			mtl::texture_descriptor desc{};
+			desc.type = types[index];
+			desc.format = mtl::pixel_format::rgba8_unorm;
+			desc.width = desc.height = 1;
+			desc.depth = 1;
+			desc.usage = mtl::usage_shader_read;
+			desc.storage = mtl::storage_mode::shared;
+			m_null_textures[index] = mtl::new_texture(m_device, desc);
+			ensure(m_null_textures[index], "Metal neutral texture");
+			const u32 black[6] = {};
+			const u32 faces = desc.type == mtl::texture_type::type_cube ? 6 : 1;
+			for (u32 face = 0; face < faces; ++face)
+			{
+				mtl::texture_replace_region(m_null_textures[index], {{0, 0, 0}, {1, 1, 1}}, 0, face, black, 4, 4);
+			}
+			m_commands.make_resident(m_null_textures[index]);
+		}
+
+		// Stencil mirrors (usampler2D -> texture2d<uint>) and shadow units (depth2d) need matching formats.
+		{
+			mtl::texture_descriptor desc{};
+			desc.format = mtl::pixel_format::r8_uint;
+			desc.usage = mtl::usage_shader_read;
+			desc.storage = mtl::storage_mode::shared;
+			m_null_stencil_texture = mtl::new_texture(m_device, desc);
+			ensure(m_null_stencil_texture, "Metal neutral stencil texture");
+			const u32 zero = 0;
+			mtl::texture_replace_region(m_null_stencil_texture, {{0, 0, 0}, {1, 1, 1}}, 0, 0, &zero, 1, 1);
+			m_commands.make_resident(m_null_stencil_texture);
+
+			desc.format = mtl::pixel_format::depth32_float;
+			desc.usage = mtl::usage_shader_read | mtl::usage_render_target;
+			desc.storage = mtl::storage_mode::private_;
+			m_null_depth_texture = mtl::new_texture(m_device, desc);
+			ensure(m_null_depth_texture, "Metal neutral depth texture");
+			m_commands.make_resident(m_null_depth_texture);
+		}
+
+		mtl::sampler_descriptor sampler{};
+		m_null_sampler = mtl::new_sampler(m_device, sampler);
+		ensure(m_null_texture_buffer && m_null_sampler, "Metal neutral resources");
+	}
+
+	m_present_table = mtl::new_argument_table(m_device, 1, 1, 1);
+	mtl::sampler_descriptor sampler{};
+	sampler.min_filter = mtl::sampler_min_mag_filter::linear;
+	sampler.mag_filter = mtl::sampler_min_mag_filter::linear;
+	m_present_sampler = mtl::new_sampler(m_device, sampler);
+	ensure(m_present_table && m_present_sampler, "Metal 4 presentation table or sampler");
+
+	std::string error;
+	if (!create_present_pipeline(error))
+	{
+		fmt::throw_exception("Metal presentation pipeline: %s", error);
+	}
+
+	if (!create_clear_library(error))
+	{
+		fmt::throw_exception("Metal clear pipeline library: %s", error);
+	}
+
+	// Scaled transfers (MTLBlit.h): the blit engine, region copies, readbacks of scaled sections.
+	if (!m_blit_engine.create(m_device, m_compiler, m_device_info.float32_filtering, error))
+	{
+		fmt::throw_exception("Metal blit library: %s", error);
+	}
+	mtl::set_blit_engine(&m_blit_engine);
+
+	// Shader stack
+	spirv::initialize_compiler_context();
+	mtl::pipeline_environment environment{};
+	environment.device = m_device;
+	environment.compiler = m_compiler;
+	environment.caps.has_native_half_support = true;
+	environment.fast_math = !g_cfg.video.disable_msl_fast_math;
+	mtl::set_pipeline_environment(environment);
+	// The program cache calls this after every link (allow_notification): the program is stored in the disk shader
+	// cache there, as in the Vulkan renderer (M5).
+	m_prog_buffer = std::make_unique<mtl::program_cache>(
+		[this](const mtl::pipeline_props& props, const RSXVertexProgram& vp, const RSXFragmentProgram& fp)
+		{
+			store_program(props, vp, fp);
+		});
+	create_program_cache();  // M5
+
+	// Texture cache (M3.1)
+	mtl::set_upload_heap(&m_rings[ring_texture_upload]);
+	m_texture_cache.initialize(m_rings[ring_texture_upload], m_device_info.bc_texture_compression);
+
+	init_m4();  // M4: occlusion queries, MSAA resolve passes, conversion kernels, overlays
+
+	begin_frame();
+
+	// The neutral depth texture holds depth 1.0 (a cleared depth attachment).
+	{
+		mtl::render_pass_descriptor pass{};
+		pass.depth.texture = m_null_depth_texture;
+		pass.depth.load = mtl::load_action::clear;
+		pass.depth.store = mtl::store_action::store;
+		pass.depth.clear_depth = 1.0;
+		pass.render_target_width = pass.render_target_height = 1;
+		m_commands.begin_render(pass, 0, "neutral depth");
+		m_commands.end_encoder();
+	}
+
+	rsx_log.notice("Metal 4 renderer M3.2: device '%s' (Apple7=%d Apple8=%d Apple9=%d, BC=%d, float32 filtering=%d, sampler LOD bias=%d, unified=%d), drawable %ux%u, fast math %d",
+		m_device_info.name, m_device_info.apple7, m_device_info.apple8, m_device_info.apple9, m_device_info.bc_texture_compression,
+		m_device_info.float32_filtering, m_device_info.sampler_lod_bias, m_device_info.unified_memory, m_drawable_width, m_drawable_height, environment.fast_math);
+	rsx_log.warning("Metal 4 renderer M3.2/M4: scaled transfers into integer formats or between depth formats and guest-memory loads of scaled surfaces are not executed yet (counted in COREPROF METAL)");
+
+	load_program_cache();  // M5: the programs of earlier sessions, built before the first draw (VKGSRender)
+}
+
+void MTLGSRender::on_exit()
+{
+	if (m_commands.recording())
+	{
+		m_commands.submit(false);
+	}
+	m_commands.wait_idle();
+
+	GSRender::on_exit();
+	close_pipeline_caches();  // M5: queued program records, the last pipeline archive checkpoint
+
+	m_texture_cache.destroy();
+	mtl::set_blit_engine(nullptr);
+	m_blit_engine.destroy();
+	m_snapshot_pool.clear();
+	m_draw_snapshots.clear();
+	m_sampler_pool.clear();
+	m_fs_sampler_handles = {};
+	m_vs_sampler_handles = {};
+	m_rtts.destroy();
+	mtl::set_upload_heap(nullptr);
+	destroy_m4();  // M4
+	m_prog_buffer.reset();
+	m_clear_pipelines.clear();
+	m_clear_library.reset();
+	m_depth_stencil_states.clear();
+	m_persistent_window = {};
+	m_volatile_window = {};
+
+	for (auto& ring : m_rings)
+	{
+		ring.destroy();
+	}
+
+	for (frame_slot& slot : m_frames)
+	{
+		slot = {};
+	}
+
+	m_commands.collect();
+	mtl::set_command_context(nullptr);
+	m_commands.destroy();
+	spirv::finalize_compiler_context();
+
+	m_null_textures = {};
+	m_null_stencil_texture.reset();
+	m_null_depth_texture.reset();
+	m_null_texture_buffer.reset();
+	m_null_sampler.reset();
+	m_vertex_table.reset();
+	m_fragment_table.reset();
+	m_present_pipeline.reset();
+	m_present_table.reset();
+	m_present_sampler.reset();
+	m_residency.reset();
+	m_event.reset();
+	m_compiler.reset();
+	m_queue.reset();
+
+	// M4: zcull_ctrl points at this renderer (on_init_thread), it must not delete it (VKGSRender::on_exit)
+	zcull_ctrl.release();
+}
+
+void MTLGSRender::begin_frame()
+{
+	frame_slot& slot = m_frames[m_frame_index % frames_in_flight];
+
+	// The slot's previous frame must be complete before its allocator and ring space are reused.
+	m_commands.wait(slot.fence);
+	m_commands.collect();
+
+	if (slot.positions_valid)
+	{
+		for (u32 index = 0; index < ring_count; ++index)
+		{
+			m_rings[index].set_get_pos(slot.ring_positions[index]);
+		}
+		slot.positions_valid = false;
+	}
+
+	// Frame ids start at 1. The wait above completed this slot's previous frame (id frame_id - frames_in_flight) and
+	// every earlier one: invalidated surfaces older than that, and referenced by nothing, are released (Vulkan trims
+	// at each present). Nothing is recording yet, so their textures go once the work submitted so far has completed.
+	const u64 frame_id = m_frame_index + 1;
+	mtl::set_current_frame_id(frame_id);
+	m_rtts.trim(frame_id > frames_in_flight ? frame_id - frames_in_flight : 0);
+
+	mtl::reset_command_allocator(slot.allocator);
+	m_commands.begin(slot.allocator, "RSX frame");
+	m_current_frame = &slot;
+	m_render_pass_dirty = true;
+	invalidate_environment();
+}
+
+void MTLGSRender::invalidate_environment()
+{
+	m_vertex_env_valid = false;
+	m_xform_constants_valid = false;
+	m_fragment_constants_valid = false;
+	m_fragment_env_valid = false;
+	m_texture_parameters_valid = false;
+	m_stipple_valid = false;
+}
+
+void MTLGSRender::flush_command_queue(bool wait)
+{
+	// An early submission within the frame (readback, full ring): the frame keeps its allocator.
+	const u64 value = m_commands.submit(true);
+#ifdef RPCS3_IOS
+	ios_on_submit();  // M5: carries an armed watched submission (VKGSRender)
+#endif
+	if (wait)
+	{
+		m_commands.wait(value);
+		m_commands.collect();
+	}
+
+	m_commands.begin(m_current_frame->allocator, "RSX frame (continued)");
+	m_render_pass_dirty = true;
+}
+
+bool MTLGSRender::on_ring_exhausted(usz size)
+{
+	mtl::counters().ring_exhaustions.fetch_add(1, std::memory_order_relaxed);
+	rsx_log.warning("Metal: a ring needs %llu bytes: submitting and waiting for the GPU", static_cast<u64>(size));
+
+	flush_command_queue(true);
+	m_commands.wait_idle();
+
+	// grow() then frees the whole exhausted ring from its PUT position, so the rest of this frame may write over
+	// space that a frame slot's saved GET still describes as older data: restoring such a GET at a later
+	// begin_frame() would hand this frame's in-flight data out again. No slot restores its saved positions; each
+	// ring reclaims space again from the next frame end recorded after this point.
+	for (frame_slot& slot : m_frames)
+	{
+		slot.positions_valid = false;
+	}
+
+	invalidate_environment();
+	return true;
+}
+
+// M4: the occlusion queries are in MTLQueries.cpp.
+
+bool MTLGSRender::create_present_pipeline(std::string& error)
+{
+	const mtl::object library = mtl::compile_library(m_compiler, mtl::present_pass::source, error);
+	if (!library)
+	{
+		return false;
+	}
+
+	mtl::render_pipeline_descriptor desc{};
+	desc.library = library;
+	desc.vertex_function = std::string(mtl::present_pass::vertex_function);
+	desc.fragment_function = std::string(mtl::present_pass::fragment_function);
+	desc.color[0].format = mtl::pixel_format::bgra8_unorm;
+	desc.label = "RSX present";
+	m_present_pipeline = mtl::new_render_pipeline(m_compiler, desc, error);
+	return static_cast<bool>(m_present_pipeline);
+}
+
+void MTLGSRender::update_drawable_size()
+{
+	const u32 width = static_cast<u32>(std::max(0, m_frame->client_width()));
+	const u32 height = static_cast<u32>(std::max(0, m_frame->client_height()));
+	if (width == m_drawable_width && height == m_drawable_height && width && height)
+	{
+		return;
+	}
+
+	m_drawable_width = width;
+	m_drawable_height = height;
+	mtl::configure_layer(m_layer, m_device, mtl::pixel_format::bgra8_unorm, width, height);
+}
+
+bool MTLGSRender::upload_display_buffer(frame_slot& slot, u32 address, u32 width, u32 height, u32 pitch)
+{
+	if (!vm::check_addr(address, vm::page_readable, pitch * (height - 1) + width * 4))
+	{
+		return false;
+	}
+
+	if (!slot.upload || slot.upload_width != width || slot.upload_height != height)
+	{
+		if (slot.upload)
+		{
+			m_commands.dispose(std::move(slot.upload), true);
+		}
+
+		mtl::texture_descriptor desc{};
+		desc.format = mtl::pixel_format::bgra8_unorm;
+		desc.width = width;
+		desc.height = height;
+		desc.usage = mtl::usage_shader_read;
+		desc.storage = mtl::storage_mode::shared;
+		slot.upload = mtl::new_texture(m_device, desc);
+		ensure(slot.upload, "Metal display buffer texture");
+		slot.upload_width = width;
+		slot.upload_height = height;
+		m_commands.make_resident(slot.upload);
+	}
+
+	// As the Vulkan renderer's upload_image_simple: each big-endian A8R8G8B8 word stored as a native u32 (BGRA8).
+	m_staging.resize(static_cast<usz>(width) * height);
+	const u8* source = vm::_ptr<const u8>(address);
+	for (u32 row = 0; row < height; ++row)
+	{
+		mtl::present_pass::convert_row(source + static_cast<usz>(row) * pitch, m_staging.data() + static_cast<usz>(row) * width, width);
+	}
+
+	mtl::texture_replace_region(slot.upload, {{0, 0, 0}, {width, height, 1}}, 0, 0, m_staging.data(), width * 4, 0);
+	return true;
+}
+
+void MTLGSRender::submit_frame(const mtl::object& source, u32 display_width, u32 display_height, f32 uv_scale_x, f32 uv_scale_y)
+{
+	frame_slot& slot = *m_current_frame;
+	const mtl::object drawable = mtl::next_drawable(m_layer);
+
+	if (drawable)
+	{
+		// M4: the native overlays are prepared before the pass opens (their uploads may submit), over the image area.
+		{
+			const auto rect = mtl::present_pass::place(display_width, display_height, m_drawable_width, m_drawable_height, g_cfg.video.stretch_to_display_area.get());  // REWINDBOX_METAL_STRETCH_934
+			areau image_area{ 0, 0, m_drawable_width, m_drawable_height };
+			if (rect.right > rect.left && rect.top > rect.bottom)
+			{
+				image_area.x1 = static_cast<u32>((rect.left + 1.f) * 0.5f * m_drawable_width);
+				image_area.x2 = static_cast<u32>((rect.right + 1.f) * 0.5f * m_drawable_width);
+				image_area.y1 = static_cast<u32>((1.f - rect.top) * 0.5f * m_drawable_height);
+				image_area.y2 = static_cast<u32>((1.f - rect.bottom) * 0.5f * m_drawable_height);
+			}
+			prepare_overlays(image_area);
+		}
+		// M4 end
+
+		mtl::render_pass_descriptor pass{};
+		pass.color[0].texture = mtl::drawable_texture(drawable);
+		pass.color[0].load = mtl::load_action::clear;
+		pass.color[0].store = mtl::store_action::store;
+		pass.color[0].clear = {0., 0., 0., 1.};
+		const mtl::object& encoder = m_commands.begin_render(pass, 0, "RSX present");
+
+		if (source && display_width && display_height && m_drawable_width && m_drawable_height)
+		{
+			// Fit the display buffer in the drawable, keeping its aspect ratio unless Stretch To Display Area is on.
+			mtl::present_pass::parameters params{};
+			params.rect = mtl::present_pass::place(display_width, display_height, m_drawable_width, m_drawable_height, g_cfg.video.stretch_to_display_area.get());  // REWINDBOX_METAL_STRETCH_934
+			params.uv_scale[0] = uv_scale_x;
+			params.uv_scale[1] = uv_scale_y;
+			std::memcpy(mtl::buffer_contents(slot.constants), &params, sizeof(params));
+
+			mtl::table_set_buffer(m_present_table, slot.constants, 0, 0);
+			mtl::table_set_texture(m_present_table, source, 0);
+			mtl::table_set_sampler(m_present_table, m_present_sampler, 0);
+			mtl::set_render_pipeline(encoder, m_present_pipeline);
+			mtl::set_argument_table(encoder, m_present_table, mtl::stage_vertex | mtl::stage_fragment);
+			mtl::draw_primitives(encoder, mtl::primitive_type::triangle_strip, 0, 4);
+		}
+
+		m_overlay_renderer.encode(encoder);  // M4: blended over the presented frame
+	}
+	else
+	{
+		mtl::counters().drawable_misses.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	slot.fence = m_commands.submit(false, drawable);
+#ifdef RPCS3_IOS
+	ios_on_submit();                     // M5
+	m_ios_early_submits_this_frame = 0;  // M5: VKPresent.cpp, per frame
+#endif
+	if (drawable)
+	{
+		mtl::present(drawable);
+		mtl::counters().frames_presented.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// Ring space written by this frame is reclaimed when the slot is reused.
+	for (u32 index = 0; index < ring_count; ++index)
+	{
+		slot.ring_positions[index] = m_rings[index].put_position();
+	}
+	slot.positions_valid = true;
+
+	m_frame_index++;
+	fold_queries(false);  // M4: the active query's completed segments (exact, no wait), so its slots are reused
+	begin_frame();
+	m_pipeline_archive.tick();  // M5: a due archive checkpoint goes to its worker (never written here)
+}
+
+void MTLGSRender::flip(const rsx::display_flip_info_t& info)
+{
+	if (info.skip_frame || !m_queue)
+	{
+		m_frame->flip(m_context, true);
+		rsx::thread::flip(info);
+		return;
+	}
+
+	update_drawable_size();
+
+	// The display buffer, as the Vulkan renderer reads it.
+	u32 width = display_buffers[info.buffer].width;
+	u32 height = display_buffers[info.buffer].height;
+	u32 pitch = display_buffers[info.buffer].pitch;
+	u32 format = CELL_GCM_TEXTURE_A8R8G8B8;
+	const auto& avconfig = g_fxo->get<rsx::avconf>();
+
+	if (!width)
+	{
+		width = avconfig.resolution_x;
+		height = avconfig.resolution_y;
+	}
+
+	if (avconfig.state)
+	{
+		format = avconfig.get_compatible_gcm_format();
+		if (!pitch)
+		{
+			pitch = width * avconfig.get_bpp();
+		}
+
+		const size2u video_frame_size = avconfig.video_frame_size();
+		width = std::min(width, video_frame_size.width);
+		height = std::min(height, video_frame_size.height);
+	}
+	else if (!pitch)
+	{
+		pitch = width * 4;
+	}
+
+	mtl::object source;
+	f32 uv_x = 1.f, uv_y = 1.f;
+
+	if (info.buffer < display_buffers_count && width && height)
+	{
+		const u32 address = rsx::get_address(display_buffers[info.buffer].offset, CELL_GCM_LOCATION_LOCAL);
+
+		// The surface that holds the display buffer, as VKGSRender::get_present_source finds it.
+		if (auto surface = m_rtts.get_surface_at(address);
+			surface && !surface->is_depth_surface() && surface->texture && surface->native_format == mtl::pixel_format::bgra8_unorm)
+		{
+			if (surface->samples() > 1)
+			{
+				// M4: VK get_present_source: a multisampled surface is read by a transfer, through its resolve texture (sizes
+				// in samples)
+				surface->memory_barrier(m_commands, rsx::surface_access::transfer_read);
+				// M5: get_surface creates and resolves a resolve image the barrier did not need yet (never read unwritten)
+				if (mtl::image* resolved = surface->get_surface(rsx::surface_access::transfer_read); resolved && resolved->samples() == 1)
+				{
+					source = resolved->texture;
+				}
+				uv_x = std::min(1.f, static_cast<f32>(width) / std::max<u32>(surface->get_surface_width<rsx::surface_metrics::samples>(), 1));
+				uv_y = std::min(1.f, static_cast<f32>(height) / std::max<u32>(surface->get_surface_height<rsx::surface_metrics::samples>(), 1));
+			}
+			else
+			{
+				surface->read_barrier(m_commands);
+				source = surface->texture;
+				uv_x = std::min(1.f, static_cast<f32>(width) / std::max<u32>(surface->get_surface_width(), 1));
+				uv_y = std::min(1.f, static_cast<f32>(height) / std::max<u32>(surface->get_surface_height(), 1));
+			}
+
+			if (source)
+			{
+				mtl::counters().frames_from_surface.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+		else if (format != CELL_GCM_TEXTURE_A8R8G8B8 || pitch < width * 4)
+		{
+			mtl::counters().unsupported_display_formats.fetch_add(1, std::memory_order_relaxed);
+		}
+		else if (upload_display_buffer(*m_current_frame, address, width, height, pitch))
+		{
+			source = m_current_frame->upload;
+			mtl::counters().frames_from_guest_memory.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	if (!source)
+	{
+		mtl::counters().frames_without_source.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	submit_frame(source, width, height, uv_x, uv_y);
+
+	// VKPresent.cpp: the texture cache ends its frame (temporary subresources, trimming, predictions), every
+	// sampler is looked up again.
+	m_texture_cache.on_frame_end();
+	m_samplers_dirty.store(true);
+	if (m_snapshot_pool.size() > 16)
+	{
+		// ~image releases them once the GPU no longer reads them.
+		m_snapshot_pool.erase(m_snapshot_pool.begin(), m_snapshot_pool.begin() + (m_snapshot_pool.size() - 16));
+	}
+
+	m_last_flip_us = get_system_time();
+	if ((m_frame_index % 600) == 0)
+	{
+		report_counters();
+		m_last_counter_report_us = m_last_flip_us;
+	}
+	else
+	{
+		report_counters_if_due();
+	}
+
+	m_frame->flip(m_context);
+	rsx::thread::flip(info);
+}
+
+void MTLGSRender::report_counters()
+{
+	// Cumulative since the renderer started; one line every 600 frames (COREPROF METAL in the RPCS3 log).
+	const auto& c = mtl::counters();
+	const auto& s = mtl::get_surface_counters();
+	const auto& p = mtl::get_pipeline_counters();
+	const auto& q = m_commands.counters();
+	const auto& t = mtl::get_texture_counters();
+	const auto load = [](const std::atomic<u64>& value) { return value.load(std::memory_order_relaxed); };
+
+	rsx_log.notice("COREPROF METAL frames=%llu surface=%llu memory=%llu none=%llu drawable_misses=%llu | draws=%llu skipped_program=%llu "
+		"skipped_vertices=%llu cull_both=%llu textures_failed=%llu clears=%llu logic_ops=%llu queries_unmeasured=%llu | "
+		"surfaces=%llu released=%llu invalidated_live=%llu cleared=%llu inherited=%llu transfers_todo=%llu loads_todo=%llu writes_todo=%llu | vp=%llu fp=%llu "
+		"glsl_fail=%llu msl_fail=%llu lib_fail=%llu pipelines=%llu pipeline_fail=%llu | submits=%llu early=%llu waits=%llu "
+		"slow_waits=%llu rings_full=%llu",
+		load(c.frames_presented), load(c.frames_from_surface), load(c.frames_from_guest_memory), load(c.frames_without_source), load(c.drawable_misses),
+		load(c.draws_rendered), load(c.draws_skipped_program), load(c.draws_skipped_no_vertices), load(c.draws_cull_both_faces),
+		load(c.textures_not_bound), load(c.clears), load(c.logic_ops_not_applied), load(c.occlusion_queries_not_measured),
+		load(s.created), load(s.released), static_cast<u64>(m_rtts.invalidated_resources.size()), load(s.cleared), load(s.inherited_copies),
+		load(s.transfers_not_implemented), load(s.memory_loads_not_implemented),
+		load(s.memory_writes_not_implemented), load(p.vertex_programs), load(p.fragment_programs), load(p.glsl_failures),
+		load(p.translation_failures), load(p.library_failures), load(p.pipelines), load(p.pipeline_failures),
+		load(q.submissions), load(q.early_submissions), load(q.waits), load(q.slow_waits), load(c.ring_exhaustions));
+
+	// M3.1 textures: done and not executed yet, on a second line.
+	rsx_log.notice("COREPROF METAL textures bound=%llu failed=%llu images=%llu alloc_fail=%llu views=%llu view_fail=%llu uploads=%llu upload_mb=%llu "
+		"upload_dedicated=%llu depth_converted=%llu upload_unsupported=%llu clears=%llu copies=%llu bitcast_views=%llu buffer_bitcasts=%llu "
+		"typeless_todo=%llu scaled_todo=%llu clipped=%llu scaled=%llu depth_scaled=%llu blits=%llu blits_cpu=%llu snapshots=%llu readbacks=%llu "
+		"readback_mb=%llu scaled_readbacks=%llu tiled_readbacks=%llu readbacks_todo=%llu flush_requests=%llu "
+		"offloader_faults=%llu faults_routed=%llu readbacks_unsubmitted=%llu samplers=%llu border_approx=%llu lod_bias_todo=%llu filter_downgraded=%llu "
+		"unnormalized_adjusted=%llu surface_loads=%llu scaled_surface_loads=%llu uploads_not_detiled=%llu",
+		load(c.textures_bound), load(c.textures_not_bound), load(t.images_created), load(t.image_allocation_failures), load(t.views_created),
+		load(t.view_failures), load(t.uploads), load(t.upload_bytes) >> 20, load(t.upload_dedicated_buffers), load(t.depth_uploads_converted),
+		load(t.uploads_unsupported_format), load(t.clears), load(t.copies), load(t.typeless_copies), load(t.buffer_bitcasts),
+		load(t.typeless_not_implemented), load(t.scaled_not_implemented), load(t.copies_clipped), load(t.scaled_copies), load(t.depth_scaled_copies),
+		load(t.blits), load(t.blits_failed), load(t.feedback_snapshots), load(t.readbacks),
+		load(t.readback_bytes) >> 20, load(t.scaled_readbacks), load(t.tiled_readbacks), load(t.readbacks_not_implemented), load(c.flush_requests), load(c.offloader_faults), load(t.faults_routed),
+		load(t.readbacks_unsubmitted), load(t.samplers_created),
+		load(t.border_colors_approximated), load(t.lod_bias_not_applied), load(t.filters_downgraded), load(t.unnormalized_samplers_adjusted),
+		load(s.memory_loads), load(s.scaled_memory_loads), load(t.uploads_not_detiled));
+
+	report_m4_counters();  // M4
+	report_m5_counters();  // M5
+	report_drain_state();  // 906
+}
+
+void MTLGSRender::report_counters_if_due()
+{
+	// REWINDBOX_METAL_TIMED_REPORT_906: AC IV (BLES01882, IPA 676) stopped presenting after about 555 frames, before the
+	// 600-frame report, so its log held no COREPROF METAL line at all. RSX thread only (the counters it reads are its own).
+	const u64 now = get_system_time();
+	if (now - m_last_counter_report_us < 5'000'000)
+	{
+		return;
+	}
+	m_last_counter_report_us = now;
+	report_counters();
+}
+
+void MTLGSRender::report_drain_state()
+{
+	// What a guest waiting on the RSX can be waiting for while the FIFO is empty: submissions not yet made or not yet
+	// completed, ZCULL reports whose segments are in them, a scheduled ZCULL flush, a pending fault flush.
+	u64 unsubmitted_reports = 0;
+	u64 in_flight_reports = 0;
+	const u64 submitted = m_commands.last_submitted();
+	const u64 completed = m_commands.completed();
+	for (const auto& record : m_query_records)
+	{
+		if (!record.has_data)
+		{
+			continue;
+		}
+		unsubmitted_reports += record.last_fence > submitted ? 1 : 0;
+		in_flight_reports += (record.last_fence <= submitted && record.last_fence > completed) ? 1 : 0;
+	}
+	const u64 now = get_system_time();
+	rsx_log.notice("COREPROF METAL state frames=%llu flip_age_ms=%llu recording=%d submitted=%llu completed=%llu query_cb_fence=%llu "
+		"active_query=%d unsubmitted_reports=%llu in_flight_reports=%llu zcull_flush_pending=%d offloader_deadlock=%d in_begin_end=%d "
+		"get=0x%x put=0x%x",
+		m_frame_index, m_last_flip_us ? (now - m_last_flip_us) / 1000 : 0, m_commands.recording() ? 1 : 0, submitted, completed,
+		m_query_cb_fence, m_active_query_info ? 1 : 0, unsubmitted_reports, in_flight_reports, m_zcull_flush_pending ? 1 : 0,
+		m_offloader_deadlock ? 1 : 0, in_begin_end ? 1 : 0, ctrl ? +ctrl->get : 0u, ctrl ? +ctrl->put : 0u);
+}
+
+bool MTLGSRender::wait_for_offloader_recovery(bool is_writing)
+{
+	// VKGSRender: the offloader thread cannot wait for flush requests (the RSX thread may be waiting for it). The RSX
+	// thread invalidates the range itself, flushing in place (flush_pending_requests), while the offloader spins.
+	ensure(!m_offloader_deadlock);
+	m_offloader_fault_range = g_fxo->get<rsx::dma_manager>().get_fault_range(is_writing);
+	m_offloader_fault_cause = is_writing ? rsx::invalidation_cause::write : rsx::invalidation_cause::read;
+
+	g_fxo->get<rsx::dma_manager>().set_mem_fault_flag();
+	m_offloader_deadlock = true;
+	m_eng_interrupt_mask |= rsx::backend_interrupt;
+#ifdef RPCS3_IOS
+	rpcs3::ios::rsx_idle_park::wake(); // CELL565_RSX_IDLE_PARK
+#endif
+	mtl::counters().offloader_faults.fetch_add(1, std::memory_order_relaxed);
+
+	while (m_offloader_deadlock)
+	{
+		utils::pause();
+	}
+
+	g_fxo->get<rsx::dma_manager>().clear_mem_fault_flag();
+	return true;
+}
+
+bool MTLGSRender::post_flush_request(flush_request&& request)
+{
+	// VKGSRender::on_access_violation order: release this thread's vm lock before taking the queue guard. The RSX thread
+	// holds the guard while it serves the queue (flush_pending_requests), so a guest thread must never wait for it with
+	// its vm lock held (M4 review).
+	vm::temporary_unlock();
+
+	flush_request* task;
+	{
+		std::lock_guard lock(m_flush_queue_guard);
+		task = &m_flush_queue.emplace_back();
+		task->section_data = std::move(request.section_data);
+		task->replay = request.replay;
+		task->is_writing = request.is_writing;
+		task->fault_address = request.fault_address;
+	}
+
+	mtl::counters().flush_requests.fetch_add(1, std::memory_order_relaxed);
+	m_eng_interrupt_mask |= rsx::backend_interrupt;
+#ifdef RPCS3_IOS
+	rpcs3::ios::rsx_idle_park::wake(); // CELL565_RSX_IDLE_PARK: this thread waits until the RSX thread serves it
+#endif
+
+	// GLGSRender work_item::producer_wait: until the RSX thread has served it (no timeout: the data is needed).
+	utils::spin_wait(task->processed, [](auto v) { return v; });
+	// Read before 'received': the RSX thread releases the entry once it is received.
+	const bool handled = task->handled;
+	task->received = true;
+	return handled;
+}
+
+bool MTLGSRender::on_access_violation(u32 address, bool is_writing)
+{
+	rsx::mm_flush(address);
+
+	// The RSX thread flushes in place; a guest thread defers the flush to the RSX thread, the only one recording.
+	const bool can_flush = is_current_thread();
+
+	if (!can_flush && m_commands.has_dma_transfer())
+	{
+		// Review R1: a GPU -> memory copy is recorded and not submitted yet (only while the RSX thread holds the
+		// texture cache lock, between recording and submitting). This thread must not take the lock and then wait for
+		// the RSX thread: the whole fault goes to the RSX thread, which flushes in place, and this thread waits
+		// outside every lock (temporary_unlock).
+		mtl::get_texture_counters().faults_routed++;
+		if (g_fxo->get<rsx::dma_manager>().is_current_thread())
+		{
+			return wait_for_offloader_recovery(is_writing);
+		}
+
+		flush_request request{};
+		request.replay = true;
+		request.is_writing = is_writing;
+		request.fault_address = address;
+		// M4: the ZCULL report pages after the texture cache (zcull_ctrl is released at exit)
+		return post_flush_request(std::move(request)) || (zcull_ctrl && zcull_ctrl->on_access_violation(address));
+	}
+
+	const rsx::invalidation_cause cause = is_writing
+		? (can_flush ? rsx::invalidation_cause::write : rsx::invalidation_cause::deferred_write)
+		: (can_flush ? rsx::invalidation_cause::read : rsx::invalidation_cause::deferred_read);
+
+	auto result = m_texture_cache.invalidate_address(m_commands, address, cause);
+
+	if (result.invalidate_samplers)
+	{
+		std::lock_guard lock(m_sampler_mutex);
+		m_samplers_dirty.store(true);
+	}
+
+	if (!result.violation_handled)
+	{
+		// M4: the ZCULL report pages (zcull_ctrl is released at exit, a late fault on another thread finds none)
+		return zcull_ctrl && zcull_ctrl->on_access_violation(address);
+	}
+
+	if (result.num_flushable > 0)
+	{
+		if (g_fxo->get<rsx::dma_manager>().is_current_thread())
+		{
+			return wait_for_offloader_recovery(is_writing);
+		}
+
+		flush_request request{};
+		request.section_data = std::move(result);
+		post_flush_request(std::move(request));
+	}
+
+	return true;
+}
+
+bool MTLGSRender::flush_pending_requests()
+{
+	bool pending = false;
+	if (m_offloader_deadlock)
+	{
+		// VKGSRender::do_local_task: clear the offloader deadlock.
+		on_invalidate_memory_range(m_offloader_fault_range, m_offloader_fault_cause);
+		m_offloader_deadlock = false;
+		pending = true;
+	}
+
+	std::lock_guard lock(m_flush_queue_guard);
+	if (m_flush_queue.empty())
+	{
+		return pending;
+	}
+
+	m_flush_queue.remove_if([](auto& q) { return q.received.load(); });
+
+	bool flushed = false;
+	for (auto& q : m_flush_queue)
+	{
+		if (q.processed.load())
+		{
+			continue;
+		}
+
+		if (q.replay)
+		{
+			// The guest thread's fault, handled here: the RSX thread flushes in place.
+			const auto cause = q.is_writing ? rsx::invalidation_cause::write : rsx::invalidation_cause::read;
+			const auto result = m_texture_cache.invalidate_address(m_commands, q.fault_address, cause);
+			if (result.invalidate_samplers)
+			{
+				std::lock_guard sampler_lock(m_sampler_mutex);
+				m_samplers_dirty.store(true);
+			}
+			q.handled = result.violation_handled;
+		}
+		else
+		{
+			m_texture_cache.flush_all(m_commands, q.section_data);
+		}
+
+		q.processed = true;
+		flushed = true;
+	}
+
+	if (flushed)
+	{
+		// The flush submitted and waited: the next draw opens its render pass again.
+		m_render_pass_dirty = true;
+	}
+
+	return true;
+}
+
+void MTLGSRender::on_invalidate_memory_range(const utils::address_range32& range, rsx::invalidation_cause cause)
+{
+	auto data = m_texture_cache.invalidate_range(m_commands, range, cause);
+	AUDIT(data.empty());
+
+	if (cause == rsx::invalidation_cause::unmap && data.violation_handled)
+	{
+		m_texture_cache.purge_unreleased_sections();
+		{
+			std::lock_guard lock(m_sampler_mutex);
+			m_samplers_dirty.store(true);
+		}
+	}
+}
+
+void MTLGSRender::on_semaphore_acquire_wait()
+{
+	// M4: query resolution may itself submit and re-enter the wait hook (VKGSRender::on_semaphore_acquire_wait)
+	if (m_servicing_semaphore_wait)
+	{
+		return;
+	}
+
+	struct service_guard
+	{
+		bool& flag;
+		explicit service_guard(bool& value) : flag(value) { flag = true; }
+		~service_guard() { flag = false; }
+	} guard(m_servicing_semaphore_wait);
+	// M4 end
+
+	bool pending = m_offloader_deadlock;
+	{
+		std::lock_guard lock(m_flush_queue_guard);
+		pending = pending || !m_flush_queue.empty();
+	}
+
+	pending = pending || zcull_semaphore_wait_pending();  // M4: ZCULL flush hint, pipe flush (VKGSRender)
+
+	if (pending || (async_flip_requested & flip_request::emu_requested))
+	{
+		do_local_task(rsx::FIFO::state::lock_wait);
+	}
+
+	service_zcull_semaphore_wait();  // M4: ZCULL progress while the acquire blocks the FIFO loop
+}
+
+void MTLGSRender::do_local_task(rsx::FIFO::state state)
+{
+	// GLGSRender / VKGSRender: the texture cache update only runs when no fault request was pending (review R2).
+	const bool requests_pending = flush_pending_requests();
+	// M4: the flush a conditional render evaluation hint scheduled; VK m_flush_requests, which defers the update too
+	const bool zcull_flushed = service_zcull_flush();
+	if (!requests_pending && !zcull_flushed && !in_begin_end && state != rsx::FIFO::state::lock_wait)
+	{
+		if (m_graphics_state & rsx::pipeline_state::framebuffer_reads_dirty)
+		{
+			// This will re-engage locks and break the texture cache if another thread is waiting in access violation
+			// handler! Only call when there are no waiters.
+			m_texture_cache.do_update();
+			m_graphics_state.clear(rsx::pipeline_state::framebuffer_reads_dirty);
+		}
+	}
+
+	rsx::thread::do_local_task(state);
+
+	service_native_ui_flip(state);  // M4: frames for the native interface (VKGSRender::do_local_task)
+	report_counters_if_due();  // 906
+}
+
+bool MTLGSRender::scaled_image_from_memory(const rsx::blit_src_info& src, const rsx::blit_dst_info& dst, bool interpolate)
+{
+	// VKGSRender::scaled_image_from_memory. A copy into a DMA section is submitted as soon as it is recorded
+	// (review R1), so nothing of the transfer waits for the next submission.
+	if (m_texture_cache.blit(src, dst, interpolate, m_rtts, m_commands))
+	{
+		m_samplers_dirty.store(true);
+		if (m_commands.has_dma_transfer())
+		{
+			flush_command_queue(false);
+		}
+		return true;
+	}
+
+	return false;
+}
+
+void MTLGSRender::notify_tile_unbound(u32 /*tile*/)
+{
+	// As VKGSRender / GLGSRender (the texture writeback of an unbound tile is a TODO there too).
+	std::lock_guard lock(m_sampler_mutex);
+	m_samplers_dirty.store(true);
+}
+
