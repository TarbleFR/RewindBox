+				break;
+			case zw::depth_verdict::hard_cap:
+				tally.depth_hard_cap_hints.fetch_add(1, std::memory_order_relaxed);
+				break;
+			case zw::depth_verdict::unknown:
+				tally.depth_unknown.fetch_add(1, std::memory_order_relaxed);
+				break;
+			case zw::depth_verdict::front_submitted:
+				tally.depth_skip_submitted.fetch_add(1, std::memory_order_relaxed);
+				m_ios_depth_skips++;
+				// The oldest pending query is on the GPU, and every older one was retired: every query up to it is
+				// submitted, which is what a hint of it would record (on_sync_hint). Without this, the critical-age
+				// branch of update() would hint that submitted query again at each tick.
+				m_sync_tag = std::max(m_sync_tag, front->sync_tag);
+				break;
+			case zw::depth_verdict::open_cb_bound:
+				tally.depth_open_cb_bound.fetch_add(1, std::memory_order_relaxed);
+				m_ios_depth_skips = 0;
+				break;
+			case zw::depth_verdict::same_command_buffer:
+				tally.depth_skip_same_cb.fetch_add(1, std::memory_order_relaxed);
+				break;
+			}
+
+			return zw::depth_hint_sent(verdict);
+		}
+
+		void ZCULL_control::ios_release_stale_pages(u32 memory_address, u32 memory_range)
+		{
+			// RSX thread, after ios_retire_claimed(): the copy that follows reads these pages.
+			if (!memory_range)
+			{
+				return;
+			}
+
+			std::scoped_lock lock(m_pages_mutex);
+			const u32 page_size = static_cast<u32>(utils::get_page_size());
+			const u32 last = utils::page_start(memory_address + (memory_range - 1));
+
+			for (u32 page = utils::page_start(memory_address);; page += page_size)
+			{
+				auto& block = m_locked_pages[rsx::classify_location(page)];
+
+				if (auto found = block.find(page); found != block.end() && !found->second.has_refs())
+				{
+					if (found->second.prot != utils::protection::rw)
+					{
+						utils::memory_protect(vm::base(page), utils::get_page_size(), utils::protection::rw);
+					}
+
+					block.erase(found);
+				}
+
+				if (page == last)
+				{
+					break;
+				}
+			}
+		}
+
+		void ZCULL_control::ios_log_trip() const
+		{
+			// REWINDBOX_ZCULL_DEMAND_GUARD_621: the trip reaches the journal as a profiler
+			// line (the host keeps no RSX warning), with the windows that caused it.
+			namespace od = rpcs3::ios::zcull_on_demand;
+			const auto trip = m_ios_demand.trip_record();
+			rsx_log.notice("COREPROF ZCULLTRIP621 reason=%s scope=%s windows_ms=%.1f:%.1f:%.1f at_us=%llu "
+				"rule=thread%ums_x%u:all%ums_x%u:severe%ums_%uwaits:storm%u:pickup%ums:hard%ums mode_after=upstream_for_boot",
+				od::trip_reason_name(trip.reason), trip.scope == 1 ? "thread" : trip.scope == 2 ? "all_threads" : "none",
+				trip.windows_us[0] / 1000.0, trip.windows_us[1] / 1000.0, trip.windows_us[2] / 1000.0,
+				static_cast<u64>(trip.at_us),
+				static_cast<u32>(od::wait_budget_us / 1000), od::sustained_windows, static_cast<u32>(od::global_budget_us / 1000),
+				od::sustained_windows, static_cast<u32>(od::severe_wait_us / 1000), od::severe_min_waits, od::storm_services,
+				static_cast<u32>(od::pickup_deadline_us / 1000), static_cast<u32>(od::hard_deadline_us / 1000));
+		}
