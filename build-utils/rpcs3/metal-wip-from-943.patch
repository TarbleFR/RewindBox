diff --git a/rpcs3/ios/IOSWaitingSuspend944.h b/rpcs3/ios/IOSWaitingSuspend944.h
new file mode 100644
index 0000000..910166d
--- /dev/null
+++ b/rpcs3/ios/IOSWaitingSuspend944.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+
+// REWINDBOX_WAITING_SUSPEND_944: a PPU thread that must give its slot up while it is outside guest code is suspended
+// without an acknowledgment to wait for.
+//
+// IPA 767 (17 November 2026, Core 943), Black Ops II in play (PID 32585, session 2, window 20): 8,260 suspensions per
+// 5 s window, and for 804 ms of it lv2_obj::schedule_all() woke nothing because g_pending was not zero; 9,547 wakes
+// were held back, 5,426 of them while every thread that owed the acknowledgment was in a host wait (cpu_flag::wait)
+// (COREPROF SCHED943 gate_pending=4121:5426). The samples find the Backend thread suspended in 46 % of them, 2,456
+// times just after a sys_semaphore_post, the main thread in 32 % (PPUPROF912). God of War III: 1,162 suspensions,
+// 110 ms. The upstream rule: a thread pushed beyond the ppu_threads slots gets cpu_flag::suspend and must acknowledge
+// it itself (at its next sleep, or through cpu_sleep -> lv2_obj::awake from check_state) before any wake proceeds,
+// so that no more than ppu_threads threads run guest code. A thread in a host wait cannot acknowledge until the wait
+// ends, so every other thread of the process waits for it.
+//
+// A thread in cpu_flag::wait leaves that state only in cpu_thread::check_state(), whose single atomic step keeps
+// cpu_flag::wait while cpu_flag::suspend is set when the thread may stop there; a thread that may not stop (cpu_flag::temp
+// set, or inside a check_state call that cleared it) leaves it, but only to host code, and stops at its next check
+// before guest code. So when cpu_flag::suspend is added in one atomic step that sees cpu_flag::wait and not
+// cpu_flag::temp, the thread cannot run guest code before it has seen the suspension, and the slot it held is free.
+// Two things the acknowledgment also protected are kept by other means:
+// - A thread still on its way to lv2_obj::sleep() (it set cpu_flag::wait at the system call's entry) may be resumed by
+//   schedule_all() before it sleeps; the cpu_flag::signal of that resume would make the sleep fail as signalled and its
+//   wait return without being woken. Such a suspension is recorded here (under lv2_obj::g_mutex) until the thread's next
+//   sleep_unlocked(), which drops a pending cpu_flag::signal of a recorded thread before its test: a PPU thread's signal
+//   only ever comes from a schedule_all() resume, and the resume that wakes a sleep needs the cpu_flag::suspend this sleep
+//   adds, so no wake-up of that sleep can come before it (an early lv2_obj::awake finds the thread still queued and
+//   only sets cancel_sleep, as upstream). The
+//   resume itself keeps cpu_flag::signal, which check_state() needs to call cpu_sleep() again at a later suspension.
+// - A thread that still holds one of the vm passive lock slots (vm::g_locks) keeps the upstream path: the thread woken
+//   in its place would otherwise spin in vm::_register_lock until the suspended one released its slot.
+// Any other state (running guest code, cpu_flag::temp, a slot held, a full record) keeps the acknowledgment as before.
+// The slot count, the priorities and the order of the queue do not change. Setting PPU suspension of waiting threads
+// (Experimental, PPU): Automatic is Black Ops II and God of War III, Enabled every title, Disabled none.
+// COREPROF SCHED943 acks_skipped= counts the suspensions that needed no acknowledgment. The debugger's "(LV2 suspended)"
+// mark (ack_suspend) is not shown for them.
+namespace rpcs3::ios::waiting_suspend944
+{
+inline std::atomic<bool> enabled{false}; // resolved at boot (RPCS3IOSExperimentalPolicy.cpp)
+
+// The threads suspended without acknowledgment since their last lv2 sleep. Only under lv2_obj::g_mutex. When it is full,
+// a suspension takes the upstream path.
+inline std::array<const void*, 64> unacked{};
+inline std::size_t unacked_count = 0;
+
+inline bool mark(const void* thread) noexcept
+{
+	for (std::size_t i = 0; i < unacked_count; i++)
+	{
+		if (unacked[i] == thread)
+		{
+			return true;
+		}
+	}
+
+	if (unacked_count == unacked.size())
+	{
+		return false;
+	}
+
+	unacked[unacked_count++] = thread;
+	return true;
+}
+
+// Forgets the record of `thread`; true if there was one.
+inline bool take(const void* thread) noexcept
+{
+	for (std::size_t i = 0; i < unacked_count; i++)
+	{
+		if (unacked[i] == thread)
+		{
+			unacked[i] = unacked[--unacked_count];
+			unacked[unacked_count] = nullptr;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+inline void reset() noexcept
+{
+	unacked = {};
+	unacked_count = 0;
+}
+} // namespace rpcs3::ios::waiting_suspend944
+
+class cpu_thread;
+
+namespace vm
+{
+// Emu/Memory/vm.cpp: whether `cpu` holds one of the passive lock slots (g_locks).
+bool ios_holds_passive_slot(const cpu_thread* cpu) noexcept;
+}
