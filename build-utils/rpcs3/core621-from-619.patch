+	unsigned long long episode = 0);
diff --git a/rpcs3/ios/RPCS3IOSFreezeEpisode.h b/rpcs3/ios/RPCS3IOSFreezeEpisode.h
new file mode 100644
index 0000000..655b3e7
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSFreezeEpisode.h
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_FREEZE_EPISODE_621: a freeze is an episode, not a 5 s window.
+// The profiler sampler (every 500 ms, RPCS3IOSPerformance.cpp) feeds the
+// emulator state and the guest flip count. The no-frame clock only advances
+// while the emulator runs: time paused, loading, stopping and the gaps of an
+// iOS suspension (no sample for more than 2 s) are kept apart, so an episode
+// that began before a pause keeps its evidence across any number of pauses and
+// resumes, and a pause alone never makes one.
+//  - begin: no guest flip for 3 s of running time while a thread group uses at
+//    least half a core (no_frames_busy, the Build 487 trigger), or for 6 s with
+//    less activity (no_frames_idle, a quiet freeze), or the emulator froze on a
+//    guest fault (emulator_frozen). The no-frame triggers are armed by the first
+//    guest flip of the session: a boot that compiles before its first frame is
+//    loading, not a freeze. One FREEZE_DUMP per episode: requested at the begin,
+//    retried on the following samples until the dump reports it was taken
+//    (dump_taken), never more often than every 10 s across episodes.
+//  - update: every 10 s of episode time for the first minute, then every 60 s.
+//  - end: recovered once guest flips come back steadily (10 flips over at
+//    least 1 s of running time), or stopped with the session. A later stall is
+//    a new episode with its own dump.
+// The host (Rpcs3Diagnostics.mm) adds what the Core cannot see: whether its
+// menu was open and whether the app was in the background.
+namespace rpcs3::ios::freeze_episode
+{
+inline constexpr std::uint64_t busy_begin_us = 3'000'000;
+inline constexpr std::uint64_t idle_begin_us = 6'000'000;
+inline constexpr double busy_cores = 0.5;
+inline constexpr std::uint64_t suspend_gap_us = 2'000'000;
+inline constexpr std::uint64_t recover_span_us = 1'000'000;
+inline constexpr std::uint64_t recover_flips = 10;
+inline constexpr std::uint64_t early_update_us = 10'000'000;
+inline constexpr std::uint64_t late_update_us = 60'000'000;
+inline constexpr std::uint64_t early_window_us = 60'000'000;
+inline constexpr std::uint64_t min_dump_interval_us = 10'000'000;
+
+enum class emu : std::uint32_t
+{
+	running = 0,
+	paused = 1,  // Emu.Pause (debugger, frame capture); RewindBox's menu does not pause
+	frozen = 2,  // Emu.Pause(true) after a guest access violation
+	loading = 3, // ready, starting, loading
+	stopped = 4, // stopping, stopped
+};
+
+enum class event : std::uint32_t
+{
+	none = 0,
+	begin = 1,
+	update = 2,
+	end = 3,
+};
+
+inline const char* event_name(event value) noexcept
+{
+	switch (value)
+	{
+	case event::begin: return "begin";
+	case event::update: return "update";
+	case event::end: return "end";
+	default: return "none";
+	}
+}
+
+struct tick
+{
+	std::uint64_t now_us = 0;     // steady clock
+	emu state = emu::running;
+	std::uint64_t guest_flips = 0; // monotonic count of guest flips
+	double busiest_cores = 0.0;    // busiest thread group of this sample
+};
+
+struct report
+{
+	event what = event::none;
+	std::uint64_t episode = 0;
+	const char* reason = "";   // no_frames_busy | no_frames_idle | emulator_frozen
+	const char* outcome = "";  // open | recovered | stopped
+	bool dump = false;         // take the FREEZE_DUMP of this episode now (also on a sample without event)
+	bool dump_suppressed = false; // the 10 s floor delays the dump of this episode
+	double no_frames_s = 0.0;      // running time without a guest flip when the episode began
+	double episode_s = 0.0;        // running time since the episode began
+	double paused_s = 0.0;         // paused or frozen wall time inside the episode
+	double suspended_s = 0.0;      // sampling gaps over 2 s inside the episode (iOS suspension)
+	double loading_s = 0.0;        // loading-state wall time inside the episode
+	std::uint32_t pauses = 0, suspensions = 0;
+	std::uint64_t flips_during = 0; // guest flips seen while the episode was open
+	double busiest_cores = 0.0;     // at begin, then the current sample
+	double begin_busiest_cores = 0.0;
+	double last_flip_age_s = 0.0;   // wall time since the last guest flip
+};
+
+class tracker
+{
+public:
+	void reset() noexcept { *this = {}; }
+
+	report observe(const tick& sample) noexcept
+	{
+		report result;
+		if (!m_started)
+		{
+			m_started = true;
+			m_previous_us = sample.now_us;
+			m_flips = sample.guest_flips;
+			m_last_flip_wall_us = sample.now_us;
+			m_previous_state = sample.state;
+			return result;
+		}
+
+		const std::uint64_t gap = sample.now_us > m_previous_us ? sample.now_us - m_previous_us : 0;
+		m_previous_us = sample.now_us;
+		const bool suspended = gap > suspend_gap_us;
+		const bool running = sample.state == emu::running;
+
+		if (m_open)
+		{
+			if (suspended)
+			{
+				m_suspended_us += gap;
+				m_suspensions++;
+			}
+			else if (sample.state == emu::paused || sample.state == emu::frozen)
+			{
+				m_paused_us += gap;
+			}
+			else if (sample.state == emu::loading)
+			{
+				m_loading_us += gap;
+			}
+			if (sample.state == emu::paused && m_previous_state != emu::paused)
+			{
+				m_pauses++;
+			}
+		}
+		m_previous_state = sample.state;
+
+		if (running && !suspended)
+		{
+			m_active_us += gap;
+		}
+
+		if (sample.guest_flips != m_flips)
+		{
+			const std::uint64_t delta = sample.guest_flips > m_flips ? sample.guest_flips - m_flips : 1;
+			m_flips = sample.guest_flips;
+			m_armed = true;
+			m_last_flip_active_us = m_active_us;
+			m_last_flip_wall_us = sample.now_us;
+			if (m_open)
+			{
+				m_flips_during += delta;
+				if (!m_recovering)
+				{
+					m_recovering = true;
+					m_recover_since_us = m_active_us;
+					m_recover_flips = 0;
+				}
+				m_recover_flips += delta;
+			}
+		}
+		else if (m_open && m_recovering && m_active_us - m_last_flip_active_us >= recover_span_us)
+		{
+			m_recovering = false; // flips stopped again before the recovery held
+		}
+
+		if (sample.state == emu::stopped)
+		{
+			if (m_open) return close("stopped", sample);
+			m_last_flip_active_us = m_active_us;
+			return result;
+		}
+
+		if (m_open)
+		{
+			if (m_recovering && m_recover_flips >= recover_flips && m_active_us - m_recover_since_us >= recover_span_us)
+			{
+				return close("recovered", sample);
+			}
+
+			const std::uint64_t elapsed = episode_us();
+			const std::uint64_t period = elapsed < early_window_us ? early_update_us : late_update_us;
+			if (elapsed >= m_next_update_us)
+			{
+				m_next_update_us = elapsed + period;
+				fill(result, event::update, "open", sample);
+			}
+			request_dump(result, sample.now_us);
+			return result;
+		}
+
+		const std::uint64_t idle = m_active_us - m_last_flip_active_us;
+		const char* reason = nullptr;
+		if (sample.state == emu::frozen)
+			reason = "emulator_frozen";
+		else if (m_armed && running && idle >= busy_begin_us && sample.busiest_cores >= busy_cores)
+			reason = "no_frames_busy";
+		else if (m_armed && running && idle >= idle_begin_us)
+			reason = "no_frames_idle";
+		if (!reason) return result;
+
+		m_open = true;
+		m_episode++;
+		m_reason = reason;
+		m_wall_clock = sample.state == emu::frozen;
+		m_begin_active_us = m_active_us;
+		m_begin_frozen_us = sample.now_us;
+		m_no_frames_us = idle;
+		m_paused_us = m_suspended_us = m_loading_us = 0;
+		m_pauses = m_suspensions = 0;
+		m_flips_during = 0;
+		m_recovering = false;
+		m_begin_cores = sample.busiest_cores;
+		m_next_update_us = early_update_us;
+		m_dump_pending = true;
+		fill(result, event::begin, "open", sample);
+		request_dump(result, sample.now_us);
+		result.dump_suppressed = !result.dump;
+		return result;
+	}
+
+	// The dump of the open episode was taken (neostation_freeze_dump returned true).
+	void dump_taken(std::uint64_t now_us) noexcept
+	{
+		m_dump_pending = false;
+		m_last_dump_us = now_us ? now_us : 1;
+	}
+
+	// The session ended (profiler reset or Core stop) with an episode open.
+	report stop(std::uint64_t now_us) noexcept
+	{
+		report result;
+		if (!m_open) return result;
+		tick sample;
+		sample.now_us = now_us;
+		sample.state = emu::stopped;
+		return close("stopped", sample);
+	}
+
+	bool open() const noexcept { return m_open; }
+	std::uint64_t episodes() const noexcept { return m_episode; }
+
+private:
+	std::uint64_t episode_us() const noexcept
+	{
+		const std::uint64_t running = m_active_us - m_begin_active_us;
+		// A guest-fault freeze keeps the emulator out of the running state: its
+		// episode time is wall time.
+		return m_wall_clock ? m_previous_us - m_begin_frozen_us : running;
+	}
+
+	void fill(report& result, event what, const char* outcome, const tick& sample) const noexcept
+	{
+		result.what = what;
+		result.episode = m_episode;
+		result.reason = m_reason ? m_reason : "";
+		result.outcome = outcome;
+		result.no_frames_s = static_cast<double>(m_no_frames_us) / 1e6;
+		result.episode_s = static_cast<double>(episode_us()) / 1e6;
+		result.paused_s = static_cast<double>(m_paused_us) / 1e6;
+		result.suspended_s = static_cast<double>(m_suspended_us) / 1e6;
+		result.loading_s = static_cast<double>(m_loading_us) / 1e6;
+		result.pauses = m_pauses;
+		result.suspensions = m_suspensions;
+		result.flips_during = m_flips_during;
+		result.busiest_cores = sample.busiest_cores;
+		result.begin_busiest_cores = m_begin_cores;
+		result.last_flip_age_s = sample.now_us > m_last_flip_wall_us
+			? static_cast<double>(sample.now_us - m_last_flip_wall_us) / 1e6 : 0.0;
+	}
+
+	// One dump per episode; a flapping title cannot dump more often than every 10 s.
+	void request_dump(report& result, std::uint64_t now_us) const noexcept
+	{
+		result.dump = m_dump_pending && (!m_last_dump_us || now_us - m_last_dump_us >= min_dump_interval_us);
+		if (result.dump && result.what == event::none)
+		{
+			result.episode = m_episode;
+			result.reason = m_reason ? m_reason : "";
+			result.no_frames_s = static_cast<double>(m_no_frames_us) / 1e6;
+			result.begin_busiest_cores = m_begin_cores;
+		}
+	}
+
+	report close(const char* outcome, const tick& sample) noexcept
+	{
+		report result;
+		fill(result, event::end, outcome, sample);
+		m_dump_pending = false;
+		m_open = false;
+		m_recovering = false;
+		m_reason = nullptr;
+		m_last_flip_active_us = m_active_us;
+		return result;
+	}
+
+	bool m_started = false, m_open = false, m_recovering = false, m_wall_clock = false;
+	bool m_armed = false;        // a guest flip was seen in this session
+	bool m_dump_pending = false; // the open episode's dump is not taken yet
+	emu m_previous_state = emu::running;
+	const char* m_reason = nullptr;
+	std::uint64_t m_previous_us = 0, m_active_us = 0, m_flips = 0;
+	std::uint64_t m_last_flip_active_us = 0, m_last_flip_wall_us = 0;
+	std::uint64_t m_episode = 0, m_begin_active_us = 0, m_begin_frozen_us = 0, m_no_frames_us = 0;
+	std::uint64_t m_paused_us = 0, m_suspended_us = 0, m_loading_us = 0;
+	std::uint32_t m_pauses = 0, m_suspensions = 0;
+	std::uint64_t m_flips_during = 0, m_recover_since_us = 0, m_recover_flips = 0;
+	std::uint64_t m_next_update_us = 0, m_last_dump_us = 0;
+	double m_begin_cores = 0.0;
+};
+}
