+namespace
+{
+	// REWINDBOX_GPU_TIMING_621 (ios/IOSGpuTiming.h): one timestamp pair per
+	// primary chunk (queries 2 * slot and 2 * slot + 1). RSX thread only.
+	struct ios_gpu_timer_state
+	{
+		VkDevice device = VK_NULL_HANDLE;
+		VkQueryPool pool = VK_NULL_HANDLE;
+		PFN_vkGetCalibratedTimestampsEXT calibrate = nullptr;
+		u64 last_calibration_tsc = 0;
+	};
+
+	ios_gpu_timer_state g_ios_gpu_timer;
+
+	// Both queries of a slot, without VK_QUERY_RESULT_WAIT_BIT: an unwritten
+	// query reports availability 0 and the sample stays unavailable.
+	rpcs3::ios::gpu_timing::sample ios_gpu_read(u32 slot)
+	{
+		rpcs3::ios::gpu_timing::sample result;
+		if (!g_ios_gpu_timer.pool)
+		{
+			return result;
+		}
+
+		u64 values[4] = {};
+		const VkResult status = vkGetQueryPoolResults(g_ios_gpu_timer.device, g_ios_gpu_timer.pool, slot * 2, 2,
+			sizeof(values), values, sizeof(u64) * 2, VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+		result.available = (status == VK_SUCCESS || status == VK_NOT_READY) && values[1] && values[3];
+		result.begin = values[0];
+		result.end = values[2];
+		return result;
+	}
+
+	// A GPU/host timestamp pair at most every calibration_period_us.
+	void ios_gpu_calibrate(bool force)
+	{
+		if (!g_ios_gpu_timer.calibrate)
+		{
+			return;
+		}
+
+		auto& tracker = rpcs3::ios::gpu_timing::instance();
+		const u64 frequency = utils::get_tsc_freq();
+		const u64 now = utils::get_tsc();
+		if (!force && frequency && now - g_ios_gpu_timer.last_calibration_tsc <
+			frequency / 1'000'000 * rpcs3::ios::gpu_timing::calibration_period_us)
+		{
+			return;
+		}
+
+		VkCalibratedTimestampInfoEXT info{};
+		info.sType = VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT;
+		info.timeDomain = VK_TIME_DOMAIN_DEVICE_EXT;
+		u64 gpu = 0, deviation = 0;
+		const u64 before = utils::get_tsc();
+		const VkResult status = g_ios_gpu_timer.calibrate(g_ios_gpu_timer.device, 1, &info, &gpu, &deviation);
+		const u64 after = utils::get_tsc();
+		if (status == VK_SUCCESS && gpu)
+		{
+			tracker.add_calibration(gpu, before, after);
+		}
+		else
+		{
+			tracker.calibration_failed();
+		}
+		g_ios_gpu_timer.last_calibration_tsc = after;
+		tracker.add_probe_cost(after - now);
+	}
+}
+
+// vk::command_buffer::begin() of a timed primary chunk, whatever reopened it
+// (close_and_submit, flips, texture_cache::cleanup_after_dma_transfers).
+void vk::ios_gpu_timing_on_begin(vk::command_buffer& cmd)
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (!g_ios_gpu_timer.pool || !tracker.active())
+	{
+		return;
+	}
+
+	const u64 begin = utils::get_tsc();
+	// The previous use of this slot completed (the renderer waited for it):
+	// take its result before the queries are reset.
+	tracker.release_slot(cmd.ios_gpu_slot, ios_gpu_read);
+	vkCmdResetQueryPool(cmd, g_ios_gpu_timer.pool, cmd.ios_gpu_slot * 2, 2);
+	vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, g_ios_gpu_timer.pool, cmd.ios_gpu_slot * 2);
+	tracker.on_begin(cmd.ios_gpu_slot);
+	tracker.add_probe_cost(utils::get_tsc() - begin);
+}
+
+// vk::command_buffer::end(): the end timestamp, if this recording has its begin one.
+bool vk::ios_gpu_timing_on_end(vk::command_buffer& cmd)
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (!g_ios_gpu_timer.pool || !tracker.active() || !tracker.begun(cmd.ios_gpu_slot))
+	{
+		return false;
+	}
+
+	const u64 begin = utils::get_tsc();
+	vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g_ios_gpu_timer.pool, cmd.ios_gpu_slot * 2 + 1);
+	tracker.add_probe_cost(utils::get_tsc() - begin);
+	return true;
+}
+
+// vk::command_buffer::submit(): a timed submission joins the FIFO; one without its
+// pair (begun before the probe started, or reset) is counted as untimed.
+void vk::ios_gpu_timing_on_submit(vk::command_buffer& cmd, bool timed, u64 submit_tsc)
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (timed && g_ios_gpu_timer.pool && tracker.active())
+	{
+		tracker.on_submit(cmd.ios_gpu_slot, submit_tsc);
+		return;
+	}
+
+	tracker.clear_begun(cmd.ios_gpu_slot);
+	tracker.on_untimed_submit();
+}
+
+void VKGSRender::ios_gpu_timing_init()
+{
+	namespace gt = rpcs3::ios::gpu_timing;
+	// The primary chunk ring and the tracker's slots are the same 512 entries.
+	static_assert(VK_MAX_ASYNC_CB_COUNT == gt::slot_count);
+	auto& tracker = gt::instance();
+	g_ios_gpu_timer = {};
+
+	// timestampComputeAndGraphics: every graphics and compute queue has valid
+	// timestamp bits (MoltenVK 1.4.2 reports VK_TRUE).
+	const auto& limits = m_device->gpu().get_limits();
+	// Fully qualified: rsx::thread inherits cpu_thread::state, which hides the enum.
+	gt::state probe = gt::state::active;
+	if (!rpcs3::ios::get_experimental_policy().gpu_timing)
+	{
+		probe = gt::state::disabled;
+	}
+	else if (!limits.timestampComputeAndGraphics || !(limits.timestampPeriod > 0.f))
+	{
+		probe = gt::state::no_support;
+	}
+	else
+	{
+		VkQueryPoolCreateInfo info{};
+		info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+		info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+		info.queryCount = gt::slot_count * 2;
+		if (vkCreateQueryPool(*m_device, &info, nullptr, &g_ios_gpu_timer.pool) != VK_SUCCESS)
+		{
+			g_ios_gpu_timer.pool = VK_NULL_HANDLE;
+			probe = gt::state::no_pool;
+		}
+	}
+
+	if (probe == gt::state::active)
+	{
+		g_ios_gpu_timer.device = *m_device;
+		for (u32 index = 0; index < VK_MAX_ASYNC_CB_COUNT; ++index)
+		{
+			auto* chunk = m_primary_cb_list.at(index);
+			chunk->ios_gpu_timed = true;
+			chunk->ios_gpu_slot = index;
+		}
+
+		if (m_device->get_calibrated_timestamps_support())
+		{
+			g_ios_gpu_timer.calibrate = reinterpret_cast<PFN_vkGetCalibratedTimestampsEXT>(
+				vkGetDeviceProcAddr(*m_device, "vkGetCalibratedTimestampsEXT"));
+		}
+	}
+
+	tracker.begin_session(rpcs3::ios::frame_trace::active_session.load(std::memory_order_acquire), probe,
+		limits.timestampPeriod, utils::get_tsc_freq());
+	ios_gpu_calibrate(true);
+	rsx_log.notice("COREPROF GPUTIME621_BOOT state=%s session=%llu period_ns=%.3f compute_and_graphics=%u calibrated_timestamps=%u "
+		"slots=%u queries_per_submission=2 mechanism=vulkan_timestamp_pair_metal_stage_boundary "
+		"read=fence_complete_no_wait scope=rsx_primary_command_buffers",
+		gt::state_name(probe), rpcs3::ios::frame_trace::active_session.load(std::memory_order_relaxed),
+		limits.timestampPeriod, limits.timestampComputeAndGraphics ? 1u : 0u, g_ios_gpu_timer.calibrate ? 1u : 0u, gt::slot_count);
+}
+
+void VKGSRender::ios_gpu_timing_shutdown()
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (g_ios_gpu_timer.pool && tracker.active())
+	{
+		// The device is idle: every remaining submission is read once.
+		tracker.collect([](u32) { return true; }, ios_gpu_read, rpcs3::ios::gpu_timing::slot_count);
+	}
+
+	tracker.end_session();
+	if (g_ios_gpu_timer.pool)
+	{
+		vkDestroyQueryPool(*m_device, g_ios_gpu_timer.pool, nullptr);
+	}
+	g_ios_gpu_timer = {};
+}
+
+// Frame end, RSX thread: results of completed submissions, oldest first.
+void VKGSRender::ios_gpu_timing_collect()
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (!g_ios_gpu_timer.pool || !tracker.active())
+	{
+		return;
+	}
+
+	const u64 begin = utils::get_tsc();
+	if (tracker.pending())
+	{
+		tracker.collect([this](u32 slot) { return m_primary_cb_list.at(slot)->ios_submission_complete(); }, ios_gpu_read);
+	}
+	tracker.add_probe_cost(utils::get_tsc() - begin);
+	ios_gpu_calibrate(false);
+}
