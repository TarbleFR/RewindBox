+	// REWINDBOX_ISO_IMAGE_LIFETIME_621: one iso_file's view of the shared image.
+	// Reads are positional (pread through fs::file::read_at), so concurrent files
+	// never share a position; this view keeps its own for read() and seek().
+	class iso_shared_image final : public fs::file_base
+	{
+		std::shared_ptr<fs::file> m_image;
+		u64 m_pos = 0;
+
+	public:
+		explicit iso_shared_image(std::shared_ptr<fs::file> image)
+			: m_image(std::move(image))
+		{
+		}
+
+		fs::stat_t get_stat() override
+		{
+			return m_image->get_stat();
+		}
+
+		bool trunc(u64) override
+		{
+			fs::g_tls_error = fs::error::readonly;
+			return false;
+		}
+
+		u64 read(void* buffer, u64 size) override
+		{
+			const u64 result = m_image->read_at(m_pos, buffer, size);
+			m_pos += result;
+			return result;
+		}
+
+		u64 read_at(u64 offset, void* buffer, u64 size) override
+		{
+			return m_image->read_at(offset, buffer, size);
+		}
+
+		u64 write(const void*, u64) override
+		{
+			fs::g_tls_error = fs::error::readonly;
+			return 0;
+		}
+
+		u64 seek(s64 offset, fs::seek_mode whence) override
+		{
+			const s64 position =
+				whence == fs::seek_set ? offset :
+				whence == fs::seek_cur ? offset + static_cast<s64>(m_pos) :
+				whence == fs::seek_end ? offset + static_cast<s64>(m_image->size()) : -1;
+			if (position < 0)
+			{
+				fs::g_tls_error = fs::error::inval;
+				return umax;
+			}
+
+			m_pos = static_cast<u64>(position);
+			return m_pos;
+		}
+
+		u64 size() override
+		{
+			return m_image->size();
+		}
+	};
+}
