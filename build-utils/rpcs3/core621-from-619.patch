@@ -0,0 +1,861 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+// REWINDBOX_GPU_TIMING_621: GPU execution time of the RSX primary command
+// buffers, read after their submission completed, never waited for.
+//
+// Path (Core 619, MoltenVK 1.4.2 db66022 plus the RewindBox patches):
+// VKGSRender::close_and_submit_command_buffer -> vk::queue_submit ->
+// vkQueueSubmit -> MVKQueueCommandBufferSubmission (one MTLCommandBuffer per
+// submission) -> Metal. What that MoltenVK exposes after completion:
+//  - MTLCommandBuffer GPUStartTime/GPUEndTime: read nowhere by MoltenVK, and
+//    VK_EXT_metal_objects exports devices, queues, buffers, textures, IOSurfaces
+//    and shared events, not command buffers: unreachable without patching it.
+//  - vkGetPerformanceStatisticsMVK: queue.mtlCommandBufferExecution is a CPU
+//    interval from commit to the completion handler, aggregated over the
+//    process: not GPU time, not per submission.
+//  - Vulkan timestamp queries: on Apple GPUs (stage-boundary counter sampling)
+//    MoltenVK defers every vkCmdWriteTimestamp to the end of the current Metal
+//    encoder batch and samples it at the start of a one-byte blit pass that
+//    waits for the previous encoders (MVKCommandEncoder::
+//    encodeTimestampStageCounterSamples). A pair at the start and end of a
+//    command buffer therefore brackets its GPU work. Results come from an
+//    MTLCounterSampleBuffer after the command buffer completed. If MoltenVK
+//    could not create that buffer it falls back to one CPU time at completion:
+//    both values are then equal (counted as zero_duration, never as GPU time).
+//  - VK_EXT_calibrated_timestamps: pairs a GPU timestamp with a host time
+//    (-[MTLDevice sampleTimestamps:gpuTimestamp:]). Two pairs seconds apart
+//    give the GPU tick rate against the host TSC, checked rather than assumed
+//    (MoltenVK reports timestampPeriod 1.0 on Apple GPUs), and place GPU times
+//    on the host clock (queue delay = GPU start - RSX submit).
+// This header holds the bookkeeping only (no Vulkan): one producer, the RSX
+// thread, and one reader, the profiler report. Results are read without the
+// WAIT bit: a submission whose fence has not signalled stays pending.
+namespace rpcs3::ios::gpu_timing
+{
+inline constexpr std::uint32_t slot_count = 512;      // VK_MAX_ASYNC_CB_COUNT primary chunks, two queries each
+inline constexpr std::uint32_t frame_capacity = 512;  // RSX frames kept for the slow-frame lookup
+inline constexpr std::uint32_t sweep_limit = 64;      // results read per frame end at most
+inline constexpr std::uint64_t calibration_period_us = 2'000'000;
+inline constexpr std::uint64_t calibration_min_baseline_us = 500'000;
+inline constexpr std::uint64_t queue_delay_tolerance_us = 500;
+
+enum class state : std::uint32_t
+{
+	off = 0,        // no renderer session
+	active = 1,
+	no_pool = 2,    // the timestamp query pool could not be created
+	no_support = 3, // timestampComputeAndGraphics is false / no valid bits
+	disabled = 4,   // switched off by the experimental setting
+};
+
+inline const char* state_name(state value) noexcept
+{
+	switch (value)
+	{
+	case state::active: return "active";
+	case state::no_pool: return "no_pool";
+	case state::no_support: return "no_support";
+	case state::disabled: return "disabled";
+	default: return "off";
+	}
+}
+
+// What a frame's GPU value is worth.
+enum class frame_status : std::uint32_t
+{
+	not_found = 0, // no record for this session and frame (before the probe, or evicted)
+	none = 1,      // the frame submitted no primary command buffer
+	untimed = 2,   // none of its submissions carried timestamps
+	pending = 3,   // timed submissions still running or not yet read
+	partial = 4,   // every timed submission read, some submissions untimed or unavailable
+	complete = 5,  // every submission of the frame measured
+};
+
+inline const char* frame_status_name(frame_status value) noexcept
+{
+	switch (value)
+	{
+	case frame_status::none: return "no_submit";
+	case frame_status::untimed: return "untimed";
+	case frame_status::pending: return "pending";
+	case frame_status::partial: return "partial";
+	case frame_status::complete: return "complete";
+	default: return "not_found";
+	}
+}
+
+// GPU timestamps of one submission. available: both queries were written.
+struct sample
+{
+	bool available = false;
+	std::uint64_t begin = 0, end = 0;
+};
+
+// Union of GPU busy intervals taken in submission order: a command buffer
+// that starts before the previous one ended only adds what extends past it,
+// so overlapping submissions are never counted twice.
+struct busy_union
+{
+	std::uint64_t merged_end = 0;
+	std::uint64_t last_begin = 0;
+	bool any = false;
+
+	// Returns the ticks this interval adds; out_of_order when it starts before
+	// the previous one (one Metal queue starts command buffers in order).
+	std::uint64_t add(std::uint64_t begin, std::uint64_t end, bool& out_of_order) noexcept
+	{
+		out_of_order = any && begin < last_begin;
+		if (!any || begin > last_begin) last_begin = begin;
+		any = true;
+		if (end <= begin) return 0;
+		if (begin >= merged_end)
+		{
+			merged_end = end;
+			return end - begin;
+		}
+		if (end > merged_end)
+		{
+			const std::uint64_t added = end - merged_end;
+			merged_end = end;
+			return added;
+		}
+		return 0;
+	}
+};
+
+// GPU ticks against host TSC ticks, from calibrated timestamp pairs. The host
+// time of a pair is the middle of the TSC reads around the Vulkan call; half
+// their distance is its uncertainty.
+class calibration
+{
+public:
+	struct point
+	{
+		std::uint64_t gpu = 0, tsc = 0, half_span = 0;
+	};
+
+	void reset() noexcept { *this = {}; }
+
+	void add(std::uint64_t gpu, std::uint64_t tsc_before, std::uint64_t tsc_after) noexcept
+	{
+		if (tsc_after < tsc_before) return;
+		const point value{gpu, tsc_before + (tsc_after - tsc_before) / 2, (tsc_after - tsc_before) / 2};
+		if (!m_count++)
+		{
+			m_first = value;
+		}
+		m_latest = value;
+	}
+
+	std::uint64_t count() const noexcept { return m_count; }
+	const point& latest() const noexcept { return m_latest; }
+
+	// GPU ticks per TSC tick once the two points are min_baseline_tsc apart and
+	// the GPU clock moved forward with the host clock.
+	bool rate(std::uint64_t min_baseline_tsc, double& gpu_per_tsc, double& relative_uncertainty) const noexcept
+	{
+		if (m_count < 2 || m_latest.tsc <= m_first.tsc || m_latest.gpu <= m_first.gpu) return false;
+		const std::uint64_t baseline = m_latest.tsc - m_first.tsc;
+		if (baseline < min_baseline_tsc) return false;
+		gpu_per_tsc = static_cast<double>(m_latest.gpu - m_first.gpu) / static_cast<double>(baseline);
+		relative_uncertainty = static_cast<double>(m_first.half_span + m_latest.half_span) / static_cast<double>(baseline);
+		return true;
+	}
+
+private:
+	std::uint64_t m_count = 0;
+	point m_first{}, m_latest{};
+};
+
+// Per-window counters, read and cleared by the profiler report.
+struct window
+{
+	state probe = state::off;
+	std::uint64_t session = 0;
+	std::uint64_t queue_submits = 0; // every vkQueueSubmit of the process (any queue, any thread)
+	std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0, not_ready = 0;
+	std::uint64_t late_dropped = 0, stop_dropped = 0, overrun = 0, invalid = 0, zero_duration = 0;
+	std::uint64_t order_violations = 0, frame_evicted = 0, pending = 0;
+	std::uint64_t busy_ticks = 0, sum_ticks = 0, max_ticks = 0;
+	std::uint64_t queue_delay_samples = 0, queue_delay_sum_tsc = 0, queue_delay_max_tsc = 0, domain_violations = 0;
+	std::uint64_t probe_tsc = 0, probe_reads = 0, calibrations = 0, calibration_failures = 0;
+	std::uint64_t frames_gpu_over_33ms = 0, frames_gpu_over_50ms = 0, frames_measured = 0;
+	// Units: calibrated GPU ticks per TSC tick when available, otherwise the
+	// Vulkan timestampPeriod (nanoseconds per GPU tick) as reported.
+	bool calibrated = false;
+	double gpu_per_tsc = 0.0, calibration_uncertainty = 0.0, period_ns = 0.0;
+	std::uint64_t tsc_frequency = 0;
+
+	// Microseconds of a GPU tick count.
+	double ticks_us(std::uint64_t ticks) const noexcept
+	{
+		if (calibrated && gpu_per_tsc > 0.0 && tsc_frequency)
+			return static_cast<double>(ticks) / gpu_per_tsc * 1'000'000.0 / static_cast<double>(tsc_frequency);
+		return static_cast<double>(ticks) * period_ns / 1000.0;
+	}
+
+	double tsc_us(std::uint64_t ticks) const noexcept
+	{
+		return tsc_frequency ? static_cast<double>(ticks) * 1'000'000.0 / static_cast<double>(tsc_frequency) : 0.0;
+	}
+};
+
+// GPU record of one RSX frame (the RSX work between two frame ends).
+struct frame_view
+{
+	frame_status status = frame_status::not_found;
+	std::uint64_t flip = 0;
+	std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0;
+	double busy_us = -1.0, sum_us = -1.0, span_us = -1.0, max_us = -1.0, queue_delay_max_us = -1.0;
+};
+
+class tracker
+{
+	struct slot
+	{
+		bool begun = false;   // the begin timestamp was recorded in the current use
+		bool pending = false; // submitted, results not processed yet
+		std::uint64_t serial = 0, epoch = 0, session = 0, submit_tsc = 0;
+	};
+
+	// Frame record as published to the reader (seqlock: odd while written).
+	struct published_frame
+	{
+		std::atomic<std::uint64_t> seq{0};
+		std::atomic<std::uint64_t> epoch{0}, flip{0}, session{0};
+		std::atomic<std::uint64_t> submits{0}, timed{0}, untimed{0}, resolved{0}, unavailable{0};
+		std::atomic<std::uint64_t> busy{0}, sum{0}, span_begin{0}, span_end{0}, max{0};
+		std::atomic<std::uint64_t> queue_delay_max{0}, queue_delay_valid{0};
+	};
+
+	struct frame_shadow
+	{
+		std::uint64_t epoch = 0, flip = 0, session = 0;
+		std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0;
+		std::uint64_t busy = 0, sum = 0, span_begin = 0, span_end = 0, max = 0;
+		std::uint64_t queue_delay_max = 0, queue_delay_valid = 0;
+		bool counted = false; // entered the >33/>50 ms window tallies
+	};
+
+	struct counters
+	{
+		std::atomic<std::uint64_t> queue_submits{0};
+		std::atomic<std::uint64_t> submits{0}, timed{0}, untimed{0}, resolved{0}, unavailable{0}, not_ready{0};
+		std::atomic<std::uint64_t> late_dropped{0}, stop_dropped{0}, overrun{0}, invalid{0}, zero_duration{0};
+		std::atomic<std::uint64_t> order_violations{0}, frame_evicted{0};
+		std::atomic<std::uint64_t> busy{0}, sum{0}, max{0};
+		std::atomic<std::uint64_t> queue_delay_samples{0}, queue_delay_sum{0}, queue_delay_max{0}, domain_violations{0};
+		std::atomic<std::uint64_t> probe_tsc{0}, probe_reads{0}, calibrations{0}, calibration_failures{0};
+		std::atomic<std::uint64_t> frames_over_33{0}, frames_over_50{0}, frames_measured{0};
+	};
+
+public:
+	// Renderer construction, RSX thread, before any submission of the session.
+	void begin_session(std::uint64_t session, state probe, double period_ns, std::uint64_t tsc_frequency) noexcept
+	{
+		for (auto& value : m_slots) value = {};
+		for (auto& value : m_fifo) value = 0;
+		for (auto& value : m_shadow) value = {};
+		m_union = {};
+		m_calibration.reset();
+		m_owner_calibrated = false;
+		m_owner_gpu_per_tsc = 0.0;
+		m_next_serial = 1;
+		m_oldest_serial = 1;
+		m_epoch = 1;
+		m_session = session;
+		m_tsc_frequency = tsc_frequency;
+		open_epoch(m_epoch);
+		m_pending.store(0, std::memory_order_relaxed);
+		m_period_bits.store(bits(period_ns), std::memory_order_relaxed);
+		m_tsc_frequency_published.store(tsc_frequency, std::memory_order_relaxed);
+		m_calibrated.store(0, std::memory_order_relaxed);
+		m_published_session.store(session, std::memory_order_relaxed);
+		m_state.store(static_cast<std::uint32_t>(probe), std::memory_order_release);
+	}
+
+	// Renderer destruction, RSX thread: results never read are dropped and
+	// counted; nothing is attributed to the next session.
+	void end_session() noexcept
+	{
+		std::uint64_t dropped = 0;
+		for (auto& value : m_slots)
+		{
+			dropped += value.pending;
+			value = {};
+		}
+		m_counters.stop_dropped.fetch_add(dropped, std::memory_order_relaxed);
+		m_pending.store(0, std::memory_order_relaxed);
+		m_session = 0;
+		m_state.store(static_cast<std::uint32_t>(state::off), std::memory_order_release);
+	}
+
+	bool active() const noexcept
+	{
+		return m_state.load(std::memory_order_relaxed) == static_cast<std::uint32_t>(state::active);
+	}
+
+	// ---- RSX thread ----------------------------------------------------
+
+	// The previous use of `index` must be processed before its queries are
+	// reset: read(index) returns its sample (the chunk's fence completed, the
+	// renderer waited for it as before). Older pending submissions go first so
+	// results are taken in submission order.
+	template <typename Read>
+	void release_slot(std::uint32_t index, Read&& read)
+	{
+		if (index >= slot_count || !m_slots[index].pending) return;
+		const std::uint64_t target = m_slots[index].serial;
+		while (m_oldest_serial <= target)
+		{
+			const std::uint32_t oldest = m_fifo[m_oldest_serial % slot_count];
+			slot& entry = m_slots[oldest];
+			if (entry.pending && entry.serial == m_oldest_serial)
+			{
+				const sample result = read(oldest);
+				m_counters.probe_reads.fetch_add(1, std::memory_order_relaxed);
+				process(entry, result);
+			}
+			m_oldest_serial++;
+		}
+	}
+
+	// The begin timestamp of `index` was recorded.
+	void on_begin(std::uint32_t index) noexcept
+	{
+		if (index < slot_count) m_slots[index].begun = true;
+	}
+
+	bool begun(std::uint32_t index) const noexcept
+	{
+		return index < slot_count && m_slots[index].begun;
+	}
+
+	// The recording of `index` was submitted without its pair (untimed).
+	void clear_begun(std::uint32_t index) noexcept
+	{
+		if (index < slot_count) m_slots[index].begun = false;
+	}
+
+	// The command buffer of `index`, closed with its end timestamp, was handed
+	// for submission at submit_tsc (RSX thread, before vkQueueSubmit).
+	void on_submit(std::uint32_t index, std::uint64_t submit_tsc) noexcept
+	{
+		if (index >= slot_count) return;
+		slot& entry = m_slots[index];
+		if (entry.pending)
+		{
+			// Never expected (release_slot runs at every begin): count, do not mix.
+			m_counters.overrun.fetch_add(1, std::memory_order_relaxed);
+			abandon(entry);
+		}
+		entry.begun = false;
+		entry.pending = true;
+		entry.serial = m_next_serial++;
+		entry.epoch = m_epoch;
+		entry.session = m_session;
+		entry.submit_tsc = submit_tsc;
+		m_fifo[entry.serial % slot_count] = index;
+		m_pending.fetch_add(1, std::memory_order_relaxed);
+		m_counters.submits.fetch_add(1, std::memory_order_relaxed);
+		m_counters.timed.fetch_add(1, std::memory_order_relaxed);
+		frame_shadow& frame = shadow(m_epoch);
+		frame.submits++;
+		frame.timed++;
+		publish(m_epoch);
+	}
+
+	// A submission without timestamps (heap sync, async streaming, probe off).
+	void on_untimed_submit(std::uint64_t count = 1) noexcept
+	{
+		m_counters.submits.fetch_add(count, std::memory_order_relaxed);
+		m_counters.untimed.fetch_add(count, std::memory_order_relaxed);
+		frame_shadow& frame = shadow(m_epoch);
+		frame.submits += count;
+		frame.untimed += count;
+		publish(m_epoch);
+	}
+
+	// Frame-end sweep, oldest first. complete(index) tells whether the chunk's
+	// fence signalled (no wait); read(index) reads its queries without waiting.
+	// Stops at the first submission still running or not yet readable.
+	template <typename Complete, typename Read>
+	void collect(Complete&& complete, Read&& read, std::uint32_t limit = sweep_limit)
+	{
+		for (std::uint32_t done = 0; done < limit && m_oldest_serial < m_next_serial;)
+		{
+			const std::uint32_t oldest = m_fifo[m_oldest_serial % slot_count];
+			slot& entry = m_slots[oldest];
+			if (!entry.pending || entry.serial != m_oldest_serial)
+			{
+				m_oldest_serial++;
+				continue;
+			}
+			if (!complete(oldest)) return;
+			const sample result = read(oldest);
+			m_counters.probe_reads.fetch_add(1, std::memory_order_relaxed);
+			done++;
+			if (!result.available)
+			{
+				// Fence signalled before MoltenVK marked the queries: retry later.
+				m_counters.not_ready.fetch_add(1, std::memory_order_relaxed);
+				return;
+			}
+			process(entry, result);
+			m_oldest_serial++;
+		}
+	}
+
+	// The RSX frame `flip` ended (rsx::thread::on_frame_end, the frame trace record).
+	// The epoch closes there, before int_flip_index advances and before the next
+	// flip's present: record F holds frame F-1's present and frame F's draws, the
+	// same interval as the frame trace and its waits. Stored as flip + 1 (0 = open).
+	void on_frame(std::uint64_t flip) noexcept
+	{
+		frame_shadow& frame = shadow(m_epoch);
+		frame.flip = flip + 1;
+		count_frame(frame); // every submission may already have been read
+		publish(m_epoch);
+		open_epoch(++m_epoch);
+	}
+
+	void add_calibration(std::uint64_t gpu, std::uint64_t tsc_before, std::uint64_t tsc_after) noexcept
+	{
+		m_counters.calibrations.fetch_add(1, std::memory_order_relaxed);
+		m_calibration.add(gpu, tsc_before, tsc_after);
+		double rate = 0.0, uncertainty = 0.0;
+		const std::uint64_t min_baseline = m_tsc_frequency / 1'000'000 * calibration_min_baseline_us;
+		if (m_calibration.rate(min_baseline, rate, uncertainty))
+		{
+			m_owner_calibrated = true;
+			m_owner_gpu_per_tsc = rate;
+			m_rate_bits.store(bits(rate), std::memory_order_relaxed);
+			m_uncertainty_bits.store(bits(uncertainty), std::memory_order_relaxed);
+			m_calibrated.store(1, std::memory_order_release);
+		}
+	}
+
+	void calibration_failed() noexcept
+	{
+		m_counters.calibration_failures.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	void add_probe_cost(std::uint64_t tsc_ticks) noexcept
+	{
+		m_counters.probe_tsc.fetch_add(tsc_ticks, std::memory_order_relaxed);
+	}
+
+	std::uint64_t pending() const noexcept { return m_pending.load(std::memory_order_relaxed); }
+
+	// Any thread: one vkQueueSubmit (vk::queue_submit_impl), the coverage denominator.
+	void on_queue_submit() noexcept
+	{
+		m_counters.queue_submits.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// ---- profiler report ------------------------------------------------
+
+	window take_window() noexcept
+	{
+		window result;
+		result.probe = static_cast<state>(m_state.load(std::memory_order_acquire));
+		result.session = m_published_session.load(std::memory_order_relaxed);
+		const auto take = [](std::atomic<std::uint64_t>& value) { return value.exchange(0, std::memory_order_relaxed); };
+		result.queue_submits = take(m_counters.queue_submits);
+		result.submits = take(m_counters.submits);
+		result.timed = take(m_counters.timed);
+		result.untimed = take(m_counters.untimed);
+		result.resolved = take(m_counters.resolved);
+		result.unavailable = take(m_counters.unavailable);
+		result.not_ready = take(m_counters.not_ready);
+		result.late_dropped = take(m_counters.late_dropped);
+		result.stop_dropped = take(m_counters.stop_dropped);
+		result.overrun = take(m_counters.overrun);
+		result.invalid = take(m_counters.invalid);
+		result.zero_duration = take(m_counters.zero_duration);
+		result.order_violations = take(m_counters.order_violations);
+		result.frame_evicted = take(m_counters.frame_evicted);
+		result.busy_ticks = take(m_counters.busy);
+		result.sum_ticks = take(m_counters.sum);
+		result.max_ticks = take(m_counters.max);
+		result.queue_delay_samples = take(m_counters.queue_delay_samples);
+		result.queue_delay_sum_tsc = take(m_counters.queue_delay_sum);
+		result.queue_delay_max_tsc = take(m_counters.queue_delay_max);
+		result.domain_violations = take(m_counters.domain_violations);
+		result.probe_tsc = take(m_counters.probe_tsc);
+		result.probe_reads = take(m_counters.probe_reads);
+		result.calibrations = take(m_counters.calibrations);
+		result.calibration_failures = take(m_counters.calibration_failures);
+		result.frames_gpu_over_33ms = take(m_counters.frames_over_33);
+		result.frames_gpu_over_50ms = take(m_counters.frames_over_50);
+		result.frames_measured = take(m_counters.frames_measured);
+		result.pending = m_pending.load(std::memory_order_relaxed);
+		units(result);
+		return result;
+	}
+
+	// The GPU record of RSX frame `flip` in `session`, converted with the
+	// current units. Never blocks the producer: a record being written is
+	// retried a few times, then reported as not found.
+	frame_view lookup(std::uint64_t session, std::uint64_t flip) const noexcept
+	{
+		frame_view view;
+		view.flip = flip;
+		if (!session) return view;
+		window scale;
+		units(scale);
+		for (const auto& entry : m_frames)
+		{
+			for (int attempt = 0; attempt < 4; ++attempt)
+			{
+				const std::uint64_t before = entry.seq.load(std::memory_order_acquire);
+				if (before & 1) continue;
+				frame_shadow copy;
+				copy.epoch = entry.epoch.load(std::memory_order_relaxed);
+				copy.flip = entry.flip.load(std::memory_order_relaxed);
+				copy.session = entry.session.load(std::memory_order_relaxed);
+				copy.submits = entry.submits.load(std::memory_order_relaxed);
+				copy.timed = entry.timed.load(std::memory_order_relaxed);
+				copy.untimed = entry.untimed.load(std::memory_order_relaxed);
+				copy.resolved = entry.resolved.load(std::memory_order_relaxed);
+				copy.unavailable = entry.unavailable.load(std::memory_order_relaxed);
+				copy.busy = entry.busy.load(std::memory_order_relaxed);
+				copy.sum = entry.sum.load(std::memory_order_relaxed);
+				copy.span_begin = entry.span_begin.load(std::memory_order_relaxed);
+				copy.span_end = entry.span_end.load(std::memory_order_relaxed);
+				copy.max = entry.max.load(std::memory_order_relaxed);
+				copy.queue_delay_max = entry.queue_delay_max.load(std::memory_order_relaxed);
+				copy.queue_delay_valid = entry.queue_delay_valid.load(std::memory_order_relaxed);
+				std::atomic_thread_fence(std::memory_order_acquire);
+				if (entry.seq.load(std::memory_order_relaxed) != before) continue;
+				if (copy.flip != flip + 1 || copy.session != session) break;
+				frame_view found = make_view(copy, scale);
+				found.flip = flip;
+				return found;
+			}
+		}
+		return view;
+	}
+
+	static frame_view make_view(const frame_shadow& copy, const window& scale) noexcept
+	{
+		frame_view view;
+		view.flip = copy.flip;
+		view.submits = copy.submits;
+		view.timed = copy.timed;
+		view.untimed = copy.untimed;
+		view.resolved = copy.resolved;
+		view.unavailable = copy.unavailable;
+		if (!copy.submits) view.status = frame_status::none;
+		else if (!copy.timed) view.status = frame_status::untimed;
+		else if (copy.timed > copy.resolved + copy.unavailable) view.status = frame_status::pending;
+		else if (copy.resolved == copy.submits) view.status = frame_status::complete;
+		else view.status = frame_status::partial;
+		if (copy.resolved)
+		{
+			view.busy_us = scale.ticks_us(copy.busy);
+			view.sum_us = scale.ticks_us(copy.sum);
+			view.max_us = scale.ticks_us(copy.max);
+			view.span_us = copy.span_end > copy.span_begin ? scale.ticks_us(copy.span_end - copy.span_begin) : 0.0;
+			if (copy.queue_delay_valid) view.queue_delay_max_us = scale.tsc_us(copy.queue_delay_max);
+		}
+		return view;
+	}
+
+private:
+	static std::uint64_t bits(double value) noexcept
+	{
+		std::uint64_t result = 0;
+		std::memcpy(&result, &value, sizeof(result));
+		return result;
+	}
+
+	static double real(std::uint64_t value) noexcept
+	{
+		double result = 0.0;
+		std::memcpy(&result, &value, sizeof(result));
+		return result;
+	}
+
+	void units(window& result) const noexcept
+	{
+		result.period_ns = real(m_period_bits.load(std::memory_order_relaxed));
+		result.tsc_frequency = m_tsc_frequency_published.load(std::memory_order_relaxed);
+		result.calibrated = m_calibrated.load(std::memory_order_acquire) != 0;
+		if (result.calibrated)
+		{
+			result.gpu_per_tsc = real(m_rate_bits.load(std::memory_order_relaxed));
+			result.calibration_uncertainty = real(m_uncertainty_bits.load(std::memory_order_relaxed));
+		}
+	}
+
+	frame_shadow& shadow(std::uint64_t epoch) noexcept
+	{
+		return m_shadow[epoch % frame_capacity];
+	}
+
+	void open_epoch(std::uint64_t epoch) noexcept
+	{
+		frame_shadow& frame = shadow(epoch);
+		frame = {};
+		frame.epoch = epoch;
+		frame.session = m_session;
+		publish(epoch);
+	}
+
+	void publish(std::uint64_t epoch) noexcept
+	{
+		const frame_shadow& frame = shadow(epoch);
+		published_frame& entry = m_frames[epoch % frame_capacity];
+		const std::uint64_t seq = entry.seq.load(std::memory_order_relaxed);
+		entry.seq.store(seq + 1, std::memory_order_relaxed);
+		std::atomic_thread_fence(std::memory_order_release);
+		entry.epoch.store(frame.epoch, std::memory_order_relaxed);
+		entry.flip.store(frame.flip, std::memory_order_relaxed);
+		entry.session.store(frame.session, std::memory_order_relaxed);
+		entry.submits.store(frame.submits, std::memory_order_relaxed);
+		entry.timed.store(frame.timed, std::memory_order_relaxed);
+		entry.untimed.store(frame.untimed, std::memory_order_relaxed);
+		entry.resolved.store(frame.resolved, std::memory_order_relaxed);
+		entry.unavailable.store(frame.unavailable, std::memory_order_relaxed);
+		entry.busy.store(frame.busy, std::memory_order_relaxed);
+		entry.sum.store(frame.sum, std::memory_order_relaxed);
+		entry.span_begin.store(frame.span_begin, std::memory_order_relaxed);
+		entry.span_end.store(frame.span_end, std::memory_order_relaxed);
+		entry.max.store(frame.max, std::memory_order_relaxed);
+		entry.queue_delay_max.store(frame.queue_delay_max, std::memory_order_relaxed);
+		entry.queue_delay_valid.store(frame.queue_delay_valid, std::memory_order_relaxed);
+		entry.seq.store(seq + 2, std::memory_order_release);
+	}
+
+	static void raise(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+	{
+		std::uint64_t current = value.load(std::memory_order_relaxed);
+		while (candidate > current && !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {}
+	}
+
+	void abandon(slot& entry) noexcept
+	{
+		if (!entry.pending) return;
+		entry.pending = false;
+		m_pending.fetch_sub(1, std::memory_order_relaxed);
+		m_counters.unavailable.fetch_add(1, std::memory_order_relaxed);
+		if (entry.session != m_session) return;
+		if (m_epoch - entry.epoch >= frame_capacity) return;
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch) return;
+		frame.unavailable++;
+		publish(entry.epoch);
+	}
+
+	void process(slot& entry, const sample& result) noexcept
+	{
+		if (!result.available)
+		{
+			abandon(entry);
+			return;
+		}
+
+		entry.pending = false;
+		m_pending.fetch_sub(1, std::memory_order_relaxed);
+
+		// A result of an earlier renderer session is never attributed.
+		if (entry.session != m_session)
+		{
+			m_counters.late_dropped.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+
+		if (result.end < result.begin)
+		{
+			m_counters.invalid.fetch_add(1, std::memory_order_relaxed);
+			abandon_frame(entry);
+			return;
+		}
+
+		const std::uint64_t duration = result.end - result.begin;
+		if (!duration) m_counters.zero_duration.fetch_add(1, std::memory_order_relaxed);
+		bool out_of_order = false;
+		const std::uint64_t added = m_union.add(result.begin, result.end, out_of_order);
+		if (out_of_order) m_counters.order_violations.fetch_add(1, std::memory_order_relaxed);
+		m_counters.resolved.fetch_add(1, std::memory_order_relaxed);
+		m_counters.busy.fetch_add(added, std::memory_order_relaxed);
+		m_counters.sum.fetch_add(duration, std::memory_order_relaxed);
+		raise(m_counters.max, duration);
+
+		// Queue delay: GPU start on the host clock minus the RSX submit time.
+		bool delay_valid = false;
+		std::uint64_t delay = 0;
+		if (m_owner_calibrated && m_owner_gpu_per_tsc > 0.0)
+		{
+			const auto& anchor = m_calibration.latest();
+			const double offset = (static_cast<double>(result.begin) - static_cast<double>(anchor.gpu)) / m_owner_gpu_per_tsc;
+			const double start_tsc = static_cast<double>(anchor.tsc) + offset;
+			const double difference = start_tsc - static_cast<double>(entry.submit_tsc);
+			const double tolerance = static_cast<double>(anchor.half_span) +
+				static_cast<double>(m_tsc_frequency) * queue_delay_tolerance_us / 1'000'000.0;
+			if (difference < -tolerance)
+			{
+				m_counters.domain_violations.fetch_add(1, std::memory_order_relaxed);
+			}
+			else
+			{
+				delay_valid = true;
+				delay = difference > 0.0 ? static_cast<std::uint64_t>(difference) : 0;
+				m_counters.queue_delay_samples.fetch_add(1, std::memory_order_relaxed);
+				m_counters.queue_delay_sum.fetch_add(delay, std::memory_order_relaxed);
+				raise(m_counters.queue_delay_max, delay);
+			}
+		}
+
+		if (m_epoch - entry.epoch >= frame_capacity)
+		{
+			m_counters.frame_evicted.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch)
+		{
+			m_counters.frame_evicted.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+		frame.resolved++;
+		frame.busy += added;
+		frame.sum += duration;
+		frame.max = std::max(frame.max, duration);
+		frame.span_begin = frame.resolved == 1 ? result.begin : std::min(frame.span_begin, result.begin);
+		frame.span_end = std::max(frame.span_end, result.end);
+		if (delay_valid)
+		{
+			frame.queue_delay_max = frame.queue_delay_valid ? std::max(frame.queue_delay_max, delay) : delay;
+			frame.queue_delay_valid = 1;
+		}
+		count_frame(frame);
+		publish(entry.epoch);
+	}
+
+	void abandon_frame(const slot& entry) noexcept
+	{
+		m_counters.unavailable.fetch_add(1, std::memory_order_relaxed);
+		if (m_epoch - entry.epoch >= frame_capacity) return;
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch) return;
+		frame.unavailable++;
+		publish(entry.epoch);
+	}
+
+	// A closed frame whose every submission was measured joins the window's
+	// GPU frame tallies once.
+	void count_frame(frame_shadow& frame) noexcept
+	{
+		if (frame.counted || !frame.flip || !frame.submits || frame.resolved != frame.submits) return;
+		frame.counted = true;
+		m_counters.frames_measured.fetch_add(1, std::memory_order_relaxed);
+		window scale;
+		units(scale);
+		const double busy_us = scale.ticks_us(frame.busy);
+		if (busy_us > 33'333.0) m_counters.frames_over_33.fetch_add(1, std::memory_order_relaxed);
+		if (busy_us > 50'000.0) m_counters.frames_over_50.fetch_add(1, std::memory_order_relaxed);
+	}
