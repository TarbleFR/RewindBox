diff --git a/rpcs3/ios/IOSFlipDoneReplay.h b/rpcs3/ios/IOSFlipDoneReplay.h
new file mode 100644
index 0000000..7852805
--- /dev/null
+++ b/rpcs3/ios/IOSFlipDoneReplay.h
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_FLIP_DONE_REPLAY_935 (iPhone logs of IPA 723, 724 and 726, Black Ops II, 13 Nov 2026): the game stops
+// producing frames for good after a few minutes of play. In the three freeze dumps (PIDs 48320, 50194 and 54406) the
+// PPU thread "Backend" polls the flip status word of the RSX driver information (head 1 flipFlags, 0x40201100 in
+// r9) in a sys_timer_usleep(1000) loop, main_thread waits for it on a semaphore, the RSX stands on a jump to itself
+// at the head of the next frame's command list, and the six SPURS threads poll the job queue with nothing to run.
+//
+// The flip status is one bit (bit 31, "done"): the RSX sets it at each flip, the game clears it
+// (cellGcmResetFlipStatus, sys_rsx attribute 0x10a) and then waits for it. Black Ops II makes the flip command
+// visible to the RSX first and clears the bit after. On a PS3 that is safe: the flip completes at a vertical blank,
+// milliseconds after the rest of the frame was drawn. Here the RSX often waits for that very command and completes
+// the flip some tens of microseconds after it appears, with no vertical blank to wait for below the frame limit.
+// When the game's thread is held between its two steps (every PPU thread parks for each data-changing SPU PUTLLC,
+// hundreds of thousands of times a second in this title, and the system preempts it when hot), the flip finds the
+// bit still set by the previous flip, sets nothing new, the game's clear then erases it, and the game waits for a
+// flip that already happened.
+//
+// For the titles of the list (ios/IOSTitleLevers.h), a flip that finds the bit already set, as the second flip
+// since the bit was last seen clear, is remembered for a bounded time. If the guest clears the bit within that time,
+// the bit is set again: the flip the game is about to wait for did complete. Nothing else changes: a flip that finds
+// the bit clear (every flip of a title that clears before it submits) leaves no trace, and neither does a title that
+// never clears it (a third flip without a clear forgets the second).
+namespace rpcs3::ios::flip_done_replay
+{
+// A reset that comes later than this after the flip it missed is not replayed.
+constexpr std::uint64_t window_us = 250'000;
+
+// Set at boot from the title policy.
+inline std::atomic<bool> enabled{false};
+
+struct state_t
+{
+	std::atomic<std::uint32_t> flips_since_clear{0}; // flips since one found the bit clear (that one included)
+	std::atomic<std::uint64_t> absorbed_at_us{0};    // nonzero: the time of the flip a reset may still erase
+	std::atomic<std::uint64_t> absorbed{0};          // flips that found the bit already set (second since a clear)
+	std::atomic<std::uint64_t> replays{0};           // times the bit was set again after the guest's clear
+};
+
+inline state_t& state() noexcept
+{
+	static state_t s_state;
+	return s_state;
+}
+
+// RSX thread, at a flip. `was_done`: the bit was already set before this flip set it. `now_us` is never 0.
+inline void on_flip(state_t& s, bool was_done, std::uint64_t now_us) noexcept
+{
+	if (!was_done)
+	{
+		s.flips_since_clear.store(1, std::memory_order_relaxed);
+		s.absorbed_at_us.store(0, std::memory_order_release);
+		return;
+	}
+
+	const std::uint32_t count = s.flips_since_clear.fetch_add(1, std::memory_order_relaxed) + 1;
+
+	if (count == 2)
+	{
+		s.absorbed.fetch_add(1, std::memory_order_relaxed);
+		s.absorbed_at_us.store(now_us ? now_us : 1, std::memory_order_release);
+	}
+	else
+	{
+		// A title that does not clear the bit for each flip: nothing to give back.
+		s.absorbed_at_us.store(0, std::memory_order_release);
+	}
+}
+
+// Whether a flip may still have to be given back (cheap test for the callers below).
+inline bool pending(const state_t& s) noexcept
+{
+	return s.absorbed_at_us.load(std::memory_order_acquire) != 0;
+}
+
+// Any thread, once the bit is seen clear while a flip is pending. True: set the bit again (once per pending flip).
+inline bool on_clear_seen(state_t& s, std::uint64_t now_us) noexcept
+{
+	const std::uint64_t at = s.absorbed_at_us.exchange(0, std::memory_order_acq_rel);
+
+	if (!at)
+	{
+		return false;
+	}
+
+	if (now_us - at > window_us && now_us >= at)
+	{
+		return false;
+	}
+
+	// The bit set again stands for the one flip since this clear.
+	s.flips_since_clear.store(1, std::memory_order_relaxed);
+	s.replays.fetch_add(1, std::memory_order_relaxed);
+	return true;
+}
+
+// RSX thread, when a pending flip was not claimed: drop it once its time has passed.
+inline void expire(state_t& s, std::uint64_t now_us) noexcept
+{
+	std::uint64_t at = s.absorbed_at_us.load(std::memory_order_acquire);
+
+	if (at && now_us >= at && now_us - at > window_us)
+	{
+		s.absorbed_at_us.compare_exchange_strong(at, 0, std::memory_order_acq_rel);
+	}
+}
+}
diff --git a/rpcs3/ios/IOSSpuIdleBackoff935.h b/rpcs3/ios/IOSSpuIdleBackoff935.h
new file mode 100644
index 0000000..6e130b7
--- /dev/null
+++ b/rpcs3/ios/IOSSpuIdleBackoff935.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_SPU_IDLE_BACKOFF_935 (iPhone logs of IPA 726, 13 Nov 2026, COREPROF ENERGY931): a game that shows a
+// menu at 60 FPS on about one core still takes 44,000 to 80,000 timer wakeups a second (Black Ops II menus: 0.5 W
+// of CPU at 48,000 wakeups; God of War III menus: 0.84 to 1.1 W at 77,000 to 80,000 wakeups on 0.4 to 0.5 core).
+// They come from idle SPU threads: a thread that waits for an event, or polls a job queue, sleeps for a bounded
+// time (100 us for an event, 160 us for a polled queue), looks, and sleeps again, 6,000 to 10,000 times a second
+// each. The bound is a safety net: writes that go through a reservation wake the sleeper at once; only a plain
+// store, or a notification the writer postponed, is found by the look that follows the bound.
+//
+// A thread whose waits keep reaching their bound with nothing to find lengthens the bound, by doubling, up to a
+// few times the reference. What it gives up is checked on the thread itself: when what the thread waits for is
+// found right after a lengthened wait reached its bound, a notification did not carry it, so this thread's waits
+// depend on the look. It then keeps the reference bound for a number of waits that doubles each time this happens
+// (256, 512, ... about a million). A wait that is woken early costs nothing and restarts the count. So a wait
+// that depends on polling converges to the timing of before, and one late event (by less than the longest bound,
+// 0.7 ms) is the price of each attempt.
+//
+// Per host thread (thread_local in SPUThread.cpp: the layout of spu_thread is a code generation input).
+namespace rpcs3::ios::spu_idle_backoff
+{
+inline constexpr std::uint32_t empty_per_step = 8;        // waits that found nothing before the bound doubles
+inline constexpr std::uint32_t event_max_shift = 3;       // event waits: 100 us, 200, 400, 800
+inline constexpr std::uint32_t poll_max_shift = 2;        // polled queues: 160 us, 320, 640
+inline constexpr std::uint32_t first_hold = 256;          // waits kept at the reference after a late find
+inline constexpr std::uint32_t max_hold = 1u << 20;
+inline constexpr std::uint64_t late_find_window_ns = 250'000;
+
+// For the existing report line (COREPROF THERMAL931): waits that reached a lengthened bound, and finds that came
+// right after one (each starts a hold at the reference bound). Process totals, read and reset by the report.
+inline std::atomic<std::uint64_t> lengthened_waits{0};
+inline std::atomic<std::uint64_t> late_finds{0};
+
+class tracker
+{
+	std::uint32_t m_empty = 0;          // consecutive waits that reached their bound and found nothing
+	std::uint32_t m_hold = 0;           // waits left at the reference bound
+	std::uint32_t m_next_hold = first_hold;
+	std::uint64_t m_lengthened_end = 0; // ticks at the end of a lengthened wait that reached its bound, 0 if none
+	bool m_reached_bound = false;       // the last wait reached its bound
+
+public:
+	// The bound of the wait about to start. `allowed`: the lever is on and this wait may be lengthened.
+	std::uint64_t bound_ns(std::uint64_t reference_ns, std::uint32_t max_shift, bool allowed) noexcept
+	{
+		if (m_reached_bound)
+		{
+			// Waiting again: the look after the last bound found nothing.
+			m_reached_bound = false;
+
+			if (m_empty < empty_per_step * 8)
+			{
+				m_empty++;
+			}
+		}
+
+		m_lengthened_end = 0;
+
+		if (m_hold)
+		{
+			m_hold--;
+			return reference_ns;
+		}
+
+		if (!allowed)
+		{
+			m_empty = 0;
+			return reference_ns;
+		}
+
+		const std::uint32_t step = m_empty / empty_per_step;
+		return reference_ns << (step < max_shift ? step : max_shift);
+	}
+
+	// After the wait. `now_ticks` is never needed as a time of day, only for the window of found().
+	void waited(std::uint64_t now_ticks, bool reached_bound, bool lengthened) noexcept
+	{
+		m_reached_bound = reached_bound;
+
+		if (!reached_bound)
+		{
+			// Woken: something was written or signalled.
+			m_empty = 0;
+			m_lengthened_end = 0;
+			return;
+		}
+
+		m_lengthened_end = lengthened ? (now_ticks ? now_ticks : 1) : 0;
+
+		if (lengthened)
+		{
+			lengthened_waits.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	// Cheap test for callers on a hot path: found() has something to do.
+	bool idle() const noexcept
+	{
+		return m_empty != 0 || m_reached_bound || m_lengthened_end != 0;
+	}
+
+	// The thread found what it waited for (an event to return, a job to take).
+	void found(std::uint64_t now_ticks, std::uint64_t window_ticks) noexcept
+	{
+		if (m_lengthened_end && now_ticks - m_lengthened_end <= window_ticks)
+		{
+			// The bound ended the wait, not a notification: keep the reference bound, longer each time.
+			late_finds.fetch_add(1, std::memory_order_relaxed);
+			m_hold = m_next_hold;
+			m_next_hold = m_next_hold < max_hold ? m_next_hold * 2 : max_hold;
+		}
+
+		m_lengthened_end = 0;
+		m_reached_bound = false;
+		m_empty = 0;
+	}
+
+	std::uint32_t hold() const noexcept { return m_hold; }
+	std::uint32_t next_hold() const noexcept { return m_next_hold; }
+	std::uint32_t empty() const noexcept { return m_empty; }
+};
+}
