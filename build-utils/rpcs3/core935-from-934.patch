+// REWINDBOX_SPU_IDLE_BACKOFF_935 (ios/IOSSpuIdleBackoff935.h): the lengthened idle waits of SPU threads follow the
+// same setting, but not the thermal state: they are on unless "Event Waits When Hot" is Disabled, and inside a
+// comparison step they are what the step says, so a comparison between report windows measures both together.
+constexpr bool decide_idle_backoff(std::uint8_t mode, int forced) noexcept
+{
+	return forced >= 0 ? forced != 0 : mode != 2;
+}
+
+inline bool idle_backoff() noexcept
+{
+	return decide_idle_backoff(setting.load(std::memory_order_relaxed),
+		writer_park::compare::event_waits_forced.load(std::memory_order_relaxed));
+}
+
