diff --git a/rpcs3/ios/IOSCryptoA64.h b/rpcs3/ios/IOSCryptoA64.h
new file mode 100644
index 0000000..9ade9bc
--- /dev/null
+++ b/rpcs3/ios/IOSCryptoA64.h
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// REWINDBOX_CRYPTO_A64_634: rpcs3/Crypto is PolarSSL and mbed TLS C code, table lookups on the
+// iPhone (the AES-NI path is x86 only). Each boot of the Build 629 logs decrypts the SELF and its
+// SPRX modules with AES-128 and hashes every code fragment with SHA-1 twice (once to look the
+// object up, once to link it); a boot of Black Ops II multiplayer spends 1.05 s before the renderer
+// exists and 0.6 s before the first link. The Apple CPU has AES, SHA-1 and SHA-256 instructions:
+// the same bytes in, the same bytes out, about ten times faster. Round keys keep their PolarSSL
+// layout: the decryption schedule is already the equivalent inverse cipher's, the one AESD needs.
+#if (defined(RPCS3_IOS) && defined(__aarch64__)) || defined(RPCS3_TEST_CRYPTO_A64)
+#define REWINDBOX_CRYPTO_A64 1
+
+#include <arm_neon.h>
+#if defined(__APPLE__)
+#include <sys/sysctl.h>
+#include <sys/types.h>
+#endif
+
+#ifdef RPCS3_TEST_CRYPTO_A64
+#define REWINDBOX_TARGET_AES
+#define REWINDBOX_TARGET_SHA2
+#else
+#define REWINDBOX_TARGET_AES __attribute__((target("aes")))
+#define REWINDBOX_TARGET_SHA2 __attribute__((target("sha2")))
+#endif
+
+namespace rpcs3::ios::crypto_a64
+{
+// The title policy sets it (experimental.hardware_crypto), before the boot decrypts anything.
+inline std::atomic<bool> enabled{true};
+
+inline bool cpu_has(const char* feature) noexcept
+{
+#if defined(__APPLE__)
+	int value = 0;
+	std::size_t size = sizeof(value);
+	return sysctlbyname(feature, &value, &size, nullptr, 0) == 0 && value == 1;
+#else
+	static_cast<void>(feature);
+	return true;
+#endif
+}
+
+inline bool aes() noexcept
+{
+	static const bool supported = cpu_has("hw.optional.arm.FEAT_AES");
+	return supported && enabled.load(std::memory_order_relaxed);
+}
+
+inline bool sha1() noexcept
+{
+	static const bool supported = cpu_has("hw.optional.arm.FEAT_SHA1");
+	return supported && enabled.load(std::memory_order_relaxed);
+}
+
+inline bool sha256() noexcept
+{
+	static const bool supported = cpu_has("hw.optional.arm.FEAT_SHA256");
+	return supported && enabled.load(std::memory_order_relaxed);
+}
+
+REWINDBOX_TARGET_AES inline uint8x16_t encrypt_block(uint8x16_t block, const std::uint8_t* keys, int rounds) noexcept
+{
+	for (int round = 0; round < rounds - 1; round++)
+	{
+		block = vaesmcq_u8(vaeseq_u8(block, vld1q_u8(keys + round * 16)));
+	}
+
+	block = vaeseq_u8(block, vld1q_u8(keys + (rounds - 1) * 16));
+	return veorq_u8(block, vld1q_u8(keys + rounds * 16));
+}
+
+REWINDBOX_TARGET_AES inline uint8x16_t decrypt_block(uint8x16_t block, const std::uint8_t* keys, int rounds) noexcept
+{
+	for (int round = 0; round < rounds - 1; round++)
+	{
+		block = vaesimcq_u8(vaesdq_u8(block, vld1q_u8(keys + round * 16)));
+	}
+
+	block = vaesdq_u8(block, vld1q_u8(keys + (rounds - 1) * 16));
+	return veorq_u8(block, vld1q_u8(keys + rounds * 16));
+}
+
+// One block: aes_crypt_ecb.
+REWINDBOX_TARGET_AES inline void ecb(const std::uint32_t* round_keys, int rounds, bool decrypt, const unsigned char* input, unsigned char* output) noexcept
+{
+	const auto* keys = reinterpret_cast<const std::uint8_t*>(round_keys);
+	const uint8x16_t block = vld1q_u8(input);
+	vst1q_u8(output, decrypt ? decrypt_block(block, keys, rounds) : encrypt_block(block, keys, rounds));
+}
+
+// Whole blocks of aes_crypt_ctr: a big-endian 128-bit counter, as the byte loop increments it.
+REWINDBOX_TARGET_AES inline void ctr_blocks(const std::uint32_t* round_keys, int rounds, std::size_t blocks, unsigned char* nonce_counter,
+	const unsigned char* input, unsigned char* output) noexcept
+{
+	const auto* keys = reinterpret_cast<const std::uint8_t*>(round_keys);
+
+	for (std::size_t block = 0; block < blocks; block++)
+	{
+		const uint8x16_t stream = encrypt_block(vld1q_u8(nonce_counter), keys, rounds);
+		vst1q_u8(output + block * 16, veorq_u8(vld1q_u8(input + block * 16), stream));
+
+		for (int byte = 16; byte > 0; byte--)
+		{
+			if (++nonce_counter[byte - 1] != 0)
+			{
+				break;
+			}
+		}
+	}
+}
+
+REWINDBOX_TARGET_SHA2 inline uint32x4_t load_big_endian(const unsigned char* data) noexcept
+{
+	return vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(data)));
+}
+
+REWINDBOX_TARGET_SHA2 inline void sha1_blocks(std::uint32_t* state, const unsigned char* data, std::size_t blocks) noexcept
+{
+	const uint32x4_t round_constants[4] = {vdupq_n_u32(0x5A827999), vdupq_n_u32(0x6ED9EBA1), vdupq_n_u32(0x8F1BBCDC), vdupq_n_u32(0xCA62C1D6)};
+	uint32x4_t abcd = vld1q_u32(state);
+	std::uint32_t e = state[4];
+
+	for (; blocks; blocks--, data += 64)
+	{
+		const uint32x4_t abcd_before = abcd;
+		const std::uint32_t e_before = e;
+		uint32x4_t schedule[4] = {load_big_endian(data), load_big_endian(data + 16), load_big_endian(data + 32), load_big_endian(data + 48)};
+
+		// Twenty groups of four rounds, each with the next four words of the message schedule.
+		for (int group = 0; group < 20; group++)
+		{
+			const uint32x4_t word = vaddq_u32(schedule[group & 3], round_constants[group / 5]);
+			const std::uint32_t next_e = vsha1h_u32(vgetq_lane_u32(abcd, 0));
+
+			switch (group / 5)
+			{
+			case 0: abcd = vsha1cq_u32(abcd, e, word); break;
+			case 2: abcd = vsha1mq_u32(abcd, e, word); break;
+			default: abcd = vsha1pq_u32(abcd, e, word); break;
+			}
+
+			e = next_e;
+			schedule[group & 3] = vsha1su1q_u32(vsha1su0q_u32(schedule[group & 3], schedule[(group + 1) & 3], schedule[(group + 2) & 3]), schedule[(group + 3) & 3]);
+		}
+
+		abcd = vaddq_u32(abcd, abcd_before);
+		e += e_before;
+	}
+
+	vst1q_u32(state, abcd);
+	state[4] = e;
+}
+
+REWINDBOX_TARGET_SHA2 inline void sha256_blocks(std::uint32_t* state, const unsigned char* data, std::size_t blocks, const std::uint32_t* round_constants) noexcept
+{
+	uint32x4_t abcd = vld1q_u32(state);
+	uint32x4_t efgh = vld1q_u32(state + 4);
+
+	for (; blocks; blocks--, data += 64)
+	{
+		const uint32x4_t abcd_before = abcd;
+		const uint32x4_t efgh_before = efgh;
+		uint32x4_t schedule[4] = {load_big_endian(data), load_big_endian(data + 16), load_big_endian(data + 32), load_big_endian(data + 48)};
+
+		// Sixteen groups of four rounds.
+		for (int group = 0; group < 16; group++)
+		{
+			const uint32x4_t word = vaddq_u32(schedule[group & 3], vld1q_u32(round_constants + group * 4));
+			const uint32x4_t abcd_previous = abcd;
+			abcd = vsha256hq_u32(abcd, efgh, word);
+			efgh = vsha256h2q_u32(efgh, abcd_previous, word);
+			schedule[group & 3] = vsha256su1q_u32(vsha256su0q_u32(schedule[group & 3], schedule[(group + 1) & 3]), schedule[(group + 2) & 3], schedule[(group + 3) & 3]);
+		}
+
+		abcd = vaddq_u32(abcd, abcd_before);
+		efgh = vaddq_u32(efgh, efgh_before);
+	}
+
+	vst1q_u32(state, abcd);
+	vst1q_u32(state + 4, efgh);
+}
+}
+#endif
diff --git a/rpcs3/ios/IOSJitLoad.h b/rpcs3/ios/IOSJitLoad.h
new file mode 100644
index 0000000..5d2c333
--- /dev/null
+++ b/rpcs3/ios/IOSJitLoad.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_FAST_JIT_LOAD_634: Build 629 logs, every module already in the cache (no compilation).
+// Black Ops II multiplayer waits 3.19 s for 86 objects, Assassin's Creed 4.44 s for 175, the
+// largest part of a boot, on one thread of a 6-core phone:
+// - ppu_cache_read: 390 MB inflated for 212 MB of objects. The check pass inflates each object to
+//   validate it, keeps 32 MiB of them, and the link inflates the others a second time;
+// - ppu_object_load 1.13 s, ppu_finalize 1.42 s (323 ms at most): MCJIT engines, one per 25
+//   objects, used in turn although nothing is shared between them but the arena allocator;
+// - each object is copied whole (getObjectForDebug) for a JIT event listener whose only reader
+//   writes a dump into a folder that does not exist on the iPhone.
+// The check pass and the link run on up to link_workers threads, one engine per thread at a time,
+// and the bytes the check pass inflated reach the link when the memory headroom allows it. Same
+// objects, same relocations, same code: only the order the engines are filled in changes, and
+// each engine still links its own objects in the same order.
+//
+// REWINDBOX_JIT_OBJECT_RELEASE_634: MCJIT keeps every object file for its whole life, although
+// the sections are copied to the arena when the object is added and relocations read them there.
+// 212 MB for Assassin's Creed (128 MB for Black Ops II multiplayer) plus every SPU object (87 MB
+// over the three sessions of the logs), never read again: they turn cold and join the 1 GB the
+// system compresses, which still counts in the footprint. The compiler keeps these bytes itself
+// and frees them after finalizeObject. The file object left in MCJIT holds a dangling pointer that
+// MCJIT only uses as a key when it unregisters the object (MCJIT::notifyFreeingObject).
+namespace rpcs3::ios::jit_load
+{
+inline std::atomic<bool> fast_load{false};      // experimental.fast_jit_load
+inline std::atomic<bool> release_bytes{false};  // experimental.jit_object_release
+
+inline constexpr std::uint32_t link_workers = 4; // the 2 performance and 2 efficiency cores of the phone: the game is not running yet
+inline constexpr std::size_t minimum_window_bytes = 32ull << 20;
+inline constexpr std::size_t maximum_window_bytes = 256ull << 20;
+
+// Inflated object bytes kept between the check pass and the link.
+inline std::atomic<std::size_t> window_limit{minimum_window_bytes};
+
+constexpr std::size_t window_bytes(std::uint64_t headroom_bytes) noexcept
+{
+	return static_cast<std::size_t>(std::clamp<std::uint64_t>(headroom_bytes / 8, minimum_window_bytes, maximum_window_bytes));
+}
+}
diff --git a/rpcs3/ios/IOSSpirvCache.h b/rpcs3/ios/IOSSpirvCache.h
new file mode 100644
index 0000000..b1e4b09
--- /dev/null
+++ b/rpcs3/ios/IOSSpirvCache.h
@@ -0,0 +1,363 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Crypto/sha256.h"
+
+#include <zlib.h>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <shared_mutex>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// REWINDBOX_SPIRV_DISK_CACHE_634: every boot of the Build 629 logs regenerates the GLSL of the
+// whole shader cache and compiles it with glslang. Black Ops II multiplayer: 1,072 sources, 5.49 s
+// of CPU (5.1 ms each, 53.8 ms at most), 1.47 s of a 1.60 s warmup, on all 6 cores, before the PPU
+// objects start loading; Assassin's Creed: 412 sources, 1.88 s of CPU. Only one of them is new per
+// 5 s window during the game. The Metal library behind each module is cached, the SPIR-V is not.
+//
+// One file per title holds the SPIR-V of each source, under SHA-256(source, stage, compiler
+// environment): the same text through the same glslang options gives the same words, so what
+// the game gets cannot differ from a compilation. The GLSL is still generated (the key), and the
+// module, the MoltenVK pipeline cache and the program caches see the same words as before.
+// Mapped read-only: clean file pages, not in the footprint, the system drops them under pressure.
+// Nothing here is needed: a missing, truncated or damaged file means compiling, as before. Entries
+// are appended; the valid prefix survives a torn tail, and a damaged entry fails its CRC at use.
+// Old Cores ignore the file. A change of glslang or of its options must change environment_revision.
+namespace rpcs3::ios::spirv_cache
+{
+using key = std::array<std::uint8_t, 32>;
+
+inline constexpr char file_magic[8] = {'R', 'B', 'S', 'P', 'I', 'R', 'V', '1'};
+// SPIRVCommon.cpp: glslang as pinned by the Core, Vulkan 1.2 rules, SPIR-V 1.5, optimizer off, optimizeSize.
+inline constexpr std::uint32_t environment_revision = 0x0105'0634;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 20;
+inline constexpr std::uint32_t max_entry_words = (16u << 20) / 4;
+
+struct file_header
+{
+	char magic[8];
+	std::uint32_t revision;
+	std::uint32_t reserved;
+};
+
+struct entry_header
+{
+	std::uint8_t name[32];
+	std::uint32_t words;
+	std::uint32_t crc;
+};
+
+static_assert(sizeof(file_header) == 16 && sizeof(entry_header) == 40);
+
+inline bool make_key(std::string_view source, std::uint32_t stage, key& out) noexcept
+{
+	const std::uint32_t prefix[2] = {stage, environment_revision};
+	mbedtls_sha256_context context;
+	mbedtls_sha256_init(&context);
+	int result = mbedtls_sha256_starts_ret(&context, 0);
+	if (!result) result = mbedtls_sha256_update_ret(&context, reinterpret_cast<const unsigned char*>(prefix), sizeof(prefix));
+	if (!result) result = mbedtls_sha256_update_ret(&context, reinterpret_cast<const unsigned char*>(source.data()), source.size());
+	if (!result) result = mbedtls_sha256_finish_ret(&context, out.data());
+	mbedtls_sha256_free(&context);
+	return result == 0;
+}
+
+class store
+{
+	struct key_hash
+	{
+		std::size_t operator()(const key& name) const noexcept
+		{
+			std::size_t value;
+			std::memcpy(&value, name.data(), sizeof(value));
+			return value;
+		}
+	};
+
+	struct located
+	{
+		std::uint64_t offset;
+		std::uint32_t words;
+		std::uint32_t crc;
+	};
+
+	mutable std::shared_mutex m_mutex;
+	std::mutex m_write_mutex;
+	std::string m_path;
+	const std::uint8_t* m_map = nullptr;
+	std::size_t m_map_bytes = 0;
+	std::uint64_t m_valid_bytes = 0; // the end of the last good entry: a torn tail starts here
+	std::uint64_t m_pending_bytes = 0;
+	std::unordered_map<key, located, key_hash> m_index;
+	std::unordered_map<key, std::vector<std::uint32_t>, key_hash> m_pending;
+	std::unordered_set<key, key_hash> m_written; // this session's entries: not mapped, not added twice
+
+	void unmap() noexcept
+	{
+		if (m_map)
+		{
+			::munmap(const_cast<std::uint8_t*>(m_map), m_map_bytes);
+		}
+
+		m_map = nullptr;
+		m_map_bytes = 0;
+		m_index.clear();
+	}
+
+	void map_file() noexcept
+	{
+		const int file = ::open(m_path.c_str(), O_RDONLY | O_CLOEXEC);
+
+		if (file < 0)
+		{
+			return;
+		}
+
+		struct stat info{};
+
+		if (::fstat(file, &info) == 0 && S_ISREG(info.st_mode) && static_cast<std::uint64_t>(info.st_size) >= sizeof(file_header))
+		{
+			void* const mapped = ::mmap(nullptr, static_cast<std::size_t>(info.st_size), PROT_READ, MAP_PRIVATE, file, 0);
+
+			if (mapped != MAP_FAILED)
+			{
+				m_map = static_cast<const std::uint8_t*>(mapped);
+				m_map_bytes = static_cast<std::size_t>(info.st_size);
+				::madvise(mapped, m_map_bytes, MADV_SEQUENTIAL);
+				index_entries();
+				::madvise(mapped, m_map_bytes, MADV_RANDOM);
+			}
+		}
+
+		::close(file);
+	}
+
+	void index_entries() noexcept
+	{
+		file_header header;
+		std::memcpy(&header, m_map, sizeof(header));
+
+		if (std::memcmp(header.magic, file_magic, sizeof(file_magic)) != 0 || header.revision != environment_revision)
+		{
+			return; // Rewritten from the start at the next flush.
+		}
+
+		std::uint64_t position = sizeof(file_header);
+
+		while (m_map_bytes - position >= sizeof(entry_header))
+		{
+			entry_header entry;
+			std::memcpy(&entry, m_map + position, sizeof(entry));
+			const std::uint64_t bytes = std::uint64_t{entry.words} * sizeof(std::uint32_t);
+
+			if (!entry.words || entry.words > max_entry_words || m_map_bytes - position - sizeof(entry) < bytes)
+			{
+				break;
+			}
+
+			key name;
+			std::memcpy(name.data(), entry.name, name.size());
+			m_index[name] = {position + sizeof(entry), entry.words, entry.crc}; // the last copy wins
+			position += sizeof(entry) + bytes;
+		}
+
+		m_valid_bytes = position;
+	}
+
+	static bool write_all(int file, const void* data, std::size_t size) noexcept
+	{
+		const auto* bytes = static_cast<const std::uint8_t*>(data);
+
+		while (size)
+		{
+			const auto written = ::write(file, bytes, size);
+
+			if (written <= 0)
+			{
+				return false;
+			}
+
+			bytes += written;
+			size -= static_cast<std::size_t>(written);
+		}
+
+		return true;
+	}
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+
+	~store()
+	{
+		close();
+	}
+
+	void open(std::string path) noexcept
+	{
+		close();
+		std::unique_lock lock(m_mutex);
+		m_path = std::move(path);
+		map_file();
+	}
+
+	bool active() const noexcept
+	{
+		std::shared_lock lock(m_mutex);
+		return !m_path.empty();
+	}
+
+	bool find(const key& name, std::vector<std::uint32_t>& words) const
+	{
+		std::shared_lock lock(m_mutex);
+
+		if (const auto pending = m_pending.find(name); pending != m_pending.end())
+		{
+			words = pending->second;
+			return true;
+		}
+
+		const auto found = m_index.find(name);
+
+		if (found == m_index.end())
+		{
+			return false;
+		}
+
+		const std::uint8_t* const payload = m_map + found->second.offset;
+		const std::size_t bytes = std::size_t{found->second.words} * sizeof(std::uint32_t);
+
+		if (::crc32(0, payload, static_cast<uInt>(bytes)) != found->second.crc)
+		{
+			return false;
+		}
+
+		words.resize(found->second.words);
+		std::memcpy(words.data(), payload, bytes);
+		return true;
+	}
+
+	void add(const key& name, const std::vector<std::uint32_t>& words)
+	{
+		const std::uint64_t bytes = sizeof(entry_header) + std::uint64_t{words.size()} * sizeof(std::uint32_t);
+		std::unique_lock lock(m_mutex);
+
+		if (m_path.empty() || words.empty() || words.size() > max_entry_words || m_valid_bytes + m_pending_bytes + bytes > max_file_bytes ||
+			m_written.contains(name))
+		{
+			return;
+		}
+
+		// A CRC failure in find() brings a damaged entry here: the new copy is the last one.
+		if (m_pending.try_emplace(name, words).second)
+		{
+			m_pending_bytes += bytes;
+		}
+	}
+
+	// Appends what add() kept. A failed write leaves the valid prefix as it was.
+	void flush() noexcept
+	{
+		std::lock_guard writer(m_write_mutex);
+		std::unordered_map<key, std::vector<std::uint32_t>, key_hash> batch;
+		std::uint64_t valid_bytes;
+		std::string path;
+
+		{
+			std::unique_lock lock(m_mutex);
+			batch.swap(m_pending);
+			m_pending_bytes = 0;
+			valid_bytes = m_valid_bytes;
+			path = m_path;
+		}
+
+		if (batch.empty() || path.empty())
+		{
+			return;
+		}
+
+		const int file = ::open(path.c_str(), O_WRONLY | O_CREAT | O_CLOEXEC, 0644);
+
+		if (file < 0)
+		{
+			return;
+		}
+
+		bool good = ::ftruncate(file, static_cast<off_t>(valid_bytes)) == 0 && ::lseek(file, static_cast<off_t>(valid_bytes), SEEK_SET) >= 0;
+
+		if (good && !valid_bytes)
+		{
+			file_header header{};
+			std::memcpy(header.magic, file_magic, sizeof(file_magic));
+			header.revision = environment_revision;
+			good = write_all(file, &header, sizeof(header));
+			valid_bytes = sizeof(header);
+		}
+
+		std::vector<key> written;
+
+		for (const auto& [name, words] : batch)
+		{
+			if (!good)
+			{
+				break;
+			}
+
+			const std::size_t bytes = words.size() * sizeof(std::uint32_t);
+			entry_header entry;
+			std::memcpy(entry.name, name.data(), name.size());
+			entry.words = static_cast<std::uint32_t>(words.size());
+			entry.crc = static_cast<std::uint32_t>(::crc32(0, reinterpret_cast<const Bytef*>(words.data()), static_cast<uInt>(bytes)));
+			good = write_all(file, &entry, sizeof(entry)) && write_all(file, words.data(), bytes);
+
+			if (good)
+			{
+				valid_bytes += sizeof(entry) + bytes;
+				written.push_back(name);
+			}
+		}
+
+		if (!good)
+		{
+			(void)!::ftruncate(file, static_cast<off_t>(valid_bytes));
+		}
+
+		::close(file);
+		std::unique_lock lock(m_mutex);
+		m_valid_bytes = valid_bytes;
+		m_written.insert(written.begin(), written.end());
+	}
+
+	void close() noexcept
+	{
+		flush();
+		std::unique_lock lock(m_mutex);
+		unmap();
+		m_path.clear();
+		m_pending.clear();
+		m_written.clear();
+		m_pending_bytes = 0;
+		m_valid_bytes = 0;
+	}
+};
+
+inline store& instance() noexcept
+{
+	static store global;
+	return global;
+}
+}
