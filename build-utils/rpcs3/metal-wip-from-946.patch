+// REWINDBOX_CLUSTER_CENSUS_947: where each thread group runs. IPA 771 logs (17 November 2026): 61,000 cluster changes
+// (ENERGY931 pset_switches) per 5 s window in Black Ops II, the P cores at 1.6 GHz and the E cores at 2.1 GHz, and no
+// way to tell which threads run where. proc_pidinfo(PROC_PIDTHREADCOUNTS) (iOS 16, looked up at run time like
+// proc_pid_rusage) gives each thread's CPU time and energy per performance level (0: performance cores, 1: efficiency
+// cores); the report thread takes the differences per window and sums them by group. Measurement only.
+struct cluster_counts947
+{
+	std::array<u64, 2> time_mach{};
+	std::array<u64, 2> energy_nj{};
+};
+
+struct cluster_census947
+{
+	std::unordered_map<u64, std::pair<u8, cluster_counts947>> last; // thread id -> group, cumulative counts
+	std::array<cluster_counts947, core_group_count> window{};
+	u32 levels = 0, threads = 0, new_threads = 0;
+	bool available = false;
+};
+
+void sample_cluster947(cluster_census947& census)
+{
+	census.window = {};
+	census.levels = 0;
+	census.threads = 0;
+	census.new_threads = 0;
+#ifdef __APPLE__
+	struct counts_data { u64 instructions, cycles, user_time_mach, system_time_mach, energy_nj; };
+	struct thread_counts { u16 len; u16 reserved0; u32 reserved1; counts_data counts[4]; };
+	using pidinfo_fn = int (*)(int, int, u64, void*, int);
+	static const pidinfo_fn read_pidinfo = reinterpret_cast<pidinfo_fn>(dlsym(RTLD_DEFAULT, "proc_pidinfo"));
+	constexpr int proc_pidthreadcounts = 34;
+
+	census.available = read_pidinfo != nullptr;
+	if (!read_pidinfo)
+	{
+		return;
+	}
+
+	thread_act_array_t threads = nullptr;
+	mach_msg_type_number_t thread_count = 0;
+	if (task_threads(mach_task_self(), &threads, &thread_count) != KERN_SUCCESS)
+	{
+		census.available = false;
+		return;
+	}
+
+	std::unordered_map<u64, std::pair<u8, cluster_counts947>> now;
+	now.reserve(thread_count);
+	bool any = false;
+
+	for (mach_msg_type_number_t index = 0; index < thread_count; ++index)
+	{
+		thread_extended_info_data_t info{};
+		mach_msg_type_number_t count = THREAD_EXTENDED_INFO_COUNT;
+		thread_identifier_info_data_t ident{};
+		mach_msg_type_number_t ident_count = THREAD_IDENTIFIER_INFO_COUNT;
+
+		if (thread_info(threads[index], THREAD_EXTENDED_INFO, reinterpret_cast<thread_info_t>(&info), &count) == KERN_SUCCESS &&
+			thread_info(threads[index], THREAD_IDENTIFIER_INFO, reinterpret_cast<thread_info_t>(&ident), &ident_count) == KERN_SUCCESS)
+		{
+			thread_counts data{};
+			const int bytes = read_pidinfo(getpid(), proc_pidthreadcounts, ident.thread_id, &data, static_cast<int>(sizeof(data)));
+
+			if (bytes >= static_cast<int>(offsetof(thread_counts, counts) + sizeof(counts_data)) && data.len)
+			{
+				any = true;
+				census.levels = std::min<u32>(data.len, 4);
+				cluster_counts947 counts{};
+
+				for (u32 level = 0; level < std::min<u32>(census.levels, 2); level++)
+				{
+					counts.time_mach[level] = data.counts[level].user_time_mach + data.counts[level].system_time_mach;
+					counts.energy_nj[level] = data.counts[level].energy_nj;
+				}
+
+				const u8 group = static_cast<u8>(classify_thread(info.pth_name));
+				now[ident.thread_id] = {group, counts};
+				census.threads++;
+
+				if (const auto it = census.last.find(ident.thread_id); it != census.last.end())
+				{
+					for (u32 level = 0; level < 2; level++)
+					{
+						const auto& before = it->second.second;
+						census.window[group].time_mach[level] += counts.time_mach[level] >= before.time_mach[level] ? counts.time_mach[level] - before.time_mach[level] : 0;
+						census.window[group].energy_nj[level] += counts.energy_nj[level] >= before.energy_nj[level] ? counts.energy_nj[level] - before.energy_nj[level] : 0;
+					}
+				}
+				else
+				{
+					census.new_threads++; // its time before this window is not counted
+				}
+			}
+		}
+
+		mach_port_deallocate(mach_task_self(), threads[index]);
+	}
+
+	vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(threads), static_cast<vm_size_t>(thread_count) * sizeof(thread_t));
+	census.available = any;
+	census.last = std::move(now);
+#endif
+}
+
+std::string format_cluster947(const cluster_census947& census, u64 session, u64 window, bool comparable)
+{
+	double ms_per_tick = 0.0;
+#ifdef __APPLE__
+	mach_timebase_info_data_t timebase{};
+	if (mach_timebase_info(&timebase) == KERN_SUCCESS && timebase.denom)
+	{
+		ms_per_tick = static_cast<double>(timebase.numer) / timebase.denom / 1e6;
+	}
+#endif
+	char head[192];
+	std::snprintf(head, sizeof(head), "COREPROF CLUSTER947 session=%llu window=%llu available=%u comparable=%u levels=%u threads=%u new_threads=%u",
+		static_cast<unsigned long long>(session), static_cast<unsigned long long>(window), census.available ? 1u : 0u, comparable ? 1u : 0u,
+		census.levels, census.threads, census.new_threads);
+	std::string line = head;
+	static constexpr std::array<const char*, core_group_count> names{"ppu", "spu", "rsx", "jit", "other"};
+
+	for (usz group = 0; group < core_group_count; group++)
+	{
+		const auto& c = census.window[group];
+		char part[160];
+		std::snprintf(part, sizeof(part), " %s_ms=%.1f:%.1f %s_mj=%.1f:%.1f", names[group], static_cast<double>(c.time_mach[0]) * ms_per_tick,
+			static_cast<double>(c.time_mach[1]) * ms_per_tick, names[group], static_cast<double>(c.energy_nj[0]) / 1e6, static_cast<double>(c.energy_nj[1]) / 1e6);
+		line += part;
+	}
+
+	line += " tuple=performance:efficiency scope=process_window";
+	return line;
+}
