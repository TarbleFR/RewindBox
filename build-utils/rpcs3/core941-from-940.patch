diff --git a/rpcs3/ios/IOSLightLoad941.h b/rpcs3/ios/IOSLightLoad941.h
new file mode 100644
index 0000000..fac7cfc
--- /dev/null
+++ b/rpcs3/ios/IOSLightLoad941.h
@@ -0,0 +1,309 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <pthread/qos.h>
+#endif
+
+// REWINDBOX_LIGHT_LOAD_941 (maintainer, 16 Nov 2026: the phone must stay in the nominal thermal state; iPhone logs of
+// IPA 760, Core 940): while a game is light, its PPU, SPU and RSX threads run in the utility class, which iOS keeps
+// on the efficiency cores.
+//
+// What the logs show (COREPROF ENERGY931, 5 s windows, iPhone with 2 performance and 4 efficiency cores):
+// - Black Ops II menus at 60 FPS, session 2 windows 6 to 9: 1.0 to 1.2 cores of work, 73 % of it on the performance
+//   cores, for 0.60, 1.35, 1.68 and 2.12 W, with those cores at 1.75, 2.32, 2.91 and 3.42 GHz. The work is the
+//   same in the four windows; its cost follows the clock iOS gives the performance cores. The performance cluster
+//   is billed 0.75 J per second of CPU time at 1.75 GHz and 2.7 J at 3.4 GHz; the efficiency cluster 0.18 J.
+// - Those menus take 42,000 timer wakeups a second (29,600 SPU polling sleeps, 11,300 RSX park slices): the SPU
+//   threads are user-initiated, the PPU and RSX threads user-interactive, and with the performance cores idle iOS
+//   wakes all of them there.
+// - God of War III title screen at 60 FPS: 0.21 core at 3.93 GHz for 0.53 W (43,000 wakeups a second, 27,400 of
+//   them timed waits under 200 us of the game's own PPU threads).
+// - The match that follows (4.3 to 4.6 cores) reaches the fair state about 15 s after it starts, and iOS then
+//   lowers the performance cores from 2.4-2.7 to 1.6-1.8 GHz: what the menus spend before the match is heat the
+//   match starts with.
+// - Sleeps taken in the utility class by Core 939 (REWINDBOX_SPU_IDLE_EFFICIENCY_939, IPA 756 and 760): 11,893,
+//   of which 134 (1.1 %) ended later than their bound plus a quarter plus 50 us, and no class change failed.
+//
+// "Light" is decided by the profiler sampler (every 500 ms), from what the game does:
+// - to enter: for `enter_samples` samples in a row the process uses at most `enter_cores`, no thread more than
+//   `enter_thread_cores` (a thread near a whole performance core has no room to run slower), and the game
+//   presents frames at a steady rate of at least `min_rate` (a loading screen or a still picture is not light:
+//   its work is not paced by frames, so running it slower would only make it last longer);
+// - to leave, at once: the process uses `leave_cores` or more (work is slower on the efficiency cores, hence the
+//   higher bound), or one thread uses `leave_thread_cores` or more for `thread_busy_samples` samples in a row (a
+//   thread that has become CPU bound, a loading thread for instance, has no room left), or the frame rate is
+//   under `rate_floor` of its reference for `rate_miss_samples` samples in a row. The reference is the rate before
+//   entering and follows the rate upwards (a 30 FPS menu, then a 60 FPS scene). An exit within `blame_ms` of
+//   entering, for the load or for the rate, is blamed on the class: the next entry waits `first_hold_ms`, doubled
+//   each time up to `max_hold_ms`; other exits wait `plain_hold_ms`.
+// The frames are the guest's flips (not the host's presents, which the native dialogs also make).
+// Each thread applies the class to itself where it already tests its state: cpu_thread::check_state() for PPU and
+// SPU threads (on entry and again when it returns, so a thread that was blocked there leaves with the current
+// class), the FIFO idle wait and the end of each frame for the RSX thread. When the game stops being light the
+// sampler also asks every registered PPU and SPU thread to test its state once (request_state_checks: the notify
+// flag, which check_state() only clears), so a thread busy in compiled code does not keep the utility class. Its own class (thread_ctrl::set_native_priority) is taken
+// back the same way, at the latest at its next wait once the game stops being light. The audio threads, the
+// compile threads, MoltenVK and the host application are not touched. Switched off with "Event Waits When Hot" =
+// Disabled, like the other idle levers.
+namespace rpcs3::ios::light_load
+{
+inline constexpr double enter_cores = 1.25;
+inline constexpr double enter_thread_cores = 0.40;
+inline constexpr double leave_cores = 2.5;
+inline constexpr double leave_thread_cores = 0.80;
+inline constexpr std::uint32_t thread_busy_samples = 2;
+inline constexpr double min_rate = 15.0;
+inline constexpr double rate_spread = 0.06;          // steady: (max - min) / max over the entry samples
+inline constexpr double rate_floor = 0.95;
+inline constexpr std::uint32_t enter_samples = 6;     // 3 s
+inline constexpr std::uint32_t rate_miss_samples = 2; // 1 s
+inline constexpr std::uint64_t blame_ms = 5'000;
+inline constexpr std::uint64_t plain_hold_ms = 5'000;
+inline constexpr std::uint64_t first_hold_ms = 20'000;
+inline constexpr std::uint64_t max_hold_ms = 320'000;
+inline constexpr std::uint64_t settled_ms = 60'000;   // a light period this long forgets the doubled holds
+
+// Read by the emulation threads: 1 while the game is light.
+inline std::atomic<std::uint32_t> wanted{0};
+
+// Report counters (COREPROF THERMAL931 tail).
+inline std::atomic<std::uint64_t> entries{0};
+inline std::atomic<std::uint64_t> leaves_load{0};
+inline std::atomic<std::uint64_t> leaves_rate{0};
+inline std::atomic<std::uint64_t> leaves_blamed{0};
+inline std::atomic<std::uint64_t> class_changes{0};
+inline std::atomic<std::uint64_t> class_failures{0};
+inline std::atomic<std::uint64_t> light_ms{0};
+
+enum class verdict : std::uint8_t { heavy, entered, light, left_load, left_rate, left_blamed, left_off };
+
+// The decision, without any system call (host-tested as a plain class).
+class controller
+{
+	bool m_light = false;
+	bool m_have_last = false;
+	std::uint64_t m_last_frames = 0;
+	std::uint64_t m_last_ms = 0;
+	std::uint32_t m_calm = 0;
+	double m_rate_min = 0.0, m_rate_max = 0.0, m_rate_sum = 0.0;
+	double m_reference = 0.0;
+	std::uint32_t m_missed = 0;
+	std::uint32_t m_busy = 0;
+	std::uint64_t m_entered_ms = 0;
+	std::uint64_t m_hold_until_ms = 0;
+	std::uint64_t m_next_hold_ms = first_hold_ms;
+
+	verdict leave(verdict why, std::uint64_t now_ms) noexcept
+	{
+		m_light = false;
+		m_calm = 0;
+		m_missed = 0;
+		m_busy = 0;
+		if (why == verdict::left_blamed)
+		{
+			m_hold_until_ms = now_ms + m_next_hold_ms;
+			m_next_hold_ms = m_next_hold_ms * 2 < max_hold_ms ? m_next_hold_ms * 2 : max_hold_ms;
+		}
+		else
+		{
+			m_hold_until_ms = now_ms + plain_hold_ms;
+			if (now_ms - m_entered_ms >= settled_ms)
+			{
+				m_next_hold_ms = first_hold_ms;
+			}
+		}
+		return why;
+	}
+
+public:
+	bool light() const noexcept { return m_light; }
+	double reference() const noexcept { return m_reference; }
+	std::uint64_t next_hold_ms() const noexcept { return m_next_hold_ms; }
+
+	void reset() noexcept { *this = controller{}; }
+
+	// One sample: the cores the process used, its busiest thread, the frames presented so far, a monotonic clock.
+	verdict observe(double process_cores, double busiest_thread_cores, std::uint64_t frames, std::uint64_t now_ms, bool allowed) noexcept
+	{
+		double rate = -1.0; // unknown
+		if (m_have_last && now_ms > m_last_ms && now_ms - m_last_ms >= 200 && now_ms - m_last_ms <= 2'000 && frames >= m_last_frames)
+		{
+			rate = static_cast<double>(frames - m_last_frames) * 1000.0 / static_cast<double>(now_ms - m_last_ms);
+		}
+		m_have_last = true;
+		m_last_frames = frames;
+		m_last_ms = now_ms;
+
+		if (!allowed)
+		{
+			if (m_light)
+			{
+				return leave(verdict::left_off, now_ms);
+			}
+			m_calm = 0;
+			return verdict::heavy;
+		}
+
+		if (m_light)
+		{
+			m_busy = busiest_thread_cores >= leave_thread_cores ? m_busy + 1 : 0;
+			if (process_cores >= leave_cores || m_busy >= thread_busy_samples)
+			{
+				// Load that appears right after entering may be the class's own doing (the same work, slower).
+				return leave(now_ms - m_entered_ms <= blame_ms ? verdict::left_blamed : verdict::left_load, now_ms);
+			}
+
+			if (rate >= 0.0)
+			{
+				if (rate > m_reference)
+				{
+					m_reference = rate; // the game now presents faster: that is the rate to keep
+				}
+
+				if (rate < m_reference * rate_floor)
+				{
+					if (++m_missed >= rate_miss_samples)
+					{
+						return leave(now_ms - m_entered_ms <= blame_ms ? verdict::left_blamed : verdict::left_rate, now_ms);
+					}
+				}
+				else
+				{
+					m_missed = 0;
+				}
+			}
+			else if (m_missed)
+			{
+				// A sample without a rate between two low ones does not clear them, and does not add one.
+			}
+
+			return verdict::light;
+		}
+
+		const bool calm = now_ms >= m_hold_until_ms && rate >= min_rate && process_cores <= enter_cores && busiest_thread_cores <= enter_thread_cores;
+		if (!calm)
+		{
+			m_calm = 0;
+			return verdict::heavy;
+		}
+
+		if (!m_calm)
+		{
+			m_rate_min = m_rate_max = rate;
+			m_rate_sum = 0.0;
+		}
+		m_rate_min = rate < m_rate_min ? rate : m_rate_min;
+		m_rate_max = rate > m_rate_max ? rate : m_rate_max;
+		m_rate_sum += rate;
+		m_calm++;
+
+		if (m_rate_max - m_rate_min > m_rate_max * rate_spread)
+		{
+			// Not a steady rate: start again from this sample.
+			m_rate_min = m_rate_max = rate;
+			m_rate_sum = rate;
+			m_calm = 1;
+			return verdict::heavy;
+		}
+
+		if (m_calm < enter_samples)
+		{
+			return verdict::heavy;
+		}
+
+		m_light = true;
+		m_reference = m_rate_sum / static_cast<double>(m_calm);
+		m_missed = 0;
+		m_busy = 0;
+		m_entered_ms = now_ms;
+		return verdict::entered;
+	}
+};
+
+// Emu/CPU/CPUThread.cpp: every registered PPU and SPU thread gets the notify flag, which makes it call
+// check_state() (and so sync()) at its next state test; check_state() clears the flag and does nothing else with it.
+void request_state_checks() noexcept;
+
+// The sampler's sample: updates `wanted` and the counters.
+inline void apply(controller& control, double process_cores, double busiest_thread_cores, std::uint64_t frames, std::uint64_t now_ms,
+	std::uint64_t sample_ms, bool allowed) noexcept
+{
+	const bool was = control.light();
+	switch (control.observe(process_cores, busiest_thread_cores, frames, now_ms, allowed))
+	{
+	case verdict::entered: entries.fetch_add(1, std::memory_order_relaxed); break;
+	case verdict::left_load: leaves_load.fetch_add(1, std::memory_order_relaxed); break;
+	case verdict::left_rate: leaves_rate.fetch_add(1, std::memory_order_relaxed); break;
+	case verdict::left_blamed: leaves_blamed.fetch_add(1, std::memory_order_relaxed); break;
+	default: break;
+	}
+	if (was)
+	{
+		light_ms.fetch_add(sample_ms, std::memory_order_relaxed);
+	}
+	wanted.store(control.light() ? 1u : 0u, std::memory_order_relaxed);
+	if (was && !control.light())
+	{
+		request_state_checks();
+	}
+}
+
+// ---- Per thread ----------------------------------------------------------------------------------------------
+// The class the thread asked for (thread_ctrl::set_native_priority) and what it runs with now.
+struct thread_class_state
+{
+	std::uint32_t applied = 0; // the value of `wanted` this thread runs with
+	bool home_known = false;
+	bool home_demotable = false; // user-interactive or user-initiated
+	int home_qos = 0;
+	int home_relative = 0;
+};
+
+inline thread_local thread_class_state t_class{};
+
+// thread_ctrl::set_native_priority() has just applied this class: remember it; the thread is in it again.
+inline void home(int qos, int relative_priority, bool demotable) noexcept
+{
+	t_class.home_known = true;
+	t_class.home_demotable = demotable;
+	t_class.home_qos = qos;
+	t_class.home_relative = relative_priority;
+	t_class.applied = 0;
+}
+
+// True while this thread runs in the utility class because the game is light.
+inline bool in_light_class() noexcept
+{
+	return t_class.applied != 0;
+}
+
+inline void change_class(std::uint32_t want) noexcept
+{
+	t_class.applied = want;
+#if defined(__APPLE__)
+	if (!t_class.home_known || !t_class.home_demotable)
+	{
+		return;
+	}
+
+	const int error = want
+		? pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0)
+		: pthread_set_qos_class_self_np(static_cast<qos_class_t>(t_class.home_qos), t_class.home_relative);
+	(error ? class_failures : class_changes).fetch_add(1, std::memory_order_relaxed);
+#endif
+}
+
+// PPU and SPU threads (cpu_thread::check_state) and the RSX thread (FIFO idle wait): one load when nothing changed.
+inline void sync() noexcept
+{
+	const std::uint32_t want = wanted.load(std::memory_order_relaxed);
+	if (want != t_class.applied) [[unlikely]]
+	{
+		change_class(want);
+	}
+}
+} // namespace rpcs3::ios::light_load
