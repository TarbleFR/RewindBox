+// NEOSTATION_RPCS3_RETROACHIEVEMENTS_V1: optional RetroAchievements hooks.
+// The host resolves them with dlsym; RPCS3_IOS_ABI_VERSION and every earlier
+// export are unchanged, and a host that never calls them changes nothing.
+// None of them writes guest memory, sets last_error or takes the API lock.
+#define RPCS3_IOS_RA_API_VERSION 1u
+
+// Called on the RSX VBlank thread after each emulated VBlank (60 Hz, none
+// while paused or stopped). The callback must return quickly and must not
