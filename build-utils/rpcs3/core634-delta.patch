+		u64 m_pos = 0;
+
+	public:
+		explicit iso_shared_image(std::shared_ptr<fs::file> image)
+			: m_image(std::move(image))
+		{
+		}
+
+		fs::stat_t get_stat() override
+		{
+			return m_image->get_stat();
+		}
+
+		bool trunc(u64) override
+		{
+			fs::g_tls_error = fs::error::readonly;
+			return false;
+		}
+
