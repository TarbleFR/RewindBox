diff --git a/rpcs3/ios/RPCS3IOSAchievements.h b/rpcs3/ios/RPCS3IOSAchievements.h
new file mode 100644
index 0000000..6e4c976
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSAchievements.h
@@ -0,0 +1,215 @@
+#pragma once
+
+// NEOSTATION_RPCS3_RETROACHIEVEMENTS_V1
+// Core side of the optional RetroAchievements hooks exported by RPCS3IOS.cpp
+// (rpcs3_ios_ra_*). The host owns the rcheevos client, the account and every
+// network request; the Core only reports emulated VBlanks, copies guest bytes
+// and describes the booted title. Nothing here writes guest memory, changes
+// emulation timing or the main RPCS3 iOS ABI (RPCS3_IOS_ABI_VERSION).
+//
+// Self-contained on purpose (standard library only) so the contract can be
+// compiled and tested on a host without the rest of the Core.
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace rpcs3::ios::achievements
+{
+	using frame_callback = void (*)(void* context, std::uint64_t frame);
+
+	// One optional observer of the emulated VBlank (RetroAchievements frame
+	// processing). notify() runs on the RSX VBlank thread, which only exists
+	// while a game is running and is joined before the guest memory is
+	// released; it never waits for the host: a frame that coincides with a
+	// (de)registration is skipped.
+	class frame_hook
+	{
+	public:
+		void notify(std::uint64_t frame) noexcept
+		{
+			if (!m_armed.load(std::memory_order_acquire))
+			{
+				return;
+			}
+
+			std::unique_lock lock(m_mutex, std::try_to_lock);
+
+			if (lock.owns_lock() && m_callback)
+			{
+				m_callback(m_context, frame);
+			}
+		}
+
+		// Host thread. Returns only after a callback using the previous
+		// registration has returned, so its context may be released at once.
+		// Must never be called from inside the callback.
+		void set(frame_callback callback, void* context) noexcept
+		{
+			std::lock_guard lock(m_mutex);
+			m_callback = callback;
+			m_context = callback ? context : nullptr;
+			m_armed.store(callback != nullptr, std::memory_order_release);
+		}
+
+		bool armed() const noexcept
+		{
+			return m_armed.load(std::memory_order_acquire);
+		}
+
+	private:
+		std::mutex m_mutex;
+		frame_callback m_callback = nullptr;
+		void* m_context = nullptr;
+		std::atomic<bool> m_armed{false};
+	};
+
+	// Never destroyed: the VBlank thread may still exist during process exit.
+	inline frame_hook& vblank_hook() noexcept
+	{
+		static frame_hook* const hook = new frame_hook();
+		return *hook;
+	}
+
+	inline constexpr std::uint32_t guest_page_size = 4096;
+	inline constexpr std::uint32_t max_read_size = 65536;
+
+	// Arguments accepted by rpcs3_ios_ra_read_memory: a non-empty bounded
+	// range inside the 32-bit guest address space.
+	constexpr bool valid_read(std::uint32_t address, const void* buffer, std::uint32_t size) noexcept
+	{
+		return buffer != nullptr && size != 0 && size <= max_read_size &&
+			std::uint64_t{address} + size <= 0x1'0000'0000ull;
+	}
+
+	// Copies [address, address + size) one guest page at a time. A page that
+	// try_read refuses (unmapped, protected, or released concurrently) is
+	// zero-filled: PS3 titles allocate their memory at run time, so a region
+	// listed by the RetroAchievements memory map may not exist yet. Returns
+	// the number of bytes that came from readable guest pages.
+	template <typename TryRead>
+	std::uint32_t read_guest(std::uint32_t address, std::uint8_t* buffer, std::uint32_t size, TryRead&& try_read)
+	{
+		std::uint32_t copied = 0;
+		std::uint32_t offset = 0;
+
+		while (offset < size)
+		{
+			const std::uint32_t current = address + offset;
+			const std::uint32_t page_left = guest_page_size - (current % guest_page_size);
+			const std::uint32_t chunk = std::min(page_left, size - offset);
+
+			if (try_read(current, buffer + offset, chunk))
+			{
+				copied += chunk;
+			}
+			else
+			{
+				std::memset(buffer + offset, 0, chunk);
+			}
+
+			offset += chunk;
+		}
+
+		return copied;
+	}
+
+	struct speed_settings
+	{
+		std::uint32_t vblank_rate = 60;
+		std::uint32_t clocks_scale = 100;
+		bool frame_limit_unbounded = false;
+	};
+
+	// RetroAchievements Hardcore forbids running a game faster or slower than
+	// the console: the guest VBlank must stay at 60 Hz, the guest clock at
+	// 100 % and presentation must stay limited (not Off, 120 or Infinite).
+	constexpr bool hardcore_compatible(const speed_settings& settings) noexcept
+	{
+		return settings.vblank_rate == 60 && settings.clocks_scale == 100 && !settings.frame_limit_unbounded;
+	}
+
+	// Copies text into a fixed C buffer. Refuses (empty result) rather than
+	// truncating: a shortened path would name another file.
+	inline bool copy_text(char* destination, std::size_t capacity, std::string_view text) noexcept
+	{
+		if (!destination || capacity == 0)
+		{
+			return false;
+		}
+
+		if (text.size() >= capacity || text.find('\0') != std::string_view::npos)
+		{
+			destination[0] = '\0';
+			return false;
+		}
+
+		// An empty view may carry a null pointer, which memcpy must never receive.
+		if (!text.empty())
+		{
+			std::memcpy(destination, text.data(), text.size());
+		}
+
+		destination[text.size()] = '\0';
+		return true;
+	}
+
+	// The library entry of the last title started by rpcs3_ios_boot_game: the
+	// base game ISO or directory (never an installed update or a savestate
+	// file), which the host hashes like RetroAchievements does.
+	class boot_record
+	{
+	public:
+		void clear() noexcept
+		{
+			std::lock_guard lock(m_mutex);
+			m_title_id.clear();
+			m_content_path.clear();
+		}
+
+		void set(std::string_view title_id, std::string_view content_path)
+		{
+			std::lock_guard lock(m_mutex);
+			m_title_id.assign(title_id);
+			m_content_path.assign(content_path);
+			++m_generation;
+		}
+
+		// Fills both buffers; false (and empty buffers) when nothing was booted
+		// or a value does not fit.
+		bool copy(char* title_id, std::size_t title_capacity, char* content_path, std::size_t path_capacity,
+			std::uint64_t& generation) const noexcept
+		{
+			std::lock_guard lock(m_mutex);
+			generation = m_generation;
+			const bool title = copy_text(title_id, title_capacity, m_title_id);
+			const bool path = copy_text(content_path, path_capacity, m_content_path);
+
+			if (!title || !path || m_title_id.empty() || m_content_path.empty())
+			{
+				copy_text(title_id, title_capacity, {});
+				copy_text(content_path, path_capacity, {});
+				return false;
+			}
+
+			return true;
+		}
+
+	private:
+		mutable std::mutex m_mutex;
+		std::string m_title_id;
+		std::string m_content_path;
+		std::uint64_t m_generation = 0;
+	};
+
+	inline boot_record& last_boot() noexcept
+	{
+		static boot_record* const record = new boot_record();
+		return *record;
+	}
+}
diff --git a/rpcs3/ios/RPCS3IOSBootDiagnostics.h b/rpcs3/ios/RPCS3IOSBootDiagnostics.h
index 74ff550..724d75e 100644
--- a/rpcs3/ios/RPCS3IOSBootDiagnostics.h
+++ b/rpcs3/ios/RPCS3IOSBootDiagnostics.h
@@ -376,6 +376,113 @@ namespace rpcs3::ios::boot_diagnostics
 		return line;
 	}
 
+	// --- CONFIG_LAYERS part=rsx (REWINDBOX_GRAPHICS_TESTS_612) ------------------
+	// The effective values of the settings that the Assassin's Creed torch and
+	// Black Ops II viewmodel tests change, one line per boot. It is emitted just
+	// before the main CONFIG_LAYERS line, which stays the last one of the boot
+	// for the host's timeline configuration and cause-history boundary. Values
+	// are cfg::to_string() text. invariance is what the vertex shaders get
+	// (policy and Shader Precision not Low, as VKVertexProgram.cpp decides on
+	// Apple GPUs); invariance_policy is the resolved setting. mvk_async is the
+	// boot's resolved request (the asynchronous-submit canary already applied).
+	// overrides lists, among the sparse user override keys applied on this boot,
+	// only those of the settings this line reports (rsx_override_keys).
+	inline constexpr std::string_view rsx_override_keys[] = {
+		"gpu.zcull_accuracy", "debug.disable_occlusion", "debug.emulate_depth_compare", "gpu.shader_precision",
+		"advanced.disable_msl_fast_math", "debug.disable_vertex_cache", "gpu.strict_rendering",
+		"advanced.read_color_buffers", "advanced.read_depth_buffer", "gpu.msaa", "gpu.vsync",
+		"experimental.position_invariance", "experimental.moltenvk_async_submits",
+		"experimental.gpu_timing", // REWINDBOX_GPU_TIMING_621
+		"experimental.zcull_on_demand", // REWINDBOX_ZCULL_DEMAND_BO2_621
+	};
+	inline constexpr std::size_t rsx_overrides_limit = 400;
+
+	// Comma-separated keys -> the reported ones, in input order, without duplicates.
+	inline std::string filter_rsx_override_keys(std::string_view keys)
+	{
+		std::string result;
+		while (!keys.empty())
+		{
+			const std::size_t comma = keys.find(',');
+			const std::string_view key = keys.substr(0, comma);
+			keys = comma == std::string_view::npos ? std::string_view{} : keys.substr(comma + 1);
+			bool reported = false;
+			for (const std::string_view known : rsx_override_keys)
+			{
+				reported = reported || key == known;
+			}
+			const std::string padded = ',' + result + ',';
+			if (reported && padded.find(',' + std::string{key} + ',') == std::string::npos)
+			{
+				result += result.empty() ? "" : ",";
+				result += key;
+			}
+		}
+		return result;
+	}
+
+	struct config_rsx
+	{
+		std::string_view title;
+		std::string_view relaxed_zcull;     // Relaxed ZCULL Sync
+		std::string_view precise_zpass;     // Accurate ZCULL stats
+		std::string_view zcull_queries_off; // Disable ZCull Occlusion Queries
+		std::string_view depth_compare;     // Emulate Special Depth Comparison
+		std::string_view shader_precision;  // Shader Precision
+		std::string_view msl_fast_math_off; // Disable MSL Fast Math
+		std::string_view vertex_cache_off;  // Disable Vertex Cache
+		std::string_view strict;            // Strict Rendering Mode
+		std::string_view rcb;               // Read Color Buffers
+		std::string_view rdb;               // Read Depth Buffer
+		std::string_view msaa;              // MSAA
+		std::string_view hp_z;              // Force High Precision Z buffer
+		std::string_view fb_bias;           // Framebuffer Aliasing Heuristic Bias
+		std::string_view vsync;             // VSync Mode
+		std::string_view host_labels;       // Allow Host GPU Labels
+		std::string_view strict_flush;      // Strict Texture Flushing
+		bool invariance = false;        // effective: policy and Shader Precision not Low
+		bool invariance_policy = false; // the resolved Position Invariance setting
+		bool mvk_async = false;         // resolved request of this boot
+		bool gpu_timing = false;        // REWINDBOX_GPU_TIMING_621: resolved probe setting
+		bool zcull_demand = false;      // REWINDBOX_ZCULL_DEMAND_BO2_621: resolved ZCULL on-demand reads
+		std::string_view levers627;     // Core 627: the test-page levers, one digit each: 1 on, +2 explicit value
+		bool legacy_custom = false;     // a full custom config was applied (tests would change it)
+		std::string_view overrides;     // every applied sparse override key; filtered when formatted
+	};
+
+	inline std::string format_config_rsx_line(const config_rsx& rsx)
+	{
+		std::string line = "CONFIG_LAYERS part=rsx";
+		append_text(line, "title", rsx.title, 64);
+		append_text(line, "relaxed_zcull", rsx.relaxed_zcull, 16);
+		append_text(line, "precise_zpass", rsx.precise_zpass, 16);
+		append_text(line, "zcull_queries_off", rsx.zcull_queries_off, 16);
+		append_text(line, "depth_compare", rsx.depth_compare, 16);
+		append_text(line, "shader_precision", rsx.shader_precision, 32);
+		append_text(line, "msl_fast_math_off", rsx.msl_fast_math_off, 16);
+		append_text(line, "vertex_cache_off", rsx.vertex_cache_off, 16);
+		append_text(line, "strict", rsx.strict, 16);
+		append_text(line, "rcb", rsx.rcb, 16);
+		append_text(line, "rdb", rsx.rdb, 16);
+		append_text(line, "msaa", rsx.msaa, 32);
+		append_text(line, "hp_z", rsx.hp_z, 16);
+		append_text(line, "fb_bias", rsx.fb_bias, 32);
+		append_text(line, "vsync", rsx.vsync, 32);
+		append_text(line, "host_labels", rsx.host_labels, 16);
+		append_text(line, "strict_flush", rsx.strict_flush, 16);
+		append_u32(line, "invariance", rsx.invariance ? 1u : 0u);
+		append_u32(line, "invariance_policy", rsx.invariance_policy ? 1u : 0u);
+		append_u32(line, "mvk_async", rsx.mvk_async ? 1u : 0u);
+		append_u32(line, "gpu_timing", rsx.gpu_timing ? 1u : 0u);
+		append_u32(line, "zcull_demand", rsx.zcull_demand ? 1u : 0u);
+		append_text(line, "levers627", rsx.levers627, 8);
+		append_u32(line, "legacy_custom", rsx.legacy_custom ? 1u : 0u);
+		const std::string reported = filter_rsx_override_keys(rsx.overrides);
+		append_text(line, "overrides", reported, rsx_overrides_limit);
+		append_u32(line, "overrides_truncated", reported.size() > rsx_overrides_limit ? 1u : 0u);
+		return line;
+	}
+
