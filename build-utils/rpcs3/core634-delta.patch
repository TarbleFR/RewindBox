+extern "C" rpcs3_ios_status rpcs3_ios_ra_read_memory(
+	uint32_t address,
+	void* buffer,
+	uint32_t size,
+	uint32_t* mapped_bytes) noexcept
+{
+	if (mapped_bytes)
+	{
+		*mapped_bytes = 0;
+	}
+
+	if (!rpcs3::ios::achievements::valid_read(address, buffer, size))
+	{
+		return RPCS3_IOS_INVALID_ARGUMENT;
+	}
+
+	u8* const bytes = static_cast<u8*>(buffer);
+
+	if (!Emu.IsRunning() && !Emu.IsPaused())
+	{
+		std::memset(bytes, 0, size);
+		return RPCS3_IOS_INVALID_STATE;
+	}
+
+	try
+	{
+		const u32 copied = rpcs3::ios::achievements::read_guest(address, bytes, size,
+			[](u32 at, u8* out, u32 count)
+			{
+				return vm::try_access(at, out, count, false);
+			});
+
+		if (mapped_bytes)
+		{
+			*mapped_bytes = copied;
+		}
+
+		return RPCS3_IOS_OK;
+	}
+	catch (...)
+	{
+		std::memset(bytes, 0, size);
+		return RPCS3_IOS_INTERNAL_ERROR;
+	}
+}
