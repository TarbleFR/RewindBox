+// REWINDBOX_FREEZE_EPISODE_621: "name:count,…" of the most frequent names (ties
+// by name), at most `limit` entries; empty names are skipped, "none" when none.
+inline std::string format_name_counts(std::vector<std::string> names, std::size_t limit = 4)
+{
+	std::sort(names.begin(), names.end());
+	std::vector<std::pair<std::string, std::size_t>> counts;
+	for (const auto& name : names)
+	{
+		if (name.empty()) continue;
+		if (!counts.empty() && counts.back().first == name) counts.back().second++;
+		else counts.emplace_back(name, 1);
+	}
+	std::stable_sort(counts.begin(), counts.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+	std::string result;
+	for (std::size_t i = 0; i < counts.size() && i < limit; ++i)
+	{
+		if (!result.empty()) result += ',';
+		result += counts[i].first + ':' + std::to_string(counts[i].second);
+	}
+	return result.empty() ? "none" : result;
+}
