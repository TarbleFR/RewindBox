--- /dev/null
+++ b/rpcs3/ios/IOSLocalProfile933.h
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <system_error>
+
+// REWINDBOX_LOCAL_PROFILE_933 (maintainer audit, 11 Nov 2026, priority 3: keep the decisions validated for a game on
+// this device for its later launches): what the Core learned about a title, in config/local_profiles/<serial>.txt.
+// - Keyed by the serial and the game version (PARAM.SFO APP_VER, which a game update changes). A profile of another
+//   version or format, or a file that is too large or not understood, is ignored and replaced; it never stops a boot.
+// - Bounded: at most max_bytes, a closed set of decisions with closed values; an unknown decision line is skipped
+//   (a later Core may add one) and counted.
+// - Written whole and atomically (fs::pending_file, ios/IOSLocalProfileStore933.h), only when a decision is learned or
+//   withdrawn, and on its first `validation_writes` validations (a boot that validates it again writes nothing).
+// - A learned decision acts only where the title's setting is Automatic and the Core's title list does not already
+//   decide; the user's setting, global or per game, always wins. It takes effect at the next boot, never mid-session.
+//
+// REWINDBOX_LEARNED_PREFETCH_933, first learned decision (shares a validated correction by mechanism instead of a
+// title list): the SPU object prefetch of Core 616 (ios/IOSSpuObjectPrefetch.h) reads a title's cached SPU objects
+// into memory on a utility thread from the runtime's creation, so that a compile thread takes their bytes instead of
+// opening thousands of small files. Black Ops II spent 4.3 s of a 5 s window opening 7,162 objects (Build 614) and
+// takes them in 0.02 ms from memory; Assassin's Creed read 4,000 in its first minute, 0.4 to 0.7 ms each. Both are on
+// the title list. Any other title that shows the same cost learns the prefetch:
+// - learn: a report window with the prefetch off in which the compile threads spent at least evidence_min_us reading
+//   at least evidence_min_reads SPU objects (JITPROF spu_cache_read, the same file read and inflate), at least half of
+//   them for compiles of play (SPUPROF gameplay_attempts), not of the boot warm-up;
+// - validate: a later boot with the learned prefetch serves at least validate_min_hits objects from memory;
+// - withdraw: a boot with the learned prefetch that ran withdraw_after_windows reports and served less than
+//   withdraw_max_hit_permille of the planned objects (memory held for nothing); only windows with presented frames
+//   count, so a pause or the background never withdraws it. A withdrawn decision stays withdrawn for this game
+//   version. A boot whose store did not start (SPU cache off, no object on disk) plans nothing: its decision neither
+//   validates nor withdraws, and holds no memory.
+// - The first report window of a boot's session is not used, nor any window reported before it: the reporter starts
+//   its session when the renderer is created, after the title policy, and the JIT and prefetch counters are exchanged
+//   only by the report, so these windows can hold the end of the previous boot (a game started within 5 s of another).
+// Same bytes, same validation, same link as the disk path: guest code is unchanged.
+// The JITPROF counters were read by no decision before (Utilities/JITPhaseProfile.h still says so); this rule reads the
+// spu_cache_read figures of a window after the reporter has exchanged them, to decide the next boot, never the current
+// one and never code generation.
+namespace rpcs3::ios::local_profile933
+{
+inline constexpr std::string_view header = "rewindbox-local-profile 1";
+inline constexpr std::size_t max_bytes = 4096;
+inline constexpr std::size_t max_version_size = 16;
+
+inline constexpr std::uint64_t evidence_min_reads = 200;
+inline constexpr std::uint64_t evidence_min_us = 500'000; // a tenth of a 5 s report window
+inline constexpr std::uint64_t validate_min_hits = 500;
+inline constexpr std::uint32_t withdraw_after_windows = 24; // two minutes of reports
+inline constexpr std::uint64_t withdraw_min_planned = 100;
+inline constexpr std::uint64_t withdraw_max_hit_permille = 10;
+inline constexpr std::uint32_t validation_writes = 3;
+
+enum class state : std::uint8_t
+{
+	none,
+	on,
+	withdrawn,
+};
+
+constexpr const char* state_name(state value) noexcept
+{
+	switch (value)
+	{
+	case state::on: return "on";
+	case state::withdrawn: return "withdrawn";
+	default: return "none";
+	}
+}
+
+struct prefetch_record
+{
+	state value = state::none;
+	std::uint32_t validated = 0;      // boots in which the learned prefetch served the title's reads
+	std::uint64_t evidence_reads = 0; // the window that taught it: SPU objects read by the compile threads
+	std::uint64_t evidence_ms = 0;    // and the time they spent reading them
+	std::uint32_t withdrawn_planned = 0, withdrawn_hits = 0; // what the withdrawing boot planned and served
+};
+
+struct profile
+{
+	std::string serial, version;
+	prefetch_record prefetch;
+	std::uint32_t skipped_lines = 0; // decisions of a later Core, kept out
+};
+
+enum class load_status : std::uint8_t
+{
+	absent,
+	loaded,
+	other_version,
+	malformed,
+	too_large,
+	unreadable,
+	not_a_title, // no serial or no version: nothing is read or written
+};
+
+constexpr const char* load_status_name(load_status value) noexcept
+{
+	switch (value)
+	{
+	case load_status::absent: return "absent";
+	case load_status::loaded: return "loaded";
+	case load_status::other_version: return "other_version";
+	case load_status::malformed: return "malformed";
+	case load_status::too_large: return "too_large";
+	case load_status::unreadable: return "unreadable";
+	case load_status::not_a_title: return "not_a_title";
+	default: return "unknown";
+	}
+}
+
+// The serial names the file: four capital letters and five digits (BLES01717), nothing else.
+constexpr bool valid_serial(std::string_view serial) noexcept
+{
+	if (serial.size() != 9)
+	{
+		return false;
+	}
+	for (std::size_t i = 0; i < 9; i++)
+	{
+		const char c = serial[i];
+		if (i < 4 ? !(c >= 'A' && c <= 'Z') : !(c >= '0' && c <= '9'))
+		{
+			return false;
+		}
+	}
+	return true;
+}
+
+// APP_VER ("01.02") or VERSION: one token, digits, letters, dots, dashes and underscores, with at least one digit.
+// Emulator::Load names a title without either "Unknown": such a title has no version a game update would change, so it
+// gets no profile.
+constexpr bool valid_version(std::string_view version) noexcept
+{
+	if (version.empty() || version.size() > max_version_size)
+	{
+		return false;
+	}
+	bool digit = false;
+	for (const char c : version)
+	{
+		if (!((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '.' || c == '-' || c == '_'))
+		{
+			return false;
+		}
+		digit = digit || (c >= '0' && c <= '9');
+	}
+	return digit;
+}
+
+namespace detail
+{
+// Splits off the next space-separated token.
+constexpr std::string_view next_token(std::string_view& rest) noexcept
+{
+	while (!rest.empty() && rest.front() == ' ')
+	{
+		rest.remove_prefix(1);
+	}
+	const std::size_t end = rest.find(' ');
+	const std::string_view token = rest.substr(0, end);
+	rest.remove_prefix(end == std::string_view::npos ? rest.size() : end);
+	return token;
+}
+
+template <typename T>
+bool number(std::string_view text, T& out) noexcept
+{
+	if (text.empty() || text.size() > 20)
+	{
+		return false;
+	}
+	T value{};
+	const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+	if (error != std::errc{} || end != text.data() + text.size())
+	{
+		return false;
+	}
+	out = value;
+	return true;
+}
+
+// "name=value" with a decimal value.
+template <typename T>
+bool field(std::string_view token, std::string_view name, T& out) noexcept
+{
+	return token.size() > name.size() + 1 && token.substr(0, name.size()) == name && token[name.size()] == '=' &&
+		number(token.substr(name.size() + 1), out);
+}
+
+inline bool parse_prefetch(std::string_view rest, prefetch_record& out) noexcept
+{
+	const std::string_view value = next_token(rest);
+	prefetch_record record{};
+	if (value == "on")
+	{
+		record.value = state::on;
+	}
+	else if (value == "withdrawn")
+	{
+		record.value = state::withdrawn;
+	}
+	else
+	{
+		return false;
+	}
+	if (!field(next_token(rest), "validated", record.validated) || !field(next_token(rest), "evidence_reads", record.evidence_reads) ||
+		!field(next_token(rest), "evidence_ms", record.evidence_ms) || !field(next_token(rest), "withdrawn_planned", record.withdrawn_planned) ||
+		!field(next_token(rest), "withdrawn_hits", record.withdrawn_hits) || !next_token(rest).empty())
+	{
+		return false;
+	}
+	out = record;
+	return true;
+}
+} // namespace detail
+
+inline std::string serialize(const profile& p)
+{
+	std::string text{header};
+	text += "\nserial ";
+	text += p.serial;
+	text += "\nversion ";
+	text += p.version;
+	text += '\n';
+	if (p.prefetch.value != state::none)
+	{
+		text += "spu_object_prefetch ";
+		text += state_name(p.prefetch.value);
+		text += " validated=" + std::to_string(p.prefetch.validated);
+		text += " evidence_reads=" + std::to_string(p.prefetch.evidence_reads);
+		text += " evidence_ms=" + std::to_string(p.prefetch.evidence_ms);
+		text += " withdrawn_planned=" + std::to_string(p.prefetch.withdrawn_planned);
+		text += " withdrawn_hits=" + std::to_string(p.prefetch.withdrawn_hits);
+		text += '\n';
+	}
+	return text;
+}
+
+// Reads a profile written for this serial and version. Anything else leaves `out` as an empty profile of this
+// serial and version, so that the next write replaces the file.
+inline load_status parse(std::string_view text, std::string_view serial, std::string_view version, profile& out)
+{
+	out = profile{std::string{serial}, std::string{version}, {}, 0};
+	if (text.size() > max_bytes)
+	{
+		return load_status::too_large;
+	}
+
+	profile read{std::string{serial}, std::string{version}, {}, 0};
+	bool have_header = false, have_serial = false, have_version = false, have_prefetch = false;
+	std::size_t line_number = 0;
+
+	while (!text.empty())
+	{
+		const std::size_t end = text.find('\n');
+		if (end == std::string_view::npos)
+		{
+			return load_status::malformed; // every line ends with a newline: a cut file is not read
+		}
+		std::string_view line = text.substr(0, end);
+		text.remove_prefix(end + 1);
+
+		if (line_number++ == 0)
+		{
+			if (line != header)
+			{
+				return load_status::malformed;
+			}
+			have_header = true;
+			continue;
+		}
+
+		std::string_view rest = line;
+		const std::string_view key = detail::next_token(rest);
+		if (key == "serial")
+		{
+			const std::string_view value = detail::next_token(rest);
+			if (have_serial || !valid_serial(value) || !detail::next_token(rest).empty())
+			{
+				return load_status::malformed;
+			}
+			if (value != serial)
+			{
+				return load_status::malformed; // another title's file under this name
+			}
+			have_serial = true;
+		}
+		else if (key == "version")
+		{
+			const std::string_view value = detail::next_token(rest);
+			if (have_version || !valid_version(value) || !detail::next_token(rest).empty())
+			{
+				return load_status::malformed;
+			}
+			if (value != version)
+			{
+				return load_status::other_version;
+			}
+			have_version = true;
+		}
+		else if (key == "spu_object_prefetch")
+		{
+			if (have_prefetch || !detail::parse_prefetch(rest, read.prefetch))
+			{
+				return load_status::malformed;
+			}
+			have_prefetch = true;
+		}
+		else if (!key.empty() && key.find('=') == std::string_view::npos)
+		{
+			read.skipped_lines++;
+		}
+		else
+		{
+			return load_status::malformed;
+		}
+	}
+
+	if (!have_header || !have_serial || !have_version)
+	{
+		return load_status::malformed;
+	}
+	out = std::move(read);
+	return load_status::loaded;
+}
+
+// One report window, as RPCS3IOSPerformance.cpp reads it.
+struct window_input
+{
+	bool prefetch_active = false;       // the store was started at this boot
+	std::uint64_t cache_reads = 0;      // JITPROF spu_cache_read events of the window
+	std::uint64_t cache_read_us = 0;    // and their exclusive time
+	std::uint64_t prefetch_hits = 0;    // objects the store served from memory in the window
+	std::uint64_t prefetch_planned = 0; // objects the store planned at boot
+	std::uint64_t frames = 0;           // frames presented in the window (0: paused, in the background or frozen)
+	std::uint64_t gameplay_compiles = 0; // SPUPROF gameplay_attempts: SPU compiles outside the boot warm-up
+	std::uint64_t session = 0;           // the report's session (COREPROF session=)
+};
+
+enum class verdict : std::uint8_t
+{
+	none,
+	learned,
+	validated,
+	withdrawn,
+};
+
+constexpr const char* verdict_name(verdict value) noexcept
+{
+	switch (value)
+	{
+	case verdict::learned: return "learned";
+	case verdict::validated: return "validated";
+	case verdict::withdrawn: return "withdrawn";
+	default: return "none";
+	}
+}
+
+// The learning of one boot. Called from the report thread only.
+class prefetch_rule
+{
+	bool m_eligible = false;   // Automatic, and the title list does not decide
+	bool m_learned_on = false; // this boot runs the learned prefetch
+	bool m_settled = false;    // validated or withdrawn at this boot: nothing more to decide
+	bool m_session_seen = false;
+	std::uint64_t m_session = 0;
+	std::uint32_t m_windows = 0;
+	std::uint64_t m_hits = 0;
+
+public:
+	void begin(bool eligible, bool learned_on) noexcept
+	{
+		*this = prefetch_rule{};
+		m_eligible = eligible;
+		m_learned_on = eligible && learned_on;
+	}
+
+	bool eligible() const noexcept { return m_eligible; }
+	bool learned_on() const noexcept { return m_learned_on; }
+
+	verdict observe(const window_input& in, prefetch_record& record) noexcept
+	{
+		if (!m_eligible || m_settled)
+		{
+			return verdict::none;
+		}
+
+		// A window of another session than the last one seen is the first of a new session, or one reported before it:
+		// it may hold counts of the previous boot.
+		if (!m_session_seen || in.session != m_session)
+		{
+			m_session_seen = true;
+			m_session = in.session;
+			return verdict::none;
+		}
+
+		if (!m_learned_on)
+		{
+			// The reads must come from the compiles of play: the boot warm-up reads every recorded object on its own
+			// workers before the game runs (God of War III, Build 694: 1,810 objects in 1.85 s, all warm-up), and
+			// the prefetch does not shorten that wait.
+			if (record.value != state::none || in.prefetch_active || in.cache_reads < evidence_min_reads || in.cache_read_us < evidence_min_us ||
+				in.gameplay_compiles * 2 < in.cache_reads)
+			{
+				return verdict::none;
+			}
+			record = prefetch_record{state::on, 0, in.cache_reads, in.cache_read_us / 1000, 0, 0};
+			m_settled = true;
+			return verdict::learned;
+		}
+
+		// Hits count whenever they come; only a window in which the game presented frames counts towards the
+		// withdrawal, so that a pause or the background never withdraws a decision.
+		m_hits += in.prefetch_hits;
+		m_windows += in.frames ? 1u : 0u;
+		if (m_hits >= validate_min_hits)
+		{
+			m_settled = true;
+			if (record.validated >= validation_writes)
+			{
+				return verdict::none; // validated often enough: nothing to write
+			}
+			record.validated++;
+			return verdict::validated;
+		}
+		if (m_windows >= withdraw_after_windows && in.prefetch_planned >= withdraw_min_planned &&
+			m_hits * 1000 < in.prefetch_planned * withdraw_max_hit_permille)
+		{
+			record.value = state::withdrawn;
+			record.withdrawn_planned = static_cast<std::uint32_t>(in.prefetch_planned > UINT32_MAX ? UINT32_MAX : in.prefetch_planned);
+			record.withdrawn_hits = static_cast<std::uint32_t>(m_hits);
+			m_settled = true;
+			return verdict::withdrawn;
+		}
+		return verdict::none;
+	}
+};
+} // namespace rpcs3::ios::local_profile933
diff --git a/rpcs3/ios/IOSLocalProfileStore933.h b/rpcs3/ios/IOSLocalProfileStore933.h
new file mode 100644
index 0000000..2047c56
--- /dev/null
+++ b/rpcs3/ios/IOSLocalProfileStore933.h
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSLocalProfile933.h"
+#include "Utilities/File.h"
+
+#include <mutex>
+#include <string>
+#include <string_view>
+
+// REWINDBOX_LOCAL_PROFILE_933 (ios/IOSLocalProfile933.h): the profile file and the profile of the running boot.
+// Emulator::Load reads it before the title policy is resolved; the policy resolution starts the boot's learning; the
+// report thread feeds each window and writes the file when a decision is learned, withdrawn or validated (its first
+// validation_writes times). One mutex: the boot thread and the report thread never hold it for longer than a small file
+// write, and it takes no other lock.
+namespace rpcs3::ios::local_profile933
+{
+// Beside config.yml and the configuration database cache (config/).
+inline std::string directory()
+{
+	return fs::get_config_dir(true) + "local_profiles/";
+}
+
+inline std::string path_for(std::string_view serial)
+{
+	return directory() + std::string{serial} + ".txt";
+}
+
+struct observation
+{
+	verdict outcome = verdict::none;
+	prefetch_record record{};
+	bool saved = false;
+	std::uint64_t hits = 0, planned = 0;
+};
+
+class current
+{
+	mutable std::mutex m_mutex;
+	load_status m_status = load_status::not_a_title;
+	profile m_profile{};
+	prefetch_rule m_rule{};
+
+	// Whole file, written to a temporary name and renamed over the old one.
+	static bool save(const profile& value)
+	{
+		const std::string text = serialize(value);
+		if (text.size() > max_bytes || !fs::create_path(directory()))
+		{
+			return false;
+		}
+		fs::pending_file destination{path_for(value.serial)};
+		return destination.file && destination.file.write(text.data(), text.size()) == text.size() && destination.commit();
+	}
+
+public:
+	static current& instance()
+	{
+		static current value;
+		return value;
+	}
+
+	// At boot, before the title policy is resolved. Nothing is read for a boot without a game serial and version.
+	load_status load(std::string_view serial, std::string_view version)
+	{
+		std::lock_guard lock(m_mutex);
+		m_rule.begin(false, false);
+		m_profile = profile{};
+		if (!valid_serial(serial) || !valid_version(version))
+		{
+			return m_status = load_status::not_a_title;
+		}
+
+		m_profile.serial = std::string{serial};
+		m_profile.version = std::string{version};
+		const std::string path = path_for(serial);
+		if (!fs::is_file(path))
+		{
+			return m_status = load_status::absent;
+		}
+
+		fs::file file{path, fs::read};
+		if (!file)
+		{
+			return m_status = load_status::unreadable;
+		}
+		if (file.size() > max_bytes)
+		{
+			return m_status = load_status::too_large;
+		}
+		const std::string text = file.to_string();
+		return m_status = parse(text, serial, version, m_profile);
+	}
+
+	load_status status() const
+	{
+		std::lock_guard lock(m_mutex);
+		return m_status;
+	}
+
+	prefetch_record prefetch() const
+	{
+		std::lock_guard lock(m_mutex);
+		return m_profile.prefetch;
+	}
+
+	std::uint32_t skipped_lines() const
+	{
+		std::lock_guard lock(m_mutex);
+		return m_profile.skipped_lines;
+	}
+
+	// From the title policy: whether this boot may learn (Automatic, no title list decision) and whether it runs the
+	// learned prefetch. A boot without a title learns nothing.
+	void begin_boot(bool eligible, bool learned_on)
+	{
+		std::lock_guard lock(m_mutex);
+		m_rule.begin(eligible && m_status != load_status::not_a_title, learned_on);
+	}
+
+	// From the report thread, once per window.
+	observation observe(const window_input& in)
+	{
+		std::lock_guard lock(m_mutex);
+		observation result;
+		prefetch_record record = m_profile.prefetch;
+		result.outcome = m_rule.observe(in, record);
+		result.hits = in.prefetch_hits;
+		result.planned = in.prefetch_planned;
+		if (result.outcome != verdict::none)
+		{
+			m_profile.prefetch = record;
+			m_profile.skipped_lines = 0; // the file is rewritten from what this Core understands
+			result.saved = save(m_profile);
+		}
+		result.record = m_profile.prefetch;
+		return result;
+	}
+};
+} // namespace rpcs3::ios::local_profile933
