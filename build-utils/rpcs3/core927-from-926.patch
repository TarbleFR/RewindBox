diff --git a/rpcs3/ios/IOSGpuBackgroundGate.h b/rpcs3/ios/IOSGpuBackgroundGate.h
new file mode 100644
index 0000000..6f4dce0
--- /dev/null
+++ b/rpcs3/ios/IOSGpuBackgroundGate.h
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+// REWINDBOX_GPU_BACKGROUND_GATE_927: iOS executes no Metal command buffer for an application in the background. One
+// committed there fails with MTLCommandBufferErrorNotPermitted, and MoltenVK then reports the device and the physical
+// device lost, whatever MVK_CONFIG_RESUME_LOST_DEVICE says (MVKQueue::handleMTLCommandBufferError, MVKQueue.mm:234-241):
+// the next Vulkan call ends the RSX thread. Nothing told the renderer about the transition; it kept submitting until
+// iOS suspended the process.
+//
+// IPA 650, Assassin's Creed, pid 8767, asynchronous MoltenVK submits: "Device lost" raised by vkGetQueryPoolResults at
+// 1793814730.525, HOST_STATE app=background recorded at 1793814730.555. It is the only device loss of the device
+// journals, and it happened as the application entered the background. With asynchronous submits the work queued
+// before the transition is still encoded and committed after it; with synchronous ones the RSX thread still commits
+// the frame it is building.
+//
+// The Core listens to the application itself (RPCS3IOSPlatform.mm), on the thread that posts, inside the transition:
+// - UIApplicationDidEnterBackgroundNotification closes the gate. A thread about to submit, present, acquire an image
+//   or wait for the device parks before the call. The posting thread waits for the calls already inside, then for
+//   everything queued so far to be encoded and executed (the renderer's settle function: an empty submission with a
+//   fence on each queue). Each wait is bounded; then the transition goes on. iOS accepts GPU work until the
+//   application returns from that transition (the rule Apple documents for applicationDidEnterBackground), which is
+//   why the settle may still submit; when a call is still inside after its limit the settle is skipped, because the
+//   queues are not the posting thread's to use then.
+// - UIApplicationDidBecomeActiveNotification opens the gate and the parked calls run, in their order.
+// Nothing is dropped, skipped or reordered: the calls happen later, as they already do when iOS suspends the process.
+// A thread of an emulator that is being stopped does not park (the bypass function): stopping in the background goes
+// on as it did before the gate existed.
+namespace rpcs3::ios::gpu_gate
+{
+// The patience of the thread that closes the gate (iOS gives the transition about five seconds in all).
+inline constexpr std::chrono::milliseconds in_flight_limit{500};
+inline constexpr std::chrono::milliseconds settle_limit{1000};
+
+// A parked call looks at the bypass function this often.
+inline constexpr std::chrono::milliseconds park_slice{100};
+
+// Since boot (COREPROF GPUGATE927).
+inline std::atomic<std::uint64_t> closes{0}, opens{0};
+inline std::atomic<std::uint64_t> parks{0}, park_us{0}, park_bypasses{0};
+inline std::atomic<std::uint64_t> in_flight_timeouts{0};
+inline std::atomic<std::uint64_t> settles{0}, settle_us{0}, settle_timeouts{0};
+
+inline std::uint64_t elapsed_us(std::chrono::steady_clock::time_point since) noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now() - since).count());
+}
+
+// Encoded and executed, or the limit passed: returns whether everything queued before the call completed.
+using settle_function = bool (*)(std::chrono::milliseconds limit);
+// Called by a parked thread: whether that thread must go on although the gate is closed (its emulator is stopping).
+using bypass_function = bool (*)();
+
+class gate
+{
+	std::mutex m_mutex;
+	std::condition_variable m_opened; // parked calls
+	std::condition_variable m_idle;   // the thread that closes
+	bool m_closed = false;
+	std::uint32_t m_inside = 0;
+
+	// Held while the settle function runs, so the renderer that owns it cannot go away under it.
+	std::mutex m_settle_mutex;
+	settle_function m_settle = nullptr;
+	std::atomic<bypass_function> m_bypass{nullptr};
+
+public:
+	static gate& instance() noexcept
+	{
+		static gate s_gate;
+		return s_gate;
+	}
+
+	// Before a call that gives work to the GPU. Parks while the gate is closed.
+	void enter() noexcept
+	{
+		std::unique_lock lock(m_mutex);
+		if (m_closed)
+		{
+			const auto begin = std::chrono::steady_clock::now();
+			bool parked = false;
+			for (;;)
+			{
+				// Looked at before the first wait too: a stopping emulator makes many calls and none of them waits.
+				const bypass_function bypass = m_bypass.load(std::memory_order_relaxed);
+				if (bypass && bypass())
+				{
+					park_bypasses.fetch_add(1, std::memory_order_relaxed);
+					break;
+				}
+
+				if (!parked)
+				{
+					parked = true;
+					parks.fetch_add(1, std::memory_order_relaxed);
+				}
+
+				if (m_opened.wait_for(lock, park_slice, [this] { return !m_closed; }))
+				{
+					break;
+				}
+			}
+
+			if (parked)
+			{
+				park_us.fetch_add(elapsed_us(begin), std::memory_order_relaxed);
+			}
+		}
+
+		++m_inside;
+	}
+
+	// After the call.
+	void leave() noexcept
+	{
+		bool idle = false;
+		{
+			std::lock_guard lock(m_mutex);
+			idle = --m_inside == 0;
+		}
+
+		if (idle)
+		{
+			m_idle.notify_all();
+		}
+	}
+
+	// No new call enters from now on. Returns whether the calls already inside left within the limit.
+	bool close(std::chrono::milliseconds limit = in_flight_limit) noexcept
+	{
+		std::unique_lock lock(m_mutex);
+		if (!m_closed)
+		{
+			m_closed = true;
+			closes.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		const bool idle = m_idle.wait_for(lock, limit, [this] { return m_inside == 0; });
+		if (!idle)
+		{
+			in_flight_timeouts.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		return idle;
+	}
+
+	void open() noexcept
+	{
+		{
+			std::lock_guard lock(m_mutex);
+			if (!m_closed)
+			{
+				return;
+			}
+
+			m_closed = false;
+			opens.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		m_opened.notify_all();
+	}
+
+	bool closed() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return m_closed;
+	}
+
+	// The renderer gives its settle function once its device exists and takes it back (null) before the device
+	// goes; taking it back waits for a settle in progress.
+	void set_settle(settle_function settle) noexcept
+	{
+		std::lock_guard lock(m_settle_mutex);
+		m_settle = settle;
+	}
+
+	// A function that never goes away (it is looked at by parked threads without a lock), or null.
+	void set_bypass(bypass_function bypass) noexcept
+	{
+		m_bypass.store(bypass, std::memory_order_relaxed);
+	}
+
+	// The application entered the background: on the posting thread, before the transition finishes.
+	void app_entered_background() noexcept
+	{
+		if (!close())
+		{
+			// A call is still inside (counted): the queues are in use, nothing more can be asked of them from here.
+			return;
+		}
+
+		std::lock_guard lock(m_settle_mutex);
+		if (m_settle)
+		{
+			const auto begin = std::chrono::steady_clock::now();
+			const bool settled = m_settle(settle_limit);
+			settles.fetch_add(1, std::memory_order_relaxed);
+			settle_us.fetch_add(elapsed_us(begin), std::memory_order_relaxed);
+			if (!settled)
+			{
+				settle_timeouts.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+	}
+
+	void app_became_active() noexcept
+	{
+		open();
+	}
+};
+
+// A call that gives work to the GPU, on this thread. A pass inside another one of the same thread is the same call.
+inline thread_local std::uint32_t pass_depth = 0;
+
+class pass
+{
+public:
+	pass() noexcept
+	{
+		if (pass_depth++ == 0)
+		{
+			gate::instance().enter();
+		}
+	}
+
+	~pass()
+	{
+		if (--pass_depth == 0)
+		{
+			gate::instance().leave();
+		}
+	}
+
+	pass(const pass&) = delete;
+	pass& operator=(const pass&) = delete;
+};
+
+// Implemented in RPCS3IOSPlatform.mm: registers the two application observers, once per process.
+void install_application_observers() noexcept;
+} // namespace rpcs3::ios::gpu_gate
