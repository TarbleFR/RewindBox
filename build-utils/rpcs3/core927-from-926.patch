+// REWINDBOX_GPU_BACKGROUND_GATE_927 (ios/IOSGpuBackgroundGate.h). The blocks are given no queue, so they run on the
+// thread that posts the notification, the main thread, inside the transition: the gate is closed and the queues have
+// settled before UIKit goes on to the background, and nothing is committed again before the application is active.
+namespace rpcs3::ios::gpu_gate
+{
+void install_application_observers() noexcept
+{
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		@autoreleasepool
+		{
+			NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+			id background = [center addObserverForName:UIApplicationDidEnterBackgroundNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { gate::instance().app_entered_background(); }];
+			id active = [center addObserverForName:UIApplicationDidBecomeActiveNotification object:nil queue:nil
+				usingBlock:^(NSNotification*) { gate::instance().app_became_active(); }];
+			// Registered for the life of the process.
+			static_cast<void>(CFBridgingRetain(background));
+			static_cast<void>(CFBridgingRetain(active));
+		}
+	});
+}
