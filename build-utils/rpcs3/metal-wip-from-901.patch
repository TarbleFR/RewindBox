diff --git a/rpcs3/Emu/RSX/Metal/MTLCommandContext.cpp b/rpcs3/Emu/RSX/Metal/MTLCommandContext.cpp
new file mode 100644
index 0000000..8a74df7
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommandContext.cpp
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): command recording, submission, residency and deferred release.
+
+#include "stdafx.h"
+#include "MTLCommandContext.h"
+
+namespace mtl
+{
+	void command_context::create(const object& device, const object& queue, const object& event, const object& residency)
+	{
+		m_device = device;
+		m_queue = queue;
+		m_event = event;
+		m_residency = residency;
+	}
+
+	void command_context::destroy()
+	{
+		if (recording())
+		{
+			submit(false);
+		}
+
+		wait_idle();
+		collect();
+		m_releases.clear();
+		m_encoder.reset();
+		m_command_buffer.reset();
+		m_residency.reset();
+		m_event.reset();
+		m_queue.reset();
+		m_device.reset();
+	}
+
+	void command_context::begin(const object& allocator, std::string_view label)
+	{
+		ensure(!recording());
+		m_command_buffer = new_command_buffer(m_device);
+		ensure(m_command_buffer, "Metal: command buffer creation failed");
+		begin_command_buffer(m_command_buffer, allocator, label);
+	}
+
+	const object& command_context::begin_render(const render_pass_descriptor& pass, u64 pass_id, std::string_view label)
+	{
+		ensure(recording());
+		end_encoder();
+
+		m_encoder = begin_render_pass(m_command_buffer, pass, label);
+		ensure(m_encoder, "Metal: render encoder creation failed");
+		barrier_after_queue_stages(m_encoder, barrier_all, barrier_all);
+		m_kind = encoder_kind::render;
+		m_render_pass_id = pass_id;
+		m_counters.encoders_render++;
+		return m_encoder;
+	}
+
+	const object& command_context::compute(std::string_view label)
+	{
+		ensure(recording());
+		if (m_kind == encoder_kind::compute)
+		{
+			return m_encoder;
+		}
+
+		end_encoder();
+		m_encoder = begin_compute(m_command_buffer, label);
+		ensure(m_encoder, "Metal: compute encoder creation failed");
+		barrier_after_queue_stages(m_encoder, barrier_all, barrier_all);
+		m_kind = encoder_kind::compute;
+		m_counters.encoders_compute++;
+		return m_encoder;
+	}
+
+	void command_context::end_encoder()
+	{
+		if (m_encoder)
+		{
+			end_encoding(m_encoder);
+			m_encoder.reset();
+		}
+
+		m_kind = encoder_kind::none;
+		m_render_pass_id = 0;
+	}
+
+	u64 command_context::submit(bool early, const object& drawable)
+	{
+		if (!recording())
+		{
+			return m_last_submitted;
+		}
+
+		end_encoder();
+		commit_residency();
+		end_command_buffer(m_command_buffer);
+		if (drawable)
+		{
+			wait_for_drawable(m_queue, drawable);
+		}
+		commit(m_queue, m_command_buffer);
+		signal_event(m_queue, m_event, ++m_last_submitted);
+		if (drawable)
+		{
+			signal_drawable(m_queue, drawable);
+		}
+		m_command_buffer.reset();
+
+		m_counters.submissions++;
+		if (early)
+		{
+			m_counters.early_submissions++;
+		}
+
+		return m_last_submitted;
+	}
+
+	u64 command_context::completed() const
+	{
+		return m_event ? signaled_value(m_event) : m_last_submitted;
+	}
+
+	void command_context::wait(u64 value)
+	{
+		if (!m_event || completed() >= value)
+		{
+			return;
+		}
+
+		m_counters.waits++;
+		u32 slow = 0;
+		while (!wait_signaled_value(m_event, value, 5000))
+		{
+			// Never abandoned: the frame's results are needed. Counted and logged so a GPU hang is visible.
+			m_counters.slow_waits++;
+			rsx_log.error("Metal: GPU work %llu not complete after %u s (completed %llu)", value, ++slow * 5, completed());
+		}
+	}
+
+	void command_context::wait_idle()
+	{
+		wait(m_last_submitted);
+	}
+
+	void command_context::make_resident(const object& allocation)
+	{
+		if (allocation && m_residency)
+		{
+			residency_add(m_residency, allocation);
+			m_residency_dirty = true;
+		}
+	}
+
+	void command_context::commit_residency()
+	{
+		if (m_residency_dirty && m_residency)
+		{
+			residency_commit(m_residency);
+			m_residency_dirty = false;
+		}
+	}
+
+	void command_context::dispose(object resource, bool resident)
+	{
+		if (!resource)
+		{
+			return;
+		}
+
+		// The work being recorded will be submitted as m_last_submitted + 1.
+		const u64 safe_after = m_last_submitted + (recording() ? 1 : 0);
+		m_releases.push_back({ std::move(resource), safe_after, resident });
+	}
+
+	void command_context::collect()
+	{
+		if (m_releases.empty())
+		{
+			return;
+		}
+
+		const u64 done = completed();
+		while (!m_releases.empty() && m_releases.front().safe_after <= done)
+		{
+			auto& entry = m_releases.front();
+			if (entry.resident && m_residency)
+			{
+				residency_remove(m_residency, entry.resource);
+				m_residency_dirty = true;
+			}
+			m_releases.pop_front();
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommandContext.h b/rpcs3/Emu/RSX/Metal/MTLCommandContext.h
new file mode 100644
index 0000000..104e0ed
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommandContext.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): what the native Metal 4 renderer is recording into.
+//
+// One MTL4 command buffer is open at a time, on the current frame's allocator (a frame may submit several: an early
+// submission for a readback or a full ring starts the next one on the same allocator). At most one encoder is open.
+// Metal 4 does not track hazards: every new encoder starts with a queue barrier after all stages of earlier work
+// (conservative and correct; narrower barriers are an optimisation for later, measured on the iPhone).
+// Metal 4 command buffers do not retain resources either: anything released while the GPU may still read it goes
+// through dispose(), which keeps it (and its residency) until the submission that could use it has completed.
+
+#include "MTLAPI.h"
+
+#include <deque>
+#include <string>
+#include <string_view>
+
+namespace mtl
+{
+	class command_context
+	{
+	public:
+		enum class encoder_kind : u8
+		{
+			none,
+			render,
+			compute,
+		};
+
+		struct counters_t
+		{
+			u64 submissions = 0;
+			u64 early_submissions = 0;
+			u64 waits = 0;
+			u64 slow_waits = 0;
+			u64 encoders_render = 0;
+			u64 encoders_compute = 0;
+		};
+
+		void create(const object& device, const object& queue, const object& event, const object& residency);
+		void destroy();
+
+		const object& device() const { return m_device; }
+
+		// Recording
+		bool recording() const { return !!m_command_buffer; }
+		void begin(const object& allocator, std::string_view label);
+		const object& command_buffer() const { return m_command_buffer; }
+
+		// Encoders
+		encoder_kind kind() const { return m_kind; }
+		const object& encoder() const { return m_encoder; }
+		u64 render_pass_id() const { return m_render_pass_id; }
+		const object& begin_render(const render_pass_descriptor& pass, u64 pass_id, std::string_view label);
+		const object& compute(std::string_view label);
+		void end_encoder();
+
+		// Submission: ends the open encoder and the command buffer, commits it and signals the next event value.
+		// With a drawable, the queue waits for it before the work and signals it after (Metal 4 presentation).
+		u64 submit(bool early, const object& drawable = {});
+		u64 last_submitted() const { return m_last_submitted; }
+		u64 completed() const;
+		// Waits for a submitted value. The wait is never abandoned: waits longer than 5 s are counted and logged.
+		void wait(u64 value);
+		void wait_idle();
+
+		// Residency of the renderer's allocations (rings, surfaces, textures).
+		void make_resident(const object& allocation);
+		void commit_residency();
+
+		// Deferred release: kept until the work recorded so far has completed.
+		void dispose(object resource, bool resident);
+		void collect();
+
+		const counters_t& counters() const { return m_counters; }
+
+	private:
+		struct pending_release
+		{
+			object resource;
+			u64 safe_after = 0;
+			bool resident = false;
+		};
+
+		object m_device;
+		object m_queue;
+		object m_event;
+		object m_residency;
+		object m_command_buffer;
+		object m_encoder;
+		encoder_kind m_kind = encoder_kind::none;
+		u64 m_render_pass_id = 0;
+		u64 m_last_submitted = 0;
+		bool m_residency_dirty = false;
+		std::deque<pending_release> m_releases;
+		counters_t m_counters{};
+	};
+}
