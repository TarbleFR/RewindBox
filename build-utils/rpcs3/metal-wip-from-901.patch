diff --git a/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp
new file mode 100644
index 0000000..4d918d2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "stdafx.h"
+#include "MTLCommonDecompiler.h"
+
+#include <array>
+#include <cctype>
+#include <cstdlib>
+#include <utility>
+
+namespace mtl
+{
+	// The same varying locations as the Vulkan decompilers (VKCommonDecompiler.cpp), so vertex and fragment
+	// programs translated separately still link by location.
+	static constexpr std::array<std::pair<std::string_view, int>, 17> varying_registers =
+	{ {
+		{ "tc0", 0 },
+		{ "tc1", 1 },
+		{ "tc2", 2 },
+		{ "tc3", 3 },
+		{ "tc4", 4 },
+		{ "tc5", 5 },
+		{ "tc6", 6 },
+		{ "tc7", 7 },
+		{ "tc8", 8 },
+		{ "tc9", 9 },
+		{ "diff_color", 10 },
+		{ "diff_color1", 11 },
+		{ "spec_color", 12 },
+		{ "spec_color1", 13 },
+		{ "fog_c", 14 },
+		{ "fogc", 14 },
+		{ "usr", 15 },
+	} };
+
+	int get_varying_register_location(std::string_view varying_register_name)
+	{
+		for (const auto& varying_register : varying_registers)
+		{
+			if (varying_register.first == varying_register_name)
+			{
+				return varying_register.second;
+			}
+		}
+
+		fmt::throw_exception("Unknown register name: %s", varying_register_name);
+	}
+
+	int get_texture_index(std::string_view name)
+	{
+		if (name.length() < 2)
+		{
+			fmt::throw_exception("Invalid texture name: '%s'", name);
+		}
+
+		constexpr int max_index_length = 2;
+		const int name_length = static_cast<int>(name.length());
+		std::string index;
+
+		for (int char_idx = name_length - max_index_length; char_idx < name_length; ++char_idx)
+		{
+			if (std::isdigit(static_cast<unsigned char>(name[char_idx])))
+			{
+				index += name[char_idx];
+			}
+		}
+
+		if (index.empty())
+		{
+			fmt::throw_exception("Invalid texture name: '%s'", name);
+		}
+
+		return std::atoi(index.c_str());
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h
new file mode 100644
index 0000000..96aa7e8
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): what the Metal decompilers declare for each translated RSX program.
+//
+// The Metal renderer reuses RPCS3's Vulkan-flavoured GLSL generation (the same text MoltenVK translates for
+// the Vulkan renderer today), compiles it to SPIR-V with glslang and translates the SPIR-V to MSL with
+// SPIRV-Cross. Nothing here depends on a Vulkan device or on Vulkan headers: the device facts the Vulkan
+// decompilers query are a capability record filled from the Metal device.
+
+#include "Emu/RSX/Program/GLSLTypes.h"
+#include "util/types.hpp"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace mtl
+{
+	namespace glsl
+	{
+		enum program_input_type : u32
+		{
+			input_type_uniform_buffer = 0,
+			input_type_texel_buffer,
+			input_type_texture,
+			input_type_storage_buffer,
+			input_type_push_constant,
+			input_type_attachment,
+
+			input_type_undefined = 0xffff'ffff
+		};
+
+		// Descriptor set numbers written in the generated GLSL ("set=0" vertex, "set=1" fragment).
+		enum binding_set_index : u32
+		{
+			binding_set_index_vertex = 0,
+			binding_set_index_fragment = 1,
+		};
+
+		struct program_input
+		{
+			::glsl::program_domain domain = ::glsl::glsl_invalid_program;
+			program_input_type type = input_type_undefined;
+			u32 set = 0;
+			u32 location = umax;
+			std::string name = "undefined";
+
+			// input_type_push_constant only: the byte range of the push constant block this stage declares.
+			u32 push_constant_offset = 0;
+			u32 push_constant_size = 0;
+
+			static program_input make(::glsl::program_domain domain, std::string name, program_input_type type, u32 set, u32 location)
+			{
+				program_input result{};
+				result.domain = domain;
+				result.type = type;
+				result.set = set;
+				result.location = location;
+				result.name = std::move(name);
+				return result;
+			}
+		};
+	}
+
+	// The device facts the RSX decompilers depend on, for the Metal device in use.
+	struct shader_device_caps
+	{
+		bool has_native_half_support = false;       // float16 arithmetic (Apple GPUs: yes; used only at low shader precision, as on Vulkan)
+		bool emulate_depth_compare = true;          // no D24S8: depth surfaces are D32F(+S8), shadow compares emulated as on MoltenVK
+		bool emulate_conditional_rendering = false; // conditional rendering resolved on the CPU, as on MoltenVK
+		bool allow_float64 = false;                 // Metal shading language has no double precision
+		bool low_precision_rounding = false;        // NVIDIA-only workaround
+	};
+
+	int get_varying_register_location(std::string_view varying_register_name);
+	int get_texture_index(std::string_view name);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLDataHeap.h b/rpcs3/Emu/RSX/Metal/MTLDataHeap.h
new file mode 100644
index 0000000..bb306e9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLDataHeap.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): ring buffers of the native Metal 4 renderer (vertex streams, draw parameters,
+// contexts, constants, indices, uploads). The same allocator as the Vulkan renderer (rsx::data_heap) over one
+// shared-storage MTLBuffer: unified memory, so the CPU writes where the GPU reads, with no map, copy or flush.
+//
+// Space is reclaimed per frame: the renderer records each heap's position when it submits a frame and moves the
+// heap's GET position there once the frame's fence has signalled. A heap that is full asks the renderer to make
+// room (on_exhausted: submit, then wait for the GPU); it never overwrites memory the GPU may still read.
+
+#include "Emu/RSX/Common/ring_buffer_helper.h"
+#include "MTLAPI.h"
+
+#include <functional>
+
+namespace mtl
+{
+	class data_heap : public rsx::data_heap
+	{
+	public:
+		object buffer;
+
+		// Called with the requested size when an allocation would reach memory in use by the GPU. Returns true
+		// once the whole heap is free again (the renderer submitted its work and waited for it).
+		std::function<bool(usz)> on_exhausted;
+
+		void create(const object& device, usz size, const char* name, usz guard = 0x10000)
+		{
+			init(size, name, guard);
+			buffer = new_buffer(device, size, storage_mode::shared);
+			m_host = static_cast<u8*>(buffer_contents(buffer));
+			ensure(m_host, "Metal ring buffer allocation failed");
+		}
+
+		void destroy()
+		{
+			buffer.reset();
+			m_host = nullptr;
+		}
+
+		template <typename T = void>
+		T* map(usz offset, usz /*size*/ = 0) const
+		{
+			return reinterpret_cast<T*>(m_host + offset);
+		}
+
+		// Kept for symmetry with vk::data_heap call sites: shared storage needs no unmap.
+		void unmap() const
+		{
+		}
+
+		// Everything allocated so far may be reused (the GPU has finished with all of it).
+		void release_all()
+		{
+			reset_allocation_stats();
+		}
+
+		usz put_position() const
+		{
+			return get_current_put_pos_minus_one();
+		}
+
+		bool valid() const
+		{
+			return !!buffer;
+		}
+
+	protected:
+		bool grow(usz size) override
+		{
+			// rsx::data_heap::alloc() keeps the PUT position it computed before calling grow(), so only GET moves:
+			// once the renderer has waited for the GPU, the whole ring is free from PUT onwards (wrapping to 0).
+			if (size < m_size && on_exhausted && on_exhausted(size))
+			{
+				reset_allocation_stats();
+				return true;
+			}
+
+			return false;
+		}
+
+	private:
+		u8* m_host = nullptr;
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFormats.cpp b/rpcs3/Emu/RSX/Metal/MTLFormats.cpp
new file mode 100644
index 0000000..5046762
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFormats.cpp
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2/M3): RSX surface formats -> Metal pixel formats (the MoltenVK mapping of the
+// Vulkan renderer's choices).
+
+#include "stdafx.h"
+#include "MTLFormats.h"
+
+namespace mtl
+{
+	surface_format get_compatible_surface_format(rsx::surface_color_format format)
+	{
+		constexpr component_map o_rgb{ swizzle::red, swizzle::green, swizzle::blue, swizzle::one };
+		constexpr component_map z_rgb{ swizzle::red, swizzle::green, swizzle::blue, swizzle::zero };
+
+		switch (format)
+		{
+		// VK_FORMAT_R5G6B5_UNORM_PACK16 / VK_FORMAT_A1R5G5B5_UNORM_PACK16 on Apple GPUs (MoltenVK: B5G6R5Unorm, BGR5A1Unorm).
+		case rsx::surface_color_format::r5g6b5:
+			return { pixel_format::b5g6r5_unorm, default_component_map };
+		case rsx::surface_color_format::x1r5g5b5_o1r5g5b5:
+			return { pixel_format::bgr5a1_unorm, o_rgb };
+		case rsx::surface_color_format::x1r5g5b5_z1r5g5b5:
+			return { pixel_format::bgr5a1_unorm, z_rgb };
+
+		case rsx::surface_color_format::a8r8g8b8:
+			return { pixel_format::bgra8_unorm, default_component_map };
+		case rsx::surface_color_format::a8b8g8r8:
+			return { pixel_format::rgba8_unorm, default_component_map };
+		case rsx::surface_color_format::x8b8g8r8_o8b8g8r8:
+			return { pixel_format::rgba8_unorm, o_rgb };
+		case rsx::surface_color_format::x8b8g8r8_z8b8g8r8:
+			return { pixel_format::rgba8_unorm, z_rgb };
+		case rsx::surface_color_format::x8r8g8b8_z8r8g8b8:
+			return { pixel_format::bgra8_unorm, z_rgb };
+		case rsx::surface_color_format::x8r8g8b8_o8r8g8b8:
+			return { pixel_format::bgra8_unorm, o_rgb };
+
+		case rsx::surface_color_format::w16z16y16x16:
+			return { pixel_format::rgba16_float, default_component_map };
+		case rsx::surface_color_format::w32z32y32x32:
+			return { pixel_format::rgba32_float, default_component_map };
+
+		case rsx::surface_color_format::b8:
+			return { pixel_format::r8_unorm, { swizzle::red, swizzle::red, swizzle::red, swizzle::one } };
+		case rsx::surface_color_format::g8b8:
+			return { pixel_format::rg8_unorm, { swizzle::red, swizzle::green, swizzle::red, swizzle::green } };
+		case rsx::surface_color_format::x32:
+			return { pixel_format::r32_float, { swizzle::red, swizzle::red, swizzle::red, swizzle::red } };
+		}
+
+		rsx_log.error("Surface color buffer: Unsupported surface color format (0x%x)", static_cast<u32>(format));
+		return { pixel_format::bgra8_unorm, default_component_map };
+	}
+
+	pixel_format get_compatible_depth_surface_format(rsx::surface_depth_format2 format)
+	{
+		switch (format)
+		{
+		case rsx::surface_depth_format2::z16_uint: return pixel_format::depth16_unorm;
+		case rsx::surface_depth_format2::z16_float: return pixel_format::depth32_float;
+		case rsx::surface_depth_format2::z24s8_uint: return pixel_format::depth32_float_stencil8;
+		case rsx::surface_depth_format2::z24s8_float: return pixel_format::depth32_float_stencil8;
+		}
+
+		fmt::throw_exception("Invalid format (0x%x)", static_cast<u32>(format));
+	}
+
+	bool is_depth_format(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::depth16_unorm:
+		case pixel_format::depth32_float:
+		case pixel_format::depth24_unorm_stencil8:
+		case pixel_format::depth32_float_stencil8:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	bool has_stencil(pixel_format format)
+	{
+		return format == pixel_format::depth24_unorm_stencil8 || format == pixel_format::depth32_float_stencil8 ||
+			format == pixel_format::stencil8 || format == pixel_format::x32_stencil8;
+	}
+
+	u32 get_texel_size(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::a8_unorm:
+		case pixel_format::r8_unorm:
+		case pixel_format::r8_snorm:
+		case pixel_format::r8_uint:
+		case pixel_format::stencil8:
+			return 1;
+		case pixel_format::r16_unorm:
+		case pixel_format::r16_snorm:
+		case pixel_format::r16_uint:
+		case pixel_format::r16_float:
+		case pixel_format::rg8_unorm:
+		case pixel_format::rg8_snorm:
+		case pixel_format::b5g6r5_unorm:
+		case pixel_format::a1bgr5_unorm:
+		case pixel_format::abgr4_unorm:
+		case pixel_format::bgr5a1_unorm:
+		case pixel_format::depth16_unorm:
+			return 2;
+		case pixel_format::r32_uint:
+		case pixel_format::r32_sint:
+		case pixel_format::r32_float:
+		case pixel_format::rg16_unorm:
+		case pixel_format::rg16_snorm:
+		case pixel_format::rg16_float:
+		case pixel_format::rgba8_unorm:
+		case pixel_format::rgba8_unorm_srgb:
+		case pixel_format::rgba8_snorm:
+		case pixel_format::rgba8_uint:
+		case pixel_format::bgra8_unorm:
+		case pixel_format::bgra8_unorm_srgb:
+		case pixel_format::rgb10a2_unorm:
+		case pixel_format::rg11b10_float:
+		case pixel_format::rgb9e5_float:
+		case pixel_format::bgr10a2_unorm:
+		case pixel_format::depth32_float:
+			return 4;
+		case pixel_format::rg32_uint:
+		case pixel_format::rg32_float:
+		case pixel_format::rgba16_unorm:
+		case pixel_format::rgba16_snorm:
+		case pixel_format::rgba16_uint:
+		case pixel_format::rgba16_float:
+			return 8;
+		case pixel_format::rgba32_uint:
+		case pixel_format::rgba32_float:
+			return 16;
+		default:
+			// Including depth32_float_stencil8: Metal copies its depth (4 bytes) and stencil (1 byte) planes separately.
+			return 0;
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFormats.h b/rpcs3/Emu/RSX/Metal/MTLFormats.h
new file mode 100644
index 0000000..01da0b9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFormats.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2/M3): RSX surface formats for the native Metal 4 renderer.
+// The Vulkan renderer's choices (VKGSRender.cpp get_compatible_surface_format, VKFormats.cpp
+// get_compatible_depth_surface_format) mapped through MoltenVK's Vulkan -> Metal pixel format table, so a surface
+// has the same layout, precision and channel mapping as on the MoltenVK path. iPhone GPUs have no D24S8: 24-bit
+// depth surfaces are Depth32Float_Stencil8 (as on MoltenVK), with exact conversions to guest memory.
+
+#include "MTLAPI.h"
+
+#include "Emu/RSX/gcm_enums.h"
+
+#include <array>
+
+namespace mtl
+{
+	// MTLTextureSwizzle
+	enum class swizzle : u8
+	{
+		zero = 0,
+		one = 1,
+		red = 2,
+		green = 3,
+		blue = 4,
+		alpha = 5,
+	};
+
+	using component_map = std::array<swizzle, 4>;
+	inline constexpr component_map default_component_map{ swizzle::red, swizzle::green, swizzle::blue, swizzle::alpha };
+
+	struct surface_format
+	{
+		pixel_format format;
+		component_map mapping;
+	};
+
+	surface_format get_compatible_surface_format(rsx::surface_color_format format);
+	pixel_format get_compatible_depth_surface_format(rsx::surface_depth_format2 format);
+
+	bool is_depth_format(pixel_format format);
+	bool has_stencil(pixel_format format);
+
+	// Bytes per texel of the uncompressed formats the renderer creates (0 for anything else).
+	u32 get_texel_size(pixel_format format);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.cpp b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.cpp
new file mode 100644
index 0000000..33b4594
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.cpp
@@ -0,0 +1,656 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2): RSX fragment program decompiler for the native Metal 4 renderer.
+// The generated GLSL follows VKFragmentProgram.cpp line for line; only the device queries differ.
+
+#include "stdafx.h"
+#include "MTLFragmentProgram.h"
+
+#include "Emu/RSX/Program/GLSLCommon.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+#include "Emu/system_config.h"
+
+std::string MTLFragmentDecompilerThread::getFloatTypeName(usz elementCount)
+{
+	return glsl::getFloatTypeNameImpl(elementCount);
+}
+
+std::string MTLFragmentDecompilerThread::getHalfTypeName(usz elementCount)
+{
+	return glsl::getHalfTypeNameImpl(elementCount);
+}
+
+std::string MTLFragmentDecompilerThread::getFunction(FUNCTION f)
+{
+	return glsl::getFunctionImpl(f);
+}
+
+std::string MTLFragmentDecompilerThread::compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1)
+{
+	return glsl::compareFunctionImpl(f, Op0, Op1);
+}
+
+void MTLFragmentDecompilerThread::prepareBindingTable()
+{
+	// First check if we have constants and textures as those need extra work
+	bool has_textures = false;
+	for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+	{
+		if (PT.type.starts_with("sampler"))
+		{
+			has_textures = true;
+			break;
+		}
+	}
+
+	unsigned location = 0; // All bindings must be set from this var
+	mtl_prog->binding_table.context_buffer_location = location++;
+	if (!properties.constant_offsets.empty())
+	{
+		mtl_prog->binding_table.cbuf_location = location++;
+	}
+
+	mtl_prog->binding_table.tex_param_location = location++;
+	mtl_prog->binding_table.polygon_stipple_params_location = location++;
+
+	std::memset(mtl_prog->binding_table.ftex_location, 0xff, sizeof(mtl_prog->binding_table.ftex_location));
+	std::memset(mtl_prog->binding_table.ftex_stencil_location, 0xff, sizeof(mtl_prog->binding_table.ftex_stencil_location));
+
+	if (has_textures) [[ likely ]]
+	{
+		for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+		{
+			if (!PT.type.starts_with("sampler"))
+			{
+				continue;
+			}
+
+			for (const ParamItem& PI : PT.items)
+			{
+				const auto texture_id = mtl::get_texture_index(PI.name);
+				const auto mask = 1u << texture_id;
+
+				// Allocate real binding
+				mtl_prog->binding_table.ftex_location[texture_id] = location++;
+
+				// Tag the stencil mirror if required
+				if (properties.redirected_sampler_mask & mask) [[ unlikely ]]
+				{
+					mtl_prog->binding_table.ftex_stencil_location[texture_id] = 0;
+				}
+			}
+
+			// Normalize stencil offsets
+			if (properties.redirected_sampler_mask != 0) [[ unlikely ]]
+			{
+				for (auto& stencil_location : mtl_prog->binding_table.ftex_stencil_location)
+				{
+					if (stencil_location != 0)
+					{
+						continue;
+					}
+
+					stencil_location = location++;
+				}
+			}
+		}
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE)
+	{
+		mtl_prog->binding_table.frag_depth_input_location = location++;
+	}
+
+	std::memset(mtl_prog->binding_table.frag_src_location, 0xff, sizeof(mtl_prog->binding_table.frag_src_location));
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		for (u32 i = 0; i < m_prog.mrt_buffers_count; ++i)
+		{
+			mtl_prog->binding_table.frag_src_location[i] = location++;
+		}
+	}
+}
+
+void MTLFragmentDecompilerThread::insertHeader(std::stringstream & OS)
+{
+	prepareBindingTable();
+
+	std::vector<const char*> required_extensions =
+	{
+		"GL_EXT_scalar_block_layout",
+		"GL_EXT_uniform_buffer_unsized_array"
+	};
+
+	if (device_props.has_native_half_support)
+	{
+		required_extensions.emplace_back("GL_EXT_shader_explicit_arithmetic_types_float16");
+	}
+
+	if (properties.multisampled_sampler_mask)
+	{
+		required_extensions.emplace_back("GL_ARB_shader_texture_image_samples");
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_ATTRIBUTE_INTERPOLATION)
+	{
+		required_extensions.emplace_back("GL_EXT_fragment_shader_barycentric");
+	}
+
+	OS << "#version 450\n";
+	for (const auto ext : required_extensions)
+	{
+		OS << "#extension " << ext << ": require\n";
+	}
+
+	OS << "#extension GL_ARB_separate_shader_objects: enable\n\n";
+
+	glsl::insert_subheader_block(OS);
+}
+
+void MTLFragmentDecompilerThread::insertInputs(std::stringstream & OS)
+{
+	glsl::insert_fragment_shader_inputs_block(
+		OS,
+		glsl::extension_flavour::EXT,
+		m_prog,
+		m_parr.params[PF_PARAM_IN],
+		{
+			.two_sided_color = !!(properties.in_register_mask & in_diff_color),
+			.two_sided_specular = !!(properties.in_register_mask & in_spec_color)
+		},
+		mtl::get_varying_register_location
+	);
+}
+
+void MTLFragmentDecompilerThread::insertOutputs(std::stringstream & OS)
+{
+	const std::pair<std::string, std::string> table[] =
+	{
+		{ "ocol0", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r0" : "h0" },
+		{ "ocol1", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r2" : "h4" },
+		{ "ocol2", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r3" : "h6" },
+		{ "ocol3", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r4" : "h8" },
+	};
+
+	// NOTE: We do not skip outputs, the only possible combinations are a(0), b(0), ab(0,1), abc(0,1,2), abcd(0,1,2,3)
+	u8 output_index = 0;
+	const bool float_type = (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS) || !device_props.has_native_half_support;
+	const auto reg_type = float_type ? "vec4" : getHalfTypeName(4);
+	for (uint i = 0; i < std::size(table); ++i)
+	{
+		if (!m_parr.HasParam(PF_PARAM_NONE, reg_type, table[i].second))
+		{
+			continue;
+		}
+
+		if (i >= m_prog.mrt_buffers_count)
+		{
+			// Dead writes. Declare as temp variables for DCE to clean up.
+			OS << "vec4 " << table[i].first << "; // Unused\n";
+			mtl_prog->output_color_masks[i] = 0;
+			continue;
+		}
+
+		OS << "layout(location=" << std::to_string(output_index++) << ") " << "out vec4 " << table[i].first << ";\n";
+		mtl_prog->output_color_masks[i] = -1;
+	}
+}
+
+void MTLFragmentDecompilerThread::insertConstants(std::stringstream & OS)
+{
+	// Fixed inputs from shader decompilation process
+	for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+	{
+		if (!PT.type.starts_with("sampler"))
+		{
+			continue;
+		}
+
+		for (const ParamItem& PI : PT.items)
+		{
+			std::string samplerType = PT.type;
+
+			const int index = mtl::get_texture_index(PI.name);
+			const auto mask = (1 << index);
+
+			if (properties.multisampled_sampler_mask & mask)
+			{
+				if (samplerType != "sampler1D" && samplerType != "sampler2D")
+				{
+					rsx_log.error("Unexpected multisampled image type '%s'", samplerType);
+				}
+
+				samplerType = "sampler2DMS";
+			}
+			else if (properties.shadow_sampler_mask & mask)
+			{
+				if (properties.common_access_sampler_mask & mask)
+				{
+					rsx_log.error("Texture unit %d is sampled as both a shadow texture and a depth texture", index);
+				}
+				else
+				{
+					samplerType += "Shadow";
+				}
+			}
+
+			const int id = mtl::get_texture_index(PI.name);
+			auto in = mtl::glsl::program_input::make(
+				glsl::glsl_fragment_program,
+				PI.name,
+				mtl::glsl::input_type_texture,
+				mtl::glsl::binding_set_index_fragment,
+				mtl_prog->binding_table.ftex_location[id]
+			);
+			inputs.push_back(in);
+
+			OS << "layout(set=1, binding=" << in.location << ") uniform " << samplerType << " " << PI.name << ";\n";
+
+			if (properties.redirected_sampler_mask & mask)
+			{
+				// Insert stencil mirror declaration
+				in.name += "_stencil";
+				in.location = mtl_prog->binding_table.ftex_stencil_location[id];
+				inputs.push_back(in);
+
+				OS << "layout(set=1, binding=" << in.location << ") uniform u" << samplerType << " " << in.name << ";\n";
+			}
+		}
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE)
+	{
+		const auto frag_depth_type = (m_prog.ctrl & RSX_SHADER_CONTROL_ROP_MULTISAMPLED)
+			? "sampler2DMS"
+			: "sampler2D";
+
+		OS << "layout(set=" << mtl::glsl::binding_set_index_fragment << ", binding=" << mtl_prog->binding_table.frag_depth_input_location << ") uniform " << frag_depth_type << " frag_depth;\n";
+
+		inputs.push_back(mtl::glsl::program_input::make(
+			glsl::glsl_fragment_program,
+			"frag_depth",
+			mtl::glsl::input_type_texture,
+			mtl::glsl::binding_set_index_fragment,
+			mtl_prog->binding_table.frag_depth_input_location
+		));
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		const std::string_view att_type = (m_prog.ctrl & RSX_SHADER_CONTROL_ROP_MULTISAMPLED)
+			? "subpassInputMS"sv
+			: "subpassInput"sv;
+
+		for (u32 i = 0; i < m_prog.mrt_buffers_count; ++i)
+		{
+			OS << "layout(input_attachment_index= " << i << ", set=" << mtl::glsl::binding_set_index_fragment << ", binding=" << mtl_prog->binding_table.frag_src_location[i] << ") uniform " << att_type << " frag_src_" << i << ";\n";
+
+			inputs.push_back(mtl::glsl::program_input::make(
+				glsl::glsl_fragment_program,
+				fmt::format("frag_src_%u", i),
+				mtl::glsl::input_type_attachment,
+				mtl::glsl::binding_set_index_fragment,
+				mtl_prog->binding_table.frag_src_location[i]
+			));
+		}
+	}
+
+	// Draw params are always provided by vertex program. Instead of pointer chasing, they're provided as varyings.
+	if (!(m_prog.ctrl & RSX_SHADER_CONTROL_INTERPRETER_MODEL))
+	{
+		OS <<
+			"layout(location=" << mtl::get_varying_register_location("usr") << ") in flat uvec4 draw_params_payload;\n\n";
+	}
+
+	OS <<
+		"#define _fs_constants_offset draw_params_payload.x\n"
+		"#define _fs_context_offset draw_params_payload.y\n"
+		"#define _fs_texture_base_index draw_params_payload.z\n"
+		"#define _fs_stipple_pattern_array_offset draw_params_payload.w\n\n";
+
+	if (!properties.constant_offsets.empty())
+	{
+		OS << "layout(std430, set=1, binding=" << mtl_prog->binding_table.cbuf_location << ") uniform FragmentConstantsBuffer\n";
+		OS << "{\n";
+		OS << "	vec4 fc[];\n";
+		OS << "};\n";
+		OS << "#define _fetch_constant(x) fc[x + _fs_constants_offset]\n\n";
+	}
+
+	OS <<
+		"layout(std430, set=1, binding=" << mtl_prog->binding_table.context_buffer_location << ") uniform FragmentStateBuffer\n"
+		"{\n"
+		"	fragment_context_t fs_contexts[];\n"
+		"};\n\n";
+
+	OS << "layout(std430, set=1, binding=" << mtl_prog->binding_table.tex_param_location << ") uniform TextureParametersBuffer\n";
+	OS << "{\n";
+	OS << "	sampler_info texture_parameters[];\n";
+	OS << "};\n\n";
+
+	OS << "layout(std430, set=1, binding=" << mtl_prog->binding_table.polygon_stipple_params_location << ") readonly buffer RasterizerHeap\n";
+	OS << "{\n";
+	OS << "	uvec4 stipple_pattern[];\n";
+	OS << "};\n\n";
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		OS <<
+			"layout(push_constant) uniform push_constants_block\n"
+			"{\n"
+			"	layout(offset = 4) uint blend_eqn;\n"
+			"	uint blend_sfactors;\n"
+			"	uint blend_dfactors;\n"
+			"	vec4 blend_constants;\n"
+			"};\n\n";
+
+		auto push_constants = mtl::glsl::program_input::make(glsl::glsl_fragment_program, "push_constants_block",
+			mtl::glsl::input_type_push_constant, mtl::glsl::binding_set_index_fragment, umax);
+		push_constants.push_constant_offset = 4;
+		push_constants.push_constant_size = 28;
+		inputs.push_back(std::move(push_constants));
+	}
+
+	if (!properties.constant_offsets.empty())
+	{
+		inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "FragmentConstantsBuffer",
+			mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.cbuf_location));
+	}
+
+	inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "FragmentStateBuffer",
+		mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.context_buffer_location));
+
+	inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "TextureParametersBuffer",
+		mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.tex_param_location));
+
+	inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "RasterizerHeap",
+		mtl::glsl::input_type_storage_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.polygon_stipple_params_location));
+}
+
+void MTLFragmentDecompilerThread::insertGlobalFunctions(std::stringstream &OS)
+{
+	m_shader_props.domain = glsl::glsl_fragment_program;
+	m_shader_props.require_lit_emulation = properties.has_lit_op;
+	m_shader_props.fp32_outputs = !!(m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS);
+	m_shader_props.require_depth_conversion = properties.redirected_sampler_mask != 0;
+	m_shader_props.require_wpos = !!(properties.in_register_mask & in_wpos);
+	m_shader_props.require_texture_ops = properties.has_tex_op;
+	m_shader_props.require_tex_shadow_ops = properties.shadow_sampler_mask != 0;
+	m_shader_props.require_msaa_ops = m_prog.texture_state.multisampled_textures != 0;
+	m_shader_props.require_texture_expand = properties.has_exp_tex_op;
+	m_shader_props.require_srgb_to_linear = properties.has_upg;
+	m_shader_props.require_linear_to_srgb = properties.has_pkg;
+	m_shader_props.require_fog_read = properties.in_register_mask & in_fogc;
+	m_shader_props.emulate_shadow_compare = device_props.emulate_depth_compare;
+
+	m_shader_props.low_precision_tests = device_props.has_low_precision_rounding && !(m_prog.ctrl & RSX_SHADER_CONTROL_ATTRIBUTE_INTERPOLATION);
+	// Vulkan: !vk::is_NVIDIA(vendor). Apple GPUs are not NVIDIA.
+	m_shader_props.disable_early_discard = !m_caps.low_precision_rounding;
+	m_shader_props.supports_native_fp16 = device_props.has_native_half_support;
+
+	m_shader_props.ROP_output_rounding = (g_cfg.video.shader_precision != gpu_preset_level::low) && !!(m_prog.ctrl & RSX_SHADER_CONTROL_8BIT_FRAMEBUFFER);
+	m_shader_props.ROP_sRGB_packing = !!(m_prog.ctrl & RSX_SHADER_CONTROL_SRGB_FRAMEBUFFER);
+	m_shader_props.ROP_alpha_test = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TEST);
+	m_shader_props.ROP_alpha_to_coverage_test = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TO_COVERAGE);
+	m_shader_props.ROP_alpha_to_one = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TO_ONE);
+	m_shader_props.ROP_polygon_stipple_test = !!(m_prog.ctrl & RSX_SHADER_CONTROL_POLYGON_STIPPLE);
+	m_shader_props.ROP_discard = !!(m_prog.ctrl & RSX_SHADER_CONTROL_USES_KIL);
+	m_shader_props.ROP_channel_remap = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ROP_OUTPUT_REMAP);
+	m_shader_props.ROP_programmable_blend = !!(m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING);
+
+	m_shader_props.require_tex1D_ops = properties.has_tex1D;
+	m_shader_props.require_tex2D_ops = properties.has_tex2D;
+	m_shader_props.require_tex3D_ops = properties.has_tex3D;
+	m_shader_props.require_shadowProj_ops = properties.shadow_sampler_mask != 0 && properties.has_texShadowProj;
+	m_shader_props.require_alpha_kill = !!(m_prog.ctrl & RSX_SHADER_CONTROL_TEXTURE_ALPHA_KILL);
+	m_shader_props.require_color_format_convert = !!(m_prog.ctrl & RSX_SHADER_CONTROL_TEXTURE_FORMAT_CONVERT);
+	m_shader_props.emulate_depth_compare = !!(m_prog.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE);
+	m_shader_props.ROP_output_multisampled = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ROP_MULTISAMPLED);
+
+	// Declare global constants
+	if (m_shader_props.require_fog_read)
+	{
+		OS <<
+			"#define fog_param0 fs_contexts[_fs_context_offset].fog_param0\n"
+			"#define fog_param1 fs_contexts[_fs_context_offset].fog_param1\n"
+			"#define fog_mode fs_contexts[_fs_context_offset].fog_mode\n\n";
+	}
+
+	if (m_shader_props.require_wpos)
+	{
+		OS <<
+			"#define wpos_scale fs_contexts[_fs_context_offset].wpos_scale\n"
+			"#define wpos_bias fs_contexts[_fs_context_offset].wpos_bias\n\n";
+	}
+
+	OS <<
+		"#define texture_base_index _fs_texture_base_index\n"
+		"#define TEX_PARAM(index) texture_parameters_##index\n\n";
+
+	glsl::insert_glsl_legacy_function(OS, m_shader_props);
+}
+
+void MTLFragmentDecompilerThread::insertMainStart(std::stringstream & OS)
+{
+	std::set<std::string> output_registers;
+	if (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS)
+	{
+		output_registers = { "r0", "r2", "r3", "r4" };
+	}
+	else
+	{
+		output_registers = { "h0", "h4", "h6", "h8" };
+	}
+
+	if (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_DEPTH_EXPORT)
+	{
+		output_registers.insert("r1");
+	}
+
+	std::string registers;
+	std::string reg_type;
+	const auto half4 = getHalfTypeName(4);
+	for (auto &reg_name : output_registers)
+	{
+		const auto type = (reg_name[0] == 'r' || !device_props.has_native_half_support)? "vec4" : half4;
+		if (reg_type == type) [[likely]]
+		{
+			registers += ", " + reg_name + " = " + type + "(0.)";
+		}
+		else
+		{
+			if (!registers.empty())
+				registers += ";\n";
+
+			registers += type + " " + reg_name + " = " + type + "(0.)";
+		}
+
+		reg_type = type;
+	}
+
+	if (!registers.empty())
+	{
+		OS << registers << ";\n";
+	}
+
+	OS << "void fs_main()\n";
+	OS << "{\n";
+
+	for (const ParamType& PT : m_parr.params[PF_PARAM_NONE])
+	{
+		for (const ParamItem& PI : PT.items)
+		{
+			if (output_registers.find(PI.name) != output_registers.end())
+				continue;
+
+			OS << "	" << PT.type << " " << PI.name;
+			if (!PI.value.empty())
+				OS << " = " << PI.value;
+
+			OS << ";\n";
+		}
+	}
+
+	if (properties.has_w_access)
+		OS << "	float in_w = (1. / gl_FragCoord.w);\n";
+
+	if (properties.in_register_mask & in_ssa)
+		OS << "	vec4 ssa = gl_FrontFacing ? vec4(1.) : vec4(-1.);\n";
+
+	if (properties.in_register_mask & in_wpos)
+		OS << "	vec4 wpos = get_wpos();\n";
+
+	if (properties.in_register_mask & in_fogc)
+		OS << "	vec4 fogc = fetch_fog_value(fog_mode);\n";
+
+	if (m_prog.two_sided_lighting)
+	{
+		if (properties.in_register_mask & in_diff_color)
+			OS << "	vec4 diff_color = gl_FrontFacing ? diff_color0 : diff_color1;\n";
+
+		if (properties.in_register_mask & in_spec_color)
+			OS << "	vec4 spec_color = gl_FrontFacing ? spec_color0 : spec_color1;\n";
+	}
+
+	for (u16 i = 0, mask = (properties.common_access_sampler_mask | properties.shadow_sampler_mask); mask != 0; ++i, mask >>= 1)
+	{
+		if (!(mask & 1))
+		{
+			continue;
+		}
+
+		OS << "	const sampler_info texture_parameters_" << i << " = texture_parameters[texture_base_index + " << i << "];\n";
+	}
+}
+
+void MTLFragmentDecompilerThread::insertMainEnd(std::stringstream & OS)
+{
+	OS << "}\n\n";
+
+	OS << "void main()\n";
+	OS << "{\n";
+
+	constexpr u32 ROP_control_access_options =
+		RSX_SHADER_CONTROL_ALPHA_TEST |
+		RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE |
+		RSX_SHADER_CONTROL_ROP_OUTPUT_REMAP |
+		RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING;
+
+	if (m_prog.ctrl & ROP_control_access_options)
+	{
+		OS << "	const uint rop_control = fs_contexts[_fs_context_offset].rop_control;\n";
+
+		if (m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TEST)
+		{
+			OS << "	const float alpha_ref = fs_contexts[_fs_context_offset].alpha_ref;\n";
+		}
+
+		OS << "\n";
+	}
+
+	::glsl::insert_rop_init(OS, m_prog.mrt_buffers_count);
+
+	OS << "\n" << "	fs_main();\n\n";
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_DISABLE_EARLY_Z)
+	{
+		// This is effectively unreachable code, but good enough to trick the GPU to skip early Z
+		// For vulkan, depth export has stronger semantics than discard.
+		OS <<
+			"	// Insert pseudo-barrier sequence to disable early-Z\n"
+			"	gl_FragDepth = gl_FragCoord.z;\n\n";
+	}
+
+	glsl::insert_rop(OS, m_shader_props);
+
+	if (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_DEPTH_EXPORT)
+	{
+		if (m_parr.HasParam(PF_PARAM_NONE, "vec4", "r1"))
+		{
+			// NOTE: Depth writes are always from a fp32 register. See issues section on nvidia's NV_fragment_program spec
+			// https://www.khronos.org/registry/OpenGL/extensions/NV/NV_fragment_program.txt
+
+			// NOTE: Depth writes in OpenGL (and by extension RSX) are clamped to 0,1 range.
+			// Indeed, hardware tests on realhw prove that even in depth float mode, values outside this range are clamped.
+			OS << "	gl_FragDepth = _saturate(r1.z);\n";
+		}
+		else
+		{
+			//Input not declared. Leave commented to assist in debugging the shader
+			OS << "	//gl_FragDepth = r1.z;\n";
+		}
+	}
+
+	OS << "}\n";
+}
+
+void MTLFragmentDecompilerThread::Task()
+{
+	m_shader = Decompile();
+	mtl_prog->inputs = std::move(inputs);
+}
+
+namespace mtl
+{
+	void fragment_program::Decompile(const RSXFragmentProgram& prog, const shader_device_caps& caps)
+	{
+		u32 size;
+		std::string source;
+		MTLFragmentDecompilerThread decompiler(source, prog, size, *this, caps);
+
+		// The same choices as VKFragmentProgram::Decompile for this device.
+		if (g_cfg.video.shader_precision == gpu_preset_level::low)
+		{
+			decompiler.device_props.has_native_half_support = caps.has_native_half_support;
+		}
+
+		decompiler.device_props.emulate_depth_compare = caps.emulate_depth_compare;
+		decompiler.device_props.has_low_precision_rounding = caps.low_precision_rounding;
+		decompiler.Task();
+
+		constant_offsets = std::move(decompiler.properties.constant_offsets);
+		glsl_source = std::move(source);
+		spirv.clear();
+
+		std::lock_guard lock(translation_lock);
+		variants.clear();
+	}
+
+	bool fragment_program::Compile()
+	{
+		if (g_cfg.video.log_programs)
+		{
+			fs::write_file(fs::get_cache_dir() + "shaderlog/MetalFragmentProgram" + std::to_string(id) + ".glsl", fs::rewrite, glsl_source);
+		}
+
+		spirv.clear();
+		std::string source = glsl_source;
+		if (!spirv::compile_glsl_to_spv(spirv, source, ::glsl::program_domain::glsl_fragment_program, ::glsl::glsl_rules_vulkan))
+		{
+			compile_error = "glslang refused the fragment program";
+			spirv.clear();
+			return false;
+		}
+
+		compile_error.clear();
+		return true;
+	}
+
+	fragment_program::variant& fragment_program::get_variant(const fragment_variant_key& key) const
+	{
+		auto [it, inserted] = variants.try_emplace(key);
+		if (inserted)
+		{
+			translation_options options{};
+			options.depth_attachment = key.depth_attachment;
+			options.stencil_attachment = key.stencil_attachment;
+			options.color_output_mask = key.color_output_mask;
+			it->second.msl = translate_spirv_to_msl(spirv, shader_stage::fragment, inputs, options);
+			if (!it->second.msl.ok)
+			{
+				rsx_log.error("Metal: fragment program %u was not translated to MSL: %s", id, it->second.msl.error);
+			}
+		}
+
+		return it->second;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.h b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.h
new file mode 100644
index 0000000..48010d9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.h
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): RSX fragment programs for the native Metal 4 renderer.
+// The decompiler emits the same Vulkan-flavoured GLSL as VKFragmentProgram.cpp, with the device facts taken
+// from mtl::shader_device_caps. Programmable blending inputs become framebuffer fetches in MSL.
+
+#include "Emu/RSX/Program/FragmentProgramDecompiler.h"
+#include "Emu/RSX/Program/GLSLTypes.h"
+#include "MTLAPI.h"
+#include "MTLCommonDecompiler.h"
+#include "MTLShaderTranslator.h"
+
+#include <array>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	class fragment_program;
+}
+
+class MTLFragmentDecompilerThread : public FragmentProgramDecompiler
+{
+	std::string& m_shader;
+	std::vector<mtl::glsl::program_input> inputs;
+	mtl::fragment_program* mtl_prog;
+	glsl::shader_properties m_shader_props{};
+	const mtl::shader_device_caps& m_caps;
+
+	void prepareBindingTable();
+
+public:
+	MTLFragmentDecompilerThread(std::string& shader, const RSXFragmentProgram& prog, u32& size, mtl::fragment_program& dst,
+		const mtl::shader_device_caps& caps)
+		: FragmentProgramDecompiler(prog, size)
+		, m_shader(shader)
+		, mtl_prog(&dst)
+		, m_caps(caps)
+	{
+	}
+
+	// FragmentProgramDecompiler::device_props is filled from the capability record before this runs.
+	void Task();
+
+protected:
+	std::string getFloatTypeName(usz elementCount) override;
+	std::string getHalfTypeName(usz elementCount) override;
+	std::string getFunction(FUNCTION f) override;
+	std::string compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1) override;
+
+	void insertHeader(std::stringstream& OS) override;
+	void insertInputs(std::stringstream& OS) override;
+	void insertOutputs(std::stringstream& OS) override;
+	void insertConstants(std::stringstream& OS) override;
+	void insertGlobalFunctions(std::stringstream& OS) override;
+	void insertMainStart(std::stringstream& OS) override;
+	void insertMainEnd(std::stringstream& OS) override;
+};
+
+namespace mtl
+{
+	// Fragment translations depend on the render pass the pipeline draws into.
+	struct fragment_variant_key
+	{
+		bool depth_attachment = true;
+		bool stencil_attachment = false;
+		u32 color_output_mask = 0xffffffffu;
+
+		auto operator<=>(const fragment_variant_key&) const = default;
+	};
+
+	class fragment_program
+	{
+	public:
+		ParamArray parr;
+		u32 id = 0;
+		std::vector<glsl::program_input> inputs;
+		std::vector<u32> constant_offsets;
+		std::array<u32, 4> output_color_masks{ {} };
+
+		std::string glsl_source;
+		std::vector<u32> spirv;
+		std::string compile_error;
+
+		// Translations by render-pass variant and the Metal libraries compiled from them, under the lock.
+		struct variant
+		{
+			translation_result msl;
+			object library;
+			std::string library_error;
+		};
+		mutable std::mutex translation_lock;
+		mutable std::map<fragment_variant_key, variant> variants;
+
+		struct
+		{
+			u32 context_buffer_location = umax;           // Rasterizer context
+			u32 cbuf_location = umax;                     // Constants register file
+			u32 tex_param_location = umax;                // Texture configuration data
+			u32 polygon_stipple_params_location = umax;   // Polygon stipple settings
+			u32 ftex_location[16];                        // Texture locations array
+			u32 ftex_stencil_location[16];                // Texture stencil mirror array
+			u32 frag_depth_input_location = umax;         // Fragment depth compare
+			u32 frag_src_location[4];                     // Fragment input attachment locations
+		} binding_table;
+
+		void Decompile(const RSXFragmentProgram& prog, const shader_device_caps& caps);
+
+		// GLSL -> SPIR-V (glslang). False with compile_error set when glslang refuses the source.
+		bool Compile();
+
+		// SPIR-V -> MSL for one variant, translated once and kept. Caller holds translation_lock.
+		variant& get_variant(const fragment_variant_key& key) const;
+		const translation_result& get_msl(const fragment_variant_key& key) const { return get_variant(key).msl; }
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp b/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp
new file mode 100644
index 0000000..f2c1d3d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): RSX fixed-function state -> Metal 4 pipeline, depth-stencil and encoder state.
+
+#include "stdafx.h"
+#include "MTLPipelineState.h"
+
+#include "Emu/RSX/Utils/color_utils.hpp"
+#include "Emu/RSX/Utils/rsx_utils.h"
+#include "Emu/RSX/rsx_methods.h"
+
+namespace mtl
+{
+	compare_function get_compare_function(rsx::comparison_function op)
+	{
+		switch (op)
+		{
+		case rsx::comparison_function::never: return compare_function::never;
+		case rsx::comparison_function::greater: return compare_function::greater;
+		case rsx::comparison_function::less: return compare_function::less;
+		case rsx::comparison_function::less_or_equal: return compare_function::less_equal;
+		case rsx::comparison_function::greater_or_equal: return compare_function::greater_equal;
+		case rsx::comparison_function::equal: return compare_function::equal;
+		case rsx::comparison_function::not_equal: return compare_function::not_equal;
+		case rsx::comparison_function::always: return compare_function::always;
+		}
+		fmt::throw_exception("Unknown compare op: 0x%x", static_cast<u32>(op));
+	}
+
+	stencil_operation get_stencil_operation(rsx::stencil_op op)
+	{
+		switch (op)
+		{
+		case rsx::stencil_op::keep: return stencil_operation::keep;
+		case rsx::stencil_op::zero: return stencil_operation::zero;
+		case rsx::stencil_op::replace: return stencil_operation::replace;
+		case rsx::stencil_op::incr: return stencil_operation::increment_clamp;
+		case rsx::stencil_op::decr: return stencil_operation::decrement_clamp;
+		case rsx::stencil_op::invert: return stencil_operation::invert;
+		case rsx::stencil_op::incr_wrap: return stencil_operation::increment_wrap;
+		case rsx::stencil_op::decr_wrap: return stencil_operation::decrement_wrap;
+		}
+		fmt::throw_exception("Unknown stencil op: 0x%x", static_cast<u32>(op));
+	}
+
+	blend_factor get_blend_factor(rsx::blend_factor factor)
+	{
+		switch (factor)
+		{
+		case rsx::blend_factor::one: return blend_factor::one;
+		case rsx::blend_factor::zero: return blend_factor::zero;
+		case rsx::blend_factor::src_alpha: return blend_factor::source_alpha;
+		case rsx::blend_factor::dst_alpha: return blend_factor::destination_alpha;
+		case rsx::blend_factor::src_color: return blend_factor::source_color;
+		case rsx::blend_factor::dst_color: return blend_factor::destination_color;
+		case rsx::blend_factor::constant_color: return blend_factor::blend_color;
+		case rsx::blend_factor::constant_alpha: return blend_factor::blend_alpha;
+		case rsx::blend_factor::one_minus_src_color: return blend_factor::one_minus_source_color;
+		case rsx::blend_factor::one_minus_dst_color: return blend_factor::one_minus_destination_color;
+		case rsx::blend_factor::one_minus_src_alpha: return blend_factor::one_minus_source_alpha;
+		case rsx::blend_factor::one_minus_dst_alpha: return blend_factor::one_minus_destination_alpha;
+		case rsx::blend_factor::one_minus_constant_alpha: return blend_factor::one_minus_blend_alpha;
+		case rsx::blend_factor::one_minus_constant_color: return blend_factor::one_minus_blend_color;
+		case rsx::blend_factor::src_alpha_saturate: return blend_factor::source_alpha_saturated;
+		}
+		fmt::throw_exception("Unknown blend factor 0x%x", static_cast<u32>(factor));
+	}
+
+	blend_operation get_blend_operation(rsx::blend_equation op)
+	{
+		// The signed equations have no host equivalent; the Vulkan renderer emulates them the same way.
+		switch (op)
+		{
+		case rsx::blend_equation::add_signed:
+			rsx_log.error("blend equation add_signed used. Emulating using FUNC_ADD");
+			[[fallthrough]];
+		case rsx::blend_equation::add: return blend_operation::add;
+		case rsx::blend_equation::reverse_add_signed:
+			rsx_log.error("blend equation reverse_add_signed used. Emulating using FUNC_ADD");
+			return blend_operation::add;
+		case rsx::blend_equation::subtract: return blend_operation::subtract;
+		case rsx::blend_equation::reverse_subtract_signed:
+			rsx_log.error("blend equation reverse_subtract_signed used. Emulating using FUNC_REVERSE_SUBTRACT");
+			[[fallthrough]];
+		case rsx::blend_equation::reverse_subtract: return blend_operation::reverse_subtract;
+		case rsx::blend_equation::min: return blend_operation::min;
+		case rsx::blend_equation::max: return blend_operation::max;
+		}
+		fmt::throw_exception("Unknown blend op: 0x%x", static_cast<u32>(op));
+	}
+
+	winding get_winding(rsx::front_face face)
+	{
+		switch (face)
+		{
+		case rsx::front_face::cw: return winding::clockwise;
+		case rsx::front_face::ccw: return winding::counter_clockwise;
+		}
+		fmt::throw_exception("Unknown front face value: 0x%x", static_cast<u32>(face));
+	}
+
+	native_primitive get_native_primitive(rsx::primitive_type primitive)
+	{
+		switch (primitive)
+		{
+		case rsx::primitive_type::points: return { primitive_type::point, false };
+		case rsx::primitive_type::lines: return { primitive_type::line, false };
+		case rsx::primitive_type::line_loop: return { primitive_type::line_strip, true };
+		case rsx::primitive_type::line_strip: return { primitive_type::line_strip, false };
+		case rsx::primitive_type::triangles: return { primitive_type::triangle, false };
+		case rsx::primitive_type::triangle_strip:
+		case rsx::primitive_type::quad_strip: return { primitive_type::triangle_strip, false };
+		case rsx::primitive_type::triangle_fan:
+		case rsx::primitive_type::quads:
+		case rsx::primitive_type::polygon: return { primitive_type::triangle, true };
+		}
+		fmt::throw_exception("Unsupported primitive topology 0x%x", static_cast<u8>(primitive));
+	}
+
+	topology_class get_topology_class(rsx::primitive_type primitive)
+	{
+		switch (get_native_primitive(primitive).type)
+		{
+		case primitive_type::point: return topology_class::point;
+		case primitive_type::line:
+		case primitive_type::line_strip: return topology_class::line;
+		default: return topology_class::triangle;
+		}
+	}
+
+	color_attachment_state color_blend_key::attachment_state() const
+	{
+		color_attachment_state state{};
+		state.format = static_cast<pixel_format>(format);
+		state.blending = !!blend;
+		state.source_rgb = static_cast<blend_factor>(source_rgb);
+		state.destination_rgb = static_cast<blend_factor>(destination_rgb);
+		state.rgb_operation = static_cast<blend_operation>(rgb_operation);
+		state.source_alpha = static_cast<blend_factor>(source_alpha);
+		state.destination_alpha = static_cast<blend_factor>(destination_alpha);
+		state.alpha_operation = static_cast<blend_operation>(alpha_operation);
+		state.write_mask = write_mask;
+		return state;
+	}
+
+	depth_stencil_descriptor depth_stencil_key::descriptor() const
+	{
+		depth_stencil_descriptor desc{};
+		desc.depth_compare = static_cast<compare_function>(depth_compare);
+		desc.depth_write = !!depth_write;
+		desc.stencil = !!stencil;
+		for (const auto& [src, dst] : { std::pair{ &front, &desc.front }, std::pair{ &back, &desc.back } })
+		{
+			dst->compare = static_cast<compare_function>(src->compare);
+			dst->stencil_fail = static_cast<stencil_operation>(src->stencil_fail);
+			dst->depth_fail = static_cast<stencil_operation>(src->depth_fail);
+			dst->depth_stencil_pass = static_cast<stencil_operation>(src->depth_stencil_pass);
+			dst->read_mask = src->read_mask;
+			dst->write_mask = src->write_mask;
+		}
+		return desc;
+	}
+
+	pipeline_props decode_pipeline_props(const rsx::rsx_state& regs, const attachment_layout& attachments,
+		rsx::primitive_type primitive, bool supports_hw_a2c, bool supports_hw_a2one, bool force_disable_blending)
+	{
+		pipeline_props props{};
+		props.color_count = attachments.color_count;
+		props.depth_attachment = attachments.depth ? 1 : 0;
+		props.stencil_attachment = attachments.stencil ? 1 : 0;
+		props.sample_count = attachments.samples;
+		props.topology = static_cast<u8>(get_topology_class(primitive));
+
+		const auto host_write_mask = rsx::get_write_output_mask(regs.surface_color());
+		for (u8 index = 0; index < attachments.color_count; ++index)
+		{
+			auto& color = props.color[index];
+			color.format = static_cast<u16>(attachments.color[index]);
+
+			bool color_mask_b = regs.color_mask_b(index);
+			bool color_mask_g = regs.color_mask_g(index);
+			bool color_mask_r = regs.color_mask_r(index);
+			bool color_mask_a = regs.color_mask_a(index);
+
+			switch (regs.surface_color())
+			{
+			case rsx::surface_color_format::b8:
+				rsx::get_b8_colormask(color_mask_r, color_mask_g, color_mask_b, color_mask_a);
+				break;
+			case rsx::surface_color_format::g8b8:
+				rsx::get_g8b8_r8g8_colormask(color_mask_r, color_mask_g, color_mask_b, color_mask_a);
+				break;
+			default:
+				break;
+			}
+
+			color.write_mask =
+				((color_mask_r && host_write_mask[0]) ? write_red : 0) |
+				((color_mask_g && host_write_mask[1]) ? write_green : 0) |
+				((color_mask_b && host_write_mask[2]) ? write_blue : 0) |
+				((color_mask_a && host_write_mask[3]) ? write_alpha : 0);
+		}
+
+		// LogicOp and Blend are mutually exclusive. If both are enabled, LogicOp takes precedence (Vulkan renderer).
+		if (regs.logic_op_enabled())
+		{
+			props.logic_op_requested = 1;
+		}
+		else if (!force_disable_blending)
+		{
+			if (const auto blend_enabled = regs.blend_enabled_mask())
+			{
+				const auto source_rgb = get_blend_factor(regs.blend_func_sfactor_rgb());
+				const auto source_alpha = get_blend_factor(regs.blend_func_sfactor_a());
+				const auto destination_rgb = get_blend_factor(regs.blend_func_dfactor_rgb());
+				const auto destination_alpha = get_blend_factor(regs.blend_func_dfactor_a());
+				const auto rgb_operation = get_blend_operation(regs.blend_equation_rgb());
+				const auto alpha_operation = get_blend_operation(regs.blend_equation_a());
+
+				for (u8 index = 0; index < attachments.color_count; ++index)
+				{
+					if (blend_enabled & (1u << index))
+					{
+						auto& color = props.color[index];
+						color.blend = 1;
+						color.source_rgb = static_cast<u8>(source_rgb);
+						color.destination_rgb = static_cast<u8>(destination_rgb);
+						color.rgb_operation = static_cast<u8>(rgb_operation);
+						color.source_alpha = static_cast<u8>(source_alpha);
+						color.destination_alpha = static_cast<u8>(destination_alpha);
+						color.alpha_operation = static_cast<u8>(alpha_operation);
+					}
+				}
+			}
+		}
+
+		// vk::graphics_pipeline_state::set_multisample_state: the enables follow the registers, not msaa_enabled().
+		// The RSX sample mask has no Metal pipeline equivalent (MSAA is stage M4).
+		if (supports_hw_a2c || attachments.samples > 1)
+		{
+			props.alpha_to_coverage = regs.msaa_alpha_to_coverage_enabled() ? 1 : 0;
+			props.alpha_to_one = (regs.msaa_alpha_to_one_enabled() && supports_hw_a2one) ? 1 : 0;
+		}
+
+		return props;
+	}
+
+	depth_stencil_key decode_depth_stencil(const rsx::rsx_state& regs, bool stencil_attachment)
+	{
+		depth_stencil_key key{};
+
+		if (regs.depth_test_enabled())
+		{
+			// Like stencil, depth write is meaningless without depth test
+			key.depth_write = regs.depth_write_enabled() ? 1 : 0;
+			key.depth_compare = static_cast<u8>(get_compare_function(regs.depth_func()));
+		}
+
+		if (stencil_attachment && regs.stencil_test_enabled())
+		{
+			const auto make_face = [](rsx::comparison_function compare, rsx::stencil_op fail, rsx::stencil_op zfail, rsx::stencil_op zpass, u8 read_mask, u8 write_mask)
+			{
+				depth_stencil_key::face face{};
+				face.compare = static_cast<u8>(get_compare_function(compare));
+				face.stencil_fail = static_cast<u8>(get_stencil_operation(fail));
+				face.depth_fail = static_cast<u8>(get_stencil_operation(zfail));
+				face.depth_stencil_pass = static_cast<u8>(get_stencil_operation(zpass));
+				face.read_mask = read_mask;
+				face.write_mask = write_mask;
+				return face;
+			};
+
+			key.stencil = 1;
+			key.front = make_face(regs.stencil_func(), regs.stencil_op_fail(), regs.stencil_op_zfail(), regs.stencil_op_zpass(),
+				regs.stencil_func_mask(), regs.stencil_mask());
+			key.back = regs.two_sided_stencil_test_enabled()
+				? make_face(regs.back_stencil_func(), regs.back_stencil_op_fail(), regs.back_stencil_op_zfail(), regs.back_stencil_op_zpass(),
+					regs.back_stencil_func_mask(), regs.back_stencil_mask())
+				: key.front;
+		}
+
+		return key;
+	}
+
+	raster_state decode_raster_state(const rsx::rsx_state& regs)
+	{
+		raster_state state{};
+		state.front = get_winding(regs.front_face_mode());
+
+		if (regs.cull_face_enabled())
+		{
+			switch (regs.cull_face_mode())
+			{
+			case rsx::cull_face::back: state.cull = cull_mode::back; break;
+			case rsx::cull_face::front: state.cull = cull_mode::front; break;
+			case rsx::cull_face::front_and_back: state.cull_both_faces = true; break;
+			}
+		}
+
+		state.depth_clip = (regs.depth_clamp_enabled() || !regs.depth_clip_enabled()) ? depth_clip_mode::clamp : depth_clip_mode::clip;
+
+		if (regs.poly_offset_fill_enabled())
+		{
+			// vkCmdSetDepthBias(constant = offset_bias, clamp = 0, slope = offset_scale), as MoltenVK forwards it.
+			state.depth_bias = regs.poly_offset_bias();
+			state.depth_bias_slope = regs.poly_offset_scale();
+		}
+
+		if (regs.stencil_test_enabled())
+		{
+			state.stencil_front_reference = regs.stencil_func_ref();
+			state.stencil_back_reference = regs.two_sided_stencil_test_enabled() ? regs.back_stencil_func_ref() : regs.stencil_func_ref();
+		}
+
+		if (regs.blend_enabled_mask())
+		{
+			state.blend_color = rsx::get_constant_blend_colors();
+		}
+
+		return state;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineState.h b/rpcs3/Emu/RSX/Metal/MTLPipelineState.h
new file mode 100644
index 0000000..a6cd4dc
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineState.h
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): RSX fixed-function state for the native Metal 4 renderer.
+//
+// The RSX registers are decoded exactly as the Vulkan renderer decodes them (VKGSRender.cpp decode_rsx_state,
+// VKDraw.cpp update_draw_state) and then converted the way MoltenVK converts the resulting Vulkan state:
+//   - pipeline_props: what a Metal render pipeline bakes in (attachment formats, blending, write masks, sample
+//     count, alpha-to-coverage/one, primitive class, the fragment variant's depth/stencil outputs);
+//   - depth_stencil_key: one MTLDepthStencilState (compare, write, stencil ops and masks; Metal has no dynamic
+//     stencil masks);
+//   - raster_state: per-draw encoder state (cull, winding, depth clip, depth bias, stencil references, blend colour).
+// Vulkan front faces map to the same Metal winding because the vertex shaders flip Y (MoltenVK's convention).
+// Features neither Metal nor the MoltenVK path on iPhone offer (logic ops, depth bounds before Apple10, wide lines)
+// behave as on that path and are counted by the renderer.
+
+#include "MTLAPI.h"
+
+#include "Emu/RSX/gcm_enums.h"
+
+#include <array>
+#include <type_traits>
+
+namespace rsx
+{
+	struct rsx_state;
+}
+
+namespace mtl
+{
+	// MTLPrimitiveTopologyClass
+	enum class topology_class : u8
+	{
+		unspecified = 0,
+		point = 1,
+		line = 2,
+		triangle = 3,
+	};
+
+	// The program cache hashes pipeline properties as raw bytes (rpcs3::hash_struct), so the keys hold only
+	// u8/u16 fields with no padding (checked below); enum values are stored as their Metal numbers.
+	struct color_blend_key
+	{
+		u16 format = 0;          // pixel_format
+		u8 write_mask = 0;       // color_write_mask bits
+		u8 blend = 0;
+		u8 source_rgb = static_cast<u8>(blend_factor::one);
+		u8 destination_rgb = static_cast<u8>(blend_factor::zero);
+		u8 rgb_operation = static_cast<u8>(blend_operation::add);
+		u8 source_alpha = static_cast<u8>(blend_factor::one);
+		u8 destination_alpha = static_cast<u8>(blend_factor::zero);
+		u8 alpha_operation = static_cast<u8>(blend_operation::add);
+
+		bool operator==(const color_blend_key&) const = default;
+		color_attachment_state attachment_state() const;
+	};
+
+	struct pipeline_props
+	{
+		std::array<color_blend_key, 4> color{};
+		u8 color_count = 0;
+		u8 depth_attachment = 0;
+		u8 stencil_attachment = 0;
+		u8 sample_count = 1;
+		u8 alpha_to_coverage = 0;
+		u8 alpha_to_one = 0;
+		u8 topology = static_cast<u8>(topology_class::triangle);
+		u8 logic_op_requested = 0;  // RSX logic op: not available (as with MoltenVK); blending stays off
+
+		bool operator==(const pipeline_props&) const = default;
+	};
+
+	static_assert(sizeof(color_blend_key) == 10 && sizeof(pipeline_props) == 48);
+	static_assert(std::has_unique_object_representations_v<pipeline_props>, "pipeline_props must have no padding");
+
+	struct depth_stencil_key
+	{
+		struct face
+		{
+			u8 compare = static_cast<u8>(compare_function::always);
+			u8 stencil_fail = static_cast<u8>(stencil_operation::keep);
+			u8 depth_fail = static_cast<u8>(stencil_operation::keep);
+			u8 depth_stencil_pass = static_cast<u8>(stencil_operation::keep);
+			u8 read_mask = 0xff;
+			u8 write_mask = 0xff;
+
+			bool operator==(const face&) const = default;
+		};
+
+		u8 depth_compare = static_cast<u8>(compare_function::always);
+		u8 depth_write = 0;
+		u8 stencil = 0;
+		u8 reserved = 0;
+		face front{};
+		face back{};
+
+		bool operator==(const depth_stencil_key&) const = default;
+		depth_stencil_descriptor descriptor() const;
+	};
+
+	static_assert(std::has_unique_object_representations_v<depth_stencil_key>, "depth_stencil_key must have no padding");
+
+	struct raster_state
+	{
+		cull_mode cull = cull_mode::none;
+		bool cull_both_faces = false;   // Vulkan FRONT_AND_BACK: triangles rasterize nothing (MoltenVK disables rasterization)
+		winding front = winding::counter_clockwise;
+		depth_clip_mode depth_clip = depth_clip_mode::clip;
+		f32 depth_bias = 0.f;
+		f32 depth_bias_slope = 0.f;
+		f32 depth_bias_clamp = 0.f;
+		u32 stencil_front_reference = 0;
+		u32 stencil_back_reference = 0;
+		std::array<f32, 4> blend_color{};
+	};
+
+	// Conversions (VK helper -> MoltenVK mapping).
+	compare_function get_compare_function(rsx::comparison_function op);
+	stencil_operation get_stencil_operation(rsx::stencil_op op);
+	blend_factor get_blend_factor(rsx::blend_factor factor);
+	blend_operation get_blend_operation(rsx::blend_equation op);
+	winding get_winding(rsx::front_face face);
+	topology_class get_topology_class(rsx::primitive_type primitive);
+
+	// Metal primitive for an RSX primitive, and whether an index buffer must emulate it (VKVertexBuffers.cpp,
+	// the __APPLE__ table: triangle fans, quads, polygons and line loops are emulated).
+	struct native_primitive
+	{
+		primitive_type type;
+		bool emulated;
+	};
+	native_primitive get_native_primitive(rsx::primitive_type primitive);
+
+	struct attachment_layout
+	{
+		std::array<pixel_format, 4> color{};
+		u8 color_count = 0;
+		bool depth = false;
+		bool stencil = false;
+		u8 samples = 1;
+	};
+
+	pipeline_props decode_pipeline_props(const rsx::rsx_state& regs, const attachment_layout& attachments,
+		rsx::primitive_type primitive, bool supports_hw_a2c, bool supports_hw_a2one, bool force_disable_blending);
+
+	depth_stencil_key decode_depth_stencil(const rsx::rsx_state& regs, bool stencil_attachment);
+
+	raster_state decode_raster_state(const rsx::rsx_state& regs);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp
new file mode 100644
index 0000000..77845a2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): program cache traits and pipeline builds of the native Metal 4 renderer.
+
+#include "stdafx.h"
+#include "MTLProgramBuffer.h"
+
+namespace mtl
+{
+	namespace
+	{
+		pipeline_environment g_environment{};
+		pipeline_counters g_counters{};
+
+		u32 find_slot(const std::vector<resource_slot>& slots, u32 location, u32 resource_slot::*member)
+		{
+			for (const auto& slot : slots)
+			{
+				if (slot.location == location && slot.type != glsl::input_type_push_constant)
+				{
+					return slot.*member;
+				}
+			}
+			return umax;
+		}
+	}
+
+	void set_pipeline_environment(const pipeline_environment& environment)
+	{
+		g_environment = environment;
+	}
+
+	const pipeline_environment& get_pipeline_environment()
+	{
+		return g_environment;
+	}
+
+	pipeline_counters& get_pipeline_counters()
+	{
+		return g_counters;
+	}
+
+	u32 program::vertex_buffer_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::buffer); }
+	u32 program::vertex_texture_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::texture); }
+	u32 program::vertex_sampler_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::sampler); }
+	u32 program::fragment_buffer_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::buffer); }
+	u32 program::fragment_texture_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::texture); }
+	u32 program::fragment_sampler_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::sampler); }
+
+	bool program::fragment_reads_push_constants() const
+	{
+		for (const auto& slot : fragment_slots)
+		{
+			if (slot.type == glsl::input_type_push_constant)
+			{
+				return slot.used;
+			}
+		}
+		return false;
+	}
+
+	void MTLTraits::recompile_fragment_program(const RSXFragmentProgram& RSXFP, fragment_program_type& fragmentProgramData, usz ID)
+	{
+		fragmentProgramData.Decompile(RSXFP, g_environment.caps);
+		fragmentProgramData.id = static_cast<u32>(ID);
+		g_counters.fragment_programs++;
+
+		if (!fragmentProgramData.Compile())
+		{
+			g_counters.glsl_failures++;
+			rsx_log.error("Metal: fragment program %u: %s", fragmentProgramData.id, fragmentProgramData.compile_error);
+		}
+	}
+
+	void MTLTraits::recompile_vertex_program(const RSXVertexProgram& RSXVP, vertex_program_type& vertexProgramData, usz ID)
+	{
+		vertexProgramData.Decompile(RSXVP, g_environment.caps);
+		vertexProgramData.id = static_cast<u32>(ID);
+		g_counters.vertex_programs++;
+
+		if (!vertexProgramData.Compile())
+		{
+			g_counters.glsl_failures++;
+			rsx_log.error("Metal: vertex program %u: %s", vertexProgramData.id, vertexProgramData.compile_error);
+		}
+	}
+
+	void MTLTraits::validate_pipeline_properties(const vertex_program_type&, const fragment_program_type& fp, pipeline_properties& properties)
+	{
+		// Explicitly disable writing to undefined registers (as VKTraits does with the colour write masks).
+		for (u32 index = 0; index < properties.color.size(); ++index)
+		{
+			if (!fp.output_color_masks[index])
+			{
+				properties.color[index].write_mask = 0;
+			}
+		}
+	}
+
+	MTLTraits::pipeline_type* MTLTraits::build_pipeline(
+		const vertex_program_type& vertexProgramData,
+		const fragment_program_type& fragmentProgramData,
+		const pipeline_properties& pipelineProperties,
+		bool /*compile_async*/,
+		std::function<pipeline_type*(pipeline_storage_type&)> callback)
+	{
+		auto result = std::make_unique<program>();
+		const auto& props = pipelineProperties;
+
+		object vertex_library;
+		object fragment_library;
+		std::string vertex_entry;
+		std::string fragment_entry;
+
+		// Vertex stage: one translation per primitive class, one library per translation.
+		{
+			const bool points = props.topology == static_cast<u8>(topology_class::point);
+			const u32 variant = points ? 1 : 0;
+
+			std::lock_guard lock(vertexProgramData.translation_lock);
+			if (vertexProgramData.spirv.empty())
+			{
+				result->error = fmt::format("vertex program %u has no SPIR-V (%s)", vertexProgramData.id, vertexProgramData.compile_error);
+			}
+			else if (const auto& msl = vertexProgramData.get_msl(points); !msl.ok)
+			{
+				g_counters.translation_failures++;
+				result->error = fmt::format("vertex program %u: %s", vertexProgramData.id, msl.error);
+			}
+			else
+			{
+				auto& library = vertexProgramData.library[variant];
+				auto& library_error = vertexProgramData.library_error[variant];
+				if (!library && library_error.empty())
+				{
+					library = compile_library(g_environment.compiler, msl.msl, { g_environment.fast_math, msl.position_invariant }, library_error);
+					if (!library)
+					{
+						g_counters.library_failures++;
+						rsx_log.error("Metal: vertex program %u does not compile: %s", vertexProgramData.id, library_error);
+					}
+				}
+
+				if (library)
+				{
+					vertex_library = library;
+					vertex_entry = msl.entry_point;
+					result->vertex_slots = msl.slots;
+				}
+				else
+				{
+					result->error = fmt::format("vertex program %u: %s", vertexProgramData.id, library_error);
+				}
+			}
+		}
+
+		// Fragment stage: one translation per render-pass variant.
+		if (result->error.empty())
+		{
+			fragment_variant_key key{};
+			key.depth_attachment = !!props.depth_attachment;
+			key.stencil_attachment = !!props.stencil_attachment;
+			// Only outputs with a colour attachment (MoltenVK's enable_frag_output_mask); alpha-to-coverage needs output 0.
+			key.color_output_mask = props.color_count ? ((1u << props.color_count) - 1) : (props.alpha_to_coverage ? 1u : 0u);
+
+			std::lock_guard lock(fragmentProgramData.translation_lock);
+			if (fragmentProgramData.spirv.empty())
+			{
+				result->error = fmt::format("fragment program %u has no SPIR-V (%s)", fragmentProgramData.id, fragmentProgramData.compile_error);
+			}
+			else if (auto& variant = fragmentProgramData.get_variant(key); !variant.msl.ok)
+			{
+				g_counters.translation_failures++;
+				result->error = fmt::format("fragment program %u: %s", fragmentProgramData.id, variant.msl.error);
+			}
+			else
+			{
+				if (!variant.library && variant.library_error.empty())
+				{
+					variant.library = compile_library(g_environment.compiler, variant.msl.msl, { g_environment.fast_math, false }, variant.library_error);
+					if (!variant.library)
+					{
+						g_counters.library_failures++;
+						rsx_log.error("Metal: fragment program %u does not compile: %s", fragmentProgramData.id, variant.library_error);
+					}
+				}
+
+				if (variant.library)
+				{
+					fragment_library = variant.library;
+					fragment_entry = variant.msl.entry_point;
+					result->fragment_slots = variant.msl.slots;
+				}
+				else
+				{
+					result->error = fmt::format("fragment program %u: %s", fragmentProgramData.id, variant.library_error);
+				}
+			}
+		}
+
+		if (result->error.empty())
+		{
+			render_pipeline_descriptor desc{};
+			desc.vertex_library = vertex_library;
+			desc.fragment_library = fragment_library;
+			desc.vertex_function = vertex_entry;
+			desc.fragment_function = fragment_entry;
+			for (u32 index = 0; index < props.color_count && index < props.color.size(); ++index)
+			{
+				desc.color[index] = props.color[index].attachment_state();
+			}
+			desc.sample_count = props.sample_count;
+			desc.alpha_to_coverage = !!props.alpha_to_coverage;
+			desc.alpha_to_one = !!props.alpha_to_one;
+			desc.input_topology = props.topology;
+			desc.label = fmt::format("RSX vp%u fp%u", vertexProgramData.id, fragmentProgramData.id);
+
+			std::string error;
+			result->pipeline = new_render_pipeline(g_environment.compiler, desc, error);
+			if (result->pipeline)
+			{
+				g_counters.pipelines++;
+			}
+			else
+			{
+				result->error = fmt::format("pipeline vp%u fp%u: %s", vertexProgramData.id, fragmentProgramData.id, error);
+			}
+		}
+
+		if (!result->error.empty())
+		{
+			g_counters.pipeline_failures++;
+			rsx_log.error("Metal: %s", result->error);
+		}
+
+		return callback(result);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h
new file mode 100644
index 0000000..449947b
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): the program cache of the native Metal 4 renderer.
+//
+// RPCS3's shared program_state_cache (the one the Vulkan and OpenGL renderers use) keys vertex and fragment
+// programs by their microcode and pipelines by (programs, pipeline_props). MTLTraits plugs the Metal stack in:
+// decompile + glslang on first sight of a program, SPIR-V -> MSL and MTL4 library compilation on first use of a
+// translation variant (both cached on the program), and one MTLRenderPipelineState per key. A program or pipeline
+// that fails is kept with its error (logged once) and its draws are skipped and counted by the renderer, exactly
+// as the Vulkan renderer skips draws whose program is not available.
+
+#include "Emu/RSX/Program/ProgramStateCache.h"
+#include "MTLAPI.h"
+#include "MTLFragmentProgram.h"
+#include "MTLPipelineState.h"
+#include "MTLShaderTranslator.h"
+#include "MTLVertexProgram.h"
+
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	// What a program cache build needs from the renderer; set once by MTLGSRender::on_init_thread.
+	struct pipeline_environment
+	{
+		object device;
+		object compiler;
+		shader_device_caps caps{};
+		bool fast_math = true;   // !g_cfg.video.disable_msl_fast_math, read when the renderer starts
+	};
+
+	void set_pipeline_environment(const pipeline_environment& environment);
+	const pipeline_environment& get_pipeline_environment();
+
+	struct pipeline_counters
+	{
+		std::atomic<u64> vertex_programs{0};
+		std::atomic<u64> fragment_programs{0};
+		std::atomic<u64> glsl_failures{0};
+		std::atomic<u64> translation_failures{0};
+		std::atomic<u64> library_failures{0};
+		std::atomic<u64> pipelines{0};
+		std::atomic<u64> pipeline_failures{0};
+	};
+
+	pipeline_counters& get_pipeline_counters();
+
+	// A linked program: the render pipeline state for one key, with both stages' argument-table slots.
+	class program
+	{
+	public:
+		object pipeline;
+		std::vector<resource_slot> vertex_slots;
+		std::vector<resource_slot> fragment_slots;
+		std::string error;
+
+		bool valid() const { return !!pipeline; }
+
+		// The Metal slot of a GLSL (set, binding) of each stage, or umax when the stage does not declare it.
+		u32 vertex_buffer_slot(u32 location) const;
+		u32 vertex_texture_slot(u32 location) const;
+		u32 vertex_sampler_slot(u32 location) const;
+		u32 fragment_buffer_slot(u32 location) const;
+		u32 fragment_texture_slot(u32 location) const;
+		u32 fragment_sampler_slot(u32 location) const;
+		bool fragment_reads_push_constants() const;
+	};
+
+	struct MTLTraits
+	{
+		using vertex_program_type = mtl::vertex_program;
+		using fragment_program_type = mtl::fragment_program;
+		using pipeline_type = mtl::program;
+		using pipeline_storage_type = std::unique_ptr<mtl::program>;
+		using pipeline_properties = mtl::pipeline_props;
+
+		static void recompile_fragment_program(const RSXFragmentProgram& RSXFP, fragment_program_type& fragmentProgramData, usz ID);
+		static void recompile_vertex_program(const RSXVertexProgram& RSXVP, vertex_program_type& vertexProgramData, usz ID);
+		static void validate_pipeline_properties(const vertex_program_type& vp, const fragment_program_type& fp, pipeline_properties& properties);
+		static pipeline_type* build_pipeline(
+			const vertex_program_type& vertexProgramData,
+			const fragment_program_type& fragmentProgramData,
+			const pipeline_properties& pipelineProperties,
+			bool compile_async,
+			std::function<pipeline_type*(pipeline_storage_type&)> callback);
+	};
+
+	struct program_cache : public program_state_cache<MTLTraits>
+	{
+		program_cache(decompiler_callback_t callback)
+		{
+			notify_pipeline_compiled = callback;
+		}
+
+		u64 get_hash(const mtl::pipeline_props& props)
+		{
+			return rpcs3::hash_struct<mtl::pipeline_props>(props);
+		}
+
+		u64 get_hash(const RSXVertexProgram& prog)
+		{
+			return program_hash_util::vertex_program_utils::get_vertex_program_ucode_hash(prog);
+		}
+
+		u64 get_hash(const RSXFragmentProgram& prog)
+		{
+			return program_hash_util::fragment_program_utils::get_fragment_program_ucode_hash(prog);
+		}
+
+		bool check_cache_missed() const
+		{
+			return m_cache_miss_flag;
+		}
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp
new file mode 100644
index 0000000..9c6968d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2): SPIR-V -> MSL translation for the native Metal 4 renderer.
+// Built with exceptions enabled (SPIRV-Cross reports errors by throwing); no exception crosses this file.
+
+#include "MTLShaderTranslator.h"
+
+#include "Utilities/StrFmt.h"
+
+#include "spirv_msl.hpp"
+
+#include <algorithm>
+#include <exception>
+#include <string_view>
+
+namespace mtl
+{
+	namespace
+	{
+		namespace spvc = SPIRV_CROSS_NAMESPACE;
+		namespace spvh = SPIRV_CROSS_SPV_HEADER_NAMESPACE;
+
+		bool ends_with(std::string_view value, std::string_view suffix)
+		{
+			return value.size() >= suffix.size() && value.substr(value.size() - suffix.size()) == suffix;
+		}
+
+		// The stencil view of a redirected depth-stencil texture: the Vulkan renderer samples it with a nearest,
+		// clamp-to-border (integer opaque black) sampler of its own (VKDraw.cpp, m_stencil_mirror_sampler).
+		spvc::MSLConstexprSampler stencil_mirror_sampler()
+		{
+			spvc::MSLConstexprSampler sampler{};
+			sampler.coord = spvc::MSL_SAMPLER_COORD_NORMALIZED;
+			sampler.min_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mag_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mip_filter = spvc::MSL_SAMPLER_MIP_FILTER_NEAREST;
+			sampler.s_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.t_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.r_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.border_color = spvc::MSL_SAMPLER_BORDER_COLOR_OPAQUE_BLACK;
+			sampler.lod_clamp_min = 0.f;
+			sampler.lod_clamp_max = 1.f;
+			sampler.lod_clamp_enable = true;
+			return sampler;
+		}
+
+		// The depth-compare input (frag_depth): the Vulkan renderer binds it with vk::null_sampler() (nearest, repeat).
+		spvc::MSLConstexprSampler depth_input_sampler()
+		{
+			spvc::MSLConstexprSampler sampler{};
+			sampler.coord = spvc::MSL_SAMPLER_COORD_NORMALIZED;
+			sampler.min_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mag_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mip_filter = spvc::MSL_SAMPLER_MIP_FILTER_NEAREST;
+			sampler.s_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			sampler.t_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			sampler.r_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			return sampler;
+		}
+
+		bool is_stencil_mirror(const resource_slot& slot)
+		{
+			return slot.type == glsl::input_type_texture && ends_with(slot.name, "_stencil");
+		}
+
+		bool is_depth_input(const resource_slot& slot)
+		{
+			return slot.type == glsl::input_type_texture && slot.name == "frag_depth";
+		}
+
+		spvh::ExecutionModel model_of(shader_stage stage)
+		{
+			return stage == shader_stage::vertex ? spvh::ExecutionModelVertex : spvh::ExecutionModelFragment;
+		}
+
+		u32 set_of(shader_stage stage)
+		{
+			return stage == shader_stage::vertex ? glsl::binding_set_index_vertex : glsl::binding_set_index_fragment;
+		}
+
+		std::string describe(const resource_slot& slot)
+		{
+			return fmt::format("'%s' (set %u, binding %u)", slot.name, slot.set, slot.location);
+		}
+	}
+
+	std::vector<resource_slot> assign_slots(shader_stage stage, const std::vector<glsl::program_input>& inputs, std::string& error)
+	{
+		std::vector<resource_slot> slots;
+		slots.reserve(inputs.size());
+
+		const u32 stage_set = set_of(stage);
+		bool push_constants_seen = false;
+
+		for (const auto& input : inputs)
+		{
+			resource_slot slot{};
+			slot.set = input.set;
+			slot.location = input.location;
+			slot.type = input.type;
+			slot.name = input.name;
+
+			if (input.set != stage_set)
+			{
+				error = fmt::format("input %s is not in this stage's set %u", describe(slot), stage_set);
+				return {};
+			}
+
+			switch (input.type)
+			{
+			case glsl::input_type_push_constant:
+				if (push_constants_seen)
+				{
+					error = "more than one push constant block in one stage";
+					return {};
+				}
+				push_constants_seen = true;
+				slot.buffer = push_constant_buffer_slot;
+				break;
+			case glsl::input_type_uniform_buffer:
+			case glsl::input_type_storage_buffer:
+				if (input.location >= push_constant_buffer_slot)
+				{
+					error = fmt::format("buffer %s exceeds the %u buffer slots below the push constants", describe(slot), push_constant_buffer_slot);
+					return {};
+				}
+				slot.buffer = input.location;
+				break;
+			case glsl::input_type_texel_buffer:
+				slot.texture = input.location;
+				break;
+			case glsl::input_type_texture:
+				slot.texture = input.location;
+				if (!is_stencil_mirror(slot) && !is_depth_input(slot))
+				{
+					const int unit = get_texture_index(input.name);
+					if (unit < 0 || static_cast<u32>(unit) >= max_sampler_slots)
+					{
+						error = fmt::format("texture %s has no sampler slot (unit %d)", describe(slot), unit);
+						return {};
+					}
+					slot.sampler = static_cast<u32>(unit);
+				}
+				break;
+			case glsl::input_type_attachment:
+				// Programmable blending: framebuffer fetch of the colour attachment, nothing to bind.
+				break;
+			default:
+				error = fmt::format("input %s has no Metal mapping (type %u)", describe(slot), static_cast<u32>(input.type));
+				return {};
+			}
+
+			if (slot.texture != umax && slot.texture >= max_texture_slots)
+			{
+				error = fmt::format("texture %s exceeds %u texture slots", describe(slot), max_texture_slots);
+				return {};
+			}
+
+			for (const auto& other : slots)
+			{
+				const bool same_buffer = slot.buffer != umax && slot.buffer == other.buffer;
+				const bool same_texture = slot.texture != umax && slot.texture == other.texture;
+				if (same_buffer || same_texture)
+				{
+					error = fmt::format("inputs %s and %s share a Metal slot", describe(other), describe(slot));
+					return {};
+				}
+			}
+
+			slots.push_back(std::move(slot));
+		}
+
+		return slots;
+	}
+
+	translation_result translate_spirv_to_msl(std::span<const u32> spirv, shader_stage stage,
+		const std::vector<glsl::program_input>& inputs, const translation_options& options)
+	{
+		translation_result result{};
+		result.slots = assign_slots(stage, inputs, result.error);
+		if (!result.error.empty())
+		{
+			return result;
+		}
+
+		if (spirv.empty())
+		{
+			result.error = "empty SPIR-V";
+			return result;
+		}
+
+		const spvh::ExecutionModel model = model_of(stage);
+
+		try
+		{
+			spvc::CompilerMSL compiler(spirv.data(), spirv.size());
+
+			// The options MoltenVK uses for these shaders (MVKPipeline.mm, SPIRVToMSLConverter.cpp), Apple GPU, iOS.
+			auto msl_options = compiler.get_msl_options();
+			msl_options.platform = spvc::CompilerMSL::Options::iOS;
+			msl_options.set_msl_version(options.msl_major, options.msl_minor);
+			msl_options.pad_fragment_output_components = true;
+			msl_options.texture_buffer_native = true;
+			msl_options.swizzle_texture_samples = false;     // swizzles are texture views (native swizzle)
+			msl_options.argument_buffers = false;            // discrete slots: Metal 4 argument tables
+			msl_options.agx_manual_cube_grad_fixup = true;   // Apple GPUs
+			msl_options.ios_support_base_vertex_instance = true;
+			msl_options.texture_1D_as_2D = true;
+			msl_options.enable_point_size_builtin = options.point_primitives;
+			msl_options.enable_point_size_default = options.point_primitives;
+			msl_options.default_point_size = 1.0f;
+			msl_options.enable_frag_depth_builtin = options.depth_attachment;
+			msl_options.enable_frag_stencil_ref_builtin = options.stencil_attachment;
+			msl_options.enable_frag_output_mask = options.color_output_mask;
+			msl_options.use_framebuffer_fetch_subpasses = true;
+			msl_options.replace_recursive_inputs = true;
+			msl_options.ios_use_simdgroup_functions = true;
+			msl_options.emulate_subgroups = false;
+			compiler.set_msl_options(msl_options);
+
+			auto common_options = compiler.get_common_options();
+			common_options.vertex.flip_vert_y = (stage == shader_stage::vertex) && options.flip_vertex_y;
+			common_options.vertex.fixup_clipspace = false;
+			compiler.set_common_options(common_options);
+
+			for (const auto& slot : result.slots)
+			{
+				if (slot.type == glsl::input_type_attachment)
+				{
+					continue;
+				}
+
+				spvc::MSLResourceBinding binding{};
+				binding.stage = model;
+				binding.count = 1;
+
+				if (slot.type == glsl::input_type_push_constant)
+				{
+					binding.desc_set = spvc::kPushConstDescSet;
+					binding.binding = spvc::kPushConstBinding;
+					result.uses_push_constants = true;
+				}
+				else
+				{
+					binding.desc_set = slot.set;
+					binding.binding = slot.location;
+				}
+
+				binding.msl_buffer = slot.buffer != umax ? slot.buffer : 0;
+				binding.msl_texture = slot.texture != umax ? slot.texture : 0;
+				binding.msl_sampler = slot.sampler != umax ? slot.sampler : 0;
+				compiler.add_msl_resource_binding(binding);
+
+				if (is_stencil_mirror(slot))
+				{
+					compiler.remap_constexpr_sampler_by_binding(slot.set, slot.location, stencil_mirror_sampler());
+				}
+				else if (is_depth_input(slot))
+				{
+					compiler.remap_constexpr_sampler_by_binding(slot.set, slot.location, depth_input_sampler());
+				}
+			}
+
+			// Every resource of the SPIR-V must have been listed by the decompiler.
+			const spvc::ShaderResources resources = compiler.get_shader_resources();
+			auto require_listed = [&](const spvc::SmallVector<spvc::Resource>& list, const char* kind)
+			{
+				for (const auto& resource : list)
+				{
+					const u32 set = compiler.get_decoration(resource.id, spvh::DecorationDescriptorSet);
+					const u32 location = compiler.get_decoration(resource.id, spvh::DecorationBinding);
+					const bool listed = std::any_of(result.slots.begin(), result.slots.end(), [&](const resource_slot& slot)
+					{
+						return slot.type != glsl::input_type_push_constant && slot.set == set && slot.location == location;
+					});
+
+					if (!listed)
+					{
+						result.error = fmt::format("%s '%s' (set %u, binding %u) was not listed by the decompiler", kind, resource.name, set, location);
+						return false;
+					}
+				}
+				return true;
+			};
+
+			if (!require_listed(resources.uniform_buffers, "uniform buffer") ||
+				!require_listed(resources.storage_buffers, "storage buffer") ||
+				!require_listed(resources.sampled_images, "sampled image") ||
+				!require_listed(resources.separate_images, "image") ||
+				!require_listed(resources.separate_samplers, "sampler") ||
+				!require_listed(resources.storage_images, "storage image") ||
+				!require_listed(resources.subpass_inputs, "subpass input"))
+			{
+				return result;
+			}
+
+			if (!resources.push_constant_buffers.empty() && !result.uses_push_constants)
+			{
+				result.error = "the shader declares push constants the decompiler did not list";
+				return result;
+			}
+
+			result.msl = compiler.compile();
+			result.entry_point = compiler.get_cleansed_entry_point_name("main", model);
+			result.position_invariant = compiler.is_position_invariant();
+
+			for (auto& slot : result.slots)
+			{
+				if (slot.type == glsl::input_type_attachment)
+				{
+					slot.used = true;
+					continue;
+				}
+
+				const u32 set = slot.type == glsl::input_type_push_constant ? spvc::kPushConstDescSet : slot.set;
+				const u32 location = slot.type == glsl::input_type_push_constant ? spvc::kPushConstBinding : slot.location;
+				slot.used = compiler.is_msl_resource_binding_used(model, set, location);
+			}
+
+			result.ok = true;
+		}
+		catch (const spvc::CompilerError& e)
+		{
+			result.error = fmt::format("SPIRV-Cross: %s", e.what());
+		}
+		catch (const std::exception& e)
+		{
+			result.error = fmt::format("SPIR-V to MSL: %s", e.what());
+		}
+
+		if (!result.ok)
+		{
+			result.msl.clear();
+		}
+
+		return result;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h
new file mode 100644
index 0000000..29a5898
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): SPIR-V -> Metal Shading Language for the native Metal 4 renderer.
+//
+// The SPIR-V comes from RPCS3's Vulkan-flavoured GLSL (Metal decompilers, glslang). SPIRV-Cross (vendored as
+// rbx_spirv_cross, so it never collides with the copy inside MoltenVK) translates it with the options MoltenVK
+// uses for the same shaders today, and every resource the shader declares gets an explicit slot in the Metal 4
+// argument table of its stage. A shader that declares a resource the decompiler did not list is refused rather
+// than given an automatic slot.
+//
+// Slot assignment (documented contract with the draw code):
+//   buffers  (uniform, storage)        -> buffer slot  = GLSL binding location
+//   textures (sampled, texel buffers)  -> texture slot = GLSL binding location
+//   texture samplers                   -> sampler slot = RSX texture unit (tex0..15, vtex0..3)
+//   stencil mirrors, depth-compare input -> samplers baked into the shader (same states as the Vulkan renderer)
+//   push constants (one block per stage) -> buffer slot push_constant_buffer_slot, same bytes for both stages
+//   programmable-blend inputs          -> framebuffer fetch of the colour attachment (no slot)
+
+#include "MTLCommonDecompiler.h"
+
+#include <span>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	enum class shader_stage : u8
+	{
+		vertex,
+		fragment,
+	};
+
+	constexpr u32 push_constant_buffer_slot = 30;
+	constexpr u32 max_buffer_slots = 31;
+	constexpr u32 max_texture_slots = 64;
+	constexpr u32 max_sampler_slots = 16;
+
+	struct resource_slot
+	{
+		u32 set = 0;
+		u32 location = umax;
+		glsl::program_input_type type = glsl::input_type_undefined;
+		std::string name;
+		u32 buffer = umax;
+		u32 texture = umax;
+		u32 sampler = umax;   // umax: no runtime sampler (none needed, or baked into the shader)
+		bool used = false;    // the translated shader reads it
+	};
+
+	struct translation_options
+	{
+		bool flip_vertex_y = true;          // Vulkan clip space (y down) -> Metal (y up), as MoltenVK does by default
+		bool point_primitives = false;      // vertex: the pipeline draws points, so [[point_size]] is written
+		bool depth_attachment = true;       // fragment: a depth attachment exists, so [[depth]] may be written
+		bool stencil_attachment = false;    // fragment: a stencil attachment exists
+		u32 color_output_mask = 0xffffffffu;
+		u32 msl_major = 3;
+		u32 msl_minor = 2;
+	};
+
+	struct translation_result
+	{
+		bool ok = false;
+		std::string msl;
+		std::string error;
+		std::string entry_point;
+		bool position_invariant = false;    // compile with preserveInvariance
+		bool uses_push_constants = false;
+		std::vector<resource_slot> slots;
+	};
+
+	// Slots for every input of one stage, before translation (pure; also used by the draw code to bind).
+	std::vector<resource_slot> assign_slots(shader_stage stage, const std::vector<glsl::program_input>& inputs, std::string& error);
+
+	translation_result translate_spirv_to_msl(std::span<const u32> spirv, shader_stage stage,
+		const std::vector<glsl::program_input>& inputs, const translation_options& options);
+}
