diff --git a/3rdparty/rewindbox-spirv-cross/CMakeLists.txt b/3rdparty/rewindbox-spirv-cross/CMakeLists.txt
new file mode 100644
index 0000000..53c34d1
--- /dev/null
+++ b/3rdparty/rewindbox-spirv-cross/CMakeLists.txt
@@ -0,0 +1,25 @@
+# REWINDBOX_METAL_NATIVE (M2): SPIRV-Cross (SPIR-V -> Metal Shading Language) for the native Metal 4 renderer.
+# SPIRV-Cross vulkan-sdk-1.4.350.1 (commit 1a6169566c73d3da552748fc372fe2bbb856e46e, Apache-2.0), files unchanged
+# (SOURCE.txt lists their SHA-256). Namespaced as rbx_spirv_cross / rbx_spv so it never collides with the copy
+# MoltenVK carries. SPIRV-Cross reports errors with exceptions: this library and its one caller
+# (rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp) are the only Metal sources built with -fexceptions.
+
+add_library(rewindbox_spirv_cross STATIC
+	spirv_cfg.cpp
+	spirv_cross.cpp
+	spirv_cross_parsed_ir.cpp
+	spirv_glsl.cpp
+	spirv_msl.cpp
+	spirv_parser.cpp
+)
+
+target_include_directories(rewindbox_spirv_cross SYSTEM PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
+target_compile_definitions(rewindbox_spirv_cross PUBLIC
+	SPIRV_CROSS_NAMESPACE_OVERRIDE=rbx_spirv_cross
+	SPIRV_CROSS_SPV_HEADER_NAMESPACE_OVERRIDE=rbx_spv
+)
+target_compile_options(rewindbox_spirv_cross PRIVATE -fexceptions -w)
+set_target_properties(rewindbox_spirv_cross PROPERTIES
+	CXX_STANDARD 20
+	CXX_STANDARD_REQUIRED ON
+)
