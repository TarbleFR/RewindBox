+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineState.cpp
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): RSX fixed-function state -> Metal 4 pipeline, depth-stencil and encoder state.
+
+#include "stdafx.h"
+#include "MTLPipelineState.h"
+
+#include "Emu/RSX/Utils/color_utils.hpp"
+#include "Emu/RSX/Utils/rsx_utils.h"
+#include "Emu/RSX/rsx_methods.h"
+
+namespace mtl
+{
+	compare_function get_compare_function(rsx::comparison_function op)
+	{
+		switch (op)
+		{
+		case rsx::comparison_function::never: return compare_function::never;
+		case rsx::comparison_function::greater: return compare_function::greater;
+		case rsx::comparison_function::less: return compare_function::less;
+		case rsx::comparison_function::less_or_equal: return compare_function::less_equal;
+		case rsx::comparison_function::greater_or_equal: return compare_function::greater_equal;
+		case rsx::comparison_function::equal: return compare_function::equal;
+		case rsx::comparison_function::not_equal: return compare_function::not_equal;
+		case rsx::comparison_function::always: return compare_function::always;
+		}
+		fmt::throw_exception("Unknown compare op: 0x%x", static_cast<u32>(op));
+	}
+
+	stencil_operation get_stencil_operation(rsx::stencil_op op)
+	{
+		switch (op)
+		{
+		case rsx::stencil_op::keep: return stencil_operation::keep;
+		case rsx::stencil_op::zero: return stencil_operation::zero;
+		case rsx::stencil_op::replace: return stencil_operation::replace;
+		case rsx::stencil_op::incr: return stencil_operation::increment_clamp;
+		case rsx::stencil_op::decr: return stencil_operation::decrement_clamp;
+		case rsx::stencil_op::invert: return stencil_operation::invert;
+		case rsx::stencil_op::incr_wrap: return stencil_operation::increment_wrap;
+		case rsx::stencil_op::decr_wrap: return stencil_operation::decrement_wrap;
+		}
+		fmt::throw_exception("Unknown stencil op: 0x%x", static_cast<u32>(op));
+	}
+
+	blend_factor get_blend_factor(rsx::blend_factor factor)
+	{
+		switch (factor)
+		{
+		case rsx::blend_factor::one: return blend_factor::one;
+		case rsx::blend_factor::zero: return blend_factor::zero;
+		case rsx::blend_factor::src_alpha: return blend_factor::source_alpha;
+		case rsx::blend_factor::dst_alpha: return blend_factor::destination_alpha;
+		case rsx::blend_factor::src_color: return blend_factor::source_color;
+		case rsx::blend_factor::dst_color: return blend_factor::destination_color;
+		case rsx::blend_factor::constant_color: return blend_factor::blend_color;
+		case rsx::blend_factor::constant_alpha: return blend_factor::blend_alpha;
+		case rsx::blend_factor::one_minus_src_color: return blend_factor::one_minus_source_color;
+		case rsx::blend_factor::one_minus_dst_color: return blend_factor::one_minus_destination_color;
+		case rsx::blend_factor::one_minus_src_alpha: return blend_factor::one_minus_source_alpha;
+		case rsx::blend_factor::one_minus_dst_alpha: return blend_factor::one_minus_destination_alpha;
+		case rsx::blend_factor::one_minus_constant_alpha: return blend_factor::one_minus_blend_alpha;
+		case rsx::blend_factor::one_minus_constant_color: return blend_factor::one_minus_blend_color;
+		case rsx::blend_factor::src_alpha_saturate: return blend_factor::source_alpha_saturated;
+		}
+		fmt::throw_exception("Unknown blend factor 0x%x", static_cast<u32>(factor));
+	}
+
+	blend_operation get_blend_operation(rsx::blend_equation op)
+	{
+		// The signed equations have no host equivalent; the Vulkan renderer emulates them the same way.
+		switch (op)
+		{
+		case rsx::blend_equation::add_signed:
+			rsx_log.error("blend equation add_signed used. Emulating using FUNC_ADD");
+			[[fallthrough]];
+		case rsx::blend_equation::add: return blend_operation::add;
+		case rsx::blend_equation::reverse_add_signed:
+			rsx_log.error("blend equation reverse_add_signed used. Emulating using FUNC_ADD");
+			return blend_operation::add;
+		case rsx::blend_equation::subtract: return blend_operation::subtract;
+		case rsx::blend_equation::reverse_subtract_signed:
+			rsx_log.error("blend equation reverse_subtract_signed used. Emulating using FUNC_REVERSE_SUBTRACT");
+			[[fallthrough]];
+		case rsx::blend_equation::reverse_subtract: return blend_operation::reverse_subtract;
+		case rsx::blend_equation::min: return blend_operation::min;
+		case rsx::blend_equation::max: return blend_operation::max;
+		}
+		fmt::throw_exception("Unknown blend op: 0x%x", static_cast<u32>(op));
+	}
+
+	winding get_winding(rsx::front_face face)
+	{
+		switch (face)
+		{
+		case rsx::front_face::cw: return winding::clockwise;
+		case rsx::front_face::ccw: return winding::counter_clockwise;
+		}
+		fmt::throw_exception("Unknown front face value: 0x%x", static_cast<u32>(face));
+	}
+
+	native_primitive get_native_primitive(rsx::primitive_type primitive)
+	{
+		switch (primitive)
+		{
+		case rsx::primitive_type::points: return { primitive_type::point, false };
+		case rsx::primitive_type::lines: return { primitive_type::line, false };
+		case rsx::primitive_type::line_loop: return { primitive_type::line_strip, true };
+		case rsx::primitive_type::line_strip: return { primitive_type::line_strip, false };
+		case rsx::primitive_type::triangles: return { primitive_type::triangle, false };
+		case rsx::primitive_type::triangle_strip:
+		case rsx::primitive_type::quad_strip: return { primitive_type::triangle_strip, false };
+		case rsx::primitive_type::triangle_fan:
+		case rsx::primitive_type::quads:
+		case rsx::primitive_type::polygon: return { primitive_type::triangle, true };
+		}
+		fmt::throw_exception("Unsupported primitive topology 0x%x", static_cast<u8>(primitive));
+	}
+
+	topology_class get_topology_class(rsx::primitive_type primitive)
+	{
+		switch (get_native_primitive(primitive).type)
+		{
+		case primitive_type::point: return topology_class::point;
+		case primitive_type::line:
+		case primitive_type::line_strip: return topology_class::line;
+		default: return topology_class::triangle;
+		}
+	}
+
+	color_attachment_state color_blend_key::attachment_state() const
+	{
+		color_attachment_state state{};
+		state.format = static_cast<pixel_format>(format);
+		state.blending = !!blend;
+		state.source_rgb = static_cast<blend_factor>(source_rgb);
+		state.destination_rgb = static_cast<blend_factor>(destination_rgb);
+		state.rgb_operation = static_cast<blend_operation>(rgb_operation);
+		state.source_alpha = static_cast<blend_factor>(source_alpha);
+		state.destination_alpha = static_cast<blend_factor>(destination_alpha);
+		state.alpha_operation = static_cast<blend_operation>(alpha_operation);
+		state.write_mask = write_mask;
+		return state;
+	}
+
+	depth_stencil_descriptor depth_stencil_key::descriptor() const
+	{
+		depth_stencil_descriptor desc{};
+		desc.depth_compare = static_cast<compare_function>(depth_compare);
+		desc.depth_write = !!depth_write;
+		desc.stencil = !!stencil;
+		for (const auto& [src, dst] : { std::pair{ &front, &desc.front }, std::pair{ &back, &desc.back } })
+		{
+			dst->compare = static_cast<compare_function>(src->compare);
+			dst->stencil_fail = static_cast<stencil_operation>(src->stencil_fail);
+			dst->depth_fail = static_cast<stencil_operation>(src->depth_fail);
+			dst->depth_stencil_pass = static_cast<stencil_operation>(src->depth_stencil_pass);
+			dst->read_mask = src->read_mask;
+			dst->write_mask = src->write_mask;
+		}
+		return desc;
+	}
+
+	pipeline_props decode_pipeline_props(const rsx::rsx_state& regs, const attachment_layout& attachments,
+		rsx::primitive_type primitive, bool supports_hw_a2c, bool supports_hw_a2one, bool force_disable_blending)
+	{
+		pipeline_props props{};
+		props.color_count = attachments.color_count;
+		props.depth_attachment = attachments.depth ? 1 : 0;
+		props.stencil_attachment = attachments.stencil ? 1 : 0;
+		props.sample_count = attachments.samples;
+		props.topology = static_cast<u8>(get_topology_class(primitive));
+
+		const auto host_write_mask = rsx::get_write_output_mask(regs.surface_color());
+		for (u8 index = 0; index < attachments.color_count; ++index)
+		{
+			auto& color = props.color[index];
+			color.format = static_cast<u16>(attachments.color[index]);
+
+			bool color_mask_b = regs.color_mask_b(index);
+			bool color_mask_g = regs.color_mask_g(index);
+			bool color_mask_r = regs.color_mask_r(index);
+			bool color_mask_a = regs.color_mask_a(index);
+
+			switch (regs.surface_color())
+			{
+			case rsx::surface_color_format::b8:
+				rsx::get_b8_colormask(color_mask_r, color_mask_g, color_mask_b, color_mask_a);
+				break;
+			case rsx::surface_color_format::g8b8:
+				rsx::get_g8b8_r8g8_colormask(color_mask_r, color_mask_g, color_mask_b, color_mask_a);
+				break;
+			default:
+				break;
+			}
+
+			color.write_mask =
+				((color_mask_r && host_write_mask[0]) ? write_red : 0) |
+				((color_mask_g && host_write_mask[1]) ? write_green : 0) |
+				((color_mask_b && host_write_mask[2]) ? write_blue : 0) |
+				((color_mask_a && host_write_mask[3]) ? write_alpha : 0);
+		}
+
+		// LogicOp and Blend are mutually exclusive. If both are enabled, LogicOp takes precedence (Vulkan renderer).
+		if (regs.logic_op_enabled())
+		{
+			props.logic_op_requested = 1;
+		}
+		else if (!force_disable_blending)
+		{
+			if (const auto blend_enabled = regs.blend_enabled_mask())
+			{
+				const auto source_rgb = get_blend_factor(regs.blend_func_sfactor_rgb());
+				const auto source_alpha = get_blend_factor(regs.blend_func_sfactor_a());
+				const auto destination_rgb = get_blend_factor(regs.blend_func_dfactor_rgb());
+				const auto destination_alpha = get_blend_factor(regs.blend_func_dfactor_a());
+				const auto rgb_operation = get_blend_operation(regs.blend_equation_rgb());
+				const auto alpha_operation = get_blend_operation(regs.blend_equation_a());
+
+				for (u8 index = 0; index < attachments.color_count; ++index)
+				{
+					if (blend_enabled & (1u << index))
+					{
+						auto& color = props.color[index];
+						color.blend = 1;
+						color.source_rgb = static_cast<u8>(source_rgb);
+						color.destination_rgb = static_cast<u8>(destination_rgb);
+						color.rgb_operation = static_cast<u8>(rgb_operation);
+						color.source_alpha = static_cast<u8>(source_alpha);
+						color.destination_alpha = static_cast<u8>(destination_alpha);
+						color.alpha_operation = static_cast<u8>(alpha_operation);
+					}
+				}
+			}
+		}
+
+		// vk::graphics_pipeline_state::set_multisample_state: the enables follow the registers, not msaa_enabled().
+		// The RSX sample mask has no Metal pipeline equivalent (MSAA is stage M4).
+		if (supports_hw_a2c || attachments.samples > 1)
+		{
+			props.alpha_to_coverage = regs.msaa_alpha_to_coverage_enabled() ? 1 : 0;
+			props.alpha_to_one = (regs.msaa_alpha_to_one_enabled() && supports_hw_a2one) ? 1 : 0;
+		}
+
+		return props;
+	}
+
+	depth_stencil_key decode_depth_stencil(const rsx::rsx_state& regs, bool stencil_attachment)
+	{
+		depth_stencil_key key{};
+
+		if (regs.depth_test_enabled())
+		{
+			// Like stencil, depth write is meaningless without depth test
+			key.depth_write = regs.depth_write_enabled() ? 1 : 0;
+			key.depth_compare = static_cast<u8>(get_compare_function(regs.depth_func()));
+		}
+
+		if (stencil_attachment && regs.stencil_test_enabled())
+		{
+			const auto make_face = [](rsx::comparison_function compare, rsx::stencil_op fail, rsx::stencil_op zfail, rsx::stencil_op zpass, u8 read_mask, u8 write_mask)
+			{
+				depth_stencil_key::face face{};
+				face.compare = static_cast<u8>(get_compare_function(compare));
+				face.stencil_fail = static_cast<u8>(get_stencil_operation(fail));
+				face.depth_fail = static_cast<u8>(get_stencil_operation(zfail));
+				face.depth_stencil_pass = static_cast<u8>(get_stencil_operation(zpass));
+				face.read_mask = read_mask;
+				face.write_mask = write_mask;
+				return face;
+			};
+
+			key.stencil = 1;
+			key.front = make_face(regs.stencil_func(), regs.stencil_op_fail(), regs.stencil_op_zfail(), regs.stencil_op_zpass(),
+				regs.stencil_func_mask(), regs.stencil_mask());
+			key.back = regs.two_sided_stencil_test_enabled()
+				? make_face(regs.back_stencil_func(), regs.back_stencil_op_fail(), regs.back_stencil_op_zfail(), regs.back_stencil_op_zpass(),
+					regs.back_stencil_func_mask(), regs.back_stencil_mask())
+				: key.front;
+		}
+
+		return key;
+	}
+
+	raster_state decode_raster_state(const rsx::rsx_state& regs)
+	{
+		raster_state state{};
+		state.front = get_winding(regs.front_face_mode());
+
+		if (regs.cull_face_enabled())
+		{
+			switch (regs.cull_face_mode())
+			{
+			case rsx::cull_face::back: state.cull = cull_mode::back; break;
+			case rsx::cull_face::front: state.cull = cull_mode::front; break;
+			case rsx::cull_face::front_and_back: state.cull_both_faces = true; break;
+			}
+		}
+
+		state.depth_clip = (regs.depth_clamp_enabled() || !regs.depth_clip_enabled()) ? depth_clip_mode::clamp : depth_clip_mode::clip;
+
+		if (regs.poly_offset_fill_enabled())
+		{
+			// vkCmdSetDepthBias(constant = offset_bias, clamp = 0, slope = offset_scale), as MoltenVK forwards it.
+			state.depth_bias = regs.poly_offset_bias();
+			state.depth_bias_slope = regs.poly_offset_scale();
+		}
+
+		if (regs.stencil_test_enabled())
+		{
+			state.stencil_front_reference = regs.stencil_func_ref();
+			state.stencil_back_reference = regs.two_sided_stencil_test_enabled() ? regs.back_stencil_func_ref() : regs.stencil_func_ref();
+		}
+
+		if (regs.blend_enabled_mask())
+		{
+			state.blend_color = rsx::get_constant_blend_colors();
+		}
+
+		return state;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineState.h b/rpcs3/Emu/RSX/Metal/MTLPipelineState.h
new file mode 100644
index 0000000..a6cd4dc
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineState.h
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): RSX fixed-function state for the native Metal 4 renderer.
+//
+// The RSX registers are decoded exactly as the Vulkan renderer decodes them (VKGSRender.cpp decode_rsx_state,
+// VKDraw.cpp update_draw_state) and then converted the way MoltenVK converts the resulting Vulkan state:
+//   - pipeline_props: what a Metal render pipeline bakes in (attachment formats, blending, write masks, sample
+//     count, alpha-to-coverage/one, primitive class, the fragment variant's depth/stencil outputs);
+//   - depth_stencil_key: one MTLDepthStencilState (compare, write, stencil ops and masks; Metal has no dynamic
+//     stencil masks);
+//   - raster_state: per-draw encoder state (cull, winding, depth clip, depth bias, stencil references, blend colour).
+// Vulkan front faces map to the same Metal winding because the vertex shaders flip Y (MoltenVK's convention).
+// Features neither Metal nor the MoltenVK path on iPhone offer (logic ops, depth bounds before Apple10, wide lines)
+// behave as on that path and are counted by the renderer.
+
+#include "MTLAPI.h"
+
+#include "Emu/RSX/gcm_enums.h"
+
+#include <array>
+#include <type_traits>
+
+namespace rsx
+{
+	struct rsx_state;
+}
+
+namespace mtl
+{
+	// MTLPrimitiveTopologyClass
+	enum class topology_class : u8
+	{
+		unspecified = 0,
+		point = 1,
+		line = 2,
+		triangle = 3,
+	};
+
+	// The program cache hashes pipeline properties as raw bytes (rpcs3::hash_struct), so the keys hold only
+	// u8/u16 fields with no padding (checked below); enum values are stored as their Metal numbers.
+	struct color_blend_key
+	{
+		u16 format = 0;          // pixel_format
+		u8 write_mask = 0;       // color_write_mask bits
+		u8 blend = 0;
+		u8 source_rgb = static_cast<u8>(blend_factor::one);
+		u8 destination_rgb = static_cast<u8>(blend_factor::zero);
+		u8 rgb_operation = static_cast<u8>(blend_operation::add);
+		u8 source_alpha = static_cast<u8>(blend_factor::one);
+		u8 destination_alpha = static_cast<u8>(blend_factor::zero);
+		u8 alpha_operation = static_cast<u8>(blend_operation::add);
+
+		bool operator==(const color_blend_key&) const = default;
+		color_attachment_state attachment_state() const;
+	};
+
+	struct pipeline_props
+	{
+		std::array<color_blend_key, 4> color{};
+		u8 color_count = 0;
+		u8 depth_attachment = 0;
+		u8 stencil_attachment = 0;
+		u8 sample_count = 1;
+		u8 alpha_to_coverage = 0;
+		u8 alpha_to_one = 0;
+		u8 topology = static_cast<u8>(topology_class::triangle);
+		u8 logic_op_requested = 0;  // RSX logic op: not available (as with MoltenVK); blending stays off
+
+		bool operator==(const pipeline_props&) const = default;
+	};
+
+	static_assert(sizeof(color_blend_key) == 10 && sizeof(pipeline_props) == 48);
+	static_assert(std::has_unique_object_representations_v<pipeline_props>, "pipeline_props must have no padding");
+
+	struct depth_stencil_key
+	{
+		struct face
+		{
+			u8 compare = static_cast<u8>(compare_function::always);
+			u8 stencil_fail = static_cast<u8>(stencil_operation::keep);
+			u8 depth_fail = static_cast<u8>(stencil_operation::keep);
+			u8 depth_stencil_pass = static_cast<u8>(stencil_operation::keep);
+			u8 read_mask = 0xff;
+			u8 write_mask = 0xff;
+
+			bool operator==(const face&) const = default;
+		};
+
+		u8 depth_compare = static_cast<u8>(compare_function::always);
+		u8 depth_write = 0;
+		u8 stencil = 0;
+		u8 reserved = 0;
+		face front{};
+		face back{};
+
+		bool operator==(const depth_stencil_key&) const = default;
+		depth_stencil_descriptor descriptor() const;
+	};
+
+	static_assert(std::has_unique_object_representations_v<depth_stencil_key>, "depth_stencil_key must have no padding");
+
+	struct raster_state
+	{
+		cull_mode cull = cull_mode::none;
+		bool cull_both_faces = false;   // Vulkan FRONT_AND_BACK: triangles rasterize nothing (MoltenVK disables rasterization)
+		winding front = winding::counter_clockwise;
+		depth_clip_mode depth_clip = depth_clip_mode::clip;
+		f32 depth_bias = 0.f;
+		f32 depth_bias_slope = 0.f;
+		f32 depth_bias_clamp = 0.f;
+		u32 stencil_front_reference = 0;
+		u32 stencil_back_reference = 0;
+		std::array<f32, 4> blend_color{};
+	};
+
+	// Conversions (VK helper -> MoltenVK mapping).
+	compare_function get_compare_function(rsx::comparison_function op);
+	stencil_operation get_stencil_operation(rsx::stencil_op op);
+	blend_factor get_blend_factor(rsx::blend_factor factor);
+	blend_operation get_blend_operation(rsx::blend_equation op);
+	winding get_winding(rsx::front_face face);
+	topology_class get_topology_class(rsx::primitive_type primitive);
+
+	// Metal primitive for an RSX primitive, and whether an index buffer must emulate it (VKVertexBuffers.cpp,
+	// the __APPLE__ table: triangle fans, quads, polygons and line loops are emulated).
+	struct native_primitive
+	{
+		primitive_type type;
+		bool emulated;
+	};
+	native_primitive get_native_primitive(rsx::primitive_type primitive);
+
+	struct attachment_layout
+	{
+		std::array<pixel_format, 4> color{};
+		u8 color_count = 0;
+		bool depth = false;
+		bool stencil = false;
+		u8 samples = 1;
+	};
+
+	pipeline_props decode_pipeline_props(const rsx::rsx_state& regs, const attachment_layout& attachments,
+		rsx::primitive_type primitive, bool supports_hw_a2c, bool supports_hw_a2one, bool force_disable_blending);
+
+	depth_stencil_key decode_depth_stencil(const rsx::rsx_state& regs, bool stencil_attachment);
+
+	raster_state decode_raster_state(const rsx::rsx_state& regs);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPresent.h b/rpcs3/Emu/RSX/Metal/MTLPresent.h
index 5003c16..4ff281a 100644
--- a/rpcs3/Emu/RSX/Metal/MTLPresent.h
+++ b/rpcs3/Emu/RSX/Metal/MTLPresent.h
@@ -29,12 +29,18 @@ struct present_vertex_out
 	float2 uv;
 };
 
-vertex present_vertex_out present_vertex(uint vid [[vertex_id]], constant float4& rect [[buffer(0)]])
+struct present_params
+{
+	float4 rect;       // left, bottom, right, top in clip space
+	float4 uv_scale;   // xy: the displayed fraction of the source texture (a surface may be larger than the buffer)
+};
+
+vertex present_vertex_out present_vertex(uint vid [[vertex_id]], constant present_params& params [[buffer(0)]])
 {
