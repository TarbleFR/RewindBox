+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2): RSX vertex program decompiler for the native Metal 4 renderer.
+// The generated GLSL follows VKVertexProgram.cpp line for line; only the device queries differ.
+
+#include "stdafx.h"
+#include "MTLVertexProgram.h"
+
+#include "Emu/RSX/Program/GLSLCommon.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+#include "Emu/system_config.h"
+
+#ifdef RPCS3_IOS
+#include "ios/RPCS3IOSExperimentalPolicy.h"
+#endif
+
+std::string MTLVertexDecompilerThread::getFloatTypeName(usz elementCount)
+{
+	return glsl::getFloatTypeNameImpl(elementCount);
+}
+
+std::string MTLVertexDecompilerThread::getIntTypeName(usz /*elementCount*/)
+{
+	return "ivec4";
+}
+
+std::string MTLVertexDecompilerThread::getFunction(FUNCTION f)
+{
+	return glsl::getFunctionImpl(f);
+}
+
+std::string MTLVertexDecompilerThread::compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1, bool scalar)
+{
+	return glsl::compareFunctionImpl(f, Op0, Op1, scalar);
+}
+
+void MTLVertexDecompilerThread::prepareBindingTable()
+{
+	u32 location = 0;
+	mtl_prog->binding_table.vertex_buffers_location = location;
+	location += 3; // Persistent verts, volatile and layout data
+
+	mtl_prog->binding_table.context_buffer_location = location++;
+	if (m_caps.emulate_conditional_rendering)
+	{
+		mtl_prog->binding_table.cr_pred_buffer_location = location++;
+	}
+
+	std::memset(mtl_prog->binding_table.vtex_location, 0xff, sizeof(mtl_prog->binding_table.vtex_location));
+
+	for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+	{
+		const bool is_texture_type = PT.type.starts_with("sampler");
+
+		for (const ParamItem& PI : PT.items)
+		{
+			if (is_texture_type)
+			{
+				const int id = mtl::get_texture_index(PI.name);
+				mtl_prog->binding_table.vtex_location[id] = location++;
+				continue;
+			}
+
+			if (PI.name.starts_with("vc["))
+			{
+				if (!(m_prog.ctrl & RSX_SHADER_CONTROL_INSTANCED_CONSTANTS))
+				{
+					mtl_prog->binding_table.cbuf_location = location++;
+					continue;
+				}
+
+				mtl_prog->binding_table.instanced_lut_buffer_location = location++;
+				mtl_prog->binding_table.instanced_cbuf_location = location++;
+				continue;
+			}
+		}
+	}
+}
+
+void MTLVertexDecompilerThread::insertHeader(std::stringstream& OS)
+{
+	prepareBindingTable();
+
+	OS <<
+		"#version 450\n\n"
+		"#extension GL_EXT_scalar_block_layout : require\n"
+		"#extension GL_EXT_uniform_buffer_unsized_array : require\n"
+		"#extension GL_ARB_separate_shader_objects : enable\n\n";
+
+	glsl::insert_subheader_block(OS);
+
+	OS <<
+		// Variable redirection
+		"#define get_draw_params() draw_parameters[draw_parameters_offset]\n"
+		"#define vs_context_offset get_draw_params().vs_context_offset\n\n"
+		// Helpers
+		"#define get_vertex_context() vertex_contexts[vs_context_offset]\n"
+		"#define get_user_clip_config() get_vertex_context().user_clip_configuration_bits\n\n";
+
+	OS <<
+		"layout(std430, set=0, binding=" << mtl_prog->binding_table.context_buffer_location << ") uniform VertexContextBuffer\n"
+		"{\n"
+		"	vertex_context_t vertex_contexts[];\n"
+		"};\n\n";
+
+	inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "VertexContextBuffer",
+		mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_vertex, mtl_prog->binding_table.context_buffer_location));
+
+	if (m_caps.emulate_conditional_rendering)
+	{
+		OS <<
+			"layout(std430, set=0, binding=" << mtl_prog->binding_table.cr_pred_buffer_location << ") readonly restrict buffer EXT_Conditional_Rendering\n"
+			"{\n"
+			"	uint cr_predicate_value;\n"
+			"};\n\n";
+
+		inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "EXT_Conditional_Rendering",
+			mtl::glsl::input_type_storage_buffer, mtl::glsl::binding_set_index_vertex, mtl_prog->binding_table.cr_pred_buffer_location));
+	}
+
+	OS <<
+		"layout(std430, set=0, binding=" << mtl_prog->binding_table.vertex_buffers_location + 2 << ") readonly restrict buffer DrawParametersBuffer\n"
+		"{\n"
+		"	draw_parameters_t draw_parameters[];\n"
+		"};\n\n";
+
+	inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "DrawParametersBuffer",
+		mtl::glsl::input_type_storage_buffer, mtl::glsl::binding_set_index_vertex, mtl_prog->binding_table.vertex_buffers_location + 2));
+
+	OS <<
+		"layout(push_constant) uniform push_constants_block\n"
+		"{\n"
+		"	uint draw_parameters_offset;\n"
+		"};\n\n";
+
+	auto push_constants = mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "push_constants_block",
+		mtl::glsl::input_type_push_constant, mtl::glsl::binding_set_index_vertex, umax);
+	push_constants.push_constant_offset = 0;
+	push_constants.push_constant_size = 4;
+	inputs.push_back(std::move(push_constants));
+}
+
+void MTLVertexDecompilerThread::insertInputs(std::stringstream& OS, const std::vector<ParamType>& /*inputs*/)
+{
+	static const char* input_streams[] =
+	{
+		"persistent_input_stream",    // Data stream with persistent vertex data (cacheable)
+		"volatile_input_stream"      // Data stream with per-draw data (registers and immediate draw data)
+	};
+
+	u32 location = mtl_prog->binding_table.vertex_buffers_location;
+	for (const auto& stream : input_streams)
+	{
+		OS << "layout(set=0, binding=" << location << ") uniform usamplerBuffer " << stream << ";\n";
+
+		this->inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, stream,
+			mtl::glsl::input_type_texel_buffer, mtl::glsl::binding_set_index_vertex, location++));
+	}
+}
+
+void MTLVertexDecompilerThread::insertConstants(std::stringstream& OS, const std::vector<ParamType>& constants)
+{
+	for (const ParamType& PT : constants)
+	{
+		for (const ParamItem& PI : PT.items)
+		{
+			if (PI.name.starts_with("vc["))
+			{
+				if (!(m_prog.ctrl & RSX_SHADER_CONTROL_INSTANCED_CONSTANTS))
+				{
+					OS << "layout(std430, set=0, binding=" << mtl_prog->binding_table.cbuf_location << ") uniform VertexConstantsBuffer\n";
+					OS << "{\n";
+					OS << "	vec4 vc[];\n";
+					OS << "};\n\n";
+
+					inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "VertexConstantsBuffer",
+						mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_vertex, mtl_prog->binding_table.cbuf_location));
+					continue;
+				}
+				else
+				{
+					// 1. Bind indirection lookup buffer
+					OS << "layout(std430, set=0, binding=" << mtl_prog->binding_table.instanced_lut_buffer_location << ") readonly restrict buffer InstancingData\n";
+					OS << "{\n";
+					OS << "	int constants_addressing_lookup[];\n";
+					OS << "};\n\n";
+
+					inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "InstancingData",
+						mtl::glsl::input_type_storage_buffer, mtl::glsl::binding_set_index_vertex, mtl_prog->binding_table.instanced_lut_buffer_location));
+
+					// 2. Bind actual constants buffer
+					OS << "layout(std430, set=0, binding=" << mtl_prog->binding_table.instanced_cbuf_location << ") readonly restrict buffer VertexConstantsBuffer\n";
+					OS << "{\n";
+					OS << "	vec4 instanced_constants_array[];\n";
+					OS << "};\n\n";
+
+					OS << "#define CONSTANTS_ARRAY_LENGTH " << (properties.has_indexed_constants ? 468 : ::size32(m_constant_ids)) << "\n\n";
+
+					inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, "VertexConstantsBuffer",
+						mtl::glsl::input_type_storage_buffer, mtl::glsl::binding_set_index_vertex, mtl_prog->binding_table.instanced_cbuf_location));
+					continue;
+				}
+			}
+
+			if (PT.type.starts_with("sampler"))
+			{
+				const int id = mtl::get_texture_index(PI.name);
+				const u32 location = mtl_prog->binding_table.vtex_location[id];
+
+				inputs.push_back(mtl::glsl::program_input::make(::glsl::glsl_vertex_program, PI.name,
+					mtl::glsl::input_type_texture, mtl::glsl::binding_set_index_vertex, location));
+
+				auto samplerType = PT.type;
+
+				if (m_prog.texture_state.multisampled_textures) [[ unlikely ]]
+				{
+					ensure(PI.name.length() > 3);
+					int index = atoi(&PI.name[3]);
+
+					if (m_prog.texture_state.multisampled_textures & (1 << index))
+					{
+						if (samplerType != "sampler1D" && samplerType != "sampler2D")
+						{
+							rsx_log.error("Unexpected multisampled sampler type '%s'", samplerType);
+						}
+
+						samplerType = "sampler2DMS";
+					}
+				}
+
+				OS << "layout(set=0, binding=" << location << ") uniform " << samplerType << " " << PI.name << ";\n";
+			}
+		}
+	}
+}
+
