+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): RSX vertex programs for the native Metal 4 renderer.
+// The decompiler emits the same Vulkan-flavoured GLSL as VKVertexProgram.cpp (bindings, vertex fetch from
+// texel buffers, draw parameters, z-clip transform), with the device facts taken from mtl::shader_device_caps.
+
+#include "Emu/RSX/Program/VertexProgramDecompiler.h"
+#include "Emu/RSX/Program/program_util.h"
+#include "MTLAPI.h"
+#include "MTLCommonDecompiler.h"
+#include "MTLShaderTranslator.h"
+
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	class vertex_program;
+}
+
+struct MTLVertexDecompilerThread : public VertexProgramDecompiler
+{
+	std::string& m_shader;
+	std::vector<mtl::glsl::program_input> inputs;
+	mtl::vertex_program* mtl_prog;
+	const mtl::shader_device_caps& m_caps;
+
+protected:
+	std::string getFloatTypeName(usz elementCount) override;
+	std::string getIntTypeName(usz elementCount) override;
+	std::string getFunction(FUNCTION f) override;
+	std::string compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1, bool scalar) override;
+
+	void insertHeader(std::stringstream& OS) override;
+	void insertInputs(std::stringstream& OS, const std::vector<ParamType>& inputs) override;
+	void insertConstants(std::stringstream& OS, const std::vector<ParamType>& constants) override;
+	void insertOutputs(std::stringstream& OS, const std::vector<ParamType>& outputs) override;
+	void insertMainStart(std::stringstream& OS) override;
+	void insertMainEnd(std::stringstream& OS) override;
+
+	void prepareBindingTable();
+	void insertFSExport(std::stringstream& OS);
+
+	const RSXVertexProgram& rsx_vertex_program;
+
+public:
+	MTLVertexDecompilerThread(const RSXVertexProgram& prog, std::string& shader, mtl::vertex_program& dst, const mtl::shader_device_caps& caps)
+		: VertexProgramDecompiler(prog)
+		, m_shader(shader)
+		, mtl_prog(&dst)
+		, m_caps(caps)
+		, rsx_vertex_program(prog)
+	{
+	}
+
+	void Task();
+};
+
+namespace mtl
+{
+	class vertex_program : public rsx::VertexProgramBase
+	{
+	public:
+		ParamArray parr;
+		std::vector<glsl::program_input> inputs;
+		bool use_last_provoking_vertex = false;
+
+		std::string glsl_source;
+		std::vector<u32> spirv;
+		std::string compile_error;
+
+		// Translations by primitive class: [0] everything but points, [1] points ([[point_size]] written), and the
+		// Metal libraries compiled from them. Filled on first use by any pipeline build, under the lock.
+		mutable std::mutex translation_lock;
+		mutable translation_result msl[2];
+		mutable object library[2];
+		mutable std::string library_error[2];
+
+		struct
+		{
+			u32 context_buffer_location = umax;        // Vertex program context
+			u32 cr_pred_buffer_location = umax;        // Conditional rendering predicate
+			u32 vertex_buffers_location = umax;        // Vertex input streams (3)
+			u32 cbuf_location = umax;                  // Vertex program constants register file
+			u32 instanced_lut_buffer_location = umax;  // Instancing redirection table
+			u32 instanced_cbuf_location = umax;        // Instancing constants register file
+			u32 vtex_location[4];                      // Vertex textures
+		} binding_table;
+
+		void Decompile(const RSXVertexProgram& prog, const shader_device_caps& caps);
+
+		// GLSL -> SPIR-V (glslang). False with compile_error set when glslang refuses the source.
+		bool Compile();
+
+		// SPIR-V -> MSL for one primitive class, translated once and kept. Caller holds translation_lock.
+		const translation_result& get_msl(bool point_primitives) const;
+	};
+}
