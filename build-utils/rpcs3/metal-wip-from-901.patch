index 0000000..03937d1
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLRenderTargets.h
@@ -0,0 +1,287 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): render targets of the native Metal 4 renderer on RPCS3's shared surface store.
+//
+// rsx::surface_store keeps all the RSX memory logic (address overlap, inheritance of old contents, invalidation, the
+// same rules the Vulkan renderer runs on); these traits only create and update Metal textures, as VKRenderTargets.h
+// does for Vulkan images:
+//   - new surfaces are initialised exactly as the Vulkan renderer initialises them when guest-memory loads are off
+//     (the default): colour (0, 0, 0, 1), depth 1.0, stencil 255;
+//   - inherited contents are copied on the GPU when source and target have the same format and scale;
+// Stage M2.2 does not have the texture cache yet, so these remain to be written and are counted, never faked:
+// typeless or scaled inheritance (the region is initialised as above instead), guest-memory loads of a surface, and
+// writes of a surface back to guest memory. MSAA surfaces are single-sampled, as with the "MSAA: Disabled" setting,
+// until stage M4.
+
+#include "Emu/RSX/Common/surface_store.h"
+#include "MTLCommandContext.h"
+#include "MTLFormats.h"
+
+#include <atomic>
+#include <memory>
+#include <vector>
+
+namespace mtl
+{
+	struct surface_counters
+	{
+		std::atomic<u64> created{0};
+		std::atomic<u64> cleared{0};
+		std::atomic<u64> inherited_copies{0};
+		std::atomic<u64> transfers_not_implemented{0};
+		std::atomic<u64> memory_loads_not_implemented{0};
+		std::atomic<u64> memory_writes_not_implemented{0};
+	};
+
+	surface_counters& get_surface_counters();
+
+	// The renderer's command context, for destructors and traits that have none at hand.
+	void set_command_context(command_context* ctx);
+	command_context* get_command_context();
+
+	class render_target : public rsx::render_target_descriptor<render_target*>
+	{
+	public:
+		object texture;
+		pixel_format native_format = pixel_format::invalid;
+		u32 texture_width = 0;    // texture size (resolution scale applied)
+		u32 texture_height = 0;
+		u8 sample_count = 1;
+		rsx::format_class surface_format_class = rsx::RSX_FORMAT_CLASS_COLOR;
+		component_map native_component_map = default_component_map;
+
+		u64 frame_tag = 0;            // frame id when invalidated, 0 if not invalid
+		u64 last_rw_access_tag = 0;   // timestamp when this object was last used
+		bool is_bound = false;        // bound for rendering
+
+		render_target() = default;
+		~render_target() override;
+
+		render_target* get_surface(rsx::surface_access access_type) override;
+		bool is_depth_surface() const override;
+		bool matches_dimensions(u16 surface_width, u16 surface_height) const;
+		void reset_surface_counters();
+		rsx::format_class format_class() const { return surface_format_class; }
+		u32 width() const { return texture_width; }
+		u32 height() const { return texture_height; }
+		u8 samples() const { return sample_count; }
+
+		// Allocates the texture (private storage, render target and shader read) and makes it resident.
+		bool allocate(command_context& ctx, pixel_format format, u32 texture_width, u32 texture_height, bool depth);
+
+		// Synchronization (the command context inserts the hazard barriers between encoders)
+		void memory_barrier(command_context& ctx, rsx::surface_access access);
+		void read_barrier(command_context& ctx) { memory_barrier(ctx, rsx::surface_access::shader_read); }
+		void write_barrier(command_context& ctx) { memory_barrier(ctx, rsx::surface_access::shader_write); }
+
+	private:
+		void clear_memory(command_context& ctx);
+		void initialize_memory(command_context& ctx, rsx::surface_access access);
+	};
+
+	// A shared-storage buffer for the surface store's DMA blocks.
+	struct buffer_object
+	{
+		object buffer;
+		u64 length = 0;
+
+		u64 size() const { return length; }
+	};
+
+	struct surface_cache_traits
+	{
+		using surface_storage_type = std::unique_ptr<render_target>;
+		using surface_type = render_target*;
+		using buffer_object_storage_type = std::unique_ptr<buffer_object>;
+		using buffer_object_type = buffer_object*;
+		using command_list_type = command_context&;
+		using download_buffer_object = void*;
+		using barrier_descriptor_t = rsx::deferred_clipped_region<render_target*>;
+
+		static std::unique_ptr<render_target> create_new_surface(
+			command_context& ctx,
+			u32 address,
+			rsx::surface_color_format format,
+			usz width, usz height, usz pitch,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& resolution_scaling_config);
+
+		static std::unique_ptr<render_target> create_new_surface(
+			command_context& ctx,
+			u32 address,
+			rsx::surface_depth_format2 format,
+			usz width, usz height, usz pitch,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& resolution_scaling_config);
+
+		static bool is_reusable_surface(const render_target* surface, const render_target* ref)
+		{
+			return surface->texture && surface->native_format == ref->native_format && surface->is_depth_surface() == ref->is_depth_surface();
+		}
+
+		static void prepare_for_reuse(command_context&, render_target* surface)
+		{
+			surface->reset_surface_counters();
+			surface->last_rw_access_tag = 0;
+		}
+
+		static void clone_surface(
+			command_context& ctx,
+			std::unique_ptr<render_target>& sink, render_target* ref,
+			u32 address, barrier_descriptor_t& prev,
+			const rsx::surface_scaling_config_t& scaling_config);
+
+		static std::unique_ptr<render_target> convert_pitch(command_context&, std::unique_ptr<render_target>& src, usz)
+		{
+			// Same as the Vulkan renderer (TODO there too): the surface is re-initialised.
+			src->state_flags = rsx::surface_state_flags::erase_bkgnd;
+			return {};
+		}
+
+		static bool is_compatible_surface(const render_target* surface, const render_target* ref, u16 width, u16 height, u8 sample_count)
+		{
+			return (surface->native_format == ref->native_format &&
+				surface->get_spp() == sample_count &&
+				surface->get_surface_width() == width &&
+				surface->get_surface_height() == height);
+		}
+
+		static void prepare_surface_for_drawing(command_context& ctx, render_target* surface)
+		{
+			surface->memory_barrier(ctx, rsx::surface_access::gpu_reference);
+			surface->reset_surface_counters();
+			surface->memory_usage_flags |= rsx::surface_usage_flags::attachment;
+			surface->is_bound = true;
+		}
+
+		static void prepare_surface_for_sampling(command_context&, render_target* surface)
+		{
+			surface->is_bound = false;
+		}
+
+		static bool surface_is_pitch_compatible(const std::unique_ptr<render_target>& surface, usz pitch)
+		{
+			return surface->rsx_pitch == pitch;
+		}
+
+		static void int_invalidate_surface_contents(command_context&, render_target* surface, u32 address, usz pitch)
+		{
+			surface->rsx_pitch = static_cast<u32>(pitch);
+			surface->queue_tag(address);
+			surface->last_use_tag = 0;
+			surface->stencil_init_flags = 0;
+			surface->memory_usage_flags = rsx::surface_usage_flags::unknown;
+			surface->raster_type = rsx::surface_raster_type::linear;
+		}
+
+		static void invalidate_surface_contents(command_context& ctx, render_target* surface, rsx::surface_color_format format, u32 address, usz pitch)
+		{
+			surface->set_format(format);
+			surface->native_component_map = get_compatible_surface_format(format).mapping;
+			int_invalidate_surface_contents(ctx, surface, address, pitch);
+		}
+
+		static void invalidate_surface_contents(command_context& ctx, render_target* surface, rsx::surface_depth_format2 format, u32 address, usz pitch)
+		{
+			surface->set_format(format);
+			int_invalidate_surface_contents(ctx, surface, address, pitch);
+		}
+
+		static void notify_surface_invalidated(const std::unique_ptr<render_target>& surface);
+
+		static void notify_surface_persist(const std::unique_ptr<render_target>&)
+		{
+		}
+
+		static void notify_surface_reused(const std::unique_ptr<render_target>& surface)
+		{
+			surface->state_flags |= rsx::surface_state_flags::erase_bkgnd;
+			surface->add_ref();
+		}
+
+		static bool int_surface_matches_properties(
+			const std::unique_ptr<render_target>& surface,
+			pixel_format format,
+			usz width, usz height,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& scaling_config,
+			bool check_refs);
+
+		static bool surface_matches_properties(
+			const std::unique_ptr<render_target>& surface,
+			rsx::surface_color_format format,
+			usz width, usz height,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& scaling_config,
+			bool check_refs = false)
+		{
+			return int_surface_matches_properties(surface, get_compatible_surface_format(format).format, width, height, antialias, scaling_config, check_refs);
+		}
+
+		static bool surface_matches_properties(
+			const std::unique_ptr<render_target>& surface,
+			rsx::surface_depth_format2 format,
+			usz width, usz height,
+			rsx::surface_antialiasing antialias,
+			const rsx::surface_scaling_config_t& scaling_config,
+			bool check_refs = false)
+		{
+			return int_surface_matches_properties(surface, get_compatible_depth_surface_format(format), width, height, antialias, scaling_config, check_refs);
+		}
+
+		static void spill_buffer(std::unique_ptr<buffer_object>&)
+		{
+		}
+
+		static void unspill_buffer(std::unique_ptr<buffer_object>&)
+		{
+		}
+
+		static void write_render_target_to_memory(
+			command_context& ctx,
+			buffer_object* bo,
+			render_target* surface,
+			u64 dst_offset_in_buffer,
+			u64 src_offset_in_buffer,
+			u64 max_copy_length);
+
+		template <int BlockSize>
+		static buffer_object* merge_bo_list(command_context& ctx, std::vector<buffer_object*>& list)
+		{
+			// rsx::surface_store::write_to_dma_buffers is not called anywhere in this RPCS3, so this is never
+			// instantiated. Should it become reachable, the merged block must be filled by GPU copies (the source
+			// blocks may still be pending GPU writes); until then it is counted as a memory write not implemented.
+			u64 size = 0;
+			for (auto& bo : list)
+			{
+				size += bo ? bo->size() : BlockSize;
+				if (bo)
+				{
+					ctx.dispose(std::move(bo->buffer), false);
+					delete bo;
+				}
+			}
+
+			get_surface_counters().memory_writes_not_implemented++;
+			auto merged = new buffer_object();
+			merged->buffer = new_buffer(ctx_device(ctx), size, storage_mode::shared);
+			merged->length = size;
+			return merged;
+		}
+
+		static const object& ctx_device(command_context& ctx);
+
+		template <typename T>
+		static T* get(const std::unique_ptr<T>& obj)
+		{
+			return obj.get();
+		}
+	};
+
+	class surface_cache : public rsx::surface_store<surface_cache_traits>
+	{
+	public:
+		void destroy();
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp
new file mode 100644
index 0000000..9c6968d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.cpp
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2): SPIR-V -> MSL translation for the native Metal 4 renderer.
+// Built with exceptions enabled (SPIRV-Cross reports errors by throwing); no exception crosses this file.
+
+#include "MTLShaderTranslator.h"
+
+#include "Utilities/StrFmt.h"
+
+#include "spirv_msl.hpp"
+
+#include <algorithm>
+#include <exception>
+#include <string_view>
+
+namespace mtl
+{
+	namespace
+	{
+		namespace spvc = SPIRV_CROSS_NAMESPACE;
+		namespace spvh = SPIRV_CROSS_SPV_HEADER_NAMESPACE;
+
+		bool ends_with(std::string_view value, std::string_view suffix)
+		{
+			return value.size() >= suffix.size() && value.substr(value.size() - suffix.size()) == suffix;
+		}
+
+		// The stencil view of a redirected depth-stencil texture: the Vulkan renderer samples it with a nearest,
+		// clamp-to-border (integer opaque black) sampler of its own (VKDraw.cpp, m_stencil_mirror_sampler).
+		spvc::MSLConstexprSampler stencil_mirror_sampler()
+		{
+			spvc::MSLConstexprSampler sampler{};
+			sampler.coord = spvc::MSL_SAMPLER_COORD_NORMALIZED;
+			sampler.min_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mag_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mip_filter = spvc::MSL_SAMPLER_MIP_FILTER_NEAREST;
+			sampler.s_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.t_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.r_address = spvc::MSL_SAMPLER_ADDRESS_CLAMP_TO_BORDER;
+			sampler.border_color = spvc::MSL_SAMPLER_BORDER_COLOR_OPAQUE_BLACK;
+			sampler.lod_clamp_min = 0.f;
+			sampler.lod_clamp_max = 1.f;
+			sampler.lod_clamp_enable = true;
+			return sampler;
+		}
+
+		// The depth-compare input (frag_depth): the Vulkan renderer binds it with vk::null_sampler() (nearest, repeat).
+		spvc::MSLConstexprSampler depth_input_sampler()
+		{
+			spvc::MSLConstexprSampler sampler{};
+			sampler.coord = spvc::MSL_SAMPLER_COORD_NORMALIZED;
+			sampler.min_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mag_filter = spvc::MSL_SAMPLER_FILTER_NEAREST;
+			sampler.mip_filter = spvc::MSL_SAMPLER_MIP_FILTER_NEAREST;
+			sampler.s_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			sampler.t_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			sampler.r_address = spvc::MSL_SAMPLER_ADDRESS_REPEAT;
+			return sampler;
+		}
+
+		bool is_stencil_mirror(const resource_slot& slot)
+		{
+			return slot.type == glsl::input_type_texture && ends_with(slot.name, "_stencil");
+		}
+
+		bool is_depth_input(const resource_slot& slot)
+		{
+			return slot.type == glsl::input_type_texture && slot.name == "frag_depth";
+		}
+
+		spvh::ExecutionModel model_of(shader_stage stage)
+		{
+			return stage == shader_stage::vertex ? spvh::ExecutionModelVertex : spvh::ExecutionModelFragment;
+		}
+
+		u32 set_of(shader_stage stage)
+		{
+			return stage == shader_stage::vertex ? glsl::binding_set_index_vertex : glsl::binding_set_index_fragment;
+		}
+
+		std::string describe(const resource_slot& slot)
+		{
+			return fmt::format("'%s' (set %u, binding %u)", slot.name, slot.set, slot.location);
+		}
+	}
+
+	std::vector<resource_slot> assign_slots(shader_stage stage, const std::vector<glsl::program_input>& inputs, std::string& error)
+	{
+		std::vector<resource_slot> slots;
+		slots.reserve(inputs.size());
+
+		const u32 stage_set = set_of(stage);
+		bool push_constants_seen = false;
+
+		for (const auto& input : inputs)
+		{
+			resource_slot slot{};
+			slot.set = input.set;
+			slot.location = input.location;
+			slot.type = input.type;
+			slot.name = input.name;
+
+			if (input.set != stage_set)
+			{
+				error = fmt::format("input %s is not in this stage's set %u", describe(slot), stage_set);
+				return {};
+			}
+
+			switch (input.type)
+			{
+			case glsl::input_type_push_constant:
+				if (push_constants_seen)
+				{
+					error = "more than one push constant block in one stage";
+					return {};
+				}
+				push_constants_seen = true;
+				slot.buffer = push_constant_buffer_slot;
+				break;
+			case glsl::input_type_uniform_buffer:
+			case glsl::input_type_storage_buffer:
+				if (input.location >= push_constant_buffer_slot)
+				{
+					error = fmt::format("buffer %s exceeds the %u buffer slots below the push constants", describe(slot), push_constant_buffer_slot);
+					return {};
+				}
+				slot.buffer = input.location;
+				break;
+			case glsl::input_type_texel_buffer:
+				slot.texture = input.location;
+				break;
+			case glsl::input_type_texture:
+				slot.texture = input.location;
+				if (!is_stencil_mirror(slot) && !is_depth_input(slot))
+				{
+					const int unit = get_texture_index(input.name);
+					if (unit < 0 || static_cast<u32>(unit) >= max_sampler_slots)
+					{
+						error = fmt::format("texture %s has no sampler slot (unit %d)", describe(slot), unit);
+						return {};
+					}
+					slot.sampler = static_cast<u32>(unit);
+				}
+				break;
+			case glsl::input_type_attachment:
+				// Programmable blending: framebuffer fetch of the colour attachment, nothing to bind.
+				break;
+			default:
+				error = fmt::format("input %s has no Metal mapping (type %u)", describe(slot), static_cast<u32>(input.type));
+				return {};
+			}
+
+			if (slot.texture != umax && slot.texture >= max_texture_slots)
+			{
+				error = fmt::format("texture %s exceeds %u texture slots", describe(slot), max_texture_slots);
+				return {};
+			}
+
+			for (const auto& other : slots)
+			{
+				const bool same_buffer = slot.buffer != umax && slot.buffer == other.buffer;
+				const bool same_texture = slot.texture != umax && slot.texture == other.texture;
+				if (same_buffer || same_texture)
+				{
+					error = fmt::format("inputs %s and %s share a Metal slot", describe(other), describe(slot));
+					return {};
+				}
+			}
+
+			slots.push_back(std::move(slot));
+		}
+
+		return slots;
+	}
+
+	translation_result translate_spirv_to_msl(std::span<const u32> spirv, shader_stage stage,
+		const std::vector<glsl::program_input>& inputs, const translation_options& options)
+	{
+		translation_result result{};
+		result.slots = assign_slots(stage, inputs, result.error);
+		if (!result.error.empty())
+		{
+			return result;
+		}
+
+		if (spirv.empty())
+		{
+			result.error = "empty SPIR-V";
+			return result;
+		}
+
+		const spvh::ExecutionModel model = model_of(stage);
+
+		try
+		{
+			spvc::CompilerMSL compiler(spirv.data(), spirv.size());
+
+			// The options MoltenVK uses for these shaders (MVKPipeline.mm, SPIRVToMSLConverter.cpp), Apple GPU, iOS.
+			auto msl_options = compiler.get_msl_options();
+			msl_options.platform = spvc::CompilerMSL::Options::iOS;
+			msl_options.set_msl_version(options.msl_major, options.msl_minor);
+			msl_options.pad_fragment_output_components = true;
+			msl_options.texture_buffer_native = true;
+			msl_options.swizzle_texture_samples = false;     // swizzles are texture views (native swizzle)
+			msl_options.argument_buffers = false;            // discrete slots: Metal 4 argument tables
+			msl_options.agx_manual_cube_grad_fixup = true;   // Apple GPUs
+			msl_options.ios_support_base_vertex_instance = true;
+			msl_options.texture_1D_as_2D = true;
+			msl_options.enable_point_size_builtin = options.point_primitives;
+			msl_options.enable_point_size_default = options.point_primitives;
+			msl_options.default_point_size = 1.0f;
+			msl_options.enable_frag_depth_builtin = options.depth_attachment;
+			msl_options.enable_frag_stencil_ref_builtin = options.stencil_attachment;
+			msl_options.enable_frag_output_mask = options.color_output_mask;
+			msl_options.use_framebuffer_fetch_subpasses = true;
+			msl_options.replace_recursive_inputs = true;
+			msl_options.ios_use_simdgroup_functions = true;
+			msl_options.emulate_subgroups = false;
+			compiler.set_msl_options(msl_options);
+
+			auto common_options = compiler.get_common_options();
+			common_options.vertex.flip_vert_y = (stage == shader_stage::vertex) && options.flip_vertex_y;
+			common_options.vertex.fixup_clipspace = false;
+			compiler.set_common_options(common_options);
+
+			for (const auto& slot : result.slots)
+			{
+				if (slot.type == glsl::input_type_attachment)
+				{
+					continue;
+				}
+
+				spvc::MSLResourceBinding binding{};
+				binding.stage = model;
+				binding.count = 1;
+
+				if (slot.type == glsl::input_type_push_constant)
+				{
+					binding.desc_set = spvc::kPushConstDescSet;
+					binding.binding = spvc::kPushConstBinding;
+					result.uses_push_constants = true;
+				}
+				else
+				{
+					binding.desc_set = slot.set;
+					binding.binding = slot.location;
+				}
+
+				binding.msl_buffer = slot.buffer != umax ? slot.buffer : 0;
+				binding.msl_texture = slot.texture != umax ? slot.texture : 0;
+				binding.msl_sampler = slot.sampler != umax ? slot.sampler : 0;
+				compiler.add_msl_resource_binding(binding);
+
+				if (is_stencil_mirror(slot))
+				{
+					compiler.remap_constexpr_sampler_by_binding(slot.set, slot.location, stencil_mirror_sampler());
+				}
+				else if (is_depth_input(slot))
+				{
+					compiler.remap_constexpr_sampler_by_binding(slot.set, slot.location, depth_input_sampler());
+				}
+			}
+
+			// Every resource of the SPIR-V must have been listed by the decompiler.
+			const spvc::ShaderResources resources = compiler.get_shader_resources();
+			auto require_listed = [&](const spvc::SmallVector<spvc::Resource>& list, const char* kind)
+			{
+				for (const auto& resource : list)
+				{
+					const u32 set = compiler.get_decoration(resource.id, spvh::DecorationDescriptorSet);
+					const u32 location = compiler.get_decoration(resource.id, spvh::DecorationBinding);
+					const bool listed = std::any_of(result.slots.begin(), result.slots.end(), [&](const resource_slot& slot)
+					{
+						return slot.type != glsl::input_type_push_constant && slot.set == set && slot.location == location;
+					});
+
+					if (!listed)
+					{
+						result.error = fmt::format("%s '%s' (set %u, binding %u) was not listed by the decompiler", kind, resource.name, set, location);
+						return false;
+					}
+				}
+				return true;
+			};
+
+			if (!require_listed(resources.uniform_buffers, "uniform buffer") ||
+				!require_listed(resources.storage_buffers, "storage buffer") ||
+				!require_listed(resources.sampled_images, "sampled image") ||
+				!require_listed(resources.separate_images, "image") ||
+				!require_listed(resources.separate_samplers, "sampler") ||
+				!require_listed(resources.storage_images, "storage image") ||
+				!require_listed(resources.subpass_inputs, "subpass input"))
+			{
+				return result;
+			}
+
+			if (!resources.push_constant_buffers.empty() && !result.uses_push_constants)
+			{
+				result.error = "the shader declares push constants the decompiler did not list";
+				return result;
+			}
+
+			result.msl = compiler.compile();
+			result.entry_point = compiler.get_cleansed_entry_point_name("main", model);
+			result.position_invariant = compiler.is_position_invariant();
+
+			for (auto& slot : result.slots)
+			{
+				if (slot.type == glsl::input_type_attachment)
+				{
+					slot.used = true;
+					continue;
+				}
+
+				const u32 set = slot.type == glsl::input_type_push_constant ? spvc::kPushConstDescSet : slot.set;
+				const u32 location = slot.type == glsl::input_type_push_constant ? spvc::kPushConstBinding : slot.location;
+				slot.used = compiler.is_msl_resource_binding_used(model, set, location);
+			}
+
+			result.ok = true;
+		}
+		catch (const spvc::CompilerError& e)
+		{
+			result.error = fmt::format("SPIRV-Cross: %s", e.what());
+		}
+		catch (const std::exception& e)
+		{
+			result.error = fmt::format("SPIR-V to MSL: %s", e.what());
+		}
+
+		if (!result.ok)
+		{
+			result.msl.clear();
+		}
+
+		return result;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h
new file mode 100644
index 0000000..29a5898
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLShaderTranslator.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): SPIR-V -> Metal Shading Language for the native Metal 4 renderer.
+//
+// The SPIR-V comes from RPCS3's Vulkan-flavoured GLSL (Metal decompilers, glslang). SPIRV-Cross (vendored as
+// rbx_spirv_cross, so it never collides with the copy inside MoltenVK) translates it with the options MoltenVK
+// uses for the same shaders today, and every resource the shader declares gets an explicit slot in the Metal 4
+// argument table of its stage. A shader that declares a resource the decompiler did not list is refused rather
+// than given an automatic slot.
+//
+// Slot assignment (documented contract with the draw code):
+//   buffers  (uniform, storage)        -> buffer slot  = GLSL binding location
+//   textures (sampled, texel buffers)  -> texture slot = GLSL binding location
+//   texture samplers                   -> sampler slot = RSX texture unit (tex0..15, vtex0..3)
+//   stencil mirrors, depth-compare input -> samplers baked into the shader (same states as the Vulkan renderer)
+//   push constants (one block per stage) -> buffer slot push_constant_buffer_slot, same bytes for both stages
+//   programmable-blend inputs          -> framebuffer fetch of the colour attachment (no slot)
+
+#include "MTLCommonDecompiler.h"
+
+#include <span>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	enum class shader_stage : u8
+	{
+		vertex,
+		fragment,
+	};
+
+	constexpr u32 push_constant_buffer_slot = 30;
+	constexpr u32 max_buffer_slots = 31;
+	constexpr u32 max_texture_slots = 64;
+	constexpr u32 max_sampler_slots = 16;
+
+	struct resource_slot
+	{
+		u32 set = 0;
+		u32 location = umax;
+		glsl::program_input_type type = glsl::input_type_undefined;
+		std::string name;
+		u32 buffer = umax;
+		u32 texture = umax;
+		u32 sampler = umax;   // umax: no runtime sampler (none needed, or baked into the shader)
+		bool used = false;    // the translated shader reads it
+	};
+
+	struct translation_options
+	{
+		bool flip_vertex_y = true;          // Vulkan clip space (y down) -> Metal (y up), as MoltenVK does by default
+		bool point_primitives = false;      // vertex: the pipeline draws points, so [[point_size]] is written
+		bool depth_attachment = true;       // fragment: a depth attachment exists, so [[depth]] may be written
+		bool stencil_attachment = false;    // fragment: a stencil attachment exists
+		u32 color_output_mask = 0xffffffffu;
+		u32 msl_major = 3;
+		u32 msl_minor = 2;
+	};
+
+	struct translation_result
+	{
+		bool ok = false;
+		std::string msl;
+		std::string error;
+		std::string entry_point;
+		bool position_invariant = false;    // compile with preserveInvariance
+		bool uses_push_constants = false;
+		std::vector<resource_slot> slots;
+	};
+
+	// Slots for every input of one stage, before translation (pure; also used by the draw code to bind).
+	std::vector<resource_slot> assign_slots(shader_stage stage, const std::vector<glsl::program_input>& inputs, std::string& error);
+
+	translation_result translate_spirv_to_msl(std::span<const u32> spirv, shader_stage stage,
+		const std::vector<glsl::program_input>& inputs, const translation_options& options);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLVertexBuffers.cpp b/rpcs3/Emu/RSX/Metal/MTLVertexBuffers.cpp
new file mode 100644
index 0000000..cd2b2e2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLVertexBuffers.cpp
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): vertex and index uploads of the native Metal 4 renderer (VKVertexBuffers.cpp).
+// The same RSX helpers write the same bytes; only the destination (shared Metal rings, read by the GPU in place)
+// and the host primitive mapping (Metal's, which matches the Vulkan renderer's __APPLE__ table) differ. The
+// Vulkan renderer's persistent-vertex cache is not used yet: every draw uploads its vertex data (exact, slower).
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/Common/BufferUtils.h"
+#include "Emu/RSX/Utils/rsx_utils.h"
+#include "Emu/RSX/rsx_methods.h"
+#include "util/asm.hpp"
+
+#include <span>
+
+namespace
+{
+	mtl::index_type get_index_type(rsx::index_array_type type)
+	{
+		return type == rsx::index_array_type::u32 ? mtl::index_type::uint32 : mtl::index_type::uint16;
+	}
+
+	struct vertex_input_state
+	{
+		mtl::primitive_type native_primitive_type;
+		bool index_rebase;
+		u32 min_index;
+		u32 max_index;
+		u32 vertex_draw_count;
+		u32 vertex_index_offset;
+		std::optional<std::pair<u64, mtl::index_type>> index_info;
+	};
+
+	std::pair<u32, std::pair<u64, mtl::index_type>> generate_emulating_index_buffer(
+		const rsx::draw_clause& clause, u32 vertex_count, mtl::data_heap& index_ring)
+	{
+		const u32 index_count = get_index_count(clause.primitive, vertex_count);
+		const u32 upload_size = index_count * sizeof(u16);
+
+		const u64 offset = index_ring.alloc<256>(upload_size);
+		g_fxo->get<rsx::dma_manager>().emulate_as_indexed(index_ring.map(offset), clause.primitive, vertex_count);
+		return { index_count, { offset, mtl::index_type::uint16 } };
+	}
+
+	struct draw_command_visitor
+	{
+		draw_command_visitor(mtl::data_heap& index_ring, rsx::vertex_input_layout& layout)
+			: m_index_ring(index_ring)
+			, m_vertex_layout(layout)
+		{
+		}
+
+		vertex_input_state operator()(const rsx::draw_array_command& /*command*/)
+		{
+			const auto [prims, primitives_emulated] = mtl::get_native_primitive(rsx::method_registers.current_draw_clause.primitive);
+			const u32 vertex_count = rsx::method_registers.current_draw_clause.get_elements_count();
+			const u32 min_index = rsx::method_registers.current_draw_clause.min_index();
+			const u32 max_index = (min_index + vertex_count) - 1;
+
+			if (primitives_emulated)
+			{
+				const auto [index_count, index_info] = generate_emulating_index_buffer(rsx::method_registers.current_draw_clause, vertex_count, m_index_ring);
+				return { prims, false, min_index, max_index, index_count, 0, index_info };
+			}
+
+			return { prims, false, min_index, max_index, vertex_count, 0, {} };
+		}
+
+		vertex_input_state operator()(const rsx::draw_indexed_array_command& command)
+		{
+			auto primitive = rsx::method_registers.current_draw_clause.primitive;
+			const auto [prims, primitives_emulated] = mtl::get_native_primitive(primitive);
+
+			const rsx::index_array_type index_type = rsx::method_registers.current_draw_clause.is_immediate_draw ?
+				rsx::index_array_type::u32 :
+				rsx::method_registers.index_type();
+
+			const u32 type_size = get_index_type_size(index_type);
+
+			u32 index_count = rsx::method_registers.current_draw_clause.get_elements_count();
+			if (primitives_emulated)
+				index_count = get_index_count(rsx::method_registers.current_draw_clause.primitive, index_count);
+			const u32 upload_size = index_count * type_size;
+
+			const u64 offset_in_index_buffer = m_index_ring.alloc<64>(upload_size);
+			void* buf = m_index_ring.map(offset_in_index_buffer);
+
+			// Upload index (and expand it if the primitive type is not natively supported). Metal always restarts
+			// strips at the all-ones index, as the Vulkan renderer's restart-enabled pipelines do on MoltenVK.
+			u32 min_index, max_index;
+			std::tie(min_index, max_index, index_count) = write_index_array_data_to_buffer(
+				std::span<std::byte>(static_cast<std::byte*>(buf), upload_size),
+				command.raw_index_buffer, index_type,
+				rsx::method_registers.current_draw_clause.primitive,
+				rsx::method_registers.restart_index_enabled(),
+				rsx::method_registers.restart_index(),
+				[](auto prim) { return mtl::get_native_primitive(prim).emulated; });
+
+			if (min_index >= max_index)
+			{
+				// Empty set, do not draw
+				return { prims, false, 0, 0, 0, 0, {} };
+			}
+
+			const auto index_offset = rsx::method_registers.vertex_data_base_index();
+			return { prims, true, min_index, max_index, index_count, index_offset, std::pair{ offset_in_index_buffer, get_index_type(index_type) } };
+		}
+
+		vertex_input_state operator()(const rsx::draw_inlined_array& /*command*/)
+		{
+			auto& draw_clause = rsx::method_registers.current_draw_clause;
+			const auto [prims, primitives_emulated] = mtl::get_native_primitive(draw_clause.primitive);
+
+			const auto stream_length = rsx::method_registers.current_draw_clause.inline_vertex_array.size();
+			const u32 vertex_count = u32(stream_length * sizeof(u32)) / m_vertex_layout.interleaved_blocks[0]->attribute_stride;
+
+			if (!primitives_emulated)
+			{
+				return { prims, false, 0, vertex_count - 1, vertex_count, 0, {} };
+			}
+
+			const auto [index_count, index_info] = generate_emulating_index_buffer(draw_clause, vertex_count, m_index_ring);
+			return { prims, false, 0, vertex_count - 1, index_count, 0, index_info };
+		}
+
+	private:
+		mtl::data_heap& m_index_ring;
+		rsx::vertex_input_layout& m_vertex_layout;
+	};
+}
+
+void MTLGSRender::update_texel_window(texel_window& window, u32& range_base, u64 required)
+{
+	// The attribute ring seen through a texel-buffer view starting at an aligned base (VK: buffer views of 64M
+	// blocks); the shader addresses the stream relative to the view.
+	if (window.view && range_base >= window.base && static_cast<u64>(range_base) + required <= window.base + window.length)
+	{
+		range_base = static_cast<u32>(range_base - window.base);
+		return;
+	}
+
+	if (window.view)
+	{
+		m_commands.dispose(std::move(window.view), true);
+	}
+
+	const u64 ring_size = m_rings[ring_attrib].size();
+	const u64 base = (range_base / m_texel_buffer_alignment) * m_texel_buffer_alignment;
+	const u64 length = std::min(m_texel_window_size, ring_size - base);
+	ensure(length >= (range_base - base) + required, "Metal: a vertex stream does not fit in a texel-buffer window");
+
+	window.view = mtl::new_texture_buffer(m_rings[ring_attrib].buffer, mtl::pixel_format::r8_uint, base, length);
+	ensure(window.view, "Metal: texel-buffer view creation failed");
+	m_commands.make_resident(window.view);
+	window.base = base;
+	window.length = length;
+	range_base = static_cast<u32>(range_base - base);
+}
+
+mtl::vertex_upload_info MTLGSRender::upload_vertex_data()
+{
+	draw_command_visitor visitor(m_rings[ring_index], m_vertex_layout);
+	auto result = std::visit(visitor, m_draw_processor.get_draw_command(rsx::method_registers));
+
+	const u32 vertex_count = (result.max_index - result.min_index) + 1;
+	u32 vertex_base = result.min_index;
+	u32 index_base = 0;
+
+	if (result.index_rebase)
+	{
+		vertex_base = rsx::get_index_from_base(vertex_base, rsx::method_registers.vertex_data_base_index());
+		index_base = result.min_index;
+	}
+
+	// Actual vertex upload
+	const auto required = calculate_memory_requirements(m_vertex_layout, vertex_base, vertex_count);
+	u32 persistent_range_base = umax, volatile_range_base = umax;
+	usz persistent_offset = umax, volatile_offset = umax;
+
+	if (required.first > 0)
+	{
+		persistent_offset = m_rings[ring_attrib].alloc<256>(required.first);
+		persistent_range_base = static_cast<u32>(persistent_offset);
+	}
+
+	if (required.second > 0)
+	{
+		volatile_offset = m_rings[ring_attrib].alloc<256>(required.second);
+		volatile_range_base = static_cast<u32>(volatile_offset);
+	}
+
+	if (required.first > 0 || required.second > 0)
+	{
+		m_draw_processor.write_vertex_data_to_memory(m_vertex_layout, vertex_base, vertex_count,
+			required.first ? m_rings[ring_attrib].map(persistent_offset) : nullptr,
+			required.second ? m_rings[ring_attrib].map(volatile_offset) : nullptr);
+	}
+
+	if (persistent_range_base != umax)
+	{
+		update_texel_window(m_persistent_window, persistent_range_base, required.first);
+	}
+
+	if (volatile_range_base != umax)
+	{
+		update_texel_window(m_volatile_window, volatile_range_base, required.second);
+	}
+
+	mtl::vertex_upload_info info{};
+	info.primitive = result.native_primitive_type;
+	info.vertex_draw_count = result.vertex_draw_count;
+	info.allocated_vertex_count = vertex_count;
+	info.first_vertex = vertex_base;
+	info.vertex_index_base = index_base;
+	info.vertex_index_offset = result.vertex_index_offset;
+	info.persistent_window_offset = persistent_range_base;
+	info.volatile_window_offset = volatile_range_base;
+	info.index_info = result.index_info;
+	return info;
+}
