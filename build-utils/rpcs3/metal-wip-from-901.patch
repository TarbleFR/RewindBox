index 0000000..4d918d2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.cpp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "stdafx.h"
+#include "MTLCommonDecompiler.h"
+
+#include <array>
+#include <cctype>
+#include <cstdlib>
+#include <utility>
+
+namespace mtl
+{
+	// The same varying locations as the Vulkan decompilers (VKCommonDecompiler.cpp), so vertex and fragment
+	// programs translated separately still link by location.
+	static constexpr std::array<std::pair<std::string_view, int>, 17> varying_registers =
+	{ {
+		{ "tc0", 0 },
+		{ "tc1", 1 },
+		{ "tc2", 2 },
+		{ "tc3", 3 },
+		{ "tc4", 4 },
+		{ "tc5", 5 },
+		{ "tc6", 6 },
+		{ "tc7", 7 },
+		{ "tc8", 8 },
+		{ "tc9", 9 },
+		{ "diff_color", 10 },
+		{ "diff_color1", 11 },
+		{ "spec_color", 12 },
+		{ "spec_color1", 13 },
+		{ "fog_c", 14 },
+		{ "fogc", 14 },
+		{ "usr", 15 },
+	} };
+
+	int get_varying_register_location(std::string_view varying_register_name)
+	{
+		for (const auto& varying_register : varying_registers)
+		{
+			if (varying_register.first == varying_register_name)
+			{
+				return varying_register.second;
+			}
+		}
+
+		fmt::throw_exception("Unknown register name: %s", varying_register_name);
+	}
+
+	int get_texture_index(std::string_view name)
+	{
+		if (name.length() < 2)
+		{
+			fmt::throw_exception("Invalid texture name: '%s'", name);
+		}
+
+		constexpr int max_index_length = 2;
+		const int name_length = static_cast<int>(name.length());
+		std::string index;
+
+		for (int char_idx = name_length - max_index_length; char_idx < name_length; ++char_idx)
+		{
+			if (std::isdigit(static_cast<unsigned char>(name[char_idx])))
+			{
+				index += name[char_idx];
+			}
+		}
+
+		if (index.empty())
+		{
+			fmt::throw_exception("Invalid texture name: '%s'", name);
+		}
+
+		return std::atoi(index.c_str());
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h
new file mode 100644
index 0000000..96aa7e8
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLCommonDecompiler.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): what the Metal decompilers declare for each translated RSX program.
+//
+// The Metal renderer reuses RPCS3's Vulkan-flavoured GLSL generation (the same text MoltenVK translates for
+// the Vulkan renderer today), compiles it to SPIR-V with glslang and translates the SPIR-V to MSL with
+// SPIRV-Cross. Nothing here depends on a Vulkan device or on Vulkan headers: the device facts the Vulkan
+// decompilers query are a capability record filled from the Metal device.
+
+#include "Emu/RSX/Program/GLSLTypes.h"
+#include "util/types.hpp"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace mtl
+{
+	namespace glsl
+	{
+		enum program_input_type : u32
+		{
+			input_type_uniform_buffer = 0,
+			input_type_texel_buffer,
+			input_type_texture,
+			input_type_storage_buffer,
+			input_type_push_constant,
+			input_type_attachment,
+
+			input_type_undefined = 0xffff'ffff
+		};
+
+		// Descriptor set numbers written in the generated GLSL ("set=0" vertex, "set=1" fragment).
+		enum binding_set_index : u32
+		{
+			binding_set_index_vertex = 0,
+			binding_set_index_fragment = 1,
+		};
+
+		struct program_input
+		{
+			::glsl::program_domain domain = ::glsl::glsl_invalid_program;
+			program_input_type type = input_type_undefined;
+			u32 set = 0;
+			u32 location = umax;
+			std::string name = "undefined";
+
+			// input_type_push_constant only: the byte range of the push constant block this stage declares.
+			u32 push_constant_offset = 0;
+			u32 push_constant_size = 0;
+
+			static program_input make(::glsl::program_domain domain, std::string name, program_input_type type, u32 set, u32 location)
+			{
+				program_input result{};
+				result.domain = domain;
+				result.type = type;
+				result.set = set;
+				result.location = location;
+				result.name = std::move(name);
+				return result;
+			}
+		};
+	}
+
+	// The device facts the RSX decompilers depend on, for the Metal device in use.
+	struct shader_device_caps
+	{
+		bool has_native_half_support = false;       // float16 arithmetic (Apple GPUs: yes; used only at low shader precision, as on Vulkan)
+		bool emulate_depth_compare = true;          // no D24S8: depth surfaces are D32F(+S8), shadow compares emulated as on MoltenVK
+		bool emulate_conditional_rendering = false; // conditional rendering resolved on the CPU, as on MoltenVK
+		bool allow_float64 = false;                 // Metal shading language has no double precision
+		bool low_precision_rounding = false;        // NVIDIA-only workaround
+	};
+
+	int get_varying_register_location(std::string_view varying_register_name);
+	int get_texture_index(std::string_view name);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLDataHeap.h b/rpcs3/Emu/RSX/Metal/MTLDataHeap.h
new file mode 100644
index 0000000..bb306e9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLDataHeap.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): ring buffers of the native Metal 4 renderer (vertex streams, draw parameters,
+// contexts, constants, indices, uploads). The same allocator as the Vulkan renderer (rsx::data_heap) over one
+// shared-storage MTLBuffer: unified memory, so the CPU writes where the GPU reads, with no map, copy or flush.
+//
+// Space is reclaimed per frame: the renderer records each heap's position when it submits a frame and moves the
+// heap's GET position there once the frame's fence has signalled. A heap that is full asks the renderer to make
+// room (on_exhausted: submit, then wait for the GPU); it never overwrites memory the GPU may still read.
+
+#include "Emu/RSX/Common/ring_buffer_helper.h"
+#include "MTLAPI.h"
+
+#include <functional>
+
+namespace mtl
+{
+	class data_heap : public rsx::data_heap
+	{
+	public:
+		object buffer;
+
+		// Called with the requested size when an allocation would reach memory in use by the GPU. Returns true
+		// once the whole heap is free again (the renderer submitted its work and waited for it).
+		std::function<bool(usz)> on_exhausted;
+
+		void create(const object& device, usz size, const char* name, usz guard = 0x10000)
+		{
+			init(size, name, guard);
+			buffer = new_buffer(device, size, storage_mode::shared);
+			m_host = static_cast<u8*>(buffer_contents(buffer));
+			ensure(m_host, "Metal ring buffer allocation failed");
+		}
+
+		void destroy()
+		{
+			buffer.reset();
+			m_host = nullptr;
+		}
+
+		template <typename T = void>
+		T* map(usz offset, usz /*size*/ = 0) const
+		{
+			return reinterpret_cast<T*>(m_host + offset);
+		}
+
+		// Kept for symmetry with vk::data_heap call sites: shared storage needs no unmap.
+		void unmap() const
+		{
+		}
+
+		// Everything allocated so far may be reused (the GPU has finished with all of it).
+		void release_all()
+		{
+			reset_allocation_stats();
+		}
+
+		usz put_position() const
+		{
+			return get_current_put_pos_minus_one();
+		}
+
+		bool valid() const
+		{
+			return !!buffer;
+		}
+
+	protected:
+		bool grow(usz size) override
+		{
+			// rsx::data_heap::alloc() keeps the PUT position it computed before calling grow(), so only GET moves:
+			// once the renderer has waited for the GPU, the whole ring is free from PUT onwards (wrapping to 0).
+			if (size < m_size && on_exhausted && on_exhausted(size))
+			{
+				reset_allocation_stats();
+				return true;
+			}
+
+			return false;
+		}
+
+	private:
+		u8* m_host = nullptr;
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLDraw.cpp b/rpcs3/Emu/RSX/Metal/MTLDraw.cpp
new file mode 100644
index 0000000..e797b7f
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLDraw.cpp
@@ -0,0 +1,1106 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): the draw path of the native Metal 4 renderer (VKDraw.cpp and the draw parts of
+// VKGSRender.cpp ported to Metal 4 argument tables and render encoders).
+//
+// Binding scheme: every ring is bound at the address of this draw's element, so the element offsets the Vulkan
+// renderer writes into the draw parameters (vs_context_offset, fs_context_offset, xform/fs constants offsets,
+// texture base, stipple offset) are all 0 here; the draw parameters entry of subdraw N is reached through the push
+// constant draw_parameters_offset = N with the vertex layout ring bound at the draw call's batch.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/Common/BufferUtils.h"
+#include "Emu/RSX/Common/TextureUtils.h"
+#include "Emu/RSX/Utils/color_utils.hpp"
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/system_config.h"
+
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+namespace
+{
+	// Stage M2.2 has no texture cache: an enabled texture unit is described as a colour texture of its declared
+	// dimension, so the program state (dimensions, no shadow/stencil redirection) is computed as for a plain colour
+	// texture; the unit is bound to a neutral 1x1 texture and counted.
+	class neutral_sampled_image final : public rsx::sampled_image_descriptor_base
+	{
+	public:
+		u32 encoded_component_map() const override
+		{
+			return 0;
+		}
+	};
+
+	template <typename Texture>
+	void describe_neutral(rsx::sampled_image_descriptor_base& descriptor, const Texture& tex)
+	{
+		descriptor.upload_context = rsx::texture_upload_context::shader_read;
+		descriptor.image_type = tex.get_extended_texture_dimension();
+		descriptor.format_class = rsx::RSX_FORMAT_CLASS_COLOR;
+		descriptor.is_cyclic_reference = false;
+		descriptor.samples = 1;
+		descriptor.ref_address = rsx::get_address(tex.offset(), tex.location());
+		descriptor.texcoord_xform.scale[0] = descriptor.texcoord_xform.scale[1] = descriptor.texcoord_xform.scale[2] = 1.f;
+		descriptor.texcoord_xform.bias[0] = descriptor.texcoord_xform.bias[1] = descriptor.texcoord_xform.bias[2] = 0.f;
+		descriptor.texcoord_xform.clamp = false;
+	}
+
+	// The full-surface clear pass (MoltenVK clears attachments the same way: a triangle under the scissor).
+	constexpr std::string_view clear_source = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct clear_params
+{
+	float4 color;
+	float4 depth;
+};
+
+struct clear_vertex_out
+{
+	float4 position [[position]];
+};
+
+vertex clear_vertex_out clear_vertex(uint vid [[vertex_id]], constant clear_params& params [[buffer(0)]])
+{
+	const float2 corner = float2((vid == 1u) ? 3.0 : -1.0, (vid == 2u) ? 3.0 : -1.0);
+	clear_vertex_out out;
+	out.position = float4(corner, params.depth.x, 1.0);
+	return out;
+}
+
+struct clear_out_1 { float4 c0 [[color(0)]]; };
+struct clear_out_2 { float4 c0 [[color(0)]]; float4 c1 [[color(1)]]; };
+struct clear_out_3 { float4 c0 [[color(0)]]; float4 c1 [[color(1)]]; float4 c2 [[color(2)]]; };
+struct clear_out_4 { float4 c0 [[color(0)]]; float4 c1 [[color(1)]]; float4 c2 [[color(2)]]; float4 c3 [[color(3)]]; };
+
+fragment void clear_fragment_0() {}
+fragment clear_out_1 clear_fragment_1(constant clear_params& p [[buffer(0)]]) { return { p.color }; }
+fragment clear_out_2 clear_fragment_2(constant clear_params& p [[buffer(0)]]) { return { p.color, p.color }; }
+fragment clear_out_3 clear_fragment_3(constant clear_params& p [[buffer(0)]]) { return { p.color, p.color, p.color }; }
+fragment clear_out_4 clear_fragment_4(constant clear_params& p [[buffer(0)]]) { return { p.color, p.color, p.color, p.color }; }
+)";
+
+	// RSX clear mask bits -> Metal colour write mask
+	u8 to_write_mask(u32 rsx_mask)
+	{
+		return static_cast<u8>(((rsx_mask & RSX_GCM_CLEAR_RED_BIT) ? mtl::write_red : 0) |
+			((rsx_mask & RSX_GCM_CLEAR_GREEN_BIT) ? mtl::write_green : 0) |
+			((rsx_mask & RSX_GCM_CLEAR_BLUE_BIT) ? mtl::write_blue : 0) |
+			((rsx_mask & RSX_GCM_CLEAR_ALPHA_BIT) ? mtl::write_alpha : 0));
+	}
+}
+
+void MTLGSRender::begin()
+{
+	rsx::thread::begin();
+
+	if (skip_current_frame || cond_render_ctrl.disable_rendering())
+	{
+		return;
+	}
+
+	init_buffers(rsx::framebuffer_creation_context::context_draw);
+}
+
+void MTLGSRender::init_buffers(rsx::framebuffer_creation_context context)
+{
+	prepare_rtts(context);
+}
+
+void MTLGSRender::prepare_rtts(rsx::framebuffer_creation_context context)
+{
+	const bool clipped_scissor = (context == rsx::framebuffer_creation_context::context_draw);
+	if (m_current_framebuffer_context == context && !m_graphics_state.test(rsx::rtt_config_dirty) && !m_draw_buffers_stale)
+	{
+		// Fast path: framebuffer usage and configuration registers have not changed
+		areau scissor;
+		if (get_scissor(scissor, clipped_scissor))
+		{
+			m_scissor = { scissor.x1, scissor.y1, scissor.width(), scissor.height() };
+		}
+		return;
+	}
+
+	m_graphics_state.clear(
+		rsx::rtt_config_dirty |
+		rsx::rtt_config_contested |
+		rsx::rtt_config_valid |
+		rsx::rtt_cache_state_dirty);
+
+	get_framebuffer_layout(context, m_framebuffer_layout);
+	if (!m_graphics_state.test(rsx::rtt_config_valid))
+	{
+		return;
+	}
+
+	if (!m_draw_buffers_stale && m_framebuffer_layout.ignore_change)
+	{
+		// Nothing has changed, we're still using the same framebuffer
+		areau scissor;
+		if (get_scissor(scissor, clipped_scissor))
+		{
+			m_scissor = { scissor.x1, scissor.y1, scissor.width(), scissor.height() };
+		}
+		return;
+	}
+
+	m_rtts.prepare_render_target(m_commands,
+		m_framebuffer_layout.color_format, m_framebuffer_layout.depth_format,
+		m_framebuffer_layout.width, m_framebuffer_layout.height,
+		m_framebuffer_layout.target, m_framebuffer_layout.aa_mode, m_framebuffer_layout.raster_type,
+		m_framebuffer_layout.color_addresses, m_framebuffer_layout.zeta_address,
+		m_framebuffer_layout.actual_color_pitch, m_framebuffer_layout.actual_zeta_pitch,
+		resolution_scaling_config);
+
+	// The texture cache's memory bookkeeping (surface locks, flushes) is stage M3; the surfaces' guest memory is not
+	// written back yet (counted by the surface store traits when it would be).
+	m_rtts.superseded_surfaces.clear();
+	m_rtts.orphaned_surfaces.clear();
+
+	const auto draw_buffers = rsx::utility::get_rtt_indexes(m_framebuffer_layout.target);
+	m_draw_buffers.clear();
+	for (u8 index : draw_buffers)
+	{
+		if (std::get<1>(m_rtts.m_bound_render_targets[index]))
+		{
+			m_draw_buffers.push_back(index);
+		}
+	}
+
+	m_draw_buffers_stale = false;
+	m_render_pass_dirty = true;
+
+	// As VKGSRender::set_scissor: the scissor changes only when get_scissor recomputed it.
+	areau scissor;
+	if (get_scissor(scissor, clipped_scissor))
+	{
+		m_scissor = { scissor.x1, scissor.y1, scissor.width(), scissor.height() };
+	}
+	on_framebuffer_layout_updated();
+}
+
+mtl::attachment_layout MTLGSRender::current_attachment_layout() const
+{
+	mtl::attachment_layout layout{};
+	for (u8 index : m_draw_buffers)
+	{
+		if (auto surface = std::get<1>(m_rtts.m_bound_render_targets[index]); surface && layout.color_count < layout.color.size())
+		{
+			layout.color[layout.color_count++] = surface->native_format;
+		}
+	}
+
+	if (auto ds = std::get<1>(m_rtts.m_bound_depth_stencil))
+	{
+		layout.depth = true;
+		layout.stencil = mtl::has_stencil(ds->native_format);
+	}
+
+	layout.samples = 1;
+	return layout;
+}
+
+void MTLGSRender::open_render_pass()
+{
+	if (!m_render_pass_dirty && m_commands.kind() == mtl::command_context::encoder_kind::render)
+	{
+		return;
+	}
+
+	mtl::render_pass_descriptor pass{};
+	u32 width = umax, height = umax;
+	u32 attachment = 0;
+	for (u8 index : m_draw_buffers)
+	{
+		if (auto surface = std::get<1>(m_rtts.m_bound_render_targets[index]); surface && surface->texture)
+		{
+			auto& color = pass.color[attachment++];
+			color.texture = surface->texture;
+			color.load = mtl::load_action::load;
+			color.store = mtl::store_action::store;
+			width = std::min(width, surface->width());
+			height = std::min(height, surface->height());
+		}
+	}
+
+	if (auto ds = std::get<1>(m_rtts.m_bound_depth_stencil); ds && ds->texture)
+	{
+		pass.depth.texture = ds->texture;
+		pass.depth.load = mtl::load_action::load;
+		pass.depth.store = mtl::store_action::store;
+		if (mtl::has_stencil(ds->native_format))
+		{
+			pass.stencil.texture = ds->texture;
+			pass.stencil.load = mtl::load_action::load;
+			pass.stencil.store = mtl::store_action::store;
+		}
+		width = std::min(width, ds->width());
+		height = std::min(height, ds->height());
+	}
+
+	if (width == umax)
+	{
+		// No attachment at all (every target disabled): Metal still needs a render size.
+		const auto [w, h] = rsx::apply_resolution_scale<true>(resolution_scaling_config, m_framebuffer_layout.width, m_framebuffer_layout.height);
+		width = w;
+		height = h;
+	}
+
+	pass.render_target_width = std::max(width, 1u);
+	pass.render_target_height = std::max(height, 1u);
+	pass.default_raster_sample_count = 1;  // needed when every target is disabled
+	m_render_pass_size = { pass.render_target_width, pass.render_target_height };
+
+	m_commands.begin_render(pass, ++m_render_pass_serial, "RSX pass");
+	m_render_pass_dirty = false;
+	m_encoder_state_dirty = true;
+}
+
+void MTLGSRender::load_texture_env()
+{
+	// Fragment and vertex texture units the programs reference: described as neutral colour textures (see above).
+	for (u32 textures_ref = current_fp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		if (!fs_sampler_state[i])
+		{
+			fs_sampler_state[i] = std::make_unique<neutral_sampled_image>();
+		}
+
+		const auto& tex = rsx::method_registers.fragment_textures[i];
+		auto& descriptor = *fs_sampler_state[i];
+		if (!tex.enabled())
+		{
+			descriptor.format_class = rsx::RSX_FORMAT_CLASS_UNDEFINED;
+			continue;
+		}
+
+		describe_neutral(descriptor, tex);
+	}
+
+	for (u32 textures_ref = current_vp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		if (!vs_sampler_state[i])
+		{
+			vs_sampler_state[i] = std::make_unique<neutral_sampled_image>();
+		}
+
+		const auto& tex = rsx::method_registers.vertex_textures[i];
+		auto& descriptor = *vs_sampler_state[i];
+		if (!tex.enabled())
+		{
+			descriptor.format_class = rsx::RSX_FORMAT_CLASS_UNDEFINED;
+			continue;
+		}
+
+		describe_neutral(descriptor, tex);
+	}
+}
+
+bool MTLGSRender::load_program()
+{
+	const bool program_state_dirty = !!(m_graphics_state & rsx::pipeline_state::invalidate_pipeline_bits);
+	if (program_state_dirty)
+	{
+		get_current_fragment_program(fs_sampler_state);
+		ensure(current_fragment_program.valid);
+
+		get_current_vertex_program(vs_sampler_state);
+
+		m_graphics_state.clear(rsx::pipeline_state::invalidate_pipeline_bits);
+	}
+
+	const auto attachments = current_attachment_layout();
+	// Programmable blending replaces fixed-function blending (VKGSRender::load_program, force_disable_blending).
+	const bool programmable_blending = !!(current_fragment_program.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING);
+	auto properties = mtl::decode_pipeline_props(rsx::method_registers, attachments,
+		rsx::method_registers.current_draw_clause.primitive, backend_config.supports_hw_a2c, backend_config.supports_hw_a2one, programmable_blending);
+
+	if (m_program && !program_state_dirty && properties == m_pipeline_properties &&
+		!(m_graphics_state & rsx::pipeline_state::pipeline_config_dirty))
+	{
+		return m_program->valid();
+	}
+
+	m_graphics_state.clear(rsx::pipeline_state::pipeline_config_dirty);
+	m_pipeline_properties = properties;
+
+	if (properties.logic_op_requested)
+	{
+		mtl::counters().logic_ops_not_applied.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// Load current program from cache (synchronous compilation in stage M2.2)
+	std::tie(m_program, m_vertex_prog, m_fragment_prog) = m_prog_buffer->get_graphics_pipeline(
+		&m_program_cache_hint,
+		current_vertex_program,
+		current_fragment_program,
+		m_pipeline_properties,
+		false, true);
+
+	m_encoder_state_dirty = true;
+	return m_program && m_program->valid();
+}
+
+void MTLGSRender::upload_transform_constants(const rsx::io_buffer& buffer)
+{
+	const usz transform_constants_size = m_vertex_prog->has_indexed_constants ? 8192 : m_vertex_prog->constant_ids.size() * 16;
+	if (transform_constants_size)
+	{
+		buffer.reserve(transform_constants_size);
+		auto buf = buffer.data();
+
+		const auto constant_ids = (transform_constants_size == 8192)
+			? std::span<const u16>{}
+			: std::span<const u16>(m_vertex_prog->constant_ids);
+		m_draw_processor.fill_vertex_program_constants_data(buf, constant_ids);
+	}
+}
+
+void MTLGSRender::load_program_env()
+{
+	const auto& ctx = REGS(m_ctx);
+
+	const u32 fragment_constants_size = current_fp_metadata.program_constants_buffer_length;
+	const bool update_transform_constants = !!(m_graphics_state & rsx::pipeline_state::transform_constants_dirty);
+	const bool update_fragment_constants = !!(m_graphics_state & rsx::pipeline_state::fragment_constants_dirty);
+	const bool update_vertex_env = !!(m_graphics_state & rsx::pipeline_state::vertex_state_dirty);
+	const bool update_fragment_env = !!(m_graphics_state & rsx::pipeline_state::fragment_state_dirty);
+	const bool update_fragment_texture_env = !!(m_graphics_state & rsx::pipeline_state::fragment_texture_state_dirty);
+	const bool update_raster_env = (ctx->polygon_stipple_enabled() && !!(m_graphics_state & rsx::pipeline_state::polygon_stipple_pattern_dirty)) || !m_stipple_valid;
+	const bool update_instancing_data = ctx->current_draw_clause.is_trivial_instanced_draw;
+
+	if (update_vertex_env || !m_vertex_env_valid)
+	{
+		// Vertex state, std430 layout (VKGSRender::load_program_env)
+		m_vertex_env_offset = m_rings[ring_vertex_env].alloc<256>(96);
+		auto buf = m_rings[ring_vertex_env].map<char>(m_vertex_env_offset);
+
+		m_draw_processor.fill_scale_offset_data(buf, false);
+		m_draw_processor.fill_user_clip_data(buf + 64);
+		*(reinterpret_cast<u32*>(buf + 68)) = ctx->transform_branch_bits();
+		*(reinterpret_cast<f32*>(buf + 72)) = ctx->point_size() * resolution_scaling_config.scale_factor();
+		*(reinterpret_cast<f32*>(buf + 76)) = ctx->clip_min();
+		*(reinterpret_cast<f32*>(buf + 80)) = ctx->clip_max();
+		m_vertex_env_valid = true;
+	}
+
+	if (update_instancing_data)
+	{
+		// Combines transform load + instancing lookup table
+		rsx::io_buffer indirection_table_buf([&](usz size) -> std::pair<void*, usz>
+		{
+			m_instancing_lut_offset = m_rings[ring_instancing].alloc<256>(size);
+			return std::make_pair(m_rings[ring_instancing].map(m_instancing_lut_offset), size);
+		});
+
+		rsx::io_buffer constants_array_buf([&](usz size) -> std::pair<void*, usz>
+		{
+			m_instancing_constants_offset = m_rings[ring_instancing].alloc<256>(size);
+			return std::make_pair(m_rings[ring_instancing].map(m_instancing_constants_offset), size);
+		});
+
+		m_draw_processor.fill_constants_instancing_buffer(indirection_table_buf, constants_array_buf, m_vertex_prog);
+	}
+	else if (update_transform_constants || !m_xform_constants_valid)
+	{
+		auto alloc_storage = [&](usz size) -> std::pair<void*, usz>
+		{
+			m_xform_constants_offset = m_rings[ring_transform_constants].alloc<256>(size);
+			return std::make_pair(m_rings[ring_transform_constants].map(m_xform_constants_offset), size);
+		};
+
+		auto io_buf = rsx::io_buffer(alloc_storage);
+		upload_transform_constants(io_buf);
+		m_xform_constants_valid = true;
+	}
+
+	if ((update_fragment_constants || !m_fragment_constants_valid) && fragment_constants_size)
+	{
+		m_fragment_constants_offset = m_rings[ring_fragment_constants].alloc<256>(fragment_constants_size);
+		auto buf = m_rings[ring_fragment_constants].map(m_fragment_constants_offset);
+
+		m_prog_buffer->fill_fragment_constants_buffer({ reinterpret_cast<float*>(buf), fragment_constants_size },
+			*ensure(m_fragment_prog), current_fragment_program, true);
+		m_fragment_constants_valid = true;
+	}
+
+	if (update_fragment_env || !m_fragment_env_valid)
+	{
+		m_fragment_env_offset = m_rings[ring_fragment_env].alloc<256>(32);
+		auto buf = m_rings[ring_fragment_env].map(m_fragment_env_offset);
+		m_draw_processor.fill_fragment_state_buffer(buf, current_fragment_program);
+		m_fragment_env_valid = true;
+	}
+
+	if (update_fragment_texture_env || !m_texture_parameters_valid)
+	{
+		m_texture_parameters_offset = m_rings[ring_fragment_texture_params].alloc<256>(768);
+		auto buf = m_rings[ring_fragment_texture_params].map(m_texture_parameters_offset);
+		current_fragment_program.texture_params.write_to(buf, current_fp_metadata.referenced_textures_mask);
+		m_texture_parameters_valid = true;
+	}
+
+	if (update_raster_env)
+	{
+		m_stipple_offset = m_rings[ring_raster_env].alloc<256>(128);
+		auto buf = m_rings[ring_raster_env].map(m_stipple_offset);
+		std::memcpy(buf, ctx->polygon_stipple_pattern(), 128);
+		m_graphics_state.clear(rsx::pipeline_state::polygon_stipple_pattern_dirty);
+		m_stipple_valid = true;
+	}
+
+	// Clear flags (as the Vulkan renderer)
+	rsx::flags32_t handled_flags =
+		rsx::pipeline_state::fragment_state_dirty |
+		rsx::pipeline_state::vertex_state_dirty |
+		rsx::pipeline_state::fragment_texture_state_dirty;
+
+	if (!update_instancing_data)
+	{
+		handled_flags |= rsx::pipeline_state::transform_constants_dirty;
+	}
+
+	if (update_fragment_constants)
+	{
+		handled_flags |= rsx::pipeline_state::fragment_constants_dirty;
+	}
+
+	m_graphics_state.clear(handled_flags);
+}
+
+void MTLGSRender::update_vertex_env(u32 id, const mtl::vertex_upload_info& vertex_info)
+{
+#pragma pack(push, 1)
+	struct rsx_prog_vertex_layout_entry_t
+	{
+		u32 vertex_base_index;
+		u32 vertex_index_offset;
+		u32 draw_id;
+		u32 xform_constants_offset;
+		u32 vs_context_offset;
+		u32 fs_constants_offset;
+		u32 fs_context_offset;
+		u32 fs_texture_base_index;
+		u32 fs_stipple_pattern_offset;
+		u32 reserved;
+		s32 attrib_data[1];
+	};
+#pragma pack(pop)
+
+	auto dst = m_rings[ring_vertex_layout].map<rsx_prog_vertex_layout_entry_t>(m_vertex_layout_offset + (168u * id));
+
+	dst->vertex_base_index = vertex_info.vertex_index_base;
+	dst->vertex_index_offset = vertex_info.vertex_index_offset;
+	dst->draw_id = id;
+
+	// Every ring is bound at this draw's element (see the binding scheme at the top of this file).
+	dst->xform_constants_offset = 0;
+	dst->vs_context_offset = 0;
+	dst->fs_constants_offset = 0;
+	dst->fs_context_offset = 0;
+	dst->fs_texture_base_index = 0;
+	dst->fs_stipple_pattern_offset = 0;
+	dst->reserved = 0;
+
+	m_draw_processor.fill_vertex_layout_state(
+		m_vertex_layout,
+		current_vp_metadata,
+		vertex_info.first_vertex,
+		vertex_info.allocated_vertex_count,
+		dst->attrib_data,
+		vertex_info.persistent_window_offset,
+		vertex_info.volatile_window_offset);
+
+	// Push constants (one 32-byte block for both stages, as Vulkan's push constant range):
+	// [0] draw_parameters_offset (vertex), [1..7] blend configuration (fragment, programmable blending).
+	m_push_constants_offset = m_rings[ring_push_constants].alloc<32>(32);
+	auto push = m_rings[ring_push_constants].map<u32>(m_push_constants_offset);
+	push[0] = id;
+
+	if (current_fragment_program.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		push[1] = REGS(m_ctx)->registers[NV4097_SET_BLEND_EQUATION];
+		push[2] = REGS(m_ctx)->registers[NV4097_SET_BLEND_FUNC_SFACTOR];
+		push[3] = REGS(m_ctx)->registers[NV4097_SET_BLEND_FUNC_DFACTOR];
+
+		const auto blend_colors = rsx::get_constant_blend_colors();
+		push[4] = std::bit_cast<u32>(blend_colors[0]);
+		push[5] = std::bit_cast<u32>(blend_colors[1]);
+		push[6] = std::bit_cast<u32>(blend_colors[2]);
+		push[7] = std::bit_cast<u32>(blend_colors[3]);
+	}
+}
+
+void MTLGSRender::bind_vertex_streams(const mtl::vertex_upload_info& info)
+{
+	const auto& slots = *m_program;
+	const auto& table = m_vertex_table;
+	const auto& binding = m_vertex_prog->binding_table;
+
+	// Streams (texel buffers over the attribute ring windows)
+	const auto bind_stream = [&](u32 location, const texel_window& window, u32 base)
+	{
+		const u32 slot = slots.vertex_texture_slot(location);
+		if (slot != umax)
+		{
+			mtl::table_set_texture(table, (base != umax && window.view) ? window.view : m_null_texture_buffer, slot);
+		}
+	};
+	bind_stream(binding.vertex_buffers_location, m_persistent_window, info.persistent_window_offset);
+	bind_stream(binding.vertex_buffers_location + 1, m_volatile_window, info.volatile_window_offset);
+
+	const auto bind_ring = [&](const mtl::object& target_table, u32 slot, ring_id ring, usz offset)
+	{
+		if (slot != umax)
+		{
+			mtl::table_set_buffer(target_table, m_rings[ring].buffer, offset, slot);
+		}
+	};
+
+	// Vertex stage buffers
+	bind_ring(table, slots.vertex_buffer_slot(binding.vertex_buffers_location + 2), ring_vertex_layout, m_vertex_layout_offset);
+	bind_ring(table, slots.vertex_buffer_slot(binding.context_buffer_location), ring_vertex_env, m_vertex_env_offset);
+	if (binding.cbuf_location != umax)
+	{
+		bind_ring(table, slots.vertex_buffer_slot(binding.cbuf_location), ring_transform_constants, m_xform_constants_offset);
+	}
+	if (binding.instanced_lut_buffer_location != umax)
+	{
+		bind_ring(table, slots.vertex_buffer_slot(binding.instanced_lut_buffer_location), ring_instancing, m_instancing_lut_offset);
+		bind_ring(table, slots.vertex_buffer_slot(binding.instanced_cbuf_location), ring_instancing, m_instancing_constants_offset);
+	}
+	mtl::table_set_buffer(table, m_rings[ring_push_constants].buffer, m_push_constants_offset, mtl::push_constant_buffer_slot);
+
+	// Fragment stage buffers
+	const auto& fragment = m_fragment_prog->binding_table;
+	bind_ring(m_fragment_table, slots.fragment_buffer_slot(fragment.context_buffer_location), ring_fragment_env, m_fragment_env_offset);
+	bind_ring(m_fragment_table, slots.fragment_buffer_slot(fragment.tex_param_location), ring_fragment_texture_params, m_texture_parameters_offset);
+	bind_ring(m_fragment_table, slots.fragment_buffer_slot(fragment.polygon_stipple_params_location), ring_raster_env, m_stipple_offset);
+	if (fragment.cbuf_location != umax)
+	{
+		bind_ring(m_fragment_table, slots.fragment_buffer_slot(fragment.cbuf_location), ring_fragment_constants, m_fragment_constants_offset);
+	}
+	mtl::table_set_buffer(m_fragment_table, m_rings[ring_push_constants].buffer, m_push_constants_offset, mtl::push_constant_buffer_slot);
+}
+
+void MTLGSRender::bind_neutral_textures()
+{
+	const auto& slots = *m_program;
+	u32 bound = 0;
+
+	const auto null_for = [&](rsx::texture_dimension_extended dimension) -> const mtl::object&
+	{
+		switch (dimension)
+		{
+		case rsx::texture_dimension_extended::texture_dimension_cubemap: return m_null_textures[2];
+		case rsx::texture_dimension_extended::texture_dimension_3d: return m_null_textures[3];
+		default: return m_null_textures[1];
+		}
+	};
+
+	for (u32 textures_ref = current_fp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		const u32 location = m_fragment_prog->binding_table.ftex_location[i];
+		if (location == umax)
+		{
+			continue;
+		}
+
+		if (const u32 slot = slots.fragment_texture_slot(location); slot != umax)
+		{
+			mtl::table_set_texture(m_fragment_table, null_for(current_fragment_program.get_texture_dimension(i)), slot);
+			bound++;
+		}
+		if (const u32 slot = slots.fragment_sampler_slot(location); slot != umax)
+		{
+			mtl::table_set_sampler(m_fragment_table, m_null_sampler, slot);
+		}
+	}
+
+	for (u32 textures_ref = current_vp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		const u32 location = m_vertex_prog->binding_table.vtex_location[i];
+		if (location == umax)
+		{
+			continue;
+		}
+
+		if (const u32 slot = slots.vertex_texture_slot(location); slot != umax)
+		{
+			mtl::table_set_texture(m_vertex_table, null_for(current_vertex_program.get_texture_dimension(i)), slot);
+			bound++;
+		}
+		if (const u32 slot = slots.vertex_sampler_slot(location); slot != umax)
+		{
+			mtl::table_set_sampler(m_vertex_table, m_null_sampler, slot);
+		}
+	}
+
+	if (bound)
+	{
+		mtl::counters().textures_not_bound.fetch_add(bound, std::memory_order_relaxed);
+	}
+}
+
+const mtl::object& MTLGSRender::get_depth_stencil_state(const mtl::depth_stencil_key& key)
+{
+	const u64 hash = rpcs3::hash_struct(key);
+	auto [it, inserted] = m_depth_stencil_states.try_emplace(hash);
+	if (inserted)
+	{
+		it->second = mtl::new_depth_stencil_state(m_device, key.descriptor());
+	}
+	return it->second;
+}
+
+void MTLGSRender::update_draw_state(const mtl::raster_state& raster)
+{
+	const auto& encoder = m_commands.encoder();
+
+	// The scale_offset matrix already has the viewport transform factored in (VKGSRender::set_viewport).
+	const auto [clip_width, clip_height] = rsx::apply_resolution_scale<true>(
+		resolution_scaling_config, rsx::method_registers.surface_clip_width(), rsx::method_registers.surface_clip_height());
+	mtl::set_viewport(encoder, { 0., 0., static_cast<f64>(clip_width), static_cast<f64>(clip_height), 0., 1. });
+
+	// Metal requires the scissor inside the render target.
+	mtl::scissor_rect scissor = m_scissor;
+	scissor.x = std::min(scissor.x, m_render_pass_size.width);
+	scissor.y = std::min(scissor.y, m_render_pass_size.height);
+	scissor.width = std::min(scissor.width, m_render_pass_size.width - scissor.x);
+	scissor.height = std::min(scissor.height, m_render_pass_size.height - scissor.y);
+	mtl::set_scissor(encoder, scissor);
+
+	mtl::set_cull_mode(encoder, raster.cull);
+	mtl::set_front_facing(encoder, raster.front);
+	mtl::set_depth_clip_mode(encoder, raster.depth_clip);
+	mtl::set_depth_bias(encoder, raster.depth_bias, raster.depth_bias_slope, raster.depth_bias_clamp);
+	mtl::set_stencil_reference(encoder, raster.stencil_front_reference, raster.stencil_back_reference);
+	mtl::set_blend_color(encoder, raster.blend_color[0], raster.blend_color[1], raster.blend_color[2], raster.blend_color[3]);
+}
+
+void MTLGSRender::emit_geometry(u32 sub_index)
+{
+	auto& draw_call = rsx::method_registers.current_draw_clause;
+
+	const rsx::flags32_t vertex_state_mask = rsx::vertex_base_changed | rsx::vertex_arrays_changed;
+	const rsx::flags32_t state_flags = (sub_index == 0) ? rsx::vertex_arrays_changed : draw_call.execute_pipeline_dependencies(m_ctx);
+
+	if (state_flags & rsx::vertex_arrays_changed)
+	{
+		m_draw_processor.analyse_inputs_interleaved(m_vertex_layout, current_vp_metadata);
+	}
+	else if (state_flags & rsx::vertex_base_changed)
+	{
+		for (auto& info : m_vertex_layout.interleaved_blocks)
+		{
+			info->vertex_range.second = 0;
+			const auto vertex_base_offset = rsx::method_registers.vertex_data_base_offset();
+			info->real_offset_address = rsx::get_address(rsx::get_vertex_offset_from_base(vertex_base_offset, info->base_offset), info->memory_location);
+		}
+	}
+	else
+	{
+		for (auto& info : m_vertex_layout.interleaved_blocks)
+		{
+			info->vertex_range.second = 0;
+		}
+	}
+
+	if ((state_flags & vertex_state_mask) && !m_vertex_layout.validate())
+	{
+		// No vertex inputs enabled: execute the remaining pipeline barriers with NOP draws
+		do
+		{
+			draw_call.execute_pipeline_dependencies(m_ctx);
+		}
+		while (draw_call.next());
+
+		draw_call.end();
+		return;
+	}
+
+	auto upload_info = upload_vertex_data();
+	if (!upload_info.vertex_draw_count)
+	{
+		mtl::counters().draws_skipped_no_vertices.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+
+	if (m_subdraw_id == 0)
+	{
+		// Draw parameters for this batch of subdraws
+		m_vertex_layout_offset = m_rings[ring_vertex_layout].alloc<256>(draw_call.pass_count() * 168);
+	}
+
+	update_vertex_env(sub_index, upload_info);
+
+	// Uploads may have submitted (full ring): reopen the pass and reset the encoder state if needed.
+	open_render_pass();
+	const auto& encoder = m_commands.encoder();
+
+	const auto raster = mtl::decode_raster_state(rsx::method_registers);
+	if (raster.cull_both_faces && mtl::get_topology_class(draw_call.primitive) == mtl::topology_class::triangle)
+	{
+		// Vulkan FRONT_AND_BACK culling of triangles rasterizes nothing (MoltenVK disables rasterization).
+		mtl::counters().draws_cull_both_faces.fetch_add(1, std::memory_order_relaxed);
+		m_subdraw_id++;
+		return;
+	}
+
+	mtl::set_render_pipeline(encoder, m_program->pipeline);
+	// Without a depth attachment the depth and stencil tests have no effect (Vulkan); Metal is given no test.
+	const auto attachments = current_attachment_layout();
+	const auto ds_key = attachments.depth ? mtl::decode_depth_stencil(rsx::method_registers, attachments.stencil) : mtl::depth_stencil_key{};
+	mtl::set_depth_stencil_state(encoder, get_depth_stencil_state(ds_key));
+	update_draw_state(raster);
+
+	bind_vertex_streams(upload_info);
+	bind_neutral_textures();
+	mtl::set_argument_table(encoder, m_vertex_table, mtl::stage_vertex);
+	mtl::set_argument_table(encoder, m_fragment_table, mtl::stage_fragment);
+
+	if (!upload_info.index_info)
+	{
+		if (draw_call.is_trivial_instanced_draw)
+		{
+			mtl::draw_primitives(encoder, upload_info.primitive, 0, upload_info.vertex_draw_count, draw_call.pass_count());
+		}
+		else if (draw_call.is_single_draw())
+		{
+			mtl::draw_primitives(encoder, upload_info.primitive, 0, upload_info.vertex_draw_count);
+		}
+		else
+		{
+			u32 vertex_offset = 0;
+			const auto subranges = draw_call.get_subranges();
+			for (const auto& range : subranges)
+			{
+				mtl::draw_primitives(encoder, upload_info.primitive, vertex_offset, range.count);
+				vertex_offset += range.count;
+			}
+		}
+	}
+	else
+	{
+		const auto [offset, type] = *upload_info.index_info;
+		const u32 index_size = (type == mtl::index_type::uint16) ? 2 : 4;
+		const auto& index_buffer = m_rings[ring_index].buffer;
+
+		if (draw_call.is_trivial_instanced_draw)
+		{
+			mtl::draw_indexed_primitives(encoder, upload_info.primitive, upload_info.vertex_draw_count, type, index_buffer,
+				offset, static_cast<u64>(upload_info.vertex_draw_count) * index_size, draw_call.pass_count());
+		}
+		else if (draw_call.is_single_draw())
+		{
+			mtl::draw_indexed_primitives(encoder, upload_info.primitive, upload_info.vertex_draw_count, type, index_buffer,
+				offset, static_cast<u64>(upload_info.vertex_draw_count) * index_size, 1);
+		}
+		else
+		{
+			u32 first_index = 0;
+			const auto subranges = draw_call.get_subranges();
+			for (const auto& range : subranges)
+			{
+				const auto count = get_index_count(draw_call.primitive, range.count);
+				mtl::draw_indexed_primitives(encoder, upload_info.primitive, count, type, index_buffer,
+					offset + static_cast<u64>(first_index) * index_size, static_cast<u64>(count) * index_size, 1);
+				first_index += count;
+			}
+		}
+	}
+
+	mtl::counters().draws_rendered.fetch_add(1, std::memory_order_relaxed);
+	m_subdraw_id++;
+}
+
+void MTLGSRender::end()
+{
+	if (skip_current_frame || !m_graphics_state.test(rsx::rtt_config_valid) || cond_render_ctrl.disable_rendering())
+	{
+		execute_nop_draw();
+		rsx::thread::end();
+		return;
+	}
+
+	analyse_current_rsx_pipeline();
+	load_texture_env();
+
+	if (!load_program())
+	{
+		// Program not available: skip drawing this, as the Vulkan renderer does (counted)
+		mtl::counters().draws_skipped_program.fetch_add(1, std::memory_order_relaxed);
+		execute_nop_draw();
+		rsx::thread::end();
+		return;
+	}
+
+	load_program_env();
+
+	// Surface memory barriers (initialisation, inheritance) before any of this draw's work is encoded.
+	if (auto ds = std::get<1>(m_rtts.m_bound_depth_stencil))
+	{
+		ds->write_barrier(m_commands);
+	}
+
+	for (auto& rtt : m_rtts.m_bound_render_targets)
+	{
+		if (auto surface = std::get<1>(rtt))
+		{
+			surface->write_barrier(m_commands);
+		}
+	}
+
+	if (m_commands.kind() != mtl::command_context::encoder_kind::render)
+	{
+		// A barrier above encoded copies or clears: the render pass must be reopened after them.
+		m_render_pass_dirty = true;
+	}
+
+	m_subdraw_id = 0;
+	auto& draw_call = rsx::method_registers.current_draw_clause;
+	draw_call.begin();
+	u32 sub_index = 0;
+	do
+	{
+		emit_geometry(sub_index++);
+
+		if (draw_call.is_trivial_instanced_draw)
+		{
+			draw_call.end();
+		}
+	}
+	while (draw_call.next());
+
+	m_rtts.on_write(m_framebuffer_layout.color_write_enabled, m_framebuffer_layout.zeta_write_enabled);
+	rsx::thread::end();
+}
+
+bool MTLGSRender::create_clear_library(std::string& error)
+{
+	m_clear_library = mtl::compile_library(m_compiler, clear_source, error);
+	return !!m_clear_library;
+}
+
+const mtl::object& MTLGSRender::get_clear_pipeline(u32 color_write_mask)
+{
+	const auto attachments = current_attachment_layout();
+
+	// Key: attachment formats, depth/stencil presence and the write mask.
+	u64 key = color_write_mask;
+	key = key * 31 + attachments.color_count;
+	for (u32 i = 0; i < attachments.color_count; ++i)
+	{
+		key = key * 1009 + static_cast<u32>(attachments.color[i]);
+	}
+	key = key * 7 + (attachments.depth ? 1 : 0) + (attachments.stencil ? 2 : 0);
+
+	auto [it, inserted] = m_clear_pipelines.try_emplace(key);
+	if (inserted)
+	{
+		mtl::render_pipeline_descriptor desc{};
+		desc.library = m_clear_library;
+		desc.vertex_function = "clear_vertex";
+		desc.fragment_function = fmt::format("clear_fragment_%u", attachments.color_count);
+		for (u32 i = 0; i < attachments.color_count; ++i)
+		{
+			desc.color[i].format = attachments.color[i];
+			desc.color[i].write_mask = color_write_mask;
+		}
+		desc.label = "RSX clear";
+
+		std::string error;
+		it->second = mtl::new_render_pipeline(m_compiler, desc, error);
+		if (!it->second)
+		{
+			rsx_log.error("Metal: clear pipeline: %s", error);
+		}
+	}
+
+	return it->second;
+}
+
+void MTLGSRender::clear_attachments(u32 color_write_mask, bool clear_depth, bool clear_stencil, f32 depth, u8 stencil,
+	u8 stencil_write_mask, const std::array<f32, 4>& color)
+{
+	const auto& pipeline = get_clear_pipeline(color_write_mask);
+	if (!pipeline)
+	{
+		return;
+	}
+
+	struct
+	{
+		f32 color[4];
+		f32 depth[4];
+	} params{ { color[0], color[1], color[2], color[3] }, { depth, 0.f, 0.f, 0.f } };
+
+	// Allocated before the pass is opened, as in emit_geometry: a full ring submits, which ends the encoder.
+	const usz offset = m_rings[ring_push_constants].alloc<32>(sizeof(params));
+	std::memcpy(m_rings[ring_push_constants].map(offset), &params, sizeof(params));
+
+	open_render_pass();
+	const auto& encoder = m_commands.encoder();
+
+	mtl::depth_stencil_key ds{};
+	ds.depth_compare = static_cast<u8>(mtl::compare_function::always);
+	ds.depth_write = clear_depth ? 1 : 0;
+	if (clear_stencil)
+	{
+		ds.stencil = 1;
+		ds.front.compare = static_cast<u8>(mtl::compare_function::always);
+		ds.front.depth_stencil_pass = static_cast<u8>(mtl::stencil_operation::replace);
+		ds.front.depth_fail = static_cast<u8>(mtl::stencil_operation::replace);
+		ds.front.write_mask = stencil_write_mask;
+		ds.back = ds.front;
+	}
+
+	mtl::set_render_pipeline(encoder, pipeline);
+	mtl::set_depth_stencil_state(encoder, get_depth_stencil_state(ds));
+	mtl::set_stencil_reference(encoder, stencil, stencil);
+	// vkCmdClearAttachments ignores the rasterization state: no culling and no depth bias left by the last draw
+	// (MoltenVK's helper draw resets both the same way).
+	mtl::set_cull_mode(encoder, mtl::cull_mode::none);
+	mtl::set_depth_bias(encoder, 0.f, 0.f, 0.f);
+	mtl::set_depth_clip_mode(encoder, mtl::depth_clip_mode::clip);
+	mtl::set_viewport(encoder, { 0., 0., static_cast<f64>(m_render_pass_size.width), static_cast<f64>(m_render_pass_size.height), 0., 1. });
+
+	mtl::scissor_rect scissor = m_scissor;
+	scissor.x = std::min(scissor.x, m_render_pass_size.width);
+	scissor.y = std::min(scissor.y, m_render_pass_size.height);
+	scissor.width = std::min(scissor.width, m_render_pass_size.width - scissor.x);
+	scissor.height = std::min(scissor.height, m_render_pass_size.height - scissor.y);
+	mtl::set_scissor(encoder, scissor);
+
+	mtl::table_set_buffer(m_vertex_table, m_rings[ring_push_constants].buffer, offset, 0);
+	mtl::table_set_buffer(m_fragment_table, m_rings[ring_push_constants].buffer, offset, 0);
+	mtl::set_argument_table(encoder, m_vertex_table, mtl::stage_vertex);
+	mtl::set_argument_table(encoder, m_fragment_table, mtl::stage_fragment);
+	mtl::draw_primitives(encoder, mtl::primitive_type::triangle, 0, 3);
+
+	m_encoder_state_dirty = true;
+	mtl::counters().clears.fetch_add(1, std::memory_order_relaxed);
+}
+
+void MTLGSRender::clear_surface(u32 mask)
+{
+	if (skip_current_frame) return;
+
+	// If stencil write mask is disabled, remove clear_stencil bit
+	if (!rsx::method_registers.stencil_mask()) mask &= ~RSX_GCM_CLEAR_STENCIL_BIT;
+
+	// Ignore invalid clear flags
+	if (!(mask & RSX_GCM_CLEAR_ANY_MASK)) return;
+
+	u8 ctx = rsx::framebuffer_creation_context::context_draw;
+	if (mask & RSX_GCM_CLEAR_COLOR_RGBA_MASK) ctx |= rsx::framebuffer_creation_context::context_clear_color;
+	if (mask & RSX_GCM_CLEAR_DEPTH_STENCIL_MASK) ctx |= rsx::framebuffer_creation_context::context_clear_depth;
+	init_buffers(rsx::framebuffer_creation_context{ctx});
+
+	if (!m_graphics_state.test(rsx::rtt_config_valid))
+	{
+		return;
+	}
+
+	bool clear_depth = false, clear_stencil = false;
+	f32 depth_clear = 1.f;
+	u8 stencil_clear = 0;
+	bool update_color = false, update_z = false;
+	const auto surface_depth_format = rsx::method_registers.surface_depth_fmt();
+
+	if (auto ds = std::get<1>(m_rtts.m_bound_depth_stencil); ds && (mask & RSX_GCM_CLEAR_DEPTH_STENCIL_MASK))
+	{
+		if (mask & RSX_GCM_CLEAR_DEPTH_BIT)
+		{
+			const u32 max_depth_value = get_max_depth_value(surface_depth_format);
+			const u32 clear_depth_value = rsx::method_registers.z_clear_value(is_depth_stencil_format(surface_depth_format));
+			depth_clear = static_cast<f32>(clear_depth_value) / max_depth_value;
+			clear_depth = true;
+		}
+
+		if (is_depth_stencil_format(surface_depth_format) && (mask & RSX_GCM_CLEAR_STENCIL_BIT))
+		{
+			stencil_clear = rsx::method_registers.stencil_clear_value();
+			clear_stencil = true;
+		}
+
+		// A partial clear needs the surface initialised first (VKGSRender::clear_surface, without guest-memory loads).
+		ds->write_barrier(m_commands);
+		update_z = clear_depth || clear_stencil;
+	}
+
+	u32 color_write_mask = 0;
+	std::array<f32, 4> color{};
+	if (auto colormask = (mask & RSX_GCM_CLEAR_COLOR_RGBA_MASK); colormask && !m_draw_buffers.empty())
+	{
+		u8 clear_a = rsx::method_registers.clear_color_a();
+		u8 clear_r = rsx::method_registers.clear_color_r();
+		u8 clear_g = rsx::method_registers.clear_color_g();
+		u8 clear_b = rsx::method_registers.clear_color_b();
+
+		switch (rsx::method_registers.surface_color())
+		{
+		case rsx::surface_color_format::x32:
+		case rsx::surface_color_format::w16z16y16x16:
+		case rsx::surface_color_format::w32z32y32x32:
+			// NOP (as the Vulkan renderer)
+			colormask = 0;
+			break;
+		case rsx::surface_color_format::b8:
+			rsx::get_b8_clear_color(clear_r, clear_g, clear_b, clear_a);
+			colormask = rsx::get_b8_clearmask(colormask);
+			break;
+		case rsx::surface_color_format::g8b8:
+			rsx::get_g8b8_clear_color(clear_r, clear_g, clear_b, clear_a);
+			colormask = rsx::get_g8b8_r8g8_clearmask(colormask);
+			break;
+		case rsx::surface_color_format::r5g6b5:
+			rsx::get_rgb565_clear_color(clear_r, clear_g, clear_b, clear_a);
+			break;
+		case rsx::surface_color_format::x1r5g5b5_o1r5g5b5:
+			rsx::get_a1rgb555_clear_color(clear_r, clear_g, clear_b, clear_a, 255);
+			break;
+		case rsx::surface_color_format::x1r5g5b5_z1r5g5b5:
+			rsx::get_a1rgb555_clear_color(clear_r, clear_g, clear_b, clear_a, 0);
+			break;
+		case rsx::surface_color_format::a8b8g8r8:
+		case rsx::surface_color_format::x8b8g8r8_o8b8g8r8:
+		case rsx::surface_color_format::x8b8g8r8_z8b8g8r8:
+			rsx::get_abgr8_clear_color(clear_r, clear_g, clear_b, clear_a);
+			colormask = rsx::get_abgr8_clearmask(colormask);
+			break;
+		default:
+			break;
+		}
+
+		if (colormask)
+		{
+			for (const auto& index : m_rtts.m_bound_render_target_ids)
+			{
+				m_rtts.m_bound_render_targets[index].second->write_barrier(m_commands);
+			}
+
+			color = { clear_r / 255.f, clear_g / 255.f, clear_b / 255.f, clear_a / 255.f };
+			color_write_mask = to_write_mask(colormask);
+			update_color = true;
+		}
+	}
+
+	if (m_commands.kind() != mtl::command_context::encoder_kind::render)
+	{
+		m_render_pass_dirty = true;
+	}
+
+	if (update_color || update_z)
+	{
+		clear_attachments(color_write_mask, clear_depth, clear_stencil, depth_clear, stencil_clear,
+			rsx::method_registers.stencil_mask(), color);
+		m_rtts.on_write({ update_color, update_color, update_color, update_color }, update_z);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFormats.cpp b/rpcs3/Emu/RSX/Metal/MTLFormats.cpp
new file mode 100644
index 0000000..5046762
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFormats.cpp
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2/M3): RSX surface formats -> Metal pixel formats (the MoltenVK mapping of the
+// Vulkan renderer's choices).
+
+#include "stdafx.h"
+#include "MTLFormats.h"
+
+namespace mtl
+{
+	surface_format get_compatible_surface_format(rsx::surface_color_format format)
+	{
+		constexpr component_map o_rgb{ swizzle::red, swizzle::green, swizzle::blue, swizzle::one };
+		constexpr component_map z_rgb{ swizzle::red, swizzle::green, swizzle::blue, swizzle::zero };
+
+		switch (format)
+		{
+		// VK_FORMAT_R5G6B5_UNORM_PACK16 / VK_FORMAT_A1R5G5B5_UNORM_PACK16 on Apple GPUs (MoltenVK: B5G6R5Unorm, BGR5A1Unorm).
+		case rsx::surface_color_format::r5g6b5:
+			return { pixel_format::b5g6r5_unorm, default_component_map };
+		case rsx::surface_color_format::x1r5g5b5_o1r5g5b5:
+			return { pixel_format::bgr5a1_unorm, o_rgb };
+		case rsx::surface_color_format::x1r5g5b5_z1r5g5b5:
+			return { pixel_format::bgr5a1_unorm, z_rgb };
+
+		case rsx::surface_color_format::a8r8g8b8:
+			return { pixel_format::bgra8_unorm, default_component_map };
+		case rsx::surface_color_format::a8b8g8r8:
+			return { pixel_format::rgba8_unorm, default_component_map };
+		case rsx::surface_color_format::x8b8g8r8_o8b8g8r8:
+			return { pixel_format::rgba8_unorm, o_rgb };
+		case rsx::surface_color_format::x8b8g8r8_z8b8g8r8:
+			return { pixel_format::rgba8_unorm, z_rgb };
+		case rsx::surface_color_format::x8r8g8b8_z8r8g8b8:
+			return { pixel_format::bgra8_unorm, z_rgb };
+		case rsx::surface_color_format::x8r8g8b8_o8r8g8b8:
+			return { pixel_format::bgra8_unorm, o_rgb };
+
+		case rsx::surface_color_format::w16z16y16x16:
+			return { pixel_format::rgba16_float, default_component_map };
+		case rsx::surface_color_format::w32z32y32x32:
+			return { pixel_format::rgba32_float, default_component_map };
+
+		case rsx::surface_color_format::b8:
+			return { pixel_format::r8_unorm, { swizzle::red, swizzle::red, swizzle::red, swizzle::one } };
+		case rsx::surface_color_format::g8b8:
+			return { pixel_format::rg8_unorm, { swizzle::red, swizzle::green, swizzle::red, swizzle::green } };
+		case rsx::surface_color_format::x32:
+			return { pixel_format::r32_float, { swizzle::red, swizzle::red, swizzle::red, swizzle::red } };
+		}
+
+		rsx_log.error("Surface color buffer: Unsupported surface color format (0x%x)", static_cast<u32>(format));
+		return { pixel_format::bgra8_unorm, default_component_map };
+	}
+
+	pixel_format get_compatible_depth_surface_format(rsx::surface_depth_format2 format)
+	{
+		switch (format)
+		{
+		case rsx::surface_depth_format2::z16_uint: return pixel_format::depth16_unorm;
+		case rsx::surface_depth_format2::z16_float: return pixel_format::depth32_float;
+		case rsx::surface_depth_format2::z24s8_uint: return pixel_format::depth32_float_stencil8;
+		case rsx::surface_depth_format2::z24s8_float: return pixel_format::depth32_float_stencil8;
+		}
+
+		fmt::throw_exception("Invalid format (0x%x)", static_cast<u32>(format));
+	}
+
+	bool is_depth_format(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::depth16_unorm:
+		case pixel_format::depth32_float:
+		case pixel_format::depth24_unorm_stencil8:
+		case pixel_format::depth32_float_stencil8:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	bool has_stencil(pixel_format format)
+	{
+		return format == pixel_format::depth24_unorm_stencil8 || format == pixel_format::depth32_float_stencil8 ||
+			format == pixel_format::stencil8 || format == pixel_format::x32_stencil8;
+	}
+
+	u32 get_texel_size(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::a8_unorm:
+		case pixel_format::r8_unorm:
+		case pixel_format::r8_snorm:
+		case pixel_format::r8_uint:
+		case pixel_format::stencil8:
+			return 1;
+		case pixel_format::r16_unorm:
+		case pixel_format::r16_snorm:
+		case pixel_format::r16_uint:
+		case pixel_format::r16_float:
+		case pixel_format::rg8_unorm:
+		case pixel_format::rg8_snorm:
+		case pixel_format::b5g6r5_unorm:
+		case pixel_format::a1bgr5_unorm:
+		case pixel_format::abgr4_unorm:
+		case pixel_format::bgr5a1_unorm:
+		case pixel_format::depth16_unorm:
+			return 2;
+		case pixel_format::r32_uint:
+		case pixel_format::r32_sint:
+		case pixel_format::r32_float:
+		case pixel_format::rg16_unorm:
+		case pixel_format::rg16_snorm:
+		case pixel_format::rg16_float:
+		case pixel_format::rgba8_unorm:
+		case pixel_format::rgba8_unorm_srgb:
+		case pixel_format::rgba8_snorm:
+		case pixel_format::rgba8_uint:
+		case pixel_format::bgra8_unorm:
+		case pixel_format::bgra8_unorm_srgb:
+		case pixel_format::rgb10a2_unorm:
+		case pixel_format::rg11b10_float:
+		case pixel_format::rgb9e5_float:
+		case pixel_format::bgr10a2_unorm:
+		case pixel_format::depth32_float:
+			return 4;
+		case pixel_format::rg32_uint:
+		case pixel_format::rg32_float:
+		case pixel_format::rgba16_unorm:
+		case pixel_format::rgba16_snorm:
+		case pixel_format::rgba16_uint:
+		case pixel_format::rgba16_float:
+			return 8;
+		case pixel_format::rgba32_uint:
+		case pixel_format::rgba32_float:
+			return 16;
+		default:
+			// Including depth32_float_stencil8: Metal copies its depth (4 bytes) and stencil (1 byte) planes separately.
+			return 0;
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFormats.h b/rpcs3/Emu/RSX/Metal/MTLFormats.h
new file mode 100644
index 0000000..01da0b9
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFormats.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2/M3): RSX surface formats for the native Metal 4 renderer.
+// The Vulkan renderer's choices (VKGSRender.cpp get_compatible_surface_format, VKFormats.cpp
+// get_compatible_depth_surface_format) mapped through MoltenVK's Vulkan -> Metal pixel format table, so a surface
+// has the same layout, precision and channel mapping as on the MoltenVK path. iPhone GPUs have no D24S8: 24-bit
+// depth surfaces are Depth32Float_Stencil8 (as on MoltenVK), with exact conversions to guest memory.
+
+#include "MTLAPI.h"
+
+#include "Emu/RSX/gcm_enums.h"
+
+#include <array>
+
+namespace mtl
+{
+	// MTLTextureSwizzle
+	enum class swizzle : u8
+	{
+		zero = 0,
+		one = 1,
+		red = 2,
+		green = 3,
+		blue = 4,
+		alpha = 5,
+	};
+
+	using component_map = std::array<swizzle, 4>;
+	inline constexpr component_map default_component_map{ swizzle::red, swizzle::green, swizzle::blue, swizzle::alpha };
+
+	struct surface_format
+	{
+		pixel_format format;
+		component_map mapping;
+	};
+
+	surface_format get_compatible_surface_format(rsx::surface_color_format format);
+	pixel_format get_compatible_depth_surface_format(rsx::surface_depth_format2 format);
+
+	bool is_depth_format(pixel_format format);
+	bool has_stencil(pixel_format format);
+
+	// Bytes per texel of the uncompressed formats the renderer creates (0 for anything else).
+	u32 get_texel_size(pixel_format format);
+}
