diff --git a/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp
new file mode 100644
index 0000000..77845a2
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.cpp
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): program cache traits and pipeline builds of the native Metal 4 renderer.
+
+#include "stdafx.h"
+#include "MTLProgramBuffer.h"
+
+namespace mtl
+{
+	namespace
+	{
+		pipeline_environment g_environment{};
+		pipeline_counters g_counters{};
+
+		u32 find_slot(const std::vector<resource_slot>& slots, u32 location, u32 resource_slot::*member)
+		{
+			for (const auto& slot : slots)
+			{
+				if (slot.location == location && slot.type != glsl::input_type_push_constant)
+				{
+					return slot.*member;
+				}
+			}
+			return umax;
+		}
+	}
+
+	void set_pipeline_environment(const pipeline_environment& environment)
+	{
+		g_environment = environment;
+	}
+
+	const pipeline_environment& get_pipeline_environment()
+	{
+		return g_environment;
+	}
+
+	pipeline_counters& get_pipeline_counters()
+	{
+		return g_counters;
+	}
+
+	u32 program::vertex_buffer_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::buffer); }
+	u32 program::vertex_texture_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::texture); }
+	u32 program::vertex_sampler_slot(u32 location) const { return find_slot(vertex_slots, location, &resource_slot::sampler); }
+	u32 program::fragment_buffer_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::buffer); }
+	u32 program::fragment_texture_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::texture); }
+	u32 program::fragment_sampler_slot(u32 location) const { return find_slot(fragment_slots, location, &resource_slot::sampler); }
+
+	bool program::fragment_reads_push_constants() const
+	{
+		for (const auto& slot : fragment_slots)
+		{
+			if (slot.type == glsl::input_type_push_constant)
+			{
+				return slot.used;
+			}
+		}
+		return false;
+	}
+
+	void MTLTraits::recompile_fragment_program(const RSXFragmentProgram& RSXFP, fragment_program_type& fragmentProgramData, usz ID)
+	{
+		fragmentProgramData.Decompile(RSXFP, g_environment.caps);
+		fragmentProgramData.id = static_cast<u32>(ID);
+		g_counters.fragment_programs++;
+
+		if (!fragmentProgramData.Compile())
+		{
+			g_counters.glsl_failures++;
+			rsx_log.error("Metal: fragment program %u: %s", fragmentProgramData.id, fragmentProgramData.compile_error);
+		}
+	}
+
+	void MTLTraits::recompile_vertex_program(const RSXVertexProgram& RSXVP, vertex_program_type& vertexProgramData, usz ID)
+	{
+		vertexProgramData.Decompile(RSXVP, g_environment.caps);
+		vertexProgramData.id = static_cast<u32>(ID);
+		g_counters.vertex_programs++;
+
+		if (!vertexProgramData.Compile())
+		{
+			g_counters.glsl_failures++;
+			rsx_log.error("Metal: vertex program %u: %s", vertexProgramData.id, vertexProgramData.compile_error);
+		}
+	}
+
+	void MTLTraits::validate_pipeline_properties(const vertex_program_type&, const fragment_program_type& fp, pipeline_properties& properties)
+	{
+		// Explicitly disable writing to undefined registers (as VKTraits does with the colour write masks).
+		for (u32 index = 0; index < properties.color.size(); ++index)
+		{
+			if (!fp.output_color_masks[index])
+			{
+				properties.color[index].write_mask = 0;
+			}
+		}
+	}
+
+	MTLTraits::pipeline_type* MTLTraits::build_pipeline(
+		const vertex_program_type& vertexProgramData,
+		const fragment_program_type& fragmentProgramData,
+		const pipeline_properties& pipelineProperties,
+		bool /*compile_async*/,
+		std::function<pipeline_type*(pipeline_storage_type&)> callback)
+	{
+		auto result = std::make_unique<program>();
+		const auto& props = pipelineProperties;
+
+		object vertex_library;
+		object fragment_library;
+		std::string vertex_entry;
+		std::string fragment_entry;
+
+		// Vertex stage: one translation per primitive class, one library per translation.
+		{
+			const bool points = props.topology == static_cast<u8>(topology_class::point);
+			const u32 variant = points ? 1 : 0;
+
+			std::lock_guard lock(vertexProgramData.translation_lock);
+			if (vertexProgramData.spirv.empty())
+			{
+				result->error = fmt::format("vertex program %u has no SPIR-V (%s)", vertexProgramData.id, vertexProgramData.compile_error);
+			}
+			else if (const auto& msl = vertexProgramData.get_msl(points); !msl.ok)
+			{
+				g_counters.translation_failures++;
+				result->error = fmt::format("vertex program %u: %s", vertexProgramData.id, msl.error);
+			}
+			else
+			{
+				auto& library = vertexProgramData.library[variant];
+				auto& library_error = vertexProgramData.library_error[variant];
+				if (!library && library_error.empty())
+				{
+					library = compile_library(g_environment.compiler, msl.msl, { g_environment.fast_math, msl.position_invariant }, library_error);
+					if (!library)
+					{
+						g_counters.library_failures++;
+						rsx_log.error("Metal: vertex program %u does not compile: %s", vertexProgramData.id, library_error);
+					}
+				}
+
+				if (library)
+				{
+					vertex_library = library;
+					vertex_entry = msl.entry_point;
+					result->vertex_slots = msl.slots;
+				}
+				else
+				{
+					result->error = fmt::format("vertex program %u: %s", vertexProgramData.id, library_error);
+				}
+			}
+		}
+
+		// Fragment stage: one translation per render-pass variant.
+		if (result->error.empty())
+		{
+			fragment_variant_key key{};
+			key.depth_attachment = !!props.depth_attachment;
+			key.stencil_attachment = !!props.stencil_attachment;
+			// Only outputs with a colour attachment (MoltenVK's enable_frag_output_mask); alpha-to-coverage needs output 0.
+			key.color_output_mask = props.color_count ? ((1u << props.color_count) - 1) : (props.alpha_to_coverage ? 1u : 0u);
+
+			std::lock_guard lock(fragmentProgramData.translation_lock);
+			if (fragmentProgramData.spirv.empty())
+			{
+				result->error = fmt::format("fragment program %u has no SPIR-V (%s)", fragmentProgramData.id, fragmentProgramData.compile_error);
+			}
+			else if (auto& variant = fragmentProgramData.get_variant(key); !variant.msl.ok)
+			{
+				g_counters.translation_failures++;
+				result->error = fmt::format("fragment program %u: %s", fragmentProgramData.id, variant.msl.error);
+			}
+			else
+			{
+				if (!variant.library && variant.library_error.empty())
+				{
+					variant.library = compile_library(g_environment.compiler, variant.msl.msl, { g_environment.fast_math, false }, variant.library_error);
+					if (!variant.library)
+					{
+						g_counters.library_failures++;
+						rsx_log.error("Metal: fragment program %u does not compile: %s", fragmentProgramData.id, variant.library_error);
+					}
+				}
+
+				if (variant.library)
+				{
+					fragment_library = variant.library;
+					fragment_entry = variant.msl.entry_point;
+					result->fragment_slots = variant.msl.slots;
+				}
+				else
+				{
+					result->error = fmt::format("fragment program %u: %s", fragmentProgramData.id, variant.library_error);
+				}
+			}
+		}
+
+		if (result->error.empty())
+		{
+			render_pipeline_descriptor desc{};
+			desc.vertex_library = vertex_library;
+			desc.fragment_library = fragment_library;
+			desc.vertex_function = vertex_entry;
+			desc.fragment_function = fragment_entry;
+			for (u32 index = 0; index < props.color_count && index < props.color.size(); ++index)
+			{
+				desc.color[index] = props.color[index].attachment_state();
+			}
+			desc.sample_count = props.sample_count;
+			desc.alpha_to_coverage = !!props.alpha_to_coverage;
+			desc.alpha_to_one = !!props.alpha_to_one;
+			desc.input_topology = props.topology;
+			desc.label = fmt::format("RSX vp%u fp%u", vertexProgramData.id, fragmentProgramData.id);
+
+			std::string error;
+			result->pipeline = new_render_pipeline(g_environment.compiler, desc, error);
+			if (result->pipeline)
+			{
+				g_counters.pipelines++;
+			}
+			else
+			{
+				result->error = fmt::format("pipeline vp%u fp%u: %s", vertexProgramData.id, fragmentProgramData.id, error);
+			}
+		}
+
+		if (!result->error.empty())
+		{
+			g_counters.pipeline_failures++;
+			rsx_log.error("Metal: %s", result->error);
+		}
+
+		return callback(result);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h
new file mode 100644
index 0000000..449947b
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLProgramBuffer.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2.2): the program cache of the native Metal 4 renderer.
+//
+// RPCS3's shared program_state_cache (the one the Vulkan and OpenGL renderers use) keys vertex and fragment
+// programs by their microcode and pipelines by (programs, pipeline_props). MTLTraits plugs the Metal stack in:
+// decompile + glslang on first sight of a program, SPIR-V -> MSL and MTL4 library compilation on first use of a
+// translation variant (both cached on the program), and one MTLRenderPipelineState per key. A program or pipeline
+// that fails is kept with its error (logged once) and its draws are skipped and counted by the renderer, exactly
+// as the Vulkan renderer skips draws whose program is not available.
+
+#include "Emu/RSX/Program/ProgramStateCache.h"
+#include "MTLAPI.h"
+#include "MTLFragmentProgram.h"
+#include "MTLPipelineState.h"
+#include "MTLShaderTranslator.h"
+#include "MTLVertexProgram.h"
+
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	// What a program cache build needs from the renderer; set once by MTLGSRender::on_init_thread.
+	struct pipeline_environment
+	{
+		object device;
+		object compiler;
+		shader_device_caps caps{};
+		bool fast_math = true;   // !g_cfg.video.disable_msl_fast_math, read when the renderer starts
+	};
+
+	void set_pipeline_environment(const pipeline_environment& environment);
+	const pipeline_environment& get_pipeline_environment();
+
+	struct pipeline_counters
+	{
+		std::atomic<u64> vertex_programs{0};
+		std::atomic<u64> fragment_programs{0};
+		std::atomic<u64> glsl_failures{0};
+		std::atomic<u64> translation_failures{0};
+		std::atomic<u64> library_failures{0};
+		std::atomic<u64> pipelines{0};
+		std::atomic<u64> pipeline_failures{0};
+	};
+
+	pipeline_counters& get_pipeline_counters();
+
+	// A linked program: the render pipeline state for one key, with both stages' argument-table slots.
+	class program
+	{
+	public:
+		object pipeline;
+		std::vector<resource_slot> vertex_slots;
+		std::vector<resource_slot> fragment_slots;
+		std::string error;
+
+		bool valid() const { return !!pipeline; }
+
+		// The Metal slot of a GLSL (set, binding) of each stage, or umax when the stage does not declare it.
+		u32 vertex_buffer_slot(u32 location) const;
+		u32 vertex_texture_slot(u32 location) const;
+		u32 vertex_sampler_slot(u32 location) const;
+		u32 fragment_buffer_slot(u32 location) const;
+		u32 fragment_texture_slot(u32 location) const;
+		u32 fragment_sampler_slot(u32 location) const;
+		bool fragment_reads_push_constants() const;
+	};
+
+	struct MTLTraits
+	{
+		using vertex_program_type = mtl::vertex_program;
+		using fragment_program_type = mtl::fragment_program;
+		using pipeline_type = mtl::program;
+		using pipeline_storage_type = std::unique_ptr<mtl::program>;
+		using pipeline_properties = mtl::pipeline_props;
+
+		static void recompile_fragment_program(const RSXFragmentProgram& RSXFP, fragment_program_type& fragmentProgramData, usz ID);
+		static void recompile_vertex_program(const RSXVertexProgram& RSXVP, vertex_program_type& vertexProgramData, usz ID);
+		static void validate_pipeline_properties(const vertex_program_type& vp, const fragment_program_type& fp, pipeline_properties& properties);
+		static pipeline_type* build_pipeline(
+			const vertex_program_type& vertexProgramData,
+			const fragment_program_type& fragmentProgramData,
+			const pipeline_properties& pipelineProperties,
+			bool compile_async,
+			std::function<pipeline_type*(pipeline_storage_type&)> callback);
+	};
+
+	struct program_cache : public program_state_cache<MTLTraits>
+	{
+		program_cache(decompiler_callback_t callback)
+		{
+			notify_pipeline_compiled = callback;
+		}
+
+		u64 get_hash(const mtl::pipeline_props& props)
+		{
+			return rpcs3::hash_struct<mtl::pipeline_props>(props);
+		}
+
+		u64 get_hash(const RSXVertexProgram& prog)
+		{
+			return program_hash_util::vertex_program_utils::get_vertex_program_ucode_hash(prog);
+		}
+
+		u64 get_hash(const RSXFragmentProgram& prog)
+		{
+			return program_hash_util::fragment_program_utils::get_fragment_program_ucode_hash(prog);
+		}
+
+		bool check_cache_missed() const
+		{
+			return m_cache_miss_flag;
+		}
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLRenderTargets.cpp b/rpcs3/Emu/RSX/Metal/MTLRenderTargets.cpp
new file mode 100644
index 0000000..6012d47
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLRenderTargets.cpp
@@ -0,0 +1,462 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2.2): render targets of the native Metal 4 renderer (VKRenderTargets.cpp counterpart).
+
+#include "stdafx.h"
+#include "MTLRenderTargets.h"
+
+#include "Emu/RSX/Common/TextureUtils.h"
+#include "Emu/system_config.h"
+
+namespace mtl
+{
+	namespace
+	{
+		surface_counters g_surface_counters{};
+		command_context* g_command_context = nullptr;
+
+		// Stage M2.2 renders single-sampled textures, as the Vulkan renderer with the "MSAA: Disabled" setting
+		// (until M4). As there, the descriptor's sample metrics keep the RSX AA mode: they define the guest-memory
+		// layout of the surface (pitch, extent), not the host texture.
+		constexpr u8 surface_samples = 1;
+		constexpr auto surface_sample_layout = rsx::surface_sample_layout::null;
+	}
+
+	surface_counters& get_surface_counters()
+	{
+		return g_surface_counters;
+	}
+
+	void set_command_context(command_context* ctx)
+	{
+		g_command_context = ctx;
+	}
+
+	command_context* get_command_context()
+	{
+		return g_command_context;
+	}
+
+	render_target::~render_target()
+	{
+		if (texture && g_command_context)
+		{
+			// The GPU may still read it: released once the work recorded so far has completed.
+			g_command_context->dispose(std::move(texture), true);
+		}
+	}
+
+	render_target* render_target::get_surface(rsx::surface_access /*access_type*/)
+	{
+		last_rw_access_tag = rsx::get_shared_tag();
+		return this;
+	}
+
+	bool render_target::is_depth_surface() const
+	{
+		return is_depth_format(native_format);
+	}
+
+	bool render_target::matches_dimensions(u16 surface_width_, u16 surface_height_) const
+	{
+		// Use forward scaling to account for rounding and clamping errors (as the Vulkan renderer does)
+		const auto [scaled_w, scaled_h] = rsx::apply_resolution_scale<true>(resolution_scaling_config, surface_width_, surface_height_);
+		return (scaled_w == texture_width) && (scaled_h == texture_height);
+	}
+
+	void render_target::reset_surface_counters()
+	{
+		frame_tag = 0;
+	}
+
+	bool render_target::allocate(command_context& ctx, pixel_format format, u32 texture_width, u32 texture_height, bool depth)
+	{
+		texture_descriptor desc{};
+		desc.type = texture_type::type_2d;
+		desc.format = format;
+		desc.width = std::max(texture_width, 1u);
+		desc.height = std::max(texture_height, 1u);
+		desc.usage = usage_render_target | usage_shader_read | (depth ? 0 : usage_pixel_format_view);
+		desc.storage = storage_mode::private_;
+
+		texture = new_texture(ctx.device(), desc);
+		if (!texture)
+		{
+			rsx_log.error("Metal: surface texture allocation failed (%ux%u, format %u)", desc.width, desc.height, static_cast<u32>(format));
+			return false;
+		}
+
+		native_format = format;
+		texture_width = desc.width;
+		texture_height = desc.height;
+		sample_count = surface_samples;
+		ctx.make_resident(texture);
+		g_surface_counters.created++;
+		return true;
+	}
+
+	void render_target::clear_memory(command_context& ctx)
+	{
+		// VKRenderTargets.cpp clear_memory: colour (0, 0, 0, 1), depth 1.0, stencil 255.
+		render_pass_descriptor pass{};
+		pass.render_target_width = texture_width;
+		pass.render_target_height = texture_height;
+
+		if (is_depth_surface())
+		{
+			pass.depth.texture = texture;
+			pass.depth.load = load_action::clear;
+			pass.depth.store = store_action::store;
+			pass.depth.clear_depth = 1.0;
+
+			if (has_stencil(native_format))
+			{
+				pass.stencil.texture = texture;
+				pass.stencil.load = load_action::clear;
+				pass.stencil.store = store_action::store;
+				pass.stencil.clear_stencil = 255;
+			}
+		}
+		else
+		{
+			pass.color[0].texture = texture;
+			pass.color[0].load = load_action::clear;
+			pass.color[0].store = store_action::store;
+			pass.color[0].clear = { 0., 0., 0., 1. };
+		}
+
+		ctx.begin_render(pass, 0, "surface clear");
+		ctx.end_encoder();
+
+		state_flags &= ~rsx::surface_state_flags::erase_bkgnd;
+		g_surface_counters.cleared++;
+	}
+
+	void render_target::initialize_memory(command_context& ctx, rsx::surface_access /*access*/)
+	{
+		const bool read_buffers_config = is_depth_surface() ?
+			!!g_cfg.video.read_depth_buffer :
+			!!g_cfg.video.read_color_buffers;
+
+		const bool should_read_buffers = (state_flags & rsx::surface_state_flags::force_data_load) || read_buffers_config;
+		if (should_read_buffers)
+		{
+			// The Vulkan renderer loads the surface from guest memory here (load_memory, through its texture
+			// upload path). Stage M2.2 has no texture upload path yet: counted, and initialised as without loads.
+			g_surface_counters.memory_loads_not_implemented++;
+		}
+
+		clear_memory(ctx);
+		msaa_flags = rsx::surface_state_flags::ready;
+	}
+
+	void render_target::memory_barrier(command_context& ctx, rsx::surface_access access)
+	{
+		if (access == rsx::surface_access::gpu_reference)
+		{
+			// Only requires the object to exist for GPU usage (no spilling in this renderer).
+			return;
+		}
+
+		const bool is_depth = is_depth_surface();
+		const bool read_buffers_config = is_depth ? !!g_cfg.video.read_depth_buffer : !!g_cfg.video.read_color_buffers;
+		const bool should_read_buffers = (state_flags & rsx::surface_state_flags::force_data_load) || read_buffers_config;
+
+		if (should_read_buffers)
+		{
+			if (last_use_tag && state_flags == rsx::surface_state_flags::ready && !test())
+			{
+				state_flags |= rsx::surface_state_flags::erase_bkgnd;
+			}
+		}
+
+		if (old_contents.empty()) [[likely]]
+		{
+			if (state_flags & rsx::surface_state_flags::erase_bkgnd)
+			{
+				initialize_memory(ctx, access);
+
+				ensure(state_flags == rsx::surface_state_flags::ready);
+				on_write(rsx::get_shared_tag(), static_cast<rsx::surface_state_flags>(msaa_flags));
+			}
+
+			return;
+		}
+
+		// Memory transfers from the surfaces this one replaced or overlaps.
+		const unsigned first = prepare_rw_barrier_for_transfer(this);
+		const bool accept_all = (last_use_tag && test());
+		bool optimize_copy = true;
+		u64 newest_tag = 0;
+
+		for (auto i = first; i < old_contents.size(); ++i)
+		{
+			auto& section = old_contents[i];
+			auto src_texture = static_cast<render_target*>(section.source);
+			src_texture->memory_barrier(ctx, rsx::surface_access::transfer_read);
+
+			if (!accept_all && !src_texture->test()) [[likely]]
+			{
+				// If this surface is intact, accept all incoming data as it is guaranteed to be safe
+				// If this surface has not been initialized or is dirty, do not add more dirty data to it
+				continue;
+			}
+
+			section.init_transfer(this);
+			const auto src_area = section.src_rect();
+			const auto dst_area = section.dst_rect();
+
+			bool memory_load = true;
+			if (dst_area.x1 == 0 && dst_area.y1 == 0 &&
+				static_cast<u32>(dst_area.x2) == texture_width && static_cast<u32>(dst_area.y2) == texture_height)
+			{
+				// The whole surface is replaced
+				state_flags &= ~(rsx::surface_state_flags::erase_bkgnd);
+				msaa_flags = rsx::surface_state_flags::ready;
+
+				memory_load = false;
+				stencil_init_flags = src_texture->stencil_init_flags;
+			}
+			else if (state_flags & rsx::surface_state_flags::erase_bkgnd)
+			{
+				initialize_memory(ctx, rsx::surface_access::memory_write);
+				ensure(state_flags == rsx::surface_state_flags::ready);
+			}
+
+			const s32 copy_width = src_area.x2 - src_area.x1;
+			const s32 copy_height = src_area.y2 - src_area.y1;
+			const bool same_scale = copy_width == (dst_area.x2 - dst_area.x1) && copy_height == (dst_area.y2 - dst_area.y1);
+			const bool in_bounds = copy_width > 0 && copy_height > 0 &&
+				static_cast<u32>(src_area.x2) <= src_texture->texture_width && static_cast<u32>(src_area.y2) <= src_texture->texture_height &&
+				static_cast<u32>(dst_area.x2) <= texture_width && static_cast<u32>(dst_area.y2) <= texture_height;
+
+			if (src_texture->native_format == native_format && same_scale && in_bounds && src_texture->texture && texture)
+			{
+				region source_region{};
+				source_region.at = { static_cast<u32>(src_area.x1), static_cast<u32>(src_area.y1), 0 };
+				source_region.size = { static_cast<u32>(copy_width), static_cast<u32>(copy_height), 1 };
+				copy_texture(ctx.compute("surface inheritance"), src_texture->texture, 0, 0, source_region,
+					texture, 0, 0, { static_cast<u32>(dst_area.x1), static_cast<u32>(dst_area.y1), 0 });
+				g_surface_counters.inherited_copies++;
+			}
+			else
+			{
+				// Typeless or scaled transfer (the Vulkan renderer's blitter): not written yet. Counted; the region
+				// keeps the initialisation the Vulkan renderer would have used without loads.
+				g_surface_counters.transfers_not_implemented++;
+				if (!memory_load)
+				{
+					state_flags |= rsx::surface_state_flags::erase_bkgnd;
+					initialize_memory(ctx, rsx::surface_access::memory_write);
+				}
+			}
+
+			optimize_copy = optimize_copy && !memory_load;
+			newest_tag = src_texture->last_use_tag;
+		}
+
+		if (!newest_tag) [[unlikely]]
+		{
+			// Underlying memory has been modified and we could not find valid data to fill it
+			clear_rw_barrier();
+
+			state_flags |= rsx::surface_state_flags::erase_bkgnd;
+			initialize_memory(ctx, access);
+			ensure(state_flags == rsx::surface_state_flags::ready);
+		}
+
+		on_write_copy(newest_tag, optimize_copy);
+	}
+
+	std::unique_ptr<render_target> surface_cache_traits::create_new_surface(
+		command_context& ctx,
+		u32 address,
+		rsx::surface_color_format format,
+		usz width, usz height, usz pitch,
+		rsx::surface_antialiasing antialias,
+		const rsx::surface_scaling_config_t& resolution_scaling_config)
+	{
+		const auto fmt = get_compatible_surface_format(format);
+		const auto [width_, height_] = rsx::apply_resolution_scale<true>(resolution_scaling_config, static_cast<u16>(width), static_cast<u16>(height));
+
+		auto rtt = std::make_unique<render_target>();
+		if (!rtt->allocate(ctx, fmt.format, width_, height_, false))
+		{
+			return {};
+		}
+
+		rtt->surface_format_class = rsx::RSX_FORMAT_CLASS_COLOR;
+		rtt->set_format(format);
+		rtt->set_aa_mode(antialias);
+		rtt->set_resolution_scaling_config(resolution_scaling_config);
+		rtt->sample_layout = surface_sample_layout;
+		rtt->memory_usage_flags = rsx::surface_usage_flags::attachment;
+		rtt->state_flags = rsx::surface_state_flags::erase_bkgnd;
+		rtt->native_component_map = fmt.mapping;
+		rtt->rsx_pitch = static_cast<u32>(pitch);
+		rtt->native_pitch = static_cast<u32>(width) * get_format_block_size_in_bytes(format) * rtt->samples_x;
+		rtt->surface_width = static_cast<u16>(width);
+		rtt->surface_height = static_cast<u16>(height);
+		rtt->queue_tag(address);
+
+		rtt->add_ref();
+		return rtt;
+	}
+
+	std::unique_ptr<render_target> surface_cache_traits::create_new_surface(
+		command_context& ctx,
+		u32 address,
+		rsx::surface_depth_format2 format,
+		usz width, usz height, usz pitch,
+		rsx::surface_antialiasing antialias,
+		const rsx::surface_scaling_config_t& resolution_scaling_config)
+	{
+		const auto requested_format = get_compatible_depth_surface_format(format);
+		const auto [width_, height_] = rsx::apply_resolution_scale<true>(resolution_scaling_config, static_cast<u16>(width), static_cast<u16>(height));
+
+		auto ds = std::make_unique<render_target>();
+		if (!ds->allocate(ctx, requested_format, width_, height_, true))
+		{
+			return {};
+		}
+
+		ds->surface_format_class = rsx::classify_format(format);
+		ds->set_format(format);
+		ds->set_aa_mode(antialias);
+		ds->set_resolution_scaling_config(resolution_scaling_config);
+		ds->sample_layout = surface_sample_layout;
+		ds->memory_usage_flags = rsx::surface_usage_flags::attachment;
+		ds->state_flags = rsx::surface_state_flags::erase_bkgnd;
+		ds->native_component_map = { swizzle::red, swizzle::red, swizzle::red, swizzle::red };
+		ds->native_pitch = static_cast<u32>(width) * get_format_block_size_in_bytes(format) * ds->samples_x;
+		ds->rsx_pitch = static_cast<u32>(pitch);
+		ds->surface_width = static_cast<u16>(width);
+		ds->surface_height = static_cast<u16>(height);
+		ds->queue_tag(address);
+
+		ds->add_ref();
+		return ds;
+	}
+
+	void surface_cache_traits::clone_surface(
+		command_context& ctx,
+		std::unique_ptr<render_target>& sink, render_target* ref,
+		u32 address, barrier_descriptor_t& prev,
+		const rsx::surface_scaling_config_t& scaling_config)
+	{
+		const bool initialize = !sink || !sink->has_refs();
+		if (sink && initialize)
+		{
+			prepare_for_reuse(ctx, sink.get());
+		}
+
+		if (!sink)
+		{
+			const auto [new_w, new_h] = rsx::apply_resolution_scale<true>(
+				scaling_config,
+				prev.width, prev.height,
+				ref->get_surface_width<rsx::surface_metrics::pixels>(), ref->get_surface_height<rsx::surface_metrics::pixels>());
+
+			sink = std::make_unique<render_target>();
+			if (!sink->allocate(ctx, ref->native_format, new_w, new_h, ref->is_depth_surface()))
+			{
+				sink.reset();
+				return;
+			}
+
+			sink->surface_format_class = ref->format_class();
+		}
+
+		if (initialize)
+		{
+			sink->reset();
+			sink->msaa_flags = rsx::surface_state_flags::ready;
+			sink->add_ref();
+
+			sink->sample_layout = ref->sample_layout;
+			sink->resolution_scaling_config = scaling_config;
+
+			sink->set_aa_mode(ref->get_aa_mode());
+			sink->format_info = ref->format_info;
+			sink->memory_usage_flags = rsx::surface_usage_flags::storage;
+			sink->state_flags = rsx::surface_state_flags::erase_bkgnd;
+			sink->native_component_map = ref->native_component_map;
+			sink->stencil_init_flags = ref->stencil_init_flags;
+			sink->native_pitch = static_cast<u32>(prev.width) * ref->get_bpp() * ref->samples_x;
+			sink->rsx_pitch = ref->get_rsx_pitch();
+			sink->surface_width = prev.width;
+			sink->surface_height = prev.height;
+			sink->queue_tag(address);
+		}
+
+		sink->on_clone_from(ref);
+
+		if (!sink->old_contents.empty())
+		{
+			// Deal with this, likely only needs to clear
+			if (sink->surface_width > prev.width || sink->surface_height > prev.height)
+			{
+				sink->write_barrier(ctx);
+			}
+			else
+			{
+				sink->clear_rw_barrier();
+			}
+		}
+
+		prev.target = sink.get();
+		sink->set_old_contents_region(prev, false);
+	}
+
+	void surface_cache_traits::notify_surface_invalidated(const std::unique_ptr<render_target>& surface)
+	{
+		surface->frame_tag = 1;
+
+		if (!surface->old_contents.empty())
+		{
+			// TODO (as in the Vulkan renderer): retire the deferred writes
+			surface->clear_rw_barrier();
+		}
+
+		surface->release();
+	}
+
+	bool surface_cache_traits::int_surface_matches_properties(
+		const std::unique_ptr<render_target>& surface,
+		pixel_format format,
+		usz width, usz height,
+		rsx::surface_antialiasing antialias,
+		const rsx::surface_scaling_config_t& scaling_config,
+		bool check_refs)
+	{
+		if (check_refs && surface->has_refs())
+		{
+			// Surface may still have read refs from data 'copy'
+			return false;
+		}
+
+		return surface->native_format == format &&
+			surface->get_spp() == get_format_sample_count(antialias) &&
+			surface->matches_dimensions(static_cast<u16>(width), static_cast<u16>(height)) &&
+			surface->resolution_scaling_config == scaling_config;
+	}
+
+	void surface_cache_traits::write_render_target_to_memory(
+		command_context&,
+		buffer_object*,
+		render_target*,
+		u64, u64, u64)
+	{
+		// Reached only through rsx::surface_store::write_to_dma_buffers, which nothing calls in this RPCS3.
+		g_surface_counters.memory_writes_not_implemented++;
+	}
+
+	const object& surface_cache_traits::ctx_device(command_context& ctx)
+	{
+		return ctx.device();
+	}
+
+	void surface_cache::destroy()
+	{
+		invalidate_all();
+	}
+}
