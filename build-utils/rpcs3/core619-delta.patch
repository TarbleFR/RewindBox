+	struct config_rsx
+	{
+		std::string_view title;
+		std::string_view relaxed_zcull;     // Relaxed ZCULL Sync
+		std::string_view precise_zpass;     // Accurate ZCULL stats
+		std::string_view zcull_queries_off; // Disable ZCull Occlusion Queries
+		std::string_view depth_compare;     // Emulate Special Depth Comparison
+		std::string_view shader_precision;  // Shader Precision
+		std::string_view msl_fast_math_off; // Disable MSL Fast Math
+		std::string_view vertex_cache_off;  // Disable Vertex Cache
+		std::string_view strict;            // Strict Rendering Mode
+		std::string_view rcb;               // Read Color Buffers
+		std::string_view rdb;               // Read Depth Buffer
+		std::string_view msaa;              // MSAA
+		std::string_view hp_z;              // Force High Precision Z buffer
+		std::string_view fb_bias;           // Framebuffer Aliasing Heuristic Bias
+		std::string_view vsync;             // VSync Mode
+		std::string_view host_labels;       // Allow Host GPU Labels
+		std::string_view strict_flush;      // Strict Texture Flushing
+		bool invariance = false;        // effective: policy and Shader Precision not Low
+		bool invariance_policy = false; // the resolved Position Invariance setting
+		bool mvk_async = false;         // resolved request of this boot
+		bool legacy_custom = false;     // a full custom config was applied (tests would change it)
+		std::string_view overrides;     // every applied sparse override key; filtered when formatted
+	};
+
+	inline std::string format_config_rsx_line(const config_rsx& rsx)
+	{
+		std::string line = "CONFIG_LAYERS part=rsx";
+		append_text(line, "title", rsx.title, 64);
+		append_text(line, "relaxed_zcull", rsx.relaxed_zcull, 16);
+		append_text(line, "precise_zpass", rsx.precise_zpass, 16);
+		append_text(line, "zcull_queries_off", rsx.zcull_queries_off, 16);
+		append_text(line, "depth_compare", rsx.depth_compare, 16);
+		append_text(line, "shader_precision", rsx.shader_precision, 32);
+		append_text(line, "msl_fast_math_off", rsx.msl_fast_math_off, 16);
+		append_text(line, "vertex_cache_off", rsx.vertex_cache_off, 16);
+		append_text(line, "strict", rsx.strict, 16);
+		append_text(line, "rcb", rsx.rcb, 16);
+		append_text(line, "rdb", rsx.rdb, 16);
+		append_text(line, "msaa", rsx.msaa, 32);
+		append_text(line, "hp_z", rsx.hp_z, 16);
+		append_text(line, "fb_bias", rsx.fb_bias, 32);
+		append_text(line, "vsync", rsx.vsync, 32);
+		append_text(line, "host_labels", rsx.host_labels, 16);
+		append_text(line, "strict_flush", rsx.strict_flush, 16);
+		append_u32(line, "invariance", rsx.invariance ? 1u : 0u);
+		append_u32(line, "invariance_policy", rsx.invariance_policy ? 1u : 0u);
+		append_u32(line, "mvk_async", rsx.mvk_async ? 1u : 0u);
+		append_u32(line, "legacy_custom", rsx.legacy_custom ? 1u : 0u);
+		const std::string reported = filter_rsx_override_keys(rsx.overrides);
+		append_text(line, "overrides", reported, rsx_overrides_limit);
+		append_u32(line, "overrides_truncated", reported.size() > rsx_overrides_limit ? 1u : 0u);
+		return line;
+	}
