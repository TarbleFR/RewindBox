+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+// REWINDBOX_ZCULL_ON_DEMAND_619: Assassin's Creed (BLES00158, BLUS30089), Build
+// 617 iPhone logs (PID 65755, session 1, windows 17-28): 2,200-2,900 waits per
+// 5 s window, 4.1-4.3 s in all, every one of them inside ZCULL_control::sync()
+// (COREPROF ZCULLWAIT616 sync=, all other paths 0). Once the guest touched a
+// report page that still had a pending report, upstream marks the whole
+// location "accessed" for the rest of the boot (disable_optimizations):
+// every report becomes critical, and every label write with a pipe flush,
+// WAIT_FOR_IDLE or NOTIFY waits for the GPU to retire all of them, about 33
+// times per frame at 14 FPS. The value a guest thread reads is what matters,
+// not when the label is written: report pages stay protected (as upstream
+// before the first access), and a PPU/SPU access to a page that still holds a
+// pending report asks the RSX thread to write every claimed report (the same
+// writes sync() does), waits for them, then unprotects the page. The guest
+// reads the same values; the labels no longer wait. A wait that does not end
+// (250 ms) or a storm of requests (more than 1,000 per second) returns the
+// boot to the upstream mode. Title scoped (ios/IOSTitleLevers.h).
+namespace rpcs3::ios::zcull_on_demand
+{
+inline constexpr std::uint64_t fault_deadline_us = 250'000;
+inline constexpr std::uint64_t storm_window_us = 1'000'000;
+inline constexpr std::uint32_t storm_services = 1'000;
+
+// Process-wide counters of COREPROF ZCULLDEMAND619 (taken per window).
+struct tally
+{
+	std::atomic<std::uint64_t> faults{0};           // guest accesses to a page with a pending report
+	std::atomic<std::uint64_t> stale{0};            // guest accesses to a page whose reports were all written
+	std::atomic<std::uint64_t> services{0};         // RSX thread: every claimed report written for a request
+	std::atomic<std::uint64_t> waits{0};            // guest thread waits that ended served or released
+	std::atomic<std::uint64_t> wait_us{0};
+	std::atomic<std::uint64_t> wait_max_us{0};
+	std::atomic<std::uint64_t> timeouts{0};
+	std::atomic<std::uint64_t> stops{0};
+	std::atomic<std::uint64_t> rsx_reads{0};        // RSX copies out of report memory, served by writing the reports
+	std::atomic<std::uint64_t> upstream_cell{0};    // upstream disable_optimizations after a PPU/SPU access
+	std::atomic<std::uint64_t> upstream_other{0};   // ... after an access by another thread
+	std::atomic<std::uint64_t> upstream_rsx_read{0};// ... after an RSX copy out of report memory
+	std::atomic<bool> tripped{false};
+
+	void add_wait(std::uint64_t us) noexcept
+	{
+		waits.fetch_add(1, std::memory_order_relaxed);
+		wait_us.fetch_add(us, std::memory_order_relaxed);
+		std::uint64_t max = wait_max_us.load(std::memory_order_relaxed);
+		while (us > max && !wait_max_us.compare_exchange_weak(max, us, std::memory_order_relaxed)) {}
+	}
+};
+
+inline tally& counters() noexcept
+{
+	static tally s_tally;
+	return s_tally;
+}
+
+// Request/serve handshake between faulting guest threads and the RSX thread.
+class gate
+{
+	std::atomic<std::uint64_t> m_requested{0};
+	std::atomic<std::uint64_t> m_served{0};
+	std::atomic<bool> m_tripped{false};
+	std::uint64_t m_window_start_us = 0; // RSX thread only
+	std::uint32_t m_window_services = 0; // RSX thread only
+
+public:
+	gate() noexcept
+	{
+		// One gate per renderer, that is per boot: the process-wide flag follows it.
+		counters().tripped.store(false, std::memory_order_relaxed);
+	}
+
+	gate(const gate&) = delete;
+	gate& operator=(const gate&) = delete;
+
+	// Guest thread: a new ticket, served once the RSX thread wrote every claimed report after it.
+	std::uint64_t request() noexcept
+	{
+		return m_requested.fetch_add(1, std::memory_order_acq_rel) + 1;
+	}
+
+	// RSX thread: the newest ticket waiting to be served, 0 when none.
+	std::uint64_t pending() const noexcept
+	{
+		const std::uint64_t requested = m_requested.load(std::memory_order_acquire);
+		return requested != m_served.load(std::memory_order_relaxed) ? requested : 0;
+	}
+
+	// RSX thread, after every report claimed when `ticket` was read is written.
+	// Returns true when this service tripped the storm guard.
+	bool serve(std::uint64_t ticket, std::uint64_t now_us) noexcept
+	{
+		std::uint64_t served = m_served.load(std::memory_order_relaxed);
+		while (served < ticket && !m_served.compare_exchange_weak(served, ticket, std::memory_order_release, std::memory_order_relaxed)) {}
+
+		if (now_us - m_window_start_us >= storm_window_us)
+		{
+			m_window_start_us = now_us;
+			m_window_services = 0;
+		}
+
+		if (++m_window_services > storm_services && !tripped())
+		{
+			trip();
+			return true;
+		}
+
+		return false;
+	}
+
+	bool is_served(std::uint64_t ticket) const noexcept
+	{
+		return m_served.load(std::memory_order_acquire) >= ticket;
+	}
+
+	void trip() noexcept
+	{
+		m_tripped.store(true, std::memory_order_release);
+		counters().tripped.store(true, std::memory_order_relaxed);
+	}
+
+	bool tripped() const noexcept
+	{
+		return m_tripped.load(std::memory_order_acquire);
+	}
+};
+
+enum class wait_result
+{
+	served,    // the RSX thread wrote every report claimed at the request
+	released,  // the page no longer holds a pending report (written meanwhile)
+	stopped,   // emulation or renderer stopping
+	timed_out, // deadline reached
+};
+
+// Guest thread: waits for `ticket`. `released()` checks the page, `stopped()`
+// the emulator, `now_us()` the clock. Spins briefly, then sleeps 50 us steps:
+// the request costs one GPU round trip, a few milliseconds.
+template <typename Released, typename Stopped, typename Now>
+wait_result wait_for(const gate& g, std::uint64_t ticket, std::uint64_t deadline_us, Released&& released, Stopped&& stopped, Now&& now_us)
+{
+	for (unsigned step = 0;; step++)
+	{
+		if (g.is_served(ticket))
+		{
+			return wait_result::served;
+		}
+
+		if (released())
+		{
+			return wait_result::released;
+		}
+
+		if (stopped())
+		{
+			return wait_result::stopped;
+		}
+
+		if (now_us() >= deadline_us)
+		{
+			return wait_result::timed_out;
+		}
+
+		if (step < 32)
+		{
+			std::this_thread::yield();
+		}
+		else
+		{
+			std::this_thread::sleep_for(std::chrono::microseconds(50));
+		}
+	}
+}
+}
