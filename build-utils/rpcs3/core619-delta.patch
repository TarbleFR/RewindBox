+	// --- CONFIG_LAYERS part=rsx (REWINDBOX_GRAPHICS_TESTS_612) ------------------
+	// The effective values of the settings that the Assassin's Creed torch and
+	// Black Ops II viewmodel tests change, one line per boot. It is emitted just
+	// before the main CONFIG_LAYERS line, which stays the last one of the boot
+	// for the host's timeline configuration and cause-history boundary. Values
+	// are cfg::to_string() text. invariance is what the vertex shaders get
+	// (policy and Shader Precision not Low, as VKVertexProgram.cpp decides on
+	// Apple GPUs); invariance_policy is the resolved setting. mvk_async is the
+	// boot's resolved request (the asynchronous-submit canary already applied).
+	// overrides lists, among the sparse user override keys applied on this boot,
+	// only those of the settings this line reports (rsx_override_keys).
+	inline constexpr std::string_view rsx_override_keys[] = {
+		"gpu.zcull_accuracy", "debug.disable_occlusion", "debug.emulate_depth_compare", "gpu.shader_precision",
+		"advanced.disable_msl_fast_math", "debug.disable_vertex_cache", "gpu.strict_rendering",
+		"advanced.read_color_buffers", "advanced.read_depth_buffer", "gpu.msaa", "gpu.vsync",
+		"experimental.position_invariance", "experimental.moltenvk_async_submits",
+	};
+	inline constexpr std::size_t rsx_overrides_limit = 400;
+
+	// Comma-separated keys -> the reported ones, in input order, without duplicates.
+	inline std::string filter_rsx_override_keys(std::string_view keys)
+	{
+		std::string result;
+		while (!keys.empty())
+		{
+			const std::size_t comma = keys.find(',');
+			const std::string_view key = keys.substr(0, comma);
+			keys = comma == std::string_view::npos ? std::string_view{} : keys.substr(comma + 1);
+			bool reported = false;
+			for (const std::string_view known : rsx_override_keys)
+			{
+				reported = reported || key == known;
+			}
+			const std::string padded = ',' + result + ',';
+			if (reported && padded.find(',' + std::string{key} + ',') == std::string::npos)
+			{
+				result += result.empty() ? "" : ",";
+				result += key;
+			}
+		}
+		return result;
+	}
