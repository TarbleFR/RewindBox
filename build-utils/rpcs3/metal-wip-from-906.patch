+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_LOAD_OP_CLEAR_907: Assassin's Creed (BLES00158), IPA 676 device log, gameplay at 25-28 FPS with the GPU
+// busy 77-84 % (about 30 ms of GPU work per frame): 44-48 render passes begin per frame (COREPROF RPASS652), every one
+// created with load-op LOAD for every attachment (VKRenderPass.cpp). A guest clear that is the first command on its
+// framebuffer begins such a pass and then records vkCmdClearAttachments, which MoltenVK executes as a triangle draw
+// (MVKCmdClearAttachments::encode): the Apple GPU first loads the whole attachment from memory into tile memory, then
+// overwrites every pixel of it.
+//
+// When the clear covers the whole framebuffer (render area = framebuffer), every bound color buffer with the full
+// write mask (fast clear) and/or whole depth/stencil aspects, on single-sample targets, and no pass is open on this
+// framebuffer, the pass now begins with load-op CLEAR for exactly those attachments and the same clear values. The
+// result in every pixel is the clear value in both cases, written before any draw of the pass, so the image the game
+// sees is identical; only the load from memory and the clear draw are gone. The other attachments keep LOAD. Anything
+// else (scissored or partial clears, masked channels, MSAA, a pass already open on the framebuffer) records vkCmdClearAttachments exactly as before. Counted per window
+// (COREPROF LOADCLEAR907).
+namespace rpcs3::ios::load_op_clear
+{
+// Resolved once per boot (title policy); read by the RSX thread.
+inline std::atomic<bool> enabled{false};
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> passes{0};          // passes begun with load-op CLEAR
+	std::atomic<std::uint64_t> color{0};           // ... clearing the color attachments
+	std::atomic<std::uint64_t> depth{0};           // ... clearing depth
+	std::atomic<std::uint64_t> stencil{0};         // ... clearing stencil
+	std::atomic<std::uint64_t> kept_open_pass{0};  // vkCmdClearAttachments kept: a pass is open on this framebuffer
+	std::atomic<std::uint64_t> kept_partial{0};    // ... the clear is scissored, masked or MSAA
+	std::atomic<std::uint64_t> kept_disabled{0};   // ... the title policy has the lever off
+};
+
+inline window_counters counters;
+
+inline void add(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::load_op_clear
