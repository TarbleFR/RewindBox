+#ifdef RPCS3_IOS
+bool VKGSRender::begin_render_pass_with_clear(const std::vector<VkClearAttachment>& clears, bool full_frame)
+{
+	namespace lc = rpcs3::ios::load_op_clear;
+	if (!lc::enabled.load(std::memory_order_relaxed))
+	{
+		lc::add(lc::counters.kept_disabled);
+		return false;
+	}
+	if (vk::is_renderpass_open_on(*m_current_command_buffer, m_draw_fbo->value))
+	{
+		// The clear lands in the middle of an open pass: its load-op is past.
+		lc::add(lc::counters.kept_open_pass);
+		return false;
+	}
+
+	// The framebuffer's attachments: the color views first, then the depth/stencil view (vk::framebuffer_holder).
+	// (prepare_rtts: m_fbo_images holds the m_draw_buffers surfaces, then the depth surface when one is bound.)
+	const auto& views = m_draw_fbo->attachments;
+	const bool has_depth = std::get<0>(m_rtts.m_bound_depth_stencil) != 0;
+	const usz color_count = m_draw_buffers.size();
+	if (views.size() != color_count + (has_depth ? 1 : 0))
+	{
+		lc::add(lc::counters.kept_partial);
+		return false;
+	}
+	bool clear_color = false;
+	VkImageAspectFlags depth_aspects = 0;
+	VkClearValue color_value{}, depth_value{};
+	usz color_descriptors = 0;
+	for (const auto& clear : clears)
+	{
+		if (clear.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT)
+		{
+			clear_color = true;
+			color_value = clear.clearValue;
+			color_descriptors++;
+		}
+		else
+		{
+			depth_aspects |= clear.aspectMask;
+			depth_value = clear.clearValue;
+		}
+	}
+
+	const bool single_sample = !views.empty() && views.front()->image()->samples() == 1;
+	// Every color attachment cleared (one fast-clear descriptor each, one value for all), whole depth/stencil aspects
+	// of the bound depth buffer, a full-framebuffer rectangle, single sample.
+	const bool color_ok = !clear_color || color_descriptors == color_count;
+	const bool depth_ok = !depth_aspects || has_depth;
+	if (!full_frame || !single_sample || !color_ok || !depth_ok || views.empty())
+	{
+		lc::add(lc::counters.kept_partial);
+		return false;
+	}
+
+	std::array<VkClearValue, 8> values{};
+	if (views.size() > values.size())
+	{
+		lc::add(lc::counters.kept_partial);
+		return false;
+	}
+	for (usz index = 0; index < color_count; ++index)
+	{
+		values[index] = color_value;
+	}
+	if (has_depth)
+	{
+		values[views.size() - 1] = depth_value;
+	}
+
+	const bool clear_depth = !!(depth_aspects & VK_IMAGE_ASPECT_DEPTH_BIT);
+	const bool clear_stencil = !!(depth_aspects & VK_IMAGE_ASPECT_STENCIL_BIT);
+	const VkRenderPass pass = get_render_pass();
+	const VkRenderPass cleared_pass = vk::get_renderpass(*m_device,
+		vk::get_renderpass_key_with_load_clear(m_current_renderpass_key, clear_color, clear_depth, clear_stencil));
+	vk::begin_renderpass_cleared(*m_current_command_buffer, pass, cleared_pass, m_draw_fbo->value,
+		{ positionu{0u, 0u}, sizeu{m_draw_fbo->width(), m_draw_fbo->height()} }, values.data(), ::size32(views));
+	// FEEDBACK610 counts only the passes the draw path begins (its reviewed census): the passes begun
+	// here are counted by COREPROF LOADCLEAR907 passes, and by RPASS652 like every other begin.
+	{
+		// REWINDBOX_IN_PASS_READ_TRANSITION_655: the attachments of the pass now open on m_draw_fbo, as
+		// VKGSRender::begin_render_pass notes them (its reviewed form is unchanged).
+		std::array<VkImage, 8> images{};
+		u32 count = 0;
+		for (const auto& view : views)
+		{
+			if (count == images.size())
+			{
+				count = 0;
+				break;
+			}
+			images[count++] = view->image()->value;
+		}
+		vk::note_renderpass_attachments(*m_current_command_buffer, m_draw_fbo->value, images.data(), count);
+	}
+
+	lc::add(lc::counters.passes);
+	if (clear_color) lc::add(lc::counters.color);
+	if (clear_depth) lc::add(lc::counters.depth);
+	if (clear_stencil) lc::add(lc::counters.stencil);
+	return true;
+}
