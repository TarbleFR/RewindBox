+// REWINDBOX_POST_AA_942: bit 1 of limit_range asks for FXAA of the single view (bit 0 stays the limited range flag).
+// The nine-tap FXAA of Timothy Lottes' white paper: the edge direction from the luma of the four diagonal texels,
+// two then four taps along it, the wider average kept only while its luma stays inside the local range.
+#define LIMIT_RANGE_BIT 1
+#define POST_AA_BIT 2
+
+vec4 fxaa_source()
+{
+	const vec2 texel = 1. / vec2(textureSize(fs0, 0));
+	const vec3 luma = vec3(0.299, 0.587, 0.114);
+
+	const vec4 centre = textureLod(fs0, tc0, 0.);
+	const float luma_nw = dot(textureLod(fs0, tc0 + vec2(-1., -1.) * texel, 0.).rgb, luma);
+	const float luma_ne = dot(textureLod(fs0, tc0 + vec2(1., -1.) * texel, 0.).rgb, luma);
+	const float luma_sw = dot(textureLod(fs0, tc0 + vec2(-1., 1.) * texel, 0.).rgb, luma);
+	const float luma_se = dot(textureLod(fs0, tc0 + vec2(1., 1.) * texel, 0.).rgb, luma);
+	const float luma_m = dot(centre.rgb, luma);
+
+	const float luma_min = min(luma_m, min(min(luma_nw, luma_ne), min(luma_sw, luma_se)));
+	const float luma_max = max(luma_m, max(max(luma_nw, luma_ne), max(luma_sw, luma_se)));
+
+	vec2 dir = vec2(-((luma_nw + luma_ne) - (luma_sw + luma_se)), (luma_nw + luma_sw) - (luma_ne + luma_se));
+	const float dir_reduce = max((luma_nw + luma_ne + luma_sw + luma_se) * (0.25 / 8.), 1. / 128.);
+	const float rcp_dir_min = 1. / (min(abs(dir.x), abs(dir.y)) + dir_reduce);
+	dir = clamp(dir * rcp_dir_min, vec2(-8.), vec2(8.)) * texel;
+
+	const vec3 rgb_a = 0.5 * (
+		textureLod(fs0, tc0 + dir * (1. / 3. - 0.5), 0.).rgb +
+		textureLod(fs0, tc0 + dir * (2. / 3. - 0.5), 0.).rgb);
+	const vec3 rgb_b = rgb_a * 0.5 + 0.25 * (
+		textureLod(fs0, tc0 + dir * -0.5, 0.).rgb +
+		textureLod(fs0, tc0 + dir * 0.5, 0.).rgb);
+	const float luma_b = dot(rgb_b, luma);
+
+	return vec4((luma_b < luma_min || luma_b > luma_max) ? rgb_a : rgb_b, centre.a);
+}
