diff --git a/rpcs3/ios/IOSPostAA942.h b/rpcs3/ios/IOSPostAA942.h
new file mode 100644
index 0000000..f7aaf4a
--- /dev/null
+++ b/rpcs3/ios/IOSPostAA942.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include "IOSGow3MlaaReport.h"
+
+// REWINDBOX_POST_AA_942: God of War III, iPhone logs of IPA 760 (Core 940), fresh boot: the MLAA bypass is applied
+// (COREPROF GOW3MLAA909 ppu=applied) and the title asks for no multisampling (MSAA Auto, CONFIG_LAYERS msaa=Auto): its
+// only anti-aliasing was the MLAA its SPUs ran on the finished frame, so the picture now reaches the screen with none.
+// Thin alpha-tested geometry (foliage) then crawls from one frame to the next, more so at the 14 to 21 frames a second
+// of the heavy scenes. The bypass stays (it frees the SPU time and the 1280x720 read-back of every frame); the
+// anti-aliasing comes back on the GPU instead, as FXAA in the pass that already scales the frame to the screen
+// (VideoOutCalibrationPass.glsl, bit 1 of its limit_range constant; VKPresent.cpp).
+//
+// Automatic: the titles the policy names (God of War III), and only while the game's own MLAA is known to be off (the
+// PPU half written at this boot, a restored savestate that holds it, or the SPU half patched). Enabled: every frame of
+// the title, whatever it does itself. Disabled: never. Read at boot. Only the Bilinear output mode takes this path
+// (the pass samples linearly); Nearest, MetalFX, FSR and stereo output keep their own.
+namespace rpcs3::ios::post_aa
+{
+inline std::atomic<bool> automatic{false}; // the title is one the Automatic mode covers
+inline std::atomic<bool> forced{false};    // the setting is Enabled
+inline std::atomic<std::uint64_t> frames{0}; // frames presented through FXAA since boot (COREPROF POSTAA942)
+
+inline bool wanted() noexcept
+{
+	if (forced.load(std::memory_order_relaxed))
+	{
+		return true;
+	}
+
+	if (!automatic.load(std::memory_order_relaxed))
+	{
+		return false;
+	}
+
+	const auto ppu = static_cast<gow3_mlaa::ppu_state>(gow3_mlaa::ppu.load(std::memory_order_relaxed));
+	return ppu == gow3_mlaa::ppu_state::applied || ppu == gow3_mlaa::ppu_state::savestate_applied ||
+		gow3_mlaa::savestate_patched.load(std::memory_order_relaxed) == 1 ||
+		gow3_mlaa::spu_words_patched.load(std::memory_order_relaxed) != 0; // the SPU half alone also turns the MLAA job off
+}
+}
