diff --git a/rpcs3/ios/IOSGow3PollSleep943.h b/rpcs3/ios/IOSGow3PollSleep943.h
index c4f7d4b..974cbe4 100644
--- a/rpcs3/ios/IOSGow3PollSleep943.h
+++ b/rpcs3/ios/IOSGow3PollSleep943.h
@@ -27,11 +27,21 @@
 // never writes; the nop at 0x2eafd4, just before the loop, stores the object pointer (r30) there as the "no wait yet"
 // mark. The rest is a code cave reached by a far jump from 0x2eaff4, as the patch engine builds them (code_alloc); the
 // cave leaves through absolute branches (ba 0x2eafd8, ba 0x2eaff8: both below 32 MiB), real guest instructions that a
-// savestate keeps. Written at a fresh boot only, on this executable only, and only if the eleven words 0x2eafd4..0x2eaffc
+// savestate keeps. Written at a fresh boot (and, from Core 946, on resuming a savestate of an unpatched boot), on this executable only, and only if the eleven words 0x2eafd4..0x2eaffc
 // are the ones read on the device: any other content refuses the patch and says so (COREPROF GOW3POLL943
 // state=refused_guard). A savestate made from a patched boot holds the cave and the mark but not what the host keeps
 // (the cave's execution table, the far jump into it): on resume the loader finds the cave by its exact words and
 // registers both again, so a thread saved inside the cave (in its sleep, most often) resumes there; nothing is written.
+// This happens whatever the setting says (Core 946): with the setting Disabled a thread saved inside the cave could not
+// run its next instruction otherwise.
+// REWINDBOX_GOW3_POLL_SAVESTATE_946: IPA 771 logs (17 November 2026, Core 945), God of War III resumed from a savestate
+// made before Core 943 (session 2): state=savestate cave=0x0, the main thread back to 0.70-0.83 core in its poll. A
+// resumed savestate whose memory holds the eleven original words (no mark, so no cave) is patched as a fresh boot: a
+// new cave, the mark and the far jump (state=savestate_applied). A thread saved inside the loop has not stored the mark;
+// in the cave its 0x70(r1) slot is an older stack value, so its wait is taken as already older than 100 us and it sleeps
+// 30 us between calls from its next unanswered call, which is the rule; its next wait stores the mark as usual. Any
+// other content refuses the patch as at a fresh boot (refused_guard). A later savestate holds the cave and the mark and
+// is restored as savestate_restored.
 // Cost: the function at 0x2eafb0 contains a far jump, so it leaves LLVM and runs in the interpreter fallback, as every
 // function a code_alloc patch enters does; the loop is that function's own, the work it waits for is elsewhere.
 namespace rpcs3::ios::gow3_poll943
@@ -133,6 +143,7 @@ enum class state : std::uint32_t
 	savestate,          // a resumed savestate whose memory holds no cave (made from an unpatched boot): the game's loop
 	other_executable, refused_guard, no_memory, no_jump,
 	savestate_restored, // a resumed savestate made from a patched boot: its cave found and registered again
+	savestate_applied,  // REWINDBOX_GOW3_POLL_SAVESTATE_946: a resumed savestate from an unpatched boot, patched as a fresh boot
 };
 
 inline std::atomic<std::uint32_t> applied_state{0};
@@ -151,6 +162,7 @@ inline const char* name(std::uint32_t s) noexcept
 	case state::no_memory: return "no_memory";
 	case state::no_jump: return "no_jump";
 	case state::savestate_restored: return "savestate_restored";
+	case state::savestate_applied: return "savestate_applied";
 	default: return "unset";
 	}
 }
