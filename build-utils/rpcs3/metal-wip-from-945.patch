 		const auto poll_block = poll_result == poll_state::applied || poll_result == poll_state::savestate ? vm::get(vm::any, poll943::branch_word) : nullptr;
 
+		// REWINDBOX_GOW3_POLL_SAVESTATE_946 (ios/IOSGow3PollSleep943.h): a resumed savestate whose memory still holds the
+		// original first word (no mark: saved from an unpatched boot) is patched as a fresh boot, after the same guard.
+		bool poll_from_savestate = false;
+
+		if (poll_result == poll_state::savestate && poll_policy && poll_block && _main.get_ptr<u8>(poll943::first_word, 4) &&
+			static_cast<u32>(_main.get_ref<u32>(poll943::first_word)) == poll943::expected[0])
