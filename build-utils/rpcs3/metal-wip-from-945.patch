 		using poll_state = poll943::state;
-		poll_state poll_result = virtual_load ? poll_state::unset : !rpcs3::ios::get_experimental_policy().gow3_poll_sleep ? poll_state::policy_off :
-			hash != poll943::executable ? poll_state::other_executable : ar ? poll_state::savestate : poll_state::applied;
+		// REWINDBOX_GOW3_POLL_SAVESTATE_946: a resumed savestate of this executable is examined whatever the setting says, so
+		// that the cave of a patched boot is always registered again (its main thread may be saved inside it); the setting
+		// decides only whether an unpatched one is patched.
+		const bool poll_policy = rpcs3::ios::get_experimental_policy().gow3_poll_sleep;
+		poll_state poll_result = virtual_load ? poll_state::unset : hash != poll943::executable ? (poll_policy ? poll_state::other_executable : poll_state::policy_off) :
