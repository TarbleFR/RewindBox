@@ -2525,6 +2540,11 @@ bool ppu_load_exec(const ppu_exec_object& elf, bool virtual_load, const std::str
 					applied.push_back(poll943::branch_word);
 					rpcs3_ios_register_patch_block(poll943::branch_word);
 					poll943::cave_address.store(cave, std::memory_order_relaxed);
