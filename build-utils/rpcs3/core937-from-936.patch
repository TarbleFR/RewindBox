diff --git a/rpcs3/ios/IOSAtomicWaitBound937.h b/rpcs3/ios/IOSAtomicWaitBound937.h
new file mode 100644
index 0000000..077fb68
--- /dev/null
+++ b/rpcs3/ios/IOSAtomicWaitBound937.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_SPU_IDLE_BACKOFF_937: a one-shot bound for the next atomic wait of this thread.
+//
+// IPA 737 logs (14 Nov 2026), Black Ops II menus at 60 FPS: 35,000 to 38,000 of the 48,000 timer wakeups a second
+// are the 100 us wait of a polling GETLLAR (SPUWAIT551 getllar_sleep, 149 us each on average). That wait is written
+// in spu_thread::process_mfc_cmd(), whose body is an extracted input of a reused host harness and must keep its
+// Core 610 bytes. So the bound is chosen around it: spu_thread::register_cache_line_waiter(), called right before the
+// wait, sets it here; atomic_wait_engine::wait() takes it at entry and uses it in place of the requested timeout only
+// when that timeout is exactly the 100 us of this wait; spu_thread::deregister_cache_line_waiter(), called right
+// after, clears whatever was not taken. No wait of any other thread, and no other timeout, can see it.
+namespace rpcs3::ios::atomic_wait_bound
+{
+inline constexpr std::uint64_t reference_ns = 100'000;
+
+inline thread_local std::uint64_t next_ns = 0;
+
+inline void set(std::uint64_t ns) noexcept
+{
+	next_ns = ns == reference_ns ? 0 : ns;
+}
+
+inline std::uint64_t take() noexcept
+{
+	const std::uint64_t value = next_ns;
+	next_ns = 0;
+	return value;
+}
+}
