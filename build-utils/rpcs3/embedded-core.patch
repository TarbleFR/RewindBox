+				{
+					Emu.SetContinuousMode(false);
+					Emu.SetForceBoot(false);
+					set_error("RPCS3 could not switch processes because the preceding session stopped. Start the game again.");
+					emit_log(1, "RPCS3 internal process transition ended after the preceding session stopped.");
+				}
+				return;
+			}
+
+			// Capture the old VFS/FXO and start its asynchronous Kill on UIKit,
+			// while the API lock excludes a simultaneous wrapper stop/new boot.
+			std::mutex completed_mutex;
+			std::condition_variable completed_cv;
+			bool completed = false;
+			bool executed = false; // REWINDBOX_TRANSITION_PHASES_610
+			std::exception_ptr failure;
+			const auto stop_started = std::chrono::steady_clock::now();
+			Emu.GetCallbacks().call_from_main_thread([&]
+			{
+				try
+				{
+					// Native main-thread restarts do not change the worker generation.
+					// Keep the original stop-ID guard through the UIKit dispatch gap.
+					if (restore_jobs().current(generation) && !Emu.IsStopped() &&
+						static_cast<std::uint64_t>(Emu.GetEmulationIdentifier()) == request->emulation_id &&
+						Emu.GetTitleID() == request->title_id && !neostation::savestate::current.read().active)
+					{
+						executed = true;
+						request->main_stop(request->emulation_id);
+					}
+				}
+				catch (...) { failure = std::current_exception(); }
+				std::lock_guard lock(completed_mutex);
+				completed = true;
+				completed_cv.notify_one();
+			}, nullptr);
+			std::unique_lock lock(completed_mutex);
+			completed_cv.wait(lock, [&] { return completed; });
+			// REWINDBOX_TRANSITION_PHASES_610: UIKit ran (or skipped) the old-process stop.
+			// Written here on the worker, never from UIKit. Kill continues asynchronously.
+			emit_log(6, fmt::format("COREPROF EXITSPAWN phase=stop_main executed=%u failure=%u ui_wait_ms=%.3f generation=%llu emulation_id=%llu",
+				executed ? 1u : 0u, failure ? 1u : 0u,
+				std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - stop_started).count(),
+				generation, request->emulation_id));
+			if (failure)
+			{
+				Emu.SetContinuousMode(false);
+				Emu.SetForceBoot(false);
+				set_error("RPCS3 could not prepare the internal process transition.");
+				emit_log(1, "RPCS3 internal process transition preparation failed.");
+			}
+		}, token);
+		return admitted || !restore_jobs().current(token);
+	}
+	catch (...) { return false; }
+}
+}
+
+bool defer_continuous_stop(std::function<void(std::uint64_t)> main_stop, std::uint64_t token, std::uint64_t emulation_id, std::string title_id) noexcept
+{
+	if (!main_stop) return false;
+	try
+	{
+		return schedule_continuous_stop(std::make_shared<continuous_stop_request>(continuous_stop_request{
+			std::move(main_stop), token, emulation_id, std::move(title_id)}));
+	}
+	catch (...) { return false; }
+}
+
+bool defer_continuous_boot(std::function<void()> boot, std::uint64_t token, std::uint64_t emulation_id, std::string title_id) noexcept
+{
+	if (!boot) return false;
+	try
+	{
+		const bool admitted = restore_jobs().post_continuation([boot = std::move(boot), emulation_id, title_id = std::move(title_id)](std::uint64_t generation)
+		{
+			std::lock_guard api_lock(g_api_mutex);
+			if (!restore_jobs().current(generation) || Emu.GetTitleID() != title_id) return;
+			if (g_lifecycle.state() != RPCS3_IOS_STATE_READY ||
+				!g_accept_display_surfaces.load() || Emu.GetStatus(false) != system_state::stopped ||
+				static_cast<std::uint64_t>(Emu.GetEmulationIdentifier()) != emulation_id ||
+				neostation::savestate::current.read().active)
+			{
+				emit_log(1, "RPCS3 internal process boot was no longer ready.");
+				return;
+			}
+			thread_base::set_name("RPCS3 Reboot");
+			// REWINDBOX_TRANSITION_PHASES_610: phases 2-4 and the rest of Load run inside
+			// boot(); a boot that never returns leaves boot_begin without boot_return.
+			emit_log(6, fmt::format("COREPROF EXITSPAWN phase=boot_begin generation=%llu emulation_id=%llu", generation, emulation_id));
+			const auto boot_started = std::chrono::steady_clock::now();
+			bool boot_returned = false;
+			try
+			{
+				boot();
+				boot_returned = true;
+			}
+			catch (const std::exception& error)
+			{
+				Emu.SetContinuousMode(false);
+				Emu.SetForceBoot(false);
+				set_error(error.what());
+				emit_log(1, "RPCS3 internal process boot failed.");
+			}
+			catch (...)
+			{
+				Emu.SetContinuousMode(false);
+				Emu.SetForceBoot(false);
+				set_error("RPCS3 could not boot the next internal process.");
+				emit_log(1, "RPCS3 internal process boot failed.");
+			}
+			if (boot_returned)
+			{
+				// 7 (starting) is expected: Run(true) ended Load; RunPPU follows the warmup.
+				// Outside the boot try block: a logging failure is never a boot failure.
+				emit_log(6, fmt::format("COREPROF EXITSPAWN phase=boot_return raw_state=%u boot_ms=%.3f",
+					static_cast<u32>(Emu.GetStatus(false)),
+					std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - boot_started).count()));
+			}
+		}, token);
+		return admitted || !restore_jobs().current(token);
+	}
+	catch (...) { return false; }
+}
+}
+
 [[noreturn]] void report_fatal_error(std::string_view text, bool, bool)
 {
 	set_error(std::string{text});
 	emit_log(1, text);
 	std::abort();
 }
+
