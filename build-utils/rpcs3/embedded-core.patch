+	bool texture_cache::copy_transfer_regions_fully_cover_image(vk::image* dst, const rsx::simple_array<copy_region_descriptor>& sections) const
+	{
+		const u32 mipmaps = dst->mipmaps();
+		if (dst->aspect() != VK_IMAGE_ASPECT_COLOR_BIT || !mipmaps || mipmaps > 16)
+			return false;
