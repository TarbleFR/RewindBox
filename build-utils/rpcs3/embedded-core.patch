 #include "ios/IOSTextureHash.h"
+#include "ios/IOSTexturePrehash.h"
+#include "ios/IOSThreadQoS.h"
 #include "ios/RPCS3IOSExperimentalPolicy.h"
+#include "Emu/Memory/vm_locking.h"
+#include <bit>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
