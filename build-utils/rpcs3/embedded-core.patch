+	bool wait_for_offloader_recovery(bool is_writing);
+	void update_draw_state(const mtl::raster_state& raster);
+	void emit_geometry(u32 sub_index) override;
+	const mtl::object& get_depth_stencil_state(const mtl::depth_stencil_key& key);
+
+	// Clears: a full-surface triangle within the scissor (as MoltenVK implements vkCmdClearAttachments)
+	bool create_clear_library(std::string& error);
+	const mtl::object& get_clear_pipeline(u32 color_write_mask);
+	void clear_attachments(u32 color_write_mask, bool clear_depth, bool clear_stencil, f32 depth, u8 stencil,
+		u8 stencil_write_mask, const std::array<f32, 4>& color);
+
+	std::string m_initialization_error;
+	mtl::device_info m_device_info;
+	mtl::object m_device;
