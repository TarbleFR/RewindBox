@@ -0,0 +1,492 @@
+#pragma once
+
+// NEOSTATION_BUILD487_DIAGNOSTICS_V1: boot observability of the embedded Core
+// (audit docs/rpcs3-bottleneck-audit-2026-10-18.md § 7, D3/D4/D8/D10).
+//
+// This header holds only pure helpers so the Linux host test can compile and
+// run them bit-for-bit: process-wide monotonic counters of the PPU boot
+// pipeline, the restart-reason hand-off between an announcing site and
+// Emulator::Restart, and the std::snprintf formatters of the four lines the
+// host whitelists by prefix:
+//
+//   CONFIG_LAYERS      (System.cpp, right after resolve_experimental_policy())
+//   NEOSTATION_RESTART (Emulator::Restart and the home-menu savestate reload)
+//   JITPROF_BOOT       (end of ppu_initialize(), two lines per boot: PPU, SPU)
+//   SAVESTATE_BOOT     (ppu_initialize() of a savestate boot, two lines)
+//
+// Pure diagnostics: nothing in the Core reads these counters to take a
+// decision, no generated code or cache key depends on their values. (The PPU
+// and SPU object identities still change once with this build: PPUThread.cpp,
+// Utilities/JITPhaseProfile.h and SPUCommonRecompiler.cpp, which it edits, are
+// hashed into NEOSTATION_PPU/SPU_CODEGEN_ID by rpcs3/Emu/CMakeLists.txt; this
+// header is not.) Free-form values (paths, config names, details) are
+// percent-encoded so a space never splits a key=value token; '-' stands for an
+// empty value. The host cuts a milestone at 1 KiB including the "<thread>: "
+// prefix of the log listener, so each line is kept under line_budget bytes for
+// realistic values (the JITPROF_BOOT phases are split over two lines for that).
+// The only RPCS3 header used is JITPhaseProfile.h, itself standard C++.
+#include "Utilities/JITPhaseProfile.h"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <string_view>
+
+namespace rpcs3::ios::boot_diagnostics
+{
+	// Bound, for realistic values, on every line these formatters produce: it
+	// leaves 128 bytes for the listener's thread prefix under the host's 1 KiB
+	// milestone cut (checked by the host test with heavy-boot values).
+	inline constexpr std::size_t line_budget = 896;
+
+	// --- PPU boot pipeline counters ------------------------------------------
+	// Monotonic for the process lifetime (never exchanged with zero, unlike the
+	// 5 s reporter's counters); readers take deltas between two snapshots.
+	struct counters
+	{
+		std::atomic<std::uint64_t> boots{0};            // ppu_initialize() entries: the boot ordinal of this Core process
+		std::atomic<std::uint64_t> fragments{0};        // <= 1 MiB fragments walked by any ppu_initialize(module) pass (check passes included)
+		std::atomic<std::uint64_t> modules_total{0};    // fragments walked by a non-check pass (= compiled + cached + existing)
+		std::atomic<std::uint64_t> modules_compiled{0}; // cache misses handed to the LLVM workers ("LLVM: Compiling module")
+		std::atomic<std::uint64_t> modules_cached{0};   // cache hits of a module in use by emulation (loaded by the link loop)
+		std::atomic<std::uint64_t> modules_existing{0}; // cache hits of a precompile-only module ("LLVM: Module exists")
+		std::atomic<std::uint64_t> cache_hits{0};       // jit_compiler::check hits, every pass (same site as record_ppu_cache_lookup)
+		std::atomic<std::uint64_t> cache_misses{0};     // jit_compiler::check misses, every pass
+		std::atomic<std::uint64_t> objects_loaded{0};   // successful jit_compiler::add in the link loops (cached and freshly compiled)
+		std::atomic<std::uint64_t> link_ticks{0};       // TSC ticks spent inside the link loops
+
+		void note_cache_lookup(bool hit) noexcept
+		{
+			(hit ? cache_hits : cache_misses).fetch_add(1, std::memory_order_relaxed);
+		}
+	};
+
+	// Constant-initialized: no constructor runs during the Core's dlopen.
+	inline constinit counters g_counters{};
+
+	struct snapshot
+	{
+		std::uint64_t fragments = 0;
+		std::uint64_t modules_total = 0;
+		std::uint64_t modules_compiled = 0;
+		std::uint64_t modules_cached = 0;
+		std::uint64_t modules_existing = 0;
+		std::uint64_t cache_hits = 0;
+		std::uint64_t cache_misses = 0;
+		std::uint64_t objects_loaded = 0;
+		std::uint64_t link_ticks = 0;
+	};
+
+	inline snapshot take() noexcept
+	{
+		snapshot result{};
+		result.fragments = g_counters.fragments.load(std::memory_order_relaxed);
+		result.modules_total = g_counters.modules_total.load(std::memory_order_relaxed);
+		result.modules_compiled = g_counters.modules_compiled.load(std::memory_order_relaxed);
+		result.modules_cached = g_counters.modules_cached.load(std::memory_order_relaxed);
+		result.modules_existing = g_counters.modules_existing.load(std::memory_order_relaxed);
+		result.cache_hits = g_counters.cache_hits.load(std::memory_order_relaxed);
+		result.cache_misses = g_counters.cache_misses.load(std::memory_order_relaxed);
+		result.objects_loaded = g_counters.objects_loaded.load(std::memory_order_relaxed);
+		result.link_ticks = g_counters.link_ticks.load(std::memory_order_relaxed);
+		return result;
+	}
+
+	// end - begin, field by field (saturating at zero: counters only grow).
+	inline snapshot delta(const snapshot& begin, const snapshot& end) noexcept
+	{
+		const auto sub = [](std::uint64_t a, std::uint64_t b) { return a > b ? a - b : 0; };
+		snapshot result{};
+		result.fragments = sub(end.fragments, begin.fragments);
+		result.modules_total = sub(end.modules_total, begin.modules_total);
+		result.modules_compiled = sub(end.modules_compiled, begin.modules_compiled);
+		result.modules_cached = sub(end.modules_cached, begin.modules_cached);
+		result.modules_existing = sub(end.modules_existing, begin.modules_existing);
+		result.cache_hits = sub(end.cache_hits, begin.cache_hits);
+		result.cache_misses = sub(end.cache_misses, begin.cache_misses);
+		result.objects_loaded = sub(end.objects_loaded, begin.objects_loaded);
+		result.link_ticks = sub(end.link_ticks, begin.link_ticks);
+		return result;
+	}
+
+	// --- Text helpers --------------------------------------------------------
+	// Free-form values never split a key=value token: whitespace, '%' and
+	// control bytes are percent-encoded, the value is cut at `limit` bytes of
+	// input and an empty value prints as '-'.
+	inline std::string encode_value(std::string_view value, std::size_t limit = 256)
+	{
+		if (value.empty())
+		{
+			return "-";
+		}
+
+		std::string result;
+		result.reserve(value.size() + 8);
+
+		for (std::size_t index = 0; index < value.size() && index < limit; ++index)
+		{
+			const unsigned char byte = static_cast<unsigned char>(value[index]);
+
+			if (byte == '%' || byte <= 0x20 || byte == 0x7f)
+			{
+				char escaped[4];
+				std::snprintf(escaped, sizeof(escaped), "%%%02X", byte);
+				result += escaped;
+			}
+			else
+			{
+				result += static_cast<char>(byte);
+			}
+		}
+
+		return result;
+	}
+
+	inline void append_u64(std::string& line, const char* key, std::uint64_t value)
+	{
+		char buffer[48];
+		std::snprintf(buffer, sizeof(buffer), " %s=%llu", key, static_cast<unsigned long long>(value));
+		line += buffer;
+	}
+
+	inline void append_u32(std::string& line, const char* key, std::uint32_t value)
+	{
+		char buffer[48];
+		std::snprintf(buffer, sizeof(buffer), " %s=%u", key, static_cast<unsigned>(value));
+		line += buffer;
+	}
+
+	inline void append_hex32(std::string& line, const char* key, std::uint32_t value)
+	{
+		char buffer[48];
+		std::snprintf(buffer, sizeof(buffer), " %s=0x%x", key, static_cast<unsigned>(value));
+		line += buffer;
+	}
+
+	inline void append_text(std::string& line, const char* key, std::string_view value, std::size_t limit = 256)
+	{
+		line += ' ';
+		line += key;
+		line += '=';
+		line += encode_value(value, limit);
+	}
+
+	// Same conversion as the reporter's `milliseconds` lambda: 0 when the TSC
+	// frequency is unknown.
+	inline double ticks_to_ms(std::uint64_t ticks, std::uint64_t tsc_frequency) noexcept
+	{
+		return tsc_frequency ? static_cast<double>(ticks) * 1000.0 / static_cast<double>(tsc_frequency) : 0.0;
+	}
+
+	inline void append_ms(std::string& line, const char* key, std::uint64_t ticks, std::uint64_t tsc_frequency)
+	{
+		char buffer[64];
+		std::snprintf(buffer, sizeof(buffer), " %s=%.3f", key, ticks_to_ms(ticks, tsc_frequency));
+		line += buffer;
+	}
+
+	// --- NEOSTATION_RESTART --------------------------------------------------
+	enum class restart_reason : unsigned
+	{
+		other,
+		savestate_create,
+		savestate_load,
+		game_setting,
+		home_menu,
+		sys_game,
+	};
+
+	inline const char* restart_reason_token(restart_reason reason) noexcept
+	{
+		switch (reason)
+		{
+		case restart_reason::savestate_create: return "savestate_create";
+		case restart_reason::savestate_load: return "savestate_load";
+		case restart_reason::game_setting: return "game_setting";
+		case restart_reason::home_menu: return "home_menu";
+		case restart_reason::sys_game: return "sys_game";
+		case restart_reason::other: break;
+		}
+
+		return "other";
+	}
+
+	// "NEOSTATION_RESTART reason=<token or game_setting:<key>> title= detail="
+	inline std::string format_restart_line(restart_reason reason, std::string_view key, std::string_view title, std::string_view detail)
+	{
+		std::string line = "NEOSTATION_RESTART reason=";
+		line += restart_reason_token(reason);
+
+		if (reason == restart_reason::game_setting)
+		{
+			line += ':';
+			line += encode_value(key, 64);
+		}
+
+		append_text(line, "title", title, 64);
+		append_text(line, "detail", detail, 192);
+		return line;
+	}
+
+	// Hand-off from an announcing site to Emulator::Restart, which emits the
+	// line once per restart that proceeds. A refused or abandoned restart
+	// cancels the announcement so it can never label a later, unrelated one.
+	struct pending_restart
+	{
+		std::atomic<bool> lock{false};
+		bool armed = false;
+		restart_reason reason = restart_reason::other;
+		char key[64]{};
+		char detail[192]{};
+
+		void acquire() noexcept
+		{
+			while (lock.exchange(true, std::memory_order_acquire)) {}
+		}
+
+		void release() noexcept
+		{
+			lock.store(false, std::memory_order_release);
+		}
+	};
+
+	// Constant-initialized: no constructor runs during the Core's dlopen.
+	inline constinit pending_restart g_pending_restart{};
+
+	inline void copy_bounded(char* destination, std::size_t capacity, std::string_view source) noexcept
+	{
+		const std::size_t length = source.size() < capacity - 1 ? source.size() : capacity - 1;
+		if (length)
+		{
+			// An empty std::string_view{} has a null data(): never hand it to memcpy.
+			std::memcpy(destination, source.data(), length);
+		}
+		destination[length] = '\0';
+	}
+
+	inline void announce_restart(restart_reason reason, std::string_view key, std::string_view detail) noexcept
+	{
+		g_pending_restart.acquire();
+		g_pending_restart.armed = true;
+		g_pending_restart.reason = reason;
+		copy_bounded(g_pending_restart.key, sizeof(g_pending_restart.key), key);
+		copy_bounded(g_pending_restart.detail, sizeof(g_pending_restart.detail), detail);
+		g_pending_restart.release();
+	}
+
+	inline void cancel_restart_announcement() noexcept
+	{
+		g_pending_restart.acquire();
+		g_pending_restart.armed = false;
+		g_pending_restart.reason = restart_reason::other;
+		g_pending_restart.key[0] = '\0';
+		g_pending_restart.detail[0] = '\0';
+		g_pending_restart.release();
+	}
+
+	// Builds the line of a restart that proceeds and consumes the announcement;
+	// reason 'other' (detail 'unannounced') when no site announced it.
+	inline std::string consume_restart_line(std::string_view title)
+	{
+		restart_reason reason = restart_reason::other;
+		char key[sizeof(g_pending_restart.key)];
+		char detail[sizeof(g_pending_restart.detail)];
+
+		g_pending_restart.acquire();
+		const bool armed = g_pending_restart.armed;
+		reason = g_pending_restart.reason;
+		std::memcpy(key, g_pending_restart.key, sizeof(key));
+		std::memcpy(detail, g_pending_restart.detail, sizeof(detail));
+		g_pending_restart.armed = false;
+		g_pending_restart.reason = restart_reason::other;
+		g_pending_restart.key[0] = '\0';
+		g_pending_restart.detail[0] = '\0';
+		g_pending_restart.release();
+
+		if (!armed)
+		{
+			return format_restart_line(restart_reason::other, {}, title, "unannounced");
+		}
+
+		return format_restart_line(reason, key, title, detail);
+	}
+
+	// --- CONFIG_LAYERS -------------------------------------------------------
+	// Values are the Core's own cfg::to_string() text (config.yml spelling),
+	// percent-encoded like every other value of these lines.
+	struct config_layers
+	{
+		std::string_view title;
+		std::string_view name;          // g_cfg.name after every layer was applied
+		bool database = false;          // "Applying database config" succeeded on this boot
+		bool legacy_custom = false;     // a full custom_configs/config_<TITLE>.yml was applied ("Found custom config")
+		std::string_view legacy_path;   // its path, or empty
+		bool sparse_overrides = false;  // custom_configs/overrides/<TITLE>.yml existed and was applied
+		std::string_view shader_mode;
+		std::string_view frame_limit;
+		std::string_view wcb;
+		std::string_view wdb;
+		std::string_view rsx_res;
+		std::string_view spu_block;
+		std::string_view spu_decoder;
+		std::string_view ppu_decoder;
+		std::string_view async_tex;
+		std::string_view max_spurs;
+		std::string_view getllar_pct;
+		// REWINDBOX_LEGACY_CONFIG_INHERITANCE_V1: database leaves applied under a
+		// full file (it left them at the global value) and leaves it kept, then
+		// effective values the God of War III profile sets.
+		std::uint32_t inherited = 0;
+		std::uint32_t kept = 0;
+		std::string_view accurate_res;
+		std::string_view mt_rsx;
+		std::string_view spu_spin;
+		bool mlaa_bypass = false;
+	};
+
+	inline std::string format_config_layers_line(const config_layers& layers)
+	{
+		std::string line = "CONFIG_LAYERS";
+		append_text(line, "title", layers.title, 64);
+		append_text(line, "name", layers.name);
+		append_u32(line, "database", layers.database ? 1u : 0u);
+		append_u32(line, "legacy_custom", layers.legacy_custom ? 1u : 0u);
+		append_text(line, "legacy_path", layers.legacy_custom ? layers.legacy_path : std::string_view{});
+		append_u32(line, "sparse_overrides", layers.sparse_overrides ? 1u : 0u);
+		append_text(line, "shader_mode", layers.shader_mode, 64);
+		append_text(line, "frame_limit", layers.frame_limit, 64);
+		append_text(line, "wcb", layers.wcb, 16);
+		append_text(line, "wdb", layers.wdb, 16);
+		append_text(line, "rsx_res", layers.rsx_res, 16);
+		append_text(line, "spu_block", layers.spu_block, 64);
+		append_text(line, "spu_decoder", layers.spu_decoder, 64);
+		append_text(line, "ppu_decoder", layers.ppu_decoder, 64);
+		append_text(line, "async_tex", layers.async_tex, 16);
+		append_text(line, "max_spurs", layers.max_spurs, 16);
+		append_text(line, "getllar_pct", layers.getllar_pct, 16);
+		append_u32(line, "inherited", layers.inherited);
+		append_u32(line, "kept", layers.kept);
+		append_text(line, "accurate_res", layers.accurate_res, 16);
+		append_text(line, "mt_rsx", layers.mt_rsx, 16);
+		append_text(line, "spu_spin", layers.spu_spin, 16);
+		append_u32(line, "mlaa_bypass", layers.mlaa_bypass ? 1u : 0u);
+		return line;
+	}
+
+	// --- JITPROF_BOOT --------------------------------------------------------
+	struct jit_boot_summary
+	{
+		std::uint64_t session = 0;      // boot ordinal of this Core process (counters::boots)
+		bool savestate = false;         // boot_kind=savestate when Emu.DeserialManager() was set
+		snapshot modules;               // delta of the boot pipeline counters over ppu_initialize()
+		std::uint64_t wall_ticks = 0;   // ppu_initialize() entry to exit
+		std::uint64_t tsc_frequency = 0;
+		std::uint32_t ppu_pipeline = 0; // same ordinals as the reporter's JITPROF tail
+		std::uint32_t ppu_ir_passes = 0;
+		std::uint32_t spu_pipeline = 0;
+	};
+
+	// One phase field, exactly as the reporter's JITPROF prints it:
+	// name=events:total_ms:max_ms:bytes.
+	inline void append_phase(std::string& line, unsigned phase, const jit_phase::snapshot& phases, std::uint64_t tsc_frequency)
+	{
+		char buffer[128];
+		std::snprintf(buffer, sizeof(buffer), " %s=%llu:%.3f:%.3f:%llu", jit_phase::names[phase],
+			static_cast<unsigned long long>(phases.events[phase]),
+			ticks_to_ms(phases.ticks[phase], tsc_frequency),
+			ticks_to_ms(phases.max_ticks[phase], tsc_frequency),
+			static_cast<unsigned long long>(phases.bytes[phase]));
+		line += buffer;
+	}
+
+	// First JITPROF_BOOT line: the boot summary, the nine PPU phase fields of
+	// JITPROF (every phase printed, zeros included), headroom_samples/
+	// headroom_min_mib (sampled after PPU module compiles) and the pipeline tail.
+	// All fifteen phases on one line could exceed the host's 1 KiB milestone cut
+	// on a long boot (LLVM precompilation also runs SPU phases inside
+	// ppu_initialize()), so the six SPU phases follow on a second line.
+	inline std::string format_jitprof_boot_line(const jit_boot_summary& summary, const jit_phase::snapshot& phases)
+	{
+		std::string line = "JITPROF_BOOT";
+		append_u64(line, "session", summary.session);
+		line += " boot_kind=";
+		line += summary.savestate ? "savestate" : "fresh";
+		append_u64(line, "modules_total", summary.modules.modules_total);
+		append_u64(line, "modules_compiled", summary.modules.modules_compiled);
+		append_u64(line, "modules_cached", summary.modules.modules_cached);
+		append_u64(line, "modules_existing", summary.modules.modules_existing);
+		append_u64(line, "ppu_cache_hits", summary.modules.cache_hits);
+		append_u64(line, "ppu_cache_misses", summary.modules.cache_misses);
+		append_ms(line, "wall_ms", summary.wall_ticks, summary.tsc_frequency);
+
+		for (unsigned phase = 0; phase < jit_phase::spu_build; ++phase)
+		{
+			append_phase(line, phase, phases, summary.tsc_frequency);
+		}
+
+		{
+			char buffer[96];
+			std::snprintf(buffer, sizeof(buffer), " headroom_samples=%llu headroom_min_mib=%.3f",
+				static_cast<unsigned long long>(phases.headroom_samples),
+				phases.headroom_samples ? static_cast<double>(phases.headroom_min_bytes) / 0x100000 : 0.0);
+			line += buffer;
+		}
+
+		append_u32(line, "ppu_pipeline", summary.ppu_pipeline);
+		append_u32(line, "ppu_ir_passes", summary.ppu_ir_passes);
+		append_u32(line, "spu_pipeline", summary.spu_pipeline);
+		return line;
+	}
+
+	// Second JITPROF_BOOT line, always emitted right after the first one:
+	// "JITPROF_BOOT session=<n> boot_kind=<k> part=spu" and the six SPU phase
+	// fields of JITPROF (every phase printed, zeros included).
+	inline std::string format_jitprof_boot_spu_line(const jit_boot_summary& summary, const jit_phase::snapshot& phases)
+	{
+		std::string line = "JITPROF_BOOT";
+		append_u64(line, "session", summary.session);
+		line += " boot_kind=";
+		line += summary.savestate ? "savestate" : "fresh";
+		line += " part=spu";
+
+		for (unsigned phase = jit_phase::spu_build; phase < jit_phase::count; ++phase)
+		{
+			append_phase(line, phase, phases, summary.tsc_frequency);
+		}
+
+		return line;
+	}
+
+	// --- SAVESTATE_BOOT ------------------------------------------------------
+	// First line, after _main.analyse() and the main-module cache check.
+	// `fragments` counts the fragments walked by that check pass: complete when
+	// every fragment is cached, cut at the first miss otherwise (the check pass
+	// returns at its first miss); fragments_total of the second line is exact.
+	inline std::string format_savestate_analysis_line(std::string_view title, std::uint64_t applied_patches,
+		std::uint32_t seg0_code_end, std::uint64_t funcs, std::uint64_t fragments)
+	{
+		std::string line = "SAVESTATE_BOOT";
+		append_text(line, "title", title, 64);
+		append_u64(line, "applied_patches", applied_patches);
+		append_hex32(line, "seg0_code_end", seg0_code_end);
+		append_u64(line, "funcs", funcs);
+		append_u64(line, "fragments", fragments);
+		return line;
+	}
+
+	// Second line, after the object load loops of the boot.
+	inline std::string format_savestate_link_line(std::string_view title, const snapshot& boot, std::uint64_t tsc_frequency)
+	{
+		std::string line = "SAVESTATE_BOOT";
+		append_text(line, "title", title, 64);
+		append_u64(line, "ppu_cache_hits", boot.cache_hits);
+		append_u64(line, "ppu_cache_misses", boot.cache_misses);
+		append_u64(line, "objects_loaded", boot.objects_loaded);
+		append_ms(line, "link_ms", boot.link_ticks, tsc_frequency);
+		append_u64(line, "fragments_total", boot.modules_total);
+		return line;
+	}
+}
diff --git a/rpcs3/ios/RPCS3IOSConfigInheritance.h b/rpcs3/ios/RPCS3IOSConfigInheritance.h
new file mode 100644
index 0000000..23005f9
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSConfigInheritance.h
@@ -0,0 +1,119 @@
+#pragma once
+
+// REWINDBOX_LEGACY_CONFIG_INHERITANCE_V1: a full custom_configs/config_<TITLE>.yml
+// written by an earlier build is a snapshot of every setting, taken at the
+// title's first per-game change. Upstream then ignores the title's database
+// (GameDB/RewindBox profile) config entirely. God of War III ran every build
+// from 412 to 547 on such a snapshot (CONFIG_LAYERS legacy_custom=1
+// database=0): none of its profile settings was ever applied. A snapshot value
+// equal to the global config is not a choice the file made, so the database
+// value applies there; a value the file changed relative to the global config
+// stays. The result is the layering titles without a snapshot already get:
+// global < database < the file's own changes.
+
+#include "util/yaml.hpp"
+
+#include <string>
+
+namespace rpcs3::ios::config_inheritance
+{
+	struct result
+	{
+		std::string yaml;       // database settings to apply after the full file
+		unsigned inherited = 0; // database leaves the file left at the global value
+		unsigned kept = 0;      // database leaves the file changed: its value stays
+		bool ok = false;        // the three documents parsed and the database is a map
+	};
+
+	namespace detail
+	{
+		inline YAML::Node child(const YAML::Node& node, const std::string& key)
+		{
+			if (node.IsDefined() && node.IsMap())
+			{
+				return node[key];
+			}
+
+			return YAML::Node(YAML::NodeType::Undefined);
+		}
+
+		// Scalars compare as written by cfg::node::to_string(); sequences and maps
+		// compare as their emitted text.
+		inline std::string leaf_text(const YAML::Node& node)
+		{
+			if (!node.IsDefined() || node.IsNull())
+			{
+				return {};
+			}
+
+			if (node.IsScalar())
+			{
+				return node.Scalar();
+			}
+
+			return YAML::Dump(node);
+		}
+
+		inline void filter(const YAML::Node& database, const YAML::Node& file, const YAML::Node& global, YAML::Node& out, result& r)
+		{
+			for (const auto& entry : database)
+			{
+				if (!entry.first.IsScalar())
+				{
+					continue;
+				}
+
+				const std::string key = entry.first.Scalar();
+				const YAML::Node value = entry.second;
+				const YAML::Node in_file = child(file, key);
+				const YAML::Node in_global = child(global, key);
+
+				if (value.IsMap())
+				{
+					YAML::Node section(YAML::NodeType::Map);
+					filter(value, in_file, in_global, section, r);
+
+					if (section.size())
+					{
+						out[key] = section;
+					}
+				}
+				else if (in_file.IsDefined() && leaf_text(in_file) != leaf_text(in_global))
+				{
+					r.kept++;
+				}
+				else
+				{
+					out[key] = value;
+					r.inherited++;
+				}
+			}
+		}
+	}
+
+	// database: the title's database config; file: the full config file applied
+	// on this boot; global: g_cfg.to_string() before that file was applied.
+	inline result inherit_database(const std::string& database, const std::string& file, const std::string& global)
+	{
+		result r;
+		const auto [database_node, database_error] = yaml_load(database);
+		const auto [file_node, file_error] = yaml_load(file);
+		const auto [global_node, global_error] = yaml_load(global);
+
+		if (!database_error.empty() || !file_error.empty() || !global_error.empty() || !database_node.IsMap())
+		{
+			return r;
+		}
+
+		YAML::Node out(YAML::NodeType::Map);
+		detail::filter(database_node, file_node, global_node, out, r);
+		r.ok = true;
+
+		if (r.inherited)
+		{
+			r.yaml = YAML::Dump(out);
+		}
+
+		return r;
+	}
+}
