diff --git a/rpcs3/Emu/Cell/SPUObjectCachePolicy.h b/rpcs3/Emu/Cell/SPUObjectCachePolicy.h
new file mode 100644
index 0000000..9d87383
--- /dev/null
+++ b/rpcs3/Emu/Cell/SPUObjectCachePolicy.h
@@ -0,0 +1,131 @@
+#pragma once
+
+// NEOSTATION_BUILD481_SPU_OBJECT_CACHE_V1: policy of the persistent ARM64 SPU
+// object cache. Pure, allocation-light and LLVM-free so the host test suite
+// can execute it (test/native/rpcs3_build481_spu_object_cache_test.cpp).
+//
+// Why ARM64 objects can be persisted since Build 481: the SPU translator no
+// longer bakes any host address into the IR as an integer constant. Every host
+// reference (dispatcher, escape, patchpoints, segment base, timebase offset)
+// is an external symbol that MCJIT resolves through the engine's global
+// mapping when an object is loaded, in whatever process loads it. Before the
+// change, SPU_RdDec materialized &g_timebase_offs as movz/movk immediates with
+// no relocation (ARMSX3 457a932c7 documents the resulting crash), which is why
+// the cache stayed disabled on ARM64 until now.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace rpcs3::spu::object_cache
+{
+	// Bump whenever the on-disk layout or the key composition changes; older
+	// directories are removed as "another build" at the next boot.
+	inline constexpr std::uint32_t format_version = 6;
+
+	// Bounds of one title's directory. Objects are a few KiB each (gzip);
+	// 40,000 files is ARMSX3's iOS bound, 512 MiB keeps a worst case of large
+	// Mega blocks below the per-title shader and metadata caches.
+	inline constexpr std::size_t max_files = 40'000;
+	inline constexpr std::uint64_t max_bytes = 512ull << 20;
+
+	// After a bound is crossed, the oldest objects are removed until both
+	// bounds are at this fraction, so the next boots do not evict again at once.
+	inline constexpr unsigned low_water_percent = 90;
+
+	// True once every host reference of the SPU translator is symbolic. The
+	// experimental policy resolves "Automatic" to this value on ARM64.
+	inline constexpr bool arm64_objects_relocatable = true;
+
+	// iOS 64-bit processes keep __PAGEZERO over the first 4 GiB: every host
+	// pointer (image, heap, JIT arena, stacks) is above it, while guest
+	// addresses and local-store offsets are below. An integer constant turned
+	// into a pointer above this floor is therefore a baked host address.
+	inline constexpr std::uint64_t host_address_floor = 1ull << 32;
+
+	constexpr bool is_host_address_constant(std::uint64_t value) noexcept
+	{
+		return value >= host_address_floor;
+	}
+
+	struct entry
+	{
+		std::string name;
+		std::uint64_t bytes = 0;
+		std::int64_t mtime = 0;
+	};
+
+	struct eviction_plan
+	{
+		std::vector<std::string> remove; // oldest first
+		std::size_t kept_files = 0;
+		std::uint64_t kept_bytes = 0;
+		std::uint64_t removed_bytes = 0;
+	};
+
+	// Selects the oldest entries (by mtime, then name for determinism) to remove
+	// when the directory exceeds either bound. Within bounds nothing is removed.
+	inline eviction_plan plan_eviction(std::vector<entry> entries,
+		std::size_t file_limit = max_files, std::uint64_t byte_limit = max_bytes, unsigned low_water = low_water_percent)
+	{
+		eviction_plan plan;
+		std::uint64_t total = 0;
+
+		for (const entry& item : entries)
+		{
+			total += item.bytes;
+		}
+
+		plan.kept_files = entries.size();
+		plan.kept_bytes = total;
+
+		if (entries.size() <= file_limit && total <= byte_limit)
+		{
+			return plan;
+		}
+
+		const std::size_t file_target = static_cast<std::size_t>(static_cast<std::uint64_t>(file_limit) * low_water / 100);
+		const std::uint64_t byte_target = byte_limit / 100 * low_water;
+
+		std::sort(entries.begin(), entries.end(), [](const entry& a, const entry& b)
+		{
+			return a.mtime != b.mtime ? a.mtime < b.mtime : a.name < b.name;
+		});
+
+		for (entry& item : entries)
+		{
+			if (plan.kept_files <= file_target && plan.kept_bytes <= byte_target)
+			{
+				break;
+			}
+
+			plan.kept_files--;
+			plan.kept_bytes -= item.bytes;
+			plan.removed_bytes += item.bytes;
+			plan.remove.push_back(std::move(item.name));
+		}
+
+		return plan;
+	}
+
+	// Codegen variants of the ARM64 register-pressure retries produce different
+	// machine code for the same guest bytes; they never share an object name.
+	inline std::string variant_suffix(bool use_tbl2, bool use_fma)
+	{
+		std::string suffix;
+
+		if (!use_tbl2)
+		{
+			suffix += "-notbl2";
+		}
+
+		if (!use_fma)
+		{
+			suffix += "-nofma";
+		}
+
+		return suffix;
+	}
+}
