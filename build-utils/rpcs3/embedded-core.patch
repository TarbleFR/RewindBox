+			ticks[which].fetch_add(elapsed_ticks, std::memory_order_relaxed);
+			bytes[which].fetch_add(byte_count, std::memory_order_relaxed);
+			auto previous = max_ticks[which].load(std::memory_order_relaxed);
+			while (previous < elapsed_ticks &&
+				!max_ticks[which].compare_exchange_weak(previous, elapsed_ticks, std::memory_order_relaxed)) {}
+			total_events[which].fetch_add(1, std::memory_order_relaxed);
+			total_ticks[which].fetch_add(elapsed_ticks, std::memory_order_relaxed);
+			total_bytes[which].fetch_add(byte_count, std::memory_order_relaxed);
+			auto window_previous = window_max_ticks[which].load(std::memory_order_relaxed);
+			while (window_previous < elapsed_ticks &&
+				!window_max_ticks[which].compare_exchange_weak(window_previous, elapsed_ticks, std::memory_order_relaxed)) {}
+		}
+
+		void note_headroom(std::uint64_t headroom_bytes) noexcept
+		{
+			headroom_samples.fetch_add(1, std::memory_order_relaxed);
+			auto previous = headroom_min.load(std::memory_order_relaxed);
+			while (previous > headroom_bytes &&
+				!headroom_min.compare_exchange_weak(previous, headroom_bytes, std::memory_order_relaxed)) {}
+			total_headroom_samples.fetch_add(1, std::memory_order_relaxed);
+			auto window_previous = window_headroom_min.load(std::memory_order_relaxed);
+			while (window_previous > headroom_bytes &&
+				!window_headroom_min.compare_exchange_weak(window_previous, headroom_bytes, std::memory_order_relaxed)) {}
+		}
