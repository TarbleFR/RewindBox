diff --git a/rpcs3/ios/RPCS3IOSWriterCounters.h b/rpcs3/ios/RPCS3IOSWriterCounters.h
new file mode 100644
index 0000000..f54ef27
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSWriterCounters.h
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cstdint>
+#include <mutex>
+namespace rpcs3::ios::diagnostics {
+class WriterCounters final {
+public:
+ static constexpr uint32_t sources=5, shard_count=64;
+ struct Total {uint64_t count=0,acquire=0,hold=0,maximum=0;};
+ void record(uint32_t source,uint64_t acquire,uint64_t hold) noexcept {
+  const auto slot=thread_slot();
+  auto& entry=shards_[slot].source[source<sources?source:0];
+  // CELL539_WRITER_COUNTERS: a unique live writer owns each normal slot.
+  // The reporter only reads cumulative totals, so these increments need no
+  // read-modify-write instruction. Fields stay atomic for the concurrent reader.
+  // Overflow threads share the last slot and retain exact atomic increments.
+  if(slot==shard_count-1){
+   entry.count.fetch_add(1,std::memory_order_relaxed);
+   if(acquire)entry.acquire.fetch_add(acquire,std::memory_order_relaxed);
+   if(hold)entry.hold.fetch_add(hold,std::memory_order_relaxed);
+  }else{
+   entry.count.store(entry.count.load(std::memory_order_relaxed)+1,std::memory_order_relaxed);
+   if(acquire)entry.acquire.store(entry.acquire.load(std::memory_order_relaxed)+acquire,std::memory_order_relaxed);
+   if(hold)entry.hold.store(entry.hold.load(std::memory_order_relaxed)+hold,std::memory_order_relaxed);
+  }
+  auto maximum=entry.maximum.load(std::memory_order_relaxed);
+  while(maximum<hold&&!entry.maximum.compare_exchange_weak(maximum,hold,std::memory_order_relaxed)){}
+ }
+ std::array<Total,sources> drain() noexcept {
+  // No writer takes this mutex. Serialize reporter/reset cursors only.
+  std::lock_guard lock(drain_mutex_);
+  std::array<Total,sources> result{};
+  for(uint32_t s=0;s<shard_count;++s)for(uint32_t i=0;i<sources;++i){
+   auto& shard=shards_[s];auto& cursor=cursors_[s][i];
+   auto& entry=shard.source[i];auto& total=result[i];
+   const auto count=entry.count.load(std::memory_order_relaxed);
+   const auto acquire=entry.acquire.load(std::memory_order_relaxed);
+   const auto hold=entry.hold.load(std::memory_order_relaxed);
+   // Unsigned subtraction also preserves totals across counter wraparound.
+   total.count+=count-cursor.count;cursor.count=count;
+   total.acquire+=acquire-cursor.acquire;cursor.acquire=acquire;
+   total.hold+=hold-cursor.hold;cursor.hold=hold;
+   const auto maximum=entry.maximum.exchange(0,std::memory_order_relaxed);
+   if(maximum>total.maximum)total.maximum=maximum;
+  }
+  return result;
+ }
+private:
+ struct Entry {std::atomic<uint64_t> count{0},acquire{0},hold{0},maximum{0};};
+ struct alignas(128) Shard {std::array<Entry,sources> source{};};
+ // Slot ownership is per live thread, independent of a counter object's lifetime.
+ // TLS retirement touches only this process-static bitmap, never a registry or
+ // a destroyed counter. Acquire/release hands cumulative stores to a new owner.
+ inline static constinit std::atomic<uint64_t> occupied_{0};
+ // A late TLS destructor may still record after our lease is retired. Keep
+ // the trivial index alive and route such calls through the shared RMW slot.
+ inline static thread_local constinit uint32_t slot_index_=shard_count;
+ struct ThreadLease {
+  ThreadLease() noexcept {
+   slot_index_=shard_count-1;
+   constexpr uint64_t exclusive_mask=(uint64_t{1}<<(shard_count-1))-1;
+   auto used=occupied_.load(std::memory_order_relaxed);
+   while(const auto available=~used&exclusive_mask){
+    const auto candidate=static_cast<uint32_t>(std::countr_zero(available));
+    if(occupied_.compare_exchange_weak(used,used|(uint64_t{1}<<candidate),std::memory_order_acquire,std::memory_order_relaxed)){
+     slot_index_=candidate;return;
+    }
+   }
+  }
+  ~ThreadLease(){
+   const auto index=slot_index_;slot_index_=shard_count-1;
+   if(index<shard_count-1)occupied_.fetch_and(~(uint64_t{1}<<index),std::memory_order_release);
+  }
+  ThreadLease(const ThreadLease&)=delete;
+ };
+ // Keep registration/destructor setup off the per-event path. Darwin TLS
+ // access itself needs a call; the initialized path reads only this one index,
+ // without a second TLS guard lookup. Retired/overflow threads keep index63.
+ [[gnu::noinline]] static uint32_t initialize_slot() noexcept {
+  static thread_local const ThreadLease lease;
+  return slot_index_;
+ }
+ static uint32_t thread_slot() noexcept {
+  const auto index=slot_index_;
+  return index<shard_count?index:initialize_slot();
+ }
+ std::array<Shard,shard_count> shards_{};
+ struct Cursor {uint64_t count=0,acquire=0,hold=0;};
+ std::array<std::array<Cursor,sources>,shard_count> cursors_{};
+ std::mutex drain_mutex_;
+};
+}
