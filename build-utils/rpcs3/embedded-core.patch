+{
+	write_non_native_indices_precomputed(d, p, n);
+}
+struct configuration
+{
+	struct
+	{
+		bool multithreaded_rsx = true;
+	} video;
+} g_cfg;
+struct worker
+{
+	enum op
+	{
+		raw_copy,
+		vector_copy,
