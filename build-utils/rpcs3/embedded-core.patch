+// NEOSTATION_BUILD435_SPU_DEFERRED_COMPILE_V1: worker pool that compiles missed
+// SPU programs off the SPU threads. Each worker owns one LLVM recompiler and a
+// scratch local store, exactly like the warmup workers; publication goes
+// through spu_llvm_recompiler::compile() (claim, build, install, trampoline),
+// so the SPU threads observe the module exactly as a warmup result.
+struct spu_deferred_compiler;
+
+struct spu_deferred_worker
+{
+	spu_deferred_compiler* pool;
+
+	void operator()();
+};
+
+struct spu_deferred_compiler
+{
+	lf_queue<spu_item*> requests;
+	shared_mutex backlog_mutex;
+	std::vector<spu_item*> backlog;
+	atomic_t<u32> pending = 0;
+	atomic_t<u64> sequence = 0;
+	const u32 worker_count;
+	std::unique_ptr<named_thread_group<spu_deferred_worker>> workers;
+
+	spu_deferred_compiler()
+		: worker_count(rpcs3::spu::deferred_worker_count(utils::get_thread_count()))
+	{
+		workers = std::make_unique<named_thread_group<spu_deferred_worker>>("SPU Deferred "sv, worker_count, spu_deferred_worker{this});
+	}
+
+	spu_deferred_compiler(const spu_deferred_compiler&) = delete;
+	spu_deferred_compiler& operator=(const spu_deferred_compiler&) = delete;
+
+	~spu_deferred_compiler()
+	{
+		if (workers)
+		{
+			for (u32 i = 0; i < workers->size(); i++)
+			{
+				(workers->begin() + i)->operator=(thread_state::aborting);
+			}
+
+			requests.get_wait_atomic().notify_all();
+			workers.reset();
+		}
+	}
+
+	// Called from an SPU thread on a dispatcher miss. False when saturated.
+	bool enqueue(spu_item* item, u64 now_tsc)
+	{
+		if (pending.load() >= rpcs3::spu::deferred_queue_limit)
+		{
+			return false;
+		}
+
+		pending++;
+		item->deferred_sequence = ++sequence;
+		item->deferred_enqueued_tsc = now_tsc;
+		requests.push(item);
+		return true;
+	}
+
+	// Called from a worker: the hottest waiting request, or null.
+	spu_item* take()
+	{
+		std::lock_guard lock(backlog_mutex);
+
+		for (auto slice = requests.pop_all(); slice; slice.pop_front())
+		{
+			backlog.push_back(*slice.get());
+		}
+
+		if (backlog.empty())
+		{
+			return nullptr;
+		}
+
+		usz best = 0;
+
+		for (usz i = 1; i < backlog.size(); i++)
+		{
+			if (rpcs3::spu::prefer_request(backlog[i]->deferred_hits, backlog[i]->deferred_sequence,
+				backlog[best]->deferred_hits, backlog[best]->deferred_sequence))
+			{
+				best = i;
+			}
+		}
+
+		spu_item* item = backlog[best];
+		backlog[best] = backlog.back();
+		backlog.pop_back();
+
+		if (!backlog.empty())
+		{
+			// More work than this worker: wake another one (a spurious wake is harmless).
+			requests.get_wait_atomic().notify_one();
+		}
+
+		return item;
+	}
+};
+
+void spu_deferred_worker::operator()()
+{
+	std::unique_ptr<spu_recompiler_base> compiler;
+	std::vector<be_t<u32>> ls;
+
+	while (thread_ctrl::state() != thread_state::aborting)
+	{
+		spu_item* item = pool->take();
+
+		if (!item)
+		{
+			thread_ctrl::wait_on(pool->requests.get_wait_atomic(), 0);
+			continue;
+		}
+
+		if (!compiler)
+		{
+			compiler = spu_recompiler_base::make_llvm_recompiler();
+			compiler->init();
+			ls.resize(SPU_LS_SIZE / sizeof(be_t<u32>));
+		}
+
+		const spu_program& func = item->data;
+		const u32 start = func.lower_bound;
+		const u32 size0 = ::size32(func.data);
+
+		for (u32 i = 0, pos = start; i < size0; i++, pos += 4)
+		{
+			ls[pos / 4] = std::bit_cast<be_t<u32>>(func.data[i]);
+		}
+
+		const u64 compile_started = utils::get_tsc();
+		spu_function_t target = nullptr;
+		spu_program func2 = compiler->analyse(ls.data(), func.entry_point);
+
+		if (func2 != func)
+		{
+			// The program depends on local store outside its own bytes: the SPU
+			// thread that owns the real local store compiles it inline instead.
+			spu_log.error("[0x%05x] SPU deferred analyser mismatch, %u vs %u; compiling inline from now on", func.entry_point, func2.data.size(), size0);
+			item->deferred_inline.release(1);
+		}
+		else
+		{
+			target = compile_spu_llvm_with_retry(compiler, func2);
+		}
+
+		rpcs3::spu::clear_warmup_local_store(std::span{ls.data() + start / 4, size0});
+		const u64 finished = utils::get_tsc();
+		rpcs3::ios::record_spu_deferred_compile(target != nullptr,
+			finished >= item->deferred_enqueued_tsc ? finished - item->deferred_enqueued_tsc : 0,
+			finished >= compile_started ? finished - compile_started : 0);
+		pool->pending--;
+	}
