+bool arm_moltenvk_async_boot() noexcept
+{
+	std::lock_guard lock(s_mvk_canary_mutex);
+	if (!s_policy.moltenvk_async_submits)
+	{
+		return false;
+	}
+
+	if (s_mvk_canary_armed)
+	{
+		return true;
+	}
+
+	auto records = read_mvk_canary();
+	if (mvk_async_canary::on_boot(records, s_mvk_canary_title, true) != mvk_async_canary::verdict::run || !write_mvk_canary(records))
+	{
+		s_policy.moltenvk_async_submits = false;
+		s_mvk_canary_verdict = mvk_async_canary::verdict::record_failed;
+		ios_experimental_log.error("MoltenVK asynchronous submits off for this boot: the boot record of %s could not be written", s_mvk_canary_title);
+		return false;
+	}
+
+	s_mvk_canary_armed = true;
+	return true;
+}
+
+void note_moltenvk_async_flip() noexcept
+{
+	if (s_mvk_canary_confirmed.load(std::memory_order_relaxed) ||
+		s_mvk_canary_flips.fetch_add(1, std::memory_order_relaxed) + 1 != mvk_async_canary::confirm_presents)
+	{
+		return;
+	}
+
+	std::lock_guard lock(s_mvk_canary_mutex);
+	confirm_mvk_async_locked("guest flips");
+}
+
+void confirm_moltenvk_async_boot(const char* reason) noexcept
+{
+	std::lock_guard lock(s_mvk_canary_mutex);
+	confirm_mvk_async_locked(reason);
+}
+
+const char* moltenvk_async_canary_verdict() noexcept
+{
+	std::lock_guard lock(s_mvk_canary_mutex);
+	return mvk_async_canary::verdict_name(s_mvk_canary_verdict).data();
+}
+
+bool moltenvk_async_boot_confirmed() noexcept
+{
+	return s_mvk_canary_confirmed.load(std::memory_order_relaxed);
