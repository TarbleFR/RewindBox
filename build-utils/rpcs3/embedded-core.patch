+	rsx::texture_channel_remap_t remap_from(u32 encoded)
+	{
+		// The RSX encoding: 8 bits of channel selectors (A, R, G, B order, 2 bits each), 8 bits of control.
+		return rsx::decode_remap_encoding(encoded);
