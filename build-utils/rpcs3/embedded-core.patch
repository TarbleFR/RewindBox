+inline v128 gv_sar16_full(const v128& a, const v128& count)
+{
+#if defined(ARCH_ARM64)
+	return vshlq_s16(a, vnegq_s16(vreinterpretq_s16_u16(vminq_u16(count, vdupq_n_u16(15)))));
+#else
+	v128 result;
+	for (u32 i = 0; i < 8; ++i)
+		result._s16[i] = a._s16[i] >> std::min<u16>(count._u16[i], 15);
+	return result;
+#endif
+}
+
+inline v128 gv_sar32_full(const v128& a, const v128& count)
+{
+#if defined(ARCH_ARM64)
+	return vshlq_s32(a, vnegq_s32(vreinterpretq_s32_u32(vminq_u32(count, vdupq_n_u32(31)))));
+#else
+	v128 result;
+	for (u32 i = 0; i < 4; ++i)
+		result._s32[i] = a._s32[i] >> std::min<u32>(count._u32[i], 31);
+	return result;
+#endif
+}
+
+// Low bit of lane i becomes bit i of the scalar result.
+inline u32 gv_gather_bits8(const v128& a)
+{
+#if defined(ARCH_ARM64)
+	constexpr int8x16_t positions = {0,1,2,3,4,5,6,7,0,1,2,3,4,5,6,7};
+	const auto weighted = vshlq_u8(vandq_u8(a, vdupq_n_u8(1)), positions);
+	const auto sums = vpaddlq_u32(vpaddlq_u16(vpaddlq_u8(weighted)));
+	return u32(vgetq_lane_u64(sums, 0)) | u32(vgetq_lane_u64(sums, 1)) << 8;
+#else
+	return _mm_movemask_epi8(_mm_slli_epi64(a, 7));
+#endif
+}
+
+inline u32 gv_gather_bits16(const v128& a)
+{
+#if defined(ARCH_ARM64)
+	constexpr int16x8_t positions = {0,1,2,3,4,5,6,7};
+	return vaddvq_u16(vshlq_u16(vandq_u16(a, vdupq_n_u16(1)), positions));
+#else
+	return _mm_movemask_epi8(_mm_packs_epi16(_mm_slli_epi16(a, 15), _mm_setzero_si128()));
+#endif
+}
+
+inline u32 gv_gather_bits32(const v128& a)
+{
+#if defined(ARCH_ARM64)
+	constexpr int32x4_t positions = {0,1,2,3};
+	return vaddvq_u32(vshlq_u32(vandq_u32(a, vdupq_n_u32(1)), positions));
+#else
+	return _mm_movemask_ps(_mm_castsi128_ps(_mm_slli_epi32(a, 31)));
+#endif
+}
+
+inline v128 gv_expand_mask8(u32 bits)
+{
+#if defined(ARCH_ARM64)
+	constexpr uint8x16_t weights = {1,2,4,8,16,32,64,128,1,2,4,8,16,32,64,128};
+	const auto value = vcombine_u8(vdup_n_u8(u8(bits)), vdup_n_u8(u8(bits >> 8)));
+	return vceqq_u8(vandq_u8(value, weights), weights);
+#else
+	v128 result;
+	for (u32 i = 0; i < 16; ++i)
+		result._u8[i] = (bits >> i & 1) ? 0xff : 0;
+	return result;
+#endif
+}
+
+inline v128 gv_expand_mask16(u32 bits)
+{
+#if defined(ARCH_ARM64)
+	constexpr uint16x8_t weights = {1,2,4,8,16,32,64,128};
+	return vceqq_u16(vandq_u16(vdupq_n_u16(u16(bits)), weights), weights);
+#else
+	v128 result;
+	for (u32 i = 0; i < 8; ++i)
+		result._u16[i] = (bits >> i & 1) ? 0xffff : 0;
+	return result;
+#endif
+}
+
+inline v128 gv_expand_mask32(u32 bits)
+{
+#if defined(ARCH_ARM64)
+	constexpr uint32x4_t weights = {1,2,4,8};
+	return vceqq_u32(vandq_u32(vdupq_n_u32(bits), weights), weights);
+#else
+	v128 result;
+	for (u32 i = 0; i < 4; ++i)
+		result._u32[i] = (bits >> i & 1) ? 0xffffffff : 0;
+	return result;
+#endif
+}
+
+// Variable byte windows deliberately retain the measured native load/store
+// algorithm. A TBL1 version was slower on the matched Apple ARM64 host probe.
+// Preserve the original 32/64-byte temporary alignment: a variable load must
+// not acquire avoidable cache-line splits during the API migration. These are
+// host temporaries only; the guest/register alignment contract remains 16 bytes.
+inline v128 gv_rotl128_bytes(const v128& a, u32 count)
+{
+	alignas(32) const v128 window[2]{a, a};
+	return v128::loadu(reinterpret_cast<const u8*>(window) + (16 - (count & 15)));
+}
+
+inline v128 gv_shl128_bytes(const v128& a, u32 count)
+{
+	// Counts 16..31 naturally select only zero bytes; clamping to 31 keeps
+	// every window within these 48 bytes. Existing &31 callers fold the clamp.
+	count = std::min<u32>(count, 31);
+	alignas(64) const v128 window[3]{{}, {}, a};
+	return v128::loadu(reinterpret_cast<const u8*>(window) + (32 - count));
+}
+
+inline v128 gv_shr128_bytes(const v128& a, u32 count)
+{
+	count = std::min<u32>(count, 31);
+	alignas(64) const v128 window[3]{a, {}, {}};
+	return v128::loadu(reinterpret_cast<const u8*>(window) + count);
+}
+
+// Out-of-range unsigned indices produce zero, including 0x80..0xff. Unlike
+// PSHUFB this is a 32-byte table and does not discard index bits 4..6.
+inline v128 gv_shuffle2_bytes(const v128& a, const v128& b, const v128& indices)
+{
+#if defined(ARCH_ARM64)
+	return vqtbl2q_u8({a, b}, indices);
+#else
+	v128 result{};
+	for (u32 i = 0; i < 16; ++i)
+	{
+		const auto n = indices._u8[i];
+		result._u8[i] = n < 16 ? a._u8[n] : n < 32 ? b._u8[n - 16] : 0;
+	}
+	return result;
+#endif
+}
+
+inline v128 gv_byteswap16(const v128& a)
+{
+#if defined(ARCH_ARM64)
+	return vrev16q_u8(a);
+#else
+	return gv_or32(gv_shl16(a, 8), gv_shr16(a, 8));
+#endif
+}
