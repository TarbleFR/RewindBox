+
+// Optional diagnostic getter, independent of both the allocator v1 vtable and
+// RPCS3's runtime ABI. Counts reflect actual allocator decisions, not RAM gains.
+enum { NEOSWAP_CLIENT_STATS_ABI = 1 };
