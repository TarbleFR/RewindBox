+				static_cast<MTLTextureSwizzle>(descriptor.swizzle[0]), static_cast<MTLTextureSwizzle>(descriptor.swizzle[1]),
+				static_cast<MTLTextureSwizzle>(descriptor.swizzle[2]), static_cast<MTLTextureSwizzle>(descriptor.swizzle[3]));
+			return keep([as<id<MTLTexture>>(texture) newTextureViewWithPixelFormat:static_cast<MTLPixelFormat>(descriptor.format)
+				textureType:static_cast<MTLTextureType>(descriptor.type)
+				levels:NSMakeRange(descriptor.base_level, descriptor.level_count)
+				slices:NSMakeRange(descriptor.base_slice, descriptor.slice_count)
+				swizzle:channels]);
+		}
+	}
