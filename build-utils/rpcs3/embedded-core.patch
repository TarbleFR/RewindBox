+++ b/rpcs3/ios/RPCS3IOSLeverHelpers.h
@@ -0,0 +1,307 @@
+#pragma once
+
+// NEOSTATION_BUILD487_DIAGNOSTICS_V1 (WP-D, levers L2 and L5): pure helpers
+// of the Build 487 levers. Header-only, LLVM-free and RPCS3-free so the host
+// test suite can execute them on Linux
+// (test/native/rpcs3_build487_lever_helpers_test.cpp). Nothing here reads a
+// setting, touches the SPU/PPU object-cache keys or changes generated code:
+// the Core resolves the levers once per boot in
+// rpcs3/ios/RPCS3IOSExperimentalPolicy.cpp and the consumers read the result.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace rpcs3::ios::levers
+{
+	// ---------------------------------------------------------------------
+	// L2: SPU spin thresholds expressed in time ("SPU Spin Timing").
+	//
+	// RPCS3's SPU wait loops compare raw differences of utils::get_tsc(). On
+	// ARM64 that counter is cntvct_el0, whose frequency cntfrq_el0 is 24 MHz
+	// on the iPhone, while the constants were written for a ~3 GHz x86-64
+	// TSC (comment above utils::init_arm_timer_scale, rpcs3/util/asm.hpp).
+	// A tick constant therefore lasts 125 times longer on the iPhone than
+	// upstream intended. "Calibrated" converts each constant to the duration
+	// it has at the upstream frequency and back to ticks of the real counter;
+	// "Reference" keeps the Build 483 tick constants exactly.
+	// ---------------------------------------------------------------------
+
+	// Frequency the upstream constants were written for (rpcs3/util/asm.hpp:
+	// "hardware timers that run around 3GHz").
+	inline constexpr std::uint64_t upstream_tsc_hz = 3'000'000'000;
+
+	// Documentation only: the Core reads cntfrq_el0 at boot, never this value.
+	inline constexpr std::uint64_t iphone_cntfrq_hz = 24'000'000;
+
+	inline constexpr std::uint64_t nanoseconds_per_second = 1'000'000'000;
+
+	// Duration, in nanoseconds, of `ticks` of a counter running at `hz`,
+	// rounded to the nearest nanosecond. Safe for ticks below 2^54 at 1 GHz.
+	constexpr std::uint64_t ticks_to_nanoseconds(std::uint64_t ticks, std::uint64_t hz) noexcept
+	{
+		if (!hz)
+		{
+			return 0;
+		}
+
+		const std::uint64_t seconds = ticks / hz;
+		const std::uint64_t remainder = ticks % hz;
+		return seconds * nanoseconds_per_second + (remainder * nanoseconds_per_second + hz / 2) / hz;
+	}
+
+	// Duration the upstream authors intended for a tick constant.
+	constexpr std::uint64_t upstream_ticks_to_nanoseconds(std::uint64_t ticks) noexcept
+	{
+		return ticks_to_nanoseconds(ticks, upstream_tsc_hz);
+	}
+
+	// Ticks of a counter running at `cntfrq` Hz for `nanoseconds`, rounded to
+	// the nearest tick and never below one tick, so a converted threshold can
+	// never degenerate into "always elapsed". Returns 0 only when the
+	// frequency is unknown (0); callers then keep the reference ticks.
+	constexpr std::uint64_t ticks_for_nanoseconds(std::uint64_t nanoseconds, std::uint64_t cntfrq) noexcept
+	{
+		if (!cntfrq)
+		{
+			return 0;
+		}
+
+		const std::uint64_t seconds = nanoseconds / nanoseconds_per_second;
+		const std::uint64_t remainder = nanoseconds % nanoseconds_per_second;
+		const std::uint64_t ticks = seconds * cntfrq + (remainder * cntfrq + nanoseconds_per_second / 2) / nanoseconds_per_second;
+		return ticks ? ticks : 1;
+	}
+
+	// The three GETLLAR tick thresholds of rpcs3/Emu/Cell/SPUThread.cpp
+	// (MFC_GETLLAR_CMD). Each value documents: the Build 483 tick constant,
+	// its duration on the 24 MHz iPhone counter, and the upstream intent at
+	// 3 GHz.
+	struct spu_spin_thresholds
+	{
+		// "GETLLAR after fail": a GETLLAR repeated on the address of the last
+		// failed PUTLLC reuses its reservation when it comes this soon
+		// (perf0.get() - last_ftsc < 1000).
+		// 1'000 ticks = 41.7 us at 24 MHz; upstream intent 333 ns.
+		std::uint64_t getllar_refail_ticks = 1'000;
+
+		// Validation that the thread is really spinning on GETLLAR: a longer
+		// gap since the previous GETLLAR resets the spin statistics
+		// (perf0.get() - last_gtsc >= 5'000).
+		// 5'000 ticks = 208 us at 24 MHz; upstream intent 1.67 us.
+		std::uint64_t getllar_spin_window_ticks = 5'000;
+
+		// "Don't be stubborn": a busy-waiting GETLLAR loop is forced to an
+		// operating-system sleep after this much time
+		// (perf0.get() - getllar_evaluate_time >= 400'000).
+		// 400'000 ticks = 16.7 ms at 24 MHz; upstream intent 133 us.
+		std::uint64_t getllar_forced_sleep_ticks = 400'000;
+
+		constexpr bool operator==(const spu_spin_thresholds&) const noexcept = default;
+	};
+
+	// Reference = the Build 483 constants, in ticks, whatever the counter.
+	constexpr spu_spin_thresholds reference_spu_spin_thresholds() noexcept
+	{
+		return spu_spin_thresholds{};
+	}
+
+	// Calibrated = the upstream-intended durations in ticks of `cntfrq`.
+	// An unknown frequency keeps the reference.
+	constexpr spu_spin_thresholds calibrated_spu_spin_thresholds(std::uint64_t cntfrq) noexcept
+	{
+		if (!cntfrq)
+		{
+			return reference_spu_spin_thresholds();
+		}
+
+		const spu_spin_thresholds reference{};
+		spu_spin_thresholds calibrated{};
+		calibrated.getllar_refail_ticks = ticks_for_nanoseconds(upstream_ticks_to_nanoseconds(reference.getllar_refail_ticks), cntfrq);
+		calibrated.getllar_spin_window_ticks = ticks_for_nanoseconds(upstream_ticks_to_nanoseconds(reference.getllar_spin_window_ticks), cntfrq);
+		calibrated.getllar_forced_sleep_ticks = ticks_for_nanoseconds(upstream_ticks_to_nanoseconds(reference.getllar_forced_sleep_ticks), cntfrq);
+		return calibrated;
+	}
+
+	// Mirror of utils::init_arm_timer_scale() (rpcs3/util/asm.hpp): the scale
+	// it installs is cntfrq / 30'000'000, or 1 when that quotient is 0. On the
+	// 24 MHz iPhone counter it is therefore 1, the same value as when the
+	// function is never called: busy_wait(n) = (n / 100) ticks either way.
+	constexpr std::uint64_t upstream_arm_timer_scale(std::uint64_t cntfrq) noexcept
+	{
+		const std::uint64_t scale = cntfrq / 30'000'000;
+		return scale ? scale : 1;
+	}
+
+	// Duration of utils::busy_wait(cycles) on ARM64 for a given counter and
+	// scale: (cycles / 100) * scale ticks (rpcs3/util/asm.hpp).
+	constexpr std::uint64_t arm64_busy_wait_nanoseconds(std::uint64_t cycles, std::uint64_t cntfrq, std::uint64_t scale) noexcept
+	{
+		return ticks_to_nanoseconds((cycles / 100) * scale, cntfrq);
+	}
+
+	// ---------------------------------------------------------------------
+	// L5: retention of recent persistent SPU object directories
+	// ("SPU Object Cache Retained Keys"). Cache policy only: which
+	// spuobj-v<format>-<key>/ directories survive a boot. Objects, keys and
+	// generated code are untouched.
+	// ---------------------------------------------------------------------
+
+	// Marker written at the root of every directory this Core creates. A
+	// directory of this same Core build and CPU can be told from one of
+	// another build or CPU only by it: the key is a hash of settings, build
+	// and device features together.
+	//
+	// The marker holds every input of the key except the settings, so a
+	// directory with a matching marker is exactly one this Core could read
+	// again after a settings flip. The Core commit and revision alone cannot
+	// tell two NeoStation Core builds apart: the CI fetches the pinned
+	// upstream commit at depth 1 and applies the NeoStation delta without
+	// committing, so RPCS3_GIT_VERSION is "1-22f11527" for every build. The
+	// SPU codegen identity (jit_compiler::spu_codegen_identity(): LLVM
+	// version, NEOSTATION_SPU_CODEGEN_ID digest of the translator/backend
+	// sources, target attributes) is what changes between Core builds, so it
+	// is part of the marker.
+	inline constexpr std::string_view build_marker_name = "neostation-build.id";
+
+	// Objects are "<name>.gz" (Utilities/JITLLVM.cpp); the marker never
+	// collides with one and is never read as one.
+	static_assert(!build_marker_name.ends_with(".gz"));
+
+	inline std::string build_marker_content(std::string_view commit, std::string_view revision, std::string_view codegen, std::string_view cpu, std::uint32_t hw_bits, std::uint64_t tsc_freq)
+	{
+		std::string content;
+		content.reserve(commit.size() + revision.size() + codegen.size() + cpu.size() + 48);
+		content += "neostation-spuobj-build 1 ";
+		content += commit;
+		content += ' ';
+		content += revision;
+		content += ' ';
+		content += codegen;
+		content += ' ';
+		content += cpu;
+		content += ' ';
+		content += std::to_string(hw_bits);
+		content += ' ';
+		content += std::to_string(tsc_freq);
+		return content;
+	}
+
+	// A marker file matches when its content, without trailing line breaks or
+	// spaces, equals the expected content.
+	inline bool build_marker_matches(std::string_view file_content, std::string_view expected) noexcept
+	{
+		while (!file_content.empty() && (file_content.back() == '\n' || file_content.back() == '\r' || file_content.back() == ' '))
+		{
+			file_content.remove_suffix(1);
+		}
+
+		return !expected.empty() && file_content == expected;
+	}
+
+	inline std::string directory_prefix(std::uint32_t format_version)
+	{
+		return "spuobj-v" + std::to_string(format_version) + "-";
+	}
+
+	struct cache_directory_candidate
+	{
+		std::string name;        // directory name under the title cache root, e.g. "spuobj-v6-<key>"
+		std::int64_t mtime = 0;  // directory modification time
+		bool same_build = false; // its marker matches this Core build and CPU
+	};
+
+	struct retention_plan
+	{
+		std::vector<std::string> retain; // other directories kept, most recent first (never the current one)
+		std::vector<std::string> remove; // directories to delete
+	};
+
+	// Keeps the current key (never listed among the candidates) plus at most
+	// `retained_keys - 1` other directories, the most recently modified first
+	// (name order breaks ties for determinism). Removed: every directory of
+	// another cache format version, of another build or CPU (marker absent
+	// or different) and every same-build directory beyond the count.
+	inline retention_plan plan_directory_retention(std::vector<cache_directory_candidate> candidates, std::string_view current_name, std::uint32_t retained_keys, std::uint32_t format_version)
+	{
+		retention_plan plan;
+		const std::string prefix = directory_prefix(format_version);
+		const std::size_t others_to_keep = retained_keys ? retained_keys - 1 : 0;
+		std::vector<cache_directory_candidate> eligible;
+
+		for (cache_directory_candidate& candidate : candidates)
+		{
+			if (candidate.name == current_name)
+			{
+				continue;
+			}
+
+			if (!candidate.name.starts_with(prefix) || !candidate.same_build)
+			{
+				plan.remove.push_back(std::move(candidate.name));
+				continue;
+			}
+
+			eligible.push_back(std::move(candidate));
+		}
+
+		std::sort(eligible.begin(), eligible.end(), [](const cache_directory_candidate& a, const cache_directory_candidate& b)
+		{
+			return a.mtime != b.mtime ? a.mtime > b.mtime : a.name < b.name;
+		});
+
+		for (std::size_t i = 0; i < eligible.size(); i++)
+		{
+			(i < others_to_keep ? plan.retain : plan.remove).push_back(std::move(eligible[i].name));
+		}
+
+		return plan;
+	}
+
+	// What the global bounds leave to the other retained directories once the
+	// current directory kept `kept_files` / `kept_bytes`. Saturates at zero.
+	constexpr std::pair<std::size_t, std::uint64_t> remaining_budget(std::size_t kept_files, std::uint64_t kept_bytes, std::size_t max_files, std::uint64_t max_bytes) noexcept
+	{
+		return {kept_files < max_files ? max_files - kept_files : 0, kept_bytes < max_bytes ? max_bytes - kept_bytes : 0};
+	}
+
+	// Number of entries (names "<directory>/<file>") left in `directory` after
+	// an eviction plan removed `removed`. Used to delete a retained directory
+	// that the shared bounds emptied, so it stops occupying a retained slot.
+	// Linear in all + removed (hashed lookup): it runs at boot over up to
+	// 40,000 names per retained directory.
+	inline std::size_t entries_left_in(std::string_view directory, const std::vector<std::string>& all, const std::vector<std::string>& removed)
+	{
+		const auto in_directory = [directory](std::string_view name)
+		{
+			return name.size() > directory.size() && name.substr(0, directory.size()) == directory && name[directory.size()] == '/';
+		};
+
+		std::unordered_set<std::string_view> removed_here;
+		removed_here.reserve(removed.size());
+
+		for (const std::string& name : removed)
+		{
+			if (in_directory(name))
+			{
+				removed_here.insert(name);
+			}
+		}
+
+		std::size_t left = 0;
+
+		for (const std::string& name : all)
+		{
+			if (in_directory(name) && !removed_here.contains(name))
+			{
+				left++;
+			}
+		}
+
+		return left;
+	}
+}
