+	void flush_command_queue(bool wait);
+	bool on_ring_exhausted(usz size);
+	void report_counters();
+	// REWINDBOX_METAL_TIMED_REPORT_906: the COREPROF METAL lines every 5 s, from flip() and from do_local_task() (so a
+	// renderer that stopped presenting still reports), plus the drain state line.
+	void report_counters_if_due();
+	void report_drain_state();
