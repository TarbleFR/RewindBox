+			return static_cast<u64>(XXH3_64bits_withSeed(src, length, rpcs3::fnv_seed));
+		}
+
+		if (length >= 4096 && rpcs3::ios::get_experimental_policy().texture_hash_hybrid)
+		{
+			return rpcs3::ios::texture_hash_hybrid(src, length,
