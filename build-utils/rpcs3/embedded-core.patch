+		// end - begin for the monotonic fields; maxima and the headroom minimum are
+		// those of `end` (window values), headroom_min_bytes is 0 without a sample.
+		static snapshot window_delta(const snapshot& begin, const snapshot& end) noexcept
+		{
+			const auto sub = [](std::uint64_t a, std::uint64_t b) { return a > b ? a - b : 0; };
+			snapshot result{};
+			for (unsigned which = 0; which < count; ++which)
+			{
+				result.events[which] = sub(end.events[which], begin.events[which]);
+				result.ticks[which] = sub(end.ticks[which], begin.ticks[which]);
+				result.max_ticks[which] = end.max_ticks[which];
+				result.bytes[which] = sub(end.bytes[which], begin.bytes[which]);
+			}
+			result.headroom_samples = sub(end.headroom_samples, begin.headroom_samples);
+			result.headroom_min_bytes = result.headroom_samples && end.headroom_min_bytes != std::numeric_limits<std::uint64_t>::max()
+				? end.headroom_min_bytes : 0;
+			return result;
+		}
+
+		snapshot exchange() noexcept
+		{
+			snapshot result{};
+			for (unsigned which = 0; which < count; ++which)
+			{
+				result.events[which] = events[which].exchange(0, std::memory_order_relaxed);
+				result.ticks[which] = ticks[which].exchange(0, std::memory_order_relaxed);
+				result.max_ticks[which] = max_ticks[which].exchange(0, std::memory_order_relaxed);
+				result.bytes[which] = bytes[which].exchange(0, std::memory_order_relaxed);
+			}
+			result.headroom_samples = headroom_samples.exchange(0, std::memory_order_relaxed);
+			result.headroom_min_bytes = headroom_min.exchange(std::numeric_limits<std::uint64_t>::max(), std::memory_order_relaxed);
