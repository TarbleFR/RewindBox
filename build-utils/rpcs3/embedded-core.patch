+std::string jit_compiler::codegen_identity()
+{
+	// NEOSTATION_BUILD444_PPU_CACHE_IDENTITY_V1. Everything that shapes a PPU
+	// object besides the module hash, the settings bits and the CPU name: the
+	// LLVM release, the configure-time digest of the translator/engine sources
+	// (NEOSTATION_PPU_CODEGEN_ID, see rpcs3/Emu/CMakeLists.txt), the advertised
+	// target features and the fixed backend options. A different identity never
+	// reuses an object; it recompiles once into a new file name.
+	static const std::string identity = []()
+	{
+		std::string seed = LLVM_VERSION_STRING;
+		seed += '|';
+#ifdef NEOSTATION_PPU_CODEGEN_ID
+		seed += NEOSTATION_PPU_CODEGEN_ID;
+#else
+		seed += "unversioned";
+#endif
+		seed += '|';
+
+		for (const auto& attribute : target_attributes())
+		{
+			seed += attribute;
+			seed += ',';
+		}
+
+		seed += "|aggressive|pic|interleaved-load-combine-off|ghc-emergency-spill-v1";
+
+		u8 output[20]{};
+		sha1_context ctx{};
+		sha1_starts(&ctx);
+		sha1_update(&ctx, reinterpret_cast<const u8*>(seed.data()), seed.size());
+		sha1_finish(&ctx, output);
+		return fmt::format("%s", fmt::base57(output, 12));
+	}();
+
+	return identity;
+}
+
+std::string jit_compiler::spu_codegen_identity()
+{
+	// NEOSTATION_BUILD481_SPU_OBJECT_CACHE_V1: same construction as the PPU
+	// identity, over the SPU translator/backend digest (NEOSTATION_SPU_CODEGEN_ID,
+	// rpcs3/Emu/CMakeLists.txt). The directory key of the SPU object cache adds
+	// the settings bits, the device features and the CPU name on top.
+	static const std::string identity = []()
+	{
+		std::string seed = LLVM_VERSION_STRING;
+		seed += '|';
+#ifdef NEOSTATION_SPU_CODEGEN_ID
+		seed += NEOSTATION_SPU_CODEGEN_ID;
+#else
+		seed += "unversioned";
+#endif
+		seed += '|';
+
+		for (const auto& attribute : target_attributes())
+		{
+			seed += attribute;
+			seed += ',';
+		}
+
+		seed += "|aggressive|pic|interleaved-load-combine-off|ghc-emergency-spill-v1|spu-objects-v1";
+
+		u8 output[20]{};
+		sha1_context ctx{};
+		sha1_starts(&ctx);
+		sha1_update(&ctx, reinterpret_cast<const u8*>(seed.data()), seed.size());
+		sha1_finish(&ctx, output);
+		return fmt::format("%s", fmt::base57(output, 12));
+	}();
+
+	return identity;
+}
