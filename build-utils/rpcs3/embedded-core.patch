+	void* m_layer = nullptr;
+	u32 m_drawable_width = 0;
+	u32 m_drawable_height = 0;
+
+	std::array<frame_slot, frames_in_flight> m_frames{};
+	u64 m_frame_index = 0;
+	frame_slot* m_current_frame = nullptr;
+	std::vector<u32> m_staging;
+
+	// M2.2
+	mtl::command_context m_commands;
+	std::unique_ptr<mtl::program_cache> m_prog_buffer;
+	mtl::surface_cache m_rtts;
+	std::array<mtl::data_heap, ring_count> m_rings;
