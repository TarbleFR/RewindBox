diff --git a/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h b/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h
new file mode 100644
index 0000000..341b7c8
--- /dev/null
+++ b/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <llvm/IR/Constants.h>
+#include <llvm/IR/IRBuilder.h>
+#include <llvm/IR/Intrinsics.h>
+#include <llvm/IR/IntrinsicsAArch64.h>
+#include <llvm/IR/Module.h>
+
+// Exact modulo-2^32 CELL dot products. This layer builds guest instructions;
+// it is independent of the host runtime SIMD implementation and never changes
+// memory accesses, saturation state, floating-point state or instruction order.
+namespace rpcs3::cell::arm64
+{
+inline llvm::Value* unsigned_byte_dot(llvm::IRBuilder<>& ir, llvm::Value* accumulator,
+    llvm::Value* a, llvm::Value* b)
+{
+    auto* dot = llvm::Intrinsic::getOrInsertDeclaration(ir.GetInsertBlock()->getModule(),
+        llvm::Intrinsic::aarch64_neon_udot, {accumulator->getType(), a->getType()});
+    return ir.CreateCall(dot, {accumulator, a, b});
+}
+
+inline llvm::Value* signed_unsigned_byte_dot(llvm::IRBuilder<>& ir, llvm::Value* accumulator,
+    llvm::Value* a, llvm::Value* b)
+{
+    // sign_extend(a) == zero_extend(a XOR 0x80) - 128. UDOT handles
+    // four adjacent bytes per word; the correction is exact modulo 2^32,
+    // including accumulator wraparound. This requires DOTPROD, not I8MM.
+    auto* bias = llvm::ConstantInt::get(a->getType(), 0x80);
+    auto* ones = llvm::ConstantInt::get(b->getType(), 1);
+    auto* zero = llvm::Constant::getNullValue(accumulator->getType());
+    auto* product = unsigned_byte_dot(ir, accumulator, ir.CreateXor(a, bias), b);
+    auto* correction = unsigned_byte_dot(ir, zero, b, ones);
+    return ir.CreateSub(product, ir.CreateShl(correction, 7));
+}
+
+inline llvm::Value* halfword_pair_dot(llvm::IRBuilder<>& ir, llvm::Value* accumulator,
+    llvm::Value* a, llvm::Value* b, bool is_signed)
+{
+    // Each host word contains the two corresponding guest halfwords. Addition
+    // is commutative within the pair, so host little-endian lane order needs
+    // no byte reversal. Wider products and ADDP all have defined wrapping.
+    auto* module = ir.GetInsertBlock()->getModule();
+    auto* multiply = llvm::Intrinsic::getOrInsertDeclaration(module,
+        is_signed ? llvm::Intrinsic::aarch64_neon_smull : llvm::Intrinsic::aarch64_neon_umull,
+        {accumulator->getType()});
+    auto* low = ir.CreateCall(multiply, {ir.CreateShuffleVector(a, {0, 1, 2, 3}),
+        ir.CreateShuffleVector(b, {0, 1, 2, 3})});
+    auto* high = ir.CreateCall(multiply, {ir.CreateShuffleVector(a, {4, 5, 6, 7}),
+        ir.CreateShuffleVector(b, {4, 5, 6, 7})});
+    auto* pair = llvm::Intrinsic::getOrInsertDeclaration(module,
+        llvm::Intrinsic::aarch64_neon_addp, {accumulator->getType()});
+    return ir.CreateAdd(accumulator, ir.CreateCall(pair, {low, high}));
+}
+// Four adjacent CELL byte terms fit exactly in signed/unsigned 32-bit lanes.
+// DOT with ones replaces the widening, masking and pairwise-add preparation;
+// the caller retains the guest saturating addition and SAT update unchanged.
+inline llvm::Value* byte_sum(llvm::IRBuilder<>& ir, llvm::Value* bytes, bool is_signed)
+{
+    auto* words = llvm::FixedVectorType::get(ir.getInt32Ty(), 4);
+    auto* sum = llvm::Intrinsic::getOrInsertDeclaration(ir.GetInsertBlock()->getModule(),
+        is_signed ? llvm::Intrinsic::aarch64_neon_sdot : llvm::Intrinsic::aarch64_neon_udot,
+        {words, bytes->getType()});
+    return ir.CreateCall(sum, {llvm::Constant::getNullValue(words), bytes,
+        llvm::ConstantInt::get(bytes->getType(), 1)});
+}
+
+inline llvm::Value* signed_halfword_pair_sum(llvm::IRBuilder<>& ir, llvm::Value* halfwords)
+{
+    auto* words = llvm::FixedVectorType::get(ir.getInt32Ty(), 4);
+    auto* sum = llvm::Intrinsic::getOrInsertDeclaration(ir.GetInsertBlock()->getModule(),
+        llvm::Intrinsic::aarch64_neon_saddlp, {words, halfwords->getType()});
+    return ir.CreateCall(sum, {halfwords});
+}
+} // namespace rpcs3::cell::arm64
diff --git a/rpcs3/Emu/CPU/Backends/AArch64/SPUInterpreterGateway.h b/rpcs3/Emu/CPU/Backends/AArch64/SPUInterpreterGateway.h
new file mode 100644
index 0000000..aa747a8
--- /dev/null
+++ b/rpcs3/Emu/CPU/Backends/AArch64/SPUInterpreterGateway.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <asmjit/asmjit.h>
+#include <asmjit/a64.h>
+#include <cstdint>
+
+namespace aarch64
+{
+// The dynamic interpreter enters with the native ABI, but STOP/interrupt helpers
+// can leave through spu_escape without returning through LLVM's native frame.
+// Keep a complete native callee-save frame and the PC/SP pair that ARM64 escape
+// expects, independently of the interpreter's GHC instruction chain.
+inline void emit_spu_interpreter_gateway(asmjit::a64::Assembler& c, std::uint32_t context_offset, std::uint64_t entry)
+{
+	using namespace asmjit;
+	constexpr int frame_size = 176;
+	c.sub(a64::sp, a64::sp, Imm(frame_size));
+	c.stp(a64::x18, a64::x19, arm::Mem(a64::sp, 0));
+	c.stp(a64::x20, a64::x21, arm::Mem(a64::sp, 16));
+	c.stp(a64::x22, a64::x23, arm::Mem(a64::sp, 32));
+	c.stp(a64::x24, a64::x25, arm::Mem(a64::sp, 48));
+	c.stp(a64::x26, a64::x27, arm::Mem(a64::sp, 64));
+	c.stp(a64::x28, a64::x29, arm::Mem(a64::sp, 80));
+	c.str(a64::x30, arm::Mem(a64::sp, 96));
+	c.stp(a64::d8, a64::d9, arm::Mem(a64::sp, 112));
+	c.stp(a64::d10, a64::d11, arm::Mem(a64::sp, 128));
+	c.stp(a64::d12, a64::d13, arm::Mem(a64::sp, 144));
+	c.stp(a64::d14, a64::d15, arm::Mem(a64::sp, 160));
+
+	const auto epilogue = c.newLabel();
+	c.mov(a64::x14, Imm(context_offset));
+	c.add(a64::x14, a64::x14, a64::x0);
+	c.adr(a64::x15, epilogue);
+	c.mov(a64::x16, a64::sp);
+	c.stp(a64::x15, a64::x16, arm::Mem(a64::x14));
+	c.mov(a64::x19, a64::x0);
+	c.mov(a64::x16, Imm(entry));
+	c.blr(a64::x16);
+
+	// A normal native return preserves x19; spu_escape explicitly sets it to
+	// the SPU thread. Both paths recover the frame before touching saved data.
+	c.bind(epilogue);
+	c.mov(a64::x14, Imm(context_offset));
+	c.add(a64::x14, a64::x14, a64::x19);
+	c.ldr(a64::x16, arm::Mem(a64::x14, 8));
+	c.mov(a64::sp, a64::x16);
+	c.ldp(a64::d8, a64::d9, arm::Mem(a64::sp, 112));
+	c.ldp(a64::d10, a64::d11, arm::Mem(a64::sp, 128));
+	c.ldp(a64::d12, a64::d13, arm::Mem(a64::sp, 144));
+	c.ldp(a64::d14, a64::d15, arm::Mem(a64::sp, 160));
+	c.ldp(a64::x18, a64::x19, arm::Mem(a64::sp, 0));
+	c.ldp(a64::x20, a64::x21, arm::Mem(a64::sp, 16));
+	c.ldp(a64::x22, a64::x23, arm::Mem(a64::sp, 32));
+	c.ldp(a64::x24, a64::x25, arm::Mem(a64::sp, 48));
+	c.ldp(a64::x26, a64::x27, arm::Mem(a64::sp, 64));
+	c.ldp(a64::x28, a64::x29, arm::Mem(a64::sp, 80));
+	c.ldr(a64::x30, arm::Mem(a64::sp, 96));
+	c.add(a64::sp, a64::sp, Imm(frame_size));
+	c.ret(a64::x30);
+}
+}
diff --git a/rpcs3/Emu/CPU/Backends/AArch64/SPUReservationHash.h b/rpcs3/Emu/CPU/Backends/AArch64/SPUReservationHash.h
new file mode 100644
index 0000000..409949a
--- /dev/null
+++ b/rpcs3/Emu/CPU/Backends/AArch64/SPUReservationHash.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <arm_neon.h>
+#include <cstdint>
+
+namespace aarch64
+{
+// The native reservation fingerprint is a modulo-2^32 sum of all 32 words.
+// Keep the horizontal reduction in NEON until the single scalar result.
+inline std::uint32_t spu_rdata_hash32(const void* source)
+{
+	const auto* bytes = static_cast<const std::uint8_t*>(source);
+	auto load = [&](unsigned offset) { return vreinterpretq_u32_u8(vld1q_u8(bytes + offset)); };
+	const auto a = vaddq_u32(load(0), load(16));
+	const auto b = vaddq_u32(load(32), load(48));
+	const auto c = vaddq_u32(load(64), load(80));
+	const auto d = vaddq_u32(load(96), load(112));
+	return vaddvq_u32(vaddq_u32(vaddq_u32(a, b), vaddq_u32(c, d)));
+}
+}
