+	// M5: persistent pipeline binaries (MTLPipelineCache.h)
+	namespace
+	{
+		std::mutex g_lookup_lock;
+		object g_lookup_archive;
+		pipeline_archive_counters g_archive_counters;
+
+		// A serializer is never written while a pipeline is being captured into it (MTL4PipelineDataSetSerializer is not
+		// declared thread-safe): pipeline creations share g_capture, the archive writer takes it exclusively. A creation
+		// that finds the writer at work never waits: it uses the capturing compiler's twin, a compiler of the same device
+		// without the serializer (counted as uncaptured; the next session's boot precompile captures that pipeline).
+		std::shared_mutex g_capture;
+		object g_capturing_compiler;  // guarded by g_lookup_lock
+		object g_twin_compiler;       // guarded by g_lookup_lock
+
+		object lookup_archive()
+		{
+			std::lock_guard lock(g_lookup_lock);
+			return g_lookup_archive;
+		}
+
+		// The compiler a pipeline creation uses, holding the shared capture lock when it is the capturing one.
+		struct capture_guard
+		{
+			std::shared_lock<std::shared_mutex> lock{ g_capture, std::try_to_lock };
+			object compiler;
+
+			explicit capture_guard(const object& requested)
+				: compiler(requested)
+			{
+				if (lock.owns_lock())
+				{
+					return;
+				}
+
+				std::unique_lock twins(g_lookup_lock);
+				if (!g_capturing_compiler || requested.get() != g_capturing_compiler.get())
+				{
+					return;  // a compiler without a serializer: nothing to order
+				}
+
+				if (g_twin_compiler)
+				{
+					compiler = g_twin_compiler;
+					g_archive_counters.uncaptured.fetch_add(1, std::memory_order_relaxed);
+					return;
+				}
+
+				// No twin (its creation failed): the creation waits for the writer rather than race it.
+				twins.unlock();
+				lock.lock();
+			}
+		};
+
+		// The lookup of a pipeline creation: whether the archive holds the binary (counted as a hit, or a miss when
+		// the pipeline is compiled), and the task options handing the archive to the compiler.
+		struct archive_lookup
+		{
+			object archive;
+			bool hit = false;
+
+			void count() const
+			{
+				(hit ? g_archive_counters.hits : g_archive_counters.misses).fetch_add(1, std::memory_order_relaxed);
+			}
+		};
+
+		RBX_METAL4 MTL4CompilerTaskOptions* lookup_options(const archive_lookup& lookup)
+		{
+			if (!lookup.archive)
+			{
+				return nil;
+			}
+
+			MTL4CompilerTaskOptions* options = [[MTL4CompilerTaskOptions alloc] init];
+			options.lookupArchives = @[ as<id<MTL4Archive>>(lookup.archive) ];
+			return options;
+		}
+	}
+
+	RBX_METAL4 object new_pipeline_serializer(const object& device)
+	{
+		@autoreleasepool
+		{
+			MTL4PipelineDataSetSerializerDescriptor* desc = [[MTL4PipelineDataSetSerializerDescriptor alloc] init];
+			desc.configuration = MTL4PipelineDataSetSerializerConfigurationCaptureBinaries;
+			return keep([as<id<MTLDevice>>(device) newPipelineDataSetSerializerWithDescriptor:desc]);
+		}
+	}
+
+	RBX_METAL4 object new_compiler(const object& device, const object& serializer)
+	{
+		@autoreleasepool
+		{
+			MTL4CompilerDescriptor* desc = [[MTL4CompilerDescriptor alloc] init];
+			NSError* failure = nil;
+			if (!serializer)
+			{
+				return keep([as<id<MTLDevice>>(device) newCompilerWithDescriptor:desc error:&failure]);
+			}
+
+			// The twin first (no serializer), then the capturing compiler.
+			object twin = keep([as<id<MTLDevice>>(device) newCompilerWithDescriptor:desc error:&failure]);
+			desc.pipelineDataSetSerializer = as<id<MTL4PipelineDataSetSerializer>>(serializer);
+			object compiler = keep([as<id<MTLDevice>>(device) newCompilerWithDescriptor:desc error:&failure]);
+
+			std::lock_guard lock(g_lookup_lock);
+			g_capturing_compiler = compiler;
+			g_twin_compiler = std::move(twin);
+			return compiler;
+		}
+	}
+
+	RBX_METAL4 object open_pipeline_archive(const object& device, const std::string& path, std::string& error)
+	{
+		@autoreleasepool
+		{
+			NSURL* url = [NSURL fileURLWithPath:string(path) isDirectory:NO];
+			NSError* failure = nil;
+			const id<MTL4Archive> archive = [as<id<MTLDevice>>(device) newArchiveWithURL:url error:&failure];
+			if (!archive)
+			{
+				error = describe(failure);
+			}
+			return keep(archive);
+		}
+	}
+
+	RBX_METAL4 bool write_pipeline_archive(const object& serializer, const std::string& path, std::string& error)
+	{
+		@autoreleasepool
+		{
+			NSURL* url = [NSURL fileURLWithPath:string(path) isDirectory:NO];
+			NSError* failure = nil;
+			// Every capturing creation in flight ends first; later ones use the twin compiler meanwhile.
+			std::unique_lock capture(g_capture);
+			if (![as<id<MTL4PipelineDataSetSerializer>>(serializer) serializeAsArchiveAndFlushToURL:url error:&failure])
+			{
+				error = describe(failure);
+				return false;
+			}
+			return true;
+		}
+	}
+
+	void set_pipeline_lookup_archive(const object& archive)
+	{
+		std::lock_guard lock(g_lookup_lock);
+		g_lookup_archive = archive;
+	}
+
+	void end_pipeline_capture()
+	{
+		std::lock_guard lock(g_lookup_lock);
+		g_capturing_compiler.reset();
+		g_twin_compiler.reset();
+	}
+
+	pipeline_archive_counters& get_pipeline_archive_counters()
+	{
+		return g_archive_counters;
+	}
