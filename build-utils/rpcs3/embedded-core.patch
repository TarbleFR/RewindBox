+	for (unsigned j = 0; j < 16; ++j)
+		ol.attribute_placement[j] = nl.attribute_placement[j] = attribute_buffer_placement::none;
+	ol.attribute_placement[15] = nl.attribute_placement[15] = attribute_buffer_placement::persistent;
