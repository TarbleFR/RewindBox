+			rpcs3::fnv_seed));
+	}
+
+	namespace
+	{
+		namespace validation = rpcs3::ios::texture_validation;
+
+		struct recorded
+		{
+			u32 start;
+			u32 length;
+			// Epochs this frame had started before the validation (0: the frame's first).
+			u64 ordinal;
+		};
+
+		// All below under g_mutex; the worker never holds it while hashing.
+		std::mutex g_mutex;
+		std::condition_variable g_wakeup;
+		std::vector<recorded> g_current, g_previous;
+		u64 g_frame_epoch = 0;
+		u64 g_frame = 0;
+		u64 g_signal = 0;
+		bool g_stop = false;
+		bool g_started = false;
+		// CELL583_PREHASH_PACING: the RSX thread's position in this frame's validations
+		// (g_current.size(), read by the worker without the lock while it hashes), and the
+		// position at which the RSX thread wakes the worker for the next ranges.
+		std::atomic<usz> g_position{0};
+		usz g_refill_at = umax;
+		// Never destroyed: a process that exits with the worker running does not terminate.
+		std::thread* g_worker = nullptr;
+
+		// An exhausted range lock allocation is fatal to the emulator: the worker
+		// takes a slot only while plenty remain, else it reads RSX local memory only.
+		atomic_t<u64, 128>* reserve_range_lock() noexcept
+		{
+			if (std::popcount(vm::g_range_lock_bits[0].load()) > 32)
+			{
+				return nullptr;
+			}
+
+			return vm::alloc_range_lock();
+		}
+
+		bool hash_guest_range(atomic_t<u64, 128>* range_lock, u32 start, u32 length, u64& out) noexcept
+		{
+			const u64 end = u64{start} + length;
+
+			if (start >= rsx::constants::local_mem_base && end <= u64{rsx::constants::local_mem_base} + 0x1000'0000)
+			{
+				// RSX local memory stays mapped while the RSX thread runs (vm::range_lock skips it too).
+				out = range_hash(vm::g_sudo_addr + start, length);
+				return true;
+			}
+
+			if (!range_lock)
+			{
+				return false;
+			}
+
+			// The vm::range_lock protocol without its waits: an unmap or protection change
+			// publishes its exclusive bits before it waits for the range locks that overlap,
+			// so it either waits for this one or is seen here. A readable range lock is one
+			// reservation writers do not wait for.
+			range_lock->store(start | (u64{length} << 32) | vm::range_readable);
+
+			if (vm::g_range_lock_bits[1].load() || !vm::check_addr(start, vm::page_readable, length))
+			{
+				range_lock->release(0);
+				return false;
+			}
+
+			out = range_hash(vm::g_sudo_addr + start, length);
+			range_lock->release(0);
+			return true;
+		}
+
+		void worker_main()
+		{
+#if defined(__APPLE__)
+			// The class and level of the SPU and PPU threads, below the RSX thread (CELL567_THREAD_QOS).
+			pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, rpcs3::ios::thread_qos::default_relative_priority.load(std::memory_order_relaxed));
+#endif
+			atomic_t<u64, 128>* const range_lock = reserve_range_lock();
+			// The previous frame's validations, with their index in that frame.
+			std::vector<std::pair<usz, recorded>> batch;
+			batch.reserve(lookahead);
+			u64 seen = 0;
+			// The last window taken: a timeout without new work takes nothing.
+			u64 last_epoch = 0, last_frame = 0;
+			usz last_position = umax;
+
+			std::unique_lock lock(g_mutex);
+
+			while (!g_stop)
+			{
+				g_wakeup.wait_for(lock, std::chrono::milliseconds(4), [&] { return g_stop || g_signal != seen; });
+
+				if (g_stop)
+				{
+					break;
+				}
+
+				seen = g_signal;
+
+				// Read the epoch before any byte it confirms.
+				const u64 epoch = validation::current_epoch();
+
+				if (!epoch || epoch < g_frame_epoch)
+				{
+					continue;
+				}
+
+				const usz position = g_current.size();
+
+				if (epoch == last_epoch && g_frame == last_frame && position == last_position)
+				{
+					continue;
+				}
+
+				last_epoch = epoch;
+				last_frame = g_frame;
+				last_position = position;
+
+				// The previous frame's validations from this frame's position on, up to the
+				// first one its next epoch made: those would not be used in this one.
+				const u64 ordinal = epoch - g_frame_epoch;
+				batch.clear();
+
+				for (usz i = position; i < g_previous.size() && batch.size() < lookahead && g_previous[i].ordinal <= ordinal; i++)
+				{
+					batch.emplace_back(i, g_previous[i]);
+				}
+
+				if (batch.empty())
+				{
+					continue;
+				}
+
+				// CELL583_PREHASH_PACING: once the RSX thread is halfway through these ranges it
+				// wakes the worker for the next ones, instead of the 4 ms timeout.
+				g_refill_at = position + (batch.size() + 1) / 2;
+
+				lock.unlock();
+
+				for (const auto& [index, range] : batch)
+				{
+					if (validation::current_epoch() != epoch)
+					{
+						break;
+					}
+
+					// CELL583_PREHASH_PACING: a range the RSX thread has already passed was hashed
+					// by it; hashing it here would only be wasted.
+					if (index < g_position.load(std::memory_order_relaxed))
+					{
+						worker_passed.fetch_add(1, std::memory_order_relaxed);
+						continue;
+					}
+
+					u64 hash = 0;
+
+					if (lookup(range.start, range.length, epoch, hash))
+					{
+						continue;
+					}
+
+					const u64 begin = utils::get_tsc();
+
+					if (!hash_guest_range(range_lock, range.start, range.length, hash))
+					{
+						worker_skips.fetch_add(1, std::memory_order_relaxed);
+						continue;
+					}
+
+					publish(range.start, range.length, epoch, hash);
+					worker_hashes.fetch_add(1, std::memory_order_relaxed);
+					worker_bytes.fetch_add(range.length, std::memory_order_relaxed);
+					worker_ticks.fetch_add(utils::get_tsc() - begin, std::memory_order_relaxed);
+				}
+
+				lock.lock();
+			}
+
+			lock.unlock();
+
+			if (range_lock)
+			{
+				vm::free_range_lock(range_lock);
+			}
+		}
+	}
+
+	void record(u32 start, u32 length) noexcept
+	{
+		if (length < min_bytes || !enabled.load(std::memory_order_relaxed))
+		{
+			return;
+		}
+
+		const u64 epoch = validation::current_epoch();
+		std::lock_guard lock(g_mutex);
+
+		// stop() turns the lever off under this lock until the next boot resolves it.
+		if (!enabled.load(std::memory_order_relaxed))
+		{
+			return;
+		}
+
+		if (!g_started)
+		{
+			g_stop = false;
+			g_started = true;
+			g_worker = new std::thread(worker_main);
+			validation::epoch_listener.store(&on_epoch_advance, std::memory_order_relaxed);
+		}
+
+		if (g_current.size() < max_sequence)
+		{
+			g_current.push_back({start, length, epoch >= g_frame_epoch ? epoch - g_frame_epoch : 0});
+			g_position.store(g_current.size(), std::memory_order_relaxed);
+		}
+
+		// CELL583_PREHASH_PACING: halfway through the worker's ranges, wake it for the next ones.
+		if (g_current.size() >= g_refill_at)
+		{
+			g_refill_at = umax;
+			g_signal++;
+			worker_refills.fetch_add(1, std::memory_order_relaxed);
+			g_wakeup.notify_one();
+		}
+	}
+
+	void end_frame() noexcept
+	{
+		if (!enabled.load(std::memory_order_relaxed))
+		{
+			return;
+		}
+
+		{
+			std::lock_guard lock(g_mutex);
+
+			if (!g_started)
+			{
+				return;
+			}
+
+			g_previous.swap(g_current);
+			g_current.clear();
+			g_position.store(0, std::memory_order_relaxed);
+			g_refill_at = umax;
+			g_frame_epoch = validation::current_epoch();
+			g_frame++;
+			g_signal++;
+		}
+
+		g_wakeup.notify_one();
+	}
+
+	void on_epoch_advance() noexcept
+	{
+		{
+			std::lock_guard lock(g_mutex);
+
+			if (!g_started)
+			{
+				return;
+			}
+
+			g_signal++;
+		}
+
+		g_wakeup.notify_one();
+	}
+
+	void stop() noexcept
+	{
+		validation::epoch_listener.store(nullptr, std::memory_order_relaxed);
+		std::thread* worker = nullptr;
+
+		{
+			std::lock_guard lock(g_mutex);
+			// No validation from another thread restarts the worker after the RSX thread.
+			enabled.store(false, std::memory_order_relaxed);
+
+			if (!g_started)
