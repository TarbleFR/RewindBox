@@ -208,6 +208,12 @@ namespace utils
 
 	inline u64 arm_timer_scale = 1;
 
+	// NEOSTATION_BUILD487_DIAGNOSTICS_V1 (L2): freq / 30000000 is 0 below
+	// 30 MHz, so on the iPhone's 24 MHz cntfrq_el0 this call leaves the scale
+	// at 1 and busy_wait(n) stays (n / 100) ticks: 1.25x the 3 GHz intent
+	// (busy_wait(300) = 3 ticks = 125 ns against 100 ns). iOS calls it only
+	// under "SPU Spin Timing = Calibrated" (rpcs3/ios/RPCS3IOSExperimentalPolicy.cpp),
+	// which converts the SPU GETLLAR tick thresholds separately.
 	inline void init_arm_timer_scale()
 	{
 		u64 freq = 0;
@@ -231,6 +237,38 @@ namespace utils
 		while (get_tsc() < stop);
 	}
 
+#ifdef RPCS3_IOS
