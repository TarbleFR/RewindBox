+
+	// M4: compute pipelines and dispatches.
+	RBX_METAL4 object new_compute_pipeline(const object& compiler, const object& library, std::string_view function, std::string_view label, std::string& error)
+	{
+		@autoreleasepool
+		{
+			MTL4LibraryFunctionDescriptor* entry = [[MTL4LibraryFunctionDescriptor alloc] init];
+			entry.library = as<id<MTLLibrary>>(library);
+			entry.name = string(function);
+
+			MTL4ComputePipelineDescriptor* desc = [[MTL4ComputePipelineDescriptor alloc] init];
+			desc.computeFunctionDescriptor = entry;
+			if (!label.empty())
+			{
+				desc.label = string(label);
+			}
+
+			// M5: as new_render_pipeline (the archive probed, then handed to the compiler)
+			archive_lookup lookup{ lookup_archive() };
+			if (lookup.archive)
+			{
+				NSError* absent = nil;
+				lookup.hit = [as<id<MTL4Archive>>(lookup.archive) newComputePipelineStateWithDescriptor:desc error:&absent] != nil;
+			}
+
+			NSError* failure = nil;
+			const capture_guard capture(compiler);
+			const id<MTLComputePipelineState> pipeline = [as<id<MTL4Compiler>>(capture.compiler) newComputePipelineStateWithDescriptor:desc
+				compilerTaskOptions:lookup_options(lookup) error:&failure];
+			if (!pipeline)
+			{
+				error = describe(failure);
+			}
+			else
+			{
+				lookup.count();
+			}
+			return keep(pipeline);
+		}
+	}
