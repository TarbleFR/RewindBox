diff --git a/rpcs3/ios/IOSRestoreExecutor.h b/rpcs3/ios/IOSRestoreExecutor.h
new file mode 100644
index 0000000..31b2c81
--- /dev/null
+++ b/rpcs3/ios/IOSRestoreExecutor.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <thread>
+
+namespace rpcs3::ios {
+// One owned worker, created only on the first internal restore. One admission
+// at a time; no unbounded queue, detached thread or new host ABI. Cancellation
+// invalidates a task even after dequeue while it waits for the Core API lock.
+class restore_executor final {
+public:
+    using task = std::function<void(std::uint64_t)>;
+    restore_executor() = default;
+    ~restore_executor();
+    restore_executor(const restore_executor&) = delete;
+    restore_executor& operator=(const restore_executor&) = delete;
+    bool post(task work, std::uint64_t token) noexcept;
+    bool cancel() noexcept;
+    bool current(std::uint64_t token) const noexcept;
+    std::uint64_t generation() const noexcept { return generation_.load(std::memory_order_acquire); }
+    bool close() noexcept; // join outside emulator/API/UI locks
+private:
+    struct job { std::uint64_t token; task work; };
+    std::mutex mutex_, join_mutex_;
+    std::condition_variable changed_;
+    std::optional<job> pending_;
+    std::thread worker_;
+    std::thread::id worker_id_{}; // mutex_: self-close check never reads a joining std::thread
+    std::atomic<std::uint64_t> generation_{1};
+    bool closed_ = false, active_ = false;
+    void run() noexcept;
+};
+// Called after UIKit has completed the existing stop/renderer cleanup.
+// The continuation runs under the Core API mutex, after generation and
+// lifecycle checks. A failure is reported; it never falls back to UIKit I/O.
+std::uint64_t savestate_restore_generation() noexcept;
+// True means scheduled OR an obsolete request safely discarded. False means
+// admission failed for the still-current request. No stale callback may mutate
+// a newer title, even if UIKit delivers it only after a later boot/stop.
+bool defer_savestate_restore(std::function<void()> continuation, std::uint64_t token) noexcept;
+}
diff --git a/rpcs3/ios/IOSRestoreFailure.h b/rpcs3/ios/IOSRestoreFailure.h
new file mode 100644
index 0000000..8c8be8d
--- /dev/null
+++ b/rpcs3/ios/IOSRestoreFailure.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+
+// A recoverable missing-resource failure on the one restore worker. No throws
+// cross the noexcept ID constructors, and no serialized format is changed.
+namespace rpcs3::ios::restore_failure
+{
+struct failure
+{
+    std::uint32_t id = 0, error = 0;
+    std::array<char, 256> disc_path{};
+    bool active = false;
+};
+inline constinit thread_local failure current{};
+inline void reset() noexcept { current = {}; }
+inline bool failed() noexcept { return current.active; }
+inline void missing(std::uint32_t id, std::uint32_t error, std::string_view path) noexcept
+{
+    if (current.active) return; // Preserve the first cause.
+    current.id = id; current.error = error; current.active = true;
+    // Only disc-relative guest names can be exported. Never an iOS container,
+    // host_root, user save name, file content or a persisted absolute host path.
+    if (!path.starts_with("/dev_bdvd/")) return;
+    const auto count = path.size() < current.disc_path.size() ? path.size() : current.disc_path.size() - 1;
+    for (std::size_t i = 0; i < count; ++i)
+    {
+        const auto c = static_cast<unsigned char>(path[i]);
+        current.disc_path[i] = c >= 32 && c < 127 ? static_cast<char>(c) : '?';
+    }
+}
+}
diff --git a/rpcs3/ios/IOSRsxIdlePark.h b/rpcs3/ios/IOSRsxIdlePark.h
new file mode 100644
index 0000000..b344283
--- /dev/null
+++ b/rpcs3/ios/IOSRsxIdlePark.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+// CELL565_RSX_IDLE_PARK: with an empty FIFO the RSX thread yields in a loop, so
+// it keeps a whole core while it waits for the next guest commands (Dragon Ball
+// Z Budokai HD on build 564: 0.90 core with the FIFO busy 33-43 % of the time,
+// one idle period of about 12 ms per frame). The iPhone has two performance
+// cores; that core is taken from the SPU and PPU threads doing the guest's
+// work. After the FIFO has stayed empty for grace_us, the thread sleeps in
+// slices of slice_us instead. The guest's next PUT is seen at the end of the
+// current slice at worst; a flush request, a flip request or a ZCULL pipe flush
+// posted by another thread wakes it at once.
+namespace rpcs3::ios::rsx_idle_park
+{
+inline std::atomic<bool> enabled{false};
+
+// Short gaps inside a frame keep the yield loop; only a long idle period parks.
+constexpr std::uint64_t grace_us = 1000;
+constexpr std::uint64_t slice_us = 50;
+
+inline std::mutex gate_mutex;
+inline std::condition_variable gate;
+inline std::uint64_t generation = 0;
+inline std::atomic<std::uint32_t> parked{0};
+
+// RSX thread only: sleep one slice unless woken.
+inline void park() noexcept
+{
+	parked.fetch_add(1, std::memory_order_seq_cst);
+	{
+		std::unique_lock lock(gate_mutex);
+		const std::uint64_t seen = generation;
+		gate.wait_for(lock, std::chrono::microseconds(slice_us), [&] { return generation != seen; });
+	}
+	parked.fetch_sub(1, std::memory_order_relaxed);
+}
+
+// Any thread, after posting work the RSX thread must service.
+inline void wake() noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed) || !parked.load(std::memory_order_seq_cst))
+	{
+		return;
+	}
+
+	{
+		std::lock_guard lock(gate_mutex);
+		generation++;
+	}
+	gate.notify_all();
+}
+}
diff --git a/rpcs3/ios/IOSRsxSyncProfile.h b/rpcs3/ios/IOSRsxSyncProfile.h
new file mode 100644
index 0000000..612c9b4
--- /dev/null
+++ b/rpcs3/ios/IOSRsxSyncProfile.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_RSX_SYNC_PROFILE_V1: where the RSX thread's frame goes. Dragon Ball
+// Z HD Collection (547 logs, BLES01658) runs at 31-35 fps with an unimodal
+// 22-36 ms frame (not a 30 fps cap): per frame the RSX thread uses 21 ms of CPU
+// and waits twice for the GPU, 7.3 ms in total, i.e. 28 of the 30 ms. Neither
+// which waits these are nor how much of that CPU is MoltenVK encoding the Metal
+// commands inside vkQueueSubmit (synchronous submits) was measured. Durations
+// are TSC ticks; the profiler converts and drains them once per window.
+namespace rpcs3::ios::rsx_sync
+{
+enum site : unsigned
+{
+    other,
+    frame_cleanup, // frame_context_cleanup: the frame queue waits for an older frame
+    cb_reuse,      // a command buffer still pending on the GPU is recycled
+    hard_sync,     // flush_command_queue(hard_sync): wait for everything submitted
+    texture,       // texture cache readback or DMA completion
+    site_count
+};
+
+inline const char* site_name(site value) noexcept
+{
+    switch (value)
+    {
+    case frame_cleanup: return "frame_cleanup";
+    case cb_reuse: return "cb_reuse";
+    case hard_sync: return "hard_sync";
+    case texture: return "texture";
+    default: return "other";
+    }
+}
+
+inline thread_local site t_site = other;
+
+// The outermost reason wins unless `override` is set: a hard sync drains the
+// frame queue and recycles buffers, and those waits belong to the hard sync.
+class SiteScope final
+{
+    site previous_;
+public:
+    explicit SiteScope(site value, bool override = false) noexcept : previous_(t_site)
+    {
+        if (override || t_site == other) t_site = value;
+    }
+    ~SiteScope() noexcept { t_site = previous_; }
+    SiteScope(const SiteScope&) = delete;
+    SiteScope& operator=(const SiteScope&) = delete;
+};
+
+inline std::array<diagnostics::EventCost, site_count> fence_wait_ticks{};
+inline diagnostics::EventCost submit_ticks{};  // vkQueueSubmit on the calling thread
+inline diagnostics::EventCost acquire_ticks{}; // vkAcquireNextImageKHR (CAMetalLayer drawable)
+inline diagnostics::EventCost present_ticks{}; // vkQueuePresentKHR
+// Swap submission to observed completion of the same frame (frame cleanup):
+// about one frame when the GPU keeps up, up to the frames in flight when it
+// does not.
+inline diagnostics::EventCost frame_latency_ticks{};
+// REWINDBOX_MOLTENVK_COMPILE_QOS_V1: MoltenVK Metal compiles dispatched in the
+// waiting thread's user-interactive class, or at the default priority.
+inline std::atomic<std::uint64_t> metal_compiles_interactive{0};
+inline std::atomic<std::uint64_t> metal_compiles_default{0};
+
+// REWINDBOX_RSX_FRAME_PROFILE_V1: RPCS3's own per-frame RSX statistics
+// (frame_statistics_t). Counters are taken every frame; the stage timers only
+// run on sampled frames (one in rsx_frame_sample_period) because they read
+// the clock around every draw. The RSX thread adds once per flip; the
+// profiler exchanges once per window. FIFO idle entries count transitions of
+// the puller from running to empty, NOP or jump-to-self.
+inline constexpr unsigned rsx_frame_sample_period = 8;
+struct rsx_frame_window
+{
+    std::atomic<std::uint64_t> frames{0}, sampled{0}, draws{0}, submits{0};
+    std::atomic<std::uint64_t> setup_us{0}, vertex_us{0}, texture_us{0}, exec_us{0}, flip_us{0}, sampled_draws{0};
+    std::atomic<std::uint64_t> vertex_cache_requests{0}, vertex_cache_misses{0}, program_lookups{0}, program_lookups_elided{0};
+    std::atomic<std::uint64_t> fifo_idle_entries{0};
+};
+inline rsx_frame_window rsx_frames{};
+
+inline void record_fence_wait(std::uint64_t ticks) noexcept
+{
+    fence_wait_ticks[t_site < site_count ? t_site : other].record(ticks);
+}
+}
diff --git a/rpcs3/ios/IOSRuntimeMetrics.h b/rpcs3/ios/IOSRuntimeMetrics.h
new file mode 100644
index 0000000..433344e
--- /dev/null
+++ b/rpcs3/ios/IOSRuntimeMetrics.h
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// Build527: bounded, allocation-free observations. No emulation decision reads
+// these counters. Frame samples are guest flips only, not UIKit/overlay frames.
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace rpcs3::ios::diagnostics
+{
+class GuestFrameWindow final
+{
+public:
+    static constexpr std::size_t capacity = 2048;
+    static constexpr std::size_t histogram_bins = 256;
+    static constexpr std::uint32_t histogram_upper_us(std::size_t bin) noexcept
+    {
+        return bin < 128 ? static_cast<std::uint32_t>((bin + 1) * 1000 - 1)
+            : bin < 255 ? static_cast<std::uint32_t>(128000 + (bin - 127) * 8000 - 1) : UINT32_MAX;
+    }
+    struct Sample
+    {
+        std::array<std::uint64_t, histogram_bins> histogram{};
+        std::uint64_t intervals = 0, unavailable = 0, total_us = 0;
+        std::uint32_t median_us = 0, p95_us = 0, p99_us = 0, maximum_us = 0;
+        std::uint64_t over_50ms = 0, over_100ms = 0;
+    };
+
+    // One producer: rsx::thread::flip(). UI flips do not advance the guest
+    // baseline. Microsecond quantization bounds the packed interval to 71 min;
+    // saturation is explicit in the output. The sequence shares the same atomic
+    // word, so a wrap/overwrite cannot produce a torn frame/timestamp pair.
+    void record(bool guest_flip, std::uint64_t now_ticks, std::uint64_t frequency) noexcept
+    {
+        if (!guest_flip || !frequency) return;
+        const auto previous = last_ticks_.exchange(now_ticks, std::memory_order_relaxed);
+        if (!previous || now_ticks <= previous) return;
+        const auto ticks = now_ticks - previous;
+        const auto whole_seconds = ticks / frequency;
+        const auto remainder = ticks % frequency;
+        const auto micros = whole_seconds > UINT32_MAX / 1'000'000
+            ? UINT32_MAX : std::min<std::uint64_t>(UINT32_MAX,
+                whole_seconds * 1'000'000 + (remainder <= UINT64_MAX / 1'000'000
+                    ? remainder * 1'000'000 / frequency
+                    : static_cast<std::uint64_t>(static_cast<long double>(remainder) * 1'000'000 / frequency)));
+        const auto index = published_.load(std::memory_order_relaxed);
+        const auto packed = (static_cast<std::uint64_t>(static_cast<std::uint32_t>(index)) << 32) | micros;
+        ring_[index % capacity].store(packed, std::memory_order_release);
+        published_.store(index + 1, std::memory_order_release);
+    }
+
+    // Lifecycle owner calls only after the old renderer producer has stopped,
+    // as required by reset_performance_metrics(). Monotonic indices preserve
+    // overwrite detection without touching all 2048 slots at every new session.
+    void reset() noexcept
+    {
+        last_ticks_.store(0, std::memory_order_relaxed);
+        cursor_ = published_.load(std::memory_order_acquire);
+    }
+
+    // One consumer: the existing 5 s sampler. At most capacity samples are
+    // sorted on its stack. Concurrent overwrite is counted as unavailable;
+    // UI frames and unsupported/invalid clocks cannot create intervals.
+    Sample take() noexcept
+    {
+        const auto end = published_.load(std::memory_order_acquire);
+        const auto first = std::max(cursor_, end > capacity ? end - capacity : 0);
+        Sample result;
+        result.unavailable = first - cursor_;
+        std::array<std::uint32_t, capacity> intervals{};
+        std::size_t count = 0;
+        for (auto i = first; i < end; ++i)
+        {
+            const auto packed = ring_[i % capacity].load(std::memory_order_acquire);
+            if (static_cast<std::uint32_t>(packed >> 32) != static_cast<std::uint32_t>(i))
+            {
+                ++result.unavailable;
+                continue;
+            }
+            const auto interval = static_cast<std::uint32_t>(packed);
+            intervals[count++] = interval;
+            result.total_us += interval;
+            const auto bin = interval < 128000 ? interval / 1000
+                : std::min<std::uint32_t>(255, 128 + (interval - 128000) / 8000);
+            ++result.histogram[bin];
+            result.over_50ms += interval > 50'000;
+            result.over_100ms += interval > 100'000;
+        }
+        cursor_ = end;
+        result.intervals = count;
+        if (count)
+        {
+            std::sort(intervals.begin(), intervals.begin() + count);
+            const auto percentile = [&](std::size_t percent)
+            {
+                return intervals[(count * percent + 99) / 100 - 1];
+            };
+            result.median_us = percentile(50);
+            result.p95_us = percentile(95);
+            result.p99_us = percentile(99);
+            result.maximum_us = intervals[count - 1];
+        }
+        return result;
+    }
+private:
+    std::array<std::atomic<std::uint64_t>, capacity> ring_{};
+    std::atomic<std::uint64_t> last_ticks_{0}, published_{0};
+    std::uint64_t cursor_ = 0;
+};
+
+// Maxima are observational window maxima. Drain can split an event's count,
+// sum and maximum over adjacent windows; totals across completed drains are
+// conserved. No lock, allocation or clock call is added to the existing hooks.
+class EventCost final
+{
+public:
+    struct Sample { std::uint64_t count = 0, total = 0, maximum = 0; };
+    void record(std::uint64_t duration) noexcept
+    {
+        count_.fetch_add(1, std::memory_order_relaxed);
+        total_.fetch_add(duration, std::memory_order_relaxed);
+        auto old = maximum_.load(std::memory_order_relaxed);
+        while (old < duration && !maximum_.compare_exchange_weak(old, duration, std::memory_order_relaxed)) {}
+    }
+    Sample take() noexcept
+    {
+        return {count_.exchange(0, std::memory_order_relaxed),
+                total_.exchange(0, std::memory_order_relaxed),
+                maximum_.exchange(0, std::memory_order_relaxed)};
+    }
+private:
+    std::atomic<std::uint64_t> count_{0}, total_{0}, maximum_{0};
+};
+
+struct ProcessMemorySample
+{
+    bool valid = false;
+    std::uint64_t footprint = 0, resident = 0, compressed = 0, virtual_bytes = 0;
+};
+class ProcessMemoryWindow final
+{
+public:
+    void reset() noexcept { latest = {}; peak = {}; samples = 0; }
+    void record(ProcessMemorySample value) noexcept
+    {
+        latest = value;
+        if (!value.valid) return;
+        peak.valid = true;
+        peak.footprint = std::max(peak.footprint, value.footprint);
+        peak.resident = std::max(peak.resident, value.resident);
+        peak.compressed = std::max(peak.compressed, value.compressed);
+        peak.virtual_bytes = std::max(peak.virtual_bytes, value.virtual_bytes);
+        ++samples;
+    }
+    ProcessMemorySample latest{}, peak{};
+    std::uint64_t samples = 0;
+};
+}
diff --git a/rpcs3/ios/IOSShaderTiming.h b/rpcs3/ios/IOSShaderTiming.h
new file mode 100644
index 0000000..e4b2379
--- /dev/null
+++ b/rpcs3/ios/IOSShaderTiming.h
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <ctime>
+#include <sys/resource.h>
+
+namespace rpcs3::ios::shader_timing
+{
+// Measure the actual Vulkan/compiler entry points: the legacy synchronous
+// path does not visit the asynchronous pipeline worker's existing counters.
+// Fixed process-wide storage, no allocation, no logs and no emulation choices.
+enum class Stage : std::size_t { source, module, graphics, compute, debug_source, count };
+inline std::array<diagnostics::EventCost, static_cast<std::size_t>(Stage::count)> costs{};
+
+// CELL538: operation boundaries permit alignment with guest-flip intervals.
+// Fixed 32-entry storage; producers never wait for the reporter or each other.
+// Slow startup bursts may overflow: every rejected record is counted.
+struct PipelineContext
+{
+    std::uint64_t properties = 0, renderpass = 0, vertex_module = 0, fragment_module = 0, flags = 0;
+    // CELL543: written once after the driver call returns, still per actual
+    // construction. Feedback bits: 1 chained, 2 pipeline valid, 4 VS valid,
+    // 8 VS from VkPipelineCache, 16 FS valid, 32 FS from VkPipelineCache.
+    // Durations are MoltenVK-reported; CPU deltas separate this thread's own
+    // conversion work from the rest of the process while it waits on Metal.
+    std::uint32_t feedback = 0, concurrent = 0;
+    std::uint64_t driver_ns = 0, vertex_ns = 0, fragment_ns = 0;
+    std::uint64_t thread_cpu_us = 0, process_cpu_us = 0;
+};
+inline thread_local PipelineContext pipeline_context;
+
+// CELL543: why the cache built: bit 1 new vertex program, 2 new fragment
+// program (neither: an existing shader pair met new state), 4 inline, 8 deferred.
+inline thread_local std::uint32_t build_origin = 0;
+class BuildOriginScope final
+{
+    std::uint32_t previous_ = build_origin;
+public:
+    explicit BuildOriginScope(std::uint32_t value) noexcept { build_origin = value; }
+    ~BuildOriginScope() noexcept { build_origin = previous_; }
+    BuildOriginScope(const BuildOriginScope&) = delete;
+    BuildOriginScope& operator=(const BuildOriginScope&) = delete;
+};
+
+struct CpuClock
+{
+    std::uint64_t thread_us = 0, process_us = 0;
+    static CpuClock now() noexcept
+    {
+        CpuClock result;
+        timespec thread_time{};
+        if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &thread_time) == 0)
+            result.thread_us = static_cast<std::uint64_t>(thread_time.tv_sec) * 1'000'000 + static_cast<std::uint64_t>(thread_time.tv_nsec) / 1000;
+        rusage usage{};
+        if (getrusage(RUSAGE_SELF, &usage) == 0)
+            result.process_us = (static_cast<std::uint64_t>(usage.ru_utime.tv_sec) + static_cast<std::uint64_t>(usage.ru_stime.tv_sec)) * 1'000'000 +
+                static_cast<std::uint64_t>(usage.ru_utime.tv_usec) + static_cast<std::uint64_t>(usage.ru_stime.tv_usec);
+        return result;
+    }
+};
+// Set once per actual pipeline construction, never per draw or SPU operation.
+// RAII restores nested contexts, exceptions and worker reuse without retaining
+// pointers to a renderer or a previous session. Handles are process-local IDs.
+class PipelineContextScope final
+{
+    PipelineContext previous_ = pipeline_context;
+public:
+    explicit PipelineContextScope(PipelineContext value) noexcept { pipeline_context = value; }
+    ~PipelineContextScope() noexcept { pipeline_context = previous_; }
+    PipelineContextScope(const PipelineContextScope&) = delete;
+    PipelineContextScope& operator=(const PipelineContextScope&) = delete;
+};
+struct SlowOperation
+{
+    Stage stage{};
+    std::uint64_t begin_us = 0, end_us = 0;
+    PipelineContext pipeline{};
+    std::uint32_t origin = 0;
+};
+class SlowOperations final
+{
+    std::mutex mutex_;
+    std::array<SlowOperation, 32> events_{};
+    std::size_t size_ = 0;
+    std::atomic<std::uint64_t> dropped_{0};
+public:
+    struct Snapshot
+    {
+        std::array<SlowOperation, 32> events{};
+        std::size_t size = 0;
+        std::uint64_t dropped = 0;
+        bool captured = false;
+    };
+    void record(Stage stage, std::uint64_t begin_us, std::uint64_t end_us) noexcept
+    {
+        if (end_us < begin_us || end_us - begin_us < 50'000) return;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock || size_ == events_.size())
+        {
+            dropped_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        events_[size_++] = {stage, begin_us, end_us,
+            stage == Stage::graphics ? pipeline_context : PipelineContext{},
+            stage == Stage::graphics ? build_origin : 0u};
+    }
+    Snapshot take() noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return {};
+        Snapshot result{events_, size_, dropped_.exchange(0, std::memory_order_relaxed), true};
+        size_ = 0;
+        return result;
+    }
+};
+inline constinit SlowOperations slow_operations;
+
+// CELL536: retain the renderer's actual configuration in periodic evidence.
+// Fixed storage, no renderer dereference, no lock on a frame/compile path.
+struct Configuration
+{
+    bool captured = false, live = false, interpreter_supported = false;
+    std::uint32_t configured = 0, applied = 0;
+    std::uint64_t generation = 0;
+};
+class ConfigurationProfile final
+{
+    mutable std::mutex mutex_;
+    const void* owner_ = nullptr;
+    Configuration value_{};
+public:
+    void begin(const void* owner, std::uint32_t configured, std::uint32_t applied, bool supported)
+    {
+        std::lock_guard lock(mutex_);
+        owner_ = owner;
+        value_ = {true, true, supported, configured, applied, value_.generation + 1};
+    }
+    void end(const void* owner)
+    {
+        std::lock_guard lock(mutex_);
+        if (owner_ != owner) return;
+        owner_ = nullptr;
+        value_ = {true, false, false, 0, 0, value_.generation};
+    }
+    Configuration capture() const
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        return lock ? value_ : Configuration{};
+    }
+};
+inline constinit ConfigurationProfile configuration;
+
+class Scope final
+{
+    using Clock = std::chrono::steady_clock;
+    Stage stage_;
+    Clock::time_point begin_ = Clock::now();
+public:
+    explicit Scope(Stage stage) noexcept : stage_(stage) {}
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+    ~Scope() noexcept
+    {
+        const auto end = Clock::now();
+        const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(end - begin_).count();
+        costs[static_cast<std::size_t>(stage_)].record(static_cast<std::uint64_t>(std::max<std::int64_t>(elapsed, 0)));
+        if (elapsed >= 50'000)
+        {
+            slow_operations.record(stage_,
+                std::chrono::duration_cast<std::chrono::microseconds>(begin_.time_since_epoch()).count(),
+                std::chrono::duration_cast<std::chrono::microseconds>(end.time_since_epoch()).count());
+        }
+    }
+};
+
+inline auto take() noexcept
+{
+    std::array<diagnostics::EventCost::Sample, costs.size()> result{};
+    for (std::size_t i = 0; i < result.size(); ++i) result[i] = costs[i].take();
+    return result;
+}
+
+inline void raise_to(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+{
+    auto old = value.load(std::memory_order_relaxed);
+    while (old < candidate && !value.compare_exchange_weak(old, candidate, std::memory_order_relaxed)) {}
+}
+
+// CELL543: shader-cache disk publication. caller = time the producing thread
+// (normally RSX) spends in store(); write = one complete record on the writer;
+// commit = each atomic temporary write, fsync and rename. Deferred and inline
+// counts show where the I/O ran. A full queue writes inline; nothing is dropped.
+struct PublicationProfile
+{
+    diagnostics::EventCost caller, write, commit;
+    std::atomic<std::uint64_t> deferred{0}, inline_writes{0}, failures{0}, depth_peak{0};
+    struct Sample
+    {
+        diagnostics::EventCost::Sample caller, write, commit;
+        std::uint64_t deferred = 0, inline_writes = 0, failures = 0, depth_peak = 0;
+    };
+    Sample take() noexcept
+    {
+        return {caller.take(), write.take(), commit.take(),
+            deferred.exchange(0, std::memory_order_relaxed), inline_writes.exchange(0, std::memory_order_relaxed),
+            failures.exchange(0, std::memory_order_relaxed), depth_peak.exchange(0, std::memory_order_relaxed)};
+    }
+};
+inline PublicationProfile publication;
+
+// CELL555: bounded recent-key observations, not a pipeline cache. The old table
+// permanently filled during warm-up, losing every later unknown key. Retain
+// the latest 64 admitted identities with FIFO replacement and explicit eviction
+// counts. Repeats are a lifetime lower bound: an evicted identity may return.
+// Raw/UI pipelines lack a complete context and are counted as unattributed,
+// never merged into the all-zero fingerprint. Their timing remains recorded.
+class FingerprintTable final
+{
+public:
+    static constexpr std::size_t capacity = 64;
+    struct Entry { std::uint64_t fingerprint = 0, builds = 0, total_us = 0, max_us = 0; };
+    struct Snapshot
+    {
+        std::uint64_t distinct = 0, repeated_builds = 0, dropped = 0;
+        std::uint64_t tracked = 0, evicted = 0, unattributed = 0;
+        std::array<Entry, 3> costliest{}, repeated{};
+        bool captured = false;
+    };
+    static std::uint64_t fingerprint(const PipelineContext& c) noexcept
+    {
+        auto mix = [](std::uint64_t seed, std::uint64_t value) noexcept
+        {
+            seed ^= value + 0x9e3779b97f4a7c15ull + (seed << 6) + (seed >> 2);
+            return seed;
+        };
+        const auto result = mix(mix(mix(mix(mix(0x51ed270b27aeb4ffull, c.properties), c.renderpass), c.vertex_module), c.fragment_module), c.flags);
+        return result ? result : 1;
+    }
+    void record(const PipelineContext& context, std::uint64_t duration_us) noexcept
+    {
+        if (!context.vertex_module || !context.fragment_module)
+        {
+            unattributed_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        record(fingerprint(context), duration_us);
+    }
+    void record(std::uint64_t key, std::uint64_t duration_us) noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock)
+        {
+            dropped_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        for (std::size_t i = 0; i < capacity; ++i)
+        {
+            auto& entry = entries_[i];
+            if (entry.fingerprint && entry.fingerprint != key) continue;
+            tracked_++;
+            repeated_builds_ += entry.fingerprint ? 1 : 0;
+            entry.fingerprint = key;
+            entry.builds++;
+            entry.total_us += duration_us;
+            entry.max_us = std::max(entry.max_us, duration_us);
+            return;
+        }
+        // Full table: replace one observation, never an actual GPU pipeline.
+        // No allocation, no waiting and no increase in the 64-entry capacity.
+        entries_[next_replacement_] = {key, 1, duration_us, duration_us};
+        next_replacement_ = (next_replacement_ + 1) % capacity;
+        tracked_++;
+        evicted_++;
+    }
+    Snapshot snapshot() noexcept
+    {
+        Snapshot result;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return result;
+        result.captured = true;
+        result.dropped = dropped_.load(std::memory_order_relaxed);
+        result.unattributed = unattributed_.load(std::memory_order_relaxed);
+        result.tracked = tracked_;
+        result.evicted = evicted_;
+        result.repeated_builds = repeated_builds_;
+        for (const auto& entry : entries_)
+        {
+            if (!entry.fingerprint) continue;
+            result.distinct++;
+            auto insert = [&entry](std::array<Entry, 3>& list, auto&& better)
+            {
+                for (auto& slot : list)
+                {
+                    if (!slot.fingerprint || better(entry, slot))
+                    {
+                        auto carry = entry;
+                        for (auto* it = &slot; it != list.data() + list.size(); ++it) std::swap(*it, carry);
+                        return;
+                    }
+                }
+            };
+            insert(result.costliest, [](const Entry& a, const Entry& b) { return a.max_us > b.max_us; });
+            if (entry.builds > 1) insert(result.repeated, [](const Entry& a, const Entry& b) { return a.builds > b.builds; });
+        }
+        return result;
+    }
+    void reset() noexcept
+    {
+        std::lock_guard lock(mutex_);
+        entries_ = {};
+        dropped_.store(0, std::memory_order_relaxed);
+        unattributed_.store(0, std::memory_order_relaxed);
+        tracked_ = repeated_builds_ = evicted_ = 0;
+        next_replacement_ = 0;
+    }
+private:
+    std::mutex mutex_;
+    std::array<Entry, capacity> entries_{};
+    std::atomic<std::uint64_t> dropped_{0};
+    std::atomic<std::uint64_t> unattributed_{0};
+    std::uint64_t tracked_ = 0, repeated_builds_ = 0, evicted_ = 0;
+    std::size_t next_replacement_ = 0;
+};
+
+// CELL543: single-flight, origin and MoltenVK cache attribution counters.
+// Updated once per actual build or wait, never per draw or SPU operation.
+struct PipelineProfile
+{
+    std::atomic<std::uint64_t> new_vertex{0}, new_fragment{0}, state_only{0}, abandoned{0};
+    diagnostics::EventCost pending_wait;
+    std::atomic<std::uint64_t> feedback{0}, vertex_cached{0}, vertex_compiled{0}, fragment_cached{0}, fragment_compiled{0}, cache_additions{0};
+    std::atomic<std::int64_t> live{0};
+    std::atomic<std::uint32_t> in_driver{0};
+    FingerprintTable fingerprints;
+    struct Sample
+    {
+        std::uint64_t new_vertex = 0, new_fragment = 0, state_only = 0, abandoned = 0;
+        diagnostics::EventCost::Sample pending_wait;
+        std::uint64_t feedback = 0, vertex_cached = 0, vertex_compiled = 0, fragment_cached = 0, fragment_compiled = 0, cache_additions = 0;
+        std::int64_t live = 0;
+    };
+    void record_origin(std::uint32_t origin) noexcept
+    {
+        if (origin & 1) new_vertex.fetch_add(1, std::memory_order_relaxed);
+        if (origin & 2) new_fragment.fetch_add(1, std::memory_order_relaxed);
+        if (!(origin & 3)) state_only.fetch_add(1, std::memory_order_relaxed);
+    }
+    void record_feedback(std::uint32_t bits) noexcept
+    {
+        if (!(bits & 1)) return;
+        feedback.fetch_add(1, std::memory_order_relaxed);
+        if (bits & 4) ((bits & 8) ? vertex_cached : vertex_compiled).fetch_add(1, std::memory_order_relaxed);
+        if (bits & 16) ((bits & 32) ? fragment_cached : fragment_compiled).fetch_add(1, std::memory_order_relaxed);
+    }
+    Sample take() noexcept
+    {
+        Sample result;
+        result.new_vertex = new_vertex.exchange(0, std::memory_order_relaxed);
+        result.new_fragment = new_fragment.exchange(0, std::memory_order_relaxed);
+        result.state_only = state_only.exchange(0, std::memory_order_relaxed);
+        result.abandoned = abandoned.exchange(0, std::memory_order_relaxed);
+        result.pending_wait = pending_wait.take();
+        result.feedback = feedback.exchange(0, std::memory_order_relaxed);
+        result.vertex_cached = vertex_cached.exchange(0, std::memory_order_relaxed);
+        result.vertex_compiled = vertex_compiled.exchange(0, std::memory_order_relaxed);
+        result.fragment_cached = fragment_cached.exchange(0, std::memory_order_relaxed);
+        result.fragment_compiled = fragment_compiled.exchange(0, std::memory_order_relaxed);
+        result.cache_additions = cache_additions.exchange(0, std::memory_order_relaxed);
+        result.live = live.load(std::memory_order_relaxed);
+        return result;
+    }
+};
+inline PipelineProfile pipeline_profile;
+}
diff --git a/rpcs3/ios/IOSSpuWaitProfile.h b/rpcs3/ios/IOSSpuWaitProfile.h
new file mode 100644
index 0000000..7167ee8
--- /dev/null
+++ b/rpcs3/ios/IOSSpuWaitProfile.h
@@ -0,0 +1,130 @@
+#pragma once
+
+// REWINDBOX_SPU_WAIT_PROFILE_V1: where SPU threads spend time outside guest
+// code. The 547 God of War III logs show about 3.4 SPU cores per frame, also
+// while every draw waited for a pipeline, with almost no confirmed GETLLAR
+// poll (PRESSURE547 spu_passive_waits 0-33): which wait burns that CPU was not
+// measurable. Counters live in per-thread slots written only by their owner
+// (relaxed load + store, no shared read-modify-write on the hot paths); the
+// profiler sums every slot. Slots are claimed at first use and released when
+// the thread exits; totals only grow, so window deltas stay exact.
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rpcs3::ios::spu_wait
+{
+	enum counter : std::size_t
+	{
+		getllar_poll_ticks, // busy polling of unchanged reservation data, between consecutive polls
+		getllar_polls,
+		getllar_sleep_ticks, // a polling GETLLAR asleep on the reservation notifier
+		getllar_sleeps,
+		event_wait_ticks, // RdEventStat calls that had to wait (busy and passive)
+		event_waits,
+		putllc_ok,
+		putllc_fail,
+		putllc_heavy, // stores under the exclusive vm::writer_lock (every running PPU parked)
+		counter_count
+	};
+
+	// A gap above this between two polls is a new polling episode, not polling time.
+	inline constexpr std::uint64_t poll_gap_ns = 20'000;
+
+	struct alignas(128) slot
+	{
+		std::array<std::atomic<std::uint64_t>, counter_count> value{};
+		std::atomic<bool> owned{false};
+	};
+
+	inline constexpr std::size_t slot_count = 32;
+
+	// The last slot is shared by threads beyond slot_count and uses fetch_add.
+	inline std::array<slot, slot_count + 1> g_slots{};
+
+	struct claim
+	{
+		slot* owned = nullptr;
+		std::uint64_t last_poll = 0;
+
+		~claim()
+		{
+			if (owned && owned != &g_slots[slot_count])
+			{
+				owned->owned.store(false, std::memory_order_release);
+			}
+		}
+	};
+
+	inline claim& local() noexcept
+	{
+		thread_local claim t_claim;
+
+		if (!t_claim.owned)
+		{
+			for (std::size_t i = 0; i < slot_count && !t_claim.owned; i++)
+			{
+				bool expected = false;
+
+				if (g_slots[i].owned.compare_exchange_strong(expected, true, std::memory_order_acquire))
+				{
+					t_claim.owned = &g_slots[i];
+				}
+			}
+
+			if (!t_claim.owned)
+			{
+				t_claim.owned = &g_slots[slot_count];
+			}
+		}
+
+		return t_claim;
+	}
+
+	inline void add(counter c, std::uint64_t v = 1) noexcept
+	{
+		slot& s = *local().owned;
+		auto& value = s.value[c];
+
+		if (&s == &g_slots[slot_count])
+		{
+			value.fetch_add(v, std::memory_order_relaxed);
+		}
+		else
+		{
+			value.store(value.load(std::memory_order_relaxed) + v, std::memory_order_relaxed);
+		}
+	}
+
+	// One busy poll at tick `now`; the gap since the previous poll counts as
+	// polling time when it is shorter than poll_gap_ticks.
+	inline void poll(std::uint64_t now, std::uint64_t poll_gap_ticks) noexcept
+	{
+		claim& c = local();
+
+		if (c.last_poll && now > c.last_poll && now - c.last_poll <= poll_gap_ticks)
+		{
+			add(getllar_poll_ticks, now - c.last_poll);
+		}
+
+		c.last_poll = now;
+		add(getllar_polls);
+	}
+
+	inline std::array<std::uint64_t, counter_count> totals() noexcept
+	{
+		std::array<std::uint64_t, counter_count> sum{};
+
+		for (const slot& s : g_slots)
+		{
+			for (std::size_t i = 0; i < counter_count; i++)
+			{
+				sum[i] += s.value[i].load(std::memory_order_relaxed);
+			}
+		}
+
+		return sum;
+	}
+}
diff --git a/rpcs3/ios/IOSTextureHash.cpp b/rpcs3/ios/IOSTextureHash.cpp
index 4d7a339..cb021bc 100644
--- a/rpcs3/ios/IOSTextureHash.cpp
+++ b/rpcs3/ios/IOSTextureHash.cpp
@@ -1,4 +1,6 @@
 #include "IOSTextureHash.h"
+#include "Utilities/JITMemoryProfile.h"
+#include "util/tsc.hpp"
 
 // Use the bundled implementation's existing six-NEON/two-scalar-lane variant.
 // Keep this in its own translation unit so other hashes retain their lowering.
@@ -9,11 +11,52 @@
 #include "Utilities/xxhash3.h"
 #pragma clang diagnostic pop
 
+namespace
+{
+#if defined(__aarch64__) || defined(__arm64__)
+// The texture cache reuses a 192-byte secret. Four stripes per iteration give
+// Clang room to overlap independent NEON/scalar work without changing XXH3's
+// accumulator order, block scrambles, final stripe or bytes read.
+XXH_FORCE_INLINE void accumulate_texture_stripes(xxh_u64* XXH_RESTRICT acc,
+	const xxh_u8* XXH_RESTRICT input, const xxh_u8* XXH_RESTRICT secret,
+	std::size_t stripe_count)
+{
+#if defined(__clang__)
+#pragma clang loop unroll_count(4)
+#endif
+	for (std::size_t stripe = 0; stripe < stripe_count; ++stripe)
+	{
+		const auto* data = input + stripe * XXH_STRIPE_LEN;
+		XXH_PREFETCH(data + XXH_PREFETCH_DIST);
+		XXH3_accumulate_512_neon(acc, data, secret + stripe * XXH_SECRET_CONSUME_RATE);
+	}
+}
+#endif
+}
+
 namespace rpcs3::ios
 {
 std::uint64_t texture_hash_hybrid(const void* src, std::size_t size,
 	const void* secret, std::size_t secret_size, std::uint64_t seed) noexcept
 {
+	const auto start = utils::get_tsc();
+	struct measurement {
+		std::uint64_t start; std::size_t bytes;
+		~measurement() {
+			jit_memory::texture_hash_bytes.fetch_add(bytes, std::memory_order_relaxed);
+			jit_memory::texture_hash_ticks.fetch_add(utils::get_tsc() - start, std::memory_order_relaxed);
+		}
+	} measure{start, size};
+
+#if defined(__aarch64__) || defined(__arm64__)
+	if (size >= 4096 && secret_size == XXH3_SECRET_DEFAULT_SIZE)
+	{
+		// Constant block geometry also removes the generic secret-size division.
+		// For long inputs withSecretandSeed uses the supplied secret, not seed.
+		return XXH3_hashLong_64b_internal(src, size, secret, XXH3_SECRET_DEFAULT_SIZE,
+			accumulate_texture_stripes, XXH3_scrambleAcc_neon);
+	}
+#endif
 	return XXH3_64bits_withSecretandSeed(src, size, secret, secret_size, seed);
 }
 }
