+inline v128 gv_mulfd(const v128& a, const v128& b)
+{
+#if defined(ARCH_X64)
+	return _mm_mul_pd(a, b);
+#elif defined(ARCH_ARM64)
+	return vmulq_f64(a, b);
+#endif
