+	u64 buffer_length(const object& buffer);
+
+	// Textures.
+	object new_texture(const object& device, const texture_descriptor& descriptor);
+	object new_texture_view(const object& texture, pixel_format format);
+	// newTextureViewWithPixelFormat:textureType:levels:slices:swizzle: (the texture needs usage_pixel_format_view).
+	object new_texture_view(const object& texture, const texture_view_descriptor& descriptor);
