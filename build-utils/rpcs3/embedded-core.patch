 #pragma once
 
+#include <atomic>
 #include <cstdint>
 
 namespace rpcs3::ios
@@ -17,4 +18,18 @@ namespace rpcs3::ios
 		return wait_iteration >= reservation_lock_spin_iterations &&
 			(wait_iteration % reservation_lock_yield_interval) == 0;
 	}
+
+	// CELL579_WRITER_YIELD: these yields run while the writer holds its exclusive
+	// bit, which parks every PPU thread. On Darwin sched_yield() is swtch_pri(0):
+	// with any other thread runnable it drops the caller to priority 0 until it is
