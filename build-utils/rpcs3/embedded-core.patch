+
+#if defined(__APPLE__)
+#include <os/os_sync_wait_on_address.h>
+#elif defined(__linux__)
+#include <ctime>
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+// CELL571_PASSIVE_LOCK_FAIRNESS: a CPU thread re-entering guest memory
+// (vm::passive_lock) waits until no exclusive writer lock is held anywhere, and
+// a heavy PUTLLC or reservation write takes one while waiting for every PPU
+// thread to park. Several SPUs taking writer locks back to back keep the word
+// set, and the waiter, woken only when it clears, finds a new writer each time
+// (build 567, Dragon Ball Z combat: 520-720 episodes and up to 10 ms per 5 s
+// window, against 3-10 ms in total on build 564). A waiter that has gone
+// through `starving_after` timed waits marks itself starving; a writer about to
+// take its lock first lets the held ones drain while one is, for at most
+// `writer_deferral`. No lock is skipped or weakened: the waiter still waits for
+// the word to clear, and the writer still takes its lock afterwards. The writer
+// spins with the CPU's pause hint: on Darwin sched_yield() depresses the
+// thread for a whole quantum (about 10 ms).
+//
+// CELL579_GATE_SLEEP: a writer spins for at most `writer_spin`, then sleeps on
+// `starving` for the rest of its deferral; the last starving waiter to leave
+// wakes it. Build 575, Call of Duty: Black Ops II: its waiters averaged 25-31
+// timed waits per episode, so heavy PUTLLC deferred most of the time, and in
+// the PUTLLC storm windows about 5 s per 5 s window went before the writers
+// published their bits: up to five SPU threads spinning on the cores the
+// starving PPU thread needed to run on. Deferrals shorter than `writer_spin`
+// (Dragon Ball Z keeps free cores) are unchanged; what the writer and the
+// waiter wait for is unchanged.
+namespace rpcs3::ios::passive_gate
+{
+inline std::atomic<bool> enabled{false};
+inline std::atomic<std::uint32_t> starving{0};
+
+// passive_lock: timed waits (50 us each) before a waiter counts as starving.
+constexpr std::uint64_t starving_after = 2;
+// Longest a writer defers to a starving waiter before taking its lock anyway.
+constexpr std::chrono::microseconds writer_deferral{500};
+// CELL579_GATE_SLEEP: of which it spins at most this long, then sleeps.
+constexpr std::chrono::microseconds writer_spin{50};
+
+// CELL579_GATE_SLEEP: writers asleep in defer_writer(). The waiter that clears
+// `starving` wakes one of them and each woken writer wakes the next, so the PPU
+// thread leaving its wait pays for one wake-up at most.
+inline std::atomic<std::uint32_t> sleepers{0};
+
+// Sleeps while `word` holds `value`, at most `timeout`; it may return earlier.
+inline void sleep_while(std::atomic<std::uint32_t>& word, std::uint32_t value, std::chrono::nanoseconds timeout) noexcept;
+inline void wake_one(std::atomic<std::uint32_t>& word) noexcept;
+
+// A waiter's starving mark, released on every exit of the wait loop.
+class waiter_mark
+{
+	bool m_marked = false;
+
+public:
+	waiter_mark() noexcept = default;
+	waiter_mark(const waiter_mark&) = delete;
+	waiter_mark& operator=(const waiter_mark&) = delete;
+
+	// Called once per timed wait; marks the waiter from the `starving_after`-th on.
+	void on_timed_wait(std::uint64_t timed_waits) noexcept
+	{
+		if (!m_marked && timed_waits >= starving_after && enabled.load(std::memory_order_relaxed))
+		{
+			m_marked = true;
+			starving.fetch_add(1, std::memory_order_acq_rel);
+		}
+	}
+
+	bool marked() const noexcept
+	{
+		return m_marked;
+	}
+
+	~waiter_mark()
+	{
+		// CELL579_GATE_SLEEP: the last starving waiter wakes a writer asleep in defer_writer().
+		if (m_marked && starving.fetch_sub(1, std::memory_order_seq_cst) == 1 && sleepers.load(std::memory_order_seq_cst))
+		{
+			wake_one(starving);
+		}
+	}
+};
+
+inline void relax() noexcept
+{
+#if defined(__aarch64__)
+	__asm__ volatile("yield" ::: "memory");
+#elif defined(__x86_64__) || defined(__i386__)
+	__builtin_ia32_pause();
+#endif
+}
+
+inline void sleep_while(std::atomic<std::uint32_t>& word, std::uint32_t value, std::chrono::nanoseconds timeout) noexcept
+{
+	static_assert(sizeof(word) == sizeof(std::uint32_t) && std::atomic<std::uint32_t>::is_always_lock_free);
+	const auto ns = static_cast<std::uint64_t>(timeout.count() > 0 ? timeout.count() : 1);
+#if defined(__APPLE__)
+	if (__builtin_available(iOS 17.4, macOS 14.4, *))
+	{
+		os_sync_wait_on_address_with_timeout(&word, value, sizeof(std::uint32_t), OS_SYNC_WAIT_ON_ADDRESS_NONE, OS_CLOCK_MACH_ABSOLUTE_TIME, ns);
+		return;
+	}
+#elif defined(__linux__)
+	const timespec relative{static_cast<time_t>(ns / 1'000'000'000), static_cast<long>(ns % 1'000'000'000)};
+	syscall(SYS_futex, &word, FUTEX_WAIT_PRIVATE, value, &relative, nullptr, 0);
+	return;
+#endif
+	// No address wait on this system: keep spinning, as in 575.
+	static_cast<void>(word); static_cast<void>(value);
+	relax();
+}
+
+inline void wake_one(std::atomic<std::uint32_t>& word) noexcept
+{
+#if defined(__APPLE__)
+	if (__builtin_available(iOS 17.4, macOS 14.4, *))
+	{
+		os_sync_wake_by_address_any(&word, sizeof(std::uint32_t), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+	}
+#elif defined(__linux__)
+	syscall(SYS_futex, &word, FUTEX_WAKE_PRIVATE, 1, nullptr, nullptr, 0);
+#else
+	static_cast<void>(word);
+#endif
+}
+
+// Before a writer publishes its lock: wait while a waiter starves, bounded.
+// Returns true when it deferred at all.
+inline bool defer_writer() noexcept
+{
+	std::uint32_t seen = starving.load(std::memory_order_acquire);
+
+	if (!seen)
+	{
+		return false;
+	}
+
+	const auto start = std::chrono::steady_clock::now();
+	const auto stop = start + writer_deferral;
+
+	for (auto now = start; seen && now < stop; now = std::chrono::steady_clock::now())
+	{
+		if (now - start < writer_spin)
+		{
+			relax();
+		}
+		else
+		{
+			// CELL579_GATE_SLEEP: leave the core to the starving waiter. A change of
+			// `starving` between the load and the sleep makes the sleep return at once.
+			sleepers.fetch_add(1, std::memory_order_seq_cst);
+			sleep_while(starving, seen, stop - now);
+			sleepers.fetch_sub(1, std::memory_order_seq_cst);
+
+			if (!starving.load(std::memory_order_seq_cst) && sleepers.load(std::memory_order_seq_cst))
+			{
+				// Pass the wake-up on to the next sleeping writer.
+				wake_one(starving);
+			}
+		}
+
+		seen = starving.load(std::memory_order_acquire);
+	}
+
+	return true;
+}
+}
diff --git a/rpcs3/ios/IOSReadbackProfile.h b/rpcs3/ios/IOSReadbackProfile.h
new file mode 100644
index 0000000..2fa0e35
--- /dev/null
+++ b/rpcs3/ios/IOSReadbackProfile.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include "util/tsc.hpp"
+
+// CELL555: identify synchronous GPU-to-guest transfers without recording guest
+// addresses or changing their ordering. Five fixed counters; two clock reads
+// only for a nonempty DMA batch, never for an ordinary draw/cache hit.
+namespace rpcs3::ios::readback
+{
+// CELL560: framebuffer commits and guest CPU faults are named (appended, the
+// 555 field order is unchanged).
+enum class Origin : unsigned
+{
+    unknown, texture_cpu, blit_source_cpu, blit_destination_dma, presentation_cpu,
+    fbo_commit, fault_read, fault_write, count
+};
+inline constexpr unsigned origin_count = static_cast<unsigned>(Origin::count);
+inline constexpr std::array<const char*, origin_count> names{
+    "unknown", "texture_cpu", "blit_source_cpu", "blit_destination_dma", "presentation_cpu",
+    "fbo_commit", "fault_read", "fault_write"};
+inline thread_local Origin current_origin = Origin::unknown;
+
+class OriginScope final
+{
+    Origin previous_;
+public:
+    explicit OriginScope(Origin value) noexcept : previous_(current_origin) { current_origin = value; }
+    ~OriginScope() noexcept { current_origin = previous_; }
+    OriginScope(const OriginScope&) = delete;
+    OriginScope& operator=(const OriginScope&) = delete;
+};
+
+struct Counter
+{
+    diagnostics::EventCost duration_ticks;
+    std::atomic<std::uint64_t> sections{0}, confirmed_bytes{0};
+    struct Sample
+    {
+        diagnostics::EventCost::Sample duration_ticks;
+        std::uint64_t sections = 0, confirmed_bytes = 0;
+    };
+    Sample take() noexcept
+    {
+        return {duration_ticks.take(), sections.exchange(0, std::memory_order_relaxed),
+            confirmed_bytes.exchange(0, std::memory_order_relaxed)};
+    }
+};
+inline std::array<Counter, origin_count> counters{};
+
+class BatchScope final
+{
+    unsigned origin_;
+    std::uint64_t sections_, bytes_, begin_;
+public:
+    BatchScope(std::uint64_t sections, std::uint64_t confirmed_bytes) noexcept
+        : origin_(static_cast<unsigned>(current_origin)), sections_(sections), bytes_(confirmed_bytes),
+          begin_(sections ? utils::get_tsc() : 0)
+    {
+        if (origin_ >= origin_count) origin_ = 0;
+    }
+    ~BatchScope() noexcept
+    {
+        if (!sections_) return;
+        const auto end = utils::get_tsc();
+        auto& counter = counters[origin_];
+        counter.sections.fetch_add(sections_, std::memory_order_relaxed);
+        counter.confirmed_bytes.fetch_add(bytes_, std::memory_order_relaxed);
+        counter.duration_ticks.record(end >= begin_ ? end - begin_ : 0);
+    }
+    BatchScope(const BatchScope&) = delete;
+    BatchScope& operator=(const BatchScope&) = delete;
+};
+
+inline auto take() noexcept
+{
+    std::array<Counter::Sample, origin_count> result{};
+    for (unsigned i = 0; i < origin_count; ++i) result[i] = counters[i].take();
+    return result;
+}
+}
diff --git a/rpcs3/ios/IOSRecyclableImagePool.h b/rpcs3/ios/IOSRecyclableImagePool.h
new file mode 100644
index 0000000..65d78d3
--- /dev/null
+++ b/rpcs3/ios/IOSRecyclableImagePool.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdlib>
+#include <cstdint>
+#include <utility>
+#include <memory>
+
+
+namespace rpcs3::ios::recyclable_image_pool
+{
+// Preserve the pre-existing iOS recycling thresholds; these are neither an
+// active-texture budget nor a change to NeoSwap/driver allocation admission.
+inline constexpr std::uint64_t byte_limit = 256ull * 1024 * 1024;
+inline constexpr std::size_t item_limit = 256;
+
+// At most item_limit entries can be in a newly constructed iOS pool. Only
+// their already-retired unique_ptrs are detached here. A raw-pointer RAII
+// batch avoids allocating during memory pressure; unwritten slots are never
+// initialized, read or deleted. Its count-only common path does no heap work.
+template <typename Image>
+class retirement_batch
+{
+    std::array<Image*, item_limit> images;
+    std::size_t count = 0;
+public:
+    retirement_batch() noexcept = default;
+    retirement_batch(const retirement_batch&) = delete;
+    retirement_batch& operator=(const retirement_batch&) = delete;
+    ~retirement_batch() { clear(); }
+    void emplace_back(std::unique_ptr<Image>&& image) noexcept
+    {
+        if (count == images.size()) std::abort(); // broken pool invariant
+        images[count++] = image.release();
+    }
+    void clear() noexcept
+    {
+        while (count) delete images[--count];
+    }
+};
+
+// Caller owns the existing pool mutex. Entries are newest-first and have
+// already retired from the GPU. A caller-owned retirement batch keeps image
+// destruction out of the pool critical section. The bounded batch never allocates; no per-frame historical walk is needed.
+// incoming_bytes <= byte_limit is the caller's admission precondition.
+template <typename Pool, typename ByteCount, typename Retired>
+void trim_to_fit(Pool& pool, ByteCount& bytes, Retired& retired,
+    std::uint64_t incoming_bytes = 0, bool incoming_item = false)
+{
+    const auto allowed_bytes = byte_limit - incoming_bytes;
+    const auto allowed_items = item_limit - static_cast<std::size_t>(incoming_item);
+    while (!pool.empty() && (pool.size() > allowed_items ||
+        static_cast<std::uint64_t>(bytes) > allowed_bytes))
+    {
+        auto& oldest = pool.back();
+        const auto released_bytes = oldest.data->memory->size();
+        retired.emplace_back(std::move(oldest.data));
+        pool.pop_back();
+        bytes -= released_bytes;
+    }
+}
+}
