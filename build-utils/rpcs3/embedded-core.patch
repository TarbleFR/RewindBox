+		seed = seed * 1664525 + 1013904223;
+		if (!live.empty() && (seed & 3) == 0)
+		{
+			const usz slot = (seed >> 8) % live.size();
+			const arena_range range = live[slot];
+			assert(churn.release(range.offset, range.size));
+			for (usz i = range.offset; i < range.offset + range.size; ++i)
+			{
+				assert(occupied[i]);
+				occupied[i] = false;
+			}
+			live.erase(live.begin() + slot);
+		}
+		else
+		{
+			arena_range range;
+			const usz size = 1 + (seed >> 12) % 87;
+			const usz alignment = usz{1} << ((seed >> 24) % 7);
+			if ((seed & 4 ? churn.allocate_highest(size, alignment, range)
+			              : churn.allocate_lowest(size, alignment, range)))
+			{
+				assert(range.offset + range.size <= occupied.size());
+				for (usz i = range.offset; i < range.offset + range.size; ++i)
+				{
+					assert(!occupied[i]);
+					occupied[i] = true;
+				}
+				live.push_back(range);
+			}
+		}
+		usz free = 0;
+		usz longest = 0;
+		usz run = 0;
+		for (const bool used : occupied)
+		{
+			free += !used;
+			run = used ? 0 : run + 1;
+			longest = std::max(longest, run);
+		}
+		assert(churn.free_bytes() == free);
+		assert(churn.largest_free_bytes() == longest);
+	}
 	return 0;
 }
