+void report_renderer_causes(const rpcs3::ios::renderer_causality::Profile::Snapshot& captured,
+    u64 session, u64 window)
+{
+    ios_core_profiler.notice(
+        "COREPROF RENDERCAUSE session=%llu window=%llu captured=%u retained=%llu vertex_range=%llu "
+        "sampler_refresh=%llu sampler_cyclic_fast=%llu dropped=%llu contended=%llu capacity=8 "
+        "budgets=2:4:2 reasons=range:validity:coordinates:clamp:dimension:samples:format:cyclic "
+        "reason_counts=%llu:%llu:%llu:%llu:%llu:%llu:%llu:%llu "
+        "frame_scope=rsx_flip_index vertex_range_scope=legacy_key_divergence visual_error_proven=0",
+        session, window, captured.captured ? 1u : 0u, static_cast<u64>(captured.size),
+        captured.counts[0], captured.counts[1], captured.counts[2], captured.dropped, captured.contended,
+        captured.reasons[0], captured.reasons[1], captured.reasons[2], captured.reasons[3],
+        captured.reasons[4], captured.reasons[5], captured.reasons[6], captured.reasons[7]);
+    for (usz i = 0; i < captured.size; ++i)
+    {
+        const auto& event = captured.events[i];
+        if (event.kind == rpcs3::ios::renderer_causality::Kind::vertex_range)
+        {
+            ios_core_profiler.notice(
+                "COREPROF RENDERCAUSE_EVENT session=%llu window=%llu kind=vertex_range reasons=0x%x "
+                "monotonic_us=%llu frame=%llu draw=%u fragment_offset=0x%x vertex_start=0x%x "
+                "legacy_address=0x%x actual_address=0x%x bytes=%u draw_first=%u source_first=%u count=%u stride=%u "
+                "cache_hit=%u visual_error_proven=0",
+                event.session, window, event.reasons, event.monotonic_us, event.frame, event.draw,
+                event.fragment_offset, event.vertex_start, event.legacy_address, event.actual_address,
+                event.bytes, event.draw_first, event.source_first, event.count, event.stride, event.cache_hit ? 1u : 0u);
+            continue;
+        }
+        std::string before_coordinates, after_coordinates;
+        for (usz coordinate = 0; coordinate < event.before.coordinates.size(); ++coordinate)
+        {
+            fmt::append(before_coordinates, "%s%08x", coordinate ? ":" : "", event.before.coordinates[coordinate]);
+            fmt::append(after_coordinates, "%s%08x", coordinate ? ":" : "", event.after.coordinates[coordinate]);
+        }
+        ios_core_profiler.notice(
+            "COREPROF RENDERCAUSE_EVENT session=%llu window=%llu kind=%s reasons=0x%x monotonic_us=%llu "
+            "frame=%llu draw=%u fragment_offset=0x%x vertex_start=0x%x stage=%s slot=%u "
+            "old_resource=0x%x new_resource=0x%x state_tuple=valid:dimension:class:samples:features:remap:cyclic:clamp "
+            "before=%u:%u:%u:%u:%x:%x:%u:%u after=%u:%u:%u:%u:%x:%x:%u:%u "
+            "coord_encoding=float32_hex_scale3_bias3_clamp_min2_max2 before_coord=%s after_coord=%s",
+            event.session, window,
+            event.kind == rpcs3::ios::renderer_causality::Kind::sampler_refresh ? "sampler_refresh" : "sampler_cyclic_fast",
+            event.reasons, event.monotonic_us, event.frame, event.draw, event.fragment_offset, event.vertex_start,
+            event.vertex ? "vertex" : "fragment", event.slot, event.old_resource, event.new_resource,
+            event.before.valid ? 1u : 0u, event.before.dimension, event.before.format_class, static_cast<u32>(event.before.samples),
+            event.before.format_features, event.before.texel_remap_control, event.before.cyclic ? 1u : 0u, event.before.clamp ? 1u : 0u,
+            event.after.valid ? 1u : 0u, event.after.dimension, event.after.format_class, static_cast<u32>(event.after.samples),
+            event.after.format_features, event.after.texel_remap_control, event.after.cyclic ? 1u : 0u, event.after.clamp ? 1u : 0u,
+            before_coordinates, after_coordinates);
