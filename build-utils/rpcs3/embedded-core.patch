+}
diff --git a/rpcs3/ios/IOSGuestAccessEmulation.h b/rpcs3/ios/IOSGuestAccessEmulation.h
new file mode 100644
index 0000000..493d4d3
--- /dev/null
+++ b/rpcs3/ios/IOSGuestAccessEmulation.h
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_ZCULL_ASYNC_READS_630 (ios/IOSZcullOnDemand.h): a guest access to a page ZCULL holds
+// locked can be completed by the access violation handler instead of being retried, for the
+// memory that page still has final: the handler reads or writes the unprotected view and steps
+// over the instruction. Utilities/Thread.cpp decodes the instruction before the RSX handler runs
+// (decode_a64_mem_inst, the decoder of the RawSPU MMIO path, plus the integer pairs below, which
+// LLVM forms from two neighbouring guest loads) and completes it afterwards when the RSX handler
+// sets `emulate`. Everything else keeps the retry: atomics and SIMD, writeback forms, an unaligned
+// access, an access that crosses the page.
+namespace rpcs3::ios::guest_access
+{
+struct access
+{
+	std::uint32_t size = 0;  // bytes of the access (both registers of a pair), 0: not completable
+	bool emulate = false;    // set by the RSX handler: complete it, do not retry it
+};
+
+inline thread_local access t_access{};
+
+// REWINDBOX_GUEST_ACCESS_FP_LR_636: a register the handler may read or write through the context. Darwin's
+// thread state holds X0-X28 in __x[29]; X29 (FP) and X30 (LR) are separate fields, so GPR(context, 29/30)
+// would index past __x. An access naming either keeps the retry. 31 is XZR (data, index) or SP (base,
+// refused by its callers).
+constexpr bool context_register(std::uint32_t reg) noexcept
+{
+	return reg < 29 || reg == 31;
+}
+
+// The operands of a scalar load or store decode_a64_mem_inst() accepted, for the address the
+// instruction computes: the fault address alone says nothing about an access that starts below it.
+struct single_operands
+{
+	std::uint32_t rn = 31;
+	bool indexed = false;     // register offset
+	std::uint32_t rm = 31;
+	std::uint32_t option = 3; // 010 UXTW, 011 LSL, 110 SXTW, 111 SXTX
+	std::uint32_t shift = 0;
+	std::int64_t offset = 0;  // immediate forms
+};
+
+constexpr single_operands decode_single_operands(std::uint32_t inst) noexcept
+{
+	single_operands r{};
+	const std::uint32_t size = inst >> 30;
+	r.rn = (inst >> 5) & 31;
+
+	if ((inst & 0x3B000000u) == 0x39000000u)
+	{
+		r.offset = static_cast<std::int64_t>((inst >> 10) & 0xfff) << size; // unsigned immediate, scaled
+	}
+	else if ((inst & 0x3B204C00u) == 0x38204800u)
+	{
+		r.indexed = true;
+		r.rm = (inst >> 16) & 31;
+		r.option = (inst >> 13) & 7;
+		r.shift = ((inst >> 12) & 1) ? size : 0;
+	}
+	else
+	{
+		const std::int32_t imm9 = static_cast<std::int32_t>((inst >> 12) & 511); // unscaled
+		r.offset = imm9 >= 256 ? imm9 - 512 : imm9;
+	}
+
+	return r;
+}
+
+// The index of a register-offset form, from the value of Rm.
+constexpr std::uint64_t index_value(const single_operands& operands, std::uint64_t rm) noexcept
+{
+	switch (operands.option)
+	{
+	case 2: rm &= 0xffffffffu; break;
+	case 6: rm = static_cast<std::uint64_t>(static_cast<std::int64_t>(static_cast<std::int32_t>(rm))); break;
+	default: break;
+	}
+
+	return rm << operands.shift;
+}
+
+// LDP, LDPSW and STP of general registers, signed offset, no writeback.
+struct pair_access
+{
+	bool valid = false;
+	bool load = false;
+	bool sign_extend = false; // LDPSW
+	std::uint32_t element = 0; // bytes of one register
+	std::uint32_t rt = 0, rt2 = 0, rn = 0;
+	std::int32_t offset = 0;
+};
+
+constexpr pair_access decode_pair(std::uint32_t inst) noexcept
+{
+	pair_access r{};
+
+	// opc[31:30] 101 V[26]=0 010 L[22] imm7[21:15] Rt2[14:10] Rn[9:5] Rt[4:0]
+	if ((inst & 0x3F800000u) != 0x29000000u)
+	{
+		return r;
+	}
+
+	const std::uint32_t opc = inst >> 30;
+	const bool load = ((inst >> 22) & 1) != 0;
+
+	if (opc == 3 || (opc == 1 && !load))
+	{
+		return r; // reserved, STGP
+	}
+
+	r.load = load;
+	r.sign_extend = opc == 1;
+	r.element = opc == 2 ? 8 : 4;
+	r.rt = inst & 31;
+	r.rn = (inst >> 5) & 31;
+	r.rt2 = (inst >> 10) & 31;
+
+	const std::int32_t imm7 = static_cast<std::int32_t>((inst >> 15) & 127);
+	r.offset = (imm7 >= 64 ? imm7 - 128 : imm7) * static_cast<std::int32_t>(r.element);
+	r.valid = !(load && r.rt == r.rt2); // CONSTRAINED UNPREDICTABLE
+	return r;
+}
+
+// An aligned element of guest memory, one access, as the instruction would have made it.
+inline std::uint64_t read_element(const std::uint8_t* memory, std::uint32_t size) noexcept
+{
+	switch (size)
+	{
+	case 1: return __atomic_load_n(memory, __ATOMIC_RELAXED);
+	case 2: return __atomic_load_n(reinterpret_cast<const std::uint16_t*>(memory), __ATOMIC_RELAXED);
+	case 4: return __atomic_load_n(reinterpret_cast<const std::uint32_t*>(memory), __ATOMIC_RELAXED);
+	default: return __atomic_load_n(reinterpret_cast<const std::uint64_t*>(memory), __ATOMIC_RELAXED);
+	}
+}
+
+inline void write_element(std::uint8_t* memory, std::uint32_t size, std::uint64_t value) noexcept
+{
+	switch (size)
+	{
+	case 1: __atomic_store_n(memory, static_cast<std::uint8_t>(value), __ATOMIC_RELAXED); break;
+	case 2: __atomic_store_n(reinterpret_cast<std::uint16_t*>(memory), static_cast<std::uint16_t>(value), __ATOMIC_RELAXED); break;
+	case 4: __atomic_store_n(reinterpret_cast<std::uint32_t*>(memory), static_cast<std::uint32_t>(value), __ATOMIC_RELAXED); break;
+	default: __atomic_store_n(reinterpret_cast<std::uint64_t*>(memory), value, __ATOMIC_RELAXED); break;
+	}
+}
+}
diff --git a/rpcs3/ios/IOSInPassReadTransition.h b/rpcs3/ios/IOSInPassReadTransition.h
new file mode 100644
index 0000000..138df00
--- /dev/null
+++ b/rpcs3/ios/IOSInPassReadTransition.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_IN_PASS_READ_TRANSITION_655: Assassin's Creed, IPA 653 (Core 652) device log, gameplay at 24-29 FPS with
+// the GPU 70-78 % busy: 44-53 render passes begin per frame, 13-19 of them on the framebuffer the previous pass ended
+// on (COREPROF RPASS652). vk::change_image_layout ends 28-36 passes per frame, 4-11 of which the next draw begins
+// again on the same framebuffer: an image the next draw samples (a render target rendered earlier, a texture uploaded
+// earlier) changes to SHADER_READ_ONLY_OPTIMAL while the pass is open, and the transition ended the pass. On the Apple
+// GPU every restart stores every attachment of the pass to memory and loads it back.
+//
+// A transition to SHADER_READ_ONLY_OPTIMAL of an image that is not an attachment of the open pass is now recorded
+// inside the pass. Its writer (an earlier pass or copy) is in an earlier Metal encoder: the patched MoltenVK makes
+// the open render encoder wait for the barrier's stage fences, as the next encoder would have after a restart
+// (MVKCmdPipelineBarrier, build-utils/rpcs3/patches/moltenvk-1.4.2-deferred-cache.patch; without a residency set
+// Metal tracks the hazard itself). Kept only when:
+// - the title policy enables it (Automatic: Assassin's Creed) and the linked MoltenVK defines
+//   rbx_mvk_in_pass_read_barrier_waits() (weak reference, checked once per boot);
+// - the transition goes to SHADER_READ_ONLY_OPTIMAL from a color or depth attachment layout or a transfer layout,
+//   with the full access masks of the standard transition and no queue family transfer;
+// - the open pass was begun by the draw path, whose framebuffer attachments are known, and the image is none of them.
+// Anything else ends the pass exactly as before. Counted per window (COREPROF RPASS655).
+extern "C" __attribute__((weak)) int rbx_mvk_in_pass_read_barrier_waits(void);
+
+namespace rpcs3::ios::in_pass_read
+{
+// Resolved once per boot (title policy and the MoltenVK hook); read by the RSX thread.
+inline std::atomic<bool> enabled{false};
+
+inline bool moltenvk_waits_in_pass() noexcept
+{
+	return rbx_mvk_in_pass_read_barrier_waits != nullptr && rbx_mvk_in_pass_read_barrier_waits() >= 1;
+}
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> kept_color{0};       // kept open: COLOR_ATTACHMENT_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
