+	GAME_SETTING("experimental.native_half_registers", "Experimental", "GPU", "Native half-precision registers", "Computes the half-precision registers of PlayStation 3 pixel shaders (the RSX H registers) in native 16-bit floats, as the RSX does, instead of 32-bit floats clamped to the half range; every other precision rule stays as with High precision. The Apple GPU executes 16-bit float math at twice the rate. Automatic enables it for Assassin's Creed; Disabled restores 32-bit registers. Shaders are compiled again on the next boot.", kind::RPCS3_IOS_SETTING_CHOICE, g_cfg.ios_experimental.native_half_registers, 0, 0, 0),
+	GAME_SETTING("experimental.load_op_clear", "Experimental", "GPU", "Clear as render pass load", "When a render pass starts with a clear of its whole framebuffer, the GPU starts the pass cleared instead of loading the old image from memory and then drawing the clear over it. The image is the same. Automatic enables it for Assassin's Creed; Disabled restores the previous clears. Takes effect on the next boot.", kind::RPCS3_IOS_SETTING_CHOICE, g_cfg.ios_experimental.load_op_clear, 0, 0, 0),
