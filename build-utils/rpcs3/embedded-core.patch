+
+// Written to a temporary file, flushed to storage and renamed: a crash at any point
+// leaves the previous or the new records whole.
+bool write_mvk_canary(const std::vector<mvk_async_canary::record>& records)
+{
+	const std::string path = mvk_canary_path();
+	const std::string temp = path + ".tmp";
+	const std::string text = mvk_async_canary::serialize(records);
+	const int fd = ::open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+	if (fd < 0)
+	{
+		return false;
+	}
+
+	usz written = 0;
+	while (written < text.size())
+	{
+		const ssize_t count = ::write(fd, text.data() + written, text.size() - written);
+		if (count < 0 && errno == EINTR)
+		{
+			continue;
+		}
+
+		if (count <= 0)
+		{
+			::close(fd);
+			return false;
+		}
+
+		written += static_cast<usz>(count);
+	}
+
+	const bool synced = ::fsync(fd) == 0;
+	::close(fd);
+	if (!synced || ::rename(temp.c_str(), path.c_str()) != 0)
+	{
+		return false;
+	}
