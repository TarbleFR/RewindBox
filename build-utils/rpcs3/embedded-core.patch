+	void observe_freeze_episode(const thread_usage_sample& usage)
+	{
+		namespace episode = rpcs3::ios::freeze_episode;
+		const u64 session = m_profile_session.load(std::memory_order_relaxed);
+		const u64 now_us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+			sample_clock::now().time_since_epoch()).count());
+		if (session != m_freeze_session)
+		{
+			// A new boot: an episode of the previous one ends as stopped.
+			const auto stopped = m_freeze_episode.stop(now_us);
+			if (stopped.what != episode::event::none) emit_freeze_episode(stopped, m_freeze_session, {});
+			m_freeze_episode.reset();
+			m_freeze_session = session;
+		}
+
+		episode::tick sample;
+		sample.now_us = now_us;
+		sample.state = freeze_state(Emu.GetStatus(false));
+		sample.guest_flips = m_guest_frames.load(std::memory_order_acquire);
+		for (usz group = 0; group < core_group_count; ++group)
+		{
+			sample.busiest_cores = std::max(sample.busiest_cores, usage.cores[group]);
+		}
+
+		const auto result = m_freeze_episode.observe(sample);
+		if (result.what != episode::event::none)
+		{
+			std::vector<rpcs3::ios::profiler::thread_cores> rows;
+			for (const auto& row : usage.detail)
+			{
+				rpcs3::ios::profiler::accumulate_thread(rows, row.name, row.cores);
+			}
+			const std::string top = rpcs3::ios::profiler::format_top_list(rpcs3::ios::profiler::top_threads(std::move(rows), 1, 3));
+			emit_freeze_episode(result, session, top);
+		}
+		// The episode's dump is retried on later samples until it is taken (a busy
+		// idm lock or a state change makes the dump give up without logging).
+		// REWINDBOX_LIGHT_MEASUREMENT_627: no dump in a light run.
+		if (result.dump && !rpcs3::ios::get_experimental_policy().light_measurement &&
+			neostation_freeze_dump(result.reason, result.no_frames_s, result.begin_busiest_cores, result.episode))
+		{
+			m_freeze_episode.dump_taken(now_us);
+		}
+	}
