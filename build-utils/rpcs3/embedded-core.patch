+static bool spu_deferred_dispatch(spu_thread& spu, const spu_program& program)
+{
+	if (!rpcs3::spu::deferred_compile_enabled)
+	{
+		return false;
+	}
+
+	auto* const pool = g_fxo->try_get<spu_deferred_compiler>();
+
+	if (!pool)
+	{
+		return false;
+	}
+
+	spu_item* const item = spu.jit->get_runtime().add_empty(spu_program{program});
+
+	if (!item || item->data.entry_point != program.entry_point)
+	{
+		// A relocated duplicate publishes through its own inline compile.
+		return false;
+	}
+
+	const spu_function_t compiled = item->compiled.load();
+	auto decision = rpcs3::spu::classify_dispatch(true, compiled != nullptr,
+		item->llvm_compile_state.load(), item->deferred_queued != 0, item->deferred_inline != 0);
+
+	if (decision == rpcs3::spu::deferred_dispatch::enqueue_and_interpret)
+	{
+		if (!item->deferred_queued.exchange(1))
+		{
+			if (!pool->enqueue(item, utils::get_tsc()))
+			{
+				item->deferred_queued.release(0);
+				decision = rpcs3::spu::deferred_dispatch::compile_inline;
+			}
+		}
+		else
+		{
+			decision = rpcs3::spu::deferred_dispatch::interpret_pending;
+		}
+	}
+
+	rpcs3::ios::record_spu_deferred_dispatch(static_cast<u32>(decision));
+
+	switch (decision)
+	{
+	case rpcs3::spu::deferred_dispatch::compile_inline:
+	case rpcs3::spu::deferred_dispatch::count:
+		return false;
+	case rpcs3::spu::deferred_dispatch::run_compiled:
