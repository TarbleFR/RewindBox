diff --git a/rpcs3/ios/RPCS3IOSProfilerHelpers.h b/rpcs3/ios/RPCS3IOSProfilerHelpers.h
new file mode 100644
index 0000000..b6b0c69
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSProfilerHelpers.h
@@ -0,0 +1,342 @@
+#pragma once
+
+// NEOSTATION_BUILD487_DIAGNOSTICS_V1: pure, header-only helpers of the iOS Core
+// profiler (RPCS3IOSPerformance.cpp), the metrics getter (RPCS3IOS.cpp) and the
+// freeze dump (RPCS3IOSFreezeDump.cpp). This header has no RPCS3 dependency so
+// the arithmetic, the formatting and the trigger decisions can be compiled and
+// executed on a Linux host; the callers own every lock, atomic and log channel.
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rpcs3::ios::profiler
+{
+// Same order as core_group in RPCS3IOSPerformance.cpp: ppu, spu, rsx, jit, other.
+constexpr std::size_t thread_group_count = 5;
+constexpr std::size_t group_ppu = 0;
+constexpr std::size_t group_spu = 1;
+constexpr std::size_t group_rsx = 2;
+constexpr std::size_t group_jit = 3;
+constexpr std::size_t group_other = 4;
+
+// COREPROF top=<name>:<cores>,… carries the five busiest threads of the window;
+// names are bounded so the whole line stays under diagnostic_line_limit.
+constexpr std::size_t top_thread_count = 5;
+constexpr std::size_t top_thread_name_limit = 20;
+constexpr std::size_t diagnostic_line_limit = 1024;
+
+// FREEZE_DUMP: at most 64 lines per dump, at most one dump every 30 s.
+constexpr std::size_t freeze_dump_line_limit = 64;
+constexpr std::uint64_t freeze_dump_min_interval_us = 30'000'000;
+
+// RSX approximate load: upstream recomputes after 30 guest flips; Build 487 also
+// recomputes once a second so the value cannot freeze when the guest stops presenting.
+constexpr std::uint32_t rsx_load_window_frames = 30;
+constexpr std::uint64_t rsx_load_window_us = 1'000'000;
+
+// Transient compile workers (PPU module batches, SPU warmup) as opposed to the
+// permanent JIT threads ("SPUW.", "SPU LLVM", "RSX.W") that the jit group also holds.
+inline bool is_transient_compile_thread(std::string_view name) noexcept
+{
+	// JITLLVM.cpp creates a disposable "LLVM JIT" code-generation thread.
+	return name == "LLVM JIT" || name.starts_with("PPUW.") || name.starts_with("PPU Exec") ||
+		name.starts_with("PPU Symbol") || name.starts_with("SPU Worker");
+}
+
+// The single RSX puller thread; "RSX.W" pipeline compilers and "RSX Worker" are not it.
+inline bool is_rsx_main_thread(std::string_view name) noexcept
+{
+	return name == "rsx::thread";
+}
+
+struct thread_cores
+{
+	std::string name;
+	double cores = 0.0;
+};
+
+// Adds one sampled thread to the window accumulator (sum of instantaneous cores by name).
+inline void accumulate_thread(std::vector<thread_cores>& accumulated, std::string_view name, double cores)
+{
+	for (auto& entry : accumulated)
+	{
+		if (entry.name == name)
+		{
+			entry.cores += cores;
+			return;
+		}
+	}
+
+	accumulated.push_back({std::string(name), cores});
+}
+
+// Averages the accumulator over `samples` and keeps the `count` busiest threads, highest first.
+inline std::vector<thread_cores> top_threads(std::vector<thread_cores> accumulated, std::uint64_t samples, std::size_t count = top_thread_count)
+{
+	if (!samples)
+	{
+		return {};
+	}
+
+	for (auto& entry : accumulated)
+	{
+		entry.cores /= static_cast<double>(samples);
+	}
+
+	std::stable_sort(accumulated.begin(), accumulated.end(), [](const thread_cores& a, const thread_cores& b)
+	{
+		return a.cores > b.cores;
+	});
+
+	if (accumulated.size() > count)
+	{
+		accumulated.resize(count);
+	}
+
+	return accumulated;
+}
+
+// A value token for key=value diagnostic lines: separators become '_', empty becomes "-".
+inline std::string sanitize_token(std::string_view text, std::size_t limit = 0)
+{
+	std::string out;
+	out.reserve(limit ? std::min(limit, text.size()) : text.size());
+
+	for (const char c : text)
+	{
+		if (limit && out.size() >= limit)
+		{
+			break;
+		}
+
+		const bool separator = c == ' ' || c == '\t' || c == '\n' || c == '\r' ||
+			c == ',' || c == ':' || c == '=' || c == '"';
+		out += separator ? '_' : c;
+	}
+
+	if (out.empty())
+	{
+		out = "-";
+	}
+
+	return out;
+}
+
+// "name:cores,name:cores" (cores with three decimals), "-" when empty.
+inline std::string format_top_list(const std::vector<thread_cores>& top)
+{
+	std::string out;
+
+	for (const auto& entry : top)
+	{
+		if (!out.empty())
+		{
+			out += ',';
+		}
+
+		out += sanitize_token(entry.name, top_thread_name_limit);
+		char cores[32];
+		std::snprintf(cores, sizeof(cores), ":%.3f", entry.cores);
+		out += cores;
+	}
+
+	if (out.empty())
+	{
+		out = "-";
+	}
+
+	return out;
+}
+
+// COREPROF per-frame fields: CPU ms per presented frame of a group averaging `cores`
+// over a `window_ms` window; 0 when no frame was presented (cores= fields carry the load).
+inline double per_frame_ms(double cores, double window_ms, std::uint64_t frames) noexcept
+{
+	return frames ? cores * window_ms / static_cast<double>(frames) : 0.0;
+}
+
+inline double ticks_to_ms(std::uint64_t ticks, std::uint64_t frequency) noexcept
+{
+	return frequency ? static_cast<double>(ticks) * 1000.0 / static_cast<double>(frequency) : 0.0;
+}
+
+inline double ticks_to_us(std::uint64_t ticks, std::uint64_t frequency) noexcept
+{
+	return frequency ? static_cast<double>(ticks) * 1'000'000.0 / static_cast<double>(frequency) : 0.0;
+}
+
+inline double ticks_per_frame_ms(std::uint64_t ticks, std::uint64_t frequency, std::uint64_t frames) noexcept
+{
+	return frames ? ticks_to_ms(ticks, frequency) / static_cast<double>(frames) : 0.0;
+}
+
+// rsx::thread::get_load(): upstream condition (first call or > 30 guest flips) plus the
+// Build 487 time basis (>= 1 s since the last recomputation).
+inline bool should_recompute_rsx_load(std::uint64_t last_update_timestamp, std::uint32_t sampled_frames, std::uint64_t elapsed_us) noexcept
+{
+	return !last_update_timestamp || sampled_frames > rsx_load_window_frames || elapsed_us >= rsx_load_window_us;
+}
+
+// Upstream formula; 0 when nothing elapsed (first call) instead of the former ~100 %.
+inline std::uint32_t rsx_load_percent(std::uint64_t elapsed_us, std::uint64_t idle_us) noexcept
+{
+	return elapsed_us > idle_us ? static_cast<std::uint32_t>((elapsed_us - idle_us) * 100 / elapsed_us) : 0u;
+}
+
+// Busy share of the RSX puller over the load windows closed during one profile
+// window; -1 when no window closed (the puller made no loop progress in 5 s).
+inline double rsx_fifo_busy_percent(std::uint64_t window_elapsed_us, std::uint64_t window_idle_us) noexcept
+{
+	if (!window_elapsed_us)
+	{
+		return -1.0;
+	}
+
+	const std::uint64_t idle = std::min(window_idle_us, window_elapsed_us);
+	return static_cast<double>(window_elapsed_us - idle) * 100.0 / static_cast<double>(window_elapsed_us);
+}
+
+// RANGELOCKPROF max_hold_us: non-atomic model of the registry's update_max.
+inline void update_maximum(std::uint64_t& target, std::uint64_t value) noexcept
+{
+	if (value > target)
+	{
+		target = value;
+	}
+}
+
+// Freeze trigger (reporter, every 5 s window): the dump is requested only while the
+// emulator runs, no frame was presented for more than 3 s and one thread group still
+// averages more than 0.5 core (a quiet guest waiting on input is not a freeze).
+struct freeze_trigger_policy
+{
+	double min_seconds_without_frames = 3.0;
+	double min_group_cores = 0.5;
+};
+
+struct freeze_trigger_decision
+{
+	bool dump = false;
+	std::size_t busiest_group = 0;
+	double busiest_cores = 0.0;
+};
+
+inline freeze_trigger_decision evaluate_freeze_trigger(bool emulator_running, double seconds_without_frames,
+	const std::array<double, thread_group_count>& group_cores, freeze_trigger_policy policy = {}) noexcept
+{
+	freeze_trigger_decision decision{};
+
+	for (std::size_t group = 0; group < thread_group_count; ++group)
+	{
+		if (group_cores[group] > decision.busiest_cores)
+		{
+			decision.busiest_cores = group_cores[group];
+			decision.busiest_group = group;
+		}
+	}
+
+	decision.dump = emulator_running &&
+		seconds_without_frames > policy.min_seconds_without_frames &&
+		decision.busiest_cores > policy.min_group_cores;
+	return decision;
+}
+
+// Rate limit of the dump: accepts when no dump was taken yet or at least
+// min_interval_us elapsed since the last accepted one; records the accepted time.
+inline bool accept_freeze_dump(std::uint64_t now_us, std::uint64_t& last_accepted_us, std::uint64_t min_interval_us = freeze_dump_min_interval_us) noexcept
+{
+	if (last_accepted_us && now_us >= last_accepted_us && now_us - last_accepted_us < min_interval_us)
+	{
+		return false;
+	}
+
+	last_accepted_us = now_us ? now_us : 1;
+	return true;
+}
+
+// Line budget of one dump: `reserved_lines` (header, rsx, footer) are always
+// emitted; SPU threads come first, PPU threads take the rest, the remainder is counted.
+struct freeze_dump_plan
+{
+	std::size_t spu_lines = 0;
+	std::size_t ppu_lines = 0;
+	std::size_t truncated = 0;
+};
+
+inline freeze_dump_plan plan_freeze_dump(std::size_t spu_threads, std::size_t ppu_threads,
+	std::size_t reserved_lines = 3, std::size_t line_limit = freeze_dump_line_limit) noexcept
+{
+	freeze_dump_plan plan{};
+	const std::size_t budget = line_limit > reserved_lines ? line_limit - reserved_lines : 0;
+	plan.spu_lines = std::min(spu_threads, budget);
+	plan.ppu_lines = std::min(ppu_threads, budget - plan.spu_lines);
+	plan.truncated = (spu_threads - plan.spu_lines) + (ppu_threads - plan.ppu_lines);
+	return plan;
+}
+
+inline std::string& bound_line(std::string& line, std::size_t limit = diagnostic_line_limit)
+{
+	if (line.size() > limit)
+	{
+		line.resize(limit);
+	}
+
+	return line;
+}
+
+// Metrics ABI: an older host passes the 48-byte Build 258 struct and receives exactly
+// that prefix; a Build 487 host passes the full struct and receives every field. A
+// struct smaller than the legacy one is refused (0).
+inline std::size_t metrics_copy_size(std::size_t caller_size, std::size_t legacy_size, std::size_t full_size) noexcept
+{
+	if (caller_size < legacy_size)
+	{
+		return 0;
+	}
+
+	return caller_size >= full_size ? full_size : legacy_size;
+}
+
+// utils::rational_mul<u64>(value, numerator, denominator) without the RPCS3 header.
+inline std::uint64_t rational_mul_u64(std::uint64_t value, std::uint64_t numerator, std::uint64_t denominator) noexcept
+{
+	return value / denominator * numerator + (value % denominator) * numerator / denominator;
+}
+
+// The permille counters of rpcs3_ios_get_boot_progress (same maths, same inputs), so
+// the metrics struct reports the same completed/total pair as the dedicated getter.
+struct boot_progress_permille
+{
+	std::uint32_t completed = 0;
+	std::uint32_t total = 0;
+};
+
+inline boot_progress_permille compute_boot_progress_permille(std::uint32_t modules_total, std::uint32_t modules_done,
+	std::uint64_t files_total, std::uint64_t file_bits_total, std::uint64_t file_bits_known) noexcept
+{
+	boot_progress_permille result{};
+
+	if (!modules_total)
+	{
+		return result;
+	}
+
+	const bool use_bits = file_bits_known && file_bits_total;
+	const std::uint64_t known_files = use_bits ? file_bits_known : files_total;
+	const std::uint64_t total_units = rational_mul_u64(
+		std::max<std::uint64_t>(modules_total, 1),
+		std::max<std::uint64_t>(use_bits ? file_bits_total : files_total, 1),
+		std::max<std::uint64_t>(known_files, 1));
+	result.total = 1000;
+	result.completed = static_cast<std::uint32_t>(modules_done >= total_units
+		? 1000
+		: rational_mul_u64(modules_done, 1000, total_units));
+	return result;
+}
+}
