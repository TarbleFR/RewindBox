+// x86 retains its aligned non-temporal store; ARM's coherent normal store
+// retains the semantics used by the former compatibility implementation.
+inline void gv_stream(void* destination, const v128& a)
+{
+#if defined(ARCH_X64)
+	_mm_stream_si128(static_cast<__m128i*>(destination), a);
+#elif defined(ARCH_ARM64)
+	vst1q_u8(static_cast<u8*>(destination), a);
+#endif
+}
