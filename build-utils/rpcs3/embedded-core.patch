diff --git a/rpcs3/Emu/Cell/SPUDeferredCompilePolicy.h b/rpcs3/Emu/Cell/SPUDeferredCompilePolicy.h
new file mode 100644
index 0000000..a994d9b
--- /dev/null
+++ b/rpcs3/Emu/Cell/SPUDeferredCompilePolicy.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <cstdint>
+
+// NEOSTATION_BUILD435_SPU_DEFERRED_COMPILE_V1: the God of War III heavy regime
+// began with 635 SPU LLVM compilations in 9 s, each executed on the SPU thread
+// that missed the dispatcher. That thread stalled for the whole compilation,
+// the PPU threads then waited on it and one frame lasted 6.2 s (Build 411
+// trace). The dispatcher now hands a missed program to a small worker pool and
+// runs it through the existing legacy interpreter until the module is
+// published, so the SPU keeps making progress. The decisions are pure so a
+// host test can execute them; the pool itself lives in SPUCommonRecompiler.cpp.
+namespace rpcs3::spu
+{
+// spu_item::llvm_compile_state values owned by spu_llvm_recompiler::compile().
+inline constexpr std::uint32_t compile_state_unclaimed = 0;
+inline constexpr std::uint32_t compile_state_compiling = 1;
+inline constexpr std::uint32_t compile_state_complete = 2;
+inline constexpr std::uint32_t compile_state_failed = 3;
+
+// Compile-time switch; no setting or UI is involved. Off since Build 436: with
+// it, God of War III froze about 5 s after boot on the iPhone (3 of 3 sessions,
+// 10 October 2026: frames kept coming, PPU/SPU/RSX idle, memory flat) and another
+// title stopped on SPU STOP 0x0 after interpreted hand-offs. The Build 434 inline
+// compilation is used again; the pool and its policies stay for a later review.
+inline constexpr bool deferred_compile_enabled = false;
+
+// Requests waiting or compiling before a miss compiles inline again, which
+// bounds the backlog memory and the time a program can stay interpreted.
+inline constexpr std::uint32_t deferred_queue_limit = 256;
+
+enum class deferred_dispatch : std::uint8_t
+{
+	run_compiled = 0,      // the module is published: jump to it
+	enqueue_and_interpret, // first miss: queue the program, interpret meanwhile
+	interpret_pending,     // queued or compiling elsewhere: interpret meanwhile
+	interpret_failed,      // the module cannot be built: interpret its range
+	compile_inline,        // deferral unavailable, refused or saturated: Build 434 path
+	count,
+};
+
+constexpr deferred_dispatch classify_dispatch(bool enabled, bool has_compiled,
+	std::uint32_t compile_state, bool already_queued, bool inline_only) noexcept
+{
+	if (has_compiled)
+	{
+		return deferred_dispatch::run_compiled;
+	}
+
+	if (!enabled || inline_only)
+	{
+		return deferred_dispatch::compile_inline;
+	}
+
+	switch (compile_state)
+	{
+	case compile_state_failed:
+		return deferred_dispatch::interpret_failed;
+	case compile_state_compiling:
+		return deferred_dispatch::interpret_pending;
+	case compile_state_complete:
+		// Published, pointer not visible yet: compile() returns it at once.
+		return deferred_dispatch::compile_inline;
+	default:
+		return already_queued ? deferred_dispatch::interpret_pending : deferred_dispatch::enqueue_and_interpret;
+	}
+}
+
+// The interpreter leaves a deferred program only at a taken branch, where the
+// recompiled module can take over: at its entry point, or anywhere after a
+// quantum of branches so a loop inside the program does not stay interpreted
+// (the dispatcher then compiles a program from that pc).
+inline constexpr std::uint64_t interpreter_handoff_quantum_branches = 4096;
+
+constexpr bool interpreter_should_exit(std::uint32_t compile_state, bool at_entry_point,
+	std::uint64_t branches_since_published) noexcept
+{
+	if (compile_state != compile_state_complete)
+	{
+		return false;
+	}
+
+	return at_entry_point || branches_since_published >= interpreter_handoff_quantum_branches;
+}
+
+// Two workers on the 6-core phones; the SPU, PPU and RSX threads keep the rest.
+constexpr std::uint32_t deferred_worker_count(std::uint32_t hardware_threads) noexcept
+{
+	return hardware_threads >= 8 ? 3 : hardware_threads >= 4 ? 2 : 1;
+}
+
+// Hottest request first (dispatcher hits while waiting), oldest among equals.
+constexpr bool prefer_request(std::uint64_t hits_a, std::uint64_t sequence_a,
+	std::uint64_t hits_b, std::uint64_t sequence_b) noexcept
+{
+	return hits_a != hits_b ? hits_a > hits_b : sequence_a < sequence_b;
+}
+}
