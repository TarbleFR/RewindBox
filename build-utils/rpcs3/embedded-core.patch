+	// SPUThread.cpp (cntvct_el0 ticks). The busy_wait scale is installed on
+	// utils::arm_timer_scale by apply_spu_spin_timing_policy().
+	bool spu_spin_calibrated = false;
+	u64 spu_spin_cntfrq = 0;      // cntfrq_el0 as read at resolution, 0 when unknown
+	u64 spu_spin_timer_scale = 1; // utils::arm_timer_scale after resolution
+	levers::spu_spin_thresholds spu_spin{};
+	// L3 "RSX FIFO Idle Wait" = Bounded sleep (exclusive with fifo_idle_wfe).
+	bool fifo_idle_bounded_sleep = false;
+	// L5 "SPU Object Cache Retained Keys": cache policy, no gameplay effect.
+	u32 spu_object_cache_retained_keys = 2;
+	// L9 "SPU Warmup Scope" = All titles with metadata.
+	bool spu_warmup_all_titles = false;
 };
 
