+void report_signal_causes(const rpcs3::ios::signal_trace::summary_result& current,
+    rpcs3::ios::signal_trace::snapshot_result* captured, u64 session, u64 window, u64 now_us)
+{
+    const auto& watch = current.watch;
+    const auto& totals = current.totals;
+    ios_core_profiler.notice(
+        "COREPROF SIGNALCAUSE session=%llu window=%llu enabled=%u watch_valid=%u watch_active=%u watch_stalled=%u "
+        "acquire=%llu address=0x%x expected=0x%x observed=0x%x watch_since_us=%llu acquire_start_us=%llu "
+        "watch_published_us=%llu report_us=%llu clock=get_system_time_us "
+        "events_published=%llu events_dropped=%llu history_overwritten=%llu stale_session_dropped=%llu "
+        "producer_published=%llu producer_dropped=%llu producer_replaced=%llu read_busy=%llu watch_changes=%llu "
+        "stalls_total=%llu stall_latched=%llu stall_overwritten=%llu stall_dropped=%llu dump=%u "
+        "history_capacity=64 producer_capacity=32 counters_scope=process dump_min_period_s=30 "
+        "coverage=rsx_cpu_label_and_spu_put_copy excluded=ppu_direct_gpu_commit_reservation_store dma_value_sampled=0 "
+        "kinds=1_acquire:2_stalled:3_resolved:4_aborted:5_release_requested:6_cpu_commit:7_gpu_deferred:8_dma_commit:9_list_commit "
+        "absence_proves_no_write=0",
+        session, window, current.enabled ? 1u : 0u, watch.session == session && watch.address ? 1u : 0u,
+        watch.active ? 1u : 0u, watch.stalled ? 1u : 0u, watch.acquire_sequence, watch.address, watch.expected, watch.observed,
+        watch.watch_since_us, watch.acquire_start_us, watch.published_us, now_us,
+        totals.events_published, totals.events_dropped, totals.history_overwritten, totals.stale_session_dropped,
+        totals.producer_published, totals.producer_dropped, totals.producer_replaced, totals.read_busy, totals.watch_changes,
+        totals.stalls_total, totals.stall_latched, totals.stall_overwritten, totals.stall_dropped, captured ? 1u : 0u);
+    if (!captured) return;
+    std::sort(captured->events.begin(), captured->events.begin() + captured->event_count,
+        [](const auto& a, const auto& b) { return a.sequence < b.sequence; });
+    const auto& blocked = captured->watch;
+    ios_core_profiler.notice(
+        "COREPROF SIGNALCAUSE_EVENT session=%llu window=%llu kind=stall_snapshot acquire=%llu address=0x%x "
+        "expected=0x%x observed=0x%x begin_us=%llu captured_us=%llu report_us=%llu events=%llu producers=%llu "
+        "retained_after_resolution=1 snapshot_scope=owner_published_copies snapshot_globally_atomic=0",
+        captured->session, window, blocked.acquire_sequence, blocked.address, blocked.expected, blocked.observed,
+        blocked.acquire_start_us, blocked.published_us, now_us,
+        static_cast<u64>(captured->event_count), static_cast<u64>(captured->producer_count));
+    for (usz i = 0; i < captured->event_count; ++i)
+    {
+        const auto& event = captured->events[i];
+        ios_core_profiler.notice(
+            "COREPROF SIGNALCAUSE_EVENT session=%llu window=%llu dump_acquire=%llu sequence=%llu kind=%u "
+            "acquire=%llu timestamp_us=%llu address=0x%x expected=0x%x value=0x%x value_valid=%u value_is_written_argument=%u "
+            "producer_id=0x%x pc=0x%x write_address=0x%x write_size=%u command=0x%x",
+            event.session, window, blocked.acquire_sequence, event.sequence, static_cast<u32>(event.kind),
+            event.acquire_sequence, event.timestamp_us, event.address, event.expected, event.value,
+            event.value_valid ? 1u : 0u, event.value_is_written_argument ? 1u : 0u, event.producer_id, event.pc,
+            event.write_address, event.write_size, event.command);
+    }
+    for (usz i = 0; i < captured->producer_count; ++i)
+    {
+        const auto& producer = captured->producers[i];
+        if (producer.phase != rpcs3::ios::signal_trace::producer_phase::mfc_blocked) continue;
+        std::string queue;
+        for (usz entry = 0; entry < std::min<usz>(producer.size, producer.queue.size()); ++entry)
+        {
+            const auto& command = producer.queue[entry];
+            fmt::append(queue, "%s%x:%u:%x:%x:%u", entry ? "," : "", command.cmd,
+                command.tag, command.lsa, command.eal, command.size);
+        }
+        ios_core_profiler.notice(
+            "COREPROF SIGNALCAUSE_PRODUCER session=%llu window=%llu dump_acquire=%llu serial=%llu "
+            "phase=mfc_blocked producer_id=0x%x pc=0x%x return_pc=0x%x published_us=%llu snapshot_age_at_report_us=%llu "
+            "blocked_since_us=%llu last_queue_progress_us=%llu mfc_size=%u barrier=0x%x fence=0x%x stall_mask=0x%x "
+            "tag_mask=0x%x tag_update=%u event_bits=0x%x event_mask=0x%x event_count=%u event_waiting=%u irq_enabled=%u "
+            "snr1_count=%u snr2_count=%u command_tuple=cmd:tag:lsa:ea:size unaccepted=%x:%u:%x:%x:%u queue=%s "
+            "scope=state_at_publication_not_live_at_report queue_progress_scope=size_decrease",
+            producer.session, window, blocked.acquire_sequence, producer.serial, producer.id, producer.pc, producer.return_pc,
+            producer.published_us, now_us >= producer.published_us ? now_us - producer.published_us : 0,
+            producer.blocked_since_us, producer.last_progress_us, producer.size,
+            producer.barrier, producer.fence, producer.stall_mask, producer.tag_mask, producer.tag_update,
+            producer.event_bits, producer.event_mask, producer.event_count, producer.event_waiting,
+            producer.interrupts_enabled, producer.snr1_count, producer.snr2_count,
+            producer.unaccepted.cmd, producer.unaccepted.tag, producer.unaccepted.lsa,
+            producer.unaccepted.eal, producer.unaccepted.size, queue.empty() ? "none" : queue);
+    }
+}
