+				result.ticks[which] = total_ticks[which].load(std::memory_order_relaxed);
+				result.max_ticks[which] = window_max_ticks[which].load(std::memory_order_relaxed);
+				result.bytes[which] = total_bytes[which].load(std::memory_order_relaxed);
+			}
