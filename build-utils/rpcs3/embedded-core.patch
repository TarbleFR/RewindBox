+	// REWINDBOX_FREEZE_EPISODE_621 (RPCS3IOSFreezeEpisode.h), sampler thread only.
+	static rpcs3::ios::freeze_episode::emu freeze_state(system_state state) noexcept
+	{
+		using rpcs3::ios::freeze_episode::emu;
+		switch (state)
+		{
+		case system_state::running: return emu::running;
+		case system_state::paused: return emu::paused;
+		case system_state::frozen: return emu::frozen;
+		case system_state::stopping:
+		case system_state::stopped: return emu::stopped;
+		default: return emu::loading;
+		}
+	}
