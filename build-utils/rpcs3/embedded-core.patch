@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <limits>
+namespace jit_memory {
+inline std::atomic<unsigned> active{0}, peak_active{0};
+inline std::atomic<std::uint64_t> samples{0}, footprint_peak{0}, batch_peak{0}, latest_footprint{0};
+inline std::atomic<std::uint64_t> headroom_min{UINT64_MAX};
+inline std::atomic<std::uint64_t> texture_hash_bytes{0}, texture_hash_ticks{0};
+inline std::atomic<std::uint64_t> vma_block_bytes{0}, vma_allocated{0}, vma_unused{0};
+inline std::atomic<std::uint64_t> cache_index_hits{0}, cache_buffer_hits{0};
+inline std::atomic<void(*)()> sample_hook{nullptr};
+inline void maximum(std::atomic<std::uint64_t>& value, std::uint64_t sample) {
+    auto prior = value.load(std::memory_order_relaxed);
+    while (prior < sample && !value.compare_exchange_weak(prior, sample, std::memory_order_relaxed)) {}
+}
+inline void sample() { if (auto hook = sample_hook.load(std::memory_order_relaxed)) hook(); }
+}
diff --git a/Utilities/JITMinimalObject.h b/Utilities/JITMinimalObject.h
new file mode 100644
index 0000000..1ee8976
--- /dev/null
+++ b/Utilities/JITMinimalObject.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <llvm/ExecutionEngine/ExecutionEngine.h>
+#include <llvm/Object/ObjectFile.h>
+#include <llvm/Support/MemoryBuffer.h>
+#include <llvm/Target/TargetMachine.h>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+
+// Research path: no IR bodies. Bind only explicit symbolic host references,
+// validated before mutating the engine. On a later LLVM fatal error the caller
+// must discard the engine, just as try_add_cached does. Production SPU keeps
+// its established IR/patchpoint path until real-title binding coverage exists.
+namespace jit_minimal_object {
+inline bool add(llvm::ExecutionEngine& engine, std::unique_ptr<llvm::MemoryBuffer>& buffer,
+    const std::string& entry, const std::unordered_map<std::string, std::uint64_t>& bindings,
+    std::string& error)
+{
+    if (!buffer) { error = "missing_object"; return false; }
+    auto object = llvm::object::ObjectFile::createObjectFile(buffer->getMemBufferRef());
+    if (!object) { llvm::consumeError(object.takeError()); error = "invalid_object"; return false; }
+    if ((*object)->getArch() != engine.getTargetMachine()->getTargetTriple().getArch()) {
+        error = "foreign_architecture"; return false;
+    }
+    bool found_entry = false;
+    for (const auto& symbol : (*object)->symbols()) {
+        auto name = symbol.getName(); auto flags = symbol.getFlags();
+        if (!name || !flags) {
+            if (!name) llvm::consumeError(name.takeError());
+            if (!flags) llvm::consumeError(flags.takeError());
+            error = "invalid_symbol"; return false;
+        }
+        if ((*flags & llvm::object::SymbolRef::SF_Absolute) && (*flags & llvm::object::SymbolRef::SF_Global)) { error = "absolute_symbol"; return false; }
+        if ((*flags & llvm::object::SymbolRef::SF_Undefined) && !name->empty()) {
+            const auto found = bindings.find(name->str());
+            if (found == bindings.end() || !found->second) { error = "unbound_symbol:" + name->str(); return false; }
+        } else if (*name == entry) found_entry = true;
+    }
+    if (!found_entry) { error = "missing_entry"; return false; }
+    for (const auto& [name, address] : bindings) engine.updateGlobalMapping(name, address);
+    engine.addObjectFile(llvm::object::OwningBinary<llvm::object::ObjectFile>(std::move(*object), std::move(buffer)));
+    return true;
+}
+}
diff --git a/Utilities/JITObjectBuffer.h b/Utilities/JITObjectBuffer.h
new file mode 100644
index 0000000..531d6e6
--- /dev/null
+++ b/Utilities/JITObjectBuffer.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <zlib.h>
+
+// The object writer produces one gzip member. Decode into the final owner's
+// buffer, with bounded compressed/decompressed sizes and mandatory CRC/ISIZE.
+// ReadAt reads bytes from the same open file, never a second path lookup.
+namespace jit_object_buffer
+{
+inline constexpr std::size_t maximum_object_bytes = 256 * 1024 * 1024;
+inline constexpr std::size_t input_chunk_bytes = 64 * 1024;
+
+template <class ReadAt>
+std::size_t gzip_size(std::uint64_t file_size, ReadAt read)
+{
+    if (file_size < 18 || file_size > maximum_object_bytes) return 0;
+    std::array<unsigned char, 4> footer{};
+    if (read(file_size - 4, footer.data(), footer.size()) != footer.size()) return 0;
+    const auto size = std::uint32_t(footer[0]) | (std::uint32_t(footer[1]) << 8) |
+        (std::uint32_t(footer[2]) << 16) | (std::uint32_t(footer[3]) << 24);
+    return size && size <= maximum_object_bytes ? size : 0;
+}
+
+template <class ReadAt>
+bool inflate(std::uint64_t file_size, ReadAt read, void* output, std::size_t output_size)
+{
+    if (!output || !output_size || output_size > maximum_object_bytes ||
+        file_size < 18 || file_size > maximum_object_bytes) return false;
+    z_stream stream{};
+    if (inflateInit2(&stream, 15 + 16) != Z_OK) return false;
+    struct cleanup { z_stream& stream; ~cleanup() { inflateEnd(&stream); } } guard{stream};
+    std::array<unsigned char, input_chunk_bytes> input;
+    unsigned char overflow = 0;
+    stream.next_out = static_cast<unsigned char*>(output);
+    stream.avail_out = static_cast<uInt>(output_size);
+    std::uint64_t offset = 0;
+    for (;;)
+    {
+        if (!stream.avail_in && offset < file_size)
+        {
+            const auto requested = static_cast<std::size_t>(std::min<std::uint64_t>(input.size(), file_size - offset));
+            const auto got = read(offset, input.data(), requested);
+            if (!got || got > requested) return false;
+            offset += got;
+            stream.next_in = input.data();
+            stream.avail_in = static_cast<uInt>(got);
+        }
+        if (!stream.avail_out)
+        {
+            // Permit zlib to consume a trailer after filling the exact output.
+            stream.next_out = &overflow;
+            stream.avail_out = 1;
+        }
+        const auto before_in = stream.total_in;
+        const auto before_out = stream.total_out;
+        const int status = ::inflate(&stream, Z_NO_FLUSH);
+        if (stream.total_out > output_size) return false;
+        if (status == Z_STREAM_END)
+            return stream.total_out == output_size && stream.total_in == file_size;
+        if (status != Z_OK || (stream.total_in == before_in && stream.total_out == before_out)) return false;
+    }
+}
+}
