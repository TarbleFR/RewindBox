diff --git a/rpcs3/ios/NeoSwapRelay.h b/rpcs3/ios/NeoSwapRelay.h
new file mode 100644
index 0000000..7c8d616
--- /dev/null
+++ b/rpcs3/ios/NeoSwapRelay.h
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: MIT
+#ifndef NEOSTATION_NEOSWAP_RELAY_H
+#define NEOSTATION_NEOSWAP_RELAY_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Separate ABI: does not change NeoSwapAPI v1 or its allocation ownership.
+ * A token owns one backing interval. Every map of that token aliases the SAME
+ * bytes. Capacity is retained VM-object capacity, never resident physical RAM.
+ * All calls require a normal thread. Quiesce every guest/CPU/GPU user before
+ * unmap/release; these operations do not wait for emulator work to complete.
+ */
+enum { NEOSWAP_RELAY_ABI = 1, NEOSWAP_RELAY_ALIGNMENT = 65536 };
+enum NeoSwapRelayProtection {
+    NEOSWAP_RELAY_NONE = 0, NEOSWAP_RELAY_READ = 1, NEOSWAP_RELAY_READ_WRITE = 3
+};
+enum NeoSwapRelayResult {
+    NEOSWAP_RELAY_OK = 0, NEOSWAP_RELAY_DISABLED = -1,
+    NEOSWAP_RELAY_INVALID = -2, NEOSWAP_RELAY_QUOTA = -3,
+    NEOSWAP_RELAY_MAPPING = -4, NEOSWAP_RELAY_BUSY = -5,
+    NEOSWAP_RELAY_UNKNOWN = -6, NEOSWAP_RELAY_PRESSURE = -7,
+    NEOSWAP_RELAY_LIMIT = -8, NEOSWAP_RELAY_CLEANUP = -9
+};
+typedef struct NeoSwapRelayStats {
+    uint32_t struct_size, abi_version;
+    uint64_t capacity_bytes, retained_capacity_bytes, live_bytes, peak_live_bytes;
+    uint64_t object_count, alias_count, mapped_alias_bytes, entry_count;
+    uint64_t rejection_count, os_error_count, pending_cleanup_entries, retiring_object_count;
+    uint64_t quarantined_fixed_alias_count;
+    uint32_t enabled_owner_mask, pressure_raised;
+    int32_t last_result, last_os_error;
+} NeoSwapRelayStats;
+typedef struct NeoSwapRelayAPI {
+    uint32_t struct_size, abi_version;
+    int (*create)(uint32_t owner, uint64_t bytes, uint64_t* token);
+    /* A non-null target MUST be a caller-owned reserved guest range. Existing
+     * guest users must be quiesced. Failed maps leave that reservation intact.
+     * Null requests a new, 64-KiB-aligned alias. No executable mapping exists.
+     */
+    int (*map)(uint64_t token, void* target, uint32_t protection, void** mapped);
+    /* A fixed alias is atomically replaced with a PROT_NONE reservation;
+     * an anywhere alias is deallocated. Failure retains ownership and mapping.
+     */
+    int (*unmap)(uint64_t token, void* address);
+    /* BUSY while any aliases remain. Scrub failure retains the token for retry;
+     * no error permits reuse of the backing interval or an ordinary free().
+     */
+    int (*release)(uint64_t token);
+    int (*enabled)(uint32_t owner);
+    int (*snapshot)(NeoSwapRelayStats* stats);
+    /* Destructor path: caller has quiesced ALL users and relinquishes the
+     * token. The backend blocks new maps immediately and owns retirement of
+     * every remaining alias. ANYWHERE cleanup errors are retried by collect().
+     * FIXED aliases are attempted synchronously once: a failed fixed replacement
+     * is permanently quarantined because its caller may subsequently reuse the
+     * virtual address. That object is never scrubbed/reissued during this process.
+     * Unlike release(), caller may forget the token after calling retire().
+     */
+    int (*retire)(uint64_t token);
+} NeoSwapRelayAPI;
+#if defined(__GNUC__)
+__attribute__((visibility("default")))
+#endif
+const NeoSwapRelayAPI* NeoSwap_GetRelayAPI(uint32_t abi_version);
+
+/* Optional, separate ABI. Prepared objects have no caller alias and are not
+ * donated until RelayAPI.map first publishes them. Acquisition only tries a
+ * metadata lock: it never allocates, samples the OS, maps or touches pages.
+ * A successful token uses the unchanged RelayAPI lifecycle. Misses record
+ * bounded demand for a utility worker; callers may use ordinary backing.
+ */
+enum { NEOSWAP_PREPARED_RELAY_ABI = 1 };
+typedef struct NeoSwapPreparedRelayStats {
+    uint32_t struct_size, abi_version;
+    uint64_t prepared_bytes, prepared_count, demand_bytes, demand_count;
+    uint64_t request_count, requested_bytes, acquired_count, acquired_bytes;
+    uint64_t miss_busy, miss_empty, refused_pressure, refused_disabled;
+    uint64_t unsupported_count, demand_overflow;
+    uint64_t prepared_total, reclaimed_total, prepare_failures, peak_prepared_bytes;
+    uint64_t pending_scrub_bytes, pending_scrub_count;
+    /* Includes prepared + borrowed-but-unpublished + their pending cleanup.
+     * These commitments have not necessarily consumed physical pages yet. */
+    uint64_t unpublished_bytes;
+} NeoSwapPreparedRelayStats;
+typedef struct NeoSwapPreparedRelayAPI {
+    uint32_t struct_size, abi_version;
+    int (*try_acquire)(uint32_t owner, uint64_t bytes, uint64_t* token);
+    /* Only before any successful map, with no concurrent user of the token.
+     * OK transfers ownership to utility cleanup without locks or OS calls;
+     * failure retains ownership. Does not accept legacy create() tokens. */
+    int (*return_unused)(uint64_t token);
+    int (*snapshot)(NeoSwapPreparedRelayStats* stats);
+} NeoSwapPreparedRelayAPI;
+#if defined(__GNUC__)
+__attribute__((visibility("default")))
+#endif
+const NeoSwapPreparedRelayAPI* NeoSwap_GetPreparedRelayAPI(uint32_t abi_version);
+
+/* Optional Core diagnostics; independent from both relay function tables. */
+enum { NEOSWAP_RELAY_CLIENT_STATS_ABI = 1 };
+typedef struct NeoSwapRelayClientStats {
+    uint32_t struct_size, abi_version, gameplay_active, reserved;
+    uint64_t candidate_first_maps, requested_bytes, gameplay_first_maps, gameplay_requested_bytes;
+    uint64_t prepared_hits, prepared_hit_bytes, prepared_misses, prepared_miss_bytes;
+    uint64_t ordinary_fallbacks, ordinary_fallback_bytes, map_failures, alias_maps;
+    uint64_t prepared_published_objects, prepared_published_bytes;
+    uint64_t first_map_total_ns, first_map_max_ns;
+    int32_t last_result;
+    uint32_t reserved_result;
+} NeoSwapRelayClientStats;
+
+/* Optional, separate ABI (Build 444): direct admission on a stock miss.
+ * On a prepared-stock miss the caller may create an exact-size guest object
+ * without waiting. The call tries the metadata lock only, applies the same
+ * admission as create() (dispatch pressure, kernel headroom sample, retained
+ * capacity, owner quota) plus the budget allowance installed by the host
+ * controller for the current maintenance interval, and touches no page. A
+ * token follows the prepared lifecycle: RelayAPI map/unmap/retire, or
+ * PreparedRelayAPI.return_unused before any published view. Every refusal
+ * leaves the caller on ordinary backing; no FILE object migrates later.
+ */
+enum { NEOSWAP_DIRECT_RELAY_ABI = 1 };
+typedef struct NeoSwapDirectRelayStats {
+    uint32_t struct_size, abi_version;
+    uint64_t requests, requested_bytes, created, created_bytes;
+    uint64_t busy, refused_pressure, refused_budget, refused_capacity;
+    uint64_t refused_disabled, refused_limit, refused_invalid;
+    /* Requests above the prepared stock maximum (16 MiB); created counts them too. */
+    uint64_t oversize_requests, oversize_requested_bytes, oversize_max_bytes;
+    /* Allowance in force until the next utility pass, and cumulative grants. */
+    uint64_t allowance_bytes, allowance_grants, allowance_granted_bytes;
+    /* Maintenance wake-ups signalled after misses (rate limited by the backend). */
+    uint64_t wakeups;
+} NeoSwapDirectRelayStats;
+typedef struct NeoSwapDirectRelayAPI {
+    uint32_t struct_size, abi_version;
+    int (*try_create)(uint32_t owner, uint64_t bytes, uint64_t* token);
+    int (*snapshot)(NeoSwapDirectRelayStats* stats);
+} NeoSwapDirectRelayAPI;
+#if defined(__GNUC__)
+__attribute__((visibility("default")))
+#endif
+const NeoSwapDirectRelayAPI* NeoSwap_GetDirectRelayAPI(uint32_t abi_version);
+
+/* Optional Core diagnostics extension (Build 444); independent from
+ * NeoSwapRelayClientStats and from every relay function table. */
+enum { NEOSWAP_RELAY_CLIENT_STATS_EXT_ABI = 1 };
+typedef struct NeoSwapRelayClientStatsExt {
+    uint32_t struct_size, abi_version;
+    uint64_t gameplay_direct_requests, gameplay_direct_creates, gameplay_direct_create_bytes;
+    uint64_t gameplay_direct_busy, gameplay_direct_pressure, gameplay_direct_budget, gameplay_direct_other;
+    /* Candidate objects that selected ordinary backing during gameplay (permanent). */
+    uint64_t gameplay_fallbacks, gameplay_fallback_bytes;
+    /* Candidate objects currently alive on ordinary backing: durably excluded bytes. */
+    uint64_t fallback_live_objects, fallback_live_bytes;
+    uint64_t oversize_requests, oversize_requested_bytes;
+    uint64_t boot_creates, boot_create_bytes;
+    uint64_t direct_published_objects, direct_published_bytes;
+} NeoSwapRelayClientStatsExt;
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/rpcs3/ios/NeoSwapRelayClient.h b/rpcs3/ios/NeoSwapRelayClient.h
new file mode 100644
index 0000000..2299c6c
--- /dev/null
+++ b/rpcs3/ios/NeoSwapRelayClient.h
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "NeoSwapRelay.h"
+#include "NeoSwap.h"
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <new>
+
+namespace neostation::relay {
+// Borrowed vtables live for the Core lifetime; no host broker or extension is
+// linked into the Core. Neither installation allocates or prepares memory.
+inline constinit std::atomic<const NeoSwapRelayAPI*> client_api{nullptr};
+inline constinit std::atomic<const NeoSwapPreparedRelayAPI*> prepared_api{nullptr};
+// Build 444: optional direct admission on a stock miss (host ABI, may be absent).
+inline constinit std::atomic<const NeoSwapDirectRelayAPI*> direct_api{nullptr};
+inline constinit std::atomic<bool> gameplay_active{false};
+inline constinit std::atomic<std::uint64_t> gameplay_fallbacks{0};
+inline void set_gameplay_active(bool active) noexcept {
+    gameplay_active.store(active, std::memory_order_release);
+}
+inline int install(const NeoSwapRelayAPI* api) noexcept {
+    if (!api || api->struct_size != sizeof(*api) || api->abi_version != NEOSWAP_RELAY_ABI ||
+        !api->create || !api->map || !api->unmap || !api->release || !api->enabled || !api->snapshot || !api->retire)
+        return NEOSWAP_RELAY_INVALID;
+    const NeoSwapRelayAPI* expected = nullptr;
+    if (!client_api.compare_exchange_strong(expected, api, std::memory_order_acq_rel) && expected != api)
+        return NEOSWAP_RELAY_BUSY;
+    return NEOSWAP_RELAY_OK;
+}
+inline int install_prepared(const NeoSwapPreparedRelayAPI* api) noexcept {
+    if (!api || api->struct_size != sizeof(*api) || api->abi_version != NEOSWAP_PREPARED_RELAY_ABI ||
+        !api->try_acquire || !api->snapshot || !api->return_unused)
+        return NEOSWAP_RELAY_INVALID;
+    const NeoSwapPreparedRelayAPI* expected = nullptr;
+    if (!prepared_api.compare_exchange_strong(expected, api, std::memory_order_acq_rel) && expected != api)
+        return NEOSWAP_RELAY_BUSY;
+    return NEOSWAP_RELAY_OK;
+}
+inline int install_direct(const NeoSwapDirectRelayAPI* api) noexcept {
+    if (!api || api->struct_size != sizeof(*api) || api->abi_version != NEOSWAP_DIRECT_RELAY_ABI ||
+        !api->try_create || !api->snapshot)
+        return NEOSWAP_RELAY_INVALID;
+    const NeoSwapDirectRelayAPI* expected = nullptr;
+    if (!direct_api.compare_exchange_strong(expected, api, std::memory_order_acq_rel) && expected != api)
+        return NEOSWAP_RELAY_BUSY;
+    return NEOSWAP_RELAY_OK;
+}
+
+#define NEOSWAP_RELAY_CLIENT_COUNTERS(F) \
+    F(candidate_first_maps) F(requested_bytes) \
+    F(gameplay_first_maps) F(gameplay_requested_bytes) \
+    F(prepared_hits) F(prepared_hit_bytes) F(prepared_misses) F(prepared_miss_bytes) \
+    F(ordinary_fallbacks) F(ordinary_fallback_bytes) F(map_failures) F(alias_maps) \
+    F(prepared_published_objects) F(prepared_published_bytes) \
+    F(first_map_total_ns) F(first_map_max_ns)
+struct client_counters {
+#define NEOSWAP_RELAY_COUNTER(name) std::atomic<std::uint64_t> name{0};
+    NEOSWAP_RELAY_CLIENT_COUNTERS(NEOSWAP_RELAY_COUNTER)
+#undef NEOSWAP_RELAY_COUNTER
+    std::atomic<std::int32_t> last_result{NEOSWAP_RELAY_OK};
+};
+inline constinit client_counters counters;
+inline int snapshot(NeoSwapRelayClientStats* out) noexcept {
+    if (!out || out->struct_size != sizeof(*out) || out->abi_version != NEOSWAP_RELAY_CLIENT_STATS_ABI)
+        return NEOSWAP_RELAY_INVALID;
+    NeoSwapRelayClientStats result{};
+    result.struct_size = sizeof(result);
+    result.abi_version = NEOSWAP_RELAY_CLIENT_STATS_ABI;
+    result.gameplay_active = gameplay_active.load(std::memory_order_acquire);
+#define NEOSWAP_RELAY_READ(name) result.name = counters.name.load(std::memory_order_relaxed);
+    NEOSWAP_RELAY_CLIENT_COUNTERS(NEOSWAP_RELAY_READ)
+#undef NEOSWAP_RELAY_READ
+    result.last_result = counters.last_result.load(std::memory_order_relaxed);
+    *out = result;
+    return NEOSWAP_RELAY_OK;
+}
+#undef NEOSWAP_RELAY_CLIENT_COUNTERS
+
+// Build 444 extension: direct admission outcomes, bytes durably excluded on
+// ordinary backing (live counts) and the boot-path creations. Separate ABI.
+#define NEOSWAP_RELAY_CLIENT_EXT_COUNTERS(F) \
+    F(gameplay_direct_requests) F(gameplay_direct_creates) F(gameplay_direct_create_bytes) \
+    F(gameplay_direct_busy) F(gameplay_direct_pressure) F(gameplay_direct_budget) F(gameplay_direct_other) \
+    F(gameplay_fallbacks) F(gameplay_fallback_bytes) F(fallback_live_objects) F(fallback_live_bytes) \
+    F(oversize_requests) F(oversize_requested_bytes) F(boot_creates) F(boot_create_bytes) \
+    F(direct_published_objects) F(direct_published_bytes)
+struct client_ext_counters {
+#define NEOSWAP_RELAY_COUNTER(name) std::atomic<std::uint64_t> name{0};
+    NEOSWAP_RELAY_CLIENT_EXT_COUNTERS(NEOSWAP_RELAY_COUNTER)
+#undef NEOSWAP_RELAY_COUNTER
+};
+inline constinit client_ext_counters ext_counters;
+inline int snapshot_ext(NeoSwapRelayClientStatsExt* out) noexcept {
+    if (!out || out->struct_size != sizeof(*out) || out->abi_version != NEOSWAP_RELAY_CLIENT_STATS_EXT_ABI)
+        return NEOSWAP_RELAY_INVALID;
+    NeoSwapRelayClientStatsExt result{};
+    result.struct_size = sizeof(result);
+    result.abi_version = NEOSWAP_RELAY_CLIENT_STATS_EXT_ABI;
+#define NEOSWAP_RELAY_READ(name) result.name = ext_counters.name.load(std::memory_order_relaxed);
+    NEOSWAP_RELAY_CLIENT_EXT_COUNTERS(NEOSWAP_RELAY_READ)
+#undef NEOSWAP_RELAY_READ
+    *out = result;
+    return NEOSWAP_RELAY_OK;
+}
+#undef NEOSWAP_RELAY_CLIENT_EXT_COUNTERS
+inline constexpr std::uint64_t prepared_stock_maximum_bytes = 16ULL * 1024 * 1024;
+
+// Measures only the first candidate call AFTER taking its client mutex. This
+// includes selection and the first Relay map if attempted, not the outer VM
+// lock wait, later alias calls or utils::shm's subsequent ordinary FILE mapping.
+class first_map_measurement {
+    using clock = std::chrono::steady_clock;
+    bool enabled;
+    clock::time_point start{};
+public:
+    first_map_measurement(bool candidate, bool gameplay, std::uint64_t bytes) noexcept : enabled(candidate) {
+        if (!enabled) return;
+        start = clock::now();
+        counters.candidate_first_maps.fetch_add(1, std::memory_order_relaxed);
+        counters.requested_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        if (gameplay) {
+            counters.gameplay_first_maps.fetch_add(1, std::memory_order_relaxed);
+            counters.gameplay_requested_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+    }
+    ~first_map_measurement() {
+        if (!enabled) return;
+        const auto elapsed = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now() - start).count());
+        counters.first_map_total_ns.fetch_add(elapsed, std::memory_order_relaxed);
+        auto previous = counters.first_map_max_ns.load(std::memory_order_relaxed);
+        while (previous < elapsed && !counters.first_map_max_ns.compare_exchange_weak(previous, elapsed, std::memory_order_relaxed)) {}
+    }
+};
+
+// One shared-memory object selects its backing once. No FILE object migrates;
+// fallback requires that no alias has ever been published and that ownership
+// has safely returned to the host. Every published alias keeps the same bytes.
+class shared_memory {
+    enum class mode { file, candidate, relay };
+    mutable std::mutex mutex;
+    mode state = mode::file;
+    const NeoSwapRelayAPI* api = nullptr;
+    const NeoSwapPreparedRelayAPI* prepared = nullptr;
+    std::uint64_t token = 0, bytes = 0;
+    bool published = false;
+    // Build 444: FILE selected after a candidate miss (live exclusion counted
+    // until destruction) and tokens obtained through the direct path.
+    bool excluded = false, direct = false;
+    struct alias { void* address = nullptr; alias* next = nullptr; bool heap = false; };
+    // g_base, g_sudo and map_self need no metadata allocation. Additional
+    // existing alias uses retain the old fallible allocation before mapping.
+    mutable alias inline_aliases[4]{};
+    mutable alias* aliases = nullptr;
+    alias* reserve_alias() noexcept {
+        for (auto& record : inline_aliases) if (!record.address) return &record;
+        alias* record = new (std::nothrow) alias;
+        if (record) record->heap = true;
+        return record;
+    }
+    static void discard_alias(alias* record) noexcept {
+        if (record->heap) delete record;
+        else *record = {};
+    }
+    bool return_unpublished() noexcept {
+        if (published) return false;
+        // Returning an unused prepared loan must not synchronously scrub/map
+        // memory under the VM lock. The host retains it for later maintenance.
+        const int result = prepared ? prepared->return_unused(token) : api->release(token);
+        if (result != NEOSWAP_RELAY_OK) return false;
+        token = 0;
+        return true;
+    }
+public:
+    struct map_result { bool handled; void* address; int result; };
+private:
+    map_result finish(bool handled, void* address, int result) noexcept {
+        counters.last_result.store(result, std::memory_order_relaxed);
+        return {handled, address, result};
+    }
+    map_result fallback(int result, bool gameplay) noexcept {
+        state = mode::file;
+        excluded = true;
+        counters.ordinary_fallbacks.fetch_add(1, std::memory_order_relaxed);
+        counters.ordinary_fallback_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        ext_counters.fallback_live_objects.fetch_add(1, std::memory_order_relaxed);
+        ext_counters.fallback_live_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        if (gameplay) {
+            gameplay_fallbacks.fetch_add(1, std::memory_order_relaxed);
+            ext_counters.gameplay_fallbacks.fetch_add(1, std::memory_order_relaxed);
+            ext_counters.gameplay_fallback_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+        return finish(false, nullptr, result);
+    }
+public:
+    shared_memory() = default;
+    shared_memory(const shared_memory&) = delete;
+    shared_memory& operator=(const shared_memory&) = delete;
+    void configure(std::uint64_t size, bool guest_data) noexcept {
+        bytes = size;
+        if (guest_data && size && size % NEOSWAP_RELAY_ALIGNMENT == 0)
+            state = mode::candidate;
+    }
+    map_result map(void* target, std::uint32_t protection, bool compatible) noexcept {
+        const std::lock_guard lock(mutex);
+        if (state == mode::file) return {false, nullptr, NEOSWAP_RELAY_DISABLED};
+        const bool gameplay = gameplay_active.load(std::memory_order_acquire);
+        first_map_measurement measurement(state == mode::candidate, gameplay, bytes);
+        if (!compatible || (target && reinterpret_cast<std::uintptr_t>(target) % NEOSWAP_RELAY_ALIGNMENT)) {
+            if (state == mode::candidate) return fallback(NEOSWAP_RELAY_DISABLED, gameplay);
+            return finish(true, nullptr, NEOSWAP_RELAY_INVALID);
+        }
+        if (state == mode::candidate) {
+            if (bytes > prepared_stock_maximum_bytes) {
+                ext_counters.oversize_requests.fetch_add(1, std::memory_order_relaxed);
+                ext_counters.oversize_requested_bytes.fetch_add(bytes, std::memory_order_relaxed);
+            }
+            api = client_api.load(std::memory_order_acquire);
+            if (!api) return fallback(NEOSWAP_RELAY_DISABLED, gameplay);
+            const auto* ready = prepared_api.load(std::memory_order_acquire);
+            int result = NEOSWAP_RELAY_DISABLED;
+            if (ready) result = ready->try_acquire(NEOSWAP_RPCS3, bytes, &token);
+            if (result == NEOSWAP_RELAY_OK && token) {
+                prepared = ready;
+                counters.prepared_hits.fetch_add(1, std::memory_order_relaxed);
+                counters.prepared_hit_bytes.fetch_add(bytes, std::memory_order_relaxed);
+            } else {
+                counters.prepared_misses.fetch_add(1, std::memory_order_relaxed);
+                counters.prepared_miss_bytes.fetch_add(bytes, std::memory_order_relaxed);
+                if (gameplay) {
+                    // No blocking create, extension request or lock wait in
+                    // gameplay. Build 444: an empty stock (QUOTA) or a size
+                    // above the stock maximum (INVALID) may still be admitted
+                    // at once by the host's non-blocking direct path, within
+                    // the budget allowance of the current interval. Every
+                    // other outcome selects ordinary backing permanently.
+                    const auto* admit = direct_api.load(std::memory_order_acquire);
+                    if (!admit || !ready || (result != NEOSWAP_RELAY_QUOTA && result != NEOSWAP_RELAY_INVALID))
+                        return fallback(result == NEOSWAP_RELAY_OK ? NEOSWAP_RELAY_INVALID : result, gameplay);
+                    ext_counters.gameplay_direct_requests.fetch_add(1, std::memory_order_relaxed);
+                    result = admit->try_create(NEOSWAP_RPCS3, bytes, &token);
+                    if (result != NEOSWAP_RELAY_OK || !token) {
+                        switch (result) {
+                        case NEOSWAP_RELAY_BUSY: ext_counters.gameplay_direct_busy.fetch_add(1, std::memory_order_relaxed); break;
+                        case NEOSWAP_RELAY_PRESSURE: ext_counters.gameplay_direct_pressure.fetch_add(1, std::memory_order_relaxed); break;
+                        case NEOSWAP_RELAY_QUOTA: ext_counters.gameplay_direct_budget.fetch_add(1, std::memory_order_relaxed); break;
+                        default: ext_counters.gameplay_direct_other.fetch_add(1, std::memory_order_relaxed); break;
+                        }
+                        return fallback(result == NEOSWAP_RELAY_OK ? NEOSWAP_RELAY_INVALID : result, gameplay);
+                    }
+                    prepared = ready;
+                    direct = true;
+                    ext_counters.gameplay_direct_creates.fetch_add(1, std::memory_order_relaxed);
+                    ext_counters.gameplay_direct_create_bytes.fetch_add(bytes, std::memory_order_relaxed);
+                } else {
+                    if (!api->enabled(NEOSWAP_RPCS3)) return fallback(NEOSWAP_RELAY_DISABLED, gameplay);
+                    result = api->create(NEOSWAP_RPCS3, bytes, &token);
+                    if (result != NEOSWAP_RELAY_OK || !token)
+                        return fallback(result == NEOSWAP_RELAY_OK ? NEOSWAP_RELAY_INVALID : result, gameplay);
+                    ext_counters.boot_creates.fetch_add(1, std::memory_order_relaxed);
+                    ext_counters.boot_create_bytes.fetch_add(bytes, std::memory_order_relaxed);
+                }
+            }
+            state = mode::relay;
+        }
+        alias* record = reserve_alias();
+        if (!record) {
+            if (return_unpublished()) return fallback(NEOSWAP_RELAY_LIMIT, gameplay);
+            return finish(true, nullptr, NEOSWAP_RELAY_LIMIT);
+        }
+        void* address = nullptr;
+        const int result = api->map(token, target, protection, &address);
+        if (result == NEOSWAP_RELAY_OK && address) {
+            record->address = address;
+            record->next = aliases;
+            aliases = record;
+            if (published) counters.alias_maps.fetch_add(1, std::memory_order_relaxed);
+            else if (direct) {
+                ext_counters.direct_published_objects.fetch_add(1, std::memory_order_relaxed);
+                ext_counters.direct_published_bytes.fetch_add(bytes, std::memory_order_relaxed);
+            } else if (prepared) {
+                counters.prepared_published_objects.fetch_add(1, std::memory_order_relaxed);
+                counters.prepared_published_bytes.fetch_add(bytes, std::memory_order_relaxed);
+            }
+            published = true;
+            return finish(true, address, result);
+        }
+        discard_alias(record);
+        counters.map_failures.fetch_add(1, std::memory_order_relaxed);
+        const int error = result == NEOSWAP_RELAY_OK ? NEOSWAP_RELAY_MAPPING : result;
+        if (return_unpublished()) return fallback(error, gameplay);
+        return finish(true, nullptr, error);
+    }
+    // Failed cleanup never falls through to munmap/free and never permits a
+    // published object to switch backing even when temporarily without aliases.
+    bool unmap(void* address, int& result) const noexcept {
+        const std::lock_guard lock(mutex);
+        if (state != mode::relay) return false;
+        alias** found = &aliases;
+        while (*found && (*found)->address != address) found = &(*found)->next;
+        if (!*found) {
+            result = NEOSWAP_RELAY_UNKNOWN;
+            return true;
+        }
+        result = api->unmap(token, address);
+        if (result == NEOSWAP_RELAY_OK) {
+            alias* retired = *found;
+            *found = retired->next;
+            discard_alias(retired);
+        }
+        return true;
+    }
+    // Destruction transfers ownership after users are quiesced. Failed fixed
+    // aliases stay quarantined; a later guest may already reuse their range.
+    bool retire() noexcept {
+        const std::lock_guard lock(mutex);
+        if (!token || !api) return false;
+        if (!prepared || published || !return_unpublished()) (void)api->retire(token);
+        token = 0;
+        while (aliases) {
+            alias* retired = aliases;
+            aliases = retired->next;
+            discard_alias(retired);
+        }
+        return true;
+    }
+    ~shared_memory() {
+        (void)retire();
+        if (excluded) {
+            ext_counters.fallback_live_objects.fetch_sub(1, std::memory_order_relaxed);
+            ext_counters.fallback_live_bytes.fetch_sub(bytes, std::memory_order_relaxed);
+        }
+    }
+};
+}
diff --git a/rpcs3/ios/NeoSwapStorage/Client.h b/rpcs3/ios/NeoSwapStorage/Client.h
new file mode 100644
index 0000000..a0d7975
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/Client.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "StorageABI.h"
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+namespace neostation::storage_client {
+inline constinit std::atomic<const NeoSwapStorageAPI*> installed{nullptr};
+inline int install(const NeoSwapStorageAPI* api) noexcept {
+    if(!api||api->struct_size!=sizeof(*api)||api->abi_version!=NEOSWAP_STORAGE_ABI||
+       !api->session||!api->acquire||!api->publish||!api->release||!api->prefetch||
+       !api->invalidate||!api->event)return NS_STORAGE_INVALID;
+    const NeoSwapStorageAPI* expected=nullptr;
+    return installed.compare_exchange_strong(expected,api)||expected==api?NS_STORAGE_OK:NS_STORAGE_INVALID;
+}
+struct Ticket {const NeoSwapStorageAPI* api=nullptr;uint64_t session=0;std::array<uint8_t,32> key{};};
+inline Ticket ticket() noexcept {Ticket t;t.api=installed.load();if(t.api)t.session=t.api->session();return t;}
+inline bool active(const Ticket& t) noexcept {return t.api&&t.session&&t.api->session()==t.session;}
+class Lease final {
+public:
+    explicit Lease(const Ticket& t):api_(t.api){
+        if(active(t)&&api_->acquire(t.session,t.key.data(),&view_)==NS_STORAGE_OK){
+            uint32_t h[5]{};
+            if(view_.words&&view_.lease&&view_.byte_count>=sizeof(h)&&view_.byte_count<=1024*1024&&view_.byte_count%4==0){
+                std::memcpy(h,view_.words,sizeof(h));valid_=h[0]==0x07230203u&&h[1]>=0x00010000u&&h[1]<=0x00010600u&&h[3]&&h[4]==0;
+            }
+            if(!valid_){api_->invalidate(t.session,t.key.data());reset();}
+        }else reset();
+    }
+    ~Lease(){reset();}
+    Lease(const Lease&)=delete;Lease& operator=(const Lease&)=delete;
+    explicit operator bool()const noexcept{return valid_;}
+    const uint32_t* data()const noexcept{return view_.words;}
+    size_t size()const noexcept{return static_cast<size_t>(view_.byte_count);}
+    void reset() noexcept {if(api_&&view_.lease)api_->release(&view_);view_={};valid_=false;}
+private:const NeoSwapStorageAPI* api_;NeoSwapStorageView view_{};bool valid_=false;
+};
+enum class CompileResult {ok, source_failure, module_failure};
+enum class ModuleResult {ok, retry_source, fatal};
+// Actual production hook: cache bytes are consumed by vkCreateShaderModule,
+// NOT a debug-only getter. Driver objects and live GPU memory are never evicted.
+// Build and Create must preserve the original compiler and module parameters.
+template<class Build,class Create>
+CompileResult compile(const Ticket& t,std::vector<uint32_t>& original,Build&& build,Create&& create){
+    {
+        Lease cached(t);
+        if(cached){
+            const auto result=create(cached.data(),cached.size());
+            if(result==ModuleResult::ok){
+                std::vector<uint32_t>().swap(original);return CompileResult::ok;
+            }
+            // Out-of-memory/device-loss must not allocate another compiler
+            // result. Only an explicit invalid-cache result permits one rebuild.
+            if(result==ModuleResult::fatal)return CompileResult::module_failure;
+            t.api->invalidate(t.session,t.key.data());
+            t.api->event(t.session,NS_STORAGE_CACHED_MODULE_REJECTED,cached.size());
+        }
+    } // release pin before rebuilding; no stale cache error blocks original path
+    if(active(t))t.api->event(t.session,NS_STORAGE_SOURCE_COMPILE,0);
+    if(!build(original))return CompileResult::source_failure;
+    if(create(original.data(),original.size()*sizeof(uint32_t))!=ModuleResult::ok)return CompileResult::module_failure;
+    if(active(t)&&t.api->publish(t.session,t.key.data(),original.data(),original.size()*4)==NS_STORAGE_OK){
+        const auto bytes=original.capacity()*sizeof(uint32_t);
+        std::vector<uint32_t>().swap(original);
+        t.api->event(t.session,NS_STORAGE_CPU_COPY_RELEASED,bytes);
+    }
+    return CompileResult::ok;
+}
+}
diff --git a/rpcs3/ios/NeoSwapStorage/FrameClient.h b/rpcs3/ios/NeoSwapStorage/FrameClient.h
new file mode 100644
index 0000000..e0724fa
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/FrameClient.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "SourceClient.h"
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <condition_variable>
+#include <mutex>
+
+namespace neostation::source_client {
+// Immutable packed SOFTWARE pixels only, after the decoder has relinquished
+// its references. Neither guest buffers nor GPU images belong to this client.
+inline constexpr uint32_t frame_domain = 3;
+inline constexpr uint64_t frame_max_bytes = 4ULL << 20;
+inline constexpr uint32_t frame_max_chunks = 4;
+inline constexpr uint64_t frame_cold_age_us = 250'000;
+inline constexpr uint32_t frame_warm_count = 8, frame_min_queue = 24;
+// Protect the next pictures as well as FFmpeg's newest references. Archiving
+// the FIFO head creates an avoidable disk restore on cellVdecGetPicture.
+inline constexpr uint32_t frame_warm_head_count = 8;
+inline constexpr uint64_t frame_prefetch_payload_limit = 8ULL << 20;
+inline constexpr uint32_t frame_prefetch_count_limit = 8;
+enum class FrameWarmState : uint8_t { cold, loading, ready, consumed, failed };
+inline constinit std::atomic<uint64_t> frame_prefetch_payload_bytes{0},frame_prefetch_peak_bytes{0};
+inline constinit std::atomic<uint32_t> frame_prefetch_count{0};
+inline constinit std::atomic<uint64_t> frame_prefetch_hits{0},frame_prefetch_requests{0};
+inline constinit std::atomic<uint64_t> frame_prefetch_failures{0},frame_prefetch_refusals{0};
+inline constinit std::atomic<uint64_t> frame_demand_reads{0},frame_prefetch_wait_max_us{0};
+inline constinit std::atomic<uint64_t> frame_prefetch_read_us{0},frame_prefetch_read_max_us{0};
+inline constinit std::atomic<uint64_t> frame_demand_read_us{0},frame_demand_read_max_us{0};
+inline constexpr bool frame_requires_restore_slot(bool archived, bool has_output) noexcept {
+    // Normal/warm/default-off consumption keeps the original producer wakeup.
+    return archived && has_output;
+}
+inline bool frame_queue_has_room(uint64_t queued, uint64_t consuming, uint64_t maximum) noexcept {
+    return queued < maximum && consuming < maximum - queued;
+}
+inline bool frame_can_cool(uint32_t queue, uint32_t position, uint64_t age_us,
+                           uint64_t bytes, bool exclusively_owned) noexcept {
+    return exclusively_owned && queue >= frame_min_queue && position >= frame_warm_head_count && position < queue &&
+        queue - position > frame_warm_count && age_us >= frame_cold_age_us &&
+        bytes >= 4096 && bytes <= frame_max_bytes;
+}
+struct FrameReference final {
+    std::array<Reference, frame_max_chunks> chunks;
+    uint64_t bytes = 0;
+    uint32_t count = 0;
+    std::atomic<FrameWarmState> warm_state{FrameWarmState::cold};
+    std::mutex warm_mutex;
+    std::condition_variable warm_changed;
+    std::string warm_pixels;
+    bool warm_charge = false; // guarded by warm_mutex; last shared owner retires it
+    ~FrameReference();
+};
+class ColdFrame final {
+public:
+    bool archived() const noexcept { return bool(reference_); }
+    void reset() noexcept { reference_.reset(); }
+    // Transactional admission: every chunk shares ONE session; partial
+    // acceptance is retired and the caller must keep its original AVFrame.
+    // This only copies bounded bytes, never performs storage I/O.
+    bool offload(const char* packed_pixels, size_t bytes) noexcept;
+    // Allocation/copy lives in the dedicated exception-enabled source unit,
+    // keeping decoder consumers valid with their real -fno-exceptions flags.
+    using PixelCopy = int (*)(char*, size_t, void*);
+    bool offload_copy(size_t bytes, PixelCopy copy, void* context) noexcept;
+    // VDEC's CPU consumer only, outside the queue/conversion mutexes. Failed
+    // restore clears output; no caller may consume partially restored pixels.
+    int restore(std::string& output, int& os_error, bool* prefetched = nullptr) const noexcept;
+    bool can_prefetch() const noexcept {
+        return reference_ && reference_->warm_state.load(std::memory_order_relaxed)==FrameWarmState::cold;
+    }
+    // Existing VDEC producer only, OUTSIDE its queue/conversion locks. There
+    // is no new worker thread, Core ABI or host storage API. A consumed frame
+    // never starts a second speculative read. Payload/count limits are global.
+    bool prefetch() const noexcept;
+private:
+    std::shared_ptr<FrameReference> reference_;
+};
+}
diff --git a/rpcs3/ios/NeoSwapStorage/ShaderKey.h b/rpcs3/ios/NeoSwapStorage/ShaderKey.h
new file mode 100644
index 0000000..86f7444
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/ShaderKey.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "Client.h"
+#include "Crypto/sha256.h"
+#include <string_view>
+namespace neostation::storage_client {
+// Same-session SHA-256(source bytes, stage, compilation environment revision).
+// SPIRVCommon: Vulkan 1.2, SPIR-V 1.5, optimizer disabled, optimizeSize=true.
+inline Ticket shader_ticket(std::string_view source,uint32_t stage) noexcept {
+    auto t=ticket();if(!active(t)||source.empty()||source.size()>4*1024*1024){t.session=0;return t;}
+    const uint8_t prefix[16]={'N','S','-','S','P','V','1',0,
+        uint8_t(stage),uint8_t(stage>>8),uint8_t(stage>>16),uint8_t(stage>>24),
+        0,5,1,0};
+    mbedtls_sha256_context ctx;mbedtls_sha256_init(&ctx);
+    int rc=mbedtls_sha256_starts_ret(&ctx,0);
+    if(!rc)rc=mbedtls_sha256_update_ret(&ctx,prefix,sizeof(prefix));
+    if(!rc)rc=mbedtls_sha256_update_ret(&ctx,reinterpret_cast<const uint8_t*>(source.data()),source.size());
+    if(!rc)rc=mbedtls_sha256_finish_ret(&ctx,t.key.data());
+    mbedtls_sha256_free(&ctx);if(rc)t.session=0;
+    return t;
+}
+}
diff --git a/rpcs3/ios/NeoSwapStorage/SourceABI.h b/rpcs3/ios/NeoSwapStorage/SourceABI.h
new file mode 100644
index 0000000..aad4038
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/SourceABI.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+#ifndef NEOSTATION_SOURCE_ARCHIVE_ABI_H
+#define NEOSTATION_SOURCE_ARCHIVE_ABI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Optional host-owned archive for immutable CPU snapshots: compiled GLSL
+ * (domains 0..2), or exclusively owned software pixels (domain 3 opt-in).
+ * An old GLSL-only host refuses domain 3; retain original pixels on refusal.
+ * Layout/ABI 1 is unchanged. Admission
+ * snapshots at most 1 MiB, never waits for I/O and keeps ownership on refusal.
+ * The host checkpoints on its utility queue before releasing its snapshot.
+ * read copies into caller-owned output: synchronous debug/export or VDEC CPU
+ * consumption outside queue/conversion locks. NOT an RSX/render-thread lookup,
+ * a guest-memory pager or a way to archive FFmpeg reference/GPU frames. */
+enum { NEOSWAP_SOURCE_ABI = 1, NEOSWAP_SOURCE_MAX_BYTES = 1024*1024 };
+enum NeoSwapSourceResult { NS_SOURCE_OK=0, NS_SOURCE_BUSY=1,
+    NS_SOURCE_DISABLED=2, NS_SOURCE_INVALID=3, NS_SOURCE_IO=4,
+    NS_SOURCE_QUOTA=5, NS_SOURCE_MISSING=6, NS_SOURCE_PRESSURE=7 };
+typedef struct NeoSwapSourceAPI {
+    uint32_t struct_size, abi_version;
+    uint64_t (*session)(void);
+    int (*admit)(uint64_t session, uint32_t domain, const char* source,
+                 uint64_t bytes, uint64_t* object);
+    int (*read)(uint64_t session, uint64_t object, char* output,
+                uint64_t exact_bytes, int* os_error);
+    void (*discard)(uint64_t session, uint64_t object);
+    void (*released)(uint64_t session, uint64_t source_capacity);
+} NeoSwapSourceAPI;
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/rpcs3/ios/NeoSwapStorage/SourceClient.cpp b/rpcs3/ios/NeoSwapStorage/SourceClient.cpp
new file mode 100644
index 0000000..02c18dd
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/SourceClient.cpp
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: MIT
+#include "SourceClient.h"
+#include "FrameClient.h"
+#include <algorithm>
+#include <chrono>
+#if !defined(__cpp_exceptions)
+#error "NeoSwap SourceClient.cpp requires exceptions in this dedicated unit"
+#endif
+namespace neostation::source_client {
+bool ColdSource::offload(std::string& source,uint32_t domain) noexcept {
+    if(reference_ || source.empty())return false;
+    const auto* api=installed.load();if(!api)return false;
+    const auto session=api->session();if(!session)return false;
+    try {
+        auto ref=std::make_shared<Reference>(); // Before host ownership transfer.
+        ref->api=api;ref->session=session;ref->bytes=source.size();
+        uint64_t object=0;
+        if(api->admit(session,domain,source.data(),source.size(),&object)!=NS_SOURCE_OK || !object)
+            return false;
+        ref->object=object;reference_=std::move(ref);
+        const auto capacity=source.capacity();std::string().swap(source);
+        api->released(session,capacity);
+        return true;
+    }catch(...){return false;}
+}
+int ColdSource::restore(std::string& output,int& os_error) const noexcept {
+    os_error=0;output.clear();if(!reference_)return NS_SOURCE_MISSING;
+    const auto& ref=*reference_;
+    try {
+        output.resize(static_cast<size_t>(ref.bytes));
+        const auto result=ref.api->read(ref.session,ref.object,output.data(),ref.bytes,&os_error);
+        if(result!=NS_SOURCE_OK)output.clear();
+        return result;
+    }catch(...){output.clear();return NS_SOURCE_BUSY;}
+}
+bool ColdFrame::offload(const char* pixels, size_t bytes) noexcept {
+    if(reference_ || !pixels || bytes < 4096 || bytes > frame_max_bytes)return false;
+    const auto* api=installed.load();if(!api)return false;
+    const auto epoch=api->session();if(!epoch)return false;
+    try {
+        auto candidate=std::make_shared<FrameReference>();
+        candidate->bytes=bytes;
+        candidate->count=static_cast<uint32_t>((bytes+NEOSWAP_SOURCE_MAX_BYTES-1)/NEOSWAP_SOURCE_MAX_BYTES);
+        const auto chunk=(bytes+candidate->count-1)/candidate->count;
+        size_t offset=0;
+        for(uint32_t index=0;index<candidate->count;++index){
+            auto& ref=candidate->chunks[index];
+            ref.api=api;ref.session=epoch;ref.bytes=std::min(chunk,bytes-offset);
+            if(api->admit(epoch,frame_domain,pixels+offset,ref.bytes,&ref.object)!=NS_SOURCE_OK || !ref.object)
+                return false; // candidate retires ALL accepted chunks exactly once
+            offset+=static_cast<size_t>(ref.bytes);
+        }
+        // A concurrent stop/relaunch must never strand the original frame in
+        // a retired epoch. Old hosts reject domain 3 and keep the RAM fallback.
+        if(api->session()!=epoch)return false;
+        reference_=std::move(candidate);return true;
+    }catch(...){return false;}
+}
+bool ColdFrame::offload_copy(size_t bytes,PixelCopy copy,void* context) noexcept {
+    const auto* api=installed.load();
+    if(reference_ || !copy || bytes<4096 || bytes>frame_max_bytes || !api || !api->session())return false;
+    try {
+        std::string packed(bytes,'\0');
+        if(copy(packed.data(),bytes,context)!=static_cast<int>(bytes))return false;
+        return offload(packed.data(),packed.size());
+    }catch(...){return false;}
+}
+namespace {
+void frame_peak(std::atomic<uint64_t>& field,uint64_t value) noexcept {
+    auto old=field.load(std::memory_order_relaxed);
+    while(old<value&&!field.compare_exchange_weak(old,value,std::memory_order_relaxed)){}
+}
+bool reserve_frame_payload(uint64_t bytes) noexcept {
+    auto used=frame_prefetch_payload_bytes.load(std::memory_order_relaxed);
+    do {
+        if(bytes>frame_prefetch_payload_limit || used>frame_prefetch_payload_limit-bytes)return false;
+    }while(!frame_prefetch_payload_bytes.compare_exchange_weak(used,used+bytes,std::memory_order_relaxed));
+    const auto count=frame_prefetch_count.fetch_add(1,std::memory_order_relaxed);
+    if(count>=frame_prefetch_count_limit){
+        frame_prefetch_count.fetch_sub(1,std::memory_order_relaxed);
+        frame_prefetch_payload_bytes.fetch_sub(bytes,std::memory_order_relaxed);return false;
+    }
+    frame_peak(frame_prefetch_peak_bytes,used+bytes);return true;
+}
+void release_frame_payload(uint64_t bytes) noexcept {
+    frame_prefetch_payload_bytes.fetch_sub(bytes,std::memory_order_relaxed);
+    frame_prefetch_count.fetch_sub(1,std::memory_order_relaxed);
+}
+int read_frame_payload(const FrameReference& frame,std::string& output,int& os_error,bool speculative=false) noexcept {
+    struct ReadCost {
+        bool prefetch;
+        std::chrono::steady_clock::time_point start=std::chrono::steady_clock::now();
+        ~ReadCost(){
+            const auto elapsed=static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now()-start).count());
+            auto& total=prefetch?frame_prefetch_read_us:frame_demand_read_us;
+            auto& maximum=prefetch?frame_prefetch_read_max_us:frame_demand_read_max_us;
+            total.fetch_add(elapsed,std::memory_order_relaxed);frame_peak(maximum,elapsed);
+        }
+    } cost{speculative};
+    try {
+        output.resize(static_cast<size_t>(frame.bytes));size_t offset=0;
+        for(uint32_t index=0;index<frame.count;++index){
+            const auto& ref=frame.chunks[index];
+            const int code=ref.api->read(ref.session,ref.object,output.data()+offset,ref.bytes,&os_error);
+            if(code!=NS_SOURCE_OK){output.clear();return code;}
+            offset+=static_cast<size_t>(ref.bytes);
+        }
+        return NS_SOURCE_OK;
+    }catch(...){output.clear();return NS_SOURCE_BUSY;}
+}
+}
+FrameReference::~FrameReference(){
+    if(warm_charge){std::string().swap(warm_pixels);release_frame_payload(bytes);}
+}
+bool ColdFrame::prefetch() const noexcept {
+    if(!reference_)return false;
+    auto frame=reference_; // pins objects and epoch during the existing producer's read
+    // A zero/stale session also covers paused or pressure-closed admission.
+    // Demand restores remain permitted; speculative RAM is not grown there.
+    if(!frame->chunks[0].api || frame->chunks[0].api->session()!=frame->chunks[0].session){
+        frame_prefetch_refusals.fetch_add(1);return false;
+    }
+    try {
+        {
+            std::unique_lock lock(frame->warm_mutex,std::try_to_lock);
+            if(!lock.owns_lock() || frame->warm_state.load()!=FrameWarmState::cold)return false;
+            if(!reserve_frame_payload(frame->bytes)){frame_prefetch_refusals.fetch_add(1);return false;}
+            frame->warm_charge=true;
+            frame->warm_state.store(FrameWarmState::loading);
+        }
+        frame_prefetch_requests.fetch_add(1);
+        std::string pixels;int error=0;
+        const int result=read_frame_payload(*frame,pixels,error,true);
+        {
+            std::lock_guard lock(frame->warm_mutex);
+            if(result==NS_SOURCE_OK){
+                frame->warm_pixels.swap(pixels);
+                frame->warm_state.store(FrameWarmState::ready);
+            }else{
+                std::string().swap(pixels);
+                release_frame_payload(frame->bytes);frame->warm_charge=false;
+                frame->warm_state.store(FrameWarmState::failed);
+                frame_prefetch_failures.fetch_add(1);
+            }
+        }
+        frame->warm_changed.notify_all();return result==NS_SOURCE_OK;
+    }catch(...){
+        // No I/O occurs under this metadata lock. Always release waiters, and
+        // keep the archived original available to the normal retry path.
+        std::lock_guard lock(frame->warm_mutex);
+        if(frame->warm_charge){release_frame_payload(frame->bytes);frame->warm_charge=false;}
+        frame->warm_state.store(FrameWarmState::failed);frame->warm_changed.notify_all();
+        frame_prefetch_failures.fetch_add(1);return false;
+    }
+}
+int ColdFrame::restore(std::string& output,int& os_error,bool* prefetched) const noexcept {
+    os_error=0;output.clear();if(prefetched)*prefetched=false;
+    if(!reference_)return NS_SOURCE_MISSING;
+    auto frame=reference_;
+    try {
+        std::string retired_output;
+        std::unique_lock lock(frame->warm_mutex);
+        const auto start=std::chrono::steady_clock::now();
+        frame->warm_changed.wait(lock,[&]{return frame->warm_state.load()!=FrameWarmState::loading;});
+        frame_peak(frame_prefetch_wait_max_us,std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now()-start).count());
+        if(frame->warm_state.load()==FrameWarmState::ready){
+            output.swap(frame->warm_pixels);retired_output.swap(frame->warm_pixels);
+            release_frame_payload(frame->bytes);frame->warm_charge=false;
+            frame->warm_state.store(FrameWarmState::consumed);
+            if(prefetched)*prefetched=true;
+            frame_prefetch_hits.fetch_add(1);return NS_SOURCE_OK;
+        }
+        frame->warm_state.store(FrameWarmState::consumed);
+        lock.unlock();frame_demand_reads.fetch_add(1);
+        return read_frame_payload(*frame,output,os_error);
+    }catch(...){output.clear();return NS_SOURCE_BUSY;}
+}
+}
diff --git a/rpcs3/ios/NeoSwapStorage/SourceClient.h b/rpcs3/ios/NeoSwapStorage/SourceClient.h
new file mode 100644
index 0000000..313e75b
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/SourceClient.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "SourceABI.h"
+#include <atomic>
+#include <memory>
+#include <string>
+#include <utility>
+namespace neostation::source_client {
+inline constinit std::atomic<const NeoSwapSourceAPI*> installed{nullptr};
+inline int install(const NeoSwapSourceAPI* api) noexcept {
+    if(!api || api->struct_size!=sizeof(*api) || api->abi_version!=NEOSWAP_SOURCE_ABI ||
+       !api->session || !api->admit || !api->read || !api->discard || !api->released)
+        return NS_SOURCE_INVALID;
+    const NeoSwapSourceAPI* expected=nullptr;
+    return installed.compare_exchange_strong(expected,api)||expected==api ? NS_SOURCE_OK:NS_SOURCE_INVALID;
+}
+struct Reference final {
+    const NeoSwapSourceAPI* api=nullptr;
+    uint64_t session=0,object=0,bytes=0;
+    ~Reference(){if(api && object)api->discard(session,object);}
+};
+// Shared ownership preserves shader moves/copies without double retirement.
+// A restored string owns its bytes; no reference escapes a temporary lease.
+class ColdSource final {
+public:
+    void reset() noexcept { reference_.reset(); }
+    bool archived() const noexcept { return bool(reference_); }
+    // Definitions live in one exception-enabled unit. This header is also
+    // included by RPCS3 units compiled with -fno-exceptions.
+    bool offload(std::string& source,uint32_t domain) noexcept;
+    int restore(std::string& output,int& os_error) const noexcept;
+private:
+    std::shared_ptr<Reference> reference_;
+};
+}
diff --git a/rpcs3/ios/NeoSwapStorage/StorageABI.h b/rpcs3/ios/NeoSwapStorage/StorageABI.h
new file mode 100644
index 0000000..535b53e
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/StorageABI.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+#ifndef NEOSTATION_STORAGE_ABI_H
+#define NEOSTATION_STORAGE_ABI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Optional HOST service for regenerable SPIR-V CPU bytes only. Never owns
+ * VkShaderModule, GPU memory, guest pages, JIT code or user save data.
+ * Calls on a rendering/compilation thread do no file I/O and never wait for I/O.
+ * A miss (including pending restore) means recompile from the unchanged GLSL.
+ * Each operation is scoped to an immutable session generation. */
+enum { NEOSWAP_STORAGE_ABI = 1, NEOSWAP_STORAGE_KEY_BYTES = 32 };
+enum NeoSwapStorageResult { NS_STORAGE_OK = 0, NS_STORAGE_MISS = 1,
+    NS_STORAGE_BUSY = 2, NS_STORAGE_DISABLED = 3, NS_STORAGE_INVALID = 4 };
