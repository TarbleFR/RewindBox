+			const u32 slice = mip_offsets[section.level] + section.dst_z;
+			const u64 bit = u64{1} << (slice % 64);
+			if (!(covered[slice / 64] & bit))
+			{
+				covered[slice / 64] |= bit;
+				--remaining;
+			}
+		}
+
+		return remaining == 0;
+	}
