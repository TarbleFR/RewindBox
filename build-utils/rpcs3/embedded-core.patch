+#include "old-type.inc"
+} // namespace rsx
+using namespace rsx;
+namespace utils
+{
+	template <class T>
+	T aligned_div(T x, std::type_identity_t<T> d)
+	{
+		return x / d + T{!!(x % d)};
+	}
+	template <class T>
+	T add_saturate(T a, T b)
+	{
+		return a > std::numeric_limits<T>::max() - b ? std::numeric_limits<T>::max() : a + b;
+	}
+} // namespace utils
+namespace vm
+{
+	alignas(128) std::array<std::byte, 131072> memory{};
