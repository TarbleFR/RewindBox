+			ol.attribute_mask = 0xffffu ^ (i & 3);
+			return ol.validate();
+		},
+		[&](unsigned i)
+		{
+			nl.attribute_mask = 0xffffu ^ (i & 3);
+			return nl.validate();
+		});
