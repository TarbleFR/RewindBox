+	const auto branch = opcode(branch_pc);
+	const auto type = g_spu_itype.decode(branch.opcode);
+	return (type == spu_itype::BRZ || type == spu_itype::BRNZ) && values[branch.rt] &&
+		spu_branch_target(branch_pc, branch.i16) == read_pc;
+}
