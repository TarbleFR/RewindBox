+		asm("ISB");
+		asm("DSB ISH");
+#endif
+		spu_runtime::g_tail_escape(&spu, compiled, nullptr);
+		return true;
+	case rpcs3::spu::deferred_dispatch::enqueue_and_interpret:
+	case rpcs3::spu::deferred_dispatch::interpret_pending:
+	case rpcs3::spu::deferred_dispatch::interpret_failed:
+		item->deferred_hits++;
+		spu.interp_fallback_item = decision == rpcs3::spu::deferred_dispatch::interpret_failed ? nullptr : item;
+		spu.interp_fallback_branches = 0;
+		spu.interp_fallback_instructions = 0;
