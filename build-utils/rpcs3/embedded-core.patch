+	// ------------------------------------------------------------------------------------------------------------------
+	// One decode as upload_tiled_image runs it: the tile span copied out of the tile memory, then the kernel's loop for
+	// every word of the packed linear image (MTLM4Shaders.h m4_tile_decode_kernel), against rsx::tiled_dma_copy decoding
+	// the same region from the same memory into a zeroed buffer (what the CPU path uploads).
+	struct tile_case
+	{
+		u32 base, size, pitch, bank, origin_offset, width, height, bpp;
+	};
+
+	bool run_tile_case(const tile_case& c, const std::vector<u8>& tile_memory, const char*& failure)
+	{
+		const auto factors = get_tile_pitch_factors(c.pitch);
+		const u32 tiles_per_row = factors.prime * factors.factor;
+		const u32 image_pitch = c.width * c.bpp;
+		const u64 linear_length = u64{image_pitch} * c.height;
+
+		std::vector<u8> expected(linear_length, 0);
+		const rsx::detiler_config conf =
+		{
+			.prime = factors.prime,
+			.factor = factors.factor,
+			.num_tiles_per_row = tiles_per_row,
+			.tile_base_address = c.base,
+			.tile_size = c.size,
+			.tile_address_offset = c.origin_offset,
+			.tile_rw_offset = 0,
+			.tile_pitch = c.pitch,
+			.tile_bank = c.bank,
+			.image_width = c.width,
+			.image_height = c.height,
+			.image_pitch = image_pitch,
+			.image_bpp = c.bpp,
+		};
+		for (u32 row = 0; row < c.height; ++row)
+		{
+			for (u32 col = 0; col < c.width; ++col)
+			{
+				rsx::tiled_dma_copy(row, col, conf, const_cast<char*>(reinterpret_cast<const char*>(tile_memory.data())),
+					reinterpret_cast<char*>(expected.data()), 1 /* RSX_DMA_OP_DECODE_TILE */);
+
+				// The span holds every texel the tiler reads (inside the tile).
+				const u32 offset = m4_tile_offset(row, col, factors.factor, tiles_per_row, c.base, c.origin_offset, c.pitch, c.bank, c.bpp);
+				const tile_span span = get_tile_span(c.base, c.size, c.pitch, tiles_per_row, c.origin_offset, c.width, c.height, c.bpp);
+				if (offset < c.size && (offset < span.start || u64{offset} + c.bpp > span.end))
+				{
+					failure = "a texel's tiled bytes lie outside the staged span";
+					return false;
+				}
+			}
+		}
+
+		const tile_span span = get_tile_span(c.base, c.size, c.pitch, tiles_per_row, c.origin_offset, c.width, c.height, c.bpp);
+		const u32 tiled_length = span.end - span.start;
+		std::vector<u32> data((tiled_length + 3) / 4 + (linear_length + 3) / 4 + 1, 0xDEADBEEFu);
+		std::memcpy(data.data(), tile_memory.data() + span.start, tiled_length);
+		const u32 linear_offset = (tiled_length + 3) & ~3u;
+		const u32 linear_words = static_cast<u32>((linear_length + 3) / 4);
+
+		for (u32 word = 0; word < linear_words; ++word)
+		{
+			u32 value = 0;
+			for (u32 byte_index = 0; byte_index < 4; ++byte_index)
+			{
+				const u32 source = m4_detile_source((word * 4) + byte_index, factors.factor, tiles_per_row, c.base, c.size, c.origin_offset, span.start,
+					c.pitch, c.bank, c.width, c.height, image_pitch, c.bpp, tiled_length);
+				if (source != 0xFFFFFFFFu)
+				{
+					const u32 index = 0 + source;
+					value |= ((data[index >> 2] >> ((index & 3) * 8)) & 0xFF) << (byte_index * 8);
+				}
+			}
+			data[(linear_offset >> 2) + word] = value;
+		}
+
+		if (std::memcmp(reinterpret_cast<const u8*>(data.data()) + linear_offset, expected.data(), linear_length) != 0)
+		{
+			failure = "the decoded rows differ from the CPU tiler";
+			return false;
+		}
+
+		// The padding bytes of the last word are zero.
+		for (u64 i = linear_length; i < u64{linear_words} * 4; ++i)
+		{
+			if (reinterpret_cast<const u8*>(data.data())[linear_offset + i] != 0)
+			{
+				failure = "a padding byte is not zero";
+				return false;
+			}
+		}
+		return true;
+	}
+
+	void test_tiling_math()
+	{
+		// The bank table as arithmetic
+		constexpr u32 table[16] = { 0, 1, 2, 3, 2, 3, 0, 1, 1, 2, 3, 0, 3, 0, 1, 2 };
+		bool lookup_ok = true;
+		for (u32 i = 0; i < 16; ++i)
+		{
+			lookup_ok &= m4_tile_bank_lookup(i) == table[i];
+		}
+		check(lookup_ok, "bank distribution table");
+
+		// Common get_prime_factor
+		check(get_tile_pitch_factors(0x200).prime == 1 && get_tile_pitch_factors(0x200).factor == 2, "pitch 0x200 = 1 x 2");
+		check(get_tile_pitch_factors(0x300).prime == 3 && get_tile_pitch_factors(0x300).factor == 1, "pitch 0x300 = 3 x 1");
+		check(get_tile_pitch_factors(0xD00).prime == 13 && get_tile_pitch_factors(0xD00).factor == 1, "pitch 0xD00 = 13 x 1");
+		check(get_tile_pitch_factors(0x1400).prime == 5 && get_tile_pitch_factors(0x1400).factor == 4, "pitch 0x1400 = 5 x 4");
+		check(get_tile_pitch_factors(0x11 * 256).factor == 0 && get_tile_pitch_factors(0).factor == 0, "unknown pitches");
+
+		// Every RSX tile pitch (rsx::GcmTileInfo: 0x200 .. 0x10000 from the hardware table), banks, texel sizes, origins
+		constexpr u32 pitches[] = { 0x200, 0x300, 0x400, 0x500, 0x600, 0x700, 0x800, 0xA00, 0xC00, 0xD00, 0xE00, 0x1000, 0x1400, 0x1800, 0x1A00,
+			0x1C00, 0x2000, 0x2800, 0x3000, 0x3400, 0x3800, 0x4000, 0x5000, 0x6000, 0x6800, 0x7000, 0x8000, 0xA000, 0xC000, 0xD000, 0xE000, 0x10000 };
+		std::mt19937 rng(20261106);
+		int cases = 0, failed = 0;
+		const char* first_failure = nullptr;
+		for (const u32 pitch : pitches)
+		{
+			for (const u32 bpp : { 1u, 2u, 4u, 8u, 16u })
+			{
+				if (pitch < bpp * 4)
+				{
+					continue;
+				}
+
+				for (int trial = 0; trial < 3; ++trial)
+				{
+					tile_case c{};
+					c.pitch = pitch;
+					c.bpp = bpp;
+					c.base = (trial == 2) ? 0x00012000u : static_cast<u32>((rng() % 64) * 0x10000);  // trial 2: an unaligned base (whole tile)
+					c.bank = rng() % 4;
+					const u32 max_width = std::min<u32>(pitch / bpp, 300);
+					c.width = 1 + rng() % max_width;
+					c.height = 1 + rng() % 150;
+					const u32 x = (max_width > c.width) ? (rng() % (max_width - c.width + 1)) : 0;
+					const u32 y = rng() % 130;
+					c.origin_offset = y * pitch + x * bpp;
+					// A tile that ends inside the region sometimes (texels beyond it stay zero)
+					const u64 needed = u64{c.origin_offset} + u64{c.height} * pitch;
+					c.size = static_cast<u32>((((trial == 1) ? needed / 2 + pitch : needed + 0x20000) + 0xFFFF) & ~0xFFFFull);
+
+					std::vector<u8> memory(c.size);
+					for (auto& b : memory) b = static_cast<u8>(rng());
+
+					const char* failure = nullptr;
+					cases++;
+					if (!run_tile_case(c, memory, failure))
+					{
+						failed++;
+						if (!first_failure)
+						{
+							first_failure = failure;
+							std::fprintf(stderr, "tile case pitch 0x%x bpp %u base 0x%x bank %u origin 0x%x %ux%u size 0x%x: %s\n",
+								c.pitch, c.bpp, c.base, c.bank, c.origin_offset, c.width, c.height, c.size, failure);
+						}
+					}
+				}
+			}
+		}
+		check(failed == 0, "the tile decoder decodes as the CPU tiler", failed, cases);
+
+		// The span of a 64 KiB aligned tile: whole groups of four 16 KiB tiles of the bands the region touches
+		const tile_span span = get_tile_span(0x10000, 0x100000, 0x1000, 16, 0x1000 * 64 + 0x10, 100, 10, 4);
+		check(span.start == 16 * 0x4000 && span.end == 32 * 0x4000, "tile span of one band", span.start, span.end);
+		// Bands 1 and 2 of a 3-tile pitch: tile ids 3 .. 8, so groups 0 .. 11
+		const tile_span odd = get_tile_span(0x10000, 0x100000, 0x300, 3, 0x300 * 64, 10, 70, 4);
+		check(odd.start == 0 && odd.end == 12 * 0x4000, "tile span of a 3-tile pitch rounds to groups of four", odd.start, odd.end);
+		check(get_tile_span(0x12000, 0x40000, 0x1000, 16, 0, 10, 10, 4).end == 0x40000, "an unaligned tile base stages the whole tile");
+
+		check(get_gpu_upload_word_size(CELL_GCM_TEXTURE_A8R8G8B8) == 4 && get_gpu_upload_word_size(CELL_GCM_TEXTURE_R5G6B5) == 2 &&
+			get_gpu_upload_word_size(CELL_GCM_TEXTURE_B8) == 1 && get_gpu_upload_word_size(CELL_GCM_TEXTURE_DEPTH24_D8) == 4 &&
+			get_gpu_upload_word_size(CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT) == 2 && get_gpu_upload_word_size(CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT) == 4 &&
+			get_gpu_upload_word_size(CELL_GCM_TEXTURE_R6G5B5) == 0 && get_gpu_upload_word_size(CELL_GCM_TEXTURE_COMPRESSED_DXT1) == 0,
+			"upload_texture_subresource word sizes (arm64)");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_msl_text(const char* directory)
+	{
+		const std::string compute = m4_shaders::compute_library_source();
+		const std::string resolve = m4_shaders::resolve_library_source();
+		const std::string tiling = m4_shaders::tiling_library_source();
+		check(tiling.find(m4_source::tiling_math) != std::string::npos && tiling.find(std::string("kernel void ") + std::string(m4_shaders::tile_decode_kernel_name) + "(") != std::string::npos,
+			"the tile decoder library holds the tested math and its kernel");
+		check(compute.find("m4_tile_decode_kernel") == std::string::npos, "the conversion kernels do not depend on the tile decoder");
+
+		check(m4_shaders::compute_kernel_names.size() == static_cast<usz>(compute_kernel::count), "one MSL kernel per compute_kernel");
+		for (const auto name : m4_shaders::compute_kernel_names)
+		{
+			// Each kernel is declared once through its M4_*_KERNEL macro
+			const std::string declaration = "(" + std::string(name) + ",";
+			const usz first = compute.find(declaration);
+			check(first != std::string::npos && compute.find(declaration, first + 1) == std::string::npos, "kernel declared once", static_cast<long long>(first));
+		}
+
+		for (const char* function : { "m4_resolve_vertex", "m4_color_resolve", "m4_color_unresolve", "m4_depth_resolve", "m4_depth_unresolve",
+			"m4_depth_stencil_resolve", "m4_depth_stencil_unresolve" })
+		{
+			check(resolve.find(std::string(" ") + function + "(") != std::string::npos, "resolve function present");
+		}
+
+		// The C++ and MSL halves of the dual sources are the same tokens
+		check(m4_source::conversion_math.find("m4_pack_e4m12_pack16") != std::string_view::npos &&
+			m4_source::resolve_math.find("m4_unresolve_target_y") != std::string_view::npos, "dual sources stringized");
+		check(compute.find(m4_source::conversion_math) != std::string::npos && resolve.find(m4_source::resolve_math) != std::string::npos,
+			"the libraries hold the tested math");
+
+		if (directory)
+		{
+			std::ofstream(std::string(directory) + "/m4_compute.metal", std::ios::binary) << compute;
+			std::ofstream(std::string(directory) + "/m4_resolve.metal", std::ios::binary) << resolve;
+			std::ofstream(std::string(directory) + "/m4_tiling.metal", std::ios::binary) << tiling;
+		}
+	}
+}
+
+int main(int argc, char** argv)
+{
+	test_slot_pool();
+	test_query_rules();
+	test_conversion_math();
+	test_resolve_math();
+	test_msaa_config();
+	test_dispatch_params();
+	test_typeless_selection();
+	test_tiling_math();
+	test_msl_text(argc > 1 ? argv[1] : nullptr);
+
+	if (g_failures)
+	{
+		std::fprintf(stderr, "%d of %d checks failed\n", g_failures, g_checks);
+		return 1;
+	}
+
+	std::printf("PASS: Metal M4 unit (%d checks)\n", g_checks);
+	return 0;
+}
