+template <class F>
+double measure(F f, unsigned n)
+{
+	u64 r = 0;
+	auto t = std::chrono::steady_clock::now();
+	for (unsigned i = 0; i < n; ++i)
+	{
+		asm volatile("" ::: "memory");
+		r += f(i);
+	}
+	sink = r;
+	return std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - t).count() / n;
