@@ -0,0 +1,6 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_THREAD_ORCHESTRATOR_665 was removed in Core 668 (maintainer decision of 5 November 2026:
+// abandoned, it added complexity without a measured gain). No source includes this header; it stays
+// in the canonical delta only because that delta never drops a file.
diff --git a/rpcs3/ios/IOSThreadQoS.h b/rpcs3/ios/IOSThreadQoS.h
new file mode 100644
index 0000000..b1d21f2
--- /dev/null
+++ b/rpcs3/ios/IOSThreadQoS.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+
+// CELL567_THREAD_QOS: iOS schedules threads by QoS class and, within a class,
+// by relative priority (0 down to QOS_MIN_RELATIVE_PRIORITY, -15). RPCS3 raises
+// the RSX thread and the two audio threads "above other threads" (priority +1)
+// and lowers compilers and loggers (-1); on iOS +1 and the default 0 were the
+// same user-interactive class at relative priority 0, so the RSX thread had no
+// precedence over the SPU and PPU threads when they oversubscribe the two
+// performance cores (God of War III on build 565: about 4.7 cores requested,
+// RSX FIFO 85-90 % busy at 0.57 core). Threads that ask for nothing now run one
+// step below the raised ones in the same class.
+//
+// The native worker pool also reuses threads: a worker that ran a thread which
+// lowered itself (shader cache writer: set_native_priority(-1), never restored)
+// kept the utility class for the next thread it ran, an SPU or PPU thread for
+// instance. Each job now starts at the default level.
+//
+// REWINDBOX_SPU_QOS_627: relative priorities order threads inside one class, and the
+// iPhone has two performance cores for all of them. Build 622 and 624 logs: God of War III's
+// RSX thread is CPU bound (0.65-0.83 core, FIFO busy 78-96 %, GPU 30-40 % busy) beside 3.0-3.6
+// SPU cores; Black Ops II's six SPU threads take 3.3-5.3 cores of six. With this setting
+// SPU threads run in the user-initiated class, one class below the PPU, RSX and MoltenVK
+// threads: those keep the performance cores whenever they are runnable, and SPU threads
+// take what is left, the four efficiency cores and any idle performance core. A
+// user-initiated thread still runs at once on an idle core, so the guest's SPU work
+// does not wait for a free slot; it runs slower while the others need the fast cores.
+// The compile threads (utility class) and the idle worker pool stay as they are: their
+// load in game is compile_cores=0.000.
+namespace rpcs3::ios::thread_qos
+{
+// Relative priority of threads that request no priority while the ordering is on.
+constexpr int lowered_relative_priority = -2;
+inline std::atomic<int> default_relative_priority{0};
+
+// REWINDBOX_SPU_QOS_627: the thread_ctrl::set_native_priority() value of an SPU thread.
+constexpr int spu_native_priority = -2;
+
+struct level
+{
+	bool utility;           // QOS_CLASS_UTILITY instead of QOS_CLASS_USER_INTERACTIVE
+	int relative_priority;  // pthread_set_qos_class_self_np's relative priority
+	bool user_initiated = false; // REWINDBOX_SPU_QOS_627: QOS_CLASS_USER_INITIATED
+};
+
+// thread_ctrl::set_native_priority(priority); 0 is also every pooled job's start.
+inline level for_priority(int priority) noexcept
+{
+	if (priority == spu_native_priority)
+	{
+		return {false, 0, true};
+	}
+
+	if (priority < 0)
+	{
+		return {true, 0};
+	}
+
+	if (priority > 0)
+	{
+		return {false, 0};
+	}
+
+	return {false, default_relative_priority.load(std::memory_order_relaxed)};
+}
+}
diff --git a/rpcs3/ios/IOSTitleLevers.h b/rpcs3/ios/IOSTitleLevers.h
new file mode 100644
index 0000000..16d3ffb
--- /dev/null
+++ b/rpcs3/ios/IOSTitleLevers.h
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <string_view>
+
+// CELL575_TITLE_LEVERS: titles whose build 567 logs show the bottleneck an
+// existing lever removes, so that lever's Automatic mode includes them.
+// - Call of Duty: Black Ops II (SPU and RSX bound, accurate reservations on):
+//   3.5-10 million failed SPU PUTLLC per 5 s window (the no-op write-back
+//   pattern of Dragon Ball Z before 565), and 9-16 ms of texture preparation
+//   per frame at about 5,270 draws, every texture lookup hashing again.
+// - Bladestorm: The Hundred Years' War (30 fps, main PPU thread 18.8 ms per
+//   frame): an RSX thread at 0.66 core for a FIFO busy 31 % of the time, and
+//   7.4 ms of texture preparation per frame.
+// Only serials seen in those logs or in the shipped catalogue are listed.
+//
+// CELL585_EARLY_SUBMIT_GOW3: God of War III (the six serials of
+// is_god_of_war_iii_title) joins Dragon Ball Z in the Automatic mode of early
+// command buffer submission (561). Its build 583 logs show Dragon Ball Z's
+// pattern before 561: the guest reads one 1280x720x4 render target back every
+// frame (one READBACK555 fault_read per frame, 3.69 MB each) and waits for the
+// GPU, 2.1-6.7 ms per frame and 0.8-1.06 s per 5 s window in the ~700-draw
+// scenes, with Multithreaded RSX on.
+//
+// CELL587_MVK_ENCODE_BARRIER: God of War III is the Automatic title of
+// asynchronous MoltenVK submits (ios/IOSMoltenVKExec.h, IOSMoltenVKAsyncCanary.h).
+// Its build 583 logs spend 490-640 ms per 5 s window in vkQueueSubmit (1,200-2,500
+// submits, RSXSYNC551 submit=), the Metal encoding of synchronous submits, on the
+// RSX offloader thread that the RSX thread waits for at each submission.
+//
+// CELL589_TITLE_LEVERS: Assassin's Creed joins the texture validation epoch
+// (559) and the scoped revalidation (573), the two levers of Black Ops II and
+// Bladestorm (575). Its first build 585 run (BLES00158) is bound by the RSX
+// thread in the game scenes (10-29 fps; RSX thread 0.4-0.8 core, FIFO busy
+// 70-96 %) at 1,000-3,300 draws per frame, with 14-45 ms of texture
+// preparation per frame (RSXFRAME551 texture_ms) and no epoch (OPT559
+// texture_epoch=0): every texture lookup hashing again.
+// Serials of the shipped cheat catalogue (BLES00158, BLUS30089).
+//
+// REWINDBOX_POSITION_INVARIANCE_610: Black Ops II (weapon and forearm
+// corruption, reported since it became playable with 587) and Assassin's Creed
+// (flicker on torch-lit walls) are still reported on the delivered 608, whose
+// colour-feedback copy, sampler refresh and vertex-range corrections left
+// RENDERCAUSE at zero in those scenes on the 601 logs. On Apple GPUs every
+// RPCS3 shader is compiled with MTLMathModeFast: its SPIR-V carries no float
+// controls, so SPIRV-Cross reports every fast-math flag and MoltenVK selects
+// them. No vertex shader declares an invariant position, so MoltenVK never
+// requests preserveInvariance either. Two pipelines that compute the same RSX
+// position may then round it differently, and a later pass that tests against
+// the depth of an earlier one (EQUAL light pass, depth prepass) fails on some
+// pixels. RPCS3 already forces position invariance on NVIDIA ("PS3 has shader
+// invariance"); these titles get the same declaration on iOS. It is the
+// hypothesis to check on the same iPhone scenes, not a measured fix. Their
+// vertex SPIR-V changes once, so their vertex Metal libraries are compiled again
+// on the next boot; fragment shaders and the PPU/SPU caches are unchanged.
+//
+// REWINDBOX_AC_MVK_ASYNC_610: Assassin's Creed joins God of War III in the
+// Automatic mode of asynchronous MoltenVK submits (CELL587). Its build 601 game
+// windows 22-37 (PID 55119, 27-36 fps) keep the RSX FIFO busy 60-97 % and spend
+// 0.93-1.36 s per 5 s window inside vkQueueSubmit (4,065-5,435 submits, RSXSYNC
+// submit=), the Metal encoding that the RSX thread waits for at each submission,
+// above the 490-640 ms that made God of War III the first Automatic title. The
+// boot canary of 587 still returns the title to synchronous submits after a boot
+// that did not finish. No frame-rate gain is measured yet.
+namespace rpcs3::ios::title_levers
+{
+constexpr bool is_black_ops_ii_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES01717";
+}
+
+constexpr bool is_bladestorm_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES00113" || title_id == "BLUS30070";
+}
+
+constexpr bool is_assassins_creed_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES00158" || title_id == "BLUS30089";
+}
+
+// REWINDBOX_NATIVE_HALF_907 / REWINDBOX_LOAD_OP_CLEAR_907: GPU-bound in play (IPA 676).
+constexpr bool wants_gpu_work_reduction_907(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id);
+}
+
+// REWINDBOX_POSITION_INVARIANCE_610
+constexpr bool requires_position_invariance(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id) || is_assassins_creed_title(title_id);
+}
+
+// REWINDBOX_ZCLIP_WINDOW_Z_616: Black Ops II draws an object in front of the
+// whole scene with the clip range [1, 1e19] and a viewport Z scale of 1e19
+// over an offset of 1 (window Z = 1 + 1e19 * z_ndc), reversed depth GEQUAL.
+// The RSX capture of BLES01717 attached to RPCS3 issue #13227 (RRC v5,
+// 4,023 draws) holds 26 such draws: a 12-draw depth prepass right after the
+// depth clear, before the 1,544-draw scene prepass, the same 12 draws in the
+// colour pass (GEQUAL against that prepass) and 2 blended draws without
+// depth write. Without float64 nor an unrestricted depth range (MoltenVK),
+// the vertex fallback compresses Z above 1 into [0.99, 1] from clip-space Z
+// (pos.z), not window Z: pos.z - 1 over 1e19 - 1 is the clip-space z_clip,
+// constant (the near distance) for a reversed infinite projection, so every
+// fragment of these draws gets the same depth. The colour pass then keeps the
+// last triangle drawn on a pixel instead of the nearest one: back parts of
+// the forearm and weapon show through the front ones. Compressing the window
+// Z ((d - 1) / (1e19 - 1) = z_ndc) keeps their depth order inside the band.
+// The vertex shader text of this title changes once, so its vertex Metal
+// libraries are compiled again on the next boot.
+constexpr bool requires_zclip_fallback_window_z(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_SPU_OBJECT_PREFETCH_616 (ios/IOSSpuObjectPrefetch.h): Black Ops II
+// opens 7,162 cached SPU objects in the first 5 s of a multiplayer match on the
+// Build 614 logs (4.3 s of file reads on the compile threads, a 2.0 s frame).
+// REWINDBOX_SPU_PREFETCH_AC_634: Assassin's Creed reads 4,000 objects from the disk in its first
+// minute on the Build 629 logs, 0.4 to 0.7 ms each and 7 ms for the first after an idle period;
+// Black Ops II reads the same size of object in 0.02 ms from this prefetch. The SPU Object Prefetch
+// setting tests each mode per game.
+constexpr bool requires_spu_object_prefetch(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id) || is_assassins_creed_title(title_id);
+}
+
+// REWINDBOX_ZCULL_ON_DEMAND_619 (ios/IOSZcullOnDemand.h): Assassin's Creed waits
+// 4.1-4.3 s of each 5 s window in ZCULL_control::sync() on the Build 617 logs
+// (2,200-2,900 waits, ~33 per frame at 14 FPS) once a report page was read.
+// REWINDBOX_ZCULL_DEMAND_BO2_621: Black Ops II takes the same upstream switch at
+// every boot (Build 620 logs, PIDs 66891/66907/66957: COREPROF ZCULLDEMAND619
+// upstream_disables=1:0:0, a PPU/SPU access, in the first window of the single
+// player and of the multiplayer executable), then waits 1.1-1.9 s of each 5 s
+// multiplayer window in ZCULL_control::sync() (200-390 GPU syncs) at 20-35 FPS.
+// The ZCULL On-Demand Reads setting overrides the list per game (A/B test).
+constexpr bool requires_zcull_on_demand(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id) || is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_ZCULL_WAIT_GUARD_627: the guest-wait rules of the guard do not apply to these
+// titles (ios/IOSZcullOnDemand.h); REWINDBOX_ZCULL_COND_NO_WAIT_627: their conditional renders
+// draw without waiting (ios/IOSZcullLabelPage.h). Build 624 logs (PID 1893).
+
+// REWINDBOX_SPU_NOOP_SPIN_WAIT_627 (ios/IOSSpuNoopSpin.h): Black Ops II on the Build 624
+// logs (3.3-5.3 SPU cores, 5-7 million PUTLLC per 5 s window, getllar_poll=0). God of War III
+// joins it in the policy (is_god_of_war_iii_title): Build 622 run, 3.0-3.6 SPU cores and 2-3
+// million PUTLLC per window on the same relaxed reservations. A title without such
+// a loop never reaches the wait. Automatic stays off for other titles.
+constexpr bool wants_spu_noop_spin_wait(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_SPU_DIRECT_OBJECT_HIT_660 (ios/IOSSpuObjectBindings.h): every title. IPA 657 (Core 655):
+// Black Ops II links 8,700-8,800 SPU blocks at the first transition of each boot, all object-cache
+// hits (session 2 window 5: 8,793), each spending about 0.19 ms of spu_build on an IR that only names
+// the object's symbols, next to 0.18 ms of object load. The direct link binds the same functions under
+// the same names and publishes the block the same way, so no title needs to keep the IR path; the
+// SPU Direct Object Hits setting (Disabled) restores it per game.
+constexpr bool wants_spu_direct_object_hits(std::string_view /*title_id*/) noexcept
+{
+	return true;
+}
+
+// REWINDBOX_ZCLIP_PINNED_AFFINE_619: refines REWINDBOX_ZCLIP_WINDOW_Z_616. The
+// fallback compresses only window Z in (1, far] and passes every other vertex
+// through unchanged. The pinned draws of the #13227 capture keep depth clip on
+// and clamp off (NV4097_SET_ZMIN_MAX_CONTROL = 1): a triangle with one vertex
+// beyond the RSX clip range (in front of the near plane, window Z > 1e19) then
+// mixes one unchanged vertex (Z/W of about 1e19) with compressed ones (about
+// 0.99), and Vulkan clips the edge almost at the compressed vertex: the part of
+// the first-person arm that crosses the near plane vanishes instead of being
+// clipped at the near plane. For a clip range wholly above 1, every vertex now
+// takes the same affine map of [near, far] onto [0.99, 1], unclamped, so the
+// hardware clips exactly where the RSX clips (window Z = far); vertices in
+// (1, far] keep the 616 formula.
+constexpr bool requires_zclip_pinned_affine(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_BO2_MVK_ASYNC_619: Black Ops II joins God of War III and Assassin's
+// Creed in the Automatic mode of asynchronous MoltenVK submits (CELL587, boot
+// canary kept). Build 617 multiplayer windows 18-28 (PID 65755, session 3, 30 fps,
+// mvk_async=0) spend 0.80 s per 5 s window inside vkQueueSubmit on the RSX thread
+// (RSXSYNC551 submit=1051:796.9 ms), 4-27 ms in the 45-120 ms frames.
+constexpr bool joins_mvk_async_automatic_619(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_EARLY_SUBMIT_BOUNDARY_659: Assassin's Creed and Black Ops II join the
+// Automatic mode of early command buffer submission (561), in the boundary mode.
+// IPA 657 (Core 655, PID 10471): every Assassin's Creed command buffer other than
+// the flip one is a ZCULL sync-hint flush (GPUTIME621 queue_submits = frames +
+// ZCULLSYNC613 hint_flushes in every window, 344 = 118 + 226 in window 1:42); the
+// game waits on each ZCULL report for the whole command buffer that holds its
+// query (ZCULLDEMAND619 32.0 ms per frame against 30.5 ms of GPU busy), then
+// records the rest of the frame while the GPU has nothing queued: GPU idle per
+// frame (8.7-13.0 ms, 23-32 % of the interval) equals the sampled RSX recording
+// time plus one 2.1-3.6 ms hand-off within 0.7 ms in four of six windows.
+// Black Ops II (GPU 25-35 % busy) waits 12.5 ms per ZCULL report on average for
+// the GPU side of the round trip (window 3:16: 1566.5 ms over 107 waits, pickup
+// and service 2.1 ms). OPT561 early_submits=0 for both.
+constexpr bool early_submit_at_pass_boundary(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id) || is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_TEXTURE_LOOKUP_MEMO_660 (ios/IOSTextureLookupMemo.h): IPA 657 (Core 655, PID 10471). Assassin's
+// Creed, window 1:42: 904 texture lookups per frame for 1,515 draws (TEXCACHE621 upload_calls 106,705 over 118
+// frames), 61 % of them confirmed without hashing because the same section was already validated in the same
+// epoch (OPT559 epoch_skips 64,999), 5.03 ms of texture stage per sampled frame (RSXFRAME551) and 29 CPU uploads
+// in the window: the Automatic title whose memo hits are served. Black Ops II, windows 3:12-3:16, shows the same
+// counters (1,243-1,545 lookups per frame, 48-51 % epoch skips, 4.0-5.7 ms of texture stage) but 248-293 CPU
+// uploads per window, each of which ends every entry: its Automatic mode verifies every hit (the full lookup
+// runs and its result is used), so TEXMEMO660 measures what it would gain before any hit is served.
+constexpr bool serves_texture_lookup_memo(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id);
+}
+
+constexpr bool verifies_texture_lookup_memo(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_ZCULL_WATCHED_FLUSH_660 (ios/IOSZcullWatched.h): Assassin's Creed submits the command buffer
+// of a report queued into a slot a guest waited for at the next point without an open render pass. IPA 657
+// (Core 655, PID 10471): Assassin's Creed waits 32.0 ms per frame for its reports (window 1:42,
+// ZCULLDEMAND619 waits=259:3779.8 ms) for 30.5 ms of GPU work, each wait covering the whole command buffer
+// of the report, submitted only when the guest asked for it. Not Black Ops II: its host model learns no slot
+// (reads less than 1 ms after their report), and with more than 2,048 reports in flight the extra
+// submissions lengthen the synchronous reads at query exhaustion (model: 45.8 -> 67.0 ms per frame).
+constexpr bool zcull_watched_flush(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id);
+}
+
+// REWINDBOX_ZCULL_DEPTH_GUARD_660 (ios/IOSZcullWatched.h): at the ZCULL queue-depth limit the same titles
+// submit the open command buffer only while it holds the oldest pending query. IPA 657: Black Ops II frames
+// of about 140 submissions in windows 3:12-3:13 (ZCULLSYNC613 hint_flushes 2,844 and 2,861 per window).
+constexpr bool zcull_depth_guard(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id) || is_black_ops_ii_title(title_id);
+}
+}
diff --git a/rpcs3/ios/IOSTransitionPhases.h b/rpcs3/ios/IOSTransitionPhases.h
new file mode 100644
index 0000000..ecf9024
--- /dev/null
+++ b/rpcs3/ios/IOSTransitionPhases.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_TRANSITION_PHASES_610: timestamps (get_system_time, microseconds)
+// that split phase 6 of a boot or internal SELF transition (PPU/SPU start) on
+// the next device journal: the RSX thread's RunPPU dispatch after its warmup,
+// UIKit's execution of RunPPU, and the starting->running transition that
+// FinalizeRunRequest reports from an emulator thread. Stores only; nothing is
+// written to a journal from UIKit and no guest state depends on these values.
+namespace rpcs3::ios::transition_phases
+{
+inline std::atomic<std::uint64_t> runppu_dispatch_us{0};
+inline std::atomic<std::uint64_t> runppu_main_us{0};
+
+// Milliseconds since a recorded timestamp, or -1 when none was recorded.
+inline double since_ms(std::uint64_t now_us, std::uint64_t then_us) noexcept
+{
+	return then_us && now_us >= then_us ? static_cast<double>(now_us - then_us) / 1000.0 : -1.0;
+}
+}
diff --git a/rpcs3/ios/IOSWriterLockPhases.h b/rpcs3/ios/IOSWriterLockPhases.h
new file mode 100644
index 0000000..9206aec
--- /dev/null
+++ b/rpcs3/ios/IOSWriterLockPhases.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_WRITER_LOCK_PHASES_908: Black Ops II (BLES01717), IPA 694 device log, RANGELOCKPROF
+// wl_putllc=38814:229.833:0.956 (count:acquire_ms:hold_ms): an SPU PUTLLC that takes the heavyweight writer
+// lock waits about 5.9 us to acquire it and holds it 0.025 us. The acquisition has three phases (vm.cpp,
+// vm::writer_lock): the range-lock bit of the writer (bits), the range locks of other threads over the line
+// (ranges), and every running PPU thread reaching cpu_flag::wait after cpu_flag::memory (park). Counted for the
+// SPU PUTLLC source only, reported in RANGELOCKPROF as wl_putllc_phases=bits_ms:ranges_ms:park_ms,
+// wl_putllc_flagged (PPU threads asked to park), wl_putllc_slow_parks (parks over 50 us) and
+// wl_putllc_park_max_us. Measurement only: the lock protocol is unchanged.
+namespace rpcs3::ios::writer_lock_phases
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> bits_ticks{0}, ranges_ticks{0}, park_ticks{0};
+	std::atomic<std::uint64_t> flagged{0}, slow_parks{0}, park_max_ticks{0};
+};
+
+inline counters_t counters;
+
+inline void record(std::uint64_t bits, std::uint64_t ranges, std::uint64_t park, std::uint64_t flagged, std::uint64_t slow_threshold) noexcept
+{
+	counters.bits_ticks.fetch_add(bits, std::memory_order_relaxed);
+	counters.ranges_ticks.fetch_add(ranges, std::memory_order_relaxed);
+	counters.park_ticks.fetch_add(park, std::memory_order_relaxed);
+	counters.flagged.fetch_add(flagged, std::memory_order_relaxed);
+	if (park > slow_threshold)
+	{
+		counters.slow_parks.fetch_add(1, std::memory_order_relaxed);
+	}
+	std::uint64_t seen = counters.park_max_ticks.load(std::memory_order_relaxed);
+	while (park > seen && !counters.park_max_ticks.compare_exchange_weak(seen, park, std::memory_order_relaxed))
+	{
+	}
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::writer_lock_phases
diff --git a/rpcs3/ios/IOSZcullLabelPage.h b/rpcs3/ios/IOSZcullLabelPage.h
new file mode 100644
index 0000000..0d8ecea
--- /dev/null
+++ b/rpcs3/ios/IOSZcullLabelPage.h
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_ZCULL_LABEL_PAGE_624: Build 622 logs (PID 1459, Assassin's Creed, session 3):
+// the ZCULL on-demand lever served 411 GCM label reads and 33 report reads in one
+// window, the guest thread TaskThread1 waited 422/469/456 ms in three seconds and the
+// lever tripped (wait_budget); the rest of the boot ran the upstream mode, 2,400-2,900
+// ZCULL syncs and 4.1-4.3 s of the RSX thread blocked per 5 s window, 13-17 FPS.
+// The labels (offset 0x0000) and notify slots (0x1000) of the RSX reports block share
+// the first host page with reports 0-703 (0x1400): with 16 KiB host pages every label
+// poll of the game faulted whenever one of those reports was pending, and each fault
+// wrote every claimed report. lv2 returns the block's address to the game
+// (sys_rsx_context_allocate, lpar_reports); every RSX, GCM and ZCULL address derives
+// from it. Placing the block so that its report array begins on a host page leaves the
+// labels and notify slots on a page that never holds a report: a label read never
+// waits, a report read still waits for its value. The PS3 layout of the block
+// (labels, notify, reports and their offsets in RsxDriverInfo) is unchanged.
+namespace rpcs3::ios::zcull_label_page
+{
+// The shift lv2 applied to the reports block of the running boot (0 without the lever),
+// for the COREPROF ZCULL624 line.
+inline std::atomic<std::uint32_t> g_applied_shift{0};
+
+// The offset to add to the block's address so that `report_offset` lands on a page
+// boundary of `page_size` bytes (0 when it already does, or for a page size that is
+// not a power of two).
+constexpr std::uint32_t offset(std::uint32_t report_offset, std::uint32_t page_size) noexcept
+{
+	if (page_size == 0 || (page_size & (page_size - 1)) != 0)
+	{
+		return 0;
+	}
+
+	const std::uint32_t remainder = report_offset % page_size;
+	return remainder ? page_size - remainder : 0;
+}
+}
+
+// REWINDBOX_ZCULL_COND_PREVIOUS_624: Build 622 logs (Black Ops II multiplayer): the RSX
+// thread waited for the occlusion result of a conditional render 112-123 times per 5 s
+// window, 0.9-1.2 s in all (8-10 ms each), on top of the forced report passes. MoltenVK
+// has no conditional rendering, so RPCS3 waits on the CPU for the GPU to finish the
+// query that predicates the draws. With the ZCULL on-demand lever, when that query is
+// still on the GPU and the report it writes already holds a non-zero value (the object
+// was visible at its previous evaluation), the draws are emitted now instead of
+// waiting; a report holding 0 still waits, so an object the game would show is never
+// hidden. An object hidden in this frame but visible in the previous one is drawn one
+// evaluation longer, behind whatever hides it.
+//
+// REWINDBOX_ZCULL_COND_NO_WAIT_627: Build 624 logs (PID 1893, Black Ops II, session 2):
+// 841-1,002 evaluations per window drew on the previous value, and the 88-120 that found a
+// report holding 0 still took 1.3-2.6 s of the RSX thread per window, 13-26 ms each: the
+// largest ZCULL cost left, at 28 % GPU occupancy. For a depth-tested draw, skipping is only an
+// optimization: a conditional render asks to leave out an object that its query found hidden,
+// and drawing it anyway leaves it hidden behind what hides it, at the price of its GPU time.
+// So with the setting, a query still on the GPU never waits for such a draw (`no_wait`),
+// whatever its report holds. A draw the depth test cannot hide (a flare or corona over the
+// scene) keeps the 624 rule: a report holding 0 waits, or the effect would show through walls.
+// A query already complete is evaluated as before, so an object known to be hidden is skipped.
+namespace rpcs3::ios::zcull_cond_previous
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> previous{0}; // evaluations that drew on the previous visible value
+	std::atomic<std::uint64_t> waited{0};   // evaluations that waited (not ready and report 0)
+	std::atomic<std::uint64_t> ready{0};    // evaluations whose query was already complete
+};
+
+inline counters_t& counters() noexcept
+{
+	static counters_t s_counters;
+	return s_counters;
+}
+
+enum class decision
+{
+	wait,     // wait for the query, as upstream
+	previous, // draw now: the report already shows the object visible
+};
+
+// The decision for a pending evaluation. `ready`: the newest query of the evaluation
+// has its result on the host (check_occlusion_query_status); `report_value`: the value
+// field of the report at the evaluation address (read through the unprotected view);
+// `no_wait`: REWINDBOX_ZCULL_COND_NO_WAIT_627.
+constexpr decision decide(bool lever, bool ready, std::uint32_t report_value, bool no_wait = false) noexcept
+{
+	return (lever && !ready && (report_value != 0 || no_wait)) ? decision::previous : decision::wait;
+}
+}
+
+// REWINDBOX_ZCULL_CONSERVATIVE_627: the mode where no report ever makes anything wait. A
+// queued report is written at once with a value that reads "visible", no page is locked,
+// no label waits, and the GPU result replaces it when the query completes, in the usual
+// update() pass. A guest that reads the report before that gets "visible" and draws the
+// object; one that reads it later gets the real value. It differs from Relaxed ZCULL
+// Sync, which leaves the previous bytes of the slot in place (Assassin's Creed BLES00158,
+// Build 612: torches and lights flickered). Whether a guest can see the difference between
+// "visible" and the real value is a device question: off for every title by default, and
+// the ZCULL On-Demand Reads lever keeps exact values.
+
+// REWINDBOX_ZCULL_FAULT_CENSUS_624: who reaches into a page ZCULL holds locked, for the
+// next reading of the Black Ops II "other" faults (Build 622: 60-120 per window, 885 ms
+// of guest waits, outside the GCM report block): the thread class of every on-demand
+// fault and the last address of an "other" fault. Counting changes no fault handling.
+namespace rpcs3::ios::zcull_fault_census
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> ppu{0};
+	std::atomic<std::uint64_t> spu{0};
+	std::atomic<std::uint32_t> other_last{0};     // guest address of the last "other" fault
+	std::atomic<std::uint32_t> other_last_spu{0}; // 1 when an SPU made it
+};
+
+inline counters_t& counters() noexcept
+{
+	static counters_t s_counters;
+	return s_counters;
+}
+}
