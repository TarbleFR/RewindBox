+// NEOSTATION_BUILD487_DIAGNOSTICS_V1: FREEZE_DUMP (brief § 3.1 / § 3.3).
+//
+// Every record starts with "FREEZE_DUMP " (whitelisted by the host filter).
+// A complete snapshot is emitted in one message and retained as one durable
+// freeze_snapshot milestone. Per dump: one begin line, one rsx line, SPU threads first, then
+// PPU threads, one end line; at most 64 lines of at most 1 KiB. Thread
+// references are collected under the idm reader lock, which is only tried
+// (a busy or queued writer makes the dump give up instead of blocking the
+// profiler thread), with the three idm::select passes run unlocked inside
+// it; a group's SPU threads are copied under that group's own mutex, also
+// only tried. The emulator must still be running after the collection, and
+// the formatting happens after every lock is released. Member reads are
+// plain loads of the fields other diagnostics (dump_misc) already read from
+// foreign threads; nothing is written to the emulated threads.
+
+LOG_CHANNEL(ios_freeze_dump, "iOS Freeze Dump");
+
+namespace
+{
+std::mutex s_dump_mutex; // try-locked: a concurrent caller gives up
+u64 s_last_dump_us = 0;  // guarded by s_dump_mutex
+u64 s_suppressed = 0;    // requests refused (rate limit, busy idm lock) since the last dump
+u64 s_dump_index = 0;
+
+using rpcs3::ios::profiler::bound_line;
+using rpcs3::ios::profiler::sanitize_token;
+
+std::string cpu_state_token(const cpu_thread& cpu)
+{
+	return sanitize_token(fmt::format("%s", cpu.state.load()));
+}
+
+std::string ppu_line(const ppu_thread& ppu)
+{
+	const char* function = ppu.current_function;
+	const char* last = ppu.last_function;
+	const u64 wait_start = ppu.start_time;
+
+	// REWINDBOX_FREEZE_DEEP_621: r3-r10 (a waiting syscall's arguments: r3 is the
+	// semaphore id of sys_semaphore_wait), lr, ctr and the reservation.
+	std::string line = fmt::format(
+		"FREEZE_DUMP ppu id=0x%x name=%s state=%s pc=0x%x prio=%d func=%s last=%s wait_s=%.3f "
+		"r3=0x%llx r4=0x%llx r5=0x%llx r6=0x%llx r7=0x%llx r8=0x%llx r9=0x%llx r10=0x%llx lr=0x%llx ctr=0x%llx raddr=0x%x rtime=0x%llx",
+		ppu.id, sanitize_token(ppu.get_name()), cpu_state_token(ppu), ppu.cia, ppu.prio.load().prio,
+		sanitize_token(function ? function : ""), sanitize_token(last ? last : ""),
+		wait_start ? (get_guest_system_time() - wait_start) / 1000000. : 0.0,
+		ppu.gpr[3], ppu.gpr[4], ppu.gpr[5], ppu.gpr[6], ppu.gpr[7], ppu.gpr[8], ppu.gpr[9], ppu.gpr[10],
+		ppu.lr, ppu.ctr, ppu.raddr, ppu.rtime);
+	return bound_line(line);
+}
+
+// REWINDBOX_FREEZE_DEEP_621: guest bytes in hex, read through the unprotected view
+// (a ZCULL-locked report page would otherwise fault on the profiler thread) and
+// only where the page is mapped and readable; "-" otherwise.
+std::string guest_hex(u32 addr, u32 size)
+{
+	if (!addr || !vm::check_addr(addr, vm::page_readable, size))
+	{
+		return "-";
+	}
+
+	const u8* bytes = vm::get_super_ptr<u8>(addr);
+	std::string out;
+	out.reserve(size * 2);
+	for (u32 i = 0; i < size; i++)
+	{
+		fmt::append(out, "%02x", bytes[i]);
+	}
+	return out;
+}
+
+// One running PPU thread: 16 samples of its pc about 1 ms apart (does the spin
+// move?), the 32 instruction words around it and the line it holds reserved.
+std::string ppu_code_line(const ppu_thread& ppu)
+{
+	std::string samples;
+	for (int i = 0; i < 16; i++)
+	{
+		fmt::append(samples, "%s%x", i ? ":" : "", ppu.cia);
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+
+	const u32 pc = ppu.cia;
+	const u32 code = pc >= 0x40 ? pc - 0x40 : 0;
+	const u32 reserved = ppu.raddr & -128;
+	std::string line = fmt::format(
+		"FREEZE_DUMP ppu_code id=0x%x pcs=%s code_at=0x%x code=%s raddr=0x%x line=%s",
+		ppu.id, samples, code, guest_hex(code, 128), reserved, reserved ? guest_hex(reserved, 128) : std::string("-"));
+	return bound_line(line);
+}
+
+// REWINDBOX_FREEZE_POLLER_908: a PPU thread that polls with a timed sleep or a yield
+// (Black Flag, builds 676 and 694: TaskThread1 in sys_timer_usleep(30) at 0x5e33f8 while
+// every other thread waits). The waiting-state filter of ppu_code_line skipped it, so the
+// loop it runs and the words it tests were never seen. Its loop around lr (the call
+// returns there), r13-r31 and, for each that is a readable guest address, 16 bytes there.
+bool is_polling_call(const char* function)
+{
+	return function && (std::strcmp(function, "sys_timer_usleep") == 0 || std::strcmp(function, "sys_timer_sleep") == 0 ||
+		std::strcmp(function, "sys_ppu_thread_yield") == 0);
+}
+
+std::string ppu_poller_line(const ppu_thread& ppu)
+{
+	const u32 lr = static_cast<u32>(ppu.lr);
+	const u32 code = lr >= 0x80 ? lr - 0x80 : 0;
+	std::string regs, words;
+	u32 shown = 0;
+	std::vector<u32> seen;
+	for (u32 r = 13; r < 32; r++)
+	{
+		const u64 value = ppu.gpr[r];
+		fmt::append(regs, "%s%llx", r == 13 ? "" : ":", value);
+		const u32 addr = static_cast<u32>(value) & ~15u;
+		if (value >> 32 || addr < 0x10000 || shown >= 10 || std::find(seen.begin(), seen.end(), addr) != seen.end() ||
+			!vm::check_addr(addr, vm::page_readable, 16))
+		{
+			continue;
+		}
+		seen.push_back(addr);
+		fmt::append(words, "%sr%u@%x=%s", shown ? "," : "", r, addr, guest_hex(addr, 16));
+		shown++;
+	}
+	std::string line = fmt::format("FREEZE_DUMP ppu_poller id=0x%x func=%s pc=0x%x lr=0x%x code_at=0x%x code=%s r13_31=%s words=%s",
+		ppu.id, sanitize_token(ppu.current_function ? ppu.current_function : ""), ppu.cia, lr, code, guest_hex(code, 256), regs,
+		words.empty() ? std::string("-") : words);
+	return bound_line(line);
+}
+
+// REWINDBOX_FREEZE_POLLER_908: a lightweight condition the PPU threads wait on, its
+// lightweight mutex (guest sys_lwmutex_t: owner, waiter, attribute, recursion,
+// sleep queue) and the waiting threads, so the thread that must signal it is named.
+struct lwcond_state
+{
+	u32 id = 0;
+	u64 name = 0;
+	u32 lwid = 0;
+	u32 control = 0;
+	std::vector<u32> waiters;
+};
+
+std::string lwcond_line(const lwcond_state& cond)
+{
+	std::string ids;
+	for (const u32 waiter : cond.waiters)
+	{
+		fmt::append(ids, "%s0x%x", ids.empty() ? "" : ":", waiter);
+	}
+	u32 lwmutex = 0;
+	if (cond.control && vm::check_addr(cond.control, vm::page_readable, 8))
+	{
+		lwmutex = *vm::get_super_ptr<be_t<u32>>(cond.control);
+	}
+	std::string line = fmt::format("FREEZE_DUMP lwcond id=0x%x name=%s lwmutex_id=0x%x control=0x%x control_data=%s lwmutex=0x%x lwmutex_data=%s waiters=%s",
+		cond.id, sanitize_token(lv2_obj::name64(cond.name)), cond.lwid, cond.control, guest_hex(cond.control, 8), lwmutex,
+		guest_hex(lwmutex, 24), ids.empty() ? std::string("-") : ids);
+	return bound_line(line);
+}
+
+// One 128-byte guest line the SPUs poll (raddr, last GETLLAR, the SPURS block).
+std::string guest_line(u32 addr)
+{
+	const u64 rtime = vm::check_addr(addr, vm::page_readable, 128) ? +vm::reservation_acquire(addr) : 0;
+	std::string line = fmt::format("FREEZE_DUMP line addr=0x%x rtime=0x%llx data=%s", addr, rtime, guest_hex(addr, 128));
+	return bound_line(line);
+}
+
+struct sema_state
+{
+	u32 id = 0;
+	s32 val = 0;
+	s32 max = 0;
+	u64 name = 0;
+	bool locked = false;
+	std::vector<u32> waiters;
+};
+
+std::string spu_line(const spu_thread& spu, const lv2_spu_group* group)
+{
+	const spu_mfc_cmd pending = spu.ch_mfc_cmd;
+	const auto events = spu.ch_events.load();
+	const u64 wait_start = spu.start_time;
+	const char* function = spu.current_func;
+	const std::string group_name = group ? sanitize_token(group->name) : std::string("-");
+	const std::string group_state = group ? fmt::format("%s", group->run_state.load()) : std::string("raw");
+
+	std::string line = fmt::format(
+		"FREEZE_DUMP spu id=0x%x lv2_id=0x%x name=%s group=%s gid=0x%x gstate=%s pc=0x%x state=%s "
+		"raddr=0x%x rtime=0x%llx last_getllar=0x%x getllar_addr=0x%x getllar_spins=%u gl_switch=0x%x "
+		"eventstat_spins=%llu events=0x%llx mask=0x%x mfc_size=%u mfc=%s:%u:0x%x:0x%x:0x%x func=%s wait_s=%.3f spurs_addr=0x%x",
+		spu.id, spu.lv2_id, sanitize_token(spu.get_name()), group_name, group ? group->id : 0u,
+		sanitize_token(group_state), spu.pc, cpu_state_token(spu),
+		spu.raddr, spu.rtime, spu.last_getllar, spu.last_getllar_addr, spu.getllar_spin_count,
+		spu.getllar_busy_waiting_switch, spu.eventstat_spin_count, events.all, static_cast<u32>(events.mask),
+		spu.mfc_size, pending.cmd, static_cast<u32>(pending.tag), pending.lsa, pending.eal, static_cast<u32>(pending.size),
+		sanitize_token(function ? function : ""),
+		wait_start ? (get_system_time() - wait_start) / 1000000. : 0.0, spu.spurs_addr);
+	return bound_line(line);
+}
+
+std::string rsx_line()
+{
+	const auto rsx = rsx::get_current_renderer();
+	if (!rsx)
+	{
+		return "FREEZE_DUMP rsx present=0";
+	}
+
+	std::string line = fmt::format(
+		"FREEZE_DUMP rsx present=1 state=%s fifo_state=%u get=0x%x put=0x%x in_begin_end=%u ext_lock=%u",
+		cpu_state_token(*rsx), static_cast<u32>(rsx->performance_counters.state),
+		rsx->ctrl ? +rsx->ctrl->get : 0u, rsx->ctrl ? +rsx->ctrl->put : 0u,
+		rsx->in_begin_end ? 1u : 0u, +rsx->external_interrupt_lock);
+	return bound_line(line);
+}
+}
+
+bool neostation_freeze_dump(const char* reason, double seconds_without_frames, double busiest_group_cores,
+	unsigned long long episode)
+{
+	// REWINDBOX_FREEZE_EPISODE_621: a guest-fault freeze (frozen) is dumped too.
+	const auto dumpable = [] {
+		const auto state = Emu.GetStatus(false);
+		return state == system_state::running || state == system_state::frozen;
+	};
+
+	std::unique_lock lock(s_dump_mutex, std::try_to_lock);
+	if (!lock.owns_lock())
+	{
+		return false;
+	}
+
+	// Only a running (or guest-fault frozen) emulator is dumped: paused, loading,
+	// stopping or stopped states present no frames for legitimate reasons.
+	if (!dumpable())
+	{
+		return false;
+	}
+
+	// The 30 s budget is checked here but consumed only once the collection
+	// below obtained its locks and the emulator was still running after it.
+	u64 accepted_at = s_last_dump_us;
+	if (!rpcs3::ios::profiler::accept_freeze_dump(get_system_time(), accepted_at,
+		rpcs3::ios::freeze_episode::min_dump_interval_us))
+	{
+		s_suppressed++;
+		return false;
+	}
+
+	// Collect references first, format afterwards. The idm reader lock is only
+	// tried: if a writer holds or waits for it (an emulation thread creating or
+	// withdrawing an object), the profiler thread gives up instead of waiting,
+	// so the COREPROF/JITPROF windows keep coming during the freeze.
+	std::vector<stx::shared_ptr<named_thread<ppu_thread>>> ppus;
+	std::vector<stx::shared_ptr<lv2_spu_group>> groups;
+	std::vector<stx::shared_ptr<named_thread<spu_thread>>> raw_spus;
+	std::vector<sema_state> semaphores; // REWINDBOX_FREEZE_DEEP_621
+	std::vector<lwcond_state> lwconds;  // REWINDBOX_FREEZE_POLLER_908
+
+	{
+		// Same try-locked reader pattern as the exit-request observer in System.cpp.
+		std::shared_lock idm_reader(id_manager::g_mutex, std::try_to_lock);
+		if (!idm_reader.owns_lock())
+		{
+			s_suppressed++;
+			return false;
+		}
+
+		if (g_fxo->is_init<id_manager::id_map<named_thread<ppu_thread>>>())
+		{
+			idm::select<named_thread<ppu_thread>>([&](u32 id, named_thread<ppu_thread>&)
+			{
+				if (auto ptr = idm::get_unlocked<named_thread<ppu_thread>>(id))
+				{
+					ppus.emplace_back(std::move(ptr));
+				}
+			}, idm::unlocked);
+		}
+
+		// Grouped SPU threads are reached through their group (kept alive by the
+		// collected reference); raw SPUs have no group.
+		if (g_fxo->is_init<id_manager::id_map<lv2_spu_group>>())
+		{
+			idm::select<lv2_spu_group>([&](u32 id, lv2_spu_group&)
+			{
+				if (auto ptr = idm::get_unlocked<lv2_spu_group>(id))
+				{
+					groups.emplace_back(std::move(ptr));
+				}
+			}, idm::unlocked);
+		}
+
+		// REWINDBOX_FREEZE_DEEP_621: semaphores with waiters (a negative count), their
+		// waiters' ids under the semaphore's own mutex, only tried.
+		if (g_fxo->is_init<id_manager::id_map<lv2_obj>>())
+		{
+			idm::select<lv2_obj, lv2_sema>([&](u32 id, lv2_sema& sema)
+			{
+				const s32 val = sema.val;
+				if (val >= 0 || semaphores.size() >= 8)
+				{
+					return;
+				}
+
+				sema_state state{id, val, sema.max, sema.name};
+				if (sema.mutex.try_lock_shared())
+				{
+					state.locked = true;
+					for (auto cpu = +sema.sq; cpu && state.waiters.size() < 6; cpu = cpu->next_cpu)
+					{
+						state.waiters.push_back(cpu->id);
+					}
+					sema.mutex.unlock_shared();
+				}
+				semaphores.push_back(std::move(state));
+			}, idm::unlocked);
+		}
+
+		// REWINDBOX_FREEZE_POLLER_908: the lwconds the PPU threads wait on (r3 of
+		// _sys_lwcond_queue_wait is the lwcond id), at most 6; their identity is const.
+		if (g_fxo->is_init<id_manager::id_map<lv2_obj>>())
+		{
+			std::vector<std::pair<u32, u32>> waited; // lwcond id, waiting ppu id
+			for (const auto& ppu : ppus)
+			{
+				const char* function = ppu->current_function;
+				if (function && std::strcmp(function, "_sys_lwcond_queue_wait") == 0)
+				{
+					waited.emplace_back(static_cast<u32>(ppu->gpr[3]), ppu->id);
+				}
+			}
+			idm::select<lv2_obj, lv2_lwcond>([&](u32 id, lv2_lwcond& cond)
+			{
+				lwcond_state state{id, cond.name, cond.lwid, cond.control.addr()};
+				for (const auto& [cond_id, ppu_id] : waited)
+				{
+					if (cond_id == id && state.waiters.size() < 8)
+					{
+						state.waiters.push_back(ppu_id);
+					}
+				}
+				if (!state.waiters.empty() && lwconds.size() < 6)
+				{
+					lwconds.push_back(std::move(state));
+				}
+			}, idm::unlocked);
+		}
+
+		if (g_fxo->is_init<id_manager::id_map<named_thread<spu_thread>>>())
+		{
+			idm::select<named_thread<spu_thread>>([&](u32 id, named_thread<spu_thread>& spu)
+			{
+				if (spu.group)
+				{
+					return;
+				}
+
+				if (auto ptr = idm::get_unlocked<named_thread<spu_thread>>(id))
+				{
+					raw_spus.emplace_back(std::move(ptr));
+				}
+			}, idm::unlocked);
+		}
+	}
+
+	// group->threads is assigned under group->mutex (sys_spu_thread_initialize):
+	// each group's entries are copied to local references under that mutex,
+	// only tried; a busy group is counted in busy_groups= and not listed.
+	std::vector<std::pair<const lv2_spu_group*, stx::shared_ptr<named_thread<spu_thread>>>> grouped_spus;
+	u32 busy_groups = 0;
+	for (const auto& group : groups)
+	{
+		std::shared_lock group_reader(group->mutex, std::try_to_lock);
+		if (!group_reader.owns_lock())
+		{
+			busy_groups++;
+			continue;
+		}
+
+		for (const auto& entry : group->threads)
+		{
+			if (stx::shared_ptr<named_thread<spu_thread>> thread = entry)
+			{
+				grouped_spus.emplace_back(group.get(), std::move(thread));
+			}
+		}
+	}
+
+	// A stop that began during the collection is not dumped (its threads are
+	// being torn down); the references are released right away and the rate
+	// limit is not consumed.
+	if (!dumpable())
+	{
+		return false;
+	}
+
+	s_last_dump_us = accepted_at;
+	const u64 suppressed = std::exchange(s_suppressed, 0);
+	const u64 index = ++s_dump_index;
+
+	const usz spu_count = grouped_spus.size() + raw_spus.size();
+
+	// REWINDBOX_FREEZE_DEEP_621: what decides a guest hang (BO2 multiplayer, builds 585,
+	// 612 and 620: main_thread in sys_semaphore_wait, one PPU thread spinning, the SPURS
+	// kernels polling): the code and reserved line of up to 2 running PPU threads, the
+	// waited semaphores and up to 6 guest lines the SPU threads poll. Bounded, read once
+	// per dump (at most one per episode), every lock already released.
+	std::vector<std::string> deep;
+	{
+		u32 running = 0;
+		for (const auto& ppu : ppus)
+		{
+			if (running < 2 && !(ppu->state & (cpu_flag::wait + cpu_flag::suspend + cpu_flag::stop)))
+			{
+				deep.push_back(ppu_code_line(*ppu));
+				running++;
+			}
+		}
+
+		u32 pollers = 0;
+		for (const auto& ppu : ppus)
+		{
+			if (pollers < 2 && is_polling_call(ppu->current_function))
+			{
+				deep.push_back(ppu_poller_line(*ppu));
+				pollers++;
+			}
+		}
+		for (const auto& cond : lwconds)
+		{
+			deep.push_back(lwcond_line(cond));
+		}
+
+		for (const auto& sema : semaphores)
+		{
+			std::string ids;
+			for (const u32 waiter : sema.waiters)
+			{
+				fmt::append(ids, "%s0x%x", ids.empty() ? "" : ":", waiter);
+			}
+			std::string line = fmt::format("FREEZE_DUMP sema id=0x%x name=%s val=%d max=%d waiters=%d ids=%s",
+				sema.id, sanitize_token(lv2_obj::name64(sema.name)), sema.val, sema.max, -sema.val,
+				sema.locked ? (ids.empty() ? std::string("-") : ids) : std::string("busy"));
+			deep.push_back(bound_line(line));
+		}
+
+		std::vector<u32> addresses;
+		const auto add_line = [&](u32 addr)
+		{
+			addr &= -128;
+			if (addr && addresses.size() < 6 && std::find(addresses.begin(), addresses.end(), addr) == addresses.end())
+			{
+				addresses.push_back(addr);
+			}
+		};
+		for (const auto& [group, thread] : grouped_spus)
+		{
+			if (thread->spurs_addr)
+			{
+				add_line(thread->spurs_addr);
+				add_line(thread->spurs_addr + 0x80);
+			}
+		}
+		for (const auto& [group, thread] : grouped_spus)
+		{
+			add_line(thread->last_getllar_addr);
+			add_line(thread->raddr);
+		}
+		for (const u32 addr : addresses)
+		{
+			deep.push_back(guest_line(addr));
+		}
+
+		// REWINDBOX_FREEZE_LABELS_909: God of War III, build 694: the RSX waited on label 0x60300510 while the label it
+		// had released just before (0x603004f0, the PPU's go signal) lies in the previous 128-byte line. Both lines
+		// show which side last wrote them: the value the PPU consumed (reset) or not.
+		if (const u32 watched = rpcs3::ios::signal_trace::watched_address.load(std::memory_order_relaxed))
+		{
+			const u32 base = watched & -128;
+			deep.push_back(guest_line(base));
+			if (base >= 128)
+			{
+				deep.push_back(guest_line(base - 128));
+			}
+		}
+	}
+
+	// begin + waits + rsx + end and the lines above are always emitted; the thread lines share the rest.
+	const auto plan = rpcs3::ios::profiler::plan_freeze_dump(spu_count, ppus.size(), 4 + deep.size());
+
+	// REWINDBOX_FREEZE_EPISODE_621: what every thread waits in, all threads
+	// counted (the per-thread lines below may be truncated).
+	std::vector<std::string> ppu_calls, spu_calls, spu_groups;
+	for (const auto& ppu : ppus)
+	{
+		const char* function = ppu->current_function;
+		ppu_calls.emplace_back(sanitize_token(function ? function : "guest_code"));
+	}
+	for (const auto& [group, thread] : grouped_spus)
+	{
+		const char* function = thread->current_func;
+		spu_calls.emplace_back(sanitize_token(function ? function : "guest_code"));
+		spu_groups.emplace_back(sanitize_token(fmt::format("%s", group->run_state.load())));
+	}
+	for (const auto& spu : raw_spus)
+	{
+		const char* function = spu->current_func;
+		spu_calls.emplace_back(sanitize_token(function ? function : "guest_code"));
+		spu_groups.emplace_back("raw");
+	}
+	std::vector<std::string> lines;
+	lines.reserve(plan.spu_lines + plan.ppu_lines);
+
+	usz spu_emitted = 0;
+	for (const auto& [group, thread] : grouped_spus)
+	{
+		if (spu_emitted < plan.spu_lines)
+		{
+			lines.push_back(spu_line(*thread, group));
+			spu_emitted++;
+		}
+	}
+	for (const auto& spu : raw_spus)
+	{
+		if (spu_emitted < plan.spu_lines)
+		{
+			lines.push_back(spu_line(*spu, nullptr));
+			spu_emitted++;
+		}
+	}
+
+	usz ppu_emitted = 0;
+	for (const auto& ppu : ppus)
+	{
+		if (ppu_emitted < plan.ppu_lines)
+		{
+			lines.push_back(ppu_line(*ppu));
+			ppu_emitted++;
+		}
+	}
+
+	const u32 total_lines = static_cast<u32>(lines.size() + deep.size() + 4);
+	std::string header = fmt::format(
+		"FREEZE_DUMP begin dump=%llu reason=%s no_frames_s=%.3f busiest_cores=%.3f state=%u "
+		"ppu=%u spu=%u groups=%u raw_spu=%u lines=%u truncated=%u suppressed=%llu busy_groups=%u episode=%llu",
+		index, sanitize_token(reason ? reason : ""), seconds_without_frames, busiest_group_cores,
+		static_cast<u32>(Emu.GetStatus(false)), static_cast<u32>(ppus.size()), static_cast<u32>(spu_count),
+		static_cast<u32>(groups.size()), static_cast<u32>(raw_spus.size()), total_lines,
+		static_cast<u32>(plan.truncated), suppressed, busy_groups, episode);
+	std::string waits = fmt::format(
+		"FREEZE_DUMP waits dump=%llu episode=%llu ppu=%u ppu_calls=%s spu=%u spu_calls=%s spu_groups=%s busy_groups=%u",
+		index, episode, static_cast<u32>(ppus.size()), rpcs3::ios::profiler::format_name_counts(std::move(ppu_calls)),
+		static_cast<u32>(spu_count), rpcs3::ios::profiler::format_name_counts(std::move(spu_calls)),
+		rpcs3::ios::profiler::format_name_counts(std::move(spu_groups)), busy_groups);
+	// REWINDBOX_FREEZE_SNAPSHOT_V1: one bounded message survives host log
+	// rotation as one durable milestone, with a single filesystem sync.
+	std::string snapshot = "FREEZE_DUMP snapshot\n" + bound_line(header) + "\n" + bound_line(waits) + "\n" + rsx_line();
+	for (const auto& line : lines)
+	{
+		snapshot += "\n";
+		snapshot += line;
+	}
+	for (const auto& line : deep)
+	{
+		snapshot += "\n";
+		snapshot += line;
+	}
+	fmt::append(snapshot, "\nFREEZE_DUMP end dump=%llu lines=%u truncated=%u", index, total_lines, static_cast<u32>(plan.truncated));
+	ios_freeze_dump.notice("%s", snapshot);
+	return true;
+}
diff --git a/rpcs3/ios/RPCS3IOSFreezeDump.h b/rpcs3/ios/RPCS3IOSFreezeDump.h
new file mode 100644
index 0000000..7719240
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSFreezeDump.h
@@ -0,0 +1,25 @@
+#pragma once
+
+// NEOSTATION_BUILD487_DIAGNOSTICS_V1: bounded FREEZE_DUMP of the guest threads.
+//
+// Logs a bounded FREEZE_DUMP of every PPU and SPU thread (plus one RSX puller
+// line). Rate-limited inside (<= 1 dump / 30 s, <= 64 lines of <= 1 KiB, every
+// line prefixed "FREEZE_DUMP "; the first line is the summary the host mirrors
+// as the freeze_dump milestone). Safe to call from the profiler thread while
+// emulation runs: it only try-locks emulator locks (the idm reader lock and
+// each SPU group's mutex) and gives up or skips instead of waiting, never
+// stops or modifies emulation, and returns without logging when the emulator
+// is not running (checked before and after the collection), when the idm lock
+// is busy or when the rate limit applies (both counted in suppressed=).
+//
+// reason names the trigger ("no_frames"), seconds_without_frames the time since
+// the last presented frame and busiest_group_cores the average cores of the
+// busiest thread group over the reporter window that triggered the dump.
+//
+// REWINDBOX_FREEZE_EPISODE_621 (RPCS3IOSFreezeEpisode.h): called once per freeze
+// episode by the profiler sampler; episode= joins the dump to its FREEZE_EPISODE
+// lines, a waits summary line follows the begin line, a guest-fault freeze
+// (frozen state) is dumped too, and the inside rate limit is 10 s.
+// Returns true when the dump was logged (false: not running, idm lock busy, rate limit).
+bool neostation_freeze_dump(const char* reason, double seconds_without_frames, double busiest_group_cores,
+	unsigned long long episode = 0);
diff --git a/rpcs3/ios/RPCS3IOSFreezeEpisode.h b/rpcs3/ios/RPCS3IOSFreezeEpisode.h
new file mode 100644
index 0000000..655b3e7
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSFreezeEpisode.h
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_FREEZE_EPISODE_621: a freeze is an episode, not a 5 s window.
+// The profiler sampler (every 500 ms, RPCS3IOSPerformance.cpp) feeds the
+// emulator state and the guest flip count. The no-frame clock only advances
+// while the emulator runs: time paused, loading, stopping and the gaps of an
+// iOS suspension (no sample for more than 2 s) are kept apart, so an episode
+// that began before a pause keeps its evidence across any number of pauses and
+// resumes, and a pause alone never makes one.
+//  - begin: no guest flip for 3 s of running time while a thread group uses at
+//    least half a core (no_frames_busy, the Build 487 trigger), or for 6 s with
+//    less activity (no_frames_idle, a quiet freeze), or the emulator froze on a
+//    guest fault (emulator_frozen). The no-frame triggers are armed by the first
+//    guest flip of the session: a boot that compiles before its first frame is
+//    loading, not a freeze. One FREEZE_DUMP per episode: requested at the begin,
+//    retried on the following samples until the dump reports it was taken
+//    (dump_taken), never more often than every 10 s across episodes.
+//  - update: every 10 s of episode time for the first minute, then every 60 s.
+//  - end: recovered once guest flips come back steadily (10 flips over at
+//    least 1 s of running time), or stopped with the session. A later stall is
+//    a new episode with its own dump.
+// The host (Rpcs3Diagnostics.mm) adds what the Core cannot see: whether its
+// menu was open and whether the app was in the background.
+namespace rpcs3::ios::freeze_episode
+{
+inline constexpr std::uint64_t busy_begin_us = 3'000'000;
+inline constexpr std::uint64_t idle_begin_us = 6'000'000;
+inline constexpr double busy_cores = 0.5;
+inline constexpr std::uint64_t suspend_gap_us = 2'000'000;
+inline constexpr std::uint64_t recover_span_us = 1'000'000;
+inline constexpr std::uint64_t recover_flips = 10;
+inline constexpr std::uint64_t early_update_us = 10'000'000;
+inline constexpr std::uint64_t late_update_us = 60'000'000;
+inline constexpr std::uint64_t early_window_us = 60'000'000;
+inline constexpr std::uint64_t min_dump_interval_us = 10'000'000;
+
+enum class emu : std::uint32_t
+{
+	running = 0,
+	paused = 1,  // Emu.Pause (debugger, frame capture); RewindBox's menu does not pause
+	frozen = 2,  // Emu.Pause(true) after a guest access violation
+	loading = 3, // ready, starting, loading
+	stopped = 4, // stopping, stopped
+};
+
+enum class event : std::uint32_t
+{
+	none = 0,
+	begin = 1,
+	update = 2,
+	end = 3,
+};
+
+inline const char* event_name(event value) noexcept
+{
+	switch (value)
+	{
+	case event::begin: return "begin";
+	case event::update: return "update";
+	case event::end: return "end";
+	default: return "none";
+	}
+}
+
+struct tick
+{
+	std::uint64_t now_us = 0;     // steady clock
+	emu state = emu::running;
+	std::uint64_t guest_flips = 0; // monotonic count of guest flips
+	double busiest_cores = 0.0;    // busiest thread group of this sample
+};
+
+struct report
+{
+	event what = event::none;
+	std::uint64_t episode = 0;
+	const char* reason = "";   // no_frames_busy | no_frames_idle | emulator_frozen
+	const char* outcome = "";  // open | recovered | stopped
+	bool dump = false;         // take the FREEZE_DUMP of this episode now (also on a sample without event)
+	bool dump_suppressed = false; // the 10 s floor delays the dump of this episode
+	double no_frames_s = 0.0;      // running time without a guest flip when the episode began
+	double episode_s = 0.0;        // running time since the episode began
+	double paused_s = 0.0;         // paused or frozen wall time inside the episode
+	double suspended_s = 0.0;      // sampling gaps over 2 s inside the episode (iOS suspension)
+	double loading_s = 0.0;        // loading-state wall time inside the episode
+	std::uint32_t pauses = 0, suspensions = 0;
+	std::uint64_t flips_during = 0; // guest flips seen while the episode was open
+	double busiest_cores = 0.0;     // at begin, then the current sample
+	double begin_busiest_cores = 0.0;
+	double last_flip_age_s = 0.0;   // wall time since the last guest flip
+};
+
+class tracker
+{
+public:
+	void reset() noexcept { *this = {}; }
+
+	report observe(const tick& sample) noexcept
+	{
+		report result;
+		if (!m_started)
+		{
+			m_started = true;
+			m_previous_us = sample.now_us;
+			m_flips = sample.guest_flips;
+			m_last_flip_wall_us = sample.now_us;
+			m_previous_state = sample.state;
+			return result;
+		}
+
+		const std::uint64_t gap = sample.now_us > m_previous_us ? sample.now_us - m_previous_us : 0;
+		m_previous_us = sample.now_us;
+		const bool suspended = gap > suspend_gap_us;
+		const bool running = sample.state == emu::running;
+
+		if (m_open)
+		{
+			if (suspended)
+			{
+				m_suspended_us += gap;
+				m_suspensions++;
+			}
+			else if (sample.state == emu::paused || sample.state == emu::frozen)
+			{
+				m_paused_us += gap;
+			}
+			else if (sample.state == emu::loading)
+			{
+				m_loading_us += gap;
+			}
+			if (sample.state == emu::paused && m_previous_state != emu::paused)
+			{
+				m_pauses++;
+			}
+		}
+		m_previous_state = sample.state;
+
+		if (running && !suspended)
+		{
+			m_active_us += gap;
+		}
+
+		if (sample.guest_flips != m_flips)
+		{
+			const std::uint64_t delta = sample.guest_flips > m_flips ? sample.guest_flips - m_flips : 1;
+			m_flips = sample.guest_flips;
+			m_armed = true;
+			m_last_flip_active_us = m_active_us;
+			m_last_flip_wall_us = sample.now_us;
+			if (m_open)
+			{
+				m_flips_during += delta;
+				if (!m_recovering)
+				{
+					m_recovering = true;
+					m_recover_since_us = m_active_us;
+					m_recover_flips = 0;
+				}
+				m_recover_flips += delta;
+			}
+		}
+		else if (m_open && m_recovering && m_active_us - m_last_flip_active_us >= recover_span_us)
+		{
+			m_recovering = false; // flips stopped again before the recovery held
+		}
+
+		if (sample.state == emu::stopped)
+		{
+			if (m_open) return close("stopped", sample);
+			m_last_flip_active_us = m_active_us;
+			return result;
+		}
+
+		if (m_open)
+		{
+			if (m_recovering && m_recover_flips >= recover_flips && m_active_us - m_recover_since_us >= recover_span_us)
+			{
+				return close("recovered", sample);
+			}
+
+			const std::uint64_t elapsed = episode_us();
+			const std::uint64_t period = elapsed < early_window_us ? early_update_us : late_update_us;
+			if (elapsed >= m_next_update_us)
+			{
+				m_next_update_us = elapsed + period;
+				fill(result, event::update, "open", sample);
+			}
+			request_dump(result, sample.now_us);
+			return result;
+		}
+
+		const std::uint64_t idle = m_active_us - m_last_flip_active_us;
+		const char* reason = nullptr;
+		if (sample.state == emu::frozen)
+			reason = "emulator_frozen";
+		else if (m_armed && running && idle >= busy_begin_us && sample.busiest_cores >= busy_cores)
+			reason = "no_frames_busy";
+		else if (m_armed && running && idle >= idle_begin_us)
+			reason = "no_frames_idle";
+		if (!reason) return result;
+
+		m_open = true;
+		m_episode++;
+		m_reason = reason;
+		m_wall_clock = sample.state == emu::frozen;
+		m_begin_active_us = m_active_us;
+		m_begin_frozen_us = sample.now_us;
+		m_no_frames_us = idle;
+		m_paused_us = m_suspended_us = m_loading_us = 0;
+		m_pauses = m_suspensions = 0;
+		m_flips_during = 0;
+		m_recovering = false;
+		m_begin_cores = sample.busiest_cores;
+		m_next_update_us = early_update_us;
+		m_dump_pending = true;
+		fill(result, event::begin, "open", sample);
+		request_dump(result, sample.now_us);
+		result.dump_suppressed = !result.dump;
+		return result;
+	}
+
+	// The dump of the open episode was taken (neostation_freeze_dump returned true).
+	void dump_taken(std::uint64_t now_us) noexcept
+	{
+		m_dump_pending = false;
+		m_last_dump_us = now_us ? now_us : 1;
+	}
+
+	// The session ended (profiler reset or Core stop) with an episode open.
+	report stop(std::uint64_t now_us) noexcept
+	{
+		report result;
+		if (!m_open) return result;
+		tick sample;
+		sample.now_us = now_us;
+		sample.state = emu::stopped;
+		return close("stopped", sample);
+	}
+
+	bool open() const noexcept { return m_open; }
+	std::uint64_t episodes() const noexcept { return m_episode; }
+
+private:
+	std::uint64_t episode_us() const noexcept
+	{
+		const std::uint64_t running = m_active_us - m_begin_active_us;
+		// A guest-fault freeze keeps the emulator out of the running state: its
+		// episode time is wall time.
+		return m_wall_clock ? m_previous_us - m_begin_frozen_us : running;
+	}
+
+	void fill(report& result, event what, const char* outcome, const tick& sample) const noexcept
+	{
+		result.what = what;
+		result.episode = m_episode;
+		result.reason = m_reason ? m_reason : "";
+		result.outcome = outcome;
+		result.no_frames_s = static_cast<double>(m_no_frames_us) / 1e6;
+		result.episode_s = static_cast<double>(episode_us()) / 1e6;
+		result.paused_s = static_cast<double>(m_paused_us) / 1e6;
+		result.suspended_s = static_cast<double>(m_suspended_us) / 1e6;
+		result.loading_s = static_cast<double>(m_loading_us) / 1e6;
+		result.pauses = m_pauses;
+		result.suspensions = m_suspensions;
+		result.flips_during = m_flips_during;
+		result.busiest_cores = sample.busiest_cores;
+		result.begin_busiest_cores = m_begin_cores;
+		result.last_flip_age_s = sample.now_us > m_last_flip_wall_us
+			? static_cast<double>(sample.now_us - m_last_flip_wall_us) / 1e6 : 0.0;
+	}
+
+	// One dump per episode; a flapping title cannot dump more often than every 10 s.
+	void request_dump(report& result, std::uint64_t now_us) const noexcept
+	{
+		result.dump = m_dump_pending && (!m_last_dump_us || now_us - m_last_dump_us >= min_dump_interval_us);
+		if (result.dump && result.what == event::none)
+		{
+			result.episode = m_episode;
+			result.reason = m_reason ? m_reason : "";
+			result.no_frames_s = static_cast<double>(m_no_frames_us) / 1e6;
+			result.begin_busiest_cores = m_begin_cores;
+		}
+	}
+
+	report close(const char* outcome, const tick& sample) noexcept
+	{
+		report result;
+		fill(result, event::end, outcome, sample);
+		m_dump_pending = false;
+		m_open = false;
+		m_recovering = false;
+		m_reason = nullptr;
+		m_last_flip_active_us = m_active_us;
+		return result;
+	}
+
+	bool m_started = false, m_open = false, m_recovering = false, m_wall_clock = false;
+	bool m_armed = false;        // a guest flip was seen in this session
+	bool m_dump_pending = false; // the open episode's dump is not taken yet
+	emu m_previous_state = emu::running;
+	const char* m_reason = nullptr;
+	std::uint64_t m_previous_us = 0, m_active_us = 0, m_flips = 0;
+	std::uint64_t m_last_flip_active_us = 0, m_last_flip_wall_us = 0;
+	std::uint64_t m_episode = 0, m_begin_active_us = 0, m_begin_frozen_us = 0, m_no_frames_us = 0;
+	std::uint64_t m_paused_us = 0, m_suspended_us = 0, m_loading_us = 0;
+	std::uint32_t m_pauses = 0, m_suspensions = 0;
+	std::uint64_t m_flips_during = 0, m_recover_since_us = 0, m_recover_flips = 0;
+	std::uint64_t m_next_update_us = 0, m_last_dump_us = 0;
+	double m_begin_cores = 0.0;
+};
+}
