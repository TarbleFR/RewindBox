+	// depression. The cadence above and every wait condition are unchanged.
+	inline std::atomic<bool> reservation_yield_no_depress{false};
+
+	// Defined in RPCS3IOSPlatform.mm, the iOS unit that includes the Mach headers.
+	void reservation_lock_yield() noexcept;
 }
diff --git a/rpcs3/ios/IOSRestoreExecutor.h b/rpcs3/ios/IOSRestoreExecutor.h
new file mode 100644
index 0000000..102b061
--- /dev/null
+++ b/rpcs3/ios/IOSRestoreExecutor.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+
+namespace rpcs3::ios {
+// One owned worker, created only on the first internal restore or reboot. The
+// restore entry remains exclusive. A process transition may enqueue one next
+// phase while the current phase retires; no unbounded queue or detached thread.
+// Cancellation
+// invalidates a task even after dequeue while it waits for the Core API lock.
+class restore_executor final {
+public:
+    using task = std::function<void(std::uint64_t)>;
+    restore_executor() = default;
+    ~restore_executor();
+    restore_executor(const restore_executor&) = delete;
+    restore_executor& operator=(const restore_executor&) = delete;
+    bool post(task work, std::uint64_t token) noexcept;
+    bool post_continuation(task work, std::uint64_t token) noexcept;
+    bool cancel() noexcept;
+    bool current(std::uint64_t token) const noexcept;
+    std::uint64_t generation() const noexcept { return generation_.load(std::memory_order_acquire); }
+    bool close() noexcept; // join outside emulator/API/UI locks
+private:
+    struct job { std::uint64_t token; task work; };
+    std::mutex mutex_, join_mutex_;
+    std::condition_variable changed_;
+    std::optional<job> pending_;
+    std::thread worker_;
+    std::thread::id worker_id_{}; // mutex_: self-close check never reads a joining std::thread
+    std::atomic<std::uint64_t> generation_{1};
+    bool closed_ = false, active_ = false;
+    bool post_impl(task work, std::uint64_t token, bool allow_active) noexcept;
+    void run() noexcept;
+};
+// Called after UIKit has completed the existing stop/renderer cleanup.
+// The continuation runs under the Core API mutex, after generation and
+// lifecycle checks. A failure is reported; it never falls back to UIKit I/O.
+std::uint64_t savestate_restore_generation() noexcept;
+// True means scheduled OR an obsolete request safely discarded. False means
+// admission failed for the still-current request. No stale callback may mutate
+// a newer title, even if UIKit delivers it only after a later boot/stop.
+bool defer_savestate_restore(std::function<void()> continuation, std::uint64_t token) noexcept;
+
+// Process-switch phases share the same generation, worker and Core API lock.
+// The first phase dispatches only the existing stop/capture closure to UIKit
+// and waits for that short closure to return. The second phase runs BootGame
+// after UIKit finishes renderer cleanup. Captured arguments are not applied
+// until the second phase has rechecked the generation and stopped state.
+std::uint64_t continuous_boot_generation() noexcept;
+bool defer_continuous_stop(std::function<void(std::uint64_t)> main_stop, std::uint64_t token, std::uint64_t emulation_id, std::string title_id) noexcept;
+bool defer_continuous_boot(std::function<void()> boot, std::uint64_t token, std::uint64_t emulation_id, std::string title_id) noexcept;
+}
diff --git a/rpcs3/ios/IOSRestoreFailure.h b/rpcs3/ios/IOSRestoreFailure.h
new file mode 100644
index 0000000..8c8be8d
--- /dev/null
+++ b/rpcs3/ios/IOSRestoreFailure.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+
+// A recoverable missing-resource failure on the one restore worker. No throws
+// cross the noexcept ID constructors, and no serialized format is changed.
+namespace rpcs3::ios::restore_failure
+{
+struct failure
+{
+    std::uint32_t id = 0, error = 0;
+    std::array<char, 256> disc_path{};
+    bool active = false;
+};
+inline constinit thread_local failure current{};
+inline void reset() noexcept { current = {}; }
+inline bool failed() noexcept { return current.active; }
+inline void missing(std::uint32_t id, std::uint32_t error, std::string_view path) noexcept
+{
+    if (current.active) return; // Preserve the first cause.
+    current.id = id; current.error = error; current.active = true;
+    // Only disc-relative guest names can be exported. Never an iOS container,
+    // host_root, user save name, file content or a persisted absolute host path.
+    if (!path.starts_with("/dev_bdvd/")) return;
+    const auto count = path.size() < current.disc_path.size() ? path.size() : current.disc_path.size() - 1;
+    for (std::size_t i = 0; i < count; ++i)
+    {
+        const auto c = static_cast<unsigned char>(path[i]);
+        current.disc_path[i] = c >= 32 && c < 127 ? static_cast<char>(c) : '?';
+    }
+}
+}
diff --git a/rpcs3/ios/IOSRsxIdlePark.h b/rpcs3/ios/IOSRsxIdlePark.h
new file mode 100644
index 0000000..b344283
--- /dev/null
+++ b/rpcs3/ios/IOSRsxIdlePark.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+// CELL565_RSX_IDLE_PARK: with an empty FIFO the RSX thread yields in a loop, so
+// it keeps a whole core while it waits for the next guest commands (Dragon Ball
+// Z Budokai HD on build 564: 0.90 core with the FIFO busy 33-43 % of the time,
+// one idle period of about 12 ms per frame). The iPhone has two performance
+// cores; that core is taken from the SPU and PPU threads doing the guest's
+// work. After the FIFO has stayed empty for grace_us, the thread sleeps in
+// slices of slice_us instead. The guest's next PUT is seen at the end of the
+// current slice at worst; a flush request, a flip request or a ZCULL pipe flush
+// posted by another thread wakes it at once.
+namespace rpcs3::ios::rsx_idle_park
+{
+inline std::atomic<bool> enabled{false};
+
+// Short gaps inside a frame keep the yield loop; only a long idle period parks.
+constexpr std::uint64_t grace_us = 1000;
+constexpr std::uint64_t slice_us = 50;
+
+inline std::mutex gate_mutex;
+inline std::condition_variable gate;
+inline std::uint64_t generation = 0;
+inline std::atomic<std::uint32_t> parked{0};
+
+// RSX thread only: sleep one slice unless woken.
+inline void park() noexcept
+{
+	parked.fetch_add(1, std::memory_order_seq_cst);
+	{
+		std::unique_lock lock(gate_mutex);
+		const std::uint64_t seen = generation;
+		gate.wait_for(lock, std::chrono::microseconds(slice_us), [&] { return generation != seen; });
+	}
+	parked.fetch_sub(1, std::memory_order_relaxed);
+}
+
+// Any thread, after posting work the RSX thread must service.
+inline void wake() noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed) || !parked.load(std::memory_order_seq_cst))
+	{
+		return;
+	}
+
+	{
+		std::lock_guard lock(gate_mutex);
+		generation++;
+	}
+	gate.notify_all();
+}
+}
diff --git a/rpcs3/ios/IOSRsxLabelAccess.h b/rpcs3/ios/IOSRsxLabelAccess.h
new file mode 100644
index 0000000..cd745c8
--- /dev/null
+++ b/rpcs3/ios/IOSRsxLabelAccess.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Emu/Memory/vm.h"
+#include "Emu/Cell/lv2/sys_rsx.h"
+#include "ios/RPCS3IOSExperimentalPolicy.h"
+
+// REWINDBOX_ZCULL_ON_DEMAND_619 (ios/IOSZcullOnDemand.h): the RSX thread's own
+// reads and writes of GCM labels, notifies and flip semaphores. On a 16 KiB host
+// page the label area shares its page with local reports 0-703, which ZCULL
+// protects while one of them is pending: through the protected view, an RSX
+// label access would fault and switch the location to the upstream mode for the
+// rest of the boot. With the lever, the RSX thread reaches the GCM label/report
+// area, and any page ZCULL holds locked, through the unprotected view: the bytes
+// are the same, the page stays protected for the guest threads, whose accesses
+// are served on demand. Elsewhere, and without the lever, the protected view
+// (upstream) is kept.
+namespace rpcs3::ios::zcull_on_demand
+{
+template <typename T, typename Thread>
+auto rsx_label_ptr(Thread* rsx, u32 address)
+{
+	if (rpcs3::ios::get_experimental_policy().zcull_on_demand &&
+		(address - rsx->label_addr < sizeof(RsxReports) || rsx->ios_zcull_page_locked(address)))
+	{
+		return vm::get_super_ptr<T>(address);
+	}
+
+	return vm::_ptr<T>(address);
+}
+}
diff --git a/rpcs3/ios/IOSRsxSyncProfile.h b/rpcs3/ios/IOSRsxSyncProfile.h
new file mode 100644
index 0000000..3f337a6
--- /dev/null
+++ b/rpcs3/ios/IOSRsxSyncProfile.h
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include "IOSFrameTrace.h"
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_RSX_SYNC_PROFILE_V1: where the RSX thread's frame goes. Dragon Ball
+// Z HD Collection (547 logs, BLES01658) runs at 31-35 fps with an unimodal
+// 22-36 ms frame (not a 30 fps cap): per frame the RSX thread uses 21 ms of CPU
+// and waits twice for the GPU, 7.3 ms in total, i.e. 28 of the 30 ms. Neither
+// which waits these are nor how much of that CPU is MoltenVK encoding the Metal
+// commands inside vkQueueSubmit (synchronous submits) was measured. Durations
+// are TSC ticks; the profiler converts and drains them once per window.
+namespace rpcs3::ios::rsx_sync
+{
+enum site : unsigned
+{
+    other,
+    frame_cleanup, // frame_context_cleanup: the frame queue waits for an older frame
+    cb_reuse,      // a command buffer still pending on the GPU is recycled
+    hard_sync,     // flush_command_queue(hard_sync): wait for everything submitted
+    texture,       // texture cache readback or DMA completion
+    site_count
+};
+
+inline const char* site_name(site value) noexcept
+{
+    switch (value)
+    {
+    case frame_cleanup: return "frame_cleanup";
+    case cb_reuse: return "cb_reuse";
+    case hard_sync: return "hard_sync";
+    case texture: return "texture";
+    default: return "other";
+    }
+}
+
+inline thread_local site t_site = other;
+
+// The outermost reason wins unless `override` is set: a hard sync drains the
+// frame queue and recycles buffers, and those waits belong to the hard sync.
+class SiteScope final
+{
+    site previous_;
+public:
+    explicit SiteScope(site value, bool override = false) noexcept : previous_(t_site)
+    {
+        if (override || t_site == other) t_site = value;
+    }
+    ~SiteScope() noexcept { t_site = previous_; }
+    SiteScope(const SiteScope&) = delete;
+    SiteScope& operator=(const SiteScope&) = delete;
+};
+
+inline std::array<diagnostics::EventCost, site_count> fence_wait_ticks{};
+inline diagnostics::EventCost submit_ticks{};  // vkQueueSubmit on the calling thread
+inline diagnostics::EventCost acquire_ticks{}; // vkAcquireNextImageKHR (CAMetalLayer drawable)
+inline diagnostics::EventCost present_ticks{}; // vkQueuePresentKHR
+// Swap submission to observed completion of the same frame (frame cleanup):
+// about one frame when the GPU keeps up, up to the frames in flight when it
+// does not.
+inline diagnostics::EventCost frame_latency_ticks{};
+// REWINDBOX_MOLTENVK_COMPILE_QOS_V1: MoltenVK Metal compiles dispatched in the
+// waiting thread's user-interactive class, or at the default priority.
+inline std::atomic<std::uint64_t> metal_compiles_interactive{0};
+inline std::atomic<std::uint64_t> metal_compiles_default{0};
+
+// REWINDBOX_ZCULL_SYNC_PROBE_613: Assassin's Creed (BLES00158), Build 612
+// iPhone logs, ZCULL accuracy Approximate: in the heavy scenes the RSX FIFO is
+// busy 99% of each window while the RSX thread uses about a quarter of it on
+// the CPU, the fence, submit and present sites above stay near zero and a frame
+// costs about 2.2 ms per command buffer submitted. A ZCULL report read that
+// needs its occlusion queries submits the open command buffer and sleeps in
+// MoltenVK (vkGetQueryPoolResults with VK_QUERY_RESULT_WAIT_BIT) until the GPU
+// has run it, a wait none of those sites sees. These counters separate that
+// wait from the rest of the RSX thread's time; they change no behaviour.
+inline diagnostics::EventCost zcull_result_ticks{};        // a report read that had queries to gather
+inline std::atomic<std::uint64_t> zcull_result_flushes{0}; // ... whose queries were still in the open command buffer
+inline std::atomic<std::uint64_t> zcull_hint_flushes{0};   // zcull_sync hints that submitted ahead of a read
+// REWINDBOX_ZCULL_HINT_SITES_659: the ZCULL_control site of each zcull_sync hint that submitted:
+// sync(), update() at the queue-depth limit, update() for a critical report's age, read_barrier()
+// and ios_service_read(). Set by the site on the RSX thread just before its hint.
+enum zcull_hint_site_id : unsigned { hint_sync, hint_queue_depth, hint_critical_age, hint_read_barrier, hint_service_read, hint_site_count };
+inline thread_local unsigned zcull_hint_site = hint_sync;
+inline std::atomic<std::uint64_t> zcull_hint_site_flushes[hint_site_count]{};
+
+// REWINDBOX_ZCULL_WAIT_PROBE_616: the Build 614 logs of the same title
+// (PID 64664, windows 20-33) keep 4.1-4.4 s per 5 s window inside report
+// reads whatever their number (31,500-48,300), with result_flushes at zero and
+// hint_flushes equal to the submissions: the time is not the reads but about
+// one wait for the GPU per submitted command buffer. These counters split the
+// MoltenVK wait itself (vkGetQueryPoolResults with VK_QUERY_RESULT_WAIT_BIT,
+// VKQueryPool.cpp) from the rest of a read, by the path that asked for it:
+// a non-forced poll of ZCULL_control::update, a forced read (report read
+// barrier), a conditional render evaluation or ZCULL_control::sync (NV406E
+// reference, wait for idle, notify). poll_deferred counts the polls that
+// REWINDBOX_ZCULL_POLL_NO_WAIT_616 left for later instead of waiting.
+enum zcull_read_path : unsigned
+{
+    zcull_poll,
+    zcull_forced,
+    zcull_cond_render,
+    zcull_sync_all,
+    zcull_path_count
+};
+
+inline const char* zcull_read_path_name(unsigned value) noexcept
+{
+    switch (value)
+    {
+    case zcull_poll: return "poll";
+    case zcull_forced: return "forced";
+    case zcull_cond_render: return "cond_render";
+    case zcull_sync_all: return "sync";
+    default: return "other";
+    }
+}
+
+inline thread_local unsigned t_zcull_read_path = zcull_poll;
+// What a forced read is for when update() runs with a sync address: a report
+// read barrier unless a conditional render evaluation says otherwise.
+inline thread_local unsigned t_zcull_forced_path = zcull_forced;
+
+class ZcullPathScope final
+{
+    unsigned& slot_;
+    unsigned previous_;
+public:
+    ZcullPathScope(unsigned& slot, unsigned value) noexcept : slot_(slot), previous_(slot) { slot_ = value; }
+    ~ZcullPathScope() noexcept { slot_ = previous_; }
+    ZcullPathScope(const ZcullPathScope&) = delete;
+    ZcullPathScope& operator=(const ZcullPathScope&) = delete;
+};
+
+inline std::array<diagnostics::EventCost, zcull_path_count> zcull_wait_ticks{};
+inline std::array<std::atomic<std::uint64_t>, zcull_path_count> zcull_gathers{};
+inline std::atomic<std::uint64_t> zcull_poll_deferred{0};
+
+inline void record_zcull_wait(std::uint64_t ticks) noexcept
+{
+    zcull_wait_ticks[t_zcull_read_path < zcull_path_count ? t_zcull_read_path : zcull_poll].record(ticks);
+}
+
+inline void count_zcull_gather() noexcept
+{
+    zcull_gathers[t_zcull_read_path < zcull_path_count ? t_zcull_read_path : zcull_poll].fetch_add(1, std::memory_order_relaxed);
+}
+
+// REWINDBOX_RSX_FRAME_PROFILE_V1: RPCS3's own per-frame RSX statistics
+// (frame_statistics_t). Counters are taken every frame; the stage timers only
+// run on sampled frames (one in rsx_frame_sample_period) because they read
+// the clock around every draw. The RSX thread adds once per flip; the
+// profiler exchanges once per window. FIFO idle entries count transitions of
+// the puller from running to empty, NOP or jump-to-self.
+inline constexpr unsigned rsx_frame_sample_period = 8;
+struct rsx_frame_window
+{
+    std::atomic<std::uint64_t> frames{0}, sampled{0}, draws{0}, submits{0};
+    std::atomic<std::uint64_t> setup_us{0}, vertex_us{0}, texture_us{0}, exec_us{0}, flip_us{0}, sampled_draws{0};
+    std::atomic<std::uint64_t> vertex_cache_requests{0}, vertex_cache_misses{0}, program_lookups{0}, program_lookups_elided{0};
+    std::atomic<std::uint64_t> fifo_idle_entries{0};
+};
+inline rsx_frame_window rsx_frames{};
+
+inline void record_fence_wait(std::uint64_t ticks) noexcept
+{
+    fence_wait_ticks[t_site < site_count ? t_site : other].record(ticks);
+    frame_trace::waits().fence_ticks += ticks;
+}
+}
diff --git a/rpcs3/ios/IOSRuntimeMetrics.h b/rpcs3/ios/IOSRuntimeMetrics.h
new file mode 100644
index 0000000..433344e
--- /dev/null
+++ b/rpcs3/ios/IOSRuntimeMetrics.h
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// Build527: bounded, allocation-free observations. No emulation decision reads
+// these counters. Frame samples are guest flips only, not UIKit/overlay frames.
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace rpcs3::ios::diagnostics
+{
+class GuestFrameWindow final
+{
+public:
+    static constexpr std::size_t capacity = 2048;
+    static constexpr std::size_t histogram_bins = 256;
+    static constexpr std::uint32_t histogram_upper_us(std::size_t bin) noexcept
+    {
+        return bin < 128 ? static_cast<std::uint32_t>((bin + 1) * 1000 - 1)
+            : bin < 255 ? static_cast<std::uint32_t>(128000 + (bin - 127) * 8000 - 1) : UINT32_MAX;
+    }
+    struct Sample
+    {
+        std::array<std::uint64_t, histogram_bins> histogram{};
+        std::uint64_t intervals = 0, unavailable = 0, total_us = 0;
+        std::uint32_t median_us = 0, p95_us = 0, p99_us = 0, maximum_us = 0;
+        std::uint64_t over_50ms = 0, over_100ms = 0;
+    };
+
+    // One producer: rsx::thread::flip(). UI flips do not advance the guest
+    // baseline. Microsecond quantization bounds the packed interval to 71 min;
+    // saturation is explicit in the output. The sequence shares the same atomic
+    // word, so a wrap/overwrite cannot produce a torn frame/timestamp pair.
+    void record(bool guest_flip, std::uint64_t now_ticks, std::uint64_t frequency) noexcept
+    {
+        if (!guest_flip || !frequency) return;
+        const auto previous = last_ticks_.exchange(now_ticks, std::memory_order_relaxed);
+        if (!previous || now_ticks <= previous) return;
+        const auto ticks = now_ticks - previous;
+        const auto whole_seconds = ticks / frequency;
+        const auto remainder = ticks % frequency;
+        const auto micros = whole_seconds > UINT32_MAX / 1'000'000
+            ? UINT32_MAX : std::min<std::uint64_t>(UINT32_MAX,
+                whole_seconds * 1'000'000 + (remainder <= UINT64_MAX / 1'000'000
+                    ? remainder * 1'000'000 / frequency
+                    : static_cast<std::uint64_t>(static_cast<long double>(remainder) * 1'000'000 / frequency)));
+        const auto index = published_.load(std::memory_order_relaxed);
+        const auto packed = (static_cast<std::uint64_t>(static_cast<std::uint32_t>(index)) << 32) | micros;
+        ring_[index % capacity].store(packed, std::memory_order_release);
+        published_.store(index + 1, std::memory_order_release);
+    }
+
+    // Lifecycle owner calls only after the old renderer producer has stopped,
+    // as required by reset_performance_metrics(). Monotonic indices preserve
+    // overwrite detection without touching all 2048 slots at every new session.
+    void reset() noexcept
+    {
+        last_ticks_.store(0, std::memory_order_relaxed);
+        cursor_ = published_.load(std::memory_order_acquire);
+    }
+
+    // One consumer: the existing 5 s sampler. At most capacity samples are
+    // sorted on its stack. Concurrent overwrite is counted as unavailable;
+    // UI frames and unsupported/invalid clocks cannot create intervals.
+    Sample take() noexcept
+    {
+        const auto end = published_.load(std::memory_order_acquire);
+        const auto first = std::max(cursor_, end > capacity ? end - capacity : 0);
+        Sample result;
+        result.unavailable = first - cursor_;
+        std::array<std::uint32_t, capacity> intervals{};
+        std::size_t count = 0;
+        for (auto i = first; i < end; ++i)
+        {
+            const auto packed = ring_[i % capacity].load(std::memory_order_acquire);
+            if (static_cast<std::uint32_t>(packed >> 32) != static_cast<std::uint32_t>(i))
+            {
+                ++result.unavailable;
+                continue;
+            }
+            const auto interval = static_cast<std::uint32_t>(packed);
+            intervals[count++] = interval;
+            result.total_us += interval;
+            const auto bin = interval < 128000 ? interval / 1000
+                : std::min<std::uint32_t>(255, 128 + (interval - 128000) / 8000);
+            ++result.histogram[bin];
+            result.over_50ms += interval > 50'000;
+            result.over_100ms += interval > 100'000;
+        }
+        cursor_ = end;
+        result.intervals = count;
+        if (count)
+        {
+            std::sort(intervals.begin(), intervals.begin() + count);
+            const auto percentile = [&](std::size_t percent)
+            {
+                return intervals[(count * percent + 99) / 100 - 1];
+            };
+            result.median_us = percentile(50);
+            result.p95_us = percentile(95);
+            result.p99_us = percentile(99);
+            result.maximum_us = intervals[count - 1];
+        }
+        return result;
+    }
+private:
+    std::array<std::atomic<std::uint64_t>, capacity> ring_{};
+    std::atomic<std::uint64_t> last_ticks_{0}, published_{0};
+    std::uint64_t cursor_ = 0;
+};
+
+// Maxima are observational window maxima. Drain can split an event's count,
+// sum and maximum over adjacent windows; totals across completed drains are
+// conserved. No lock, allocation or clock call is added to the existing hooks.
+class EventCost final
+{
+public:
+    struct Sample { std::uint64_t count = 0, total = 0, maximum = 0; };
+    void record(std::uint64_t duration) noexcept
+    {
+        count_.fetch_add(1, std::memory_order_relaxed);
+        total_.fetch_add(duration, std::memory_order_relaxed);
+        auto old = maximum_.load(std::memory_order_relaxed);
+        while (old < duration && !maximum_.compare_exchange_weak(old, duration, std::memory_order_relaxed)) {}
+    }
+    Sample take() noexcept
+    {
+        return {count_.exchange(0, std::memory_order_relaxed),
+                total_.exchange(0, std::memory_order_relaxed),
+                maximum_.exchange(0, std::memory_order_relaxed)};
+    }
+private:
+    std::atomic<std::uint64_t> count_{0}, total_{0}, maximum_{0};
+};
+
+struct ProcessMemorySample
+{
+    bool valid = false;
+    std::uint64_t footprint = 0, resident = 0, compressed = 0, virtual_bytes = 0;
+};
+class ProcessMemoryWindow final
+{
+public:
+    void reset() noexcept { latest = {}; peak = {}; samples = 0; }
+    void record(ProcessMemorySample value) noexcept
+    {
+        latest = value;
+        if (!value.valid) return;
+        peak.valid = true;
+        peak.footprint = std::max(peak.footprint, value.footprint);
+        peak.resident = std::max(peak.resident, value.resident);
+        peak.compressed = std::max(peak.compressed, value.compressed);
+        peak.virtual_bytes = std::max(peak.virtual_bytes, value.virtual_bytes);
+        ++samples;
+    }
+    ProcessMemorySample latest{}, peak{};
+    std::uint64_t samples = 0;
+};
+}
diff --git a/rpcs3/ios/IOSShaderTiming.h b/rpcs3/ios/IOSShaderTiming.h
new file mode 100644
index 0000000..e4b2379
--- /dev/null
+++ b/rpcs3/ios/IOSShaderTiming.h
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <ctime>
+#include <sys/resource.h>
+
+namespace rpcs3::ios::shader_timing
+{
+// Measure the actual Vulkan/compiler entry points: the legacy synchronous
+// path does not visit the asynchronous pipeline worker's existing counters.
+// Fixed process-wide storage, no allocation, no logs and no emulation choices.
+enum class Stage : std::size_t { source, module, graphics, compute, debug_source, count };
+inline std::array<diagnostics::EventCost, static_cast<std::size_t>(Stage::count)> costs{};
+
+// CELL538: operation boundaries permit alignment with guest-flip intervals.
+// Fixed 32-entry storage; producers never wait for the reporter or each other.
+// Slow startup bursts may overflow: every rejected record is counted.
+struct PipelineContext
+{
+    std::uint64_t properties = 0, renderpass = 0, vertex_module = 0, fragment_module = 0, flags = 0;
+    // CELL543: written once after the driver call returns, still per actual
+    // construction. Feedback bits: 1 chained, 2 pipeline valid, 4 VS valid,
+    // 8 VS from VkPipelineCache, 16 FS valid, 32 FS from VkPipelineCache.
+    // Durations are MoltenVK-reported; CPU deltas separate this thread's own
+    // conversion work from the rest of the process while it waits on Metal.
+    std::uint32_t feedback = 0, concurrent = 0;
+    std::uint64_t driver_ns = 0, vertex_ns = 0, fragment_ns = 0;
+    std::uint64_t thread_cpu_us = 0, process_cpu_us = 0;
+};
+inline thread_local PipelineContext pipeline_context;
+
+// CELL543: why the cache built: bit 1 new vertex program, 2 new fragment
+// program (neither: an existing shader pair met new state), 4 inline, 8 deferred.
+inline thread_local std::uint32_t build_origin = 0;
+class BuildOriginScope final
+{
+    std::uint32_t previous_ = build_origin;
+public:
+    explicit BuildOriginScope(std::uint32_t value) noexcept { build_origin = value; }
+    ~BuildOriginScope() noexcept { build_origin = previous_; }
+    BuildOriginScope(const BuildOriginScope&) = delete;
+    BuildOriginScope& operator=(const BuildOriginScope&) = delete;
+};
+
+struct CpuClock
+{
+    std::uint64_t thread_us = 0, process_us = 0;
+    static CpuClock now() noexcept
+    {
+        CpuClock result;
+        timespec thread_time{};
+        if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &thread_time) == 0)
+            result.thread_us = static_cast<std::uint64_t>(thread_time.tv_sec) * 1'000'000 + static_cast<std::uint64_t>(thread_time.tv_nsec) / 1000;
+        rusage usage{};
+        if (getrusage(RUSAGE_SELF, &usage) == 0)
+            result.process_us = (static_cast<std::uint64_t>(usage.ru_utime.tv_sec) + static_cast<std::uint64_t>(usage.ru_stime.tv_sec)) * 1'000'000 +
+                static_cast<std::uint64_t>(usage.ru_utime.tv_usec) + static_cast<std::uint64_t>(usage.ru_stime.tv_usec);
+        return result;
+    }
+};
+// Set once per actual pipeline construction, never per draw or SPU operation.
+// RAII restores nested contexts, exceptions and worker reuse without retaining
+// pointers to a renderer or a previous session. Handles are process-local IDs.
+class PipelineContextScope final
+{
+    PipelineContext previous_ = pipeline_context;
+public:
+    explicit PipelineContextScope(PipelineContext value) noexcept { pipeline_context = value; }
+    ~PipelineContextScope() noexcept { pipeline_context = previous_; }
+    PipelineContextScope(const PipelineContextScope&) = delete;
+    PipelineContextScope& operator=(const PipelineContextScope&) = delete;
+};
+struct SlowOperation
+{
+    Stage stage{};
+    std::uint64_t begin_us = 0, end_us = 0;
+    PipelineContext pipeline{};
+    std::uint32_t origin = 0;
+};
+class SlowOperations final
+{
+    std::mutex mutex_;
+    std::array<SlowOperation, 32> events_{};
+    std::size_t size_ = 0;
+    std::atomic<std::uint64_t> dropped_{0};
+public:
+    struct Snapshot
+    {
+        std::array<SlowOperation, 32> events{};
+        std::size_t size = 0;
+        std::uint64_t dropped = 0;
+        bool captured = false;
+    };
+    void record(Stage stage, std::uint64_t begin_us, std::uint64_t end_us) noexcept
+    {
+        if (end_us < begin_us || end_us - begin_us < 50'000) return;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock || size_ == events_.size())
+        {
+            dropped_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        events_[size_++] = {stage, begin_us, end_us,
+            stage == Stage::graphics ? pipeline_context : PipelineContext{},
+            stage == Stage::graphics ? build_origin : 0u};
+    }
+    Snapshot take() noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return {};
+        Snapshot result{events_, size_, dropped_.exchange(0, std::memory_order_relaxed), true};
+        size_ = 0;
+        return result;
+    }
+};
+inline constinit SlowOperations slow_operations;
+
+// CELL536: retain the renderer's actual configuration in periodic evidence.
+// Fixed storage, no renderer dereference, no lock on a frame/compile path.
+struct Configuration
+{
+    bool captured = false, live = false, interpreter_supported = false;
+    std::uint32_t configured = 0, applied = 0;
+    std::uint64_t generation = 0;
+};
+class ConfigurationProfile final
+{
+    mutable std::mutex mutex_;
+    const void* owner_ = nullptr;
+    Configuration value_{};
+public:
+    void begin(const void* owner, std::uint32_t configured, std::uint32_t applied, bool supported)
+    {
+        std::lock_guard lock(mutex_);
+        owner_ = owner;
+        value_ = {true, true, supported, configured, applied, value_.generation + 1};
+    }
+    void end(const void* owner)
+    {
+        std::lock_guard lock(mutex_);
+        if (owner_ != owner) return;
+        owner_ = nullptr;
+        value_ = {true, false, false, 0, 0, value_.generation};
+    }
+    Configuration capture() const
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        return lock ? value_ : Configuration{};
+    }
+};
+inline constinit ConfigurationProfile configuration;
+
+class Scope final
+{
+    using Clock = std::chrono::steady_clock;
+    Stage stage_;
+    Clock::time_point begin_ = Clock::now();
+public:
+    explicit Scope(Stage stage) noexcept : stage_(stage) {}
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+    ~Scope() noexcept
+    {
+        const auto end = Clock::now();
+        const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(end - begin_).count();
+        costs[static_cast<std::size_t>(stage_)].record(static_cast<std::uint64_t>(std::max<std::int64_t>(elapsed, 0)));
+        if (elapsed >= 50'000)
+        {
+            slow_operations.record(stage_,
+                std::chrono::duration_cast<std::chrono::microseconds>(begin_.time_since_epoch()).count(),
+                std::chrono::duration_cast<std::chrono::microseconds>(end.time_since_epoch()).count());
+        }
+    }
+};
+
+inline auto take() noexcept
+{
+    std::array<diagnostics::EventCost::Sample, costs.size()> result{};
+    for (std::size_t i = 0; i < result.size(); ++i) result[i] = costs[i].take();
+    return result;
+}
+
+inline void raise_to(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+{
+    auto old = value.load(std::memory_order_relaxed);
+    while (old < candidate && !value.compare_exchange_weak(old, candidate, std::memory_order_relaxed)) {}
+}
+
+// CELL543: shader-cache disk publication. caller = time the producing thread
+// (normally RSX) spends in store(); write = one complete record on the writer;
+// commit = each atomic temporary write, fsync and rename. Deferred and inline
+// counts show where the I/O ran. A full queue writes inline; nothing is dropped.
+struct PublicationProfile
+{
+    diagnostics::EventCost caller, write, commit;
+    std::atomic<std::uint64_t> deferred{0}, inline_writes{0}, failures{0}, depth_peak{0};
+    struct Sample
+    {
+        diagnostics::EventCost::Sample caller, write, commit;
+        std::uint64_t deferred = 0, inline_writes = 0, failures = 0, depth_peak = 0;
+    };
+    Sample take() noexcept
+    {
+        return {caller.take(), write.take(), commit.take(),
+            deferred.exchange(0, std::memory_order_relaxed), inline_writes.exchange(0, std::memory_order_relaxed),
+            failures.exchange(0, std::memory_order_relaxed), depth_peak.exchange(0, std::memory_order_relaxed)};
+    }
+};
+inline PublicationProfile publication;
+
+// CELL555: bounded recent-key observations, not a pipeline cache. The old table
+// permanently filled during warm-up, losing every later unknown key. Retain
+// the latest 64 admitted identities with FIFO replacement and explicit eviction
+// counts. Repeats are a lifetime lower bound: an evicted identity may return.
+// Raw/UI pipelines lack a complete context and are counted as unattributed,
+// never merged into the all-zero fingerprint. Their timing remains recorded.
+class FingerprintTable final
+{
+public:
+    static constexpr std::size_t capacity = 64;
+    struct Entry { std::uint64_t fingerprint = 0, builds = 0, total_us = 0, max_us = 0; };
+    struct Snapshot
+    {
+        std::uint64_t distinct = 0, repeated_builds = 0, dropped = 0;
+        std::uint64_t tracked = 0, evicted = 0, unattributed = 0;
+        std::array<Entry, 3> costliest{}, repeated{};
+        bool captured = false;
+    };
+    static std::uint64_t fingerprint(const PipelineContext& c) noexcept
+    {
+        auto mix = [](std::uint64_t seed, std::uint64_t value) noexcept
+        {
+            seed ^= value + 0x9e3779b97f4a7c15ull + (seed << 6) + (seed >> 2);
+            return seed;
+        };
+        const auto result = mix(mix(mix(mix(mix(0x51ed270b27aeb4ffull, c.properties), c.renderpass), c.vertex_module), c.fragment_module), c.flags);
+        return result ? result : 1;
+    }
+    void record(const PipelineContext& context, std::uint64_t duration_us) noexcept
+    {
+        if (!context.vertex_module || !context.fragment_module)
+        {
+            unattributed_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        record(fingerprint(context), duration_us);
+    }
+    void record(std::uint64_t key, std::uint64_t duration_us) noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock)
+        {
+            dropped_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        for (std::size_t i = 0; i < capacity; ++i)
+        {
+            auto& entry = entries_[i];
+            if (entry.fingerprint && entry.fingerprint != key) continue;
+            tracked_++;
+            repeated_builds_ += entry.fingerprint ? 1 : 0;
+            entry.fingerprint = key;
+            entry.builds++;
+            entry.total_us += duration_us;
+            entry.max_us = std::max(entry.max_us, duration_us);
+            return;
+        }
+        // Full table: replace one observation, never an actual GPU pipeline.
+        // No allocation, no waiting and no increase in the 64-entry capacity.
+        entries_[next_replacement_] = {key, 1, duration_us, duration_us};
+        next_replacement_ = (next_replacement_ + 1) % capacity;
+        tracked_++;
+        evicted_++;
+    }
+    Snapshot snapshot() noexcept
+    {
+        Snapshot result;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return result;
+        result.captured = true;
+        result.dropped = dropped_.load(std::memory_order_relaxed);
+        result.unattributed = unattributed_.load(std::memory_order_relaxed);
+        result.tracked = tracked_;
+        result.evicted = evicted_;
+        result.repeated_builds = repeated_builds_;
+        for (const auto& entry : entries_)
+        {
+            if (!entry.fingerprint) continue;
+            result.distinct++;
+            auto insert = [&entry](std::array<Entry, 3>& list, auto&& better)
+            {
+                for (auto& slot : list)
+                {
+                    if (!slot.fingerprint || better(entry, slot))
+                    {
+                        auto carry = entry;
+                        for (auto* it = &slot; it != list.data() + list.size(); ++it) std::swap(*it, carry);
+                        return;
+                    }
+                }
+            };
+            insert(result.costliest, [](const Entry& a, const Entry& b) { return a.max_us > b.max_us; });
+            if (entry.builds > 1) insert(result.repeated, [](const Entry& a, const Entry& b) { return a.builds > b.builds; });
+        }
+        return result;
+    }
+    void reset() noexcept
+    {
+        std::lock_guard lock(mutex_);
+        entries_ = {};
+        dropped_.store(0, std::memory_order_relaxed);
+        unattributed_.store(0, std::memory_order_relaxed);
+        tracked_ = repeated_builds_ = evicted_ = 0;
+        next_replacement_ = 0;
+    }
+private:
+    std::mutex mutex_;
+    std::array<Entry, capacity> entries_{};
+    std::atomic<std::uint64_t> dropped_{0};
+    std::atomic<std::uint64_t> unattributed_{0};
+    std::uint64_t tracked_ = 0, repeated_builds_ = 0, evicted_ = 0;
+    std::size_t next_replacement_ = 0;
+};
+
+// CELL543: single-flight, origin and MoltenVK cache attribution counters.
+// Updated once per actual build or wait, never per draw or SPU operation.
+struct PipelineProfile
+{
+    std::atomic<std::uint64_t> new_vertex{0}, new_fragment{0}, state_only{0}, abandoned{0};
+    diagnostics::EventCost pending_wait;
+    std::atomic<std::uint64_t> feedback{0}, vertex_cached{0}, vertex_compiled{0}, fragment_cached{0}, fragment_compiled{0}, cache_additions{0};
+    std::atomic<std::int64_t> live{0};
+    std::atomic<std::uint32_t> in_driver{0};
+    FingerprintTable fingerprints;
+    struct Sample
+    {
+        std::uint64_t new_vertex = 0, new_fragment = 0, state_only = 0, abandoned = 0;
+        diagnostics::EventCost::Sample pending_wait;
+        std::uint64_t feedback = 0, vertex_cached = 0, vertex_compiled = 0, fragment_cached = 0, fragment_compiled = 0, cache_additions = 0;
+        std::int64_t live = 0;
+    };
+    void record_origin(std::uint32_t origin) noexcept
+    {
+        if (origin & 1) new_vertex.fetch_add(1, std::memory_order_relaxed);
+        if (origin & 2) new_fragment.fetch_add(1, std::memory_order_relaxed);
+        if (!(origin & 3)) state_only.fetch_add(1, std::memory_order_relaxed);
+    }
+    void record_feedback(std::uint32_t bits) noexcept
+    {
+        if (!(bits & 1)) return;
+        feedback.fetch_add(1, std::memory_order_relaxed);
+        if (bits & 4) ((bits & 8) ? vertex_cached : vertex_compiled).fetch_add(1, std::memory_order_relaxed);
+        if (bits & 16) ((bits & 32) ? fragment_cached : fragment_compiled).fetch_add(1, std::memory_order_relaxed);
+    }
+    Sample take() noexcept
+    {
+        Sample result;
+        result.new_vertex = new_vertex.exchange(0, std::memory_order_relaxed);
+        result.new_fragment = new_fragment.exchange(0, std::memory_order_relaxed);
+        result.state_only = state_only.exchange(0, std::memory_order_relaxed);
+        result.abandoned = abandoned.exchange(0, std::memory_order_relaxed);
+        result.pending_wait = pending_wait.take();
+        result.feedback = feedback.exchange(0, std::memory_order_relaxed);
+        result.vertex_cached = vertex_cached.exchange(0, std::memory_order_relaxed);
+        result.vertex_compiled = vertex_compiled.exchange(0, std::memory_order_relaxed);
+        result.fragment_cached = fragment_cached.exchange(0, std::memory_order_relaxed);
+        result.fragment_compiled = fragment_compiled.exchange(0, std::memory_order_relaxed);
+        result.cache_additions = cache_additions.exchange(0, std::memory_order_relaxed);
+        result.live = live.load(std::memory_order_relaxed);
+        return result;
+    }
+};
+inline PipelineProfile pipeline_profile;
+}
diff --git a/rpcs3/ios/IOSSignalTrace.h b/rpcs3/ios/IOSSignalTrace.h
new file mode 100644
index 0000000..ca7a32c
--- /dev/null
+++ b/rpcs3/ios/IOSSignalTrace.h
@@ -0,0 +1,375 @@
+#pragma once
+
+// Bounded provenance for one recently acquired non-flip RSX label. This is
+// observational: a completed DMA range does not establish its written value.
+// No additional guest-memory read is performed to guess that value.
+// PPU direct stores, deferred GPU commits and reservation stores are outside
+// this coverage. Absence of a record is never proof of absence of a write.
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rpcs3::ios::signal_trace
+{
+
+inline constexpr std::size_t history_capacity = 64;
+inline constexpr std::size_t producer_capacity = 32;
+inline constexpr std::size_t queue_capacity = 16;
+
+enum class event_kind : std::uint32_t
+{
+	acquire = 1, stalled, resolved, aborted,
+	rsx_release_requested, rsx_cpu_commit, rsx_gpu_deferred,
+	spu_dma_commit, spu_list_commit,
+};
+
+enum class producer_phase : std::uint32_t
+{
+	mfc_blocked = 1, mfc_woke, mfc_irq, mfc_stopped, mfc_ready,
+};
+
+struct watch_state
+{
+	std::uint64_t session{}, acquire_sequence{}, watch_since_us{}, acquire_start_us{}, published_us{};
+	std::uint32_t address{}, expected{}, observed{};
+	bool active{}, stalled{};
+};
+
+struct watch_token
+{
+	std::uint64_t session{}, acquire_sequence{};
+	std::uint32_t address{}, expected{};
+	explicit operator bool() const noexcept { return session != 0; }
+};
+
+struct event
+{
+	std::uint64_t session{}, sequence{}, acquire_sequence{}, timestamp_us{};
+	event_kind kind{};
+	std::uint32_t address{}, expected{}, value{}, producer_id{}, pc{}, write_address{}, write_size{}, command{};
+	// True only for the argument of an executed CPU atomic label store.
+	// DMA records contain a completed range, without an extra guest-memory read.
+	bool value_is_written_argument{};
+	bool value_valid{true};
+};
+
+struct queue_entry
+{
+	std::uint32_t cmd{}, tag{}, lsa{}, eal{}, size{};
+};
+
+struct producer_state
+{
+	std::uint64_t session{}, serial{}, published_us{}, blocked_since_us{}, last_progress_us{};
+	std::uint32_t id{}, pc{}, return_pc{}, size{}, barrier{}, fence{}, stall_mask{}, tag_mask{}, tag_update{};
+	std::uint32_t event_bits{}, event_mask{}, event_count{}, event_waiting{}, interrupts_enabled{}, snr1_count{}, snr2_count{};
+	producer_phase phase{};
+	queue_entry unaccepted{};
+	std::array<queue_entry, queue_capacity> queue{};
+};
+
+template <typename T>
+struct guarded
+{
+	std::atomic_flag busy = ATOMIC_FLAG_INIT;
+	T value{};
+	bool try_lock() noexcept { return !busy.test_and_set(std::memory_order_acquire); }
+	void unlock() noexcept { busy.clear(std::memory_order_release); }
+};
+
+struct counters
+{
+	std::uint64_t events_published{}, events_dropped{}, history_overwritten{}, stale_session_dropped{};
+	std::uint64_t producer_published{}, producer_dropped{}, producer_replaced{}, read_busy{}, watch_changes{};
+	std::uint64_t stalls_total{}, stall_latched{}, stall_overwritten{}, stall_dropped{};
+};
+
+// Counters are process totals, deliberately not reset while old producers can
+// still finish. Session tags isolate payloads, including writes in flight at a
+// reset. Sequence/serial values are process-unique and support deduplication.
+inline std::atomic<bool> enabled{false};
+inline std::atomic<std::uint64_t> current_session{}, next_event{}, next_acquire{}, next_producer{};
+inline std::atomic<std::uint32_t> watched_address{};
+inline guarded<watch_state> watch{};
+inline std::array<guarded<event>, history_capacity> history{};
+inline std::array<guarded<producer_state>, producer_capacity> producers{};
+inline std::atomic<std::uint64_t> events_published{}, events_dropped{}, history_overwritten{}, stale_session_dropped{};
+inline std::atomic<std::uint64_t> producer_published{}, producer_dropped{}, producer_replaced{}, read_busy{}, watch_changes{};
+inline std::atomic<std::uint64_t> stalls_total{}, stall_latched{}, stall_overwritten{}, stall_dropped{};
+
+inline void latch_stall(watch_token token, std::uint32_t observed, std::uint64_t now_us) noexcept;
+
+inline void reset(std::uint64_t session, bool active) noexcept
+{
+	// The profiler supplies a new monotonically increasing session ID for
+	// every start/restore. Old in-flight publications retain their old ID.
+	enabled.store(false, std::memory_order_release);
+	current_session.store(session, std::memory_order_release);
+	watched_address.store(0, std::memory_order_release);
+	enabled.store(active && session != 0, std::memory_order_release);
+}
+
+inline void append(event value) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed) || value.session != current_session.load(std::memory_order_acquire))
+	{
+		stale_session_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	value.sequence = next_event.fetch_add(1, std::memory_order_relaxed) + 1;
+	auto& slot = history[(value.sequence - 1) % history_capacity];
+	if (!slot.try_lock())
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	if (slot.value.sequence > value.sequence)
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+	}
+	else
+	{
+		if (slot.value.sequence)
+			history_overwritten.fetch_add(1, std::memory_order_relaxed);
+		slot.value = value;
+		events_published.fetch_add(1, std::memory_order_relaxed);
+	}
+	slot.unlock();
+}
+
+inline watch_token begin_acquire(std::uint32_t address, std::uint32_t expected, std::uint32_t observed, std::uint64_t now_us) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+		return {};
+	const auto session = current_session.load(std::memory_order_acquire);
+	if (!watch.try_lock())
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+		return {};
+	}
+	const bool changed = watch.value.session != session || watch.value.address != address;
+	if (changed)
+		watch_changes.fetch_add(1, std::memory_order_relaxed);
+	watch_state value{session, next_acquire.fetch_add(1, std::memory_order_relaxed) + 1,
+		changed ? now_us : watch.value.watch_since_us, now_us, now_us, address, expected, observed,
+		observed != expected, false};
+	watch.value = value;
+	watched_address.store(address, std::memory_order_release);
+	watch.unlock();
+	append({session, 0, value.acquire_sequence, now_us, event_kind::acquire, address, expected, observed});
+	return {session, value.acquire_sequence, address, expected};
+}
+
+inline void acquire_state(watch_token token, event_kind kind, std::uint32_t observed, std::uint64_t now_us) noexcept
+{
+	if (!token)
+		return;
+	if (watch.try_lock())
+	{
+		if (watch.value.session == token.session && watch.value.acquire_sequence == token.acquire_sequence)
+		{
+			watch.value.observed = observed;
+			watch.value.published_us = now_us;
+			watch.value.stalled = kind == event_kind::stalled;
+			watch.value.active = kind == event_kind::stalled;
+		}
+		watch.unlock();
+	}
+	else
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+	}
+	append({token.session, 0, token.acquire_sequence, now_us, kind, token.address, token.expected, observed});
+	if (kind == event_kind::stalled)
+		latch_stall(token, observed, now_us);
+}
+
+inline watch_token overlap(std::uint32_t address, std::uint32_t size) noexcept
+{
+	if (!size || !enabled.load(std::memory_order_relaxed))
+		return {};
+	const auto target = watched_address.load(std::memory_order_acquire);
+	// Widen before addition: an invalid wrap must not match an unrelated label.
+	if (!target || std::uint64_t(address) >= std::uint64_t(target) + 4 || std::uint64_t(address) + size <= target)
+		return {};
+	if (!watch.try_lock())
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+		return {};
+	}
+	const auto value = watch.value;
+	watch.unlock();
+	if (value.address != target || value.session != current_session.load(std::memory_order_acquire))
+		return {};
+	return {value.session, value.acquire_sequence, target, value.expected};
+}
+
+inline void write_event(watch_token token, event_kind kind, std::uint32_t value, std::uint64_t now_us,
+	std::uint32_t address, std::uint32_t size, std::uint32_t id = 0, std::uint32_t pc = 0, std::uint32_t command = 0) noexcept
+{
+	if (token)
+		append({token.session, 0, token.acquire_sequence, now_us, kind, token.address, token.expected,
+			value, id, pc, address, size, command, kind == event_kind::rsx_cpu_commit,
+			kind != event_kind::spu_dma_commit && kind != event_kind::spu_list_commit});
+}
+
+inline void publish_producer(producer_state value) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+		return;
+	if (!value.session || value.session != current_session.load(std::memory_order_acquire))
+	{
+		stale_session_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	auto& slot = producers[value.id % producer_capacity];
+	if (!slot.try_lock())
+	{
+		producer_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	const bool previous = slot.value.session == value.session && slot.value.id == value.id;
+	if (previous)
+	{
+		value.last_progress_us = value.size < slot.value.size ? value.published_us : slot.value.last_progress_us;
+		value.blocked_since_us = value.phase == producer_phase::mfc_blocked && slot.value.phase == producer_phase::mfc_blocked
+			? slot.value.blocked_since_us : value.published_us;
+	}
+	else if (slot.value.serial)
+	{
+		producer_replaced.fetch_add(1, std::memory_order_relaxed);
+	}
+	if (!value.blocked_since_us && value.phase == producer_phase::mfc_blocked)
+		value.blocked_since_us = value.published_us;
+	value.serial = next_producer.fetch_add(1, std::memory_order_relaxed) + 1;
+	slot.value = value;
+	slot.unlock();
+	producer_published.fetch_add(1, std::memory_order_relaxed);
+}
+
+struct summary_result
+{
+	std::uint64_t session{};
+	bool enabled{};
+	watch_state watch{};
+	counters totals{};
+};
+
+inline summary_result summary() noexcept
+{
+	summary_result out{};
+	out.session = current_session.load(std::memory_order_acquire);
+	out.enabled = enabled.load(std::memory_order_relaxed);
+	if (watch.try_lock())
+	{
+		if (watch.value.session == out.session)
+			out.watch = watch.value;
+		watch.unlock();
+	}
+	else
+		read_busy.fetch_add(1, std::memory_order_relaxed);
+	out.totals = {events_published.load(), events_dropped.load(), history_overwritten.load(), stale_session_dropped.load(),
+		producer_published.load(), producer_dropped.load(), producer_replaced.load(), read_busy.load(), watch_changes.load(),
+		stalls_total.load(), stall_latched.load(), stall_overwritten.load(), stall_dropped.load()};
+	return out;
+}
+
+struct snapshot_result : summary_result
+{
+	std::array<event, history_capacity> events{};
+	std::array<producer_state, producer_capacity> producers{};
+	std::size_t event_count{}, producer_count{};
+};
+
+// Non-destructive. Ordinary reporting uses summary(); details are sampled only
+// on a bounded stall report. The caller sorts/deduplicates by event sequence
+// and producer serial, and must label snapshot age rather than call it live.
+inline snapshot_result snapshot() noexcept
+{
+	snapshot_result out{};
+	static_cast<summary_result&>(out) = summary();
+	for (auto& slot : history)
+	{
+		if (slot.try_lock())
+		{
+			if (slot.value.session == out.session && slot.value.sequence)
+				out.events[out.event_count++] = slot.value;
+			slot.unlock();
+		}
+		else
+			read_busy.fetch_add(1, std::memory_order_relaxed);
+	}
+	for (auto& slot : producers)
+	{
+		if (slot.try_lock())
+		{
+			if (slot.value.session == out.session && slot.value.serial)
+				out.producers[out.producer_count++] = slot.value;
+			slot.unlock();
+		}
+		else
+			read_busy.fetch_add(1, std::memory_order_relaxed);
+	}
+	return out;
+}
+
+struct retained_stall_state
+{
+	snapshot_result snapshot{};
+	bool pending{};
+};
+
+inline guarded<retained_stall_state> retained_stall{};
+static_assert(sizeof(history) + sizeof(producers) + sizeof(watch) + sizeof(retained_stall) <= 40 * 1024);
+
+inline void latch_stall(watch_token token, std::uint32_t observed, std::uint64_t now_us) noexcept
+{
+	stalls_total.fetch_add(1, std::memory_order_relaxed);
+	auto value = snapshot();
+	if (value.session != token.session || !value.enabled)
+	{
+		stale_session_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	// A busy watch slot must not change the identity of the incident. Unknown
+	// start/watch timestamps remain zero rather than borrowing another acquire.
+	if (value.watch.acquire_sequence != token.acquire_sequence)
+		value.watch = {token.session, token.acquire_sequence, 0, 0, now_us, token.address, token.expected, observed, true, true};
+	value.watch.observed = observed;
+	value.watch.published_us = now_us;
+	value.watch.active = value.watch.stalled = true;
+	if (!retained_stall.try_lock())
+	{
+		stall_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	if (retained_stall.value.pending)
+		stall_overwritten.fetch_add(1, std::memory_order_relaxed);
+	retained_stall.value = {value, true};
+	retained_stall.unlock();
+	stall_latched.fetch_add(1, std::memory_order_relaxed);
+}
+
+// Called only when the reporter's detail-rate quota allows a dump. Resolution
+// and ordinary ring eviction never consume this snapshot of the actual stall.
+inline bool take_stall_snapshot(snapshot_result& out) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+		return false;
+	if (!retained_stall.try_lock())
+	{
+		read_busy.fetch_add(1, std::memory_order_relaxed);
+		return false;
+	}
+	const bool valid = retained_stall.value.pending &&
+		retained_stall.value.snapshot.session == current_session.load(std::memory_order_acquire);
+	if (valid)
+		out = retained_stall.value.snapshot;
+	retained_stall.value.pending = false;
+	retained_stall.unlock();
+	return valid;
+}
+
+}
diff --git a/rpcs3/ios/IOSSpirvCache.h b/rpcs3/ios/IOSSpirvCache.h
new file mode 100644
index 0000000..be40617
--- /dev/null
+++ b/rpcs3/ios/IOSSpirvCache.h
@@ -0,0 +1,381 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Crypto/sha256.h"
+
+#include <zlib.h>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <shared_mutex>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// REWINDBOX_SPIRV_DISK_CACHE_634: every boot of the Build 629 logs regenerates the GLSL of the
+// whole shader cache and compiles it with glslang. Black Ops II multiplayer: 1,072 sources, 5.49 s
+// of CPU (5.1 ms each, 53.8 ms at most), 1.47 s of a 1.60 s warmup, on all 6 cores, before the PPU
+// objects start loading; Assassin's Creed: 412 sources, 1.88 s of CPU. Only one of them is new per
+// 5 s window during the game. The Metal library behind each module is cached, the SPIR-V is not.
+//
+// One file per title holds the SPIR-V of each source, under SHA-256(source, stage, compiler
+// environment): the same text through the same glslang options gives the same words, so what
+// the game gets cannot differ from a compilation. The GLSL is still generated (the key), and the
+// module, the MoltenVK pipeline cache and the program caches see the same words as before.
+// Mapped read-only: clean file pages, not in the footprint, the system drops them under pressure.
+// Nothing here is needed: a missing, truncated or damaged file means compiling, as before. Entries
+// are appended; the valid prefix survives a torn tail, and a damaged entry fails its CRC at use.
+// Old Cores ignore the file. A change of glslang or of its options must change environment_revision.
+namespace rpcs3::ios::spirv_cache
+{
+using key = std::array<std::uint8_t, 32>;
+
+inline constexpr char file_magic[8] = {'R', 'B', 'S', 'P', 'I', 'R', 'V', '1'};
+// SPIRVCommon.cpp: glslang as pinned by the Core, Vulkan 1.2 rules, SPIR-V 1.5, optimizer off, optimizeSize.
+inline constexpr std::uint32_t environment_revision = 0x0105'0634;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 20;
+inline constexpr std::uint32_t max_entry_words = (16u << 20) / 4;
+
+struct file_header
+{
+	char magic[8];
+	std::uint32_t revision;
+	std::uint32_t reserved;
+};
+
+struct entry_header
+{
+	std::uint8_t name[32];
+	std::uint32_t words;
+	std::uint32_t crc;
+};
+
+static_assert(sizeof(file_header) == 16 && sizeof(entry_header) == 40);
+
+inline bool make_key(std::string_view source, std::uint32_t stage, key& out) noexcept
+{
+	const std::uint32_t prefix[2] = {stage, environment_revision};
+	mbedtls_sha256_context context;
+	mbedtls_sha256_init(&context);
+	int result = mbedtls_sha256_starts_ret(&context, 0);
+	if (!result) result = mbedtls_sha256_update_ret(&context, reinterpret_cast<const unsigned char*>(prefix), sizeof(prefix));
+	if (!result) result = mbedtls_sha256_update_ret(&context, reinterpret_cast<const unsigned char*>(source.data()), source.size());
+	if (!result) result = mbedtls_sha256_finish_ret(&context, out.data());
+	mbedtls_sha256_free(&context);
+	return result == 0;
+}
+
+class store
+{
+	struct key_hash
+	{
+		std::size_t operator()(const key& name) const noexcept
+		{
+			std::size_t value;
+			std::memcpy(&value, name.data(), sizeof(value));
+			return value;
+		}
+	};
+
+	struct located
+	{
+		std::uint64_t offset;
+		std::uint32_t words;
+		std::uint32_t crc;
+	};
+
+	mutable std::shared_mutex m_mutex;
+	std::mutex m_write_mutex;
+	std::string m_path;
+	const std::uint8_t* m_map = nullptr;
+	std::size_t m_map_bytes = 0;
+	std::uint64_t m_valid_bytes = 0; // the end of the last good entry: a torn tail starts here
+	std::uint64_t m_pending_bytes = 0;
+	std::uint64_t m_flushing_bytes = 0; // REWINDBOX_SPIRV_CAP_636: the batch flush() is writing, header included
+	std::unordered_map<key, located, key_hash> m_index;
+	std::unordered_map<key, std::vector<std::uint32_t>, key_hash> m_pending;
+	std::unordered_set<key, key_hash> m_written; // this session's entries: not mapped, not added twice
+
+	void unmap() noexcept
+	{
+		if (m_map)
+		{
+			::munmap(const_cast<std::uint8_t*>(m_map), m_map_bytes);
+		}
+
+		m_map = nullptr;
+		m_map_bytes = 0;
+		m_index.clear();
+	}
+
+	void map_file() noexcept
+	{
+		const int file = ::open(m_path.c_str(), O_RDONLY | O_CLOEXEC);
+
+		if (file < 0)
+		{
+			return;
+		}
+
+		struct stat info{};
+
+		if (::fstat(file, &info) == 0 && S_ISREG(info.st_mode) && static_cast<std::uint64_t>(info.st_size) >= sizeof(file_header))
+		{
+			void* const mapped = ::mmap(nullptr, static_cast<std::size_t>(info.st_size), PROT_READ, MAP_PRIVATE, file, 0);
+
+			if (mapped != MAP_FAILED)
+			{
+				m_map = static_cast<const std::uint8_t*>(mapped);
+				m_map_bytes = static_cast<std::size_t>(info.st_size);
+				::madvise(mapped, m_map_bytes, MADV_SEQUENTIAL);
+				index_entries();
+				::madvise(mapped, m_map_bytes, MADV_RANDOM);
+			}
+		}
+
+		::close(file);
+	}
+
+	void index_entries() noexcept
+	{
+		file_header header;
+		std::memcpy(&header, m_map, sizeof(header));
+
+		if (std::memcmp(header.magic, file_magic, sizeof(file_magic)) != 0 || header.revision != environment_revision)
+		{
+			return; // Rewritten from the start at the next flush.
+		}
+
+		std::uint64_t position = sizeof(file_header);
+
+		while (m_map_bytes - position >= sizeof(entry_header))
+		{
+			entry_header entry;
+			std::memcpy(&entry, m_map + position, sizeof(entry));
+			const std::uint64_t bytes = std::uint64_t{entry.words} * sizeof(std::uint32_t);
+
+			if (!entry.words || entry.words > max_entry_words || m_map_bytes - position - sizeof(entry) < bytes)
+			{
+				break;
+			}
+
+			key name;
+			std::memcpy(name.data(), entry.name, name.size());
+			m_index[name] = {position + sizeof(entry), entry.words, entry.crc}; // the last copy wins
+			position += sizeof(entry) + bytes;
+		}
+
+		m_valid_bytes = position;
+	}
+
+	static bool write_all(int file, const void* data, std::size_t size) noexcept
+	{
+		const auto* bytes = static_cast<const std::uint8_t*>(data);
+
+		while (size)
+		{
+			const auto written = ::write(file, bytes, size);
+
+			if (written <= 0)
+			{
+				return false;
+			}
+
+			bytes += written;
+			size -= static_cast<std::size_t>(written);
+		}
+
+		return true;
+	}
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+
+	~store()
+	{
+		close();
+	}
+
+	void open(std::string path) noexcept
+	{
+		close();
+		std::unique_lock lock(m_mutex);
+		m_path = std::move(path);
+		map_file();
+	}
+
+	bool active() const noexcept
+	{
+		std::shared_lock lock(m_mutex);
+		return !m_path.empty();
+	}
+
+	bool find(const key& name, std::vector<std::uint32_t>& words) const
+	{
+		std::shared_lock lock(m_mutex);
+
+		if (const auto pending = m_pending.find(name); pending != m_pending.end())
+		{
+			words = pending->second;
+			return true;
+		}
+
+		const auto found = m_index.find(name);
+
+		if (found == m_index.end())
+		{
+			return false;
+		}
+
+		const std::uint8_t* const payload = m_map + found->second.offset;
+		const std::size_t bytes = std::size_t{found->second.words} * sizeof(std::uint32_t);
+
+		if (::crc32(0, payload, static_cast<uInt>(bytes)) != found->second.crc)
+		{
+			return false;
+		}
+
+		words.resize(found->second.words);
+		std::memcpy(words.data(), payload, bytes);
+		return true;
+	}
+
+	void add(const key& name, const std::vector<std::uint32_t>& words)
+	{
+		const std::uint64_t bytes = sizeof(entry_header) + std::uint64_t{words.size()} * sizeof(std::uint32_t);
+		std::unique_lock lock(m_mutex);
+		// REWINDBOX_SPIRV_CAP_636: the batch flush() is writing and, for an empty file, the header count too.
+		const std::uint64_t header = m_valid_bytes == 0 && m_flushing_bytes == 0 ? sizeof(file_header) : 0;
+
+		if (m_path.empty() || words.empty() || words.size() > max_entry_words ||
+			m_valid_bytes + m_flushing_bytes + header + m_pending_bytes + bytes > max_file_bytes || m_written.contains(name))
+		{
+			return;
+		}
+
+		// A CRC failure in find() brings a damaged entry here: the new copy is the last one.
+		if (m_pending.try_emplace(name, words).second)
+		{
+			m_pending_bytes += bytes;
+		}
+	}
+
+	// Appends what add() kept. A failed write leaves the valid prefix as it was.
+	void flush() noexcept
+	{
+		std::lock_guard writer(m_write_mutex);
+		std::unordered_map<key, std::vector<std::uint32_t>, key_hash> batch;
+		std::uint64_t valid_bytes;
+		std::string path;
+
+		{
+			std::unique_lock lock(m_mutex);
+			batch.swap(m_pending);
+			valid_bytes = m_valid_bytes;
+			path = m_path;
+			// REWINDBOX_SPIRV_CAP_636: reserved until the write ends, so add() keeps counting these bytes.
+			m_flushing_bytes = batch.empty() ? 0 : m_pending_bytes + (valid_bytes == 0 ? sizeof(file_header) : 0);
+			m_pending_bytes = 0;
+		}
+
+		if (batch.empty() || path.empty())
+		{
+			std::unique_lock lock(m_mutex);
+			m_flushing_bytes = 0;
+			return;
+		}
+
+		const int file = ::open(path.c_str(), O_WRONLY | O_CREAT | O_CLOEXEC, 0644);
+
+		if (file < 0)
+		{
+			std::unique_lock lock(m_mutex);
+			m_flushing_bytes = 0;
+			return;
+		}
+
+		bool good = ::ftruncate(file, static_cast<off_t>(valid_bytes)) == 0 && ::lseek(file, static_cast<off_t>(valid_bytes), SEEK_SET) >= 0;
+
+		if (good && !valid_bytes)
+		{
+			file_header header{};
+			std::memcpy(header.magic, file_magic, sizeof(file_magic));
+			header.revision = environment_revision;
+			good = write_all(file, &header, sizeof(header));
+			valid_bytes = sizeof(header);
+		}
+
+		std::vector<key> written;
+
+		for (const auto& [name, words] : batch)
+		{
+			if (!good)
+			{
+				break;
+			}
+
+			const std::size_t bytes = words.size() * sizeof(std::uint32_t);
+
+			// REWINDBOX_SPIRV_CAP_636: the bound holds at the write too, whatever the accounting before it.
+			if (valid_bytes + sizeof(entry_header) + bytes > max_file_bytes)
+			{
+				continue;
+			}
+
+			entry_header entry;
+			std::memcpy(entry.name, name.data(), name.size());
+			entry.words = static_cast<std::uint32_t>(words.size());
+			entry.crc = static_cast<std::uint32_t>(::crc32(0, reinterpret_cast<const Bytef*>(words.data()), static_cast<uInt>(bytes)));
+			good = write_all(file, &entry, sizeof(entry)) && write_all(file, words.data(), bytes);
+
+			if (good)
+			{
+				valid_bytes += sizeof(entry) + bytes;
+				written.push_back(name);
+			}
+		}
+
+		if (!good)
+		{
+			(void)!::ftruncate(file, static_cast<off_t>(valid_bytes));
+		}
+
+		::close(file);
+		std::unique_lock lock(m_mutex);
+		m_valid_bytes = valid_bytes;
+		m_flushing_bytes = 0;
+		m_written.insert(written.begin(), written.end());
+	}
+
+	void close() noexcept
+	{
+		flush();
+		std::unique_lock lock(m_mutex);
+		unmap();
+		m_path.clear();
+		m_pending.clear();
+		m_written.clear();
+		m_pending_bytes = 0;
+		m_flushing_bytes = 0;
+		m_valid_bytes = 0;
+	}
+};
+
+inline store& instance() noexcept
+{
+	static store global;
+	return global;
+}
+}
diff --git a/rpcs3/ios/IOSSpuNoopSpin.h b/rpcs3/ios/IOSSpuNoopSpin.h
new file mode 100644
index 0000000..4162bfa
--- /dev/null
+++ b/rpcs3/ios/IOSSpuNoopSpin.h
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_SPU_NOOP_SPIN_WAIT_627: Build 624 logs (PID 1893, Black Ops II). The six
+// CellSpursKernel threads take 5.0-5.3 cores in the menus and 3.3-4.0 in a match, on a
+// device with two performance cores, while they complete 5-7 million PUTLLC per 5 s
+// window with almost no failure (0-4,900) and SPUWAIT551 getllar_poll=0.
+// With Accurate SPU Reservations off, a PUTLLC that writes back the data it read returns
+// at the top of do_putllc() with raddr = 0, without touching the reservation. The next
+// GETLLAR then finds no reservation and takes the plain read path: everything RPCS3 has
+// against SPU polling (the spin detection, the passive wait on the reservation notifier,
+// SPU GETLLAR Busy Waiting Percentage, SPU Spin Timing) sits in the "raddr == addr"
+// branch and is never reached. The polling loop GETLLAR, no-op PUTLLC, GETLLAR runs at about
+// 4 us per round on every thread, on lines of the title's own job queues (FREEZE_DUMP:
+// 0x2e20880, 0x2e20c00, several lines per thread).
+//
+// A thread is polling once it has completed `streak_threshold` no-op PUTLLC in a row, each
+// within `spin_gap_ns` of the previous one, on lines that keep their reservation time. Real
+// progress does not always reach do_putllc(): with this setting's reservation mode the
+// recognised 16-byte atomics are inlined by the recompiler (putllc16_pattern) and PUTLLUC has
+// its own path. So the tracker keeps the last `polled_lines` lines with their times: a line
+// whose time moved, or one it has not seen, restarts the streak, and a loop over more lines
+// than that never reaches a wait.
+//
+// A polling thread's next no-op PUTLLC sleeps on the reservation notifier of the line before
+// it returns, for a bounded time that doubles from first_wait_ns to max_wait_ns, unless the
+// line already changed. The PUTLLC has stored nothing and its result is decided: the sleep is
+// what a host preemption of the SPU thread at that point would be, and the next GETLLAR reads
+// as usual. A wait that ends early restarts the streak. One that times out leaves
+// `rearm_rounds` rounds before the next one, and that spacing bounds the two costs left:
+// - A wrong guess: work the tracker cannot see, on a line it does not poll, in rounds shorter
+//   than spin_gap_ns. A 40 us round loses at most a third of its time, not five sixths.
+// - The wait is on one line of the loop, and direct reservation stores do not always notify
+//   (docs/PROJECT_RULES.md; the inlined PUTLLC16 notifies another word): the bound, not the
+//   notifier, is what ends it. One pass over the polled lines holds at most one wait, so a new
+//   job waits at most max_wait_ns more, plus the pass.
+// At max_wait_ns and 4.3 us per round a thread makes about 41,000 rounds per second instead of
+// 230,000 and uses about 18 % of a core. Model figures: the device decides.
+// The tracker lives in a thread_local of SPUThread.cpp (spu_thread's layout is a codegen
+// input), and process_mfc_cmd, the input of the reused full-queue harness, does not change.
+namespace rpcs3::ios::spu_noop_spin
+{
+inline constexpr std::uint32_t streak_threshold = 64;      // about 280 us of polling at 4.3 us per round
+inline constexpr std::uint32_t rearm_rounds = 8;           // rounds between two waits, at least polled_lines
+inline constexpr std::size_t polled_lines = 8;             // lines one polling loop can watch
+inline constexpr std::uint64_t spin_gap_ns = 50'000;       // a longer gap means real work ran in between
+inline constexpr std::uint64_t first_wait_ns = 20'000;
+inline constexpr std::uint64_t max_wait_ns = 160'000;
+
+class tracker
+{
+	struct polled_line
+	{
+		std::uint32_t addr = 0;
+		std::uint64_t rtime = 0;
+	};
+
+	std::array<polled_line, polled_lines> m_lines{};
+	std::size_t m_line_count = 0;
+	std::uint64_t m_last_tick = 0;
+	std::uint64_t m_wait_ns = first_wait_ns;
+	std::uint32_t m_streak = 0;
+
+	void restart() noexcept
+	{
+		m_streak = 0;
+		m_wait_ns = first_wait_ns;
+	}
+
+public:
+	// do_putllc(): a PUTLLC on `addr`, whose reservation time the thread read as `rtime`, wrote
+	// nothing back and completed at `now` (ticks).
+	void on_noop(std::uint64_t now, std::uint64_t gap_ticks, std::uint32_t addr, std::uint64_t rtime) noexcept
+	{
+		if (now - m_last_tick > gap_ticks)
+		{
+			restart();
+			m_line_count = 0;
+		}
+
+		m_last_tick = now;
+
+		for (std::size_t i = 0; i < m_line_count; i++)
+		{
+			if (m_lines[i].addr != addr)
+			{
+				continue;
+			}
+
+			if (m_lines[i].rtime != rtime)
+			{
+				m_lines[i].rtime = rtime; // somebody wrote it, possibly this thread with no PUTLLC seen here
+				restart();
+			}
+			else if (m_streak < streak_threshold)
+			{
+				m_streak++;
+			}
+
+			return;
+		}
+
+		// Not the loop of this streak, or not yet.
+		m_line_count = m_line_count < polled_lines ? m_line_count + 1 : 1;
+		m_lines[m_line_count - 1] = {addr, rtime};
+		restart();
+	}
+
+	// do_putllc(): a PUTLLC that changes data; the thread is working.
+	void on_progress() noexcept
+	{
+		restart();
+	}
+
+	// The thread is polling: wait now.
+	bool due() const noexcept
+	{
+		return m_streak >= streak_threshold;
+	}
+
+	// The bound of the wait about to start; the next one doubles it.
+	std::uint64_t next_wait_ns() noexcept
+	{
+		const std::uint64_t value = m_wait_ns;
+		m_wait_ns = value * 2 < max_wait_ns ? value * 2 : max_wait_ns;
+		return value;
+	}
+
+	// After the wait, at `now` (ticks): the sleep is not a gap. A wait that ended before half
+	// of its bound was woken by a write to the line, or never started: the thread polls again
+	// from the start. Otherwise it runs rearm_rounds rounds before the next wait.
+	void on_woken(std::uint64_t now, std::uint64_t waited_ns, std::uint64_t bound_ns) noexcept
+	{
+		m_last_tick = now;
+
+		if (waited_ns < bound_ns / 2)
+		{
+			restart();
+		}
+		else
+		{
+			m_streak = streak_threshold - rearm_rounds;
+		}
+	}
+};
+}
diff --git a/rpcs3/ios/IOSSpuObjectBindings.h b/rpcs3/ios/IOSSpuObjectBindings.h
new file mode 100644
index 0000000..e2ccd63
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectBindings.h
@@ -0,0 +1,355 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+// REWINDBOX_SPU_DIRECT_OBJECT_HIT_660: Black Ops II links 8,700-8,800 SPU blocks at the first
+// transition of each boot, every one of them a hit of the persistent object cache (IPA 657,
+// Core 655, session 2 window 5: 8,793 blocks). A hit still builds the whole IR of the block,
+// only to name the symbols the cached object needs, then throws it away: about 0.19 ms of
+// spu_build per block next to 0.18 ms of object load.
+//
+// The object itself already names what it needs. Its undefined symbols are exactly the names
+// the IR declared and mapped on the engine:
+// - the helper of every call("name", function, ...) of the block translator (CPUTranslator.h
+//   call() maps the literal name to that function), plus spu_dispatcher, spu_timebase_offs and
+//   spu_segment_base, each mapped by one line of SPULLVMRecompiler.cpp;
+// - "<module name>-pp-<N>", one fresh branch patchpoint (make_branch_patchpoint(), data 0) each.
+// A hit whose undefined symbols are all of these links the object directly: the bindings are the
+// same expressions the IR path maps under the same names, the patchpoints are fresh stubs of the
+// same kind. Anything else (a name the table does not know, libm, memcpy, outline atomics, an
+// absolute global, a duplicate, a malformed or out-of-bound patchpoint, a second definition, a
+// missing entry, a failed copy of the object) leaves the object to the IR path of the same
+// compile() call, exactly as before.
+//
+// Name resolution is MCJIT's and the same on both paths (LLVM 18 and 20, checked on the host): an
+// undefined name of an object being loaded resolves first from RuntimeDyld's own table, which holds
+// every named definition of the objects already loaded in this engine, local and internal ones
+// included; then from the engine's resolver (the global map, where the bindings are, then that
+// table); last from the memory manager (MemoryManager1/2::findSymbol in Utilities/JITLLVM.cpp:
+// process symbols, then make_null_function()). The global map does not come first: a binding
+// decides a name only because no object of this engine defines that name. None does: a block
+// object defines its entry (its only global) and the locals spu_test_state, __spu-null,
+// __spu-cx*, __spu-fx*, __unnamed_N and the $x/$d mapping symbols; the LLVM interpreter object
+// defines spu_interpreter, spu_<MNEMONIC>[_<hex>], spu_ret and __unnamed_N. No table name and no
+// "<hash>-pp-<N>" name is among them, and the host audit (spu_direct_hit660_test.py) fails if one
+// of these names gets a body, an initializer or an internal or private linkage anywhere in
+// SPULLVMRecompiler.cpp or CPUTranslator.h. The IR hit path links the same object under the same
+// names in the same engine, with exactly this precedence too.
+//
+// This header only classifies a symbol list against a table of names. It has no LLVM or RPCS3
+// dependency so that the host test compiles it as it is.
+namespace rpcs3::ios::spu_direct_hit
+{
+inline std::atomic<bool> enabled{false}; // experimental.spu_direct_object_hits
+
+enum class reason : std::uint32_t
+{
+	accepted,
+	object_unreadable,    // the object does not parse or is not for this engine's architecture
+	symbol_unreadable,    // a symbol name or flags could not be read
+	symbol_bound,         // more symbols than max_symbols
+	absolute_global,      // a global absolute symbol (same rule as JITMinimalObject.h)
+	unknown_symbol,       // an undefined name that is neither a table name nor a patchpoint of this module
+	duplicate_symbol,     // an undefined name listed twice
+	malformed_patchpoint, // "<entry>-pp-" followed by anything but the regenerated decimal number
+	patchpoint_bound,     // a patchpoint number or count above the bounds
+	foreign_definition,   // a defined global symbol that is not the entry
+	missing_entry,        // the entry is not defined
+	duplicate_entry,      // the entry is defined twice
+	null_binding,         // a table expression evaluated to 0 in this process
+	copy_failed,          // the copy of the object handed to MCJIT could not be allocated
+	add_rejected,         // jit_minimal_object::add refused the object before loading it
+	count
+};
+
+inline constexpr std::size_t reason_count = static_cast<std::size_t>(reason::count);
+
+inline constexpr std::array<std::string_view, reason_count> reason_names{
+	"accepted", "object_unreadable", "symbol_unreadable", "symbol_bound", "absolute_global", "unknown_symbol",
+	"duplicate_symbol", "malformed_patchpoint", "patchpoint_bound", "foreign_definition", "missing_entry",
+	"duplicate_entry", "null_binding", "copy_failed", "add_rejected"};
+static_assert(!reason_names[reason_count - 1].empty(), "one name per reason");
+
+struct symbol
+{
+	std::string_view name;
+	bool readable = true;   // name and flags could be read
+	bool undefined = false; // SF_Undefined
+	bool absolute = false;  // SF_Absolute
+	bool global = false;    // SF_Global
+};
+
+struct plan
+{
+	reason result = reason::accepted;
+	std::vector<std::uint32_t> named;       // indices into the binding table, ascending, each once
+	std::vector<std::uint32_t> patchpoints; // patchpoint numbers, ascending, each once
+	std::string_view offending;             // the symbol that decided a rejection (a view of the input: copy it)
+};
+
+inline constexpr std::size_t max_symbols = 65536;
+inline constexpr std::uint32_t max_patchpoint = (1u << 20) - 1;
+
+// The direct path never allocates more stubs than this for one block. The IR path allocates one per
+// tail_chunk(nullptr) of each emitted chunk; an object above the bound keeps the IR path.
+constexpr std::size_t patchpoint_limit(std::size_t guest_words) noexcept
+{
+	return std::min<std::size_t>(guest_words * 16 + 64, std::size_t{max_patchpoint} + 1);
+}
+
+// name == entry + "-pp-" + decimal(id) exactly, the way fmt::format("%s-pp-%u", m_hash, id) wrote it:
+// no sign, no leading zero, no suffix, a value that fits 32 bits.
+constexpr bool parse_patchpoint(std::string_view entry, std::string_view name, std::uint32_t& id) noexcept
+{
+	constexpr std::string_view infix = "-pp-";
+	if (name.size() <= entry.size() + infix.size() || name.substr(0, entry.size()) != entry ||
+		name.substr(entry.size(), infix.size()) != infix)
+	{
+		return false;
+	}
+
+	const std::string_view digits = name.substr(entry.size() + infix.size());
+	std::uint32_t value = 0;
+	const auto [end, error] = std::from_chars(digits.data(), digits.data() + digits.size(), value, 10);
+	if (error != std::errc() || end != digits.data() + digits.size())
+	{
+		return false;
+	}
+
+	char regenerated[16]{};
+	const auto [last, error2] = std::to_chars(regenerated, regenerated + sizeof(regenerated), value, 10);
+	if (error2 != std::errc() || std::string_view(regenerated, static_cast<std::size_t>(last - regenerated)) != digits)
+	{
+		return false;
+	}
+
+	id = value;
+	return true;
+}
+
+constexpr bool is_patchpoint_name(std::string_view entry, std::string_view name) noexcept
+{
+	constexpr std::string_view infix = "-pp-";
+	return name.size() >= entry.size() + infix.size() && name.substr(0, entry.size()) == entry &&
+		name.substr(entry.size(), infix.size()) == infix;
+}
+
+// Every undefined, named symbol must be a table name or a patchpoint of `entry`; the entry must be the
+// only defined global symbol, defined once. Undefined symbols without a name are ignored, as
+// JITMinimalObject.h ignores them.
+inline plan classify(std::string_view entry, std::span<const symbol> symbols, std::span<const std::string_view> table,
+	std::size_t max_patchpoints)
+{
+	plan result;
+	const auto reject = [&](reason why, std::string_view name)
+	{
+		result.result = why;
+		result.offending = name;
+		result.named.clear();
+		result.patchpoints.clear();
+		return result;
+	};
+
+	if (entry.empty() || symbols.size() > max_symbols)
+	{
+		return reject(entry.empty() ? reason::missing_entry : reason::symbol_bound, {});
+	}
+
+	std::size_t entries = 0;
+	std::vector<bool> seen(table.size(), false);
+
+	for (const symbol& sym : symbols)
+	{
+		if (!sym.readable)
+		{
+			return reject(reason::symbol_unreadable, sym.name);
+		}
+
+		if (sym.absolute && sym.global)
+		{
+			return reject(reason::absolute_global, sym.name);
+		}
+
+		if (!sym.undefined)
+		{
+			if (sym.name == entry)
+			{
+				// MCJIT finds the entry by name among the global symbols of the loaded objects.
+				if (!sym.global)
+				{
+					return reject(reason::missing_entry, sym.name);
+				}
+
+				if (++entries > 1)
+				{
+					return reject(reason::duplicate_entry, sym.name);
+				}
+			}
+			else if (sym.global)
+			{
+				return reject(reason::foreign_definition, sym.name);
+			}
+
+			continue;
+		}
+
+		if (sym.name.empty())
+		{
+			continue;
+		}
+
+		const auto found = std::find(table.begin(), table.end(), sym.name);
+		if (found != table.end())
+		{
+			const auto index = static_cast<std::size_t>(found - table.begin());
+			if (seen[index])
+			{
+				return reject(reason::duplicate_symbol, sym.name);
+			}
+
+			seen[index] = true;
+			continue;
+		}
+
+		if (!is_patchpoint_name(entry, sym.name))
+		{
+			return reject(reason::unknown_symbol, sym.name);
+		}
+
+		std::uint32_t id = 0;
+		if (!parse_patchpoint(entry, sym.name, id))
+		{
+			return reject(reason::malformed_patchpoint, sym.name);
+		}
+
+		if (id > max_patchpoint || result.patchpoints.size() >= max_patchpoints)
+		{
+			return reject(reason::patchpoint_bound, sym.name);
+		}
+
+		result.patchpoints.push_back(id);
+	}
+
+	if (!entries)
+	{
+		return reject(reason::missing_entry, entry);
+	}
+
+	std::sort(result.patchpoints.begin(), result.patchpoints.end());
+	if (std::adjacent_find(result.patchpoints.begin(), result.patchpoints.end()) != result.patchpoints.end())
+	{
+		return reject(reason::duplicate_symbol, {});
+	}
+
+	for (std::size_t index = 0; index < seen.size(); ++index)
+	{
+		if (seen[index])
+		{
+			result.named.push_back(static_cast<std::uint32_t>(index));
+		}
+	}
+
+	return result;
+}
+
+// The fallback notice of compile() ("SPUDIRECT660 fallback <reason>: <symbol> (<module>)"): the first 8
+// hits of each reason in this process, then every 256th, as should_emit_spu_compile_diagnostic() in
+// SPULLVMRecompiler.cpp limits its diagnostics. An accepted hit formats nothing.
+inline bool should_log_fallback(reason why) noexcept
+{
+	static std::array<std::atomic<std::uint64_t>, reason_count> seen{};
+	const auto index = static_cast<std::size_t>(why);
+	if (why == reason::accepted || index >= reason_count)
+	{
+		return false;
+	}
+
+	const std::uint64_t current = seen[index].fetch_add(1, std::memory_order_relaxed) + 1;
+	return current <= 8 || (current % 256) == 0;
+}
+
+// Per-window counters for COREPROF SPUDIRECT660 (rpcs3/ios/RPCS3IOSPerformance.cpp). Ticks are TSC ticks.
+struct window_counters
+{
+	std::uint64_t direct = 0, direct_bytes = 0;     // blocks linked directly, their object bytes
+	std::uint64_t direct_ticks = 0, direct_max_ticks = 0; // compile() start to the published entry
+	std::uint64_t classify_ticks = 0;               // object parse, classification and bindings
+	std::uint64_t link_ticks = 0;                   // add + finalize of the object
+	std::uint64_t bindings = 0, patchpoints = 0;    // table bindings and patchpoint stubs of those blocks
+	std::uint64_t failures = 0;                     // link/finalize/entry failures, handled as on the IR path
+	std::array<std::uint64_t, reason_count> fallbacks{}; // hits left to the IR path, by reason
+};
+
+class counters
+{
+	std::atomic<std::uint64_t> m_direct{0}, m_direct_bytes{0}, m_direct_ticks{0}, m_direct_max_ticks{0};
+	std::atomic<std::uint64_t> m_classify_ticks{0}, m_link_ticks{0}, m_bindings{0}, m_patchpoints{0}, m_failures{0};
+	std::array<std::atomic<std::uint64_t>, reason_count> m_fallbacks{};
+
+public:
+	void record_direct(std::uint64_t bytes, std::uint64_t ticks, std::uint64_t classify_ticks, std::uint64_t link_ticks,
+		std::uint64_t bindings, std::uint64_t patchpoints) noexcept
+	{
+		m_direct.fetch_add(1, std::memory_order_relaxed);
+		m_direct_bytes.fetch_add(bytes, std::memory_order_relaxed);
+		m_direct_ticks.fetch_add(ticks, std::memory_order_relaxed);
+		m_classify_ticks.fetch_add(classify_ticks, std::memory_order_relaxed);
+		m_link_ticks.fetch_add(link_ticks, std::memory_order_relaxed);
+		m_bindings.fetch_add(bindings, std::memory_order_relaxed);
+		m_patchpoints.fetch_add(patchpoints, std::memory_order_relaxed);
+		std::uint64_t seen = m_direct_max_ticks.load(std::memory_order_relaxed);
+		while (ticks > seen && !m_direct_max_ticks.compare_exchange_weak(seen, ticks, std::memory_order_relaxed))
+		{
+		}
+	}
+
+	void record_fallback(reason why) noexcept
+	{
+		const auto index = static_cast<std::size_t>(why);
+		if (index < reason_count)
+		{
+			m_fallbacks[index].fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	void record_failure() noexcept
+	{
+		m_failures.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	window_counters take_window() noexcept
+	{
+		window_counters result;
+		result.direct = m_direct.exchange(0, std::memory_order_relaxed);
+		result.direct_bytes = m_direct_bytes.exchange(0, std::memory_order_relaxed);
+		result.direct_ticks = m_direct_ticks.exchange(0, std::memory_order_relaxed);
+		result.direct_max_ticks = m_direct_max_ticks.exchange(0, std::memory_order_relaxed);
+		result.classify_ticks = m_classify_ticks.exchange(0, std::memory_order_relaxed);
+		result.link_ticks = m_link_ticks.exchange(0, std::memory_order_relaxed);
+		result.bindings = m_bindings.exchange(0, std::memory_order_relaxed);
+		result.patchpoints = m_patchpoints.exchange(0, std::memory_order_relaxed);
+		result.failures = m_failures.exchange(0, std::memory_order_relaxed);
+		for (std::size_t index = 0; index < reason_count; ++index)
+		{
+			result.fallbacks[index] = m_fallbacks[index].exchange(0, std::memory_order_relaxed);
+		}
+		return result;
+	}
+};
+
+inline counters& stats() noexcept
+{
+	static counters instance;
+	return instance;
+}
+}
diff --git a/rpcs3/ios/IOSSpuObjectPrefetch.h b/rpcs3/ios/IOSSpuObjectPrefetch.h
new file mode 100644
index 0000000..62dc2dd
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectPrefetch.h
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <sys/qos.h>
+#endif
+
+// REWINDBOX_SPU_OBJECT_PREFETCH_616: Call of Duty: Black Ops II (BLES01717),
+// Build 614 iPhone logs (PID 64664, multiplayer session 3). At the start of a
+// match one 5 s window opens 7,162 cached SPU objects (JITPROF spu_cache_read
+// 7,162 calls, 4,300.8 ms, 21.2 MB inflated, 0.6 ms per object of about 3 KB):
+// the cost of opening thousands of small files on the compile path, not their
+// size. The 2,038.7 ms frame 2388 of that window has no blocking pipeline and
+// no LLVM budget wait; the 1,121.4 ms frame 3537 (window 17) also falls in a
+// burst of 613 object reads. The objects are already on disk: this module reads
+// the bytes of the title's object directory into memory on one utility-class
+// thread from the runtime's creation (menus, loading), newest objects first and
+// within a byte budget. A compile thread that needs an object takes its bytes
+// once (they leave the store) and inflates and validates them exactly as it
+// would after reading the file; an object not read yet is claimed and read from
+// the disk as before, never awaited. Same bytes, same validation, same link:
+// guest code is unchanged. Title scoped (ios/IOSTitleLevers.h); the store is
+// emptied when emulation stops.
+namespace rpcs3::ios::spu_object_prefetch
+{
+inline constexpr std::uint64_t max_resident_bytes = 48ull << 20;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 10; // larger objects keep the disk path
+inline constexpr std::uint64_t min_file_bytes = 18;           // smallest gzip member
+
+struct candidate
+{
+	std::string name;
+	std::uint64_t bytes = 0;
+	std::int64_t mtime = 0;
+};
+
+// Compressed objects (".gz") within the per-file bounds, newest first (then by
+// name), as long as they fit in the budget.
+inline std::vector<candidate> plan(std::vector<candidate> entries, std::uint64_t budget = max_resident_bytes,
+	std::uint64_t file_limit = max_file_bytes)
+{
+	std::erase_if(entries, [file_limit](const candidate& entry)
+	{
+		const std::string_view name = entry.name;
+		return name.size() <= 3 || name.substr(name.size() - 3) != ".gz" || entry.bytes < min_file_bytes || entry.bytes > file_limit;
+	});
+
+	std::sort(entries.begin(), entries.end(), [](const candidate& a, const candidate& b)
+	{
+		return a.mtime != b.mtime ? a.mtime > b.mtime : a.name < b.name;
+	});
+
+	std::vector<candidate> chosen;
+	std::uint64_t total = 0;
+
+	for (candidate& entry : entries)
+	{
+		if (entry.bytes > budget - total)
+		{
+			continue;
+		}
+
+		total += entry.bytes;
+		chosen.push_back(std::move(entry));
+	}
+
+	return chosen;
+}
+
+// Reads the whole file into `out`; false when it cannot or its size is not `expected`.
+using reader_fn = std::function<bool(const std::string& path, std::uint64_t expected, std::vector<unsigned char>& out)>;
+
+struct window_counters
+{
+	std::uint64_t hits = 0, hit_bytes = 0;   // objects served from memory
+	std::uint64_t claimed = 0;               // planned objects a compile thread read from disk first
+	std::uint64_t dropped = 0;               // read, but claimed meanwhile
+	std::uint64_t read = 0, read_bytes = 0, read_us = 0, failures = 0;
+};
+
+struct gauges
+{
+	bool active = false, done = false;
+	std::uint64_t planned = 0, planned_bytes = 0, pending = 0, resident = 0, resident_bytes = 0;
+};
+
+class store
+{
+	mutable std::mutex m_mutex;
+	std::unordered_map<std::string, std::vector<unsigned char>> m_ready; // full path of the ".gz" object
+	std::unordered_set<std::string> m_pending;                         // planned, neither read nor claimed
+	std::uint64_t m_resident_bytes = 0, m_planned = 0, m_planned_bytes = 0;
+	std::thread m_worker;
+	std::atomic<bool> m_stop{false}, m_active{false}, m_done{false};
+	window_counters m_window{};
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+	~store() { stop(); }
+
+	void start(std::string directory, std::vector<candidate> chosen, reader_fn reader)
+	{
+		stop();
+
+		{
+			std::lock_guard lock(m_mutex);
+			m_planned = chosen.size();
+			m_planned_bytes = 0;
+
+			for (const candidate& entry : chosen)
+			{
+				m_pending.insert(directory + entry.name);
+				m_planned_bytes += entry.bytes;
+			}
+		}
+
+		m_stop.store(false);
+		m_done.store(chosen.empty());
+		m_active.store(true);
+
+		if (chosen.empty())
+		{
+			return;
+		}
+
+		m_worker = std::thread([this, directory = std::move(directory), chosen = std::move(chosen), reader = std::move(reader)]()
+		{
+#if defined(__APPLE__)
+			pthread_setname_np("SPU object prefetch");
+			pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#endif
+			for (const candidate& entry : chosen)
+			{
+				if (m_stop.load(std::memory_order_relaxed))
+				{
+					break;
+				}
+
+				std::string path = directory + entry.name;
+
+				{
+					std::lock_guard lock(m_mutex);
+					if (!m_pending.contains(path))
+					{
+						continue; // claimed by a compile thread
+					}
+				}
+
+				std::vector<unsigned char> bytes;
+				const auto started = std::chrono::steady_clock::now();
+				const bool ok = reader(path, entry.bytes, bytes) && bytes.size() == entry.bytes;
+				const auto elapsed = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - started).count());
+
+				std::lock_guard lock(m_mutex);
+				m_window.read_us += elapsed;
+
+				if (!m_pending.erase(path))
+				{
+					m_window.dropped++;
+					continue;
+				}
+
+				if (!ok)
+				{
+					m_window.failures++;
+					continue;
+				}
+
+				m_window.read++;
+				m_window.read_bytes += bytes.size();
+				m_resident_bytes += bytes.size();
+				m_ready.emplace(std::move(path), std::move(bytes));
+			}
+
+			m_done.store(true);
+		});
+	}
+
+	// The prefetched bytes of this ".gz" object, once; nothing when they are
+	// not in memory (the caller reads the file, and the worker will skip it).
+	std::optional<std::vector<unsigned char>> take(const std::string& gz_path)
+	{
+		if (!m_active.load(std::memory_order_relaxed))
+		{
+			return std::nullopt;
+		}
+
+		std::lock_guard lock(m_mutex);
+
+		if (auto found = m_ready.find(gz_path); found != m_ready.end())
+		{
+			std::vector<unsigned char> bytes = std::move(found->second);
+			m_ready.erase(found);
+			m_resident_bytes -= bytes.size();
+			m_window.hits++;
+			m_window.hit_bytes += bytes.size();
+			return bytes;
+		}
+
+		if (m_pending.erase(gz_path))
+		{
+			m_window.claimed++;
+		}
+
+		return std::nullopt;
+	}
+
+	// Joins the worker and frees every byte still held.
+	void stop()
+	{
+		m_stop.store(true);
+
+		if (m_worker.joinable())
+		{
+			m_worker.join();
+		}
+
+		m_active.store(false);
+		std::lock_guard lock(m_mutex);
+		m_ready.clear();
+		m_pending.clear();
+		m_resident_bytes = 0;
+		m_planned = 0;
+		m_planned_bytes = 0;
+	}
+
+	window_counters take_window()
+	{
+		std::lock_guard lock(m_mutex);
+		return std::exchange(m_window, window_counters{});
+	}
+
+	gauges current() const
+	{
+		std::lock_guard lock(m_mutex);
+		return {m_active.load(), m_done.load(), m_planned, m_planned_bytes, m_pending.size(), m_ready.size(), m_resident_bytes};
+	}
+};
+
+inline store& instance()
+{
+	static store s_store;
+	return s_store;
+}
+}
diff --git a/rpcs3/ios/IOSSpuWaitProfile.h b/rpcs3/ios/IOSSpuWaitProfile.h
new file mode 100644
index 0000000..7167ee8
--- /dev/null
+++ b/rpcs3/ios/IOSSpuWaitProfile.h
@@ -0,0 +1,130 @@
+#pragma once
+
+// REWINDBOX_SPU_WAIT_PROFILE_V1: where SPU threads spend time outside guest
+// code. The 547 God of War III logs show about 3.4 SPU cores per frame, also
+// while every draw waited for a pipeline, with almost no confirmed GETLLAR
+// poll (PRESSURE547 spu_passive_waits 0-33): which wait burns that CPU was not
+// measurable. Counters live in per-thread slots written only by their owner
+// (relaxed load + store, no shared read-modify-write on the hot paths); the
+// profiler sums every slot. Slots are claimed at first use and released when
+// the thread exits; totals only grow, so window deltas stay exact.
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rpcs3::ios::spu_wait
+{
+	enum counter : std::size_t
+	{
+		getllar_poll_ticks, // busy polling of unchanged reservation data, between consecutive polls
+		getllar_polls,
+		getllar_sleep_ticks, // a polling GETLLAR asleep on the reservation notifier
+		getllar_sleeps,
+		event_wait_ticks, // RdEventStat calls that had to wait (busy and passive)
+		event_waits,
+		putllc_ok,
+		putllc_fail,
+		putllc_heavy, // stores under the exclusive vm::writer_lock (every running PPU parked)
+		counter_count
+	};
+
+	// A gap above this between two polls is a new polling episode, not polling time.
+	inline constexpr std::uint64_t poll_gap_ns = 20'000;
+
+	struct alignas(128) slot
+	{
+		std::array<std::atomic<std::uint64_t>, counter_count> value{};
+		std::atomic<bool> owned{false};
+	};
+
+	inline constexpr std::size_t slot_count = 32;
+
+	// The last slot is shared by threads beyond slot_count and uses fetch_add.
+	inline std::array<slot, slot_count + 1> g_slots{};
+
+	struct claim
+	{
+		slot* owned = nullptr;
+		std::uint64_t last_poll = 0;
+
+		~claim()
+		{
+			if (owned && owned != &g_slots[slot_count])
+			{
+				owned->owned.store(false, std::memory_order_release);
+			}
+		}
+	};
+
+	inline claim& local() noexcept
+	{
+		thread_local claim t_claim;
+
+		if (!t_claim.owned)
+		{
+			for (std::size_t i = 0; i < slot_count && !t_claim.owned; i++)
+			{
+				bool expected = false;
+
+				if (g_slots[i].owned.compare_exchange_strong(expected, true, std::memory_order_acquire))
+				{
+					t_claim.owned = &g_slots[i];
+				}
+			}
+
+			if (!t_claim.owned)
+			{
+				t_claim.owned = &g_slots[slot_count];
+			}
+		}
+
+		return t_claim;
+	}
+
+	inline void add(counter c, std::uint64_t v = 1) noexcept
+	{
+		slot& s = *local().owned;
+		auto& value = s.value[c];
+
+		if (&s == &g_slots[slot_count])
+		{
+			value.fetch_add(v, std::memory_order_relaxed);
+		}
+		else
+		{
+			value.store(value.load(std::memory_order_relaxed) + v, std::memory_order_relaxed);
+		}
+	}
+
+	// One busy poll at tick `now`; the gap since the previous poll counts as
+	// polling time when it is shorter than poll_gap_ticks.
+	inline void poll(std::uint64_t now, std::uint64_t poll_gap_ticks) noexcept
+	{
+		claim& c = local();
+
+		if (c.last_poll && now > c.last_poll && now - c.last_poll <= poll_gap_ticks)
+		{
+			add(getllar_poll_ticks, now - c.last_poll);
+		}
+
+		c.last_poll = now;
+		add(getllar_polls);
+	}
+
+	inline std::array<std::uint64_t, counter_count> totals() noexcept
+	{
+		std::array<std::uint64_t, counter_count> sum{};
+
+		for (const slot& s : g_slots)
+		{
+			for (std::size_t i = 0; i < counter_count; i++)
+			{
+				sum[i] += s.value[i].load(std::memory_order_relaxed);
+			}
+		}
+
+		return sum;
+	}
+}
diff --git a/rpcs3/ios/IOSTextureCacheProfile.h b/rpcs3/ios/IOSTextureCacheProfile.h
new file mode 100644
index 0000000..b0964fd
--- /dev/null
+++ b/rpcs3/ios/IOSTextureCacheProfile.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_TEXCACHE_PROFILE_621: what the Vulkan texture cache did in each
+// performance window. Build 620 Black Ops II multiplayer spent 6-7 ms per frame
+// in the RSX texture stage and its resident texture memory kept growing, but no
+// journal line said whether that came from uploads, cache misses, flushes, surface
+// copies for samplers or memory never released. The RSX thread adds the texture
+// cache's own per-frame statistics just before they are reset at the end of each
+// frame, counts the temporary subresource copies the draw path makes for samplers,
+// and counts the depth/color feedback barriers of render targets (Assassin's Creed
+// torch passages). The performance reporter exchanges the sums once per window
+// into one COREPROF TEXCACHE621 line. Counting changes no texture, copy, barrier,
+// eviction or cache decision.
+namespace rpcs3::ios::texture_cache_profile
+{
+struct window_counters
+{
+	std::atomic<std::uint64_t> frames{0};               // frame ends sampled
+	std::atomic<std::uint64_t> upload_calls{0};         // texture upload calls (cache lookups for sampling)
+	std::atomic<std::uint64_t> upload_misses{0};        // of which needed a new upload
+	std::atomic<std::uint64_t> cache_misses{0};         // flushes that missed (data had to be read back)
+	std::atomic<std::uint64_t> flushes{0};              // flush requests (GPU to guest memory)
+	std::atomic<std::uint64_t> hard_faults{0};          // unavoidable hard faults
+	std::atomic<std::uint64_t> copies_elided{0};        // copies the cache avoided
+	std::atomic<std::uint64_t> temp_subresources{0};    // sampler copies of surface regions made by the draw path
+	std::atomic<std::uint64_t> temp_failures{0};        // of which failed (out of memory)
+	std::atomic<std::uint64_t> feedback_barriers{0};    // render_target::texture_barrier inserted
+	std::atomic<std::uint64_t> feedback_skipped{0};     // back-to-back read-only depth barriers skipped
+	std::atomic<std::uint64_t> post_barriers{0};        // render_target::post_texture_barrier inserted
+	std::atomic<std::uint64_t> post_skipped{0};         // fall-out barriers elided (no write in the chain)
+	// REWINDBOX_DEPTH_TEST_OFF_READ_ONLY_652: of the skips above, those only the depth-test-off rule allowed.
+	std::atomic<std::uint64_t> feedback_skipped_test_off{0};
+	std::atomic<std::uint64_t> post_skipped_test_off{0};
+	// Gauges: the last frame end of the window, and the window peak.
+	std::atomic<std::uint64_t> texture_bytes{0}, texture_bytes_peak{0};
+	std::atomic<std::uint64_t> temp_bytes{0}, temp_bytes_peak{0};
+	std::atomic<std::uint64_t> unreleased{0};
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+inline void raise(std::atomic<std::uint64_t>& peak, std::uint64_t value) noexcept
+{
+	auto current = peak.load(std::memory_order_relaxed);
+	while (value > current && !peak.compare_exchange_weak(current, value, std::memory_order_relaxed))
+	{
+	}
+}
+
+struct frame_statistics
+{
+	std::uint64_t upload_calls = 0, upload_misses = 0, cache_misses = 0, flushes = 0, hard_faults = 0, copies_elided = 0;
+	std::uint64_t texture_bytes = 0, temp_bytes = 0, unreleased = 0;
+};
+
+// Called by the RSX thread once per frame, before the cache resets its statistics.
+inline void on_frame_end(const frame_statistics& s) noexcept
+{
+	auto& c = counters;
+	add(c.frames);
+	add(c.upload_calls, s.upload_calls);
+	add(c.upload_misses, s.upload_misses);
+	add(c.cache_misses, s.cache_misses);
+	add(c.flushes, s.flushes);
+	add(c.hard_faults, s.hard_faults);
+	add(c.copies_elided, s.copies_elided);
+	c.texture_bytes.store(s.texture_bytes, std::memory_order_relaxed);
+	c.temp_bytes.store(s.temp_bytes, std::memory_order_relaxed);
+	c.unreleased.store(s.unreleased, std::memory_order_relaxed);
+	raise(c.texture_bytes_peak, s.texture_bytes);
+	raise(c.temp_bytes_peak, s.temp_bytes);
+}
+
+// A temporary subresource the draw path asked the cache for; `ok` is false when it failed.
+inline void on_temporary_subresource(bool ok) noexcept
+{
+	add(counters.temp_subresources);
+	if (!ok) add(counters.temp_failures);
+}
+}
diff --git a/rpcs3/ios/IOSTextureHash.cpp b/rpcs3/ios/IOSTextureHash.cpp
index 4d7a339..18eebb8 100644
--- a/rpcs3/ios/IOSTextureHash.cpp
+++ b/rpcs3/ios/IOSTextureHash.cpp
@@ -1,4 +1,7 @@
 #include "IOSTextureHash.h"
+#include "Utilities/JITMemoryProfile.h"
+#include "util/tsc.hpp"
+#include <algorithm>
 
 // Use the bundled implementation's existing six-NEON/two-scalar-lane variant.
 // Keep this in its own translation unit so other hashes retain their lowering.
@@ -9,11 +12,132 @@
 #include "Utilities/xxhash3.h"
 #pragma clang diagnostic pop
 
+namespace
+{
+#if defined(__aarch64__) || defined(__arm64__)
+// The texture cache reuses a 192-byte secret. Four stripes per iteration give
+// Clang room to overlap independent NEON/scalar work without changing XXH3's
+// accumulator order, block scrambles, final stripe or bytes read.
+XXH_FORCE_INLINE void accumulate_texture_stripes(xxh_u64* XXH_RESTRICT acc,
+	const xxh_u8* XXH_RESTRICT input, const xxh_u8* XXH_RESTRICT secret,
+	std::size_t stripe_count)
+{
+#if defined(__clang__)
+#pragma clang loop unroll_count(4)
+#endif
+	for (std::size_t stripe = 0; stripe < stripe_count; ++stripe)
+	{
+		const auto* data = input + stripe * XXH_STRIPE_LEN;
+		XXH_PREFETCH(data + XXH_PREFETCH_DIST);
+		XXH3_accumulate_512_neon(acc, data, secret + stripe * XXH_SECRET_CONSUME_RATE);
+	}
+}
+#endif
+
+// The pinned xxHash block, scramble, final-stripe and merge operations remain
+// unchanged. Only speculative work gets a cancellation point between groups
+// of 64 complete 1024-byte blocks; no streaming buffer or allocation is used.
+template <XXH3_f_accumulate Accumulate, XXH3_f_scrambleAcc Scramble, typename StillCurrent>
+bool hash_long_cancellable(const void* source, std::size_t size,
+	const void* secret_source, StillCurrent&& still_current,
+	std::uint64_t& hash, std::size_t& processed) noexcept
+{
+	constexpr std::size_t secret_size = XXH3_SECRET_DEFAULT_SIZE;
+	constexpr std::size_t stripes_per_block =
+		(secret_size - XXH_STRIPE_LEN) / XXH_SECRET_CONSUME_RATE;
+	constexpr std::size_t block_size = XXH_STRIPE_LEN * stripes_per_block;
+	static_assert(block_size == 1024);
+	XXH_ALIGN(XXH_ACC_ALIGN) xxh_u64 acc[XXH_ACC_NB] = XXH3_INIT_ACC;
+	const auto* input = static_cast<const xxh_u8*>(source);
+	const auto* secret = static_cast<const xxh_u8*>(secret_source);
+	const std::size_t blocks = (size - 1) / block_size;
+	processed = 0;
+
+	for (std::size_t block = 0; block < blocks;)
+	{
+		if (!still_current()) return false;
+		const std::size_t end = std::min(block + 64, blocks);
+		do
+		{
+			Accumulate(acc, input + block * block_size, secret, stripes_per_block);
+			Scramble(acc, secret + secret_size - XXH_STRIPE_LEN);
+		} while (++block < end);
+		processed = block * block_size;
+	}
+
+	if (!still_current()) return false;
+	const std::size_t stripes = ((size - 1) - blocks * block_size) / XXH_STRIPE_LEN;
+	Accumulate(acc, input + blocks * block_size, secret, stripes);
+	XXH3_accumulate_512(acc, input + size - XXH_STRIPE_LEN,
+		secret + secret_size - XXH_STRIPE_LEN - XXH_SECRET_LASTACC_START);
+	processed = size;
+	if (!still_current()) return false;
+	hash = XXH3_mergeAccs(acc, secret + XXH_SECRET_MERGEACCS_START,
+		static_cast<xxh_u64>(size) * XXH_PRIME64_1);
+	return true;
+}
+}
+
 namespace rpcs3::ios
 {
 std::uint64_t texture_hash_hybrid(const void* src, std::size_t size,
 	const void* secret, std::size_t secret_size, std::uint64_t seed) noexcept
 {
+	const auto start = utils::get_tsc();
+	struct measurement {
+		std::uint64_t start; std::size_t bytes;
+		~measurement() {
+			jit_memory::texture_hash_bytes.fetch_add(bytes, std::memory_order_relaxed);
+			jit_memory::texture_hash_ticks.fetch_add(utils::get_tsc() - start, std::memory_order_relaxed);
+		}
+	} measure{start, size};
+
+#if defined(__aarch64__) || defined(__arm64__)
+	if (size >= 4096 && secret_size == XXH3_SECRET_DEFAULT_SIZE)
+	{
+		// Constant block geometry also removes the generic secret-size division.
+		// For long inputs withSecretandSeed uses the supplied secret, not seed.
+		return XXH3_hashLong_64b_internal(src, size, secret, XXH3_SECRET_DEFAULT_SIZE,
+			accumulate_texture_stripes, XXH3_scrambleAcc_neon);
+	}
+#endif
 	return XXH3_64bits_withSecretandSeed(src, size, secret, secret_size, seed);
 }
+
+bool texture_hash_hybrid_cancellable(const void* src, std::size_t size,
+	const void* secret, std::size_t secret_size, std::uint64_t seed,
+	const texture_hash_cancellation& cancellation, std::uint64_t& hash,
+	std::size_t& processed) noexcept
+{
+	processed = 0;
+	if (!cancellation.current()) return false;
+	const auto start = utils::get_tsc();
+	struct measurement
+	{
+		std::uint64_t start;
+		const std::size_t& bytes;
+		~measurement()
+		{
+			jit_memory::texture_hash_bytes.fetch_add(bytes, std::memory_order_relaxed);
+			jit_memory::texture_hash_ticks.fetch_add(utils::get_tsc() - start, std::memory_order_relaxed);
+		}
+	} measure{start, processed};
+
+	if (size >= 4096 && secret_size == XXH3_SECRET_DEFAULT_SIZE)
+	{
+#if defined(__aarch64__) || defined(__arm64__)
+		return hash_long_cancellable<accumulate_texture_stripes, XXH3_scrambleAcc_neon>(
+			src, size, secret, [&] { return cancellation.current(); }, hash, processed);
+#else
+		return hash_long_cancellable<XXH3_accumulate, XXH3_scrambleAcc>(
+			src, size, secret, [&] { return cancellation.current(); }, hash, processed);
+#endif
+	}
+
+	const auto result = XXH3_64bits_withSecretandSeed(src, size, secret, secret_size, seed);
+	processed = size;
+	if (!cancellation.current()) return false;
+	hash = result;
+	return true;
+}
 }
diff --git a/rpcs3/ios/IOSTextureHash.h b/rpcs3/ios/IOSTextureHash.h
index ccb4aae..c25fd6f 100644
--- a/rpcs3/ios/IOSTextureHash.h
+++ b/rpcs3/ios/IOSTextureHash.h
@@ -1,5 +1,6 @@
 #pragma once
 
+#include <atomic>
 #include <cstddef>
 #include <cstdint>
 
@@ -7,6 +8,34 @@ namespace rpcs3::ios
 {
 // Same seeded XXH3 result as the regular implementation. Callers select this
 // only for large inputs; short hashes retain the existing eight-NEON-lane path.
+// ARM64 large inputs specialize the standard 192-byte secret and batch stripes;
+// arbitrary secret sizes retain the generic implementation.
 std::uint64_t texture_hash_hybrid(const void* src, std::size_t size,
 	const void* secret, std::size_t secret_size, std::uint64_t seed) noexcept;
+
+// Borrowed for one speculative read only. The synchronous validator never
+// waits for this work and retains its complete, unchanged hash path.
+struct texture_hash_cancellation
+{
+	const std::atomic<std::uint64_t>& epoch;
+	const std::atomic<std::size_t>& position;
+	const std::atomic<bool>& enabled;
+	std::uint64_t expected_epoch;
+	std::size_t expected_position;
+
+	bool current() const noexcept
+	{
+		return enabled.load(std::memory_order_relaxed) &&
+			epoch.load(std::memory_order_acquire) == expected_epoch &&
+			position.load(std::memory_order_relaxed) <= expected_position;
+	}
+};
+
+// Poll between 64 KiB groups of the same XXH3 blocks. A cancelled operation
+// leaves hash untouched and reports only its processed prefix; it never
+// publishes a partial fingerprint. Completed hashes are bit-identical.
+bool texture_hash_hybrid_cancellable(const void* src, std::size_t size,
+	const void* secret, std::size_t secret_size, std::uint64_t seed,
+	const texture_hash_cancellation& cancellation, std::uint64_t& hash,
+	std::size_t& processed) noexcept;
 }
diff --git a/rpcs3/ios/IOSTextureLookupMemo.h b/rpcs3/ios/IOSTextureLookupMemo.h
new file mode 100644
index 0000000..9c7e4d7
--- /dev/null
+++ b/rpcs3/ios/IOSTextureLookupMemo.h
@@ -0,0 +1,600 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSTextureValidationProfile.h"
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+
+// REWINDBOX_TEXTURE_LOOKUP_MEMO_660: per sampler slot, the last results of an exact texture lookup
+// (texture_cache::upload_texture), reused for an identical lookup in the same validation epoch.
+//
+// IPA 657 (Core 655, PID 10471), Assassin's Creed window 1:42: 904 lookups per frame for 1,515 draws
+// (TEXCACHE621 upload_calls 106,705 over 118 frames), 61 % of them confirmed without hashing because
+// the section had already been validated in the same epoch (OPT559 epoch_skips 64,999), and 5.03 ms
+// of texture stage per sampled frame (RSXFRAME551). A slot is looked up again whenever one of its
+// registers is rewritten (A/B/A alternation, a filter or LOD change), even when the texture is the same.
+//
+// The key is everything the lookup reads from the texture unit: the six raw words of OFFSET, FORMAT,
+// ADDRESS, CONTROL1, IMAGE_RECT and CONTROL3 (rsx::fragment_texture::lookup_words(); a vertex texture
+// has no CONTROL1), the address they resolve to now (IO mappings can change under the same words), and
+// whether the slot is a vertex slot or a BX2 read of the fragment program. The value is the descriptor
+// upload_texture returned, before VKDraw.cpp derives the format, view override and sampler from it (that
+// code still runs on every hit); the validation stamp and binding are set again by every hit.
+//
+// An entry is used only while nothing the exact lookup reads can have changed:
+// - the validation epoch (a lookup repeated in the same epoch never hashes: buffered_section::sync) and
+//   sampler_revision (every advance_epoch: PUT, semaphores, RSX writes, frame end);
+// - a scoped RSX write over the entry's section range (CELL573: revalidate_overlapping drops it through
+//   the memo's own sampler bindings, as it does for the slot bindings);
+// - the section-state generations below, bumped under the cache lock by every change of a section, of
+//   its block or of its image views that the lookup reads (create, reset, destroy, protection, dirty,
+//   context, format, dimensions, pitch, swizzle, view flags, ranges, block size, component order):
+//   local for an uncompressed entry, all for a compressed one (find_texture_from_dimensions does not
+//   filter contexts);
+// - the sampler context generation, bumped by a global sampler refresh (m_samplers_dirty);
+// - for an uncompressed entry, no render target bound at the address, checked at every use (the only
+//   surface store input of an exact local lookup; the write tag is stamped again on every hit).
+// Only direct shader_read views of a section are stored: no render target, no deferred or gathered
+// descriptor, no cyclic reference, nothing created or changed by the lookup that produced it.
+//
+// Self-verification: the first reuse of each (slot, key) of a boot, the first 256 hits of a boot, then
+// one hit in 64 (every hit in verify_all mode) run the full lookup under the same lock and use its
+// result; a difference in the descriptor, the view or the sampler inputs, or a section change during
+// that lookup, is counted, logged once with the slot and key, and turns the memo off for the rest of
+// the boot. This is a spot check, not a bound: one hit clock is shared by all slots, so a stale path
+// that occurs rarely may never be sampled. Correctness rests on the invalidation census above (checked
+// by test/rpcs3_texture_lookup_memo660_test.py); the verification catches what the census would miss
+// systematically, for every texture of the boot at least once.
+namespace rpcs3::ios::texture_lookup_memo
+{
+enum class mode : std::uint32_t
+{
+	off = 0,        // The Core 659 lookup: prepare, upload_texture and finish, three cache locks.
+	active = 1,     // One cache lock per lookup; hits served, sampled verification.
+	verify_all = 2, // One cache lock per lookup; every hit runs the full lookup (counters only).
+};
+
+// REWINDBOX_TEXMEMO_WAYS_908: Assassin's Creed (BLES00158), IPA 694 device log, gameplay window 40: 99,674 lookups,
+// 29,617 hits, 64,461 miss_empty, 5,126 miss_epoch, lookup_ms 785 (about 11 us per miss, 0.15 us per hit). Entries
+// are rarely invalidated (miss_epoch, miss_section, miss_range small): the keys are absent. With 4 ways per slot,
+// a slot that samples more than 4 textures within an epoch evicts by LRU the entry it needs next, so a cycle of 5 or
+// more textures never hits. 16 ways keep up to 16 textures per slot; every check of a hit is unchanged (the same
+// key, epoch, revision, range, context, section and bound tests, the same verification sampling). Memory: 20 slots
+// x 16 entries. miss_evicted counts the miss_empty that only capacity explains: the key was evicted by LRU while its
+// entry was valid (among the slot's last 16 evictions), was not stored again, and nothing since would have dropped the
+// entry (REWINDBOX_TEXMEMO_GHOST_910: same epoch, sampler revision, context and section generations, no scoped write
+// over its range, target not bound). A key never seen, or one an invalidation would have dropped anyway, is not counted
+// (COREPROF TEXMEMO660).
+constexpr std::size_t ways = 16;
+constexpr std::size_t ghosts = 16;
+constexpr std::uint64_t verify_first = 256;
+constexpr std::uint64_t verify_period = 64;
+
+constexpr std::uint32_t vertex_flag = 1u;
+constexpr std::uint32_t bx2_flag = 2u;
+
+inline std::atomic<std::uint32_t> boot_mode{0};
+// Set by the first verified difference: no hit for the rest of the boot.
+inline std::atomic<bool> disabled{false};
+inline std::atomic<bool> mismatch_logged{false};
+// Hits of this boot, the sampling clock of the verification.
+inline std::atomic<std::uint64_t> boot_hits{0};
+// The first reuse of each (slot, key) is verified. Always true in the Core; the host test turns it off only to
+// exercise served hits directly (test/rpcs3_texture_lookup_memo660_test.py, mode active_served).
+inline std::atomic<bool> verify_first_reuse{true};
+
+// Section-state generations (see above). Bumped on every title: one atomic increment per change.
+inline std::atomic<std::uint64_t> local_generation{1}, all_generation{1}, context_generation{1};
+
+struct counters_t
+{
+	std::atomic<std::uint64_t> lookups{0}, hits{0}, verified{0}, mismatches{0}, stores{0};
+	std::atomic<std::uint64_t> miss_empty{0}, miss_epoch{0}, miss_revision{0}, miss_range{0}, miss_context{0},
+		miss_section{0}, miss_bound{0}, miss_disabled{0};
+	// REWINDBOX_TEXMEMO_WAYS_908: the miss_empty whose key was among the slot's last evictions (capacity misses).
+	std::atomic<std::uint64_t> miss_evicted{0};
+	std::atomic<std::uint64_t> unstored_kind{0}, unstored_changed{0}, unstored_bound{0};
+	std::atomic<std::uint64_t> locks_avoided{0}, cpu_uploads{0};
+	// First reuses of a (slot, key) verified; reuses not checked that way because the key table was full.
+	std::atomic<std::uint64_t> first_reuses{0}, seen_full{0};
+	std::atomic<std::uint64_t> hit_ticks{0}, lookup_ticks{0};
+};
+inline counters_t counters;
+
+inline void count(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+inline mode current_mode() noexcept
+{
+	return static_cast<mode>(boot_mode.load(std::memory_order_relaxed));
+}
+
+// The lookups of load_texture_env take the one-lock path (with or without hits).
+inline bool consolidated() noexcept
+{
+	return current_mode() != mode::off;
+}
+
+// Boot policy (resolve_experimental_policy), after the texture epoch was set and before the RSX
+// thread starts. New generations: no entry survives a boot or a change of epoch_enabled.
+inline void configure(mode value) noexcept
+{
+	boot_mode.store(static_cast<std::uint32_t>(value), std::memory_order_relaxed);
+	disabled.store(false, std::memory_order_relaxed);
+	mismatch_logged.store(false, std::memory_order_relaxed);
+	boot_hits.store(0, std::memory_order_relaxed);
+	local_generation.fetch_add(1, std::memory_order_acq_rel);
+	all_generation.fetch_add(1, std::memory_order_acq_rel);
+	context_generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+// A section change the exact lookup can observe. framebuffer_only: the section's context is
+// framebuffer_storage before and after the change (no uncompressed lookup visits it).
+inline void section_changed(bool framebuffer_only) noexcept
+{
+	all_generation.fetch_add(1, std::memory_order_acq_rel);
+	if (!framebuffer_only)
+	{
+		local_generation.fetch_add(1, std::memory_order_acq_rel);
+	}
+}
+
+// A global sampler refresh (VKGSRender::m_samplers_dirty) drops every entry.
+inline void sampler_refresh() noexcept
+{
+	context_generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+constexpr bool should_verify(mode value, std::uint64_t hit) noexcept
+{
+	return value == mode::verify_all || hit < verify_first || (hit - verify_first) % verify_period == 0;
+}
+
+constexpr std::uint32_t fragment_flags(std::uint32_t bx2_mask, std::uint32_t slot) noexcept
+{
+	return ((bx2_mask >> slot) & 1u) ? bx2_flag : 0u;
+}
+
+struct key
+{
+	std::uint32_t address = 0;            // rsx::get_address(offset, location), resolved at every use
+	std::array<std::uint32_t, 6> words{}; // OFFSET FORMAT ADDRESS CONTROL1 IMAGE_RECT CONTROL3
+	std::uint32_t flags = 0;              // vertex_flag, bx2_flag
+
+	bool operator==(const key&) const = default;
+};
+
+enum class miss : std::uint32_t
+{
+	none = 0, empty, epoch, revision, range, context, section, bound, disabled
+};
+
+inline void count_miss(miss reason) noexcept
+{
+	switch (reason)
+	{
+	case miss::none: break;
+	case miss::empty: count(counters.miss_empty); break;
+	case miss::epoch: count(counters.miss_epoch); break;
+	case miss::revision: count(counters.miss_revision); break;
+	case miss::range: count(counters.miss_range); break;
+	case miss::context: count(counters.miss_context); break;
+	case miss::section: count(counters.miss_section); break;
+	case miss::bound: count(counters.miss_bound); break;
+	case miss::disabled: count(counters.miss_disabled); break;
+	}
+}
+
+// Differences found by a verification (bits of the logged reasons).
+enum difference : std::uint32_t
+{
+	differs_view = 1u,       // image_handle
+	differs_descriptor = 2u, // context, image type, reference address, ranges, deferred operation, flags
+	differs_sampler = 4u,    // format class, texture coordinate transform, samples, cyclic reference
+	differs_state = 8u,      // the full lookup changed a section: the memo would have skipped that change
+};
+
+// Fields a memo hit hands to the sampler setup and to the draw (VKDraw.cpp). Both sides come straight
+// from upload_texture (before the validation stamp); surface_cache_tag is the store's current write tag.
+template <typename Descriptor>
+std::uint32_t compare(const Descriptor& memo, const Descriptor& full) noexcept
+{
+	std::uint32_t result = 0;
+	if (memo.image_handle != full.image_handle)
+	{
+		result |= differs_view;
+	}
+	if (memo.upload_context != full.upload_context || memo.image_type != full.image_type || memo.ref_address != full.ref_address ||
+		memo.surface_cache_tag != full.surface_cache_tag || memo.flag != full.flag ||
+		memo.external_subresource_desc.op != full.external_subresource_desc.op ||
+		memo.ios_validation_range != full.ios_validation_range || !(memo.format_ex == full.format_ex) ||
+		memo.format_ex.texel_remap_control != full.format_ex.texel_remap_control)
+	{
+		result |= differs_descriptor;
+	}
+	// The coordinate transform: scale and bias, and the clamp bounds only when clamping (the constructors
+	// leave the bounds unset and RSXThread.cpp reads them only for a clamped descriptor).
+	using xform_type = std::remove_cvref_t<decltype(memo.texcoord_xform)>;
+	const auto* memo_xform = reinterpret_cast<const unsigned char*>(&memo.texcoord_xform);
+	const auto* full_xform = reinterpret_cast<const unsigned char*>(&full.texcoord_xform);
+	constexpr std::size_t bounds_offset = offsetof(xform_type, clamp_min);
+	constexpr std::size_t flag_offset = offsetof(xform_type, clamp);
+	bool xform_differs = std::memcmp(memo_xform, full_xform, bounds_offset) != 0 || memo.texcoord_xform.clamp != full.texcoord_xform.clamp;
+	if (!xform_differs && memo.texcoord_xform.clamp)
+	{
+		xform_differs = std::memcmp(memo_xform + bounds_offset, full_xform + bounds_offset, flag_offset - bounds_offset) != 0;
+	}
+	if (memo.format_class != full.format_class || memo.samples != full.samples || memo.is_cyclic_reference != full.is_cyclic_reference ||
+		xform_differs)
+	{
+		result |= differs_sampler;
+	}
+	return result;
+}
+
+struct generations
+{
+	std::uint64_t epoch = 0, local = 0, all = 0, context = 0;
+
+	static generations now() noexcept
+	{
+		return { texture_validation::current_epoch(), local_generation.load(std::memory_order_acquire),
+			all_generation.load(std::memory_order_acquire), context_generation.load(std::memory_order_acquire) };
+	}
+
+	bool sections_equal(const generations& other) const noexcept
+	{
+		return local == other.local && all == other.all;
+	}
+};
+
+// Owned by the texture cache. The RSX thread finds, stores and clears entries under the cache reader
+// lock; invalidate() runs under the exclusive lock on any thread and only touches the range bindings.
+template <typename Descriptor, std::size_t Slots>
+class table
+{
+	struct entry
+	{
+		key k{};
+		Descriptor value{};
+		texture_validation::sampler_stamp stamp{};
+		generations gen{};
+		bool compressed = false;
+		bool valid = false;
+		std::uint32_t used = 0;
+		// REWINDBOX_TEXMEMO_GHOST_910: start | length << 32 of the slot binding at end(); 0: unknown.
+		std::uint64_t range = 0;
+	};
+
+	std::array<entry, Slots * ways> m_entries{};
+	texture_validation::sampler_bindings<Slots * ways> m_ranges;
+	std::uint32_t m_clock = 0;
+	// Hashes of the (slot, key) pairs whose first reuse this table has verified (0: free), filled to half at
+	// most; the table lives as long as the texture cache, one boot.
+	static constexpr std::size_t seen_capacity = 4096;
+	std::array<std::uint64_t, seen_capacity> m_seen{};
+	std::size_t m_seen_count = 0;
+	// REWINDBOX_TEXMEMO_WAYS_908: the last keys each slot evicted by LRU, a ring per slot.
+	// REWINDBOX_TEXMEMO_GHOST_910: with what the evicted entry was valid under (Core 909 review: a hash alone counted
+	// a key whose entry the next epoch would have dropped anyway as a capacity miss).
+	struct ghost
+	{
+		std::uint64_t hash = 0;   // 0: free
+		generations gen{};        // the entry's generations
+		std::uint64_t memory = 0; // the sampler revision of its validation
+		std::uint64_t range = 0;  // its binding range (start | length << 32); 0: unknown
+		bool compressed = false;
+	};
+	std::array<ghost, Slots * ghosts> m_ghosts{};
+	std::array<std::uint32_t, Slots> m_ghost_next{};
+	std::uint32_t m_ghost_live = 0;
+
+	static std::uint64_t key_hash(std::size_t slot, const key& k) noexcept
+	{
+		std::uint64_t h = 1469598103934665603ull;
+		const auto mix = [&h](std::uint64_t value) { h = (h ^ value) * 1099511628211ull; };
+		mix(slot);
+		mix(k.address);
+		for (const std::uint32_t word : k.words)
+		{
+			mix(word);
+		}
+		mix(k.flags);
+		return h ? h : 1;
+	}
+
+	// Why a present entry does not serve its key now (miss::none: it does). The checks of a hit, in their order.
+	miss validity(std::size_t index, const entry& e, bool compressed, bool bound) const noexcept
+	{
+		const auto now = generations::now();
+		miss reason = miss::none;
+		if (!now.epoch || e.gen.epoch != now.epoch)
+		{
+			reason = miss::epoch;
+		}
+		else if (e.stamp.memory != texture_validation::sampler_revision.load(std::memory_order_acquire))
+		{
+			reason = miss::revision;
+		}
+		else if (!m_ranges.matches(index, e.stamp))
+		{
+			reason = miss::range;
+		}
+		else if (e.gen.context != now.context)
+		{
+			reason = miss::context;
+		}
+		else if (e.gen.local != now.local || (compressed && e.gen.all != now.all))
+		{
+			reason = miss::section;
+		}
+		else if (!compressed && bound)
+		{
+			reason = miss::bound;
+		}
+		return reason;
+	}
+
+	// REWINDBOX_TEXMEMO_GHOST_910: the key was evicted while valid and its entry would still serve it now.
+	bool evicted_recently(std::size_t slot, const key& k, bool compressed, bool bound) const noexcept
+	{
+		if (!m_ghost_live || (!compressed && bound))
+		{
+			return false;
+		}
+
+		const auto now = generations::now();
+		if (!now.epoch)
+		{
+			return false;
+		}
+
+		const std::uint64_t h = key_hash(slot, k);
+		for (std::size_t g = 0; g < ghosts; ++g)
+		{
+			const ghost& e = m_ghosts[slot * ghosts + g];
+			if (e.hash == h && e.compressed == compressed && e.gen.epoch == now.epoch &&
+				e.memory == texture_validation::sampler_revision.load(std::memory_order_acquire) &&
+				e.gen.context == now.context && e.gen.local == now.local && (!compressed || e.gen.all == now.all))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	void drop_ghost(ghost& e) noexcept
+	{
+		if (e.hash)
+		{
+			e.hash = 0;
+			--m_ghost_live;
+		}
+	}
+
+	// A key stored again is no longer an evicted one: a later miss_empty of it is not a capacity miss.
+	void forget_ghost(std::size_t slot, const key& k) noexcept
+	{
+		if (!m_ghost_live)
+		{
+			return;
+		}
+
+		const std::uint64_t h = key_hash(slot, k);
+		for (std::size_t g = 0; g < ghosts; ++g)
+		{
+			if (m_ghosts[slot * ghosts + g].hash == h)
+			{
+				drop_ghost(m_ghosts[slot * ghosts + g]);
+			}
+		}
+	}
+
+public:
+	struct found
+	{
+		const Descriptor* value = nullptr;
+		miss reason = miss::empty;
+	};
+
+	// Under the cache reader lock. bound: a render target is bound at k.address (uncompressed only).
+	found find(std::size_t slot, const key& k, bool compressed, bool bound) noexcept
+	{
+		if (disabled.load(std::memory_order_relaxed))
+		{
+			return { nullptr, miss::disabled };
+		}
+
+		for (std::size_t way = 0; way < ways; ++way)
+		{
+			const std::size_t index = slot * ways + way;
+			auto& e = m_entries[index];
+			if (!e.valid || !(e.k == k) || e.compressed != compressed)
+			{
+				continue;
+			}
+
+			const miss reason = validity(index, e, compressed, bound);
+
+			if (reason != miss::none)
+			{
+				e.valid = false;
+				m_ranges.forget(index);
+				return { nullptr, reason };
+			}
+
+			e.used = ++m_clock;
+			return { &e.value, miss::none };
+		}
+
+		if (evicted_recently(slot, k, compressed, bound))
+		{
+			count(counters.miss_evicted);
+		}
+		return { nullptr, miss::empty };
+	}
+
+	// Under the cache reader lock, on the RSX thread, for a hit: true the first time this (slot, key) is
+	// reused in this table's life (that hit is verified). Once the key table is half full, false (only the
+	// sampled verification remains) and counted.
+	bool first_reuse(std::size_t slot, const key& k) noexcept
+	{
+		const std::uint64_t h = key_hash(slot, k);
+		for (std::size_t probe = 0, at = h % seen_capacity; probe < seen_capacity; ++probe, at = (at + 1) % seen_capacity)
+		{
+			if (m_seen[at] == h)
+			{
+				return false;
+			}
+			if (!m_seen[at])
+			{
+				if (m_seen_count >= seen_capacity / 2)
+				{
+					count(counters.seen_full);
+					return false;
+				}
+				m_seen[at] = h;
+				++m_seen_count;
+				return true;
+			}
+		}
+		count(counters.seen_full);
+		return false;
+	}
+
+	struct ticket
+	{
+		std::size_t index = 0;
+		texture_validation::sampler_stamp stamp{};
+		generations gen{};
+	};
+
+	// Under the cache reader lock, before the lookup. The way of the same key, else a free way, else the
+	// least recently used one. Its range is unknown until end(): a scoped write in between drops it.
+	ticket begin(std::size_t slot, const key& k) noexcept
+	{
+		std::size_t victim = slot * ways;
+		std::uint32_t best = 0;
+		for (std::size_t way = 0; way < ways; ++way)
+		{
+			const std::size_t index = slot * ways + way;
+			const auto& e = m_entries[index];
+			const std::uint32_t rank = e.k == k ? 3 : !e.valid ? 2 : 1;
+			if (rank > best || (rank == best && rank == 1 && e.used < m_entries[victim].used))
+			{
+				best = rank;
+				victim = index;
+			}
+		}
+
+		if (best == 1 && validity(victim, m_entries[victim], m_entries[victim].compressed, false) == miss::none)
+		{
+			// A valid entry of another key that would still serve it goes by LRU: remember it (capacity misses).
+			const entry& old = m_entries[victim];
+			auto& next = m_ghost_next[slot];
+			ghost& slot_ghost = m_ghosts[slot * ghosts + next];
+			drop_ghost(slot_ghost);
+			slot_ghost = { key_hash(slot, old.k), old.gen, old.stamp.memory, old.range, old.compressed };
+			++m_ghost_live;
+			next = (next + 1) % ghosts;
+		}
+		m_entries[victim].valid = false;
+		const auto gen = generations::now();
+		return { victim, m_ranges.prepare(victim), gen };
+	}
+
+	enum class store_result
+	{
+		stored, changed, kind, bound
+	};
+
+	// Under the cache reader (or upgraded) lock, after the lookup and its sampler validation. direct: the
+	// descriptor is a direct shader_read view of a section at k.address. length: the length the slot
+	// binding received (0: unknown, then any scoped write drops the entry).
+	store_result end(const ticket& t, const key& k, bool compressed, bool bound, const Descriptor& value, bool direct,
+		std::uint32_t start, std::uint64_t length) noexcept
+	{
+		const auto now = generations::now();
+		if (!t.gen.epoch || now.epoch != t.gen.epoch || now.local != t.gen.local || now.context != t.gen.context ||
+			(compressed && now.all != t.gen.all) || disabled.load(std::memory_order_relaxed))
+		{
+			m_ranges.forget(t.index);
+			return store_result::changed;
+		}
+		if (!compressed && bound)
+		{
+			m_ranges.forget(t.index);
+			return store_result::bound;
+		}
+		if (!direct)
+		{
+			m_ranges.forget(t.index);
+			return store_result::kind;
+		}
+
+		m_ranges.set_range(t.index, start, length);
+		auto& e = m_entries[t.index];
+		e.range = (!length || length > 0xffffffffull || start + length > (1ull << 32)) ? 0 : start | (length << 32);
+		e.k = k;
+		e.value = value;
+		e.stamp = t.stamp;
+		e.gen = t.gen;
+		e.compressed = compressed;
+		e.valid = true;
+		e.used = ++m_clock;
+		forget_ghost(t.index / ways, k);
+		return store_result::stored;
+	}
+
+	// Under the cache exclusive lock, next to the slot bindings (revalidate_overlapping).
+	void invalidate(std::uint32_t start, std::uint64_t length) noexcept
+	{
+		m_ranges.invalidate(start, length);
+
+		// REWINDBOX_TEXMEMO_GHOST_910: a scoped write would have dropped the evicted entries it covers (the same
+		// overlap rule as the slot bindings; the exclusive lock keeps the RSX thread's lookups out).
+		if (!m_ghost_live || !length)
+		{
+			return;
+		}
+
+		const bool unknown_write = length > 0xffffffffull || start + length > (1ull << 32);
+		for (ghost& e : m_ghosts)
+		{
+			const std::uint64_t ghost_start = static_cast<std::uint32_t>(e.range);
+			const std::uint64_t ghost_length = e.range >> 32;
+			if (e.hash && (unknown_write || !e.range || (start < ghost_start + ghost_length && ghost_start < start + length)))
+			{
+				drop_ghost(e);
+			}
+		}
+	}
+
+	// Under the cache reader lock: after a verified difference.
+	void clear() noexcept
+	{
+		for (std::size_t index = 0; index < m_entries.size(); ++index)
+		{
+			m_entries[index].valid = false;
+			m_ranges.forget(index);
+		}
+
+		for (ghost& e : m_ghosts)
+		{
+			drop_ghost(e);
+		}
+	}
+};
+}
diff --git a/rpcs3/ios/IOSTexturePrehash.h b/rpcs3/ios/IOSTexturePrehash.h
new file mode 100644
index 0000000..40783db
--- /dev/null
+++ b/rpcs3/ios/IOSTexturePrehash.h
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// CELL581_TEXTURE_PREHASH: on iOS the texture cache confirms CPU textures by
+// content hash, not page protection. Under "Texture Validation Per FIFO Batch"
+// (CELL559_TEXTURE_EPOCH) a texture is hashed again on its first use after
+// each synchronization point (guest PUT, semaphore acquire, frame end), on the
+// RSX thread. God of War III spends 2.8-10.4 ms of every frame there on build
+// 575 (7-10 GB per 5 s window, 13-17 % of the frame) and its RSX thread limits
+// the frame rate. A frame validates nearly the same textures in nearly the same
+// order as the frame before it. As soon as an epoch starts, a worker thread
+// therefore hashes the ranges the previous frame validated next, ahead of the
+// RSX thread, with the same function (identical results).
+//
+// A result is used only in the epoch it was computed in; the worker reads the
+// epoch before the bytes. Everything the commands of an epoch may read was
+// written before the epoch began, so a hash taken after its start confirms the
+// same data as the RSX thread's own hash would. A section revalidated by an RSX
+// write inside the epoch (CELL573_SCOPED_RSX_WRITES) is hashed by the RSX
+// thread itself. The worker reads RSX local memory, which is never unmapped
+// while the RSX thread runs, and main memory only under a vm range lock (an
+// unmap waits for it; a memory map change in progress makes it skip the range).
+// Whatever the worker has not hashed is hashed by the RSX thread as before.
+//
+// CELL583_PREHASH_PACING (build 581 iPhone logs, God of War III: 56 % of the
+// validations served, 48 % of the worker's bytes never used; Black Ops II, whose
+// SPU threads use 3.4-4.1 cores while its RSX thread uses 0.1-0.5, served 20-28 %):
+// the worker leaves out the ranges the RSX thread has already passed, the RSX thread
+// wakes it halfway through its ranges instead of a 4 ms timeout, and Automatic is
+// God of War III only.
+namespace rpcs3::ios::texture_prehash
+{
+inline std::atomic<bool> enabled{false};
+
+// Shorter ranges are left to the RSX thread.
+constexpr std::uint32_t min_bytes = 64u << 10;
+// Validations recorded per frame; the previous frame's list predicts the next.
+constexpr std::size_t max_sequence = 2048;
+// Recorded validations the worker hashes ahead of the RSX thread.
+constexpr std::size_t lookahead = 64;
+// REWINDBOX_PREHASH_BUDGET_910: God of War III, build 694 device log (Core 907), window 29: the worker completed 10,135
+// hashes (10.48 GB) while 4,623 validations were served by a published result (5.05 GB). That is not the share of the
+// worker's hashes that was used (the RSX thread publishes its own hashes, and one result serves several sections), so
+// since REWINDBOX_PREHASH_USED_911 the input below is the number of worker results used at least once.
+// The depth of the worker's look-ahead follows what the last frame used: under half of its completed hashes used,
+// the depth halves (down to 4 ranges); above 85 %, it doubles (up to 64). Only how much is hashed ahead changes: a
+// result still validates nothing but the range and epoch it was taken for, and what the worker leaves is hashed by
+// the RSX thread as before.
+constexpr std::size_t min_lookahead = 4;
+constexpr std::size_t next_lookahead(std::size_t current, std::uint64_t frame_worker_hashes, std::uint64_t frame_hits) noexcept
+{
+	if (frame_worker_hashes < 8)
+	{
+		return current; // too little to judge
+	}
+	if (frame_hits * 2 < frame_worker_hashes)
+	{
+		return current / 2 < min_lookahead ? min_lookahead : current / 2;
+	}
+	if (frame_hits * 100 >= frame_worker_hashes * 85)
+	{
+		return current * 2 > lookahead ? lookahead : current * 2;
+	}
+	return current;
+}
+// Totals since boot (the window counters below are taken by the profiler) and the current depth.
+inline std::atomic<std::uint64_t> total_hits{0}, total_worker_hashes{0};
+inline std::atomic<std::uint32_t> current_lookahead{static_cast<std::uint32_t>(lookahead)};
+// Results kept (direct mapped, power of two).
+constexpr std::size_t table_size = 4096;
+
+struct result_slot
+{
+	// Even: stable; odd: being written. The worker and synchronous validators
+	// share completed hashes; a contended publication is simply abandoned.
+	std::atomic<std::uint64_t> seq{0};
+	std::atomic<std::uint64_t> key{0};
+	std::atomic<std::uint64_t> epoch{0};
+	std::atomic<std::uint64_t> hash{0};
+	// REWINDBOX_PREHASH_USED_911: who published the result (origin_*), and whether a worker result was used.
+	std::atomic<std::uint32_t> origin{0};
+};
+// REWINDBOX_PREHASH_USED_911: OPT581 `hits` counts lookups served, by any published result: the RSX thread publishes
+// the hashes it computes itself, and several sections of one range are served by one result. The share of the
+// worker's hashes that was used is counted here: a worker result, the first time a validation takes it.
+constexpr std::uint32_t origin_validator = 0, origin_worker = 1, origin_worker_used = 2;
+inline std::atomic<std::uint64_t> worker_used{0}; // OPT583 (process window)
+
+inline std::array<result_slot, table_size> table{};
+
+// OPT581 profile counters (process window).
+inline std::atomic<std::uint64_t> hits{0}, misses{0}, hit_bytes{0};
+inline std::atomic<std::uint64_t> worker_hashes{0}, worker_bytes{0}, worker_ticks{0}, worker_skips{0};
+// OPT583 profile counters (process window): ranges the RSX thread passed before the
+// worker reached them (left unhashed), and wakes by the RSX thread's progress.
+inline std::atomic<std::uint64_t> worker_passed{0}, worker_refills{0};
+
+constexpr std::uint64_t make_key(std::uint32_t start, std::uint32_t length) noexcept
+{
+	return start | (std::uint64_t{length} << 32);
+}
+
+constexpr std::size_t slot_of(std::uint64_t key) noexcept
+{
+	return static_cast<std::size_t>((key * 0x9E3779B97F4A7C15ull) >> 52) & (table_size - 1);
+}
+
+// Any thread: a completed hash of [start, start + length) taken in `epoch`.
+inline bool lookup(std::uint32_t start, std::uint32_t length, std::uint64_t epoch, std::uint64_t& out) noexcept
+{
+	const std::uint64_t key = make_key(start, length);
+	const auto& slot = table[slot_of(key)];
+	const std::uint64_t seq = slot.seq.load(std::memory_order_acquire);
+
+	if (seq & 1)
+	{
+		return false;
+	}
+
+	// Acquire loads: a field the next writer stored brings its odd sequence with it.
+	const std::uint64_t stored_key = slot.key.load(std::memory_order_acquire);
+	if (stored_key != key)
+	{
+		return false;
+	}
+	const std::uint64_t stored_epoch = slot.epoch.load(std::memory_order_acquire);
+	if (stored_epoch != epoch)
+	{
+		return false;
+	}
+	// Misses do not need the payload or a second sequence read. A successful
+	// lookup still acquires every field and checks the publication sequence.
+	const std::uint64_t stored_hash = slot.hash.load(std::memory_order_acquire);
+
+	if (slot.seq.load(std::memory_order_relaxed) != seq)
+	{
+		return false;
+	}
+
+	out = stored_hash;
+	return true;
+}
+
+// Any producer. Try once: validation must never wait for speculative work.
+inline void publish(std::uint32_t start, std::uint32_t length, std::uint64_t epoch, std::uint64_t hash, std::uint32_t origin = origin_validator) noexcept
+{
+	const std::uint64_t key = make_key(start, length);
+	auto& slot = table[slot_of(key)];
+	std::uint64_t seq = slot.seq.load(std::memory_order_acquire);
+	// A worker may finish after the next epoch's synchronous validator. Do not
+	// evict that newer result with obsolete speculation. Read the epoch after
+	// the acquired sequence: a completed writer's epoch is visible; a concurrent
+	// writer either rejects us here or changes the sequence and makes the
+	// one-shot CAS fail. Epochs are process-monotone.
+	if ((seq & 1) || slot.epoch.load(std::memory_order_acquire) > epoch ||
+		!slot.seq.compare_exchange_strong(seq, seq + 1,
+		std::memory_order_acquire, std::memory_order_relaxed))
+	{
+		return;
+	}
+	// Release stores: whoever reads one of them also sees the odd sequence before it.
+	slot.key.store(key, std::memory_order_release);
+	slot.epoch.store(epoch, std::memory_order_release);
+	slot.hash.store(hash, std::memory_order_release);
+	slot.origin.store(origin, std::memory_order_release);
+	slot.seq.store(seq + 2, std::memory_order_release);
+}
+
+// The validating thread, after lookup() served [start, start + length) in `epoch`: true the first time the result is
+// one the worker published. A counter only: the served hash was checked by lookup(); a slot republished in between is
+// not counted.
+inline bool claim_worker_result(std::uint32_t start, std::uint32_t length, std::uint64_t epoch) noexcept
+{
+	const std::uint64_t key = make_key(start, length);
+	auto& slot = table[slot_of(key)];
+	const std::uint64_t seq = slot.seq.load(std::memory_order_acquire);
+
+	if ((seq & 1) || slot.key.load(std::memory_order_acquire) != key || slot.epoch.load(std::memory_order_acquire) != epoch)
+	{
+		return false;
+	}
+
+	std::uint32_t expected = origin_worker;
+	return slot.origin.compare_exchange_strong(expected, origin_worker_used, std::memory_order_acq_rel, std::memory_order_relaxed) &&
+		slot.seq.load(std::memory_order_relaxed) == seq;
+}
+
+// The texture cache's validation hash of guest memory at `src` (Emu/RSX/Common/texture_cache.cpp).
+std::uint64_t range_hash(const void* src, std::uint32_t length) noexcept;
+
+// A validation that hashed or looked up [start, start + length) (any thread).
+// Keep ineligible validations in the sequence so its positions/epoch ordinals
+// remain aligned, but do not predict worker work for a validation that had to
+// bypass worker results after an RSX write. This only schedules speculation;
+// it never changes whether a result may validate the current texture.
+void record(std::uint32_t start, std::uint32_t length, bool eligible = true) noexcept;
+// The texture cache's frame end, after the frame's epoch advance.
+void end_frame() noexcept;
+// Any thread that advanced the validation epoch.
+void on_epoch_advance() noexcept;
+// RSX thread exit: stops and joins the worker and turns the lever off until the next
+// boot resolves it; the next boot's first record() starts a worker again.
+void stop() noexcept;
+}
diff --git a/rpcs3/ios/IOSTextureResidency.h b/rpcs3/ios/IOSTextureResidency.h
new file mode 100644
index 0000000..65acd8e
--- /dev/null
+++ b/rpcs3/ios/IOSTextureResidency.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// CELL573_TEXTURE_RESIDENCY: on iOS the texture cache confirms CPU textures by
+// content hash, not page protection, so a guest write to their memory never
+// faults. A texture whose memory the title has reused for other data is found
+// stale only when it is looked up again; one that is never looked up again
+// keeps its GPU image. God of War III streams its levels through the same
+// guest memory: on build 567 the texture pool grew to 1.72 GB (the PS3 has
+// 512 MB in all), fell to 366 MB when the memory-pressure reclaim purged it,
+// and grew back to 1.56 GB within 75 s. While the live texture bytes exceed
+// `soft_cap_bytes`, idle sections are released, at most `max_bytes_per_pass`
+// per pass, one pass every `pass_interval` frames: first those overlapped by a
+// section used after them that extends past them, whose guest memory holds
+// other data now, once idle for `min_idle_frames_superseded` frames; then the
+// least recently used of those no lookup has used for `min_idle_frames`.
+// Bound textures are never released. A released texture the title samples
+// again is uploaded from guest memory as on its first use.
+namespace rpcs3::ios::texture_residency
+{
+inline std::atomic<bool> enabled{false};
+// Frames presented since boot, advanced by the texture cache's frame end.
+inline std::atomic<std::uint64_t> frame{1};
+
+constexpr std::uint64_t soft_cap_bytes = 768ull << 20;
+constexpr std::uint64_t min_idle_frames = 64;
+constexpr std::uint64_t min_idle_frames_superseded = 8;
+constexpr std::uint64_t pass_interval = 16;
+constexpr std::uint64_t max_bytes_per_pass = 128ull << 20;
+
+inline std::uint64_t current_frame() noexcept
+{
+	return frame.load(std::memory_order_relaxed);
+}
+
+inline void advance_frame() noexcept
+{
+	frame.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline bool pass_due() noexcept
+{
+	return enabled.load(std::memory_order_relaxed) && current_frame() % pass_interval == 0;
+}
+
+inline bool idle(std::uint64_t last_use, std::uint64_t now, bool superseded = false) noexcept
+{
+	return last_use <= now && now - last_use >= (superseded ? min_idle_frames_superseded : min_idle_frames);
+}
+
+template <typename Section>
+struct candidate
+{
+	std::uint64_t last_use = 0;
+	std::uint64_t bytes = 0;
+	Section section{};
+	// Overlapped by a section used after it that extends past it.
+	bool superseded = false;
+};
+
+// Moves the candidates to release to the front and returns their count: only
+// idle ones, superseded first, then least recently used first, until
+// `excess_bytes` (at most `max_bytes_per_pass`) are covered.
+template <typename Section>
+std::size_t select(std::vector<candidate<Section>>& candidates, std::uint64_t now, std::uint64_t excess_bytes)
+{
+	const auto idle_end = std::partition(candidates.begin(), candidates.end(), [now](const candidate<Section>& c)
+	{
+		return idle(c.last_use, now, c.superseded);
+	});
+
+	std::stable_sort(candidates.begin(), idle_end, [](const candidate<Section>& a, const candidate<Section>& b)
+	{
+		return a.superseded != b.superseded ? a.superseded : a.last_use < b.last_use;
+	});
+
+	const std::uint64_t target = std::min(excess_bytes, max_bytes_per_pass);
+	std::uint64_t covered = 0;
+	std::size_t count = 0;
+
+	for (auto it = candidates.begin(); it != idle_end && covered < target; ++it, ++count)
+	{
+		covered += it->bytes;
+	}
+
+	return count;
+}
+}
+
+// CELL573_SCOPED_RSX_WRITES: under "Texture Validation Per FIFO Batch" every
+// guest-memory write by the RSX itself (a render target written back for a
+// CPU read, a render target committed over a range) advanced the global
+// epoch, so the next lookup of every texture hashed it again, wherever it
+// was. God of War III goes through about nine epochs per frame and hashes
+// 6-12 GB of texture data per 5 s window on build 567 (8 ms of its 10 ms
+// texture time per frame). The RSX knows the range it writes: only the
+// sections over it are revalidated. Guest PUT, semaphore acquires, CPU write
+// faults, unmaps and the frame end still advance the global epoch.
+namespace rpcs3::ios::texture_validation_scope
+{
+inline std::atomic<bool> enabled{false};
+}
diff --git a/rpcs3/ios/IOSTextureValidationProfile.h b/rpcs3/ios/IOSTextureValidationProfile.h
new file mode 100644
index 0000000..7d3101f
--- /dev/null
+++ b/rpcs3/ios/IOSTextureValidationProfile.h
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rpcs3::ios::texture_validation
+{
+// Fixed 32-byte observations, outside all PPU/SPU code-generation inputs.
+// Frame-end maintenance covers all validation sizes; its time overlaps the
+// existing hash measurements, not an extra cost. No new per-hash observation.
+inline std::atomic<std::uint64_t> trim_calls{0}, trim_sections{0};
+inline std::atomic<std::uint64_t> trim_bytes{0}, trim_ticks{0};
+// CELL559_DIRTY_HASH_SKIP: dirty hashed sections released without hashing.
+inline std::atomic<std::uint64_t> dirty_releases{0}, dirty_release_bytes{0};
+
+// CELL559_TEXTURE_EPOCH: "Texture Validation Per FIFO Batch". A clean section
+// whose hash matched stays validated until the next synchronization point:
+// new commands made visible by the guest (PUT), a semaphore acquire, an RSX
+// write, flush or invalidation of guest memory, or the end of a frame. Guest
+// data a command needs is written before that command becomes visible, or
+// before the semaphore the RSX waits for is released; only an unsynchronized
+// write racing the RSX can be seen one batch later. Disabled: epoch 0, every
+// validation hashes as before.
+inline std::atomic<bool> epoch_enabled{false};
+inline std::atomic<std::uint64_t> validation_epoch{1};
+inline std::atomic<std::uint64_t> epoch_skips{0}, epoch_skip_bytes{0}, epoch_bumps{0};
+
+// A bound sampler must revisit the texture cache after a synchronization point,
+// including when per-epoch hashing is disabled. This revision never validates
+// bytes itself: buffered_section::sync() still performs the content check.
+inline std::atomic<std::uint64_t> sampler_revision{1};
+
+struct sampler_stamp
+{
+	std::uint64_t memory = 0;
+	std::uint64_t range = 0;
+};
+
+// Owned by the texture cache, one slot per fragment/vertex sampler. Store guest
+// ranges, never pointers to recyclable sections or Vulkan resources. Scoped
+// writes only invalidate overlapping bindings; unknown layouts are conservative.
+template <std::size_t Count>
+class sampler_bindings
+{
+	struct binding
+	{
+		std::atomic<std::uint64_t> range{0};
+		std::atomic<std::uint64_t> revision{1};
+	};
+	std::array<binding, Count> m_bindings{};
+	static constexpr std::uint64_t unknown_range = ~std::uint64_t{0};
+
+public:
+	bool matches(std::size_t index, sampler_stamp stamp) const noexcept
+	{
+		return stamp.memory && stamp.memory == sampler_revision.load(std::memory_order_acquire) &&
+			stamp.range == m_bindings[index].revision.load(std::memory_order_acquire);
+	}
+
+	// Called under the cache reader lock, before the lookup. A scoped writer
+	// either finishes before this snapshot or sees the new range under its
+	// exclusive lock. The lookup also takes that lock, so it cannot sample an
+	// in-progress write whose notification has already been observed.
+	void set_range(std::size_t index, std::uint32_t start, std::uint64_t length) noexcept
+	{
+		const std::uint64_t range = !length || length > 0xffffffffull || start + length > (1ull << 32)
+			? unknown_range : start | (length << 32);
+		m_bindings[index].range.store(range, std::memory_order_release);
+	}
+
+	sampler_stamp prepare(std::size_t index) noexcept
+	{
+		// Until the lookup has produced its actual source range, every scoped
+		// write must be able to invalidate this in-flight binding.
+		set_range(index, 0, 0);
+		return {sampler_revision.load(std::memory_order_acquire), m_bindings[index].revision.load(std::memory_order_acquire)};
+	}
+
+	void forget(std::size_t index) noexcept
+	{
+		m_bindings[index].range.store(0, std::memory_order_release);
+	}
+
+	// Called under the cache exclusive lock, alongside reset_validation().
+	void invalidate(std::uint32_t start, std::uint64_t length) noexcept
+	{
+		if (!length)
+		{
+			return;
+		}
+		const bool unknown_write = length > 0xffffffffull || start + length > (1ull << 32);
+		for (auto& binding : m_bindings)
+		{
+			const std::uint64_t range = binding.range.load(std::memory_order_acquire);
+			const std::uint64_t bound_start = static_cast<std::uint32_t>(range);
+			const std::uint64_t bound_length = range >> 32;
+			if (range && (unknown_write || range == unknown_range ||
+				(start < bound_start + bound_length && bound_start < start + length)))
+			{
+				binding.revision.fetch_add(1, std::memory_order_acq_rel);
+			}
+		}
+	}
+};
+
+inline std::uint64_t current_epoch() noexcept
+{
+	return epoch_enabled.load(std::memory_order_relaxed) ? validation_epoch.load(std::memory_order_acquire) : 0;
+}
+
+// CELL581_TEXTURE_PREHASH: wakes the texture pre-validation worker while it runs
+// (ios/IOSTexturePrehash.h); called after the epoch has advanced.
+inline std::atomic<void (*)() noexcept> epoch_listener{nullptr};
+
+// REWINDBOX_EPOCH_SOURCES_909: God of War III, build 694 device log (Core 907), session 2 window 29:
+// epoch_advances=25807 for 72 frames (~358 epochs per frame) and texture_hash_bytes=15.96 GB per 5 s; every
+// epoch invalidates every texture validation. Which synchronization points advance it, counted per source
+// (COREPROF OPT559 epoch_sources=).
+enum class epoch_source : std::uint8_t
+{
+	other = 0, put, acquire, inline_upload, memory_copy, blit_cpu, flush, invalidate, frame_end, count
+};
+inline std::array<std::atomic<std::uint64_t>, static_cast<std::size_t>(epoch_source::count)> epoch_source_counts{};
+// REWINDBOX_SCOPED_RSX_UPLOADS_909: RSX writes of a known range revalidated in scope instead of a new epoch.
+inline std::atomic<std::uint64_t> scoped_rsx_writes{0}, scoped_rsx_write_bytes{0};
+
+inline void advance_epoch(epoch_source source = epoch_source::other) noexcept
+{
+	const bool enabled = epoch_enabled.load(std::memory_order_relaxed);
+	if (enabled)
+	{
+		validation_epoch.fetch_add(1, std::memory_order_acq_rel);
+		epoch_bumps.fetch_add(1, std::memory_order_relaxed);
+		epoch_source_counts[static_cast<std::size_t>(source)].fetch_add(1, std::memory_order_relaxed);
+	}
+	// Observing this revision also observes the preceding hash epoch and writes.
+	sampler_revision.fetch_add(1, std::memory_order_acq_rel);
+
+	if (enabled)
+	{
+		if (const auto listener = epoch_listener.load(std::memory_order_relaxed))
+		{
+			listener();
+		}
+	}
+}
+
+// REWINDBOX_PUT_HORIZON_910: God of War III, build 694 device log (Core 907), window 29: 25,807 texture epochs for 72
+// frames (about 358 per frame) while the RSX FIFO ran dry only 3,932 times (about 55 per frame). The FIFO reads PUT
+// at every command and every change it saw started an epoch, although the commands it was still executing had been
+// published before the previous one. The rule of the epoch is that the data a command needs is written before the
+// command becomes visible; a validation made after a command became visible therefore serves it. The commands below
+// the PUT that opened the last PUT epoch (the horizon) were all visible then, and every validation since is newer:
+// a later PUT only matters once the FIFO reaches the horizon. Until then its epoch is deferred; it starts when the
+// FIFO reaches the horizon (or leaves the linear segment below it: jump, call, return, wrap), with the PUT read then.
+// Semaphore acquires, RSX writes, flushes, invalidations and the frame end start their epochs as before; one of them
+// also covers every command visible when it happened, so the horizon moves up to the last PUT read before it.
+// A jump to itself that the guest patches publishes the commands behind it without moving PUT: with the horizon on,
+// the patched command starts an epoch (RSXFIFO.cpp). The FIFO cache of the non-Fast accuracy modes reads PUT once per
+// refill, so those modes never defer; a FIFO reset or recovery forgets the horizon (reset_epoch_horizon).
+// Per title (Automatic: God of War III); off: an epoch for every PUT change read, as before.
+namespace put_horizon_policy
+{
+inline std::atomic<bool> enabled{false};
+}
+// PUT changes read while the FIFO was still below the horizon (no epoch started for them).
+inline std::atomic<std::uint64_t> put_deferred{0};
+// Epochs started by a patched jump-to-itself (counted in the put source as well).
+inline std::atomic<std::uint64_t> put_patched{0};
+
+struct put_horizon
+{
+	std::uint32_t horizon = ~0u; // commands below it were visible when the covering epoch started
+	std::uint32_t get = 0;       // the FIFO position when the horizon was set, then at each deferral
+	std::uint32_t seen = ~0u;    // the last PUT read
+	std::uint64_t epoch = 0;     // validation_epoch at the last read
+	bool armed = false;          // horizon and get describe a segment
+	bool deferred = false;       // a PUT change was deferred since the horizon was set
+
+	// The FIFO at `get_now` reads `put`; `epoch_now` is validation_epoch. True: start an epoch before the next command.
+	bool observe(std::uint32_t get_now, std::uint32_t put, std::uint64_t epoch_now, bool defer_allowed) noexcept
+	{
+		// An epoch another source started since the last read covers every command visible at that read.
+		if (defer_allowed && armed && deferred && epoch_now != epoch && seen >= get)
+		{
+			horizon = seen;
+			deferred = false;
+		}
+
+		const bool changed = put != seen;
+		seen = put;
+		epoch = epoch_now;
+
+		if (put == horizon && !deferred)
+		{
+			return false; // nothing published since the covering epoch
+		}
+
+		// The next word the FIFO consumes is at get_now or at get_now + 4 (an argument read looks at PUT from the word
+		// before it): both must be below the horizon, so the word at the horizon is never consumed before its epoch.
+		if (defer_allowed && armed && put != horizon && get_now >= get && get_now < horizon && horizon - get_now > 4 &&
+			!(put >= get && put < horizon))
+		{
+			// Still below the horizon, walking up: the commands ahead were visible when the covering epoch started.
+			get = get_now;
+			deferred = true;
+			if (changed)
+			{
+				put_deferred.fetch_add(1, std::memory_order_relaxed);
+			}
+			return false;
+		}
+
+		horizon = put;
+		get = get_now;
+		armed = true;
+		deferred = false;
+		return true;
+	}
+
+	// The caller started the epoch observe() asked for.
+	void started(std::uint64_t epoch_now) noexcept
+	{
+		epoch = epoch_now;
+	}
+};
+}
