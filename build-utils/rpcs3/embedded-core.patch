+// NEOSTATION_BUILD487_DIAGNOSTICS_V1: COREPROF other_ms/window_ms/*_cores/
+// compile_threads/rsx_fifo_busy/rsx_thread_cpu/top, a window without presented
+// frames still reported, RANGELOCKPROF per-source max_hold_us, the additive
+// metrics ABI fields (guest frames, native UI) and the FREEZE_DUMP trigger.
+// Pure arithmetic and formatting live in RPCS3IOSProfilerHelpers.h.
 
 #include <algorithm>
+#include <array>
 #include <atomic>
+#include <bit>
 #include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstddef>
