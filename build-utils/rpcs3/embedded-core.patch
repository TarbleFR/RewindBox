@@ -0,0 +1,10 @@
+#pragma once
+
+#include "../VulkanAPI.h"
+
+namespace vk
+{
+// Borrowed from the VkEvent; valid until that event is destroyed.
+void* export_metal_event(VkDevice device, VkEvent event);
+VkResult wait_for_metal_event(void* metal_event, VkDevice device, VkEvent event, u64 timeout_us);
+}
diff --git a/rpcs3/Emu/RSX/VK/vkutils/metal_event.mm b/rpcs3/Emu/RSX/VK/vkutils/metal_event.mm
new file mode 100644
index 0000000..504190d
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/metal_event.mm
@@ -0,0 +1,48 @@
+#include "metal_event.h"
+#include "ios/IOSGPUEventWait.h"
+#include "Emu/Cell/timers.hpp"
+#include "util/asm.hpp"
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wold-style-cast"
+#import <Metal/Metal.h>
+#pragma clang diagnostic pop
+
+namespace vk
+{
+void* export_metal_event(VkDevice device, VkEvent event)
+{
+    const auto export_objects = reinterpret_cast<PFN_vkExportMetalObjectsEXT>(
+        vkGetDeviceProcAddr(device, "vkExportMetalObjectsEXT"));
+    if (!export_objects)
+    {
+        return nullptr;
+    }
+
+    VkExportMetalSharedEventInfoEXT shared_event{
+        .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_SHARED_EVENT_INFO_EXT,
+        .pNext = nullptr,
+        .semaphore = VK_NULL_HANDLE,
+        .event = event,
+        .mtlSharedEvent = nullptr,
+    };
+    VkExportMetalObjectsInfoEXT objects{
+        .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+        .pNext = &shared_event,
+    };
+    export_objects(device, &objects);
+    return shared_event.mtlSharedEvent;
+}
+
+VkResult wait_for_metal_event(void* metal_event, VkDevice device, VkEvent event, u64 timeout_us)
+{
+    const auto shared_event = static_cast<id<MTLSharedEvent>>(metal_event);
+    const auto result = rpcs3::ios::wait_for_gpu_event(VK_EVENT_RESET, VK_TIMEOUT, timeout_us,
+        [&] { return shared_event.signaledValue; },
+        [&] { return vkGetEventStatus(device, event); },
+        [] { return get_system_time(); },
+        [&](u64 value, u64 milliseconds) { [shared_event waitUntilSignaledValue:value timeoutMS:milliseconds]; },
+        [] { utils::pause(); });
+    return result == VK_EVENT_SET ? VK_SUCCESS : result;
+}
+}
diff --git a/rpcs3/Emu/RSX/VK/vkutils/pipeline_key_normalization.h b/rpcs3/Emu/RSX/VK/vkutils/pipeline_key_normalization.h
new file mode 100644
index 0000000..5fa93ca
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/pipeline_key_normalization.h
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "graphics_pipeline_state.hpp"
+
+namespace vk
+{
+#ifdef RPCS3_IOS
+    // REWINDBOX_PIPELINE_DYNAMIC_KEY: these values are supplied by commands,
+    // not by the compiled pipeline. int_compile_graphics_pipe always declares
+    // them dynamic (depth bounds is either dynamic or unsupported/disabled).
+    // Normalize only the private key; update_draw_state still emits the guest
+    // values, and static enable bits/operations remain part of the key.
+    inline void normalize_pipeline_dynamic_state(graphics_pipeline_state& state) noexcept
+    {
+        state.rs.lineWidth = 1.f;
+        state.rs.depthBiasConstantFactor = 0.f;
+        state.rs.depthBiasClamp = 0.f;
+        state.rs.depthBiasSlopeFactor = 0.f;
+        state.ds.minDepthBounds = 0.f;
+        state.ds.maxDepthBounds = 1.f;
+        state.ds.front.compareMask = state.ds.back.compareMask = 0;
+        state.ds.front.writeMask = state.ds.back.writeMask = 0;
+        state.ds.front.reference = state.ds.back.reference = 0;
+        for (auto& value : state.cs.blendConstants)
+            value = 0.f;
+    }
+#endif
+    // CELL542: a pipeline may be used with a compatible render pass. The
+    // current encoder stores five 3-bit layouts at bits 22..36. General and
+    // attachment-optimal layouts do not change compatibility. Preserve slot
+    // presence, formats, samples, input references, reserved bits and the
+    // feedback-loop encoding (4). Never use this key to begin a render pass or
+    // transition an image: only normalize the private compiled-pipeline key.
+    constexpr u64 compatible_pipeline_renderpass_key(u64 key) noexcept
+    {
+        for (u32 shift = 22; shift < 37; shift += 3)
+        {
+            const u64 layout = (key >> shift) & 7;
+            if (layout == 2 || layout == 3)
+                key = (key & ~(7ull << shift)) | (1ull << shift);
+        }
+        return key;
+    }
+
+    inline void normalize_pipeline_blending(graphics_pipeline_state& state) noexcept
+    {
+        for (u32 i = 0; i < state.cs.attachmentCount; ++i)
+        {
+            auto& a = state.att_state[i];
+            if (!a.colorWriteMask || state.cs.logicOpEnable)
+                a.blendEnable = VK_FALSE;
+
+            const bool rgb_unused = !a.blendEnable ||
+                !(a.colorWriteMask & (VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT));
+            const bool alpha_unused = !a.blendEnable || !(a.colorWriteMask & VK_COLOR_COMPONENT_A_BIT);
+            if (rgb_unused) a.colorBlendOp = VK_BLEND_OP_ADD;
+            if (alpha_unused) a.alphaBlendOp = VK_BLEND_OP_ADD;
+
+            // MIN/MAX do not multiply by the factors. Masked alpha blending
+            // does not remove the shader's alpha output: RGB may still use it.
+            if (rgb_unused || a.colorBlendOp == VK_BLEND_OP_MIN || a.colorBlendOp == VK_BLEND_OP_MAX)
+            {
+                a.srcColorBlendFactor = VK_BLEND_FACTOR_ONE;
+                a.dstColorBlendFactor = VK_BLEND_FACTOR_ZERO;
+            }
+            if (alpha_unused || a.alphaBlendOp == VK_BLEND_OP_MIN || a.alphaBlendOp == VK_BLEND_OP_MAX)
+            {
+                a.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+                a.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+            }
+        }
+    }
+
+    // CELL543: depth/stencil state that the compatible render pass cannot
+    // observe. Bits 8..15 of the key hold the depth/stencil attachment format
+    // (0: none). Vulkan ignores pDepthStencilState for a subpass without a
+    // depth/stencil attachment; the stencil test is skipped and stencil is
+    // never written without a stencil aspect; a disabled depth test performs
+    // no comparison and no depth write. Compare/write masks and references
+    // stay as decoded (they are dynamic state). Only the private key changes.
+    constexpr bool depth_format_has_stencil(u32 format) noexcept
+    {
+        return format == VK_FORMAT_S8_UINT || format == VK_FORMAT_D16_UNORM_S8_UINT ||
+            format == VK_FORMAT_D24_UNORM_S8_UINT || format == VK_FORMAT_D32_SFLOAT_S8_UINT;
+    }
+
+    inline void normalize_pipeline_depth_stencil(graphics_pipeline_state& state, u64 renderpass_key) noexcept
+    {
+        auto& ds = state.ds;
+        const u32 depth_format = static_cast<u32>((renderpass_key >> 8) & 0xFF);
+        if (!depth_format)
+        {
+            const VkStructureType type = ds.sType;
+            ds = {};
+            ds.sType = type;
+            return;
+        }
+
+        if (!ds.depthTestEnable)
+        {
+            ds.depthWriteEnable = VK_FALSE;
+            ds.depthCompareOp = VK_COMPARE_OP_NEVER;
+        }
+
+        if (!ds.stencilTestEnable || !depth_format_has_stencil(depth_format))
+        {
+            ds.stencilTestEnable = VK_FALSE;
+            ds.front = {};
+            ds.back = {};
+        }
+    }
+}
diff --git a/rpcs3/Emu/RSX/VK/vkutils/query_slot_queue.hpp b/rpcs3/Emu/RSX/VK/vkutils/query_slot_queue.hpp
new file mode 100644
index 0000000..00b0ad0
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/query_slot_queue.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <bit>
+#include <vector>
+
+namespace vk
+{
+// The query manager has a fixed number of slots. Preserve FIFO reuse order
+// without allocating/deallocating deque blocks during steady-state rendering.
+class query_slot_queue
+{
+	std::vector<u32> m_slots;
+	u32 m_head = 0;
+	u32 m_tail = 0;
+	u32 m_mask = 0;
+	u32 m_capacity = 0;
+
+public:
+	void set_capacity(u32 capacity)
+	{
+		ensure(m_slots.empty() && capacity);
+		ensure(capacity <= 0x80000000u);
+		m_capacity = capacity;
+		m_slots.resize(std::bit_ceil(capacity));
+		m_mask = static_cast<u32>(m_slots.size() - 1);
+	}
+
+	bool empty() const { return m_head == m_tail; }
+	u32 front() const { return m_slots[m_head & m_mask]; }
+
+	void pop_front()
+	{
+		ensure(!empty());
+		++m_head;
+	}
+
+	void push_back(u32 index)
+	{
+		ensure(m_tail - m_head < m_capacity);
+		m_slots[m_tail++ & m_mask] = index;
+	}
+};
+}
diff --git a/rpcs3/Emu/RSX/VK/vkutils/sampler_shader_state.hpp b/rpcs3/Emu/RSX/VK/vkutils/sampler_shader_state.hpp
new file mode 100644
index 0000000..f8fb59f
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/sampler_shader_state.hpp
@@ -0,0 +1,91 @@
+#pragma once
+
+#include "../../Common/TextureUtils.h"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace vk
+{
+	// A texture can be rebound to a different host subresource without a guest
+	// sampler-register write. Keep only the descriptor fields consumed by shader
+	// selection/uniform preparation; do not copy deferred image lists or pixels.
+	struct sampler_shader_state
+	{
+		std::array<std::uint32_t, 10> coordinates{};
+		std::uint32_t dimension = 0;
+		std::uint32_t format_class = 0;
+		std::uint32_t format_features = 0;
+		std::uint32_t texel_remap_control = 0;
+		std::uint8_t samples = 1;
+		bool cyclic = false;
+		bool clamp = false;
+		bool valid = false;
+
+		template <typename Descriptor>
+		static sampler_shader_state capture_vertex(const Descriptor& descriptor)
+		{
+			sampler_shader_state result;
+			result.valid = descriptor.validate();
+			if (!result.valid)
+			{
+				return result;
+			}
+
+			result.dimension = static_cast<std::uint32_t>(descriptor.image_type);
+			result.format_class = static_cast<std::uint32_t>(descriptor.format_class);
+			result.samples = descriptor.samples;
+			return result;
+		}
+
+		template <typename Descriptor>
+		static sampler_shader_state capture_fragment(const Descriptor& descriptor)
+		{
+			auto result = capture_vertex(descriptor);
+			if (!result.valid)
+			{
+				return result;
+			}
+			result.cyclic = descriptor.format_class != rsx::RSX_FORMAT_CLASS_COLOR && descriptor.is_cyclic_reference;
+			result.clamp = descriptor.texcoord_xform.clamp;
+			result.format_features = descriptor.format_ex.features;
+			result.texel_remap_control = result.format_features ? descriptor.format_ex.texel_remap_control : 0;
+			std::memcpy(result.coordinates.data(), descriptor.texcoord_xform.scale, 6 * sizeof(std::uint32_t));
+			if (result.clamp)
+			{
+				// Inactive clamp bounds are intentionally not read: descriptors do
+				// not initialize them until clipping is required.
+				std::memcpy(result.coordinates.data() + 6, descriptor.texcoord_xform.clamp_min, 4 * sizeof(std::uint32_t));
+			}
+			return result;
+		}
+
+		template <typename Descriptor>
+		bool matches_vertex(const Descriptor& descriptor) const
+		{
+			return valid && descriptor.validate() &&
+				dimension == static_cast<std::uint32_t>(descriptor.image_type) &&
+				format_class == static_cast<std::uint32_t>(descriptor.format_class) &&
+				samples == descriptor.samples;
+		}
+
+		template <typename Descriptor>
+		bool matches_fragment(const Descriptor& descriptor) const
+		{
+			return matches_vertex(descriptor) &&
+				cyclic == (descriptor.format_class != rsx::RSX_FORMAT_CLASS_COLOR && descriptor.is_cyclic_reference) &&
+				clamp == descriptor.texcoord_xform.clamp &&
+				std::memcmp(coordinates.data(), descriptor.texcoord_xform.scale, 6 * sizeof(std::uint32_t)) == 0 &&
+				(!clamp || std::memcmp(coordinates.data() + 6, descriptor.texcoord_xform.clamp_min, 4 * sizeof(std::uint32_t)) == 0);
+		}
+
+		template <typename Descriptor>
+		bool matches_format(const Descriptor& descriptor) const
+		{
+			return valid &&
+				format_features == descriptor.format_ex.features &&
+				(!format_features || texel_remap_control == descriptor.format_ex.texel_remap_control);
+		}
+	};
+}
