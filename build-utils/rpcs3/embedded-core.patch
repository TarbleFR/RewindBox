+		return ::sysctlbyname("hw.memsize", &value, &size, nullptr, 0) == 0 ? value : 0;
+	}();
+
+	const u64 previous = s_limit_estimate.load();
+	const u64 sample = estimate_process_memory_limit(
+		process_memory_footprint(), os_proc_available_memory(), previous, s_physical_bytes);
+
+	if (sample > previous)
+	{
+		s_limit_estimate.fetch_op([&](u64& value)
+		{
+			if (value >= sample)
+			{
+				return false;
+			}
+
+			value = sample;
+			return true;
+		});
+	}
+
+	return std::max<u64>(sample, s_limit_estimate.load());
+#else
+	return 0;
+#endif
+}
