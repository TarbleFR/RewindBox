+	void sampler_main()
+	{
+		auto last_thread_sample = sample_clock::now();
+		for (;;)
+		{
+			{
+				std::unique_lock lock(m_profile_mutex);
+				if (m_profile_cv.wait_for(lock, jit_memory::active.load(std::memory_order_relaxed) ? std::chrono::milliseconds(100) : thread_sample_period, [this] { return m_stop_sampler; }))
+				{
+					return;
+				}
+			}
+
+			// NEOSTATION_BUILD487_DIAGNOSTICS_V1: sampling no longer waits for the
+			// first presented frame, so boot compilation and a session that stopped
+			// presenting are observed; the frame-change clock feeds the freeze trigger.
+			const u64 frames = m_presented_frames.load(std::memory_order_acquire);
+
+			if (jit_memory::active.load(std::memory_order_relaxed)) jit_memory::sample();
+			if (sample_clock::now() - last_thread_sample < thread_sample_period) continue;
+			last_thread_sample = sample_clock::now();
+			thread_usage_sample usage = sample_core_threads();
+			const auto process_memory = sample_process_memory();
+			bool report = false;
+			{
+				std::lock_guard lock(m_profile_mutex);
+				const auto now = sample_clock::now();
+				m_process_memory.record(process_memory);
+				if (frames != m_last_seen_frames)
+				{
+					m_last_seen_frames = frames;
+					m_last_frame_change = now;
+				}
+				for (usz group = 0; group < core_group_count; ++group)
+				{
+					m_usage_core_sum[group] += usage.cores[group];
+					m_usage_thread_sum[group] += usage.threads[group];
+				}
+				for (const auto& row : usage.detail)
+				{
+					rpcs3::ios::profiler::accumulate_thread(m_usage_thread_cores, row.name, row.cores);
+				}
+				m_usage_compile_cores_sum += usage.compile_cores;
+				m_usage_compile_thread_sum += usage.compile_threads;
+				m_usage_rsx_main_cores_sum += usage.rsx_main_cores;
+				m_usage_samples++;
