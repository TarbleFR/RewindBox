+	static_assert(static_cast<u32>(pixel_format::r16_snorm) == MTLPixelFormatR16Snorm);
+	static_assert(static_cast<u32>(pixel_format::r16_uint) == MTLPixelFormatR16Uint);
+	static_assert(static_cast<u32>(pixel_format::r16_float) == MTLPixelFormatR16Float);
+	static_assert(static_cast<u32>(pixel_format::rg8_unorm) == MTLPixelFormatRG8Unorm);
+	static_assert(static_cast<u32>(pixel_format::rg8_snorm) == MTLPixelFormatRG8Snorm);
+	static_assert(static_cast<u32>(pixel_format::b5g6r5_unorm) == MTLPixelFormatB5G6R5Unorm);
+	static_assert(static_cast<u32>(pixel_format::a1bgr5_unorm) == MTLPixelFormatA1BGR5Unorm);
+	static_assert(static_cast<u32>(pixel_format::abgr4_unorm) == MTLPixelFormatABGR4Unorm);
+	static_assert(static_cast<u32>(pixel_format::bgr5a1_unorm) == MTLPixelFormatBGR5A1Unorm);
+	static_assert(static_cast<u32>(pixel_format::r32_uint) == MTLPixelFormatR32Uint);
+	static_assert(static_cast<u32>(pixel_format::r32_sint) == MTLPixelFormatR32Sint);
+	static_assert(static_cast<u32>(pixel_format::r32_float) == MTLPixelFormatR32Float);
+	static_assert(static_cast<u32>(pixel_format::rg16_unorm) == MTLPixelFormatRG16Unorm);
+	static_assert(static_cast<u32>(pixel_format::rg16_snorm) == MTLPixelFormatRG16Snorm);
+	static_assert(static_cast<u32>(pixel_format::rg16_float) == MTLPixelFormatRG16Float);
+	static_assert(static_cast<u32>(pixel_format::rgba8_unorm) == MTLPixelFormatRGBA8Unorm);
+	static_assert(static_cast<u32>(pixel_format::rgba8_unorm_srgb) == MTLPixelFormatRGBA8Unorm_sRGB);
+	static_assert(static_cast<u32>(pixel_format::rgba8_snorm) == MTLPixelFormatRGBA8Snorm);
+	static_assert(static_cast<u32>(pixel_format::rgba8_uint) == MTLPixelFormatRGBA8Uint);
+	static_assert(static_cast<u32>(pixel_format::bgra8_unorm) == MTLPixelFormatBGRA8Unorm);
+	static_assert(static_cast<u32>(pixel_format::bgra8_unorm_srgb) == MTLPixelFormatBGRA8Unorm_sRGB);
+	static_assert(static_cast<u32>(pixel_format::rgb10a2_unorm) == MTLPixelFormatRGB10A2Unorm);
+	static_assert(static_cast<u32>(pixel_format::rg11b10_float) == MTLPixelFormatRG11B10Float);
+	static_assert(static_cast<u32>(pixel_format::rgb9e5_float) == MTLPixelFormatRGB9E5Float);
+	static_assert(static_cast<u32>(pixel_format::bgr10a2_unorm) == MTLPixelFormatBGR10A2Unorm);
+	static_assert(static_cast<u32>(pixel_format::rg32_uint) == MTLPixelFormatRG32Uint);
+	static_assert(static_cast<u32>(pixel_format::rg32_float) == MTLPixelFormatRG32Float);
+	static_assert(static_cast<u32>(pixel_format::rgba16_unorm) == MTLPixelFormatRGBA16Unorm);
+	static_assert(static_cast<u32>(pixel_format::rgba16_snorm) == MTLPixelFormatRGBA16Snorm);
+	static_assert(static_cast<u32>(pixel_format::rgba16_uint) == MTLPixelFormatRGBA16Uint);
+	static_assert(static_cast<u32>(pixel_format::rgba16_float) == MTLPixelFormatRGBA16Float);
+	static_assert(static_cast<u32>(pixel_format::rgba32_uint) == MTLPixelFormatRGBA32Uint);
+	static_assert(static_cast<u32>(pixel_format::rgba32_float) == MTLPixelFormatRGBA32Float);
+	static_assert(static_cast<u32>(pixel_format::depth16_unorm) == MTLPixelFormatDepth16Unorm);
+	static_assert(static_cast<u32>(pixel_format::depth32_float) == MTLPixelFormatDepth32Float);
+	static_assert(static_cast<u32>(pixel_format::stencil8) == MTLPixelFormatStencil8);
+	static_assert(static_cast<u32>(pixel_format::depth32_float_stencil8) == MTLPixelFormatDepth32Float_Stencil8);
+	static_assert(static_cast<u32>(pixel_format::x32_stencil8) == MTLPixelFormatX32_Stencil8);
+
+	static_assert(static_cast<u32>(texture_type::type_1d) == MTLTextureType1D);
+	static_assert(static_cast<u32>(texture_type::type_1d_array) == MTLTextureType1DArray);
+	static_assert(static_cast<u32>(texture_type::type_2d) == MTLTextureType2D);
+	static_assert(static_cast<u32>(texture_type::type_2d_array) == MTLTextureType2DArray);
+	static_assert(static_cast<u32>(texture_type::type_2d_multisample) == MTLTextureType2DMultisample);
+	static_assert(static_cast<u32>(texture_type::type_cube) == MTLTextureTypeCube);
+	static_assert(static_cast<u32>(texture_type::type_cube_array) == MTLTextureTypeCubeArray);
