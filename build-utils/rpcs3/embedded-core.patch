index 0000000..f810155
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.cpp
@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M2): RSX fragment program decompiler for the native Metal 4 renderer.
+// The generated GLSL follows VKFragmentProgram.cpp line for line; only the device queries differ.
+
+#include "stdafx.h"
+#include "MTLFragmentProgram.h"
+
+#include "Emu/RSX/Program/GLSLCommon.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+#include "Emu/system_config.h"
+#ifdef RPCS3_IOS
+#include "ios/RPCS3IOSExperimentalPolicy.h"
+#endif
+
+std::string MTLFragmentDecompilerThread::getFloatTypeName(usz elementCount)
+{
+	return glsl::getFloatTypeNameImpl(elementCount);
+}
+
+std::string MTLFragmentDecompilerThread::getHalfTypeName(usz elementCount)
+{
+	return glsl::getHalfTypeNameImpl(elementCount);
+}
+
+std::string MTLFragmentDecompilerThread::getFunction(FUNCTION f)
+{
+	return glsl::getFunctionImpl(f);
+}
+
+std::string MTLFragmentDecompilerThread::compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1)
+{
+	return glsl::compareFunctionImpl(f, Op0, Op1);
+}
+
+void MTLFragmentDecompilerThread::prepareBindingTable()
+{
+	// First check if we have constants and textures as those need extra work
+	bool has_textures = false;
+	for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+	{
+		if (PT.type.starts_with("sampler"))
+		{
+			has_textures = true;
+			break;
+		}
+	}
+
+	unsigned location = 0; // All bindings must be set from this var
+	mtl_prog->binding_table.context_buffer_location = location++;
+	if (!properties.constant_offsets.empty())
+	{
+		mtl_prog->binding_table.cbuf_location = location++;
+	}
+
+	mtl_prog->binding_table.tex_param_location = location++;
+	mtl_prog->binding_table.polygon_stipple_params_location = location++;
+
+	std::memset(mtl_prog->binding_table.ftex_location, 0xff, sizeof(mtl_prog->binding_table.ftex_location));
+	std::memset(mtl_prog->binding_table.ftex_stencil_location, 0xff, sizeof(mtl_prog->binding_table.ftex_stencil_location));
+
+	if (has_textures) [[ likely ]]
+	{
+		for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+		{
+			if (!PT.type.starts_with("sampler"))
+			{
+				continue;
+			}
+
+			for (const ParamItem& PI : PT.items)
+			{
+				const auto texture_id = mtl::get_texture_index(PI.name);
+				const auto mask = 1u << texture_id;
+
+				// Allocate real binding
+				mtl_prog->binding_table.ftex_location[texture_id] = location++;
+
+				// Tag the stencil mirror if required
+				if (properties.redirected_sampler_mask & mask) [[ unlikely ]]
+				{
+					mtl_prog->binding_table.ftex_stencil_location[texture_id] = 0;
+				}
+			}
+
+			// Normalize stencil offsets
+			if (properties.redirected_sampler_mask != 0) [[ unlikely ]]
+			{
+				for (auto& stencil_location : mtl_prog->binding_table.ftex_stencil_location)
+				{
+					if (stencil_location != 0)
+					{
+						continue;
+					}
+
+					stencil_location = location++;
+				}
+			}
+		}
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE)
+	{
+		mtl_prog->binding_table.frag_depth_input_location = location++;
+	}
+
+	std::memset(mtl_prog->binding_table.frag_src_location, 0xff, sizeof(mtl_prog->binding_table.frag_src_location));
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		for (u32 i = 0; i < m_prog.mrt_buffers_count; ++i)
+		{
+			mtl_prog->binding_table.frag_src_location[i] = location++;
+		}
+	}
+}
+
+void MTLFragmentDecompilerThread::insertHeader(std::stringstream & OS)
+{
+	prepareBindingTable();
+
+	std::vector<const char*> required_extensions =
+	{
+		"GL_EXT_scalar_block_layout",
+		"GL_EXT_uniform_buffer_unsized_array"
+	};
+
+	if (device_props.has_native_half_support)
+	{
+		required_extensions.emplace_back("GL_EXT_shader_explicit_arithmetic_types_float16");
+	}
+
+	if (properties.multisampled_sampler_mask)
+	{
+		required_extensions.emplace_back("GL_ARB_shader_texture_image_samples");
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_ATTRIBUTE_INTERPOLATION)
+	{
+		required_extensions.emplace_back("GL_EXT_fragment_shader_barycentric");
+	}
+
+	OS << "#version 450\n";
+	for (const auto ext : required_extensions)
+	{
+		OS << "#extension " << ext << ": require\n";
+	}
+
+	OS << "#extension GL_ARB_separate_shader_objects: enable\n\n";
+
+	glsl::insert_subheader_block(OS);
+}
+
+void MTLFragmentDecompilerThread::insertInputs(std::stringstream & OS)
+{
+	glsl::insert_fragment_shader_inputs_block(
+		OS,
+		glsl::extension_flavour::EXT,
+		m_prog,
+		m_parr.params[PF_PARAM_IN],
+		{
+			.two_sided_color = !!(properties.in_register_mask & in_diff_color),
+			.two_sided_specular = !!(properties.in_register_mask & in_spec_color)
+		},
+		mtl::get_varying_register_location
+	);
+}
+
+void MTLFragmentDecompilerThread::insertOutputs(std::stringstream & OS)
+{
+	const std::pair<std::string, std::string> table[] =
+	{
+		{ "ocol0", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r0" : "h0" },
+		{ "ocol1", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r2" : "h4" },
+		{ "ocol2", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r3" : "h6" },
+		{ "ocol3", m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS ? "r4" : "h8" },
+	};
+
+	// NOTE: We do not skip outputs, the only possible combinations are a(0), b(0), ab(0,1), abc(0,1,2), abcd(0,1,2,3)
+	u8 output_index = 0;
+	const bool float_type = (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS) || !device_props.has_native_half_support;
+	const auto reg_type = float_type ? "vec4" : getHalfTypeName(4);
+	for (uint i = 0; i < std::size(table); ++i)
+	{
+		if (!m_parr.HasParam(PF_PARAM_NONE, reg_type, table[i].second))
+		{
+			continue;
+		}
+
+		if (i >= m_prog.mrt_buffers_count)
+		{
+			// Dead writes. Declare as temp variables for DCE to clean up.
+			OS << "vec4 " << table[i].first << "; // Unused\n";
+			mtl_prog->output_color_masks[i] = 0;
+			continue;
+		}
+
+		OS << "layout(location=" << std::to_string(output_index++) << ") " << "out vec4 " << table[i].first << ";\n";
+		mtl_prog->output_color_masks[i] = -1;
+	}
+}
+
+void MTLFragmentDecompilerThread::insertConstants(std::stringstream & OS)
+{
+	// Fixed inputs from shader decompilation process
+	for (const ParamType& PT : m_parr.params[PF_PARAM_UNIFORM])
+	{
+		if (!PT.type.starts_with("sampler"))
+		{
+			continue;
+		}
+
+		for (const ParamItem& PI : PT.items)
+		{
+			std::string samplerType = PT.type;
+
+			const int index = mtl::get_texture_index(PI.name);
+			const auto mask = (1 << index);
+
+			if (properties.multisampled_sampler_mask & mask)
+			{
+				if (samplerType != "sampler1D" && samplerType != "sampler2D")
+				{
+					rsx_log.error("Unexpected multisampled image type '%s'", samplerType);
+				}
+
+				samplerType = "sampler2DMS";
+			}
+			else if (properties.shadow_sampler_mask & mask)
+			{
+				if (properties.common_access_sampler_mask & mask)
+				{
+					rsx_log.error("Texture unit %d is sampled as both a shadow texture and a depth texture", index);
+				}
+				else
+				{
+					samplerType += "Shadow";
+				}
+			}
+
+			const int id = mtl::get_texture_index(PI.name);
+			auto in = mtl::glsl::program_input::make(
+				glsl::glsl_fragment_program,
+				PI.name,
+				mtl::glsl::input_type_texture,
+				mtl::glsl::binding_set_index_fragment,
+				mtl_prog->binding_table.ftex_location[id]
+			);
+			inputs.push_back(in);
+
+			OS << "layout(set=1, binding=" << in.location << ") uniform " << samplerType << " " << PI.name << ";\n";
+
+			if (properties.redirected_sampler_mask & mask)
+			{
+				// Insert stencil mirror declaration
+				in.name += "_stencil";
+				in.location = mtl_prog->binding_table.ftex_stencil_location[id];
+				inputs.push_back(in);
+
+				OS << "layout(set=1, binding=" << in.location << ") uniform u" << samplerType << " " << in.name << ";\n";
+			}
+		}
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE)
+	{
+		const auto frag_depth_type = (m_prog.ctrl & RSX_SHADER_CONTROL_ROP_MULTISAMPLED)
+			? "sampler2DMS"
+			: "sampler2D";
+
+		OS << "layout(set=" << mtl::glsl::binding_set_index_fragment << ", binding=" << mtl_prog->binding_table.frag_depth_input_location << ") uniform " << frag_depth_type << " frag_depth;\n";
+
+		inputs.push_back(mtl::glsl::program_input::make(
+			glsl::glsl_fragment_program,
+			"frag_depth",
+			mtl::glsl::input_type_texture,
+			mtl::glsl::binding_set_index_fragment,
+			mtl_prog->binding_table.frag_depth_input_location
+		));
+	}
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		const std::string_view att_type = (m_prog.ctrl & RSX_SHADER_CONTROL_ROP_MULTISAMPLED)
+			? "subpassInputMS"sv
+			: "subpassInput"sv;
+
+		for (u32 i = 0; i < m_prog.mrt_buffers_count; ++i)
+		{
+			OS << "layout(input_attachment_index= " << i << ", set=" << mtl::glsl::binding_set_index_fragment << ", binding=" << mtl_prog->binding_table.frag_src_location[i] << ") uniform " << att_type << " frag_src_" << i << ";\n";
+
+			inputs.push_back(mtl::glsl::program_input::make(
+				glsl::glsl_fragment_program,
+				fmt::format("frag_src_%u", i),
+				mtl::glsl::input_type_attachment,
+				mtl::glsl::binding_set_index_fragment,
+				mtl_prog->binding_table.frag_src_location[i]
+			));
+		}
+	}
+
+	// Draw params are always provided by vertex program. Instead of pointer chasing, they're provided as varyings.
+	if (!(m_prog.ctrl & RSX_SHADER_CONTROL_INTERPRETER_MODEL))
+	{
+		OS <<
+			"layout(location=" << mtl::get_varying_register_location("usr") << ") in flat uvec4 draw_params_payload;\n\n";
+	}
+
+	OS <<
+		"#define _fs_constants_offset draw_params_payload.x\n"
+		"#define _fs_context_offset draw_params_payload.y\n"
+		"#define _fs_texture_base_index draw_params_payload.z\n"
+		"#define _fs_stipple_pattern_array_offset draw_params_payload.w\n\n";
+
+	if (!properties.constant_offsets.empty())
+	{
+		OS << "layout(std430, set=1, binding=" << mtl_prog->binding_table.cbuf_location << ") uniform FragmentConstantsBuffer\n";
+		OS << "{\n";
+		OS << "	vec4 fc[];\n";
+		OS << "};\n";
+		OS << "#define _fetch_constant(x) fc[x + _fs_constants_offset]\n\n";
+	}
+
+	OS <<
+		"layout(std430, set=1, binding=" << mtl_prog->binding_table.context_buffer_location << ") uniform FragmentStateBuffer\n"
+		"{\n"
+		"	fragment_context_t fs_contexts[];\n"
+		"};\n\n";
+
+	OS << "layout(std430, set=1, binding=" << mtl_prog->binding_table.tex_param_location << ") uniform TextureParametersBuffer\n";
+	OS << "{\n";
+	OS << "	sampler_info texture_parameters[];\n";
+	OS << "};\n\n";
+
+	OS << "layout(std430, set=1, binding=" << mtl_prog->binding_table.polygon_stipple_params_location << ") readonly buffer RasterizerHeap\n";
+	OS << "{\n";
+	OS << "	uvec4 stipple_pattern[];\n";
+	OS << "};\n\n";
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING)
+	{
+		OS <<
+			"layout(push_constant) uniform push_constants_block\n"
+			"{\n"
+			"	layout(offset = 4) uint blend_eqn;\n"
+			"	uint blend_sfactors;\n"
+			"	uint blend_dfactors;\n"
+			"	vec4 blend_constants;\n"
+			"};\n\n";
+
+		auto push_constants = mtl::glsl::program_input::make(glsl::glsl_fragment_program, "push_constants_block",
+			mtl::glsl::input_type_push_constant, mtl::glsl::binding_set_index_fragment, umax);
+		push_constants.push_constant_offset = 4;
+		push_constants.push_constant_size = 28;
+		inputs.push_back(std::move(push_constants));
+	}
+
+	if (!properties.constant_offsets.empty())
+	{
+		inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "FragmentConstantsBuffer",
+			mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.cbuf_location));
+	}
+
+	inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "FragmentStateBuffer",
+		mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.context_buffer_location));
+
+	inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "TextureParametersBuffer",
+		mtl::glsl::input_type_uniform_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.tex_param_location));
+
+	inputs.push_back(mtl::glsl::program_input::make(glsl::glsl_fragment_program, "RasterizerHeap",
+		mtl::glsl::input_type_storage_buffer, mtl::glsl::binding_set_index_fragment, mtl_prog->binding_table.polygon_stipple_params_location));
+}
+
+void MTLFragmentDecompilerThread::insertGlobalFunctions(std::stringstream &OS)
+{
+	m_shader_props.domain = glsl::glsl_fragment_program;
+	m_shader_props.require_lit_emulation = properties.has_lit_op;
+	m_shader_props.fp32_outputs = !!(m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS);
+	m_shader_props.require_depth_conversion = properties.redirected_sampler_mask != 0;
+	m_shader_props.require_wpos = !!(properties.in_register_mask & in_wpos);
+	m_shader_props.require_texture_ops = properties.has_tex_op;
+	m_shader_props.require_tex_shadow_ops = properties.shadow_sampler_mask != 0;
+	m_shader_props.require_msaa_ops = m_prog.texture_state.multisampled_textures != 0;
+	m_shader_props.require_texture_expand = properties.has_exp_tex_op;
+	m_shader_props.require_srgb_to_linear = properties.has_upg;
+	m_shader_props.require_linear_to_srgb = properties.has_pkg;
+	m_shader_props.require_fog_read = properties.in_register_mask & in_fogc;
+	m_shader_props.emulate_shadow_compare = device_props.emulate_depth_compare;
+
+	m_shader_props.low_precision_tests = device_props.has_low_precision_rounding && !(m_prog.ctrl & RSX_SHADER_CONTROL_ATTRIBUTE_INTERPOLATION);
+	// Vulkan: !vk::is_NVIDIA(vendor). Apple GPUs are not NVIDIA.
+	m_shader_props.disable_early_discard = !m_caps.low_precision_rounding;
+	m_shader_props.supports_native_fp16 = device_props.has_native_half_support;
+
+	m_shader_props.ROP_output_rounding = (g_cfg.video.shader_precision != gpu_preset_level::low) && !!(m_prog.ctrl & RSX_SHADER_CONTROL_8BIT_FRAMEBUFFER);
+	m_shader_props.ROP_sRGB_packing = !!(m_prog.ctrl & RSX_SHADER_CONTROL_SRGB_FRAMEBUFFER);
+	m_shader_props.ROP_alpha_test = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TEST);
+	m_shader_props.ROP_alpha_to_coverage_test = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TO_COVERAGE);
+	m_shader_props.ROP_alpha_to_one = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TO_ONE);
+	m_shader_props.ROP_polygon_stipple_test = !!(m_prog.ctrl & RSX_SHADER_CONTROL_POLYGON_STIPPLE);
+	m_shader_props.ROP_discard = !!(m_prog.ctrl & RSX_SHADER_CONTROL_USES_KIL);
+	m_shader_props.ROP_channel_remap = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ROP_OUTPUT_REMAP);
+	m_shader_props.ROP_programmable_blend = !!(m_prog.ctrl & RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING);
+
+	m_shader_props.require_tex1D_ops = properties.has_tex1D;
+	m_shader_props.require_tex2D_ops = properties.has_tex2D;
+	m_shader_props.require_tex3D_ops = properties.has_tex3D;
+	m_shader_props.require_shadowProj_ops = properties.shadow_sampler_mask != 0 && properties.has_texShadowProj;
+	m_shader_props.require_alpha_kill = !!(m_prog.ctrl & RSX_SHADER_CONTROL_TEXTURE_ALPHA_KILL);
+	m_shader_props.require_color_format_convert = !!(m_prog.ctrl & RSX_SHADER_CONTROL_TEXTURE_FORMAT_CONVERT);
+	m_shader_props.emulate_depth_compare = !!(m_prog.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE);
+	m_shader_props.ROP_output_multisampled = !!(m_prog.ctrl & RSX_SHADER_CONTROL_ROP_MULTISAMPLED);
+
+	// Declare global constants
+	if (m_shader_props.require_fog_read)
+	{
+		OS <<
+			"#define fog_param0 fs_contexts[_fs_context_offset].fog_param0\n"
+			"#define fog_param1 fs_contexts[_fs_context_offset].fog_param1\n"
+			"#define fog_mode fs_contexts[_fs_context_offset].fog_mode\n\n";
+	}
+
+	if (m_shader_props.require_wpos)
+	{
+		OS <<
+			"#define wpos_scale fs_contexts[_fs_context_offset].wpos_scale\n"
+			"#define wpos_bias fs_contexts[_fs_context_offset].wpos_bias\n\n";
+	}
+
+	OS <<
+		"#define texture_base_index _fs_texture_base_index\n"
+		"#define TEX_PARAM(index) texture_parameters_##index\n\n";
+
+	glsl::insert_glsl_legacy_function(OS, m_shader_props);
+}
+
+void MTLFragmentDecompilerThread::insertMainStart(std::stringstream & OS)
+{
+	std::set<std::string> output_registers;
+	if (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS)
+	{
+		output_registers = { "r0", "r2", "r3", "r4" };
+	}
+	else
+	{
+		output_registers = { "h0", "h4", "h6", "h8" };
+	}
+
+	if (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_DEPTH_EXPORT)
+	{
+		output_registers.insert("r1");
+	}
+
+	std::string registers;
+	std::string reg_type;
+	const auto half4 = getHalfTypeName(4);
+	for (auto &reg_name : output_registers)
+	{
+		const auto type = (reg_name[0] == 'r' || !device_props.has_native_half_support)? "vec4" : half4;
+		if (reg_type == type) [[likely]]
+		{
+			registers += ", " + reg_name + " = " + type + "(0.)";
+		}
+		else
+		{
+			if (!registers.empty())
+				registers += ";\n";
+
+			registers += type + " " + reg_name + " = " + type + "(0.)";
+		}
+
+		reg_type = type;
+	}
+
+	if (!registers.empty())
+	{
+		OS << registers << ";\n";
+	}
+
+	OS << "void fs_main()\n";
+	OS << "{\n";
+
+	for (const ParamType& PT : m_parr.params[PF_PARAM_NONE])
+	{
+		for (const ParamItem& PI : PT.items)
+		{
+			if (output_registers.find(PI.name) != output_registers.end())
+				continue;
+
+			OS << "	" << PT.type << " " << PI.name;
+			if (!PI.value.empty())
+				OS << " = " << PI.value;
+
+			OS << ";\n";
+		}
+	}
+
+	if (properties.has_w_access)
+		OS << "	float in_w = (1. / gl_FragCoord.w);\n";
+
+	if (properties.in_register_mask & in_ssa)
+		OS << "	vec4 ssa = gl_FrontFacing ? vec4(1.) : vec4(-1.);\n";
+
+	if (properties.in_register_mask & in_wpos)
+		OS << "	vec4 wpos = get_wpos();\n";
+
+	if (properties.in_register_mask & in_fogc)
+		OS << "	vec4 fogc = fetch_fog_value(fog_mode);\n";
+
+	if (m_prog.two_sided_lighting)
+	{
+		if (properties.in_register_mask & in_diff_color)
+			OS << "	vec4 diff_color = gl_FrontFacing ? diff_color0 : diff_color1;\n";
+
+		if (properties.in_register_mask & in_spec_color)
+			OS << "	vec4 spec_color = gl_FrontFacing ? spec_color0 : spec_color1;\n";
+	}
+
+	for (u16 i = 0, mask = (properties.common_access_sampler_mask | properties.shadow_sampler_mask); mask != 0; ++i, mask >>= 1)
+	{
+		if (!(mask & 1))
+		{
+			continue;
+		}
+
+		OS << "	const sampler_info texture_parameters_" << i << " = texture_parameters[texture_base_index + " << i << "];\n";
+	}
+}
+
+void MTLFragmentDecompilerThread::insertMainEnd(std::stringstream & OS)
+{
+	OS << "}\n\n";
+
+	OS << "void main()\n";
+	OS << "{\n";
+
+	constexpr u32 ROP_control_access_options =
+		RSX_SHADER_CONTROL_ALPHA_TEST |
+		RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE |
+		RSX_SHADER_CONTROL_ROP_OUTPUT_REMAP |
+		RSX_SHADER_CONTROL_PROGRAMMABLE_BLENDING;
+
+	if (m_prog.ctrl & ROP_control_access_options)
+	{
+		OS << "	const uint rop_control = fs_contexts[_fs_context_offset].rop_control;\n";
+
+		if (m_prog.ctrl & RSX_SHADER_CONTROL_ALPHA_TEST)
+		{
+			OS << "	const float alpha_ref = fs_contexts[_fs_context_offset].alpha_ref;\n";
+		}
+
+		OS << "\n";
+	}
+
+	::glsl::insert_rop_init(OS, m_prog.mrt_buffers_count);
+
+	OS << "\n" << "	fs_main();\n\n";
+
+	if (m_prog.ctrl & RSX_SHADER_CONTROL_DISABLE_EARLY_Z)
+	{
+		// This is effectively unreachable code, but good enough to trick the GPU to skip early Z
+		// For vulkan, depth export has stronger semantics than discard.
+		OS <<
+			"	// Insert pseudo-barrier sequence to disable early-Z\n"
+			"	gl_FragDepth = gl_FragCoord.z;\n\n";
+	}
+
+	glsl::insert_rop(OS, m_shader_props);
+
+	if (m_prog.ctrl & CELL_GCM_SHADER_CONTROL_DEPTH_EXPORT)
+	{
+		if (m_parr.HasParam(PF_PARAM_NONE, "vec4", "r1"))
+		{
+			// NOTE: Depth writes are always from a fp32 register. See issues section on nvidia's NV_fragment_program spec
+			// https://www.khronos.org/registry/OpenGL/extensions/NV/NV_fragment_program.txt
+
+			// NOTE: Depth writes in OpenGL (and by extension RSX) are clamped to 0,1 range.
+			// Indeed, hardware tests on realhw prove that even in depth float mode, values outside this range are clamped.
+			OS << "	gl_FragDepth = _saturate(r1.z);\n";
+		}
+		else
+		{
+			//Input not declared. Leave commented to assist in debugging the shader
+			OS << "	//gl_FragDepth = r1.z;\n";
+		}
+	}
+
+	OS << "}\n";
+}
+
+void MTLFragmentDecompilerThread::Task()
+{
+	m_shader = Decompile();
+	mtl_prog->inputs = std::move(inputs);
+}
+
+namespace mtl
+{
+	void fragment_program::Decompile(const RSXFragmentProgram& prog, const shader_device_caps& caps)
+	{
+		u32 size;
+		std::string source;
+		MTLFragmentDecompilerThread decompiler(source, prog, size, *this, caps);
+
+		// The same choices as VKFragmentProgram::Decompile for this device.
+		if (g_cfg.video.shader_precision == gpu_preset_level::low
+#ifdef RPCS3_IOS
+			|| rpcs3::ios::get_experimental_policy().native_half_registers  // REWINDBOX_NATIVE_HALF_907
+#endif
+			)
+		{
+			decompiler.device_props.has_native_half_support = caps.has_native_half_support;
+		}
+
+		decompiler.device_props.emulate_depth_compare = caps.emulate_depth_compare;
+		decompiler.device_props.has_low_precision_rounding = caps.low_precision_rounding;
+		decompiler.Task();
+
+		constant_offsets = std::move(decompiler.properties.constant_offsets);
+		glsl_source = std::move(source);
+		spirv.clear();
+
+		std::lock_guard lock(translation_lock);
+		variants.clear();
+	}
+
+	bool fragment_program::Compile()
+	{
+		if (g_cfg.video.log_programs)
+		{
+			fs::write_file(fs::get_cache_dir() + "shaderlog/MetalFragmentProgram" + std::to_string(id) + ".glsl", fs::rewrite, glsl_source);
+		}
+
+		spirv.clear();
+		std::string source = glsl_source;
+		if (!spirv::compile_glsl_to_spv(spirv, source, ::glsl::program_domain::glsl_fragment_program, ::glsl::glsl_rules_vulkan))
+		{
+			compile_error = "glslang refused the fragment program";
+			spirv.clear();
+			return false;
+		}
+
+		compile_error.clear();
+		return true;
+	}
+
+	fragment_program::variant& fragment_program::get_variant(const fragment_variant_key& key) const
+	{
+		auto [it, inserted] = variants.try_emplace(key);
+		if (inserted)
+		{
+			translation_options options{};
+			options.depth_attachment = key.depth_attachment;
+			options.stencil_attachment = key.stencil_attachment;
+			options.color_output_mask = key.color_output_mask;
+			options.sample_mask = key.sample_mask;                   // M4
+			options.sample_rate_shading = key.sample_rate_shading;   // M4
+			it->second.msl = translate_spirv_to_msl(spirv, shader_stage::fragment, inputs, options);
+			if (!it->second.msl.ok)
+			{
+				rsx_log.error("Metal: fragment program %u was not translated to MSL: %s", id, it->second.msl.error);
+			}
+		}
+
+		return it->second;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.h b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.h
new file mode 100644
index 0000000..438c533
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLFragmentProgram.h
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M2): RSX fragment programs for the native Metal 4 renderer.
+// The decompiler emits the same Vulkan-flavoured GLSL as VKFragmentProgram.cpp, with the device facts taken
+// from mtl::shader_device_caps. Programmable blending inputs become framebuffer fetches in MSL.
+
+#include "Emu/RSX/Program/FragmentProgramDecompiler.h"
+#include "Emu/RSX/Program/GLSLTypes.h"
+#include "MTLAPI.h"
+#include "MTLCommonDecompiler.h"
+#include "MTLShaderTranslator.h"
+
+#include <array>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace mtl
+{
+	class fragment_program;
+}
+
+class MTLFragmentDecompilerThread : public FragmentProgramDecompiler
+{
+	std::string& m_shader;
+	std::vector<mtl::glsl::program_input> inputs;
+	mtl::fragment_program* mtl_prog;
+	glsl::shader_properties m_shader_props{};
+	const mtl::shader_device_caps& m_caps;
+
+	void prepareBindingTable();
+
+public:
+	MTLFragmentDecompilerThread(std::string& shader, const RSXFragmentProgram& prog, u32& size, mtl::fragment_program& dst,
+		const mtl::shader_device_caps& caps)
+		: FragmentProgramDecompiler(prog, size)
+		, m_shader(shader)
+		, mtl_prog(&dst)
+		, m_caps(caps)
+	{
+	}
+
+	// FragmentProgramDecompiler::device_props is filled from the capability record before this runs.
+	void Task();
+
+protected:
+	std::string getFloatTypeName(usz elementCount) override;
+	std::string getHalfTypeName(usz elementCount) override;
+	std::string getFunction(FUNCTION f) override;
+	std::string compareFunction(COMPARE f, std::string_view Op0, std::string_view Op1) override;
+
+	void insertHeader(std::stringstream& OS) override;
+	void insertInputs(std::stringstream& OS) override;
+	void insertOutputs(std::stringstream& OS) override;
+	void insertConstants(std::stringstream& OS) override;
+	void insertGlobalFunctions(std::stringstream& OS) override;
+	void insertMainStart(std::stringstream& OS) override;
+	void insertMainEnd(std::stringstream& OS) override;
+};
+
+namespace mtl
+{
+	// Fragment translations depend on the render pass the pipeline draws into.
+	struct fragment_variant_key
+	{
+		bool depth_attachment = true;
+		bool stencil_attachment = false;
+		u32 color_output_mask = 0xffffffffu;
+		u32 sample_mask = 0xffffffffu;      // M4: MSAA sample mask (translation_options::sample_mask)
+		bool sample_rate_shading = false;   // M4: MSAA per-sample shading
+
+		auto operator<=>(const fragment_variant_key&) const = default;
+	};
+
+	class fragment_program
+	{
+	public:
+		ParamArray parr;
+		u32 id = 0;
+		std::vector<glsl::program_input> inputs;
+		std::vector<u32> constant_offsets;
+		std::array<u32, 4> output_color_masks{ {} };
+
+		std::string glsl_source;
+		std::vector<u32> spirv;
+		std::string compile_error;
+
+		// Translations by render-pass variant and the Metal libraries compiled from them, under the lock.
+		struct variant
+		{
+			translation_result msl;
+			object library;
+			std::string library_error;
+		};
+		mutable std::mutex translation_lock;
+		mutable std::map<fragment_variant_key, variant> variants;
+
+		struct
+		{
+			u32 context_buffer_location = umax;           // Rasterizer context
+			u32 cbuf_location = umax;                     // Constants register file
+			u32 tex_param_location = umax;                // Texture configuration data
+			u32 polygon_stipple_params_location = umax;   // Polygon stipple settings
+			u32 ftex_location[16];                        // Texture locations array
+			u32 ftex_stencil_location[16];                // Texture stencil mirror array
+			u32 frag_depth_input_location = umax;         // Fragment depth compare
+			u32 frag_src_location[4];                     // Fragment input attachment locations
+		} binding_table;
+
+		void Decompile(const RSXFragmentProgram& prog, const shader_device_caps& caps);
+
+		// GLSL -> SPIR-V (glslang). False with compile_error set when glslang refuses the source.
+		bool Compile();
+
+		// SPIR-V -> MSL for one variant, translated once and kept. Caller holds translation_lock.
+		variant& get_variant(const fragment_variant_key& key) const;
+		const translation_result& get_msl(const fragment_variant_key& key) const { return get_variant(key).msl; }
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLGSRender.cpp b/rpcs3/Emu/RSX/Metal/MTLGSRender.cpp
new file mode 100644
index 0000000..2bda1d7
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLGSRender.cpp
@@ -0,0 +1,1058 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE: the native Metal 4 renderer (see MTLGSRender.h): device, frames, rings, presentation.
+// The draw path is in MTLDraw.cpp, vertex and index uploads in MTLVertexBuffers.cpp.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+#include "MTLPresent.h"
+
+#include "Emu/IdManager.h"
+#include "Emu/Memory/vm.h"
+#include "Emu/Memory/vm_locking.h"
+#include "Emu/RSX/Host/MM.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+#include "Emu/RSX/rsx_cache.h"  // M5: the program cache on disk (MTLM5Renderer.cpp)
+#include "Emu/RSX/RSXOffload.h"
+#include "Emu/RSX/gcm_enums.h"
+#include "Emu/RSX/Utils/rsx_utils.h"
+#include "Emu/system_config.h"
+#include "util/asm.hpp"
+
+#ifdef RPCS3_IOS
+#include "ios/IOSRsxIdlePark.h"
+#endif
+
+#include <algorithm>
+#include <cstring>
+
+namespace mtl
+{
+	stage_counters& counters() noexcept
+	{
+		static stage_counters s_counters;
+		return s_counters;
+	}
+
+	namespace
+	{
+		// Ring sizes: the Vulkan renderer's initial sizes (VKGSRenderTypes.hpp), which it can grow; these rings
+		// make room by waiting for the GPU instead (counted).
+		constexpr usz ring_sizes_mb[] =
+		{
+			64, // attrib (persistent + volatile vertex streams)
+			16, // index
+			16, // vertex env
+			16, // vertex layout (draw parameters)
+			16, // fragment env
+			16, // fragment texture params
+			16, // fragment constants
+			16, // transform constants
+			16, // raster env (stipple)
+			16, // instancing
+			4,  // push constants
+			64, // texture upload (VK_TEXTURE_UPLOAD_RING_BUFFER_SIZE_M)
+		};
+
+		constexpr const char* ring_names[] =
+		{
+			"metal attrib", "metal index", "metal vertex env", "metal vertex layout", "metal fragment env",
+			"metal fragment texture params", "metal fragment constants", "metal transform constants",
+			"metal raster env", "metal instancing", "metal push constants", "metal texture upload",
+		};
+	}
+}
+
+MTLGSRender::MTLGSRender(utils::serial* ar) noexcept
+	: GSRender(ar)
+{
+	m_device = mtl::create_system_default_device();
+	if (!m_device)
+	{
+		m_initialization_error = "No Metal device";
+		return;
+	}
+
+	m_device_info = mtl::query_device(m_device);
+	if (!m_device_info.metal4)
+	{
+		m_initialization_error = fmt::format("The Metal 4 renderer needs iOS 26 and a Metal 4 GPU (Apple7 or later); this device is '%s'", m_device_info.name);
+		m_device.reset();
+		return;
+	}
+
+	// The same backend facts as the Vulkan renderer on MoltenVK, except where Metal is the reason.
+	backend_config.supports_multidraw = true;               // subranges are drawn one by one
+	backend_config.supports_hw_instanced_rendering = true;
+	backend_config.supports_programmable_blending = true;   // framebuffer fetch on Apple GPUs
+	backend_config.supports_last_provoking_vertex = false;  // Metal has no last-vertex convention: smooth fallback, as Vulkan without the extension
+	backend_config.supports_normalized_barycentrics = true;
+	backend_config.supports_hw_msaa = false;                // M4: set by init_m4_config() below
+	backend_config.supports_hw_a2c = false;
+	backend_config.supports_hw_a2c_1spp = false;
+	backend_config.supports_hw_a2one = false;
+	backend_config.supports_hw_renormalization = false;     // NVIDIA only
+	backend_config.supports_hw_conditional_render = false;  // resolved on the CPU, as on MoltenVK
+	backend_config.supports_passthrough_dma = false;
+	backend_config.supports_host_gpu_labels = false;
+	backend_config.supports_asynchronous_compute = false;
+
+	init_m4_config();  // M4: MSAA backend facts, the native interface's display manager (MTLM4Renderer.cpp)
+}
+
+MTLGSRender::~MTLGSRender() = default;
+
+u64 MTLGSRender::get_cycles()
+{
+	return thread_ctrl::get_cycles(static_cast<named_thread<MTLGSRender>&>(*this));
+}
+
+void MTLGSRender::on_init_thread()
+{
+	if (!m_device)
+	{
+		fmt::throw_exception("%s", m_initialization_error.empty() ? "No Metal device was created" : m_initialization_error);
+	}
+
+	GSRender::on_init_thread();
+	zcull_ctrl.reset(static_cast<::rsx::reports::ZCULL_control*>(this));
+
+	ensure(m_frame, "The Metal renderer needs the iOS display surface");
+#ifdef __APPLE__
+	// The iOS frame's handle is the CAMetalLayer of the display surface (rpcs3::ios::gs_frame::handle).
+	m_layer = m_frame->handle();
+#endif
+	ensure(m_layer, "The display surface has no CAMetalLayer");
+
+	m_queue = mtl::new_command_queue(m_device);
+	open_pipeline_archive();  // M5: the title's pipeline binaries, before the compiler that captures into them
+	m_compiler = mtl::new_compiler(m_device, m_pipeline_archive.serializer());
+	m_event = mtl::new_shared_event(m_device);
+	m_residency = mtl::new_residency_set(m_device, 256);
+	ensure(m_queue && m_compiler && m_event && m_residency, "Metal 4 queue, compiler, event or residency set creation failed");
+
+	// The layer's drawables are resident through the layer's own set.
+	mtl::queue_add_residency_set(m_queue, m_residency);
+	if (const mtl::object layer_set = mtl::layer_residency_set(m_layer))
+	{
+		mtl::queue_add_residency_set(m_queue, layer_set);
+	}
+
+	m_commands.create(m_device, m_queue, m_event, m_residency);
+	mtl::set_command_context(&m_commands);
+
+	update_drawable_size();
+
+	for (frame_slot& slot : m_frames)
+	{
+		slot.allocator = mtl::new_command_allocator(m_device);
+		slot.constants = mtl::new_buffer(m_device, 256, mtl::storage_mode::shared);
+		ensure(slot.allocator && slot.constants, "Metal 4 frame resources");
+		m_commands.make_resident(slot.constants);
+	}
+
+	// Rings
+	for (u32 index = 0; index < ring_count; ++index)
+	{
+		m_rings[index].create(m_device, mtl::ring_sizes_mb[index] * 0x100000, mtl::ring_names[index]);
+		m_rings[index].on_exhausted = [this](usz size) { return on_ring_exhausted(size); };
+		m_commands.make_resident(m_rings[index].buffer);
+	}
+
+	m_texel_buffer_alignment = std::max<u64>(mtl::texture_buffer_alignment(m_device, mtl::pixel_format::r8_uint), 16);
+	m_texel_window_size = m_rings[ring_attrib].size();
+
+	// Argument tables: one per stage, every slot the translator may assign.
+	m_vertex_table = mtl::new_argument_table(m_device, mtl::max_buffer_slots, mtl::max_texture_slots, mtl::max_sampler_slots);
+	m_fragment_table = mtl::new_argument_table(m_device, mtl::max_buffer_slots, mtl::max_texture_slots, mtl::max_sampler_slots);
+	ensure(m_vertex_table && m_fragment_table, "Metal 4 argument tables");
+
+	// Neutral resources: an empty texel buffer and one zeroed texture per dimension (until the texture cache).
+	{
+		const mtl::object zeros = mtl::new_buffer(m_device, 4096, mtl::storage_mode::shared);
+		std::memset(mtl::buffer_contents(zeros), 0, 4096);
+		m_commands.make_resident(zeros);
+		m_null_texture_buffer = mtl::new_texture_buffer(zeros, mtl::pixel_format::r8_uint, 0, 4096);
+		m_commands.make_resident(m_null_texture_buffer);
+		// The buffer stays alive through the texture view.
+
+		const mtl::texture_type types[] = { mtl::texture_type::type_2d, mtl::texture_type::type_2d, mtl::texture_type::type_cube, mtl::texture_type::type_3d };
+		for (u32 index = 0; index < 4; ++index)
+		{
+			mtl::texture_descriptor desc{};
+			desc.type = types[index];
+			desc.format = mtl::pixel_format::rgba8_unorm;
+			desc.width = desc.height = 1;
+			desc.depth = 1;
+			desc.usage = mtl::usage_shader_read;
+			desc.storage = mtl::storage_mode::shared;
+			m_null_textures[index] = mtl::new_texture(m_device, desc);
+			ensure(m_null_textures[index], "Metal neutral texture");
+			const u32 black[6] = {};
+			const u32 faces = desc.type == mtl::texture_type::type_cube ? 6 : 1;
+			for (u32 face = 0; face < faces; ++face)
+			{
+				mtl::texture_replace_region(m_null_textures[index], {{0, 0, 0}, {1, 1, 1}}, 0, face, black, 4, 4);
+			}
+			m_commands.make_resident(m_null_textures[index]);
+		}
+
+		// Stencil mirrors (usampler2D -> texture2d<uint>) and shadow units (depth2d) need matching formats.
+		{
+			mtl::texture_descriptor desc{};
+			desc.format = mtl::pixel_format::r8_uint;
+			desc.usage = mtl::usage_shader_read;
+			desc.storage = mtl::storage_mode::shared;
+			m_null_stencil_texture = mtl::new_texture(m_device, desc);
+			ensure(m_null_stencil_texture, "Metal neutral stencil texture");
+			const u32 zero = 0;
+			mtl::texture_replace_region(m_null_stencil_texture, {{0, 0, 0}, {1, 1, 1}}, 0, 0, &zero, 1, 1);
+			m_commands.make_resident(m_null_stencil_texture);
+
+			desc.format = mtl::pixel_format::depth32_float;
+			desc.usage = mtl::usage_shader_read | mtl::usage_render_target;
+			desc.storage = mtl::storage_mode::private_;
+			m_null_depth_texture = mtl::new_texture(m_device, desc);
+			ensure(m_null_depth_texture, "Metal neutral depth texture");
+			m_commands.make_resident(m_null_depth_texture);
+		}
+
+		mtl::sampler_descriptor sampler{};
+		m_null_sampler = mtl::new_sampler(m_device, sampler);
+		ensure(m_null_texture_buffer && m_null_sampler, "Metal neutral resources");
+	}
+
+	m_present_table = mtl::new_argument_table(m_device, 1, 1, 1);
+	mtl::sampler_descriptor sampler{};
+	sampler.min_filter = mtl::sampler_min_mag_filter::linear;
+	sampler.mag_filter = mtl::sampler_min_mag_filter::linear;
+	m_present_sampler = mtl::new_sampler(m_device, sampler);
+	ensure(m_present_table && m_present_sampler, "Metal 4 presentation table or sampler");
+
+	std::string error;
+	if (!create_present_pipeline(error))
+	{
+		fmt::throw_exception("Metal presentation pipeline: %s", error);
+	}
+
+	if (!create_clear_library(error))
+	{
+		fmt::throw_exception("Metal clear pipeline library: %s", error);
+	}
+
+	// Scaled transfers (MTLBlit.h): the blit engine, region copies, readbacks of scaled sections.
+	if (!m_blit_engine.create(m_device, m_compiler, m_device_info.float32_filtering, error))
+	{
+		fmt::throw_exception("Metal blit library: %s", error);
+	}
+	mtl::set_blit_engine(&m_blit_engine);
+
+	// Shader stack
+	spirv::initialize_compiler_context();
+	mtl::pipeline_environment environment{};
+	environment.device = m_device;
+	environment.compiler = m_compiler;
+	environment.caps.has_native_half_support = true;
+	environment.fast_math = !g_cfg.video.disable_msl_fast_math;
+	mtl::set_pipeline_environment(environment);
+	// The program cache calls this after every link (allow_notification): the program is stored in the disk shader
+	// cache there, as in the Vulkan renderer (M5).
+	m_prog_buffer = std::make_unique<mtl::program_cache>(
+		[this](const mtl::pipeline_props& props, const RSXVertexProgram& vp, const RSXFragmentProgram& fp)
+		{
+			store_program(props, vp, fp);
+		});
+	create_program_cache();  // M5
+
+	// Texture cache (M3.1)
+	mtl::set_upload_heap(&m_rings[ring_texture_upload]);
+	m_texture_cache.initialize(m_rings[ring_texture_upload], m_device_info.bc_texture_compression);
+
+	init_m4();  // M4: occlusion queries, MSAA resolve passes, conversion kernels, overlays
+
+	begin_frame();
+
+	// The neutral depth texture holds depth 1.0 (a cleared depth attachment).
+	{
+		mtl::render_pass_descriptor pass{};
+		pass.depth.texture = m_null_depth_texture;
+		pass.depth.load = mtl::load_action::clear;
+		pass.depth.store = mtl::store_action::store;
+		pass.depth.clear_depth = 1.0;
+		pass.render_target_width = pass.render_target_height = 1;
+		m_commands.begin_render(pass, 0, "neutral depth");
+		m_commands.end_encoder();
+	}
+
+	rsx_log.notice("Metal 4 renderer M3.2: device '%s' (Apple7=%d Apple8=%d Apple9=%d, BC=%d, float32 filtering=%d, sampler LOD bias=%d, unified=%d), drawable %ux%u, fast math %d",
+		m_device_info.name, m_device_info.apple7, m_device_info.apple8, m_device_info.apple9, m_device_info.bc_texture_compression,
+		m_device_info.float32_filtering, m_device_info.sampler_lod_bias, m_device_info.unified_memory, m_drawable_width, m_drawable_height, environment.fast_math);
+	rsx_log.warning("Metal 4 renderer M3.2/M4: scaled transfers into integer formats or between depth formats and guest-memory loads of scaled surfaces are not executed yet (counted in COREPROF METAL)");
+
+	load_program_cache();  // M5: the programs of earlier sessions, built before the first draw (VKGSRender)
+}
+
+void MTLGSRender::on_exit()
+{
+	if (m_commands.recording())
+	{
+		m_commands.submit(false);
+	}
+	m_commands.wait_idle();
+
+	GSRender::on_exit();
+	close_pipeline_caches();  // M5: queued program records, the last pipeline archive checkpoint
+
+	m_texture_cache.destroy();
+	mtl::set_blit_engine(nullptr);
+	m_blit_engine.destroy();
+	m_snapshot_pool.clear();
+	m_draw_snapshots.clear();
+	m_sampler_pool.clear();
+	m_fs_sampler_handles = {};
+	m_vs_sampler_handles = {};
+	m_rtts.destroy();
+	mtl::set_upload_heap(nullptr);
+	destroy_m4();  // M4
+	m_prog_buffer.reset();
+	m_clear_pipelines.clear();
+	m_clear_library.reset();
+	m_depth_stencil_states.clear();
+	m_persistent_window = {};
+	m_volatile_window = {};
+
+	for (auto& ring : m_rings)
+	{
+		ring.destroy();
+	}
+
+	for (frame_slot& slot : m_frames)
+	{
+		slot = {};
+	}
+
+	m_commands.collect();
+	mtl::set_command_context(nullptr);
+	m_commands.destroy();
+	spirv::finalize_compiler_context();
+
+	m_null_textures = {};
+	m_null_stencil_texture.reset();
+	m_null_depth_texture.reset();
+	m_null_texture_buffer.reset();
+	m_null_sampler.reset();
+	m_vertex_table.reset();
+	m_fragment_table.reset();
+	m_present_pipeline.reset();
+	m_present_table.reset();
+	m_present_sampler.reset();
+	m_residency.reset();
+	m_event.reset();
+	m_compiler.reset();
+	m_queue.reset();
+
+	// M4: zcull_ctrl points at this renderer (on_init_thread), it must not delete it (VKGSRender::on_exit)
+	zcull_ctrl.release();
+}
+
+void MTLGSRender::begin_frame()
+{
+	frame_slot& slot = m_frames[m_frame_index % frames_in_flight];
+
+	// The slot's previous frame must be complete before its allocator and ring space are reused.
+	m_commands.wait(slot.fence);
+	m_commands.collect();
+
+	if (slot.positions_valid)
+	{
+		for (u32 index = 0; index < ring_count; ++index)
+		{
+			m_rings[index].set_get_pos(slot.ring_positions[index]);
+		}
+		slot.positions_valid = false;
+	}
+
+	// Frame ids start at 1. The wait above completed this slot's previous frame (id frame_id - frames_in_flight) and
+	// every earlier one: invalidated surfaces older than that, and referenced by nothing, are released (Vulkan trims
+	// at each present). Nothing is recording yet, so their textures go once the work submitted so far has completed.
+	const u64 frame_id = m_frame_index + 1;
+	mtl::set_current_frame_id(frame_id);
+	m_rtts.trim(frame_id > frames_in_flight ? frame_id - frames_in_flight : 0);
+
+	mtl::reset_command_allocator(slot.allocator);
+	m_commands.begin(slot.allocator, "RSX frame");
+	m_current_frame = &slot;
+	m_render_pass_dirty = true;
+	invalidate_environment();
+}
+
+void MTLGSRender::invalidate_environment()
+{
+	m_vertex_env_valid = false;
+	m_xform_constants_valid = false;
+	m_fragment_constants_valid = false;
+	m_fragment_env_valid = false;
+	m_texture_parameters_valid = false;
+	m_stipple_valid = false;
+}
+
+void MTLGSRender::flush_command_queue(bool wait)
+{
+	// An early submission within the frame (readback, full ring): the frame keeps its allocator.
+	const u64 value = m_commands.submit(true);
+#ifdef RPCS3_IOS
+	ios_on_submit();  // M5: carries an armed watched submission (VKGSRender)
+#endif
+	if (wait)
+	{
+		m_commands.wait(value);
+		m_commands.collect();
+	}
+
+	m_commands.begin(m_current_frame->allocator, "RSX frame (continued)");
+	m_render_pass_dirty = true;
+}
+
+bool MTLGSRender::on_ring_exhausted(usz size)
+{
+	mtl::counters().ring_exhaustions.fetch_add(1, std::memory_order_relaxed);
+	rsx_log.warning("Metal: a ring needs %llu bytes: submitting and waiting for the GPU", static_cast<u64>(size));
+
+	flush_command_queue(true);
+	m_commands.wait_idle();
+
+	// grow() then frees the whole exhausted ring from its PUT position, so the rest of this frame may write over
+	// space that a frame slot's saved GET still describes as older data: restoring such a GET at a later
+	// begin_frame() would hand this frame's in-flight data out again. No slot restores its saved positions; each
+	// ring reclaims space again from the next frame end recorded after this point.
+	for (frame_slot& slot : m_frames)
+	{
+		slot.positions_valid = false;
+	}
+
+	invalidate_environment();
+	return true;
+}
+
+// M4: the occlusion queries are in MTLQueries.cpp.
+
+bool MTLGSRender::create_present_pipeline(std::string& error)
+{
+	const mtl::object library = mtl::compile_library(m_compiler, mtl::present_pass::source, error);
+	if (!library)
+	{
+		return false;
+	}
+
+	mtl::render_pipeline_descriptor desc{};
+	desc.library = library;
+	desc.vertex_function = std::string(mtl::present_pass::vertex_function);
+	desc.fragment_function = std::string(mtl::present_pass::fragment_function);
+	desc.color[0].format = mtl::pixel_format::bgra8_unorm;
+	desc.label = "RSX present";
+	m_present_pipeline = mtl::new_render_pipeline(m_compiler, desc, error);
+	return static_cast<bool>(m_present_pipeline);
+}
+
+void MTLGSRender::update_drawable_size()
+{
+	const u32 width = static_cast<u32>(std::max(0, m_frame->client_width()));
+	const u32 height = static_cast<u32>(std::max(0, m_frame->client_height()));
+	if (width == m_drawable_width && height == m_drawable_height && width && height)
+	{
+		return;
+	}
+
+	m_drawable_width = width;
+	m_drawable_height = height;
+	mtl::configure_layer(m_layer, m_device, mtl::pixel_format::bgra8_unorm, width, height);
+}
+
+bool MTLGSRender::upload_display_buffer(frame_slot& slot, u32 address, u32 width, u32 height, u32 pitch)
+{
+	if (!vm::check_addr(address, vm::page_readable, pitch * (height - 1) + width * 4))
+	{
+		return false;
+	}
+
+	if (!slot.upload || slot.upload_width != width || slot.upload_height != height)
+	{
+		if (slot.upload)
+		{
+			m_commands.dispose(std::move(slot.upload), true);
+		}
+
+		mtl::texture_descriptor desc{};
+		desc.format = mtl::pixel_format::bgra8_unorm;
+		desc.width = width;
+		desc.height = height;
+		desc.usage = mtl::usage_shader_read;
+		desc.storage = mtl::storage_mode::shared;
+		slot.upload = mtl::new_texture(m_device, desc);
+		ensure(slot.upload, "Metal display buffer texture");
+		slot.upload_width = width;
+		slot.upload_height = height;
+		m_commands.make_resident(slot.upload);
+	}
+
+	// As the Vulkan renderer's upload_image_simple: each big-endian A8R8G8B8 word stored as a native u32 (BGRA8).
+	m_staging.resize(static_cast<usz>(width) * height);
+	const u8* source = vm::_ptr<const u8>(address);
+	for (u32 row = 0; row < height; ++row)
+	{
+		mtl::present_pass::convert_row(source + static_cast<usz>(row) * pitch, m_staging.data() + static_cast<usz>(row) * width, width);
+	}
+
+	mtl::texture_replace_region(slot.upload, {{0, 0, 0}, {width, height, 1}}, 0, 0, m_staging.data(), width * 4, 0);
+	return true;
+}
+
+void MTLGSRender::submit_frame(const mtl::object& source, u32 display_width, u32 display_height, f32 uv_scale_x, f32 uv_scale_y)
+{
+	frame_slot& slot = *m_current_frame;
+	const mtl::object drawable = mtl::next_drawable(m_layer);
+
+	if (drawable)
+	{
+		// M4: the native overlays are prepared before the pass opens (their uploads may submit), over the image area.
+		{
+			const auto rect = mtl::present_pass::fit(display_width, display_height, m_drawable_width, m_drawable_height);
+			areau image_area{ 0, 0, m_drawable_width, m_drawable_height };
+			if (rect.right > rect.left && rect.top > rect.bottom)
+			{
+				image_area.x1 = static_cast<u32>((rect.left + 1.f) * 0.5f * m_drawable_width);
+				image_area.x2 = static_cast<u32>((rect.right + 1.f) * 0.5f * m_drawable_width);
+				image_area.y1 = static_cast<u32>((1.f - rect.top) * 0.5f * m_drawable_height);
+				image_area.y2 = static_cast<u32>((1.f - rect.bottom) * 0.5f * m_drawable_height);
+			}
+			prepare_overlays(image_area);
+		}
+		// M4 end
+
+		mtl::render_pass_descriptor pass{};
+		pass.color[0].texture = mtl::drawable_texture(drawable);
+		pass.color[0].load = mtl::load_action::clear;
+		pass.color[0].store = mtl::store_action::store;
+		pass.color[0].clear = {0., 0., 0., 1.};
+		const mtl::object& encoder = m_commands.begin_render(pass, 0, "RSX present");
+
+		if (source && display_width && display_height && m_drawable_width && m_drawable_height)
+		{
+			// Fit the display buffer in the drawable, keeping its aspect ratio.
+			mtl::present_pass::parameters params{};
+			params.rect = mtl::present_pass::fit(display_width, display_height, m_drawable_width, m_drawable_height);
+			params.uv_scale[0] = uv_scale_x;
+			params.uv_scale[1] = uv_scale_y;
+			std::memcpy(mtl::buffer_contents(slot.constants), &params, sizeof(params));
+
+			mtl::table_set_buffer(m_present_table, slot.constants, 0, 0);
+			mtl::table_set_texture(m_present_table, source, 0);
+			mtl::table_set_sampler(m_present_table, m_present_sampler, 0);
+			mtl::set_render_pipeline(encoder, m_present_pipeline);
+			mtl::set_argument_table(encoder, m_present_table, mtl::stage_vertex | mtl::stage_fragment);
+			mtl::draw_primitives(encoder, mtl::primitive_type::triangle_strip, 0, 4);
+		}
+
+		m_overlay_renderer.encode(encoder);  // M4: blended over the presented frame
+	}
+	else
+	{
+		mtl::counters().drawable_misses.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	slot.fence = m_commands.submit(false, drawable);
+#ifdef RPCS3_IOS
+	ios_on_submit();                     // M5
+	m_ios_early_submits_this_frame = 0;  // M5: VKPresent.cpp, per frame
+#endif
+	if (drawable)
+	{
+		mtl::present(drawable);
+		mtl::counters().frames_presented.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// Ring space written by this frame is reclaimed when the slot is reused.
+	for (u32 index = 0; index < ring_count; ++index)
+	{
+		slot.ring_positions[index] = m_rings[index].put_position();
+	}
+	slot.positions_valid = true;
+
+	m_frame_index++;
+	fold_queries(false);  // M4: the active query's completed segments (exact, no wait), so its slots are reused
+	begin_frame();
+	m_pipeline_archive.tick();  // M5: a due archive checkpoint goes to its worker (never written here)
+}
+
+void MTLGSRender::flip(const rsx::display_flip_info_t& info)
+{
+	if (info.skip_frame || !m_queue)
+	{
+		m_frame->flip(m_context, true);
+		rsx::thread::flip(info);
+		return;
+	}
+
+	update_drawable_size();
+
+	// The display buffer, as the Vulkan renderer reads it.
+	u32 width = display_buffers[info.buffer].width;
+	u32 height = display_buffers[info.buffer].height;
+	u32 pitch = display_buffers[info.buffer].pitch;
+	u32 format = CELL_GCM_TEXTURE_A8R8G8B8;
+	const auto& avconfig = g_fxo->get<rsx::avconf>();
+
+	if (!width)
+	{
+		width = avconfig.resolution_x;
+		height = avconfig.resolution_y;
+	}
+
+	if (avconfig.state)
+	{
+		format = avconfig.get_compatible_gcm_format();
+		if (!pitch)
+		{
+			pitch = width * avconfig.get_bpp();
+		}
+
+		const size2u video_frame_size = avconfig.video_frame_size();
+		width = std::min(width, video_frame_size.width);
+		height = std::min(height, video_frame_size.height);
+	}
+	else if (!pitch)
+	{
+		pitch = width * 4;
+	}
+
+	mtl::object source;
+	f32 uv_x = 1.f, uv_y = 1.f;
+
+	if (info.buffer < display_buffers_count && width && height)
+	{
+		const u32 address = rsx::get_address(display_buffers[info.buffer].offset, CELL_GCM_LOCATION_LOCAL);
+
+		// The surface that holds the display buffer, as VKGSRender::get_present_source finds it.
+		if (auto surface = m_rtts.get_surface_at(address);
+			surface && !surface->is_depth_surface() && surface->texture && surface->native_format == mtl::pixel_format::bgra8_unorm)
+		{
+			if (surface->samples() > 1)
+			{
+				// M4: VK get_present_source: a multisampled surface is read by a transfer, through its resolve texture (sizes
+				// in samples)
+				surface->memory_barrier(m_commands, rsx::surface_access::transfer_read);
+				// M5: get_surface creates and resolves a resolve image the barrier did not need yet (never read unwritten)
+				if (mtl::image* resolved = surface->get_surface(rsx::surface_access::transfer_read); resolved && resolved->samples() == 1)
+				{
+					source = resolved->texture;
+				}
+				uv_x = std::min(1.f, static_cast<f32>(width) / std::max<u32>(surface->get_surface_width<rsx::surface_metrics::samples>(), 1));
+				uv_y = std::min(1.f, static_cast<f32>(height) / std::max<u32>(surface->get_surface_height<rsx::surface_metrics::samples>(), 1));
+			}
+			else
+			{
+				surface->read_barrier(m_commands);
+				source = surface->texture;
+				uv_x = std::min(1.f, static_cast<f32>(width) / std::max<u32>(surface->get_surface_width(), 1));
+				uv_y = std::min(1.f, static_cast<f32>(height) / std::max<u32>(surface->get_surface_height(), 1));
+			}
+
+			if (source)
+			{
+				mtl::counters().frames_from_surface.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+		else if (format != CELL_GCM_TEXTURE_A8R8G8B8 || pitch < width * 4)
+		{
+			mtl::counters().unsupported_display_formats.fetch_add(1, std::memory_order_relaxed);
+		}
+		else if (upload_display_buffer(*m_current_frame, address, width, height, pitch))
+		{
+			source = m_current_frame->upload;
+			mtl::counters().frames_from_guest_memory.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	if (!source)
+	{
+		mtl::counters().frames_without_source.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	submit_frame(source, width, height, uv_x, uv_y);
+
+	// VKPresent.cpp: the texture cache ends its frame (temporary subresources, trimming, predictions), every
+	// sampler is looked up again.
+	m_texture_cache.on_frame_end();
+	m_samplers_dirty.store(true);
+	if (m_snapshot_pool.size() > 16)
+	{
+		// ~image releases them once the GPU no longer reads them.
+		m_snapshot_pool.erase(m_snapshot_pool.begin(), m_snapshot_pool.begin() + (m_snapshot_pool.size() - 16));
+	}
+
+	m_last_flip_us = get_system_time();
+	if ((m_frame_index % 600) == 0)
+	{
+		report_counters();
+		m_last_counter_report_us = m_last_flip_us;
+	}
+	else
+	{
+		report_counters_if_due();
+	}
+
+	m_frame->flip(m_context);
+	rsx::thread::flip(info);
+}
+
+void MTLGSRender::report_counters()
+{
+	// Cumulative since the renderer started; one line every 600 frames (COREPROF METAL in the RPCS3 log).
+	const auto& c = mtl::counters();
+	const auto& s = mtl::get_surface_counters();
+	const auto& p = mtl::get_pipeline_counters();
+	const auto& q = m_commands.counters();
+	const auto& t = mtl::get_texture_counters();
+	const auto load = [](const std::atomic<u64>& value) { return value.load(std::memory_order_relaxed); };
+
+	rsx_log.notice("COREPROF METAL frames=%llu surface=%llu memory=%llu none=%llu drawable_misses=%llu | draws=%llu skipped_program=%llu "
+		"skipped_vertices=%llu cull_both=%llu textures_failed=%llu clears=%llu logic_ops=%llu queries_unmeasured=%llu | "
+		"surfaces=%llu released=%llu invalidated_live=%llu cleared=%llu inherited=%llu transfers_todo=%llu loads_todo=%llu writes_todo=%llu | vp=%llu fp=%llu "
+		"glsl_fail=%llu msl_fail=%llu lib_fail=%llu pipelines=%llu pipeline_fail=%llu | submits=%llu early=%llu waits=%llu "
+		"slow_waits=%llu rings_full=%llu",
+		load(c.frames_presented), load(c.frames_from_surface), load(c.frames_from_guest_memory), load(c.frames_without_source), load(c.drawable_misses),
+		load(c.draws_rendered), load(c.draws_skipped_program), load(c.draws_skipped_no_vertices), load(c.draws_cull_both_faces),
+		load(c.textures_not_bound), load(c.clears), load(c.logic_ops_not_applied), load(c.occlusion_queries_not_measured),
+		load(s.created), load(s.released), static_cast<u64>(m_rtts.invalidated_resources.size()), load(s.cleared), load(s.inherited_copies),
+		load(s.transfers_not_implemented), load(s.memory_loads_not_implemented),
