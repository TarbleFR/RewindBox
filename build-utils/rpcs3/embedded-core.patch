 #endif
 
+LOG_CHANNEL(ios_core_profiler, "iOS Core Profiler");
+
 namespace
 {
 using sample_clock = std::chrono::steady_clock;
+constexpr usz frame_ring_size = 2048;
+constexpr auto thread_sample_period = std::chrono::milliseconds(500);
+constexpr auto report_period = std::chrono::seconds(5);
+
+enum class core_group : u8
+{
+	ppu,
+	spu,
+	rsx,
+	jit,
+	other,
+	count
+};
+
+constexpr usz core_group_count = static_cast<usz>(core_group::count);
+static_assert(core_group_count == rpcs3::ios::profiler::thread_group_count,
+	"RPCS3IOSProfilerHelpers.h mirrors the core_group order (ppu, spu, rsx, jit, other)");
+
+struct thread_usage_sample
+{
+	std::array<double, core_group_count> cores{};
+	std::array<u32, core_group_count> threads{};
+	// NEOSTATION_BUILD487_DIAGNOSTICS_V1: per-thread rows of the same task_threads
+	// pass (only threads with CPU time), the transient compile workers apart from
+	// the permanent JIT threads, and the single RSX puller thread.
+	std::vector<rpcs3::ios::profiler::thread_cores> detail;
+	double compile_cores = 0.0;
+	u32 compile_threads = 0;
+	double rsx_main_cores = 0.0;
+};
+
+core_group classify_thread(std::string_view name)
+{
+	if (rpcs3::ios::profiler::is_transient_compile_thread(name) ||
+		name.starts_with("SPUW.") || name.starts_with("SPU LLVM") ||
+		name.starts_with("RSX.W"))
+	{
+		return core_group::jit;
+	}
+	if (name.starts_with("PPU["))
+	{
+		return core_group::ppu;
+	}
+	if (name.starts_with("SPU") || name.starts_with("RawSPU"))
+	{
+		return core_group::spu;
+	}
+	// The main RSX thread is named "rsx::thread" (lower case): without this
+	// test its CPU time fell into "other" and rsx_ms stayed at zero.
+	if (name.starts_with("RSX") || name.starts_with("rsx::"))
+	{
+		return core_group::rsx;
+	}
+	return core_group::other;
+}
+
+thread_usage_sample sample_core_threads()
+{
+	thread_usage_sample result;
+#ifdef __APPLE__
+	thread_act_array_t threads = nullptr;
+	mach_msg_type_number_t thread_count = 0;
+	if (task_threads(mach_task_self(), &threads, &thread_count) != KERN_SUCCESS)
+	{
+		return result;
+	}
+
+	for (mach_msg_type_number_t index = 0; index < thread_count; ++index)
+	{
+		thread_extended_info_data_t info{};
+		mach_msg_type_number_t count = THREAD_EXTENDED_INFO_COUNT;
+		if (thread_info(threads[index], THREAD_EXTENDED_INFO,
+			reinterpret_cast<thread_info_t>(&info), &count) != KERN_SUCCESS)
+		{
+			mach_port_deallocate(mach_task_self(), threads[index]);
+			continue;
+		}
+
+		const usz group = static_cast<usz>(classify_thread(info.pth_name));
+		result.threads[group]++;
+		const bool transient_compile = rpcs3::ios::profiler::is_transient_compile_thread(info.pth_name);
+		if (transient_compile)
+		{
+			result.compile_threads++;
+		}
+		if (!(info.pth_flags & TH_FLAGS_IDLE))
+		{
+			const double cores = static_cast<double>(info.pth_cpu_usage) / TH_USAGE_SCALE;
+			result.cores[group] += cores;
+			if (transient_compile)
+			{
+				result.compile_cores += cores;
+			}
+			if (rpcs3::ios::profiler::is_rsx_main_thread(info.pth_name))
+			{
+				result.rsx_main_cores += cores;
+			}
+			if (cores > 0.0)
+			{
+				result.detail.push_back({std::string(info.pth_name), cores});
+			}
+		}
+		mach_port_deallocate(mach_task_self(), threads[index]);
