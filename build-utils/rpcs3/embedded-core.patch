diff --git a/Utilities/JITMemoryProfile.h b/Utilities/JITMemoryProfile.h
new file mode 100644
index 0000000..3bd4d98
--- /dev/null
+++ b/Utilities/JITMemoryProfile.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <limits>
+namespace jit_memory {
+inline std::atomic<unsigned> active{0}, peak_active{0};
+inline std::atomic<std::uint64_t> samples{0}, footprint_peak{0}, batch_peak{0}, latest_footprint{0};
+inline std::atomic<std::uint64_t> headroom_min{UINT64_MAX};
+inline std::atomic<std::uint64_t> texture_hash_bytes{0}, texture_hash_ticks{0};
+inline std::atomic<std::uint64_t> vma_block_bytes{0}, vma_allocated{0}, vma_unused{0};
+inline std::atomic<std::uint64_t> cache_index_hits{0}, cache_buffer_hits{0};
+inline std::atomic<void(*)()> sample_hook{nullptr};
+inline void maximum(std::atomic<std::uint64_t>& value, std::uint64_t sample) {
+    auto prior = value.load(std::memory_order_relaxed);
+    while (prior < sample && !value.compare_exchange_weak(prior, sample, std::memory_order_relaxed)) {}
+}
+inline void sample() { if (auto hook = sample_hook.load(std::memory_order_relaxed)) hook(); }
+}
diff --git a/Utilities/JITMinimalObject.h b/Utilities/JITMinimalObject.h
new file mode 100644
index 0000000..1ee8976
--- /dev/null
+++ b/Utilities/JITMinimalObject.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <llvm/ExecutionEngine/ExecutionEngine.h>
+#include <llvm/Object/ObjectFile.h>
+#include <llvm/Support/MemoryBuffer.h>
+#include <llvm/Target/TargetMachine.h>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+
+// Research path: no IR bodies. Bind only explicit symbolic host references,
+// validated before mutating the engine. On a later LLVM fatal error the caller
+// must discard the engine, just as try_add_cached does. Production SPU keeps
+// its established IR/patchpoint path until real-title binding coverage exists.
+namespace jit_minimal_object {
+inline bool add(llvm::ExecutionEngine& engine, std::unique_ptr<llvm::MemoryBuffer>& buffer,
+    const std::string& entry, const std::unordered_map<std::string, std::uint64_t>& bindings,
+    std::string& error)
+{
+    if (!buffer) { error = "missing_object"; return false; }
+    auto object = llvm::object::ObjectFile::createObjectFile(buffer->getMemBufferRef());
+    if (!object) { llvm::consumeError(object.takeError()); error = "invalid_object"; return false; }
+    if ((*object)->getArch() != engine.getTargetMachine()->getTargetTriple().getArch()) {
+        error = "foreign_architecture"; return false;
+    }
+    bool found_entry = false;
+    for (const auto& symbol : (*object)->symbols()) {
+        auto name = symbol.getName(); auto flags = symbol.getFlags();
+        if (!name || !flags) {
+            if (!name) llvm::consumeError(name.takeError());
+            if (!flags) llvm::consumeError(flags.takeError());
+            error = "invalid_symbol"; return false;
+        }
+        if ((*flags & llvm::object::SymbolRef::SF_Absolute) && (*flags & llvm::object::SymbolRef::SF_Global)) { error = "absolute_symbol"; return false; }
+        if ((*flags & llvm::object::SymbolRef::SF_Undefined) && !name->empty()) {
+            const auto found = bindings.find(name->str());
+            if (found == bindings.end() || !found->second) { error = "unbound_symbol:" + name->str(); return false; }
+        } else if (*name == entry) found_entry = true;
+    }
+    if (!found_entry) { error = "missing_entry"; return false; }
+    for (const auto& [name, address] : bindings) engine.updateGlobalMapping(name, address);
+    engine.addObjectFile(llvm::object::OwningBinary<llvm::object::ObjectFile>(std::move(*object), std::move(buffer)));
+    return true;
+}
+}
diff --git a/Utilities/JITObjectBuffer.h b/Utilities/JITObjectBuffer.h
new file mode 100644
index 0000000..531d6e6
--- /dev/null
+++ b/Utilities/JITObjectBuffer.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <zlib.h>
+
+// The object writer produces one gzip member. Decode into the final owner's
+// buffer, with bounded compressed/decompressed sizes and mandatory CRC/ISIZE.
+// ReadAt reads bytes from the same open file, never a second path lookup.
+namespace jit_object_buffer
+{
+inline constexpr std::size_t maximum_object_bytes = 256 * 1024 * 1024;
+inline constexpr std::size_t input_chunk_bytes = 64 * 1024;
+
+template <class ReadAt>
+std::size_t gzip_size(std::uint64_t file_size, ReadAt read)
+{
+    if (file_size < 18 || file_size > maximum_object_bytes) return 0;
+    std::array<unsigned char, 4> footer{};
+    if (read(file_size - 4, footer.data(), footer.size()) != footer.size()) return 0;
+    const auto size = std::uint32_t(footer[0]) | (std::uint32_t(footer[1]) << 8) |
+        (std::uint32_t(footer[2]) << 16) | (std::uint32_t(footer[3]) << 24);
+    return size && size <= maximum_object_bytes ? size : 0;
+}
+
+template <class ReadAt>
+bool inflate(std::uint64_t file_size, ReadAt read, void* output, std::size_t output_size)
+{
+    if (!output || !output_size || output_size > maximum_object_bytes ||
+        file_size < 18 || file_size > maximum_object_bytes) return false;
+    z_stream stream{};
+    if (inflateInit2(&stream, 15 + 16) != Z_OK) return false;
+    struct cleanup { z_stream& stream; ~cleanup() { inflateEnd(&stream); } } guard{stream};
+    std::array<unsigned char, input_chunk_bytes> input;
+    unsigned char overflow = 0;
+    stream.next_out = static_cast<unsigned char*>(output);
+    stream.avail_out = static_cast<uInt>(output_size);
+    std::uint64_t offset = 0;
+    for (;;)
+    {
+        if (!stream.avail_in && offset < file_size)
+        {
+            const auto requested = static_cast<std::size_t>(std::min<std::uint64_t>(input.size(), file_size - offset));
+            const auto got = read(offset, input.data(), requested);
+            if (!got || got > requested) return false;
+            offset += got;
+            stream.next_in = input.data();
+            stream.avail_in = static_cast<uInt>(got);
+        }
+        if (!stream.avail_out)
+        {
+            // Permit zlib to consume a trailer after filling the exact output.
+            stream.next_out = &overflow;
+            stream.avail_out = 1;
+        }
+        const auto before_in = stream.total_in;
+        const auto before_out = stream.total_out;
+        const int status = ::inflate(&stream, Z_NO_FLUSH);
+        if (stream.total_out > output_size) return false;
+        if (status == Z_STREAM_END)
+            return stream.total_out == output_size && stream.total_in == file_size;
+        if (status != Z_OK || (stream.total_in == before_in && stream.total_out == before_out)) return false;
+    }
+}
+}
diff --git a/Utilities/JITPhaseProfile.h b/Utilities/JITPhaseProfile.h
new file mode 100644
index 0000000..d7d9e95
--- /dev/null
+++ b/Utilities/JITPhaseProfile.h
@@ -0,0 +1,208 @@
+#pragma once
+
+// NEOSTATION_BUILD444_JIT_PHASE_PROFILE_V1: process-wide, allocation-free
+// counters of the LLVM compilation phases of the PPU and SPU recompilers.
+// Each phase records events, exclusive ticks (nested phases of the same thread
+// are subtracted), the longest single event and a byte figure (guest code or
+// object bytes). The performance reporter exchanges the counters with zero and
+// prints one JITPROF line per window. Pure diagnostics: no decision in the
+// Core reads these values and no code generation depends on them.
+#include <atomic>
+#include "JITMemoryProfile.h"
+#include <cstdint>
+#include <limits>
+
+namespace jit_phase
+{
+	enum phase : unsigned
+	{
+		ppu_translate,   // PPUTranslator IR generation, bytes = guest code
+		ppu_opt,         // optional ARM64 IR passes (ppu_llvm_ir_passes)
+		ppu_verify,      // llvm::verifyModule
+		ppu_codegen,     // MCJIT code generation of a cache miss (excludes the cache write)
+		ppu_cache_write, // object compression + file write, bytes = object size
+		ppu_cache_read,  // object file read + decompression, bytes = object size
+		ppu_object_load, // object parsing + MCJIT addObjectFile (excludes the read)
+		ppu_finalize,    // finalizeObject relocation per JIT instance
+		ppu_symbols,     // symbol resolver lookups
+		spu_build,       // SPU LLVM IR construction, bytes = guest code
+		spu_passes,      // SPU function pass pipeline
+		spu_codegen,     // SPU code generation + finalization of a cache miss
+		// NEOSTATION_BUILD481_SPU_OBJECT_CACHE_V1
+		spu_cache_read,  // SPU object read + decompression, bytes = object size
+		spu_object_load, // SPU object link + finalization of a cache hit (replaces spu_passes/spu_codegen), bytes = object size
+		spu_cache_write, // SPU object compression + file write, bytes = object size
+		count
+	};
+
+	inline constexpr const char* names[count] = {
+		"ppu_translate", "ppu_opt", "ppu_verify", "ppu_codegen", "ppu_cache_write", "ppu_cache_read",
+		"ppu_object_load", "ppu_finalize", "ppu_symbols", "spu_build", "spu_passes", "spu_codegen",
+		"spu_cache_read", "spu_object_load", "spu_cache_write",
+	};
+
+	struct snapshot
+	{
+		std::uint64_t events[count];
+		std::uint64_t ticks[count];
+		std::uint64_t max_ticks[count];
+		std::uint64_t bytes[count];
+		// Lowest process memory headroom sampled after a PPU module compile in
+		// the window; headroom_samples == 0 means no compile completed.
+		std::uint64_t headroom_min_bytes;
+		std::uint64_t headroom_samples;
+	};
+
+	struct registry
+	{
+		std::atomic<std::uint64_t> events[count]{};
+		std::atomic<std::uint64_t> ticks[count]{};
+		std::atomic<std::uint64_t> max_ticks[count]{};
+		std::atomic<std::uint64_t> bytes[count]{};
+		std::atomic<std::uint64_t> headroom_min{std::numeric_limits<std::uint64_t>::max()};
+		std::atomic<std::uint64_t> headroom_samples{0};
+		// NEOSTATION_BUILD487_DIAGNOSTICS_V1: monotonic totals that the reporter's
+		// exchange() never resets, so a boot-scoped delta (JITPROF_BOOT) does not
+		// depend on the 5 s window phase. window_max_ticks and window_headroom_min
+		// are reset by begin_window() of the boot-scope owner (ppu_initialize()).
+		// The exchanged window fields above keep their exact Build 444 semantics.
+		// This header is hashed into NEOSTATION_PPU_CODEGEN_ID: this edit gives a
+		// new PPU object identity (each title recompiles its PPU modules once).
+		std::atomic<std::uint64_t> total_events[count]{};
+		std::atomic<std::uint64_t> total_ticks[count]{};
+		std::atomic<std::uint64_t> total_bytes[count]{};
+		std::atomic<std::uint64_t> window_max_ticks[count]{};
+		std::atomic<std::uint64_t> window_headroom_min{std::numeric_limits<std::uint64_t>::max()};
+		std::atomic<std::uint64_t> total_headroom_samples{0};
+
+		void add(phase which, std::uint64_t elapsed_ticks, std::uint64_t byte_count = 0) noexcept
+		{
+			if (which >= count) return;
+			events[which].fetch_add(1, std::memory_order_relaxed);
+			ticks[which].fetch_add(elapsed_ticks, std::memory_order_relaxed);
+			bytes[which].fetch_add(byte_count, std::memory_order_relaxed);
+			auto previous = max_ticks[which].load(std::memory_order_relaxed);
+			while (previous < elapsed_ticks &&
+				!max_ticks[which].compare_exchange_weak(previous, elapsed_ticks, std::memory_order_relaxed)) {}
+			total_events[which].fetch_add(1, std::memory_order_relaxed);
+			total_ticks[which].fetch_add(elapsed_ticks, std::memory_order_relaxed);
+			total_bytes[which].fetch_add(byte_count, std::memory_order_relaxed);
+			auto window_previous = window_max_ticks[which].load(std::memory_order_relaxed);
+			while (window_previous < elapsed_ticks &&
+				!window_max_ticks[which].compare_exchange_weak(window_previous, elapsed_ticks, std::memory_order_relaxed)) {}
+		}
+
+		void note_headroom(std::uint64_t headroom_bytes) noexcept
+		{
+			headroom_samples.fetch_add(1, std::memory_order_relaxed);
+			auto previous = headroom_min.load(std::memory_order_relaxed);
+			while (previous > headroom_bytes &&
+				!headroom_min.compare_exchange_weak(previous, headroom_bytes, std::memory_order_relaxed)) {}
+			total_headroom_samples.fetch_add(1, std::memory_order_relaxed);
+			auto window_previous = window_headroom_min.load(std::memory_order_relaxed);
+			while (window_previous > headroom_bytes &&
+				!window_headroom_min.compare_exchange_weak(window_previous, headroom_bytes, std::memory_order_relaxed)) {}
+		}
+
+		// NEOSTATION_BUILD487_DIAGNOSTICS_V1: start of a boot window (resets only
+		// the window maxima and the window headroom minimum; totals are untouched).
+		void begin_window() noexcept
+		{
+			for (unsigned which = 0; which < count; ++which)
+			{
+				window_max_ticks[which].store(0, std::memory_order_relaxed);
+			}
+			window_headroom_min.store(std::numeric_limits<std::uint64_t>::max(), std::memory_order_relaxed);
+		}
+
+		// Totals since process start (events/ticks/bytes/headroom_samples) with the
+		// window maxima; never resets anything.
+		snapshot totals() const noexcept
+		{
+			snapshot result{};
+			for (unsigned which = 0; which < count; ++which)
+			{
+				result.events[which] = total_events[which].load(std::memory_order_relaxed);
+				result.ticks[which] = total_ticks[which].load(std::memory_order_relaxed);
+				result.max_ticks[which] = window_max_ticks[which].load(std::memory_order_relaxed);
+				result.bytes[which] = total_bytes[which].load(std::memory_order_relaxed);
+			}
+			result.headroom_samples = total_headroom_samples.load(std::memory_order_relaxed);
+			result.headroom_min_bytes = window_headroom_min.load(std::memory_order_relaxed);
+			return result;
+		}
+
+		// end - begin for the monotonic fields; maxima and the headroom minimum are
+		// those of `end` (window values), headroom_min_bytes is 0 without a sample.
+		static snapshot window_delta(const snapshot& begin, const snapshot& end) noexcept
+		{
+			const auto sub = [](std::uint64_t a, std::uint64_t b) { return a > b ? a - b : 0; };
+			snapshot result{};
+			for (unsigned which = 0; which < count; ++which)
+			{
+				result.events[which] = sub(end.events[which], begin.events[which]);
+				result.ticks[which] = sub(end.ticks[which], begin.ticks[which]);
+				result.max_ticks[which] = end.max_ticks[which];
+				result.bytes[which] = sub(end.bytes[which], begin.bytes[which]);
+			}
+			result.headroom_samples = sub(end.headroom_samples, begin.headroom_samples);
+			result.headroom_min_bytes = result.headroom_samples && end.headroom_min_bytes != std::numeric_limits<std::uint64_t>::max()
+				? end.headroom_min_bytes : 0;
+			return result;
+		}
+
+		snapshot exchange() noexcept
+		{
+			snapshot result{};
+			for (unsigned which = 0; which < count; ++which)
+			{
+				result.events[which] = events[which].exchange(0, std::memory_order_relaxed);
+				result.ticks[which] = ticks[which].exchange(0, std::memory_order_relaxed);
+				result.max_ticks[which] = max_ticks[which].exchange(0, std::memory_order_relaxed);
+				result.bytes[which] = bytes[which].exchange(0, std::memory_order_relaxed);
+			}
+			result.headroom_samples = headroom_samples.exchange(0, std::memory_order_relaxed);
+			result.headroom_min_bytes = headroom_min.exchange(std::numeric_limits<std::uint64_t>::max(), std::memory_order_relaxed);
+			if (!result.headroom_samples) result.headroom_min_bytes = 0;
+			return result;
+		}
+	};
+
+	// Constant-initialized: no constructor runs during the Core's dlopen.
+	inline constinit registry g_counters{};
+
+	// Ticks of nested scopes on this thread, subtracted by the enclosing scope.
+	inline thread_local std::uint64_t t_nested_ticks = 0;
+
+	// RAII exclusive timer. `now` supplies monotonic ticks (utils::get_tsc in the
+	// Core, which is not declared noexcept; tests inject a counter). Set `bytes`
+	// before the scope ends.
+	class scope
+	{
+		phase m_phase;
+		std::uint64_t (*m_now)();
+		std::uint64_t m_start;
+		std::uint64_t m_nested_at_start;
+
+	public:
+		std::uint64_t bytes;
+
+		scope(phase which, std::uint64_t (*now)(), std::uint64_t byte_count = 0) noexcept
+			: m_phase(which), m_now(now), m_start(now()), m_nested_at_start(t_nested_ticks), bytes(byte_count)
+		{
+			jit_memory::sample();
+		}
+
+		scope(const scope&) = delete;
+		scope& operator=(const scope&) = delete;
+
+		~scope()
+		{
+			jit_memory::sample();
+			const std::uint64_t elapsed = m_now() - m_start;
+			const std::uint64_t nested = t_nested_ticks - m_nested_at_start;
+			g_counters.add(m_phase, elapsed > nested ? elapsed - nested : 0, bytes);
+			t_nested_ticks += elapsed;
+		}
+	};
+}
diff --git a/Utilities/JITPublicationQueue.h b/Utilities/JITPublicationQueue.h
new file mode 100644
index 0000000..1708e6f
--- /dev/null
+++ b/Utilities/JITPublicationQueue.h
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// NEOSTATION_BUILD527_INCREMENTAL_JIT_PUBLICATION_V1
+// MCJIT serializes a memory manager's allocate/notify/finalize callbacks under
+// its engine lock. This queue shares that ownership; it is not a concurrent
+// allocator. Publish only after RuntimeDyld relocation resolution. A resolver
+// error may leave relocations to older sections outstanding: in that case the
+// caller flushes but MUST keep the ranges dirty. Explicit writes made after a
+// successful publication (patchpoints/trampolines) keep their existing direct
+// jit::flush calls and do not rely on this allocation queue.
+namespace jit_publication
+{
+struct snapshot
+{
+	std::uint64_t calls{}, empty_calls{}, deferred_calls{};
+	std::uint64_t history_ranges{}, dirty_ranges{}, flushed_bytes{};
+	std::uint64_t ticks{}, max_ticks{};
+	std::uint64_t retained_metadata_bytes{}, peak_metadata_bytes{};
+};
+
+struct registry
+{
+	std::atomic<std::uint64_t> calls{0}, empty_calls{0}, deferred_calls{0};
+	std::atomic<std::uint64_t> history_ranges{0}, dirty_ranges{0}, flushed_bytes{0};
+	std::atomic<std::uint64_t> ticks{0}, max_ticks{0};
+	std::atomic<std::uint64_t> retained_metadata_bytes{0}, peak_metadata_bytes{0};
+
+	static void maximum(std::atomic<std::uint64_t>& target, std::uint64_t value) noexcept
+	{
+		auto prior = target.load(std::memory_order_relaxed);
+		while (prior < value && !target.compare_exchange_weak(prior, value, std::memory_order_relaxed)) {}
+	}
+
+	snapshot exchange() noexcept
+	{
+		snapshot result;
+		result.calls = calls.exchange(0, std::memory_order_relaxed);
+		result.empty_calls = empty_calls.exchange(0, std::memory_order_relaxed);
+		result.deferred_calls = deferred_calls.exchange(0, std::memory_order_relaxed);
+		result.history_ranges = history_ranges.exchange(0, std::memory_order_relaxed);
+		result.dirty_ranges = dirty_ranges.exchange(0, std::memory_order_relaxed);
+		result.flushed_bytes = flushed_bytes.exchange(0, std::memory_order_relaxed);
+		result.ticks = ticks.exchange(0, std::memory_order_relaxed);
+		result.max_ticks = max_ticks.exchange(0, std::memory_order_relaxed);
+		result.retained_metadata_bytes = retained_metadata_bytes.load(std::memory_order_relaxed);
+		result.peak_metadata_bytes = peak_metadata_bytes.load(std::memory_order_relaxed);
+		return result;
+	}
+};
+
+inline registry& metrics() noexcept
+{
+	static registry instance;
+	return instance;
+}
+
+struct range
+{
+	void* target = nullptr;
+	std::size_t size = 0;
+};
+
+// MM1 owns allocations and keeps target/size records for destruction. MM2's
+// process-lifetime runtime owns them: once published its records can disappear.
+// Neither variant keeps the unused historical writable pointer.
+template <bool RetainAllocations>
+class queue
+{
+	std::vector<range> m_ranges;
+	std::size_t m_published = 0;
+	std::uint64_t m_history = 0;
+
+	void account_capacity(std::size_t old_capacity) noexcept
+	{
+		const auto growth = (m_ranges.capacity() - old_capacity) * sizeof(range);
+		if (growth)
+		{
+			auto& stats = metrics();
+			const auto total = stats.retained_metadata_bytes.fetch_add(growth, std::memory_order_relaxed) + growth;
+			registry::maximum(stats.peak_metadata_bytes, total);
+		}
+	}
+
+public:
+	queue() = default;
+	queue(const queue&) = delete;
+	queue& operator=(const queue&) = delete;
+	~queue()
+	{
+		metrics().retained_metadata_bytes.fetch_sub(m_ranges.capacity() * sizeof(range), std::memory_order_relaxed);
+	}
+
+	void add(void* target, std::size_t size)
+	{
+		const auto old_capacity = m_ranges.capacity();
+		m_ranges.push_back({target, size});
+		account_capacity(old_capacity);
+		++m_history;
+	}
+
+	const std::vector<range>& allocations() const noexcept { return m_ranges; }
+	std::size_t pending() const noexcept { return m_ranges.size() - m_published; }
+	std::size_t metadata_bytes() const noexcept { return m_ranges.capacity() * sizeof(range); }
+
+	template <typename Flush, typename Clock>
+	void publish(Flush&& flush, Clock&& clock, bool can_commit)
+	{
+		const auto begin = clock();
+		auto& stats = metrics();
+		const auto record_duration = [&]() {
+			const auto elapsed = clock() - begin;
+			stats.ticks.fetch_add(elapsed, std::memory_order_relaxed);
+			registry::maximum(stats.max_ticks, elapsed);
+		};
+		stats.calls.fetch_add(1, std::memory_order_relaxed);
+		stats.history_ranges.fetch_add(m_history, std::memory_order_relaxed);
+		const auto count = pending();
+		if (!count)
+		{
+			stats.empty_calls.fetch_add(1, std::memory_order_relaxed);
+			record_duration();
+			return;
+		}
+
+		std::uint64_t bytes = 0;
+		// Commit the cursor only after every flush. If a test/platform flush
+		// throws, the complete dirty suffix remains available for retry.
+		for (auto index = m_published; index < m_ranges.size(); ++index)
+		{
+			const auto& item = m_ranges[index];
+			flush(item.target, item.size);
+			bytes += item.size;
+		}
+		stats.dirty_ranges.fetch_add(count, std::memory_order_relaxed);
+		stats.flushed_bytes.fetch_add(bytes, std::memory_order_relaxed);
+		if (!can_commit)
+		{
+			stats.deferred_calls.fetch_add(1, std::memory_order_relaxed);
+			record_duration();
+			return;
+		}
+		if constexpr (RetainAllocations)
+		{
+			m_published = m_ranges.size();
+		}
+		else
+		{
+			m_ranges.clear();
+			m_published = 0;
+		}
+		record_duration();
+	}
+};
+}
