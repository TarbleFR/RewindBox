+		ppu_symbols,     // symbol resolver lookups
+		spu_build,       // SPU LLVM IR construction, bytes = guest code
+		spu_passes,      // SPU function pass pipeline
+		spu_codegen,     // SPU code generation + finalization of a cache miss
+		// NEOSTATION_BUILD481_SPU_OBJECT_CACHE_V1
+		spu_cache_read,  // SPU object read + decompression, bytes = object size
+		spu_object_load, // SPU object link + finalization of a cache hit (replaces spu_passes/spu_codegen), bytes = object size
+		spu_cache_write, // SPU object compression + file write, bytes = object size
