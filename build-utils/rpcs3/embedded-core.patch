+	GAME_SETTING("experimental.spirv_disk_cache", "Experimental", "Loading", "SPIR-V disk cache", "Keeps the compiled form of each shader on disk, so that the next boots skip the shader compiler. What the GPU receives does not change.", kind::RPCS3_IOS_SETTING_CHOICE, g_cfg.ios_experimental.spirv_disk_cache, 0, 0, 0),
+	GAME_SETTING("experimental.hardware_crypto", "Experimental", "Loading", "Hardware decryption and hashing", "Uses the AES and SHA instructions of the CPU to decrypt and hash the game's code at boot. The results are the same.", kind::RPCS3_IOS_SETTING_CHOICE, g_cfg.ios_experimental.hardware_crypto, 0, 0, 0),
