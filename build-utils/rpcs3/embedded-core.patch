+		spu.interp_fallback_end = program.lower_bound + ::size32(program.data) * 4;
+		spu.interp_fallback = true;
+		jit_write_protect(true);
+		spu_runtime::g_escape(&spu);
+		return true;
+	}
+
+	return false;
+}
