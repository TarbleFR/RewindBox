+	void copy_texture_to_buffer(const object& encoder, const object& source, u32 slice, u32 level, const region& source_area,
+		const object& destination, u64 offset, u32 bytes_per_row, u32 bytes_per_image, u32 options = blit_none);
+	void fill_buffer(const object& encoder, const object& buffer, u64 offset, u64 length, u8 value);
+
+	// Barriers: work of this encoder in `before` waits for the queue's earlier work in `after`.
+	enum barrier_stages : u64
+	{
+		barrier_vertex = 1,
+		barrier_fragment = 1u << 1,
+		barrier_tile = 1u << 2,
+		barrier_object = 1u << 3,
+		barrier_mesh = 1u << 4,
+		barrier_resource_state = 1u << 26,
+		barrier_dispatch = 1u << 27,
+		barrier_blit = 1u << 28,
+		barrier_acceleration_structure = 1u << 29,
+		barrier_machine_learning = 1u << 30,
+		barrier_all = 0x7fffffffffffffffull,
+	};
+	void barrier_after_queue_stages(const object& encoder, u64 after, u64 before);
+
+	void end_encoding(const object& encoder);
+
+	// M4: compute pipelines and dispatches (the conversion kernels of MTLComputeTasks). A pipeline is compiled by the
+	// Metal 4 compiler from a library function; its argument table is captured at each dispatch.
+	struct compute_pipeline_info
+	{
+		u32 max_threads_per_threadgroup = 0;
+		u32 thread_execution_width = 0;
+	};
+	object new_compute_pipeline(const object& compiler, const object& library, std::string_view function, std::string_view label, std::string& error);
+	compute_pipeline_info query_compute_pipeline(const object& pipeline);
+	void set_compute_pipeline(const object& encoder, const object& pipeline);
+	void set_compute_argument_table(const object& encoder, const object& table);
+	void dispatch_threadgroups(const object& encoder, const size3& threadgroups, const size3& threads_per_threadgroup);
+	// M4 end
+
+	// M5: persistent Metal 4 pipeline binaries (MTLPipelineCache.h). A serializer that captures the binary of every
+	// pipeline its compiler builds (MTL4PipelineDataSetSerializer, configuration CaptureBinaries); empty when Metal
+	// does not create one.
+	object new_pipeline_serializer(const object& device);
+	// The compiler, capturing into `serializer` (MTL4CompilerDescriptor.pipelineDataSetSerializer) when not empty;
+	// then also its uncaptured twin, which pipeline creations use while write_pipeline_archive runs.
+	object new_compiler(const object& device, const object& serializer);
+	// The archive file at `path` (MTL4Archive); empty, with error, when Metal cannot open it.
+	object open_pipeline_archive(const object& device, const std::string& path, std::string& error);
+	// Everything `serializer` captured so far, written as an archive file at `path` (never while a pipeline is being
+	// captured into it: such creations end first, and later ones use the twin meanwhile).
+	bool write_pipeline_archive(const object& serializer, const std::string& path, std::string& error);
+	// The archive that every later render and compute pipeline creation looks up first (MTL4CompilerTaskOptions
+	// lookupArchives); empty for none. A pipeline it does not hold is compiled exactly as without it. Set before the
+	// first pipeline of a session and cleared after the last.
+	void set_pipeline_lookup_archive(const object& archive);
+	// The end of a session's capture (after its last archive write): the capturing compiler and its twin are released.
+	void end_pipeline_capture();
+	// Every pipeline created through new_render_pipeline / new_compute_pipeline is a hit (the lookup archive held its
+	// binary) or a miss (compiled: no archive, or not in it). A creation while the archive is being written never waits:
+	// it uses a twin of the capturing compiler without the serializer (uncaptured: missing from that archive only).
+	struct pipeline_archive_counters
+	{
+		std::atomic<u64> hits{0};
+		std::atomic<u64> misses{0};
+		std::atomic<u64> uncaptured{0};
+	};
+	pipeline_archive_counters& get_pipeline_archive_counters();
+	// The running system's version and build ("Version 26.1 (Build 23B85)"), part of an archive's identity.
+	std::string system_version();
+	// M5 end
+
+	// The CAMetalLayer the host attached, and its drawables (Metal 4 presentation through the queue).
+	void configure_layer(void* layer, const object& device, pixel_format format, u32 width, u32 height);
+	object layer_residency_set(void* layer);
+	object next_drawable(void* layer);
+	object drawable_texture(const object& drawable);
+	void wait_for_drawable(const object& queue, const object& drawable);
+	void signal_drawable(const object& queue, const object& drawable);
+	void present(const object& drawable);
+}
