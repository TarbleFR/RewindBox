index 0000000..559f816
--- /dev/null
+++ b/rpcs3/ios/IOSMoltenVKExec.h
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <string_view>
+
+// CELL587_MVK_ENCODE_BARRIER: with MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=0,
+// MoltenVK 1.4.2 returns from vkQueueSubmit and vkQueuePresentKHR once the
+// submission is queued on the serial GCD queue of the VkQueue
+// (MVKQueue::submit, MVKQueue.mm:87); the Metal commands are encoded later on
+// that queue. RPCS3 was written for synchronous submits, where everything that
+// follows vkQueueSubmit follows the encoding. MoltenVK itself breaks with
+// that order at one point: vkAcquireNextImageKHR releases the drawable of the
+// image it returns (MVKPresentableSwapchainImage::acquireAndSignalWhenAvailable,
+// MVKImage.mm:1569), without a lock, while the queue thread fetches the same
+// drawable when it encodes a render into that image or its present
+// (getCAMetalDrawable, MVKImage.mm:1608). An acquisition that overtakes a
+// queued present either releases the drawable that holds the frame, so the
+// present takes a new drawable and the next render of the image draws into an
+// already presented one, or races with the queue thread on the same pointer.
+// The native shader cache dialog flips frames back to back, so the window is
+// widest in the first second of a boot, when every 551 boot ended.
+//
+// The build renames the MoltenVK archive's only dispatch_queue_create
+// reference (MVKQueue::initExecQueue) to rbx_mvk_exec_q_create
+// (RPCS3IOSPlatform.mm), which records the queue. After each present the RSX
+// thread queues a marker behind it; before the next acquisition it waits for
+// the marker of the last present. Command buffers submitted since that present
+// keep encoding while the RSX thread records.
+namespace rpcs3::ios::moltenvk_exec
+{
+// MVKQueue::initName and initExecQueue: "MoltenVKQueue-<family>-<index>-<priority>-Dispatch".
+constexpr bool is_exec_queue_label(std::string_view label) noexcept
+{
+	constexpr std::string_view prefix = "MoltenVKQueue-";
+	constexpr std::string_view suffix = "-Dispatch";
+	return label.size() > prefix.size() + suffix.size() && label.starts_with(prefix) && label.ends_with(suffix);
+}
+
+// MoltenVK creates a separate encoding queue for every VkQueue, including the
+// spare transfer queue. Match the family and index used by vkQueuePresentKHR;
+// neither creation order nor the total number of queues identifies it.
+struct queue_identity
+{
+	std::uint32_t family = 0;
+	std::uint32_t index = 0;
+	bool valid = false;
+};
+
+constexpr queue_identity parse_exec_queue_label(std::string_view label) noexcept
+{
+	if (!is_exec_queue_label(label))
+	{
+		return {};
+	}
+
+	label.remove_prefix(std::string_view{"MoltenVKQueue-"}.size());
+	label.remove_suffix(std::string_view{"-Dispatch"}.size());
+	auto number = [&label](std::uint32_t& value)
+	{
+		std::size_t count = 0;
+		while (count < label.size() && label[count] >= '0' && label[count] <= '9')
+		{
+			const auto digit = static_cast<std::uint32_t>(label[count] - '0');
+			if (value > (UINT32_MAX - digit) / 10)
+			{
+				return false;
+			}
+			value = value * 10 + digit;
+			++count;
+		}
+		if (!count || count == label.size() || label[count] != '-' || (count > 1 && label[0] == '0'))
+		{
+			return false;
+		}
+		label.remove_prefix(count + 1);
+		return true;
+	};
+
+	queue_identity result;
+	if (!number(result.family) || !number(result.index))
+	{
+		return {};
+	}
+
+	// MVKQueue::initName uses %.1f for a Vulkan priority in [0, 1]. Treat an
+	// unfamiliar format as missing identity and retain the existing fallback.
+	result.valid = label.size() == 3 && label[1] == '.' &&
+		((label[0] == '0' && label[2] >= '0' && label[2] <= '9') || label == "1.0");
+	return result;
+}
+
+// A waiter gives up after this long and acquires as before (a stalled queue thread is a
+// GPU or driver failure that the fence timeouts of RPCS3 report).
+constexpr std::chrono::milliseconds wait_limit{2000};
+
+// Present tickets: issued in order on the presenting thread, completed in order by the
+// marker that runs behind each present on MoltenVK's serial queue. Tickets never
+// restart, so a marker left on the queue of a destroyed device cannot complete a newer
+// ticket of the next device's queue.
+class present_tracker
+{
+	std::mutex m_mutex;
+	std::condition_variable m_cv;
+	std::uint64_t m_issued = 0;
+	std::uint64_t m_completed = 0;
+	std::array<std::uint64_t, 16> m_issue_us{};
+
+public:
+	std::uint64_t issue(std::uint64_t now_us) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		const std::uint64_t ticket = ++m_issued;
+		m_issue_us[ticket % m_issue_us.size()] = now_us;
+		return ticket;
+	}
+
+	// Returns the microseconds the ticket spent queued behind earlier work, or 0 for a
+	// ticket that a later one already completed.
+	std::uint64_t complete(std::uint64_t ticket, std::uint64_t now_us) noexcept
+	{
+		std::uint64_t lag = 0;
+		{
+			std::lock_guard lock(m_mutex);
+			if (ticket <= m_completed)
+			{
+				return 0;
+			}
+
+			m_completed = ticket;
+			const std::uint64_t issued = m_issue_us[ticket % m_issue_us.size()];
+			lag = now_us > issued ? now_us - issued : 0;
+		}
+
+		m_cv.notify_all();
+		return lag;
+	}
+
+	bool completed(std::uint64_t ticket) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return m_completed >= ticket;
+	}
+
+	enum class wait_result : std::uint8_t
+	{
+		ready,     // already completed: no wait
+		waited,    // completed while waiting
+		timed_out, // wait_limit elapsed
+	};
+
+	wait_result wait(std::uint64_t ticket, std::chrono::milliseconds limit = wait_limit) noexcept
+	{
+		std::unique_lock lock(m_mutex);
+		if (m_completed >= ticket)
+		{
+			return wait_result::ready;
+		}
+
+		return m_cv.wait_for(lock, limit, [&] { return m_completed >= ticket; }) ? wait_result::waited : wait_result::timed_out;
+	}
+};
+
+// Profile counters, read and cleared by the 5 s performance window (COREPROF OPT587).
+inline std::atomic<std::uint32_t> exec_queues{0};
+inline std::atomic<bool> barrier_missing{false};
+inline std::atomic<std::uint64_t> presents_marked{0}, marker_lag_us{0}, marker_lag_max_us{0};
+inline std::atomic<std::uint64_t> acquire_waits{0}, acquire_wait_us{0}, acquire_wait_max_us{0}, acquire_timeouts{0};
+inline std::atomic<std::uint64_t> drains{0}, drain_us{0};
+
+inline void record_max(std::atomic<std::uint64_t>& maximum, std::uint64_t value) noexcept
+{
+	std::uint64_t current = maximum.load(std::memory_order_relaxed);
+	while (value > current && !maximum.compare_exchange_weak(current, value, std::memory_order_relaxed))
+	{
+	}
+}
+
+// Implemented in RPCS3IOSPlatform.mm.
+// Forget the previous device and record which Vulkan queue presents. The index
+// is 0 in RPCS3; defaults preserve the single-family/single-queue caller.
+void begin_device(std::uint32_t present_family = 0, std::uint32_t present_index = 0) noexcept;
+// Queues recorded since begin_device (0 with synchronous submits).
+std::uint32_t queue_count() noexcept;
+// The configured present queue was captured exactly once, with no lost entries.
+bool has_present_queue() noexcept;
+// After vkQueuePresentKHR: queue a marker behind the present. Returns its ticket, or 0
+// when the presenting queue has no unambiguous recorded identity.
+std::uint64_t mark_present() noexcept;
+// Before vkAcquireNextImageKHR: wait until the marker of ticket has run.
+void wait_for_present(std::uint64_t ticket) noexcept;
+// Wait until everything queued so far on every recorded queue has been encoded.
+void drain() noexcept;
+}
diff --git a/rpcs3/ios/IOSMoltenVKExecQueue.h b/rpcs3/ios/IOSMoltenVKExecQueue.h
new file mode 100644
index 0000000..31c14fd
--- /dev/null
+++ b/rpcs3/ios/IOSMoltenVKExecQueue.h
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSMoltenVKExec.h"
+
+#include <dispatch/dispatch.h>
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+// CELL587_MVK_ENCODE_BARRIER: the GCD side of ios/IOSMoltenVKExec.h. Included
+// by RPCS3IOSPlatform.mm, which forwards rbx_mvk_exec_q_create and the
+// moltenvk_exec functions to registry::instance(), and by the host test that
+// runs it against the real libdispatch on macOS.
+namespace rpcs3::ios::moltenvk_exec::gcd
+{
+inline std::uint64_t now_us() noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// Replaces the queue held by slot, keeping one reference to the new one.
+inline void hold(dispatch_queue_t& slot, dispatch_queue_t queue) noexcept
+{
+#if defined(__OBJC__) && __has_feature(objc_arc)
+	slot = queue;
+#else
+	if (queue)
+	{
+		dispatch_retain(queue);
+	}
+	if (slot)
+	{
+		dispatch_release(slot);
+	}
+	slot = queue;
+#endif
+}
+
+class registry
+{
+	struct recorded_queue
+	{
+		dispatch_queue_t queue = nullptr;
+		queue_identity identity{};
+	};
+
+	std::mutex m_mutex;
+	std::array<recorded_queue, 4> m_queues{};
+	std::uint32_t m_count = 0;
+	std::uint32_t m_present_family = 0;
+	std::uint32_t m_present_index = 0;
+	present_tracker m_presents;
+
+	static void present_marker(void* context) noexcept
+	{
+		const std::uint64_t lag = instance().m_presents.complete(reinterpret_cast<std::uintptr_t>(context), now_us());
+		marker_lag_us.fetch_add(lag, std::memory_order_relaxed);
+		record_max(marker_lag_max_us, lag);
+	}
+
+	static void drain_marker(void*) noexcept
+	{
+	}
+
+	// Called with m_mutex held. An unparsed label, duplicate identity or registry
+	// overflow must not turn a partial set of queues into an apparently unique match.
+	dispatch_queue_t present_queue_locked() const noexcept
+	{
+		if (m_count > m_queues.size())
+		{
+			return nullptr;
+		}
+
+		dispatch_queue_t match = nullptr;
+		for (std::uint32_t i = 0; i < m_count; ++i)
+		{
+			const auto& entry = m_queues[i];
+			if (!entry.identity.valid)
+			{
+				return nullptr;
+			}
+			if (entry.identity.family == m_present_family && entry.identity.index == m_present_index)
+			{
+				if (match)
+				{
+					return nullptr;
+				}
+				match = entry.queue;
+			}
+		}
+		return match;
+	}
+
+	// The presenting queue with a reference for the caller, or null.
+	dispatch_queue_t present_queue() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		dispatch_queue_t queue = nullptr;
+		hold(queue, present_queue_locked());
+		return queue;
+	}
+
+public:
+	static registry& instance() noexcept
+	{
+		static registry s_registry;
+		return s_registry;
+	}
+
+	// rbx_mvk_exec_q_create: a queue MoltenVK created for a VkQueue.
+	void record(dispatch_queue_t queue, const char* label) noexcept
+	{
+		if (!queue || !label || !std::string_view{label}.starts_with("MoltenVKQueue-"))
+		{
+			return;
+		}
+
+		std::lock_guard lock(m_mutex);
+		if (m_count < m_queues.size())
+		{
+			auto& entry = m_queues[m_count];
+			hold(entry.queue, queue);
+			entry.identity = parse_exec_queue_label(label);
+		}
+		// Keep overflow visible to has_present_queue(), including when the
+		// presenting queue happens to be among the first four entries.
+		if (m_count < UINT32_MAX)
+		{
+			++m_count;
+		}
+
+		exec_queues.store(m_count, std::memory_order_relaxed);
+	}
+
+	void begin_device(std::uint32_t present_family = 0, std::uint32_t present_index = 0) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		for (auto& slot : m_queues)
+		{
+			hold(slot.queue, nullptr);
+			slot.identity = {};
+		}
+
+		m_count = 0;
+		m_present_family = present_family;
+		m_present_index = present_index;
+		exec_queues.store(0, std::memory_order_relaxed);
+	}
+
+	std::uint32_t queue_count() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return m_count;
+	}
+
+	bool has_present_queue() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return present_queue_locked() != nullptr;
+	}
+
+	std::uint64_t mark_present() noexcept
+	{
+		dispatch_queue_t queue = present_queue();
+		if (!queue)
+		{
+			return 0;
+		}
+
+		const std::uint64_t ticket = m_presents.issue(now_us());
+		// A serial queue runs the marker right after the present queued before it.
+		dispatch_async_f(queue, reinterpret_cast<void*>(static_cast<std::uintptr_t>(ticket)), present_marker);
+		presents_marked.fetch_add(1, std::memory_order_relaxed);
+		hold(queue, nullptr);
+		return ticket;
+	}
+
+	void wait_for_present(std::uint64_t ticket) noexcept
+	{
+		if (!ticket)
+		{
+			return;
+		}
+
+		const std::uint64_t begin = now_us();
+		switch (m_presents.wait(ticket))
+		{
+		case present_tracker::wait_result::ready:
+			return;
+		case present_tracker::wait_result::waited:
+			break;
+		case present_tracker::wait_result::timed_out:
+			acquire_timeouts.fetch_add(1, std::memory_order_relaxed);
+			break;
+		}
+
+		const std::uint64_t waited = now_us() - begin;
+		acquire_waits.fetch_add(1, std::memory_order_relaxed);
+		acquire_wait_us.fetch_add(waited, std::memory_order_relaxed);
+		record_max(acquire_wait_max_us, waited);
+	}
+
+	void drain() noexcept
+	{
+		std::array<dispatch_queue_t, 4> queues{};
+		{
+			std::lock_guard lock(m_mutex);
+			for (std::uint32_t i = 0; i < m_count && i < m_queues.size(); i++)
+			{
+				hold(queues[i], m_queues[i].queue);
+			}
+		}
+
+		const std::uint64_t begin = now_us();
+		bool any = false;
+		for (auto& queue : queues)
+		{
+			if (queue)
+			{
+				// A serial queue runs this after everything queued on it before.
+				dispatch_sync_f(queue, nullptr, drain_marker);
+				hold(queue, nullptr);
+				any = true;
+			}
+		}
+
+		if (any)
+		{
+			drains.fetch_add(1, std::memory_order_relaxed);
+			drain_us.fetch_add(now_us() - begin, std::memory_order_relaxed);
+		}
+	}
+};
+}
diff --git a/rpcs3/ios/IOSPassiveLockGate.h b/rpcs3/ios/IOSPassiveLockGate.h
new file mode 100644
index 0000000..0fe3d1f
--- /dev/null
+++ b/rpcs3/ios/IOSPassiveLockGate.h
@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+#if defined(__APPLE__)
+#include <os/os_sync_wait_on_address.h>
+#elif defined(__linux__)
+#include <ctime>
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+// CELL571_PASSIVE_LOCK_FAIRNESS: a CPU thread re-entering guest memory
+// (vm::passive_lock) waits until no exclusive writer lock is held anywhere, and
+// a heavy PUTLLC or reservation write takes one while waiting for every PPU
+// thread to park. Several SPUs taking writer locks back to back keep the word
+// set, and the waiter, woken only when it clears, finds a new writer each time
+// (build 567, Dragon Ball Z combat: 520-720 episodes and up to 10 ms per 5 s
+// window, against 3-10 ms in total on build 564). A waiter that has gone
+// through `starving_after` timed waits marks itself starving; a writer about to
+// take its lock first lets the held ones drain while one is, for at most
+// `writer_deferral`. No lock is skipped or weakened: the waiter still waits for
+// the word to clear, and the writer still takes its lock afterwards. The writer
+// spins with the CPU's pause hint: on Darwin sched_yield() depresses the
+// thread for a whole quantum (about 10 ms).
+//
+// CELL579_GATE_SLEEP: a writer spins for at most `writer_spin`, then sleeps on
+// `starving` for the rest of its deferral; the last starving waiter to leave
+// wakes it. Build 575, Call of Duty: Black Ops II: its waiters averaged 25-31
+// timed waits per episode, so heavy PUTLLC deferred most of the time, and in
+// the PUTLLC storm windows about 5 s per 5 s window went before the writers
+// published their bits: up to five SPU threads spinning on the cores the
+// starving PPU thread needed to run on. Deferrals shorter than `writer_spin`
+// (Dragon Ball Z keeps free cores) are unchanged; what the writer and the
+// waiter wait for is unchanged.
+namespace rpcs3::ios::passive_gate
+{
+inline std::atomic<bool> enabled{false};
+inline std::atomic<std::uint32_t> starving{0};
+
+// passive_lock: timed waits (50 us each) before a waiter counts as starving.
+constexpr std::uint64_t starving_after = 2;
+// Longest a writer defers to a starving waiter before taking its lock anyway.
+constexpr std::chrono::microseconds writer_deferral{500};
+// CELL579_GATE_SLEEP: of which it spins at most this long, then sleeps.
+constexpr std::chrono::microseconds writer_spin{50};
+
+// CELL579_GATE_SLEEP: writers asleep in defer_writer(). The waiter that clears
+// `starving` wakes one of them and each woken writer wakes the next, so the PPU
+// thread leaving its wait pays for one wake-up at most.
+inline std::atomic<std::uint32_t> sleepers{0};
+
+// REWINDBOX_PPU_GRACE_664: a starving waiter that finally reads the word clear
+// leaves vm::passive_lock, but cpu_thread::check_state re-parks it at once if a
+// writer published meanwhile, and the next writer's cpu_flag::memory parks it
+// again at its next check point. Under a storm of heavy PUTLLC (Black Ops II,
+// 1.2-1.6 million writer locks per second, the lock held about 87 % of the time)
+// the PPU then advances a few instructions per starving episode: the 9-40 s
+// stalls of IPA 624, 657 and 662 (PPU Secondary parked on cpu_flag::memory, the
+// job queue it feeds never served). When a starving waiter leaves, writers keep
+// deferring for `grace_window` more, so the PPU runs that long before the next
+// writer publishes. Nothing is skipped or weakened: every writer still takes the
+// full writer lock and parks every PPU thread before it stores; it only takes it
+// later, within the same `writer_deferral` bound.
+inline std::atomic<bool> grace_enabled{false};
+// Steady-clock nanoseconds until which writers defer; 0 or past when none.
+inline std::atomic<std::int64_t> grace_until{0};
+constexpr std::chrono::microseconds grace_window{100};
+// Read and reset by the performance window (COREPROF PPUGRACE664): windows opened,
+// writer locks that deferred while only a window held them, and that deferral time.
+inline std::atomic<std::uint64_t> grace_opened{0};
+inline std::atomic<std::uint64_t> grace_deferrals{0};
+inline std::atomic<std::uint64_t> grace_deferred_ns{0};
+// The end of the last window this thread opened. Its own writer locks (a PPU's
+// stwcx or store128 of a full line, an SPU's PUTLLC) do not wait for it: they
+// would only delay the run the window is for, holding their line's reservation.
+inline thread_local std::int64_t own_grace_until = 0;
+
+inline std::int64_t steady_now_ns() noexcept
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// Sleeps while `word` holds `value`, at most `timeout`; it may return earlier.
+inline void sleep_while(std::atomic<std::uint32_t>& word, std::uint32_t value, std::chrono::nanoseconds timeout) noexcept;
+inline void wake_one(std::atomic<std::uint32_t>& word) noexcept;
+inline void wake_all(std::atomic<std::uint32_t>& word) noexcept;
+
+// A waiter's starving mark, released on every exit of the wait loop.
+class waiter_mark
+{
+	bool m_marked = false;
+
+public:
+	waiter_mark() noexcept = default;
+	waiter_mark(const waiter_mark&) = delete;
+	waiter_mark& operator=(const waiter_mark&) = delete;
+
+	// Called once per timed wait; marks the waiter from the `starving_after`-th on.
+	void on_timed_wait(std::uint64_t timed_waits) noexcept
+	{
+		if (!m_marked && timed_waits >= starving_after && enabled.load(std::memory_order_relaxed))
+		{
+			m_marked = true;
+			starving.fetch_add(1, std::memory_order_acq_rel);
+		}
+	}
+
+	bool marked() const noexcept
+	{
+		return m_marked;
+	}
+
+	~waiter_mark()
+	{
+		if (!m_marked)
+		{
+			return;
+		}
+
+		// REWINDBOX_PPU_GRACE_664: opened before the mark drops, so a deferring writer
+		// that sees `starving` fall to zero already sees the window.
+		if (grace_enabled.load(std::memory_order_relaxed))
+		{
+			const std::int64_t until = steady_now_ns() + std::chrono::duration_cast<std::chrono::nanoseconds>(grace_window).count();
+			own_grace_until = until;
+			std::int64_t old = grace_until.load(std::memory_order_relaxed);
+			while (old < until && !grace_until.compare_exchange_weak(old, until, std::memory_order_seq_cst, std::memory_order_relaxed))
+			{
+			}
+			grace_opened.fetch_add(1, std::memory_order_relaxed);
+		}
+
+		// CELL579_GATE_SLEEP: the last starving waiter wakes a writer asleep in defer_writer().
+		if (starving.fetch_sub(1, std::memory_order_seq_cst) == 1 && sleepers.load(std::memory_order_seq_cst))
+		{
+			wake_one(starving);
+		}
+	}
+};
+
+inline void relax() noexcept
+{
+#if defined(__aarch64__)
+	__asm__ volatile("yield" ::: "memory");
+#elif defined(__x86_64__) || defined(__i386__)
+	__builtin_ia32_pause();
+#endif
+}
+
+inline void sleep_while(std::atomic<std::uint32_t>& word, std::uint32_t value, std::chrono::nanoseconds timeout) noexcept
+{
+	static_assert(sizeof(word) == sizeof(std::uint32_t) && std::atomic<std::uint32_t>::is_always_lock_free);
+	const auto ns = static_cast<std::uint64_t>(timeout.count() > 0 ? timeout.count() : 1);
+#if defined(__APPLE__)
+	if (__builtin_available(iOS 17.4, macOS 14.4, *))
+	{
+		os_sync_wait_on_address_with_timeout(&word, value, sizeof(std::uint32_t), OS_SYNC_WAIT_ON_ADDRESS_NONE, OS_CLOCK_MACH_ABSOLUTE_TIME, ns);
+		return;
+	}
+#elif defined(__linux__)
+	const timespec relative{static_cast<time_t>(ns / 1'000'000'000), static_cast<long>(ns % 1'000'000'000)};
+	syscall(SYS_futex, &word, FUTEX_WAIT_PRIVATE, value, &relative, nullptr, 0);
+	return;
+#endif
+	// No address wait on this system: keep spinning, as in 575.
+	static_cast<void>(word); static_cast<void>(value);
+	relax();
+}
+
+inline void wake_one(std::atomic<std::uint32_t>& word) noexcept
+{
+#if defined(__APPLE__)
+	if (__builtin_available(iOS 17.4, macOS 14.4, *))
+	{
+		os_sync_wake_by_address_any(&word, sizeof(std::uint32_t), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+	}
+#elif defined(__linux__)
+	syscall(SYS_futex, &word, FUTEX_WAKE_PRIVATE, 1, nullptr, nullptr, 0);
+#else
+	static_cast<void>(word);
+#endif
+}
+
+inline void wake_all(std::atomic<std::uint32_t>& word) noexcept
+{
+#if defined(__APPLE__)
+	if (__builtin_available(iOS 17.4, macOS 14.4, *))
+	{
+		os_sync_wake_by_address_all(&word, sizeof(std::uint32_t), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+	}
+#elif defined(__linux__)
+	syscall(SYS_futex, &word, FUTEX_WAKE_PRIVATE, 0x7fffffff, nullptr, nullptr, 0);
+#else
+	static_cast<void>(word);
+#endif
+}
+
+// Before a writer publishes its lock: wait while a waiter starves, or while the
+// window a starving waiter opened on leaving lasts (REWINDBOX_PPU_GRACE_664),
+// bounded. Returns true when it deferred at all.
+inline bool defer_writer() noexcept
+{
+	std::uint32_t seen = starving.load(std::memory_order_acquire);
+	std::int64_t grace = grace_until.load(std::memory_order_acquire);
+
+	if (!seen && (!grace || grace <= steady_now_ns()))
+	{
+		return false;
+	}
+
+	// REWINDBOX_PPU_GRACE_664: a window this thread opened does not hold it back.
+	const std::int64_t own = own_grace_until;
+
+	if (!seen && grace <= own)
+	{
+		return false;
+	}
+
+	const auto start = std::chrono::steady_clock::now();
+	const auto stop = start + writer_deferral;
+	// REWINDBOX_PPU_GRACE_664: a deferral that began with no waiter starving is the window's.
+	const bool window_only = !seen;
+	bool slept = false;
+	bool windowed = false;
+
+	for (auto now = start; now < stop; now = std::chrono::steady_clock::now())
+	{
+		const std::int64_t now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(now.time_since_epoch()).count();
+		const bool in_grace = grace > now_ns && grace > own;
+
+		if (!seen && !in_grace)
+		{
+			break;
+		}
+
+		windowed |= !seen;
+
+		if (now - start < writer_spin)
+		{
+			relax();
+		}
+		else
+		{
+			// CELL579_GATE_SLEEP: leave the core to the starving waiter. A change of
+			// `starving` between the load and the sleep makes the sleep return at once.
+			// REWINDBOX_PPU_GRACE_664: with no waiter starving, sleep to the window's end.
+			auto limit = stop;
+			if (!seen)
+			{
+				limit = std::min(stop, std::chrono::steady_clock::time_point(std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::nanoseconds(grace))));
+			}
+
+			sleepers.fetch_add(1, std::memory_order_seq_cst);
+			sleep_while(starving, seen, limit - now);
+			sleepers.fetch_sub(1, std::memory_order_seq_cst);
+			slept = true;
+		}
+
+		seen = starving.load(std::memory_order_acquire);
+		grace = grace_until.load(std::memory_order_acquire);
+	}
+
+	// CELL579_GATE_SLEEP: pass the last starving waiter's wake-up on to the next
+	// sleeping writer. REWINDBOX_PPU_GRACE_664: when this writer leaves, not after
+	// each sleep: during a window the woken writer would only sleep again and wake
+	// the next one, until the window ends. A writer that waited for a window wakes
+	// every writer still asleep, so they leave together instead of one by one.
+	if (slept && !starving.load(std::memory_order_seq_cst) && sleepers.load(std::memory_order_seq_cst))
+	{
+		if (windowed)
+		{
+			wake_all(starving);
+		}
+		else
+		{
+			wake_one(starving);
+		}
+	}
+
+	if (window_only)
+	{
+		grace_deferrals.fetch_add(1, std::memory_order_relaxed);
+		grace_deferred_ns.fetch_add(static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count()), std::memory_order_relaxed);
+	}
+
+	return true;
+}
+}
diff --git a/rpcs3/ios/IOSPipelineQueue.h b/rpcs3/ios/IOSPipelineQueue.h
new file mode 100644
index 0000000..9772d6e
--- /dev/null
+++ b/rpcs3/ios/IOSPipelineQueue.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_PIPELINE_QUEUE_621: the graphics pipeline compile queue per profiler
+// window (COREPROF PIPEQUEUE621): jobs queued and built, the deepest queue,
+// the longest time a job waited before a compiler thread took it, the longest
+// build, and the draws the renderer skipped because their program was not
+// ready (VKDraw.cpp, asynchronous shader modes only: the synchronous modes
+// build inline and never skip). It sits beside the LLVM admission (JITMEM,
+// WAITPROF527 llvm_*) and the SPU busy waits (SPUWAIT551 getllar_poll,
+// PRESSURE547 spu_passive_waits), which have their own lines.
+namespace rpcs3::ios::pipeline_queue
+{
+struct counters
+{
+	std::atomic<std::uint64_t> queued{0}, completed{0}, skipped_draws{0};
+	std::atomic<std::uint64_t> depth_peak{0};
+	std::atomic<std::uint64_t> wait_total_tsc{0}, wait_max_tsc{0}, build_total_tsc{0}, build_max_tsc{0};
+};
+
+inline counters& stats() noexcept
+{
+	static counters s_counters;
+	return s_counters;
+}
+
+inline void raise(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+{
+	std::uint64_t current = value.load(std::memory_order_relaxed);
+	while (candidate > current && !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {}
+}
+
+inline void on_queued(std::uint32_t pending) noexcept
+{
+	stats().queued.fetch_add(1, std::memory_order_relaxed);
+	raise(stats().depth_peak, pending);
+}
+
+inline void on_completed(std::uint64_t wait_tsc, std::uint64_t build_tsc) noexcept
+{
+	auto& s = stats();
+	s.completed.fetch_add(1, std::memory_order_relaxed);
+	s.wait_total_tsc.fetch_add(wait_tsc, std::memory_order_relaxed);
+	s.build_total_tsc.fetch_add(build_tsc, std::memory_order_relaxed);
+	raise(s.wait_max_tsc, wait_tsc);
+	raise(s.build_max_tsc, build_tsc);
+}
+
+inline void on_skipped_draw() noexcept
+{
+	stats().skipped_draws.fetch_add(1, std::memory_order_relaxed);
+}
+
+struct window
+{
+	std::uint64_t queued = 0, completed = 0, skipped_draws = 0, depth_peak = 0;
+	std::uint64_t wait_total_tsc = 0, wait_max_tsc = 0, build_total_tsc = 0, build_max_tsc = 0;
+};
+
+inline window take() noexcept
+{
+	auto& s = stats();
+	window w;
+	w.queued = s.queued.exchange(0, std::memory_order_relaxed);
+	w.completed = s.completed.exchange(0, std::memory_order_relaxed);
+	w.skipped_draws = s.skipped_draws.exchange(0, std::memory_order_relaxed);
+	w.depth_peak = s.depth_peak.exchange(0, std::memory_order_relaxed);
+	w.wait_total_tsc = s.wait_total_tsc.exchange(0, std::memory_order_relaxed);
+	w.wait_max_tsc = s.wait_max_tsc.exchange(0, std::memory_order_relaxed);
+	w.build_total_tsc = s.build_total_tsc.exchange(0, std::memory_order_relaxed);
+	w.build_max_tsc = s.build_max_tsc.exchange(0, std::memory_order_relaxed);
+	return w;
+}
+}
diff --git a/rpcs3/ios/IOSReadbackPrediction.h b/rpcs3/ios/IOSReadbackPrediction.h
new file mode 100644
index 0000000..0246ac0
--- /dev/null
+++ b/rpcs3/ios/IOSReadbackPrediction.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_READBACK_PREDICTION_638: whether a guest read of a written-back surface found its data
+// already copied by the upstream speculative readback (texture_cache_predictor.h) or paid the copy at
+// fault time. Build 622 God of War III: READBACK555 fault_read 132 sections of 3.69 MB per 5 s window,
+// 554 ms. READBACK555 counts only the sections still unsynchronized at the read, so it cannot say
+// whether speculation never fired for them, fired and was wasted, or was capped. Five process-wide
+// counters, read once per window; no behavior, ordering or cache decision changes.
+namespace rpcs3::ios::readback::prediction
+{
+inline std::atomic<std::uint64_t> flushes{0};            // sections written back to guest memory
+inline std::atomic<std::uint64_t> speculative_copies{0}; // copies recorded ahead of a predicted read
+inline std::atomic<std::uint64_t> flushes_after_speculation{0}; // write-backs of a section whose upstream speculation flag is set (it survives a later write)
+inline std::atomic<std::uint64_t> mispredictions{0};     // a speculative copy overwritten before any read
+inline std::atomic<std::uint64_t> misses{0};             // a read that recorded its copy at fault time
+
+struct sample
+{
+	std::uint64_t flushes = 0, speculative_copies = 0, flushes_after_speculation = 0, mispredictions = 0, misses = 0;
+};
+
+inline void count(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline sample take() noexcept
+{
+	return {flushes.exchange(0, std::memory_order_relaxed), speculative_copies.exchange(0, std::memory_order_relaxed),
+		flushes_after_speculation.exchange(0, std::memory_order_relaxed), mispredictions.exchange(0, std::memory_order_relaxed),
+		misses.exchange(0, std::memory_order_relaxed)};
+}
+}
diff --git a/rpcs3/ios/IOSReadbackProfile.h b/rpcs3/ios/IOSReadbackProfile.h
new file mode 100644
index 0000000..2fa0e35
--- /dev/null
+++ b/rpcs3/ios/IOSReadbackProfile.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include "util/tsc.hpp"
+
+// CELL555: identify synchronous GPU-to-guest transfers without recording guest
+// addresses or changing their ordering. Five fixed counters; two clock reads
+// only for a nonempty DMA batch, never for an ordinary draw/cache hit.
+namespace rpcs3::ios::readback
+{
+// CELL560: framebuffer commits and guest CPU faults are named (appended, the
+// 555 field order is unchanged).
+enum class Origin : unsigned
+{
+    unknown, texture_cpu, blit_source_cpu, blit_destination_dma, presentation_cpu,
+    fbo_commit, fault_read, fault_write, count
+};
+inline constexpr unsigned origin_count = static_cast<unsigned>(Origin::count);
+inline constexpr std::array<const char*, origin_count> names{
+    "unknown", "texture_cpu", "blit_source_cpu", "blit_destination_dma", "presentation_cpu",
+    "fbo_commit", "fault_read", "fault_write"};
+inline thread_local Origin current_origin = Origin::unknown;
+
+class OriginScope final
+{
+    Origin previous_;
+public:
+    explicit OriginScope(Origin value) noexcept : previous_(current_origin) { current_origin = value; }
+    ~OriginScope() noexcept { current_origin = previous_; }
+    OriginScope(const OriginScope&) = delete;
+    OriginScope& operator=(const OriginScope&) = delete;
+};
+
+struct Counter
+{
+    diagnostics::EventCost duration_ticks;
+    std::atomic<std::uint64_t> sections{0}, confirmed_bytes{0};
+    struct Sample
+    {
+        diagnostics::EventCost::Sample duration_ticks;
+        std::uint64_t sections = 0, confirmed_bytes = 0;
+    };
+    Sample take() noexcept
+    {
+        return {duration_ticks.take(), sections.exchange(0, std::memory_order_relaxed),
+            confirmed_bytes.exchange(0, std::memory_order_relaxed)};
+    }
+};
+inline std::array<Counter, origin_count> counters{};
+
+class BatchScope final
+{
+    unsigned origin_;
+    std::uint64_t sections_, bytes_, begin_;
+public:
+    BatchScope(std::uint64_t sections, std::uint64_t confirmed_bytes) noexcept
+        : origin_(static_cast<unsigned>(current_origin)), sections_(sections), bytes_(confirmed_bytes),
+          begin_(sections ? utils::get_tsc() : 0)
+    {
+        if (origin_ >= origin_count) origin_ = 0;
+    }
+    ~BatchScope() noexcept
+    {
+        if (!sections_) return;
+        const auto end = utils::get_tsc();
+        auto& counter = counters[origin_];
+        counter.sections.fetch_add(sections_, std::memory_order_relaxed);
+        counter.confirmed_bytes.fetch_add(bytes_, std::memory_order_relaxed);
+        counter.duration_ticks.record(end >= begin_ ? end - begin_ : 0);
+    }
+    BatchScope(const BatchScope&) = delete;
+    BatchScope& operator=(const BatchScope&) = delete;
+};
+
+inline auto take() noexcept
+{
+    std::array<Counter::Sample, origin_count> result{};
+    for (unsigned i = 0; i < origin_count; ++i) result[i] = counters[i].take();
+    return result;
+}
+}
diff --git a/rpcs3/ios/IOSRecyclableImagePool.h b/rpcs3/ios/IOSRecyclableImagePool.h
new file mode 100644
index 0000000..65d78d3
--- /dev/null
+++ b/rpcs3/ios/IOSRecyclableImagePool.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdlib>
+#include <cstdint>
+#include <utility>
+#include <memory>
+
+
+namespace rpcs3::ios::recyclable_image_pool
+{
+// Preserve the pre-existing iOS recycling thresholds; these are neither an
+// active-texture budget nor a change to NeoSwap/driver allocation admission.
+inline constexpr std::uint64_t byte_limit = 256ull * 1024 * 1024;
+inline constexpr std::size_t item_limit = 256;
+
+// At most item_limit entries can be in a newly constructed iOS pool. Only
+// their already-retired unique_ptrs are detached here. A raw-pointer RAII
+// batch avoids allocating during memory pressure; unwritten slots are never
+// initialized, read or deleted. Its count-only common path does no heap work.
+template <typename Image>
+class retirement_batch
+{
+    std::array<Image*, item_limit> images;
+    std::size_t count = 0;
+public:
+    retirement_batch() noexcept = default;
+    retirement_batch(const retirement_batch&) = delete;
+    retirement_batch& operator=(const retirement_batch&) = delete;
+    ~retirement_batch() { clear(); }
+    void emplace_back(std::unique_ptr<Image>&& image) noexcept
+    {
+        if (count == images.size()) std::abort(); // broken pool invariant
+        images[count++] = image.release();
+    }
+    void clear() noexcept
+    {
+        while (count) delete images[--count];
+    }
+};
+
+// Caller owns the existing pool mutex. Entries are newest-first and have
+// already retired from the GPU. A caller-owned retirement batch keeps image
+// destruction out of the pool critical section. The bounded batch never allocates; no per-frame historical walk is needed.
+// incoming_bytes <= byte_limit is the caller's admission precondition.
+template <typename Pool, typename ByteCount, typename Retired>
+void trim_to_fit(Pool& pool, ByteCount& bytes, Retired& retired,
+    std::uint64_t incoming_bytes = 0, bool incoming_item = false)
+{
+    const auto allowed_bytes = byte_limit - incoming_bytes;
+    const auto allowed_items = item_limit - static_cast<std::size_t>(incoming_item);
+    while (!pool.empty() && (pool.size() > allowed_items ||
+        static_cast<std::uint64_t>(bytes) > allowed_bytes))
+    {
+        auto& oldest = pool.back();
+        const auto released_bytes = oldest.data->memory->size();
+        retired.emplace_back(std::move(oldest.data));
+        pool.pop_back();
+        bytes -= released_bytes;
+    }
+}
+}
diff --git a/rpcs3/ios/IOSRenderPassCensus.h b/rpcs3/ios/IOSRenderPassCensus.h
new file mode 100644
index 0000000..a0001ca
--- /dev/null
+++ b/rpcs3/ios/IOSRenderPassCensus.h
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_RENDERPASS_CENSUS_652: why render passes end. IPA 643 Assassin's Creed (window 18): 51 render passes per
+// frame for 1401 draws. FEEDBACK610 counts the passes the draw path began and TEXCACHE621 the depth feedback barriers
+// (8.7 per frame), but no journal line said which code ended the other passes, nor whether the next pass resumed the
+// same framebuffer (a restart that a barrier or a copy forced) or bound another one (a target switch).
+// vk::end_renderpass records its caller's file and line (a std::source_location default argument: no call site
+// changes); vk::begin_renderpass, when it really begins a pass on a command buffer whose previous pass was ended,
+// attributes that begin to the site of the end, on the same framebuffer or another. The performance reporter prints
+// the totals and the busiest sites once per window (COREPROF RPASS652). The render pass helpers are not thread safe
+// by design (RSX thread); the counters are relaxed atomics only because the reporter thread exchanges them.
+// Counting changes no render pass, barrier, copy or command.
+namespace rpcs3::ios::renderpass_census
+{
+constexpr std::size_t site_capacity = 48;
+
+struct site
+{
+	std::atomic<const char*> file{nullptr};
+	std::atomic<std::uint32_t> line{0};
+	std::atomic<std::uint64_t> ends{0};         // passes this site ended
+	std::atomic<std::uint64_t> same_target{0};  // begins that followed an end here on the same framebuffer
+	std::atomic<std::uint64_t> other_target{0}; // begins that followed an end here on another framebuffer
+};
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> begins{0};       // passes vk::begin_renderpass really began
+	std::atomic<std::uint64_t> fresh{0};        // of which nothing had ended before on that command buffer
+	std::atomic<std::uint64_t> same_target{0};  // of which the previous pass ended on the same framebuffer
+	std::atomic<std::uint64_t> other_target{0}; // of which the previous pass ended on another framebuffer
+	std::atomic<std::uint64_t> overflow{0};     // ends of a site that found no free slot
+	std::array<site, site_capacity> sites{};
+};
+
+inline window_counters counters{};
+
+// REWINDBOX_PASS_SHAPE_910: Black Ops II, build 694 device log (Core 907), gameplay window 41 at 21.7 fps: the GPU
+// executes 35.8 ms per frame and is active over 46 of the frame's 52 ms (queue delay up to 26 ms), the RSX thread
+// waits for nothing and the PPU threads use 0.40 core: the frame is GPU-bound. 49 render passes begin per frame, 15
+// of them on the framebuffer the previous one ended on; every restart stores and reloads every attachment on the
+// Apple GPU. RPASS652 names the code that ended a pass; it does not say whether the pass had drawn anything. A pass
+// that ended without a draw, then began again on the same framebuffer, loaded and stored its attachments for nothing:
+// its begin can be deferred to the first draw. Counted per window (COREPROF RPASS652 ended_empty= ended_short=
+// same_target_after_empty=); decision: deferral of the begin if same_target_after_empty is a large share of same_target.
+struct shape_counters
+{
+	std::atomic<std::uint64_t> ended_empty{0};             // passes ended with no draw recorded in them
+	std::atomic<std::uint64_t> ended_short{0};             // passes ended with 1 to 3 draws
+	std::atomic<std::uint64_t> same_target_after_empty{0}; // begins on the framebuffer a pass without a draw ended on
+};
+inline shape_counters shape{};
+// Draws recorded since the last begin (RSX thread; relaxed atomic for the helpers' other callers).
+inline std::atomic<std::uint32_t> draws_in_pass{0};
+
+inline void note_draw() noexcept
+{
+	draws_in_pass.store(draws_in_pass.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+// Slot of a call site (single writer). A std::source_location file name is a string literal of its translation unit,
+// stable for the life of the program. -1 when the table is full.
+inline int slot(const char* file, std::uint32_t line) noexcept
+{
+	for (std::size_t index = 0; index < site_capacity; index++)
+	{
+		auto& entry = counters.sites[index];
+		const char* known = entry.file.load(std::memory_order_acquire);
+		if (known == nullptr)
+		{
+			entry.line.store(line, std::memory_order_relaxed);
+			entry.file.store(file, std::memory_order_release);
+			return static_cast<int>(index);
+		}
+		if (known == file && entry.line.load(std::memory_order_relaxed) == line)
+		{
+			return static_cast<int>(index);
+		}
+	}
+	return -1;
+}
+
+// The previous end on one command buffer: its framebuffer and site.
+struct last_end
+{
+	const void* framebuffer = nullptr;
+	int site = -1;
+	bool valid = false;
+	bool empty = false; // REWINDBOX_PASS_SHAPE_910: the ended pass had no draw
+};
+
+inline void on_end(last_end& previous, const void* framebuffer, const char* file, std::uint32_t line) noexcept
+{
+	const int index = slot(file, line);
+	add(index >= 0 ? counters.sites[index].ends : counters.overflow);
+	const std::uint32_t draws = draws_in_pass.exchange(0, std::memory_order_relaxed);
+	if (draws == 0)
+	{
+		add(shape.ended_empty);
+	}
+	else if (draws <= 3)
+	{
+		add(shape.ended_short);
+	}
+	previous = { framebuffer, index, true, draws == 0 };
+}
+
+inline void on_begin(last_end& previous, const void* framebuffer) noexcept
+{
+	add(counters.begins);
+	draws_in_pass.store(0, std::memory_order_relaxed);
+	if (previous.valid && previous.empty && previous.framebuffer == framebuffer)
+	{
+		add(shape.same_target_after_empty);
+	}
+	if (!previous.valid)
+	{
+		add(counters.fresh);
+		return;
+	}
+
+	const bool same = previous.framebuffer == framebuffer;
+	add(same ? counters.same_target : counters.other_target);
+	if (previous.site >= 0)
+	{
+		add(same ? counters.sites[previous.site].same_target : counters.sites[previous.site].other_target);
+	}
+	previous.valid = false;
+}
+}
diff --git a/rpcs3/ios/IOSRendererCausality.h b/rpcs3/ios/IOSRendererCausality.h
new file mode 100644
index 0000000..0ec4dd8
--- /dev/null
+++ b/rpcs3/ios/IOSRendererCausality.h
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+// Bounded observations of corrected renderer decisions. No guest-memory reads,
+// driver calls, allocations or logging. The RSX producer never waits for the
+// reporting thread. Counts include events rejected at capacity; contention is
+// separately counted because its kind/reasons could not be safely attributed.
+namespace rpcs3::ios::renderer_causality
+{
+enum class Kind : std::uint32_t { vertex_range, sampler_refresh, sampler_cyclic_fast, count };
+enum Reason : std::uint32_t
+{
+    source_range = 1u << 0,
+    validity = 1u << 1,
+    coordinates = 1u << 2,
+    clamp = 1u << 3,
+    dimension = 1u << 4,
+    samples = 1u << 5,
+    format = 1u << 6,
+    cyclic = 1u << 7,
+};
+inline constexpr std::size_t reason_count = 8;
+inline constexpr std::size_t event_capacity = 8;
+// Reserve observations for both defects even when one dominates a window.
+inline constexpr std::array<std::size_t, 3> event_budgets{2, 4, 2};
+
+struct SamplerState
+{
+    // Bit patterns of scale[3], bias[3], active clamp_min[2]/clamp_max[2].
+    // Inactive clamp values are zero; no uninitialized descriptor bytes are read.
+    std::array<std::uint32_t, 10> coordinates{};
+    std::uint32_t dimension = 0, format_class = 0, format_features = 0, texel_remap_control = 0;
+    std::uint8_t samples = 1;
+    bool cyclic = false, clamp = false, valid = false;
+
+    template <typename State>
+    static SamplerState from(const State& state) noexcept
+    {
+        return {state.coordinates, state.dimension, state.format_class,
+            state.format_features, state.texel_remap_control, state.samples,
+            state.cyclic, state.clamp, state.valid};
+    }
+};
+
+template <typename State>
+inline std::uint32_t changed_reasons(const State& before, const State& after, bool vertex) noexcept
+{
+    if (before.valid != after.valid) return validity;
+    if (!before.valid) return 0;
+    std::uint32_t result = 0;
+    if (before.dimension != after.dimension) result |= dimension;
+    if (before.format_class != after.format_class) result |= format;
+    if (before.samples != after.samples) result |= samples;
+    if (vertex) return result;
+    if (before.cyclic != after.cyclic) result |= cyclic;
+    for (std::size_t i = 0; i < 6; ++i)
+        if (before.coordinates[i] != after.coordinates[i]) result |= coordinates;
+    if (before.clamp != after.clamp) result |= clamp;
+    if (before.clamp && after.clamp)
+        for (std::size_t i = 6; i < before.coordinates.size(); ++i)
+            if (before.coordinates[i] != after.coordinates[i]) result |= clamp;
+    if (before.format_features != after.format_features ||
+        before.texel_remap_control != after.texel_remap_control) result |= format;
+    return result;
+}
+
+struct Event
+{
+    std::uint64_t session = 0, monotonic_us = 0, frame = 0;
+    Kind kind{};
+    std::uint32_t reasons = 0, draw = 0, fragment_offset = 0, vertex_start = 0;
+    std::uint32_t slot = 0, old_resource = 0, new_resource = 0;
+    bool vertex = false;
+    // vertex_range describes differing cache keys, not proven visible corruption.
+    std::uint32_t legacy_address = 0, actual_address = 0, bytes = 0;
+    std::uint32_t draw_first = 0, source_first = 0, count = 0, stride = 0;
+    bool cache_hit = false;
+    SamplerState before{}, after{};
+};
+
+class Profile final
+{
+    std::mutex mutex_;
+    std::uint64_t session_ = 0;
+    std::array<Event, event_capacity> events_{};
+    std::size_t size_ = 0;
+    std::array<std::uint64_t, static_cast<std::size_t>(Kind::count)> counts_{};
+    std::array<std::size_t, static_cast<std::size_t>(Kind::count)> kept_{};
+    std::array<std::uint64_t, reason_count> reasons_{};
+    std::uint64_t full_dropped_ = 0;
+    std::atomic<std::uint64_t> contended_{0};
+
+public:
+    struct Snapshot
+    {
+        bool captured = false;
+        std::uint64_t session = 0;
+        std::array<Event, event_capacity> events{};
+        std::size_t size = 0;
+        std::array<std::uint64_t, static_cast<std::size_t>(Kind::count)> counts{};
+        std::array<std::uint64_t, reason_count> reasons{};
+        std::uint64_t dropped = 0, contended = 0;
+    };
+
+    template <typename Fill>
+    bool record(Kind kind, std::uint32_t reasons, Fill&& fill) noexcept
+    {
+        reasons &= (1u << reason_count) - 1;
+        if (!reasons || kind >= Kind::count) return false;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock)
+        {
+            contended_.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        if (!session_) return false;
+        const auto index = static_cast<std::size_t>(kind);
+        ++counts_[index];
+        for (std::size_t bit = 0; bit < reason_count; ++bit)
+            reasons_[bit] += bool(reasons & (1u << bit));
+        if (size_ == events_.size() || kept_[index] == event_budgets[index])
+        {
+            ++full_dropped_;
+            return false;
+        }
+        auto& event = events_[size_++];
+        ++kept_[index];
+        event = {};
+        event.session = session_;
+        event.kind = kind;
+        event.reasons = reasons;
+        // Only retained events pay for a clock read or the caller's context copy.
+        event.monotonic_us = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+        fill(event);
+        return true;
+    }
+
+    // Called from the profiler's session reset, outside the RSX hot path.
+    // All retained events and attributed counts are cleared together. A
+    // concurrent rejected attempt can straddle the reset only in contended.
+    void reset(std::uint64_t session) noexcept
+    {
+        std::lock_guard lock(mutex_);
+        session_ = session;
+        size_ = 0;
+        counts_ = {};
+        kept_ = {};
+        reasons_ = {};
+        full_dropped_ = 0;
+        contended_.store(0, std::memory_order_relaxed);
+    }
+
+    Snapshot take() noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return {};
+        Snapshot result;
+        result.captured = true;
+        result.session = session_;
+        result.events = events_;
+        result.size = size_;
+        result.counts = counts_;
+        result.reasons = reasons_;
+        result.contended = contended_.exchange(0, std::memory_order_relaxed);
+        result.dropped = full_dropped_ + result.contended;
+        size_ = 0;
+        counts_ = {};
+        kept_ = {};
+        reasons_ = {};
+        full_dropped_ = 0;
+        return result;
+    }
+};
+inline constinit Profile profile;
+}
