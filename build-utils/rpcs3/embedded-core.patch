+		if (utils::has_sve())
+			result.push_back("+sve");
+		else
+			result.push_back("-sve");
+
+		if (utils::has_sve2())
+			result.push_back("+sve2");
+		else
+			result.push_back("-sve2");
+#endif
+
+		return result;
+	}();
+
+	return attributes;
+}
