+	RBX_METAL4 object compile_library(const object& compiler, std::string_view source, const library_options& options, std::string& error)
+	{
+		@autoreleasepool
+		{
+			MTLCompileOptions* compile = [[MTLCompileOptions alloc] init];
+			if (options.fast_math)
+			{
+				// MoltenVK's choice for SPIR-V without float controls (MVKDevice::getMTLCompileOptions).
+				compile.mathMode = MTLMathModeFast;
+				compile.mathFloatingPointFunctions = MTLMathFloatingPointFunctionsFast;
+			}
+			else
+			{
+				compile.mathMode = MTLMathModeSafe;
+				compile.mathFloatingPointFunctions = MTLMathFloatingPointFunctionsPrecise;
+			}
+			compile.preserveInvariance = options.preserve_invariance;
+
+			MTL4LibraryDescriptor* desc = [[MTL4LibraryDescriptor alloc] init];
+			desc.source = string(source);
+			desc.options = compile;
+			NSError* failure = nil;
+			const id<MTLLibrary> library = [as<id<MTL4Compiler>>(compiler) newLibraryWithDescriptor:desc error:&failure];
+			if (!library)
+			{
+				error = describe(failure);
+			}
+			return keep(library);
+		}
+	}
+
+	RBX_METAL4 object compile_library(const object& compiler, std::string_view source, std::string& error)
+	{
+		// The presentation pass: safe math.
+		return compile_library(compiler, source, library_options{}, error);
+	}
+
+	RBX_METAL4 object new_render_pipeline(const object& compiler, const render_pipeline_descriptor& descriptor, std::string& error)
+	{
+		@autoreleasepool
+		{
+			const auto function = [&](const object& library, const std::string& name) -> MTL4LibraryFunctionDescriptor*
+			{
+				if (name.empty())
+				{
+					return nil;
+				}
+
+				MTL4LibraryFunctionDescriptor* result = [[MTL4LibraryFunctionDescriptor alloc] init];
+				result.library = as<id<MTLLibrary>>(library);
+				result.name = string(name);
+				return result;
+			};
+
+			const object& vertex_library = descriptor.vertex_library ? descriptor.vertex_library : descriptor.library;
+			const object& fragment_library = descriptor.fragment_library ? descriptor.fragment_library : descriptor.library;
+
+			MTL4RenderPipelineDescriptor* desc = [[MTL4RenderPipelineDescriptor alloc] init];
+			desc.vertexFunctionDescriptor = function(vertex_library, descriptor.vertex_function);
+			desc.fragmentFunctionDescriptor = function(fragment_library, descriptor.fragment_function);
+			for (u32 index = 0; index < descriptor.color.size(); ++index)
+			{
+				const color_attachment_state& state = descriptor.color[index];
+				MTL4RenderPipelineColorAttachmentDescriptor* color = desc.colorAttachments[index];
+				color.pixelFormat = static_cast<MTLPixelFormat>(state.format);
+				color.blendingState = state.blending ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+				color.sourceRGBBlendFactor = static_cast<MTLBlendFactor>(state.source_rgb);
+				color.destinationRGBBlendFactor = static_cast<MTLBlendFactor>(state.destination_rgb);
+				color.rgbBlendOperation = static_cast<MTLBlendOperation>(state.rgb_operation);
+				color.sourceAlphaBlendFactor = static_cast<MTLBlendFactor>(state.source_alpha);
+				color.destinationAlphaBlendFactor = static_cast<MTLBlendFactor>(state.destination_alpha);
+				color.alphaBlendOperation = static_cast<MTLBlendOperation>(state.alpha_operation);
+				color.writeMask = static_cast<MTLColorWriteMask>(state.write_mask);
+			}
+			desc.rasterSampleCount = descriptor.sample_count;
+			desc.alphaToCoverageState = descriptor.alpha_to_coverage ? MTL4AlphaToCoverageStateEnabled : MTL4AlphaToCoverageStateDisabled;
+			desc.alphaToOneState = descriptor.alpha_to_one ? MTL4AlphaToOneStateEnabled : MTL4AlphaToOneStateDisabled;
+			desc.inputPrimitiveTopology = static_cast<MTLPrimitiveTopologyClass>(descriptor.input_topology);
+			if (!descriptor.label.empty())
+			{
+				desc.label = string(descriptor.label);
+			}
+
+			// M5: the archive is probed for the binary (counted as a hit), then handed to the compiler, which builds
+			// the pipeline from it or compiles it (a miss): either way the compiler's serializer captures it.
+			archive_lookup lookup{ lookup_archive() };
+			if (lookup.archive)
+			{
+				NSError* absent = nil;
+				lookup.hit = [as<id<MTL4Archive>>(lookup.archive) newRenderPipelineStateWithDescriptor:desc error:&absent] != nil;
+			}
+
+			NSError* failure = nil;
+			const capture_guard capture(compiler);
+			const id<MTLRenderPipelineState> pipeline = [as<id<MTL4Compiler>>(capture.compiler) newRenderPipelineStateWithDescriptor:desc
+				compilerTaskOptions:lookup_options(lookup) error:&failure];
+			if (!pipeline)
+			{
+				error = describe(failure);
+			}
+			else
+			{
+				lookup.count();
+			}
+			return keep(pipeline);
+		}
+	}
+
+	object new_depth_stencil_state(const object& device, const depth_stencil_descriptor& descriptor)
+	{
+		@autoreleasepool
+		{
+			MTLDepthStencilDescriptor* desc = [[MTLDepthStencilDescriptor alloc] init];
+			desc.depthCompareFunction = static_cast<MTLCompareFunction>(descriptor.depth_compare);
+			desc.depthWriteEnabled = descriptor.depth_write;
+			if (descriptor.stencil)
+			{
+				const auto stencil = [](const stencil_state& state)
+				{
+					MTLStencilDescriptor* result = [[MTLStencilDescriptor alloc] init];
+					result.stencilCompareFunction = static_cast<MTLCompareFunction>(state.compare);
+					result.stencilFailureOperation = static_cast<MTLStencilOperation>(state.stencil_fail);
+					result.depthFailureOperation = static_cast<MTLStencilOperation>(state.depth_fail);
+					result.depthStencilPassOperation = static_cast<MTLStencilOperation>(state.depth_stencil_pass);
+					result.readMask = state.read_mask;
+					result.writeMask = state.write_mask;
+					return result;
+				};
+				desc.frontFaceStencil = stencil(descriptor.front);
+				desc.backFaceStencil = stencil(descriptor.back);
+			}
+			return keep([as<id<MTLDevice>>(device) newDepthStencilStateWithDescriptor:desc]);
+		}
+	}
+
+	RBX_METAL4 object begin_render_pass(const object& command_buffer, const render_pass_descriptor& descriptor, std::string_view label)
+	{
+		@autoreleasepool
+		{
+			MTL4RenderPassDescriptor* desc = [[MTL4RenderPassDescriptor alloc] init];
+			for (u32 index = 0; index < descriptor.color.size(); ++index)
+			{
+				const render_pass_color_attachment& source = descriptor.color[index];
+				if (!source.texture)
+				{
+					continue;
+				}
+
+				MTLRenderPassColorAttachmentDescriptor* color = desc.colorAttachments[index];
+				color.texture = as<id<MTLTexture>>(source.texture);
+				color.level = source.level;
+				color.slice = source.slice;
+				color.depthPlane = source.depth_plane;
+				color.resolveTexture = as<id<MTLTexture>>(source.resolve_texture);
+				color.loadAction = static_cast<MTLLoadAction>(source.load);
+				color.storeAction = static_cast<MTLStoreAction>(source.store);
+				color.clearColor = MTLClearColorMake(source.clear.red, source.clear.green, source.clear.blue, source.clear.alpha);
+			}
+
+			if (descriptor.depth.texture)
+			{
+				desc.depthAttachment.texture = as<id<MTLTexture>>(descriptor.depth.texture);
+				desc.depthAttachment.level = descriptor.depth.level;
+				desc.depthAttachment.slice = descriptor.depth.slice;
+				desc.depthAttachment.loadAction = static_cast<MTLLoadAction>(descriptor.depth.load);
+				desc.depthAttachment.storeAction = static_cast<MTLStoreAction>(descriptor.depth.store);
+				desc.depthAttachment.clearDepth = descriptor.depth.clear_depth;
+			}
+
+			if (descriptor.stencil.texture)
+			{
+				desc.stencilAttachment.texture = as<id<MTLTexture>>(descriptor.stencil.texture);
+				desc.stencilAttachment.level = descriptor.stencil.level;
+				desc.stencilAttachment.slice = descriptor.stencil.slice;
+				desc.stencilAttachment.loadAction = static_cast<MTLLoadAction>(descriptor.stencil.load);
+				desc.stencilAttachment.storeAction = static_cast<MTLStoreAction>(descriptor.stencil.store);
+				desc.stencilAttachment.clearStencil = descriptor.stencil.clear_stencil;
+			}
+
+			desc.visibilityResultBuffer = as<id<MTLBuffer>>(descriptor.visibility_result_buffer);
+			if (descriptor.visibility_accumulate)
+			{
+				// M4: occlusion query slots are zeroed by the CPU before use and each holds one query segment.
+				desc.visibilityResultType = MTLVisibilityResultTypeAccumulate;
+			}
+			if (descriptor.render_target_width && descriptor.render_target_height)
+			{
+				desc.renderTargetWidth = descriptor.render_target_width;
+				desc.renderTargetHeight = descriptor.render_target_height;
+			}
+			if (descriptor.default_raster_sample_count)
+			{
+				desc.defaultRasterSampleCount = descriptor.default_raster_sample_count;
+			}
+
+			const id<MTL4RenderCommandEncoder> encoder = [as<id<MTL4CommandBuffer>>(command_buffer) renderCommandEncoderWithDescriptor:desc];
+			if (encoder && !label.empty())
+			{
+				encoder.label = string(label);
+			}
+			return keep(encoder);
+		}
+	}
