+	atomic_t<bool> m_samplers_dirty = { true };
+	std::unordered_map<mtl::sampler_key, mtl::object, mtl::sampler_key_hash> m_sampler_pool;
+	std::array<mtl::sampler_key, rsx::limits::fragment_textures_count> m_fs_sampler_keys{};
+	std::array<mtl::object, rsx::limits::fragment_textures_count> m_fs_sampler_handles;
+	std::array<mtl::sampler_key, rsx::limits::vertex_textures_count> m_vs_sampler_keys{};
+	std::array<mtl::object, rsx::limits::vertex_textures_count> m_vs_sampler_handles;
+
