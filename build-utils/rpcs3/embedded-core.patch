@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+
+#include <atomic>
+#include <cstdint>
+#include <string_view>
+
+// CELL560_DEFERRED_COMMIT: with Write Color Buffers off, binding a region as a
+// framebuffer writes a GPU-resident section starting at that address back to
+// guest memory before releasing its pages: the RSX thread submits, waits for
+// the GPU and copies. The GPU copy is recorded at the same point; the wait and
+// the copy to guest memory happen when an access needs the bytes. The pages
+// stay locked until then, so guest code cannot observe the difference; a
+// section rewritten by the GPU before any access never needs the bytes.
+namespace rpcs3::ios::deferred_commit
+{
+inline std::atomic<bool> enabled{false};
+
+inline std::atomic<std::uint64_t> deferrals{0}, deferral_bytes{0};
+// Write-backs of deferred bytes; the forced ones release pages without a flush request.
+inline diagnostics::EventCost writeback_ticks;
+inline std::atomic<std::uint64_t> writeback_bytes{0}, forced_writebacks{0};
+inline std::atomic<std::uint64_t> dropped{0}, dropped_bytes{0};
+inline std::atomic<std::uint64_t> submits{0};
+
+constexpr bool is_dbz_budokai_hd_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES01658";
+}
+}
diff --git a/rpcs3/ios/IOSEarlySubmit.h b/rpcs3/ios/IOSEarlySubmit.h
new file mode 100644
index 0000000..aab252c
--- /dev/null
+++ b/rpcs3/ios/IOSEarlySubmit.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// CELL561_EARLY_SUBMIT: the RSX thread records the draws of a frame into one
+// command buffer and submits it at the flip, or when a guest access to memory
+// the GPU wrote asks for a flush. A title that reads a render target back every
+// frame then waits, from that access, for the GPU to execute everything the
+// frame recorded. When the GPU has completed every command buffer already
+// submitted, the draws recorded since then are submitted at the end of a draw,
+// so the GPU renders while the RSX thread keeps recording. The commands, their
+// order and their synchronization are unchanged; only command buffer
+// boundaries move, at the point a flush request already uses. A GPU that is
+// still busy never sees an early submission.
+namespace rpcs3::ios::early_submit
+{
+inline std::atomic<bool> enabled{false};
+
+// An early submission carries at least this many draws; a frame has at most this many.
+constexpr std::uint32_t min_draws = 32;
+constexpr std::uint32_t max_per_frame = 6;
+
+inline std::atomic<std::uint64_t> submits{0}, submitted_draws{0}, gpu_busy{0}, frame_capped{0};
+
+enum class verdict : std::uint8_t
+{
+	keep,      // fewer than min_draws recorded, or disabled
+	gpu_busy,  // the last submission has not completed: the GPU has work
+	capped,    // this frame already used max_per_frame early submissions
+	submit,
+};
+
+// draws: recorded since the last primary submission; this_frame: early
+// submissions since the last flip; gpu_idle: the last primary submission completed.
+constexpr verdict decide(bool on, std::uint32_t draws, std::uint32_t this_frame, bool gpu_idle) noexcept
+{
+	if (!on || draws < min_draws)
+	{
+		return verdict::keep;
+	}
+
+	if (this_frame >= max_per_frame)
+	{
+		return verdict::capped;
+	}
+
+	return gpu_idle ? verdict::submit : verdict::gpu_busy;
+}
+
+// REWINDBOX_EARLY_SUBMIT_BOUNDARY_659: at the end of a draw the render pass of
+// that draw is still open, and a submission there ends it: the next draw on the
+// same framebuffer stores and reloads every attachment again (a tile flush on
+// the Apple GPU). Assassin's Creed begins about 44 passes per frame (RPASS652),
+// so in the boundary mode a submission decided at the end of a draw is armed
+// and taken where no pass is open anyway: at the start of a later draw, or once
+// that draw's textures are prepared, when their transitions or copies ended the
+// pass. An armed submission that meets no such point is taken at the end of the
+// draw after max_deferred_draws more draws, as before. Any other primary
+// submission (flip, flush request, ZCULL sync hint) carries the armed draws and
+// disarms it. Commands, their order and their synchronization are unchanged;
+// only the boundary moves.
+inline std::atomic<bool> at_pass_boundary{false};
+
+// 32 draws: in a host model of these frames (5.9 us of recording and 20 us of GPU per draw), a window of
+// 16 to 64 draws costs at most 0.3 ms per frame against the end-of-draw submission when a split pass
+// costs 0.1 ms, and saves 0.5 to 1.5 ms when it costs 0.5 ms; 32 halves the passes split by early
+// submissions there (7.0 to 4.0 per frame).
+constexpr std::uint32_t max_deferred_draws = 32;
+
+// armed: submissions armed at an open pass; boundary_starts / boundary_textures: taken at
+// the start of a draw / after its textures; fallback_submits: taken at the end of a draw
+// after max_deferred_draws more draws; disarmed: carried by another primary submission.
+inline std::atomic<std::uint64_t> armed{0}, boundary_starts{0}, boundary_textures{0}, fallback_submits{0}, disarmed{0};
+
+enum class deferral : std::uint8_t
+{
+	none,      // not armed: decide() applies
+	wait,      // armed: keep looking for a point without an open pass
+	fallback,  // armed for more than max_deferred_draws draws: submit at the end of this draw
+};
+
+// armed_draws: draws ended since the submission was armed, this one included (0: not armed).
+constexpr deferral at_draw_end(std::uint32_t armed_draws) noexcept
+{
+	if (!armed_draws)
+	{
+		return deferral::none;
+	}
+
+	return armed_draws > max_deferred_draws ? deferral::fallback : deferral::wait;
+}
+
+// A submit verdict waits for a pass boundary only in the boundary mode and
+// while a render pass is open; otherwise it is taken at once.
+constexpr bool arm_instead(bool boundary_mode, bool pass_open) noexcept
+{
+	return boundary_mode && pass_open;
+}
+
+// At the start of a draw or after its textures: an armed submission is taken
+// when no render pass is open and the recording can be interrupted.
+constexpr bool take_at_boundary(std::uint32_t armed_draws, bool pass_open, bool interruptible) noexcept
+{
+	return armed_draws && !pass_open && interruptible;
+}
+}
diff --git a/rpcs3/ios/IOSFeedbackCensus.h b/rpcs3/ios/IOSFeedbackCensus.h
new file mode 100644
index 0000000..76f08ec
--- /dev/null
+++ b/rpcs3/ios/IOSFeedbackCensus.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_FEEDBACK_CENSUS_610: counts of the MoltenVK color-feedback work that
+// no existing journal line separates (Assassin's Creed torch passages: the
+// render-pass split and full-surface copy of each snapshot, programmable
+// blending draws, feedback reads the snapshot does not cover). The RSX thread
+// increments them (relaxed) around the unchanged snapshot helper; the
+// performance reporter exchanges them once per window into one COREPROF line.
+// Counting never changes a view, a copy, a barrier or a render pass.
+namespace rpcs3::ios::feedback_census
+{
+struct window_counters
+{
+	std::atomic<std::uint64_t> draw_renderpasses{0};    // render passes VKGSRender::begin_render_pass actually began (census v2)
+	std::atomic<std::uint64_t> snapshot_draws{0};       // draws that took at least one snapshot
+	std::atomic<std::uint64_t> snapshot_copies{0};      // snapshot copies (one per sampler slot)
+	std::atomic<std::uint64_t> duplicate_copies{0};     // same snapshot image copied again in one draw
+	std::atomic<std::uint64_t> snapshot_pixels{0};      // copied surface pixels (width x height)
+	std::atomic<std::uint64_t> pb_draws{0};             // draws with programmable blending
+	std::atomic<std::uint64_t> msaa_feedback_reads{0};  // cyclic MSAA color reads left unsnapshotted
+	std::atomic<std::uint64_t> depth_feedback_reads{0}; // cyclic depth/stencil reads left unsnapshotted
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+}
diff --git a/rpcs3/ios/IOSFrameTrace.h b/rpcs3/ios/IOSFrameTrace.h
new file mode 100644
index 0000000..ab8cea6
--- /dev/null
+++ b/rpcs3/ios/IOSFrameTrace.h
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+// Diagnostic observations only. Nothing in emulation consumes these values.
+// A frame-end record uses the existing sampled stage timers. Wait hooks add
+// owner-thread integers only, with no additional clock read or allocation.
+namespace rpcs3::ios::frame_trace
+{
+inline std::atomic<std::uint64_t> active_session{0};
+
+struct Waits
+{
+    std::uint64_t fence_ticks = 0, submit_ticks = 0, drawable_ticks = 0, present_ticks = 0;
+    std::uint64_t semaphore_us = 0, pipeline_us = 0;
+    std::uint64_t skipped_draws = 0; // REWINDBOX_PIPELINE_QUEUE_621: program not ready
+    // REWINDBOX_ZCULL_FRAME_621: waits for occlusion query results on the RSX thread
+    // (vk::query_pool_manager::get_query_result, the ZCULLWAIT616 probe), per frame.
+    std::uint64_t zcull_ticks = 0, zcull_waits = 0;
+};
+inline thread_local Waits thread_waits{};
+inline thread_local std::uint64_t thread_session = 0;
+
+inline Waits& waits() noexcept
+{
+    const auto session = active_session.load(std::memory_order_relaxed);
+    if (thread_session != session)
+    {
+        thread_session = session;
+        thread_waits = {};
+    }
+    return thread_waits;
+}
+
+// REWINDBOX_ZCULL_FRAME_621: GPU waits the RSX thread counts in their own fields (ZCULL
+// results, fences, submits). nv406e::semaphore_acquire takes this before and after its
+// loop and leaves the difference out of semaphore_us, so a wait nested in an acquire
+// (a ZCULL request served from inside the acquire) is not counted twice by explain_frame.
+inline std::uint64_t nested_wait_ticks() noexcept
+{
+    const auto& w = waits();
+    return w.zcull_ticks + w.fence_ticks + w.submit_ticks;
+}
+
+inline Waits take_thread_waits() noexcept
+{
+    auto& pending = waits();
+    const auto result = pending;
+    pending = {};
+    return result;
+}
+
+inline std::uint64_t microseconds(std::uint64_t ticks, std::uint64_t frequency) noexcept
+{
+    if (!frequency) return 0;
+    const auto seconds = ticks / frequency;
+    const auto remainder = ticks % frequency;
+    constexpr auto maximum = std::numeric_limits<std::uint64_t>::max();
+    if (seconds > maximum / 1'000'000) return maximum;
+    const auto fraction = remainder <= maximum / 1'000'000
+        ? remainder * 1'000'000 / frequency
+        : static_cast<std::uint64_t>(static_cast<long double>(remainder) * 1'000'000 / frequency);
+    const auto whole = seconds * 1'000'000;
+    return fraction > maximum - whole ? maximum : whole + fraction;
+}
+
+struct Progress
+{
+    double wall_guest_fps = 0.0, completed_interval_fps = 0.0, last_guest_flip_age_ms = -1.0;
+};
+
+inline Progress progress(std::uint64_t flips, double window_ms,
+    std::uint64_t intervals, std::uint64_t interval_us,
+    std::uint64_t last_flip_ticks, std::uint64_t now_ticks, std::uint64_t frequency) noexcept
+{
+    Progress result;
+    if (window_ms > 0.0) result.wall_guest_fps = static_cast<double>(flips) * 1000.0 / window_ms;
+    if (interval_us) result.completed_interval_fps = static_cast<double>(intervals) * 1'000'000.0 / interval_us;
+    if (last_flip_ticks && frequency && now_ticks >= last_flip_ticks)
+        result.last_guest_flip_age_ms = microseconds(now_ticks - last_flip_ticks, frequency) / 1000.0;
+    return result;
+}
+
+struct Frame
+{
+    std::uint64_t session = 0, frame = 0, begin_ticks = 0, end_ticks = 0, frequency = 0;
+    std::uint64_t interval_us = 0, draws = 0, submits = 0, vertex_requests = 0, vertex_misses = 0;
+    std::uint64_t setup_us = 0, vertex_us = 0, texture_us = 0, execution_us = 0, flip_us = 0;
+    Waits waits{};
+    bool interval_available = false, stages_sampled = false, forced = false;
+};
+
+class Profile final
+{
+public:
+    static constexpr std::size_t per_group = 4;
+    static constexpr std::size_t capacity = 2 * per_group;
+    static constexpr std::uint64_t slow_threshold_us = 35'000;
+    struct Snapshot
+    {
+        bool captured = false;
+        std::uint64_t session = 0, frames = 0, slow = 0, sampled = 0, unretained = 0, contended = 0;
+        std::size_t size = 0;
+        std::array<Frame, capacity> events{};
+    };
+
+    // Lifecycle owner, after the previous RSX producer has stopped. Serialized
+    // with report take() by performance_registry's existing profile mutex.
+    void reset(std::uint64_t session)
+    {
+        std::lock_guard lock(mutex_);
+        session_ = session;
+        previous_ticks_ = 0;
+        frames_ = slow_ = sampled_ = eligible_ = 0;
+        slow_size_ = sampled_size_ = 0;
+        contended_.store(0, std::memory_order_relaxed);
+        active_session.store(session, std::memory_order_release);
+    }
+
+    // One RSX producer. The baseline advances even if the diagnostic buffer
+    // is busy, so a missed observation cannot manufacture a long interval.
+    void record(Frame event) noexcept
+    {
+        event.begin_ticks = previous_ticks_;
+        previous_ticks_ = event.end_ticks;
+        event.interval_available = event.begin_ticks && event.frequency && event.end_ticks >= event.begin_ticks;
+        event.interval_us = event.interval_available
+            ? microseconds(event.end_ticks - event.begin_ticks, event.frequency) : 0;
+        if (!mutex_.try_lock())
+        {
+            contended_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        std::lock_guard lock(mutex_, std::adopt_lock);
+        if (!session_) return;
+        event.session = session_;
+        ++frames_;
+        const bool slow = event.interval_available && event.interval_us >= slow_threshold_us;
+        slow_ += slow;
+        sampled_ += event.stages_sampled;
+        eligible_ += slow || event.stages_sampled;
+        if (slow) retain(slow_events_, slow_size_, event);
+        if (event.stages_sampled) retain(sampled_events_, sampled_size_, event);
+    }
+
+    // Keep four worst intervals plus four worst sampled frames. Deduplicate a
+    // frame retained by both groups. Unretained is explicit, never silence
+    // interpreted as absence of stutter. The sampler never waits for RSX.
+    Snapshot take() noexcept
+    {
+        Snapshot result;
+        if (!mutex_.try_lock()) return result;
+        std::lock_guard lock(mutex_, std::adopt_lock);
+        result.captured = true;
+        result.session = session_;
+        result.frames = frames_;
+        result.slow = slow_;
+        result.sampled = sampled_;
+        result.contended = contended_.exchange(0, std::memory_order_relaxed);
+        for (std::size_t i = 0; i < slow_size_; ++i) result.events[result.size++] = slow_events_[i];
+        for (std::size_t i = 0; i < sampled_size_; ++i)
+        {
+            const auto& event = sampled_events_[i];
+            bool duplicate = false;
+            for (std::size_t j = 0; j < result.size; ++j)
+                duplicate |= result.events[j].end_ticks == event.end_ticks && result.events[j].frame == event.frame;
+            if (!duplicate) result.events[result.size++] = event;
+        }
+        result.unretained = eligible_ >= result.size ? eligible_ - result.size : 0;
+        std::sort(result.events.begin(), result.events.begin() + result.size,
+            [](const Frame& a, const Frame& b) { return a.end_ticks < b.end_ticks; });
+        frames_ = slow_ = sampled_ = eligible_ = 0;
+        slow_size_ = sampled_size_ = 0;
+        return result;
+    }
+
+private:
+    static void retain(std::array<Frame, per_group>& events, std::size_t& size, const Frame& event) noexcept
+    {
+        if (size < events.size()) { events[size++] = event; return; }
+        const auto smallest = std::min_element(events.begin(), events.end(),
+            [](const Frame& a, const Frame& b) { return a.interval_us < b.interval_us; });
+        if (smallest->interval_us <= event.interval_us) *smallest = event;
+    }
+
+    std::mutex mutex_;
+    std::atomic<std::uint64_t> contended_{0};
+    std::uint64_t session_ = 0, previous_ticks_ = 0;
+    std::uint64_t frames_ = 0, slow_ = 0, sampled_ = 0, eligible_ = 0;
+    std::size_t slow_size_ = 0, sampled_size_ = 0;
+    std::array<Frame, per_group> slow_events_{}, sampled_events_{};
+};
+inline Profile profile;
+}
diff --git a/rpcs3/ios/IOSFullOverwrite.h b/rpcs3/ios/IOSFullOverwrite.h
new file mode 100644
index 0000000..dc152fa
--- /dev/null
+++ b/rpcs3/ios/IOSFullOverwrite.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// CELL559_FULL_OVERWRITE: a GPU transfer that replaces every byte of its
+// destination does not need the previous destination contents. These pure
+// decisions stay conservative: any doubt keeps the existing read-back/reload.
+namespace rpcs3::ios::full_overwrite
+{
+// Guest bytes [start, end] (inclusive, like address_range32) that the transfer
+// on this thread writes completely. Only the RSX thread sets it, around the one
+// invalidation that precedes its own DMA destination; other threads see none.
+struct Range
+{
+    std::uint32_t start = 1, end = 0;
+    bool valid() const noexcept { return start <= end; }
+    bool contains(std::uint32_t first, std::uint32_t last) const noexcept
+    {
+        return valid() && first <= last && first >= start && last <= end;
+    }
+};
+inline thread_local Range current_range{};
+
+class RangeScope final
+{
+    Range previous_;
+public:
+    RangeScope(bool enabled, std::uint32_t start, std::uint32_t length) noexcept
+        : previous_(current_range)
+    {
+        current_range = (enabled && length) ? Range{start, start + (length - 1)} : Range{};
+    }
+    ~RangeScope() noexcept { current_range = previous_; }
+    RangeScope(const RangeScope&) = delete;
+    RangeScope& operator=(const RangeScope&) = delete;
+};
+
+// A 1:1 DMA copy writes rows of src_w texels at the destination pitch. All
+// payload bytes are written only when the rows are contiguous (or single),
+// the copy keeps its texel size and no tiling or partial source applies.
+constexpr bool dma_copy_writes_whole_payload(
+    std::uint32_t dst_w, std::uint32_t dst_h, std::uint32_t dst_bpp, std::uint32_t dst_pitch,
+    std::int64_t src_area_w, std::int64_t src_area_h, std::uint32_t src_bpp,
+    bool src_typeless, bool dst_tiled) noexcept
+{
+    if (!dst_w || !dst_h || !dst_bpp || dst_tiled || src_typeless || src_bpp != dst_bpp)
+        return false;
+    if (src_area_w != static_cast<std::int64_t>(dst_w) || src_area_h != static_cast<std::int64_t>(dst_h))
+        return false;
+    return dst_h == 1 || static_cast<std::uint64_t>(dst_w) * dst_bpp == dst_pitch;
+}
+
+// A blit into an existing single-sampled color target replaces all of it when
+// the destination rectangle covers the target. Depth/stencil, typeless and
+// multisampled targets keep the existing memory reload.
+constexpr bool blit_replaces_whole_surface(
+    std::int64_t x1, std::int64_t y1, std::int64_t x2, std::int64_t y2,
+    std::uint32_t surface_w, std::uint32_t surface_h,
+    std::uint32_t surface_samples_w, std::uint32_t surface_samples_h,
+    bool depth, bool dst_typeless) noexcept
+{
+    if (depth || dst_typeless || !surface_w || !surface_h)
+        return false;
+    if (surface_samples_w != surface_w || surface_samples_h != surface_h)
+        return false;
+    // Exact bounds, as upstream requires for a newly created blit target.
+    return x1 == 0 && y1 == 0 &&
+        x2 == static_cast<std::int64_t>(surface_w) && y2 == static_cast<std::int64_t>(surface_h);
+}
+
+// Fixed counters exported once per profiler window (OPT559 line).
+inline std::atomic<std::uint64_t> dma_flush_skips{0}, dma_flush_skip_bytes{0};
+inline std::atomic<std::uint64_t> rt_reload_skips{0}, rt_reload_skip_bytes{0};
+}
diff --git a/rpcs3/ios/IOSGPUEventWait.h b/rpcs3/ios/IOSGPUEventWait.h
new file mode 100644
index 0000000..3b8c4d2
--- /dev/null
+++ b/rpcs3/ios/IOSGPUEventWait.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+namespace rpcs3::ios
+{
+// Poll briefly for an already finishing transfer, then wait for the native
+// completion counter to advance. A wake is only a hint: the Vulkan status is
+// authoritative. Read the counter BEFORE checking status to avoid losing a
+// signal between the status check and entering the native wait.
+template <typename Status, typename Counter, typename Poll, typename Clock,
+    typename Wait, typename Pause>
+Status wait_for_gpu_event(Status pending, Status timed_out,
+    std::uint64_t timeout_us, Counter counter, Poll poll, Clock clock,
+    Wait wait, Pause pause)
+{
+    const auto start = clock();
+    for (;;)
+    {
+        const auto observed = counter();
+        const auto status = poll();
+        if (status != pending)
+        {
+            return status;
+        }
+
+        const auto elapsed = clock() - start;
+        if (timeout_us && elapsed >= timeout_us)
+        {
+            return timed_out;
+        }
+
+        // One millisecond bounds error/timeout rechecks, not completion latency:
+        // Metal wakes the waiter immediately when the GPU signals the event.
+        // Poll the final sub-millisecond timeout tail instead of rounding it up.
+        if (elapsed >= 20 && (!timeout_us || timeout_us - elapsed >= 1000) &&
+            observed != std::numeric_limits<std::uint64_t>::max())
+        {
+            wait(observed + 1, 1);
+        }
+        else
+        {
+            pause();
+        }
+    }
+}
+}
diff --git a/rpcs3/ios/IOSGPUMemoryProfile.h b/rpcs3/ios/IOSGPUMemoryProfile.h
new file mode 100644
index 0000000..286359d
--- /dev/null
+++ b/rpcs3/ios/IOSGPUMemoryProfile.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include <mutex>
+namespace rpcs3::ios {
+// Diagnostic copies only. Neither the reporter nor this lock accesses a live
+// Vulkan allocator/cache. Hot-path publication and capture never wait; start /
+// stop may take the lock, but do not hold it across any GPU or allocator work.
+struct memory_sample_status {
+    bool captured = false, owner_live = false, sampled = false;
+    std::uint64_t generation = 0;
+};
+struct vma_memory_sample : memory_sample_status {
+    std::uint64_t block_bytes = 0, allocated = 0, unused = 0;
+};
+struct texture_memory_sample : memory_sample_status {
+    std::uint64_t recyclable_images = 0, recyclable_bytes = 0;
+};
+template <typename Sample> class owned_memory_profile {
+    mutable std::mutex mutex;
+    const void* owner = nullptr;
+    std::uint64_t generation = 0;
+    Sample value{};
+public:
+    void begin(const void* current) {
+        std::lock_guard lock(mutex);
+        owner = current;
+        value = {};
+        value.owner_live = true;
+        value.generation = ++generation;
+    }
+    void end(const void* current) {
+        std::lock_guard lock(mutex);
+        // A delayed teardown from an older device must not erase the new one.
+        if (owner != current) return;
+        owner = nullptr;
+        value = {};
+        value.generation = generation;
+    }
+    bool publish(const void* current, Sample sample) {
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock || owner != current) return false;
+        sample.owner_live = sample.sampled = true;
+        sample.generation = generation;
+        value = sample;
+        return true;
+    }
+    Sample capture() const {
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock) return {};
+        auto result = value;
+        result.captured = true;
+        return result;
+    }
+};
+inline constinit owned_memory_profile<vma_memory_sample> vma_profile;
+inline constinit owned_memory_profile<texture_memory_sample> texture_profile;
+}
diff --git a/rpcs3/ios/IOSGow3MlaaReport.h b/rpcs3/ios/IOSGow3MlaaReport.h
new file mode 100644
index 0000000..b671562
--- /dev/null
+++ b/rpcs3/ios/IOSGow3MlaaReport.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+// REWINDBOX_GOW3_MLAA_REPORT_909: God of War III, build 694 device log: CONFIG_LAYERS mlaa_bypass=1 is the policy, not
+// the patch. The executable was PPU-4d5c51503a81... (app 01.00, the BCES00510 cache directory), while the PPU half of the
+// bypass is gated to PPU-19724fde... (01.03) and skipped on a savestate boot; only the SPU half (exact SPU image hashes)
+// can apply, and every frame still read back one 1280x720x4 surface and received five SPU writes of the label the RSX
+// waits on. This records what was actually applied (COREPROF GOW3MLAA909): the PPU decision, the SPU images of the title
+// checked, the ones patched, and the first distinct SPU image hashes that matched no patch.
+namespace rpcs3::ios::gow3_mlaa
+{
+enum class ppu_state : std::uint32_t
+{
+	unset = 0, applied, other_executable, savestate, policy_off
+};
+
+inline std::atomic<std::uint32_t> ppu{0};
+inline std::atomic<std::uint64_t> spu_images{0}, spu_matched{0}, spu_words_patched{0};
+
+constexpr std::size_t hash_slots = 6;
+inline std::mutex hashes_mutex;
+inline std::array<std::array<char, 48>, hash_slots> unmatched{};
+inline std::size_t unmatched_count = 0;
+inline std::array<char, 48> executable{};
+
+inline void store(std::array<char, 48>& slot, std::string_view text) noexcept
+{
+	const std::size_t n = text.size() < slot.size() - 1 ? text.size() : slot.size() - 1;
+	std::memcpy(slot.data(), text.data(), n);
+	slot[n] = '\0';
+}
+
+inline void record_executable(std::string_view hash, ppu_state state) noexcept
+{
+	{
+		std::lock_guard lock(hashes_mutex);
+		store(executable, hash);
+	}
+	ppu.store(static_cast<std::uint32_t>(state), std::memory_order_relaxed);
+}
+
+inline void record_unmatched_spu(std::string_view hash) noexcept
+{
+	std::lock_guard lock(hashes_mutex);
+	for (std::size_t i = 0; i < unmatched_count; ++i)
+	{
+		if (std::string_view(unmatched[i].data()) == hash) return;
+	}
+	if (unmatched_count < hash_slots) store(unmatched[unmatched_count++], hash);
+}
+
+inline const char* ppu_name(std::uint32_t state) noexcept
+{
+	switch (static_cast<ppu_state>(state))
+	{
+	case ppu_state::applied: return "applied";
+	case ppu_state::other_executable: return "other_executable";
+	case ppu_state::savestate: return "savestate_memory";
+	case ppu_state::policy_off: return "policy_off";
+	default: return "unset";
+	}
+}
+
+// Comma-separated list of the unmatched SPU image hashes, and the executable hash.
+inline std::string unmatched_list()
+{
+	std::lock_guard lock(hashes_mutex);
+	std::string out;
+	for (std::size_t i = 0; i < unmatched_count; ++i)
+	{
+		if (i) out += ',';
+		out += unmatched[i].data();
+	}
+	return out.empty() ? std::string("-") : out;
+}
+
+inline std::string executable_hash()
+{
+	std::lock_guard lock(hashes_mutex);
+	return executable[0] ? std::string(executable.data()) : std::string("-");
+}
+} // namespace rpcs3::ios::gow3_mlaa
diff --git a/rpcs3/ios/IOSGpuTiming.h b/rpcs3/ios/IOSGpuTiming.h
new file mode 100644
index 0000000..b42617f
--- /dev/null
+++ b/rpcs3/ios/IOSGpuTiming.h
@@ -0,0 +1,870 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+// REWINDBOX_GPU_TIMING_621: GPU execution time of the RSX primary command
+// buffers, read after their submission completed, never waited for.
+//
+// Path (Core 619, MoltenVK 1.4.2 db66022 plus the RewindBox patches):
+// VKGSRender::close_and_submit_command_buffer -> vk::queue_submit ->
+// vkQueueSubmit -> MVKQueueCommandBufferSubmission (one MTLCommandBuffer per
+// submission) -> Metal. What that MoltenVK exposes after completion:
+//  - MTLCommandBuffer GPUStartTime/GPUEndTime: read nowhere by MoltenVK, and
+//    VK_EXT_metal_objects exports devices, queues, buffers, textures, IOSurfaces
+//    and shared events, not command buffers: unreachable without patching it.
+//  - vkGetPerformanceStatisticsMVK: queue.mtlCommandBufferExecution is a CPU
+//    interval from commit to the completion handler, aggregated over the
+//    process: not GPU time, not per submission.
+//  - Vulkan timestamp queries: on Apple GPUs (stage-boundary counter sampling)
+//    MoltenVK defers every vkCmdWriteTimestamp to the end of the current Metal
+//    encoder batch and samples it at the start of a one-byte blit pass that
+//    waits for the previous encoders (MVKCommandEncoder::
+//    encodeTimestampStageCounterSamples). A pair at the start and end of a
+//    command buffer therefore brackets its GPU work. Results come from an
+//    MTLCounterSampleBuffer after the command buffer completed. If MoltenVK
+//    could not create that buffer it falls back to one CPU time at completion:
+//    both values are then equal (counted as zero_duration, never as GPU time).
+//  - VK_EXT_calibrated_timestamps: pairs a GPU timestamp with a host time
+//    (-[MTLDevice sampleTimestamps:gpuTimestamp:]). Two pairs seconds apart
+//    give the GPU tick rate against the host TSC, checked rather than assumed
+//    (MoltenVK reports timestampPeriod 1.0 on Apple GPUs), and place GPU times
+//    on the host clock (queue delay = GPU start - RSX submit).
+// This header holds the bookkeeping only (no Vulkan): one producer, the RSX
+// thread, and one reader, the profiler report. Results are read without the
+// WAIT bit: a submission whose fence has not signalled stays pending.
+namespace rpcs3::ios::gpu_timing
+{
+inline constexpr std::uint32_t slot_count = 512;      // VK_MAX_ASYNC_CB_COUNT primary chunks, two queries each
+inline constexpr std::uint32_t frame_capacity = 512;  // RSX frames kept for the slow-frame lookup
+inline constexpr std::uint32_t sweep_limit = 64;      // results read per frame end at most
+inline constexpr std::uint64_t calibration_period_us = 2'000'000;
+inline constexpr std::uint64_t calibration_min_baseline_us = 500'000;
+inline constexpr std::uint64_t queue_delay_tolerance_us = 500;
+
+enum class state : std::uint32_t
+{
+	off = 0,        // no renderer session
+	active = 1,
+	no_pool = 2,    // the timestamp query pool could not be created
+	no_support = 3, // timestampComputeAndGraphics is false / no valid bits
+	disabled = 4,   // switched off by the experimental setting
+};
+
+inline const char* state_name(state value) noexcept
+{
+	switch (value)
+	{
+	case state::active: return "active";
+	case state::no_pool: return "no_pool";
+	case state::no_support: return "no_support";
+	case state::disabled: return "disabled";
+	default: return "off";
+	}
+}
+
+// What a frame's GPU value is worth.
+enum class frame_status : std::uint32_t
+{
+	not_found = 0, // no record for this session and frame (before the probe, or evicted)
+	none = 1,      // the frame submitted no primary command buffer
+	untimed = 2,   // none of its submissions carried timestamps
+	pending = 3,   // timed submissions still running or not yet read
+	partial = 4,   // every timed submission read, some submissions untimed or unavailable
+	complete = 5,  // every submission of the frame measured
+};
+
+inline const char* frame_status_name(frame_status value) noexcept
+{
+	switch (value)
+	{
+	case frame_status::none: return "no_submit";
+	case frame_status::untimed: return "untimed";
+	case frame_status::pending: return "pending";
+	case frame_status::partial: return "partial";
+	case frame_status::complete: return "complete";
+	default: return "not_found";
+	}
+}
+
+// GPU timestamps of one submission. available: both queries were written.
+struct sample
+{
+	bool available = false;
+	std::uint64_t begin = 0, end = 0;
+};
+
+// Union of GPU busy intervals taken in submission order: a command buffer
+// that starts before the previous one ended only adds what extends past it,
+// so overlapping submissions are never counted twice.
+struct busy_union
+{
+	std::uint64_t merged_end = 0;
+	std::uint64_t last_begin = 0;
+	bool any = false;
+
+	// Returns the ticks this interval adds; out_of_order when it starts before
+	// the previous one (one Metal queue starts command buffers in order).
+	std::uint64_t add(std::uint64_t begin, std::uint64_t end, bool& out_of_order) noexcept
+	{
+		out_of_order = any && begin < last_begin;
+		if (!any || begin > last_begin) last_begin = begin;
+		any = true;
+		if (end <= begin) return 0;
+		if (begin >= merged_end)
+		{
+			merged_end = end;
+			return end - begin;
+		}
+		if (end > merged_end)
+		{
+			const std::uint64_t added = end - merged_end;
+			merged_end = end;
+			return added;
+		}
+		return 0;
+	}
+};
+
+// GPU ticks against host TSC ticks, from calibrated timestamp pairs. The host
+// time of a pair is the middle of the TSC reads around the Vulkan call; half
+// their distance is its uncertainty.
+class calibration
+{
+public:
+	struct point
+	{
+		std::uint64_t gpu = 0, tsc = 0, half_span = 0;
+	};
+
+	void reset() noexcept { *this = {}; }
+
+	void add(std::uint64_t gpu, std::uint64_t tsc_before, std::uint64_t tsc_after) noexcept
+	{
+		if (tsc_after < tsc_before) return;
+		const point value{gpu, tsc_before + (tsc_after - tsc_before) / 2, (tsc_after - tsc_before) / 2};
+		if (!m_count++)
+		{
+			m_first = value;
+		}
+		m_latest = value;
+	}
+
+	std::uint64_t count() const noexcept { return m_count; }
+	const point& latest() const noexcept { return m_latest; }
+
+	// GPU ticks per TSC tick once the two points are min_baseline_tsc apart and
+	// the GPU clock moved forward with the host clock.
+	bool rate(std::uint64_t min_baseline_tsc, double& gpu_per_tsc, double& relative_uncertainty) const noexcept
+	{
+		if (m_count < 2 || m_latest.tsc <= m_first.tsc || m_latest.gpu <= m_first.gpu) return false;
+		const std::uint64_t baseline = m_latest.tsc - m_first.tsc;
+		if (baseline < min_baseline_tsc) return false;
+		gpu_per_tsc = static_cast<double>(m_latest.gpu - m_first.gpu) / static_cast<double>(baseline);
+		relative_uncertainty = static_cast<double>(m_first.half_span + m_latest.half_span) / static_cast<double>(baseline);
+		return true;
+	}
+
+private:
+	std::uint64_t m_count = 0;
+	point m_first{}, m_latest{};
+};
+
+// Per-window counters, read and cleared by the profiler report.
+struct window
+{
+	state probe = state::off;
+	std::uint64_t session = 0;
+	std::uint64_t queue_submits = 0; // every vkQueueSubmit of the process (any queue, any thread)
+	std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0, not_ready = 0;
+	std::uint64_t late_dropped = 0, stop_dropped = 0, overrun = 0, invalid = 0, zero_duration = 0;
+	std::uint64_t order_violations = 0, frame_evicted = 0, pending = 0;
+	std::uint64_t busy_ticks = 0, sum_ticks = 0, max_ticks = 0;
+	std::uint64_t queue_delay_samples = 0, queue_delay_sum_tsc = 0, queue_delay_max_tsc = 0, domain_violations = 0;
+	std::uint64_t probe_tsc = 0, probe_reads = 0, calibrations = 0, calibration_failures = 0;
+	std::uint64_t frames_gpu_over_33ms = 0, frames_gpu_over_50ms = 0, frames_measured = 0;
+	// Units: calibrated GPU ticks per TSC tick when available, otherwise the
+	// Vulkan timestampPeriod (nanoseconds per GPU tick) as reported.
+	bool calibrated = false;
+	double gpu_per_tsc = 0.0, calibration_uncertainty = 0.0, period_ns = 0.0;
+	std::uint64_t tsc_frequency = 0;
+
+	// Microseconds of a GPU tick count.
+	double ticks_us(std::uint64_t ticks) const noexcept
+	{
+		if (calibrated && gpu_per_tsc > 0.0 && tsc_frequency)
+			return static_cast<double>(ticks) / gpu_per_tsc * 1'000'000.0 / static_cast<double>(tsc_frequency);
+		return static_cast<double>(ticks) * period_ns / 1000.0;
+	}
+
+	double tsc_us(std::uint64_t ticks) const noexcept
+	{
+		return tsc_frequency ? static_cast<double>(ticks) * 1'000'000.0 / static_cast<double>(tsc_frequency) : 0.0;
+	}
+};
+
+// GPU record of one RSX frame (the RSX work between two frame ends).
+struct frame_view
+{
+	frame_status status = frame_status::not_found;
+	std::uint64_t flip = 0;
+	std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0;
+	double busy_us = -1.0, sum_us = -1.0, span_us = -1.0, max_us = -1.0, queue_delay_max_us = -1.0;
+};
+
+class tracker
+{
+	struct slot
+	{
+		bool begun = false;   // the begin timestamp was recorded in the current use
+		bool pending = false; // submitted, results not processed yet
+		std::uint64_t serial = 0, epoch = 0, session = 0, submit_tsc = 0;
+	};
+
+	// Frame record as published to the reader (seqlock: odd while written).
+	struct published_frame
+	{
+		std::atomic<std::uint64_t> seq{0};
+		std::atomic<std::uint64_t> epoch{0}, flip{0}, session{0};
+		std::atomic<std::uint64_t> submits{0}, timed{0}, untimed{0}, resolved{0}, unavailable{0};
+		std::atomic<std::uint64_t> busy{0}, sum{0}, span_begin{0}, span_end{0}, max{0};
+		std::atomic<std::uint64_t> queue_delay_max{0}, queue_delay_valid{0};
+	};
+
+	struct frame_shadow
+	{
+		std::uint64_t epoch = 0, flip = 0, session = 0;
+		std::uint64_t submits = 0, timed = 0, untimed = 0, resolved = 0, unavailable = 0;
+		std::uint64_t busy = 0, sum = 0, span_begin = 0, span_end = 0, max = 0;
+		std::uint64_t queue_delay_max = 0, queue_delay_valid = 0;
+		bool counted = false; // entered the >33/>50 ms window tallies
+	};
+
+	struct counters
+	{
+		std::atomic<std::uint64_t> queue_submits{0};
+		std::atomic<std::uint64_t> submits{0}, timed{0}, untimed{0}, resolved{0}, unavailable{0}, not_ready{0};
+		std::atomic<std::uint64_t> late_dropped{0}, stop_dropped{0}, overrun{0}, invalid{0}, zero_duration{0};
+		std::atomic<std::uint64_t> order_violations{0}, frame_evicted{0};
+		std::atomic<std::uint64_t> busy{0}, sum{0}, max{0};
+		std::atomic<std::uint64_t> queue_delay_samples{0}, queue_delay_sum{0}, queue_delay_max{0}, domain_violations{0};
+		std::atomic<std::uint64_t> probe_tsc{0}, probe_reads{0}, calibrations{0}, calibration_failures{0};
+		std::atomic<std::uint64_t> frames_over_33{0}, frames_over_50{0}, frames_measured{0};
+	};
+
+public:
+	// Renderer construction, RSX thread, before any submission of the session.
+	void begin_session(std::uint64_t session, state probe, double period_ns, std::uint64_t tsc_frequency) noexcept
+	{
+		for (auto& value : m_slots) value = {};
+		for (auto& value : m_fifo) value = 0;
+		for (auto& value : m_shadow) value = {};
+		m_union = {};
+		m_calibration.reset();
+		m_owner_calibrated = false;
+		m_owner_gpu_per_tsc = 0.0;
+		m_next_serial = 1;
+		m_oldest_serial = 1;
+		m_epoch = 1;
+		m_session = session;
+		m_tsc_frequency = tsc_frequency;
+		open_epoch(m_epoch);
+		m_pending.store(0, std::memory_order_relaxed);
+		m_period_bits.store(bits(period_ns), std::memory_order_relaxed);
+		m_tsc_frequency_published.store(tsc_frequency, std::memory_order_relaxed);
+		m_calibrated.store(0, std::memory_order_relaxed);
+		m_published_session.store(session, std::memory_order_relaxed);
+		m_state.store(static_cast<std::uint32_t>(probe), std::memory_order_release);
+	}
+
+	// Renderer destruction, RSX thread: results never read are dropped and
+	// counted; nothing is attributed to the next session.
+	void end_session() noexcept
+	{
+		std::uint64_t dropped = 0;
+		for (auto& value : m_slots)
+		{
+			dropped += value.pending;
+			value = {};
+		}
+		m_counters.stop_dropped.fetch_add(dropped, std::memory_order_relaxed);
+		m_pending.store(0, std::memory_order_relaxed);
+		m_session = 0;
+		m_state.store(static_cast<std::uint32_t>(state::off), std::memory_order_release);
+	}
+
+	bool active() const noexcept
+	{
+		return m_state.load(std::memory_order_relaxed) == static_cast<std::uint32_t>(state::active);
+	}
+
+	// ---- RSX thread ----------------------------------------------------
+
+	// The previous use of `index` must be processed before its queries are
+	// reset: read(index) returns its sample (the chunk's fence completed, the
+	// renderer waited for it as before). Older pending submissions go first so
+	// results are taken in submission order.
+	template <typename Read>
+	void release_slot(std::uint32_t index, Read&& read)
+	{
+		if (index >= slot_count || !m_slots[index].pending) return;
+		const std::uint64_t target = m_slots[index].serial;
+		while (m_oldest_serial <= target)
+		{
+			const std::uint32_t oldest = m_fifo[m_oldest_serial % slot_count];
+			slot& entry = m_slots[oldest];
+			if (entry.pending && entry.serial == m_oldest_serial)
+			{
+				const sample result = read(oldest);
+				m_counters.probe_reads.fetch_add(1, std::memory_order_relaxed);
+				process(entry, result);
+			}
+			m_oldest_serial++;
+		}
+	}
+
+	// The begin timestamp of `index` was recorded.
+	void on_begin(std::uint32_t index) noexcept
+	{
+		if (index < slot_count) m_slots[index].begun = true;
+	}
+
+	bool begun(std::uint32_t index) const noexcept
+	{
+		return index < slot_count && m_slots[index].begun;
+	}
+
+	// The recording of `index` was submitted without its pair (untimed).
+	void clear_begun(std::uint32_t index) noexcept
+	{
+		if (index < slot_count) m_slots[index].begun = false;
+	}
+
+	// The command buffer of `index`, closed with its end timestamp, was handed
+	// for submission at submit_tsc (RSX thread, before vkQueueSubmit).
+	void on_submit(std::uint32_t index, std::uint64_t submit_tsc) noexcept
+	{
+		if (index >= slot_count) return;
+		slot& entry = m_slots[index];
+		if (entry.pending)
+		{
+			// Never expected (release_slot runs at every begin): count, do not mix.
+			m_counters.overrun.fetch_add(1, std::memory_order_relaxed);
+			abandon(entry);
+		}
+		entry.begun = false;
+		entry.pending = true;
+		entry.serial = m_next_serial++;
+		entry.epoch = m_epoch;
+		entry.session = m_session;
+		entry.submit_tsc = submit_tsc;
+		m_fifo[entry.serial % slot_count] = index;
+		m_pending.fetch_add(1, std::memory_order_relaxed);
+		m_counters.submits.fetch_add(1, std::memory_order_relaxed);
+		m_counters.timed.fetch_add(1, std::memory_order_relaxed);
+		frame_shadow& frame = shadow(m_epoch);
+		frame.submits++;
+		frame.timed++;
+		publish(m_epoch);
+	}
+
+	// A submission without timestamps (heap sync, async streaming, probe off).
+	void on_untimed_submit(std::uint64_t count = 1) noexcept
+	{
+		m_counters.submits.fetch_add(count, std::memory_order_relaxed);
+		m_counters.untimed.fetch_add(count, std::memory_order_relaxed);
+		frame_shadow& frame = shadow(m_epoch);
+		frame.submits += count;
+		frame.untimed += count;
+		publish(m_epoch);
+	}
+
+	// Frame-end sweep, oldest first. complete(index) tells whether the chunk's
+	// fence signalled (no wait); read(index) reads its queries without waiting.
+	// Stops at the first submission still running or not yet readable.
+	template <typename Complete, typename Read>
+	void collect(Complete&& complete, Read&& read, std::uint32_t limit = sweep_limit)
+	{
+		for (std::uint32_t done = 0; done < limit && m_oldest_serial < m_next_serial;)
+		{
+			const std::uint32_t oldest = m_fifo[m_oldest_serial % slot_count];
+			slot& entry = m_slots[oldest];
+			if (!entry.pending || entry.serial != m_oldest_serial)
+			{
+				m_oldest_serial++;
+				continue;
+			}
+			if (!complete(oldest)) return;
+			const sample result = read(oldest);
+			m_counters.probe_reads.fetch_add(1, std::memory_order_relaxed);
+			done++;
+			if (!result.available)
+			{
+				// Fence signalled before MoltenVK marked the queries: retry later.
+				m_counters.not_ready.fetch_add(1, std::memory_order_relaxed);
+				return;
+			}
+			process(entry, result);
+			m_oldest_serial++;
+		}
+	}
+
+	// The RSX frame `flip` ended (rsx::thread::on_frame_end, the frame trace record).
+	// The epoch closes there, before int_flip_index advances and before the next
+	// flip's present: record F holds frame F-1's present and frame F's draws, the
+	// same interval as the frame trace and its waits. Stored as flip + 1 (0 = open).
+	void on_frame(std::uint64_t flip) noexcept
+	{
+		frame_shadow& frame = shadow(m_epoch);
+		frame.flip = flip + 1;
+		count_frame(frame); // every submission may already have been read
+		publish(m_epoch);
+		open_epoch(++m_epoch);
+	}
+
+	void add_calibration(std::uint64_t gpu, std::uint64_t tsc_before, std::uint64_t tsc_after) noexcept
+	{
+		m_counters.calibrations.fetch_add(1, std::memory_order_relaxed);
+		m_calibration.add(gpu, tsc_before, tsc_after);
+		double rate = 0.0, uncertainty = 0.0;
+		const std::uint64_t min_baseline = m_tsc_frequency / 1'000'000 * calibration_min_baseline_us;
+		if (m_calibration.rate(min_baseline, rate, uncertainty))
+		{
+			m_owner_calibrated = true;
+			m_owner_gpu_per_tsc = rate;
+			m_rate_bits.store(bits(rate), std::memory_order_relaxed);
+			m_uncertainty_bits.store(bits(uncertainty), std::memory_order_relaxed);
+			m_calibrated.store(1, std::memory_order_release);
+		}
+	}
+
+	void calibration_failed() noexcept
+	{
+		m_counters.calibration_failures.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	void add_probe_cost(std::uint64_t tsc_ticks) noexcept
+	{
+		m_counters.probe_tsc.fetch_add(tsc_ticks, std::memory_order_relaxed);
+	}
+
+	std::uint64_t pending() const noexcept { return m_pending.load(std::memory_order_relaxed); }
+
+	// Any thread: one vkQueueSubmit (vk::queue_submit_impl), the coverage denominator.
+	void on_queue_submit() noexcept
+	{
+		m_counters.queue_submits.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// ---- profiler report ------------------------------------------------
+
+	window take_window() noexcept
+	{
+		window result;
+		result.probe = static_cast<state>(m_state.load(std::memory_order_acquire));
+		result.session = m_published_session.load(std::memory_order_relaxed);
+		const auto take = [](std::atomic<std::uint64_t>& value) { return value.exchange(0, std::memory_order_relaxed); };
+		result.queue_submits = take(m_counters.queue_submits);
+		result.submits = take(m_counters.submits);
+		result.timed = take(m_counters.timed);
+		result.untimed = take(m_counters.untimed);
+		result.resolved = take(m_counters.resolved);
+		result.unavailable = take(m_counters.unavailable);
+		result.not_ready = take(m_counters.not_ready);
+		result.late_dropped = take(m_counters.late_dropped);
+		result.stop_dropped = take(m_counters.stop_dropped);
+		result.overrun = take(m_counters.overrun);
+		result.invalid = take(m_counters.invalid);
+		result.zero_duration = take(m_counters.zero_duration);
+		result.order_violations = take(m_counters.order_violations);
+		result.frame_evicted = take(m_counters.frame_evicted);
+		result.busy_ticks = take(m_counters.busy);
+		result.sum_ticks = take(m_counters.sum);
+		result.max_ticks = take(m_counters.max);
+		result.queue_delay_samples = take(m_counters.queue_delay_samples);
+		result.queue_delay_sum_tsc = take(m_counters.queue_delay_sum);
+		result.queue_delay_max_tsc = take(m_counters.queue_delay_max);
+		result.domain_violations = take(m_counters.domain_violations);
+		result.probe_tsc = take(m_counters.probe_tsc);
+		result.probe_reads = take(m_counters.probe_reads);
+		result.calibrations = take(m_counters.calibrations);
+		result.calibration_failures = take(m_counters.calibration_failures);
+		result.frames_gpu_over_33ms = take(m_counters.frames_over_33);
+		result.frames_gpu_over_50ms = take(m_counters.frames_over_50);
+		result.frames_measured = take(m_counters.frames_measured);
+		result.pending = m_pending.load(std::memory_order_relaxed);
+		units(result);
+		return result;
+	}
+
+	// The GPU record of RSX frame `flip` in `session`, converted with the
+	// current units. Never blocks the producer: a record being written is
+	// retried a few times, then reported as not found.
+	frame_view lookup(std::uint64_t session, std::uint64_t flip) const noexcept
+	{
+		frame_view view;
+		view.flip = flip;
+		if (!session) return view;
+		window scale;
+		units(scale);
+		for (const auto& entry : m_frames)
+		{
+			for (int attempt = 0; attempt < 4; ++attempt)
+			{
+				const std::uint64_t before = entry.seq.load(std::memory_order_acquire);
+				if (before & 1) continue;
+				frame_shadow copy;
+				copy.epoch = entry.epoch.load(std::memory_order_relaxed);
+				copy.flip = entry.flip.load(std::memory_order_relaxed);
+				copy.session = entry.session.load(std::memory_order_relaxed);
+				copy.submits = entry.submits.load(std::memory_order_relaxed);
+				copy.timed = entry.timed.load(std::memory_order_relaxed);
+				copy.untimed = entry.untimed.load(std::memory_order_relaxed);
+				copy.resolved = entry.resolved.load(std::memory_order_relaxed);
+				copy.unavailable = entry.unavailable.load(std::memory_order_relaxed);
+				copy.busy = entry.busy.load(std::memory_order_relaxed);
+				copy.sum = entry.sum.load(std::memory_order_relaxed);
+				copy.span_begin = entry.span_begin.load(std::memory_order_relaxed);
+				copy.span_end = entry.span_end.load(std::memory_order_relaxed);
+				copy.max = entry.max.load(std::memory_order_relaxed);
+				copy.queue_delay_max = entry.queue_delay_max.load(std::memory_order_relaxed);
+				copy.queue_delay_valid = entry.queue_delay_valid.load(std::memory_order_relaxed);
+				std::atomic_thread_fence(std::memory_order_acquire);
+				if (entry.seq.load(std::memory_order_relaxed) != before) continue;
+				if (copy.flip != flip + 1 || copy.session != session) break;
+				frame_view found = make_view(copy, scale);
+				found.flip = flip;
+				return found;
+			}
+		}
+		return view;
+	}
+
+	static frame_view make_view(const frame_shadow& copy, const window& scale) noexcept
+	{
+		frame_view view;
+		view.flip = copy.flip;
+		view.submits = copy.submits;
+		view.timed = copy.timed;
+		view.untimed = copy.untimed;
+		view.resolved = copy.resolved;
+		view.unavailable = copy.unavailable;
+		if (!copy.submits) view.status = frame_status::none;
+		else if (!copy.timed) view.status = frame_status::untimed;
+		else if (copy.timed > copy.resolved + copy.unavailable) view.status = frame_status::pending;
+		else if (copy.resolved == copy.submits) view.status = frame_status::complete;
+		else view.status = frame_status::partial;
+		if (copy.resolved)
+		{
+			view.busy_us = scale.ticks_us(copy.busy);
+			view.sum_us = scale.ticks_us(copy.sum);
+			view.max_us = scale.ticks_us(copy.max);
+			view.span_us = copy.span_end > copy.span_begin ? scale.ticks_us(copy.span_end - copy.span_begin) : 0.0;
+			if (copy.queue_delay_valid) view.queue_delay_max_us = scale.tsc_us(copy.queue_delay_max);
+		}
+		return view;
+	}
+
+private:
+	static std::uint64_t bits(double value) noexcept
+	{
+		std::uint64_t result = 0;
+		std::memcpy(&result, &value, sizeof(result));
+		return result;
+	}
+
+	static double real(std::uint64_t value) noexcept
+	{
+		double result = 0.0;
+		std::memcpy(&result, &value, sizeof(result));
+		return result;
+	}
+
+	void units(window& result) const noexcept
+	{
+		result.period_ns = real(m_period_bits.load(std::memory_order_relaxed));
+		result.tsc_frequency = m_tsc_frequency_published.load(std::memory_order_relaxed);
+		result.calibrated = m_calibrated.load(std::memory_order_acquire) != 0;
+		if (result.calibrated)
+		{
+			result.gpu_per_tsc = real(m_rate_bits.load(std::memory_order_relaxed));
+			result.calibration_uncertainty = real(m_uncertainty_bits.load(std::memory_order_relaxed));
+		}
+	}
+
+	frame_shadow& shadow(std::uint64_t epoch) noexcept
+	{
+		return m_shadow[epoch % frame_capacity];
+	}
+
+	void open_epoch(std::uint64_t epoch) noexcept
+	{
+		frame_shadow& frame = shadow(epoch);
+		frame = {};
+		frame.epoch = epoch;
+		frame.session = m_session;
+		publish(epoch);
+	}
+
+	void publish(std::uint64_t epoch) noexcept
+	{
+		const frame_shadow& frame = shadow(epoch);
+		published_frame& entry = m_frames[epoch % frame_capacity];
+		const std::uint64_t seq = entry.seq.load(std::memory_order_relaxed);
+		entry.seq.store(seq + 1, std::memory_order_relaxed);
+		std::atomic_thread_fence(std::memory_order_release);
+		entry.epoch.store(frame.epoch, std::memory_order_relaxed);
+		entry.flip.store(frame.flip, std::memory_order_relaxed);
+		entry.session.store(frame.session, std::memory_order_relaxed);
+		entry.submits.store(frame.submits, std::memory_order_relaxed);
+		entry.timed.store(frame.timed, std::memory_order_relaxed);
+		entry.untimed.store(frame.untimed, std::memory_order_relaxed);
+		entry.resolved.store(frame.resolved, std::memory_order_relaxed);
+		entry.unavailable.store(frame.unavailable, std::memory_order_relaxed);
+		entry.busy.store(frame.busy, std::memory_order_relaxed);
+		entry.sum.store(frame.sum, std::memory_order_relaxed);
+		entry.span_begin.store(frame.span_begin, std::memory_order_relaxed);
+		entry.span_end.store(frame.span_end, std::memory_order_relaxed);
+		entry.max.store(frame.max, std::memory_order_relaxed);
+		entry.queue_delay_max.store(frame.queue_delay_max, std::memory_order_relaxed);
+		entry.queue_delay_valid.store(frame.queue_delay_valid, std::memory_order_relaxed);
+		entry.seq.store(seq + 2, std::memory_order_release);
+	}
+
+	static void raise(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+	{
+		std::uint64_t current = value.load(std::memory_order_relaxed);
+		while (candidate > current && !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {}
+	}
+
+	void abandon(slot& entry) noexcept
+	{
+		if (!entry.pending) return;
+		entry.pending = false;
+		m_pending.fetch_sub(1, std::memory_order_relaxed);
+		m_counters.unavailable.fetch_add(1, std::memory_order_relaxed);
+		if (entry.session != m_session) return;
+		if (m_epoch - entry.epoch >= frame_capacity) return;
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch) return;
+		frame.unavailable++;
+		publish(entry.epoch);
+	}
+
+	void process(slot& entry, const sample& result) noexcept
+	{
+		if (!result.available)
+		{
+			abandon(entry);
+			return;
+		}
+
+		entry.pending = false;
+		m_pending.fetch_sub(1, std::memory_order_relaxed);
+
+		// A result of an earlier renderer session is never attributed.
+		if (entry.session != m_session)
+		{
+			m_counters.late_dropped.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+
+		if (result.end < result.begin)
+		{
+			m_counters.invalid.fetch_add(1, std::memory_order_relaxed);
+			abandon_frame(entry);
+			return;
+		}
+
+		const std::uint64_t duration = result.end - result.begin;
+		if (!duration) m_counters.zero_duration.fetch_add(1, std::memory_order_relaxed);
+		bool out_of_order = false;
+		const std::uint64_t added = m_union.add(result.begin, result.end, out_of_order);
+		if (out_of_order) m_counters.order_violations.fetch_add(1, std::memory_order_relaxed);
+		m_counters.resolved.fetch_add(1, std::memory_order_relaxed);
+		m_counters.busy.fetch_add(added, std::memory_order_relaxed);
+		m_counters.sum.fetch_add(duration, std::memory_order_relaxed);
+		raise(m_counters.max, duration);
+
+		// Queue delay: GPU start on the host clock minus the RSX submit time.
+		bool delay_valid = false;
+		std::uint64_t delay = 0;
+		if (m_owner_calibrated && m_owner_gpu_per_tsc > 0.0)
+		{
+			const auto& anchor = m_calibration.latest();
+			const double offset = (static_cast<double>(result.begin) - static_cast<double>(anchor.gpu)) / m_owner_gpu_per_tsc;
+			const double start_tsc = static_cast<double>(anchor.tsc) + offset;
+			const double difference = start_tsc - static_cast<double>(entry.submit_tsc);
+			const double tolerance = static_cast<double>(anchor.half_span) +
+				static_cast<double>(m_tsc_frequency) * queue_delay_tolerance_us / 1'000'000.0;
+			if (difference < -tolerance)
+			{
+				m_counters.domain_violations.fetch_add(1, std::memory_order_relaxed);
+			}
+			else
+			{
+				delay_valid = true;
+				delay = difference > 0.0 ? static_cast<std::uint64_t>(difference) : 0;
+				m_counters.queue_delay_samples.fetch_add(1, std::memory_order_relaxed);
+				m_counters.queue_delay_sum.fetch_add(delay, std::memory_order_relaxed);
+				raise(m_counters.queue_delay_max, delay);
+			}
+		}
+
+		if (m_epoch - entry.epoch >= frame_capacity)
+		{
+			m_counters.frame_evicted.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch)
+		{
+			m_counters.frame_evicted.fetch_add(1, std::memory_order_relaxed);
+			return;
+		}
+		frame.resolved++;
+		frame.busy += added;
+		frame.sum += duration;
+		frame.max = std::max(frame.max, duration);
+		frame.span_begin = frame.resolved == 1 ? result.begin : std::min(frame.span_begin, result.begin);
+		frame.span_end = std::max(frame.span_end, result.end);
+		if (delay_valid)
+		{
+			frame.queue_delay_max = frame.queue_delay_valid ? std::max(frame.queue_delay_max, delay) : delay;
+			frame.queue_delay_valid = 1;
+		}
+		count_frame(frame);
+		publish(entry.epoch);
+	}
+
+	void abandon_frame(const slot& entry) noexcept
+	{
+		m_counters.unavailable.fetch_add(1, std::memory_order_relaxed);
+		if (m_epoch - entry.epoch >= frame_capacity) return;
+		frame_shadow& frame = shadow(entry.epoch);
+		if (frame.epoch != entry.epoch) return;
+		frame.unavailable++;
+		publish(entry.epoch);
+	}
+
+	// A closed frame whose every submission was measured joins the window's
+	// GPU frame tallies once.
+	void count_frame(frame_shadow& frame) noexcept
+	{
+		if (frame.counted || !frame.flip || !frame.submits || frame.resolved != frame.submits) return;
+		frame.counted = true;
+		m_counters.frames_measured.fetch_add(1, std::memory_order_relaxed);
+		window scale;
+		units(scale);
+		const double busy_us = scale.ticks_us(frame.busy);
+		if (busy_us > 33'333.0) m_counters.frames_over_33.fetch_add(1, std::memory_order_relaxed);
+		if (busy_us > 50'000.0) m_counters.frames_over_50.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	// RSX-thread state.
+	std::array<slot, slot_count> m_slots{};
+	std::array<std::uint32_t, slot_count> m_fifo{};
+	std::array<frame_shadow, frame_capacity> m_shadow{};
+	busy_union m_union{};
+	calibration m_calibration{};
+	bool m_owner_calibrated = false;
+	double m_owner_gpu_per_tsc = 0.0;
+	std::uint64_t m_next_serial = 1, m_oldest_serial = 1, m_epoch = 1, m_session = 0, m_tsc_frequency = 0;
+
+	// Shared with the reader.
+	std::array<published_frame, frame_capacity> m_frames{};
+	counters m_counters{};
+	std::atomic<std::uint64_t> m_pending{0};
+	std::atomic<std::uint32_t> m_state{0};
+	std::atomic<std::uint64_t> m_published_session{0};
+	std::atomic<std::uint64_t> m_period_bits{0}, m_rate_bits{0}, m_uncertainty_bits{0};
+	std::atomic<std::uint64_t> m_tsc_frequency_published{0};
+	std::atomic<std::uint32_t> m_calibrated{0};
+};
+
+// What explains one slow RSX frame (cause_rule=v2, printed with the values it
+// read). The RSX-thread waits are sequential on that thread: CPU wait for a GPU
+// fence, blocking pipeline compile, presentation (drawable acquisition and
+// present), vkQueueSubmit (Metal encoding with synchronous MoltenVK submits), the
+// guest semaphore the RSX waited for and (v2) the occlusion query results ZCULL
+// waited for. The semaphore wait excludes the ZCULL, fence and submit waits the
+// RSX thread made inside the acquire (nv406e, frame_trace::nested_wait_ticks), so
+// a ZCULL request served from inside an acquire is counted once, as zcull_sync.
+// GPU execution runs beside them.
+//  1. GPU busy measured for every submission of the frame and >= 75 % of the
+//     interval: gpu_execution (measured).
+//  2. Otherwise the largest wait if it is >= 25 % of the interval (measured),
+//     except a fence wait whose GPU side is not fully measured (partial).
+//  3. Otherwise rsx_or_guest_cpu: RSX command processing or a guest that did
+//     not feed the FIFO (inferred: no wait explains it).
+struct frame_explanation
+{
+	const char* cause = "rsx_or_guest_cpu";
+	const char* certainty = "inferred";
+	const char* dominant = "none";
+	double dominant_ms = 0.0;
+	double waits_ms = 0.0;
+	double other_ms = 0.0;
+};
+
+inline frame_explanation explain_frame(double interval_ms, double fence_ms, double pipeline_ms, double presentation_ms,
+	double submit_ms, double semaphore_ms, double zcull_ms, const frame_view& gpu) noexcept
+{
+	frame_explanation result;
+	// REWINDBOX_ZCULL_FRAME_621 (cause_rule=v2): the RSX thread's waits for occlusion
+	// query results join the candidates. Build 620 logs: Assassin's Creed lost
+	// 4.1-4.3 s of every 5 s window there and Black Ops II 1.1-1.9 s, while v1
+	// could only infer rsx_or_guest_cpu for those frames.
+	const struct
+	{
+		const char* name;
+		double ms;
+	} waits[] = {
+		{"cpu_wait_gpu_fence", fence_ms},
+		{"pipeline_compile", pipeline_ms},
+		{"presentation", presentation_ms},
+		{"submit_encode", submit_ms},
+		{"guest_semaphore", semaphore_ms},
+		{"zcull_sync", zcull_ms},
+	};
+	for (const auto& wait : waits)
+	{
+		const double value = wait.ms > 0.0 ? wait.ms : 0.0;
+		result.waits_ms += value;
+		if (value > result.dominant_ms)
+		{
+			result.dominant_ms = value;
+			result.dominant = wait.name;
+		}
+	}
+	result.other_ms = interval_ms > result.waits_ms ? interval_ms - result.waits_ms : 0.0;
+	if (!(interval_ms > 0.0)) return result;
+
+	const bool gpu_complete = gpu.status == frame_status::complete && gpu.busy_us >= 0.0;
+	if (gpu_complete && gpu.busy_us / 1000.0 >= 0.75 * interval_ms)
+	{
+		result.cause = "gpu_execution";
+		result.certainty = "measured";
+		return result;
+	}
+	if (result.dominant_ms >= 0.25 * interval_ms)
+	{
+		result.cause = result.dominant;
+		const bool fence = result.dominant == waits[0].name;
+		result.certainty = fence && !gpu_complete ? "partial" : "measured";
+	}
+	return result;
+}
+
+inline tracker& instance() noexcept
+{
+	static tracker s_tracker;
+	return s_tracker;
+}
+}
