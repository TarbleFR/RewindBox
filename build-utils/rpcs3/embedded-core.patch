+			MTLTextureDescriptor* desc = [MTLTextureDescriptor textureBufferDescriptorWithPixelFormat:metal_format
+				width:static_cast<NSUInteger>(length / texel_size) resourceOptions:source.resourceOptions usage:MTLTextureUsageShaderRead];
+			return keep([source newTextureWithDescriptor:desc offset:static_cast<NSUInteger>(offset) bytesPerRow:static_cast<NSUInteger>(length)]);
+		}
+	}
