+// CELL587_MVK_ASYNC_CANARY (ios/IOSMoltenVKAsyncCanary.h): this boot's title, verdict and state.
+std::mutex s_mvk_canary_mutex;
+std::string s_mvk_canary_title;
+mvk_async_canary::verdict s_mvk_canary_verdict = mvk_async_canary::verdict::off;
