+	std::array<mtl::image_view*, rsx::limits::fragment_textures_count> m_fs_views{};
+	std::array<mtl::image_view*, rsx::limits::fragment_textures_count> m_fs_stencil_views{};
+	std::array<mtl::image_view*, rsx::limits::vertex_textures_count> m_vs_views{};
+	mtl::image_view* m_frag_depth_view = nullptr;
+
+	// Copies of bound attachments a draw samples (same-pass feedback), reused across draws: each copy encoder
+	// starts with a queue barrier after all earlier work, so a reuse never overtakes a draw still reading it.
+	std::vector<std::unique_ptr<mtl::image>> m_snapshot_pool;
+	std::vector<std::pair<mtl::image*, mtl::image*>> m_draw_snapshots;   // this draw: attachment -> copy
+
+	// Guest-thread faults that need a flush are served by the RSX thread (GLGSRender work queue).
+	struct flush_request
+	{
+		mtl::texture_cache::thrashed_set section_data;
+		// A replay: the RSX thread handles the whole fault itself, flushing in place (a guest thread saw a GPU ->
+		// memory copy recorded and not submitted yet, and must not take the cache lock and wait for it).
+		bool replay = false;
+		bool is_writing = false;
+		u32 fault_address = 0;
+		bool handled = false;                // replay: the texture cache handled the violation
+		atomic_t<bool> processed = false;
+		atomic_t<bool> received = false;
+	};
+	bool post_flush_request(flush_request&& request);   // waits until served; returns the replay's result
+	shared_mutex m_flush_queue_guard;
+	std::list<flush_request> m_flush_queue;
+	atomic_t<bool> m_offloader_deadlock = false;
+	utils::address_range32 m_offloader_fault_range;
+	rsx::invalidation_cause m_offloader_fault_cause = rsx::invalidation_cause::read;
+
+	texel_window m_persistent_window;
+	texel_window m_volatile_window;
+	u64 m_texel_window_size = 0;
+
+	mtl::program* m_program = nullptr;
+	const mtl::vertex_program* m_vertex_prog = nullptr;
+	const mtl::fragment_program* m_fragment_prog = nullptr;
+	mtl::pipeline_props m_pipeline_properties{};
+	std::unordered_map<u64, mtl::object> m_depth_stencil_states;
+	rsx::vertex_input_layout m_vertex_layout;
+	std::vector<u8> m_draw_buffers;
+
+	// Clear pipelines by colour write mask (one attachment configuration per render pass)
+	mtl::object m_clear_library;
+	std::unordered_map<u64, mtl::object> m_clear_pipelines;
+
+	// Render pass state: the pass is reopened (load, store) when the attachments change or after copies.
+	bool m_render_pass_dirty = true;
+	bool m_draw_buffers_stale = true;
+	bool m_encoder_state_dirty = true;
+	u64 m_render_pass_serial = 0;
+	struct { u32 width = 0, height = 0; } m_render_pass_size;
+	u32 m_subdraw_id = 0;
+
+	// Ring data a draw may reuse when its registers did not change. Re-uploaded at every frame and after a full
+	// ring made the renderer wait (the reclaimed space may then hold newer data).
+	bool m_vertex_env_valid = false;
+	bool m_xform_constants_valid = false;
+	bool m_fragment_constants_valid = false;
+	bool m_fragment_env_valid = false;
+	bool m_texture_parameters_valid = false;
+	bool m_stipple_valid = false;
+	void invalidate_environment();
+
+	// Program environment: offsets inside the rings, as the Vulkan renderer's dynamic offsets.
+	usz m_xform_constants_offset = 0;
+	usz m_vertex_env_offset = 0;
+	usz m_vertex_layout_offset = 0;
+	usz m_fragment_constants_offset = 0;
+	usz m_fragment_env_offset = 0;
+	usz m_texture_parameters_offset = 0;
+	usz m_stipple_offset = 0;
+	usz m_instancing_lut_offset = 0;
+	usz m_instancing_constants_offset = 0;
+	usz m_push_constants_offset = 0;
+	mtl::scissor_rect m_scissor{};
+
+	// M4: ZCULL occlusion queries (MTLQueries.cpp)
+	static constexpr u32 query_slot_count = 32768;  // VK OCCLUSION_MAX_POOL_SIZE (DESCRIPTOR_MAX_DRAW_CALLS)
+	mtl::object m_query_buffer;                     // the visibility result buffer of every RSX pass, 8 bytes per slot
+	mtl::visibility_slot_pool m_query_slots;
+	std::vector<mtl::occlusion_record> m_query_records;  // by occlusion_query_info::driver_handle
+	rsx::reports::occlusion_query_info* m_active_query_info = nullptr;
+	bool m_occlusion_query_active = false;
+	u64 m_query_segment_pass = 0;      // the RSX pass (m_render_pass_serial) in which the active query counts, 0 if none
+	u64 m_query_cb_fence = 0;          // the submission in which a segment was last opened (VK cb_has_occlusion_task)
+	bool m_zcull_flush_pending = false;  // VK m_flush_requests posted by a conditional render evaluation hint
+	u64 m_last_cond_render_eval_hint = 0;
+	bool m_servicing_semaphore_wait = false;
+	u32 m_semaphore_wait_polls = 0;
+	u64 m_next_semaphore_service = 0;
+
+	void init_queries();
+	void destroy_queries();
+	bool query_segment_open() const;
+	bool reserve_query_slot();                         // before open_render_pass (may submit)
+	void begin_query_segment(const mtl::object& encoder);  // after open_render_pass, before the draw
+	void suspend_query_segment();                      // a clear or the end of the query: counting stops in this encoder
+	void release_query_record(mtl::occlusion_record& record);
+	void fold_queries(bool all);
+	u64 query_slot_value(u32 slot) const;
+	// The ZCULL parts of do_local_task and on_semaphore_acquire_wait (VKGSRender)
+	bool service_zcull_flush();                            // the flush a conditional render evaluation hint asked for
+	bool zcull_semaphore_wait_pending() const;             // do_local_task(lock_wait) is needed for ZCULL
+	void service_zcull_semaphore_wait();                   // ZCULL progress while an acquire blocks the FIFO loop
+	void service_native_ui_flip(rsx::FIFO::state state);   // frames for the native interface
+
+	// M4: MSAA, conversion kernels, native overlays
+	mtl::msaa_resolver m_resolver;
+	mtl::compute_tasks m_compute_tasks;
+	mtl::ui_overlay_renderer m_overlay_renderer;
+	void init_m4_config();  // constructor: MSAA backend facts, the display manager of the native interface
+	void init_m4();
+	void destroy_m4();
+	void report_m4_counters();
+	void prepare_overlays(const areau& image_area);  // before the presentation pass: the views and their images
+	// M4 end
+
+	// M5: the RSX program cache on disk (rsx::shaders_cache, the Vulkan renderer's) and the Metal 4 pipeline binaries
+	// (MTLPipelineCache.h, MTLM5Renderer.cpp)
+	using shader_cache = rsx::shaders_cache<mtl::pipeline_props, mtl::program_cache>;
+	std::unique_ptr<shader_cache> m_shaders_cache;
+	mtl::pipeline_archive m_pipeline_archive;
+	std::string m_metal_cache_directory;  // empty when the on-disk shader cache is off
+	void open_pipeline_archive();     // before the compiler: it captures into the archive's serializer
+	void create_program_cache();      // after the program cache
+	void store_program(const mtl::pipeline_props& props, const RSXVertexProgram& vp, const RSXFragmentProgram& fp);
+	void load_program_cache();        // the boot precompile, before the first draw
+	void close_pipeline_caches();     // on_exit: the queued records, the last archive checkpoint
+	void report_m5_counters();
+#ifdef RPCS3_IOS
+	// The armed watched submission (VKGSRender m_ios_early_armed_draws / _watched; Metal arms only watched ones):
+	// taken at a draw boundary with no render pass open, after max_deferred_draws draws at a draw end, or carried by
+	// any other submission.
+	u32 m_ios_armed_draws = 0;
+	u32 m_ios_early_submits_this_frame = 0;
+	rpcs3::ios::zcull_watched::frame_budget m_ios_watched_budget;
+	void ios_watched_submit_at_boundary(bool after_textures);  // the start of a draw, after its textures
+	void ios_watched_submit_at_draw_end();
