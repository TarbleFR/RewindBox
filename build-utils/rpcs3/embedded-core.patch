+// Native runtime primitives shared by CELL interpreters and RSX conversions.
+// These operate directly on the common v128 representation; iOS never enters
+// the SSE emulation header. Counts in *_full are unsigned and saturate at the
+// element width, unlike the modulo-width vector shifts above.
+inline v128 gv_bcstfd(f64 value)
+{
+#if defined(ARCH_X64)
+	return _mm_set1_pd(value);
+#elif defined(ARCH_ARM64)
+	return vdupq_n_f64(value);
+#endif
+}
