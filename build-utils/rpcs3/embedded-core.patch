+		ring_fragment_constants,
+		ring_transform_constants,
+		ring_raster_env,
+		ring_instancing,
+		ring_push_constants,
+		ring_texture_upload,
+		ring_count
+	};
+
+	// One frame of GPU work: reused once the queue has signalled its fence value.
+	struct frame_slot
+	{
+		mtl::object allocator;
+		mtl::object constants;   // the presentation rectangle
+		mtl::object upload;      // the display buffer read from guest memory
+		u32 upload_width = 0;
+		u32 upload_height = 0;
+		u64 fence = 0;
+		std::array<usz, ring_count> ring_positions{};
+		bool positions_valid = false;
+	};
+
+	// Attribute ring windows seen as texel buffers (VK: m_persistent_attribute_storage / m_volatile_attribute_storage)
+	struct texel_window
+	{
+		mtl::object view;
+		u64 base = 0;
+		u64 length = 0;
+	};
+
+	// Frames
+	void begin_frame();
