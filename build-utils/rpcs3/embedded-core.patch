diff --git a/rpcs3/Emu/RSX/Common/deferred_publisher.h b/rpcs3/Emu/RSX/Common/deferred_publisher.h
new file mode 100644
index 0000000..91b9be7
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/deferred_publisher.h
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <utility>
+
+namespace rsx
+{
+	// CELL543: persistent shader-cache records are not needed to draw the
+	// current frame. One worker writes them in submission order, outside the
+	// RSX thread. The queue is bounded: when it is full the caller writes the
+	// record itself as before. No accepted record is dropped; destruction
+	// drains the queue before joining. Written for -fno-exceptions builds: the
+	// sink reports failure by returning false.
+	template <typename Record>
+	class deferred_publisher
+	{
+	public:
+		using sink_t = std::function<bool(Record&)>;
+		using start_t = std::function<void()>;
+
+		struct stats_t
+		{
+			std::uint64_t deferred = 0;       // accepted by the worker queue
+			std::uint64_t inline_writes = 0;  // written by the caller (queue full)
+			std::uint64_t written = 0;        // completed by the worker
+			std::uint64_t sink_failures = 0;  // the sink returned false (queued or inline)
+			std::uint64_t peak_depth = 0;
+		};
+
+		deferred_publisher(std::size_t capacity, sink_t sink, start_t on_start = {})
+			: m_capacity(std::max<std::size_t>(capacity, 1))
+			, m_sink(std::move(sink))
+			, m_on_start(std::move(on_start))
+		{
+		}
+
+		deferred_publisher(const deferred_publisher&) = delete;
+		deferred_publisher& operator=(const deferred_publisher&) = delete;
+
+		~deferred_publisher()
+		{
+			{
+				std::lock_guard lock(m_mutex);
+				m_stopping = true;
+			}
+
+			m_wake.notify_all();
+
+			if (m_worker.joinable())
+			{
+				m_worker.join();
+			}
+		}
+
+		// Returns true when the record was queued, false when the caller wrote it.
+		bool submit(Record&& record)
+		{
+			std::unique_lock lock(m_mutex);
+
+			if (!m_stopping && m_queue.size() < m_capacity)
+			{
+				start_worker();
+				m_queue.push_back(std::move(record));
+				m_stats.deferred++;
+				m_stats.peak_depth = std::max<std::uint64_t>(m_stats.peak_depth, m_queue.size());
+				lock.unlock();
+				m_wake.notify_one();
+				return true;
+			}
+
+			m_stats.inline_writes++;
+			lock.unlock();
+			const bool ok = m_sink(record);
+			lock.lock();
+			m_stats.sink_failures += ok ? 0 : 1;
+			return false;
+		}
+
+		// Blocks until every queued record has been written.
+		void drain()
+		{
+			std::unique_lock lock(m_mutex);
+			m_idle.wait(lock, [this] { return m_queue.empty() && !m_busy; });
+		}
+
+		stats_t stats() const
+		{
+			std::lock_guard lock(m_mutex);
+			return m_stats;
+		}
+
+		std::size_t depth() const
+		{
+			std::lock_guard lock(m_mutex);
+			return m_queue.size() + (m_busy ? 1 : 0);
+		}
+
+	private:
+		// Called with m_mutex held. Started on first use: sessions that never
+		// compile a new pipeline create no thread.
+		void start_worker()
+		{
+			if (!m_worker.joinable())
+			{
+				m_worker = std::thread([this] { run(); });
+			}
+		}
+
+		void run()
+		{
+			if (m_on_start)
+			{
+				m_on_start();
+			}
+
+			std::unique_lock lock(m_mutex);
+
+			while (true)
+			{
+				m_wake.wait(lock, [this] { return m_stopping || !m_queue.empty(); });
+
+				if (m_queue.empty())
+				{
+					// Only reached when stopping: every accepted record was written.
+					break;
+				}
+
+				Record record = std::move(m_queue.front());
+				m_queue.pop_front();
+				m_busy = true;
+				lock.unlock();
+
+				const bool ok = m_sink(record);
+
+				lock.lock();
+				m_busy = false;
+				m_stats.written++;
+				m_stats.sink_failures += ok ? 0 : 1;
+
+				if (m_queue.empty())
+				{
+					m_idle.notify_all();
+				}
+			}
+
+			m_idle.notify_all();
+		}
+
+		const std::size_t m_capacity;
+		const sink_t m_sink;
+		const start_t m_on_start;
+
+		mutable std::mutex m_mutex;
+		std::condition_variable m_wake;
+		std::condition_variable m_idle;
+		std::deque<Record> m_queue;
+		stats_t m_stats{};
+		bool m_busy = false;
+		bool m_stopping = false;
+
+		// Last member: started after every field above is initialized.
+		std::thread m_worker;
+	};
+}
diff --git a/rpcs3/Emu/RSX/Common/sampler_invalidation.h b/rpcs3/Emu/RSX/Common/sampler_invalidation.h
new file mode 100644
index 0000000..9345076
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/sampler_invalidation.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+namespace rsx
+{
+	template <typename Sampler, typename Context, std::size_t Count>
+	bool invalidate_sampler_context(const std::array<Sampler, Count>& samplers,
+		std::array<bool, Count>& dirty, Context context)
+	{
+		bool invalidated = false;
+		for (std::size_t i = 0; i < Count; ++i)
+		{
+			if (samplers[i] && samplers[i]->upload_context == context)
+			{
+				// A global dirty flag is consumed by the next shader's referenced
+				// slots only. Keep invalidation pending for every cached descriptor,
+				// including slots that are currently disabled or unreferenced.
+				dirty[i] = true;
+				invalidated = true;
+			}
+		}
+		return invalidated;
+	}
+}
