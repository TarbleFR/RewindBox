+};
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Counters.h b/rpcs3/Emu/RSX/Metal/MTLM4Counters.h
new file mode 100644
index 0000000..b946890
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Counters.h
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): what stage M4 executed, and what it could not execute (counted, logged once, never
+// replaced by a guess). Reported by MTLGSRender::report_counters as the "COREPROF METAL M4" line.
+
+#include "util/types.hpp"
+
+#include <atomic>
+
+namespace mtl
+{
+	struct m4_counters
+	{
+		// ZCULL / occlusion queries (MTLQueries.cpp)
+		std::atomic<u64> queries_begun{0};
+		std::atomic<u64> query_segments{0};          // visibility slots counted (one per query per render encoder)
+		std::atomic<u64> query_results{0};           // results gathered from the GPU
+		std::atomic<u64> query_discards{0};
+		std::atomic<u64> query_hard_syncs{0};        // a result read while its work was still being recorded (VK: hard sync)
+		std::atomic<u64> query_gpu_waits{0};         // a gather that had to wait for the GPU
+		std::atomic<u64> query_hint_flushes{0};      // zcull_sync / conditional render hints that submitted the work
+		std::atomic<u64> query_slot_exhaustions{0};  // the visibility pool was full (ZCULL sync, then exact folding)
+		std::atomic<u64> query_folded_segments{0};
+
+		// MSAA (MTLResolve.cpp)
+		std::atomic<u64> msaa_surfaces{0};
+		std::atomic<u64> resolves{0};
+		std::atomic<u64> unresolves{0};
+		std::atomic<u64> resolve_failures{0};        // no pipeline for the format: not executed, counted
+		std::atomic<u64> msaa_allocation_failures{0};
+		std::atomic<u64> msaa_feedback_direct{0};    // a multisampled attachment sampled in its own pass, no snapshot
+
+		// Conversion kernels (MTLComputeTasks.cpp)
+		std::atomic<u64> compute_dispatches{0};
+		std::atomic<u64> compute_failures{0};        // kernel or pipeline unavailable: not executed, counted
+		std::atomic<u64> typeless_conversions{0};    // VK copy_image_typeless through the kernels (MTLTypelessCopy.cpp)
+		std::atomic<u64> tile_decodes{0};            // tiled guest memory detiled by the tile decoder (VK detile_memory_block)
+
+		// Native overlays (MTLOverlays.cpp)
+		std::atomic<u64> overlay_frames{0};
+		std::atomic<u64> overlay_views{0};
+		std::atomic<u64> overlay_draws{0};
+		std::atomic<u64> overlay_failures{0};        // the overlay pipeline is unavailable: views not drawn, counted
+	};
+
+	m4_counters& get_m4_counters() noexcept;
+
+	// One log line per kind of failure for the whole run; the counters keep counting.
+	enum class m4_failure : u32
+	{
+		query_slots_exhausted,
+		resolve_pipeline,
+		msaa_allocation,
+		compute_library,
+		compute_pipeline,
+		overlay_pipeline,
+		tiling_library,
+		count
+	};
+
+	// True the first time `kind` is reported.
+	bool m4_first_failure(m4_failure kind) noexcept;
+
+	inline void m4_count(std::atomic<u64>& counter, u64 amount = 1) noexcept
+	{
+		counter.fetch_add(amount, std::memory_order_relaxed);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Math.h b/rpcs3/Emu/RSX/Metal/MTLM4Math.h
new file mode 100644
index 0000000..0162fec
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Math.h
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the arithmetic of the M4 GPU kernels, written once and compiled twice.
+//
+// MTL_M4_DUAL_SOURCE(name, code) compiles `code` as C++ in mtl::m4_math (the host unit test calls it) and keeps the
+// very same tokens as text in mtl::m4_source::name, which MTLM4Shaders.h places in the Metal Shading Language
+// libraries the renderer compiles at runtime. Every function is the Vulkan renderer's GLSL on scalars, operator for
+// operator:
+//   - conversion_math: Program/GLSLSnippets/ShuffleBytes.glsl (byte swaps, D24 <-> F32 depth) and the interleave and
+//     e4m12 conversion kernels of VKCompute.h / VKCompute.cpp;
+//   - resolve_math: the coordinate and sample-index math of Program/MSAA/*ResolvePass.glsl and *UnresolvePass.glsl;
+//   - tiling_math: the RSX tile addressing of Program/GLSLSnippets/RSXMemoryTiling.glsl (the tile decoder).
+// Only the two bit casts differ by language (std::bit_cast here, as_type<> in MSL). The code must stay a subset that
+// means the same in C++ and in MSL: 32-bit unsigned/signed integers, float, no vectors, no preprocessor lines.
+// The stringized text loses its line breaks, so the code holds no // comments.
+
+#include <bit>
+#include <cstdint>
+#include <string_view>
+
+#define MTL_M4_DUAL_SOURCE(name, ...) \
+	namespace mtl::m4_math \
+	{ \
+		__VA_ARGS__ \
+	} \
+	namespace mtl::m4_source \
+	{ \
+		inline constexpr std::string_view name = #__VA_ARGS__; \
+	}
+
+namespace mtl::m4_math
+{
+	using uint = std::uint32_t;
+	static_assert(sizeof(float) == 4);
+
+	// floatBitsToUint / uintBitsToFloat
+	inline uint m4_as_uint(float value) { return std::bit_cast<uint>(value); }
+	inline float m4_as_float(uint value) { return std::bit_cast<float>(value); }
+}
+
+namespace mtl::m4_source
+{
+	// The MSL definitions of the two bit casts.
+	inline constexpr std::string_view bit_casts =
+		"inline uint m4_as_uint(float value) { return as_type<uint>(value); }\n"
+		"inline float m4_as_float(uint value) { return as_type<float>(value); }\n";
+}
+
+// ShuffleBytes.glsl macros (bswap_u16, bswap_u32, bswap_u16_u32, d24_to_f32, f32_to_d24, d24f_to_f32, f32_to_d24f,
+// d24x8_to_f32, d24x8_to_d24x8_swapped, f32_to_d24x8_swapped), the gather/scatter work kernels of
+// cs_gather_d24x8 / cs_gather_d32x8 / cs_scatter_d24x8 / cs_scatter_d32x8 (VKCompute.h, VKCompute.cpp) and the e4m12
+// helpers of cs_fconvert_task (unpack_e4m12_pack16, pack_e4m12_pack16), per component.
+MTL_M4_DUAL_SOURCE(conversion_math,
+	inline uint m4_bswap_u16(uint bits) { return (bits & 0xFF) << 8 | (bits & 0xFF00) >> 8 | (bits & 0xFF0000) << 8 | (bits & 0xFF000000) >> 8; }
+	inline uint m4_bswap_u32(uint bits) { return (bits & 0xFF) << 24 | (bits & 0xFF00) << 8 | (bits & 0xFF0000) >> 8 | (bits & 0xFF000000) >> 24; }
+	inline uint m4_bswap_u16_u32(uint bits) { return (bits & 0xFFFF) << 16 | (bits & 0xFFFF0000) >> 16; }
+
+	inline uint m4_d24_to_f32(uint bits) { return m4_as_uint(float(bits) / 16777215.f); }
+	inline uint m4_f32_to_d24(uint bits) { return uint(m4_as_float(bits) * 16777215.f); }
+	inline uint m4_d24f_to_f32(uint bits) { return (bits << 7); }
+	inline uint m4_f32_to_d24f(uint bits) { return (bits >> 7); }
+	inline uint m4_d24x8_to_f32(uint bits) { return m4_d24_to_f32(bits >> 8); }
+	inline uint m4_d24x8_to_d24x8_swapped(uint bits) { return (bits & 0xFF00) | (bits & 0xFF0000) >> 16 | (bits & 0xFF) << 16; }
+	inline uint m4_f32_to_d24x8_swapped(uint bits) { return m4_d24x8_to_d24x8_swapped(m4_f32_to_d24(bits)); }
+
+	inline uint m4_stencil_shift(uint index) { return (index % 4) * 8; }
+	inline uint m4_gather_stencil(uint stencil_word, uint index) { return (stencil_word >> m4_stencil_shift(index)) & 0xFF; }
+	inline uint m4_gather_d24x8(uint depth_word, uint stencil_word, uint index) { return ((depth_word & 0x00FFFFFF) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_gather_d32x8(uint depth_word, uint stencil_word, uint index) { return (m4_f32_to_d24(depth_word) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_gather_d32fx8(uint depth_word, uint stencil_word, uint index) { return (m4_f32_to_d24f(depth_word) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_scatter_d24(uint value) { return (value >> 8); }
+	inline uint m4_scatter_d32(uint value) { return m4_d24_to_f32(value >> 8); }
+	inline uint m4_scatter_d32f(uint value) { return m4_d24f_to_f32(value >> 8); }
+	inline uint m4_scatter_stencil(uint value, uint index) { return (value & 0xFF) << m4_stencil_shift(index); }
+
+	inline uint m4_unpack_e4m12_lo(uint value) { return ((value & 0xFFFF) << 11) + (120 << 23); }
+	inline uint m4_unpack_e4m12_hi(uint value) { return (((value >> 16) & 0xFFFF) << 11) + (120 << 23); }
+	inline uint m4_pack_e4m12_pack16(uint x, uint y) { return (((x - (120 << 23)) >> 11) & 0xFFFF) | (((y - (120 << 23)) >> 11) << 16); }
+)
+
+// Program/MSAA: the resolve passes map each texel of the single-sampled image (the samples side by side) to a pixel
+// and a sample of the multisampled image; the unresolve passes map each sample back. int as in the GLSL (ivec2).
+MTL_M4_DUAL_SOURCE(resolve_math,
+	inline int m4_resolve_source(int resolve_coord, int samples) { return resolve_coord / samples; }
+	inline int m4_resolve_sample_index(int resolve_x, int resolve_y, int samples_x, int samples_y) { return (resolve_x % samples_x) + ((resolve_y % samples_y) * samples_y); }
+	inline int m4_unresolve_target_x(int pixel_x, int sample_id, int samples_x) { return (pixel_x * samples_x) + (sample_id % samples_x); }
+	inline int m4_unresolve_target_y(int pixel_y, int sample_id, int samples_x, int samples_y) { return (pixel_y * samples_y) + (sample_id / samples_x); }
+)
+
+// RSXMemoryTiling.glsl do_memory_op and its CPU port Common/tiled_dma_copy.hpp: the offset from the tile base of the
+// texel at (row, col) of a linear region inside an RSX tile, operator for operator. The bank distribution table
+// { 0, 1, 2, 3, 2, 3, 0, 1, 1, 2, 3, 0, 3, 0, 1, 2 } is written as arithmetic (row r of the table adds the 2-bit reversal
+// of r to the column, modulo 4), so that the code holds no array. m4_detile_source is the decoder's gather: for byte
+// linear_byte of the packed linear image (rows image_pitch bytes apart), the byte of the tiled data (which starts
+// tile_rw_offset bytes after the tile base and is tiled_length bytes long) it comes from: the texel's tiled offset plus
+// the byte's place in the texel, as tiled_dma_copy copies a texel's bytes. ~0u for the bytes tiled_dma_copy does not
+// write (outside the image rows, or a texel whose tiled offset is outside the tile): those stay zero.
+MTL_M4_DUAL_SOURCE(tiling_math,
+	inline uint m4_tile_bank_lookup(uint index)
+	{
+		const uint table_row = (index >> 2) & 3;
+		return ((index & 3) + (((table_row & 1) << 1) | (table_row >> 1))) & 3;
+	}
+
+	inline uint m4_tile_offset(uint row, uint col, uint factor, uint num_tiles_per_row, uint tile_base_address, uint tile_address_offset,
+		uint tile_pitch, uint tile_bank, uint image_bpp)
+	{
+		const uint row_offset = (row * tile_pitch) + tile_base_address + tile_address_offset;
+		const uint this_address = row_offset + (col * image_bpp);
+		const uint texel_offset = (this_address - tile_base_address) / 256;
+		const uint tile_x = texel_offset % num_tiles_per_row;
+		const uint tile_y = (texel_offset / num_tiles_per_row) / 64;
+		const uint tile_id = tile_y * num_tiles_per_row + tile_x;
+		const uint tile_selector = (tile_id + (tile_base_address >> 14)) & 0x3ffff;
+		const uint row_address = (tile_selector >> 2) & 0xffff;
+		uint bank_selector = 0;
+		if (factor == 1)
+		{
+			bank_selector = (tile_selector & 3);
+		}
+		else if (factor == 2)
+		{
+			bank_selector = m4_tile_bank_lookup(((tile_selector + ((tile_y & 1) << 1)) & 3) * 4 + (tile_y & 3));
+		}
+		else if (factor >= 4)
+		{
+			bank_selector = m4_tile_bank_lookup((tile_selector & 3) * 4 + (tile_y & 3));
+		}
+		bank_selector = (bank_selector + tile_bank) & 3;
+		uint column_selector = 0;
+		const uint line_offset_in_tile = (texel_offset / num_tiles_per_row) % 64;
+		column_selector |= ((line_offset_in_tile >> 3) & 0x7) << 7;
+		column_selector |= ((this_address >> 5) & 0x7) << 4;
+		column_selector |= ((line_offset_in_tile >> 0) & 0x3) << 2;
+		const uint partition_selector = (((line_offset_in_tile >> 2) & 1) + ((this_address >> 6) & 1)) & 1;
+		uint tile_address = 0;
+		tile_address |= ((row_address >> 0) & 0xFFFF) << 16;
+		tile_address |= ((bank_selector >> 0) & 0x3) << 14;
+		tile_address |= ((column_selector >> 4) & 0x3F) << 8;
+		tile_address |= ((partition_selector >> 0) & 0x1) << 7;
+		tile_address |= ((column_selector >> 2) & 0x3) << 5;
+		tile_address |= ((this_address >> 0) & 0x1F) << 0;
+		tile_address ^= (((tile_address >> 12) ^ ((bank_selector ^ tile_selector) & 1) ^ (tile_address >> 14)) & 1) << 9;
+		tile_address ^= ((tile_address >> 11) & 1) << 10;
+		return tile_address - tile_base_address;
+	}
+
+	inline uint m4_detile_source(uint linear_byte, uint factor, uint num_tiles_per_row, uint tile_base_address, uint tile_size,
+		uint tile_address_offset, uint tile_rw_offset, uint tile_pitch, uint tile_bank, uint image_width, uint image_height,
+		uint image_pitch, uint image_bpp, uint tiled_length)
+	{
+		const uint row = linear_byte / image_pitch;
+		const uint in_row = linear_byte % image_pitch;
+		if (row >= image_height || in_row >= image_width * image_bpp)
+		{
+			return 0xFFFFFFFFu;
+		}
+		const uint tile_base_offset = m4_tile_offset(row, in_row / image_bpp, factor, num_tiles_per_row, tile_base_address, tile_address_offset,
+			tile_pitch, tile_bank, image_bpp);
+		if (tile_base_offset >= tile_size || tile_base_offset < tile_rw_offset)
+		{
+			return 0xFFFFFFFFu;
+		}
+		const uint source = tile_base_offset - tile_rw_offset + (in_row % image_bpp);
+		return (source < tiled_length) ? source : 0xFFFFFFFFu;
+	}
+)
+
+// MSAA configuration (C++ only).
+namespace mtl::msaa
+{
+	// samples_x, samples_y of a sample count: rsx::surface_descriptor::set_spp and VK depth_resolve_base::
+	// update_sample_configuration (2 samples side by side, 4 samples as 2x2). {0, 0} for a count the RSX has not.
+	struct sample_grid
+	{
+		std::uint32_t x = 0;
+		std::uint32_t y = 0;
+	};
+
+	constexpr sample_grid grid_for(std::uint32_t samples)
+	{
+		switch (samples)
+		{
+		case 1: return { 1, 1 };
+		case 2: return { 2, 1 };
+		case 4: return { 2, 2 };
+		default: return { 0, 0 };
+		}
+	}
+
+	// VKRenderTargets.h create_new_surface: a surface has the AA mode's sample count (get_format_sample_count) at the
+	// "Auto" MSAA level, and one sample otherwise.
+	constexpr std::uint32_t host_samples(bool msaa_auto, std::uint32_t rsx_samples)
+	{
+		return msaa_auto ? rsx_samples : 1;
+	}
+
+	// The sample mask a pipeline applies (Vulkan pSampleMask = the RSX mask, for more than one sample), restricted to the
+	// samples that exist; all_samples when it masks nothing (no shader sample mask output is then needed).
+	constexpr std::uint32_t all_samples = 0xffffffffu;
+
+	constexpr std::uint32_t pipeline_sample_mask(std::uint32_t samples, std::uint32_t rsx_mask)
+	{
+		if (samples <= 1 || samples >= 32)
+		{
+			return all_samples;
+		}
+
+		const std::uint32_t existing = (1u << samples) - 1;
+		return ((rsx_mask & existing) == existing) ? all_samples : (rsx_mask & existing);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Renderer.cpp b/rpcs3/Emu/RSX/Metal/MTLM4Renderer.cpp
new file mode 100644
index 0000000..94573e6
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Renderer.cpp
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): the stage M4 parts of the native Metal 4 renderer's lifetime: creation and release of the
+// query buffer, MSAA resolve passes, conversion kernels and overlay renderer, the overlay views of each presented frame,
+// and the COREPROF METAL M4 counters.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/Overlays/overlay_manager.h"
+#include "Emu/system_config.h"
+#include "Emu/system_utils.hpp"
+
+#include <array>
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		std::array<std::atomic<bool>, static_cast<usz>(m4_failure::count)> g_reported_failures{};
+	}
+
+	m4_counters& get_m4_counters() noexcept
+	{
+		static m4_counters s_counters;
+		return s_counters;
+	}
+
+	bool m4_first_failure(m4_failure kind) noexcept
+	{
+		return !g_reported_failures[static_cast<usz>(kind)].exchange(true, std::memory_order_relaxed);
+	}
+}
+
+void MTLGSRender::init_m4_config()
+{
+	// As the Vulkan renderer when MSAA is not disabled: multisampling, alpha to coverage (also at one sample) and alpha to
+	// one (MoltenVK reports it) are the GPU's. Surfaces are multisampled at the "Auto" level (MTLRenderTargets.cpp).
+	const bool msaa_enabled = g_cfg.video.antialiasing_level != msaa_level::none;
+	backend_config.supports_hw_msaa = msaa_enabled;
+	backend_config.supports_hw_a2c = msaa_enabled;
+	backend_config.supports_hw_a2c_1spp = msaa_enabled;
+	backend_config.supports_hw_a2one = msaa_enabled;
+
+	// The native interface (message, save data, trophy and OSK dialogs, notices, the performance overlay). rsx::thread
+	// creates its display manager for the OpenGL and Vulkan renderers only (with the same boot music); the Metal renderer
+	// draws it as well.
+	if (g_cfg.misc.use_native_interface && !m_overlay_manager)
+	{
+		m_overlay_manager = g_fxo->init<rsx::overlays::display_manager>(0);
+		if (!m_overlay_manager)
+		{
+			m_overlay_manager = g_fxo->try_get<rsx::overlays::display_manager>();
+		}
+		else if (g_cfg.misc.play_music_during_boot)
+		{
+			if (const std::string audio_path = rpcs3::utils::get_game_content_path(game_content_type::content_sound); !audio_path.empty())
+			{
+				m_overlay_manager->start_audio(audio_path);
+			}
+		}
+	}
+}
+
+void MTLGSRender::init_m4()
+{
+	init_queries();
+
+	std::string error;
+	if (m_resolver.create(m_commands, m_compiler, error))
+	{
+		mtl::set_msaa_resolver(&m_resolver);
+	}
+	else if (mtl::m4_first_failure(mtl::m4_failure::resolve_pipeline))
+	{
+		// Every resolve or unresolve is then counted as not executed (resolve_failures).
+		rsx_log.error("Metal M4: the MSAA resolve library is unavailable: %s (counted in COREPROF METAL M4)", error);
+	}
+
+	error.clear();
+	const auto write_params = [this](const void* data, u32 size) -> std::pair<mtl::object, u64>
+	{
+		auto& ring = m_rings[ring_push_constants];
+		const usz offset = ring.alloc<32>(size);
+		std::memcpy(ring.map(offset), data, size);
+		return { ring.buffer, offset };
+	};
+
+	if (m_compute_tasks.create(m_device, m_compiler, write_params, error))
+	{
+		mtl::set_compute_tasks(&m_compute_tasks);
+	}
+	else
+	{
+		rsx_log.error("Metal M4: the conversion kernels are unavailable: %s (every task is counted as not executed)", error);
+	}
+
+	if (m_overlay_manager)
+	{
+		error.clear();
+		if (!m_overlay_renderer.create(m_device, m_compiler, !g_cfg.video.disable_msl_fast_math, error) &&
+			mtl::m4_first_failure(mtl::m4_failure::overlay_pipeline))
+		{
+			// The views are then counted and not drawn (overlay_failures); the guest's dialogs keep working.
+			rsx_log.error("Metal M4: the overlay pipeline is unavailable: %s (counted in COREPROF METAL M4)", error);
+		}
+	}
+
+	rsx_log.notice("Metal 4 renderer M4: occlusion queries (%u visibility slots), MSAA %s (resolve passes %s), conversion kernels %s, overlays %s",
+		query_slot_count, backend_config.supports_hw_msaa ? "on" : "off", m_resolver.ready() ? "ready" : "unavailable",
+		m_compute_tasks.ready() ? "ready" : "unavailable", m_overlay_manager ? (m_overlay_renderer.ready() ? "ready" : "unavailable") : "off");
+}
+
+void MTLGSRender::destroy_m4()
+{
+	m_overlay_renderer.destroy(m_commands);
+
+	mtl::set_compute_tasks(nullptr);
+	m_compute_tasks.destroy();
+
+	mtl::set_msaa_resolver(nullptr);
+	m_resolver.destroy(m_commands);
+
+	destroy_queries();
+}
+
+void MTLGSRender::prepare_overlays(const areau& image_area)
+{
+	m_overlay_renderer.clear_prepared();
+
+	if (!m_overlay_manager)
+	{
+		return;
+	}
+
+	// VKGSRender frame cleanup: the images of the overlays that were closed
+	if (m_overlay_manager->has_dirty())
+	{
+		m_overlay_manager->lock_shared();
+
+		std::vector<u32> uids_to_dispose;
+		uids_to_dispose.reserve(m_overlay_manager->get_dirty().size());
+
+		for (const auto& view : m_overlay_manager->get_dirty())
+		{
+			m_overlay_renderer.remove_temp_resources(m_commands, view->uid);
+			uids_to_dispose.push_back(view->uid);
+		}
+
+		m_overlay_manager->unlock_shared();
+		m_overlay_manager->dispose(uids_to_dispose);
+	}
+
+	if (!m_overlay_manager->has_visible())
+	{
+		return;
+	}
+
+	// VKGSRender render_overlays: window-space views cover the drawable, the others the presented image.
+	std::lock_guard lock(*m_overlay_manager);
+
+	const areau display_area = { 0, 0, m_drawable_width, m_drawable_height };
+	for (const auto& view : m_overlay_manager->get_views())
+	{
+		const areau render_area = view->use_window_space ? display_area : image_area;
+		m_overlay_renderer.prepare(m_commands, m_rings[ring_attrib], render_area, m_drawable_width, m_drawable_height, *view.get());
+	}
+
+	mtl::m4_count(mtl::get_m4_counters().overlay_frames);
+}
+
+void MTLGSRender::report_m4_counters()
+{
+	const auto& m = mtl::get_m4_counters();
+	const auto load = [](const std::atomic<u64>& value) { return value.load(std::memory_order_relaxed); };
+
+	rsx_log.notice("COREPROF METAL M4 queries=%llu segments=%llu results=%llu discards=%llu hard_syncs=%llu gpu_waits=%llu hint_flushes=%llu "
+		"slot_exhaustions=%llu folded=%llu slots_free=%u slots_pending=%u | msaa_surfaces=%llu resolves=%llu unresolves=%llu "
+		"resolve_failures=%llu msaa_alloc_failures=%llu msaa_feedback_direct=%llu | compute=%llu compute_failures=%llu typeless_conversions=%llu tile_decodes=%llu | overlay_frames=%llu overlay_views=%llu "
+		"overlay_draws=%llu overlay_failures=%llu",
+		load(m.queries_begun), load(m.query_segments), load(m.query_results), load(m.query_discards), load(m.query_hard_syncs),
+		load(m.query_gpu_waits), load(m.query_hint_flushes), load(m.query_slot_exhaustions), load(m.query_folded_segments),
+		m_query_slots.available(), m_query_slots.pending(),
+		load(m.msaa_surfaces), load(m.resolves), load(m.unresolves), load(m.resolve_failures), load(m.msaa_allocation_failures), load(m.msaa_feedback_direct),
+		load(m.compute_dispatches), load(m.compute_failures), load(m.typeless_conversions), load(m.tile_decodes),
+		load(m.overlay_frames), load(m.overlay_views), load(m.overlay_draws), load(m.overlay_failures));
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Shaders.h b/rpcs3/Emu/RSX/Metal/MTLM4Shaders.h
new file mode 100644
index 0000000..9ae45eb
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Shaders.h
@@ -0,0 +1,379 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the Metal Shading Language libraries of stage M4, compiled at runtime by the MTL4
+// compiler (MTLComputeTasks.cpp, MTLResolve.cpp). Header-only and free of renderer dependencies, so a host tool can
+// write them out for Apple's offline compiler (xcrun metal) and the host unit test can check their text.
+//
+// The arithmetic is MTLM4Math.h (the same tokens the unit test runs as C++). The kernels add what Vulkan gets from the
+// descriptor: every storage-buffer access is bounded by the bound range (`words`), as the Vulkan renderer's robust
+// buffer access bounds it; inside the range each kernel reads and writes exactly what the GLSL kernel does.
+
+#include "MTLM4Math.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+
+namespace mtl::m4_shaders
+{
+	constexpr std::string_view prelude =
+		"#include <metal_stdlib>\n"
+		"using namespace metal;\n\n";
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// Conversion kernels (VKCompute.h). Buffer 0: the data (uint words, bound at the task's data offset), buffer 1: the
+	// parameters, uint4 as the Vulkan push constants params[0] plus the bound length in words:
+	//   shuffles:    x = word count (data_length / 4), w = word count
+	//   interleave:  x = data_length (bytes), y = zeta offset (bytes), z = stencil offset (bytes), w = bound words
+	//   fconvert:    x = source length (bytes), y = source offset, z = destination offset (bytes), w = bound words
+	// The invocation index is ShuffleBytes.glsl linear_invocation_id() with KERNEL_SIZE 1 (MoltenVK's optimal kernel size).
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view compute_kernels = R"(
+inline uint m4_linear_invocation_id(uint3 global_id, uint3 grid_size)
+{
+	return (global_id.y * grid_size.x) + global_id.x;
+}
+
+inline uint m4_load(device uint* data, uint words, uint index)
+{
+	return (index < words) ? data[index] : 0u;
+}
+
+inline void m4_store(device uint* data, uint words, uint index, uint value)
+{
+	if (index < words)
+	{
+		data[index] = value;
+	}
+}
+
+inline void m4_atomic_or(device uint* data, uint words, uint index, uint value)
+{
+	if (index < words)
+	{
+		atomic_fetch_or_explicit((device atomic_uint*)(data + index), value, memory_order_relaxed);
+	}
+}
+
+#define M4_KERNEL_ARGS device uint* data [[buffer(0)]], constant uint4& params [[buffer(1)]], uint3 global_id [[thread_position_in_grid]], uint3 grid_size [[threads_per_grid]]
+
+// cs_shuffle_16, cs_shuffle_32, cs_shuffle_32_16, cs_shuffle_d24x8_f32, cs_shuffle_se_f32_d24x8, cs_shuffle_se_d24x8:
+// value = data[index]; data[index] = f(value);
+#define M4_SHUFFLE_KERNEL(name, function) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= params.x) return; \
+	const uint value = m4_load(data, params.w, index); \
+	m4_store(data, params.w, index, function(value)); \
+}
+
+M4_SHUFFLE_KERNEL(m4_bswap_u16_kernel, m4_bswap_u16)
+M4_SHUFFLE_KERNEL(m4_bswap_u32_kernel, m4_bswap_u32)
+M4_SHUFFLE_KERNEL(m4_bswap_u16_u32_kernel, m4_bswap_u16_u32)
+M4_SHUFFLE_KERNEL(m4_d24x8_to_f32_kernel, m4_d24x8_to_f32)
+M4_SHUFFLE_KERNEL(m4_f32_to_d24x8_swapped_kernel, m4_f32_to_d24x8_swapped)
+M4_SHUFFLE_KERNEL(m4_d24x8_to_d24x8_swapped_kernel, m4_d24x8_to_d24x8_swapped)
+
+inline uint m4_identity(uint value)
+{
+	return value;
+}
+
+// cs_gather_d24x8<_SwapBytes>, cs_gather_d32x8<_SwapBytes, _DepthFloat>
+#define M4_GATHER_KERNEL(name, combine, store_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint z_offset = params.y >> 2; \
+	const uint s_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint depth_word = m4_load(data, params.w, index + z_offset); \
+	const uint stencil_word = m4_load(data, params.w, (index / 4) + s_offset); \
+	m4_store(data, params.w, index, store_transform(combine(depth_word, stencil_word, index))); \
+}
+
+M4_GATHER_KERNEL(m4_gather_d24x8_kernel, m4_gather_d24x8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d24x8_swapped_kernel, m4_gather_d24x8, m4_bswap_u32)
+M4_GATHER_KERNEL(m4_gather_d32x8_kernel, m4_gather_d32x8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d32x8_swapped_kernel, m4_gather_d32x8, m4_bswap_u32)
+M4_GATHER_KERNEL(m4_gather_d32fx8_kernel, m4_gather_d32fx8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d32fx8_swapped_kernel, m4_gather_d32fx8, m4_bswap_u32)
+
+// cs_scatter_d24x8, cs_scatter_d32x8<_DepthFloat>: the stencil words are expected cleared (atomicOr), as in Vulkan.
+#define M4_SCATTER_KERNEL(name, depth_function) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint z_offset = params.y >> 2; \
+	const uint s_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint value = m4_load(data, params.w, index); \
+	m4_store(data, params.w, index + z_offset, depth_function(value)); \
+	m4_atomic_or(data, params.w, (index / 4) + s_offset, m4_scatter_stencil(value, index)); \
+}
+
+M4_SCATTER_KERNEL(m4_scatter_d24x8_kernel, m4_scatter_d24)
+M4_SCATTER_KERNEL(m4_scatter_d32x8_kernel, m4_scatter_d32)
+M4_SCATTER_KERNEL(m4_scatter_d32fx8_kernel, m4_scatter_d32f)
+
+// cs_fconvert_task<f32, f16, _SwapSrc, _SwapDst>: two source words make one destination word.
+#define M4_CONTRACT_KERNEL(name, source_transform, destination_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint in_offset = params.y >> 2; \
+	const uint out_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint src_offset = (index * 2) + in_offset; \
+	const uint dst_offset = index + out_offset; \
+	const uint x = source_transform(m4_load(data, params.w, src_offset)); \
+	const uint y = source_transform(m4_load(data, params.w, src_offset + 1)); \
+	m4_store(data, params.w, dst_offset, destination_transform(m4_pack_e4m12_pack16(x, y))); \
+}
+
+M4_CONTRACT_KERNEL(m4_f32_to_f16_kernel, m4_identity, m4_identity)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_src_kernel, m4_bswap_u32, m4_identity)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_dst_kernel, m4_identity, m4_bswap_u16)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_both_kernel, m4_bswap_u32, m4_bswap_u16)
+
+// cs_fconvert_task<f16, f32, _SwapSrc, _SwapDst>: one source word makes two destination words.
+#define M4_EXPAND_KERNEL(name, source_transform, destination_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint in_offset = params.y >> 2; \
+	const uint out_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint src_offset = index + in_offset; \
+	const uint dst_offset = (index * 2) + out_offset; \
+	const uint x = source_transform(m4_load(data, params.w, src_offset)); \
+	m4_store(data, params.w, dst_offset, destination_transform(m4_unpack_e4m12_lo(x))); \
+	m4_store(data, params.w, dst_offset + 1, destination_transform(m4_unpack_e4m12_hi(x))); \
+}
+
+M4_EXPAND_KERNEL(m4_f16_to_f32_kernel, m4_identity, m4_identity)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_src_kernel, m4_bswap_u16, m4_identity)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_dst_kernel, m4_identity, m4_bswap_u32)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_both_kernel, m4_bswap_u16, m4_bswap_u32)
+)";
+
+	// The kernels, in mtl::compute_kernel order (MTLComputeTasks.h).
+	constexpr std::array<std::string_view, 23> compute_kernel_names =
+	{
+		"m4_bswap_u16_kernel",
+		"m4_bswap_u32_kernel",
+		"m4_bswap_u16_u32_kernel",
+		"m4_d24x8_to_f32_kernel",
+		"m4_f32_to_d24x8_swapped_kernel",
+		"m4_d24x8_to_d24x8_swapped_kernel",
+		"m4_gather_d24x8_kernel",
+		"m4_gather_d24x8_swapped_kernel",
+		"m4_gather_d32x8_kernel",
+		"m4_gather_d32x8_swapped_kernel",
+		"m4_gather_d32fx8_kernel",
+		"m4_gather_d32fx8_swapped_kernel",
+		"m4_scatter_d24x8_kernel",
+		"m4_scatter_d32x8_kernel",
+		"m4_scatter_d32fx8_kernel",
+		"m4_f32_to_f16_kernel",
+		"m4_f32_to_f16_swap_src_kernel",
+		"m4_f32_to_f16_swap_dst_kernel",
+		"m4_f32_to_f16_swap_both_kernel",
+		"m4_f16_to_f32_kernel",
+		"m4_f16_to_f32_swap_src_kernel",
+		"m4_f16_to_f32_swap_dst_kernel",
+		"m4_f16_to_f32_swap_both_kernel",
+	};
+
+	inline std::string compute_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::bit_casts;
+		source += m4_source::conversion_math;
+		source += "\n";
+		source += compute_kernels;
+		return source;
+	}
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// RSX tile decoder (VKCompute.h cs_tile_memcpy<decode>, Program/GLSLSnippets/RSXMemoryTiling.glsl; its CPU port is
+	// Common/tiled_dma_copy.hpp). Its own library, so that the conversion kernels never depend on it. Buffer 0: the data
+	// (uint words, bound at the task's data offset) holding the tiled bytes and the linear output; buffer 1: the 16
+	// parameter words of mtl::tile_decode_params (MTLComputeTasks.h). One invocation per word of the packed linear image:
+	// each of its bytes comes from its texel's tiled address (MTLM4Math.h m4_detile_source), so every texel size and row
+	// length decodes whole (the GLSL kernel decodes 4 / bpp texels per invocation by read-modify-write of shared words,
+	// from its first column), and the bytes tiled_dma_copy does not write are zero, as in the CPU decoder's buffer.
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view tiling_kernels = R"(
+inline uint m4_tiling_invocation_id(uint3 global_id, uint3 grid_size)
+{
+	return (global_id.y * grid_size.x) + global_id.x;
+}
+
+kernel void m4_tile_decode_kernel(device uint* data [[buffer(0)]], constant uint* params [[buffer(1)]],
+	uint3 global_id [[thread_position_in_grid]], uint3 grid_size [[threads_per_grid]])
+{
+	const uint word = m4_tiling_invocation_id(global_id, grid_size);
+	if (word >= params[15])
+	{
+		return;
+	}
+
+	uint value = 0;
+	for (uint byte_index = 0; byte_index < 4; ++byte_index)
+	{
+		const uint source = m4_detile_source((word * 4) + byte_index, params[0], params[1], params[2], params[3], params[4], params[5],
+			params[6], params[7], params[8], params[9], params[10], params[11], params[13]);
+		if (source != 0xFFFFFFFFu)
+		{
+			const uint index = params[12] + source;
+			value |= ((data[index >> 2] >> ((index & 3) * 8)) & 0xFF) << (byte_index * 8);
+		}
+	}
+
+	data[(params[14] >> 2) + word] = value;
+}
+)";
+
+	constexpr std::string_view tile_decode_kernel_name = "m4_tile_decode_kernel";
+
+	inline std::string tiling_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::tiling_math;
+		source += "\n";
+		source += tiling_kernels;
+		return source;
+	}
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// MSAA resolve and unresolve passes (VKResolveHelper, Program/MSAA). Every pass draws the 4-vertex strip of
+	// GenericVSPassthrough.glsl over the whole target; buffer 0 holds the Vulkan push constants (int2 sample_count).
+	// Resolve: each texel of the single-sampled image takes one sample of the multisampled image. Unresolve: each sample
+	// (the pass runs per sample through [[sample_id]], as the Vulkan pass at sample shading rate 1) takes one texel back.
+	// Colour passes are render passes here (Metal has no multisampled storage images): same coordinates, same samples.
+	// Depth and stencil go through the fragment depth and stencil exports (the _EXT passes; Apple GPUs export stencil).
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view resolve_passes = R"(
+struct m4_resolve_params
+{
+	int2 sample_count;
+	int stencil_mask;
+	int reserved;
+};
+
+struct m4_fullscreen_vertex
+{
+	float4 position [[position]];
+};
+
+constant float2 m4_passthrough_positions[4] = { float2(-1., -1.), float2(1., -1.), float2(-1., 1.), float2(1., 1.) };
+
+vertex m4_fullscreen_vertex m4_resolve_vertex(uint vertex_id [[vertex_id]])
+{
+	m4_fullscreen_vertex out;
+	out.position = float4(m4_passthrough_positions[vertex_id % 4], 0., 1.);
+	return out;
+}
+
+struct m4_depth_output
+{
+	float depth [[depth(any)]];
+};
+
+struct m4_depth_stencil_output
+{
+	float depth [[depth(any)]];
+	uint stencil [[stencil]];
+};
+
+inline uint2 m4_resolve_pixel(float4 position, int2 samples)
+{
+	const int2 out_coord = int2(position.xy);
+	return uint2(m4_resolve_source(out_coord.x, samples.x), m4_resolve_source(out_coord.y, samples.y));
+}
+
+inline uint m4_resolve_sample(float4 position, int2 samples)
+{
+	const int2 out_coord = int2(position.xy);
+	return uint(m4_resolve_sample_index(out_coord.x, out_coord.y, samples.x, samples.y));
+}
+
+inline uint2 m4_unresolve_texel(float4 position, uint sample_id, int2 samples)
+{
+	const int2 pixel_coord = int2(position.xy);
+	return uint2(m4_unresolve_target_x(pixel_coord.x, int(sample_id), samples.x),
+		m4_unresolve_target_y(pixel_coord.y, int(sample_id), samples.x, samples.y));
+}
+
+// ColorResolvePass.glsl
+fragment float4 m4_color_resolve(float4 position [[position]], texture2d_ms<float, access::read> multisampled [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	return multisampled.read(m4_resolve_pixel(position, params.sample_count), m4_resolve_sample(position, params.sample_count));
+}
+
+// ColorUnresolvePass.glsl
+fragment float4 m4_color_unresolve(float4 position [[position]], uint sample_id [[sample_id]], texture2d<float, access::read> resolve [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	return resolve.read(m4_unresolve_texel(position, sample_id, params.sample_count));
+}
+
+// DepthResolvePass.glsl
+fragment m4_depth_output m4_depth_resolve(float4 position [[position]], depth2d_ms<float, access::read> fs0 [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	m4_depth_output out;
+	out.depth = fs0.read(m4_resolve_pixel(position, params.sample_count), m4_resolve_sample(position, params.sample_count));
+	return out;
+}
+
+// DepthUnresolvePass.glsl
+fragment m4_depth_output m4_depth_unresolve(float4 position [[position]], uint sample_id [[sample_id]], depth2d<float, access::read> fs0 [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	m4_depth_output out;
+	out.depth = fs0.read(m4_unresolve_texel(position, sample_id, params.sample_count));
+	return out;
+}
+
+// DepthStencilResolvePass.glsl
+fragment m4_depth_stencil_output m4_depth_stencil_resolve(float4 position [[position]], depth2d_ms<float, access::read> fs0 [[texture(0)]],
+	texture2d_ms<uint, access::read> fs1 [[texture(1)]], constant m4_resolve_params& params [[buffer(0)]])
+{
+	const uint2 in_coord = m4_resolve_pixel(position, params.sample_count);
+	const uint sample_index = m4_resolve_sample(position, params.sample_count);
+	m4_depth_stencil_output out;
+	out.depth = fs0.read(in_coord, sample_index);
+	out.stencil = fs1.read(in_coord, sample_index).x;
+	return out;
+}
+
+// DepthStencilUnresolvePass.glsl
+fragment m4_depth_stencil_output m4_depth_stencil_unresolve(float4 position [[position]], uint sample_id [[sample_id]],
+	depth2d<float, access::read> fs0 [[texture(0)]], texture2d<uint, access::read> fs1 [[texture(1)]], constant m4_resolve_params& params [[buffer(0)]])
+{
+	const uint2 pixel_coord = m4_unresolve_texel(position, sample_id, params.sample_count);
+	m4_depth_stencil_output out;
+	out.depth = fs0.read(pixel_coord);
+	out.stencil = fs1.read(pixel_coord).x;
+	return out;
+}
+)";
+
+	inline std::string resolve_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::resolve_math;
+		source += "\n";
+		source += resolve_passes;
+		return source;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp b/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp
new file mode 100644
index 0000000..9e0b043
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M5): the renderer side of the shader and pipeline caches (MTLPipelineCache.h): the RSX
+// program cache on disk (rsx::shaders_cache, as VKGSRender) with its boot precompile, and the Metal 4 pipeline archive.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/rsx_cache.h"
+#include "Emu/RSX/Overlays/Shaders/shader_loading_dialog_native.h"
+#include "Emu/cache_utils.hpp"
+#include "Emu/system_config.h"
+
+namespace
+{
+	// The title's Metal cache directory (trailing separator); empty when the on-disk shader cache is off.
+	std::string metal_cache_directory()
+	{
+		if (g_cfg.video.disable_on_disk_shader_cache)
+		{
+			return {};
+		}
+
+		std::string path = rpcs3::cache::get_ppu_cache();
+		if (path.empty())
+		{
+			return {};
+		}
+		return path + std::string(mtl::pipeline_cache::program_cache_directory);
+	}
+}
+
+void MTLGSRender::open_pipeline_archive()
+{
+	// Before the compiler exists: the compiler captures into the archive's serializer.
+	mtl::pipeline_cache::archive_identity identity;
+	identity.device = m_device_info.name;
+	identity.system = mtl::system_version();
+	m_metal_cache_directory = metal_cache_directory();
+	m_pipeline_archive.open(m_device, m_metal_cache_directory, identity);
+}
+
+void MTLGSRender::create_program_cache()
+{
+	// VKGSRender: rsx::shaders_cache over the program cache, in Metal's own directory with Metal's record version.
+	m_shaders_cache = std::make_unique<shader_cache>(*m_prog_buffer, std::string(mtl::pipeline_cache::program_cache_class),
+		mtl::pipeline_cache::program_cache_version(sizeof(mtl::pipeline_props)), mtl::pipeline_cache::program_cache_directory);
+}
+
+void MTLGSRender::store_program(const mtl::pipeline_props& props, const RSXVertexProgram& vp, const RSXFragmentProgram& fp)
+{
+	// VKGSRender's program cache callback: the program was linked; the record is written by the cache's writer thread.
+	if (m_shaders_cache)
+	{
+		m_shaders_cache->store(props, vp, fp);
+	}
+}
+
+void MTLGSRender::load_program_cache()
+{
+	// VKGSRender::on_init_thread: every record of earlier sessions is built before the first draw, with the native
+	// interface's progress dialog (or the host's, the frame hidden meanwhile).
+	if (!m_shaders_cache)
+	{
+		return;
+	}
+
+	m_pipeline_archive.begin_boot();
+	mtl::set_pipeline_build_origin(mtl::pipeline_build_origin::boot);
+	if (!m_overlay_manager)
+	{
+		m_frame->hide();
+		m_shaders_cache->load(nullptr);
+		m_frame->show();
+	}
+	else
+	{
+		rsx::shader_loading_dialog_native dlg(this);
+		m_shaders_cache->load(&dlg);
+	}
+	mtl::set_pipeline_build_origin(mtl::pipeline_build_origin::draw);
+
+	// What the boot compiled is checkpointed now, by the worker (the Vulkan renderer's NEOSTATION_BUILD266 checkpoint),
+	// unless the emulation stopped during the precompile.
+	m_pipeline_archive.end_boot(!Emu.IsStopped());
+}
+
+void MTLGSRender::close_pipeline_caches()
+{
+	// VKGSRender::on_exit: every record the draws queued reaches disk; then the last archive checkpoint (no pipeline is
+	// built after this point).
+	if (m_shaders_cache)
+	{
+		m_shaders_cache->flush_pending_writes();
+		m_shaders_cache.reset();
+	}
+	m_pipeline_archive.close();
+}
+
+void MTLGSRender::report_m5_counters()
+{
+	const auto load = [](const std::atomic<u64>& value) { return static_cast<unsigned long long>(value.load(std::memory_order_relaxed)); };
+	const auto& p = mtl::get_pipeline_counters();
+	const auto& a = mtl::get_pipeline_archive_counters();
+	const auto& c = mtl::get_pipeline_cache_counters();
+	rsx_log.notice("COREPROF METAL M5 program_cache=%s boot_pipelines=%llu draw_pipelines=%llu archive=%s archive_hits=%llu archive_misses=%llu "
+		"archive_uncaptured=%llu archive_rejected=%llu checkpoints=%llu checkpoint_bytes=%llu checkpoint_failures=%llu archive_unavailable=%llu",
+		m_metal_cache_directory.empty() ? "off" : "on", load(p.boot_pipelines), load(p.draw_pipelines), m_pipeline_archive.state_name(), load(a.hits), load(a.misses),
+		load(a.uncaptured), load(c.rejections), load(c.checkpoints), load(c.checkpoint_bytes), load(c.checkpoint_failures), load(c.unavailable));
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h b/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h
new file mode 100644
index 0000000..2449a50
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the GLSL of the native overlay pipeline (MTLOverlays.h) and its resource contract, for the
+// renderer and for the shader stack host test (GLSL -> SPIR-V -> MSL on the host, then Apple's offline compiler).
+//
+// The sources are the Vulkan renderer's (Program/GLSLSnippets/OverlayRenderVS.glsl, OverlayRenderFS.glsl) with its own
+// replacements (VKOverlays.cpp ui_overlay_renderer::ui_overlay_renderer), then the Metal resource adaptation: the vertex
+// attribute becomes the same 16-byte vertex read from a storage buffer at gl_VertexIndex, the fragment textures move to
+// the fragment descriptor set (MTLShaderTranslator slot contract). Nothing else changes.
+
+#include "MTLCommonDecompiler.h"
+
+#include "Utilities/StrFmt.h"
+#include "Utilities/StrUtil.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace mtl::overlay_shaders
+{
+	constexpr u32 vertex_push_constants_size = 68;    // VK ui_overlay_renderer::vertex_push_constants_size
+	constexpr u32 fragment_push_constants_size = 60;  // VK ui_overlay_renderer::fragment_push_constants_size
+	constexpr u32 push_constants_size = vertex_push_constants_size + fragment_push_constants_size;
+
+	inline constexpr std::string_view vertex_source =
+#include "Emu/RSX/Program/GLSLSnippets/OverlayRenderVS.glsl"
+		;
+
+	inline constexpr std::string_view fragment_source =
+#include "Emu/RSX/Program/GLSLSnippets/OverlayRenderFS.glsl"
+		;
+
+	// The Metal resource adaptation: exact declarations, each expected exactly once.
+	inline constexpr std::string_view vertex_attribute = "layout(location=0) in vec4 in_pos;";
+	inline constexpr std::string_view vertex_storage =
+		"layout(set=0, binding=0, std430) readonly buffer OverlayVertices { vec4 overlay_vertices[]; };\n"
+		"#define in_pos overlay_vertices[gl_VertexIndex]";
+	inline constexpr std::string_view fragment_texture_2d = "layout(set=0, binding=0) uniform sampler2D fs0;";
+	inline constexpr std::string_view fragment_texture_2d_metal = "layout(set=1, binding=0) uniform sampler2D fs0;";
+	inline constexpr std::string_view fragment_texture_array = "layout(set=0, binding=1) uniform sampler2DArray fs1;";
+	inline constexpr std::string_view fragment_texture_array_metal = "layout(set=1, binding=1) uniform sampler2DArray fs1;";
+
+	inline bool replace_once(std::string& text, std::string_view from, std::string_view to, std::string& error)
+	{
+		const usz position = text.find(from);
+		if (position == std::string::npos || text.find(from, position + 1) != std::string::npos)
+		{
+			error = fmt::format("the overlay shader source does not declare '%s' exactly once", from);
+			return false;
+		}
+
+		text.replace(position, from.size(), to);
+		return true;
+	}
+
+	// Empty with `error` set when a source no longer has the declarations the adaptation expects.
+	inline std::string vertex_glsl(std::string& error)
+	{
+		std::string source = fmt::replace_all(std::string(vertex_source),
+		{
+			{ "%preprocessor", "// %preprocessor" },
+			{ "%push_block", "push_constant" }
+		});
+
+		if (!replace_once(source, vertex_attribute, vertex_storage, error))
+		{
+			return {};
+		}
+		return source;
+	}
+
+	inline std::string fragment_glsl(std::string& error)
+	{
+		std::string source = fmt::replace_all(std::string(fragment_source),
+		{
+			{ "%preprocessor", "// %preprocessor" },
+			{ "%push_block_offset", "layout(offset=68)" },
+			{ "%push_block", "push_constant" }
+		});
+
+		if (!replace_once(source, fragment_texture_2d, fragment_texture_2d_metal, error) ||
+			!replace_once(source, fragment_texture_array, fragment_texture_array_metal, error))
+		{
+			return {};
+		}
+		return source;
+	}
+
+	// The resources the translator binds (MTLShaderTranslator.h): buffer 0 the vertices, the push constant block of both
+	// stages at push_constant_buffer_slot (68 bytes of vertex configuration, then the fragment's 60), fs0 / fs1 at texture
+	// slots 0 / 1 with samplers 0 / 1.
+	inline std::vector<glsl::program_input> vertex_inputs()
+	{
+		auto push = glsl::program_input::make(::glsl::glsl_vertex_program, "push_constants", glsl::input_type_push_constant,
+			glsl::binding_set_index_vertex, 0);
+		push.push_constant_size = vertex_push_constants_size;
+		return
+		{
+			glsl::program_input::make(::glsl::glsl_vertex_program, "overlay_vertices", glsl::input_type_storage_buffer,
+				glsl::binding_set_index_vertex, 0),
+			push,
+		};
+	}
+
+	inline std::vector<glsl::program_input> fragment_inputs()
+	{
+		auto push = glsl::program_input::make(::glsl::glsl_fragment_program, "push_constants", glsl::input_type_push_constant,
+			glsl::binding_set_index_fragment, 0);
+		push.push_constant_offset = vertex_push_constants_size;
+		push.push_constant_size = fragment_push_constants_size;
+		return
+		{
+			glsl::program_input::make(::glsl::glsl_fragment_program, "fs0", glsl::input_type_texture, glsl::binding_set_index_fragment, 0),
+			glsl::program_input::make(::glsl::glsl_fragment_program, "fs1", glsl::input_type_texture, glsl::binding_set_index_fragment, 1),
+			push,
+		};
+	}
+}
