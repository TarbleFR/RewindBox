+// SPDX-License-Identifier: MIT
+#ifndef NEOSTATION_STORAGE_ABI_H
+#define NEOSTATION_STORAGE_ABI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Optional HOST service for regenerable SPIR-V CPU bytes only. Never owns
+ * VkShaderModule, GPU memory, guest pages, JIT code or user save data.
+ * Calls on a rendering/compilation thread do no file I/O and never wait for I/O.
+ * A miss (including pending restore) means recompile from the unchanged GLSL.
+ * Each operation is scoped to an immutable session generation. */
+enum { NEOSWAP_STORAGE_ABI = 1, NEOSWAP_STORAGE_KEY_BYTES = 32 };
+enum NeoSwapStorageResult { NS_STORAGE_OK = 0, NS_STORAGE_MISS = 1,
+    NS_STORAGE_BUSY = 2, NS_STORAGE_DISABLED = 3, NS_STORAGE_INVALID = 4 };
+enum NeoSwapStorageEvent { NS_STORAGE_SOURCE_COMPILE = 1,
+    NS_STORAGE_CACHED_MODULE_REJECTED = 2, NS_STORAGE_CPU_COPY_RELEASED = 3 };
+typedef struct NeoSwapStorageView {
+    const uint32_t* words;
+    uint64_t byte_count;
+    void* lease; /* opaque: release exactly once; valid across session stop */
+} NeoSwapStorageView;
+typedef struct NeoSwapStorageAPI {
+    uint32_t struct_size, abi_version;
+    uint64_t (*session)(void); /* zero unless configured for this title */
+    int (*acquire)(uint64_t session, const uint8_t key[32], NeoSwapStorageView*);
+    int (*publish)(uint64_t session, const uint8_t key[32], const uint32_t*, uint64_t);
+    void (*release)(NeoSwapStorageView*);
+    void (*prefetch)(uint64_t session, const uint8_t key[32]);
+    void (*invalidate)(uint64_t session, const uint8_t key[32]);
+    void (*event)(uint64_t session, uint32_t kind, uint64_t bytes);
+} NeoSwapStorageAPI;
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/rpcs3/ios/NeoSwapStorage/VideoBuffer.h b/rpcs3/ios/NeoSwapStorage/VideoBuffer.h
new file mode 100644
index 0000000..3ddea67
--- /dev/null
+++ b/rpcs3/ios/NeoSwapStorage/VideoBuffer.h
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "FrameClient.h"
+// The Core tree places this header under ios/NeoSwapStorage/ next to the
+// borrowed NeoSwap allocator client. Without it (host-side copies, isolated
+// tests) frames keep their ordinary anonymous mappings.
+#if __has_include("../NeoSwapClient.h")
+#include "../NeoSwapClient.h"
+#define NEOSWAP_VIDEO_FRAME_LOANS 1
+#else
+#define NEOSWAP_VIDEO_FRAME_LOANS 0
+#endif
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/imgutils.h>
+}
+#include <algorithm>
+#include <cerrno>
+#include <climits>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace neostation::source_client {
+// The default FFmpeg pool retains freed pixels. Opt-in software VDEC frames
+// instead own anonymous mappings, released by FFmpeg's LAST reference. This
+// changes no codec, threading, timestamps, guest output or hardware frames.
+// When the host NeoSwap allocator admits video-frame loans (kind 4), the
+// mapping is borrowed from relay pages outside the host footprint instead;
+// a refusal keeps the anonymous mapping. The borrowed interval is returned
+// through the same last-reference callback. Loaned bytes are counted apart.
+inline constinit std::atomic<uint64_t> video_mapped_bytes{0},video_mapped_peak{0},video_unmapped_bytes{0};
+inline constinit std::atomic<uint64_t> video_unmap_failures{0};
+inline constinit std::atomic<uint64_t> video_loaned_bytes{0},video_loaned_peak{0},video_loan_returned_bytes{0};
+inline constinit std::atomic<uint64_t> video_loan_release_failures{0};
+inline constexpr uintptr_t video_loan_tag=1; // spans are page multiples; bit 0 marks a NeoSwap loan
+inline void retire_video_mapping(void* opaque,uint8_t* pixels) noexcept {
+    const auto tagged=reinterpret_cast<uintptr_t>(opaque);
+    const auto bytes=tagged&~video_loan_tag;
+    if(tagged&video_loan_tag){
+#if NEOSWAP_VIDEO_FRAME_LOANS
+        const int result=neostation::swap::release(pixels);
+        if(result==NEOSWAP_OK){video_loaned_bytes.fetch_sub(bytes);video_loan_returned_bytes.fetch_add(bytes);return;}
+        if(result!=NEOSWAP_NOT_OWNED){video_loan_release_failures.fetch_add(1);return;} // broker retains the mapping
+#endif
+        video_loan_release_failures.fetch_add(1); // never munmap a loan the broker did not disown
+        return;
+    }
+    if(::munmap(pixels,bytes)==0){video_mapped_bytes.fetch_sub(bytes);video_unmapped_bytes.fetch_add(bytes);}
+    else video_unmap_failures.fetch_add(1);
+}
+inline bool video_mapping_format(const AVCodecContext* ctx,const AVFrame* frame) noexcept {
+    if(!ctx->codec || !(ctx->codec->capabilities&AV_CODEC_CAP_DR1) || ctx->hw_frames_ctx || frame->hw_frames_ctx ||
+       (frame->format!=AV_PIX_FMT_YUV420P && frame->format!=AV_PIX_FMT_YUVJ420P))return false;
+    const int bytes=av_image_get_buffer_size(static_cast<AVPixelFormat>(frame->format),frame->width,frame->height,1);
+    return bytes>=4096 && static_cast<uint64_t>(bytes)<=frame_max_bytes;
+}
+inline int allocate_video_mapping(AVCodecContext* ctx,AVFrame* frame,int flags) noexcept {
+    if(!video_mapping_format(ctx,frame))return avcodec_default_get_buffer2(ctx,frame,flags);
+    for(auto* p:frame->data)if(p)return AVERROR(EINVAL);
+    int width=frame->width,height=frame->height,alignment[AV_NUM_DATA_POINTERS]{};
+    avcodec_align_dimensions2(ctx,&width,&height,alignment);
+    if(width<=0 || height<=0)return AVERROR(EINVAL);
+    int strides[4]{};bool aligned=false;
+    for(unsigned attempt=0;attempt<32;++attempt){
+        const int result=av_image_fill_linesizes(strides,static_cast<AVPixelFormat>(frame->format),width);
+        if(result<0)return result;
+        aligned=true;for(unsigned p=0;p<4;++p)
+            if(strides[p] && (alignment[p]<=0 || strides[p]%alignment[p]))aligned=false;
+        if(aligned)break;
+        const auto increment=static_cast<unsigned>(width)&(~static_cast<unsigned>(width)+1);
+        if(!increment || increment>static_cast<unsigned>(INT_MAX-width))return AVERROR(EINVAL);
+        width+=static_cast<int>(increment);
+    }
+    if(!aligned)return AVERROR(EINVAL);
+    ptrdiff_t pitch[4]={strides[0],strides[1],strides[2],strides[3]};size_t sizes[4]{};
+    const int result=av_image_fill_plane_sizes(sizes,static_cast<AVPixelFormat>(frame->format),height,pitch);
+    if(result<0)return result;
+    const long page_size=::sysconf(_SC_PAGESIZE);if(page_size<=0)return AVERROR(EINVAL);
+    const auto page=static_cast<size_t>(page_size);size_t offsets[4]{},span=0;
+    for(unsigned p=0;p<4;++p)if(sizes[p]){
+        // Page-aligned planes cover all codec SIMD alignment requirements.
+        // Include overread/padding without assuming that visible bytes are allocation bytes.
+        if(alignment[p]>page_size || sizes[p]>(8ULL<<20)-page-64)return AVERROR(EINVAL);
+        offsets[p]=span;const auto charge=(sizes[p]+64+page-1)/page*page;
+        if(charge>(8ULL<<20)-span)return AVERROR(EINVAL);
+        span+=charge;
+    }
+    if(!span)return AVERROR(EINVAL);
+    uint8_t* mapping=nullptr;bool loaned=false;
+#if NEOSWAP_VIDEO_FRAME_LOANS
+    // Page-aligned relay loan; the host refuses (no file, no wait) when the
+    // budget does not admit video frames, and the anonymous mapping is used.
+    if(auto* loan=neostation::swap::try_allocate_kind(NEOSWAP_RPCS3,NEOSWAP_VIDEO_FRAME,span,page)){
+        mapping=static_cast<uint8_t*>(loan);loaned=true;
+    }
+#endif
+    if(!mapping){
+        mapping=static_cast<uint8_t*>(::mmap(nullptr,span,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0));
+        if(mapping==MAP_FAILED)return AVERROR(errno);
+    }
+    const uintptr_t opaque=static_cast<uintptr_t>(span)|(loaned?video_loan_tag:0);
+    auto* buffer=av_buffer_create(mapping,span,retire_video_mapping,reinterpret_cast<void*>(opaque),0);
+    if(!buffer){
+#if NEOSWAP_VIDEO_FRAME_LOANS
+        if(loaned){if(neostation::swap::release(mapping)!=NEOSWAP_OK)video_loan_release_failures.fetch_add(1);}
+        else
+#endif
+        (void)::munmap(mapping,span);
+        return AVERROR(ENOMEM);
+    }
+    if(loaned){
+        const auto live=video_loaned_bytes.fetch_add(span)+span;auto peak=video_loaned_peak.load();
+        while(peak<live && !video_loaned_peak.compare_exchange_weak(peak,live)){}
+    } else {
+        const auto live=video_mapped_bytes.fetch_add(span)+span;auto peak=video_mapped_peak.load();
+        while(peak<live && !video_mapped_peak.compare_exchange_weak(peak,live)){}
+    }
+    frame->buf[0]=buffer;
+    for(unsigned p=0;p<4;++p){frame->linesize[p]=strides[p];frame->data[p]=sizes[p]?mapping+offsets[p]:nullptr;}
+    frame->extended_data=frame->data;return 0;
+}
+}
diff --git a/rpcs3/ios/NeoSwapVulkanBuffer.h b/rpcs3/ios/NeoSwapVulkanBuffer.h
new file mode 100644
index 0000000..112f20b
--- /dev/null
+++ b/rpcs3/ios/NeoSwapVulkanBuffer.h
@@ -0,0 +1,142 @@
+#pragma once
+#include "NeoSwapClient.h"
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <utility>
+
+// Included after vkutils/device.h and memory.h. Only coherent host-visible
+// SYSTEM buffers opt in; images, guest VM, JIT and device-private buffers retain
+// their allocators. The Vulkan extension is queried, never inferred from Metal.
+namespace vk
+{
+class neoswap_buffer_memory final : public memory_block
+{
+    VkDevice m_device;
+    VkDeviceMemory m_memory = VK_NULL_HANDLE;
+    void* m_pointer = nullptr;
+    u64 m_bytes;
+
+public:
+    neoswap_buffer_memory(VkDevice device, u64 bytes)
+        : memory_block(bytes), m_device(device), m_bytes(bytes) {}
+    ~neoswap_buffer_memory() override
+    {
+        // buffer::~buffer destroys VkBuffer first. The renderer's existing
+        // deferred disposal guarantees GPU completion before either destructor.
+        if (m_memory)
+        {
+            vmm_notify_memory_freed(this);
+            vkFreeMemory(m_device, m_memory, nullptr);
+        }
+        if (m_pointer)
+        {
+            const auto result = neostation::swap::release(m_pointer);
+            if (result != NEOSWAP_OK)
+                rsx_log.error("NeoSwap Vulkan loan release failed: %d; broker retains the mapping", result);
+        }
+    }
+    bool import(const render_device& device, u64 alignment, u32 type_bits, u32 access_flags, VkBuffer buffer)
+    {
+        // Identified as a GPU host-visible loan so the host can budget and
+        // report Vulkan imports separately from RSX CPU data. The size gate
+        // (1-256 MiB) is enforced by try_neoswap_buffer before this call.
+        m_pointer = neostation::swap::try_allocate_kind(NEOSWAP_RPCS3, NEOSWAP_GPU_HOST_VISIBLE, m_bytes, alignment);
+        if (!m_pointer) return false;
+
+        // The actual pointer can have stricter memory-type restrictions than
+        // the generic buffer. An empty intersection is a hard refusal.
+        VkMemoryHostPointerPropertiesEXT host{VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
+        if (_vkGetMemoryHostPointerPropertiesEXT(m_device,
+                VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, m_pointer, &host) != VK_SUCCESS) return false;
+        u32 memory_type;
+        if (!device.get_compatible_memory_type(type_bits & host.memoryTypeBits, access_flags, &memory_type)) return false;
+
+        VkMemoryDedicatedAllocateInfo dedicated{VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO};
+        dedicated.buffer = buffer;
+        VkImportMemoryHostPointerInfoEXT host_import{VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT};
+        host_import.pNext = &dedicated;
+        host_import.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+        host_import.pHostPointer = m_pointer;
+        VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        allocation.pNext = &host_import;
+        allocation.allocationSize = m_bytes;
+        allocation.memoryTypeIndex = memory_type;
+        VkDeviceMemory imported = VK_NULL_HANDLE;
+        if (vkAllocateMemory(m_device, &allocation, nullptr, &imported) != VK_SUCCESS) return false;
+        m_memory = imported;
+        // Preserve renderer pool/type budgets and the iOS VRAM diagnostics even
+        // though the backing pages belong to another process rather than VMA.
+        vmm_notify_memory_allocated(this, memory_type, m_bytes, VMM_ALLOCATION_POOL_SYSTEM);
+        return true;
+    }
+    VkDeviceMemory get_vk_device_memory() override { return m_memory; }
+    u64 get_vk_device_memory_offset() override { return 0; }
+    void* map(u64 offset, u64 bytes) override
+    {
+        ensure(offset <= m_bytes && (bytes == VK_WHOLE_SIZE || bytes <= m_bytes - offset));
+        return static_cast<char*>(m_pointer) + offset;
+    }
+    void unmap() override {} // The persistent CPU alias is borrowed, not vkMapMemory.
+};
+
+inline bool try_neoswap_buffer(const render_device& device, const VkBufferCreateInfo& info,
+    u32 access_flags, vmm_allocation_pool pool, VkBuffer& output,
+    std::unique_ptr<memory_block>& output_memory)
+{
+    constexpr u64 MiB = 1024 * 1024;
+    constexpr u32 coherent = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    if (info.size < MiB || info.size > 256 * MiB || pool != VMM_ALLOCATION_POOL_SYSTEM ||
+        (access_flags & coherent) != coherent || info.flags || info.pNext ||
+        !device.get_external_memory_host_support() || !_vkGetMemoryHostPointerPropertiesEXT) return false;
+
+    VkPhysicalDeviceExternalBufferInfo query{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_BUFFER_INFO};
+    query.usage = info.usage;
+    query.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+    VkExternalBufferProperties support{VK_STRUCTURE_TYPE_EXTERNAL_BUFFER_PROPERTIES};
+    vkGetPhysicalDeviceExternalBufferProperties(device.gpu(), &query, &support);
+    if (!(support.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT) ||
+        !(support.externalMemoryProperties.compatibleHandleTypes & query.handleType)) return false;
+
+    VkPhysicalDeviceExternalMemoryHostPropertiesEXT host_limits{
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT};
+    VkPhysicalDeviceProperties2 properties{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+    properties.pNext = &host_limits;
+    vkGetPhysicalDeviceProperties2(device.gpu(), &properties);
+    const u64 host_alignment = host_limits.minImportedHostPointerAlignment;
+    if (!host_alignment || host_alignment > 65536 || (host_alignment & (host_alignment - 1))) return false;
+
+    // All failure paths destroy the buffer before imported memory and its loan.
+    struct candidate
+    {
+        VkDevice device;
+        VkBuffer buffer = VK_NULL_HANDLE;
+        std::unique_ptr<neoswap_buffer_memory> memory;
+        ~candidate() { if (buffer) vkDestroyBuffer(device, buffer, nullptr); }
+    } pending{device, VK_NULL_HANDLE, nullptr};
+    VkExternalMemoryBufferCreateInfo external{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO};
+    external.handleTypes = query.handleType;
+    auto external_info = info;
+    external_info.pNext = &external;
+    VkBuffer created = VK_NULL_HANDLE;
+    if (vkCreateBuffer(device, &external_info, nullptr, &created) != VK_SUCCESS) return false;
+    pending.buffer = created;
+    VkMemoryRequirements required{};
+    vkGetBufferMemoryRequirements(device, pending.buffer, &required);
+    const u64 alignment = std::max<u64>(host_alignment, required.alignment);
+    if (!alignment || alignment > 65536 || (alignment & (alignment - 1)) || required.size < info.size ||
+        required.size > 256 * MiB || required.size > std::numeric_limits<u64>::max() - (alignment - 1)) return false;
+    const u64 bytes = (required.size + alignment - 1) & ~(alignment - 1);
+    if (bytes > 256 * MiB) return false;
+
+    // The pointer-specific intersection in import() honors all original access
+    // flags. An empty intersection always falls back; no vendor workaround.
+    pending.memory = std::make_unique<neoswap_buffer_memory>(device, bytes);
+    if (!pending.memory->import(device, alignment, required.memoryTypeBits, access_flags, pending.buffer)) return false;
+    if (vkBindBufferMemory(device, pending.buffer, pending.memory->get_vk_device_memory(), 0) != VK_SUCCESS) return false;
+
+    output_memory = std::move(pending.memory);
+    output = std::exchange(pending.buffer, VK_NULL_HANDLE);
+    return true;
+}
+} // namespace vk
