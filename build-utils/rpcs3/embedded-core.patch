+bool jit_compiler::try_add_cached(std::unique_ptr<llvm::Module> _module, const std::string& path_dir, jit_cached_object preloaded, jit_cache_outcome& outcome, std::string& error)
+{
+	ObjectCache cache{path_dir, this, true, std::move(preloaded.buffer), &outcome};
+	m_engine->setObjectCache(&cache);
+
+	const auto ptr = _module.get();
+	m_engine->addModule(std::move(_module));
+
+	if (!run_recoverable_llvm([&]()
+	{
+		m_engine->generateCodeForModule(ptr);
+	}, error))
+	{
+		m_engine->setObjectCache(nullptr);
+		if (m_announcer) m_announcer->finalized(false);
+		return false;
+	}
+
+	m_engine->setObjectCache(nullptr);
+
+	for (auto& func : ptr->functions())
+	{
+		// Delete IR to lower memory consumption
+		func.deleteBody();
+	}
+
+	return true;
+}
