+	void emit_freeze_episode(const rpcs3::ios::freeze_episode::report& episode, u64 session, const std::string& top)
+	{
+		const auto signal = rpcs3::ios::signal_trace::summary();
+		ios_core_profiler.notice(
+			"FREEZE_EPISODE %s episode=%llu session=%llu reason=%s outcome=%s no_frames_s=%.3f episode_s=%.3f "
+			"last_flip_age_s=%.3f flips_during=%llu paused_s=%.3f pauses=%u suspended_s=%.3f suspensions=%u loading_s=%.3f "
+			"busiest_cores=%.3f begin_busiest_cores=%.3f top=%s rsx_semaphore_wait=%u rsx_semaphore_stalled=%u "
+			"rsx_semaphore_addr=0x%x rsx_semaphore_expected=0x%x rsx_semaphore_observed=0x%x dump=%u dump_suppressed=%u "
+			"state=%u guest_flips=%llu clock=running_time_excludes_pause_loading_suspension host_menu_and_background=host_journal",
+			rpcs3::ios::freeze_episode::event_name(episode.what), episode.episode, session, episode.reason, episode.outcome,
+			episode.no_frames_s, episode.episode_s, episode.last_flip_age_s, episode.flips_during, episode.paused_s,
+			episode.pauses, episode.suspended_s, episode.suspensions, episode.loading_s, episode.busiest_cores,
+			episode.begin_busiest_cores, top.empty() ? "none" : top, signal.watch.active ? 1u : 0u,
+			signal.watch.stalled ? 1u : 0u, signal.watch.address, signal.watch.expected, signal.watch.observed,
+			episode.dump ? 1u : 0u, episode.dump_suppressed ? 1u : 0u, static_cast<u32>(Emu.GetStatus(false)),
+			m_guest_frames.load(std::memory_order_relaxed));
+	}
