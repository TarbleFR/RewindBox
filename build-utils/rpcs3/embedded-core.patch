diff --git a/rpcs3/ios/IOSTexturePrehash.h b/rpcs3/ios/IOSTexturePrehash.h
new file mode 100644
index 0000000..9ad3b59
--- /dev/null
+++ b/rpcs3/ios/IOSTexturePrehash.h
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// CELL581_TEXTURE_PREHASH: on iOS the texture cache confirms CPU textures by
+// content hash, not page protection. Under "Texture Validation Per FIFO Batch"
+// (CELL559_TEXTURE_EPOCH) a texture is hashed again on its first use after
+// each synchronization point (guest PUT, semaphore acquire, frame end), on the
+// RSX thread. God of War III spends 2.8-10.4 ms of every frame there on build
+// 575 (7-10 GB per 5 s window, 13-17 % of the frame) and its RSX thread limits
+// the frame rate. A frame validates nearly the same textures in nearly the same
+// order as the frame before it. As soon as an epoch starts, a worker thread
+// therefore hashes the ranges the previous frame validated next, ahead of the
+// RSX thread, with the same function (identical results).
+//
+// A result is used only in the epoch it was computed in; the worker reads the
+// epoch before the bytes. Everything the commands of an epoch may read was
+// written before the epoch began, so a hash taken after its start confirms the
+// same data as the RSX thread's own hash would. A section revalidated by an RSX
+// write inside the epoch (CELL573_SCOPED_RSX_WRITES) is hashed by the RSX
+// thread itself. The worker reads RSX local memory, which is never unmapped
+// while the RSX thread runs, and main memory only under a vm range lock (an
+// unmap waits for it; a memory map change in progress makes it skip the range).
+// Whatever the worker has not hashed is hashed by the RSX thread as before.
+//
+// CELL583_PREHASH_PACING (build 581 iPhone logs, God of War III: 56 % of the
+// validations served, 48 % of the worker's bytes never used; Black Ops II, whose
+// SPU threads use 3.4-4.1 cores while its RSX thread uses 0.1-0.5, served 20-28 %):
+// the worker leaves out the ranges the RSX thread has already passed, the RSX thread
+// wakes it halfway through its ranges instead of a 4 ms timeout, and Automatic is
+// God of War III only.
+namespace rpcs3::ios::texture_prehash
+{
+inline std::atomic<bool> enabled{false};
+
+// Shorter ranges are left to the RSX thread.
+constexpr std::uint32_t min_bytes = 64u << 10;
+// Validations recorded per frame; the previous frame's list predicts the next.
+constexpr std::size_t max_sequence = 2048;
+// Recorded validations the worker hashes ahead of the RSX thread.
+constexpr std::size_t lookahead = 64;
+// Results kept (direct mapped, power of two).
+constexpr std::size_t table_size = 4096;
+
+struct result_slot
+{
+	// Even: stable; odd: being written (single writer: the worker).
+	std::atomic<std::uint64_t> seq{0};
+	std::atomic<std::uint64_t> key{0};
+	std::atomic<std::uint64_t> epoch{0};
+	std::atomic<std::uint64_t> hash{0};
+};
+
+inline std::array<result_slot, table_size> table{};
+
+// OPT581 profile counters (process window).
+inline std::atomic<std::uint64_t> hits{0}, misses{0}, hit_bytes{0};
+inline std::atomic<std::uint64_t> worker_hashes{0}, worker_bytes{0}, worker_ticks{0}, worker_skips{0};
+// OPT583 profile counters (process window): ranges the RSX thread passed before the
+// worker reached them (left unhashed), and wakes by the RSX thread's progress.
+inline std::atomic<std::uint64_t> worker_passed{0}, worker_refills{0};
+
+constexpr std::uint64_t make_key(std::uint32_t start, std::uint32_t length) noexcept
+{
+	return start | (std::uint64_t{length} << 32);
+}
+
+constexpr std::size_t slot_of(std::uint64_t key) noexcept
+{
+	return static_cast<std::size_t>((key * 0x9E3779B97F4A7C15ull) >> 52) & (table_size - 1);
+}
+
+// Any thread: the worker's hash of [start, start + length) taken in `epoch`.
+inline bool lookup(std::uint32_t start, std::uint32_t length, std::uint64_t epoch, std::uint64_t& out) noexcept
+{
+	const std::uint64_t key = make_key(start, length);
+	const auto& slot = table[slot_of(key)];
+	const std::uint64_t seq = slot.seq.load(std::memory_order_acquire);
+
+	if (seq & 1)
+	{
+		return false;
+	}
+
+	// Acquire loads: a field the next writer stored brings its odd sequence with it.
+	const std::uint64_t stored_key = slot.key.load(std::memory_order_acquire);
+	const std::uint64_t stored_epoch = slot.epoch.load(std::memory_order_acquire);
+	const std::uint64_t stored_hash = slot.hash.load(std::memory_order_acquire);
+
+	if (slot.seq.load(std::memory_order_relaxed) != seq || stored_key != key || stored_epoch != epoch)
+	{
+		return false;
+	}
+
+	out = stored_hash;
+	return true;
+}
+
+// Worker thread only.
+inline void publish(std::uint32_t start, std::uint32_t length, std::uint64_t epoch, std::uint64_t hash) noexcept
+{
+	const std::uint64_t key = make_key(start, length);
+	auto& slot = table[slot_of(key)];
+	const std::uint64_t seq = slot.seq.load(std::memory_order_relaxed);
+	slot.seq.store(seq + 1, std::memory_order_relaxed);
+	// Release stores: whoever reads one of them also sees the odd sequence before it.
+	slot.key.store(key, std::memory_order_release);
+	slot.epoch.store(epoch, std::memory_order_release);
+	slot.hash.store(hash, std::memory_order_release);
+	slot.seq.store(seq + 2, std::memory_order_release);
+}
+
+// The texture cache's validation hash of guest memory at `src` (Emu/RSX/Common/texture_cache.cpp).
+std::uint64_t range_hash(const void* src, std::uint32_t length) noexcept;
+
+// A validation that hashed or looked up [start, start + length) (any thread).
+void record(std::uint32_t start, std::uint32_t length) noexcept;
+// The texture cache's frame end, after the frame's epoch advance.
+void end_frame() noexcept;
+// Any thread that advanced the validation epoch.
+void on_epoch_advance() noexcept;
+// RSX thread exit: stops and joins the worker and turns the lever off until the next
+// boot resolves it; the next boot's first record() starts a worker again.
+void stop() noexcept;
+}
diff --git a/rpcs3/ios/IOSTextureResidency.h b/rpcs3/ios/IOSTextureResidency.h
new file mode 100644
index 0000000..65acd8e
--- /dev/null
+++ b/rpcs3/ios/IOSTextureResidency.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// CELL573_TEXTURE_RESIDENCY: on iOS the texture cache confirms CPU textures by
+// content hash, not page protection, so a guest write to their memory never
+// faults. A texture whose memory the title has reused for other data is found
+// stale only when it is looked up again; one that is never looked up again
+// keeps its GPU image. God of War III streams its levels through the same
+// guest memory: on build 567 the texture pool grew to 1.72 GB (the PS3 has
+// 512 MB in all), fell to 366 MB when the memory-pressure reclaim purged it,
+// and grew back to 1.56 GB within 75 s. While the live texture bytes exceed
+// `soft_cap_bytes`, idle sections are released, at most `max_bytes_per_pass`
+// per pass, one pass every `pass_interval` frames: first those overlapped by a
+// section used after them that extends past them, whose guest memory holds
+// other data now, once idle for `min_idle_frames_superseded` frames; then the
+// least recently used of those no lookup has used for `min_idle_frames`.
+// Bound textures are never released. A released texture the title samples
+// again is uploaded from guest memory as on its first use.
+namespace rpcs3::ios::texture_residency
+{
+inline std::atomic<bool> enabled{false};
+// Frames presented since boot, advanced by the texture cache's frame end.
+inline std::atomic<std::uint64_t> frame{1};
+
+constexpr std::uint64_t soft_cap_bytes = 768ull << 20;
+constexpr std::uint64_t min_idle_frames = 64;
+constexpr std::uint64_t min_idle_frames_superseded = 8;
+constexpr std::uint64_t pass_interval = 16;
+constexpr std::uint64_t max_bytes_per_pass = 128ull << 20;
+
+inline std::uint64_t current_frame() noexcept
+{
+	return frame.load(std::memory_order_relaxed);
+}
+
+inline void advance_frame() noexcept
+{
+	frame.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline bool pass_due() noexcept
+{
+	return enabled.load(std::memory_order_relaxed) && current_frame() % pass_interval == 0;
+}
+
+inline bool idle(std::uint64_t last_use, std::uint64_t now, bool superseded = false) noexcept
+{
+	return last_use <= now && now - last_use >= (superseded ? min_idle_frames_superseded : min_idle_frames);
+}
+
+template <typename Section>
+struct candidate
+{
+	std::uint64_t last_use = 0;
+	std::uint64_t bytes = 0;
+	Section section{};
+	// Overlapped by a section used after it that extends past it.
+	bool superseded = false;
+};
+
+// Moves the candidates to release to the front and returns their count: only
+// idle ones, superseded first, then least recently used first, until
+// `excess_bytes` (at most `max_bytes_per_pass`) are covered.
+template <typename Section>
+std::size_t select(std::vector<candidate<Section>>& candidates, std::uint64_t now, std::uint64_t excess_bytes)
+{
+	const auto idle_end = std::partition(candidates.begin(), candidates.end(), [now](const candidate<Section>& c)
+	{
+		return idle(c.last_use, now, c.superseded);
+	});
+
+	std::stable_sort(candidates.begin(), idle_end, [](const candidate<Section>& a, const candidate<Section>& b)
+	{
+		return a.superseded != b.superseded ? a.superseded : a.last_use < b.last_use;
+	});
+
+	const std::uint64_t target = std::min(excess_bytes, max_bytes_per_pass);
+	std::uint64_t covered = 0;
+	std::size_t count = 0;
+
+	for (auto it = candidates.begin(); it != idle_end && covered < target; ++it, ++count)
+	{
+		covered += it->bytes;
+	}
+
+	return count;
+}
+}
+
+// CELL573_SCOPED_RSX_WRITES: under "Texture Validation Per FIFO Batch" every
+// guest-memory write by the RSX itself (a render target written back for a
+// CPU read, a render target committed over a range) advanced the global
+// epoch, so the next lookup of every texture hashed it again, wherever it
+// was. God of War III goes through about nine epochs per frame and hashes
+// 6-12 GB of texture data per 5 s window on build 567 (8 ms of its 10 ms
+// texture time per frame). The RSX knows the range it writes: only the
+// sections over it are revalidated. Guest PUT, semaphore acquires, CPU write
+// faults, unmaps and the frame end still advance the global epoch.
+namespace rpcs3::ios::texture_validation_scope
+{
+inline std::atomic<bool> enabled{false};
+}
diff --git a/rpcs3/ios/IOSTextureValidationProfile.h b/rpcs3/ios/IOSTextureValidationProfile.h
new file mode 100644
index 0000000..76aa301
--- /dev/null
+++ b/rpcs3/ios/IOSTextureValidationProfile.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rpcs3::ios::texture_validation
+{
+// Fixed 32-byte observations, outside all PPU/SPU code-generation inputs.
+// Frame-end maintenance covers all validation sizes; its time overlaps the
+// existing hash measurements, not an extra cost. No new per-hash observation.
+inline std::atomic<std::uint64_t> trim_calls{0}, trim_sections{0};
+inline std::atomic<std::uint64_t> trim_bytes{0}, trim_ticks{0};
+// CELL559_DIRTY_HASH_SKIP: dirty hashed sections released without hashing.
+inline std::atomic<std::uint64_t> dirty_releases{0}, dirty_release_bytes{0};
+
+// CELL559_TEXTURE_EPOCH: "Texture Validation Per FIFO Batch". A clean section
+// whose hash matched stays validated until the next synchronization point:
+// new commands made visible by the guest (PUT), a semaphore acquire, an RSX
+// write, flush or invalidation of guest memory, or the end of a frame. Guest
+// data a command needs is written before that command becomes visible, or
+// before the semaphore the RSX waits for is released; only an unsynchronized
+// write racing the RSX can be seen one batch later. Disabled: epoch 0, every
+// validation hashes as before.
+inline std::atomic<bool> epoch_enabled{false};
+inline std::atomic<std::uint64_t> validation_epoch{1};
+inline std::atomic<std::uint64_t> epoch_skips{0}, epoch_skip_bytes{0}, epoch_bumps{0};
+
+inline std::uint64_t current_epoch() noexcept
+{
+	return epoch_enabled.load(std::memory_order_relaxed) ? validation_epoch.load(std::memory_order_acquire) : 0;
+}
+
+// CELL581_TEXTURE_PREHASH: wakes the texture pre-validation worker while it runs
+// (ios/IOSTexturePrehash.h); called after the epoch has advanced.
+inline std::atomic<void (*)() noexcept> epoch_listener{nullptr};
+
+inline void advance_epoch() noexcept
+{
+	if (epoch_enabled.load(std::memory_order_relaxed))
+	{
+		validation_epoch.fetch_add(1, std::memory_order_acq_rel);
+		epoch_bumps.fetch_add(1, std::memory_order_relaxed);
+
+		if (const auto listener = epoch_listener.load(std::memory_order_relaxed))
+		{
+			listener();
+		}
+	}
+}
+}
diff --git a/rpcs3/ios/IOSThreadQoS.h b/rpcs3/ios/IOSThreadQoS.h
new file mode 100644
index 0000000..0f2f94b
--- /dev/null
+++ b/rpcs3/ios/IOSThreadQoS.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+
+// CELL567_THREAD_QOS: iOS schedules threads by QoS class and, within a class,
+// by relative priority (0 down to QOS_MIN_RELATIVE_PRIORITY, -15). RPCS3 raises
+// the RSX thread and the two audio threads "above other threads" (priority +1)
+// and lowers compilers and loggers (-1); on iOS +1 and the default 0 were the
+// same user-interactive class at relative priority 0, so the RSX thread had no
+// precedence over the SPU and PPU threads when they oversubscribe the two
+// performance cores (God of War III on build 565: about 4.7 cores requested,
+// RSX FIFO 85-90 % busy at 0.57 core). Threads that ask for nothing now run one
+// step below the raised ones in the same class.
+//
+// The native worker pool also reuses threads: a worker that ran a thread which
+// lowered itself (shader cache writer: set_native_priority(-1), never restored)
+// kept the utility class for the next thread it ran, an SPU or PPU thread for
+// instance. Each job now starts at the default level.
+namespace rpcs3::ios::thread_qos
+{
+// Relative priority of threads that request no priority while the ordering is on.
+constexpr int lowered_relative_priority = -2;
+inline std::atomic<int> default_relative_priority{0};
+
+struct level
+{
+	bool utility;           // QOS_CLASS_UTILITY instead of QOS_CLASS_USER_INTERACTIVE
+	int relative_priority;  // pthread_set_qos_class_self_np's relative priority
+};
+
+// thread_ctrl::set_native_priority(priority); 0 is also every pooled job's start.
+inline level for_priority(int priority) noexcept
+{
+	if (priority < 0)
+	{
+		return {true, 0};
+	}
+
+	if (priority > 0)
+	{
+		return {false, 0};
+	}
+
+	return {false, default_relative_priority.load(std::memory_order_relaxed)};
+}
+}
diff --git a/rpcs3/ios/IOSTitleLevers.h b/rpcs3/ios/IOSTitleLevers.h
new file mode 100644
index 0000000..4d0bcdd
--- /dev/null
+++ b/rpcs3/ios/IOSTitleLevers.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <string_view>
+
+// CELL575_TITLE_LEVERS: titles whose build 567 logs show the bottleneck an
+// existing lever removes, so that lever's Automatic mode includes them.
+// - Call of Duty: Black Ops II (SPU and RSX bound, accurate reservations on):
+//   3.5-10 million failed SPU PUTLLC per 5 s window (the no-op write-back
+//   pattern of Dragon Ball Z before 565), and 9-16 ms of texture preparation
+//   per frame at about 5,270 draws, every texture lookup hashing again.
+// - Bladestorm: The Hundred Years' War (30 fps, main PPU thread 18.8 ms per
+//   frame): an RSX thread at 0.66 core for a FIFO busy 31 % of the time, and
+//   7.4 ms of texture preparation per frame.
+// Only serials seen in those logs or in the shipped catalogue are listed.
+//
+// CELL585_EARLY_SUBMIT_GOW3: God of War III (the six serials of
+// is_god_of_war_iii_title) joins Dragon Ball Z in the Automatic mode of early
+// command buffer submission (561). Its build 583 logs show Dragon Ball Z's
+// pattern before 561: the guest reads one 1280x720x4 render target back every
+// frame (one READBACK555 fault_read per frame, 3.69 MB each) and waits for the
+// GPU, 2.1-6.7 ms per frame and 0.8-1.06 s per 5 s window in the ~700-draw
+// scenes, with Multithreaded RSX on.
+//
+// CELL587_MVK_ENCODE_BARRIER: God of War III is the Automatic title of
+// asynchronous MoltenVK submits (ios/IOSMoltenVKExec.h, IOSMoltenVKAsyncCanary.h).
+// Its build 583 logs spend 490-640 ms per 5 s window in vkQueueSubmit (1,200-2,500
+// submits, RSXSYNC551 submit=), the Metal encoding of synchronous submits, on the
+// RSX offloader thread that the RSX thread waits for at each submission.
+//
+// CELL589_TITLE_LEVERS: Assassin's Creed joins the texture validation epoch
+// (559) and the scoped revalidation (573), the two levers of Black Ops II and
+// Bladestorm (575). Its first build 585 run (BLES00158) is bound by the RSX
+// thread in the game scenes (10-29 fps; RSX thread 0.4-0.8 core, FIFO busy
+// 70-96 %) at 1,000-3,300 draws per frame, with 14-45 ms of texture
+// preparation per frame (RSXFRAME551 texture_ms) and no epoch (OPT559
+// texture_epoch=0): every texture lookup hashing again.
+// Serials of the shipped cheat catalogue (BLES00158, BLUS30089).
+namespace rpcs3::ios::title_levers
+{
+constexpr bool is_black_ops_ii_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES01717";
+}
+
+constexpr bool is_bladestorm_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES00113" || title_id == "BLUS30070";
+}
+
+constexpr bool is_assassins_creed_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES00158" || title_id == "BLUS30089";
+}
+}
diff --git a/rpcs3/ios/NeoStationSavestateIO.h b/rpcs3/ios/NeoStationSavestateIO.h
new file mode 100644
index 0000000..d6f54a1
--- /dev/null
+++ b/rpcs3/ios/NeoStationSavestateIO.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <utility>
+#include <zstd.h>
+
+namespace neostation::savestate
+{
+// Same lossless ZSTD format as existing savestates. Trade some disk space for
+// shorter capture pauses and less compression work on mobile CPUs.
+inline constexpr int compression_level = 3;
+
+struct decoder_context
+{
+    ZSTD_DCtx* m_zd = nullptr;
+    decoder_context() = default;
+    decoder_context(const decoder_context&) = delete;
+    decoder_context& operator=(const decoder_context&) = delete;
+    ~decoder_context() { reset(); }
+    void reset() noexcept
+    {
+        // ZSTD_freeDCtx returns zero on success; it is not a Boolean predicate.
+        static_cast<void>(ZSTD_freeDCtx(std::exchange(m_zd, nullptr)));
+    }
+};
+
+template <typename Write>
+bool write_complete(Write&& write, const void* data, std::size_t size)
+{
+    const auto* bytes = static_cast<const unsigned char*>(data);
+    while (size)
+    {
+        const auto written = write(bytes, size);
+        if (!written || written > size) return false;
+        bytes += written;
+        size -= written;
+    }
+    return true;
+}
+}
diff --git a/rpcs3/ios/NeoStationSavestateStatus.h b/rpcs3/ios/NeoStationSavestateStatus.h
new file mode 100644
index 0000000..006640b
--- /dev/null
+++ b/rpcs3/ios/NeoStationSavestateStatus.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace neostation::savestate
+{
+enum class phase : std::uint32_t
+{
+    idle = 0, preparing = 1, writing = 2, restarting = 3,
+    succeeded = 4, failed = 5,
+};
+
+struct snapshot
+{
+    phase state;
+    bool active;
+    bool committed;
+    std::uint32_t slot; // NEOSTATION_SAVESTATE_SLOTS_V2: 0=rolling, 1..10=user slot
+    std::string message;
+};
+
+class operation
+{
+    mutable std::mutex mutex;
+    snapshot value{phase::idle, false, false, 0, {}};
+public:
+    bool begin(std::uint32_t slot = 0)
+    {
+        std::lock_guard lock(mutex);
+        if (value.active || slot > 10) return false;
+        value = {phase::preparing, true, false, slot, {}};
+        return true;
+    }
+    snapshot read() const
+    {
+        std::lock_guard lock(mutex);
+        return value;
+    }
+    void advance(phase state)
+    {
+        std::lock_guard lock(mutex);
+        if (value.active) value.state = state;
+    }
+    void error(std::string message)
+    {
+        std::lock_guard lock(mutex);
+        if (value.active) value.message = std::move(message);
+    }
+    void record_write(bool committed)
+    {
+        std::lock_guard lock(mutex);
+        if (!value.active) return;
+        value.committed = committed;
+        if (!committed && value.message.empty())
+            value.message = "RPCS3 could not finish writing the savestate. The previous savestates were not replaced.";
+    }
+    void finish(bool success, std::string fallback = {})
+    {
+        std::lock_guard lock(mutex);
+        if (!value.active) return;
+        value.state = success ? phase::succeeded : phase::failed;
+        value.active = false;
+        if (!success && value.message.empty()) value.message = std::move(fallback);
+    }
+};
+
+inline operation current;
+}
diff --git a/rpcs3/ios/NeoSwap.h b/rpcs3/ios/NeoSwap.h
new file mode 100644
index 0000000..79d7cef
--- /dev/null
+++ b/rpcs3/ios/NeoSwap.h
@@ -0,0 +1,80 @@
+#ifndef NEOSTATION_NEOSWAP_H
+#define NEOSTATION_NEOSWAP_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* NeoSwap v1: explicitly opted-in CPU data, not kernel swap or GPU memory.
+ * One broker per HOST PROCESS. Clients borrow the immutable vtable for the
+ * lifetime of their allocations. No function may be called from a signal
+ * handler or a real-time audio callback. Never pass an arbitrary live region.
+ * Caller must quiesce users before releasing or syncing a block.
+ */
+enum { NEOSWAP_ABI = 1, NEOSWAP_OWNER_COUNT = 6 };
+enum NeoSwapOwner {
+    NEOSWAP_RPCS3 = 0, NEOSWAP_DOLPHIN = 1, NEOSWAP_ARMSX2 = 2,
+    NEOSWAP_DUSKLIGHT = 3, NEOSWAP_KARTPAD = 4, NEOSWAP_PROBE = 5
+};
+/* Additive request flag on ABI v1. An older host rejects the unknown kind,
+ * preserving ordinary allocator fallback. Fast requests may only borrow already
+ * mapped RAM and may never wait for a lock, map, donor, relay or file operation. */
+enum NeoSwapKind { NEOSWAP_CPU_DATA = 1, NEOSWAP_CPU_CACHE = 2, NEOSWAP_REQUEST_FAST = 0x40000000u };
+enum NeoSwapResult {
+    NEOSWAP_OK = 0, NEOSWAP_NOT_OWNED = 1,
+    NEOSWAP_DISABLED = -1, NEOSWAP_INVALID = -2, NEOSWAP_QUOTA = -3,
+    NEOSWAP_STORAGE = -4, NEOSWAP_IO = -5, NEOSWAP_MAPPING = -6,
+    NEOSWAP_BUSY = -7, NEOSWAP_TOO_SMALL = -8, NEOSWAP_LIMIT = -9
+};
+typedef struct NeoSwapConfig {
+    uint32_t struct_size, abi_version;
+    uint64_t capacity_bytes, minimum_free_bytes, minimum_allocation_bytes;
+    uint32_t enabled_owner_mask, reserved;
+} NeoSwapConfig;
+typedef struct NeoSwapOwnerStats {
+    uint64_t live_bytes, peak_bytes, allocation_count, rejection_count;
+} NeoSwapOwnerStats;
+typedef struct NeoSwapStats {
+    uint32_t struct_size, abi_version;
+    uint64_t capacity_bytes, live_bytes, peak_bytes, allocated_disk_bytes;
+    uint64_t live_blocks, allocation_count, rejection_count, io_errors;
+    uint64_t allocation_time_us, max_allocation_time_us, minimum_free_bytes;
+    uint32_t enabled_owner_mask;
+    int32_t last_result, last_errno;
+    uint32_t registered_owner_mask;
+    NeoSwapOwnerStats owners[NEOSWAP_OWNER_COUNT];
+} NeoSwapStats;
+typedef struct NeoSwapAPI {
+    uint32_t struct_size, abi_version;
+    int (*allocate)(uint32_t owner, uint32_t kind, uint64_t bytes,
+                    uint64_t alignment, void** address);
+    /* ONLY NOT_OWNED permits a caller to use its ordinary free(). Any other
+     * failure retains ownership and must not be turned into a heap free.
+     * FAST loans: OK transfers cleanup to host maintenance; the pointer must
+     * never be touched again. Mapping/quota remain owned until real retirement. */
+    int (*release)(void* address);
+    int (*sync)(void* address);
+    int (*enabled)(uint32_t owner);
+} NeoSwapAPI;
+#if defined(__GNUC__)
+#define NEOSWAP_PUBLIC __attribute__((visibility("default")))
+#else
+#define NEOSWAP_PUBLIC
+#endif
+NEOSWAP_PUBLIC const NeoSwapAPI* NeoSwap_GetAPI(uint32_t abi_version);
+/* Reconfiguration is atomic; it refuses while any broker block is live. */
+NEOSWAP_PUBLIC int NeoSwap_Configure(const char* private_directory, const NeoSwapConfig* config);
+NEOSWAP_PUBLIC int NeoSwap_Snapshot(NeoSwapStats* stats);
+NEOSWAP_PUBLIC void NeoSwap_RegisterClient(uint32_t owner);
+/* Lock-free display counter, not a residency or OS page-out measurement. */
+NEOSWAP_PUBLIC uint64_t NeoSwap_LiveBytes(uint32_t owner);
+#ifdef NEOSWAP_TESTING
+/* Fault injection is compiled out of deliverable libraries. */
+void NeoSwap_TestWithBrokerLock(void (*callback)(void*), void* context);
+void NeoSwap_TestFailNext(int stage); /* 1=open, 2=reserve, 3=map, 4=unmap, 5=sync */
+int NeoSwap_TestVerifyFile(void* address, const void* expected, size_t bytes);
+#endif
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/rpcs3/ios/NeoSwapClient.h b/rpcs3/ios/NeoSwapClient.h
new file mode 100644
index 0000000..fa17794
--- /dev/null
+++ b/rpcs3/ios/NeoSwapClient.h
@@ -0,0 +1,102 @@
+#pragma once
+#include "NeoSwap.h"
+#include "NeoSwapClientStats.h"
+#include <atomic>
+#include <cstddef>
+
+// Additive allocation kinds carried through the unchanged NeoSwapAPI v1 table.
+// They identify the RPCS3 consumer of a loan for host accounting; an older
+// host rejects them as NEOSWAP_INVALID and the caller keeps its original
+// allocator. Values must match the host's NeoSwapHostKind enumeration.
+enum NeoSwapExtendedKind {
+    NEOSWAP_GPU_HOST_VISIBLE = 3, /* coherent host-visible Vulkan SYSTEM buffers */
+    NEOSWAP_VIDEO_FRAME = 4       /* owned software VDEC frame mappings */
+};
+namespace neostation::swap {
+// Each core stores only a borrowed vtable. The broker itself is compiled once
+// into neo_swap.framework, never into each emulator. No static constructors.
+inline constinit std::atomic<const NeoSwapAPI*> client_api{nullptr};
+inline constinit std::atomic<uint64_t> skipped_small{0}, missing_api{0}, disabled{0};
+inline constinit std::atomic<uint64_t> eligible_attempts{0}, failed_allocations{0}, successful_allocations{0};
+inline constinit std::atomic<int32_t> last_result{NEOSWAP_OK};
+inline int install(const NeoSwapAPI* api) noexcept {
+    if (!api || api->struct_size != sizeof(NeoSwapAPI) || api->abi_version != NEOSWAP_ABI ||
+        !api->allocate || !api->release || !api->sync || !api->enabled) return NEOSWAP_INVALID;
+    const NeoSwapAPI* expected = nullptr;
+    if (!client_api.compare_exchange_strong(expected, api, std::memory_order_acq_rel) && expected != api)
+        return NEOSWAP_BUSY;
+    return NEOSWAP_OK;
+}
+// Explicit-kind request without a size threshold of its own: callers decide
+// eligibility (Vulkan import limits, frame mapping formats) before asking.
+inline void* try_allocate_kind(uint32_t owner, uint32_t kind, size_t bytes, size_t alignment) noexcept {
+    const auto* api = client_api.load(std::memory_order_acquire);
+    if (!api) {
+        missing_api.fetch_add(1, std::memory_order_relaxed);
+        return nullptr;
+    }
+    if (!api->enabled(owner)) {
+        disabled.fetch_add(1, std::memory_order_relaxed);
+        return nullptr;
+    }
+    void* ptr = nullptr;
+    eligible_attempts.fetch_add(1, std::memory_order_relaxed);
+    const int result = api->allocate(owner, kind | NEOSWAP_REQUEST_FAST, bytes, alignment, &ptr);
+    last_result.store(result, std::memory_order_relaxed);
+    if (result == NEOSWAP_OK && ptr) {
+        successful_allocations.fetch_add(1, std::memory_order_relaxed);
+        return ptr;
+    }
+    failed_allocations.fetch_add(1, std::memory_order_relaxed);
+    return nullptr;
+}
+inline void* try_allocate(uint32_t owner, size_t bytes, size_t alignment) noexcept {
+    // Small renderer allocations must not take the broker lock or create files.
+    if (bytes < 1024 * 1024) {
+        skipped_small.fetch_add(1, std::memory_order_relaxed);
+        return nullptr;
+    }
+    return try_allocate_kind(owner, NEOSWAP_CPU_DATA, bytes, alignment);
+}
+// RSX CPU data only. Vulkan retains try_allocate() and its 1 MiB threshold.
+// The host decides whether this title may borrow sub-MiB buffers. A refusal
+// returns to the original aligned heap allocator, never to a per-buffer file.
+inline void* try_allocate_cpu(uint32_t owner, size_t bytes, size_t alignment) noexcept {
+    if (bytes >= 1024 * 1024 || bytes < 64 * 1024)
+        return try_allocate(owner, bytes, alignment);
+    const auto* api = client_api.load(std::memory_order_acquire);
+    if (!api) {
+        missing_api.fetch_add(1, std::memory_order_relaxed);
+        return nullptr;
+    }
+    if (!api->enabled(owner)) {
+        disabled.fetch_add(1, std::memory_order_relaxed);
+        return nullptr;
+    }
+    void* pointer = nullptr;
+    eligible_attempts.fetch_add(1, std::memory_order_relaxed);
+    const int result = api->allocate(owner, NEOSWAP_CPU_CACHE | NEOSWAP_REQUEST_FAST, bytes, alignment, &pointer);
+    last_result.store(result, std::memory_order_relaxed);
+    if (result == NEOSWAP_OK && pointer) {
+        successful_allocations.fetch_add(1, std::memory_order_relaxed);
+        return pointer;
+    }
+    failed_allocations.fetch_add(1, std::memory_order_relaxed);
+    return nullptr;
+}
+inline int snapshot(NeoSwapClientStats* out) noexcept {
+    if (!out || out->struct_size != sizeof(*out) ||
+        out->abi_version != NEOSWAP_CLIENT_STATS_ABI) return NEOSWAP_INVALID;
+    // Relaxed cumulative observations avoid adding locks to renderer threads.
+    *out = {sizeof(*out), NEOSWAP_CLIENT_STATS_ABI,
+        skipped_small.load(std::memory_order_relaxed), missing_api.load(std::memory_order_relaxed),
+        disabled.load(std::memory_order_relaxed), eligible_attempts.load(std::memory_order_relaxed),
+        failed_allocations.load(std::memory_order_relaxed), successful_allocations.load(std::memory_order_relaxed),
+        last_result.load(std::memory_order_relaxed), 0};
+    return NEOSWAP_OK;
+}
+inline int release(void* ptr) noexcept {
+    const auto* api = client_api.load(std::memory_order_acquire);
+    return api ? api->release(ptr) : NEOSWAP_NOT_OWNED;
+}
+}
