+// REWINDBOX_PPU_CHECK_STOP_636: no job starts once stop() holds; the running ones end and are joined.
+template <typename Job, typename Stop>
+void ios_run_link_jobs(std::string_view name, usz count, Job&& job, Stop&& stop)
+{
+	if (count <= 1)
+	{
+		if (count && !stop())
+		{
+			job(0);
+		}
+
+		return;
+	}
+
+	atomic_t<usz> next = 0;
