+// At policy resolution: a title still armed failed its last asynchronous boot. Arming
+// itself waits for the Vulkan instance (arm_moltenvk_async_boot), so a boot that never
+// creates the renderer leaves no record.
+bool resolve_mvk_async(std::string_view title, bool requested)
+{
+	std::lock_guard lock(s_mvk_canary_mutex);
+	s_mvk_canary_title = title;
+	s_mvk_canary_armed = false;
+	s_mvk_canary_confirmed.store(false, std::memory_order_relaxed);
+	s_mvk_canary_flips.store(0, std::memory_order_relaxed);
+
+	// For verdict::run the armed record is not written here (arm_moltenvk_async_boot).
+	auto records = read_mvk_canary();
+	const auto verdict = mvk_async_canary::on_boot(records, title, requested);
+	if (verdict == mvk_async_canary::verdict::previous_boot_failed)
+	{
+		if (!write_mvk_canary(records))
+		{
+			ios_experimental_log.error("MoltenVK asynchronous submits: could not record that the last asynchronous boot of %s did not finish", s_mvk_canary_title);
+		}
+
+		ios_experimental_log.warning("MoltenVK asynchronous submits stay off for %s: its last asynchronous boot did not finish (crash or forced exit)", s_mvk_canary_title);
+	}
+	else if (verdict == mvk_async_canary::verdict::failed_before)
+	{
+		ios_experimental_log.warning("MoltenVK asynchronous submits stay off for %s: an earlier asynchronous boot did not finish", s_mvk_canary_title);
+	}
+
+	s_mvk_canary_verdict = verdict;
+	return verdict == mvk_async_canary::verdict::run;
+}
+
+void confirm_mvk_async_locked(const char* reason)
+{
+	if (!s_mvk_canary_armed || s_mvk_canary_confirmed.load(std::memory_order_relaxed))
+	{
+		return;
+	}
+
+	auto records = read_mvk_canary();
+	if (mvk_async_canary::on_confirm(records, s_mvk_canary_title) && !write_mvk_canary(records))
+	{
+		ios_experimental_log.error("MoltenVK asynchronous submits: could not confirm the boot of %s", s_mvk_canary_title);
+		return;
+	}
+
+	s_mvk_canary_confirmed.store(true, std::memory_order_relaxed);
+	ios_experimental_log.notice("MoltenVK asynchronous submits: boot of %s confirmed (%s)", s_mvk_canary_title, reason);
+}
