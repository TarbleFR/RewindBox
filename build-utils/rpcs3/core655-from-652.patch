diff --git a/rpcs3/ios/IOSInPassReadTransition.h b/rpcs3/ios/IOSInPassReadTransition.h
new file mode 100644
index 0000000..4ac76a8
--- /dev/null
+++ b/rpcs3/ios/IOSInPassReadTransition.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_IN_PASS_READ_TRANSITION_655: Assassin's Creed, IPA 653 (Core 652) device log, gameplay at 24-29 FPS with
+// the GPU 70-78 % busy: 44-53 render passes begin per frame, 13-19 of them on the framebuffer the previous pass ended
+// on (COREPROF RPASS652). vk::change_image_layout ends 28-36 passes per frame, 4-11 of which the next draw begins
+// again on the same framebuffer: an image the next draw samples (a render target rendered earlier, a texture uploaded
+// earlier) changes to SHADER_READ_ONLY_OPTIMAL while the pass is open, and the transition ended the pass. On the Apple
+// GPU every restart stores every attachment of the pass to memory and loads it back.
+//
+// A transition to SHADER_READ_ONLY_OPTIMAL of an image that is not an attachment of the open pass is now recorded
+// inside the pass. Its writer (an earlier pass or copy) is in an earlier Metal encoder: the patched MoltenVK makes
+// the open render encoder wait for the barrier's stage fences, as the next encoder would have after a restart
+// (MVKCmdPipelineBarrier, build-utils/rpcs3/patches/moltenvk-1.4.2-deferred-cache.patch; without a residency set
+// Metal tracks the hazard itself). Kept only when:
+// - the title policy enables it (Automatic: Assassin's Creed) and the linked MoltenVK defines
+//   rbx_mvk_in_pass_read_barrier_waits() (weak reference, checked once per boot);
+// - the transition goes to SHADER_READ_ONLY_OPTIMAL from a color or depth attachment layout or a transfer layout,
+//   with the full access masks of the standard transition and no queue family transfer;
+// - the open pass was begun by the draw path, whose framebuffer attachments are known, and the image is none of them.
+// Anything else ends the pass exactly as before. Counted per window (COREPROF RPASS655).
+extern "C" __attribute__((weak)) int rbx_mvk_in_pass_read_barrier_waits(void);
+
+namespace rpcs3::ios::in_pass_read
+{
+// Resolved once per boot (title policy and the MoltenVK hook); read by the RSX thread.
+inline std::atomic<bool> enabled{false};
+
+inline bool moltenvk_waits_in_pass() noexcept
+{
+	return rbx_mvk_in_pass_read_barrier_waits != nullptr && rbx_mvk_in_pass_read_barrier_waits() >= 1;
+}
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> kept_color{0};       // kept open: COLOR_ATTACHMENT_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
+	std::atomic<std::uint64_t> kept_depth{0};       // kept open: DEPTH_STENCIL_ATTACHMENT_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
+	std::atomic<std::uint64_t> kept_transfer{0};    // kept open: TRANSFER_DST/SRC_OPTIMAL -> SHADER_READ_ONLY_OPTIMAL
+	std::atomic<std::uint64_t> ended_attachment{0}; // read transition of an attachment of the open pass: ended
+	std::atomic<std::uint64_t> ended_unknown{0};    // read transition while the open pass's attachments are unknown: ended
+	std::atomic<std::uint64_t> ended_layout{0};     // read transition from another layout or with other masks/queues: ended
+	std::atomic<std::uint64_t> ended_disabled{0};   // read transition while the lever is off: ended
+	std::atomic<std::uint64_t> ended_other{0};      // transition to another layout with the pass open: ended
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+}
