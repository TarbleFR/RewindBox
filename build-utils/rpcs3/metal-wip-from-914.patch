diff --git a/rpcs3/ios/IOSIdleWindows916.h b/rpcs3/ios/IOSIdleWindows916.h
new file mode 100644
index 0000000..a5b9596
--- /dev/null
+++ b/rpcs3/ios/IOSIdleWindows916.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_IDLE_WINDOWS_916: the 5 s report of a stopped emulation.
+//
+// Build 718, PID 45272: the exported performance journal (1,577,669 bytes, one 2 MiB rotation) holds windows 15 to 64
+// of session 5 and nothing of sessions 1 to 4; windows 18 to 64 were written after the game was stopped (phase=stopped,
+// state=0, every counter 0), 54 lines and about 30 KiB each: 1,442,924 bytes, 91.5 % of the file. Those lines pushed
+// the windows of Black Ops II and Assassin's Creed, the ones the capture was made for, out of the rotation.
+// A stopped window after the first one keeps its FRAMEPROF527 line (the freeze and progress clocks read it) and one
+// COREPROF IDLE916 line; the counters it would have printed are still taken, so the next running window starts clean.
+namespace rpcs3::ios::idle_windows
+{
+struct tracker
+{
+	std::uint32_t consecutive = 0; // stopped windows without a guest flip in a row, this one included
+
+	// True when this window's detail lines are left out: the second and later stopped windows of a row.
+	// The first one is printed in full: it holds what the stop itself did.
+	bool compact(bool stopped_phase, std::uint64_t guest_flips) noexcept
+	{
+		if (!stopped_phase || guest_flips)
+		{
+			consecutive = 0;
+			return false;
+		}
+
+		if (consecutive != ~0u)
+		{
+			consecutive++;
+		}
+
+		return consecutive >= 2;
+	}
+};
+} // namespace rpcs3::ios::idle_windows
diff --git a/rpcs3/ios/IOSSpursRelaxedStore.h b/rpcs3/ios/IOSSpursRelaxedStore.h
new file mode 100644
index 0000000..bc4c6ae
--- /dev/null
+++ b/rpcs3/ios/IOSSpursRelaxedStore.h
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+// REWINDBOX_SPURS_RELAXED_STORE_916: the PUTLLC of an SPU on the two header lines of a SPURS instance, when Accurate SPU
+// Reservations is off.
+//
+// Build 718, Assassin's Creed (BLES00158, accurate_res=false), PID 45272, session 3, stall dump of the stop sequence:
+// the main thread waits for the shutdown of a SPURS workload (semaphore _spuWkL, 6.125 s); the second header line
+// holds wklState1[1] = 3 (shutting down) and sysSrvMsgUpdateWorkload = 0xff, written by the PPU's reservation
+// operation; the first header line holds sysSrvMessage = 0xe0: the plain byte store of 0xff that the PPU makes next,
+// to wake the SPURS kernels, is not in memory, and the five kernels wait for a lost reservation on that line with the
+// line's current reservation time. Upstream's relaxed path stored the whole 128-byte line of a SPURS header from the
+// SPU's local copy once the reservation time was unchanged, without comparing the line: a plain guest store (it does
+// not advance the reservation time) made between the SPU's GETLLAR and its PUTLLC was overwritten by the copy read
+// before it. On the console that store loses the SPU its reservation and the PUTLLC fails.
+//
+// This store never writes a byte the SPU did not change, fails when the line no longer is what GETLLAR read, and when
+// it fails it leaves the line as the guest's own stores made it:
+//   1. the whole line is compared with the GETLLAR copy: any guest store made before this PUTLLC fails it;
+//   2. each 16-byte lane the SPU changed is exchanged against its GETLLAR value (one atomic exchange per lane), in
+//      address order; a lane the SPU did not change is not written;
+//   3. a guest store that reaches a changed lane after step 1: the PUTLLC fails. The lanes it had already stored are
+//      given their GETLLAR value back (an exchange against what it stored; a byte the guest stored into such a lane in
+//      between is kept), so the line ends as GETLLAR read it plus the guest's stores: the order "guest store, then a
+//      PUTLLC that fails", whatever the width of the store. Memory was written for a moment: the caller advances the
+//      reservation time for that outcome too, so no copy of the line read across it passes for unchanged.
+// An earlier form kept such a store beside the SPU's bytes, byte by byte (the order "PUTLLC, then the store"). A store
+// wider than one byte whose bytes partly equalled the ones GETLLAR read could then end split, a value neither side
+// wrote (independent review, 10 November): the PUTLLC is refused instead.
+// What a comparison of data cannot see stays as in every reservation of this emulator: a guest store of the value the
+// byte already had; and, here, a guest store into a lane already stored that writes the very byte this PUTLLC wrote,
+// while that lane is being given back (two guest stores inside one PUTLLC).
+// The caller holds the unique lock of the line's reservation word (other SPUs and PPU reservation stores are excluded
+// and a GETLLAR retries), as before; only plain guest stores can run beside this.
+namespace rpcs3::ios::spurs_relaxed_store
+{
+constexpr std::size_t line_bytes = 128;
+constexpr std::size_t lane_bytes = 16;
+constexpr std::size_t lanes = line_bytes / lane_bytes;
+
+enum class result : std::uint8_t
+{
+	stored,          // every lane the SPU changed holds its bytes
+	refused_changed, // the line was not what GETLLAR read: nothing written
+	refused_undone,  // a guest store reached a changed lane while the line was stored: the lanes already stored were
+	                 // given back. Memory was written: the reservation time must advance
+};
+
+inline std::atomic<std::uint64_t> stored_count{0}, undone_count{0}, refused_count{0};
+
+struct lane_t
+{
+	unsigned char bytes[lane_bytes];
+};
+
+// exchange(memory_lane, expected, desired): one atomic 16-byte compare-and-exchange on guest memory; on failure
+// `expected` receives the lane as memory holds it (the contract of atomic_storage<u128>::compare_exchange).
+template <typename Exchange>
+result store(unsigned char* memory, const unsigned char* getllar, const unsigned char* to_write, Exchange&& exchange) noexcept
+{
+	if (std::memcmp(memory, getllar, line_bytes) != 0)
+	{
+		refused_count.fetch_add(1, std::memory_order_relaxed);
+		return result::refused_changed;
+	}
+
+	unsigned written = 0; // one bit per lane stored
+
+	for (std::size_t lane = 0; lane < lanes; lane++)
+	{
+		const std::size_t at = lane * lane_bytes;
+
+		if (std::memcmp(to_write + at, getllar + at, lane_bytes) == 0)
+		{
+			continue;
+		}
+
+		lane_t expected, desired;
+		std::memcpy(expected.bytes, getllar + at, lane_bytes);
+		std::memcpy(desired.bytes, to_write + at, lane_bytes);
+
+		if (exchange(memory + at, expected, desired))
+		{
+			written |= 1u << lane;
+			continue;
+		}
+
+		if (!written)
+		{
+			refused_count.fetch_add(1, std::memory_order_relaxed);
+			return result::refused_changed;
+		}
+
+		// The guest stored into this lane after step 1. Give back the lanes already stored, last one first.
+		for (std::size_t back = lane; back-- > 0;)
+		{
+			if (!(written & (1u << back)))
+			{
+				continue;
+			}
+
+			const std::size_t from = back * lane_bytes;
+			lane_t stored, before;
+			std::memcpy(stored.bytes, to_write + from, lane_bytes);
+			std::memcpy(before.bytes, getllar + from, lane_bytes);
+
+			while (!exchange(memory + from, stored, before))
+			{
+				// `stored` is the lane now. A byte that is not the one this PUTLLC stored was stored by the guest
+				// since: it stays. Every other byte takes its GETLLAR value back.
+				for (std::size_t i = 0; i < lane_bytes; i++)
+				{
+					before.bytes[i] = stored.bytes[i] != to_write[from + i] ? stored.bytes[i] : getllar[from + i];
+				}
+			}
+		}
+
+		undone_count.fetch_add(1, std::memory_order_relaxed);
+		return result::refused_undone;
+	}
+
+	stored_count.fetch_add(1, std::memory_order_relaxed);
+	return result::stored;
+}
+} // namespace rpcs3::ios::spurs_relaxed_store
