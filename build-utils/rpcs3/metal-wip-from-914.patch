diff --git a/rpcs3/ios/IOSAutoPpuProfile916.h b/rpcs3/ios/IOSAutoPpuProfile916.h
new file mode 100644
index 0000000..506dad2
--- /dev/null
+++ b/rpcs3/ios/IOSAutoPpuProfile916.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+// REWINDBOX_AUTO_PPU_PROFILE_916: one PPU region profile per boot, asked by the 5 s report itself.
+//
+// Build 718, God of War III (BCES00510), session 5, window 15: 11.2 guest frames per second, the GPU busy 21 % of
+// the time and the title's main PPU thread at 0.931 core (top=PPU[0x1000000]_:0.931): the frame waits for that
+// thread, and nothing in the journal says what it runs. The PPU region profile of Core 912 answers that, but it starts
+// only on a request of the host's test page, and that page refuses a title whose settings are an inherited custom
+// profile (legacy_custom=1), which is this title's case.
+// When the busiest PPU thread used at least `bound_cores` of a core in `windows_needed` consecutive running windows
+// that showed frames, the report asks once per boot for the same bounded profile (ios/IOSCapture912.h, ppu_profile:
+// a sampler thread that reads state and pc about once per millisecond for at most 5000 samples; it stops no thread).
+// The per-boot limit and the refusals of the explicit request apply unchanged.
+namespace rpcs3::ios::auto_ppu_profile
+{
+inline constexpr double bound_cores = 0.85;
+inline constexpr std::uint32_t windows_needed = 2;
+
+// The busiest PPU thread of a window's thread list (names as the report's top= field prints them: "PPU[0x...]...").
+template <typename Rows>
+double busiest_ppu(const Rows& rows) noexcept
+{
+	double busiest = 0.0;
+
+	for (const auto& row : rows)
+	{
+		if (std::string_view(row.name).starts_with("PPU[") && row.cores > busiest)
+		{
+			busiest = row.cores;
+		}
+	}
+
+	return busiest;
+}
+
+struct tracker
+{
+	std::uint64_t session = ~0ull;
+	std::uint32_t consecutive = 0;
+	bool asked = false;
+
+	// One call per report window. True once per boot session: ask for the profile now.
+	bool observe(std::uint64_t now_session, bool running, std::uint64_t guest_flips, double busiest_ppu_cores) noexcept
+	{
+		if (now_session != session)
+		{
+			session = now_session;
+			consecutive = 0;
+			asked = false;
+		}
+
+		if (!running || !guest_flips || !(busiest_ppu_cores >= bound_cores))
+		{
+			consecutive = 0;
+			return false;
+		}
+
+		if (asked || ++consecutive < windows_needed)
+		{
+			return false;
+		}
+
+		asked = true;
+		return true;
+	}
+};
+} // namespace rpcs3::ios::auto_ppu_profile
