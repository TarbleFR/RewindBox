diff --git a/rpcs3/ios/IOSFreezeChain916.h b/rpcs3/ios/IOSFreezeChain916.h
new file mode 100644
index 0000000..8046ddf
--- /dev/null
+++ b/rpcs3/ios/IOSFreezeChain916.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_FREEZE_CHAIN_916: two bounded walks of the stall dump, kept apart so that they are executed by a host test.
+//
+// 1. The threads queued on a kernel object, read from the object's own queue. The lwcond lines of Core 908 named a
+//    condition's waiters by r3 of the waiting threads, but _sys_lwcond_queue_wait stores its return value (0) in r3
+//    before it sleeps: on build 718 (Black Flag, PID 44597) twelve threads waited on lightweight conditions and no
+//    lwcond line was printed. The queue of the condition itself does not depend on a register.
+// 2. The return addresses of a waiting or polling PPU thread, from its stack back chain: where in the game the wait
+//    was asked from (the dump only had the address inside the system library). PowerPC 64-bit ELF ABI as the PS3 uses
+//    it: the doubleword at the stack pointer is the caller's stack pointer, and a function saves its return address
+//    at 16 bytes above the caller's stack pointer.
+namespace rpcs3::ios::freeze_chain
+{
+// first: the head of an intrusive queue; next(node) the following node or null; id(node) what to record.
+// Returns the number recorded (at most cap); `more` says whether the queue went on.
+template <typename Node, typename Next, typename Id>
+std::size_t queue_ids(const Node* first, Next&& next, Id&& id, std::uint32_t* out, std::size_t cap, bool& more)
+{
+	std::size_t count = 0;
+	more = false;
+
+	// A queue being changed while it is read without its lock would loop: the caller holds the object's lock, and the
+	// walk is bounded anyway.
+	std::size_t steps = 0;
+
+	for (const Node* node = first; node && steps < 64; node = next(node), steps++)
+	{
+		if (count == cap)
+		{
+			more = true;
+			break;
+		}
+
+		out[count++] = id(node);
+	}
+
+	return count;
+}
+
+// sp: the thread's stack pointer; readable(address) whether 8 bytes can be read there; read64(address) the big-endian
+// doubleword in host order. Writes the saved return addresses, innermost first; stops at an unreadable address, a
+// null or non-increasing back chain (the stack grows down: a caller's frame is above), or cap.
+template <typename Readable, typename Read64>
+std::size_t back_chain(std::uint64_t sp, Readable&& readable, Read64&& read64, std::uint32_t* out, std::size_t cap)
+{
+	std::size_t count = 0;
+
+	while (count < cap)
+	{
+		if (!sp || sp > 0xffffffffull || (sp & 15) || !readable(static_cast<std::uint32_t>(sp)))
+		{
+			break;
+		}
+
+		const std::uint64_t caller = read64(static_cast<std::uint32_t>(sp));
+
+		if (caller <= sp || caller > 0xffffffffull || caller - sp > 0x100000 || !readable(static_cast<std::uint32_t>(caller + 16)))
+		{
+			break;
+		}
+
+		out[count++] = static_cast<std::uint32_t>(read64(static_cast<std::uint32_t>(caller + 16)));
+		sp = caller;
+	}
+
+	return count;
+}
+} // namespace rpcs3::ios::freeze_chain
diff --git a/rpcs3/ios/IOSGow3MlaaPatch.h b/rpcs3/ios/IOSGow3MlaaPatch.h
new file mode 100644
index 0000000..df1f2ec
--- /dev/null
+++ b/rpcs3/ios/IOSGow3MlaaPatch.h
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+// REWINDBOX_GOW3_MLAA_100_916: the PPU half of the God of War III MLAA bypass, per executable.
+//
+// Build 718, BCES00510, PID 45272, sessions 4 and 5: the title's setting "God of War III MLAA Bypass" is Enabled
+// (boot policy gow3_mlaa=1), the executable is PPU-4d5c5150... (application 01.00) and COREPROF GOW3MLAA909 reports
+// that nothing was applied: the bypass knew the 01.03 executable only. In the slow windows the PPU main thread uses
+// 0.93 core and the SPU threads 2.99 cores, and every frame one SPU reads the 1280x720 colour buffer back
+// (READBACK555 fault_read 58 per window of 57 frames, 3.8 ms on average, 18 ms at most).
+//
+// RPCS3's patch repository holds "Disable MLAA" (authors illusion, ZEROx; patch version 3.0) for both executables:
+//   PPU-19724fde16a5b111b7b4d2a065f5dccaf8e01962 (01.03): [ byte, 0x52BF2F, 0 ], [ be32, 0x0023137c, 0x60000000 ]
+//   PPU-4d5c51503a81a327c2a99427390a395b8dcb3767 (01.00): [ byte, 0x52BF2F, 0 ], [ be32, 0x00231248, 0x60000000 ]
+// The be32 line removes one call (the author: "A few nop to the call 0x230c4c narrowed down to 0x0023137c"); the byte
+// is the game's own flag. The 01.03 pair is the one delivered since Build 351 (it clears the whole word 0x52bf2c, an
+// earlier version of the same patch) and is kept as it is. The 01.00 pair is applied only on that exact executable
+// and only if the word to replace is a relative call and the flag byte holds 0 or 1: any other content refuses the
+// whole pair and says so (COREPROF GOW3MLAA909 ppu=refused_guard), so a different executable is never patched.
+// Like every executable patch it is applied at a fresh boot; a savestate carries the memory of the boot it was made
+// from, and the report says whether that memory holds the patch (savestate_patched=).
+namespace rpcs3::ios::gow3_mlaa_patch
+{
+struct plan
+{
+	std::string_view executable; // "PPU-<sha1>"
+	std::string_view version;
+	std::uint32_t flag_address;  // one byte, set to 0
+	std::uint32_t call_address;  // one big-endian word, set to nop
+	bool guarded;                // check the content before writing
+	bool clear_flag_word;        // the delivered 01.03 form: the big-endian word that ends with the flag byte
+};
+
+constexpr std::uint32_t nop = 0x60000000;
+
+constexpr plan plans[] = {
+	{"PPU-19724fde16a5b111b7b4d2a065f5dccaf8e01962", "01.03", 0x0052bf2f, 0x0023137c, false, true},
+	{"PPU-4d5c51503a81a327c2a99427390a395b8dcb3767", "01.00", 0x0052bf2f, 0x00231248, true, false},
+};
+
+constexpr const plan* find(std::string_view executable) noexcept
+{
+	for (const plan& candidate : plans)
+	{
+		if (candidate.executable == executable)
+		{
+			return &candidate;
+		}
+	}
+
+	return nullptr;
+}
+
+// bl target: primary opcode 18, relative (AA = 0), link (LK = 1).
+constexpr bool is_relative_call(std::uint32_t word) noexcept
+{
+	return (word & 0xfc000003u) == 0x48000001u;
+}
+
+enum class outcome : std::uint8_t { applied, already_applied, refused_guard };
+
+struct result
+{
+	outcome what = outcome::refused_guard;
+	std::uint32_t call_word = 0; // the word found at call_address before any write
+	std::uint8_t flag_byte = 0;  // the byte found at flag_address before any write
+	std::uint32_t writes = 0;
+};
+
+// read32/write32 take a guest address and a host-order value of the big-endian word; read8/write8 one byte.
+// `wrote(address)` is called for each address whose content changed (the loader's list of applied patches).
+template <typename Read8, typename Read32, typename Write8, typename Write32, typename Wrote>
+result apply(const plan& p, Read8&& read8, Read32&& read32, Write8&& write8, Write32&& write32, Wrote&& wrote)
+{
+	result r;
+	r.call_word = read32(p.call_address);
+	r.flag_byte = read8(p.flag_address);
+
+	if (p.guarded)
+	{
+		const bool call_ok = r.call_word == nop || is_relative_call(r.call_word);
+		const bool flag_ok = r.flag_byte <= 1;
+
+		if (!call_ok || !flag_ok)
+		{
+			r.what = outcome::refused_guard;
+			return r;
+		}
+	}
+
+	if (p.clear_flag_word)
+	{
+		const std::uint32_t word_address = p.flag_address & ~3u;
+
+		if (read32(word_address) != 0)
+		{
+			write32(word_address, 0);
+			wrote(word_address);
+			r.writes++;
+		}
+	}
+	else if (r.flag_byte != 0)
+	{
+		write8(p.flag_address, 0);
+		wrote(p.flag_address);
+		r.writes++;
+	}
+
+	if (r.call_word != nop)
+	{
+		write32(p.call_address, nop);
+		wrote(p.call_address);
+		r.writes++;
+	}
+
+	r.what = r.writes ? outcome::applied : outcome::already_applied;
+	return r;
+}
+
+// Does this memory hold the patch (a savestate made from a boot that applied it)?
+template <typename Read8, typename Read32>
+bool present(const plan& p, Read8&& read8, Read32&& read32)
+{
+	return read32(p.call_address) == nop && read8(p.flag_address) == 0;
+}
