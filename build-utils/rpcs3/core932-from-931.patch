+# RATCHET & CLANK FUTURE: A CRACK IN TIME -- hangs starting a New Game.
+#
+# The engine waits for the RSX to drain its command ring, but reads GET once before
+# the loop rather than inside it:
+#
+#       lwz  r29,4(r12)        ; GET, read ONCE
+#   0x5cb1bc:
+#       lwz  r9,0(r11)         ; PUT
+#       cmpw cr6,r9,r29
+#       bne  cr6,0x5cb1bc      ; branches back AFTER the read
