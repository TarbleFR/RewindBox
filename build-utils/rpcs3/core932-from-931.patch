+      - [ jumpl, 0x00000000, 0x010acb60 ] # sys_lwmutex_lock(slot lock, 0)
+      - [ be32, 0x00000000, 0x813a3c20 ] # lwz r9,0x3c20(r26)
+      - [ be32, 0x00000000, 0x39290001 ] # addi r9,r9,1
+      - [ be32, 0x00000000, 0x913a3c20 ] # stw r9,0x3c20(r26)
+      - [ be32, 0x00000000, 0x7f5dd378 ] # mr r29,r26: back to the first slot
