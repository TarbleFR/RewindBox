+bool patch_engine::is_enabled(std::string_view hash, std::string_view description, std::string_view serial, std::string_view app_version) const
+{
+	const auto container = m_map.find(std::string{hash});
+	if (container == m_map.end())
+	{
+		return false;
+	}
+	const auto info = container->second.patch_info_map.find(std::string{description});
+	if (info == container->second.patch_info_map.end())
+	{
+		return false;
+	}
+	for (const auto& [title, serials] : info->second.titles)
+	{
+		auto found_serial = serials.find(std::string{serial});
+		if (found_serial == serials.end())
+		{
+			found_serial = serials.find(patch_key::all);
+		}
+		if (found_serial == serials.end())
+		{
+			continue;
+		}
+		auto found_version = found_serial->second.find(std::string{app_version});
+		if (found_version == found_serial->second.end())
+		{
+			found_version = found_serial->second.find(patch_key::all);
+		}
+		if (found_version != found_serial->second.end() && found_version->second.enabled)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+#endif
