+++ b/rpcs3/ios/IOSThermalPolicy931.h
@@ -2,8 +2,10 @@
 #pragma once
 
 #include <atomic>
+#include <chrono>
 #include <cstddef>
 #include <cstdint>
+#include <mutex>
 
 #include "IOSShardedCounter931.h"
 #include "IOSWriterParkSpin917.h" // compare::event_waits_forced, set by the report thread inside a comparison step
@@ -45,12 +47,160 @@ inline bool event_waits() noexcept
 }
 
 // Platform observer (RPCS3IOSPlatform.mm): the state the system posted.
+// REWINDBOX_THERMAL_LEDGER_932 (maintainer audit, 11 Nov 2026): THERMAL931 classified a report window by the state
+// read at its end, so a window that heated up in its middle counted whole in the hotter state. The ledger keeps the
+// time spent in each state and the number of transitions; a report takes one snapshot per window and prints the
+// state at the start and at the end, the time in each state and whether the window was mixed. A mixed window cannot
+// be split (the energy line is per window): the analyzer leaves it out of every per-state comparison.
+// Slots: 0 unknown (no state read yet), 1 nominal, 2 fair, 3 serious, 4 critical.
+inline constexpr std::size_t ledger_slots = 5;
+
+constexpr std::size_t ledger_slot(int thermal_state) noexcept
+{
+	return thermal_state >= 0 && thermal_state <= 3 ? static_cast<std::size_t>(thermal_state) + 1 : 0;
+}
+
+struct ledger_snapshot
+{
+	bool valid = false;
+	int state = -1;
+	std::uint64_t changes = 0;
+	std::uint64_t time_ns[ledger_slots] = {};
+};
+
+class ledger
+{
+public:
+	// Called on every notified state (the platform observer, any thread) with a steady clock.
+	void record(int thermal_state, std::uint64_t now_ns) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		account(now_ns);
+		if (thermal_state != m_state)
+		{
+			m_state = thermal_state;
+			m_changes++;
+		}
+	}
+
+	ledger_snapshot snapshot(std::uint64_t now_ns) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		account(now_ns);
+		ledger_snapshot out;
+		out.valid = true;
+		out.state = m_state;
+		out.changes = m_changes;
+		for (std::size_t i = 0; i < ledger_slots; i++)
+		{
+			out.time_ns[i] = m_time_ns[i];
+		}
+		return out;
+	}
+
+private:
+	void account(std::uint64_t now_ns) noexcept
+	{
+		if (m_since_ns && now_ns > m_since_ns)
+		{
+			m_time_ns[ledger_slot(m_state)] += now_ns - m_since_ns;
+		}
+		if (now_ns > m_since_ns)
+		{
+			m_since_ns = now_ns;
+		}
+	}
+
+	std::mutex m_mutex;
+	int m_state = -1;
+	std::uint64_t m_since_ns = 0;
+	std::uint64_t m_changes = 0;
+	std::uint64_t m_time_ns[ledger_slots] = {};
+};
+
+inline ledger state_ledger;
+
+inline std::uint64_t steady_now_ns() noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
 inline void set_state(int thermal_state) noexcept
 {
 	if (state.exchange(thermal_state, std::memory_order_relaxed) != thermal_state)
 	{
 		state_changes.fetch_add(1, std::memory_order_relaxed);
 	}
+	state_ledger.record(thermal_state, steady_now_ns()); // REWINDBOX_THERMAL_LEDGER_932
+}
+
+// One report window seen through two consecutive snapshots of the ledger.
+struct window_view
+{
+	bool known = false;               // both snapshots exist
+	int begin_state = -1, end_state = -1;
+	std::uint64_t changes = 0;
+	std::uint64_t ms[ledger_slots] = {};
+	bool mixed = false;               // a transition happened, or more than one state held time
+
+	std::size_t states_with_time() const noexcept
+	{
+		std::size_t n = 0;
+		for (const std::uint64_t value : ms)
+		{
+			n += value ? 1 : 0;
+		}
+		return n;
+	}
+};
+
+inline window_view view_between(const ledger_snapshot& before, const ledger_snapshot& now) noexcept
+{
+	window_view out;
+	if (!before.valid || !now.valid)
+	{
+		return out;
+	}
+	out.known = true;
+	out.begin_state = before.state;
+	out.end_state = now.state;
+	out.changes = now.changes >= before.changes ? now.changes - before.changes : 0;
+	for (std::size_t i = 0; i < ledger_slots; i++)
+	{
+		out.ms[i] = now.time_ns[i] >= before.time_ns[i] ? (now.time_ns[i] - before.time_ns[i]) / 1'000'000 : 0;
+	}
+	out.mixed = out.changes != 0 || out.states_with_time() > 1 || out.begin_state != out.end_state;
+	return out;
+}
+
+// The event waits of a window: constant when forced by a comparison step or by the setting; under Automatic they
+// follow the state, so a window that held time on both sides of the serious threshold is mixed.
+inline const char* event_waits_window(const window_view& window, std::uint8_t mode, int forced) noexcept
+{
+	if (forced >= 0)
+	{
+		return forced ? "on" : "off";
+	}
+	if (mode == 1 || mode == 2)
+	{
+		return mode == 1 ? "on" : "off";
+	}
+	if (!window.known)
+	{
+		return "unknown";
+	}
+	const std::uint64_t below = window.ms[0] + window.ms[ledger_slot(0)] + window.ms[ledger_slot(1)];
+	const std::uint64_t above = window.ms[ledger_slot(2)] + window.ms[ledger_slot(3)];
+	if (below && above)
+	{
+		return "mixed";
+	}
+	if (above || (!below && window.end_state >= automatic_from))
+	{
+		return "on";
+	}
+	return "off";
 }
 
