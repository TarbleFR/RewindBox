+      - [ be32, 0x00000000, 0x4082001c ] # bne +0x1c: some other caller
+      - [ be32, 0x00000000, 0x80c50004 ] # lwz r6,4(r5)
+      - [ be32, 0x00000000, 0x3ce00001 ] # lis r7,0x0001
+      - [ be32, 0x00000000, 0x60e70f5e ] # ori r7,r7,0x0f5e
+      - [ be32, 0x00000000, 0x7c063800 ] # cmpw r6,r7
+      - [ be32, 0x00000000, 0x40820008 ] # bne +8
+      - [ be32, 0x00000000, 0x38600000 ] # li r3,0: the private check, so its minimum is 1
