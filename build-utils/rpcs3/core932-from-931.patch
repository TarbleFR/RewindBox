diff --git a/rpcs3/ios/IOSPatchRelief932.h b/rpcs3/ios/IOSPatchRelief932.h
new file mode 100644
index 0000000..3f114e4
--- /dev/null
+++ b/rpcs3/ios/IOSPatchRelief932.h
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+// REWINDBOX_PATCH_RELIEF_932 (maintainer audit, 11 Nov 2026: share corrections between games under precise
+// conditions): a game patch that removes the reason the RPCS3 database turns an expensive setting on for a title also
+// removes the need for that setting. A rule names the patch, the setting, the value the database set and the value
+// the setting goes back to. It acts only when every condition holds, and the boot line PATCHRELIEF932 says what it
+// did or why it refused:
+// - the patch is applied in this boot: a main executable patch whose every entry was written, or, for a rule decided
+//   at boot, the patch enabled for this serial and version before any SPU program is compiled;
+// - the value comes from the database alone: it differs from the global value, the user's per-game settings do not
+//   name the setting (they always win) and no configuration file was chosen for this boot;
+// - a fresh boot: a savestate keeps the memory it was saved with, patched or not, so its settings are left as they are.
+// Turning the patch off in the game-patch list turns the rule off. Two rules, both shipped by ARMSX3 21863 with the
+// same patches (rpcs3/ios/IOSCanaryPatches932.h):
+// 1. gt6_mlaa_buffers: Gran Turismo 6 v01.22, "Disable MLAA" of its eight executables. The game reads every frame back
+//    for its SPU MLAA pass, which is why the database turns Write and Read Color Buffers on for every GT6 serial; with
+//    the pass gone nothing reads the frame. Applied with the patch, on the loader thread, before the renderer exists
+//    (ppu_load_exec applies the main executable patches before init_fxo_for_exec starts it).
+// 2. gta4_collision_xfloat: Grand Theft Auto IV, "ARMSX3 Approximate collision fix". The collision job starts its 14
+//    searches from 0x7FFFFFFF, a NaN under Approximate XFloat, which is why the database pins the game to Accurate (a
+//    cost on every SPU program); the patch starts them from FLT_MAX, the same value under both. Decided at boot, before
+//    any SPU compilation (the mode is read while compiling), and only for the executables the patch was written for:
+//    BLUS30682 v01.02 and BLUS30127 / NPUB30702 v01.08.
+namespace rpcs3::ios::patch_relief932
+{
+enum class setting : std::uint8_t
+{
+	write_color_buffers,
+	read_color_buffers,
+	spu_xfloat_accuracy,
+	count,
+};
+
+constexpr std::size_t setting_count = static_cast<std::size_t>(setting::count);
+
+constexpr const char* setting_name(setting s) noexcept
+{
+	switch (s)
+	{
+	case setting::write_color_buffers: return "write_color_buffers";
+	case setting::read_color_buffers: return "read_color_buffers";
+	case setting::spu_xfloat_accuracy: return "spu_xfloat_accuracy";
+	default: return "unknown";
+	}
+}
+
+// The key of the same setting in the user's per-game settings (RPCS3IOSSettings.cpp).
+constexpr std::string_view setting_key(setting s) noexcept
+{
+	switch (s)
+	{
+	case setting::write_color_buffers: return "gpu.write_color_buffers";
+	case setting::read_color_buffers: return "advanced.read_color_buffers";
+	case setting::spu_xfloat_accuracy: return "cpu.spu_xfloat_accuracy";
+	default: return {};
+	}
+}
+
+// Comma-separated keys, as game_setting_override_keys prints them.
+constexpr bool has_key(std::string_view keys, std::string_view key) noexcept
+{
+	while (!keys.empty())
+	{
+		const std::size_t comma = keys.find(',');
+		const std::string_view item = keys.substr(0, comma);
+		if (item == key)
+		{
+			return true;
+		}
+		if (comma == std::string_view::npos)
+		{
+			break;
+		}
+		keys.remove_prefix(comma + 1);
+	}
+	return false;
+}
+
+enum class refusal : std::uint8_t
+{
+	none,
+	not_fresh_boot,
+	explicit_config,
+	overrides_unknown,
+	user_choice,
+	not_database,
+	partial_apply,
+	version,
+};
+
+constexpr const char* refusal_name(refusal r) noexcept
+{
+	switch (r)
+	{
+	case refusal::none: return "none";
+	case refusal::not_fresh_boot: return "savestate";
+	case refusal::explicit_config: return "explicit_config";
+	case refusal::overrides_unknown: return "user_settings_unknown";
+	case refusal::user_choice: return "user_choice";
+	case refusal::not_database: return "not_from_database";
+	case refusal::partial_apply: return "patch_partially_applied";
+	case refusal::version: return "other_version";
+	default: return "unknown";
+	}
+}
+
+// What the boot knows about one setting, captured by Emulator::Load after every layer.
+struct setting_origin
+{
+	bool user_key = false;      // the user's per-game settings name it
+	bool from_database = false; // the global value differs and the value is the one the rule relieves
+};
+
+struct decision_inputs
+{
+	bool fresh_boot = false;
+	bool explicit_config = false;
+	bool overrides_known = false;
+	setting_origin origin{};
+	bool patch_complete = false;
+	bool version_ok = false;
+};
+
+// The order of the refusals is the order of the conditions above; the first one that fails is reported.
+constexpr refusal decide(const decision_inputs& in) noexcept
+{
+	if (!in.fresh_boot)
+	{
+		return refusal::not_fresh_boot;
+	}
+	if (in.explicit_config)
+	{
+		return refusal::explicit_config;
+	}
+	if (!in.overrides_known)
+	{
+		return refusal::overrides_unknown;
+	}
+	if (in.origin.user_key)
+	{
+		return refusal::user_choice;
+	}
+	if (!in.origin.from_database)
+	{
+		return refusal::not_database;
+	}
+	if (!in.patch_complete)
+	{
+		return refusal::partial_apply;
+	}
+	if (!in.version_ok)
+	{
+		return refusal::version;
+	}
+	return refusal::none;
+}
+
+// Rule 1.
+inline constexpr std::string_view gt6_description = "Disable MLAA";
+inline constexpr std::array<std::string_view, 8> gt6_hashes = {
+	"PPU-42367707f4caac2668f10cb46498f64bde9db440", "PPU-4f1e9acd7d98961b4b742fb324a2faba6212ea67",
+	"PPU-6ac472e1f334f54ec4753cde9e8e1515bfab4d17", "PPU-638ef307e2b35d593f599efec0dc0c37059a984b",
+	"PPU-80f0d67b29d3d17ac885a309a3fc4cd8dcf50658", "PPU-4213aba5ed17f7e3cd3f299fa44d9d9acef0ba18",
+	"PPU-6a7de7fdfd7e7cbd1031bf28a7104b29c308136c", "PPU-43e618448eed82aa96856338d072f1e4978c36a8",
+};
+
+constexpr bool is_gt6_mlaa_patch(std::string_view hash, std::string_view description) noexcept
+{
+	if (description != gt6_description)
+	{
+		return false;
+	}
+	for (const std::string_view known : gt6_hashes)
+	{
+		if (known == hash)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+// Rule 2.
+inline constexpr std::string_view gta4_hash = "SPU-d0a1508208613e2184fbd64906d34d5f07890033";
+inline constexpr std::string_view gta4_description = "ARMSX3 Approximate collision fix";
+
+struct serial_version
+{
+	std::string_view serial;
+	std::string_view app_version;
+};
+
+inline constexpr std::array<serial_version, 3> gta4_versions = {{
+	{"BLUS30682", "01.02"},
+	{"BLUS30127", "01.08"},
+	{"NPUB30702", "01.08"},
+}};
+
+constexpr bool is_gta4_serial(std::string_view serial) noexcept
+{
+	for (const serial_version& known : gta4_versions)
+	{
+		if (known.serial == serial)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+constexpr bool gta4_version_ok(std::string_view serial, std::string_view app_version) noexcept
+{
+	for (const serial_version& known : gta4_versions)
+	{
+		if (known.serial == serial && known.app_version == app_version)
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+// Written by Emulator::Load on its loader thread before the executable is loaded; read by patch_engine::apply on
+// the same thread. Atomics only so that a read from another thread is never a data race.
+class boot_state
+{
+public:
+	static boot_state& instance() noexcept
+	{
+		static boot_state value;
+		return value;
+	}
+
+	void begin(bool fresh_boot, bool explicit_config, bool overrides_known, const std::array<setting_origin, setting_count>& origins) noexcept
+	{
+		m_fresh_boot.store(fresh_boot, std::memory_order_relaxed);
+		m_explicit_config.store(explicit_config, std::memory_order_relaxed);
+		m_overrides_known.store(overrides_known, std::memory_order_relaxed);
+		for (std::size_t i = 0; i < setting_count; i++)
+		{
+			m_user_key[i].store(origins[i].user_key, std::memory_order_relaxed);
+			m_from_database[i].store(origins[i].from_database, std::memory_order_relaxed);
+		}
+		m_applied.store(0, std::memory_order_relaxed);
+		m_armed.store(true, std::memory_order_release);
+	}
+
+	// After the executable is loaded nothing is relieved any more (a later apply() is a module or an SPU image).
+	void end_loading() noexcept { m_armed.store(false, std::memory_order_release); }
+	bool armed() const noexcept { return m_armed.load(std::memory_order_acquire); }
+
+	decision_inputs inputs(setting s, bool patch_complete, bool version_ok) const noexcept
+	{
+		const std::size_t i = static_cast<std::size_t>(s);
+		decision_inputs in;
+		in.fresh_boot = m_fresh_boot.load(std::memory_order_relaxed);
+		in.explicit_config = m_explicit_config.load(std::memory_order_relaxed);
+		in.overrides_known = m_overrides_known.load(std::memory_order_relaxed);
+		in.origin.user_key = m_user_key[i].load(std::memory_order_relaxed);
+		in.origin.from_database = m_from_database[i].load(std::memory_order_relaxed);
+		in.patch_complete = patch_complete;
+		in.version_ok = version_ok;
+		return in;
+	}
+
+	void count_applied() noexcept { m_applied.fetch_add(1, std::memory_order_relaxed); }
+	std::uint32_t applied() const noexcept { return m_applied.load(std::memory_order_relaxed); }
+
+private:
+	std::atomic<bool> m_armed{false}, m_fresh_boot{false}, m_explicit_config{false}, m_overrides_known{false};
+	std::array<std::atomic<bool>, setting_count> m_user_key{}, m_from_database{};
+	std::atomic<std::uint32_t> m_applied{0};
+};
+} // namespace rpcs3::ios::patch_relief932
diff --git a/rpcs3/ios/IOSTexturePrehash.h b/rpcs3/ios/IOSTexturePrehash.h
index 40783db..2a2eead 100644
--- a/rpcs3/ios/IOSTexturePrehash.h
+++ b/rpcs3/ios/IOSTexturePrehash.h
@@ -68,6 +68,34 @@ constexpr std::size_t next_lookahead(std::size_t current, std::uint64_t frame_wo
 	}
 	return current;
 }
+// REWINDBOX_PREHASH_THERMAL_932 (maintainer audit, 11 Nov 2026): a hash the worker computes ahead and no validation
+// uses is pure heat. From the fair thermal state (moderate heating), the depth that next_lookahead kept also halves
+// while fewer than two thirds of the worker's hashes were used (the nominal threshold stays one half); from the
+// serious state it never exceeds half the maximum depth. Growth still needs 85 % of the hashes used. Only how much is
+// hashed ahead changes: whatever the worker leaves is hashed on demand by the RSX thread, as before.
+constexpr std::size_t thermal_lookahead(std::size_t after, std::size_t before, std::uint64_t frame_worker_hashes, std::uint64_t frame_hits,
+	int thermal_state) noexcept
+{
+	std::size_t depth = after;
+	if (thermal_state >= 1 && after == before && frame_worker_hashes >= 8 && frame_hits * 3 < frame_worker_hashes * 2)
+	{
+		depth = after / 2 < min_lookahead ? min_lookahead : after / 2;
+	}
+	if (thermal_state >= 2 && depth > lookahead / 2)
+	{
+		depth = lookahead / 2;
+	}
+	return depth;
+}
+
+static_assert(thermal_lookahead(16, 16, 100, 60, 0) == 16);   // nominal: unchanged (next_lookahead alone decides)
+static_assert(thermal_lookahead(16, 16, 100, 60, 1) == 8);    // fair, 60 % used: halved
+static_assert(thermal_lookahead(16, 16, 100, 70, 1) == 16);   // fair, 70 % used: kept
+static_assert(thermal_lookahead(8, 16, 100, 40, 1) == 8);     // already halved by next_lookahead: not twice
+static_assert(thermal_lookahead(64, 32, 100, 90, 2) == 32);   // serious: growth capped at half the maximum
+static_assert(thermal_lookahead(4, 4, 100, 10, 3) == 4);      // floor
+static_assert(thermal_lookahead(16, 16, 7, 0, 1) == 16);      // too little to judge
+
 // Totals since boot (the window counters below are taken by the profiler) and the current depth.
 inline std::atomic<std::uint64_t> total_hits{0}, total_worker_hashes{0};
 inline std::atomic<std::uint32_t> current_lookahead{static_cast<std::uint32_t>(lookahead)};
diff --git a/rpcs3/ios/IOSThermalPolicy931.h b/rpcs3/ios/IOSThermalPolicy931.h
