diff --git a/rpcs3/ios/IOSTexturePrehash.h b/rpcs3/ios/IOSTexturePrehash.h
index fea2f33..9d566a1 100644
--- a/rpcs3/ios/IOSTexturePrehash.h
+++ b/rpcs3/ios/IOSTexturePrehash.h
@@ -43,6 +43,32 @@ constexpr std::uint32_t min_bytes = 64u << 10;
 constexpr std::size_t max_sequence = 2048;
 // Recorded validations the worker hashes ahead of the RSX thread.
 constexpr std::size_t lookahead = 64;
+// REWINDBOX_PREHASH_BUDGET_910: God of War III, build 694 device log (Core 907), window 29: the worker completed 10,135
+// hashes (10.48 GB) and the RSX thread used 4,623 of them (5.05 GB): the rest was hashed for an epoch that ended first.
+// The depth of the worker's look-ahead now follows what the last frame used: under half of its completed hashes used,
+// the depth halves (down to 4 ranges); above 85 %, it doubles (up to 64). Only how much is hashed ahead changes: a
+// result still validates nothing but the range and epoch it was taken for, and what the worker leaves is hashed by
+// the RSX thread as before.
+constexpr std::size_t min_lookahead = 4;
+constexpr std::size_t next_lookahead(std::size_t current, std::uint64_t frame_worker_hashes, std::uint64_t frame_hits) noexcept
+{
+	if (frame_worker_hashes < 8)
+	{
+		return current; // too little to judge
+	}
+	if (frame_hits * 2 < frame_worker_hashes)
+	{
+		return current / 2 < min_lookahead ? min_lookahead : current / 2;
+	}
+	if (frame_hits * 100 >= frame_worker_hashes * 85)
+	{
+		return current * 2 > lookahead ? lookahead : current * 2;
+	}
+	return current;
+}
+// Totals since boot (the window counters below are taken by the profiler) and the current depth.
+inline std::atomic<std::uint64_t> total_hits{0}, total_worker_hashes{0};
+inline std::atomic<std::uint32_t> current_lookahead{static_cast<std::uint32_t>(lookahead)};
 // Results kept (direct mapped, power of two).
 constexpr std::size_t table_size = 4096;
 
diff --git a/rpcs3/ios/IOSTextureValidationProfile.h b/rpcs3/ios/IOSTextureValidationProfile.h
index af6cd5d..7d3101f 100644
--- a/rpcs3/ios/IOSTextureValidationProfile.h
+++ b/rpcs3/ios/IOSTextureValidationProfile.h
@@ -147,4 +147,84 @@ inline void advance_epoch(epoch_source source = epoch_source::other) noexcept
 		}
 	}
 }
+
+// REWINDBOX_PUT_HORIZON_910: God of War III, build 694 device log (Core 907), window 29: 25,807 texture epochs for 72
+// frames (about 358 per frame) while the RSX FIFO ran dry only 3,932 times (about 55 per frame). The FIFO reads PUT
+// at every command and every change it saw started an epoch, although the commands it was still executing had been
+// published before the previous one. The rule of the epoch is that the data a command needs is written before the
+// command becomes visible; a validation made after a command became visible therefore serves it. The commands below
+// the PUT that opened the last PUT epoch (the horizon) were all visible then, and every validation since is newer:
+// a later PUT only matters once the FIFO reaches the horizon. Until then its epoch is deferred; it starts when the
+// FIFO reaches the horizon (or leaves the linear segment below it: jump, call, return, wrap), with the PUT read then.
+// Semaphore acquires, RSX writes, flushes, invalidations and the frame end start their epochs as before; one of them
+// also covers every command visible when it happened, so the horizon moves up to the last PUT read before it.
+// A jump to itself that the guest patches publishes the commands behind it without moving PUT: with the horizon on,
+// the patched command starts an epoch (RSXFIFO.cpp). The FIFO cache of the non-Fast accuracy modes reads PUT once per
+// refill, so those modes never defer; a FIFO reset or recovery forgets the horizon (reset_epoch_horizon).
+// Per title (Automatic: God of War III); off: an epoch for every PUT change read, as before.
+namespace put_horizon_policy
+{
+inline std::atomic<bool> enabled{false};
+}
+// PUT changes read while the FIFO was still below the horizon (no epoch started for them).
+inline std::atomic<std::uint64_t> put_deferred{0};
+// Epochs started by a patched jump-to-itself (counted in the put source as well).
+inline std::atomic<std::uint64_t> put_patched{0};
+
+struct put_horizon
+{
+	std::uint32_t horizon = ~0u; // commands below it were visible when the covering epoch started
+	std::uint32_t get = 0;       // the FIFO position when the horizon was set, then at each deferral
+	std::uint32_t seen = ~0u;    // the last PUT read
+	std::uint64_t epoch = 0;     // validation_epoch at the last read
+	bool armed = false;          // horizon and get describe a segment
+	bool deferred = false;       // a PUT change was deferred since the horizon was set
+
+	// The FIFO at `get_now` reads `put`; `epoch_now` is validation_epoch. True: start an epoch before the next command.
+	bool observe(std::uint32_t get_now, std::uint32_t put, std::uint64_t epoch_now, bool defer_allowed) noexcept
+	{
+		// An epoch another source started since the last read covers every command visible at that read.
+		if (defer_allowed && armed && deferred && epoch_now != epoch && seen >= get)
+		{
+			horizon = seen;
+			deferred = false;
+		}
+
+		const bool changed = put != seen;
+		seen = put;
+		epoch = epoch_now;
+
+		if (put == horizon && !deferred)
+		{
+			return false; // nothing published since the covering epoch
+		}
+
+		// The next word the FIFO consumes is at get_now or at get_now + 4 (an argument read looks at PUT from the word
+		// before it): both must be below the horizon, so the word at the horizon is never consumed before its epoch.
+		if (defer_allowed && armed && put != horizon && get_now >= get && get_now < horizon && horizon - get_now > 4 &&
+			!(put >= get && put < horizon))
+		{
+			// Still below the horizon, walking up: the commands ahead were visible when the covering epoch started.
+			get = get_now;
+			deferred = true;
+			if (changed)
+			{
+				put_deferred.fetch_add(1, std::memory_order_relaxed);
+			}
+			return false;
+		}
+
+		horizon = put;
+		get = get_now;
+		armed = true;
+		deferred = false;
+		return true;
+	}
+
+	// The caller started the epoch observe() asked for.
+	void started(std::uint64_t epoch_now) noexcept
+	{
+		epoch = epoch_now;
+	}
+};
 }
