@@ -89,4 +89,15 @@ fragment float4 present_fragment(present_vertex_out in [[stage_in]], texture2d<f
 		const f32 half_height = static_cast<f32>(source_height * scale / target_height);
 		return {-half_width, -half_height, half_width, half_height};
 	}
+
+	// REWINDBOX_METAL_STRETCH_934: Stretch To Display Area fills the drawable, as the Vulkan renderer does
+	// (VKPresent.cpp keeps the aspect ratio only when the setting is off). An empty source or target draws nothing.
+	inline rectangle place(u32 source_width, u32 source_height, u32 target_width, u32 target_height, bool stretch) noexcept
+	{
+		if (!stretch || !source_width || !source_height || !target_width || !target_height)
+		{
+			return fit(source_width, source_height, target_width, target_height);
+		}
+		return {-1.f, -1.f, 1.f, 1.f};
+	}
