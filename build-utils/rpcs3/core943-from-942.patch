+inline std::atomic<std::uint32_t> lowered_queues{0};   // queues created in the lowered class since the process started
+inline std::atomic<std::uint64_t> boosts{0};           // waits that queued a raising block (this window)
+inline std::atomic<std::uint64_t> boost_failures{0};   // dispatch_block_create_with_qos_class returned nothing
+
+// Report thread: the line of this window. Reads and resets the window counters.
+inline std::string take_line(std::uint64_t session, std::uint64_t window)
+{
+	char line[288];
+	std::snprintf(line, sizeof(line),
+		"COREPROF MVKQOS943 session=%llu window=%llu enabled=%u class=user_initiated:0 lowered_queues=%u boosts=%llu "
+		"boost_failures=%llu scope=process_window",
