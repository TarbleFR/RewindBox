+		lowered_queues.load(std::memory_order_relaxed), static_cast<unsigned long long>(boosts.exchange(0, std::memory_order_relaxed)),
+		static_cast<unsigned long long>(boost_failures.exchange(0, std::memory_order_relaxed)));
+	return line;
+}
+} // namespace rpcs3::ios::mvk_encode_qos943
