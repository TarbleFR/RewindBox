diff --git a/rpcs3/ios/IOSFrameInterval943.h b/rpcs3/ios/IOSFrameInterval943.h
new file mode 100644
index 0000000..7cae755
--- /dev/null
+++ b/rpcs3/ios/IOSFrameInterval943.h
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSWorkInterval940.h"
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <utility>
+
+// REWINDBOX_FRAME_INTERVAL_943: tell iOS which threads make the frame and when it is due.
+//
+// IPA 763 (16 November 2026). The CPU is held to about 2 W once the phone has warmed, and that budget is paid in busy
+// performance cores: in God of War III, in the same thermal state, 1.28 busy P core runs at 3.3-3.4 GHz and 1.97 at
+// 1.27-1.41 GHz; Black Ops II capped, 1.85 at 1.8 GHz, with FPS = 16-18 x the P clock. Black Ops II at window 17
+// (thermal state still "nominal"): P 2.31 -> 1.80 GHz, E 2.42 -> 2.11 GHz and the GPU slowed together. iOS sets those
+// clocks from what it knows of the threads (CLPC); it does not know which ones make the frame.
+//
+// The probe of Core 940 (IOSWorkInterval940.h) showed on the device that this app can create a work interval with the
+// flags 0x47 (joinable, group, unrestricted, finish at deadline), join it, notify it and leave it (CONFIG_LAYERS
+// part=deadline_probe status=ok). Here the emulator's PPU threads and its RSX thread join one such interval when they
+// start (one thread group), and the RSX thread notifies it at each guest flip: the frame ran from the previous flip to
+// this one, and was due one 60 Hz period after the previous flip. A late frame asks iOS for more performance for that
+// group; a frame on time keeps it where it is. The SPU threads, the shader compilers and MoltenVK's encoder stay in the
+// application's default group. A gap of more than 200 ms between flips (loading, pause) is not reported.
+// Nothing changes in the emulation; only the scheduler's information. Setting Frame work interval: Automatic is Black
+// Ops II and God of War III, Enabled every title, Disabled none. COREPROF FRAMEWI943 reports what was done.
+namespace rpcs3::ios::frame_interval943
+{
+inline std::atomic<bool> enabled{false}; // resolved at boot (RPCS3IOSExperimentalPolicy.cpp)
+
+enum counter : std::uint32_t { joins, join_failures, leaves, notifies, notify_failures, late, skipped_gaps, count };
+inline std::array<std::atomic<std::uint64_t>, count> counters{};
+inline std::atomic<std::uint32_t> created_flags{0}; // 0 until an interval exists
+
+inline void add(counter c) noexcept
+{
+	counters[c].fetch_add(1, std::memory_order_relaxed);
+}
+
+#if defined(__APPLE__)
+inline work_interval940::api& calls() noexcept
+{
+	static work_interval940::api api;
+	static const bool loaded = api.load();
+	static_cast<void>(loaded);
+	return api;
+}
+
+inline std::mutex create_mutex;
+inline void* handle = nullptr;           // written once under create_mutex
+inline bool create_failed = false;       // under create_mutex
+inline thread_local bool tls_joined = false;
+inline thread_local std::uint64_t tls_last_flip = 0;
+
+// One interval for the process; 0x47 as the probe chose, 0x07 (no deadline flag) if iOS refuses it.
+inline void* get_or_create() noexcept
+{
+	std::lock_guard lock(create_mutex);
+
+	if (handle || create_failed)
+	{
+		return handle;
+	}
+
+	auto& wi = calls();
+
+	if (!wi.create || !wi.join || !wi.leave || !wi.notify)
+	{
+		create_failed = true;
+		return nullptr;
+	}
+
+	for (const std::uint32_t flags : {0x47u, 0x07u})
+	{
+		void* h = nullptr;
+
+		if (wi.create(&h, flags) == 0 && h)
+		{
+			handle = h;
+			created_flags.store(flags, std::memory_order_relaxed);
+			return h;
+		}
+	}
+
+	create_failed = true;
+	return nullptr;
+}
+
+// A PPU or RSX thread, when it starts (cpu_thread::operator()).
+inline void join_current() noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed) || tls_joined)
+	{
+		return;
+	}
+
+	void* const h = get_or_create();
+
+	if (h && calls().join(h) == 0)
+	{
+		tls_joined = true;
+		tls_last_flip = 0;
+		add(joins);
+	}
+	else
+	{
+		add(join_failures);
+	}
+}
+
+// The same thread, when it ends (its worker may run another job next).
+inline void leave_current() noexcept
+{
+	if (!tls_joined)
+	{
+		return;
+	}
+
+	calls().leave();
+	tls_joined = false;
+	tls_last_flip = 0;
+	add(leaves);
+}
+
+inline std::uint64_t mach_ticks(std::uint64_t ns) noexcept
+{
+	static const mach_timebase_info_data_t tb = [] { mach_timebase_info_data_t t{}; mach_timebase_info(&t); return t; }();
+	return tb.numer ? ns * tb.denom / tb.numer : ns * 3 / 125;
+}
+
+// The RSX thread, at each guest flip (rsx::thread::flip through rpcs3::ios::record_flip).
+inline void notify_flip() noexcept
+{
+	if (!tls_joined)
+	{
+		return;
+	}
+
+	const std::uint64_t now = mach_absolute_time();
+	const std::uint64_t previous = std::exchange(tls_last_flip, now);
+
+	if (!previous || now <= previous)
+	{
+		return;
+	}
+
+	static const std::uint64_t period = mach_ticks(16'666'667);
+	static const std::uint64_t gap = mach_ticks(200'000'000);
+
+	if (now - previous > gap)
+	{
+		add(skipped_gaps);
+		return;
+	}
+
+	const std::uint64_t deadline = previous + period;
+
+	if (now > deadline)
+	{
+		add(late);
+	}
+
+	add(calls().notify(handle, previous, now, deadline, now, 0) == 0 ? notifies : notify_failures);
+}
+#else
+inline void join_current() noexcept {}
+inline void leave_current() noexcept {}
+inline void notify_flip() noexcept {}
+#endif
+
+// Report thread: the line of this window. Reads and resets the counters.
+inline std::string take_line(std::uint64_t session, std::uint64_t window)
+{
+	unsigned long long v[count];
+
+	for (std::uint32_t i = 0; i < count; i++)
+	{
+		v[i] = counters[i].exchange(0, std::memory_order_relaxed);
+	}
+
+	char line[384];
+	std::snprintf(line, sizeof(line),
+		"COREPROF FRAMEWI943 session=%llu window=%llu enabled=%u flags=0x%x joins=%llu join_failures=%llu leaves=%llu notifies=%llu "
+		"notify_failures=%llu late=%llu skipped_gaps=%llu period_us=16667 scope=process_window",
+		static_cast<unsigned long long>(session), static_cast<unsigned long long>(window), enabled.load(std::memory_order_relaxed) ? 1u : 0u,
+		created_flags.load(std::memory_order_relaxed), v[joins], v[join_failures], v[leaves], v[notifies], v[notify_failures], v[late],
+		v[skipped_gaps]);
+	return line;
+}
+} // namespace rpcs3::ios::frame_interval943
diff --git a/rpcs3/ios/IOSGow3PollSleep943.h b/rpcs3/ios/IOSGow3PollSleep943.h
new file mode 100644
index 0000000..c4f7d4b
--- /dev/null
+++ b/rpcs3/ios/IOSGow3PollSleep943.h
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <string_view>
+
+// REWINDBOX_GOW3_POLL_SLEEP_943: God of War III 01.00 (PPU-4d5c5150...), the main thread's wait for SPU work.
+//
+// IPA 763, BCES00510, PID 27597, session 3, a new game (16 November 2026): from the first gameplay frame the title runs
+// at 9.7-12.8 fps (windows 44-54). Three SPURS kernels are busy in 93 % of 5,000 samples each, two others idle, and the
+// PPU main thread runs in 70 % of them, 52 % of all its samples returning to 0x2eafe8: the loop
+//
+//   0x2eafd8  mr r3,r30 / li r4,3 / mr r5,r31 / bl 0x2e7b18 / nop / clrlwi r3,r3,24 / cmpwi cr7,r3,0 / beq cr7,0x2eafd8
+//
+// of the function at 0x2eafb0, which calls 0x2e7b18(object, 3, object->0x2a) until it answers non-zero, then goes on at
+// 0x2eaff8. The main thread is in the user-interactive class, the SPU threads one class below (REWINDBOX_SPU_QOS_627):
+// the poll keeps a performance core while the kernels it waits for run on the efficiency cores. Energy per window
+// (ENERGY931): the two performance cores take 1.2-1.5 W of the 2.0-2.3 W the CPU is held to at 1.3 GHz, the main
+// thread 0.67-0.89 core of them (census top=).
+//
+// The loop is left as it is for a short wait. Once the first unanswered call is 100 us old (guest time base, 79.8 MHz),
+// each further unanswered call is followed by sys_timer_usleep(30), as the bundled Splatterhouse fix sleeps 100 us
+// between its searches. A wait still ends at the first call that answers; a long one is seen up to one sleep later.
+// The start of the wait is kept in the function's own frame at 0x70(r1), a local slot its prologue (0x2eafb0..0x2eafd0)
+// never writes; the nop at 0x2eafd4, just before the loop, stores the object pointer (r30) there as the "no wait yet"
+// mark. The rest is a code cave reached by a far jump from 0x2eaff4, as the patch engine builds them (code_alloc); the
+// cave leaves through absolute branches (ba 0x2eafd8, ba 0x2eaff8: both below 32 MiB), real guest instructions that a
+// savestate keeps. Written at a fresh boot only, on this executable only, and only if the eleven words 0x2eafd4..0x2eaffc
+// are the ones read on the device: any other content refuses the patch and says so (COREPROF GOW3POLL943
+// state=refused_guard). A savestate made from a patched boot holds the cave and the mark but not what the host keeps
+// (the cave's execution table, the far jump into it): on resume the loader finds the cave by its exact words and
+// registers both again, so a thread saved inside the cave (in its sleep, most often) resumes there; nothing is written.
+// Cost: the function at 0x2eafb0 contains a far jump, so it leaves LLVM and runs in the interpreter fallback, as every
+// function a code_alloc patch enters does; the loop is that function's own, the work it waits for is elsewhere.
+namespace rpcs3::ios::gow3_poll943
+{
+inline constexpr std::string_view executable = "PPU-4d5c51503a81a327c2a99427390a395b8dcb3767";
+inline constexpr std::uint32_t first_word = 0x002eafd4; // nop before the loop: becomes std r30,0x70(r1)
+inline constexpr std::uint32_t loop_start = 0x002eafd8;
+inline constexpr std::uint32_t branch_word = 0x002eaff4; // beq cr7,0x2eafd8: becomes the far jump to the cave
+inline constexpr std::uint32_t loop_exit = 0x002eaff8;
+
+// The words at 0x2eafd4..0x2eaffc as read from guest memory on the device (PPUPROF912 part=code from=2eaf00).
+inline constexpr std::array<std::uint32_t, 11> expected = {
+	0x60000000, // 2eafd4 nop
+	0x7fc3f378, // 2eafd8 mr r3,r30
+	0x38800003, // 2eafdc li r4,3
+	0x7fe5fb78, // 2eafe0 mr r5,r31
+	0x4bffcb35, // 2eafe4 bl 0x2e7b18
+	0x60000000, // 2eafe8 nop
+	0x5463063e, // 2eafec clrlwi r3,r3,24
+	0x2f830000, // 2eaff0 cmpwi cr7,r3,0
+	0x419effe4, // 2eaff4 beq cr7,0x2eafd8
+	0x7ba30020, // 2eaff8 clrldi r3,r29,32
+	0x4bffd7ad, // 2eaffc bl 0x2e87a8
+};
+
+inline constexpr std::uint32_t store_mark = 0xfbc10070; // std r30,0x70(r1)
+
+inline constexpr std::uint32_t spin_ticks = 7980; // 100 us at the PS3 time base (79.8 MHz)
+inline constexpr std::uint32_t sleep_us = 30;
+inline constexpr std::uint32_t cave_bytes = 0x10000;
+inline constexpr std::uint32_t data_offset = 0x8000; // two counters, in the writable second half of the cave
+
+// Cave layout: index of each word. jump_retry and jump_retry2 branch to loop_start, jump_exit to loop_exit.
+enum : std::uint32_t
+{
+	i_done = 0, i_now, i_load, i_cmp_mark, i_bne_mark, i_store_start, i_count_wait_hi, i_count_wait_ld, i_count_wait_add,
+	i_count_wait_st, jump_retry, i_elapsed, i_cmp_budget, i_blt_budget, i_count_sleep_hi, i_count_sleep_ld,
+	i_count_sleep_add, i_count_sleep_st, i_arg, i_code, i_sc, jump_retry2, jump_exit, cave_words
+};
+
+constexpr std::uint32_t bc(std::uint32_t bo, std::uint32_t bi, std::uint32_t from, std::uint32_t to) noexcept
+{
+	return 0x40000000u | bo << 21 | bi << 16 | (((to - from) * 4) & 0xfffcu);
+}
+
+// ba target: primary opcode 18, absolute (AA = 1), no link; the target must lie below 32 MiB.
+constexpr std::uint32_t branch_absolute(std::uint32_t target) noexcept
+{
+	return 0x48000002u | (target & 0x03fffffcu);
+}
+
+static_assert(loop_start < 0x02000000u && loop_exit < 0x02000000u, "absolute branches reach the first 32 MiB only");
+
+constexpr std::uint32_t hi16(std::uint32_t address) noexcept
+{
+	return (address + 0x8000u) >> 16; // for lis + a signed 16-bit displacement
+}
+
+constexpr std::uint32_t lo16(std::uint32_t address) noexcept
+{
+	return address & 0xffffu;
+}
+
+// The cave. data = cave + data_offset: data + 0 counts the waits that outlived the first call, data + 4 the sleeps (plain
+// guest loads and stores: a count may be lost if two threads poll at once; diagnostic only).
+constexpr std::array<std::uint32_t, cave_words> cave(std::uint32_t data) noexcept
+{
+	std::array<std::uint32_t, cave_words> w{};
+	const std::uint32_t waits = data, sleeps = data + 4;
+	w[i_done] = bc(4, 30, i_done, jump_exit);                 // bne cr7,exit: the call answered
+	w[i_now] = 0x7d8c42e6;                                    // mftb r12
+	w[i_load] = 0xe8010070;                                   // ld r0,0x70(r1)
+	w[i_cmp_mark] = 0x7ca0f000;                               // cmpd cr1,r0,r30: still the mark, no wait yet
+	w[i_bne_mark] = bc(4, 6, i_bne_mark, i_elapsed);          // bne cr1,elapsed
+	w[i_store_start] = 0xf9810070;                            // std r12,0x70(r1): the wait starts now
+	w[i_count_wait_hi] = 0x3d600000u | hi16(waits);           // lis r11,waits@ha
+	w[i_count_wait_ld] = 0x800b0000u | lo16(waits);           // lwz r0,waits@l(r11)
+	w[i_count_wait_add] = 0x30000001;                         // addic r0,r0,1
+	w[i_count_wait_st] = 0x900b0000u | lo16(waits);           // stw r0,waits@l(r11)
+	w[jump_retry] = branch_absolute(loop_start);              // ba 0x2eafd8: call again at once
+	w[i_elapsed] = 0x7d806050;                                // subf r12,r0,r12: ticks since the first call
+	w[i_cmp_budget] = 0x28ac0000u | spin_ticks;               // cmpldi cr1,r12,spin_ticks
+	w[i_blt_budget] = bc(12, 4, i_blt_budget, jump_retry2);   // blt cr1,retry2: still within the spin
+	w[i_count_sleep_hi] = 0x3d600000u | hi16(sleeps);         // lis r11,sleeps@ha
+	w[i_count_sleep_ld] = 0x800b0000u | lo16(sleeps);         // lwz r0,sleeps@l(r11)
+	w[i_count_sleep_add] = 0x30000001;                        // addic r0,r0,1
+	w[i_count_sleep_st] = 0x900b0000u | lo16(sleeps);         // stw r0,sleeps@l(r11)
+	w[i_arg] = 0x38600000u | sleep_us;                        // li r3,sleep_us
+	w[i_code] = 0x3960008d;                                   // li r11,141 (sys_timer_usleep)
+	w[i_sc] = 0x44000002;                                     // sc
+	w[jump_retry2] = branch_absolute(loop_start);             // ba 0x2eafd8: call again
+	w[jump_exit] = branch_absolute(loop_exit);                // ba 0x2eaff8: the loop is over
+	return w;
+}
+
+enum class state : std::uint32_t
+{
+	unset = 0, applied, policy_off,
+	savestate,          // a resumed savestate whose memory holds no cave (made from an unpatched boot): the game's loop
+	other_executable, refused_guard, no_memory, no_jump,
+	savestate_restored, // a resumed savestate made from a patched boot: its cave found and registered again
+};
+
+inline std::atomic<std::uint32_t> applied_state{0};
+inline std::atomic<std::uint32_t> cave_address{0};
+inline std::atomic<std::uint32_t> mismatch_address{0};
+
+inline const char* name(std::uint32_t s) noexcept
+{
+	switch (static_cast<state>(s))
+	{
+	case state::applied: return "applied";
+	case state::policy_off: return "policy_off";
+	case state::savestate: return "savestate";
+	case state::other_executable: return "other_executable";
+	case state::refused_guard: return "refused_guard";
+	case state::no_memory: return "no_memory";
+	case state::no_jump: return "no_jump";
+	case state::savestate_restored: return "savestate_restored";
+	default: return "unset";
+	}
+}
+} // namespace rpcs3::ios::gow3_poll943
diff --git a/rpcs3/ios/IOSMoltenVKEncodeQoS943.h b/rpcs3/ios/IOSMoltenVKEncodeQoS943.h
new file mode 100644
index 0000000..44bccaf
--- /dev/null
+++ b/rpcs3/ios/IOSMoltenVKEncodeQoS943.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+// REWINDBOX_MVK_ENCODE_QOS_943: in Black Ops II, MoltenVK's encoding queue in the SPU threads' class instead of the
+// RSX thread's, and in the RSX thread's class again while that thread waits for it.
+//
+// IPA 763 (16 November 2026), Black Ops II in play once the phone has warmed: the CPU is held to about 2 W; a busy
+// performance core costs 0.72-0.78 W at 1.8 GHz, an efficiency core 0.23 W at 2.1 GHz for about 1/1.4 of its work
+// (COREPROF ENERGY931). The encoding of submissions and presents on MoltenVK's queue, the unnamed threads of the census
+// (0.27 to 0.31 core), runs in the user-interactive class with the PPU and RSX threads (qos_ms: 1.58 cores in that class
+// for PPU 0.93 + RSX 0.38 + 0.29), on the performance cores: some 0.22 W, where the same work on efficiency cores costs
+// about 0.09 W. It is rarely on the frame's path: in play the RSX thread waited for it before vkAcquireNextImageKHR
+// 0 times per 5 s window, and before a query result 16 to 29 times for 13 to 34 ms (COREPROF OPT587).
+//
+// The class before Core 943 is user-interactive, relative priority -15: REWINDBOX_MOLTENVK_ASYNC_SUBMITS_V1 asks for
+// VK_QUEUE_GLOBAL_PRIORITY_HIGH (vkutils/device.cpp) because the user-initiated queue of MEDIUM ran below the threads
+// that waited for it, and MoltenVK 1.4.2 maps HIGH to QOS_CLASS_USER_INTERACTIVE with -15 (MVKQueue::initExecQueue).
+// Here the queue of the presenting VkQueue, whose submissions and presents carry the encoding tickets
+// (ios/IOSMoltenVKExec.h), is created user-initiated, relative priority 0, through rbx_mvk_exec_q_create
+// (RPCS3IOSPlatform.mm): the class and priority of the SPU threads since REWINDBOX_SPU_QOS_627, which iOS runs on the
+// efficiency cores in play (Black Ops II: 2.7 to 2.8 of the 4 busy, 0.26 core spilling to the performance cores). Not
+// the utility class: a utility thread waits while user-initiated work is ready on its cluster (XNU Clutch), so it
+// would run after the SPU threads instead of beside them. When the RSX thread has to wait for an encoding (acquire,
+// fence or query: ios/IOSMoltenVKExecQueue.h) it first queues an empty block in its own class with
+// DISPATCH_BLOCK_ENFORCE_QOS_CLASS: libdispatch then runs the queue in that class until it has drained, as it does for
+// dispatch_sync. The work, its order and its queue do not change; the spare transfer queue keeps its class.
+//
+// Black Ops II only (Automatic). God of War III keeps the Core 942 class: its SPU threads use 3.4 to 3.7 cores in
+// play, more than the efficiency cores hold, so the encoder would share a saturated cluster. Other waits for the
+// presenting queue are not raised (a DMA readback's wait_for_event, vkQueueWaitIdle): in the SPU threads' class the
+// encoder shares the cluster with them, it does not wait behind them. Setting MoltenVK encoding class (Experimental,
+// MoltenVK): Automatic is Black Ops II, Enabled every title, Disabled none; with asynchronous submits only, read when
+// the Vulkan device is created. COREPROF MVKQOS943 reports it; ENERGY931 qos_ms shows the encoding moving from the
