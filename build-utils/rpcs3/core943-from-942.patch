 inline std::atomic<bool> scoped_cpu_blit{true};
 
+// REWINDBOX_TEXVAL_CENSUS_943: what the hashed validations of each kind of epoch find. IPA 763 (16 November 2026), God
+// of War III in play (session 3, window 48): 1,350 epochs per 5 s window (1,108 of them a patched jump-to-itself,
+// EPOCH909 put_patched), 12,124 validations hashed by the RSX thread (OPT581 misses) for 355 texture uploads (TEXCACHE621),
+// 15 to 27 ms of texture stage per frame (RSXFRAME551). Which epochs are followed by a changed texture, and in which
+// memory, is the measurement a narrower validation would need. Measurement only: sync() counts what it hashed and what
+// it found, by the source of the last epoch (COREPROF TEXVAL943); the validation itself is unchanged.
+constexpr std::size_t census_patched = static_cast<std::size_t>(epoch_source::count); // a patched jump (a put epoch)
+constexpr std::size_t census_slots = census_patched + 1;
+inline std::atomic<std::uint8_t> last_epoch_source{0};
+inline std::array<std::atomic<std::uint64_t>, census_slots> census_hashed{};
+inline std::array<std::atomic<std::uint64_t>, census_slots> census_changed{};
+inline std::atomic<std::uint64_t> census_prehashed{0}, census_hashed_bytes{0}, census_changed_bytes{0};
+inline std::atomic<std::uint64_t> census_changed_local{0}, census_changed_main{0};
+
+// sync(), after a validation that did not take the epoch shortcut. RSX local memory starts at 0xC0000000.
+inline void census_validation(std::uint32_t start, std::uint64_t length, bool prehashed, bool unchanged) noexcept
+{
+	const std::size_t slot = std::min<std::size_t>(last_epoch_source.load(std::memory_order_relaxed), census_slots - 1);
+	census_hashed[slot].fetch_add(1, std::memory_order_relaxed);
+	(prehashed ? census_prehashed : census_hashed_bytes).fetch_add(prehashed ? 1 : length, std::memory_order_relaxed);
+
+	if (!unchanged)
+	{
+		census_changed[slot].fetch_add(1, std::memory_order_relaxed);
+		census_changed_bytes.fetch_add(length, std::memory_order_relaxed);
+		(start >= 0xC0000000u ? census_changed_local : census_changed_main).fetch_add(1, std::memory_order_relaxed);
+	}
+}
+
 inline void advance_epoch(epoch_source source = epoch_source::other) noexcept
