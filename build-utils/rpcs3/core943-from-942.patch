diff --git a/rpcs3/ios/IOSPpuWaitFloor943.h b/rpcs3/ios/IOSPpuWaitFloor943.h
new file mode 100644
index 0000000..2fe9909
--- /dev/null
+++ b/rpcs3/ios/IOSPpuWaitFloor943.h
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <utility>
+
+// REWINDBOX_PPU_WAIT_FLOOR_943: a PPU polling loop's short lv2 timed waits last longer before they time out.
+//
+// IPA 763 (16 November 2026), Black Ops II in play (BLES01717, PID 27739, session 2, windows 8-44): 64,000 to 91,000
+// host timed waits of guest threads shorter than 200 us per 5 s window, all but 0.3 % ending at their bound
+// (COREPROF WAKE936: 13,000 to 18,000 a second), and 66,000 context switches a second for the process (SCHED918),
+// where God of War III in play has about 1,000 such waits a second. The PPU threads take 0.93 to 0.98 core while the
+// samples find them running guest code 0.41 thread (PPUPROF912), and the ones that do the frame's work wait for a PPU
+// slot: Backend is suspended in 27 % of the samples, 1,510 times of 1,545 just after a sys_semaphore_post, the main
+// thread in 17 %, Secondary in 13 %; the main thread itself is in sys_timer_usleep in 75 % of them.
+//
+// With the iOS timer accuracy (As Host), every such wait is a round of the lv2 scheduler: the thread leaves its slot
+// (lv2_obj::sleep), a suspended thread is woken into it, the timer ends the wait some tens of microseconds later, the
+// thread takes its slot back by priority (cpu_sleep -> lv2_obj::awake), the thread it displaces is suspended and must
+// acknowledge it (g_pending) before the woken one runs: four context switches and three lock rounds for one check
+// of a flag, more than 13,000 times a second, on the performance cores the frame needs.
+//
+// An lv2 timeout gives a minimum duration, never a maximum: on the console as here, a thread that waits longer than
+// asked is correct. Only a polling loop is lengthened: the same wait made again, that is the same PPU thread, the same
+// system call (r11), the same first argument (r3: the object, or the time of a usleep) and the same timeout, after the
+// previous one ran to its bound. From the second such wait, its timeout is four times the one asked, at most 200 us
+// (usleep and the timeouts of semaphores, condition variables, event queues and mutexes alike). A different wait, a
+// wait without a timeout, a long one or one that was signalled ends the streak; a signalled wait still ends at once.
+// A polling loop then makes up to four times fewer rounds and sees its flag up to three timeouts later; a loop that
+// polls with a bounded count of short waits lasts at most four times as long; a poll of several objects in turn is
+// left as it is. Nothing else changes: no synchronisation primitive, priority or slot rule. Setting PPU short wait
+// floor (Experimental, PPU): Automatic is Black Ops II, Enabled every title, Disabled none. COREPROF PPUWAITFLOOR943
+// says how many waits were lengthened, from which system calls and from what timeouts; WAKE936 shows the waits under
+// 200 us thinning out.
+namespace rpcs3::ios::ppu_wait_floor943
+{
+inline constexpr std::uint64_t floor_us = 200;
+inline constexpr std::uint64_t stretch = 4;
+
+inline std::atomic<bool> enabled{false}; // resolved at boot (RPCS3IOSExperimentalPolicy.cpp)
+
+enum counter : std::uint32_t { raised, kept_first, under_20, under_50, under_100, under_200, requested_us, granted_us, count };
+inline std::array<std::atomic<std::uint64_t>, count> counters{};
+inline std::array<std::atomic<std::uint32_t>, 1024> by_syscall{}; // lengthened waits by system call number (r11)
+
+// The polling rule, per host thread: the key of the last short timed wait and how many times in a row that same wait
+// ran to its bound. A pooled host thread may carry it from one PPU thread to the next; the thread is part of the key.
+struct streak_state
+{
+	const void* thread = nullptr;
+	std::uint64_t syscall = 0;
+	std::uint64_t object = 0;
+	std::uint64_t timeout = 0;
+	std::uint32_t runs = 0;  // consecutive waits with this key that ran to their bound
+	bool armed = false;      // the wait now starting has this key (wait_ended updates runs)
+};
+
+inline thread_local streak_state tls_streak{};
+
+inline void add(counter c, std::uint64_t n = 1) noexcept
+{
+	counters[c].fetch_add(n, std::memory_order_relaxed);
+}
+
+// lv2_obj::sleep_unlocked, on the PPU thread that is about to wait (it called lv2_obj::sleep itself), before the
+// timeout is registered. `timeout` in guest microseconds (0: no timeout). Returns the timeout to use.
+inline std::uint64_t apply(std::uint64_t timeout, const void* thread, std::uint64_t syscall, std::uint64_t object) noexcept
+{
+	streak_state& s = tls_streak;
+
+	if (!enabled.load(std::memory_order_relaxed) || !timeout || timeout >= floor_us)
+	{
+		s = {}; // an untimed or long wait ends any streak
+		return timeout;
+	}
+
+	if (s.thread != thread || s.syscall != syscall || s.object != object || s.timeout != timeout)
+	{
+		s = {thread, syscall, object, timeout, 0, true};
+		add(kept_first);
+		return timeout;
+	}
+
+	s.armed = true;
+
+	if (!s.runs)
+	{
+		add(kept_first);
+		return timeout;
+	}
+
+	const std::uint64_t granted = std::min(floor_us, timeout * stretch);
+	add(raised);
+	add(timeout < 20 ? under_20 : timeout < 50 ? under_50 : timeout < 100 ? under_100 : under_200);
+	add(requested_us, timeout);
+	add(granted_us, granted);
+	by_syscall[syscall < by_syscall.size() ? syscall : 0].fetch_add(1, std::memory_order_relaxed);
+	return granted;
+}
+
+// lv2_obj::wait_timeout, on the same thread, when its wait is over: whether it ran to its bound (or was given a forced
+// timeout notification). A wait whose end had already passed when wait_timeout was entered does not come here.
+inline void wait_ended(bool ran_to_bound) noexcept
+{
+	streak_state& s = tls_streak;
+
+	if (!s.armed)
+	{
+		return;
+	}
+
+	s.armed = false;
+	s.runs = ran_to_bound ? s.runs + 1 : 0;
+}
+
+// Report thread: the line of this window. Reads and resets the counters.
+inline std::string take_line(std::uint64_t session, std::uint64_t window)
+{
+	unsigned long long v[count];
+
+	for (std::uint32_t i = 0; i < count; i++)
+	{
+		v[i] = counters[i].exchange(0, std::memory_order_relaxed);
+	}
+
+	std::array<std::pair<std::uint32_t, std::uint32_t>, 4> top{}; // (count, syscall)
+
+	for (std::uint32_t code = 0; code < by_syscall.size(); code++)
+	{
+		const std::uint32_t n = by_syscall[code].exchange(0, std::memory_order_relaxed);
+
+		if (n > top.back().first)
+		{
+			top.back() = {n, code};
+			std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+		}
+	}
+
+	std::string calls;
+
+	for (const auto& [n, code] : top)
+	{
+		if (n)
+		{
+			char part[32];
+			std::snprintf(part, sizeof(part), "%s%u:%u", calls.empty() ? "" : ",", code, n);
+			calls += part;
+		}
+	}
+
+	const double raised_waits = static_cast<double>(v[raised]);
+	char line[512];
+	std::snprintf(line, sizeof(line),
+		"COREPROF PPUWAITFLOOR943 session=%llu window=%llu enabled=%u floor_us=%llu stretch=%llu raised=%llu kept_first=%llu "
+		"requested_avg_us=%.1f granted_avg_us=%.1f under_20us=%llu under_50us=%llu under_100us=%llu under_200us=%llu syscalls=%s "
+		"scope=process_window",
+		static_cast<unsigned long long>(session), static_cast<unsigned long long>(window), enabled.load(std::memory_order_relaxed) ? 1u : 0u,
+		static_cast<unsigned long long>(floor_us), static_cast<unsigned long long>(stretch), v[raised], v[kept_first],
+		v[raised] ? static_cast<double>(v[requested_us]) / raised_waits : 0.0, v[raised] ? static_cast<double>(v[granted_us]) / raised_waits : 0.0,
+		v[under_20], v[under_50], v[under_100], v[under_200], calls.empty() ? "-" : calls.c_str());
+	return line;
+}
+} // namespace rpcs3::ios::ppu_wait_floor943
diff --git a/rpcs3/ios/IOSSchedCensus943.h b/rpcs3/ios/IOSSchedCensus943.h
new file mode 100644
index 0000000..a427e7f
--- /dev/null
+++ b/rpcs3/ios/IOSSchedCensus943.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+// REWINDBOX_SCHED_CENSUS_943: what the lv2 PPU scheduler costs, counted where it happens. Measurement only.
+//
+// IPA 763 (16 November 2026). Black Ops II in play: the PPU threads take 0.93-0.98 core (census ppu_cores) while the
+// samples find them running 0.41 thread on average (PPUPROF912), and Backend, main and Secondary carry
+// cpu_flag::suspend in 27 %, 17 % and 13 % of the samples: 0.56 thread waiting for one of the two slots
+// (g_cfg.core.ppu_threads) on average while 0.6 slot is in use. God of War III before play (60 fps, 3 minutes): the
+// main thread takes 0.93-0.97 core while it runs guest code in 7 % of the samples; 58 % carry cpu_flag::suspend and
+// 20 % cpu_flag::memory (resuming), with 57-58 thousand context switches a second for the process.
+//
+// Two upstream rules can hold a thread back while a slot is free, and both are counted here:
+// - lv2_obj::schedule_all() wakes nothing while g_pending is not zero, that is while a thread told to give its slot
+//   up has not acknowledged it (it does so itself, at its next check_state or sleep);
+// - vm::_register_lock() spins without a pause until one of the ppu_threads memory slots is free.
+// The report (COREPROF SCHED943) says how often each held a thread back and for how long.
+namespace rpcs3::ios::sched943
+{
+enum counter : std::uint32_t
+{
+	suspensions,          // a thread beyond the slots told to give its slot up (awake_unlocked)
+	self_acks,            // acknowledged by the suspended thread itself in awake_unlocked (at once, or from its cpu_sleep)
+	acks,                 // acknowledged when the suspended thread went to sleep (sleep_unlocked)
+	gate_blocked,         // schedule_all() with g_pending: a thread within the slots stayed suspended
+	gate_pending_running, // ... and a thread owing its acknowledgment was running guest code (no cpu_flag::wait)
+	gate_pending_waiting, // ... and every thread owing it was in a host wait (cpu_flag::wait)
+	resumes,              // threads schedule_all() woke into a slot
+	pending_ticks,        // time with g_pending > 0 (get_tsc ticks)
+	pending_episodes,     // g_pending going from 0 to 1
+	register_calls,       // vm::_register_lock()
+	register_waited,      // ... that found both slots taken at least once
+	register_ticks,       // time spent in those (get_tsc ticks)
+	suspend_waits,        // cpu_wait() calls of a thread with cpu_flag::suspend (PPU, and SPU threads of a suspended group)
+	count
+};
+
+inline std::array<std::atomic<std::uint64_t>, count> counters{};
+
+inline void add(counter c, std::uint64_t n = 1) noexcept
+{
+	counters[c].fetch_add(n, std::memory_order_relaxed);
+}
+
+// g_pending is changed under lv2_obj::g_mutex only; these two are called there, right after it changes.
+inline std::uint64_t pending_since = 0;
+
+template <typename Clock>
+inline void pending_changed(std::uint32_t pending_now, Clock&& tsc) noexcept
+{
+	if (pending_now && !pending_since)
+	{
+		pending_since = tsc();
+		add(pending_episodes);
+	}
+	else if (!pending_now && pending_since)
+	{
+		const std::uint64_t now = tsc();
+		add(pending_ticks, now > pending_since ? now - pending_since : 0);
+		pending_since = 0;
+	}
+}
+
+// Report thread: the line of this window. Reads and resets the counters. A pending period still open at the report is
+// counted when it ends, in the window it ends in.
+inline std::string take_line(std::uint64_t session, std::uint64_t window, std::uint64_t tsc_frequency)
+{
+	unsigned long long v[count];
+
+	for (std::uint32_t i = 0; i < count; i++)
+	{
+		v[i] = counters[i].exchange(0, std::memory_order_relaxed);
+	}
+
+	const auto ms = [tsc_frequency](unsigned long long ticks) { return tsc_frequency ? ticks * 1000.0 / static_cast<double>(tsc_frequency) : 0.0; };
+	char line[512];
+	std::snprintf(line, sizeof(line),
+		"COREPROF SCHED943 session=%llu window=%llu suspensions=%llu self_acks=%llu acks=%llu gate_blocked=%llu "
+		"gate_pending=%llu:%llu gate_pending_order=running:waiting resumes=%llu pending_episodes=%llu pending_ms=%.3f "
+		"register=%llu:%llu register_wait_ms=%.3f suspend_waits=%llu scope=process_window",
+		static_cast<unsigned long long>(session), static_cast<unsigned long long>(window), v[suspensions], v[self_acks], v[acks],
+		v[gate_blocked], v[gate_pending_running], v[gate_pending_waiting], v[resumes], v[pending_episodes], ms(v[pending_ticks]),
+		v[register_calls], v[register_waited], ms(v[register_ticks]), v[suspend_waits]);
+	return line;
+}
+} // namespace rpcs3::ios::sched943
