diff --git a/rpcs3/ios/IOSSpuObjectPrefetch.h b/rpcs3/ios/IOSSpuObjectPrefetch.h
new file mode 100644
index 0000000..62dc2dd
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectPrefetch.h
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <sys/qos.h>
+#endif
+
+// REWINDBOX_SPU_OBJECT_PREFETCH_616: Call of Duty: Black Ops II (BLES01717),
+// Build 614 iPhone logs (PID 64664, multiplayer session 3). At the start of a
+// match one 5 s window opens 7,162 cached SPU objects (JITPROF spu_cache_read
+// 7,162 calls, 4,300.8 ms, 21.2 MB inflated, 0.6 ms per object of about 3 KB):
+// the cost of opening thousands of small files on the compile path, not their
+// size. The 2,038.7 ms frame 2388 of that window has no blocking pipeline and
+// no LLVM budget wait; the 1,121.4 ms frame 3537 (window 17) also falls in a
+// burst of 613 object reads. The objects are already on disk: this module reads
+// the bytes of the title's object directory into memory on one utility-class
+// thread from the runtime's creation (menus, loading), newest objects first and
+// within a byte budget. A compile thread that needs an object takes its bytes
+// once (they leave the store) and inflates and validates them exactly as it
+// would after reading the file; an object not read yet is claimed and read from
+// the disk as before, never awaited. Same bytes, same validation, same link:
+// guest code is unchanged. Title scoped (ios/IOSTitleLevers.h); the store is
+// emptied when emulation stops.
+namespace rpcs3::ios::spu_object_prefetch
+{
+inline constexpr std::uint64_t max_resident_bytes = 48ull << 20;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 10; // larger objects keep the disk path
+inline constexpr std::uint64_t min_file_bytes = 18;           // smallest gzip member
+
+struct candidate
+{
+	std::string name;
+	std::uint64_t bytes = 0;
+	std::int64_t mtime = 0;
+};
+
+// Compressed objects (".gz") within the per-file bounds, newest first (then by
+// name), as long as they fit in the budget.
+inline std::vector<candidate> plan(std::vector<candidate> entries, std::uint64_t budget = max_resident_bytes,
+	std::uint64_t file_limit = max_file_bytes)
+{
+	std::erase_if(entries, [file_limit](const candidate& entry)
+	{
+		const std::string_view name = entry.name;
+		return name.size() <= 3 || name.substr(name.size() - 3) != ".gz" || entry.bytes < min_file_bytes || entry.bytes > file_limit;
+	});
+
+	std::sort(entries.begin(), entries.end(), [](const candidate& a, const candidate& b)
+	{
+		return a.mtime != b.mtime ? a.mtime > b.mtime : a.name < b.name;
+	});
+
+	std::vector<candidate> chosen;
+	std::uint64_t total = 0;
+
+	for (candidate& entry : entries)
+	{
+		if (entry.bytes > budget - total)
+		{
+			continue;
+		}
+
+		total += entry.bytes;
+		chosen.push_back(std::move(entry));
+	}
+
+	return chosen;
+}
+
+// Reads the whole file into `out`; false when it cannot or its size is not `expected`.
+using reader_fn = std::function<bool(const std::string& path, std::uint64_t expected, std::vector<unsigned char>& out)>;
+
+struct window_counters
+{
+	std::uint64_t hits = 0, hit_bytes = 0;   // objects served from memory
+	std::uint64_t claimed = 0;               // planned objects a compile thread read from disk first
+	std::uint64_t dropped = 0;               // read, but claimed meanwhile
+	std::uint64_t read = 0, read_bytes = 0, read_us = 0, failures = 0;
+};
+
+struct gauges
+{
+	bool active = false, done = false;
+	std::uint64_t planned = 0, planned_bytes = 0, pending = 0, resident = 0, resident_bytes = 0;
+};
+
+class store
+{
+	mutable std::mutex m_mutex;
+	std::unordered_map<std::string, std::vector<unsigned char>> m_ready; // full path of the ".gz" object
+	std::unordered_set<std::string> m_pending;                         // planned, neither read nor claimed
+	std::uint64_t m_resident_bytes = 0, m_planned = 0, m_planned_bytes = 0;
+	std::thread m_worker;
+	std::atomic<bool> m_stop{false}, m_active{false}, m_done{false};
+	window_counters m_window{};
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+	~store() { stop(); }
+
+	void start(std::string directory, std::vector<candidate> chosen, reader_fn reader)
+	{
+		stop();
+
+		{
+			std::lock_guard lock(m_mutex);
+			m_planned = chosen.size();
+			m_planned_bytes = 0;
+
+			for (const candidate& entry : chosen)
+			{
+				m_pending.insert(directory + entry.name);
+				m_planned_bytes += entry.bytes;
+			}
+		}
+
+		m_stop.store(false);
+		m_done.store(chosen.empty());
+		m_active.store(true);
+
+		if (chosen.empty())
+		{
+			return;
+		}
+
+		m_worker = std::thread([this, directory = std::move(directory), chosen = std::move(chosen), reader = std::move(reader)]()
+		{
+#if defined(__APPLE__)
+			pthread_setname_np("SPU object prefetch");
+			pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#endif
+			for (const candidate& entry : chosen)
+			{
+				if (m_stop.load(std::memory_order_relaxed))
+				{
+					break;
+				}
+
+				std::string path = directory + entry.name;
+
+				{
+					std::lock_guard lock(m_mutex);
+					if (!m_pending.contains(path))
+					{
+						continue; // claimed by a compile thread
+					}
+				}
+
+				std::vector<unsigned char> bytes;
+				const auto started = std::chrono::steady_clock::now();
+				const bool ok = reader(path, entry.bytes, bytes) && bytes.size() == entry.bytes;
+				const auto elapsed = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - started).count());
+
+				std::lock_guard lock(m_mutex);
+				m_window.read_us += elapsed;
+
+				if (!m_pending.erase(path))
+				{
+					m_window.dropped++;
+					continue;
+				}
+
+				if (!ok)
+				{
+					m_window.failures++;
+					continue;
+				}
+
+				m_window.read++;
+				m_window.read_bytes += bytes.size();
+				m_resident_bytes += bytes.size();
+				m_ready.emplace(std::move(path), std::move(bytes));
+			}
+
+			m_done.store(true);
+		});
+	}
+
+	// The prefetched bytes of this ".gz" object, once; nothing when they are
+	// not in memory (the caller reads the file, and the worker will skip it).
+	std::optional<std::vector<unsigned char>> take(const std::string& gz_path)
+	{
+		if (!m_active.load(std::memory_order_relaxed))
+		{
+			return std::nullopt;
+		}
+
+		std::lock_guard lock(m_mutex);
+
+		if (auto found = m_ready.find(gz_path); found != m_ready.end())
+		{
+			std::vector<unsigned char> bytes = std::move(found->second);
+			m_ready.erase(found);
+			m_resident_bytes -= bytes.size();
+			m_window.hits++;
+			m_window.hit_bytes += bytes.size();
+			return bytes;
+		}
+
+		if (m_pending.erase(gz_path))
+		{
+			m_window.claimed++;
+		}
+
+		return std::nullopt;
+	}
+
+	// Joins the worker and frees every byte still held.
+	void stop()
+	{
+		m_stop.store(true);
+
+		if (m_worker.joinable())
+		{
+			m_worker.join();
+		}
+
+		m_active.store(false);
+		std::lock_guard lock(m_mutex);
+		m_ready.clear();
+		m_pending.clear();
+		m_resident_bytes = 0;
+		m_planned = 0;
+		m_planned_bytes = 0;
+	}
+
+	window_counters take_window()
+	{
+		std::lock_guard lock(m_mutex);
+		return std::exchange(m_window, window_counters{});
+	}
+
+	gauges current() const
+	{
+		std::lock_guard lock(m_mutex);
+		return {m_active.load(), m_done.load(), m_planned, m_planned_bytes, m_pending.size(), m_ready.size(), m_resident_bytes};
+	}
+};
+
+inline store& instance()
+{
+	static store s_store;
+	return s_store;
+}
+}
diff --git a/rpcs3/ios/IOSTextureCacheProfile.h b/rpcs3/ios/IOSTextureCacheProfile.h
new file mode 100644
index 0000000..bfe711e
--- /dev/null
+++ b/rpcs3/ios/IOSTextureCacheProfile.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_TEXCACHE_PROFILE_621: what the Vulkan texture cache did in each
+// performance window. Build 620 Black Ops II multiplayer spent 6-7 ms per frame
+// in the RSX texture stage and its resident texture memory kept growing, but no
+// journal line said whether that came from uploads, cache misses, flushes, surface
+// copies for samplers or memory never released. The RSX thread adds the texture
+// cache's own per-frame statistics just before they are reset at the end of each
+// frame, counts the temporary subresource copies the draw path makes for samplers,
+// and counts the depth/color feedback barriers of render targets (Assassin's Creed
+// torch passages). The performance reporter exchanges the sums once per window
+// into one COREPROF TEXCACHE621 line. Counting changes no texture, copy, barrier,
+// eviction or cache decision.
+namespace rpcs3::ios::texture_cache_profile
+{
+struct window_counters
+{
+	std::atomic<std::uint64_t> frames{0};               // frame ends sampled
+	std::atomic<std::uint64_t> upload_calls{0};         // texture upload calls (cache lookups for sampling)
+	std::atomic<std::uint64_t> upload_misses{0};        // of which needed a new upload
+	std::atomic<std::uint64_t> cache_misses{0};         // flushes that missed (data had to be read back)
+	std::atomic<std::uint64_t> flushes{0};              // flush requests (GPU to guest memory)
+	std::atomic<std::uint64_t> hard_faults{0};          // unavoidable hard faults
+	std::atomic<std::uint64_t> copies_elided{0};        // copies the cache avoided
+	std::atomic<std::uint64_t> temp_subresources{0};    // sampler copies of surface regions made by the draw path
+	std::atomic<std::uint64_t> temp_failures{0};        // of which failed (out of memory)
+	std::atomic<std::uint64_t> feedback_barriers{0};    // render_target::texture_barrier inserted
+	std::atomic<std::uint64_t> feedback_skipped{0};     // back-to-back read-only depth barriers skipped
+	std::atomic<std::uint64_t> post_barriers{0};        // render_target::post_texture_barrier inserted
+	std::atomic<std::uint64_t> post_skipped{0};         // fall-out barriers elided (no write in the chain)
+	// Gauges: the last frame end of the window, and the window peak.
+	std::atomic<std::uint64_t> texture_bytes{0}, texture_bytes_peak{0};
+	std::atomic<std::uint64_t> temp_bytes{0}, temp_bytes_peak{0};
+	std::atomic<std::uint64_t> unreleased{0};
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+inline void raise(std::atomic<std::uint64_t>& peak, std::uint64_t value) noexcept
+{
+	auto current = peak.load(std::memory_order_relaxed);
+	while (value > current && !peak.compare_exchange_weak(current, value, std::memory_order_relaxed))
+	{
+	}
+}
+
+struct frame_statistics
+{
+	std::uint64_t upload_calls = 0, upload_misses = 0, cache_misses = 0, flushes = 0, hard_faults = 0, copies_elided = 0;
+	std::uint64_t texture_bytes = 0, temp_bytes = 0, unreleased = 0;
+};
+
+// Called by the RSX thread once per frame, before the cache resets its statistics.
+inline void on_frame_end(const frame_statistics& s) noexcept
+{
+	auto& c = counters;
+	add(c.frames);
+	add(c.upload_calls, s.upload_calls);
+	add(c.upload_misses, s.upload_misses);
+	add(c.cache_misses, s.cache_misses);
+	add(c.flushes, s.flushes);
+	add(c.hard_faults, s.hard_faults);
+	add(c.copies_elided, s.copies_elided);
+	c.texture_bytes.store(s.texture_bytes, std::memory_order_relaxed);
+	c.temp_bytes.store(s.temp_bytes, std::memory_order_relaxed);
+	c.unreleased.store(s.unreleased, std::memory_order_relaxed);
+	raise(c.texture_bytes_peak, s.texture_bytes);
+	raise(c.temp_bytes_peak, s.temp_bytes);
+}
+
+// A temporary subresource the draw path asked the cache for; `ok` is false when it failed.
+inline void on_temporary_subresource(bool ok) noexcept
+{
+	add(counters.temp_subresources);
+	if (!ok) add(counters.temp_failures);
+}
+}
diff --git a/rpcs3/ios/IOSTitleLevers.h b/rpcs3/ios/IOSTitleLevers.h
index 2fe17df..58782d1 100644
--- a/rpcs3/ios/IOSTitleLevers.h
+++ b/rpcs3/ios/IOSTitleLevers.h
@@ -84,4 +84,75 @@ constexpr bool requires_position_invariance(std::string_view title_id) noexcept
 {
 	return is_black_ops_ii_title(title_id) || is_assassins_creed_title(title_id);
 }
+
+// REWINDBOX_ZCLIP_WINDOW_Z_616: Black Ops II draws an object in front of the
+// whole scene with the clip range [1, 1e19] and a viewport Z scale of 1e19
+// over an offset of 1 (window Z = 1 + 1e19 * z_ndc), reversed depth GEQUAL.
+// The RSX capture of BLES01717 attached to RPCS3 issue #13227 (RRC v5,
+// 4,023 draws) holds 26 such draws: a 12-draw depth prepass right after the
+// depth clear, before the 1,544-draw scene prepass, the same 12 draws in the
+// colour pass (GEQUAL against that prepass) and 2 blended draws without
+// depth write. Without float64 nor an unrestricted depth range (MoltenVK),
+// the vertex fallback compresses Z above 1 into [0.99, 1] from clip-space Z
+// (pos.z), not window Z: pos.z - 1 over 1e19 - 1 is the clip-space z_clip,
+// constant (the near distance) for a reversed infinite projection, so every
+// fragment of these draws gets the same depth. The colour pass then keeps the
+// last triangle drawn on a pixel instead of the nearest one: back parts of
+// the forearm and weapon show through the front ones. Compressing the window
+// Z ((d - 1) / (1e19 - 1) = z_ndc) keeps their depth order inside the band.
+// The vertex shader text of this title changes once, so its vertex Metal
+// libraries are compiled again on the next boot.
+constexpr bool requires_zclip_fallback_window_z(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_SPU_OBJECT_PREFETCH_616 (ios/IOSSpuObjectPrefetch.h): Black Ops II
+// opens 7,162 cached SPU objects in the first 5 s of a multiplayer match on the
+// Build 614 logs (4.3 s of file reads on the compile threads, a 2.0 s frame).
+constexpr bool requires_spu_object_prefetch(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_ZCULL_ON_DEMAND_619 (ios/IOSZcullOnDemand.h): Assassin's Creed waits
+// 4.1-4.3 s of each 5 s window in ZCULL_control::sync() on the Build 617 logs
+// (2,200-2,900 waits, ~33 per frame at 14 FPS) once a report page was read.
+// REWINDBOX_ZCULL_DEMAND_BO2_621: Black Ops II takes the same upstream switch at
+// every boot (Build 620 logs, PIDs 66891/66907/66957: COREPROF ZCULLDEMAND619
+// upstream_disables=1:0:0, a PPU/SPU access, in the first window of the single
+// player and of the multiplayer executable), then waits 1.1-1.9 s of each 5 s
+// multiplayer window in ZCULL_control::sync() (200-390 GPU syncs) at 20-35 FPS.
+// The ZCULL On-Demand Reads setting overrides the list per game (A/B test).
+constexpr bool requires_zcull_on_demand(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id) || is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_ZCLIP_PINNED_AFFINE_619: refines REWINDBOX_ZCLIP_WINDOW_Z_616. The
+// fallback compresses only window Z in (1, far] and passes every other vertex
+// through unchanged. The pinned draws of the #13227 capture keep depth clip on
+// and clamp off (NV4097_SET_ZMIN_MAX_CONTROL = 1): a triangle with one vertex
+// beyond the RSX clip range (in front of the near plane, window Z > 1e19) then
+// mixes one unchanged vertex (Z/W of about 1e19) with compressed ones (about
+// 0.99), and Vulkan clips the edge almost at the compressed vertex: the part of
+// the first-person arm that crosses the near plane vanishes instead of being
+// clipped at the near plane. For a clip range wholly above 1, every vertex now
+// takes the same affine map of [near, far] onto [0.99, 1], unclamped, so the
+// hardware clips exactly where the RSX clips (window Z = far); vertices in
+// (1, far] keep the 616 formula.
+constexpr bool requires_zclip_pinned_affine(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
+
+// REWINDBOX_BO2_MVK_ASYNC_619: Black Ops II joins God of War III and Assassin's
+// Creed in the Automatic mode of asynchronous MoltenVK submits (CELL587, boot
+// canary kept). Build 617 multiplayer windows 18-28 (PID 65755, session 3, 30 fps,
+// mvk_async=0) spend 0.80 s per 5 s window inside vkQueueSubmit on the RSX thread
+// (RSXSYNC551 submit=1051:796.9 ms), 4-27 ms in the 45-120 ms frames.
+constexpr bool joins_mvk_async_automatic_619(std::string_view title_id) noexcept
+{
+	return is_black_ops_ii_title(title_id);
+}
 }
diff --git a/rpcs3/ios/IOSZcullLabelPage.h b/rpcs3/ios/IOSZcullLabelPage.h
new file mode 100644
index 0000000..1b956d5
--- /dev/null
+++ b/rpcs3/ios/IOSZcullLabelPage.h
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_ZCULL_LABEL_PAGE_624: Build 622 logs (PID 1459, Assassin's Creed, session 3):
+// the ZCULL on-demand lever served 411 GCM label reads and 33 report reads in one
+// window, the guest thread TaskThread1 waited 422/469/456 ms in three seconds and the
+// lever tripped (wait_budget); the rest of the boot ran the upstream mode, 2,400-2,900
+// ZCULL syncs and 4.1-4.3 s of the RSX thread blocked per 5 s window, 13-17 FPS.
+// The labels (offset 0x0000) and notify slots (0x1000) of the RSX reports block share
+// the first host page with reports 0-703 (0x1400): with 16 KiB host pages every label
+// poll of the game faulted whenever one of those reports was pending, and each fault
+// wrote every claimed report. lv2 returns the block's address to the game
+// (sys_rsx_context_allocate, lpar_reports); every RSX, GCM and ZCULL address derives
+// from it. Placing the block so that its report array begins on a host page leaves the
+// labels and notify slots on a page that never holds a report: a label read never
+// waits, a report read still waits for its value. The PS3 layout of the block
+// (labels, notify, reports and their offsets in RsxDriverInfo) is unchanged.
+namespace rpcs3::ios::zcull_label_page
+{
+// The shift lv2 applied to the reports block of the running boot (0 without the lever),
+// for the COREPROF ZCULL624 line.
+inline std::atomic<std::uint32_t> g_applied_shift{0};
+
+// The offset to add to the block's address so that `report_offset` lands on a page
+// boundary of `page_size` bytes (0 when it already does, or for a page size that is
+// not a power of two).
+constexpr std::uint32_t offset(std::uint32_t report_offset, std::uint32_t page_size) noexcept
+{
+	if (page_size == 0 || (page_size & (page_size - 1)) != 0)
+	{
+		return 0;
+	}
+
+	const std::uint32_t remainder = report_offset % page_size;
+	return remainder ? page_size - remainder : 0;
+}
+}
+
+// REWINDBOX_ZCULL_COND_PREVIOUS_624: Build 622 logs (Black Ops II multiplayer): the RSX
+// thread waited for the occlusion result of a conditional render 112-123 times per 5 s
+// window, 0.9-1.2 s in all (8-10 ms each), on top of the forced report passes. MoltenVK
+// has no conditional rendering, so RPCS3 waits on the CPU for the GPU to finish the
+// query that predicates the draws. With the ZCULL on-demand lever, when that query is
+// still on the GPU and the report it writes already holds a non-zero value (the object
+// was visible at its previous evaluation), the draws are emitted now instead of
+// waiting; a report holding 0 still waits, so an object the game would show is never
+// hidden. An object hidden in this frame but visible in the previous one is drawn one
+// evaluation longer, behind whatever hides it.
+namespace rpcs3::ios::zcull_cond_previous
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> previous{0}; // evaluations that drew on the previous visible value
+	std::atomic<std::uint64_t> waited{0};   // evaluations that waited (not ready and report 0)
+	std::atomic<std::uint64_t> ready{0};    // evaluations whose query was already complete
+};
+
+inline counters_t& counters() noexcept
+{
+	static counters_t s_counters;
+	return s_counters;
+}
+
+enum class decision
+{
+	wait,     // wait for the query, as upstream
+	previous, // draw now: the report already shows the object visible
+};
+
+// The decision for a pending evaluation. `ready`: the newest query of the evaluation
+// has its result on the host (check_occlusion_query_status); `report_value`: the value
+// field of the report at the evaluation address (read through the unprotected view).
+constexpr decision decide(bool lever, bool ready, std::uint32_t report_value) noexcept
+{
+	return (lever && !ready && report_value != 0) ? decision::previous : decision::wait;
+}
+}
+
+// REWINDBOX_ZCULL_FAULT_CENSUS_624: who reaches into a page ZCULL holds locked, for the
+// next reading of the Black Ops II "other" faults (Build 622: 60-120 per window, 885 ms
+// of guest waits, outside the GCM report block): the thread class of every on-demand
+// fault and the last address of an "other" fault. Counting changes no fault handling.
+namespace rpcs3::ios::zcull_fault_census
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> ppu{0};
+	std::atomic<std::uint64_t> spu{0};
+	std::atomic<std::uint32_t> other_last{0};     // guest address of the last "other" fault
+	std::atomic<std::uint32_t> other_last_spu{0}; // 1 when an SPU made it
+};
+
+inline counters_t& counters() noexcept
+{
+	static counters_t s_counters;
+	return s_counters;
+}
+}
diff --git a/rpcs3/ios/IOSZcullOnDemand.h b/rpcs3/ios/IOSZcullOnDemand.h
new file mode 100644
index 0000000..b7b4ed0
--- /dev/null
+++ b/rpcs3/ios/IOSZcullOnDemand.h
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+
+// REWINDBOX_ZCULL_ON_DEMAND_619: Assassin's Creed (BLES00158, BLUS30089), Build
+// 617 iPhone logs (PID 65755, session 1, windows 17-28): 2,203-2,911 waits per
+// 5 s window, 4.15-4.32 s in all, every one of them inside ZCULL_control::sync()
+// (COREPROF ZCULLWAIT616 sync=, all other paths 0), 14-17 FPS. Once a report
+// page holding a pending report is touched, upstream marks the whole location
+// "accessed" for the rest of the boot (disable_optimizations): every report
+// becomes critical and every label write with a pipe flush, WAIT_FOR_IDLE or
+// NOTIFY waits for the GPU to retire all of them, about 33 times per frame.
+// On iOS the host page is 16 KiB: the GCM labels (4 KiB), the notifies (1 KiB)
+// and local reports 0-703 share one page, so the RSX thread's own label read or
+// write is enough to trigger it. With the lever the report pages stay
+// protected; the RSX thread reaches the label area and locked report pages
+// through the unprotected view (ios/IOSRsxLabelAccess.h); a PPU/SPU access to
+// a page that still holds a pending report asks the RSX thread to write every
+// claimed report (the writes sync() does), waits for them, then unprotects the
+// page. The guest reads the same values; the labels no longer wait. A request
+// not picked up within 2 s, sustained guest waits (below) or more than 1,000
+// services per second return the boot to the upstream mode. Title scoped
+// (ios/IOSTitleLevers.h).
+//
+// REWINDBOX_ZCULL_DEMAND_GUARD_621: Build 620 logs (PID 66957, Assassin's Creed,
+// session 3): the lever served the menus, then at the first gameplay second it
+// served 54 label reads, 401.5 ms of guest waits against the 619 budget of
+// 400 ms in one second (max 23.9 ms), and tripped. The rest of the boot ran the
+// upstream mode it falls back to: 2,100-2,900 GPU syncs and 3.4-4.3 s of the
+// RSX thread blocked per 5 s window, 14-18 FPS. One busy second is not a reason
+// to take the more expensive path for the whole boot. A guest thread now trips
+// the lever when it waits more than 400 ms in each of 3 consecutive seconds, or
+// more than 900 ms over at least 16 waits in one second (a fault storm, not one
+// long wait behind a pipeline compile on the RSX thread); all guest
+// threads together trip it above 800 ms in each of 3 consecutive seconds (the
+// upstream mode cost the RSX thread 0.68-0.86 s per second in the same session).
+// The trip is recorded with its windows (trip_detail) for the COREPROF
+// ZCULLTRIP621 line; the pickup and service halves of each wait are counted.
+// Seconds are fixed one-second buckets of the clock: each wait adds to every
+// bucket it overlaps the part it overlaps, so a thread blocked in waits longer
+// than a second is counted in each second it is blocked (a review of the first
+// 621 rule found that waits more than 2 s apart never tripped), and a wait
+// that began in an earlier second adds nothing to the next one. The storm rule
+// counts at most 100 ms of each wait, so one long wait behind a pipeline
+// compile followed by ordinary reads is not a storm.
+namespace rpcs3::ios::zcull_on_demand
+{
+inline constexpr std::uint64_t pickup_deadline_us = 2'000'000;  // the RSX thread has not started the request
+inline constexpr std::uint64_t hard_deadline_us = 5'000'000;    // the request never completed
+inline constexpr std::uint64_t window_us = 1'000'000;
+inline constexpr std::uint32_t storm_services = 1'000;          // services per window
+inline constexpr std::uint64_t wait_budget_us = 400'000;        // one guest thread's wait per window (621: sustained)
+inline constexpr std::uint32_t sustained_windows = 3;           // consecutive windows above a budget
+inline constexpr std::uint64_t severe_wait_us = 900'000;        // one guest thread's wait in one window...
+inline constexpr std::uint32_t severe_min_waits = 16;          // ...over at least this many waits (a storm, not one
+                                                                // long wait behind an RSX pipeline compile)
+inline constexpr std::uint64_t global_budget_us = 800'000;      // all guest threads' wait per window (sustained)
+inline constexpr std::uint64_t severe_wait_cap_us = 100'000;    // the part of one wait the storm rule counts
+
+enum class trip_reason : std::uint32_t
+{
+	none = 0,
+	storm = 1,       // more than storm_services services in a window
+	wait_budget = 2, // guest threads waited more than wait_budget_us in a window
+	pickup = 3,      // a request was not picked up in time
+	hard = 4,        // a request picked up but not completed in time
+	wait_severe = 5, // REWINDBOX_ZCULL_DEMAND_GUARD_621: one guest thread blocked most of a window
+};
+
+inline const char* trip_reason_name(std::uint32_t reason) noexcept
+{
+	switch (static_cast<trip_reason>(reason))
+	{
+	case trip_reason::none: return "none";
+	case trip_reason::storm: return "storm";
+	case trip_reason::wait_budget: return "wait_budget";
+	case trip_reason::pickup: return "pickup";
+	case trip_reason::hard: return "hard";
+	case trip_reason::wait_severe: return "wait_severe";
+	}
+	return "other";
+}
+
+// REWINDBOX_ZCULL_DEMAND_GUARD_621: which windows tripped the lever (scope 1: one
+// guest thread, 2: all guest threads, 0: not a wait trip), in microseconds of wait.
+struct trip_detail
+{
+	std::uint32_t reason = 0;
+	std::uint32_t scope = 0;
+	std::uint64_t at_us = 0;
+	std::uint64_t windows_us[sustained_windows]{}; // oldest first; the last one is the window that tripped
+};
+
+// Process-wide counters of COREPROF ZCULLDEMAND619 (taken per window).
+struct tally
+{
+	std::atomic<std::uint64_t> faults_label{0};     // guest access at a label/notify offset of a page with a pending report
+	std::atomic<std::uint64_t> faults_report{0};    // ... at a report offset of the GCM report area
+	std::atomic<std::uint64_t> faults_other{0};     // ... elsewhere (main-memory reports)
+	std::atomic<std::uint64_t> stale{0};            // guest accesses to a page whose reports were all written
+	std::atomic<std::uint64_t> services{0};         // RSX thread: every claimed report written for a request
+	std::atomic<std::uint64_t> waits{0};            // guest waits that ended served or released
+	std::atomic<std::uint64_t> wait_us{0};
+	std::atomic<std::uint64_t> wait_max_us{0};
+	std::atomic<std::uint64_t> timeouts{0};
+	std::atomic<std::uint64_t> stops{0};
+	std::atomic<std::uint64_t> rsx_reads{0};        // RSX copies out of locked report pages, served by writing the reports
+	std::atomic<std::uint64_t> upstream_cell{0};    // upstream disable_optimizations after a PPU/SPU access
+	std::atomic<std::uint64_t> upstream_other{0};   // ... after an access by another thread
+	std::atomic<std::uint64_t> upstream_rsx_read{0};// ... after an RSX copy out of report memory
+	std::atomic<std::uint32_t> tripped{0};          // trip_reason of the current boot
+	// REWINDBOX_ZCULL_DEMAND_GUARD_621: the two halves of a served wait.
+	std::atomic<std::uint64_t> pickups{0};           // waits whose request the RSX thread was seen to pick up
+	std::atomic<std::uint64_t> pickup_us{0};         // request -> picked up by the RSX thread
+	std::atomic<std::uint64_t> pickup_max_us{0};
+	std::atomic<std::uint64_t> service_us{0};        // picked up -> reports written
+	std::atomic<std::uint64_t> service_max_us{0};
+
+	static void raise_max(std::atomic<std::uint64_t>& max_value, std::uint64_t value) noexcept
+	{
+		std::uint64_t max = max_value.load(std::memory_order_relaxed);
+		while (value > max && !max_value.compare_exchange_weak(max, value, std::memory_order_relaxed)) {}
+	}
+
+	void add_wait(std::uint64_t us) noexcept
+	{
+		waits.fetch_add(1, std::memory_order_relaxed);
+		wait_us.fetch_add(us, std::memory_order_relaxed);
+		raise_max(wait_max_us, us);
+	}
+
+	void add_halves(std::uint64_t pickup, std::uint64_t service) noexcept
+	{
+		pickups.fetch_add(1, std::memory_order_relaxed);
+		pickup_us.fetch_add(pickup, std::memory_order_relaxed);
+		service_us.fetch_add(service, std::memory_order_relaxed);
+		raise_max(pickup_max_us, pickup);
+		raise_max(service_max_us, service);
+	}
+};
+
+// Wait time per fixed one-second bucket of the clock (index = time / window_us),
+// for the last ring_size buckets. One guest thread's ring is thread_local (its
+// waits are sequential); the all-threads ring is shared under the gate's mutex,
+// where a wait reported late adds to the buckets still in the ring.
+inline constexpr std::uint32_t ring_size = sustained_windows + 1;
+struct wait_bucket
+{
+	std::uint64_t index = ~std::uint64_t{0};  // the bucket held, none at first
+	std::uint64_t waited_us = 0;              // wait time inside the bucket
+	std::uint64_t severe_us = 0;              // the same, at most severe_wait_cap_us per wait
+	std::uint32_t waits = 0;                  // waits that ended in the bucket
+};
+struct wait_ring
+{
+	wait_bucket buckets[ring_size]{};
+	std::uint64_t newest = 0;                 // newest bucket index + 1, 0 when none
+
+	// Adds the wait [now_us - us, now_us) to the buckets it overlaps; returns the
+	// bucket it ended in.
+	const wait_bucket& add(std::uint64_t us, std::uint64_t now_us) noexcept
+	{
+		const std::uint64_t begin = us < now_us ? now_us - us : 0;
+		const std::uint64_t last = now_us / window_us;
+		std::uint64_t first = begin / window_us;
+		if (last - first >= ring_size) first = last - (ring_size - 1);
+		for (std::uint64_t b = first; b <= last; b++)
+		{
+			auto& slot = buckets[b % ring_size];
+			if (slot.index != b)
+			{
+				if (slot.index != ~std::uint64_t{0} && slot.index > b) continue; // already reused by a newer bucket
+				slot = {};
+				slot.index = b;
+			}
+			const std::uint64_t lo = begin > b * window_us ? begin : b * window_us;
+			const std::uint64_t hi = now_us < (b + 1) * window_us ? now_us : (b + 1) * window_us;
+			const std::uint64_t part = hi > lo ? hi - lo : 0;
+			slot.waited_us += part;
+			slot.severe_us += part < severe_wait_cap_us ? part : severe_wait_cap_us;
+			if (b == last) slot.waits++;
+		}
+		if (last + 1 > newest) newest = last + 1;
+		return buckets[last % ring_size];
+	}
+
+	std::uint64_t waited(std::uint64_t b) const noexcept
+	{
+		const auto& slot = buckets[b % ring_size];
+		return slot.index == b ? slot.waited_us : 0;
+	}
+
+	// True when each of the sustained_windows complete buckets before the newest
+	// one holds more than `budget_us`; `history_us` gets them, oldest first. A
+	// bucket without waits (idle) breaks the run: nothing trips late.
+	bool sustained(std::uint64_t budget_us, std::uint64_t (&history_us)[sustained_windows]) const noexcept
+	{
+		if (newest < sustained_windows + 1) return false;
+		const std::uint64_t current = newest - 1;
+		bool over = true;
+		for (std::uint32_t i = 0; i < sustained_windows; i++)
+		{
+			history_us[i] = waited(current - sustained_windows + i);
+			over = over && history_us[i] > budget_us;
+		}
+		return over;
+	}
+};
+struct thread_wait_ring
+{
+	std::uint64_t generation = 0;            // the gate (boot) the ring belongs to
+	wait_ring ring{};
+};
+inline thread_local thread_wait_ring t_wait_ring{};
+inline std::atomic<std::uint64_t> g_gate_generation{0};
+
+inline tally& counters() noexcept
+{
+	static tally s_tally;
+	return s_tally;
+}
+
+// Request/serve handshake between faulting guest threads and the RSX thread.
+class gate
+{
+	std::atomic<std::uint64_t> m_requested{0};
+	std::atomic<std::uint64_t> m_picked{0};          // newest ticket the RSX thread started
+	std::atomic<std::uint64_t> m_served{0};          // newest ticket whose reports are written
+	std::atomic<std::uint32_t> m_tripped{0};
+	std::uint64_t m_window_start_us = 0;             // RSX thread only
+	std::uint32_t m_window_services = 0;             // RSX thread only
+	// REWINDBOX_ZCULL_DEMAND_GUARD_621: the all-threads buckets (m_global_mutex) and
+	// the trip record.
+	std::mutex m_global_mutex;
+	wait_ring m_global_ring{};
+	std::uint64_t m_generation = 0;
+	mutable std::mutex m_trip_mutex;
+	trip_detail m_trip{};
+
+	static void raise(std::atomic<std::uint64_t>& value, std::uint64_t ticket) noexcept
+	{
+		std::uint64_t current = value.load(std::memory_order_relaxed);
+		while (current < ticket && !value.compare_exchange_weak(current, ticket, std::memory_order_acq_rel, std::memory_order_relaxed)) {}
+	}
+
+public:
+	gate() noexcept
+		: m_generation(g_gate_generation.fetch_add(1, std::memory_order_relaxed) + 1)
+	{
+		// One gate per renderer, that is per boot: the process-wide flag follows it.
+		counters().tripped.store(0, std::memory_order_relaxed);
+	}
+
+	gate(const gate&) = delete;
+	gate& operator=(const gate&) = delete;
+
+	// Guest thread: a new ticket, served once the RSX thread wrote every claimed report after it.
+	std::uint64_t request() noexcept
+	{
+		return m_requested.fetch_add(1, std::memory_order_acq_rel) + 1;
+	}
+
+	// RSX thread: the newest ticket waiting to be served, 0 when none.
+	std::uint64_t pending() const noexcept
+	{
+		const std::uint64_t requested = m_requested.load(std::memory_order_acquire);
+		return requested != m_served.load(std::memory_order_relaxed) ? requested : 0;
+	}
+
+	// RSX thread, before the forced pass for `ticket`.
+	void pick(std::uint64_t ticket) noexcept
+	{
+		raise(m_picked, ticket);
+	}
+
+	// RSX thread, after every report claimed when `ticket` was read is written.
+	// Returns true when this service tripped the storm guard.
+	bool serve(std::uint64_t ticket, std::uint64_t now_us) noexcept
+	{
+		raise(m_picked, ticket);
+		raise(m_served, ticket);
+
+		if (now_us - m_window_start_us >= window_us)
+		{
+			m_window_start_us = now_us;
+			m_window_services = 0;
+		}
+
+		return ++m_window_services > storm_services && trip(trip_reason::storm);
+	}
+
+	// Guest thread, after a served wait of `us` ending at `now_us`. Returns true when
+	// this wait tripped the lever (REWINDBOX_ZCULL_DEMAND_GUARD_621, see the top).
+	bool record_wait(std::uint64_t us, std::uint64_t now_us) noexcept
+	{
+		// This guest thread's buckets.
+		auto& own = t_wait_ring;
+		if (own.generation != m_generation)
+		{
+			own = {};
+			own.generation = m_generation;
+		}
+		const wait_bucket& ended = own.ring.add(us, now_us);
+		std::uint64_t history[sustained_windows]{};
+		if (own.ring.sustained(wait_budget_us, history) && trip(trip_reason::wait_budget, 1, now_us, history))
+		{
+			return true;
+		}
+		if (ended.severe_us > severe_wait_us && ended.waits >= severe_min_waits)
+		{
+			std::uint64_t severe[sustained_windows]{};
+			severe[sustained_windows - 1] = ended.severe_us;
+			if (trip(trip_reason::wait_severe, 1, now_us, severe))
+			{
+				return true;
+			}
+		}
+
+		// All guest threads' buckets.
+		bool sustained = false;
+		{
+			std::lock_guard lock(m_global_mutex);
+			m_global_ring.add(us, now_us);
+			sustained = m_global_ring.sustained(global_budget_us, history);
+		}
+		return sustained && trip(trip_reason::wait_budget, 2, now_us, history);
+	}
+
+	// The trip record of this boot (reason 0 while the lever works).
+	trip_detail trip_record() const noexcept
+	{
+		std::lock_guard lock(m_trip_mutex);
+		return m_trip;
+	}
+
+	bool is_picked(std::uint64_t ticket) const noexcept
+	{
+		return m_picked.load(std::memory_order_acquire) >= ticket;
+	}
+
+	bool is_served(std::uint64_t ticket) const noexcept
+	{
+		return m_served.load(std::memory_order_acquire) >= ticket;
+	}
+
+	// The first reason wins; returns true for the call that tripped.
+	bool trip(trip_reason reason) noexcept
+	{
+		const std::uint64_t none[sustained_windows]{};
+		return trip(reason, 0, 0, none);
+	}
+
+	bool trip(trip_reason reason, std::uint32_t scope, std::uint64_t now_us, const std::uint64_t (&windows_us)[sustained_windows]) noexcept
+	{
+		std::uint32_t expected = 0;
+		if (!m_tripped.compare_exchange_strong(expected, static_cast<std::uint32_t>(reason), std::memory_order_acq_rel))
+		{
+			return false;
+		}
+
+		{
+			std::lock_guard lock(m_trip_mutex);
+			m_trip.reason = static_cast<std::uint32_t>(reason);
+			m_trip.scope = scope;
+			m_trip.at_us = now_us;
+			for (std::uint32_t i = 0; i < sustained_windows; i++) m_trip.windows_us[i] = windows_us[i];
+		}
+
+		counters().tripped.store(static_cast<std::uint32_t>(reason), std::memory_order_relaxed);
+		return true;
+	}
+
+	bool tripped() const noexcept
+	{
+		return m_tripped.load(std::memory_order_acquire) != 0;
+	}
+};
+
+enum class wait_result
+{
+	served,    // the RSX thread wrote every report claimed at the request
+	released,  // the page no longer holds a pending report (written meanwhile)
+	stopped,   // emulation or renderer stopping
+	timed_out, // not picked up by pickup_deadline, or not completed by hard_deadline
+};
+
+// Guest thread: waits for `ticket`, measured from `started_us`. `released()` checks
+// the page, `stopped()` the emulator, `now_us()` the clock. A request the RSX thread
+// has picked up is waited for up to the hard deadline (a long pipeline compile or GPU
+// backlog is not a failure); one never picked up fails at the pickup deadline.
+// Spins briefly, then sleeps 50 us steps: the request costs one GPU round trip.
+// REWINDBOX_ZCULL_DEMAND_GUARD_621: `picked_at_us`, when given, receives the clock
+// at which the request was first seen picked up (the service time follows it).
+template <typename Released, typename Stopped, typename Now>
+wait_result wait_for(const gate& g, std::uint64_t ticket, std::uint64_t started_us, Released&& released, Stopped&& stopped, Now&& now_us,
+	std::uint64_t* picked_at_us = nullptr)
+{
+	for (unsigned step = 0;; step++)
+	{
+		if (picked_at_us && !*picked_at_us && g.is_picked(ticket))
+		{
+			*picked_at_us = now_us();
+		}
+
+		if (g.is_served(ticket))
+		{
+			return wait_result::served;
+		}
+
+		if (released())
+		{
+			return wait_result::released;
+		}
+
+		if (stopped())
+		{
+			return wait_result::stopped;
+		}
+
+		const std::uint64_t elapsed = now_us() - started_us;
+		if (elapsed >= hard_deadline_us || (elapsed >= pickup_deadline_us && !g.is_picked(ticket)))
+		{
+			return wait_result::timed_out;
+		}
+
+		if (step < 32)
+		{
+			std::this_thread::yield();
+		}
+		else
+		{
+			std::this_thread::sleep_for(std::chrono::microseconds(50));
+		}
+	}
+}
+}
