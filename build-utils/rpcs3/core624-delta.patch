+			{
+				fs::g_tls_error = fs::error::inval;
+				return umax;
+			}
+
+			m_pos = static_cast<u64>(position);
+			return m_pos;
+		}
+
+		u64 size() override
+		{
+			return m_image->size();
+		}
+	};
