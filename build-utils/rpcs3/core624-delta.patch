+	const u64 rtime = vm::check_addr(addr, vm::page_readable, 128) ? +vm::reservation_acquire(addr) : 0;
+	std::string line = fmt::format("FREEZE_DUMP line addr=0x%x rtime=0x%llx data=%s", addr, rtime, guest_hex(addr, 128));
+	return bound_line(line);
+}
