+void VKGSRender::ios_gpu_timing_init()
+{
+	namespace gt = rpcs3::ios::gpu_timing;
+	// The primary chunk ring and the tracker's slots are the same 512 entries.
+	static_assert(VK_MAX_ASYNC_CB_COUNT == gt::slot_count);
+	auto& tracker = gt::instance();
+	g_ios_gpu_timer = {};
+
+	// timestampComputeAndGraphics: every graphics and compute queue has valid
+	// timestamp bits (MoltenVK 1.4.2 reports VK_TRUE).
+	const auto& limits = m_device->gpu().get_limits();
+	// Fully qualified: rsx::thread inherits cpu_thread::state, which hides the enum.
+	gt::state probe = gt::state::active;
+	if (!rpcs3::ios::get_experimental_policy().gpu_timing)
+	{
+		probe = gt::state::disabled;
+	}
+	else if (!limits.timestampComputeAndGraphics || !(limits.timestampPeriod > 0.f))
+	{
+		probe = gt::state::no_support;
+	}
+	else
+	{
+		VkQueryPoolCreateInfo info{};
+		info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+		info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+		info.queryCount = gt::slot_count * 2;
+		if (vkCreateQueryPool(*m_device, &info, nullptr, &g_ios_gpu_timer.pool) != VK_SUCCESS)
+		{
+			g_ios_gpu_timer.pool = VK_NULL_HANDLE;
+			probe = gt::state::no_pool;
+		}
+	}
+
+	if (probe == gt::state::active)
+	{
+		g_ios_gpu_timer.device = *m_device;
+		for (u32 index = 0; index < VK_MAX_ASYNC_CB_COUNT; ++index)
+		{
+			auto* chunk = m_primary_cb_list.at(index);
+			chunk->ios_gpu_timed = true;
+			chunk->ios_gpu_slot = index;
+		}
+
+		if (m_device->get_calibrated_timestamps_support())
+		{
+			g_ios_gpu_timer.calibrate = reinterpret_cast<PFN_vkGetCalibratedTimestampsEXT>(
+				vkGetDeviceProcAddr(*m_device, "vkGetCalibratedTimestampsEXT"));
+		}
+	}
+
+	tracker.begin_session(rpcs3::ios::frame_trace::active_session.load(std::memory_order_acquire), probe,
+		limits.timestampPeriod, utils::get_tsc_freq());
+	ios_gpu_calibrate(true);
+	rsx_log.notice("COREPROF GPUTIME621_BOOT state=%s session=%llu period_ns=%.3f compute_and_graphics=%u calibrated_timestamps=%u "
+		"slots=%u queries_per_submission=2 mechanism=vulkan_timestamp_pair_metal_stage_boundary "
+		"read=fence_complete_no_wait scope=rsx_primary_command_buffers",
+		gt::state_name(probe), rpcs3::ios::frame_trace::active_session.load(std::memory_order_relaxed),
+		limits.timestampPeriod, limits.timestampComputeAndGraphics ? 1u : 0u, g_ios_gpu_timer.calibrate ? 1u : 0u, gt::slot_count);
+}
+
+void VKGSRender::ios_gpu_timing_shutdown()
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (g_ios_gpu_timer.pool && tracker.active())
+	{
+		// The device is idle: every remaining submission is read once.
+		tracker.collect([](u32) { return true; }, ios_gpu_read, rpcs3::ios::gpu_timing::slot_count);
+	}
+
+	tracker.end_session();
+	if (g_ios_gpu_timer.pool)
+	{
+		vkDestroyQueryPool(*m_device, g_ios_gpu_timer.pool, nullptr);
+	}
+	g_ios_gpu_timer = {};
+}
+
+// Frame end, RSX thread: results of completed submissions, oldest first.
+void VKGSRender::ios_gpu_timing_collect()
