+// One running PPU thread: 16 samples of its pc about 1 ms apart (does the spin
+// move?), the 32 instruction words around it and the line it holds reserved.
+std::string ppu_code_line(const ppu_thread& ppu)
+{
+	std::string samples;
+	for (int i = 0; i < 16; i++)
+	{
+		fmt::append(samples, "%s%x", i ? ":" : "", ppu.cia);
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+
+	const u32 pc = ppu.cia;
+	const u32 code = pc >= 0x40 ? pc - 0x40 : 0;
+	const u32 reserved = ppu.raddr & -128;
+	std::string line = fmt::format(
+		"FREEZE_DUMP ppu_code id=0x%x pcs=%s code_at=0x%x code=%s raddr=0x%x line=%s",
+		ppu.id, samples, code, guest_hex(code, 128), reserved, reserved ? guest_hex(reserved, 128) : std::string("-"));
+	return bound_line(line);
