+// REWINDBOX_FREEZE_DEEP_621: guest bytes in hex, read through the unprotected view
+// (a ZCULL-locked report page would otherwise fault on the profiler thread) and
+// only where the page is mapped and readable; "-" otherwise.
+std::string guest_hex(u32 addr, u32 size)
+{
+	if (!addr || !vm::check_addr(addr, vm::page_readable, size))
+	{
+		return "-";
+	}
+
+	const u8* bytes = vm::get_super_ptr<u8>(addr);
+	std::string out;
+	out.reserve(size * 2);
+	for (u32 i = 0; i < size; i++)
+	{
+		fmt::append(out, "%02x", bytes[i]);
+	}
+	return out;
