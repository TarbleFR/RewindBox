+// vk::command_buffer::begin() of a timed primary chunk, whatever reopened it
+// (close_and_submit, flips, texture_cache::cleanup_after_dma_transfers).
+void vk::ios_gpu_timing_on_begin(vk::command_buffer& cmd)
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (!g_ios_gpu_timer.pool || !tracker.active())
+	{
+		return;
+	}
+
+	const u64 begin = utils::get_tsc();
+	// The previous use of this slot completed (the renderer waited for it):
+	// take its result before the queries are reset.
+	tracker.release_slot(cmd.ios_gpu_slot, ios_gpu_read);
+	vkCmdResetQueryPool(cmd, g_ios_gpu_timer.pool, cmd.ios_gpu_slot * 2, 2);
+	vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, g_ios_gpu_timer.pool, cmd.ios_gpu_slot * 2);
+	tracker.on_begin(cmd.ios_gpu_slot);
+	tracker.add_probe_cost(utils::get_tsc() - begin);
+}
+
+// vk::command_buffer::end(): the end timestamp, if this recording has its begin one.
+bool vk::ios_gpu_timing_on_end(vk::command_buffer& cmd)
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (!g_ios_gpu_timer.pool || !tracker.active() || !tracker.begun(cmd.ios_gpu_slot))
+	{
+		return false;
+	}
+
+	const u64 begin = utils::get_tsc();
+	vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g_ios_gpu_timer.pool, cmd.ios_gpu_slot * 2 + 1);
+	tracker.add_probe_cost(utils::get_tsc() - begin);
+	return true;
+}
+
+// vk::command_buffer::submit(): a timed submission joins the FIFO; one without its
+// pair (begun before the probe started, or reset) is counted as untimed.
+void vk::ios_gpu_timing_on_submit(vk::command_buffer& cmd, bool timed, u64 submit_tsc)
+{
+	auto& tracker = rpcs3::ios::gpu_timing::instance();
+	if (timed && g_ios_gpu_timer.pool && tracker.active())
+	{
+		tracker.on_submit(cmd.ios_gpu_slot, submit_tsc);
+		return;
+	}
+
+	tracker.clear_begun(cmd.ios_gpu_slot);
+	tracker.on_untimed_submit();
+}
