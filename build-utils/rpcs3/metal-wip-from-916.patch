diff --git a/rpcs3/ios/IOSWriterParkSpin917.h b/rpcs3/ios/IOSWriterParkSpin917.h
new file mode 100644
index 0000000..eaad662
--- /dev/null
+++ b/rpcs3/ios/IOSWriterParkSpin917.h
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_WRITER_PARK_SPIN_917: how a writer waits for the PPU threads to park, and what the park costs.
+//
+// A data-changing PUTLLC with Accurate SPU Reservations takes vm::writer_lock: it publishes its exclusive bit, asks
+// every running PPU thread to park (cpu_flag::memory) and waits until each one shows cpu_flag::wait; while its bit is
+// set no PPU thread runs guest code. Call of Duty: Black Ops II in play, build 676 (PID 25658, session 3, windows 9 to
+// 17): 1.08 to 1.60 million such locks per 5 s window, 2.4 to 2.9 s of SPU thread time per window spent acquiring
+// them (1.8 to 2.5 us per lock) against 13 to 19 ms holding them, and 20 to 26 frames per second with no thread
+// saturated. God of War III, build 718 (session 5, window 16): 4,484 locks, the park phase 1.36 us per lock.
+//
+// The wait (vm.cpp, reservation_lock_wait) spins 128 iterations of the CPU's yield hint, a fraction of a
+// microsecond, then hands the core off with a system call (thread_switch) every 32 iterations. A PPU thread that
+// runs compiled code parks at its next block; one that is inside a host function (a system call of the guest, a
+// reservation helper) parks when it returns, which takes about as long as those 128 iterations or longer: the writer
+// then pays a hand-off although the thread it waits for is running, and may lose its core while its exclusive bit
+// keeps every PPU thread parked.
+//
+// With the lever on, the writer spins for `spin_budget_ns` before its first hand-off. The budget is a few times the
+// park phase measured above, so a PPU thread that is running parks within it; a PPU thread that is not on a core
+// still gets the hand-offs, at the same cadence, one budget later (against the 50 us and more such a park costs).
+// What the writer waits for is unchanged: every PPU thread parked before it stores, the lock held as before.
+namespace rpcs3::ios::writer_park
+{
+inline std::atomic<bool> spin_enabled{false};
+
+constexpr std::uint64_t spin_budget_ns = 8'000;
+// The clock is read at the first wait iteration and then every `clock_interval` iterations.
+constexpr std::uint64_t clock_interval = 16;
+
+struct waiter
+{
+	std::uint64_t begin = 0;
+	std::uint64_t steps = 0;
+	bool spent = false; // the budget is over: the caller's previous wait applies from here on
+
+	// One wait iteration. True: spin (the caller gives the CPU its hint and tests its condition again). False: the
+	// lever is off or the budget is over; the caller waits as before. `now()` is a monotonic clock in the unit of
+	// `budget`; it is not read by a wait that never happens.
+	template <typename Clock>
+	bool spin(bool enabled, std::uint64_t budget, Clock&& now) noexcept
+	{
+		if (!enabled || spent)
+		{
+			return false;
+		}
+
+		if (!steps)
+		{
+			begin = now();
+		}
+		else if ((steps % clock_interval) == 0 && now() - begin >= budget)
+		{
+			spent = true;
+			return false;
+		}
+
+		steps++;
+		return true;
+	}
+};
+
+// The park phase of the SPU PUTLLC writer locks of a report window, by duration.
+constexpr std::size_t buckets = 8;
+// Upper bounds in nanoseconds; the last bucket has none.
+constexpr std::uint64_t bucket_upper_ns[buckets - 1] = {500, 1'000, 2'000, 4'000, 8'000, 16'000, 50'000};
+
+constexpr std::size_t bucket_of(std::uint64_t park_ns) noexcept
+{
+	std::size_t index = 0;
+
+	while (index < buckets - 1 && park_ns >= bucket_upper_ns[index])
+	{
+		index++;
+	}
+
+	return index;
+}
+
+struct counters_t
+{
+	std::atomic<std::uint64_t> histogram[buckets]{};
+	std::atomic<std::uint64_t> slow_ticks{0};  // the time of the parks of the last bucket (50 us and more)
+	std::atomic<std::uint64_t> over_budget{0}; // locks whose wait outlasted the spin budget (lever on)
+	// A PPU thread inside vm::passive_lock's wait (spin and timed waits): every PPU thread, and the first one.
+	std::atomic<std::uint64_t> ppu_parks{0}, ppu_park_ticks{0}, main_parks{0}, main_park_ticks{0};
+};
+
+inline counters_t counters;
+
+inline void record_park(std::uint64_t park_ticks, std::uint64_t ticks_per_second, bool budget_spent) noexcept
+{
+	const std::uint64_t park_ns = ticks_per_second == 1'000'000'000 ? park_ticks :
+		ticks_per_second ? static_cast<std::uint64_t>(static_cast<double>(park_ticks) * 1e9 / static_cast<double>(ticks_per_second)) : 0;
+	const std::size_t bucket = bucket_of(park_ns);
+	counters.histogram[bucket].fetch_add(1, std::memory_order_relaxed);
+
+	if (bucket == buckets - 1)
+	{
+		counters.slow_ticks.fetch_add(park_ticks, std::memory_order_relaxed);
+	}
+
+	if (budget_spent)
+	{
+		counters.over_budget.fetch_add(1, std::memory_order_relaxed);
+	}
+}
+
+inline void record_ppu_park(bool first_ppu_thread, std::uint64_t ticks) noexcept
+{
+	counters.ppu_parks.fetch_add(1, std::memory_order_relaxed);
+	counters.ppu_park_ticks.fetch_add(ticks, std::memory_order_relaxed);
+
+	if (first_ppu_thread)
+	{
+		counters.main_parks.fetch_add(1, std::memory_order_relaxed);
+		counters.main_park_ticks.fetch_add(ticks, std::memory_order_relaxed);
+	}
+}
+
+// REWINDBOX_PARK_SPIN_COMPARE_917: one export holds both sides of the lever in the same scene.
+//
+// What the budget is worth depends on the iPhone's scheduler and cannot be measured on a host. With the setting on
+// Automatic, the 5 s report turns the lever off and on again between its windows while a storm of heavy PUTLLC lasts:
+// the first `lead` storm windows of a boot keep it on (the captures the report asks for on a storm run there), then
+// `period` windows off and `period` windows on, in turn, for `compared` storm windows; after that it stays on. Both
+// sides are exact: off is the previous wait, the one of Core 916. RANGELOCKPROF prints park_spin= for the window it
+// reports and COREPROF PARKCMP917 each step. A window that is not a storm window runs with the lever on and is not
+// counted. With the setting Enabled or Disabled nothing alternates.
+namespace compare
+{
+inline std::atomic<bool> allowed{false}; // the setting is Automatic
+
+inline constexpr std::uint64_t bound_heavy = 100'000; // heavy PUTLLC per report window: the bound of IOSAutoStorm917.h
+inline constexpr std::uint32_t lead = 6;
+inline constexpr std::uint32_t period = 2;
+inline constexpr std::uint32_t compared = 16;
+
+struct tracker
+{
+	std::uint64_t session = ~0ull;
+	std::uint32_t storm_windows = 0; // storm windows reported in this boot, counted up to lead + compared
+
+	// The step of the comparison the next storm window is: 1 to `compared`, 0 outside the comparison.
+	constexpr std::uint32_t upcoming_step() const noexcept
+	{
+		const std::uint32_t upcoming = storm_windows + 1;
+		return upcoming > lead && upcoming <= lead + compared ? upcoming - lead : 0;
+	}
+
+	// One call per report window, after the window was reported. Returns the lever of the next window.
+	constexpr bool next(std::uint64_t now_session, bool running, std::uint64_t guest_flips, std::uint64_t heavy_putllc) noexcept
+	{
+		if (now_session != session)
+		{
+			session = now_session;
+			storm_windows = 0;
+		}
+
+		if (!running || !guest_flips || heavy_putllc < bound_heavy)
+		{
+			return true;
+		}
+
+		if (storm_windows < lead + compared)
+		{
+			storm_windows++;
+		}
+
+		const std::uint32_t step = upcoming_step();
+		return !step || ((step - 1) / period) % 2 != 0;
+	}
+};
+} // namespace compare
+} // namespace rpcs3::ios::writer_park
