diff --git a/rpcs3/ios/IOSAutoStorm917.h b/rpcs3/ios/IOSAutoStorm917.h
new file mode 100644
index 0000000..5c0d936
--- /dev/null
+++ b/rpcs3/ios/IOSAutoStorm917.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_AUTO_STORM_CAPTURE_917: the two bounded captures of Core 912, asked once per boot by the 5 s report when
+// the SPU threads take heavyweight writer locks at a high rate.
+//
+// Call of Duty: Black Ops II in play, build 676: 1.08 to 1.60 million data-changing PUTLLC per 5 s window, each one
+// parking every PPU thread, at 20 to 26 frames per second. What those PUTLLC store (which lines, which lanes, whether
+// a value comes back) and where the PPU threads are meanwhile is what the heavy PUTLLC trace and the PPU region
+// profile record; on build 718 neither could be asked for (the lever digits were not exported whole) and the report
+// windows of the game were no longer in the exported files. When `windows_needed` consecutive running windows that
+// showed frames each counted at least `bound_heavy` heavy PUTLLC, the report asks for both captures, once per boot.
+// The per-boot limits and the refusals of the explicit requests apply unchanged; nothing is asked on a title that
+// stays under the bound (God of War III, build 718: 2,029 to 4,484 per window).
+namespace rpcs3::ios::auto_storm
+{
+inline constexpr std::uint64_t bound_heavy = 100'000;
+inline constexpr std::uint32_t windows_needed = 2;
+
+struct tracker
+{
+	std::uint64_t session = ~0ull;
+	std::uint32_t consecutive = 0;
+	bool asked = false;
+
+	// One call per report window. True once per boot session: ask for the captures now.
+	bool observe(std::uint64_t now_session, bool running, std::uint64_t guest_flips, std::uint64_t heavy_putllc) noexcept
+	{
+		if (now_session != session)
+		{
+			session = now_session;
+			consecutive = 0;
+			asked = false;
+		}
+
+		if (!running || !guest_flips || heavy_putllc < bound_heavy)
+		{
+			consecutive = 0;
+			return false;
+		}
+
+		if (asked || ++consecutive < windows_needed)
+		{
+			return false;
+		}
+
+		asked = true;
+		return true;
+	}
+};
+} // namespace rpcs3::ios::auto_storm
