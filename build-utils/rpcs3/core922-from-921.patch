+// REWINDBOX_FREEZE_RESERVATION_922: the reservation word of a line read in the same line as the thread's own
+// reservation time. Build 723, Black Ops II freeze: the line records printed after the threads showed the words of
+// 0x2e20880 and 0x2e20c00 below times threads had read from them, with bit 64 set; the word read next to each time
+// tells whether a word really went back or the reads were apart. ts = the time-base counter at the read.
+std::string reservation_word(u32 addr)
+{
+	if (!addr || !vm::check_addr(addr & -128, vm::page_readable, 128))
+	{
+		return "-";
+	}
+
+	const u64 word = vm::reservation_acquire(addr);
+	return fmt::format("0x%llx@%llu", word, utils::get_tsc());
+}
