diff --git a/rpcs3/ios/IOSEarlySubmit.h b/rpcs3/ios/IOSEarlySubmit.h
index e5df604..aab252c 100644
--- a/rpcs3/ios/IOSEarlySubmit.h
+++ b/rpcs3/ios/IOSEarlySubmit.h
@@ -48,4 +48,61 @@ constexpr verdict decide(bool on, std::uint32_t draws, std::uint32_t this_frame,
 
 	return gpu_idle ? verdict::submit : verdict::gpu_busy;
 }
+
+// REWINDBOX_EARLY_SUBMIT_BOUNDARY_659: at the end of a draw the render pass of
+// that draw is still open, and a submission there ends it: the next draw on the
+// same framebuffer stores and reloads every attachment again (a tile flush on
+// the Apple GPU). Assassin's Creed begins about 44 passes per frame (RPASS652),
+// so in the boundary mode a submission decided at the end of a draw is armed
+// and taken where no pass is open anyway: at the start of a later draw, or once
+// that draw's textures are prepared, when their transitions or copies ended the
+// pass. An armed submission that meets no such point is taken at the end of the
+// draw after max_deferred_draws more draws, as before. Any other primary
+// submission (flip, flush request, ZCULL sync hint) carries the armed draws and
+// disarms it. Commands, their order and their synchronization are unchanged;
+// only the boundary moves.
+inline std::atomic<bool> at_pass_boundary{false};
+
+// 32 draws: in a host model of these frames (5.9 us of recording and 20 us of GPU per draw), a window of
+// 16 to 64 draws costs at most 0.3 ms per frame against the end-of-draw submission when a split pass
+// costs 0.1 ms, and saves 0.5 to 1.5 ms when it costs 0.5 ms; 32 halves the passes split by early
+// submissions there (7.0 to 4.0 per frame).
+constexpr std::uint32_t max_deferred_draws = 32;
+
+// armed: submissions armed at an open pass; boundary_starts / boundary_textures: taken at
+// the start of a draw / after its textures; fallback_submits: taken at the end of a draw
+// after max_deferred_draws more draws; disarmed: carried by another primary submission.
+inline std::atomic<std::uint64_t> armed{0}, boundary_starts{0}, boundary_textures{0}, fallback_submits{0}, disarmed{0};
+
+enum class deferral : std::uint8_t
+{
+	none,      // not armed: decide() applies
+	wait,      // armed: keep looking for a point without an open pass
+	fallback,  // armed for more than max_deferred_draws draws: submit at the end of this draw
+};
+
+// armed_draws: draws ended since the submission was armed, this one included (0: not armed).
+constexpr deferral at_draw_end(std::uint32_t armed_draws) noexcept
+{
+	if (!armed_draws)
+	{
+		return deferral::none;
+	}
+
+	return armed_draws > max_deferred_draws ? deferral::fallback : deferral::wait;
+}
+
+// A submit verdict waits for a pass boundary only in the boundary mode and
+// while a render pass is open; otherwise it is taken at once.
+constexpr bool arm_instead(bool boundary_mode, bool pass_open) noexcept
+{
+	return boundary_mode && pass_open;
+}
+
+// At the start of a draw or after its textures: an armed submission is taken
+// when no render pass is open and the recording can be interrupted.
+constexpr bool take_at_boundary(std::uint32_t armed_draws, bool pass_open, bool interruptible) noexcept
+{
+	return armed_draws && !pass_open && interruptible;
+}
 }
