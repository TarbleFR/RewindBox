 // RSX thread only: sleep one slice unless woken.
 inline void park() noexcept
 {
+	// REWINDBOX_WAKE_CENSUS_936 (ios/IOSWakeCensus936.h): counted, not changed.
+	const std::int64_t census_begin_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
