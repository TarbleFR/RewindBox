diff --git a/rpcs3/ios/IOSTexturePrehash.h b/rpcs3/ios/IOSTexturePrehash.h
index 2a2eead..c1bcd3e 100644
--- a/rpcs3/ios/IOSTexturePrehash.h
+++ b/rpcs3/ios/IOSTexturePrehash.h
@@ -96,8 +96,76 @@ static_assert(thermal_lookahead(64, 32, 100, 90, 2) == 32);   // serious: growth
 static_assert(thermal_lookahead(4, 4, 100, 10, 3) == 4);      // floor
 static_assert(thermal_lookahead(16, 16, 7, 0, 1) == 16);      // too little to judge
 
+// REWINDBOX_PREHASH_IDLE_936: the worker stops hashing ahead while almost none of its hashes are used.
+// IPA 725/726 device logs, God of War III (the only Automatic title). In its 60 fps scenes a frame validates one
+// range of about 3.6 MB right after an epoch starts: the worker and the RSX thread hash it at the same time and the
+// worker's hash is thrown away. PID 52633 windows 21-24: OPT581 worker_ms 52-62 and worker_bytes 0.87-0.96 GB per
+// 5 s for worker_hashes 0-1, worker_skips 238-263, hits 0. Such a discarded hash was in no budget (next_lookahead
+// counts published hashes only, and needs 8 of them in one frame), and the depth never went below 4.
+// The gate counts the worker's hashes, published or discarded, against its results that were used, over as many
+// frames as it takes to reach idle_judge_min hashes. After idle_low_periods such periods in a row with less than one
+// hash in eight used, the worker hashes nothing for idle_pause_frames frames, then is judged again at the minimum
+// depth. It only acts on frames with at most idle_max_validations validations (those scenes make 1 to 4 per frame):
+// a frame with more ends a pause at once and is left to next_lookahead alone, because there the worker does serve
+// the RSX thread (PID 54406 session 3 windows 11-17: 112 to 177 validations per frame, 58 to 96 ms of RSX hashing
+// served per 5 s) and no device run says the RSX thread could take that back without lengthening a frame.
+// Only speculation changes: with the worker paused the RSX thread hashes every range itself, with the same function,
+// as it does for every title without this lever.
+constexpr std::uint64_t idle_judge_min = 8;
+constexpr std::uint32_t idle_low_periods = 3;
+constexpr std::uint32_t idle_pause_frames = 120;
+constexpr std::size_t idle_max_validations = 16;
+
+struct idle_gate
+{
+	std::uint64_t work = 0, used = 0; // since the last judgement
+	std::uint32_t low = 0;            // judgements in a row with less than 1/8 used
+	std::uint32_t paused = 0;         // frames left without speculation
+
+	// Frame end. frame_work: hashes the worker completed in the frame (published or discarded); frame_used: its
+	// results a validation took; frame_validations: validations of 64 KiB or more the frame made.
+	// True: the worker hashes nothing during the next frame.
+	constexpr bool frame(std::uint64_t frame_work, std::uint64_t frame_used, std::size_t frame_validations) noexcept
+	{
+		if (frame_validations > idle_max_validations)
+		{
+			*this = {};
+			return false;
+		}
+
+		if (paused)
+		{
+			return --paused != 0;
+		}
+
+		work += frame_work;
+		used += frame_used;
+
+		if (work < idle_judge_min)
+		{
+			return false;
+		}
+
+		low = used * 8 < work ? low + 1 : 0;
+		work = 0;
+		used = 0;
+
+		if (low < idle_low_periods)
+		{
+			return false;
+		}
+
+		low = 0;
+		paused = idle_pause_frames;
+		return true;
+	}
+};
+
 // Totals since boot (the window counters below are taken by the profiler) and the current depth.
 inline std::atomic<std::uint64_t> total_hits{0}, total_worker_hashes{0};
+// REWINDBOX_PREHASH_IDLE_936: hashes the worker completed and could not publish (the RSX thread got there first, or
+// the epoch ended).
+inline std::atomic<std::uint64_t> total_worker_discards{0};
 inline std::atomic<std::uint32_t> current_lookahead{static_cast<std::uint32_t>(lookahead)};
 // Results kept (direct mapped, power of two).
 constexpr std::size_t table_size = 4096;
diff --git a/rpcs3/ios/IOSWakeCensus936.h b/rpcs3/ios/IOSWakeCensus936.h
new file mode 100644
index 0000000..fb228de
--- /dev/null
+++ b/rpcs3/ios/IOSWakeCensus936.h
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+// REWINDBOX_WAKE_CENSUS_936: measurement only, nothing in the execution changes.
+//
+// iPhone logs of IPA 726 (COREPROF ENERGY931): Black Ops II in game takes 22,000 to 25,000 timer wakeups of less
+// than 2 ms per second while its SPU threads almost never sleep (SPUWAIT551: 80 to 1,000 GETLLAR sleeps and about
+// 90 event waits per second); the frozen game takes as many with no SPU sleep at all; God of War III menus take
+// 80,000, which six SPU threads on a 100 us bound cannot reach alone (60,000 at most). The logs count the SPU
+// sleeps and the passive-lock waits, nothing else: the rest can only be bounded, not attributed.
+//
+// This file counts the three other sites that sleep on a short bound in a loop, each one only when it sleeps:
+// - lv2_obj::wait_timeout: every timed wait of a guest PPU thread (sys_timer_usleep, and semaphore, mutex, cond,
+//   event queue and event flag waits with a timeout), by the length of the host wait, and whether it ran to its
+//   bound (a timer woke the thread) or was ended early (a notification did);
+// - the RSX idle park (ios/IOSRsxIdlePark.h): slices that ran to their 50 us bound, slices ended by wake(), the
+//   time parked, and the number of parks (each one follows 1 ms of the yield loop, grace_us);
+// - the ZCULL on-demand read of a guest thread: its 50 us polls and its 50 to 400 us pauses.
+//
+// One report line per window: COREPROF WAKE936. Every counter is written by the thread that just slept or is
+// about to sleep, a few thousand times a second at most, each on its own cache line.
+namespace rpcs3::ios::wake_census
+{
+enum counter : unsigned
+{
+	// Host waits of lv2_obj::wait_timeout by requested length: ran to the bound, ended early.
+	lv2_under_200us_bound,
+	lv2_under_200us_early,
+	lv2_under_2ms_bound,
+	lv2_under_2ms_early,
+	lv2_under_5ms_bound,
+	lv2_under_5ms_early,
+	lv2_longer_bound,
+	lv2_longer_early,
+	// RSX idle park.
+	rsx_park_bound,   // slices that ran to their bound
+	rsx_park_woken,   // slices ended by rsx_idle_park::wake()
+	rsx_park_ns,      // time inside the slices
+	rsx_park_periods, // runs of slices more than period_gap_ns apart: about one per parked idle period
+	// ZCULL on-demand read (ios/IOSZcullOnDemand.h, RSXZCULL.cpp).
+	zcull_poll_sleeps, // 50 us sleeps while the RSX thread has not served the request
+	zcull_slot_pauses, // waits between two requests for the same slot (50 to 400 us, ended early by a release)
+	counter_count
+};
+
+// Two slices of one idle period are a few microseconds apart; two idle periods are at least grace_us (1 ms) apart.
+inline constexpr std::int64_t period_gap_ns = 500'000;
+
+struct alignas(128) cell
+{
+	std::atomic<std::uint64_t> value{0};
+};
+
+inline cell cells[counter_count];
+
+inline void add(counter c, std::uint64_t n = 1) noexcept
+{
+	cells[c].value.fetch_add(n, std::memory_order_relaxed);
+}
+
+// One host wait of lv2_obj::wait_timeout. It ran to its bound when it lasted at least 3/4 of the request (the rule
+// REWINDBOX_SPU_IDLE_BACKOFF_935 uses for its own waits).
+inline void lv2_wait(std::uint64_t requested_us, std::uint64_t slept_us) noexcept
+{
+	const unsigned first = requested_us < 200 ? lv2_under_200us_bound : requested_us < 2000 ? lv2_under_2ms_bound :
+		requested_us < 5000 ? lv2_under_5ms_bound : lv2_longer_bound;
+	add(static_cast<counter>(first + (slept_us >= requested_us - requested_us / 4 ? 0u : 1u)));
+}
+
+// Report thread: the line of this window. Reads and resets the counters.
+inline std::string take_line(std::uint64_t session, std::uint64_t window)
+{
+	unsigned long long v[counter_count];
+
+	for (unsigned i = 0; i < counter_count; i++)
+	{
+		v[i] = cells[i].value.exchange(0, std::memory_order_relaxed);
+	}
+
+	char line[640];
+	std::snprintf(line, sizeof(line),
+		"COREPROF WAKE936 session=%llu window=%llu tuple=ran_to_bound:ended_early "
+		"lv2_under_200us=%llu:%llu lv2_under_2ms=%llu:%llu lv2_under_5ms=%llu:%llu lv2_longer=%llu:%llu "
+		"rsx_park=%llu:%llu rsx_park_ms=%llu.%03llu rsx_park_periods=%llu rsx_park_slice_us=50 rsx_grace_us=1000 "
+		"zcull_poll_sleeps=%llu zcull_slot_pauses=%llu scope=process_window",
+		static_cast<unsigned long long>(session), static_cast<unsigned long long>(window),
+		v[lv2_under_200us_bound], v[lv2_under_200us_early], v[lv2_under_2ms_bound], v[lv2_under_2ms_early],
+		v[lv2_under_5ms_bound], v[lv2_under_5ms_early], v[lv2_longer_bound], v[lv2_longer_early],
+		v[rsx_park_bound], v[rsx_park_woken], v[rsx_park_ns] / 1'000'000, v[rsx_park_ns] / 1000 % 1000, v[rsx_park_periods],
+		v[zcull_poll_sleeps], v[zcull_slot_pauses]);
+	return line;
+}
+}
