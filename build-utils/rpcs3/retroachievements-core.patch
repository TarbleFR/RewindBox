+
+// NEOSTATION_RPCS3_RETROACHIEVEMENTS_V1: optional RetroAchievements hooks
+// (see RPCS3IOS.h). They never write guest memory, never call set_error()
+// (reads run every frame) and never take g_api_mutex, which a boot or stop
+// holds for seconds; the guest memory itself is protected by vm::try_access.
+extern "C" uint32_t rpcs3_ios_ra_api_version(void) noexcept
+{
+	return RPCS3_IOS_RA_API_VERSION;
+}
+
+extern "C" rpcs3_ios_status rpcs3_ios_ra_set_frame_callback(
+	rpcs3_ios_ra_frame_callback callback,
+	void* context) noexcept
+{
+	rpcs3::ios::achievements::vblank_hook().set(callback, context);
+	return RPCS3_IOS_OK;
+}
+
+extern "C" rpcs3_ios_status rpcs3_ios_ra_read_memory(
+	uint32_t address,
+	void* buffer,
+	uint32_t size,
+	uint32_t* mapped_bytes) noexcept
+{
+	if (mapped_bytes)
+	{
+		*mapped_bytes = 0;
+	}
+
+	if (!rpcs3::ios::achievements::valid_read(address, buffer, size))
+	{
+		return RPCS3_IOS_INVALID_ARGUMENT;
+	}
+
+	u8* const bytes = static_cast<u8*>(buffer);
+
+	if (!Emu.IsRunning() && !Emu.IsPaused())
+	{
+		std::memset(bytes, 0, size);
+		return RPCS3_IOS_INVALID_STATE;
+	}
+
+	try
+	{
+		const u32 copied = rpcs3::ios::achievements::read_guest(address, bytes, size,
+			[](u32 at, u8* out, u32 count)
+			{
+				return vm::try_access(at, out, count, false);
+			});
+
+		if (mapped_bytes)
+		{
+			*mapped_bytes = copied;
+		}
+
+		return RPCS3_IOS_OK;
+	}
+	catch (...)
+	{
+		std::memset(bytes, 0, size);
+		return RPCS3_IOS_INTERNAL_ERROR;
+	}
+}
+
+extern "C" rpcs3_ios_status rpcs3_ios_ra_get_session_info(rpcs3_ios_ra_session_info* info) noexcept
+{
+	if (!info || info->struct_size < sizeof(rpcs3_ios_ra_session_info))
+	{
+		return RPCS3_IOS_INVALID_ARGUMENT;
+	}
+
+	try
+	{
+		const u32 struct_size = info->struct_size;
+		std::memset(info, 0, sizeof(rpcs3_ios_ra_session_info));
+		info->struct_size = struct_size;
+		info->emulation_state = static_cast<u32>(current_emulation_state());
+
+		const frame_limit_type limit = g_cfg.video.frame_limit.get();
+		rpcs3::ios::achievements::speed_settings speed;
+		speed.vblank_rate = static_cast<u32>(g_cfg.video.vblank_rate.get());
+		speed.clocks_scale = static_cast<u32>(g_cfg.core.clocks_scale.get());
+		speed.frame_limit_unbounded = limit == frame_limit_type::none ||
+			limit == frame_limit_type::_120 || limit == frame_limit_type::infinite;
+
+		info->vblank_rate = speed.vblank_rate;
+		info->clocks_scale = speed.clocks_scale;
+		info->frame_limit_unbounded = speed.frame_limit_unbounded ? 1 : 0;
+		info->hardcore_compatible = rpcs3::ios::achievements::hardcore_compatible(speed) ? 1 : 0;
+
+		u64 generation = 0;
+		rpcs3::ios::achievements::last_boot().copy(info->title_id, sizeof(info->title_id),
+			info->content_path, sizeof(info->content_path), generation);
+		info->boot_generation = generation;
+		return RPCS3_IOS_OK;
+	}
+	catch (...)
+	{
+		return RPCS3_IOS_INTERNAL_ERROR;
+	}
+}
