+	std::string line = fmt::format("FREEZE_DUMP lwcond id=0x%x name=%s lwmutex_id=0x%x control=0x%x control_data=%s lwmutex=0x%x lwmutex_data=%s waiters=%s",
+		cond.id, sanitize_token(lv2_obj::name64(cond.name)), cond.lwid, cond.control, guest_hex(cond.control, 8), lwmutex,
+		guest_hex(lwmutex, 24), ids.empty() ? std::string("-") : ids);
+	return bound_line(line);
+}
