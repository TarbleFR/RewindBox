+	const u32 code = lr >= 0x80 ? lr - 0x80 : 0;
+	std::string regs, words;
+	u32 shown = 0;
+	std::vector<u32> seen;
+	for (u32 r = 13; r < 32; r++)
+	{
+		const u64 value = ppu.gpr[r];
+		fmt::append(regs, "%s%llx", r == 13 ? "" : ":", value);
+		const u32 addr = static_cast<u32>(value) & ~15u;
+		if (value >> 32 || addr < 0x10000 || shown >= 10 || std::find(seen.begin(), seen.end(), addr) != seen.end() ||
+			!vm::check_addr(addr, vm::page_readable, 16))
+		{
+			continue;
+		}
+		seen.push_back(addr);
+		fmt::append(words, "%sr%u@%x=%s", shown ? "," : "", r, addr, guest_hex(addr, 16));
+		shown++;
+	}
+	std::string line = fmt::format("FREEZE_DUMP ppu_poller id=0x%x func=%s pc=0x%x lr=0x%x code_at=0x%x code=%s r13_31=%s words=%s",
+		ppu.id, sanitize_token(ppu.current_function ? ppu.current_function : ""), ppu.cia, lr, code, guest_hex(code, 256), regs,
