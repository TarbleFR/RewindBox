diff --git a/rpcs3/ios/IOSWriterLockPhases.h b/rpcs3/ios/IOSWriterLockPhases.h
new file mode 100644
index 0000000..9206aec
--- /dev/null
+++ b/rpcs3/ios/IOSWriterLockPhases.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_WRITER_LOCK_PHASES_908: Black Ops II (BLES01717), IPA 694 device log, RANGELOCKPROF
+// wl_putllc=38814:229.833:0.956 (count:acquire_ms:hold_ms): an SPU PUTLLC that takes the heavyweight writer
+// lock waits about 5.9 us to acquire it and holds it 0.025 us. The acquisition has three phases (vm.cpp,
+// vm::writer_lock): the range-lock bit of the writer (bits), the range locks of other threads over the line
+// (ranges), and every running PPU thread reaching cpu_flag::wait after cpu_flag::memory (park). Counted for the
+// SPU PUTLLC source only, reported in RANGELOCKPROF as wl_putllc_phases=bits_ms:ranges_ms:park_ms,
+// wl_putllc_flagged (PPU threads asked to park), wl_putllc_slow_parks (parks over 50 us) and
+// wl_putllc_park_max_us. Measurement only: the lock protocol is unchanged.
+namespace rpcs3::ios::writer_lock_phases
+{
+struct counters_t
+{
+	std::atomic<std::uint64_t> bits_ticks{0}, ranges_ticks{0}, park_ticks{0};
+	std::atomic<std::uint64_t> flagged{0}, slow_parks{0}, park_max_ticks{0};
+};
+
+inline counters_t counters;
+
+inline void record(std::uint64_t bits, std::uint64_t ranges, std::uint64_t park, std::uint64_t flagged, std::uint64_t slow_threshold) noexcept
+{
+	counters.bits_ticks.fetch_add(bits, std::memory_order_relaxed);
+	counters.ranges_ticks.fetch_add(ranges, std::memory_order_relaxed);
+	counters.park_ticks.fetch_add(park, std::memory_order_relaxed);
+	counters.flagged.fetch_add(flagged, std::memory_order_relaxed);
+	if (park > slow_threshold)
+	{
+		counters.slow_parks.fetch_add(1, std::memory_order_relaxed);
+	}
+	std::uint64_t seen = counters.park_max_ticks.load(std::memory_order_relaxed);
+	while (park > seen && !counters.park_max_ticks.compare_exchange_weak(seen, park, std::memory_order_relaxed))
+	{
+	}
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::writer_lock_phases
