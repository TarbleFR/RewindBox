new file mode 100644
index 0000000..657821c
--- /dev/null
+++ b/rpcs3/ios/IOSCapture912.h
@@ -0,0 +1,548 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// REWINDBOX_CAPTURE_912: two bounded captures for questions the aggregate counters cannot answer. Both are off
+// unless their setting is on at boot (Automatic: off), start only on an explicit action (the emulation leaving a
+// pause: the in-game menu closed) and stop by themselves. Nothing here changes a lock, a barrier, a reservation
+// result or a wait: the collectors copy values the executed path already holds.
+//
+// putllc_trace (Black Ops II: what do the heavy PUTLLC write?). With Accurate SPU Reservations, every PUTLLC that
+// changes data and reaches its decision is recorded per SPU thread, in the order the thread executed them, up to
+// `capacity` events per thread and capture. No address filter: "consecutive" means every such PUTLLC of that
+// thread from the start of the capture to the thread's last recorded event; a thread that fills its buffer stops
+// recording (counted in after_full). There is no order between threads other than the timestamps.
+// Values and their meaning (16-byte lane = the first lane where the write-back differs from the snapshot):
+//   snapshot  the lane as the thread read it at GETLLAR (its reservation copy);
+//   written   the lane the thread asked to store;
+//   observed  the lane found in memory at the decision, on the paths that read the line and did not store:
+//             precheck (the line is copied once without the writer lock and the copy is what the check compares),
+//             compare and exchange (the line is copied under the writer lock right after the comparison or the
+//             16-byte exchange that failed). The mask after it says which lanes of memory differed from the snapshot;
+//             "=" says the copy equalled the snapshot. On a stored PUTLLC memory equalled the snapshot by the
+//             comparison under the lock. On the paths that fail on the reservation word, memory was not read:
+//             the event says so; nothing is read again later.
+//   written   is the local store at the moment the event is recorded, after the decision.
+// Cost while collecting: one 128-byte comparison and an 80-byte entry per recorded PUTLLC; not collecting: one
+// relaxed load per data-changing accurate PUTLLC. Memory: max_threads x capacity x sizeof(event), allocated once
+// by the diagnostic thread on the first capture.
+namespace rpcs3::ios::capture912
+{
+namespace putllc_trace
+{
+inline constexpr std::size_t capacity = 512;
+inline constexpr std::size_t max_threads = 8;
+inline constexpr std::uint64_t max_capture_ns = 3'000'000'000ull;
+inline constexpr std::uint32_t max_captures = 2; // per boot
+
+enum result : std::uint8_t
+{
+	none = 0,
+	stored = 1,            // compared equal under the writer lock, written
+	failed_time = 2,       // the reservation time had changed on entry (memory not read)
+	failed_owner = 3,      // the reservation word was locked or moved at the unique-lock attempt (memory not read)
+	failed_precheck = 4,   // memory already differed from the snapshot before the writer lock
+	failed_compare = 5,    // memory differed from the snapshot under the writer lock
+	failed_exchange = 6,   // under the writer lock the 128 bytes compared equal and the 16-byte exchange failed
+};
+
+struct event
+{
+	std::uint64_t tsc = 0;
+	std::uint64_t rtime = 0;      // the reservation time the thread held
+	std::uint32_t addr = 0;       // the 128-byte line
+	std::uint32_t pc = 0;         // SPU pc of the MFC command
+	std::uint8_t result = none;
+	std::uint8_t lanes = 0;       // bit i: 16-byte lane i of the write-back differs from the snapshot
+	std::uint8_t lane = 0xff;     // the first of them
+	std::uint8_t observed_valid = 0; // 1: observed[] was read at the decision and differs from the snapshot somewhere
+	std::uint8_t observed_lanes = 0; // bit i: lane i of memory differed from the snapshot (observed_read only)
+	std::uint8_t observed_read = 0;  // 1: the path copied the line from memory
+	std::uint8_t observed_lane = 0;  // the lane of observed[] (observed_valid only)
+	std::uint8_t pad = 0;
+	std::array<std::uint8_t, 16> snapshot{};
+	std::array<std::uint8_t, 16> written{};
+	std::array<std::uint8_t, 16> observed{}; // lane `lane` of memory at the decision (observed_valid only)
+};
+
+struct slot
+{
+	std::atomic<std::uint32_t> count{0};      // published entries (complete)
+	std::atomic<std::uint32_t> after_full{0}; // PUTLLC of this thread not recorded: its buffer was full
+	std::uint32_t thread_id = 0;
+};
+
+enum state : std::uint32_t { idle = 0, collecting = 1, stopping = 2 };
+
+inline std::atomic<bool> armed{false};               // the boot setting
+inline std::atomic<std::uint32_t> g_state{idle};
+inline std::atomic<std::uint32_t> g_generation{0};
+inline std::atomic<std::uint32_t> g_slots_used{0};
+inline std::atomic<std::uint32_t> g_writers{0};
+inline std::atomic<std::uint32_t> g_threads_dropped{0}; // threads beyond max_threads
+inline std::atomic<event*> g_events{nullptr};
+inline std::atomic<std::uint64_t> g_start_tsc{0};       // the time base of a capture: every thread's events refer to it
+inline std::array<slot, max_threads> g_slots{};
+
+inline bool is_collecting() noexcept
+{
+	return g_state.load(std::memory_order_relaxed) == collecting;
+}
+
+// Diagnostic thread: start a capture. The previous one was read and no writer is inside. now_tsc: the same clock
+// as the events' tsc.
+inline bool start(std::uint64_t now_tsc = 0) noexcept
+{
+	if (g_state.load(std::memory_order_acquire) != idle || g_writers.load(std::memory_order_acquire) != 0)
+	{
+		return false;
+	}
+
+	if (!g_events.load(std::memory_order_acquire))
+	{
+		g_events.store(new (std::nothrow) event[max_threads * capacity], std::memory_order_release);
+
+		if (!g_events.load(std::memory_order_acquire))
+		{
+			return false;
+		}
+	}
+
+	for (auto& s : g_slots)
+	{
+		s.count.store(0, std::memory_order_relaxed);
+		s.after_full.store(0, std::memory_order_relaxed);
+		s.thread_id = 0;
+	}
+
+	g_slots_used.store(0, std::memory_order_relaxed);
+	g_threads_dropped.store(0, std::memory_order_relaxed);
+	g_start_tsc.store(now_tsc, std::memory_order_relaxed);
+	g_generation.fetch_add(1, std::memory_order_release);
+	g_state.store(collecting, std::memory_order_release);
+	return true;
+}
+
+// Diagnostic thread: no new event starts after this.
+inline void stop() noexcept
+{
+	// seq_cst here, in quiescent() and in record(): either a writer sees the stop, or quiescent() sees the writer.
+	std::uint32_t expected = collecting;
+	g_state.compare_exchange_strong(expected, stopping, std::memory_order_seq_cst);
+}
+
+// Diagnostic thread, after stop(): true once no writer is inside; the slots may then be read.
+inline bool quiescent() noexcept
+{
+	return g_state.load(std::memory_order_seq_cst) == stopping && g_writers.load(std::memory_order_seq_cst) == 0;
+}
+
+// Diagnostic thread, after the slots were read.
+inline void release() noexcept
+{
+	g_state.store(idle, std::memory_order_release);
+}
+
+// Every recording thread filled its buffer (or nothing can be recorded any more).
+inline bool full() noexcept
+{
+	const std::uint32_t used = g_slots_used.load(std::memory_order_acquire);
+
+	if (!used)
+	{
+		return false;
+	}
+
+	for (std::uint32_t i = 0; i < used && i < max_threads; i++)
+	{
+		if (g_slots[i].count.load(std::memory_order_acquire) < capacity)
+		{
+			return false;
+		}
+	}
+
+	return true;
+}
+
+// SPU thread, after its PUTLLC decided. snapshot/written: the 128 bytes of the reservation copy and of the
+// write-back; observed: the 128 bytes of memory copied at the decision, or null when the path did not read them.
+inline void record(std::uint32_t thread_id, std::uint32_t pc, std::uint32_t addr, std::uint64_t rtime, std::uint64_t tsc,
+	std::uint8_t outcome, const void* snapshot, const void* written, const void* observed) noexcept
+{
+	g_writers.fetch_add(1, std::memory_order_seq_cst);
+
+	struct leave
+	{
+		~leave() { g_writers.fetch_sub(1, std::memory_order_seq_cst); }
+	} leaving;
+
+	if (g_state.load(std::memory_order_seq_cst) != collecting)
+	{
+		return;
+	}
+
+	static thread_local std::uint32_t t_generation = 0;
+	static thread_local std::uint32_t t_slot = ~0u;
+	const std::uint32_t generation = g_generation.load(std::memory_order_acquire);
+
+	if (t_generation != generation)
+	{
+		t_generation = generation;
+		const std::uint32_t index = g_slots_used.fetch_add(1, std::memory_order_acq_rel);
+
+		if (index >= max_threads)
+		{
+			g_slots_used.store(static_cast<std::uint32_t>(max_threads), std::memory_order_release);
+			g_threads_dropped.fetch_add(1, std::memory_order_relaxed);
+			t_slot = ~0u;
+		}
+		else
+		{
+			t_slot = index;
+			g_slots[index].thread_id = thread_id;
+		}
+	}
+
+	if (t_slot == ~0u)
+	{
+		return;
+	}
+
+	slot& s = g_slots[t_slot];
+	const std::uint32_t n = s.count.load(std::memory_order_relaxed);
+
+	if (n >= capacity)
+	{
+		s.after_full.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+
+	event& e = g_events.load(std::memory_order_relaxed)[t_slot * capacity + n];
+	e = event{};
+	e.tsc = tsc;
+	e.rtime = rtime;
+	e.addr = addr;
+	e.pc = pc;
+	e.result = outcome;
+	const auto* a = static_cast<const std::uint8_t*>(snapshot);
+	const auto* b = static_cast<const std::uint8_t*>(written);
+	const auto* m = static_cast<const std::uint8_t*>(observed);
+
+	for (std::uint32_t lane = 0; lane < 8; lane++)
+	{
+		if (std::memcmp(a + lane * 16, b + lane * 16, 16) != 0)
+		{
+			e.lanes |= static_cast<std::uint8_t>(1u << lane);
+
+			if (e.lane == 0xff)
+			{
+				e.lane = static_cast<std::uint8_t>(lane);
+			}
+		}
+
+		if (m && std::memcmp(a + lane * 16, m + lane * 16, 16) != 0)
+		{
+			e.observed_lanes |= static_cast<std::uint8_t>(1u << lane);
+		}
+	}
+
+	const std::uint32_t lane = e.lane == 0xff ? 0 : e.lane;
+	std::memcpy(e.snapshot.data(), a + lane * 16, 16);
+	std::memcpy(e.written.data(), b + lane * 16, 16);
+
+	if (m)
+	{
+		e.observed_read = 1;
+
+		if (e.observed_lanes)
+		{
+			// The lane shown is the first written lane when memory differs there, else the first lane that differs.
+			std::uint32_t shown = lane;
+
+			if (!(e.observed_lanes & (1u << lane)))
+			{
+				for (shown = 0; !(e.observed_lanes & (1u << shown)); shown++)
+				{
+				}
+			}
+
+			e.observed_valid = 1;
+			e.observed_lane = static_cast<std::uint8_t>(shown);
+			std::memcpy(e.observed.data(), m + shown * 16, 16);
+		}
+	}
+
+	s.count.store(n + 1, std::memory_order_release); // publish the complete entry
+}
+
+inline void append_hex(std::string& out, const std::uint8_t* data, std::size_t size)
+{
+	static constexpr char digits[] = "0123456789abcdef";
+
+	for (std::size_t i = 0; i < size; i++)
+	{
+		out += digits[data[i] >> 4];
+		out += digits[data[i] & 15];
+	}
+}
+
+// One event: dt_us:pc:addr:result:lanes:lane:rtime:snapshot:written:observed. observed is "-" (memory not read),
+// "=" (equal to the snapshot: by the comparison under the lock when stored, else by the copy the path took) or
+// hex/mask@lane (16 bytes of the copy, the lanes of memory that differed from the snapshot, the lane shown).
+// dt_us is the time since the thread's previous recorded event.
+inline std::string format_event(const event& e, std::uint64_t previous_tsc, std::uint64_t tsc_hz)
+{
+	char head[96];
+	const std::uint64_t dt = previous_tsc && tsc_hz && e.tsc >= previous_tsc ? (e.tsc - previous_tsc) * 1'000'000ull / tsc_hz : 0;
+	std::snprintf(head, sizeof(head), "%llu:%x:%x:%u:%02x:%x:%llx:", static_cast<unsigned long long>(dt), e.pc, e.addr, e.result, e.lanes,
+		e.lane == 0xff ? 15u : e.lane, static_cast<unsigned long long>(e.rtime));
+	std::string out = head;
+	append_hex(out, e.snapshot.data(), 16);
+	out += ':';
+	append_hex(out, e.written.data(), 16);
+	out += ':';
+
+	if (e.observed_valid)
+	{
+		char tail[16];
+		append_hex(out, e.observed.data(), 16);
+		std::snprintf(tail, sizeof(tail), "/%02x@%x", e.observed_lanes, e.observed_lane);
+		out += tail;
+	}
+	else
+	{
+		out += e.result == stored || e.observed_read ? "=" : "-";
+	}
+
+	return out;
+}
+
+// Diagnostic thread, quiescent(): the lines of one capture (each at most about 900 characters).
+inline std::vector<std::string> format_capture(std::uint32_t capture, std::uint64_t session, std::uint64_t tsc_hz, std::uint64_t elapsed_us,
+	const char* end_reason)
+{
+	std::vector<std::string> lines;
+	const std::uint32_t used = std::min<std::uint32_t>(g_slots_used.load(std::memory_order_acquire), static_cast<std::uint32_t>(max_threads));
+	const event* events = g_events.load(std::memory_order_acquire);
+	char head[320];
+	std::uint64_t total = 0, lost = 0;
+
+	for (std::uint32_t i = 0; i < used; i++)
+	{
+		total += g_slots[i].count.load(std::memory_order_acquire);
+		lost += g_slots[i].after_full.load(std::memory_order_relaxed);
+	}
+
+	std::snprintf(head, sizeof(head), "COREPROF PUTLLCTRACE912 session=%llu capture=%u part=begin threads=%u threads_dropped=%u events=%llu "
+		"after_full=%llu capacity=%zu elapsed_us=%llu end=%s scope=accurate_data_changing_putllc order=per_thread "
+		"time_base=capture_start t0_us=first_event_of_the_line "
+		"fields=dt_us:pc:addr:result:lanes:lane:rtime:snapshot:written:observed",
+		static_cast<unsigned long long>(session), capture, used, g_threads_dropped.load(std::memory_order_relaxed),
+		static_cast<unsigned long long>(total), static_cast<unsigned long long>(lost), capacity,
+		static_cast<unsigned long long>(elapsed_us), end_reason);
+	lines.emplace_back(head);
+
+	for (std::uint32_t i = 0; i < used && events; i++)
+	{
+		const std::uint32_t count = std::min<std::uint32_t>(g_slots[i].count.load(std::memory_order_acquire), static_cast<std::uint32_t>(capacity));
+		std::uint64_t previous = 0;
+		std::string line;
+		std::uint32_t first = 0;
+
+		for (std::uint32_t n = 0; n <= count; n++)
+		{
+			std::string text = n < count ? format_event(events[i * capacity + n], previous, tsc_hz) : std::string();
+
+			if (n < count)
+			{
+				previous = events[i * capacity + n].tsc;
+			}
+
+			if (!line.empty() && (n == count || line.size() + text.size() > 800))
+			{
+				// t0_us: the first event of this line against the start of the capture, so that the events of every
+				// thread share one time base (each event is stamped when it is recorded, after its PUTLLC decided).
+				const std::uint64_t base = g_start_tsc.load(std::memory_order_relaxed);
+				const std::uint64_t stamp = events[i * capacity + first].tsc;
+				const std::uint64_t t0 = tsc_hz && stamp >= base ? (stamp - base) * 1'000'000ull / tsc_hz : 0;
+				std::snprintf(head, sizeof(head), "COREPROF PUTLLCTRACE912 session=%llu capture=%u part=events thread=0x%x first=%u last=%u of=%u "
+					"after_full=%u t0_us=%llu ev=", static_cast<unsigned long long>(session), capture, g_slots[i].thread_id, first, n - 1, count,
+					g_slots[i].after_full.load(std::memory_order_relaxed), static_cast<unsigned long long>(t0));
+				lines.emplace_back(head + line);
+				line.clear();
+				first = n;
+			}
+
+			if (n < count)
+			{
+				if (!line.empty())
+				{
+					line += ' ';
+				}
+
+				line += text;
+			}
+		}
+	}
+
+	std::snprintf(head, sizeof(head), "COREPROF PUTLLCTRACE912 session=%llu capture=%u part=end lines=%zu", static_cast<unsigned long long>(session),
+		capture, lines.size() + 1);
+	lines.emplace_back(head);
+	return lines;
+}
+} // namespace putllc_trace
+
+// ppu_profile (God of War III: where does the main PPU thread spend its time?). A sampler reads, about once per
+// millisecond for a bounded time, the state and the guest pc of the running PPU threads. With the LLVM PPU
+// recompiler the pc field is written at indirect transfers (returns, calls through a pointer), at system calls
+// and at reservation instructions, not at every instruction or direct call: a sample names the last such point,
+// that is a region of code (often the caller of the hot code), never an exact instruction. Samples are counted per
+// 256-byte region; a thread seen waiting is counted as waiting with the name of its system call when it has one.
+namespace ppu_profile
+{
+inline constexpr std::size_t max_regions = 512;   // distinct 256-byte regions per thread (then counted in overflow)
+inline constexpr std::size_t max_threads = 4;
+inline constexpr std::uint32_t max_samples = 5000; // about 5 s at 1 kHz
+inline constexpr std::uint32_t max_captures = 3;  // per boot
+
+inline std::atomic<bool> armed{false};
+
+struct histogram
+{
+	struct cell
+	{
+		std::uint32_t region = 0; // pc >> 8, 0: empty
+		std::uint32_t count = 0;
+		std::uint32_t first_pc = 0;
+	};
+
+	std::array<cell, max_regions> cells{};
+	std::uint32_t thread_id = 0;
+	std::uint64_t running = 0, waiting = 0, overflow = 0, same_pc = 0;
+	std::uint32_t last_pc = 0;
+	std::uint32_t distinct = 0;
+
+	void add_running(std::uint32_t pc) noexcept
+	{
+		running++;
+		same_pc += pc == last_pc;
+		last_pc = pc;
+		const std::uint32_t region = pc >> 8;
+		std::size_t at = (region * 2654435761u) % max_regions;
+
+		for (std::size_t probe = 0; probe < max_regions; probe++, at = (at + 1) % max_regions)
+		{
+			cell& c = cells[at];
+
+			if (c.count == 0)
+			{
+				if (distinct >= max_regions * 3 / 4)
+				{
+					break; // keep the table sparse: the rest is overflow
+				}
+
+				c = {region, 1, pc};
+				distinct++;
+				return;
+			}
+
+			if (c.region == region)
+			{
+				c.count++;
+				return;
+			}
+		}
+
+		overflow++;
+	}
+
+	void add_waiting() noexcept
+	{
+		waiting++;
+	}
+
+	// The busiest regions first: region_base:count:first_pc.
+	std::string top(std::size_t limit) const
+	{
+		std::vector<cell> sorted;
+
+		for (const cell& c : cells)
+		{
+			if (c.count)
+			{
+				sorted.push_back(c);
+			}
+		}
+
+		std::sort(sorted.begin(), sorted.end(), [](const cell& a, const cell& b) { return a.count != b.count ? a.count > b.count : a.region < b.region; });
+		std::string out;
+		char item[48];
+
+		for (std::size_t i = 0; i < sorted.size() && i < limit; i++)
+		{
+			std::snprintf(item, sizeof(item), "%s%x:%u:%x", i ? "," : "", sorted[i].region << 8, sorted[i].count, sorted[i].first_pc);
+			out += item;
+		}
+
+		return out.empty() ? "-" : out;
+	}
+};
+} // namespace ppu_profile
+
+// The explicit start both captures share. The in-game menu of the host does not pause the emulation, so the host says
+// "start now" when that menu closes: it writes "Enabled" again to the capture's setting of the running title, and the
+// settings API hands that write here instead of treating it as a change of setting (nothing is loaded or saved).
+// Only a capture enabled at boot accepts a request.
+namespace start_request
+{
+inline std::atomic<bool> putllc{false};
+inline std::atomic<bool> ppu{false};
+
+// Settings API thread, a title running. True: the write is a start request and it is recorded.
+inline bool offer(std::string_view key, std::string_view value) noexcept
+{
+	if (value != "Enabled")
+	{
+		return false;
+	}
+
+	if (key == "experimental.heavy_putllc_trace" && putllc_trace::armed.load(std::memory_order_relaxed))
+	{
+		putllc.store(true, std::memory_order_release);
+		return true;
+	}
+
+	if (key == "experimental.ppu_region_profile" && ppu_profile::armed.load(std::memory_order_relaxed))
+	{
+		ppu.store(true, std::memory_order_release);
+		return true;
+	}
+
+	return false;
+}
+
+// Diagnostic thread, every sample: one start per request; a request found while the emulation does not run is dropped.
+inline bool take(std::atomic<bool>& request, bool running) noexcept
+{
+	return request.exchange(false, std::memory_order_acq_rel) && running;
+}
+
+// Diagnostic thread, another boot: a request of the previous game starts nothing.
+inline void clear() noexcept
+{
+	putllc.store(false, std::memory_order_release);
+	ppu.store(false, std::memory_order_release);
+}
+} // namespace start_request
+} // namespace rpcs3::ios::capture912
