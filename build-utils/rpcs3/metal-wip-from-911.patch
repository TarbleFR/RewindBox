+// REWINDBOX_CAPTURE_912 (ios/IOSCapture912.h): the diagnostic-thread side of the two captures. Called by the
+// profiler sampler every 500 ms; nothing here runs on an emulated thread except the PPU sampler's own reads.
+namespace
+{
+namespace capture = rpcs3::ios::capture912;
+
+u64 s_capture_session = ~0ull;  // the boot session the limits below belong to
+u32 s_putllc_captures = 0;      // captures armed in this boot session
+u32 s_putllc_number = 0;        // the capture in progress: its number and the boot session that armed it
+u64 s_putllc_session = 0;
+u64 s_putllc_started_us = 0;
+const char* s_putllc_end = "-";
+
+struct ppu_sampling
+{
+	std::vector<stx::shared_ptr<named_thread<ppu_thread>>> threads;
+	std::array<capture::ppu_profile::histogram, capture::ppu_profile::max_threads> tracked{};
+	std::array<std::array<std::pair<const char*, u32>, 8>, capture::ppu_profile::max_threads> wait_calls{};
+	u32 tracked_count = 0;
+	u64 others_running = 0;
+	u32 samples = 0;
+	u64 started_us = 0, ended_us = 0;
+	u64 session = 0;  // the boot session that armed this capture, and its number in that session
+	u32 number = 0;
+	u32 thread_count = 0;
+	std::array<std::string, capture::ppu_profile::max_threads> names;
+	std::atomic<bool> stop{false};
+	std::atomic<bool> done{false};
+	std::thread worker;
+
+	void run()
+	{
+		while (samples < capture::ppu_profile::max_samples && !stop.load(std::memory_order_relaxed) &&
+			Emu.GetStatus(false) == system_state::running)
+		{
+			for (const auto& ptr : threads)
+			{
+				const ppu_thread& ppu = *ptr;
+				u32 slot = tracked_count;
+
+				for (u32 i = 0; i < tracked_count; i++)
+				{
+					if (tracked[i].thread_id == ppu.id)
+					{
+						slot = i;
+						break;
+					}
+				}
+
+				const bool waiting = !!(ppu.state & cpu_flag::wait);
+
+				if (slot == tracked_count)
+				{
+					// Tracked: the first thread of the list (the title's main thread), then the first seen running.
+					if (tracked_count >= capture::ppu_profile::max_threads || (waiting && &ptr != &threads.front()))
+					{
+						others_running += !waiting;
+						continue;
+					}
+
+					tracked[tracked_count++].thread_id = ppu.id;
+				}
+
+				if (!waiting)
+				{
+					tracked[slot].add_running(ppu.cia);
+					continue;
+				}
+
+				tracked[slot].add_waiting();
+				const char* call = ppu.current_function;
+
+				for (auto& [name, count] : wait_calls[slot])
+				{
+					if (count == 0 || name == call)
+					{
+						name = call;
+						count++;
+						break;
+					}
+				}
+			}
+
+			samples++;
+			std::this_thread::sleep_for(std::chrono::microseconds(1000));
+		}
+
+		ended_us = get_system_time();
+
+		// The thread objects are released here, by this worker, about a millisecond after the emulation left the
+		// running state or the capture ended; the diagnostic thread only reads the copies below.
+		thread_count = static_cast<u32>(threads.size());
+
+		for (u32 i = 0; i < tracked_count; i++)
+		{
+			for (const auto& ptr : threads)
+			{
+				if (ptr->id == tracked[i].thread_id)
+				{
+					names[i] = ptr->get_name();
+					break;
+				}
+			}
+		}
+
+		threads.clear();
+		done.store(true, std::memory_order_release);
+	}
+};
+
+ppu_sampling* s_ppu = nullptr; // one capture at a time; deleted by the diagnostic thread after the join
+u32 s_ppu_captures = 0;
+
+void emit_ppu_profile(ppu_sampling& run)
+{
+	const u64 session = run.session;
+	const u32 s_ppu_captures = run.number;
+	ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu capture=%u part=begin samples=%u period_us=1000 elapsed_us=%llu threads=%u "
+		"tracked=%u others_running=%llu region_bytes=256 pc_scope=last_indirect_transfer_syscall_or_reservation "
+		"top_fields=region:samples:first_pc", session, s_ppu_captures, run.samples, run.ended_us - run.started_us,
+		run.thread_count, run.tracked_count, run.others_running);
+
+	for (u32 i = 0; i < run.tracked_count; i++)
+	{
+		const auto& h = run.tracked[i];
+		const std::string name = run.names[i].empty() ? std::string("-") : sanitize_token(run.names[i]);
+
+		std::string calls;
+
+		for (const auto& [call, count] : run.wait_calls[i])
+		{
+			if (count)
+			{
+				fmt::append(calls, "%s%s:%u", calls.empty() ? "" : ",", sanitize_token(call ? call : "guest_code"), count);
+			}
+		}
+
+		std::string line = fmt::format("COREPROF PPUPROF912 session=%llu capture=%u part=thread id=0x%x name=%s running=%llu "
+			"waiting=%llu same_pc=%llu distinct=%u overflow=%llu wait_calls=%s top=%s", session, s_ppu_captures, h.thread_id, name, h.running,
+			h.waiting, h.same_pc, h.distinct, h.overflow, calls.empty() ? std::string("-") : calls, h.top(24));
+		ios_freeze_dump.notice("%s", bound_line(line));
+	}
+
+	ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu capture=%u part=end", session, s_ppu_captures);
+}
+}
+
+void rewindbox_capture912_tick(unsigned long long session)
+{
+	const system_state status = Emu.GetStatus(false);
+	const bool running = status == system_state::running;
+	namespace trace = capture::putllc_trace;
+
+	if (session != s_capture_session)
+	{
+		// Another boot: the per-boot limits start again, a start request of the previous game starts nothing, and a
+		// capture of the previous boot ends now; it is exported under the session that started it.
+		s_capture_session = session;
+		capture::start_request::clear();
+		s_putllc_captures = 0;
+		s_ppu_captures = 0;
+
+		if (trace::is_collecting())
+		{
+			s_putllc_end = "session_change";
+			trace::stop();
+		}
+
+		if (s_ppu)
+		{
+			s_ppu->stop.store(true, std::memory_order_relaxed);
+		}
+	}
+
+	// The explicit start: the host wrote "Enabled" to the capture's setting when its in-game menu closed
+	// (ios/IOSCapture912.h, start_request). A request that cannot be served says why in the journal.
+	const bool start_putllc = capture::start_request::take(capture::start_request::putllc, running);
+	const bool start_ppu = capture::start_request::take(capture::start_request::ppu, running);
+	bool putllc_started = false;
+
+	// Heavy PUTLLC trace.
+	if (start_putllc)
+	{
+		if (s_putllc_captures >= trace::max_captures)
+		{
+			ios_freeze_dump.notice("COREPROF PUTLLCTRACE912 session=%llu part=refused reason=limit_per_boot max=%u", session, trace::max_captures);
+		}
+		else if (!trace::start(utils::get_tsc()))
+		{
+			ios_freeze_dump.notice("COREPROF PUTLLCTRACE912 session=%llu part=refused reason=previous_capture_not_exported", session);
+		}
+		else
+		{
+			putllc_started = true;
+			s_putllc_started_us = get_system_time();
+			s_putllc_session = session;
+			s_putllc_number = ++s_putllc_captures;
+			ios_freeze_dump.notice("COREPROF PUTLLCTRACE912 session=%llu capture=%u part=armed trigger=menu_closed capacity=%u max_threads=%u max_ms=%u",
+				s_putllc_session, s_putllc_number, static_cast<u32>(trace::capacity), static_cast<u32>(trace::max_threads),
+				static_cast<u32>(trace::max_capture_ns / 1'000'000));
+		}
+	}
+
+	if (putllc_started)
+	{
+	}
+	else if (trace::is_collecting())
+	{
+		const u64 elapsed = get_system_time() - s_putllc_started_us;
+
+		if (trace::full() || elapsed * 1000 >= trace::max_capture_ns || !running)
+		{
+			s_putllc_end = trace::full() ? "full" : running ? "time" : "not_running";
+			trace::stop();
+		}
+	}
+	else if (trace::quiescent())
+	{
+		for (const std::string& line : trace::format_capture(s_putllc_number, s_putllc_session, utils::get_tsc_freq(),
+			get_system_time() - s_putllc_started_us, s_putllc_end))
+		{
+			ios_freeze_dump.notice("%s", line);
+		}
+
+		trace::release();
+	}
+
+	// PPU region profile.
+	if (s_ppu)
+	{
+		if (start_ppu)
+		{
+			ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu part=refused reason=previous_capture_not_exported", session);
+		}
+
+		if (!running)
+		{
+			s_ppu->stop.store(true, std::memory_order_relaxed);
+		}
+
+		if (s_ppu->done.load(std::memory_order_acquire))
+		{
+			s_ppu->worker.join();
+			emit_ppu_profile(*s_ppu);
+			delete s_ppu;
+			s_ppu = nullptr;
+		}
+	}
+	else if (start_ppu && s_ppu_captures >= capture::ppu_profile::max_captures)
+	{
+		ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu part=refused reason=limit_per_boot max=%u", session, capture::ppu_profile::max_captures);
+	}
+	else if (start_ppu)
+	{
+		auto run = std::make_unique<ppu_sampling>();
+
+		{
+			// The same try-locked reader pattern as the freeze dump: a busy lock skips this capture.
+			std::shared_lock idm_reader(id_manager::g_mutex, std::try_to_lock);
+
+			if (idm_reader.owns_lock() && g_fxo->is_init<id_manager::id_map<named_thread<ppu_thread>>>())
+			{
+				idm::select<named_thread<ppu_thread>>([&](u32 id, named_thread<ppu_thread>&)
+				{
+					if (auto ptr = idm::get_unlocked<named_thread<ppu_thread>>(id))
+					{
+						run->threads.emplace_back(std::move(ptr));
+					}
+				}, idm::unlocked);
+			}
+		}
+
+		if (!run->threads.empty())
+		{
+			run->started_us = get_system_time();
+			run->session = session;
+			run->number = ++s_ppu_captures;
+			const u32 listed = static_cast<u32>(run->threads.size());
+			s_ppu = run.release();
+			s_ppu->worker = std::thread([state = s_ppu] { state->run(); });
+			ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu capture=%u part=armed trigger=menu_closed threads=%u max_samples=%u",
+				session, s_ppu->number, listed, capture::ppu_profile::max_samples);
+		}
+		else
+		{
+			// The thread list is read under a try-lock; busy, or no PPU thread yet.
+			ios_freeze_dump.notice("COREPROF PPUPROF912 session=%llu part=refused reason=thread_list_unavailable", session);
+		}
+	}
+}
