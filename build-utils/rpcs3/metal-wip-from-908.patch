diff --git a/rpcs3/ios/IOSGow3MlaaReport.h b/rpcs3/ios/IOSGow3MlaaReport.h
new file mode 100644
index 0000000..b671562
--- /dev/null
+++ b/rpcs3/ios/IOSGow3MlaaReport.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+// REWINDBOX_GOW3_MLAA_REPORT_909: God of War III, build 694 device log: CONFIG_LAYERS mlaa_bypass=1 is the policy, not
+// the patch. The executable was PPU-4d5c51503a81... (app 01.00, the BCES00510 cache directory), while the PPU half of the
+// bypass is gated to PPU-19724fde... (01.03) and skipped on a savestate boot; only the SPU half (exact SPU image hashes)
+// can apply, and every frame still read back one 1280x720x4 surface and received five SPU writes of the label the RSX
+// waits on. This records what was actually applied (COREPROF GOW3MLAA909): the PPU decision, the SPU images of the title
+// checked, the ones patched, and the first distinct SPU image hashes that matched no patch.
+namespace rpcs3::ios::gow3_mlaa
+{
+enum class ppu_state : std::uint32_t
+{
+	unset = 0, applied, other_executable, savestate, policy_off
+};
+
+inline std::atomic<std::uint32_t> ppu{0};
+inline std::atomic<std::uint64_t> spu_images{0}, spu_matched{0}, spu_words_patched{0};
+
+constexpr std::size_t hash_slots = 6;
+inline std::mutex hashes_mutex;
+inline std::array<std::array<char, 48>, hash_slots> unmatched{};
+inline std::size_t unmatched_count = 0;
+inline std::array<char, 48> executable{};
+
+inline void store(std::array<char, 48>& slot, std::string_view text) noexcept
+{
+	const std::size_t n = text.size() < slot.size() - 1 ? text.size() : slot.size() - 1;
+	std::memcpy(slot.data(), text.data(), n);
+	slot[n] = '\0';
+}
+
+inline void record_executable(std::string_view hash, ppu_state state) noexcept
+{
+	{
+		std::lock_guard lock(hashes_mutex);
+		store(executable, hash);
+	}
+	ppu.store(static_cast<std::uint32_t>(state), std::memory_order_relaxed);
+}
+
+inline void record_unmatched_spu(std::string_view hash) noexcept
+{
+	std::lock_guard lock(hashes_mutex);
+	for (std::size_t i = 0; i < unmatched_count; ++i)
+	{
+		if (std::string_view(unmatched[i].data()) == hash) return;
+	}
+	if (unmatched_count < hash_slots) store(unmatched[unmatched_count++], hash);
+}
+
+inline const char* ppu_name(std::uint32_t state) noexcept
+{
+	switch (static_cast<ppu_state>(state))
+	{
+	case ppu_state::applied: return "applied";
+	case ppu_state::other_executable: return "other_executable";
+	case ppu_state::savestate: return "savestate_memory";
+	case ppu_state::policy_off: return "policy_off";
+	default: return "unset";
+	}
+}
+
+// Comma-separated list of the unmatched SPU image hashes, and the executable hash.
+inline std::string unmatched_list()
+{
+	std::lock_guard lock(hashes_mutex);
+	std::string out;
+	for (std::size_t i = 0; i < unmatched_count; ++i)
+	{
+		if (i) out += ',';
+		out += unmatched[i].data();
+	}
+	return out.empty() ? std::string("-") : out;
+}
+
+inline std::string executable_hash()
+{
+	std::lock_guard lock(hashes_mutex);
+	return executable[0] ? std::string(executable.data()) : std::string("-");
+}
+} // namespace rpcs3::ios::gow3_mlaa
diff --git a/rpcs3/ios/IOSTextureValidationProfile.h b/rpcs3/ios/IOSTextureValidationProfile.h
