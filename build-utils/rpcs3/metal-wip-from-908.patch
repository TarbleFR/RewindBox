 	m_rtts.invalidate_range(utils::address_range32::start_length(address, range));
 }
 
+#ifdef RPCS3_IOS
+// REWINDBOX_SCOPED_RSX_UPLOADS_909: God of War III (CELL573 scope, Automatic for it) went through ~358 texture epochs
+// per frame on build 694 (Core 907), each one re-hashing every texture it samples next. An RSX method that writes guest
+// memory knows the range it wrote: only the sections over it are revalidated (revalidate_overlapping: section
+// validation, prehash bypass, bound sampler ranges, memo entries), as CELL573 does for flushed and committed surfaces.
+// The write is complete when this runs (the caller wrote the bytes first). Scope off, or an empty or wrapping range:
+// a new epoch, as before.
+void VKGSRender::ios_rsx_wrote_guest_memory(u32 address, u32 length, u8 epoch_source)
+{
+	if (length && u64{address} + length <= (1ull << 32) &&
+		rpcs3::ios::texture_validation_scope::enabled.load(std::memory_order_relaxed) &&
+		rpcs3::ios::texture_validation::current_epoch())
+	{
+		m_texture_cache.ios_revalidate_rsx_write(utils::address_range32::start_length(address, length));
+		rpcs3::ios::texture_validation::scoped_rsx_writes.fetch_add(1, std::memory_order_relaxed);
+		rpcs3::ios::texture_validation::scoped_rsx_write_bytes.fetch_add(length, std::memory_order_relaxed);
+		return;
+	}
+
+	rsx::thread::ios_rsx_wrote_guest_memory(address, length, epoch_source);
+}
+#endif
