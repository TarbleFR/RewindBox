+inline std::array<std::atomic<std::uint64_t>, static_cast<std::size_t>(epoch_source::count)> epoch_source_counts{};
+// REWINDBOX_SCOPED_RSX_UPLOADS_909: RSX writes of a known range revalidated in scope instead of a new epoch.
+inline std::atomic<std::uint64_t> scoped_rsx_writes{0}, scoped_rsx_write_bytes{0};
+
+inline void advance_epoch(epoch_source source = epoch_source::other) noexcept
 {
 	const bool enabled = epoch_enabled.load(std::memory_order_relaxed);
 	if (enabled)
 	{
 		validation_epoch.fetch_add(1, std::memory_order_acq_rel);
 		epoch_bumps.fetch_add(1, std::memory_order_relaxed);
+		epoch_source_counts[static_cast<std::size_t>(source)].fetch_add(1, std::memory_order_relaxed);
