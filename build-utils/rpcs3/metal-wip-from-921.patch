+		// REWINDBOX_CONFIG_DATABASE_RULE_922: every leaf the database names is applied; a file value that differs is
+		// a correction, reported with its path.
+		inline void apply_all(const YAML::Node& database, const YAML::Node& file, const YAML::Node& global, YAML::Node& out, result& r,
+			const std::string& path)
+		{
+			for (const auto& entry : database)
+			{
+				if (!entry.first.IsScalar())
+				{
+					continue;
+				}
+
+				const std::string key = entry.first.Scalar();
+				const YAML::Node value = entry.second;
+				const YAML::Node in_file = child(file, key);
+				const YAML::Node in_global = child(global, key);
+				const std::string here = path.empty() ? key : path + "/" + key;
+
+				if (value.IsMap())
+				{
