+					apply_all(value, in_file, in_global, section, r, here);
+
+					if (section.size())
+					{
+						out[key] = section;
+					}
+
+					continue;
+				}
+
+				const std::string wanted = leaf_text(value);
+				const std::string had = in_file.IsDefined() ? leaf_text(in_file) : leaf_text(in_global);
+
+				if (had == wanted)
+				{
+					r.agreed++;
+					continue;
+				}
+
+				out[key] = value;
+
+				if (in_file.IsDefined() && leaf_text(in_file) != leaf_text(in_global))
+				{
+					r.corrected++;
+					if (r.corrections.size() < 1024)
+					{
+						r.corrections += (r.corrections.empty() ? "" : ";") + here + ":" + had + "->" + wanted;
+					}
+				}
+				else
+				{
+					r.inherited++;
+				}
+			}
+		}
+	}
+
+	// REWINDBOX_CONFIG_DATABASE_RULE_922: the title's RPCS3 database config is the reference for every setting it
+	// names. God of War III ran on a full custom file written by an earlier build (legacy_custom=1) whose own values
+	// outranked the database under inherit_database below; the maintainer's rule (10 Nov): the RPCS3 database is applied
+	// to every game, compared with what is applied, and a setting that disagrees is corrected. The file still decides
+	// every setting the database does not name (resolution, for one).
+	inline result apply_database(const std::string& database, const std::string& file, const std::string& global)
+	{
+		result r;
+		const auto [database_node, database_error] = yaml_load(database);
+		const auto [file_node, file_error] = yaml_load(file);
+		const auto [global_node, global_error] = yaml_load(global);
+
+		if (!database_error.empty() || !file_error.empty() || !global_error.empty() || !database_node.IsMap())
+		{
+			return r;
+		}
+
+		YAML::Node out(YAML::NodeType::Map);
+		detail::apply_all(database_node, file_node, global_node, out, r, {});
+		r.ok = true;
+
+		if (r.inherited || r.corrected)
+		{
+			r.yaml = YAML::Dump(out);
+		}
+
+		return r;
 	}
 
