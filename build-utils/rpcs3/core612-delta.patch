+#define RPCS3_IOS_RA_API_VERSION 1u
+
+// Called on the RSX VBlank thread after each emulated VBlank (60 Hz, none
+// while paused or stopped). The callback must return quickly and must not
+// call rpcs3_ios_ra_set_frame_callback.
+typedef void (*rpcs3_ios_ra_frame_callback)(void* context, uint64_t frame);
+
+typedef struct rpcs3_ios_ra_session_info
+{
+    uint32_t struct_size;           // in: sizeof(rpcs3_ios_ra_session_info)
+    uint32_t emulation_state;       // rpcs3_ios_emulation_state, sampled by the call
+    uint32_t hardcore_compatible;   // VBlank 60 Hz, clocks 100 %, bounded frame limit
+    uint32_t vblank_rate;           // effective Video/Vblank Rate (Hz)
+    uint32_t clocks_scale;          // effective Core/Clocks scale (%)
+    uint32_t frame_limit_unbounded; // Frame limit Off, 120 or Infinite
+    uint64_t boot_generation;       // successful rpcs3_ios_boot_game calls
+    char title_id[64];
+    // Library entry of the last boot: the base game ISO or directory, never an
+    // installed update or a savestate file. Empty when unknown.
+    char content_path[1024];
+} rpcs3_ios_ra_session_info;
+
+RPCS3_IOS_EXPORT uint32_t rpcs3_ios_ra_api_version(void) RPCS3_IOS_NOEXCEPT;
+// Pass NULL to detach. Returns after a callback that used the previous
+// registration has finished, so its context may be released afterwards.
+RPCS3_IOS_EXPORT rpcs3_ios_status rpcs3_ios_ra_set_frame_callback(
+    rpcs3_ios_ra_frame_callback callback,
+    void* context) RPCS3_IOS_NOEXCEPT;
+// Copies guest bytes (PS3 byte order) while a game is running or paused.
+// Unmapped or protected pages are zero-filled; mapped_bytes (optional)
+// receives the number of bytes read from guest pages. size is 1..65536 and
+// the range must stay inside the 32-bit guest address space. Returns
+// RPCS3_IOS_INVALID_STATE (buffer zeroed) when no game is running.
+RPCS3_IOS_EXPORT rpcs3_ios_status rpcs3_ios_ra_read_memory(
+    uint32_t address,
+    void* buffer,
+    uint32_t size,
+    uint32_t* mapped_bytes) RPCS3_IOS_NOEXCEPT;
+RPCS3_IOS_EXPORT rpcs3_ios_status rpcs3_ios_ra_get_session_info(
+    rpcs3_ios_ra_session_info* info) RPCS3_IOS_NOEXCEPT;
+
