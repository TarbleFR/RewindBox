diff --git a/rpcs3/ios/IOSSpuObjectPrefetch.h b/rpcs3/ios/IOSSpuObjectPrefetch.h
new file mode 100644
index 0000000..62dc2dd
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectPrefetch.h
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <sys/qos.h>
+#endif
+
+// REWINDBOX_SPU_OBJECT_PREFETCH_616: Call of Duty: Black Ops II (BLES01717),
+// Build 614 iPhone logs (PID 64664, multiplayer session 3). At the start of a
+// match one 5 s window opens 7,162 cached SPU objects (JITPROF spu_cache_read
+// 7,162 calls, 4,300.8 ms, 21.2 MB inflated, 0.6 ms per object of about 3 KB):
+// the cost of opening thousands of small files on the compile path, not their
+// size. The 2,038.7 ms frame 2388 of that window has no blocking pipeline and
+// no LLVM budget wait; the 1,121.4 ms frame 3537 (window 17) also falls in a
+// burst of 613 object reads. The objects are already on disk: this module reads
+// the bytes of the title's object directory into memory on one utility-class
+// thread from the runtime's creation (menus, loading), newest objects first and
+// within a byte budget. A compile thread that needs an object takes its bytes
+// once (they leave the store) and inflates and validates them exactly as it
+// would after reading the file; an object not read yet is claimed and read from
+// the disk as before, never awaited. Same bytes, same validation, same link:
+// guest code is unchanged. Title scoped (ios/IOSTitleLevers.h); the store is
+// emptied when emulation stops.
+namespace rpcs3::ios::spu_object_prefetch
+{
+inline constexpr std::uint64_t max_resident_bytes = 48ull << 20;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 10; // larger objects keep the disk path
+inline constexpr std::uint64_t min_file_bytes = 18;           // smallest gzip member
+
+struct candidate
+{
+	std::string name;
+	std::uint64_t bytes = 0;
+	std::int64_t mtime = 0;
+};
+
+// Compressed objects (".gz") within the per-file bounds, newest first (then by
+// name), as long as they fit in the budget.
+inline std::vector<candidate> plan(std::vector<candidate> entries, std::uint64_t budget = max_resident_bytes,
+	std::uint64_t file_limit = max_file_bytes)
+{
+	std::erase_if(entries, [file_limit](const candidate& entry)
+	{
+		const std::string_view name = entry.name;
+		return name.size() <= 3 || name.substr(name.size() - 3) != ".gz" || entry.bytes < min_file_bytes || entry.bytes > file_limit;
+	});
+
+	std::sort(entries.begin(), entries.end(), [](const candidate& a, const candidate& b)
+	{
+		return a.mtime != b.mtime ? a.mtime > b.mtime : a.name < b.name;
+	});
+
+	std::vector<candidate> chosen;
+	std::uint64_t total = 0;
+
+	for (candidate& entry : entries)
+	{
+		if (entry.bytes > budget - total)
+		{
+			continue;
+		}
+
+		total += entry.bytes;
+		chosen.push_back(std::move(entry));
+	}
+
+	return chosen;
+}
+
+// Reads the whole file into `out`; false when it cannot or its size is not `expected`.
+using reader_fn = std::function<bool(const std::string& path, std::uint64_t expected, std::vector<unsigned char>& out)>;
+
+struct window_counters
+{
+	std::uint64_t hits = 0, hit_bytes = 0;   // objects served from memory
+	std::uint64_t claimed = 0;               // planned objects a compile thread read from disk first
+	std::uint64_t dropped = 0;               // read, but claimed meanwhile
+	std::uint64_t read = 0, read_bytes = 0, read_us = 0, failures = 0;
+};
+
+struct gauges
+{
+	bool active = false, done = false;
+	std::uint64_t planned = 0, planned_bytes = 0, pending = 0, resident = 0, resident_bytes = 0;
+};
+
+class store
+{
+	mutable std::mutex m_mutex;
+	std::unordered_map<std::string, std::vector<unsigned char>> m_ready; // full path of the ".gz" object
+	std::unordered_set<std::string> m_pending;                         // planned, neither read nor claimed
+	std::uint64_t m_resident_bytes = 0, m_planned = 0, m_planned_bytes = 0;
+	std::thread m_worker;
+	std::atomic<bool> m_stop{false}, m_active{false}, m_done{false};
+	window_counters m_window{};
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+	~store() { stop(); }
+
+	void start(std::string directory, std::vector<candidate> chosen, reader_fn reader)
+	{
+		stop();
+
+		{
+			std::lock_guard lock(m_mutex);
+			m_planned = chosen.size();
+			m_planned_bytes = 0;
+
+			for (const candidate& entry : chosen)
+			{
+				m_pending.insert(directory + entry.name);
+				m_planned_bytes += entry.bytes;
+			}
+		}
+
+		m_stop.store(false);
+		m_done.store(chosen.empty());
+		m_active.store(true);
+
+		if (chosen.empty())
+		{
+			return;
+		}
+
+		m_worker = std::thread([this, directory = std::move(directory), chosen = std::move(chosen), reader = std::move(reader)]()
+		{
+#if defined(__APPLE__)
+			pthread_setname_np("SPU object prefetch");
+			pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#endif
+			for (const candidate& entry : chosen)
+			{
+				if (m_stop.load(std::memory_order_relaxed))
+				{
+					break;
+				}
+
+				std::string path = directory + entry.name;
+
+				{
+					std::lock_guard lock(m_mutex);
+					if (!m_pending.contains(path))
+					{
+						continue; // claimed by a compile thread
+					}
+				}
+
+				std::vector<unsigned char> bytes;
+				const auto started = std::chrono::steady_clock::now();
+				const bool ok = reader(path, entry.bytes, bytes) && bytes.size() == entry.bytes;
+				const auto elapsed = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - started).count());
+
+				std::lock_guard lock(m_mutex);
+				m_window.read_us += elapsed;
+
+				if (!m_pending.erase(path))
+				{
+					m_window.dropped++;
+					continue;
+				}
+
+				if (!ok)
+				{
+					m_window.failures++;
+					continue;
+				}
+
+				m_window.read++;
+				m_window.read_bytes += bytes.size();
+				m_resident_bytes += bytes.size();
+				m_ready.emplace(std::move(path), std::move(bytes));
+			}
+
+			m_done.store(true);
+		});
+	}
+
+	// The prefetched bytes of this ".gz" object, once; nothing when they are
+	// not in memory (the caller reads the file, and the worker will skip it).
+	std::optional<std::vector<unsigned char>> take(const std::string& gz_path)
+	{
+		if (!m_active.load(std::memory_order_relaxed))
+		{
+			return std::nullopt;
+		}
+
+		std::lock_guard lock(m_mutex);
+
+		if (auto found = m_ready.find(gz_path); found != m_ready.end())
+		{
+			std::vector<unsigned char> bytes = std::move(found->second);
+			m_ready.erase(found);
+			m_resident_bytes -= bytes.size();
+			m_window.hits++;
+			m_window.hit_bytes += bytes.size();
+			return bytes;
+		}
+
+		if (m_pending.erase(gz_path))
+		{
+			m_window.claimed++;
+		}
+
+		return std::nullopt;
+	}
+
+	// Joins the worker and frees every byte still held.
+	void stop()
+	{
+		m_stop.store(true);
+
+		if (m_worker.joinable())
+		{
+			m_worker.join();
+		}
+
+		m_active.store(false);
+		std::lock_guard lock(m_mutex);
+		m_ready.clear();
+		m_pending.clear();
+		m_resident_bytes = 0;
+		m_planned = 0;
+		m_planned_bytes = 0;
+	}
+
+	window_counters take_window()
+	{
+		std::lock_guard lock(m_mutex);
+		return std::exchange(m_window, window_counters{});
+	}
+
+	gauges current() const
+	{
+		std::lock_guard lock(m_mutex);
+		return {m_active.load(), m_done.load(), m_planned, m_planned_bytes, m_pending.size(), m_ready.size(), m_resident_bytes};
+	}
+};
+
+inline store& instance()
+{
+	static store s_store;
+	return s_store;
+}
+}
