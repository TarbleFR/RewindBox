+void MTLGSRender::prepare_texture_bindings()
+{
+	// VKDraw.cpp bind_texture_env, the resolving half: deferred subresources become views (copies on the compute
+	// encoder), attachments sampled by this draw become snapshots. Done before the render pass opens.
+	using descriptor_type = mtl::texture_cache::sampled_image_descriptor;
+	auto& counters = mtl::counters();
+	m_draw_snapshots.clear();
+	m_fs_views = {};
+	m_fs_stencil_views = {};
+	m_vs_views = {};
+	m_frag_depth_view = nullptr;
+
+	for (u32 textures_ref = current_fp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		if (m_fragment_prog->binding_table.ftex_location[i] == umax)
+		{
+			// Corrupt shader table
+			break;
+		}
+
+		auto sampler_state = static_cast<descriptor_type*>(fs_sampler_state[i].get());
+		if (!sampler_state || !rsx::method_registers.fragment_textures[i].enabled() || !sampler_state->validate())
+		{
+			continue;
+		}
+
+		mtl::image_view* view = sampler_state->image_handle;
+		if (!view)
+		{
+			// Requires update, copy subresource
+			view = m_texture_cache.create_temporary_subresource(m_commands, sampler_state->external_subresource_desc);
+		}
+
+		if (!view)
+		{
+			counters.textures_not_bound.fetch_add(1, std::memory_order_relaxed);
+			mtl::get_texture_counters().textures_failed++;
+			continue;
+		}
+
+		view = snapshot_if_attachment(view);
+		m_fs_views[i] = view;
+		counters.textures_bound.fetch_add(1, std::memory_order_relaxed);
+
+		if (current_fragment_program.texture_state.redirected_textures & (1 << i))
+		{
+			// Stencil mirror required
+			if (view->image()->has_stencil_aspect())
+			{
+				m_fs_stencil_views[i] = view->image()->get_view(rsx::default_remap_vector, mtl::aspect_stencil);
+			}
+		}
+	}
+
+	for (u32 textures_ref = current_vp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		if (m_vertex_prog->binding_table.vtex_location[i] == umax)
+		{
+			// Corrupt shader
+			break;
+		}
+
+		auto sampler_state = static_cast<descriptor_type*>(vs_sampler_state[i].get());
+		if (!sampler_state || !rsx::method_registers.vertex_textures[i].enabled())
+		{
+			continue;
+		}
+
+		mtl::image_view* view = sampler_state->image_handle;
+		if (!view && sampler_state->validate())
+		{
+			view = m_texture_cache.create_temporary_subresource(m_commands, sampler_state->external_subresource_desc);
+		}
+
+		if (!view)
+		{
+			rsx_log.error("Texture upload failed to vtexture index %d. Binding null sampler.", i);
+			counters.textures_not_bound.fetch_add(1, std::memory_order_relaxed);
+			mtl::get_texture_counters().textures_failed++;
+			continue;
+		}
+
+		m_vs_views[i] = snapshot_if_attachment(view);
+		counters.textures_bound.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	if (current_fragment_program.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE)
+	{
+		// The bound depth buffer read by the shader (a snapshot: it is the attachment of this pass).
+		auto ds = ensure(std::get<1>(m_rtts.m_bound_depth_stencil), "Invalid FS export configuration.");
+		if (auto view = ds->get_view(rsx::default_remap_vector, mtl::aspect_depth))
+		{
+			m_frag_depth_view = snapshot_if_attachment(view);
+		}
+	}
+}
