+		// VK cs_interleave_task::run(cmd, data, data_offset, data_length, zeta_offset, stencil_offset)
+		bool run_interleave(command_context& ctx, compute_kernel kernel, const object& data, u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset);
+		// VK cs_fconvert_task::run(cmd, data, src_offset, src_length, dst_offset)
+		bool run_fconvert(command_context& ctx, compute_kernel kernel, const object& data, u32 src_offset, u32 src_length, u32 dst_offset);
