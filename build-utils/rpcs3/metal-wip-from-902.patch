+bool MTLGSRender::on_access_violation(u32 address, bool is_writing)
+{
+	rsx::mm_flush(address);
+
+	// The RSX thread flushes in place; a guest thread defers the flush to the RSX thread, the only one recording.
+	const bool can_flush = is_current_thread();
+	const rsx::invalidation_cause cause = is_writing
+		? (can_flush ? rsx::invalidation_cause::write : rsx::invalidation_cause::deferred_write)
+		: (can_flush ? rsx::invalidation_cause::read : rsx::invalidation_cause::deferred_read);
+
+	auto result = m_texture_cache.invalidate_address(m_commands, address, cause);
+
+	if (result.invalidate_samplers)
+	{
+		std::lock_guard lock(m_sampler_mutex);
+		m_samplers_dirty.store(true);
+	}
+
+	if (!result.violation_handled)
+	{
+		return zcull_ctrl->on_access_violation(address);
+	}
+
+	if (result.num_flushable > 0)
+	{
+		if (g_fxo->get<rsx::dma_manager>().is_current_thread())
+		{
+			// VKGSRender: the offloader thread cannot wait for flush requests (the RSX thread may be waiting for it).
+			// The RSX thread invalidates the range itself, flushing in place (VKGSRender::do_local_task).
+			ensure(!m_offloader_deadlock);
+			m_offloader_fault_range = g_fxo->get<rsx::dma_manager>().get_fault_range(is_writing);
+			m_offloader_fault_cause = is_writing ? rsx::invalidation_cause::write : rsx::invalidation_cause::read;
+
+			g_fxo->get<rsx::dma_manager>().set_mem_fault_flag();
+			m_offloader_deadlock = true;
+			m_eng_interrupt_mask |= rsx::backend_interrupt;
+#ifdef RPCS3_IOS
+			rpcs3::ios::rsx_idle_park::wake(); // CELL565_RSX_IDLE_PARK
+#endif
+			mtl::counters().offloader_faults.fetch_add(1, std::memory_order_relaxed);
+
+			while (m_offloader_deadlock)
+			{
+				utils::pause();
+			}
+
+			g_fxo->get<rsx::dma_manager>().clear_mem_fault_flag();
+			return true;
+		}
+
+		flush_request* task;
+		{
+			std::lock_guard lock(m_flush_queue_guard);
+			task = &m_flush_queue.emplace_back();
+			task->section_data = std::move(result);
+		}
+
+		mtl::counters().flush_requests.fetch_add(1, std::memory_order_relaxed);
+		m_eng_interrupt_mask |= rsx::backend_interrupt;
+#ifdef RPCS3_IOS
+		rpcs3::ios::rsx_idle_park::wake(); // CELL565_RSX_IDLE_PARK: this thread waits until the RSX thread serves it
+#endif
+		vm::temporary_unlock();
+
+		// GLGSRender work_item::producer_wait: until the RSX thread has written the data back.
+		utils::spin_wait(task->processed, [](auto v) { return v; });
+		task->received = true;
+	}
+
+	return true;
+}
+
+void MTLGSRender::flush_pending_requests()
+{
+	if (m_offloader_deadlock)
+	{
+		// VKGSRender::do_local_task: clear the offloader deadlock.
+		on_invalidate_memory_range(m_offloader_fault_range, m_offloader_fault_cause);
+		m_offloader_deadlock = false;
+	}
+
+	std::lock_guard lock(m_flush_queue_guard);
+	if (m_flush_queue.empty())
+	{
+		return;
+	}
+
+	m_flush_queue.remove_if([](auto& q) { return q.received.load(); });
+
+	bool flushed = false;
+	for (auto& q : m_flush_queue)
+	{
+		if (q.processed.load())
+		{
+			continue;
+		}
+
+		m_texture_cache.flush_all(m_commands, q.section_data);
+		q.processed = true;
+		flushed = true;
+	}
+
+	if (flushed)
+	{
+		// The flush submitted and waited: the next draw opens its render pass again.
+		m_render_pass_dirty = true;
+	}
 }
+
+void MTLGSRender::on_invalidate_memory_range(const utils::address_range32& range, rsx::invalidation_cause cause)
+{
+	auto data = m_texture_cache.invalidate_range(m_commands, range, cause);
+	AUDIT(data.empty());
+
+	if (cause == rsx::invalidation_cause::unmap && data.violation_handled)
+	{
+		m_texture_cache.purge_unreleased_sections();
+		{
+			std::lock_guard lock(m_sampler_mutex);
+			m_samplers_dirty.store(true);
+		}
+	}
+}
+
+void MTLGSRender::on_semaphore_acquire_wait()
+{
+	bool pending = m_offloader_deadlock;
+	{
+		std::lock_guard lock(m_flush_queue_guard);
+		pending = pending || !m_flush_queue.empty();
+	}
+
+	if (pending || (async_flip_requested & flip_request::emu_requested))
+	{
+		do_local_task(rsx::FIFO::state::lock_wait);
+	}
+}
+
+void MTLGSRender::do_local_task(rsx::FIFO::state state)
+{
+	flush_pending_requests();
+
+	if (!in_begin_end && state != rsx::FIFO::state::lock_wait)
+	{
+		if (m_graphics_state & rsx::pipeline_state::framebuffer_reads_dirty)
+		{
+			// This will re-engage locks and break the texture cache if another thread is waiting in access violation
+			// handler! Only call when there are no waiters.
+			m_texture_cache.do_update();
+			m_graphics_state.clear(rsx::pipeline_state::framebuffer_reads_dirty);
+		}
+	}
+
+	rsx::thread::do_local_task(state);
+}
+
+void MTLGSRender::notify_tile_unbound(u32 /*tile*/)
+{
+	// As VKGSRender / GLGSRender (the texture writeback of an unbound tile is a TODO there too).
+	std::lock_guard lock(m_sampler_mutex);
+	m_samplers_dirty.store(true);
+}
