+	void upload_image(command_context& ctx, data_heap& heap, image* dst, const std::vector<rsx::subresource_layout>& layouts,
+		u32 gcm_format, bool is_swizzled, bool supports_bc)
+	{
+		ensure(dst && dst->texture);
+
+		rsx::texture_uploader_capabilities caps{};
+		caps.supports_byteswap = false;      // byteswap, deswizzle and DXT decoding on the CPU (no compute helpers yet)
+		caps.supports_vtc_decoding = false;
+		caps.supports_hw_deswizzle = false;
+		caps.supports_zero_copy = false;
+		caps.supports_dxt = supports_bc;
+		caps.alignment = 0;
+
+		const pixel_format format = dst->format();
+		const bool depth_stencil = format == pixel_format::depth32_float_stencil8;
+		const bool depth16_float = format == pixel_format::depth32_float && gcm_format == CELL_GCM_TEXTURE_DEPTH16_FLOAT;
+		const bool depth_float_class = dst->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32;
+		const bool compressed = rsx::is_compressed_host_format(caps, gcm_format);
+		const u32 host_bpp = compressed ? get_block_size(format) : get_texel_size(format);
+
+		if (!depth_stencil && !depth16_float && !compressed && !host_bpp)
+		{
+			g_texture_counters.uploads_unsupported_format++;
+			log_once("upload-format", fmt::format("texture upload into format %u (gcm 0x%x) is not supported", static_cast<u32>(format), gcm_format));
+			return;
+		}
+
+		for (const rsx::subresource_layout& layout : layouts)
+		{
+			if (layout.level >= dst->mipmaps())
+			{
+				rsx_log.error("Metal: invalid subresource definition for the output texture (mip level %u does not exist)", layout.level);
+				continue;
+			}
+
+			const auto [row_pitch, upload_pitch_in_texel] = calculate_upload_pitch(gcm_format, *dst, layout, caps);
+			caps.alignment = row_pitch;
+
+			const u32 rows = compressed ? layout.height_in_block : layout.height_in_texel;
+			const u64 image_linear_size = static_cast<u64>(row_pitch) * layout.depth * rows;
+
+			// Decode the guest data into staging memory (with 8 bytes of slack, as VK maps it). Depth formats get their
+			// converted planes in the same allocation: a second one could make room by reusing this one's space.
+			const u32 width = layout.width_in_texel;
+			const u32 plane_rows = rows * layout.depth;
+			const u64 decode_size = utils::align<u64>(image_linear_size + 8, 256);
+			const u64 depth_size = (depth_stencil || depth16_float) ? utils::align<u64>(static_cast<u64>(width) * 4 * plane_rows, 256) : 0;
+			const u64 stencil_size = depth_stencil ? static_cast<u64>(width) * plane_rows : 0;
+			auto staging = allocate_staging(ctx, heap, decode_size + depth_size + stencil_size);
+			u8* const mapped = staging.data;
+			auto io_buf = rsx::io_buffer([&](usz) -> std::tuple<void*, usz>
+			{
+				return { mapped, static_cast<usz>(image_linear_size) };
+			});
+
+			const auto opt = rsx::upload_texture_subresource(io_buf, layout, static_cast<int>(gcm_format), is_swizzled, caps);
+			ensure(!opt.require_upload, "Metal: zero-copy texture upload requested without support");
+
+			g_texture_counters.uploads++;
+			g_texture_counters.upload_bytes += image_linear_size;
+
+			const size3 size{ layout.width_in_texel, layout.height_in_texel, layout.depth };
+			const bool is_3d = dst->type == texture_type::type_3d;
+			const u32 slice = is_3d ? 0 : layout.layer;
+
+			if (depth_stencil || depth16_float)
+			{
+				// Separate planes, converted with the Vulkan renderer's formulas.
+				f32* depth = reinterpret_cast<f32*>(mapped + decode_size);
+				u8* stencil = mapped + decode_size + depth_size;
+				const u64 depth_offset = staging.offset + decode_size;
+
+				if (depth_stencil)
+				{
+					scatter_depth_stencil(mapped, row_pitch, width, plane_rows, depth_float_class, depth, stencil);
+				}
+				else
+				{
+					for (u32 y = 0; y < plane_rows; ++y)
+					{
+						const u16* in = reinterpret_cast<const u16*>(mapped + static_cast<usz>(y) * row_pitch);
+						for (u32 x = 0; x < width; ++x)
+						{
+							depth[static_cast<usz>(y) * width + x] = std::bit_cast<f32>(e4m12_to_f32_bits(in[x]));
+						}
+					}
+				}
+
+				const auto& encoder = ctx.compute("texture upload");
+				copy_buffer_to_texture(encoder, staging.buffer, depth_offset, width * 4, is_3d ? width * 4 * rows : 0,
+					size, dst->texture, slice, layout.level, {}, depth_stencil ? blit_depth_from_depth_stencil : blit_none);
+				if (depth_stencil)
+				{
+					copy_buffer_to_texture(encoder, staging.buffer, depth_offset + depth_size, width, is_3d ? width * rows : 0,
+						size, dst->texture, slice, layout.level, {}, blit_stencil_from_depth_stencil);
+				}
+				g_texture_counters.depth_uploads_converted++;
+				continue;
+			}
+
+			const auto& encoder = ctx.compute("texture upload");
+			copy_buffer_to_texture(encoder, staging.buffer, staging.offset, row_pitch, is_3d ? row_pitch * rows : 0,
+				size, dst->texture, slice, layout.level, {});
+			static_cast<void>(upload_pitch_in_texel);
+		}
+
+		// Commands of one Metal 4 encoder may run concurrently: the next user of this texture opens a new encoder,
+		// whose queue barrier waits for these copies.
+		ctx.end_encoder();
+	}
+
+	void clear_image(command_context& ctx, data_heap& heap, image* dst)
+	{
+		ensure(dst && dst->texture);
+		g_texture_counters.clears++;
+
+		if (dst->is_depth())
+		{
+			// VK clears temporary depth images to {1.f, 0}.
+			for (u32 level = 0; level < dst->mipmaps(); ++level)
+			{
+				for (u32 slice = 0; slice < dst->layers(); ++slice)
+				{
+					render_pass_descriptor pass{};
+					pass.depth.texture = dst->texture;
+					pass.depth.level = level;
+					pass.depth.slice = slice;
+					pass.depth.load = load_action::clear;
+					pass.depth.store = store_action::store;
+					pass.depth.clear_depth = 1.0;
+					if (dst->has_stencil_aspect())
+					{
+						pass.stencil = { dst->texture, level, slice, load_action::clear, store_action::store, 0 };
+					}
+					pass.render_target_width = std::max(dst->width() >> level, 1u);
+					pass.render_target_height = std::max(dst->height() >> level, 1u);
+					ctx.begin_render(pass, 0, "texture clear");
+					ctx.end_encoder();
+				}
+			}
+			return;
+		}
+
+		// Colour: a zeroed staging region copied into every level and slice.
+		const bool compressed = is_compressed_format(dst->format());
+		const u32 bpp = compressed ? get_block_size(dst->format()) : get_texel_size(dst->format());
+		if (!bpp)
+		{
+			log_once("clear-format", fmt::format("clear of texture format %u is not supported", static_cast<u32>(dst->format())));
+			return;
+		}
+
+		const auto row_bytes = [&](u32 width) { return compressed ? utils::aligned_div(width, 4u) * bpp : width * bpp; };
+		const auto row_count = [&](u32 height) { return compressed ? utils::aligned_div(height, 4u) : height; };
+		const bool is_3d = dst->type == texture_type::type_3d;
+		const u64 size = static_cast<u64>(row_bytes(dst->width())) * row_count(dst->height()) * (is_3d ? dst->depth() : 1);
+		auto zeros = allocate_staging(ctx, heap, size);
+		std::memset(zeros.data, 0, static_cast<usz>(size));
+
+		const auto& encoder = ctx.compute("texture clear");
+		for (u32 level = 0; level < dst->mipmaps(); ++level)
+		{
+			const u32 w = std::max(dst->width() >> level, 1u);
+			const u32 h = std::max(dst->height() >> level, 1u);
+			const u32 d = is_3d ? std::max(dst->depth() >> level, 1u) : 1;
+			for (u32 slice = 0; slice < (is_3d ? 1 : dst->layers()); ++slice)
+			{
+				copy_buffer_to_texture(encoder, zeros.buffer, zeros.offset, row_bytes(w), is_3d ? row_bytes(w) * row_count(h) : 0,
+					{ w, h, d }, dst->texture, slice, level, {});
+			}
+		}
+		ctx.end_encoder();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTexture.h b/rpcs3/Emu/RSX/Metal/MTLTexture.h
new file mode 100644
index 0000000..fbd13ea
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTexture.h
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M3.1): textures of the native Metal 4 renderer (vk::image / vk::viewable_image /
+// vk::image_view counterparts) and the CPU texture upload path.
+//
+// An image owns one MTLTexture (private storage, resident in the renderer's residency set) and the views made of
+// it: one per (RSX remap, aspect, format), with the swizzle the Vulkan renderer puts in its VkImageView. Render
+// targets are images too, so the texture cache samples them through the same views.
+//
+// Uploads run on the CPU exactly as the Vulkan renderer's upload_image does when its GPU helpers are not used:
+// rsx::upload_texture_subresource deswizzles, byteswaps and (without BC support) decompresses into the upload
+// ring, then the compute encoder copies the ring into the texture. Depth formats are converted on the CPU with
+// the Vulkan renderer's formulas (MTLTextureFormats.h) and copied per plane.
+
+#include "MTLAPI.h"
+#include "MTLDataHeap.h"
+#include "MTLFormats.h"
+#include "MTLTextureFormats.h"
+
+#include "Emu/RSX/Common/TextureUtils.h"
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace mtl
+{
+	class command_context;
+	class image;
+
+	// The renderer's command context, for destructors and code paths that have none at hand (RSX thread only).
+	void set_command_context(command_context* ctx);
+	command_context* get_command_context();
+
+	enum image_aspect : u32
+	{
+		aspect_color = 1,
+		aspect_depth = 2,
+		aspect_stencil = 4,
+	};
+
+	// What the texture paths did or could not do yet; read and reset by the performance report (COREPROF METAL).
+	struct texture_counters
+	{
+		std::atomic<u64> images_created{0};
+		std::atomic<u64> image_allocation_failures{0};
+		std::atomic<u64> views_created{0};
+		std::atomic<u64> view_failures{0};
+		std::atomic<u64> uploads{0};
+		std::atomic<u64> upload_bytes{0};
+		std::atomic<u64> upload_dedicated_buffers{0};
+		std::atomic<u64> depth_uploads_converted{0};
+		std::atomic<u64> uploads_unsupported_format{0};     // no Metal format (counted, the section keeps zeros)
+		std::atomic<u64> clears{0};
+		std::atomic<u64> copies{0};
+		std::atomic<u64> typeless_copies{0};                // bit-compatible format views
+		std::atomic<u64> buffer_bitcasts{0};                // reinterpretations through a buffer (no byte shuffle)
+		std::atomic<u64> typeless_not_implemented{0};       // needs a byte shuffle or a depth conversion on the GPU
+		std::atomic<u64> scaled_not_implemented{0};         // a scaled region copy (no blit-scale pipeline yet)
+		std::atomic<u64> copies_clipped{0};                 // region copies kept inside the textures (Metal does not clip)
+		std::atomic<u64> feedback_snapshots{0};             // bound attachments sampled through a copy
+		std::atomic<u64> readbacks{0};
+		std::atomic<u64> readback_bytes{0};
+		std::atomic<u64> readbacks_not_implemented{0};      // scaled, tiled, compressed or DMA-only (guest memory kept)
+		std::atomic<u64> samplers_created{0};
+		std::atomic<u64> border_colors_approximated{0};     // RSX custom border colour -> closest Metal preset
+		std::atomic<u64> lod_bias_not_applied{0};           // the device has no sampler LOD bias
+		std::atomic<u64> filters_downgraded{0};             // linear filter on a format the device cannot filter
+		std::atomic<u64> unnormalized_samplers_adjusted{0}; // Metal limits on unnormalized coordinates
+		std::atomic<u64> textures_failed{0};                // enabled unit without a texture: neutral texture bound
+	};
+
+	texture_counters& get_texture_counters();
+
+	// Logs a message once per process (counters keep the totals).
+	void log_once(const char* key, const std::string& message);
+
+	class image_view
+	{
+	public:
+		image_view(mtl::image* owner, object handle, const texture_view_descriptor& desc, u32 aspect, u64 key);
+		~image_view();
+
+		image_view(const image_view&) = delete;
+		image_view& operator=(const image_view&) = delete;
+
+		mtl::image* image() const { return m_owner; }
+		const object& handle() const { return m_handle; }
+		pixel_format format() const { return m_desc.format; }
+		u32 aspect() const { return m_aspect; }
+		const texture_view_descriptor& descriptor() const { return m_desc; }
+
+		// The shader reads native swizzles: nothing to emulate (VK_DISABLE_COMPONENT_SWIZZLE is off).
+		u32 encoded_component_map() const { return 0; }
+
+		// The same view in another compatible format (hardware SNORM / sRGB conversion), or this view on failure.
+		image_view* as(pixel_format format);
+
+	private:
+		mtl::image* m_owner = nullptr;
+		object m_handle;
+		texture_view_descriptor m_desc{};
+		u32 m_aspect = aspect_color;
+		u64 m_key = 0;
+	};
+
+	class image
+	{
+	public:
+		object texture;
+		texture_type type = texture_type::type_2d;
+		pixel_format native_format = pixel_format::invalid;
+		u32 texture_width = 0;    // texture size (resolution scale applied for surfaces)
+		u32 texture_height = 0;
+		u32 texture_depth = 1;
+		u32 mip_count = 1;
+		u32 layer_count = 1;
+		u8 sample_count = 1;
+		u32 usage = usage_shader_read;
+		rsx::format_class image_format_class = rsx::RSX_FORMAT_CLASS_COLOR;
+		component_map native_component_map = default_component_map;
+		std::string debug_name;
+
+		image() = default;
+		virtual ~image();
+
+		image(const image&) = delete;
+		image& operator=(const image&) = delete;
+
+		// Allocates the texture (private storage) and makes it resident. False on failure (counted, logged).
+		bool create(command_context& ctx, const texture_descriptor& desc, rsx::format_class format_class);
+
+		u32 width() const { return texture_width; }
+		u32 height() const { return texture_height; }
+		u32 depth() const { return texture_depth; }
+		u32 mipmaps() const { return mip_count; }
+		u32 layers() const { return layer_count; }
+		u8 samples() const { return sample_count; }
+		pixel_format format() const { return native_format; }
+		rsx::format_class format_class() const { return image_format_class; }
+		u32 aspect() const;
+		bool is_depth() const { return is_depth_format(native_format); }
+		bool has_stencil_aspect() const { return has_stencil(native_format); }
+
+		// A view with the RSX remap applied over the native component layout (viewable_image::get_view).
+		image_view* get_view(const rsx::texture_channel_remap_t& remap, u32 aspect_mask = aspect_color | aspect_depth);
+		// A view with an explicit format and swizzle (cached by key).
+		image_view* get_view(pixel_format format, const component_map& swizzle, u32 aspect, u64 key);
+
+		void set_native_component_layout(const component_map& layout);
+		const component_map& get_native_component_layout() const { return native_component_map; }
+		void set_name(const std::string& name) { debug_name = name; }
+
+		// The texture type a view of the whole image uses.
+		texture_type view_type() const { return type; }
+
+	protected:
+		void release_views();
+
+	private:
+		std::unordered_map<u64, std::unique_ptr<image_view>> m_views;
+		image_view* m_last_view = nullptr;
+		u64 m_last_view_key = 0;
+	};
+
+	// Uploads guest subresources (rsx::get_subresources_layout) into an image, in the compute encoder of ctx.
+	// The upload ring may make room by submitting: the caller must not hold an encoder across this call.
+	void upload_image(command_context& ctx, data_heap& heap, image* dst, const std::vector<rsx::subresource_layout>& layouts,
+		u32 gcm_format, bool is_swizzled, bool supports_bc);
+
+	// Clears every level and slice: colour images to zero (buffer copy), depth images to depth 1, stencil 0.
+	void clear_image(command_context& ctx, data_heap& heap, image* dst);
+
+	// Staging memory for a transfer: the ring, or a dedicated shared buffer released after the submission.
+	struct staging_allocation
+	{
+		object buffer;
+		u64 offset = 0;
+		u8* data = nullptr;
+	};
+
+	staging_allocation allocate_staging(command_context& ctx, data_heap& heap, u64 size);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTextureCache.cpp b/rpcs3/Emu/RSX/Metal/MTLTextureCache.cpp
new file mode 100644
index 0000000..7a5878d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTextureCache.cpp
@@ -0,0 +1,1114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M3.1): the Metal 4 backend of the common texture cache (VKTextureCache.cpp counterpart).
+
+#include "stdafx.h"
+#include "MTLTextureCache.h"
+
+#include "Emu/Memory/vm.h"
+#include "Emu/RSX/RSXThread.h"
+#include "util/asm.hpp"
+
+#include <cstring>
+
+#ifdef RPCS3_IOS
+#include "ios/IOSDeferredCommit.h"
+#endif
+
+namespace mtl
+{
+	namespace
+	{
+		constexpr u32 swap32(u32 v)
+		{
+			return (v >> 24) | ((v >> 8) & 0xff00u) | ((v << 8) & 0xff0000u) | (v << 24);
+		}
+
+		template <typename T>
+		void byteswap_elements(u8* data, usz bytes)
+		{
+			for (usz offset = 0; offset + sizeof(T) <= bytes; offset += sizeof(T))
+			{
+				T value;
+				std::memcpy(&value, data + offset, sizeof(T));
+				if constexpr (sizeof(T) == 2)
+				{
+					value = static_cast<T>((value >> 8) | (value << 8));
+				}
+				else
+				{
+					value = swap32(value);
+				}
+				std::memcpy(data + offset, &value, sizeof(T));
+			}
+		}
+
+		u16 swap16(u16 value) { return static_cast<u16>((value >> 8) | (value << 8)); }
+	}
+
+	// cached_texture_section
+
+	void cached_texture_section::create(u16 w, u16 h, u16 depth_, u16 mipmaps_, mtl::image* image, u32 rsx_pitch_, bool managed, u32 gcm_format_, bool pack_swap_bytes)
+	{
+#ifdef RPCS3_IOS
+		// REWINDBOX_TEXTURE_LOOKUP_MEMO_660: image, dimensions, pitch, format and swizzle are written directly below.
+		ios_memo_changed();
+#endif
+		ensure(!exists() || !is_managed() || vram_texture == image);
+
+		if (vram_texture != image && !managed_texture && get_protection() == utils::protection::no)
+		{
+			// In-place image swap, still locked. Likely a color buffer that got rebound as depth buffer or vice-versa.
+			as_rtt(vram_texture)->on_swap_out();
+
+			if (!managed)
+			{
+				// Incoming is also an external resource, reference it immediately
+				as_rtt(image)->on_swap_in(is_locked());
+			}
+		}
+
+		vram_texture = image;
+		ensure(rsx_pitch_);
+
+		width = w;
+		height = h;
+		this->depth = depth_;
+		this->mipmaps = mipmaps_;
+		this->rsx_pitch = rsx_pitch_;
+		this->gcm_format = gcm_format_;
+		this->pack_unpack_swap_bytes = pack_swap_bytes;
+
+		if (managed)
+		{
+			managed_texture.reset(vram_texture);
+		}
+
+		if (auto rtt = try_as_rtt(image))
+		{
+			swizzled = (rtt->raster_type != rsx::surface_raster_type::linear);
+		}
+
+		if (synchronized)
+		{
+#ifdef RPCS3_IOS
+			// CELL560_DEFERRED_COMMIT: new GPU contents replace bytes nobody accessed.
+			this->drop_deferred_commit();
+#endif
+			// Even if we are managing the same vram section, we cannot guarantee contents are static
+			release_dma_resources();
+			synchronized = false;
+			flushed = false;
+			sync_timestamp = 0ull;
+		}
+
+		baseclass::on_section_resources_created();
+	}
+
+	void cached_texture_section::create(u16 w, u16 h, u16 depth_, u16 mipmaps_, mtl::image* image, u32 rsx_pitch_, bool managed, const mtl::render_target* surface)
+	{
+		const auto info = surface->is_depth_surface() ?
+			rsx::get_compatible_gcm_format(surface->get_surface_depth_format()) :
+			rsx::get_compatible_gcm_format(surface->get_surface_color_format());
+		create(w, h, depth_, mipmaps_, image, rsx_pitch_, managed, info.first, info.second);
+	}
+
+	void cached_texture_section::release_dma_resources()
+	{
+		if (m_download)
+		{
+			// A copy may still be writing it.
+			if (auto ctx = get_command_context())
+			{
+				ctx->dispose(std::move(m_download), true);
+			}
+			m_download.reset();
+			m_download_size = 0;
+		}
+
+		m_fence = 0;
+		m_converted = false;
+		m_mode = readback_mode::none;
+	}
+
+	void cached_texture_section::dma_abort()
+	{
+		// A reset after a bad prediction: the next sync, if any, records a new copy.
+		ensure(synchronized);
+		ensure(!flushed);
+		m_fence = 0;
+		m_converted = false;
+		m_mode = readback_mode::none;
+	}
+
+	void cached_texture_section::destroy()
+	{
+		if (!exists() && context != rsx::texture_upload_context::dma)
+		{
+			return;
+		}
+#ifdef RPCS3_IOS
+		ios_memo_changed(); // REWINDBOX_TEXTURE_LOOKUP_MEMO_660: the image and its views go
+#endif
+
+		m_tex_cache->on_section_destroyed(*this);
+
+		vram_texture = nullptr;
+		ensure(!managed_texture);
+		release_dma_resources();
+
+		baseclass::on_section_resources_destroyed();
+	}
+
+	image_view* cached_texture_section::get_view(const rsx::texture_channel_remap_t& remap)
+	{
+		ensure(vram_texture != nullptr);
+		return vram_texture->get_view(remap);
+	}
+
+	image_view* cached_texture_section::get_raw_view()
+	{
+		ensure(vram_texture != nullptr);
+		return vram_texture->get_view(rsx::default_remap_vector);
+	}
+
+	pixel_format cached_texture_section::get_format() const
+	{
+		if (context == rsx::texture_upload_context::dma)
+		{
+			return pixel_format::r32_uint;
+		}
+
+		ensure(vram_texture != nullptr);
+		return vram_texture->format();
+	}
+
+	void cached_texture_section::set_rsx_pitch(u32 pitch)
+	{
+		ensure(!is_locked());
+#ifdef RPCS3_IOS
+		ios_memo_changed(); // REWINDBOX_TEXTURE_LOOKUP_MEMO_660: read by pitch_compatible()
+#endif
+		rsx_pitch = pitch;
+	}
+
+	void cached_texture_section::sync_surface_memory(const rsx::simple_array<cached_texture_section*>& surfaces)
+	{
+		auto rtt = as_rtt(vram_texture);
+		rtt->sync_tag();
+
+		for (auto& surface : surfaces)
+		{
+			rtt->inherit_surface_contents(as_rtt(surface->vram_texture));
+		}
+	}
+
+	void cached_texture_section::copy_texture(command_context& cmd, bool miss)
+	{
+		auto& counters = get_texture_counters();
+
+		if (!miss) [[likely]]
+		{
+			ensure(!synchronized);
+			baseclass::on_speculative_flush();
+		}
+		else
+		{
+			baseclass::on_miss();
+		}
+
+		const auto keep_memory = [&](const char* key, const char* reason)
+		{
+			// Not implemented for this section: the flush writes the guest memory back unchanged (never garbage).
+			m_mode = readback_mode::keep_memory;
+			m_fence = 0;
+			m_converted = false;
+			real_pitch = rsx_pitch;
+			counters.readbacks_not_implemented++;
+			log_once(key, fmt::format("readback of %s sections is not implemented: the guest memory keeps its contents", reason));
+			synchronized = true;
+			sync_timestamp = rsx::get_shared_tag();
+		};
+
+		if (!exists())
+		{
+			keep_memory("readback-dma", "DMA-only");
+			return;
+		}
+
+		mtl::image* locked_resource = vram_texture;
+		u32 transfer_width = width;
+		u32 transfer_height = height;
+
+		if (context == rsx::texture_upload_context::framebuffer_storage)
+		{
+			auto surface = as_rtt(vram_texture);
+			surface->memory_barrier(cmd, rsx::surface_access::transfer_read);
+			locked_resource = surface->get_surface(rsx::surface_access::transfer_read);
+			transfer_width *= surface->samples_x;
+			transfer_height *= surface->samples_y;
+		}
+
+		if (transfer_width != locked_resource->width() || transfer_height != locked_resource->height())
+		{
+			// VK scales into a typeless helper first (copy_scaled_image).
+			keep_memory("readback-scaled", "scaled (resolution scale or anti-aliased)");
+			return;
+		}
+
+		if (rsx::get_current_renderer()->get_tiled_memory_region(get_confirmed_range()))
+		{
+			// VK tiles the data on the GPU (cs_tile_memcpy<encode>).
+			keep_memory("readback-tiled", "tiled");
+			return;
+		}
+
+		const pixel_format format = locked_resource->format();
+		const u32 guest_bpp = get_format_texel_width(format);
+		u32 plane_bpp = get_texel_size(format);
+		readback_mode mode = readback_mode::copy;
+		switch (format)
+		{
+		case pixel_format::depth16_unorm: mode = readback_mode::depth16; break;
+		case pixel_format::depth32_float: mode = readback_mode::depth16_float; plane_bpp = 4; break;
+		case pixel_format::depth32_float_stencil8: mode = readback_mode::depth24; plane_bpp = 4; break;
+		default: break;
+		}
+
+		if (!guest_bpp || !plane_bpp || is_compressed_format(format))
+		{
+			keep_memory("readback-format", "compressed or unknown-format");
+			return;
+		}
+
+		m_mode = mode;
+		m_depth_float = locked_resource->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32;
+		m_transfer_width = transfer_width;
+		m_transfer_height = transfer_height;
+		m_guest_bpp = guest_bpp;
+		m_element_size = get_format_element_size(format).first;
+		m_converted = false;
+
+		// The whole image is read back; the common imp_flush writes only the confirmed range. Layout of the buffer:
+		// [guest layout, real_pitch rows | scratch plane(s) as the GPU copied them].
+		real_pitch = guest_bpp * transfer_width;
+		const u64 output_size = utils::align<u64>(std::max<u64>(static_cast<u64>(real_pitch) * transfer_height, get_section_size()), 256);
+		const u64 plane_size = utils::align<u64>(static_cast<u64>(plane_bpp) * transfer_width * transfer_height, 256);
+		const u64 stencil_size = (mode == readback_mode::depth24) ? static_cast<u64>(transfer_width) * transfer_height : 0;
+		const u64 required = output_size + plane_size + stencil_size;
+		m_scratch_offset = output_size;
+		m_stencil_offset = output_size + plane_size;
+
+		if (!m_download || m_download_size < required)
+		{
+			if (m_download)
+			{
+				cmd.dispose(std::move(m_download), true);
+			}
+			m_download_size = utils::align<u64>(required, 4096);
+			m_download = new_buffer(cmd.device(), m_download_size, storage_mode::shared);
+			ensure(m_download, "Metal: readback buffer allocation failed");
+			cmd.make_resident(m_download);
+		}
+
+		const region area{ { 0, 0, 0 }, { transfer_width, transfer_height, 1 } };
+		const auto& encoder = cmd.compute("texture readback");
+		if (mode == readback_mode::depth24)
+		{
+			copy_texture_to_buffer(encoder, locked_resource->texture, 0, 0, area, m_download, m_scratch_offset, transfer_width * 4, 0, blit_depth_from_depth_stencil);
+			copy_texture_to_buffer(encoder, locked_resource->texture, 0, 0, area, m_download, m_stencil_offset, transfer_width, 0, blit_stencil_from_depth_stencil);
+		}
+		else
+		{
+			copy_texture_to_buffer(encoder, locked_resource->texture, 0, 0, area, m_download, m_scratch_offset, transfer_width * plane_bpp, 0);
+		}
+		cmd.end_encoder();
+
+		m_fence = cmd.recording_value();
+		cmd.set_dma_transfer();
+		counters.readbacks++;
+		counters.readback_bytes += static_cast<u64>(real_pitch) * transfer_height;
+
+		synchronized = true;
+		sync_timestamp = rsx::get_shared_tag();
+	}
+
+	void cached_texture_section::convert_readback(u8* base)
+	{
+		const u8* scratch = base + m_scratch_offset;
+		const u32 w = m_transfer_width;
+		const bool swap = pack_unpack_swap_bytes;
+
+		for (u32 y = 0; y < m_transfer_height; ++y)
+		{
+			u8* out = base + static_cast<usz>(y) * real_pitch;
+			switch (m_mode)
+			{
+			case readback_mode::copy:
+			{
+				const usz row = static_cast<usz>(w) * m_guest_bpp;
+				std::memcpy(out, scratch + y * row, row);
+				if (swap && m_element_size == 2)
+				{
+					byteswap_elements<u16>(out, row);
+				}
+				else if (swap && m_element_size == 4)
+				{
+					byteswap_elements<u32>(out, row);
+				}
+				break;
+			}
+			case readback_mode::depth16:
+			{
+				const u16* in = reinterpret_cast<const u16*>(scratch) + static_cast<usz>(y) * w;
+				for (u32 x = 0; x < w; ++x)
+				{
+					const u16 value = swap ? swap16(in[x]) : in[x];
+					std::memcpy(out + x * 2, &value, 2);
+				}
+				break;
+			}
+			case readback_mode::depth16_float:
+			{
+				const u32* in = reinterpret_cast<const u32*>(scratch) + static_cast<usz>(y) * w;
+				for (u32 x = 0; x < w; ++x)
+				{
+					const u16 packed = f32_bits_to_e4m12(in[x]);
+					const u16 value = swap ? swap16(packed) : packed;
+					std::memcpy(out + x * 2, &value, 2);
+				}
+				break;
+			}
+			case readback_mode::depth24:
+			{
+				const u32* depth = reinterpret_cast<const u32*>(scratch) + static_cast<usz>(y) * w;
+				const u8* stencil = base + m_stencil_offset + static_cast<usz>(y) * w;
+				for (u32 x = 0; x < w; ++x)
+				{
+					const u32 d24 = m_depth_float ? f32_bits_to_d24f(depth[x]) : f32_to_d24(std::bit_cast<f32>(depth[x]));
+					const u32 packed = (d24 << 8) | stencil[x];
+					const u32 value = swap ? swap32(packed) : packed;
+					std::memcpy(out + x * 4, &value, 4);
+				}
+				break;
+			}
+			default:
+				break;
+			}
+		}
+	}
+
+	void* cached_texture_section::map_synchronized(u32 offset, u32 size)
+	{
+		ensure(synchronized);
+
+		if (m_mode == readback_mode::keep_memory)
+		{
+			// The guest bytes themselves (through the unprotected mirror): the write-back leaves them unchanged.
+			const u32 length = get_section_size();
+			if (!m_download || m_download_size < length)
+			{
+				if (m_download)
+				{
+					get_command_context()->dispose(std::move(m_download), true);
+				}
+				m_download_size = utils::align<u64>(length, 4096);
+				m_download = new_buffer(get_command_context()->device(), m_download_size, storage_mode::shared);
+				ensure(m_download, "Metal: readback buffer allocation failed");
+			}
+
+			u8* base = static_cast<u8*>(buffer_contents(m_download));
+			std::memcpy(base, vm::get_super_ptr<u8>(get_section_base()), length);
+			ensure(u64{offset} + size <= length);
+			return base + offset;
+		}
+
+		ensure(m_download && m_fence);
+		command_context* ctx = ensure(get_command_context());
+		if (m_fence > ctx->last_submitted())
+		{
+			if (rsx::get_current_renderer()->is_current_thread())
+			{
+				// The copy is in the work being recorded (a speculative copy): submit it now.
+				ctx->submit_and_wait();
+			}
+			else
+			{
+				// Only the RSX thread records and submits. Every path that records a readback submits it before
+				// another thread can need it (the flush batch, prepare_rtts after a commit); should one not have,
+				// this thread waits for the RSX thread's next submission (logged once).
+				log_once("readback-unsubmitted", "a guest thread needs a readback the RSX thread has not submitted yet: waiting for it");
+				while (m_fence > ctx->last_submitted())
+				{
+					utils::pause();
+				}
+			}
+		}
+		ctx->wait(m_fence);
+
+		u8* base = static_cast<u8*>(buffer_contents(m_download));
+		if (!m_converted)
+		{
+			convert_readback(base);
+			m_converted = true;
+		}
+
+		ensure(u64{offset} + size <= m_scratch_offset);
+		return base + offset;
+	}
+
+	// texture_cache
+
+	void texture_cache::initialize(data_heap& upload_heap, bool supports_bc)
+	{
+		m_upload_heap = &upload_heap;
+		m_supports_bc = supports_bc;
+	}
+
+	void texture_cache::on_section_destroyed(cached_texture_section& tex)
+	{
+		if (tex.is_managed() && tex.exists())
+		{
+			// ~image releases the texture and its views once the work recorded so far has completed.
+			tex.get_texture().reset();
+		}
+	}
+
+	void texture_cache::clear()
+	{
+		baseclass::clear();
+	}
+
+	void texture_cache::destroy()
+	{
+		clear();
+	}
+
+	component_map texture_cache::apply_component_mapping_flags(u32 gcm_format, rsx::component_order flags, const rsx::texture_channel_remap_t& remap) const
+	{
+		component_map mapping{};
+		if (!mtl::apply_component_mapping_flags(gcm_format, static_cast<u32>(flags), remap, mapping))
+		{
+			fmt::throw_exception("Invalid or unsupported component mapping for texture format (0x%x)", gcm_format);
+		}
+		return mapping;
+	}
+
+	std::unique_ptr<mtl::image> texture_cache::create_image(command_context& cmd, u32 gcm_format, texture_type type, u16 width, u16 height, u16 depth, u8 mips) const
+	{
+		const pixel_format format = get_compatible_sampler_format(gcm_format, m_supports_bc);
+		if (format == pixel_format::invalid)
+		{
+			fmt::throw_exception("Invalid or unsupported sampler format for texture format (0x%x)", gcm_format);
+		}
+
+		texture_descriptor desc{};
+		desc.type = type;
+		desc.format = format;
+		desc.width = std::max<u32>(width, 1);
+		desc.height = std::max<u32>(height, 1);
+		desc.depth = (type == texture_type::type_3d) ? std::max<u32>(depth, 1) : 1;
+		desc.array_length = 1;
+
+		// Metal refuses more levels than the full chain of the largest dimension.
+		const u32 largest = std::max({ desc.width, desc.height, desc.depth });
+		const u32 full_chain = 32 - std::countl_zero(largest);
+		desc.mip_levels = std::clamp<u32>(mips, 1, full_chain);
+
+		// Views reinterpret formats (hardware SNORM/sRGB, bit-compatible copies) and swizzle; depth images are
+		// cleared through a render pass.
+		desc.usage = usage_shader_read | usage_pixel_format_view | (is_depth_format(format) ? usage_render_target : 0);
+		desc.storage = storage_mode::private_;
+
+		auto result = std::make_unique<mtl::image>();
+		if (!result->create(cmd, desc, rsx::classify_format(gcm_format)))
+		{
+			return {};
+		}
+		return result;
+	}
+
+	mtl::image* texture_cache::get_template_from_collection_impl(const rsx::simple_array<copy_region_descriptor>& sections_to_transfer) const
+	{
+		if (sections_to_transfer.size() == 1) [[likely]]
+		{
+			return sections_to_transfer.front().src;
+		}
+
+		mtl::image* result = nullptr;
+		for (const auto& section : sections_to_transfer)
+		{
+			if (!section.src)
+			{
+				continue;
+			}
+
+			if (!result)
+			{
+				result = section.src;
+			}
+			else if (section.src->native_component_map != result->native_component_map)
+			{
+				// TODO (as in the Vulkan renderer): mixing component layouts needs compute assistance
+				return nullptr;
+			}
+		}
+
+		return result;
+	}
+
+	void texture_cache::copy_transfer_regions_impl(command_context& cmd, mtl::image* dst, const rsx::simple_array<copy_region_descriptor>& sections_to_transfer) const
+	{
+		auto& counters = get_texture_counters();
+		const u32 dst_bpp = get_format_texel_width(dst->format());
+		const bool dst_is_3d = dst->type == texture_type::type_3d;
+
+		for (const auto& section : sections_to_transfer)
+		{
+			mtl::image* src = section.src;
+			if (!src)
+			{
+				continue;
+			}
+
+			const u32 src_bpp = get_format_texel_width(src->format());
+			if (!src_bpp || !dst_bpp)
+			{
+				counters.typeless_not_implemented++;
+				log_once("copy-format", fmt::format("copy between formats %u and %u is not implemented", static_cast<u32>(src->format()), static_cast<u32>(dst->format())));
+				continue;
+			}
+
+			const bool typeless = src->aspect() != dst->aspect() ||
+				!images_are_bitcast_compatible(dst->format(), dst->format_class(), src->format(), src->format_class());
+
+			u16 src_x = section.src_x;
+			u16 src_y = section.src_y;
+			u16 src_w = section.src_w;
+			u16 src_h = section.src_h;
+
+			rsx::flags32_t transform = section.xform;
+			if (section.xform == rsx::surface_transform::coordinate_transform)
+			{
+				// Dimensions were given in 'dst' space. Work out the real source coordinates
+				src_x = static_cast<u16>((src_x * dst_bpp) / src_bpp);
+				src_w = utils::aligned_div<u16>(static_cast<u16>(src_w * dst_bpp), static_cast<u16>(src_bpp));
+				transform &= ~(rsx::surface_transform::coordinate_transform);
+			}
+
+			if (auto surface = try_as_rtt(src))
+			{
+				surface->transform_samples_to_pixels(src_x, src_w, src_y, src_h);
+			}
+
+			if (transform != rsx::surface_transform::identity)
+			{
+				counters.scaled_not_implemented++;
+				log_once("copy-transform", "region copy with a coordinate transform is not implemented");
+				continue;
+			}
+
+			const u32 dst_slice = dst_is_3d ? 0 : section.dst_z;
+			const u32 dst_z = dst_is_3d ? section.dst_z : 0;
+			const u32 level = section.level;
+			const u32 level_w = std::max(dst->width() >> level, 1u);
+			const u32 level_h = std::max(dst->height() >> level, 1u);
+
+			// Metal does not clip copies: keep every region inside both textures (Vulkan leaves it undefined).
+			const auto clip = [&](u32 sx, u32 sy, u32& w, u32& h, u32 sw, u32 sh)
+			{
+				const u32 cw = std::min({ w, sw > sx ? sw - sx : 0u, level_w > section.dst_x ? level_w - section.dst_x : 0u });
+				const u32 ch = std::min({ h, sh > sy ? sh - sy : 0u, level_h > section.dst_y ? level_h - section.dst_y : 0u });
+				if (cw != w || ch != h)
+				{
+					counters.copies_clipped++;
+				}
+				w = cw;
+				h = ch;
+			};
+
+			if (typeless) [[unlikely]]
+			{
+				// VK copy_image_typeless: a bit-level reinterpretation through a buffer. Without a byte shuffle (same
+				// swap granule on both sides) it is two copies; shuffles and depth <-> colour packing need compute.
+				const u32 convert_w = (static_cast<u32>(src_w) * src_bpp) / dst_bpp;
+				const auto src_convert = get_format_convert_flags(src->format());
+				const auto dst_convert = get_format_convert_flags(dst->format());
+				const bool needs_shuffle = (src_convert.first || dst_convert.first) &&
+					(src_convert.first != dst_convert.first || src_convert.second != dst_convert.second);
+				const bool colour = src->aspect() == aspect_color && dst->aspect() == aspect_color &&
+					!is_compressed_format(src->format()) && !is_compressed_format(dst->format());
+				const u32 row_bytes = static_cast<u32>(src_w) * src_bpp;
+
+				if (colour && !needs_shuffle && convert_w == section.dst_w && src_h == section.dst_h && (row_bytes % dst_bpp) == 0 &&
+					get_texel_size(src->format()) == src_bpp && get_texel_size(dst->format()) == dst_bpp &&
+					u32{src_x} + src_w <= src->width() && u32{src_y} + src_h <= src->height() &&
+					u32{section.dst_x} + convert_w <= level_w && u32{section.dst_y} + src_h <= level_h && src_w && src_h)
+				{
+					auto staging = allocate_staging(cmd, *m_upload_heap, static_cast<u64>(row_bytes) * src_h);
+					copy_texture_to_buffer(cmd.compute("typeless copy"), src->texture, 0, 0, { { src_x, src_y, 0 }, { src_w, src_h, 1 } },
+						staging.buffer, staging.offset, row_bytes, 0);
+					// The second copy reads what the first wrote: a new encoder (its queue barrier orders them).
+					cmd.end_encoder();
+					copy_buffer_to_texture(cmd.compute("typeless copy"), staging.buffer, staging.offset, row_bytes, 0,
+						{ convert_w, src_h, 1 }, dst->texture, dst_slice, level, { section.dst_x, section.dst_y, dst_z });
+					cmd.end_encoder();
+					counters.buffer_bitcasts++;
+					continue;
+				}
+
+				counters.typeless_not_implemented++;
+				log_once("copy-typeless", fmt::format("typeless copy %u (class %u) -> %u (class %u) needs a GPU byte shuffle or depth conversion: not implemented",
+					static_cast<u32>(src->format()), static_cast<u32>(src->format_class()), static_cast<u32>(dst->format()), static_cast<u32>(dst->format_class())));
+				continue;
+			}
+
+			if (src_w != section.dst_w || src_h != section.dst_h)
+			{
+				// VK copy_scaled_image (vkCmdBlitImage): needs a scaling pass on Metal.
+				counters.scaled_not_implemented++;
+				log_once("copy-scaled", "scaled region copy is not implemented");
+				continue;
+			}
+
+			u32 w = src_w, h = src_h;
+			clip(src_x, src_y, w, h, src->width(), src->height());
+			if (!w || !h)
+			{
+				continue;
+			}
+
+			if (is_compressed_format(src->format()) || is_compressed_format(dst->format()))
+			{
+				// Block-compressed copies must be block aligned (or reach the texture edge).
+				const bool aligned = src->format() == dst->format() && !(src_x % 4) && !(src_y % 4) && !(section.dst_x % 4) && !(section.dst_y % 4) &&
+					((w % 4) == 0 || src_x + w == src->width()) && ((h % 4) == 0 || src_y + h == src->height());
+				if (!aligned)
+				{
+					counters.typeless_not_implemented++;
+					log_once("copy-compressed", "unaligned block-compressed region copy is not implemented");
+					continue;
+				}
+			}
+
+			// Bit-compatible formats: copy from a view of the source in the destination's format (Metal copies
+			// between textures of one pixel format).
+			const object* source_texture = &src->texture;
+			if (src->format() != dst->format())
+			{
+				const auto raw = rsx::default_remap_vector.with_encoding(remap_identity_raw);
+				auto view = src->get_view(dst->format(), default_component_map, src->aspect(),
+					view_key(src->native_component_map, raw, src->aspect(), dst->format()));
+				if (!view)
+				{
+					counters.typeless_not_implemented++;
+					continue;
+				}
+				source_texture = &view->handle();
+				counters.typeless_copies++;
+			}
+
+			copy_texture(cmd.compute("texture copy"), *source_texture, 0, 0, { { src_x, src_y, 0 }, { w, h, 1 } },
+				dst->texture, dst_slice, level, { section.dst_x, section.dst_y, dst_z });
+			counters.copies++;
+		}
+
+		cmd.end_encoder();
+	}
+
+	image_view* texture_cache::create_temporary_subresource_view_impl(command_context& cmd, mtl::image* source, texture_type type,
+		u32 gcm_format, u16 w, u16 h, u16 d, u8 mips, const rsx::texture_channel_remap_t& remap_vector, const copy_region_descriptor* copy)
+	{
+		auto image = create_image(cmd, gcm_format, type, w, h, d, mips);
+		if (!image)
+		{
+			// OOM, bail
+			return nullptr;
+		}
+
+		// This method is almost exclusively used to work on framebuffer resources. Keep the original swizzle layout
+		// unless there is data format conversion.
+		component_map swizzle = default_component_map;
+		if (!source || image->format() != source->format())
+		{
+			// A data cast: the native mapping of the new type.
+			argb_map remap{};
+			if (get_component_mapping(gcm_format, remap))
+			{
+				swizzle = { remap[1], remap[2], remap[3], remap[0] };
+			}
+		}
+		else
+		{
+			swizzle = source->native_component_map;
+		}
+
+		image->set_name(fmt::format("Temp view, fmt=0x%x", gcm_format));
+		image->set_native_component_layout(swizzle);
+
+		if (copy)
+		{
+			// A copy that does not replace every texel, or that is not implemented, must not leave stale memory.
+			const bool covers = copy->dst_x == 0 && copy->dst_y == 0 && copy->dst_w == image->width() && copy->dst_h == image->height() &&
+				image->mipmaps() == 1 && image->layers() == 1;
+			const auto before = get_texture_counters().copies.load() + get_texture_counters().buffer_bitcasts.load();
+			if (!covers)
+			{
+				clear_image(cmd, *m_upload_heap, image.get());
+			}
+
+			rsx::simple_array<copy_region_descriptor> region = { *copy };
+			copy_transfer_regions_impl(cmd, image.get(), region);
+
+			if (covers && before == get_texture_counters().copies.load() + get_texture_counters().buffer_bitcasts.load())
+			{
+				// Nothing was copied (counted where it was refused): zeros rather than uninitialised memory.
+				clear_image(cmd, *m_upload_heap, image.get());
+			}
+		}
+
+		auto view = image->get_view(remap_vector);
+		if (!view)
+		{
+			return nullptr;
+		}
+
+		// Owned through the view until release_temporary_subresource.
+		image.release();
+		return view;
+	}
+
+	image_view* texture_cache::create_temporary_subresource_view(command_context& cmd, const deferred_subresource& desc)
+	{
+		ensure(desc.sections_to_copy.size() == 1);
+		const auto& section = desc.sections_to_copy.front();
+		return create_temporary_subresource_view_impl(cmd, section.src, texture_type::type_2d,
+			desc.gcm_format, desc.width, desc.height, 1, 1, desc.remap, &section);
+	}
+
+	image_view* texture_cache::generate_gather(command_context& cmd, const deferred_subresource& desc, texture_type type, u16 depth_, u8 mips,
+		rsx::texture_dimension_extended memory_type)
+	{
+		auto _template = get_template_from_collection_impl(desc.sections_to_copy);
+		auto result = create_temporary_subresource_view_impl(cmd, _template, type, desc.gcm_format, desc.width, desc.height, depth_, mips, desc.remap);
+		if (!result)
+		{
+			// Failed to create temporary object, bail
+			return nullptr;
+		}
+
+		auto image = result->image();
+		if (desc.force_bg_load)
+		{
+			// The memory load covers the whole image, no need to clear it first
+			initialize_subresource_from_memory(cmd, image, desc, memory_type);
+		}
+		else
+		{
+			// VK skips the clear when the copies are proven to cover every texel; a copy refused here (counted)
+			// would then leave the pool image's previous contents, so the image is always cleared.
+			clear_image(cmd, *m_upload_heap, image);
+		}
+
+		copy_transfer_regions_impl(cmd, image, desc.sections_to_copy);
+		return result;
+	}
+
+	image_view* texture_cache::generate_cubemap_from_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		return generate_gather(cmd, desc, texture_type::type_cube, 1, desc.exact_mip_count(), rsx::texture_dimension_extended::texture_dimension_cubemap);
+	}
+
+	image_view* texture_cache::generate_3d_from_2d_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		return generate_gather(cmd, desc, texture_type::type_3d, desc.depth, desc.exact_mip_count(), rsx::texture_dimension_extended::texture_dimension_3d);
+	}
+
+	image_view* texture_cache::generate_atlas_from_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		return generate_gather(cmd, desc, texture_type::type_2d, 1, 1, rsx::texture_dimension_extended::texture_dimension_2d);
+	}
+
+	image_view* texture_cache::generate_2d_mipmaps_from_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		const auto mipmaps = ::narrow<u8>(desc.sections_to_copy.size());
+		return generate_gather(cmd, desc, texture_type::type_2d, 1, mipmaps, rsx::texture_dimension_extended::texture_dimension_2d);
+	}
+
+	void texture_cache::release_temporary_subresource(image_view* view)
+	{
+		// ~image hands the texture and its views to the deferred release.
+		std::unique_ptr<mtl::image> image(ensure(view->image()));
+	}
+
+	void texture_cache::initialize_subresource_from_memory(command_context& cmd, mtl::image* dst, const deferred_subresource& desc, rsx::texture_dimension_extended type) const
+	{
+		auto subresources_layout = rsx::get_subresources_layout(desc, type);
+		std::erase_if(subresources_layout, [mipmaps = dst->mipmaps()](const rsx::subresource_layout& layout)
+		{
+			return layout.level >= mipmaps;
+		});
+		upload_image(cmd, *m_upload_heap, dst, subresources_layout, desc.gcm_format, desc.swizzled, m_supports_bc);
+	}
+
+	void texture_cache::update_image_contents(command_context& cmd, image_view* dst_view, const deferred_subresource& desc)
+	{
+		copy_transfer_regions_impl(cmd, dst_view->image(), desc.sections_to_copy);
+	}
+
+	cached_texture_section* texture_cache::create_new_texture(command_context& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch,
+		u32 gcm_format, rsx::texture_upload_context context, rsx::texture_dimension_extended type, bool swizzled, rsx::component_order swizzle_flags, rsx::flags32_t flags)
+	{
+		const auto section_depth = depth;
+
+		texture_type image_type = texture_type::type_2d;
+		switch (type)
+		{
+		case rsx::texture_dimension_extended::texture_dimension_1d:
+			// Sampled as a 2D texture of height 1 (the translator's texture_1D_as_2D).
+			image_type = texture_type::type_2d;
+			height = 1;
+			depth = 1;
+			break;
+		case rsx::texture_dimension_extended::texture_dimension_2d:
+			image_type = texture_type::type_2d;
+			depth = 1;
+			break;
+		case rsx::texture_dimension_extended::texture_dimension_cubemap:
+			image_type = texture_type::type_cube;
+			depth = 1;
+			break;
+		case rsx::texture_dimension_extended::texture_dimension_3d:
+			image_type = texture_type::type_3d;
+			break;
+		default:
+			fmt::throw_exception("Unreachable");
+		}
+
+		// Check what actually exists at that address
+		const rsx::image_section_attributes_t search_desc = { .gcm_format = gcm_format, .width = width, .height = height, .depth = section_depth, .mipmaps = mipmaps };
+		const bool allow_dirty = (context != rsx::texture_upload_context::framebuffer_storage);
+		cached_texture_section& region = *find_cached_texture(rsx_range, search_desc, true, true, allow_dirty);
+		ensure(!region.is_locked());
+
+		mtl::image* image = nullptr;
+		if (region.exists())
+		{
+			image = region.get_raw_texture();
+			if (!image || region.get_image_type() != type || image->depth() != depth)
+			{
+				// Incompatible view/type
+				region.destroy();
+				image = nullptr;
+			}
+			else
+			{
+				ensure(region.is_managed());
+
+				// Reuse
+				region.set_rsx_pitch(pitch);
+
+				if (flags & texture_create_flags::initialize_image_contents)
+				{
+					// VK wipes colour to (0, 0, 0, 1); this clears colour to zero. Unreachable without the blit
+					// engine (stage M3.2), which is the only user of the flag.
+					clear_image(cmd, *m_upload_heap, image);
+				}
+			}
+		}
+
+		if (!image)
+		{
+			auto created = create_image(cmd, gcm_format, image_type, width, height, depth, static_cast<u8>(std::min<u16>(mipmaps, 255)));
+			image = ensure(created.release(), "Metal: texture cache image allocation failed");
+
+			// New section, we must prepare it
+			region.reset(rsx_range);
+			region.set_gcm_format(gcm_format);
+			region.set_image_type(type);
+			region.create(width, height, section_depth, mipmaps, image, pitch, true, gcm_format);
+		}
+
+		region.set_view_flags(swizzle_flags);
+		region.set_context(context);
+		region.set_swizzled(swizzled);
+		region.set_dirty(false);
+
+		image->set_native_component_layout(apply_component_mapping_flags(gcm_format, swizzle_flags, rsx::default_remap_vector));
+
+		// Its not necessary to lock blit dst textures as they are just reused as necessary
+		switch (context)
+		{
+		case rsx::texture_upload_context::shader_read:
+		case rsx::texture_upload_context::blit_engine_src:
+			region.protect(utils::protection::ro);
+			read_only_range = region.get_min_max(read_only_range, rsx::section_bounds::locked_range);
+			break;
+		case rsx::texture_upload_context::blit_engine_dst:
+			region.set_unpack_swap_bytes(true);
+			no_access_range = region.get_min_max(no_access_range, rsx::section_bounds::locked_range);
+			break;
+		case rsx::texture_upload_context::dma:
+		case rsx::texture_upload_context::framebuffer_storage:
+		default:
+			fmt::throw_exception("Unexpected upload context 0x%x", u32(context));
+		}
+
+		update_cache_tag();
+		return &region;
+	}
+
+	cached_texture_section* texture_cache::create_nul_section(command_context& /*cmd*/, const utils::address_range32& rsx_range, const rsx::image_section_attributes_t& attrs,
+		const rsx::GCM_tile_reference& /*tile*/, bool /*memory_load*/)
+	{
+		auto& region = *find_cached_texture(rsx_range, { .gcm_format = RSX_GCM_FORMAT_IGNORED }, true, false, false);
+		ensure(!region.is_locked());
+
+		// Prepare section
+		region.reset(rsx_range);
+		region.create_dma_only(attrs.width, attrs.height, attrs.pitch);
+		region.set_dirty(false);
+		region.set_unpack_swap_bytes(true);
+
+		no_access_range = region.get_min_max(no_access_range, rsx::section_bounds::locked_range);
+		update_cache_tag();
+		return &region;
+	}
+
+	cached_texture_section* texture_cache::upload_image_from_cpu(command_context& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch, u32 gcm_format,
+		rsx::texture_upload_context context, const std::vector<rsx::subresource_layout>& subresource_layout, rsx::texture_dimension_extended type, bool swizzled)
+	{
+		auto section = create_new_texture(cmd, rsx_range, width, height, depth, mipmaps, pitch, gcm_format, context, type, swizzled,
+			rsx::component_order::default_, 0);
+
+		auto image = section->get_raw_texture();
+		image->set_name(fmt::format("Raw Texture @0x%x", rsx_range.start));
+
+		bool input_swizzled = swizzled;
+		if (context == rsx::texture_upload_context::blit_engine_src)
+		{
+			// Swizzling is ignored for blit engine copy and emulated using remapping
+			input_swizzled = false;
+
+			if (rsx::get_current_renderer()->get_tiled_memory_region(rsx_range))
+			{
+				// VK detiles blit sources on the GPU first (stage M3.2 with the blit engine).
+				get_texture_counters().typeless_not_implemented++;
+				log_once("upload-tiled-blit", "tiled blit-engine source upload is not detiled yet");
+			}
+		}
+
+		upload_image(cmd, *m_upload_heap, image, subresource_layout, gcm_format, input_swizzled, m_supports_bc);
+
+		section->last_write_tag = rsx::get_shared_tag();
+		return section;
+	}
+
+	void texture_cache::set_component_order(cached_texture_section& section, u32 gcm_format, rsx::component_order expected_flags)
+	{
+		if (expected_flags == section.get_view_flags())
+		{
+			return;
+		}
+
+		const component_map mapping = apply_component_mapping_flags(gcm_format, expected_flags, rsx::default_remap_vector);
+		auto image = section.get_raw_texture();
+
+		ensure(image);
+#ifdef RPCS3_IOS
+		section.ios_memo_changed(); // REWINDBOX_TEXTURE_LOOKUP_MEMO_660: the section's views are disposed
+#endif
+		image->set_native_component_layout(mapping);
+
+		section.set_view_flags(expected_flags);
+	}
+
+	void texture_cache::insert_texture_barrier(command_context& /*cmd*/, mtl::image* /*tex*/, bool /*strong_ordering*/)
+	{
+		// A render target sampled while bound (a cyclic reference) is never read in place on Metal: before the draw,
+		// MTLGSRender::prepare_texture_bindings copies every bound attachment that a unit samples (after the pass
+		// that wrote it has ended) and binds the copy. That is the barrier: the copy sees every earlier write.
+	}
+
+	bool texture_cache::render_target_format_is_compatible(mtl::image* tex, u32 gcm_format)
+	{
+		if (mtl::render_target_format_is_compatible(tex->format(), gcm_format))
+		{
+			return true;
+		}
+
+		switch (gcm_format)
+		{
+		case CELL_GCM_TEXTURE_R5G6B5:
+		case CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT:
+		case CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT:
+		case CELL_GCM_TEXTURE_X32_FLOAT:
+		case CELL_GCM_TEXTURE_A8R8G8B8:
+		case CELL_GCM_TEXTURE_D8R8G8B8:
+		case CELL_GCM_TEXTURE_B8:
+		case CELL_GCM_TEXTURE_G8B8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT:
+		case CELL_GCM_TEXTURE_X16:
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT:
+			return false;
+		default:
+			warn_once("Format incompatibility detected, reporting failure to force data copy (MTL_FORMAT=0x%X, GCM_FORMAT=0x%X)", static_cast<u32>(tex->format()), gcm_format);
+			return false;
+		}
+	}
+
+	void texture_cache::prepare_for_dma_transfers(command_context& cmd)
+	{
+		ensure(cmd.recording());
+	}
+
+	void texture_cache::cleanup_after_dma_transfers(command_context& cmd)
+	{
+		// The batch of hard-fault copies: submit and wait (VK submits its command buffer and waits on its fence).
+		cmd.submit_and_wait();
+	}
+
+	bool texture_cache::is_depth_texture(u32 rsx_address, u32 rsx_size)
+	{
+		reader_lock lock(m_cache_mutex);
+
+		auto& block = m_storage.block_for(rsx_address);
+		if (block.get_locked_count() == 0)
+		{
+			return false;
+		}
+
+		for (auto& tex : block)
+		{
+			if (tex.is_dirty())
+			{
+				continue;
+			}
+
+			if (!tex.overlaps(rsx_address, rsx::section_bounds::full_range))
+			{
+				continue;
+			}
+
+			if ((rsx_address + rsx_size - tex.get_section_base()) <= tex.get_section_size())
+			{
+				return is_depth_format(tex.get_format());
+			}
+		}
+
+		return false;
+	}
+
+	void texture_cache::on_frame_end()
+	{
+		trim_sections();
+
+		if (m_storage.m_unreleased_texture_objects >= m_max_zombie_objects)
+		{
+			purge_unreleased_sections();
+		}
+
+		baseclass::on_frame_end();
+	}
+}
