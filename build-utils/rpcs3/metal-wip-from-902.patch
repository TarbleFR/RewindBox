diff --git a/rpcs3/Emu/RSX/Metal/MTLComputeTasks.cpp b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.cpp
new file mode 100644
index 0000000..ad5fde4
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.cpp
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): conversion compute tasks of the native Metal 4 renderer (VKCompute.cpp).
+
+#include "stdafx.h"
+#include "MTLComputeTasks.h"
+
+#include "MTLCommandContext.h"
+#include "MTLM4Counters.h"
+#include "MTLM4Shaders.h"
+
+
+namespace mtl
+{
+	namespace
+	{
+		compute_tasks* g_compute_tasks = nullptr;
+
+		void log_failure(m4_failure kind, std::string_view what)
+		{
+			if (m4_first_failure(kind))
+			{
+				rsx_log.error("Metal M4: %s (counted in COREPROF METAL M4; logged once)", what);
+			}
+		}
+	}
+
+	void set_compute_tasks(compute_tasks* tasks)
+	{
+		g_compute_tasks = tasks;
+	}
+
+	compute_tasks* get_compute_tasks()
+	{
+		return g_compute_tasks;
+	}
+
+	bool compute_tasks::create(const object& device, const object& compiler, param_writer writer, std::string& error)
+	{
+		m_device = device;
+		m_compiler = compiler;
+		m_writer = std::move(writer);
+
+		// Safe math: the depth conversions divide and multiply exactly as written.
+		m_library = compile_library(compiler, m4_shaders::compute_library_source(), library_options{}, error);
+		if (!m_library)
+		{
+			log_failure(m4_failure::compute_library, fmt::format("conversion kernels do not compile: %s", error));
+			return false;
+		}
+
+		m_table = new_argument_table(device, 2, 1, 1);  // two buffers (a texture and a sampler entry so that no count is 0)
+		if (!m_table)
+		{
+			error = "conversion kernels argument table";
+			m_library.reset();
+			return false;
+		}
+
+		return true;
+	}
+
+	void compute_tasks::destroy()
+	{
+		m_pipelines = {};
+		m_pipeline_failed = {};
+		m_table.reset();
+		m_library.reset();
+		m_compiler.reset();
+		m_device.reset();
+		m_writer = nullptr;
+	}
+
+	const object& compute_tasks::get_pipeline(compute_kernel kernel)
+	{
+		const usz index = static_cast<usz>(kernel);
+		auto& pipeline = m_pipelines[index];
+		if (!pipeline && !m_pipeline_failed[index] && m_library)
+		{
+			const std::string_view name = m4_shaders::compute_kernel_names[index];
+			std::string error;
+			pipeline = new_compute_pipeline(m_compiler, m_library, name, name, error);
+			if (!pipeline)
+			{
+				m_pipeline_failed[index] = true;
+				log_failure(m4_failure::compute_pipeline, fmt::format("compute pipeline %s: %s", name, error));
+			}
+		}
+		return pipeline;
+	}
+
+	bool compute_tasks::dispatch(command_context& ctx, compute_kernel kernel, const object& data, u64 data_offset, const std::array<u32, 4>& params, u32 workgroups)
+	{
+		const object& pipeline = get_pipeline(kernel);
+		if (!pipeline || !data || !m_writer || (data_offset % 4) != 0)
+		{
+			m4_count(get_m4_counters().compute_failures);
+			return false;
+		}
+
+		if (!workgroups)
+		{
+			return true;
+		}
+
+		// Parameters first: the writer may submit to make room, which must not happen with the encoder open.
+		const auto [param_buffer, param_offset] = m_writer(params.data(), static_cast<u32>(sizeof(params)));
+		if (!param_buffer)
+		{
+			m4_count(get_m4_counters().compute_failures);
+			return false;
+		}
+
+		// The Vulkan dispatch covers workgroups * 256 invocations; a smaller pipeline limit only regroups them.
+		const u32 invocations = workgroups * compute_optimal_group_size;
+		const u32 limit = query_compute_pipeline(pipeline).max_threads_per_threadgroup;
+		const dispatch_size size = get_dispatch_size(invocations, std::min(compute_optimal_group_size, std::max(limit, 1u)));
+
+		// A fresh encoder: commands of one Metal 4 encoder may overlap, the queue barrier of a new one orders this task
+		// after everything encoded before it; ending it orders what follows after the task.
+		ctx.end_encoder();
+		const object& encoder = ctx.compute("RSX conversion");
+		set_compute_pipeline(encoder, pipeline);
+		table_set_buffer(m_table, data, data_offset, 0);
+		table_set_buffer(m_table, param_buffer, param_offset, 1);
+		set_compute_argument_table(encoder, m_table);
+		dispatch_threadgroups(encoder, size.groups, size.threads);
+		ctx.end_encoder();
+
+		m4_count(get_m4_counters().compute_dispatches);
+		return true;
+	}
+
+	bool compute_tasks::run_shuffle(command_context& ctx, compute_kernel kernel, const object& data, u32 data_length, u32 data_offset)
+	{
+		ensure(get_kernel_family(kernel) == compute_kernel_family::shuffle);
+		return dispatch(ctx, kernel, data, data_offset, shuffle_params(data_length), compute_shuffle_workgroups(data_length));
+	}
+
+	bool compute_tasks::run_interleave(command_context& ctx, compute_kernel kernel, const object& data, u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset)
+	{
+		ensure(get_kernel_family(kernel) == compute_kernel_family::interleave);
+		ensure(stencil_offset > data_offset);
+
+		u32 bound_offset = 0;
+		const auto params = interleave_params(data_offset, data_length, zeta_offset, stencil_offset, bound_offset);
+		return dispatch(ctx, kernel, data, bound_offset, params, compute_shuffle_workgroups(data_length));
+	}
+
+	bool compute_tasks::run_fconvert(command_context& ctx, compute_kernel kernel, const object& data, u32 src_offset, u32 src_length, u32 dst_offset)
+	{
+		ensure(get_kernel_family(kernel) == compute_kernel_family::fconvert);
+
+		u32 bound_offset = 0;
+		const auto params = fconvert_params(kernel, src_offset, src_length, dst_offset, bound_offset);
+		return dispatch(ctx, kernel, data, bound_offset, params, compute_shuffle_workgroups(src_length));
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h
new file mode 100644
index 0000000..3736bdd
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the conversion compute tasks of the surface and texture paths (VKCompute.h / .cpp):
+// byte swaps, D24S8 <-> F32 depth conversions, depth-stencil gather/scatter (interleave) and the e4m12 float
+// conversions, as Metal compute kernels compiled at runtime from MSL (MTLM4Shaders.h) by the MTL4 compiler.
+//
+// Each run() takes the Vulkan task's run() arguments and dispatches over the same words with the same arithmetic
+// (MTLM4Math.h, shared with the host unit test). Accesses stay inside the bound range, as Vulkan's robust buffer access
+// keeps them. Each task is its own compute encoder: the next encoder of the command context waits for it, so a task's
+// results are visible to whatever is encoded after it, and it sees everything encoded before.
+// The caller keeps the data buffer resident and alive until the work completes (command_context::dispose).
+// Not ported (no caller in this renderer yet): the GPU deswizzle (GPUDeswizzle.glsl), the RSX tile codec
+// (RSXMemoryTiling.glsl) and the conditional-render aggregator (no hardware conditional rendering on Metal).
+
+#include "MTLAPI.h"
+
+#include <array>
+#include <functional>
+#include <string>
+#include <utility>
+
+namespace mtl
+{
+	class command_context;
+
+	enum class compute_kernel : u32
+	{
+		// cs_shuffle_*: value = data[index]; data[index] = f(value)
+		bswap_u16,                // cs_shuffle_16
+		bswap_u32,                // cs_shuffle_32
+		bswap_u16_u32,            // cs_shuffle_32_16
+		d24x8_to_f32,             // cs_shuffle_d24x8_f32
+		f32_to_d24x8_swapped,     // cs_shuffle_se_f32_d24x8
+		d24x8_to_d24x8_swapped,   // cs_shuffle_se_d24x8
+
+		// cs_interleave_task family
