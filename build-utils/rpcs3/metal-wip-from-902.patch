+	constexpr u32 compute_optimal_group_size = 256;
+	constexpr u32 compute_optimal_kernel_size = 1;
+
+	constexpr u32 compute_aligned_div(u32 value, u32 alignment)
+	{
+		return static_cast<u32>((static_cast<u64>(value) + alignment - 1) / alignment);
+	}
+
+	// cs_shuffle_base::run: the work groups covering `data_length` bytes, one word per invocation.
+	constexpr u32 compute_shuffle_workgroups(u32 data_length)
