+mtl::image_view* MTLGSRender::snapshot_if_attachment(mtl::image_view* view)
+{
+	// Same-pass feedback: a unit samples an attachment of the pass this draw renders into. Apple GPUs keep the
+	// attachment in tile memory during the pass, so the texture memory is stale until the pass stores it. The pass
+	// is ended (stored), the attachment is copied after a queue barrier, and the unit samples the copy: it sees
+	// every write made before this draw, which is what the RSX texture barrier guarantees.
+	mtl::image* source = view->image();
