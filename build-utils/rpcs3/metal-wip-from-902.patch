+		compute_pipeline_info info{};
+		if (state)
+		{
+			info.max_threads_per_threadgroup = static_cast<u32>(state.maxTotalThreadsPerThreadgroup);
+			info.thread_execution_width = static_cast<u32>(state.threadExecutionWidth);
+		}
+		return info;
+	}
