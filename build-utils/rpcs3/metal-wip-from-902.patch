+		{
+			if (m4_first_failure(kind))
+			{
+				rsx_log.error("Metal M4: %s (counted in COREPROF METAL M4; logged once)", what);
+			}
+		}
+	}
+
+	void set_msaa_resolver(msaa_resolver* resolver)
+	{
+		g_resolver = resolver;
+	}
+
+	msaa_resolver* get_msaa_resolver()
+	{
+		return g_resolver;
+	}
+
+	bool msaa_resolver::create(command_context& ctx, const object& compiler, std::string& error)
+	{
+		const object& device = ctx.device();
+		m_device = device;
+		m_compiler = compiler;
+		m_pipelines.init(compiler);
+
+		// The resolve passes are exact copies of samples: safe math (no arithmetic on the values anyway).
+		m_library = compile_library(compiler, m4_shaders::resolve_library_source(), library_options{}, error);
+		if (!m_library)
+		{
+			return false;
+		}
+
+		m_table = new_argument_table(device, 1, 2, 1);  // a sampler entry so that no count is 0
+
+		depth_stencil_descriptor depth{};
+		depth.depth_compare = compare_function::always;
+		depth.depth_write = true;
+		m_depth_state = new_depth_stencil_state(device, depth);
+
+		// VK depthstencil_(un)resolve_EXT: always pass, replace on every outcome, all bits written; the reference is the
+		// fragment's stencil export.
+		depth.stencil = true;
+		depth.front.compare = compare_function::always;
+		depth.front.stencil_fail = stencil_operation::replace;
+		depth.front.depth_fail = stencil_operation::replace;
+		depth.front.depth_stencil_pass = stencil_operation::replace;
+		depth.front.read_mask = 0xff;
+		depth.front.write_mask = 0xff;
+		depth.back = depth.front;
+		m_depth_stencil_state = new_depth_stencil_state(device, depth);
+
+		for (const u32 samples : { 2u, 4u })
+		{
+			const auto grid = msaa::grid_for(samples);
+			m_params[samples] = new_buffer(device, sizeof(resolve_params), storage_mode::shared);
+			if (!m_params[samples])
+			{
+				break;
+			}
+
+			const resolve_params params{ { static_cast<s32>(grid.x), static_cast<s32>(grid.y) }, 0, 0 };
+			std::memcpy(buffer_contents(m_params[samples]), &params, sizeof(params));
+			ctx.make_resident(m_params[samples]);
+		}
+
+		if (!m_table || !m_depth_state || !m_depth_stencil_state || !m_params[2] || !m_params[4])
+		{
+			error = "resolve argument table, depth-stencil states or parameters";
+			m_library.reset();
+			return false;
+		}
+
+		return true;
+	}
+
+	void msaa_resolver::destroy(command_context& ctx)
+	{
+		m_pipelines.clear();
+		for (auto& params : m_params)
+		{
+			ctx.dispose(std::move(params), true);
+		}
+		m_depth_state.reset();
+		m_depth_stencil_state.reset();
+		m_table.reset();
+		m_library.reset();
+		m_compiler.reset();
+		m_device.reset();
+	}
+
+	const object& msaa_resolver::get_pipeline(pass kind, pixel_format format, u32 samples)
+	{
+		const u64 key = (static_cast<u64>(kind) << 40) | (static_cast<u64>(format) << 8) | samples;
+		const auto describe = [&](render_pipeline_descriptor& desc)
+		{
+			desc.library = m_library;
+			desc.vertex_function = "m4_resolve_vertex";
+			switch (kind)
+			{
+			case pass::color_resolve: desc.fragment_function = "m4_color_resolve"; break;
+			case pass::color_unresolve: desc.fragment_function = "m4_color_unresolve"; break;
+			case pass::depth_resolve: desc.fragment_function = "m4_depth_resolve"; break;
+			case pass::depth_unresolve: desc.fragment_function = "m4_depth_unresolve"; break;
+			case pass::depth_stencil_resolve: desc.fragment_function = "m4_depth_stencil_resolve"; break;
+			case pass::depth_stencil_unresolve: desc.fragment_function = "m4_depth_stencil_unresolve"; break;
+			}
+
+			if (kind == pass::color_resolve || kind == pass::color_unresolve)
+			{
+				desc.color[0].format = format;
+				desc.color[0].write_mask = write_all;
+			}
+
+			desc.sample_count = samples;
+			desc.label = fmt::format("MSAA %s", desc.fragment_function);
+		};
+
+		return m_pipelines.get(key, describe, [&](const render_pipeline_descriptor& desc, const std::string& error)
+		{
+			log_failure(m4_failure::resolve_pipeline, fmt::format("%s pipeline for format %u x%u: %s", desc.fragment_function,
+				static_cast<u32>(format), samples, error));
+		});
+	}
+
+	bool msaa_resolver::run(command_context& ctx, render_target& surface, bool unresolve)
+	{
+		const u32 samples = surface.samples();
+		image* const resolved = surface.resolve_surface.get();
+		if (samples <= 1 || !msaa::grid_for(samples).x || !m_params[samples] || !surface.texture || !resolved || !resolved->texture)
+		{
+			return false;
+		}
+
+		const bool depth = surface.is_depth_surface();
+		const bool stencil = depth && has_stencil(surface.native_format);
+
+		pass kind = unresolve ? pass::color_unresolve : pass::color_resolve;
+		if (stencil)
+		{
+			kind = unresolve ? pass::depth_stencil_unresolve : pass::depth_stencil_resolve;
+		}
+		else if (depth)
+		{
+			kind = unresolve ? pass::depth_unresolve : pass::depth_resolve;
+		}
+
+		const object& pipeline = get_pipeline(kind, surface.native_format, unresolve ? samples : 1);
+		if (!pipeline)
+		{
+			return false;
+		}
+
+		// The stencil plane is read through the images' X32_Stencil8 views (Depth32Float_Stencil8 is the only stencil
+		// format here).
+		image_view* stencil_source = nullptr;
+		if (stencil)
+		{
+			if (surface.native_format != pixel_format::depth32_float_stencil8)
+			{
+				return false;
+			}
+
+			stencil_source = unresolve ? resolved->get_view(rsx::default_remap_vector, aspect_stencil)
+				: surface.get_view(rsx::default_remap_vector, aspect_stencil);
+			if (!stencil_source)
+			{
+				return false;
+			}
+		}
+
+		const object& target = unresolve ? surface.texture : resolved->texture;
+		const object& source = unresolve ? resolved->texture : surface.texture;
+		const u32 width = unresolve ? surface.width() : surface.resolve_width();
+		const u32 height = unresolve ? surface.height() : surface.resolve_height();
+
+		// Every texel (resolve) or every sample (unresolve) of the target is written: its previous contents are not loaded.
+		render_pass_descriptor pass_desc{};
+		if (!depth)
+		{
+			pass_desc.color[0].texture = target;
+			pass_desc.color[0].load = load_action::dont_care;
+			pass_desc.color[0].store = store_action::store;
+		}
+		else
+		{
+			pass_desc.depth.texture = target;
+			pass_desc.depth.load = load_action::dont_care;
+			pass_desc.depth.store = store_action::store;
+			if (stencil)
+			{
+				pass_desc.stencil.texture = target;
+				pass_desc.stencil.load = load_action::dont_care;
+				pass_desc.stencil.store = store_action::store;
+			}
+		}
+		pass_desc.render_target_width = width;
+		pass_desc.render_target_height = height;
+
+		table_set_buffer(m_table, m_params[samples], 0, 0);
+		table_set_texture(m_table, source, 0);
+		if (stencil_source)
+		{
+			table_set_texture(m_table, stencil_source->handle(), 1);
+		}
+
+		const object* depth_stencil = depth ? (stencil ? &m_depth_stencil_state : &m_depth_state) : nullptr;
+		draw_transfer_quad(ctx, pass_desc, unresolve ? "MSAA unresolve" : "MSAA resolve", pipeline, depth_stencil, m_table, stage_fragment,
+			0, 0, width, height);
+		m4_count(unresolve ? get_m4_counters().unresolves : get_m4_counters().resolves);
+		return true;
+	}
+
+	bool msaa_resolver::resolve(command_context& ctx, render_target& surface)
+	{
+		return run(ctx, surface, false);
+	}
+
+	bool msaa_resolver::unresolve(command_context& ctx, render_target& surface)
+	{
+		return run(ctx, surface, true);
+	}
+
+	// render_target (MTLRenderTargets.h, M4 block)
+
+	image* render_target::get_resolve_target_safe(command_context& ctx)
+	{
+		if (!resolve_surface)
+		{
+			// VK render_target::get_resolve_target_safe: one sample, the samples side by side, same format, class and
+			// component layout. Pixel format views as every surface (the texture cache samples it through views).
+			texture_descriptor desc{};
+			desc.type = texture_type::type_2d;
+			desc.format = native_format;
+			desc.width = std::max(resolve_width(), 1u);
+			desc.height = std::max(resolve_height(), 1u);
+			desc.usage = usage_render_target | usage_shader_read | usage_pixel_format_view;
+			desc.storage = storage_mode::private_;
+
+			auto created = std::make_unique<image>();
+			if (!created->create(ctx, desc, format_class()))
+			{
+				m4_count(get_m4_counters().msaa_allocation_failures);
+				log_failure(m4_failure::msaa_allocation, fmt::format("MSAA resolve image allocation failed (%ux%u, format %u)",
+					desc.width, desc.height, static_cast<u32>(native_format)));
+				return nullptr;
+			}
+
+			created->set_native_component_layout(native_component_map);
+			created->set_name("MSAA resolve");
+			resolve_surface = std::move(created);
+		}
+
+		return resolve_surface.get();
+	}
+
+	void render_target::resolve(command_context& ctx)
+	{
+		// VK render_target::resolve. A pass that cannot run is counted and leaves the resolve texture marked stale.
+		auto* resolver = get_msaa_resolver();
+		if (resolver && get_resolve_target_safe(ctx) && resolver->resolve(ctx, *this))
+		{
+			msaa_flags &= ~(rsx::surface_state_flags::require_resolve);
+			return;
+		}
+
+		m4_count(get_m4_counters().resolve_failures);
+	}
+
+	void render_target::unresolve(command_context& ctx)
+	{
+		// VK render_target::unresolve (the resolve texture holds the newer data).
+		auto* resolver = get_msaa_resolver();
+		if (resolver && resolve_surface && resolver->unresolve(ctx, *this))
+		{
+			msaa_flags &= ~(rsx::surface_state_flags::require_unresolve);
+			return;
+		}
+
+		m4_count(get_m4_counters().resolve_failures);
+	}
+
+	void render_target::clear_resolve_memory(command_context& ctx)
+	{
+		// VK clear_memory(cmd, get_resolve_target_safe(cmd)): colour (0, 0, 0, 1), depth 1.0, stencil 255.
+		image* const resolved = get_resolve_target_safe(ctx);
+		if (!resolved)
+		{
+			return;
+		}
+		const object& target = resolved->texture;
+
+		render_pass_descriptor pass{};
+		pass.render_target_width = resolve_width();
+		pass.render_target_height = resolve_height();
+
+		if (is_depth_surface())
+		{
+			pass.depth.texture = target;
+			pass.depth.load = load_action::clear;
+			pass.depth.store = store_action::store;
+			pass.depth.clear_depth = 1.0;
+
+			if (has_stencil(native_format))
+			{
+				pass.stencil.texture = target;
+				pass.stencil.load = load_action::clear;
+				pass.stencil.store = store_action::store;
+				pass.stencil.clear_stencil = 255;
+			}
+		}
+		else
+		{
+			pass.color[0].texture = target;
+			pass.color[0].load = load_action::clear;
+			pass.color[0].store = store_action::store;
+			pass.color[0].clear = { 0., 0., 0., 1. };
+		}
+
+		ctx.begin_render(pass, 0, "surface resolve clear");
+		ctx.end_encoder();
+	}
+
+	const object& render_target::texture_for(rsx::surface_access access) const
+	{
+		// VK render_target::get_surface: transfers of a multisampled surface use its resolve texture, after the barrier
+		// that resolves it (memory_barrier(transfer_read)) or before the one that unresolves it (shader_write). None when
+		// that resolve failed (counted), as get_surface().
+		static const object no_texture{};
+		if (sample_count == 1 || !access.is_transfer())
+		{
+			return texture;
+		}
+
+		return (resolve_surface && !(msaa_flags & rsx::surface_state_flags::require_resolve)) ? resolve_surface->texture : no_texture;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLResolve.h b/rpcs3/Emu/RSX/Metal/MTLResolve.h
new file mode 100644
index 0000000..4d35ec4
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLResolve.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): MSAA surfaces of the native Metal 4 renderer, with the Vulkan renderer's semantics.
+//
+// At the "Auto" MSAA level a surface has the sample count of its RSX AA mode (VKRenderTargets.h create_new_surface) and
+// is a 2D multisample texture. Its resolve texture holds the same samples side by side (samples_x * width by samples_y *
+// height, single-sampled), the layout of the surface in guest memory; transfers and the presentation read it, and the
+// surface store's copies write it (VK render_target::get_surface). Rendering marks the resolve texture stale
+// (require_resolve); a transfer read resolves first; a write of the resolve texture marks the multisampled texture stale
+// (require_unresolve), unresolved before the next draw (VK render_target::memory_barrier).
+//
+// The passes are VKResolveHelper's, as Metal render passes (Metal has no writable multisampled storage textures):
+// colour, depth, and depth with stencil (stencil export, the Vulkan renderer's _EXT passes), the coordinate math of
+// Program/MSAA (MTLM4Math.h resolve_math), on the pipeline cache and quad draw of the blit engine's scaled copies
+// (MTLTransferPass.h). A pass whose pipeline cannot be built is counted and not executed.
+
+#include "MTLAPI.h"
+#include "MTLM4Math.h"
+#include "MTLTransferPass.h"
+
+#include <array>
+#include <string>
+
+namespace mtl
+{
+	class command_context;
+	class render_target;
+
+	class msaa_resolver
+	{
+	public:
+		bool create(command_context& ctx, const object& compiler, std::string& error);
+		void destroy(command_context& ctx);
+		bool ready() const { return !!m_library; }
+
+		// The multisampled texture into the resolve texture, and back.
+		bool resolve(command_context& ctx, render_target& surface);
+		bool unresolve(command_context& ctx, render_target& surface);
+
+	private:
+		enum class pass : u8
+		{
+			color_resolve,
+			color_unresolve,
+			depth_resolve,
+			depth_unresolve,
+			depth_stencil_resolve,
+			depth_stencil_unresolve,
+		};
+
+		const object& get_pipeline(pass kind, pixel_format format, u32 samples);
+		bool run(command_context& ctx, render_target& surface, bool unresolve);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		object m_depth_state;          // depth always, written
+		object m_depth_stencil_state;  // and stencil always, replaced, all bits
+		std::array<object, 5> m_params{};  // the sample counts by host sample count (2, 4)
+		transfer_pipeline_cache m_pipelines;  // the blit engine's pipeline machinery (MTLTransferPass.h)
+	};
+
+	// The resolver the render targets use (set by the renderer, as the command context).
+	void set_msaa_resolver(msaa_resolver* resolver);
+	msaa_resolver* get_msaa_resolver();
+}
