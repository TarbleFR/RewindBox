new file mode 100644
index 0000000..3736bdd
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLComputeTasks.h
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the conversion compute tasks of the surface and texture paths (VKCompute.h / .cpp):
+// byte swaps, D24S8 <-> F32 depth conversions, depth-stencil gather/scatter (interleave) and the e4m12 float
+// conversions, as Metal compute kernels compiled at runtime from MSL (MTLM4Shaders.h) by the MTL4 compiler.
+//
+// Each run() takes the Vulkan task's run() arguments and dispatches over the same words with the same arithmetic
+// (MTLM4Math.h, shared with the host unit test). Accesses stay inside the bound range, as Vulkan's robust buffer access
+// keeps them. Each task is its own compute encoder: the next encoder of the command context waits for it, so a task's
+// results are visible to whatever is encoded after it, and it sees everything encoded before.
+// The caller keeps the data buffer resident and alive until the work completes (command_context::dispose).
+// Not ported (no caller in this renderer yet): the GPU deswizzle (GPUDeswizzle.glsl), the RSX tile codec
+// (RSXMemoryTiling.glsl) and the conditional-render aggregator (no hardware conditional rendering on Metal).
+
+#include "MTLAPI.h"
+
+#include <array>
+#include <functional>
+#include <string>
+#include <utility>
+
+namespace mtl
+{
+	class command_context;
+
+	enum class compute_kernel : u32
+	{
+		// cs_shuffle_*: value = data[index]; data[index] = f(value)
+		bswap_u16,                // cs_shuffle_16
+		bswap_u32,                // cs_shuffle_32
+		bswap_u16_u32,            // cs_shuffle_32_16
+		d24x8_to_f32,             // cs_shuffle_d24x8_f32
+		f32_to_d24x8_swapped,     // cs_shuffle_se_f32_d24x8
+		d24x8_to_d24x8_swapped,   // cs_shuffle_se_d24x8
+
+		// cs_interleave_task family
+		gather_d24x8,             // cs_gather_d24x8<false>
+		gather_d24x8_swapped,     // cs_gather_d24x8<true>
+		gather_d32x8,             // cs_gather_d32x8<false, false>
+		gather_d32x8_swapped,     // cs_gather_d32x8<true, false>
+		gather_d32fx8,            // cs_gather_d32x8<false, true>
+		gather_d32fx8_swapped,    // cs_gather_d32x8<true, true>
+		scatter_d24x8,            // cs_scatter_d24x8
+		scatter_d32x8,            // cs_scatter_d32x8<false>
+		scatter_d32fx8,           // cs_scatter_d32x8<true>
+
+		// cs_fconvert_task<From, To, _SwapSrc, _SwapDst>
+		f32_to_f16,
+		f32_to_f16_swap_src,
+		f32_to_f16_swap_dst,
+		f32_to_f16_swap_both,
+		f16_to_f32,
+		f16_to_f32_swap_src,
+		f16_to_f32_swap_dst,
+		f16_to_f32_swap_both,
+
+		count
+	};
+
+	enum class compute_kernel_family : u8
+	{
+		shuffle,
+		interleave,
+		fconvert,
+	};
+
+	constexpr compute_kernel_family get_kernel_family(compute_kernel kernel)
+	{
+		if (kernel <= compute_kernel::d24x8_to_d24x8_swapped) return compute_kernel_family::shuffle;
+		if (kernel <= compute_kernel::scatter_d32fx8) return compute_kernel_family::interleave;
+		return compute_kernel_family::fconvert;
+	}
+
+	// MoltenVK's compute_task settings in the Vulkan renderer (VKCompute.cpp compute_task::create).
+	constexpr u32 compute_optimal_group_size = 256;
+	constexpr u32 compute_optimal_kernel_size = 1;
+
+	constexpr u32 compute_aligned_div(u32 value, u32 alignment)
+	{
+		return static_cast<u32>((static_cast<u64>(value) + alignment - 1) / alignment);
+	}
+
+	// cs_shuffle_base::run: the work groups covering `data_length` bytes, one word per invocation.
+	constexpr u32 compute_shuffle_workgroups(u32 data_length)
+	{
+		return compute_aligned_div(data_length, compute_optimal_group_size * compute_optimal_kernel_size * 4);
+	}
+
+	// The dispatch of `invocations` threads in groups of `group_size` (VK compute_task::run), in two dimensions when one
+	// would exceed `max_groups_x` (compute_task::run(cmd, num_invocations), rounded up so that every group is covered:
+	// the kernels' invocation index is linear and bounded, extra groups do nothing).
+	struct dispatch_size
+	{
+		size3 groups{ 0, 1, 1 };
+		size3 threads{ 1, 1, 1 };
+	};
+
+	inline dispatch_size get_dispatch_size(u32 invocations, u32 group_size, u32 max_groups_x = 65535)
+	{
+		dispatch_size size{};
+		group_size = group_size ? group_size : 1;
+		size.threads = { group_size, 1, 1 };
+
+		const u32 groups = compute_aligned_div(invocations, group_size);
+		if (groups <= max_groups_x)
+		{
+			size.groups = { groups, 1, 1 };
+			return size;
+		}
+
+		u32 x = 1;
+		while (static_cast<u64>(x + 1) * (x + 1) <= groups && x < max_groups_x)
+		{
+			x++;
+		}
+		size.groups = { x, compute_aligned_div(groups, x), 1 };
+		return size;
+	}
+
+	// The parameter words of each family: the Vulkan push constants params[0], plus the bound range in words in w.
+	inline std::array<u32, 4> shuffle_params(u32 data_length)
+	{
+		// The bound range is data_length bytes: the whole words inside it are processed (robust access drops the rest).
+		const u32 words = data_length / 4;
+		return { words, 0, 0, words };
+	}
+
+	// cs_interleave_task::run; `bound_offset` is where the data is bound.
+	inline std::array<u32, 4> interleave_params(u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset, u32& bound_offset)
+	{
+		bound_offset = data_offset;
+		const u32 ssbo_length = stencil_offset + (data_length / 4) - data_offset;
+		return { data_length, zeta_offset - data_offset, stencil_offset - data_offset, ssbo_length / 4 };
+	}
+
+	// cs_fconvert_task::run
+	inline std::array<u32, 4> fconvert_params(compute_kernel kernel, u32 src_offset, u32 src_length, u32 dst_offset, u32& bound_offset)
+	{
+		const bool contract = kernel <= compute_kernel::f32_to_f16_swap_both;
+		const u32 from_size = contract ? 4 : 2;
+		const u32 to_size = contract ? 2 : 4;
+
+		u32 ssbo_length;
+		if (src_offset > dst_offset)
+		{
+			ssbo_length = (src_offset + src_length) - dst_offset;
+			bound_offset = dst_offset;
+		}
+		else
+		{
+			ssbo_length = (dst_offset - src_offset) + (src_length / from_size) * to_size;
+			bound_offset = src_offset;
+		}
+
+		return { src_length, src_offset - bound_offset, dst_offset - bound_offset, ssbo_length / 4 };
+	}
+
+	class compute_tasks
+	{
+	public:
+		// Writes `size` bytes of parameters into GPU-visible memory; returns the buffer and offset. Called before the
+		// task's encoder is opened (it may submit to make room).
+		using param_writer = std::function<std::pair<object, u64>(const void* data, u32 size)>;
+
+		bool create(const object& device, const object& compiler, param_writer writer, std::string& error);
+		void destroy();
+		bool ready() const { return !!m_library; }
+
+		// VK cs_shuffle_base::run(cmd, data, data_length, data_offset)
+		bool run_shuffle(command_context& ctx, compute_kernel kernel, const object& data, u32 data_length, u32 data_offset = 0);
+		// VK cs_interleave_task::run(cmd, data, data_offset, data_length, zeta_offset, stencil_offset)
+		bool run_interleave(command_context& ctx, compute_kernel kernel, const object& data, u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset);
+		// VK cs_fconvert_task::run(cmd, data, src_offset, src_length, dst_offset)
+		bool run_fconvert(command_context& ctx, compute_kernel kernel, const object& data, u32 src_offset, u32 src_length, u32 dst_offset);
+
+	private:
+		const object& get_pipeline(compute_kernel kernel);
+		bool dispatch(command_context& ctx, compute_kernel kernel, const object& data, u64 data_offset, const std::array<u32, 4>& params, u32 workgroups);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		param_writer m_writer;
+		std::array<object, static_cast<usz>(compute_kernel::count)> m_pipelines{};
+		std::array<bool, static_cast<usz>(compute_kernel::count)> m_pipeline_failed{};
+	};
+
+	// The tasks the surface and texture paths use (set by the renderer).
+	void set_compute_tasks(compute_tasks* tasks);
+	compute_tasks* get_compute_tasks();
+}
