diff --git a/rpcs3/Emu/RSX/Metal/MTLTexture.cpp b/rpcs3/Emu/RSX/Metal/MTLTexture.cpp
new file mode 100644
index 0000000..847f06d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTexture.cpp
@@ -0,0 +1,592 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M3.1): images, views and the CPU upload path of the native Metal 4 renderer
+// (vkutils/image.cpp and VKTexture.cpp upload_image counterparts).
+
+#include "stdafx.h"
+#include "MTLTexture.h"
+#include "MTLCommandContext.h"
+
+#include "Emu/Memory/vm.h"
+#include "Emu/RSX/Common/io_buffer.h"
+#include "Emu/RSX/Common/tiled_dma_copy.hpp"
+#include "util/asm.hpp"
+
+#include <cstring>
+#include <mutex>
+#include <unordered_set>
+
+namespace mtl
+{
+	namespace
+	{
+		command_context* g_command_context = nullptr;
+		texture_counters g_texture_counters{};
+
+		texture_view_descriptor make_view_descriptor(const image& img, pixel_format format, const component_map& swizzle)
+		{
+			texture_view_descriptor desc{};
+			desc.format = format;
+			desc.type = img.view_type();
+			desc.base_level = 0;
+			desc.level_count = std::max(img.mipmaps(), 1u);
+			desc.base_slice = 0;
+			desc.slice_count = (img.type == texture_type::type_3d) ? 1 : std::max(img.layers(), 1u);
+			for (u32 i = 0; i < 4; ++i)
+			{
+				desc.swizzle[i] = static_cast<texture_swizzle>(swizzle[i]);
+			}
+			return desc;
+		}
+	}
+
+	void set_command_context(command_context* ctx)
+	{
+		g_command_context = ctx;
+	}
+
+	command_context* get_command_context()
+	{
+		return g_command_context;
+	}
+
+	texture_counters& get_texture_counters()
+	{
+		return g_texture_counters;
+	}
+
+	void log_once(const char* key, const std::string& message)
+	{
+		static std::mutex s_lock;
+		static std::unordered_set<std::string> s_seen;
+		std::lock_guard lock(s_lock);
+		if (s_seen.emplace(key).second)
+		{
+			rsx_log.error("Metal: %s (counted in COREPROF METAL; logged once)", message);
+		}
+	}
+
+	// image_view
+
+	image_view::image_view(mtl::image* owner, object handle, const texture_view_descriptor& desc, u32 aspect, u64 key)
+		: m_owner(owner), m_handle(std::move(handle)), m_desc(desc), m_aspect(aspect), m_key(key)
+	{
+		if (m_handle && g_command_context)
+		{
+			g_command_context->make_resident(m_handle);
+		}
+	}
+
+	image_view::~image_view()
+	{
+		if (m_handle && g_command_context)
+		{
+			// The GPU may still read it through an argument table: released after the recorded work completes.
+			g_command_context->dispose(std::move(m_handle), true);
+		}
+	}
+
+	image_view* image_view::as(pixel_format format)
+	{
+		if (format == m_desc.format || format == pixel_format::invalid)
+		{
+			return this;
+		}
+
+		component_map swizzle{};
+		for (u32 i = 0; i < 4; ++i)
+		{
+			swizzle[i] = static_cast<mtl::swizzle>(m_desc.swizzle[i]);
+		}
+
+		// Same remap and aspect, other format: replace the format bits of the key (view_key layout).
+		const u64 key = (m_key & ~(0xffffull << 40)) | (static_cast<u64>(static_cast<u32>(format) & 0xffff) << 40);
+		auto result = m_owner->get_view(format, swizzle, m_aspect, key);
+		return result ? result : this;
+	}
+
+	// image
+
+	image::~image()
+	{
+		release_views();
+		if (texture && g_command_context)
+		{
+			g_command_context->dispose(std::move(texture), true);
+		}
+	}
+
+	bool image::create(command_context& ctx, const texture_descriptor& desc, rsx::format_class format_class)
+	{
+		ensure(!texture);
+		texture = new_texture(ctx.device(), desc);
+		if (!texture)
+		{
+			g_texture_counters.image_allocation_failures++;
+			rsx_log.error("Metal: texture allocation failed (%ux%ux%u, %u levels, %u slices, type %u, format %u)",
+				desc.width, desc.height, desc.depth, desc.mip_levels, desc.array_length, static_cast<u32>(desc.type), static_cast<u32>(desc.format));
+			return false;
+		}
+
+		type = desc.type;
+		native_format = desc.format;
+		texture_width = desc.width;
+		texture_height = desc.height;
+		texture_depth = desc.depth;
+		mip_count = desc.mip_levels;
+		layer_count = (desc.type == texture_type::type_cube) ? 6 : desc.array_length;
+		sample_count = static_cast<u8>(desc.sample_count);
+		usage = desc.usage;
+		image_format_class = format_class;
+		ctx.make_resident(texture);
+		g_texture_counters.images_created++;
+		return true;
+	}
+
+	u32 image::aspect() const
+	{
+		if (!is_depth_format(native_format))
+		{
+			return native_format == pixel_format::stencil8 ? aspect_stencil : aspect_color;
+		}
+		return aspect_depth | (has_stencil(native_format) ? aspect_stencil : 0);
+	}
+
+	image_view* image::get_view(const rsx::texture_channel_remap_t& remap, u32 aspect_mask)
+	{
+		const u32 aspect_bits = aspect() & aspect_mask;
+		ensure(aspect_bits, "Metal: view of an aspect the image does not have");
+
+		// A stencil-only request of a depth-stencil image is its stencil plane (X32_Stencil8).
+		const bool stencil = (aspect_bits == aspect_stencil) && is_depth();
+		const pixel_format format = stencil ? pixel_format::x32_stencil8 : native_format;
+		const u64 key = view_key(native_component_map, remap, aspect_bits, format);
+		if (m_last_view && m_last_view_key == key)
+		{
+			return m_last_view;
+		}
+
+		return get_view(format, view_swizzle(native_component_map, remap), aspect_bits, key);
+	}
+
+	image_view* image::get_view(pixel_format format, const component_map& swizzle, u32 aspect_bits, u64 key)
+	{
+		if (auto found = m_views.find(key); found != m_views.end())
+		{
+			m_last_view_key = key;
+			return m_last_view = found->second.get();
+		}
+
+		const auto desc = make_view_descriptor(*this, format, swizzle);
+		object handle = new_texture_view(texture, desc);
+		if (!handle)
+		{
+			g_texture_counters.view_failures++;
+			log_once("view", fmt::format("texture view creation failed (format %u of %u, type %u, %ux%u)",
+				static_cast<u32>(format), static_cast<u32>(native_format), static_cast<u32>(type), texture_width, texture_height));
+			return nullptr;
+		}
+
+		g_texture_counters.views_created++;
+		auto view = std::make_unique<image_view>(this, std::move(handle), desc, aspect_bits, key);
+		auto result = view.get();
+		m_views.emplace(key, std::move(view));
+		m_last_view_key = key;
+		return m_last_view = result;
+	}
+
+	void image::set_native_component_layout(const component_map& layout)
+	{
+		if (layout != native_component_map)
+		{
+			// Views of the old layout go (the GPU may still read them: they are released through dispose()).
+			release_views();
+			native_component_map = layout;
+		}
+	}
+
+	void image::release_views()
+	{
+		m_views.clear();
+		m_last_view = nullptr;
+		m_last_view_key = 0;
+	}
+
+	// Staging
+
+	staging_allocation allocate_staging(command_context& ctx, data_heap& heap, u64 size)
+	{
+		staging_allocation result{};
+		size = std::max<u64>(size, 16);
+
+		// The ring makes room by submitting and waiting; anything larger than half of it gets its own buffer
+		// (VK grows its upload heap instead).
+		if (size < heap.size() / 2)
+		{
+			result.offset = heap.alloc<512>(static_cast<usz>(size));
+			result.buffer = heap.buffer;
+			result.data = heap.map<u8>(static_cast<usz>(result.offset));
+			return result;
+		}
+
+		result.buffer = new_buffer(ctx.device(), utils::align<u64>(size, 4096), storage_mode::shared);
+		ensure(result.buffer, "Metal: staging buffer allocation failed");
+		result.data = static_cast<u8*>(buffer_contents(result.buffer));
+		ctx.make_resident(result.buffer);
+		// Released once the work recorded so far (and this copy) has completed.
+		ctx.dispose(result.buffer, true);
+		g_texture_counters.upload_dedicated_buffers++;
+		return result;
+	}
+
+	bool tiled_copy(u32 tile_base, u32 tile_size, u32 tile_pitch, u8 tile_bank, u32 origin, u8* linear, u32 linear_pitch,
+		u32 width, u32 height, u32 bpp, bool encode)
+	{
+		// tile_texel_data's prime/factor decomposition of the pitch.
+		const u32 units = tile_pitch >> 8;
+		u32 prime = 0, factor = 0;
+		if (tile_pitch && (tile_pitch & (tile_pitch - 1)) == 0)
+		{
+			prime = 1;
+			factor = units;
+		}
+		else
+		{
+			for (const u32 p : { 3u, 5u, 7u, 11u, 13u })
+			{
+				if (units && (units % p) == 0)
+				{
+					prime = p;
+					factor = units / p;
+					break;
+				}
+			}
+		}
+
+		if (!prime || !factor || origin < tile_base)
+		{
+			return false;
+		}
+
+		// Offsets are taken from the tile base (tile_rw_offset 0), so every texel's tiled address is inside the tile
+		// (tiled_dma_copy skips any beyond tile_size).
+		const rsx::detiler_config conf =
+		{
+			.prime = prime,
+			.factor = factor,
+			.num_tiles_per_row = prime * factor,
+			.tile_base_address = tile_base,
+			.tile_size = tile_size,
+			.tile_address_offset = origin - tile_base,
+			.tile_rw_offset = 0,
+			.tile_pitch = tile_pitch,
+			.tile_bank = tile_bank,
+			.image_width = width,
+			.image_height = height,
+			.image_pitch = linear_pitch,
+			.image_bpp = bpp,
+		};
+
+		char* tiled_data = vm::get_super_ptr<char>(tile_base);
+		char* linear_data = reinterpret_cast<char*>(linear);
+		const int op = encode ? 0 /* RSX_DMA_OP_ENCODE_TILE */ : 1 /* RSX_DMA_OP_DECODE_TILE */;
+		for (u32 row = 0; row < height; ++row)
+		{
+			for (u32 col = 0; col < width; ++col)
+			{
+				rsx::tiled_dma_copy(row, col, conf, tiled_data, linear_data, op);
+			}
+		}
+		return true;
+	}
+
+	// Uploads
+
+	namespace
+	{
+		// VKTexture.cpp calculate_upload_pitch with heap_align = 0 (packed rows, guest pitch kept when larger).
+		std::pair<u32, u32> calculate_upload_pitch(u32 gcm_format, const image& dst, const rsx::subresource_layout& layout,
+			const rsx::texture_uploader_capabilities& caps)
+		{
+			const u32 block_in_pixel = rsx::get_format_block_size_in_texel(gcm_format);
+			const u8 block_size_in_bytes = rsx::get_format_block_size_in_bytes(gcm_format);
+
+			u32 row_pitch = layout.border ? (layout.width_in_block * block_size_in_bytes) : (layout.pitch_in_block * block_size_in_bytes);
+			u32 upload_pitch_in_texel;
+
+			if (!rsx::is_compressed_host_format(caps, gcm_format))
+			{
+				const u32 host_texel_width = get_format_texel_width(dst.format());
+				const u32 host_packed_pitch = host_texel_width * layout.width_in_texel;
+				row_pitch = std::max<u32>(row_pitch, host_packed_pitch);
+				upload_pitch_in_texel = row_pitch / std::max(host_texel_width, 1u);
+			}
+			else
+			{
+				upload_pitch_in_texel = std::max<u32>(block_in_pixel * row_pitch / block_size_in_bytes, layout.width_in_texel);
+			}
+
+			return { row_pitch, upload_pitch_in_texel };
+		}
+
+		// The depth-stencil planes of uploaded D24S8 words (VKCompute.h cs_scatter_d24x8 / cs_scatter_d32x8).
+		void scatter_depth_stencil(const u8* src, u32 src_pitch, u32 width, u32 rows, bool depth_float, f32* depth, u8* stencil)
+		{
+			for (u32 y = 0; y < rows; ++y)
+			{
+				const u32* in = reinterpret_cast<const u32*>(src + static_cast<usz>(y) * src_pitch);
+				for (u32 x = 0; x < width; ++x)
+				{
+					const u32 value = in[x];
+					const u32 d24 = value >> 8;
+					depth[static_cast<usz>(y) * width + x] = depth_float ? std::bit_cast<f32>(d24f_to_f32_bits(d24)) : d24_to_f32(d24);
+					stencil[static_cast<usz>(y) * width + x] = static_cast<u8>(value & 0xff);
+				}
+			}
+		}
+	}
+
+	void upload_image(command_context& ctx, data_heap& heap, image* dst, const std::vector<rsx::subresource_layout>& layouts,
+		u32 gcm_format, bool is_swizzled, bool supports_bc)
+	{
+		ensure(dst && dst->texture);
+
+		rsx::texture_uploader_capabilities caps{};
+		caps.supports_byteswap = false;      // byteswap, deswizzle and DXT decoding on the CPU (no compute helpers yet)
+		caps.supports_vtc_decoding = false;
+		caps.supports_hw_deswizzle = false;
+		caps.supports_zero_copy = false;
+		caps.supports_dxt = supports_bc;
+		caps.alignment = 0;
+
+		const pixel_format format = dst->format();
+		const bool depth_stencil = format == pixel_format::depth32_float_stencil8;
+		const bool depth16_float = format == pixel_format::depth32_float && gcm_format == CELL_GCM_TEXTURE_DEPTH16_FLOAT;
+		const bool depth_float_class = dst->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32;
+		const bool compressed = rsx::is_compressed_host_format(caps, gcm_format);
+		const u32 host_bpp = compressed ? get_block_size(format) : get_texel_size(format);
+
+		if (!depth_stencil && !depth16_float && !compressed && !host_bpp)
+		{
+			g_texture_counters.uploads_unsupported_format++;
+			log_once("upload-format", fmt::format("texture upload into format %u (gcm 0x%x) is not supported", static_cast<u32>(format), gcm_format));
+			return;
+		}
+
+		transfer_scope scope(ctx, "texture upload");
+		for (const rsx::subresource_layout& layout : layouts)
+		{
+			if (layout.level >= dst->mipmaps())
+			{
+				rsx_log.error("Metal: invalid subresource definition for the output texture (mip level %u does not exist)", layout.level);
+				continue;
+			}
+
+			const auto [row_pitch, upload_pitch_in_texel] = calculate_upload_pitch(gcm_format, *dst, layout, caps);
+			caps.alignment = row_pitch;
+
+			const u32 rows = compressed ? layout.height_in_block : layout.height_in_texel;
+			const u64 image_linear_size = static_cast<u64>(row_pitch) * layout.depth * rows;
+
+			// Decode the guest data into staging memory (with 8 bytes of slack, as VK maps it). Depth formats get their
+			// converted planes in the same allocation: a second one could make room by reusing this one's space.
+			const u32 width = layout.width_in_texel;
+			const u32 plane_rows = rows * layout.depth;
+			const u64 decode_size = utils::align<u64>(image_linear_size + 8, 256);
+			const u64 depth_size = (depth_stencil || depth16_float) ? utils::align<u64>(static_cast<u64>(width) * 4 * plane_rows, 256) : 0;
+			const u64 stencil_size = depth_stencil ? static_cast<u64>(width) * plane_rows : 0;
+			auto staging = allocate_staging(ctx, heap, decode_size + depth_size + stencil_size);
+			u8* const mapped = staging.data;
+			auto io_buf = rsx::io_buffer([&](usz) -> std::tuple<void*, usz>
+			{
+				return { mapped, static_cast<usz>(image_linear_size) };
+			});
+
+			const auto opt = rsx::upload_texture_subresource(io_buf, layout, static_cast<int>(gcm_format), is_swizzled, caps);
+			ensure(!opt.require_upload, "Metal: zero-copy texture upload requested without support");
+
+			g_texture_counters.uploads++;
+			g_texture_counters.upload_bytes += image_linear_size;
+
+			const size3 size{ layout.width_in_texel, layout.height_in_texel, layout.depth };
+			const bool is_3d = dst->type == texture_type::type_3d;
+			const u32 slice = is_3d ? 0 : layout.layer;
+			const auto box = texture_box::make(layout.level, slice, 0, 0, 0, size.width, size.height, size.depth);
+
+			if (depth_stencil || depth16_float)
+			{
+				// Separate planes, converted with the Vulkan renderer's formulas.
+				f32* depth = reinterpret_cast<f32*>(mapped + decode_size);
+				u8* stencil = mapped + decode_size + depth_size;
+				const u64 depth_offset = staging.offset + decode_size;
+
+				if (depth_stencil)
+				{
+					scatter_depth_stencil(mapped, row_pitch, width, plane_rows, depth_float_class, depth, stencil);
+				}
+				else
+				{
+					for (u32 y = 0; y < plane_rows; ++y)
+					{
+						const u16* in = reinterpret_cast<const u16*>(mapped + static_cast<usz>(y) * row_pitch);
+						for (u32 x = 0; x < width; ++x)
+						{
+							depth[static_cast<usz>(y) * width + x] = std::bit_cast<f32>(e4m12_to_f32_bits(in[x]));
+						}
+					}
+				}
+
+				copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, depth_offset, width * 4, is_3d ? width * 4 * rows : 0,
+					size, dst->texture, slice, layout.level, {}, depth_stencil ? blit_depth_from_depth_stencil : blit_none);
+				if (depth_stencil)
+				{
+					// Same region, other plane: ordered after the depth plane (a new encoder).
+					copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, depth_offset + depth_size, width, is_3d ? width * rows : 0,
+						size, dst->texture, slice, layout.level, {}, blit_stencil_from_depth_stencil);
+				}
+				g_texture_counters.depth_uploads_converted++;
+				continue;
+			}
+
+			copy_buffer_to_texture(scope.for_write(dst->texture, box), staging.buffer, staging.offset, row_pitch, is_3d ? row_pitch * rows : 0,
+				size, dst->texture, slice, layout.level, {});
+			static_cast<void>(upload_pitch_in_texel);
+		}
+
+		// The scope ends the encoder: the next user of this texture opens a new one, whose queue barrier waits for
+		// these copies.
+	}
+
+	void clear_image(command_context& ctx, data_heap& heap, image* dst)
+	{
+		ensure(dst && dst->texture);
+		g_texture_counters.clears++;
+
+		if (dst->is_depth())
+		{
+			// VK clears temporary depth images to {1.f, 0}.
+			for (u32 level = 0; level < dst->mipmaps(); ++level)
+			{
+				for (u32 slice = 0; slice < dst->layers(); ++slice)
+				{
+					render_pass_descriptor pass{};
+					pass.depth.texture = dst->texture;
+					pass.depth.level = level;
+					pass.depth.slice = slice;
+					pass.depth.load = load_action::clear;
+					pass.depth.store = store_action::store;
+					pass.depth.clear_depth = 1.0;
+					if (dst->has_stencil_aspect())
+					{
+						pass.stencil = { dst->texture, level, slice, load_action::clear, store_action::store, 0 };
+					}
+					pass.render_target_width = std::max(dst->width() >> level, 1u);
+					pass.render_target_height = std::max(dst->height() >> level, 1u);
+					ctx.begin_render(pass, 0, "texture clear");
+					ctx.end_encoder();
+				}
+			}
+			return;
+		}
+
+		// Colour: a zeroed staging region copied into every level and slice.
+		const bool compressed = is_compressed_format(dst->format());
+		const u32 bpp = compressed ? get_block_size(dst->format()) : get_texel_size(dst->format());
+		if (!bpp)
+		{
+			log_once("clear-format", fmt::format("clear of texture format %u is not supported", static_cast<u32>(dst->format())));
+			return;
+		}
+
+		const auto row_bytes = [&](u32 width) { return compressed ? utils::aligned_div(width, 4u) * bpp : width * bpp; };
+		const auto row_count = [&](u32 height) { return compressed ? utils::aligned_div(height, 4u) : height; };
+		const bool is_3d = dst->type == texture_type::type_3d;
+		const u64 size = static_cast<u64>(row_bytes(dst->width())) * row_count(dst->height()) * (is_3d ? dst->depth() : 1);
+		auto zeros = allocate_staging(ctx, heap, size);
+		std::memset(zeros.data, 0, static_cast<usz>(size));
+
+		transfer_scope scope(ctx, "texture clear");
+		for (u32 level = 0; level < dst->mipmaps(); ++level)
+		{
+			const u32 w = std::max(dst->width() >> level, 1u);
+			const u32 h = std::max(dst->height() >> level, 1u);
+			const u32 d = is_3d ? std::max(dst->depth() >> level, 1u) : 1;
+			for (u32 slice = 0; slice < (is_3d ? 1 : dst->layers()); ++slice)
+			{
+				copy_buffer_to_texture(scope.for_write(dst->texture, texture_box::make(level, slice, 0, 0, 0, w, h, d)), zeros.buffer, zeros.offset,
+					row_bytes(w), is_3d ? row_bytes(w) * row_count(h) : 0, { w, h, d }, dst->texture, slice, level, {});
+			}
+		}
+	}
+
+	// transfer_scope
+
+	transfer_scope::transfer_scope(command_context& ctx, std::string_view label)
+		: m_ctx(ctx), m_label(label)
+	{
+		// A compute encoder opened before this scope may hold copies the scope does not know about.
+		if (m_ctx.kind() == command_context::encoder_kind::compute)
+		{
+			m_ctx.end_encoder();
+		}
+	}
+
+	transfer_scope::~transfer_scope()
+	{
+		if (m_ctx.kind() == command_context::encoder_kind::compute)
+		{
+			m_ctx.end_encoder();
+		}
+	}
+
+	bool transfer_scope::conflicts(const void* texture, const texture_box& box, bool write) const
+	{
+		for (const auto& entry : m_accesses)
+		{
+			if (entry.texture == texture && (write || entry.write) && entry.box.overlaps(box))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	void transfer_scope::split()
+	{
+		if (m_ctx.kind() == command_context::encoder_kind::compute)
+		{
+			m_ctx.end_encoder();
+		}
+		m_accesses.clear();
+		m_encoder = nullptr;
+	}
+
+	const object& transfer_scope::encoder(const object* src, const texture_box& src_box, const object* dst, const texture_box& dst_box)
+	{
+		// Another helper (a full ring submits) may have ended the encoder: nothing recorded so far is in the open one.
+		if (m_ctx.kind() != command_context::encoder_kind::compute || m_ctx.encoder().get() != m_encoder)
+		{
+			m_accesses.clear();
+		}
+
+		// (A copy whose own source and destination regions overlap is refused by the callers: no encoder orders that.)
+		const bool conflict = (src && conflicts(src->get(), src_box, false)) || (dst && conflicts(dst->get(), dst_box, true));
+		if (conflict)
+		{
+			m_ctx.end_encoder();
+			m_accesses.clear();
+			m_splits++;
+		}
+
+		const object& result = m_ctx.compute(m_label);
+		m_encoder = result.get();
+		if (src)
+		{
+			m_accesses.push_back({ src->get(), src_box, false });
+		}
+		if (dst)
+		{
+			m_accesses.push_back({ dst->get(), dst_box, true });
+		}
+		return result;
+	}
+}
