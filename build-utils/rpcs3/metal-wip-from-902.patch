diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Counters.h b/rpcs3/Emu/RSX/Metal/MTLM4Counters.h
new file mode 100644
index 0000000..cb9d80c
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Counters.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): what stage M4 executed, and what it could not execute (counted, logged once, never
+// replaced by a guess). Reported by MTLGSRender::report_counters as the "COREPROF METAL M4" line.
+
+#include "util/types.hpp"
+
+#include <atomic>
+
+namespace mtl
+{
+	struct m4_counters
+	{
+		// ZCULL / occlusion queries (MTLQueries.cpp)
+		std::atomic<u64> queries_begun{0};
+		std::atomic<u64> query_segments{0};          // visibility slots counted (one per query per render encoder)
+		std::atomic<u64> query_results{0};           // results gathered from the GPU
+		std::atomic<u64> query_discards{0};
+		std::atomic<u64> query_hard_syncs{0};        // a result read while its work was still being recorded (VK: hard sync)
+		std::atomic<u64> query_gpu_waits{0};         // a gather that had to wait for the GPU
+		std::atomic<u64> query_hint_flushes{0};      // zcull_sync / conditional render hints that submitted the work
+		std::atomic<u64> query_slot_exhaustions{0};  // the visibility pool was full (ZCULL sync, then exact folding)
+		std::atomic<u64> query_folded_segments{0};
+
+		// MSAA (MTLResolve.cpp)
+		std::atomic<u64> msaa_surfaces{0};
+		std::atomic<u64> resolves{0};
+		std::atomic<u64> unresolves{0};
+		std::atomic<u64> resolve_failures{0};        // no pipeline for the format: not executed, counted
+		std::atomic<u64> msaa_allocation_failures{0};
+		std::atomic<u64> msaa_feedback_direct{0};    // a multisampled attachment sampled in its own pass, no snapshot
+
+		// Conversion kernels (MTLComputeTasks.cpp)
+		std::atomic<u64> compute_dispatches{0};
+		std::atomic<u64> compute_failures{0};        // kernel or pipeline unavailable: not executed, counted
+		std::atomic<u64> typeless_copies{0};         // VK copy_image_typeless through the kernels (MTLTypelessCopy.cpp)
+
+		// Native overlays (MTLOverlays.cpp)
+		std::atomic<u64> overlay_frames{0};
+		std::atomic<u64> overlay_views{0};
+		std::atomic<u64> overlay_draws{0};
+		std::atomic<u64> overlay_failures{0};        // the overlay pipeline is unavailable: views not drawn, counted
+	};
+
+	m4_counters& get_m4_counters() noexcept;
+
+	// One log line per kind of failure for the whole run; the counters keep counting.
+	enum class m4_failure : u32
+	{
+		query_slots_exhausted,
+		resolve_pipeline,
+		msaa_allocation,
+		compute_library,
+		compute_pipeline,
+		overlay_pipeline,
+		count
+	};
+
+	// True the first time `kind` is reported.
+	bool m4_first_failure(m4_failure kind) noexcept;
+
+	inline void m4_count(std::atomic<u64>& counter, u64 amount = 1) noexcept
+	{
+		counter.fetch_add(amount, std::memory_order_relaxed);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLM4Math.h b/rpcs3/Emu/RSX/Metal/MTLM4Math.h
new file mode 100644
index 0000000..3e8b729
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM4Math.h
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the arithmetic of the M4 GPU kernels, written once and compiled twice.
+//
+// MTL_M4_DUAL_SOURCE(name, code) compiles `code` as C++ in mtl::m4_math (the host unit test calls it) and keeps the
+// very same tokens as text in mtl::m4_source::name, which MTLM4Shaders.h places in the Metal Shading Language
+// libraries the renderer compiles at runtime. Every function is the Vulkan renderer's GLSL on scalars, operator for
+// operator:
+//   - conversion_math: Program/GLSLSnippets/ShuffleBytes.glsl (byte swaps, D24 <-> F32 depth) and the interleave and
+//     e4m12 conversion kernels of VKCompute.h / VKCompute.cpp;
+//   - resolve_math: the coordinate and sample-index math of Program/MSAA/*ResolvePass.glsl and *UnresolvePass.glsl.
+// Only the two bit casts differ by language (std::bit_cast here, as_type<> in MSL). The code must stay a subset that
+// means the same in C++ and in MSL: 32-bit unsigned/signed integers, float, no vectors, no preprocessor lines.
+// The stringized text loses its line breaks, so the code holds no // comments.
+
+#include <bit>
+#include <cstdint>
+#include <string_view>
+
+#define MTL_M4_DUAL_SOURCE(name, ...) \
+	namespace mtl::m4_math \
+	{ \
+		__VA_ARGS__ \
+	} \
+	namespace mtl::m4_source \
+	{ \
+		inline constexpr std::string_view name = #__VA_ARGS__; \
+	}
+
+namespace mtl::m4_math
+{
+	using uint = std::uint32_t;
+	static_assert(sizeof(float) == 4);
+
+	// floatBitsToUint / uintBitsToFloat
+	inline uint m4_as_uint(float value) { return std::bit_cast<uint>(value); }
+	inline float m4_as_float(uint value) { return std::bit_cast<float>(value); }
+}
+
+namespace mtl::m4_source
+{
+	// The MSL definitions of the two bit casts.
+	inline constexpr std::string_view bit_casts =
+		"inline uint m4_as_uint(float value) { return as_type<uint>(value); }\n"
+		"inline float m4_as_float(uint value) { return as_type<float>(value); }\n";
+}
+
+// ShuffleBytes.glsl macros (bswap_u16, bswap_u32, bswap_u16_u32, d24_to_f32, f32_to_d24, d24f_to_f32, f32_to_d24f,
+// d24x8_to_f32, d24x8_to_d24x8_swapped, f32_to_d24x8_swapped), the gather/scatter work kernels of
+// cs_gather_d24x8 / cs_gather_d32x8 / cs_scatter_d24x8 / cs_scatter_d32x8 (VKCompute.h, VKCompute.cpp) and the e4m12
+// helpers of cs_fconvert_task (unpack_e4m12_pack16, pack_e4m12_pack16), per component.
+MTL_M4_DUAL_SOURCE(conversion_math,
+	inline uint m4_bswap_u16(uint bits) { return (bits & 0xFF) << 8 | (bits & 0xFF00) >> 8 | (bits & 0xFF0000) << 8 | (bits & 0xFF000000) >> 8; }
+	inline uint m4_bswap_u32(uint bits) { return (bits & 0xFF) << 24 | (bits & 0xFF00) << 8 | (bits & 0xFF0000) >> 8 | (bits & 0xFF000000) >> 24; }
+	inline uint m4_bswap_u16_u32(uint bits) { return (bits & 0xFFFF) << 16 | (bits & 0xFFFF0000) >> 16; }
+
+	inline uint m4_d24_to_f32(uint bits) { return m4_as_uint(float(bits) / 16777215.f); }
+	inline uint m4_f32_to_d24(uint bits) { return uint(m4_as_float(bits) * 16777215.f); }
+	inline uint m4_d24f_to_f32(uint bits) { return (bits << 7); }
+	inline uint m4_f32_to_d24f(uint bits) { return (bits >> 7); }
+	inline uint m4_d24x8_to_f32(uint bits) { return m4_d24_to_f32(bits >> 8); }
+	inline uint m4_d24x8_to_d24x8_swapped(uint bits) { return (bits & 0xFF00) | (bits & 0xFF0000) >> 16 | (bits & 0xFF) << 16; }
+	inline uint m4_f32_to_d24x8_swapped(uint bits) { return m4_d24x8_to_d24x8_swapped(m4_f32_to_d24(bits)); }
+
+	inline uint m4_stencil_shift(uint index) { return (index % 4) * 8; }
+	inline uint m4_gather_stencil(uint stencil_word, uint index) { return (stencil_word >> m4_stencil_shift(index)) & 0xFF; }
+	inline uint m4_gather_d24x8(uint depth_word, uint stencil_word, uint index) { return ((depth_word & 0x00FFFFFF) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_gather_d32x8(uint depth_word, uint stencil_word, uint index) { return (m4_f32_to_d24(depth_word) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_gather_d32fx8(uint depth_word, uint stencil_word, uint index) { return (m4_f32_to_d24f(depth_word) << 8) | m4_gather_stencil(stencil_word, index); }
+	inline uint m4_scatter_d24(uint value) { return (value >> 8); }
+	inline uint m4_scatter_d32(uint value) { return m4_d24_to_f32(value >> 8); }
+	inline uint m4_scatter_d32f(uint value) { return m4_d24f_to_f32(value >> 8); }
+	inline uint m4_scatter_stencil(uint value, uint index) { return (value & 0xFF) << m4_stencil_shift(index); }
+
+	inline uint m4_unpack_e4m12_lo(uint value) { return ((value & 0xFFFF) << 11) + (120 << 23); }
+	inline uint m4_unpack_e4m12_hi(uint value) { return (((value >> 16) & 0xFFFF) << 11) + (120 << 23); }
+	inline uint m4_pack_e4m12_pack16(uint x, uint y) { return (((x - (120 << 23)) >> 11) & 0xFFFF) | (((y - (120 << 23)) >> 11) << 16); }
+)
+
+// Program/MSAA: the resolve passes map each texel of the single-sampled image (the samples side by side) to a pixel
+// and a sample of the multisampled image; the unresolve passes map each sample back. int as in the GLSL (ivec2).
+MTL_M4_DUAL_SOURCE(resolve_math,
+	inline int m4_resolve_source(int resolve_coord, int samples) { return resolve_coord / samples; }
+	inline int m4_resolve_sample_index(int resolve_x, int resolve_y, int samples_x, int samples_y) { return (resolve_x % samples_x) + ((resolve_y % samples_y) * samples_y); }
+	inline int m4_unresolve_target_x(int pixel_x, int sample_id, int samples_x) { return (pixel_x * samples_x) + (sample_id % samples_x); }
+	inline int m4_unresolve_target_y(int pixel_y, int sample_id, int samples_x, int samples_y) { return (pixel_y * samples_y) + (sample_id / samples_x); }
+)
+
+// MSAA configuration (C++ only).
+namespace mtl::msaa
+{
+	// samples_x, samples_y of a sample count: rsx::surface_descriptor::set_spp and VK depth_resolve_base::
+	// update_sample_configuration (2 samples side by side, 4 samples as 2x2). {0, 0} for a count the RSX has not.
+	struct sample_grid
+	{
+		std::uint32_t x = 0;
+		std::uint32_t y = 0;
+	};
+
+	constexpr sample_grid grid_for(std::uint32_t samples)
+	{
+		switch (samples)
+		{
+		case 1: return { 1, 1 };
+		case 2: return { 2, 1 };
+		case 4: return { 2, 2 };
+		default: return { 0, 0 };
+		}
+	}
+
+	// VKRenderTargets.h create_new_surface: a surface has the AA mode's sample count (get_format_sample_count) at the
+	// "Auto" MSAA level, and one sample otherwise.
+	constexpr std::uint32_t host_samples(bool msaa_auto, std::uint32_t rsx_samples)
+	{
+		return msaa_auto ? rsx_samples : 1;
+	}
+
+	// The sample mask a pipeline applies (Vulkan pSampleMask = the RSX mask, for more than one sample), restricted to the
+	// samples that exist; all_samples when it masks nothing (no shader sample mask output is then needed).
+	constexpr std::uint32_t all_samples = 0xffffffffu;
+
+	constexpr std::uint32_t pipeline_sample_mask(std::uint32_t samples, std::uint32_t rsx_mask)
+	{
+		if (samples <= 1 || samples >= 32)
+		{
+			return all_samples;
+		}
+
+		const std::uint32_t existing = (1u << samples) - 1;
+		return ((rsx_mask & existing) == existing) ? all_samples : (rsx_mask & existing);
+	}
+}
