+
+	void test_sampler_formats()
+	{
+		// VKFormats.cpp get_compatible_sampler_format on arm64, through MoltenVK's table.
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_A8R8G8B8, true) == pixel_format::bgra8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_D8R8G8B8, true) == pixel_format::bgra8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_R5G6B5, true) == pixel_format::b5g6r5_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_R6G5B5, true) == pixel_format::b5g6r5_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_R5G5B5A1, true) == pixel_format::a1bgr5_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_A1R5G5B5, true) == pixel_format::bgr5a1_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_D1R5G5B5, true) == pixel_format::bgr5a1_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_A4R4G4B4, true) == pixel_format::abgr4_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_B8, true) == pixel_format::r8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_G8B8, true) == pixel_format::rg8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_X16, true) == pixel_format::r16_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_Y16_X16, true) == pixel_format::rg16_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_Y16_X16_FLOAT, true) == pixel_format::rg16_float);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT, true) == pixel_format::rgba16_float);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT, true) == pixel_format::rgba32_float);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_X32_FLOAT, true) == pixel_format::r32_float);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_HILO8, true) == pixel_format::rg8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_HILO_S8, true) == pixel_format::rg8_snorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_B8R8_G8R8, true) == pixel_format::bgra8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_R8B8_R8G8, true) == pixel_format::bgra8_unorm);
+		// No D24S8 on Apple GPUs: Depth32Float_Stencil8, as MoltenVK.
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_DEPTH24_D8, true) == pixel_format::depth32_float_stencil8);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT, true) == pixel_format::depth32_float_stencil8);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_DEPTH16, true) == pixel_format::depth16_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_DEPTH16_FLOAT, true) == pixel_format::depth32_float);
+		// DXT: BC formats when the device has them, decompressed to BGRA8 otherwise (as VK and GL).
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_DXT1, true) == pixel_format::bc1_rgba);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_DXT23, true) == pixel_format::bc2_rgba);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_DXT45, true) == pixel_format::bc3_rgba);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_DXT1, false) == pixel_format::bgra8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_DXT23, false) == pixel_format::bgra8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(CELL_GCM_TEXTURE_COMPRESSED_DXT45, false) == pixel_format::bgra8_unorm);
+		CHECK(mtl::get_compatible_sampler_format(0x00, true) == pixel_format::invalid);
+
+		// Every format with a sampler format has a component mapping, and both agree on depth.
+		const u32 all[] = {
+			CELL_GCM_TEXTURE_B8, CELL_GCM_TEXTURE_A1R5G5B5, CELL_GCM_TEXTURE_A4R4G4B4, CELL_GCM_TEXTURE_R5G6B5, CELL_GCM_TEXTURE_A8R8G8B8,
+			CELL_GCM_TEXTURE_COMPRESSED_DXT1, CELL_GCM_TEXTURE_COMPRESSED_DXT23, CELL_GCM_TEXTURE_COMPRESSED_DXT45, CELL_GCM_TEXTURE_G8B8,
+			CELL_GCM_TEXTURE_R6G5B5, CELL_GCM_TEXTURE_DEPTH24_D8, CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT, CELL_GCM_TEXTURE_DEPTH16,
+			CELL_GCM_TEXTURE_DEPTH16_FLOAT, CELL_GCM_TEXTURE_X16, CELL_GCM_TEXTURE_Y16_X16, CELL_GCM_TEXTURE_R5G5B5A1,
+			CELL_GCM_TEXTURE_COMPRESSED_HILO8, CELL_GCM_TEXTURE_COMPRESSED_HILO_S8, CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT,
+			CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT, CELL_GCM_TEXTURE_X32_FLOAT, CELL_GCM_TEXTURE_D1R5G5B5, CELL_GCM_TEXTURE_D8R8G8B8,
+			CELL_GCM_TEXTURE_Y16_X16_FLOAT, CELL_GCM_TEXTURE_COMPRESSED_B8R8_G8R8, CELL_GCM_TEXTURE_COMPRESSED_R8B8_R8G8,
+		};
+		for (u32 format : all)
+		{
+			mtl::argb_map map{};
+			CHECK(mtl::get_compatible_sampler_format(format, true) != pixel_format::invalid);
+			CHECK(mtl::get_component_mapping(format, map));
+			CHECK(mtl::get_format_texel_width(mtl::get_compatible_sampler_format(format, true)) != 0);
+		}
+	}
