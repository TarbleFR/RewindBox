+	void test_transfers()
+	{
+		using mtl::texture_box;
+		// Transfer ordering: same subresource and intersecting boxes only.
+		const auto a = texture_box::make(0, 0, 0, 0, 0, 64, 64);
+		CHECK(a.overlaps(texture_box::make(0, 0, 63, 63, 0, 10, 10)));
+		CHECK(!a.overlaps(texture_box::make(0, 0, 64, 0, 0, 10, 10)));      // touching edges do not overlap
+		CHECK(!a.overlaps(texture_box::make(0, 0, 0, 64, 0, 10, 10)));
+		CHECK(!a.overlaps(texture_box::make(1, 0, 0, 0, 0, 64, 64)));       // another level
+		CHECK(!a.overlaps(texture_box::make(0, 1, 0, 0, 0, 64, 64)));       // another slice
+		CHECK(texture_box::make(0, 0, 0, 0, 2, 8, 8, 2).overlaps(texture_box::make(0, 0, 4, 4, 3, 8, 8, 1)));
+		CHECK(!texture_box::make(0, 0, 0, 0, 2, 8, 8, 2).overlaps(texture_box::make(0, 0, 4, 4, 4, 8, 8, 1)));
+
+		// The Vulkan blit mapping: a 2x downscale samples between texel pairs, a 2x upscale repeats texels with
+		// nearest filtering, a mirrored span reads from the far end, an unscaled span reads texel centres.
+		CHECK(mtl::blit_source_coord(0, 8, 0, 4, 0) == 1.0f);
+		CHECK(mtl::blit_source_coord(0, 8, 0, 4, 3) == 7.0f);
+		CHECK(mtl::blit_source_coord(0, 4, 0, 8, 0) == 0.25f);
+		CHECK(mtl::blit_source_coord(0, 4, 0, 8, 7) == 3.75f);
+		CHECK(mtl::blit_source_coord(8, 0, 0, 8, 0) == 7.5f);
+		CHECK(mtl::blit_source_coord(8, 0, 0, 8, 7) == 0.5f);
+		CHECK(mtl::blit_source_coord(2, 6, 10, 14, 10) == 2.5f);
+		CHECK(mtl::blit_source_coord(2, 6, 10, 14, 13) == 5.5f);
+		// Nearest texel for every destination pixel of an integer upscale: floor(u) == x / 2.
+		u32 bad = 0;
+		for (u32 x = 0; x < 4096; ++x)
+		{
+			if (static_cast<u32>(std::floor(mtl::blit_source_coord(0, 2048, 0, 4096, x))) != x / 2)
+			{
+				bad++;
+			}
+		}
+		CHECK(bad == 0);
+	}
+}
+
+int main()
+{
+	test_sampler_formats();
+	test_component_orders();
+	test_format_properties();
+	test_depth_conversions();
+	test_samplers();
+	test_transfers();
+
+	if (g_failures)
+	{
+		std::fprintf(stderr, "%d of %d checks failed\n", g_failures, g_checks);
+		return 1;
+	}
+
+	std::printf("PASS: Metal texture formats, component orders and samplers (%d checks)\n", g_checks);
+	return 0;
+}
