+
+	void cached_texture_section::mark_keep_memory(const char* key, const char* reason)
+	{
+		// Not implemented for this section: the flush leaves the guest memory as it is (never garbage). Counted.
+		m_mode = readback_mode::keep_memory;
+		m_fence = 0;
+		m_converted = false;
+		real_pitch = rsx_pitch;
+		get_texture_counters().readbacks_not_implemented++;
+		log_once(key, fmt::format("readback of %s data is not implemented: the guest memory keeps its contents", reason));
+		synchronized = true;
+		sync_timestamp = rsx::get_shared_tag();
+	}
+
+	void cached_texture_section::copy_texture(command_context& cmd, bool miss)
+	{
+		if (!miss) [[likely]]
+		{
+			ensure(!synchronized);
+			baseclass::on_speculative_flush();
+		}
+		else
+		{
+			baseclass::on_miss();
+		}
+
+		if (!exists())
+		{
+			// A DMA section is written by the blit engine through dma_transfer only.
+			mark_keep_memory("readback-dma", "DMA-only");
+			return;
+		}
+
+		mtl::image* locked_resource = vram_texture;
+		u32 transfer_width = width;
+		u32 transfer_height = height;
+		u32 transfer_x = 0, transfer_y = 0;
+
+		if (context == rsx::texture_upload_context::framebuffer_storage)
+		{
+			auto surface = as_rtt(vram_texture);
+			surface->memory_barrier(cmd, rsx::surface_access::transfer_read);
+			locked_resource = surface->get_surface(rsx::surface_access::transfer_read);
+			transfer_width *= surface->samples_x;
+			transfer_height *= surface->samples_y;
+
+			// M4: VK reads a multisampled surface back from its resolve image (resolved by the barrier). Without one (its
+			// allocation or resolve pass failed, counted there) the samples are not read: the guest memory is kept.
+			if (locked_resource->samples() > 1)
+			{
+				mark_keep_memory("readback-msaa", "unresolved multisampled");
+				return;
+			}
+			// M4 end
+		}
+
+		mtl::image* target = locked_resource;
+		if (transfer_width != locked_resource->width() || transfer_height != locked_resource->height())
+		{
+			// VK copy_texture: scaled into a typeless helper first, linear for colour, nearest for depth.
+			auto engine = get_blit_engine();
+			target = engine ? engine->get_typeless_helper(cmd, locked_resource->format(), locked_resource->format_class(), transfer_width, transfer_height, 4) : nullptr;
+			const areai full_src = { 0, 0, static_cast<s32>(locked_resource->width()), static_cast<s32>(locked_resource->height()) };
+			const areai full_dst = { 0, 0, static_cast<s32>(transfer_width), static_cast<s32>(transfer_height) };
+			const auto filter = (locked_resource->aspect() == aspect_color) ? blit_filter::linear : blit_filter::nearest;
+			if (!target || !copy_scaled_image(cmd, locked_resource, target, full_src, full_dst, 0, 0, 0, true, filter))
+			{
+				mark_keep_memory("readback-scaled", "scaled");
+				return;
+			}
+			get_texture_counters().scaled_readbacks++;
+		}
+
+		const u32 internal_bpp = get_format_texel_width(vram_texture->format());
+		const auto valid_range = get_confirmed_range();
+		if (!internal_bpp || !rsx_pitch)
+		{
+			mark_keep_memory("readback-format", "unknown-format");
+			return;
+		}
+
+		if (const auto section_range = get_section_range(); section_range != valid_range)
+		{
+			if (const auto offset = (valid_range.start - get_section_base()))
+			{
+				transfer_y = offset / rsx_pitch;
+				transfer_x = (offset % rsx_pitch) / internal_bpp;
+
+				ensure(transfer_width >= transfer_x);
+				ensure(transfer_height >= transfer_y);
+				transfer_width -= transfer_x;
+				transfer_height -= transfer_y;
+			}
+
+			if (const auto tail = (section_range.end - valid_range.end))
+			{
+				const auto row_count = tail / rsx_pitch;
+
+				ensure(transfer_height >= row_count);
+				transfer_height -= row_count;
+			}
+		}
+
+		areai src_area;
+		src_area.x1 = static_cast<s32>(transfer_x);
+		src_area.y1 = static_cast<s32>(transfer_y);
+		src_area.x2 = static_cast<s32>(transfer_x + transfer_width);
+		src_area.y2 = static_cast<s32>(transfer_y + transfer_height);
+		dma_transfer(cmd, target, src_area, valid_range, rsx_pitch);
+	}
+
+	void cached_texture_section::dma_transfer(command_context& cmd, mtl::image* src, const areai& src_area, const utils::address_range32& valid_range, u32 pitch)
+	{
+		// VKTextureCache.cpp dma_transfer: the region of the image, in guest layout, from valid_range.start on.
+		auto& counters = get_texture_counters();
+		m_converted = false;
+		if (!src || src_area.is_flipped() || src_area.x1 < 0 || src_area.y1 < 0 || src_area.x2 <= src_area.x1 || src_area.y2 <= src_area.y1)
+		{
+			mark_keep_memory("readback-area", "empty or flipped");
+			return;
+		}
+
+#ifdef RPCS3_IOS
+		// REWINDBOX_TEXTURE_LOOKUP_MEMO_660: rsx_pitch is read by pitch_compatible() on the exact lookup paths.
+		if (pitch != rsx_pitch)
+		{
+			ios_memo_changed();
+		}
+#endif
+		rsx_pitch = pitch;
+
+		const pixel_format format = src->format();
+		const u32 guest_bpp = get_format_texel_width(format);
+		u32 plane_bpp = get_texel_size(format);
+		readback_mode mode = readback_mode::copy;
+		switch (format)
+		{
+		case pixel_format::depth16_unorm: mode = readback_mode::depth16; break;
+		case pixel_format::depth32_float: mode = readback_mode::depth16_float; plane_bpp = 4; break;
+		case pixel_format::depth32_float_stencil8: mode = readback_mode::depth24; plane_bpp = 4; break;
+		default: break;
+		}
+
+		if (!guest_bpp || !plane_bpp || is_compressed_format(format))
+		{
+			mark_keep_memory("readback-format", "compressed or unknown-format");
+			return;
+		}
+
+		const u32 transfer_width = static_cast<u32>(src_area.width());
+		const u32 transfer_height = static_cast<u32>(src_area.height());
+		if (u64{static_cast<u32>(src_area.x2)} > src->width() || u64{static_cast<u32>(src_area.y2)} > src->height())
+		{
+			mark_keep_memory("readback-bounds", "out-of-bounds");
+			return;
+		}
+
+		m_mode = mode;
+		m_depth_float = src->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32;
+		m_transfer_width = transfer_width;
+		m_transfer_height = transfer_height;
+		m_guest_bpp = guest_bpp;
+		m_element_size = get_format_element_size(format).first;
+		m_origin = valid_range.start;
+
+		// Layout of the buffer: [guest layout of the region, real_pitch rows | the plane(s) as the GPU copied them].
+		real_pitch = guest_bpp * transfer_width;
+		const u64 output_size = utils::align<u64>(static_cast<u64>(real_pitch) * transfer_height, 256);
+		const u64 plane_size = utils::align<u64>(static_cast<u64>(plane_bpp) * transfer_width * transfer_height, 256);
+		const u64 stencil_size = (mode == readback_mode::depth24) ? static_cast<u64>(transfer_width) * transfer_height : 0;
+		const u64 required = output_size + plane_size + stencil_size;
+		m_scratch_offset = output_size;
+		m_stencil_offset = output_size + plane_size;
+
+		if (!m_download || m_download_size < required)
+		{
+			if (m_download)
+			{
+				cmd.dispose(std::move(m_download), true);
+			}
+			m_download_size = utils::align<u64>(required, 4096);
+			m_download = new_buffer(cmd.device(), m_download_size, storage_mode::shared);
+			ensure(m_download, "Metal: readback buffer allocation failed");
+			cmd.make_resident(m_download);
+		}
+
+		const region area{ { static_cast<u32>(src_area.x1), static_cast<u32>(src_area.y1), 0 }, { transfer_width, transfer_height, 1 } };
+		{
+			// Reads only (two planes go to distinct buffer regions).
+			transfer_scope scope(cmd, "texture readback");
+			const auto box = texture_box::make(0, 0, area.at.x, area.at.y, 0, transfer_width, transfer_height);
+			if (mode == readback_mode::depth24)
+			{
+				copy_texture_to_buffer(scope.for_read(src->texture, box), src->texture, 0, 0, area, m_download, m_scratch_offset, transfer_width * 4, 0, blit_depth_from_depth_stencil);
+				copy_texture_to_buffer(scope.for_read(src->texture, box), src->texture, 0, 0, area, m_download, m_stencil_offset, transfer_width, 0, blit_stencil_from_depth_stencil);
+			}
+			else
+			{
+				copy_texture_to_buffer(scope.for_read(src->texture, box), src->texture, 0, 0, area, m_download, m_scratch_offset, transfer_width * plane_bpp, 0);
+			}
+		}
+
+		m_fence = cmd.recording_value();
+		cmd.set_dma_transfer();
+		counters.readbacks++;
+		counters.readback_bytes += static_cast<u64>(real_pitch) * transfer_height;
+
+		if (context == rsx::texture_upload_context::dma)
+		{
+			// Save readback hint in case transformation is required later (VK)
+			gcm_format = (guest_bpp == 2) ? CELL_GCM_TEXTURE_R5G6B5 : CELL_GCM_TEXTURE_A8R8G8B8;
+		}
+
+		synchronized = true;
+		sync_timestamp = rsx::get_shared_tag();
+
+		// Review R1: every copy is recorded under the texture cache lock. Outside a flush batch (whose cleanup submits
+		// before the lock goes) it is submitted now, so no other thread taking the lock ever sees a fence that still
+		// depends on the RSX thread's progress: a write-back on a guest thread only waits for the GPU.
+		if (!static_cast<mtl::texture_cache*>(m_tex_cache)->in_dma_batch())
+		{
+			cmd.submit_and_continue();
+		}
+	}
+
+	void cached_texture_section::convert_readback(u8* base)
+	{
+		const u8* scratch = base + m_scratch_offset;
+		const u32 w = m_transfer_width;
+		const bool swap = pack_unpack_swap_bytes;
+
+		for (u32 y = 0; y < m_transfer_height; ++y)
+		{
+			u8* out = base + static_cast<usz>(y) * real_pitch;
+			switch (m_mode)
+			{
+			case readback_mode::copy:
+			{
+				const usz row = static_cast<usz>(w) * m_guest_bpp;
+				std::memcpy(out, scratch + y * row, row);
+				if (swap && m_element_size == 2)
+				{
+					byteswap_elements<u16>(out, row);
+				}
+				else if (swap && m_element_size == 4)
+				{
+					byteswap_elements<u32>(out, row);
+				}
+				break;
+			}
+			case readback_mode::depth16:
+			{
+				const u16* in = reinterpret_cast<const u16*>(scratch) + static_cast<usz>(y) * w;
+				for (u32 x = 0; x < w; ++x)
+				{
+					const u16 value = swap ? swap16(in[x]) : in[x];
+					std::memcpy(out + x * 2, &value, 2);
+				}
+				break;
+			}
+			case readback_mode::depth16_float:
+			{
+				const u32* in = reinterpret_cast<const u32*>(scratch) + static_cast<usz>(y) * w;
+				for (u32 x = 0; x < w; ++x)
+				{
+					const u16 packed = f32_bits_to_e4m12(in[x]);
+					const u16 value = swap ? swap16(packed) : packed;
+					std::memcpy(out + x * 2, &value, 2);
+				}
+				break;
+			}
+			case readback_mode::depth24:
+			{
+				const u32* depth = reinterpret_cast<const u32*>(scratch) + static_cast<usz>(y) * w;
+				const u8* stencil = base + m_stencil_offset + static_cast<usz>(y) * w;
+				for (u32 x = 0; x < w; ++x)
+				{
+					const u32 d24 = m_depth_float ? f32_bits_to_d24f(depth[x]) : f32_to_d24(std::bit_cast<f32>(depth[x]));
+					const u32 packed = (d24 << 8) | stencil[x];
+					const u32 value = swap ? swap32(packed) : packed;
+					std::memcpy(out + x * 4, &value, 4);
+				}
+				break;
+			}
+			default:
+				break;
+			}
+		}
+	}
+
+	u8* cached_texture_section::finish_readback()
+	{
+		ensure(m_download && m_fence);
+		command_context* ctx = ensure(get_command_context());
+		if (m_fence > ctx->last_submitted())
+		{
+			// Unreachable by construction (dma_transfer submits before the cache lock is released, a flush batch
+			// submits in cleanup_after_dma_transfers, and a guest thread that sees an unsubmitted copy hands its
+			// fault to the RSX thread before taking the lock). Waiting here for the RSX thread could deadlock (this
+			// thread may hold the cache lock) and returning anything would return unflushed data.
+			get_texture_counters().readbacks_unsubmitted++;
+			log_once("readback-unsubmitted", "a write-back found its GPU copy unsubmitted");
+			ensure(rsx::get_current_renderer()->is_current_thread(), "Metal: a write-back off the RSX thread found its GPU copy unsubmitted");
+			ctx->submit_and_wait();
+		}
+
+		// Only GPU completion: the copy is submitted.
+		ctx->wait(m_fence);
+
+		u8* base = static_cast<u8*>(buffer_contents(m_download));
+		if (!m_converted)
+		{
+			convert_readback(base);
+			m_converted = true;
+		}
+		return base;
+	}
+
+	void* cached_texture_section::map_synchronized(u32 offset, u32 size)
+	{
+		// The common imp_flush is replaced (imp_flush below); this keeps its contract for completeness.
+		ensure(synchronized && m_mode != readback_mode::keep_memory);
+		u8* base = finish_readback();
+		ensure(u64{offset} + size <= m_scratch_offset);
+		return base + offset;
+	}
+
+	void cached_texture_section::write_guest(u32 address, const u8* src, u32 length) const
+	{
+		// imp_flush_memcpy: through the unprotected mirror, skipping the flush exclusions.
+		u8* dst = vm::get_super_ptr<u8>(address);
+		const auto copy_range = utils::address_range32::start_length(address, length);
+		if (flush_exclusions.empty() || !copy_range.overlaps(flush_exclusions))
+		{
+			std::memcpy(dst, src, length);
+			return;
+		}
+
+		if (copy_range.inside(flush_exclusions))
+		{
+			return;
+		}
+
+		rsx::address_range_vector32 vec;
+		vec.merge(copy_range);
+		vec.exclude(flush_exclusions);
+		for (const auto& rng : vec)
+		{
+			if (!rng.valid())
+			{
+				continue;
+			}
+
+			const u32 offset = rng.start - address;
+			std::memcpy(dst + offset, src + offset, rng.length());
+		}
+	}
+
+	void cached_texture_section::imp_flush()
+	{
+		AUDIT(synchronized);
+
+		if (m_mode == readback_mode::keep_memory)
+		{
+			// Counted when the copy was refused: the guest memory keeps its contents.
+			return;
+		}
+
+		u8* base = finish_readback();
+		const auto valid_range = get_confirmed_range();
+
+		if (const auto tiled_region = rsx::get_current_renderer()->get_tiled_memory_region(valid_range))
+		{
+			// VK encodes the tiling on the GPU (cs_tile_memcpy<encode>) into a copy of the tile rows it then writes
+			// back whole. Here each texel goes to its tiled address in guest memory (the common tiling helper, the
+			// CPU port of the same shader), so no other byte of the tile is rewritten. Like VK, flush exclusions do
+			// not apply to tiled data.
+			const auto& tile = *tiled_region.tile;
+			if (!tiled_copy(tiled_region.base_address, tile.size, tile.pitch, tile.bank, m_origin, base, real_pitch,
+				m_transfer_width, m_transfer_height, m_guest_bpp, true))
+			{
+				get_texture_counters().readbacks_not_implemented++;
+				log_once("readback-tile-pitch", fmt::format("tiled readback with pitch 0x%x is not implemented: the guest memory keeps its contents", tile.pitch));
+				return;
+			}
+
+			get_texture_counters().tiled_readbacks++;
+			return;
+		}
+
+		// Linear: each row of the region at its guest address, within the confirmed range.
+		for (u32 row = 0; row < m_transfer_height; ++row)
+		{
+			const u32 address = m_origin + row * rsx_pitch;
+			const auto row_range = utils::address_range32::start_length(address, real_pitch);
+			const auto clipped = row_range.get_intersect(valid_range);
+			if (!clipped.valid())
+			{
+				continue;
+			}
+
+			write_guest(clipped.start, base + static_cast<usz>(row) * real_pitch + (clipped.start - address), clipped.length());
+		}
+	}
+
