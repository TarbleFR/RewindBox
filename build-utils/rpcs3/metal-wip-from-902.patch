+		return compute_aligned_div(data_length, compute_optimal_group_size * compute_optimal_kernel_size * 4);
+	}
+
+	// The dispatch of `invocations` threads in groups of `group_size` (VK compute_task::run), in two dimensions when one
+	// would exceed `max_groups_x` (compute_task::run(cmd, num_invocations), rounded up so that every group is covered:
+	// the kernels' invocation index is linear and bounded, extra groups do nothing).
+	struct dispatch_size
+	{
+		size3 groups{ 0, 1, 1 };
+		size3 threads{ 1, 1, 1 };
+	};
+
+	inline dispatch_size get_dispatch_size(u32 invocations, u32 group_size, u32 max_groups_x = 65535)
+	{
+		dispatch_size size{};
+		group_size = group_size ? group_size : 1;
+		size.threads = { group_size, 1, 1 };
+
+		const u32 groups = compute_aligned_div(invocations, group_size);
+		if (groups <= max_groups_x)
+		{
+			size.groups = { groups, 1, 1 };
+			return size;
+		}
+
+		u32 x = 1;
+		while (static_cast<u64>(x + 1) * (x + 1) <= groups && x < max_groups_x)
+		{
+			x++;
+		}
+		size.groups = { x, compute_aligned_div(groups, x), 1 };
