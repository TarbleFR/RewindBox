+
+#include "Emu/RSX/Overlays/overlay_manager.h"
+#include "Emu/system_config.h"
+#include "Emu/system_utils.hpp"
+
+#include <array>
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		std::array<std::atomic<bool>, static_cast<usz>(m4_failure::count)> g_reported_failures{};
+	}
+
+	m4_counters& get_m4_counters() noexcept
+	{
+		static m4_counters s_counters;
+		return s_counters;
+	}
+
+	bool m4_first_failure(m4_failure kind) noexcept
+	{
+		return !g_reported_failures[static_cast<usz>(kind)].exchange(true, std::memory_order_relaxed);
+	}
+}
+
+void MTLGSRender::init_m4_config()
+{
+	// As the Vulkan renderer when MSAA is not disabled: multisampling, alpha to coverage (also at one sample) and alpha to
+	// one (MoltenVK reports it) are the GPU's. Surfaces are multisampled at the "Auto" level (MTLRenderTargets.cpp).
+	const bool msaa_enabled = g_cfg.video.antialiasing_level != msaa_level::none;
+	backend_config.supports_hw_msaa = msaa_enabled;
+	backend_config.supports_hw_a2c = msaa_enabled;
+	backend_config.supports_hw_a2c_1spp = msaa_enabled;
+	backend_config.supports_hw_a2one = msaa_enabled;
+
+	// The native interface (message, save data, trophy and OSK dialogs, notices, the performance overlay). rsx::thread
+	// creates its display manager for the OpenGL and Vulkan renderers only (with the same boot music); the Metal renderer
+	// draws it as well.
+	if (g_cfg.misc.use_native_interface && !m_overlay_manager)
+	{
+		m_overlay_manager = g_fxo->init<rsx::overlays::display_manager>(0);
+		if (!m_overlay_manager)
+		{
+			m_overlay_manager = g_fxo->try_get<rsx::overlays::display_manager>();
+		}
+		else if (g_cfg.misc.play_music_during_boot)
+		{
+			if (const std::string audio_path = rpcs3::utils::get_game_content_path(game_content_type::content_sound); !audio_path.empty())
+			{
+				m_overlay_manager->start_audio(audio_path);
+			}
+		}
+	}
+}
+
+void MTLGSRender::init_m4()
+{
+	init_queries();
+
+	std::string error;
+	if (m_resolver.create(m_commands, m_compiler, error))
+	{
+		mtl::set_msaa_resolver(&m_resolver);
+	}
+	else if (mtl::m4_first_failure(mtl::m4_failure::resolve_pipeline))
+	{
+		// Every resolve or unresolve is then counted as not executed (resolve_failures).
+		rsx_log.error("Metal M4: the MSAA resolve library is unavailable: %s (counted in COREPROF METAL M4)", error);
+	}
+
+	error.clear();
+	const auto write_params = [this](const void* data, u32 size) -> std::pair<mtl::object, u64>
+	{
+		auto& ring = m_rings[ring_push_constants];
+		const usz offset = ring.alloc<32>(size);
+		std::memcpy(ring.map(offset), data, size);
+		return { ring.buffer, offset };
+	};
+
+	if (m_compute_tasks.create(m_device, m_compiler, write_params, error))
+	{
+		mtl::set_compute_tasks(&m_compute_tasks);
+	}
+	else
+	{
+		rsx_log.error("Metal M4: the conversion kernels are unavailable: %s (every task is counted as not executed)", error);
+	}
+
+	if (m_overlay_manager)
+	{
+		error.clear();
+		if (!m_overlay_renderer.create(m_device, m_compiler, !g_cfg.video.disable_msl_fast_math, error) &&
+			mtl::m4_first_failure(mtl::m4_failure::overlay_pipeline))
+		{
+			// The views are then counted and not drawn (overlay_failures); the guest's dialogs keep working.
+			rsx_log.error("Metal M4: the overlay pipeline is unavailable: %s (counted in COREPROF METAL M4)", error);
+		}
+	}
+
+	rsx_log.notice("Metal 4 renderer M4: occlusion queries (%u visibility slots), MSAA %s (resolve passes %s), conversion kernels %s, overlays %s",
+		query_slot_count, backend_config.supports_hw_msaa ? "on" : "off", m_resolver.ready() ? "ready" : "unavailable",
+		m_compute_tasks.ready() ? "ready" : "unavailable", m_overlay_manager ? (m_overlay_renderer.ready() ? "ready" : "unavailable") : "off");
+}
+
+void MTLGSRender::destroy_m4()
+{
+	m_overlay_renderer.destroy(m_commands);
+
+	mtl::set_compute_tasks(nullptr);
+	m_compute_tasks.destroy();
+
+	mtl::set_msaa_resolver(nullptr);
+	m_resolver.destroy(m_commands);
+
+	destroy_queries();
+}
+
+void MTLGSRender::prepare_overlays(const areau& image_area)
+{
+	m_overlay_renderer.clear_prepared();
+
+	if (!m_overlay_manager)
+	{
+		return;
+	}
+
+	// VKGSRender frame cleanup: the images of the overlays that were closed
+	if (m_overlay_manager->has_dirty())
+	{
+		m_overlay_manager->lock_shared();
+
+		std::vector<u32> uids_to_dispose;
+		uids_to_dispose.reserve(m_overlay_manager->get_dirty().size());
+
+		for (const auto& view : m_overlay_manager->get_dirty())
+		{
+			m_overlay_renderer.remove_temp_resources(m_commands, view->uid);
+			uids_to_dispose.push_back(view->uid);
+		}
+
+		m_overlay_manager->unlock_shared();
+		m_overlay_manager->dispose(uids_to_dispose);
+	}
+
+	if (!m_overlay_manager->has_visible())
+	{
+		return;
+	}
+
+	// VKGSRender render_overlays: window-space views cover the drawable, the others the presented image.
+	std::lock_guard lock(*m_overlay_manager);
+
+	const areau display_area = { 0, 0, m_drawable_width, m_drawable_height };
+	for (const auto& view : m_overlay_manager->get_views())
+	{
+		const areau render_area = view->use_window_space ? display_area : image_area;
+		m_overlay_renderer.prepare(m_commands, m_rings[ring_attrib], render_area, m_drawable_width, m_drawable_height, *view.get());
+	}
+
+	mtl::m4_count(mtl::get_m4_counters().overlay_frames);
+}
+
+void MTLGSRender::report_m4_counters()
+{
+	const auto& m = mtl::get_m4_counters();
+	const auto load = [](const std::atomic<u64>& value) { return value.load(std::memory_order_relaxed); };
+
+	rsx_log.notice("COREPROF METAL M4 queries=%llu segments=%llu results=%llu discards=%llu hard_syncs=%llu gpu_waits=%llu hint_flushes=%llu "
+		"slot_exhaustions=%llu folded=%llu slots_free=%u slots_pending=%u | msaa_surfaces=%llu resolves=%llu unresolves=%llu "
+		"resolve_failures=%llu msaa_alloc_failures=%llu msaa_feedback_direct=%llu | compute=%llu compute_failures=%llu typeless_copies=%llu | overlay_frames=%llu overlay_views=%llu "
+		"overlay_draws=%llu overlay_failures=%llu",
+		load(m.queries_begun), load(m.query_segments), load(m.query_results), load(m.query_discards), load(m.query_hard_syncs),
+		load(m.query_gpu_waits), load(m.query_hint_flushes), load(m.query_slot_exhaustions), load(m.query_folded_segments),
+		m_query_slots.available(), m_query_slots.pending(),
+		load(m.msaa_surfaces), load(m.resolves), load(m.unresolves), load(m.resolve_failures), load(m.msaa_allocation_failures), load(m.msaa_feedback_direct),
+		load(m.compute_dispatches), load(m.compute_failures), load(m.typeless_copies),
+		load(m.overlay_frames), load(m.overlay_views), load(m.overlay_draws), load(m.overlay_failures));
+}
