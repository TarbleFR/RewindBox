+mtl::image_view* MTLGSRender::snapshot_if_attachment(mtl::image_view* view)
+{
+	// Same-pass feedback: a unit samples an attachment of the pass this draw renders into. Apple GPUs keep the
+	// attachment in tile memory during the pass, so the texture memory is stale until the pass stores it. The pass
+	// is ended (stored), the attachment is copied after a queue barrier, and the unit samples the copy: it sees
+	// every write made before this draw, which is what the RSX texture barrier guarantees.
+	mtl::image* source = view->image();
+	bool attached = false;
+	for (const auto& [address, surface] : m_rtts.m_bound_render_targets)
+	{
+		attached = attached || (surface && static_cast<mtl::image*>(surface) == source);
+	}
+	if (auto ds = std::get<1>(m_rtts.m_bound_depth_stencil); ds && static_cast<mtl::image*>(ds) == source)
+	{
+		attached = true;
+	}
+
+	if (!attached)
+	{
+		return view;
+	}
+
+	// M4: the common texture cache samples a multisampled render target through its resolve image (strict sampling
+	// with MSAA), never in its own pass; should one get here, it is sampled directly (counted, logged once).
+	if (source->samples() > 1)
+	{
+		mtl::m4_count(mtl::get_m4_counters().msaa_feedback_direct);
+		mtl::log_once("snapshot-msaa", "a multisampled attachment sampled in its own pass is sampled without a snapshot");
+		return view;
+	}
+	// M4 end
+
+	mtl::image* copy = nullptr;
+	for (const auto& [from, to] : m_draw_snapshots)
+	{
+		if (from == source)
+		{
+			copy = to;
+		}
+	}
+
+	if (!copy)
+	{
+		// A pool image of the same format and size that this draw does not use yet.
+		for (auto& candidate : m_snapshot_pool)
+		{
+			const bool in_use = std::any_of(m_draw_snapshots.begin(), m_draw_snapshots.end(), [&](const auto& entry) { return entry.second == candidate.get(); });
+			if (!in_use && candidate->format() == source->format() && candidate->width() == source->width() && candidate->height() == source->height())
+			{
+				copy = candidate.get();
+				break;
+			}
+		}
+
+		if (!copy)
+		{
+			mtl::texture_descriptor desc{};
+			desc.type = mtl::texture_type::type_2d;
+			desc.format = source->format();
+			desc.width = source->width();
+			desc.height = source->height();
+			desc.usage = mtl::usage_shader_read | mtl::usage_pixel_format_view;
+			desc.storage = mtl::storage_mode::private_;
+			auto created = std::make_unique<mtl::image>();
+			if (!created->create(m_commands, desc, source->format_class()))
+			{
+				mtl::log_once("snapshot", "feedback snapshot allocation failed: the attachment is sampled directly");
+				return view;
+			}
+			created->set_name("feedback snapshot");
+			copy = created.get();
+			m_snapshot_pool.push_back(std::move(created));
+		}
+
+		copy->image_format_class = source->format_class();
+		copy->set_native_component_layout(source->native_component_map);
+		mtl::copy_texture(m_commands.compute("feedback snapshot"), source->texture, 0, 0, { { 0, 0, 0 }, { source->width(), source->height(), 1 } },
+			copy->texture, 0, 0, {});
+		m_commands.end_encoder();
+		m_draw_snapshots.emplace_back(source, copy);
+		mtl::get_texture_counters().feedback_snapshots++;
+	}
+
+	// The same view (format, swizzle, aspect) of the copy.
+	{
+		mtl::component_map swizzle{};
+		for (u32 c = 0; c < 4; ++c)
+		{
+			swizzle[c] = static_cast<mtl::swizzle>(view->descriptor().swizzle[c]);
+		}
+		const u64 key = (static_cast<u64>(view->aspect()) << 56) | (static_cast<u64>(static_cast<u32>(view->format()) & 0xffff) << 40) |
+			(static_cast<u64>(swizzle[0]) << 12) | (static_cast<u64>(swizzle[1]) << 8) | (static_cast<u64>(swizzle[2]) << 4) | static_cast<u64>(swizzle[3]) | (1ull << 63);
+		auto result = copy->get_view(view->format(), swizzle, view->aspect(), key);
+		return result ? result : view;
+	}
+}
