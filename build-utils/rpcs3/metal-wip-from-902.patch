+	// M4: compute pipelines and dispatches.
+	RBX_METAL4 object new_compute_pipeline(const object& compiler, const object& library, std::string_view function, std::string_view label, std::string& error)
+	{
+		@autoreleasepool
+		{
+			MTL4LibraryFunctionDescriptor* entry = [[MTL4LibraryFunctionDescriptor alloc] init];
+			entry.library = as<id<MTLLibrary>>(library);
+			entry.name = string(function);
+
+			MTL4ComputePipelineDescriptor* desc = [[MTL4ComputePipelineDescriptor alloc] init];
+			desc.computeFunctionDescriptor = entry;
+			if (!label.empty())
+			{
+				desc.label = string(label);
+			}
+
+			NSError* failure = nil;
+			const id<MTLComputePipelineState> pipeline = [as<id<MTL4Compiler>>(compiler) newComputePipelineStateWithDescriptor:desc
+				compilerTaskOptions:nil error:&failure];
+			if (!pipeline)
+			{
+				error = describe(failure);
+			}
+			return keep(pipeline);
+		}
+	}
+
+	compute_pipeline_info query_compute_pipeline(const object& pipeline)
