+	// Staging memory for a transfer: the ring, or a dedicated shared buffer released after the submission.
+	struct staging_allocation
+	{
+		object buffer;
+		u64 offset = 0;
+		u8* data = nullptr;
+	};
+
+	staging_allocation allocate_staging(command_context& ctx, data_heap& heap, u64 size);
+
+	// RSX memory tiling on the CPU (Common/tiled_dma_copy.hpp, the port of the Vulkan renderer's cs_tile_memcpy): the
+	// texels of a width x height region whose first texel is at guest address `origin` inside a tiled region, between
+	// their tiled addresses in guest memory (through the unprotected mirror) and a linear buffer with rows linear_pitch
+	// apart. encode: linear -> guest memory (only the texels' own bytes are written); decode: guest memory -> linear.
+	// False for a tile pitch the tiling helper does not know (nothing is copied).
+	bool tiled_copy(u32 tile_base, u32 tile_size, u32 tile_pitch, u8 tile_bank, u32 origin, u8* linear, u32 linear_pitch,
+		u32 width, u32 height, u32 bpp, bool encode);
+
+	// The transfers of one helper in compute encoders. Metal 4 may run the commands of one encoder concurrently, so
+	// a copy that writes a region an earlier copy of the encoder reads or writes, or reads a region an earlier copy
+	// writes, starts a new encoder: its queue barrier waits for the earlier copies (in submission order, so the
+	// newer data lands last, as the texture cache's oldest-first ordering requires). Depth and stencil planes of one
+	// texture count as one region. Buffer hazards are ordered by the caller (split()). The destructor ends the
+	// encoder, so the next user of these textures is ordered after them too.
+	class transfer_scope
+	{
+	public:
+		transfer_scope(command_context& ctx, std::string_view label);
+		~transfer_scope();
+
+		transfer_scope(const transfer_scope&) = delete;
+		transfer_scope& operator=(const transfer_scope&) = delete;
+
+		// The encoder for a copy reading src_box of src (if any) and writing dst_box of dst (if any).
+		const object& encoder(const object* src, const texture_box& src_box, const object* dst, const texture_box& dst_box);
+		const object& for_write(const object& dst, const texture_box& dst_box) { return encoder(nullptr, {}, &dst, dst_box); }
+		const object& for_read(const object& src, const texture_box& src_box) { return encoder(&src, src_box, nullptr, {}); }
+
+		// Ends the encoder (a later copy depends on an earlier one through a buffer).
+		void split();
+
+		u32 encoders_split() const { return m_splits; }
+
+	private:
+		struct access
+		{
+			const void* texture;
+			texture_box box;
+			bool write;
+		};
+
+		bool conflicts(const void* texture, const texture_box& box, bool write) const;
+
+		command_context& m_ctx;
+		std::string m_label;
+		const void* m_encoder = nullptr;
+		std::vector<access> m_accesses;
+		u32 m_splits = 0;
+	};
+}
