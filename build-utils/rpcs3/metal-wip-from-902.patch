+		return { src_length, src_offset - bound_offset, dst_offset - bound_offset, ssbo_length / 4 };
+	}
+
+	class compute_tasks
+	{
+	public:
+		// Writes `size` bytes of parameters into GPU-visible memory; returns the buffer and offset. Called before the
+		// task's encoder is opened (it may submit to make room).
+		using param_writer = std::function<std::pair<object, u64>(const void* data, u32 size)>;
