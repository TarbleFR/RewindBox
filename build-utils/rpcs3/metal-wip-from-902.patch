diff --git a/rpcs3/Emu/RSX/Metal/MTLQueries.cpp b/rpcs3/Emu/RSX/Metal/MTLQueries.cpp
new file mode 100644
index 0000000..332b3aa
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLQueries.cpp
@@ -0,0 +1,408 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): ZCULL occlusion queries of the native Metal 4 renderer (see MTLQueries.h), and what the
+// Vulkan renderer does around them: ZCULL sync hints, report pages, semaphore waits and native UI flips.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/system_config.h"
+
+#include <atomic>
+#include <cstring>
+
+namespace
+{
+	bool precise_zpass_count()
+	{
+		return !!g_cfg.video.precise_zpass_count;
+	}
+}
+
+void MTLGSRender::init_queries()
+{
+	m_query_buffer = mtl::new_buffer(m_device, static_cast<u64>(query_slot_count) * sizeof(u64), mtl::storage_mode::shared);
+	ensure(m_query_buffer, "Metal visibility result buffer");
+	std::memset(mtl::buffer_contents(m_query_buffer), 0, static_cast<usz>(query_slot_count) * sizeof(u64));
+	m_commands.make_resident(m_query_buffer);
+
+	m_query_slots.reset(query_slot_count);
+	m_query_records.assign(rsx::reports::occlusion_query_count, {});
+
+	// VKGSRender::VKGSRender: each RSX query slot names its record.
+	for (u32 n = 0; n < rsx::reports::occlusion_query_count; ++n)
+	{
+		m_occlusion_query_data[n].driver_handle = n;
+	}
+}
+
+void MTLGSRender::destroy_queries()
+{
+	m_query_records.clear();
+	m_query_slots.reset(0);
+	m_commands.dispose(std::move(m_query_buffer), true);
+	m_active_query_info = nullptr;
+	m_occlusion_query_active = false;
+	m_query_segment_pass = 0;
+}
+
+u64 MTLGSRender::query_slot_value(u32 slot) const
+{
+	// Read after the submission that writes the slot has signalled (an acquire fence follows every completion read).
+	return static_cast<const volatile u64*>(mtl::buffer_contents(m_query_buffer))[slot];
+}
+
+bool MTLGSRender::query_segment_open() const
+{
+	return m_query_segment_pass && m_commands.kind() == mtl::command_context::encoder_kind::render &&
+		m_commands.render_pass_id() == m_query_segment_pass;
+}
+
+void MTLGSRender::release_query_record(mtl::occlusion_record& record)
+{
+	// A slot becomes reusable once the submission that writes it has completed.
+	for (const auto& segment : record.segments)
+	{
+		ensure(m_query_slots.release(segment.slot, segment.fence));
+	}
+	record.clear();
+}
+
+void MTLGSRender::fold_queries(bool all)
+{
+	const u64 completed = m_commands.completed();
+	std::atomic_thread_fence(std::memory_order_acquire);
+
+	const bool precise = precise_zpass_count();
+	const auto read = [this](u32 slot) { return query_slot_value(slot); };
+	const auto release = [this](u32 slot, u64 fence) { ensure(m_query_slots.release(slot, fence)); };
+
+	u32 folded = 0;
+	if (all)
+	{
+		for (auto& record : m_query_records)
+		{
+			if (!record.segments.empty())
+			{
+				folded += mtl::fold_completed(record, completed, precise, read, release);
+			}
+		}
+	}
+	else if (m_occlusion_query_active)
+	{
+		folded += mtl::fold_completed(m_query_records[m_active_query_info->driver_handle], completed, precise, read, release);
+	}
+
+	m_query_slots.collect(completed);
+	if (folded)
+	{
+		mtl::m4_count(mtl::get_m4_counters().query_folded_segments, folded);
+	}
+}
+
+bool MTLGSRender::reserve_query_slot()
+{
+	if (!m_occlusion_query_active)
+	{
+		return true;
+	}
+
+	const auto& record = m_query_records[m_active_query_info->driver_handle];
+	if (record.decided(precise_zpass_count()) || (query_segment_open() && !m_render_pass_dirty))
+	{
+		// No new segment: the value is known, or this encoder keeps counting.
+		return true;
+	}
+
+	if (m_query_slots.available() || m_query_slots.collect(m_commands.completed()))
+	{
+		return true;
+	}
+
+	// VKDraw.cpp emit_geometry: out of free occlusion slots, a ZCULL hard sync retires the pending reports.
+	mtl::m4_count(mtl::get_m4_counters().query_slot_exhaustions);
+	if (mtl::m4_first_failure(mtl::m4_failure::query_slots_exhausted))
+	{
+		rsx_log.warning("[Performance Warning] Out of free occlusion slots. Forcing hard sync. (Metal M4: logged once, counted in COREPROF METAL M4)");
+	}
+
+	ZCULL_control::sync(this);
+	if (m_query_slots.collect(m_commands.completed()) || m_query_slots.available())
+	{
+		return true;
+	}
+
+	// Where the Vulkan renderer would force a result of 1: every recorded segment completes, and the completed prefix of
+	// each query is read now (the same additions, in the gather's order) and its slots freed.
+	flush_command_queue(true);
+	fold_queries(true);
+	return m_query_slots.available() > 0;
+}
+
+void MTLGSRender::begin_query_segment(const mtl::object& encoder)
+{
+	if (!m_occlusion_query_active)
+	{
+		return;
+	}
+
+	auto& record = m_query_records[m_active_query_info->driver_handle];
+	const u64 fence = m_commands.last_submitted() + 1;  // the submission being recorded
+
+	// VK set_sync_command_buffer / cb_has_occlusion_task: the query now has work in this command buffer.
+	record.last_fence = fence;
+	m_query_cb_fence = fence;
+
+	if (record.decided(precise_zpass_count()) || query_segment_open())
+	{
+		return;
+	}
+
+	const u32 slot = m_query_slots.allocate();
+	ensure(slot != umax, "Metal: no visibility slot after reserve_query_slot");
+
+	// Not written by the GPU any more (its submission completed): zeroed, then accumulated into by this encoder.
+	static_cast<volatile u64*>(mtl::buffer_contents(m_query_buffer))[slot] = 0;
+
+	record.segments.push_back({ slot, fence });
+	record.has_data = true;
+	mtl::set_visibility_result_mode(encoder, mtl::visibility_result_mode::counting, static_cast<u64>(slot) * sizeof(u64));
+	m_query_segment_pass = m_render_pass_serial;
+	mtl::m4_count(mtl::get_m4_counters().query_segments);
+}
+
+void MTLGSRender::suspend_query_segment()
+{
+	if (query_segment_open())
+	{
+		mtl::set_visibility_result_mode(m_commands.encoder(), mtl::visibility_result_mode::disabled, 0);
+	}
+
+	m_query_segment_pass = 0;
+}
+
+void MTLGSRender::begin_occlusion_query(rsx::reports::occlusion_query_info* query)
+{
+	ensure(!m_occlusion_query_active);
+
+	query->result = 0;
+	m_active_query_info = query;
+	m_occlusion_query_active = true;
+	m_query_segment_pass = 0;
+
+	// The slot was freed by a read or a discard; nothing measured before belongs to this query.
+	auto& record = m_query_records[query->driver_handle];
+	if (record.has_data || !record.segments.empty())
+	{
+		release_query_record(record);
+	}
+
+	mtl::m4_count(mtl::get_m4_counters().queries_begun);
+}
+
+void MTLGSRender::end_occlusion_query(rsx::reports::occlusion_query_info* query)
+{
+	ensure(query == m_active_query_info);
+
+	// NOTE (VK): flushing the queue is very expensive, do not flush just because query stopped
+	suspend_query_segment();
+
+	m_occlusion_query_active = false;
+	m_active_query_info = nullptr;
+}
+
+bool MTLGSRender::check_occlusion_query_status(rsx::reports::occlusion_query_info* query)
+{
+	if (!query->num_draws)
+	{
+		return true;
+	}
+
+	const auto& record = m_query_records[query->driver_handle];
+	const u64 completed = m_commands.completed();
+	std::atomic_thread_fence(std::memory_order_acquire);
+
+	return mtl::occlusion_ready(record, m_commands.last_submitted(), completed, precise_zpass_count(),
+		[this](u32 slot) { return query_slot_value(slot); });
+}
+
+void MTLGSRender::get_occlusion_query_result(rsx::reports::occlusion_query_info* query)
+{
+	auto& record = m_query_records[query->driver_handle];
+	if (!record.has_data)
+	{
+		return;
+	}
+
+	if (query->num_draws)
+	{
+		if (record.last_fence > m_commands.last_submitted())
+		{
+			// The work is still being recorded: submit it (VK flush_command_queue + busy_wait)
+			mtl::m4_count(mtl::get_m4_counters().query_hard_syncs);
+			flush_command_queue(false);
+			m_zcull_flush_pending = false;
+
+			rsx_log.warning("[Performance warning] Unexpected ZCULL read caused a hard sync");
+		}
+
+		const auto wait = [this](u64 fence)
+		{
+			if (m_commands.completed() < fence)
+			{
+				mtl::m4_count(mtl::get_m4_counters().query_gpu_waits);
+				m_commands.wait(fence);
+			}
+			std::atomic_thread_fence(std::memory_order_acquire);
+		};
+
+		query->result += mtl::occlusion_gather(record, precise_zpass_count(), wait, [this](u32 slot) { return query_slot_value(slot); });
+		mtl::m4_count(mtl::get_m4_counters().query_results);
+	}
+
+	release_query_record(record);
+}
+
+void MTLGSRender::discard_occlusion_query(rsx::reports::occlusion_query_info* query)
+{
+	if (m_active_query_info == query)
+	{
+		end_occlusion_query(query);
+	}
+
+	auto& record = m_query_records[query->driver_handle];
+	if (!record.has_data)
+	{
+		return;
+	}
+
+	release_query_record(record);
+	mtl::m4_count(mtl::get_m4_counters().query_discards);
+}
+
+void MTLGSRender::sync_hint(rsx::FIFO::interrupt_hint hint, rsx::reports::sync_hint_payload_t payload)
+{
+	// VKGSRender::sync_hint
+	rsx::thread::sync_hint(hint, payload);
+
+	if (!m_commands.recording() || m_query_cb_fence != m_commands.last_submitted() + 1)
+	{
+		// Occlusion queries not enabled in the command buffer being recorded, do nothing
+		return;
+	}
+
+	// Occlusion test result evaluation is coming up, avoid a hard sync
+	switch (hint)
+	{
+	case rsx::FIFO::interrupt_hint::conditional_render_eval:
+	{
+		// If a flush request is already enqueued, do nothing
+		if (m_zcull_flush_pending)
+		{
+			return;
+		}
+
+		// If the result is not going to be read by CELL, do nothing
+		const auto ref_addr = static_cast<u32>(payload.address);
+		if (!zcull_ctrl->is_query_result_urgent(ref_addr))
+		{
+			// No effect on CELL behaviour, it will be faster to handle this in RSX code
+			return;
+		}
+
+		// OK, cell will be accessing the results, probably.
+		// Try to avoid flush spam, it is more costly to flush the CB than it is to just upload the vertex data
+		const auto now = get_system_time();
+		if ((now - m_last_cond_render_eval_hint) > 50)
+		{
+			// Schedule a sync on the next loop iteration
+			m_zcull_flush_pending = true;
+		}
+
+		m_last_cond_render_eval_hint = now;
+		break;
+	}
+	case rsx::FIFO::interrupt_hint::zcull_sync:
+	{
+		// Check if the required report is synced to this CB
+		const auto& record = m_query_records[payload.query->driver_handle];
+		if (!record.has_data || record.last_fence <= m_commands.last_submitted())
+		{
+			return;
+		}
+
+		// Unavoidable hard sync coming up, flush immediately
+		flush_command_queue(false);
+		mtl::m4_count(mtl::get_m4_counters().query_hint_flushes);
+
+		// Clear without wait
+		m_zcull_flush_pending = false;
+		break;
+	}
+	}
+}
+
+// The ZCULL parts of MTLGSRender::do_local_task and on_semaphore_acquire_wait (MTLGSRender.cpp), as VKGSRender has
+// them; the report-page faults reach zcull_ctrl->on_access_violation from MTLGSRender::on_access_violation.
+
+bool MTLGSRender::service_zcull_flush()
+{
+	// VKGSRender::do_local_task: the flush scheduled by a conditional render evaluation hint (m_flush_requests); true
+	// when it ran (the texture cache update then waits for the next iteration, as there)
+	if (!m_zcull_flush_pending)
+	{
+		return false;
+	}
+
+	m_zcull_flush_pending = false;
+	flush_command_queue(false);
+	return true;
+}
+
+bool MTLGSRender::zcull_semaphore_wait_pending() const
+{
+	return m_zcull_flush_pending || (m_eng_interrupt_mask & rsx::pipe_flush_interrupt);
+}
+
+void MTLGSRender::service_zcull_semaphore_wait()
+{
+#ifdef RPCS3_IOS
+	// VKGSRender::on_semaphore_acquire_wait (RPCS3_IOS): the outer FIFO loop normally updates ZCULL. An acquire blocks
+	// that loop: completed reports must also progress here, or a PPU producer waiting for them can never release this
+	// acquire. Throttled as in the Vulkan renderer.
+	if ((++m_semaphore_wait_polls & 15) != 0)
+	{
+		return;
+	}
+
+	const u64 now = get_system_time();
+	if (now < m_next_semaphore_service)
+	{
+		return;
+	}
+
+	m_next_semaphore_service = now + 1'000;
+	if (zcull_ctrl)
+	{
+		zcull_ctrl->update(this);
+	}
+#endif
+}
+
+void MTLGSRender::service_native_ui_flip(rsx::FIFO::state state)
+{
+	// VKGSRender::do_local_task: the native interface asks for frames when the guest does not present (dialogs over a
+	// paused or waiting game).
+	if (state == rsx::FIFO::state::lock_wait || !m_overlay_manager)
+	{
+		return;
+	}
+
+	const auto should_ignore = in_begin_end && state != rsx::FIFO::state::empty;
+	if ((async_flip_requested & flip_request::native_ui) && !should_ignore && !is_stopped())
+	{
+		flush_command_queue(true);
+		rsx::display_flip_info_t info{};
+		info.buffer = current_display_buffer;
+		flip(info);
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLQueries.h b/rpcs3/Emu/RSX/Metal/MTLQueries.h
new file mode 100644
index 0000000..813a77e
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLQueries.h
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): ZCULL occlusion queries of the native Metal 4 renderer, on Metal visibility results with
+// the Vulkan renderer's semantics (VKGSRender.cpp begin/end/check/get/discard_occlusion_query, VKQueryPool.cpp).
+//
+// An RSX query (rsx::reports::occlusion_query_info) is measured in segments. A segment is one 8-byte slot of the
+// renderer's visibility result buffer, counted (MTLVisibilityResultModeCounting) by the draws of one render encoder:
+// Metal visibility counting ends with its encoder, as the Vulkan renderer's host query ends with its command buffer, so
+// a query open across encoders or submissions gets one segment in each. Slots are zeroed by the CPU before use and the
+// passes accumulate into them; clears are not counted (vkCmdClearAttachments is not a draw).
+//
+// Results are those of the GPU, read only once the submission that recorded a segment has signalled the renderer's
+// shared event, with the Vulkan renderer's rules:
+//   - check: not ready while the query's last segment is in the command buffer being recorded (VK is_current); then the
+//     segments oldest first: one not complete makes the query not ready, one with samples makes it ready unless the
+//     exact count is requested (Precise ZCULL), all complete make it ready (the RPCS3_IOS variant, which never waits);
+//   - gather: the segments oldest first, each one waited for, summed as Vulkan's 32-bit results, stopping at the first
+//     sample unless the exact count is requested.
+// A slot is reused only after the submission that writes it has completed. When the pool is exhausted, the renderer
+// does what the Vulkan renderer does (a ZCULL hard sync) and then folds the completed prefix of each query: the same
+// additions in the same order, done earlier, so the result is unchanged (where Vulkan would force a result of 1).
+
+#include "util/types.hpp"
+
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace mtl
+{
+	// The slots of the visibility result buffer.
+	class visibility_slot_pool
+	{
+	public:
+		explicit visibility_slot_pool(u32 capacity = 0)
+		{
+			reset(capacity);
+		}
+
+		void reset(u32 capacity)
+		{
+			m_capacity = capacity;
+			m_free.clear();
+			m_pending.clear();
+			m_in_use.assign(capacity, false);
+			m_free.reserve(capacity);
+			for (u32 slot = capacity; slot > 0; --slot)
+			{
+				m_free.push_back(slot - 1);
+			}
+		}
+
+		u32 capacity() const { return m_capacity; }
+		u32 available() const { return static_cast<u32>(m_free.size()); }
+		u32 pending() const { return static_cast<u32>(m_pending.size()); }
+		u32 in_use() const { return m_capacity - available() - pending(); }
+
+		// A free slot, or umax when every slot is in use or waiting for its submission.
+		u32 allocate()
+		{
+			if (m_free.empty())
+			{
+				return umax;
+			}
+
+			const u32 slot = m_free.back();
+			m_free.pop_back();
+			m_in_use[slot] = true;
+			return slot;
+		}
+
+		// The slot may be written by the GPU until `fence` has completed. False for a slot that is not in use.
+		bool release(u32 slot, u64 fence)
+		{
+			if (slot >= m_capacity || !m_in_use[slot])
+			{
+				return false;
+			}
+
+			m_in_use[slot] = false;
+			m_pending.emplace_back(fence, slot);
+			return true;
+		}
+
+		// Makes the slots whose submissions have completed free again; returns how many.
+		u32 collect(u64 completed)
+		{
+			u32 count = 0;
+			for (usz index = 0; index < m_pending.size();)
+			{
+				if (m_pending[index].first <= completed)
+				{
+					m_free.push_back(m_pending[index].second);
+					m_pending[index] = m_pending.back();
+					m_pending.pop_back();
+					count++;
+					continue;
+				}
+				index++;
+			}
+			return count;
+		}
+
+	private:
+		std::vector<u32> m_free;
+		std::vector<std::pair<u64, u32>> m_pending;  // fence, slot
+		std::vector<bool> m_in_use;
+		u32 m_capacity = 0;
+	};
+
+	struct occlusion_segment
+	{
+		u32 slot = 0;
+		u64 fence = 0;  // the submission that records it (the command context's shared event value)
+	};
+
+	// What the renderer measured for one RSX query (VK occlusion_data).
+	struct occlusion_record
+	{
+		std::vector<occlusion_segment> segments;  // oldest first; fences never decrease
+		u32 folded = 0;           // the gathered value of the segments already read (see fold_completed)
+		bool has_data = false;    // a segment was recorded since the query began (VK: indices not empty)
+		u64 last_fence = 0;       // the submission of the last segment (VK: the command buffer to wait for)
+
+		// Precise counting off and a sample already found: later segments cannot change the value (VK stops there).
+		bool decided(bool precise) const
+		{
+			return !precise && folded != 0;
+		}
+
+		void clear()
+		{
+			segments.clear();
+			folded = 0;
+			has_data = false;
+			last_fence = 0;
+		}
+	};
+
+	// VKGSRender::check_occlusion_query_status (RPCS3_IOS variant) for a query with draws. `read(slot)` is the slot's
+	// value and is called only for a segment whose submission has completed.
+	template <typename Read>
+	bool occlusion_ready(const occlusion_record& record, u64 last_submitted, u64 completed, bool precise, Read&& read)
+	{
+		if (!record.has_data)
+		{
+			return true;
+		}
+
+		if (record.last_fence > last_submitted)
+		{
+			// The query is in the command buffer being recorded
+			return false;
+		}
+
+		if (record.decided(precise))
+		{
+			return true;
+		}
+
+		for (const auto& segment : record.segments)
+		{
+			if (segment.fence > completed)
+			{
+				return false;
+			}
+
+			if (!precise && read(segment.slot))
+			{
+				// Ready and known: the gather stops at this hit without waiting
+				return true;
+			}
+		}
+
+		return true;
+	}
+
+	// VKGSRender::get_occlusion_query_result's gather (after the submission of the query's work): `wait(fence)` returns
+	// once that submission has completed, `read(slot)` is the slot's value. Vulkan returns 32-bit results.
+	template <typename Wait, typename Read>
+	u32 occlusion_gather(const occlusion_record& record, bool precise, Wait&& wait, Read&& read)
+	{
+		u32 result = record.folded;
+		if (record.decided(precise))
+		{
+			return result;
+		}
+
+		for (const auto& segment : record.segments)
+		{
+			wait(segment.fence);
+			result += static_cast<u32>(read(segment.slot));
+			if (result && !precise)
+			{
+				// We only need one hit unless precise zcull is requested
+				break;
+			}
+		}
+
+		return result;
+	}
+
+	// Reads the completed prefix of a record into `folded`, exactly as the gather would read it, and releases those
+	// slots. Once the value is decided (a sample found, precise counting off), the remaining segments are released
+	// unread: the gather never reads them. Returns the number of segments released.
+	template <typename Read, typename Release>
+	u32 fold_completed(occlusion_record& record, u64 completed, bool precise, Read&& read, Release&& release)
+	{
+		usz index = 0;
+		for (; index < record.segments.size() && !record.decided(precise); ++index)
+		{
+			const auto& segment = record.segments[index];
+			if (segment.fence > completed)
+			{
+				break;
+			}
+
+			record.folded += static_cast<u32>(read(segment.slot));
+			release(segment.slot, segment.fence);
+		}
+
+		if (record.decided(precise))
+		{
+			for (usz rest = index; rest < record.segments.size(); ++rest)
+			{
+				release(record.segments[rest].slot, record.segments[rest].fence);
+			}
+			index = record.segments.size();
+		}
+
+		record.segments.erase(record.segments.begin(), record.segments.begin() + index);
+		return static_cast<u32>(index);
+	}
+}
