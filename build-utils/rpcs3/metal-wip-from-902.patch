+		u32 ssbo_length;
+		if (src_offset > dst_offset)
+		{
+			ssbo_length = (src_offset + src_length) - dst_offset;
+			bound_offset = dst_offset;
+		}
+		else
+		{
+			ssbo_length = (dst_offset - src_offset) + (src_length / from_size) * to_size;
+			bound_offset = src_offset;
+		}
