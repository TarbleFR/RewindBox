index 0000000..65e738a
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLResolve.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): MSAA surfaces of the native Metal 4 renderer, with the Vulkan renderer's semantics.
+//
+// At the "Auto" MSAA level a surface has the sample count of its RSX AA mode (VKRenderTargets.h create_new_surface) and
+// is a 2D multisample texture. Its resolve texture holds the same samples side by side (samples_x * width by samples_y *
+// height, single-sampled), the layout of the surface in guest memory; transfers and the presentation read it, and the
+// surface store's copies write it (VK render_target::get_surface). Rendering marks the resolve texture stale
+// (require_resolve); a transfer read resolves first; a write of the resolve texture marks the multisampled texture stale
+// (require_unresolve), unresolved before the next draw (VK render_target::memory_barrier).
+//
+// The passes are VKResolveHelper's, as Metal render passes (Metal has no writable multisampled storage textures):
+// colour, depth, and depth with stencil (stencil export, the Vulkan renderer's _EXT passes), the coordinate math of
+// Program/MSAA (MTLM4Math.h resolve_math). A pass whose pipeline cannot be built is counted and not executed.
+
+#include "MTLAPI.h"
+#include "MTLM4Math.h"
+
+#include <array>
+#include <string>
+#include <unordered_map>
+
+namespace mtl
+{
+	class command_context;
+	class render_target;
+
+	class msaa_resolver
+	{
+	public:
+		bool create(command_context& ctx, const object& compiler, std::string& error);
+		void destroy(command_context& ctx);
+		bool ready() const { return !!m_library; }
+
+		// The multisampled texture into the resolve texture, and back.
+		bool resolve(command_context& ctx, render_target& surface);
+		bool unresolve(command_context& ctx, render_target& surface);
+
+	private:
+		enum class pass : u8
+		{
+			color_resolve,
+			color_unresolve,
+			depth_resolve,
+			depth_unresolve,
+			depth_stencil_resolve,
+			depth_stencil_unresolve,
+		};
+
+		const object& get_pipeline(pass kind, pixel_format format, u32 samples);
+		bool run(command_context& ctx, render_target& surface, bool unresolve);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		object m_depth_state;          // depth always, written
+		object m_depth_stencil_state;  // and stencil always, replaced, all bits
+		std::array<object, 5> m_params{};  // the sample counts by host sample count (2, 4)
+		std::unordered_map<u64, object> m_pipelines;
+	};
+
+	// The resolver the render targets use (set by the renderer, as the command context).
+	void set_msaa_resolver(msaa_resolver* resolver);
+	msaa_resolver* get_msaa_resolver();
+}
