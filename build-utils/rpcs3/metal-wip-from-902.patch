+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M3.1): host unit test of the Metal renderer's texture format, component order and sampler
+// decisions (MTLTextureFormats.h). Pure logic: no Metal, builds with g++ or clang++ on any host.
+//
+//   S=<rpcs3 source root>
+//   c++ -std=gnu++20 -Wall -I "$S/rpcs3" -I "$S" -I "$S/rpcs3/Emu" -I "$S/3rdparty"
+//       "$S/rpcs3/Emu/RSX/Metal/tests/mtl_texture_formats_test.cpp" -o mtl_texture_formats_test
+//   ./mtl_texture_formats_test
+
+#include "Emu/RSX/Metal/MTLTextureFormats.h"
+
