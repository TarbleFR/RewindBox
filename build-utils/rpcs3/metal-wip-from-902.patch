diff --git a/rpcs3/Emu/RSX/Metal/MTLBlit.cpp b/rpcs3/Emu/RSX/Metal/MTLBlit.cpp
new file mode 100644
index 0000000..9f7fdf6
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLBlit.cpp
@@ -0,0 +1,682 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M3.2): image transfers (VKTexture.cpp copy_image / copy_image_typeless / copy_scaled_image,
+// vk::blitter::scale_image counterparts). See MTLBlit.h.
+
+#include "stdafx.h"
+#include "MTLBlit.h"
+#include "MTLCommandContext.h"
+#include "MTLRenderTargets.h"
+
+#include "util/asm.hpp"
+
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		blit_engine* g_blit_engine = nullptr;
+
+		// The Vulkan blit: u = srcX0 + (x + 0.5 - dstX0) * (srcX1 - srcX0) / (dstX1 - dstX0), in texels, clamp to edge.
+		// [[position]] is the pixel centre (x + 0.5, y + 0.5) of the attachment.
+		constexpr std::string_view blit_source = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct blit_params
+{
+	float2 src_origin;
+	float2 scale;
+	float2 dst_origin;
+	float2 reserved;
+};
+
+struct blit_vertex_out
+{
+	float4 position [[position]];
+};
+
+vertex blit_vertex_out blit_vertex(uint vid [[vertex_id]])
+{
+	blit_vertex_out out;
+	out.position = float4((vid & 1u) ? 1.0 : -1.0, (vid & 2u) ? 1.0 : -1.0, 0.0, 1.0);
+	return out;
+}
+
+constexpr sampler blit_nearest_sampler(coord::pixel, filter::nearest, address::clamp_to_edge);
+constexpr sampler blit_linear_sampler(coord::pixel, filter::linear, address::clamp_to_edge);
+
+inline float2 blit_coord(float4 position, constant blit_params& p)
+{
+	return p.src_origin + (position.xy - p.dst_origin) * p.scale;
+}
+
+fragment float4 blit_nearest(blit_vertex_out in [[stage_in]], texture2d<float> src [[texture(0)]], constant blit_params& p [[buffer(0)]])
+{
+	return src.sample(blit_nearest_sampler, blit_coord(in.position, p));
+}
+
+fragment float4 blit_linear(blit_vertex_out in [[stage_in]], texture2d<float> src [[texture(0)]], constant blit_params& p [[buffer(0)]])
+{
+	return src.sample(blit_linear_sampler, blit_coord(in.position, p));
+}
+)";
+
+		struct blit_params
+		{
+			f32 src_origin[2];
+			f32 scale[2];
+			f32 dst_origin[2];
+			f32 reserved[2];
+		};
+
+		data_heap& staging_heap()
+		{
+			return *ensure(get_upload_heap(), "Metal: no upload heap for transfers");
+		}
+
+		bool renderable_colour(pixel_format format)
+		{
+			// The blit shader writes float4: normalized and float colour formats only.
+			switch (format)
+			{
+			case pixel_format::r8_uint: case pixel_format::r16_uint: case pixel_format::r32_uint: case pixel_format::r32_sint:
+			case pixel_format::rg32_uint: case pixel_format::rgba8_uint: case pixel_format::rgba16_uint: case pixel_format::rgba32_uint:
+			case pixel_format::stencil8: case pixel_format::x32_stencil8:
+				return false;
+			default:
+				return !is_compressed_format(format) && !is_depth_format(format) && get_texel_size(format) != 0;
+			}
+		}
+
+		// The region of an area (flips removed).
+		struct abs_rect
+		{
+			u32 x, y, w, h;
+		};
+
+		abs_rect absolute(const areai& area)
+		{
+			return { static_cast<u32>(std::min(area.x1, area.x2)), static_cast<u32>(std::min(area.y1, area.y2)),
+				static_cast<u32>(area.width()), static_cast<u32>(area.height()) };
+		}
+
+		bool inside(const abs_rect& r, u32 w, u32 h)
+		{
+			return r.w && r.h && u64{r.x} + r.w <= w && u64{r.y} + r.h <= h;
+		}
+
+		u32 level_width(const image& img, u32 level) { return std::max(img.width() >> level, 1u); }
+		u32 level_height(const image& img, u32 level) { return std::max(img.height() >> level, 1u); }
+
+		// The copy-compatible source of a bit-compatible copy: the texture itself, or a view in dst's format.
+		const object* copy_source(image* src, image* dst)
+		{
+			if (src->format() == dst->format())
+			{
+				return &src->texture;
+			}
+
+			const auto raw = rsx::default_remap_vector.with_encoding(remap_identity_raw);
+			auto view = src->get_view(dst->format(), default_component_map, src->aspect(),
+				view_key(src->native_component_map, raw, src->aspect(), dst->format()));
+			return view ? &view->handle() : nullptr;
+		}
+	}
+
+	// M4: a multisampled image is never copied, sampled or written by a transfer: its surface's resolve image is (VK
+	// render_target::get_surface). Reaching one means the resolve image could not be made or resolved (counted there).
+	bool transferable(const image* src, const image* dst)
+	{
+		if (src->samples() > 1 || dst->samples() > 1)
+		{
+			get_texture_counters().typeless_not_implemented++;
+			log_once("transfer-msaa", "transfer of a multisampled image without its resolve image refused");
+			return false;
+		}
+		return true;
+	}
+
+	void set_blit_engine(blit_engine* engine)
+	{
+		g_blit_engine = engine;
+	}
+
+	blit_engine* get_blit_engine()
+	{
+		return g_blit_engine;
+	}
+
+	// blit_engine
+
+	bool blit_engine::create(const object& device, const object& compiler, bool float32_filtering, std::string& error)
+	{
+		m_device = device;
+		m_compiler = compiler;
+		m_float32_filtering = float32_filtering;
+		m_pipelines.init(compiler);  // M4
+		m_library = compile_library(compiler, blit_source, error);
+		m_table = new_argument_table(device, 1, 1, 1);
+		return m_library && m_table;
+	}
+
+	void blit_engine::destroy()
+	{
+		m_helpers.clear();
+		m_pipelines.clear();
+		m_table.reset();
+		m_library.reset();
+		m_compiler.reset();
+		m_device.reset();
+	}
+
+	const object& blit_engine::get_pipeline(pixel_format format, blit_filter filter)
+	{
+		// M4: the transfer pipeline cache (MTLTransferPass.h)
+		const u64 key = static_cast<u64>(format) | (static_cast<u64>(filter) << 32);
+		return m_pipelines.get(key, [&](render_pipeline_descriptor& desc)
+		{
+			desc.library = m_library;
+			desc.vertex_function = "blit_vertex";
+			desc.fragment_function = (filter == blit_filter::linear) ? "blit_linear" : "blit_nearest";
+			desc.color[0].format = format;
+			desc.label = "RSX blit";
+		}, [&](const render_pipeline_descriptor&, const std::string& error)
+		{
+			log_once("blit-pipeline", fmt::format("blit pipeline for format %u: %s", static_cast<u32>(format), error));
+		});
+	}
+
+	image* blit_engine::get_typeless_helper(command_context& ctx, pixel_format format, rsx::format_class format_class, u32 w, u32 h, u32 index)
+	{
+		const u64 key = static_cast<u64>(format) | (static_cast<u64>(index) << 32);
+		auto& helper = m_helpers[key];
+		if (helper && helper->width() >= w && helper->height() >= h)
+		{
+			helper->image_format_class = format_class;
+			return helper.get();
+		}
+
+		// Grows like VK's typeless helpers; the old one is released once the work recorded so far completed.
+		const u32 new_w = std::max(w, helper ? helper->width() : 0u);
+		const u32 new_h = std::max(h, helper ? helper->height() : 0u);
+		texture_descriptor desc{};
+		desc.type = texture_type::type_2d;
+		desc.format = format;
+		desc.width = std::max(new_w, 1u);
+		desc.height = std::max(new_h, 1u);
+		desc.usage = usage_shader_read | usage_pixel_format_view | usage_render_target;
+		desc.storage = storage_mode::private_;
+
+		auto created = std::make_unique<image>();
+		if (!created->create(ctx, desc, format_class))
+		{
+			return nullptr;
+		}
+		created->set_name("typeless helper");
+		helper = std::move(created);
+		return helper.get();
+	}
+
+	bool blit_engine::blit(command_context& ctx, const image& src, const areai& src_area, const image& dst, u32 dst_level, u32 dst_slice, u32 dst_z,
+		const areai& dst_area, blit_filter filter)
+	{
+		auto& counters = get_texture_counters();
+		const auto s = absolute(src_area);
+		const auto d = absolute(dst_area);
+
+		if (&src == &dst || !renderable_colour(dst.format()) || !(dst.usage & usage_render_target) || src.is_depth() || is_compressed_format(src.format()) ||
+			src.samples() > 1 || dst.samples() > 1)  // M4: multisampled images are transferred through their resolve images
+		{
+			// (A render pass cannot sample the texture it renders to.)
+			counters.scaled_not_implemented++;
+			log_once("blit-format", fmt::format("scaled transfer %u -> %u cannot be rendered (format or usage)", static_cast<u32>(src.format()), static_cast<u32>(dst.format())));
+			return false;
+		}
+
+		if (dst_area.is_flipped() || !inside(s, src.width(), src.height()) || !inside(d, level_width(dst, dst_level), level_height(dst, dst_level)))
+		{
+			rsx_log.error("Metal: blit request refused: the regions do not fit (src %d,%d-%d,%d of %ux%u, dst %d,%d-%d,%d of %ux%u)",
+				src_area.x1, src_area.y1, src_area.x2, src_area.y2, src.width(), src.height(),
+				dst_area.x1, dst_area.y1, dst_area.x2, dst_area.y2, level_width(dst, dst_level), level_height(dst, dst_level));
+			return false;
+		}
+
+		if (filter == blit_filter::linear && is_float32_format(src.format()) && !m_float32_filtering)
+		{
+			// Metal cannot filter 32-bit floats on this device.
+			filter = blit_filter::nearest;
+			counters.filters_downgraded++;
+		}
+
+		const auto& pipeline = get_pipeline(dst.format(), filter);
+		if (!pipeline)
+		{
+			counters.scaled_not_implemented++;
+			return false;
+		}
+
+		// Parameters first: the ring may make room by submitting, which ends any open encoder.
+		auto params = allocate_staging(ctx, staging_heap(), sizeof(blit_params));
+		blit_params p{};
+		p.src_origin[0] = static_cast<f32>(src_area.x1);
+		p.src_origin[1] = static_cast<f32>(src_area.y1);
+		p.scale[0] = blit_scale(src_area.x1, src_area.x2, dst_area.x1, dst_area.x2);
+		p.scale[1] = blit_scale(src_area.y1, src_area.y2, dst_area.y1, dst_area.y2);
+		p.dst_origin[0] = static_cast<f32>(dst_area.x1);
+		p.dst_origin[1] = static_cast<f32>(dst_area.y1);
+		std::memcpy(params.data, &p, sizeof(p));
+
+		render_pass_descriptor pass{};
+		pass.color[0].texture = dst.texture;
+		pass.color[0].level = dst_level;
+		pass.color[0].slice = dst_slice;
+		pass.color[0].depth_plane = dst_z;
+		pass.color[0].load = load_action::load;
+		pass.color[0].store = store_action::store;
+		pass.render_target_width = level_width(dst, dst_level);
+		pass.render_target_height = level_height(dst, dst_level);
+
+		table_set_buffer(m_table, params.buffer, params.offset, 0);
+		table_set_texture(m_table, src.texture, 0);
+		draw_transfer_quad(ctx, pass, "RSX blit", pipeline, nullptr, m_table, stage_vertex | stage_fragment, d.x, d.y, d.w, d.h);  // M4
+
+		counters.scaled_copies++;
+		return true;
+	}
+
+	// Transfers
+
+	namespace
+	{
+		bool copy_image_impl(transfer_scope& scope, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+		{
+			auto& counters = get_texture_counters();
+			if (src_area.is_flipped() || dst_area.is_flipped() || src_area.width() != dst_area.width() || src_area.height() != dst_area.height())
+			{
+				return false;
+			}
+
+			if (!transferable(src, dst))  // M4
+			{
+				return false;
+			}
+
+			const auto s = absolute(src_area);
+			const auto d = absolute(dst_area);
+			if (!inside(s, src->width(), src->height()) || !inside(d, level_width(*dst, dst_level), level_height(*dst, dst_level)))
+			{
+				rsx_log.error("Metal: copy request refused: the regions do not fit");
+				return false;
+			}
+
+			// One bit layout: the same format, or colour formats of one texel size (vkCmdCopyImage copies the bits of
+			// size-compatible formats).
+			const bool same = src->format() == dst->format();
+			const bool size_compatible = src->aspect() == aspect_color && dst->aspect() == aspect_color &&
+				!is_compressed_format(src->format()) && !is_compressed_format(dst->format()) &&
+				get_texel_size(src->format()) != 0 && get_texel_size(src->format()) == get_texel_size(dst->format());
+			if (!same && !size_compatible)
+			{
+				return false;
+			}
+
+			if (is_compressed_format(src->format()))
+			{
+				const bool aligned = !(s.x % 4) && !(s.y % 4) && !(d.x % 4) && !(d.y % 4) &&
+					((s.w % 4) == 0 || s.x + s.w == src->width()) && ((s.h % 4) == 0 || s.y + s.h == src->height());
+				if (!aligned)
+				{
+					counters.typeless_not_implemented++;
+					log_once("copy-compressed", "unaligned block-compressed region copy is not implemented");
+					return false;
+				}
+			}
+
+			const object* source = copy_source(src, dst);
+			if (!source)
+			{
+				counters.typeless_not_implemented++;
+				return false;
+			}
+
+			if (src == dst && texture_box::make(0, 0, s.x, s.y, 0, s.w, s.h).overlaps(texture_box::make(dst_level, dst_slice, d.x, d.y, dst_z, d.w, d.h)))
+			{
+				counters.typeless_not_implemented++;
+				log_once("copy-self", "overlapping copy of a texture onto itself is not implemented");
+				return false;
+			}
+
+			const auto& encoder = scope.encoder(&src->texture, texture_box::make(0, 0, s.x, s.y, 0, s.w, s.h),
+				&dst->texture, texture_box::make(dst_level, dst_slice, d.x, d.y, dst_z, d.w, d.h));
+			copy_texture(encoder, *source, 0, 0, { { s.x, s.y, 0 }, { s.w, s.h, 1 } }, dst->texture, dst_slice, dst_level, { d.x, d.y, dst_z });
+			counters.copies++;
+			if (!same)
+			{
+				counters.typeless_copies++;
+			}
+			return true;
+		}
+
+	}
+
+	bool copy_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+	{
+		transfer_scope scope(ctx, "image copy");
+		return copy_image_impl(scope, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+	}
+
+	bool copy_image(transfer_scope& scope, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+	{
+		return copy_image_impl(scope, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+	}
+
+	// M4: copy_image_typeless is in MTLTypelessCopy.cpp (VK's selection: the conversion kernels or the bits as they are).
+
+	bool copy_scaled_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level, u32 dst_slice, u32 dst_z, bool compatible_formats, blit_filter filter)
+	{
+		auto& counters = get_texture_counters();
+		blit_engine* engine = get_blit_engine();
+		compatible_formats |= (src->format() == dst->format());
+
+		if (!transferable(src, dst))  // M4
+		{
+			return false;
+		}
+
+		if (compatible_formats && !src_area.is_flipped() && !dst_area.is_flipped() &&
+			src_area.width() == dst_area.width() && src_area.height() == dst_area.height())
+		{
+			return copy_image(ctx, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+		}
+
+		if (!engine)
+		{
+			counters.scaled_not_implemented++;
+			return false;
+		}
+
+		if (src->aspect() == aspect_color)
+		{
+			if (dst->aspect() != aspect_color)
+			{
+				counters.scaled_not_implemented++;
+				log_once("blit-aspect", "scaled transfer between colour and depth is not implemented");
+				return false;
+			}
+
+			// vkCmdBlitImage: sampled and written as values (formats converted).
+			return engine->blit(ctx, *src, src_area, *dst, dst_level, dst_slice, dst_z, dst_area, filter);
+		}
+
+		// Depth and stencil (VKTexture.cpp copy_scaled_image): a depth float mismatch needs a typeless conversion.
+		if (src->format() != dst->format())
+		{
+			// M4: VK ("can happen because of depth float mismatch; format width should be equal RSX-side"): the bits go
+			// into a helper of the destination's format (copy_image_typeless, counted there when refused), then scaled.
+			if (!dst->is_depth())
+			{
+				counters.typeless_not_implemented++;
+				log_once("blit-depth-format", "scaled transfer from a depth image into a colour image is not implemented");
+				return false;
+			}
+
+			const auto s = absolute(src_area);
+			image* const typeless = engine->get_typeless_helper(ctx, dst->format(), dst->format_class(), s.w, s.h, 5);
+			if (!typeless)
+			{
+				counters.scaled_not_implemented++;
+				return false;
+			}
+
+			areai helper_area = { 0, 0, static_cast<s32>(s.w), static_cast<s32>(s.h) };
+			const areai source_box = { static_cast<s32>(s.x), static_cast<s32>(s.y), static_cast<s32>(s.x + s.w), static_cast<s32>(s.y + s.h) };
+			if (!copy_image_typeless(ctx, src, typeless, source_box, helper_area))
+			{
+				return false;
+			}
+
+			// The flip happens in the scaling step, as for the carriers below.
+			if (src_area.x1 > src_area.x2) helper_area.flip_horizontal();
+			if (src_area.y1 > src_area.y2) helper_area.flip_vertical();
+			return copy_scaled_image(ctx, typeless, dst, helper_area, dst_area, dst_level, dst_slice, dst_z, true, filter);
+			// M4 end
+		}
+
+		if (dst_area.is_flipped())
+		{
+			rsx_log.error("Metal: flipped depth blit destination refused");
+			return false;
+		}
+
+		const auto s = absolute(src_area);
+		const auto d = absolute(dst_area);
+		if (!inside(s, src->width(), src->height()) || !inside(d, level_width(*dst, dst_level), level_height(*dst, dst_level)))
+		{
+			rsx_log.error("Metal: depth blit refused: the regions do not fit");
+			return false;
+		}
+
+		// The carriers of the Vulkan renderer's 'safe' transport (bits, never values: no float interpolation of
+		// depth across a format change).
+		struct plane
+		{
+			u32 options;
+			pixel_format carrier;
+			u32 bpp;
+		};
+
+		plane planes[2]{};
+		u32 plane_count = 0;
+		switch (src->format())
+		{
+		case pixel_format::depth16_unorm:
+			planes[plane_count++] = { blit_none, pixel_format::r16_unorm, 2 };
+			break;
+		case pixel_format::depth32_float:
+			planes[plane_count++] = { blit_none, pixel_format::r32_float, 4 };
+			break;
+		case pixel_format::depth32_float_stencil8:
+			planes[plane_count++] = { blit_depth_from_depth_stencil, pixel_format::bgra8_unorm, 4 };
+			planes[plane_count++] = { blit_stencil_from_depth_stencil, pixel_format::r8_unorm, 1 };
+			break;
+		default:
+			counters.scaled_not_implemented++;
+			return false;
+		}
+
+		// The carrier region keeps the source's orientation; the flip happens in the scaling step.
+		areai carrier_src = { 0, 0, static_cast<s32>(s.w), static_cast<s32>(s.h) };
+		if (src_area.x1 > src_area.x2) carrier_src.flip_horizontal();
+		if (src_area.y1 > src_area.y2) carrier_src.flip_vertical();
+		const areai carrier_dst = { 0, 0, static_cast<s32>(d.w), static_cast<s32>(d.h) };
+
+		for (u32 i = 0; i < plane_count; ++i)
+		{
+			const auto& pl = planes[i];
+			image* from = engine->get_typeless_helper(ctx, pl.carrier, rsx::RSX_FORMAT_CLASS_COLOR, s.w, s.h, 2);
+			image* to = engine->get_typeless_helper(ctx, pl.carrier, rsx::RSX_FORMAT_CLASS_COLOR, d.w, d.h, 3);
+			if (!from || !to)
+			{
+				counters.scaled_not_implemented++;
+				return false;
+			}
+
+			const u32 src_row = s.w * pl.bpp;
+			const u32 dst_row = d.w * pl.bpp;
+			const u64 src_bytes = utils::align<u64>(u64{src_row} * s.h, 256);
+			auto staging = allocate_staging(ctx, staging_heap(), src_bytes + u64{dst_row} * d.h);
+			{
+				// 1. The plane's bits into the source carrier.
+				transfer_scope scope(ctx, "depth blit (in)");
+				copy_texture_to_buffer(scope.for_read(src->texture, texture_box::make(0, 0, s.x, s.y, 0, s.w, s.h)), src->texture, 0, 0,
+					{ { s.x, s.y, 0 }, { s.w, s.h, 1 } }, staging.buffer, staging.offset, src_row, 0, pl.options);
+				scope.split();
+				copy_buffer_to_texture(scope.for_write(from->texture, texture_box::make(0, 0, 0, 0, 0, s.w, s.h)), staging.buffer, staging.offset,
+					src_row, 0, { s.w, s.h, 1 }, from->texture, 0, 0, {});
+			}
+
+			// 2. Scaled from carrier to carrier.
+			if (!engine->blit(ctx, *from, carrier_src, *to, 0, 0, 0, carrier_dst, filter))
+			{
+				return false;
+			}
+
+			{
+				// 3. The bits back into the destination plane.
+				transfer_scope scope(ctx, "depth blit (out)");
+				copy_texture_to_buffer(scope.for_read(to->texture, texture_box::make(0, 0, 0, 0, 0, d.w, d.h)), to->texture, 0, 0,
+					{ { 0, 0, 0 }, { d.w, d.h, 1 } }, staging.buffer, staging.offset + src_bytes, dst_row, 0);
+				scope.split();
+				copy_buffer_to_texture(scope.for_write(dst->texture, texture_box::make(dst_level, dst_slice, d.x, d.y, dst_z, d.w, d.h)), staging.buffer,
+					staging.offset + src_bytes, dst_row, 0, { d.w, d.h, 1 }, dst->texture, dst_slice, dst_level, { d.x, d.y, dst_z }, pl.options);
+			}
+		}
+
+		counters.depth_scaled_copies++;
+		return true;
+	}
+
+	bool blitter::scale_image(command_context& cmd, image* src, image* dst, areai src_area, areai dst_area, bool interpolate, const rsx::typeless_xfer& xfer_info)
+	{
+		// vk::blitter::scale_image
+		image* real_src = src;
+		image* real_dst = dst;
+		auto& counters = get_texture_counters();
+		blit_engine* engine = get_blit_engine();
+		if (!src || !dst)
+		{
+			return false;
+		}
+
+		// Optimization pass; check for pass-through data transfer
+		if (!xfer_info.flip_horizontal && !xfer_info.flip_vertical && src_area.height() == dst_area.height())
+		{
+			auto src_w = src_area.width();
+			auto dst_w = dst_area.width();
+
+			if (xfer_info.src_is_typeless) src_w = static_cast<int>(src_w * xfer_info.src_scaling_hint);
+			if (xfer_info.dst_is_typeless) dst_w = static_cast<int>(dst_w * xfer_info.dst_scaling_hint);
+
+			if (src_w == dst_w)
+			{
+				// Final dimensions are a match
+				if (xfer_info.src_is_typeless || xfer_info.dst_is_typeless)
+				{
+					return copy_image_typeless(cmd, src, dst, src_area, dst_area);
+				}
+
+				if (!copy_image(cmd, src, dst, src_area, dst_area))
+				{
+					counters.typeless_not_implemented++;
+					log_once("blit-copy", fmt::format("unscaled blit %u -> %u has no bit-compatible copy", static_cast<u32>(src->format()), static_cast<u32>(dst->format())));
+					return false;
+				}
+				return true;
+			}
+		}
+
+		const bool supports_bc = false; // the typeless formats of the blit engine are never block-compressed
+		if (xfer_info.src_is_typeless)
+		{
+			const auto format = xfer_info.src_native_format_override ?
+				static_cast<pixel_format>(xfer_info.src_native_format_override) :
+				get_compatible_sampler_format(xfer_info.src_gcm_format, supports_bc);
+
+			if (format != src->format())
+			{
+				// Normalize input region (memory optimization)
+				const auto old_src_area = src_area;
+				src_area.y2 -= src_area.y1;
+				src_area.y1 = 0;
+				src_area.x2 = static_cast<int>(src_area.width() * xfer_info.src_scaling_hint);
+				src_area.x1 = 0;
+
+				// Transfer bits from src to typeless src
+				real_src = engine ? engine->get_typeless_helper(cmd, format, rsx::classify_format(xfer_info.src_gcm_format), src_area.width(), src_area.height(), 0) : nullptr;
+				if (!real_src || !copy_image_typeless(cmd, src, real_src, old_src_area, src_area))
+				{
+					return false;
+				}
+			}
+		}
+
+		// Save output region descriptor
+		const auto old_dst_area = dst_area;
+
+		if (xfer_info.dst_is_typeless)
+		{
+			const auto format = xfer_info.dst_native_format_override ?
+				static_cast<pixel_format>(xfer_info.dst_native_format_override) :
+				get_compatible_sampler_format(xfer_info.dst_gcm_format, supports_bc);
+
+			if (format != dst->format())
+			{
+				// Normalize output region (memory optimization). A distinct helper from the source one (index 1):
+				// VK places both in one image, one below the other, which a Metal render pass cannot sample and write.
+				dst_area.y2 -= dst_area.y1;
+				dst_area.y1 = 0;
+				dst_area.x2 = static_cast<int>(dst_area.width() * xfer_info.dst_scaling_hint);
+				dst_area.x1 = 0;
+
+				real_dst = engine ? engine->get_typeless_helper(cmd, format, rsx::classify_format(xfer_info.dst_gcm_format), dst_area.width(), dst_area.height(), 1) : nullptr;
+				if (!real_dst)
+				{
+					return false;
+				}
+			}
+		}
+
+		// Checks
+		if (src_area.x2 <= src_area.x1 || src_area.y2 <= src_area.y1 || dst_area.x2 <= dst_area.x1 || dst_area.y2 <= dst_area.y1)
+		{
+			rsx_log.error("Blit request consists of an empty region descriptor!");
+			return false;
+		}
+
+		if (src_area.x1 < 0 || src_area.x2 > static_cast<s32>(real_src->width()) || src_area.y1 < 0 || src_area.y2 > static_cast<s32>(real_src->height()))
+		{
+			rsx_log.error("Blit request denied because the source region does not fit!");
+			return false;
+		}
+
+		if (dst_area.x1 < 0 || dst_area.x2 > static_cast<s32>(real_dst->width()) || dst_area.y1 < 0 || dst_area.y2 > static_cast<s32>(real_dst->height()))
+		{
+			rsx_log.error("Blit request denied because the destination region does not fit!");
+			return false;
+		}
+
+		if (xfer_info.flip_horizontal)
+		{
+			src_area.flip_horizontal();
+		}
+
+		if (xfer_info.flip_vertical)
+		{
+			src_area.flip_vertical();
+		}
+
+		if (real_src->aspect() != real_dst->aspect())
+		{
+			// VK asserts here ("Incompatible source and destination format!").
+			counters.typeless_not_implemented++;
+			log_once("blit-aspects", "blit between a colour and a depth image is not implemented");
+			return false;
+		}
+
+		if (!copy_scaled_image(cmd, real_src, real_dst, src_area, dst_area, 0, 0, 0,
+			images_are_bitcast_compatible(real_src->format(), real_src->format_class(), real_dst->format(), real_dst->format_class()),
+			interpolate ? blit_filter::linear : blit_filter::nearest))
+		{
+			return false;
+		}
+
+		if (real_dst != dst)
+		{
+			return copy_image_typeless(cmd, real_dst, dst, dst_area, old_dst_area);
+		}
+
+		return true;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLBlit.h b/rpcs3/Emu/RSX/Metal/MTLBlit.h
new file mode 100644
index 0000000..3c6576b
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLBlit.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M3.2): image transfers of the native Metal 4 renderer, the counterparts of VKTexture.cpp's
+// copy_image, copy_image_typeless, copy_scaled_image and vk::blitter (the blit engine's scale_image).
+//
+// Unscaled transfers are compute-encoder copies (a view of the source in the destination's format for bit-compatible
+// formats, a buffer for reinterpretations without a byte shuffle). Scaled transfers are what vkCmdBlitImage is:
+// a render pass over the destination region whose fragments sample the source with the requested filter at
+//     u = srcX0 + (x + 0.5 - dstX0) * (srcX1 - srcX0) / (dstX1 - dstX0)
+// in unnormalized texel coordinates with clamp-to-edge addressing (the Vulkan blit definition, mirrored when a source
+// region is flipped). Depth and stencil are scaled as the Vulkan renderer does on MoltenVK-class drivers: each plane
+// goes through a buffer into a colour carrier (D16 -> R16Unorm, D32F -> R32Float, the D32F_S8 depth plane -> BGRA8,
+// its stencil plane -> R8Unorm), the carrier is scaled, and the result goes back into the plane, bit for bit.
+//
+// M4: reinterpretations that need a GPU byte shuffle or depth <-> colour packing run on the conversion kernels
+// (copy_image_typeless, MTLTypelessCopy.cpp: the one typeless copy of the renderer). A multisampled surface is
+// transferred through its resolve image (MTLResolve.h); a multisampled image reaching a transfer (its resolve image
+// could not be made or resolved, counted there) is refused and counted. The render pipelines and the quad draw are the
+// ones the MSAA resolve passes use (MTLTransferPass.h).
+
+#include "MTLTexture.h"
+#include "MTLTransferPass.h"  // M4
+
+#include "Utilities/geometry.h"
+
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+namespace mtl
+{
+	class command_context;
+
+	enum class blit_filter : u8
+	{
+		nearest,
+		linear,
+	};
+
+	// The render pipelines and scratch images of the scaled transfers; owned by the renderer (RSX thread only).
+	class blit_engine
+	{
+	public:
+		bool create(const object& device, const object& compiler, bool float32_filtering, std::string& error);
+		void destroy();
+
+		// Scales src_area of a colour image (level 0, slice 0; flipped when x1 > x2 or y1 > y2) into dst_area of a
+		// level/slice/plane of a colour image. False (counted) when the destination cannot be rendered to.
+		bool blit(command_context& ctx, const image& src, const areai& src_area, const image& dst, u32 dst_level, u32 dst_slice, u32 dst_z,
+			const areai& dst_area, blit_filter filter);
+
+		// A scratch colour image of at least w x h (VK get_typeless_helper). Index 0 and 1 are distinct images, so a
+		// transfer can scale from one to the other.
+		image* get_typeless_helper(command_context& ctx, pixel_format format, rsx::format_class format_class, u32 w, u32 h, u32 index = 0);
+
+	private:
+		const object& get_pipeline(pixel_format format, blit_filter filter);
+
+		object m_device;
+		object m_compiler;
+		object m_library;
+		object m_table;
+		bool m_float32_filtering = false;
+		transfer_pipeline_cache m_pipelines;  // M4: shared with the MSAA resolve passes
+		std::unordered_map<u64, std::unique_ptr<image>> m_helpers;
+	};
+
+	void set_blit_engine(blit_engine* engine);
+	blit_engine* get_blit_engine();
+
+	// M4: false (counted, logged once) when either image is multisampled: transfers use resolve images.
+	bool transferable(const image* src, const image* dst);
+
+	// VKTexture.cpp copy_image: an unscaled, unflipped copy between formats of one bit layout. False (counted) when
+	// the formats or regions do not allow it.
+	bool copy_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level = 0, u32 dst_slice = 0, u32 dst_z = 0);
+	// The same in a caller's transfer scope (copies batched in one encoder where they do not overlap).
+	bool copy_image(transfer_scope& scope, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level = 0, u32 dst_slice = 0, u32 dst_z = 0);
+
+	// VKTexture.cpp copy_image_typeless: the bits of src_area reinterpreted in dst's format, through a buffer.
+	// M4: with VK's selection (MTLTypelessCopy.cpp): the byte shuffle get_format_convert_flags asks for and the depth
+	// packing of copy_image_to_buffer / copy_buffer_to_image run on the conversion kernels; otherwise the bits are
+	// copied as they are. False (counted, the destination unchanged) when it cannot be done exactly.
+	bool copy_image_typeless(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level = 0, u32 dst_slice = 0, u32 dst_z = 0);
+
+	// VKTexture.cpp copy_scaled_image: compatible_formats as there (an unscaled copy is used when possible).
+	bool copy_scaled_image(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area,
+		u32 dst_level, u32 dst_slice, u32 dst_z, bool compatible_formats, blit_filter filter);
+
+	// vk::blitter: the blit engine's transfers (rsx::texture_cache::upload_scaled_image) and surface inheritance.
+	struct blitter
+	{
+		bool scale_image(command_context& cmd, image* src, image* dst, areai src_area, areai dst_area, bool interpolate, const rsx::typeless_xfer& xfer_info);
+	};
+}
