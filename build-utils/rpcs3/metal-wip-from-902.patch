+bool MTLGSRender::wait_for_offloader_recovery(bool is_writing)
+{
+	// VKGSRender: the offloader thread cannot wait for flush requests (the RSX thread may be waiting for it). The RSX
+	// thread invalidates the range itself, flushing in place (flush_pending_requests), while the offloader spins.
+	ensure(!m_offloader_deadlock);
+	m_offloader_fault_range = g_fxo->get<rsx::dma_manager>().get_fault_range(is_writing);
+	m_offloader_fault_cause = is_writing ? rsx::invalidation_cause::write : rsx::invalidation_cause::read;
+
+	g_fxo->get<rsx::dma_manager>().set_mem_fault_flag();
+	m_offloader_deadlock = true;
+	m_eng_interrupt_mask |= rsx::backend_interrupt;
+#ifdef RPCS3_IOS
+	rpcs3::ios::rsx_idle_park::wake(); // CELL565_RSX_IDLE_PARK
+#endif
+	mtl::counters().offloader_faults.fetch_add(1, std::memory_order_relaxed);
+
+	while (m_offloader_deadlock)
+	{
+		utils::pause();
+	}
+
+	g_fxo->get<rsx::dma_manager>().clear_mem_fault_flag();
+	return true;
+}
+
+bool MTLGSRender::post_flush_request(flush_request&& request)
+{
+	// VKGSRender::on_access_violation order: release this thread's vm lock before taking the queue guard. The RSX thread
+	// holds the guard while it serves the queue (flush_pending_requests), so a guest thread must never wait for it with
+	// its vm lock held (M4 review).
+	vm::temporary_unlock();
+
+	flush_request* task;
+	{
+		std::lock_guard lock(m_flush_queue_guard);
+		task = &m_flush_queue.emplace_back();
+		task->section_data = std::move(request.section_data);
+		task->replay = request.replay;
+		task->is_writing = request.is_writing;
+		task->fault_address = request.fault_address;
+	}
+
+	mtl::counters().flush_requests.fetch_add(1, std::memory_order_relaxed);
+	m_eng_interrupt_mask |= rsx::backend_interrupt;
+#ifdef RPCS3_IOS
+	rpcs3::ios::rsx_idle_park::wake(); // CELL565_RSX_IDLE_PARK: this thread waits until the RSX thread serves it
+#endif
+
+	// GLGSRender work_item::producer_wait: until the RSX thread has served it (no timeout: the data is needed).
+	utils::spin_wait(task->processed, [](auto v) { return v; });
+	// Read before 'received': the RSX thread releases the entry once it is received.
+	const bool handled = task->handled;
+	task->received = true;
+	return handled;
+}
+
+bool MTLGSRender::on_access_violation(u32 address, bool is_writing)
+{
+	rsx::mm_flush(address);
+
+	// The RSX thread flushes in place; a guest thread defers the flush to the RSX thread, the only one recording.
+	const bool can_flush = is_current_thread();
+
+	if (!can_flush && m_commands.has_dma_transfer())
+	{
+		// Review R1: a GPU -> memory copy is recorded and not submitted yet (only while the RSX thread holds the
+		// texture cache lock, between recording and submitting). This thread must not take the lock and then wait for
+		// the RSX thread: the whole fault goes to the RSX thread, which flushes in place, and this thread waits
+		// outside every lock (temporary_unlock).
+		mtl::get_texture_counters().faults_routed++;
+		if (g_fxo->get<rsx::dma_manager>().is_current_thread())
+		{
+			return wait_for_offloader_recovery(is_writing);
+		}
+
+		flush_request request{};
+		request.replay = true;
+		request.is_writing = is_writing;
+		request.fault_address = address;
+		// M4: the ZCULL report pages after the texture cache (zcull_ctrl is released at exit)
+		return post_flush_request(std::move(request)) || (zcull_ctrl && zcull_ctrl->on_access_violation(address));
+	}
+
+	const rsx::invalidation_cause cause = is_writing
+		? (can_flush ? rsx::invalidation_cause::write : rsx::invalidation_cause::deferred_write)
+		: (can_flush ? rsx::invalidation_cause::read : rsx::invalidation_cause::deferred_read);
+
+	auto result = m_texture_cache.invalidate_address(m_commands, address, cause);
+
+	if (result.invalidate_samplers)
+	{
+		std::lock_guard lock(m_sampler_mutex);
+		m_samplers_dirty.store(true);
+	}
+
+	if (!result.violation_handled)
+	{
+		// M4: the ZCULL report pages (zcull_ctrl is released at exit, a late fault on another thread finds none)
+		return zcull_ctrl && zcull_ctrl->on_access_violation(address);
+	}
+
+	if (result.num_flushable > 0)
+	{
+		if (g_fxo->get<rsx::dma_manager>().is_current_thread())
+		{
+			return wait_for_offloader_recovery(is_writing);
+		}
+
+		flush_request request{};
+		request.section_data = std::move(result);
+		post_flush_request(std::move(request));
+	}
+
+	return true;
+}
+
+bool MTLGSRender::flush_pending_requests()
+{
+	bool pending = false;
+	if (m_offloader_deadlock)
+	{
+		// VKGSRender::do_local_task: clear the offloader deadlock.
+		on_invalidate_memory_range(m_offloader_fault_range, m_offloader_fault_cause);
+		m_offloader_deadlock = false;
+		pending = true;
+	}
+
+	std::lock_guard lock(m_flush_queue_guard);
+	if (m_flush_queue.empty())
+	{
+		return pending;
+	}
+
+	m_flush_queue.remove_if([](auto& q) { return q.received.load(); });
+
+	bool flushed = false;
+	for (auto& q : m_flush_queue)
+	{
+		if (q.processed.load())
+		{
+			continue;
+		}
+
+		if (q.replay)
+		{
+			// The guest thread's fault, handled here: the RSX thread flushes in place.
+			const auto cause = q.is_writing ? rsx::invalidation_cause::write : rsx::invalidation_cause::read;
+			const auto result = m_texture_cache.invalidate_address(m_commands, q.fault_address, cause);
+			if (result.invalidate_samplers)
+			{
+				std::lock_guard sampler_lock(m_sampler_mutex);
+				m_samplers_dirty.store(true);
+			}
+			q.handled = result.violation_handled;
+		}
+		else
+		{
+			m_texture_cache.flush_all(m_commands, q.section_data);
+		}
+
+		q.processed = true;
+		flushed = true;
+	}
+
+	if (flushed)
+	{
+		// The flush submitted and waited: the next draw opens its render pass again.
+		m_render_pass_dirty = true;
+	}
+
+	return true;
 }
+
+void MTLGSRender::on_invalidate_memory_range(const utils::address_range32& range, rsx::invalidation_cause cause)
+{
+	auto data = m_texture_cache.invalidate_range(m_commands, range, cause);
+	AUDIT(data.empty());
+
+	if (cause == rsx::invalidation_cause::unmap && data.violation_handled)
+	{
+		m_texture_cache.purge_unreleased_sections();
+		{
+			std::lock_guard lock(m_sampler_mutex);
+			m_samplers_dirty.store(true);
+		}
+	}
+}
+
+void MTLGSRender::on_semaphore_acquire_wait()
+{
+	// M4: query resolution may itself submit and re-enter the wait hook (VKGSRender::on_semaphore_acquire_wait)
+	if (m_servicing_semaphore_wait)
+	{
+		return;
+	}
+
+	struct service_guard
+	{
+		bool& flag;
+		explicit service_guard(bool& value) : flag(value) { flag = true; }
+		~service_guard() { flag = false; }
+	} guard(m_servicing_semaphore_wait);
+	// M4 end
+
+	bool pending = m_offloader_deadlock;
+	{
+		std::lock_guard lock(m_flush_queue_guard);
+		pending = pending || !m_flush_queue.empty();
+	}
+
+	pending = pending || zcull_semaphore_wait_pending();  // M4: ZCULL flush hint, pipe flush (VKGSRender)
+
+	if (pending || (async_flip_requested & flip_request::emu_requested))
+	{
+		do_local_task(rsx::FIFO::state::lock_wait);
+	}
+
+	service_zcull_semaphore_wait();  // M4: ZCULL progress while the acquire blocks the FIFO loop
+}
+
+void MTLGSRender::do_local_task(rsx::FIFO::state state)
+{
+	// GLGSRender / VKGSRender: the texture cache update only runs when no fault request was pending (review R2).
+	const bool requests_pending = flush_pending_requests();
+	// M4: the flush a conditional render evaluation hint scheduled; VK m_flush_requests, which defers the update too
+	const bool zcull_flushed = service_zcull_flush();
+	if (!requests_pending && !zcull_flushed && !in_begin_end && state != rsx::FIFO::state::lock_wait)
+	{
+		if (m_graphics_state & rsx::pipeline_state::framebuffer_reads_dirty)
+		{
+			// This will re-engage locks and break the texture cache if another thread is waiting in access violation
+			// handler! Only call when there are no waiters.
+			m_texture_cache.do_update();
+			m_graphics_state.clear(rsx::pipeline_state::framebuffer_reads_dirty);
+		}
+	}
+
+	rsx::thread::do_local_task(state);
+
+	service_native_ui_flip(state);  // M4: frames for the native interface (VKGSRender::do_local_task)
+}
+
+bool MTLGSRender::scaled_image_from_memory(const rsx::blit_src_info& src, const rsx::blit_dst_info& dst, bool interpolate)
+{
+	// VKGSRender::scaled_image_from_memory. A copy into a DMA section is submitted as soon as it is recorded
+	// (review R1), so nothing of the transfer waits for the next submission.
+	if (m_texture_cache.blit(src, dst, interpolate, m_rtts, m_commands))
+	{
+		m_samplers_dirty.store(true);
+		if (m_commands.has_dma_transfer())
+		{
+			flush_command_queue(false);
+		}
+		return true;
+	}
+
+	return false;
+}
+
+void MTLGSRender::notify_tile_unbound(u32 /*tile*/)
+{
+	// As VKGSRender / GLGSRender (the texture writeback of an unbound tile is a TODO there too).
+	std::lock_guard lock(m_sampler_mutex);
+	m_samplers_dirty.store(true);
+}
