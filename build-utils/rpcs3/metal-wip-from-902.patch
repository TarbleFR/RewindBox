+		const u32 words = data_length / 4;
+		return { words, 0, 0, words };
+	}
+
+	// cs_interleave_task::run; `bound_offset` is where the data is bound.
+	inline std::array<u32, 4> interleave_params(u32 data_offset, u32 data_length, u32 zeta_offset, u32 stencil_offset, u32& bound_offset)
+	{
+		bound_offset = data_offset;
+		const u32 ssbo_length = stencil_offset + (data_length / 4) - data_offset;
+		return { data_length, zeta_offset - data_offset, stencil_offset - data_offset, ssbo_length / 4 };
+	}
+
+	// cs_fconvert_task::run
+	inline std::array<u32, 4> fconvert_params(compute_kernel kernel, u32 src_offset, u32 src_length, u32 dst_offset, u32& bound_offset)
+	{
+		const bool contract = kernel <= compute_kernel::f32_to_f16_swap_both;
+		const u32 from_size = contract ? 4 : 2;
+		const u32 to_size = contract ? 2 : 4;
