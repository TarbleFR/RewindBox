+	void test_depth_conversions()
+	{
+		CHECK(mtl::d24_to_f32(0) == 0.f);
+		CHECK(mtl::d24_to_f32(0xffffff) == 1.f);
+		CHECK(mtl::f32_to_d24(1.f) == 0xffffff);
+		CHECK(mtl::f32_to_d24(0.f) == 0);
+		// D24 -> float -> D24 is the identity for all 2^24 values (round-to-nearest quantisation).
+		u32 mismatches = 0;
+		for (u32 v = 0; v <= 0xffffff; ++v)
+		{
+			if (mtl::f32_to_d24(mtl::d24_to_f32(v)) != v)
+			{
+				if (mismatches++ < 4)
+				{
+					std::fprintf(stderr, "D24 round trip: %u -> %u\n", v, mtl::f32_to_d24(mtl::d24_to_f32(v)));
+				}
+			}
+		}
+		CHECK(mismatches == 0);
+		// Quantisation of values between two D24 steps: to the nearest one, clamped to [0, 1].
+		CHECK(mtl::f32_to_d24(0.5f / 16777215.f * 0.99f) == 0);
+		CHECK(mtl::f32_to_d24(1.5f / 16777215.f * 1.01f) == 2);
+		CHECK(mtl::f32_to_d24(-1.f) == 0);
+		CHECK(mtl::f32_to_d24(2.f) == 0xffffff);
+		CHECK(mtl::f32_to_d24(std::bit_cast<f32>(0x7fc00000u)) == 0);
+		mismatches = 0;
+
+		// Float depth: 24-bit pattern <-> f32 bits (shift by 7), exact both ways.
+		for (u32 v : { 0u, 1u, 0x123456u, 0x7fffffu, 0xffffffu })
+		{
+			CHECK(mtl::f32_bits_to_d24f(mtl::d24f_to_f32_bits(v)) == v);
+		}
+
+		// e4m12: 16-bit pattern <-> f32 bits, exact both ways.
+		for (u32 v = 0; v <= 0xffff; ++v)
+		{
+			if (mtl::f32_bits_to_e4m12(mtl::e4m12_to_f32_bits(static_cast<u16>(v))) != v)
+			{
+				mismatches++;
+			}
+		}
+		CHECK(mismatches == 0);
+		CHECK(std::bit_cast<f32>(mtl::e4m12_to_f32_bits(0)) == std::bit_cast<f32>(120u << 23));
+	}
