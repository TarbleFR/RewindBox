+
+	component_map texture_cache::apply_component_mapping_flags(u32 gcm_format, rsx::component_order flags, const rsx::texture_channel_remap_t& remap) const
+	{
+		component_map mapping{};
+		if (!mtl::apply_component_mapping_flags(gcm_format, static_cast<u32>(flags), remap, mapping))
+		{
+			fmt::throw_exception("Invalid or unsupported component mapping for texture format (0x%x)", gcm_format);
+		}
+		return mapping;
+	}
+
+	std::unique_ptr<mtl::image> texture_cache::create_image(command_context& cmd, u32 gcm_format, texture_type type, u16 width, u16 height, u16 depth, u8 mips) const
+	{
+		const pixel_format format = get_compatible_sampler_format(gcm_format, m_supports_bc);
+		if (format == pixel_format::invalid)
+		{
+			fmt::throw_exception("Invalid or unsupported sampler format for texture format (0x%x)", gcm_format);
+		}
+
+		texture_descriptor desc{};
+		desc.type = type;
+		desc.format = format;
+		desc.width = std::max<u32>(width, 1);
+		desc.height = std::max<u32>(height, 1);
+		desc.depth = (type == texture_type::type_3d) ? std::max<u32>(depth, 1) : 1;
+		desc.array_length = 1;
+
+		// Metal refuses more levels than the full chain of the largest dimension.
+		const u32 largest = std::max({ desc.width, desc.height, desc.depth });
+		const u32 full_chain = 32 - std::countl_zero(largest);
+		desc.mip_levels = std::clamp<u32>(mips, 1, full_chain);
+
+		// Views reinterpret formats (hardware SNORM/sRGB, bit-compatible copies) and swizzle; depth images are cleared
+		// and every uncompressed image is a scaled-copy (blit) destination through a render pass.
+		desc.usage = usage_shader_read | usage_pixel_format_view | (is_compressed_format(format) ? 0 : usage_render_target);
+		desc.storage = storage_mode::private_;
+
+		auto result = std::make_unique<mtl::image>();
+		if (!result->create(cmd, desc, rsx::classify_format(gcm_format)))
+		{
+			return {};
+		}
+		return result;
+	}
+
+	mtl::image* texture_cache::get_template_from_collection_impl(const rsx::simple_array<copy_region_descriptor>& sections_to_transfer) const
+	{
+		if (sections_to_transfer.size() == 1) [[likely]]
+		{
+			return sections_to_transfer.front().src;
+		}
+
+		mtl::image* result = nullptr;
+		for (const auto& section : sections_to_transfer)
+		{
+			if (!section.src)
+			{
+				continue;
+			}
+
+			if (!result)
+			{
+				result = section.src;
+			}
+			else if (section.src->native_component_map != result->native_component_map)
+			{
+				// TODO (as in the Vulkan renderer): mixing component layouts needs compute assistance
+				return nullptr;
+			}
+		}
+
+		return result;
+	}
+
+	u32 texture_cache::copy_transfer_regions_impl(command_context& cmd, mtl::image* dst, const rsx::simple_array<copy_region_descriptor>& sections_to_transfer) const
+	{
+		// VKTextureCache.cpp copy_transfer_regions_impl
+		auto& counters = get_texture_counters();
+		const u32 dst_bpp = get_format_texel_width(dst->format());
+		const bool dst_is_3d = dst->type == texture_type::type_3d;
+		blit_engine* engine = get_blit_engine();
+
+		// The sections come oldest first (newer data must land last): copies that overlap an earlier one of this call
+		// are ordered by a new encoder (review D1). Scaled copies are render passes, ordered by their queue barrier.
+		transfer_scope scope(cmd, "texture copy");
+		u32 transferred = 0;
+
+		for (const auto& section : sections_to_transfer)
+		{
+			mtl::image* src = section.src;
+			if (!src)
+			{
+				continue;
+			}
+
+			const u32 src_bpp = get_format_texel_width(src->format());
+			if (!src_bpp || !dst_bpp)
+			{
+				counters.typeless_not_implemented++;
+				log_once("copy-format", fmt::format("copy between formats %u and %u is not implemented", static_cast<u32>(src->format()), static_cast<u32>(dst->format())));
+				continue;
+			}
+
+			const bool typeless = src->aspect() != dst->aspect() ||
+				!images_are_bitcast_compatible(dst->format(), dst->format_class(), src->format(), src->format_class());
+
+			u16 src_x = section.src_x;
+			u16 src_y = section.src_y;
+			u16 src_w = section.src_w;
+			u16 src_h = section.src_h;
+
+			rsx::flags32_t transform = section.xform;
+			if (section.xform == rsx::surface_transform::coordinate_transform)
+			{
+				// Dimensions were given in 'dst' space. Work out the real source coordinates
+				src_x = static_cast<u16>((src_x * dst_bpp) / src_bpp);
+				src_w = utils::aligned_div<u16>(static_cast<u16>(src_w * dst_bpp), static_cast<u16>(src_bpp));
+				transform &= ~(rsx::surface_transform::coordinate_transform);
+			}
+
+			if (auto surface = try_as_rtt(src))
+			{
+				surface->transform_samples_to_pixels(src_x, src_w, src_y, src_h);
+			}
+
+			if (transform != rsx::surface_transform::identity)
+			{
+				counters.scaled_not_implemented++;
+				log_once("copy-transform", "region copy with a coordinate transform is not implemented");
+				continue;
+			}
+
+			const u32 dst_slice = dst_is_3d ? 0 : section.dst_z;
+			const u32 dst_z = dst_is_3d ? section.dst_z : 0;
+			const u32 level = section.level;
+			const areai dst_rect = { section.dst_x, section.dst_y, section.dst_x + section.dst_w, section.dst_y + section.dst_h };
+
+			mtl::image* src_image = src;
+			if (typeless) [[unlikely]]
+			{
+				const u16 convert_w = static_cast<u16>(u32{src_w} * src_bpp / dst_bpp);
+				const u16 convert_x = static_cast<u16>(u32{src_x} * src_bpp / dst_bpp);
+				const areai src_rect = { src_x, src_y, src_x + src_w, src_y + src_h };
+
+				if (convert_w == section.dst_w && src_h == section.dst_h)
+				{
+					// Optimization to avoid double transfer (refusals are counted inside)
+					transferred += copy_image_typeless(cmd, src, dst, src_rect, dst_rect, level, dst_slice, dst_z) ? 1 : 0;
+					continue;
+				}
+
+				// Into a helper of the destination's format, then scaled below (VK get_typeless_helper).
+				src_image = engine ? engine->get_typeless_helper(cmd, dst->format(), dst->format_class(), convert_x + convert_w, src_y + src_h, 0) : nullptr;
+				if (!src_image || !copy_image_typeless(cmd, src, src_image, src_rect, { 0, 0, convert_w, src_h }))
+				{
+					continue;
+				}
+
+				src_x = 0;
+				src_y = 0;
+				src_w = convert_w;
+			}
+
+			if (src_w == section.dst_w && src_h == section.dst_h) [[likely]]
+			{
+				// Metal does not clip copies: keep every region inside both textures (Vulkan leaves it undefined).
+				const u32 level_w = std::max(dst->width() >> level, 1u);
+				const u32 level_h = std::max(dst->height() >> level, 1u);
+				const u32 w = std::min({ u32{src_w}, src_image->width() > src_x ? src_image->width() - src_x : 0u, level_w > section.dst_x ? level_w - section.dst_x : 0u });
+				const u32 h = std::min({ u32{src_h}, src_image->height() > src_y ? src_image->height() - src_y : 0u, level_h > section.dst_y ? level_h - section.dst_y : 0u });
+				if (w != src_w || h != src_h)
+				{
+					counters.copies_clipped++;
+				}
+				if (!w || !h)
+				{
+					continue;
+				}
+
+				const areai src_box = { src_x, src_y, static_cast<s32>(src_x + w), static_cast<s32>(src_y + h) };
+				const areai dst_box = { section.dst_x, section.dst_y, static_cast<s32>(section.dst_x + w), static_cast<s32>(section.dst_y + h) };
+				if (!copy_image(scope, src_image, dst, src_box, dst_box, level, dst_slice, dst_z))
+				{
+					counters.typeless_not_implemented++;
+					log_once("copy-region", fmt::format("region copy %u -> %u is not possible as a copy", static_cast<u32>(src_image->format()), static_cast<u32>(dst->format())));
+					continue;
+				}
+				transferred++;
+				continue;
+			}
+
+			// Scaled (VK copy_scaled_image, VK_FILTER_NEAREST)
+			const areai src_rect = { src_x, src_y, src_x + src_w, src_y + src_h };
+			if (src_image->format() != dst->format()) [[unlikely]]
+			{
+				// Either a bitcast is required or a scale+copy to mipmap level / layer: scaled in the source's format
+				// into a helper, then the bits copied ("casting comes after the scaling").
+				const areai helper_rect = { 0, 0, section.dst_w, section.dst_h };
+				auto helper = engine ? engine->get_typeless_helper(cmd, src_image->format(), src_image->format_class(), section.dst_w, section.dst_h, 1) : nullptr;
+				if (helper && copy_scaled_image(cmd, src_image, helper, src_rect, helper_rect, 0, 0, 0, true, blit_filter::nearest))
+				{
+					if (copy_image(cmd, helper, dst, helper_rect, dst_rect, level, dst_slice, dst_z))
+					{
+						transferred++;
+					}
+					else
+					{
+						counters.typeless_not_implemented++;
+					}
+				}
+				continue;
+			}
+
+			transferred += copy_scaled_image(cmd, src_image, dst, src_rect, dst_rect, level, dst_slice, dst_z, true, blit_filter::nearest) ? 1 : 0;
+		}
+
+		// ~transfer_scope ends the encoder.
+		return transferred;
+	}
+
+	image_view* texture_cache::create_temporary_subresource_view_impl(command_context& cmd, mtl::image* source, texture_type type,
+		u32 gcm_format, u16 w, u16 h, u16 d, u8 mips, const rsx::texture_channel_remap_t& remap_vector, const copy_region_descriptor* copy)
+	{
+		auto image = create_image(cmd, gcm_format, type, w, h, d, mips);
+		if (!image)
+		{
+			// OOM, bail
+			return nullptr;
+		}
+
+		// This method is almost exclusively used to work on framebuffer resources. Keep the original swizzle layout
+		// unless there is data format conversion.
+		component_map swizzle = default_component_map;
+		if (!source || image->format() != source->format())
+		{
+			// A data cast: the native mapping of the new type.
+			argb_map remap{};
+			if (get_component_mapping(gcm_format, remap))
+			{
+				swizzle = { remap[1], remap[2], remap[3], remap[0] };
+			}
+		}
+		else
+		{
+			swizzle = source->native_component_map;
+		}
+
+		image->set_name(fmt::format("Temp view, fmt=0x%x", gcm_format));
+		image->set_native_component_layout(swizzle);
+
+		if (copy)
+		{
+			// A copy that does not replace every texel, or that is not implemented, must not leave stale memory.
+			const bool covers = copy->dst_x == 0 && copy->dst_y == 0 && copy->dst_w == image->width() && copy->dst_h == image->height() &&
+				image->mipmaps() == 1 && image->layers() == 1;
+			if (!covers)
+			{
+				clear_image(cmd, *m_upload_heap, image.get());
+			}
+
+			rsx::simple_array<copy_region_descriptor> region = { *copy };
+			if (!copy_transfer_regions_impl(cmd, image.get(), region) && covers)
+			{
+				// Nothing was copied (counted where it was refused): zeros rather than uninitialised memory.
+				clear_image(cmd, *m_upload_heap, image.get());
+			}
+		}
+
+		auto view = image->get_view(remap_vector);
+		if (!view)
+		{
+			return nullptr;
+		}
+
+		// Owned through the view until release_temporary_subresource.
+		image.release();
+		return view;
+	}
+
+	image_view* texture_cache::create_temporary_subresource_view(command_context& cmd, const deferred_subresource& desc)
+	{
+		ensure(desc.sections_to_copy.size() == 1);
+		const auto& section = desc.sections_to_copy.front();
+		return create_temporary_subresource_view_impl(cmd, section.src, texture_type::type_2d,
+			desc.gcm_format, desc.width, desc.height, 1, 1, desc.remap, &section);
+	}
+
+	image_view* texture_cache::generate_gather(command_context& cmd, const deferred_subresource& desc, texture_type type, u16 depth_, u8 mips,
+		rsx::texture_dimension_extended memory_type)
+	{
+		auto _template = get_template_from_collection_impl(desc.sections_to_copy);
+		auto result = create_temporary_subresource_view_impl(cmd, _template, type, desc.gcm_format, desc.width, desc.height, depth_, mips, desc.remap);
+		if (!result)
+		{
+			// Failed to create temporary object, bail
+			return nullptr;
+		}
+
+		auto image = result->image();
+		if (desc.force_bg_load)
+		{
+			// The memory load covers the whole image, no need to clear it first
+			initialize_subresource_from_memory(cmd, image, desc, memory_type);
+		}
+		else
+		{
+			// VK skips the clear when the copies are proven to cover every texel; a copy refused here (counted)
+			// would then leave the pool image's previous contents, so the image is always cleared.
+			clear_image(cmd, *m_upload_heap, image);
+		}
+
+		copy_transfer_regions_impl(cmd, image, desc.sections_to_copy);
+		return result;
+	}
+
+	image_view* texture_cache::generate_cubemap_from_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		return generate_gather(cmd, desc, texture_type::type_cube, 1, desc.exact_mip_count(), rsx::texture_dimension_extended::texture_dimension_cubemap);
+	}
+
+	image_view* texture_cache::generate_3d_from_2d_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		return generate_gather(cmd, desc, texture_type::type_3d, desc.depth, desc.exact_mip_count(), rsx::texture_dimension_extended::texture_dimension_3d);
+	}
+
+	image_view* texture_cache::generate_atlas_from_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		return generate_gather(cmd, desc, texture_type::type_2d, 1, 1, rsx::texture_dimension_extended::texture_dimension_2d);
+	}
+
+	image_view* texture_cache::generate_2d_mipmaps_from_images(command_context& cmd, const deferred_subresource& desc)
+	{
+		const auto mipmaps = ::narrow<u8>(desc.sections_to_copy.size());
+		return generate_gather(cmd, desc, texture_type::type_2d, 1, mipmaps, rsx::texture_dimension_extended::texture_dimension_2d);
+	}
+
+	void texture_cache::release_temporary_subresource(image_view* view)
+	{
+		// ~image hands the texture and its views to the deferred release.
+		std::unique_ptr<mtl::image> image(ensure(view->image()));
+	}
+
+	void texture_cache::initialize_subresource_from_memory(command_context& cmd, mtl::image* dst, const deferred_subresource& desc, rsx::texture_dimension_extended type) const
+	{
+		auto subresources_layout = rsx::get_subresources_layout(desc, type);
+		std::erase_if(subresources_layout, [mipmaps = dst->mipmaps()](const rsx::subresource_layout& layout)
+		{
+			return layout.level >= mipmaps;
+		});
+		upload_image(cmd, *m_upload_heap, dst, subresources_layout, desc.gcm_format, desc.swizzled, m_supports_bc);
+	}
+
+	void texture_cache::update_image_contents(command_context& cmd, image_view* dst_view, const deferred_subresource& desc)
+	{
+		copy_transfer_regions_impl(cmd, dst_view->image(), desc.sections_to_copy);
+	}
+
+	cached_texture_section* texture_cache::create_new_texture(command_context& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch,
+		u32 gcm_format, rsx::texture_upload_context context, rsx::texture_dimension_extended type, bool swizzled, rsx::component_order swizzle_flags, rsx::flags32_t flags)
+	{
+		const auto section_depth = depth;
+
+		texture_type image_type = texture_type::type_2d;
+		switch (type)
+		{
+		case rsx::texture_dimension_extended::texture_dimension_1d:
+			// Sampled as a 2D texture of height 1 (the translator's texture_1D_as_2D).
+			image_type = texture_type::type_2d;
+			height = 1;
+			depth = 1;
+			break;
+		case rsx::texture_dimension_extended::texture_dimension_2d:
+			image_type = texture_type::type_2d;
+			depth = 1;
+			break;
+		case rsx::texture_dimension_extended::texture_dimension_cubemap:
+			image_type = texture_type::type_cube;
+			depth = 1;
+			break;
+		case rsx::texture_dimension_extended::texture_dimension_3d:
+			image_type = texture_type::type_3d;
+			break;
+		default:
+			fmt::throw_exception("Unreachable");
+		}
+
+		// Check what actually exists at that address
+		const rsx::image_section_attributes_t search_desc = { .gcm_format = gcm_format, .width = width, .height = height, .depth = section_depth, .mipmaps = mipmaps };
+		const bool allow_dirty = (context != rsx::texture_upload_context::framebuffer_storage);
+		cached_texture_section& region = *find_cached_texture(rsx_range, search_desc, true, true, allow_dirty);
+		ensure(!region.is_locked());
+
+		mtl::image* image = nullptr;
+		if (region.exists())
+		{
+			image = region.get_raw_texture();
+			if (!image || region.get_image_type() != type || image->depth() != depth)
+			{
+				// Incompatible view/type
+				region.destroy();
+				image = nullptr;
+			}
+			else
+			{
+				ensure(region.is_managed());
+
+				// Reuse
+				region.set_rsx_pitch(pitch);
+
+				if (flags & texture_create_flags::initialize_image_contents)
+				{
+					// VK wipes colour to (0, 0, 0, 1); this clears colour to zero. Unreachable without the blit
+					// engine (stage M3.2), which is the only user of the flag.
+					clear_image(cmd, *m_upload_heap, image);
+				}
+			}
+		}
+
+		if (!image)
+		{
+			auto created = create_image(cmd, gcm_format, image_type, width, height, depth, static_cast<u8>(std::min<u16>(mipmaps, 255)));
+			image = ensure(created.release(), "Metal: texture cache image allocation failed");
+
+			// New section, we must prepare it
+			region.reset(rsx_range);
+			region.set_gcm_format(gcm_format);
+			region.set_image_type(type);
+			region.create(width, height, section_depth, mipmaps, image, pitch, true, gcm_format);
+		}
+
+		region.set_view_flags(swizzle_flags);
+		region.set_context(context);
+		region.set_swizzled(swizzled);
+		region.set_dirty(false);
+
+		image->set_native_component_layout(apply_component_mapping_flags(gcm_format, swizzle_flags, rsx::default_remap_vector));
+
+		// Its not necessary to lock blit dst textures as they are just reused as necessary
+		switch (context)
+		{
+		case rsx::texture_upload_context::shader_read:
+		case rsx::texture_upload_context::blit_engine_src:
+			region.protect(utils::protection::ro);
+			read_only_range = region.get_min_max(read_only_range, rsx::section_bounds::locked_range);
+			break;
+		case rsx::texture_upload_context::blit_engine_dst:
+			region.set_unpack_swap_bytes(true);
+			no_access_range = region.get_min_max(no_access_range, rsx::section_bounds::locked_range);
+			break;
+		case rsx::texture_upload_context::dma:
+		case rsx::texture_upload_context::framebuffer_storage:
+		default:
+			fmt::throw_exception("Unexpected upload context 0x%x", u32(context));
+		}
+
+		update_cache_tag();
+		return &region;
+	}
+
+	cached_texture_section* texture_cache::create_nul_section(command_context& /*cmd*/, const utils::address_range32& rsx_range, const rsx::image_section_attributes_t& attrs,
+		const rsx::GCM_tile_reference& /*tile*/, bool /*memory_load*/)
+	{
+		auto& region = *find_cached_texture(rsx_range, { .gcm_format = RSX_GCM_FORMAT_IGNORED }, true, false, false);
+		ensure(!region.is_locked());
+
+		// Prepare section
+		region.reset(rsx_range);
+		region.create_dma_only(attrs.width, attrs.height, attrs.pitch);
+		region.set_dirty(false);
+		region.set_unpack_swap_bytes(true);
+
+		no_access_range = region.get_min_max(no_access_range, rsx::section_bounds::locked_range);
+		update_cache_tag();
+		return &region;
+	}
+
+	cached_texture_section* texture_cache::upload_image_from_cpu(command_context& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch, u32 gcm_format,
+		rsx::texture_upload_context context, const std::vector<rsx::subresource_layout>& subresource_layout, rsx::texture_dimension_extended type, bool swizzled)
+	{
+		auto section = create_new_texture(cmd, rsx_range, width, height, depth, mipmaps, pitch, gcm_format, context, type, swizzled,
+			rsx::component_order::default_, 0);
+
+		auto image = section->get_raw_texture();
+		image->set_name(fmt::format("Raw Texture @0x%x", rsx_range.start));
+
+		bool input_swizzled = swizzled;
+		if (context == rsx::texture_upload_context::blit_engine_src)
+		{
+			// Swizzling is ignored for blit engine copy and emulated using remapping
+			input_swizzled = false;
+
+			if (rsx::get_current_renderer()->get_tiled_memory_region(rsx_range))
+			{
+				// VK detiles blit sources on the GPU first (stage M3.2 with the blit engine).
+				get_texture_counters().typeless_not_implemented++;
+				log_once("upload-tiled-blit", "tiled blit-engine source upload is not detiled yet");
+			}
+		}
+
+		upload_image(cmd, *m_upload_heap, image, subresource_layout, gcm_format, input_swizzled, m_supports_bc);
+
+		section->last_write_tag = rsx::get_shared_tag();
+		return section;
+	}
+
+	void texture_cache::set_component_order(cached_texture_section& section, u32 gcm_format, rsx::component_order expected_flags)
+	{
+		if (expected_flags == section.get_view_flags())
+		{
+			return;
+		}
+
+		const component_map mapping = apply_component_mapping_flags(gcm_format, expected_flags, rsx::default_remap_vector);
+		auto image = section.get_raw_texture();
+
+		ensure(image);
+#ifdef RPCS3_IOS
+		section.ios_memo_changed(); // REWINDBOX_TEXTURE_LOOKUP_MEMO_660: the section's views are disposed
+#endif
+		image->set_native_component_layout(mapping);
+
+		section.set_view_flags(expected_flags);
+	}
+
+	void texture_cache::insert_texture_barrier(command_context& /*cmd*/, mtl::image* /*tex*/, bool /*strong_ordering*/)
+	{
+		// A render target sampled while bound (a cyclic reference) is never read in place on Metal: before the draw,
+		// MTLGSRender::prepare_texture_bindings copies every bound attachment that a unit samples (after the pass
+		// that wrote it has ended) and binds the copy. That is the barrier: the copy sees every earlier write.
+	}
+
+	bool texture_cache::render_target_format_is_compatible(mtl::image* tex, u32 gcm_format)
+	{
+		if (mtl::render_target_format_is_compatible(tex->format(), gcm_format))
+		{
+			return true;
+		}
+
+		switch (gcm_format)
+		{
+		case CELL_GCM_TEXTURE_R5G6B5:
+		case CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT:
+		case CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT:
+		case CELL_GCM_TEXTURE_X32_FLOAT:
+		case CELL_GCM_TEXTURE_A8R8G8B8:
+		case CELL_GCM_TEXTURE_D8R8G8B8:
+		case CELL_GCM_TEXTURE_B8:
+		case CELL_GCM_TEXTURE_G8B8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT:
+		case CELL_GCM_TEXTURE_X16:
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT:
+			return false;
+		default:
+			warn_once("Format incompatibility detected, reporting failure to force data copy (MTL_FORMAT=0x%X, GCM_FORMAT=0x%X)", static_cast<u32>(tex->format()), gcm_format);
+			return false;
+		}
+	}
+
+	void texture_cache::prepare_for_dma_transfers(command_context& cmd)
+	{
+		ensure(cmd.recording());
+		m_dma_batch_depth++;
+	}
+
+	void texture_cache::cleanup_after_dma_transfers(command_context& cmd)
+	{
+		// The batch of hard-fault copies: submit and wait (VK submits its command buffer and waits on its fence).
+		ensure(m_dma_batch_depth > 0);
+		m_dma_batch_depth--;
+		cmd.submit_and_wait();
+	}
+
+	bool texture_cache::is_depth_texture(u32 rsx_address, u32 rsx_size)
+	{
+		reader_lock lock(m_cache_mutex);
+
+		auto& block = m_storage.block_for(rsx_address);
+		if (block.get_locked_count() == 0)
+		{
+			return false;
+		}
+
+		for (auto& tex : block)
+		{
+			if (tex.is_dirty())
+			{
+				continue;
+			}
+
+			if (!tex.overlaps(rsx_address, rsx::section_bounds::full_range))
+			{
+				continue;
+			}
+
+			if ((rsx_address + rsx_size - tex.get_section_base()) <= tex.get_section_size())
+			{
+				return is_depth_format(tex.get_format());
+			}
+		}
+
+		return false;
+	}
+
+	bool texture_cache::blit(const rsx::blit_src_info& src, const rsx::blit_dst_info& dst, bool interpolate, mtl::surface_cache& m_rtts, command_context& cmd)
+	{
+		// VKTextureCache.cpp texture_cache::blit
+		blitter helper;
+		auto reply = upload_scaled_image(src, dst, interpolate, cmd, m_rtts, helper);
+
+		if (reply.succeeded)
+		{
+			get_texture_counters().blits++;
+			if (reply.real_dst_size)
+			{
+				flush_if_cache_miss_likely(cmd, reply.to_address_range());
+			}
+
+			return true;
+		}
+
+		get_texture_counters().blits_failed++;
+		return false;
+	}
+
+	void texture_cache::on_frame_end()
+	{
+		trim_sections();
+
+		if (m_storage.m_unreleased_texture_objects >= m_max_zombie_objects)
+		{
+			purge_unreleased_sections();
+		}
+
+		baseclass::on_frame_end();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTextureCache.h b/rpcs3/Emu/RSX/Metal/MTLTextureCache.h
new file mode 100644
index 0000000..ad333ab
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTextureCache.h
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M3.1): the Metal 4 backend of RPCS3's common texture cache (rsx::texture_cache), modelled on
+// the Vulkan backend (VKTextureCache.h/.cpp) with the OpenGL backend's readback through a host-visible buffer.
+//
+// All of the RSX memory logic stays in the common code: section lookup, page protection and invalidation, surface
+// cache lookups (render-to-texture), deferred subresources (copies, atlases, cubemap and 3D gathers, mipmap chains),
+// predictions and flushes. This backend creates images, uploads guest memory into them (MTLTexture.cpp), copies
+// regions with the compute encoder, and reads sections back:
+//   - copy_texture records a texture -> buffer copy into a shared-storage buffer of the section and remembers the
+//     submission that holds it; map_synchronized waits for that submission (submitting it first when it is still
+//     being recorded), then converts the copy into the guest layout on the CPU (byte order, D24S8 / D16F packing
+//     with the Vulkan renderer's formulas) for the common imp_flush to write into guest memory;
+//   - every flush runs on the RSX thread (the renderer posts the faulting thread's request, as the OpenGL
+//     renderer does), so this backend never records from another thread; every copy is submitted before the cache
+//     lock is released (review R1), so a write-back elsewhere only ever waits for the GPU;
+//   - scaled sections are read back through a scaled copy (MTLBlit.h), tiled ones are tiled on the CPU with the
+//     common tiling helper straight into guest memory (M3.2);
+//   - the blit engine (upload_scaled_image) runs on the transfers of MTLBlit.h (M3.2).
+// What is not written yet is counted (COREPROF METAL) and logged once, never faked: byte-shuffling or depth <->
+// colour reinterpretations (the destination keeps its clear or memory contents) and readbacks of compressed data
+// (the guest memory keeps its contents).
+
+#include "MTLRenderTargets.h"
+#include "MTLTexture.h"
+
+#include "Emu/RSX/Common/texture_cache.h"
+
+#include <memory>
+#include <vector>
+
+namespace mtl
+{
+	class cached_texture_section;
+	class texture_cache;
+
+	struct texture_cache_traits
+	{
+		using commandbuffer_type      = mtl::command_context;
+		using section_storage_type    = mtl::cached_texture_section;
+		using texture_cache_type      = mtl::texture_cache;
+		using texture_cache_base_type = rsx::texture_cache<texture_cache_type, texture_cache_traits>;
+		using image_resource_type     = mtl::image*;
+		using image_view_type         = mtl::image_view*;
+		using image_storage_type      = mtl::image;
+		using texture_format          = mtl::pixel_format;
+		using viewable_image_type     = mtl::image*;
+	};
+
+	// How a section's readback is turned into guest memory (decided when the copy is recorded).
+	enum class readback_mode : u8
+	{
+		none,
+		copy,           // texels as they are, byteswapped per element when the section swaps bytes
+		depth16,        // Depth16Unorm -> u16
+		depth16_float,  // Depth32Float -> e4m12 u16
+		depth24,        // Depth32Float_Stencil8 -> D24S8 u32 (unorm or float depth)
+		keep_memory,    // not implemented for this section: the guest memory keeps its contents (counted)
+	};
+
+	class cached_texture_section : public rsx::cached_texture_section<mtl::cached_texture_section, mtl::texture_cache_traits>
+	{
+		using baseclass = rsx::cached_texture_section<mtl::cached_texture_section, mtl::texture_cache_traits>;
+		friend baseclass;
+
+		std::unique_ptr<mtl::image> managed_texture;
+		mtl::image* vram_texture = nullptr;
+
+		// Readback
+		object m_download;
+		u64 m_download_size = 0;
+		u64 m_fence = 0;
+		bool m_converted = false;
+		readback_mode m_mode = readback_mode::none;
+		bool m_depth_float = false;
+		u32 m_transfer_width = 0;
+		u32 m_transfer_height = 0;
+		u32 m_guest_bpp = 0;
+		u32 m_element_size = 0;
+		u32 m_origin = 0;            // guest address of the region's first texel
+		u64 m_scratch_offset = 0;
+		u64 m_stencil_offset = 0;
+
+	public:
+		using baseclass::cached_texture_section;
+
+		void create(u16 w, u16 h, u16 depth, u16 mipmaps, mtl::image* image, u32 rsx_pitch, bool managed, u32 gcm_format, bool pack_swap_bytes = false);
+		void create(u16 w, u16 h, u16 depth, u16 mipmaps, mtl::image* image, u32 rsx_pitch, bool managed, const mtl::render_target* surface);
+
+		void release_dma_resources();
+		void dma_abort() override;
+		void destroy();
+
+		bool exists() const { return vram_texture != nullptr; }
+		bool is_managed() const { return !exists() || managed_texture; }
+
+		image_view* get_view(const rsx::texture_channel_remap_t& remap);
+		image_view* get_raw_view();
+		mtl::image* get_raw_texture() { return managed_texture.get(); }
+		std::unique_ptr<mtl::image>& get_texture() { return managed_texture; }
+		mtl::render_target* get_render_target() const { return as_rtt(vram_texture); }
+		pixel_format get_format() const;
+		bool is_flushed() const { return flushed; }
+
+		// GPU -> host-visible buffer (VK copy_texture / dma_transfer)
+		void copy_texture(command_context& cmd, bool miss);
+		void dma_transfer(command_context& cmd, mtl::image* src, const areai& src_area, const utils::address_range32& valid_range, u32 pitch);
+
+		// Flush: the converted readback written into guest memory, linear or tiled (VK imp_flush).
+		void imp_flush() override;
+		void* map_synchronized(u32 offset, u32 size);
+		void finish_flush() {}
+
+		void set_unpack_swap_bytes(bool swap_bytes) { pack_unpack_swap_bytes = swap_bytes; }
+		void set_rsx_pitch(u32 pitch);
+		void sync_surface_memory(const rsx::simple_array<cached_texture_section*>& surfaces);
+		bool has_compatible_format(mtl::image* tex) const { return vram_texture->format() == tex->format(); }
+		bool is_depth_texture() const { return vram_texture->is_depth(); }
+
+	private:
+		void mark_keep_memory(const char* key, const char* reason);
+		void convert_readback(u8* base);
+		u8* finish_readback();
+		void write_guest(u32 address, const u8* src, u32 length) const;
+	};
+
+	class texture_cache : public rsx::texture_cache<mtl::texture_cache, mtl::texture_cache_traits>
+	{
+	private:
+		using baseclass = rsx::texture_cache<mtl::texture_cache, mtl::texture_cache_traits>;
+		friend baseclass;
+
+	public:
+		enum texture_create_flags : u32
+		{
+			initialize_image_contents = 1,
+		};
+
+		void on_section_destroyed(cached_texture_section& tex) override;
+
+	private:
+		data_heap* m_upload_heap = nullptr;
+		bool m_supports_bc = false;
+		u32 m_dma_batch_depth = 0;   // inside prepare_for_dma_transfers .. cleanup_after_dma_transfers (lock held)
+
+		void clear();
+
+		component_map apply_component_mapping_flags(u32 gcm_format, rsx::component_order flags, const rsx::texture_channel_remap_t& remap) const;
+
+		// Returns how many of the regions were transferred (the others are counted where they were refused).
+		u32 copy_transfer_regions_impl(command_context& cmd, mtl::image* dst, const rsx::simple_array<copy_region_descriptor>& sections_to_transfer) const;
+		mtl::image* get_template_from_collection_impl(const rsx::simple_array<copy_region_descriptor>& sections_to_transfer) const;
+		std::unique_ptr<mtl::image> create_image(command_context& cmd, u32 gcm_format, texture_type type, u16 width, u16 height, u16 depth, u8 mips) const;
+
+	protected:
+		image_view* create_temporary_subresource_view_impl(command_context& cmd, mtl::image* source, texture_type type,
+			u32 gcm_format, u16 w, u16 h, u16 d, u8 mips, const rsx::texture_channel_remap_t& remap_vector, const copy_region_descriptor* copy = nullptr);
+		image_view* generate_gather(command_context& cmd, const deferred_subresource& desc, texture_type type, u16 depth, u8 mips,
+			rsx::texture_dimension_extended memory_type);
+
+		image_view* create_temporary_subresource_view(command_context& cmd, const deferred_subresource& desc) override;
+		image_view* generate_cubemap_from_images(command_context& cmd, const deferred_subresource& desc) override;
+		image_view* generate_3d_from_2d_images(command_context& cmd, const deferred_subresource& desc) override;
+		image_view* generate_atlas_from_images(command_context& cmd, const deferred_subresource& desc) override;
+		image_view* generate_2d_mipmaps_from_images(command_context& cmd, const deferred_subresource& desc) override;
+		void release_temporary_subresource(image_view* view) override;
+
+		void initialize_subresource_from_memory(command_context& cmd, mtl::image* dst, const deferred_subresource& desc, rsx::texture_dimension_extended type) const;
+		void update_image_contents(command_context& cmd, image_view* dst_view, const deferred_subresource& desc) override;
+
+		cached_texture_section* create_new_texture(command_context& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch,
+			u32 gcm_format, rsx::texture_upload_context context, rsx::texture_dimension_extended type, bool swizzled, rsx::component_order swizzle_flags, rsx::flags32_t flags) override;
+		cached_texture_section* create_nul_section(command_context& cmd, const utils::address_range32& rsx_range, const rsx::image_section_attributes_t& attrs,
+			const rsx::GCM_tile_reference& tile, bool memory_load) override;
+		cached_texture_section* upload_image_from_cpu(command_context& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch, u32 gcm_format,
+			rsx::texture_upload_context context, const std::vector<rsx::subresource_layout>& subresource_layout, rsx::texture_dimension_extended type, bool swizzled) override;
+
+		void set_component_order(cached_texture_section& section, u32 gcm_format, rsx::component_order expected_flags) override;
+		void insert_texture_barrier(command_context& cmd, mtl::image* tex, bool strong_ordering) override;
+		bool render_target_format_is_compatible(mtl::image* tex, u32 gcm_format) override;
+		void prepare_for_dma_transfers(command_context& cmd) override;
+		void cleanup_after_dma_transfers(command_context& cmd) override;
+
+	public:
+		using baseclass::texture_cache;
+
+		void initialize(data_heap& upload_heap, bool supports_bc);
+		void destroy() override;
+		bool is_depth_texture(u32 rsx_address, u32 rsx_size) override;
+		void on_frame_end() override;
+		bool supports_bc() const { return m_supports_bc; }
+
+		// The blit engine (VKTextureCache.cpp texture_cache::blit).
+		bool blit(const rsx::blit_src_info& src, const rsx::blit_dst_info& dst, bool interpolate, mtl::surface_cache& m_rtts, command_context& cmd);
+		bool in_dma_batch() const { return m_dma_batch_depth != 0; }
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTextureFormats.h b/rpcs3/Emu/RSX/Metal/MTLTextureFormats.h
new file mode 100644
index 0000000..8cbdb43
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTextureFormats.h
@@ -0,0 +1,623 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M3.1): RSX texture formats, component orders and sampler states for the native Metal 4
+// renderer. Pure functions (no Metal, no logging) so the host unit tests (Metal/tests) check them directly.
+//
+// Every choice is the Vulkan renderer's (VKFormats.cpp, VKTextureCache.cpp, VKDraw.cpp) on an arm64 Apple GPU,
+// mapped through MoltenVK's Vulkan -> Metal pixel format table, so a texture has the layout, precision and channel
+// order it has on the MoltenVK path today:
+//   R5G6B5_UNORM_PACK16 -> B5G6R5Unorm, R5G5B5A1_UNORM_PACK16 -> A1BGR5Unorm, A1R5G5B5_UNORM_PACK16 -> BGR5A1Unorm,
+//   R4G4B4A4_UNORM_PACK16 -> ABGR4Unorm, D32_SFLOAT_S8_UINT -> Depth32Float_Stencil8 (no D24S8 on iPhone GPUs).
+// Component maps are Metal swizzles (MTLTextureSwizzle); "ARGB" arrays follow RSX's channel order as VK does.
+
+#include "MTLFormats.h"
+
+#include "Emu/RSX/Utils/color_utils.hpp"
+
+#include <array>
+#include <bit>
+#include <cmath>
+#include <utility>
+
+namespace mtl
+{
+	// Remap encodings with a renderer meaning (never produced by the RSX, whose encodings are 16-bit).
+	inline constexpr u32 remap_identity_raw = 0xCAFE0001u;   // the texture's own channels, no native layout
+
+	using argb_map = std::array<swizzle, 4>;
+
+	// VKFormats.cpp get_compatible_sampler_format (arm64: native 16-bit packed formats), through MoltenVK.
+	constexpr pixel_format get_compatible_sampler_format(u32 gcm_format, bool supports_bc)
+	{
+		switch (gcm_format)
+		{
+		case CELL_GCM_TEXTURE_R5G6B5: return pixel_format::b5g6r5_unorm;
+		case CELL_GCM_TEXTURE_R6G5B5: return pixel_format::b5g6r5_unorm;
+		case CELL_GCM_TEXTURE_R5G5B5A1: return pixel_format::a1bgr5_unorm;
+		case CELL_GCM_TEXTURE_D1R5G5B5: return pixel_format::bgr5a1_unorm;
+		case CELL_GCM_TEXTURE_A1R5G5B5: return pixel_format::bgr5a1_unorm;
+		case CELL_GCM_TEXTURE_A4R4G4B4: return pixel_format::abgr4_unorm;
+		case CELL_GCM_TEXTURE_B8: return pixel_format::r8_unorm;
+		case CELL_GCM_TEXTURE_A8R8G8B8: return pixel_format::bgra8_unorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_DXT1: return supports_bc ? pixel_format::bc1_rgba : pixel_format::bgra8_unorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_DXT23: return supports_bc ? pixel_format::bc2_rgba : pixel_format::bgra8_unorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_DXT45: return supports_bc ? pixel_format::bc3_rgba : pixel_format::bgra8_unorm;
+		case CELL_GCM_TEXTURE_G8B8: return pixel_format::rg8_unorm;
+		case CELL_GCM_TEXTURE_DEPTH24_D8: return pixel_format::depth32_float_stencil8;
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT: return pixel_format::depth32_float_stencil8;
+		case CELL_GCM_TEXTURE_DEPTH16: return pixel_format::depth16_unorm;
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT: return pixel_format::depth32_float;
+		case CELL_GCM_TEXTURE_X16: return pixel_format::r16_unorm;
+		case CELL_GCM_TEXTURE_Y16_X16: return pixel_format::rg16_unorm;
+		case CELL_GCM_TEXTURE_Y16_X16_FLOAT: return pixel_format::rg16_float;
+		case CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT: return pixel_format::rgba16_float;
+		case CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT: return pixel_format::rgba32_float;
+		case CELL_GCM_TEXTURE_X32_FLOAT: return pixel_format::r32_float;
+		case CELL_GCM_TEXTURE_D8R8G8B8: return pixel_format::bgra8_unorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_HILO8: return pixel_format::rg8_unorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_HILO_S8: return pixel_format::rg8_snorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_B8R8_G8R8: return pixel_format::bgra8_unorm;
+		case CELL_GCM_TEXTURE_COMPRESSED_R8B8_R8G8: return pixel_format::bgra8_unorm;
+		default: return pixel_format::invalid;
+		}
+	}
+
+	// VKFormats.cpp get_component_mapping: the native component map of a texture format, in ARGB order.
+	// Returns false for a format without one (the Vulkan renderer throws there).
+	constexpr bool get_component_mapping(u32 gcm_format, argb_map& out)
+	{
+		constexpr auto A = swizzle::alpha, R = swizzle::red, G = swizzle::green, B = swizzle::blue, ONE = swizzle::one;
+		switch (gcm_format)
+		{
+		case CELL_GCM_TEXTURE_A1R5G5B5:
+		case CELL_GCM_TEXTURE_R5G5B5A1:
+		case CELL_GCM_TEXTURE_R6G5B5:
+		case CELL_GCM_TEXTURE_R5G6B5:
+		case CELL_GCM_TEXTURE_COMPRESSED_DXT1:
+		case CELL_GCM_TEXTURE_COMPRESSED_DXT23:
+		case CELL_GCM_TEXTURE_COMPRESSED_DXT45:
+			out = { A, R, G, B }; return true;
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT:
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT:
+			out = { R, R, R, R }; return true;
+		case CELL_GCM_TEXTURE_A4R4G4B4:
+			out = { R, G, B, A }; return true;
+		case CELL_GCM_TEXTURE_G8B8:
+			out = { G, R, G, R }; return true;
+		case CELL_GCM_TEXTURE_B8:
+			out = { ONE, R, R, R }; return true;
+		case CELL_GCM_TEXTURE_X16:
+			out = { R, ONE, R, ONE }; return true;
+		case CELL_GCM_TEXTURE_X32_FLOAT:
+			out = { R, R, R, R }; return true;
+		case CELL_GCM_TEXTURE_Y16_X16:
+			out = { G, R, G, R }; return true;
+		case CELL_GCM_TEXTURE_Y16_X16_FLOAT:
+			out = { R, G, R, G }; return true;
+		case CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT:
+		case CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT:
+			out = { A, R, G, B }; return true;
+		case CELL_GCM_TEXTURE_D8R8G8B8:
+			out = { ONE, R, G, B }; return true;
+		case CELL_GCM_TEXTURE_D1R5G5B5:
+			out = { ONE, R, G, B }; return true;
+		case CELL_GCM_TEXTURE_COMPRESSED_HILO8:
+		case CELL_GCM_TEXTURE_COMPRESSED_HILO_S8:
+			out = { R, G, R, G }; return true;
+		case CELL_GCM_TEXTURE_COMPRESSED_B8R8_G8R8:
+		case CELL_GCM_TEXTURE_COMPRESSED_R8B8_R8G8:
+			out = { A, R, G, B }; return true;
+		case CELL_GCM_TEXTURE_A8R8G8B8:
+			out = { A, R, G, B }; return true;
+		default:
+			return false;
+		}
+	}
+
+	// image_helpers.cpp apply_swizzle_remap: RSX remap of an ARGB map, returned as the RGBA swizzle of a view.
+	inline component_map apply_swizzle_remap(const argb_map& base, const rsx::texture_channel_remap_t& remap)
+	{
+		const auto final_mapping = remap.remap(base, swizzle::zero, swizzle::one);
+		return { final_mapping[1], final_mapping[2], final_mapping[3], final_mapping[0] };
+	}
+
+	// VKTextureCache.cpp apply_component_mapping_flags (an RGBA swizzle). Returns false for an unknown format.
+	inline bool apply_component_mapping_flags(u32 gcm_format, u32 flags /* rsx::component_order */, const rsx::texture_channel_remap_t& remap, component_map& out)
+	{
+		switch (gcm_format)
+		{
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT:
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT:
+			out = { swizzle::red, swizzle::red, swizzle::red, swizzle::red };
+			return true;
+		default:
+			break;
+		}
+
+		switch (flags)
+		{
+		case 0: // default_
+		{
+			argb_map base{};
+			if (!get_component_mapping(gcm_format, base))
+			{
+				return false;
+			}
+			out = apply_swizzle_remap(base, remap);
+			return true;
+		}
+		case 1: // native
+			out = { swizzle::red, swizzle::green, swizzle::blue, swizzle::alpha };
+			return true;
+		case 2: // swapped_native
+			out = { swizzle::alpha, swizzle::red, swizzle::green, swizzle::blue };
+			return true;
+		default:
+			// The Vulkan renderer leaves the mapping zeroed (all channels zero).
+			out = { swizzle::zero, swizzle::zero, swizzle::zero, swizzle::zero };
+			return true;
+		}
+	}
+
+	// The swizzle of a view: viewable_image::get_view (VK) for the three kinds of remap encoding.
+	inline component_map view_swizzle(const component_map& native, const rsx::texture_channel_remap_t& remap)
+	{
+		if (remap.encoded == remap_identity_raw)
+		{
+			return default_component_map;
+		}
+
+		if (remap.encoded == RSX_TEXTURE_REMAP_IDENTITY)
+		{
+			return native;
+		}
+
+		return apply_swizzle_remap({ native[3], native[0], native[1], native[2] }, remap);
+	}
+
+	// The key of a view in an image's view cache (VK: remap encoding | aspect << 32), plus the view format.
+	inline u64 view_key(const component_map& native, const rsx::texture_channel_remap_t& remap, u32 aspect, pixel_format format)
+	{
+		u32 encoding = remap.encoded;
+		if (encoding == remap_identity_raw && native == default_component_map)
+		{
+			encoding = RSX_TEXTURE_REMAP_IDENTITY;
+		}
+		return static_cast<u64>(encoding) | (static_cast<u64>(aspect & 0xff) << 32) | (static_cast<u64>(static_cast<u32>(format) & 0xffff) << 40);
+	}
+
+	// VKFormats.cpp get_compatible_srgb_format / get_compatible_snorm_format on formats Metal has (MoltenVK maps
+	// B8G8R8A8_SNORM, R8_SRGB and R8G8_SRGB to no Metal format on iOS: the shader conversion stays in use).
+	constexpr pixel_format get_compatible_srgb_format(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::rgba8_unorm: return pixel_format::rgba8_unorm_srgb;
+		case pixel_format::bgra8_unorm: return pixel_format::bgra8_unorm_srgb;
+		case pixel_format::bc1_rgba: return pixel_format::bc1_rgba_srgb;
+		case pixel_format::bc2_rgba: return pixel_format::bc2_rgba_srgb;
+		case pixel_format::bc3_rgba: return pixel_format::bc3_rgba_srgb;
+		default: return pixel_format::invalid;
+		}
+	}
+
+	constexpr pixel_format get_compatible_snorm_format(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::r8_unorm: return pixel_format::r8_snorm;
+		case pixel_format::rg8_unorm: return pixel_format::rg8_snorm;
+		case pixel_format::rgba8_unorm: return pixel_format::rgba8_snorm;
+		case pixel_format::r16_unorm: return pixel_format::r16_snorm;
+		case pixel_format::rg16_unorm: return pixel_format::rg16_snorm;
+		default: return pixel_format::invalid;
+		}
+	}
+
+	constexpr bool is_compressed_format(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::bc1_rgba: case pixel_format::bc1_rgba_srgb:
+		case pixel_format::bc2_rgba: case pixel_format::bc2_rgba_srgb:
+		case pixel_format::bc3_rgba: case pixel_format::bc3_rgba_srgb:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	// Bytes per 4x4 block of a compressed format (0 otherwise).
+	constexpr u32 get_block_size(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::bc1_rgba: case pixel_format::bc1_rgba_srgb: return 8;
+		case pixel_format::bc2_rgba: case pixel_format::bc2_rgba_srgb:
+		case pixel_format::bc3_rgba: case pixel_format::bc3_rgba_srgb: return 16;
+		default: return 0;
+		}
+	}
+
+	// 32-bit float formats need supports32BitFloatFiltering to be filtered linearly.
+	constexpr bool is_float32_format(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::r32_float: case pixel_format::rg32_float: case pixel_format::rgba32_float:
+		case pixel_format::depth32_float: case pixel_format::depth32_float_stencil8:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	// VKFormats.cpp get_format_texel_width: the guest-side bytes of one texel of a host format (D32F stands for a
+	// 16-bit guest depth, D32F_S8 for a 32-bit one, as in the Vulkan renderer).
+	constexpr u32 get_format_texel_width(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::r8_unorm: case pixel_format::r8_snorm: case pixel_format::r8_uint: case pixel_format::a8_unorm:
+			return 1;
+		case pixel_format::r16_uint: case pixel_format::r16_float: case pixel_format::r16_unorm: case pixel_format::r16_snorm:
+		case pixel_format::rg8_unorm: case pixel_format::rg8_snorm:
+		case pixel_format::b5g6r5_unorm: case pixel_format::a1bgr5_unorm: case pixel_format::abgr4_unorm: case pixel_format::bgr5a1_unorm:
+		case pixel_format::depth16_unorm: case pixel_format::depth32_float:
+			return 2;
+		case pixel_format::r32_uint: case pixel_format::r32_float: case pixel_format::rg16_unorm: case pixel_format::rg16_snorm:
+		case pixel_format::rg16_float: case pixel_format::rgba8_unorm: case pixel_format::rgba8_unorm_srgb: case pixel_format::rgba8_snorm:
+		case pixel_format::bgra8_unorm: case pixel_format::bgra8_unorm_srgb:
+		case pixel_format::bc1_rgba: case pixel_format::bc1_rgba_srgb: case pixel_format::bc2_rgba: case pixel_format::bc2_rgba_srgb:
+		case pixel_format::bc3_rgba: case pixel_format::bc3_rgba_srgb:
+		case pixel_format::depth32_float_stencil8:
+			return 4;
+		case pixel_format::rgba16_float:
+			return 8;
+		case pixel_format::rgba32_float:
+			return 16;
+		default:
+			return 0;
+		}
+	}
+
+	// VKFormats.cpp get_format_element_size: {element size, elements per texel} (the byteswap granule).
+	constexpr std::pair<u8, u8> get_format_element_size(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::r8_unorm: case pixel_format::r8_snorm: return { 1, 1 };
+		case pixel_format::rg8_unorm: case pixel_format::rg8_snorm: return { 2, 1 };
+		case pixel_format::rgba8_unorm: case pixel_format::rgba8_unorm_srgb: case pixel_format::rgba8_snorm:
+		case pixel_format::bgra8_unorm: case pixel_format::bgra8_unorm_srgb: return { 4, 1 };
+		case pixel_format::r16_uint: case pixel_format::r16_float: case pixel_format::r16_unorm: case pixel_format::r16_snorm: return { 2, 1 };
+		case pixel_format::rg16_unorm: case pixel_format::rg16_snorm: case pixel_format::rg16_float: return { 2, 2 };
+		case pixel_format::rgba16_float: return { 2, 4 };
+		case pixel_format::b5g6r5_unorm: case pixel_format::a1bgr5_unorm: case pixel_format::abgr4_unorm: case pixel_format::bgr5a1_unorm: return { 2, 1 };
+		case pixel_format::r32_uint: case pixel_format::r32_float: return { 4, 1 };
+		case pixel_format::rgba32_float: return { 4, 4 };
+		case pixel_format::bc1_rgba: case pixel_format::bc1_rgba_srgb: case pixel_format::bc2_rgba: case pixel_format::bc2_rgba_srgb:
+		case pixel_format::bc3_rgba: case pixel_format::bc3_rgba_srgb: return { 4, 1 };
+		case pixel_format::depth16_unorm: case pixel_format::depth32_float: return { 2, 1 };
+		case pixel_format::depth32_float_stencil8: return { 4, 1 };
+		default: return { 0, 0 };
+		}
+	}
+
+	// VKFormats.cpp get_format_convert_flags: {byteswapped on upload, swap granule}.
+	constexpr std::pair<bool, u32> get_format_convert_flags(pixel_format format)
+	{
+		switch (format)
+		{
+		case pixel_format::r8_unorm: case pixel_format::r8_snorm: return { false, 1 };
+		case pixel_format::bgra8_unorm: case pixel_format::rgba8_unorm: case pixel_format::bgra8_unorm_srgb:
+		case pixel_format::rgba8_unorm_srgb: case pixel_format::rgba8_snorm: return { true, 4 };
+		case pixel_format::r16_uint: case pixel_format::r16_float: case pixel_format::r16_unorm: case pixel_format::r16_snorm:
+		case pixel_format::rg8_unorm: case pixel_format::rg8_snorm: case pixel_format::rg16_unorm: case pixel_format::rg16_snorm:
+		case pixel_format::rg16_float: case pixel_format::rgba16_float:
+		case pixel_format::bgr5a1_unorm: case pixel_format::abgr4_unorm: case pixel_format::b5g6r5_unorm: case pixel_format::a1bgr5_unorm:
+			return { true, 2 };
+		case pixel_format::r32_uint: case pixel_format::r32_float: case pixel_format::rgba32_float: return { true, 4 };
+		case pixel_format::bc1_rgba: case pixel_format::bc2_rgba: case pixel_format::bc3_rgba:
+		case pixel_format::bc1_rgba_srgb: case pixel_format::bc2_rgba_srgb: case pixel_format::bc3_rgba_srgb: return { false, 1 };
+		case pixel_format::depth16_unorm: case pixel_format::depth32_float: return { true, 2 };
+		case pixel_format::depth32_float_stencil8: return { true, 4 };
+		default: return { false, 0 };
+		}
+	}
+
+	// VKFormats.cpp formats_are_bitcast_compatible (formats).
+	constexpr bool formats_are_bitcast_compatible(pixel_format a, pixel_format b)
+	{
+		if (a == b)
+		{
+			return true;
+		}
+
+		if (get_format_texel_width(a) != get_format_texel_width(b))
+		{
+			return false;
+		}
+
+		const auto ta = get_format_convert_flags(a);
+		const auto tb = get_format_convert_flags(b);
+		if (ta.first == tb.first)
+		{
+			return !ta.first || ta.second == tb.second;
+		}
+		return false;
+	}
+
+	// VKFormats.cpp formats_are_bitcast_compatible (images): depth-float data only matches the same class.
+	constexpr bool images_are_bitcast_compatible(pixel_format a, u32 class_a, pixel_format b, u32 class_b)
+	{
+		constexpr u32 depth_float_mask = 4 | 16; // RSX_FORMAT_CLASS_DEPTH_FLOAT_MASK
+		if ((class_a | class_b) & depth_float_mask)
+		{
+			return class_a == class_b;
+		}
+		return formats_are_bitcast_compatible(a, b);
+	}
+
+	// VKTextureCache.cpp render_target_format_is_compatible (arm64 Apple), through MoltenVK.
+	constexpr bool render_target_format_is_compatible(pixel_format format, u32 gcm_format)
+	{
+		switch (gcm_format)
+		{
+		case CELL_GCM_TEXTURE_R5G6B5:
+			return format == pixel_format::b5g6r5_unorm;
+		case CELL_GCM_TEXTURE_W16_Z16_Y16_X16_FLOAT:
+			return format == pixel_format::rgba16_float;
+		case CELL_GCM_TEXTURE_W32_Z32_Y32_X32_FLOAT:
+			return format == pixel_format::rgba32_float;
+		case CELL_GCM_TEXTURE_X32_FLOAT:
+			return format == pixel_format::r32_float;
+		case CELL_GCM_TEXTURE_A8R8G8B8:
+		case CELL_GCM_TEXTURE_D8R8G8B8:
+			return format == pixel_format::bgra8_unorm || format == pixel_format::depth32_float_stencil8;
+		case CELL_GCM_TEXTURE_B8:
+			return format == pixel_format::r8_unorm;
+		case CELL_GCM_TEXTURE_G8B8:
+			return format == pixel_format::rg8_unorm;
+		case CELL_GCM_TEXTURE_DEPTH24_D8:
+		case CELL_GCM_TEXTURE_DEPTH24_D8_FLOAT:
+			return format == pixel_format::depth32_float_stencil8;
+		case CELL_GCM_TEXTURE_X16:
+		case CELL_GCM_TEXTURE_DEPTH16:
+		case CELL_GCM_TEXTURE_DEPTH16_FLOAT:
+			return format == pixel_format::depth16_unorm || format == pixel_format::depth32_float;
+		default:
+			return false;
+		}
+	}
+
+	// Depth conversions between guest memory and Depth32Float(_Stencil8) (Program/GLSLSnippets/ShuffleBytes.glsl,
+	// VKCompute.h cs_fconvert_task e4m12 packing). D24 is a normalized integer: float -> D24 rounds to the nearest
+	// value (the unorm quantisation), so a stored D24 value reads back unchanged. The Vulkan renderer's GLSL
+	// truncates (uint(f * 16777215.f)), which can return d - 1 for a depth it uploaded as d. The product is formed
+	// in double: f has 24 significant bits and 16777215 has 24, so it is exact, and the float division in
+	// d24_to_f32 is off by at most half an ulp, under 0.5 D24 units; the round trip is exact for every value.
+	inline f32 d24_to_f32(u32 bits) { return static_cast<f32>(bits & 0xffffff) / 16777215.f; }
+	inline u32 f32_to_d24(f32 value)
+	{
+		if (!(value > 0.f))
+		{
+			return 0; // zero, negative and NaN
+		}
+		if (value >= 1.f)
+		{
+			return 0xffffff;
+		}
+		return static_cast<u32>(static_cast<double>(value) * 16777215.0 + 0.5);
+	}
+	inline u32 d24f_to_f32_bits(u32 bits) { return bits << 7; }
+	inline u32 f32_bits_to_d24f(u32 bits) { return bits >> 7; }
+	inline u32 e4m12_to_f32_bits(u16 value) { return (static_cast<u32>(value) << 11) + (120u << 23); }
+	inline u16 f32_bits_to_e4m12(u32 bits) { return static_cast<u16>(((bits - (120u << 23)) >> 11) & 0xffff); }
+
+	// The Vulkan sampler state the RSX texture registers decode to (VKDraw.cpp load_texture_env), in Metal terms.
+	struct rsx_min_filter
+	{
+		sampler_min_mag_filter filter;
+		sampler_mip_filter mip;
+		bool sample_mipmaps;
+	};
+
+	constexpr rsx_min_filter get_min_filter(rsx::texture_minify_filter filter)
+	{
+		using f = sampler_min_mag_filter;
+		using m = sampler_mip_filter;
+		switch (filter)
+		{
+		case rsx::texture_minify_filter::nearest: return { f::nearest, m::nearest, false };
+		case rsx::texture_minify_filter::linear: return { f::linear, m::nearest, false };
+		case rsx::texture_minify_filter::nearest_nearest: return { f::nearest, m::nearest, true };
+		case rsx::texture_minify_filter::linear_nearest: return { f::linear, m::nearest, true };
+		case rsx::texture_minify_filter::nearest_linear: return { f::nearest, m::linear, true };
+		case rsx::texture_minify_filter::linear_linear: return { f::linear, m::linear, true };
+		case rsx::texture_minify_filter::convolution_min: return { f::linear, m::nearest, false };
+		default: return { f::nearest, m::nearest, false };
+		}
+	}
+
+	constexpr sampler_min_mag_filter get_mag_filter(rsx::texture_magnify_filter filter)
+	{
+		return filter == rsx::texture_magnify_filter::nearest ? sampler_min_mag_filter::nearest : sampler_min_mag_filter::linear;
+	}
+
+	constexpr sampler_address_mode get_wrap_mode(rsx::texture_wrap_mode wrap)
+	{
+		switch (wrap)
+		{
+		case rsx::texture_wrap_mode::wrap: return sampler_address_mode::repeat;
+		case rsx::texture_wrap_mode::mirror: return sampler_address_mode::mirror_repeat;
+		case rsx::texture_wrap_mode::clamp_to_edge: return sampler_address_mode::clamp_to_edge;
+		case rsx::texture_wrap_mode::border: return sampler_address_mode::clamp_to_border_color;
+		case rsx::texture_wrap_mode::clamp: return sampler_address_mode::clamp_to_edge;
+		case rsx::texture_wrap_mode::mirror_once_clamp_to_edge: return sampler_address_mode::mirror_clamp_to_edge;
+		case rsx::texture_wrap_mode::mirror_once_border: return sampler_address_mode::mirror_clamp_to_edge;
+		case rsx::texture_wrap_mode::mirror_once_clamp: return sampler_address_mode::mirror_clamp_to_edge;
+		default: return sampler_address_mode::repeat;
+		}
+	}
+
+	constexpr u32 get_max_anisotropy(rsx::texture_max_anisotropy aniso)
+	{
+		switch (aniso)
+		{
+		case rsx::texture_max_anisotropy::x1: return 1;
+		case rsx::texture_max_anisotropy::x2: return 2;
+		case rsx::texture_max_anisotropy::x4: return 4;
+		case rsx::texture_max_anisotropy::x6: return 6;
+		case rsx::texture_max_anisotropy::x8: return 8;
+		case rsx::texture_max_anisotropy::x10: return 10;
+		case rsx::texture_max_anisotropy::x12: return 12;
+		case rsx::texture_max_anisotropy::x16: return 16;
+		default: return 1;
+		}
+	}
+
+	// VKDraw.cpp get_compare_func(op, reverse_direction = true)
+	constexpr compare_function get_compare_func(rsx::comparison_function op, bool reverse_direction)
+	{
+		switch (op)
+		{
+		case rsx::comparison_function::never: return compare_function::never;
+		case rsx::comparison_function::greater: return reverse_direction ? compare_function::less : compare_function::greater;
+		case rsx::comparison_function::less: return reverse_direction ? compare_function::greater : compare_function::less;
+		case rsx::comparison_function::less_or_equal: return reverse_direction ? compare_function::greater_equal : compare_function::less_equal;
+		case rsx::comparison_function::greater_or_equal: return reverse_direction ? compare_function::less_equal : compare_function::greater_equal;
+		case rsx::comparison_function::equal: return compare_function::equal;
+		case rsx::comparison_function::not_equal: return compare_function::not_equal;
+		case rsx::comparison_function::always: return compare_function::always;
+		default: return compare_function::never;
+		}
+	}
+
+	// vk::get_border_color + get_closest_border_color_enum: Metal has only the three preset border colours (as
+	// MoltenVK without VK_EXT_custom_border_color). `exact` reports whether the colour is one of them.
+	inline sampler_border_color get_border_color(const color4f& color, bool& exact)
+	{
+		const u32 encoded = rsx::encode_color_to_storage_key(color);
+		exact = true;
+		switch (encoded)
+		{
+		case 0x00000000: return sampler_border_color::transparent_black;
+		case 0xFFFFFFFF: return sampler_border_color::opaque_white;
+		case 0xFF000000: return sampler_border_color::opaque_black;
+		default: break;
+		}
+
+		exact = false;
+		if ((color.r + color.g + color.b) > 1.35f)
+		{
+			return sampler_border_color::opaque_white;
+		}
+		if (color.a > 0.5f)
+		{
+			return sampler_border_color::opaque_black;
+		}
+		return sampler_border_color::transparent_black;
+	}
+
+	// The key of a sampler state in the renderer's sampler cache (every field of sampler_descriptor).
+	struct sampler_key
+	{
+		u64 lo = 0;
+		u64 hi = 0;
+
+		bool operator==(const sampler_key&) const = default;
+	};
+
+	inline sampler_key make_sampler_key(const sampler_descriptor& d)
+	{
+		sampler_key key{};
+		key.lo = static_cast<u64>(d.min_filter) |
+			(static_cast<u64>(d.mag_filter) << 1) |
+			(static_cast<u64>(d.mip_filter) << 2) |
+			(static_cast<u64>(d.address_s) << 4) |
+			(static_cast<u64>(d.address_t) << 7) |
+			(static_cast<u64>(d.address_r) << 10) |
+			(static_cast<u64>(d.border) << 13) |
+			(static_cast<u64>(d.compare) << 15) |
+			(static_cast<u64>(d.compare_enabled ? 1 : 0) << 18) |
+			(static_cast<u64>(d.max_anisotropy & 0x1f) << 19) |
+			(static_cast<u64>(d.normalized_coordinates ? 1 : 0) << 24) |
+			(static_cast<u64>(std::bit_cast<u32>(d.lod_bias)) << 32);
+		key.hi = static_cast<u64>(std::bit_cast<u32>(d.lod_min)) | (static_cast<u64>(std::bit_cast<u32>(d.lod_max)) << 32);
+		return key;
+	}
+
+	struct sampler_key_hash
+	{
+		usz operator()(const sampler_key& key) const noexcept
+		{
+			return static_cast<usz>(key.lo * 0x9E3779B97F4A7C15ull ^ (key.hi + 0x632BE59BD9B4E019ull + (key.lo << 6) + (key.lo >> 2)));
+		}
+	};
+
+	// A region of one subresource of a texture (exclusive upper bounds), for transfer ordering (transfer_scope).
+	struct texture_box
+	{
+		u32 level = 0;
+		u32 slice = 0;   // array slice or cube face; 0 for a 3D texture (its depth planes are z)
+		u32 x0 = 0, y0 = 0, z0 = 0;
+		u32 x1 = 0, y1 = 0, z1 = 1;
+
+		static constexpr texture_box make(u32 level, u32 slice, u32 x, u32 y, u32 z, u32 w, u32 h, u32 d = 1)
+		{
+			return { level, slice, x, y, z, x + w, y + h, z + d };
+		}
+
+		constexpr bool overlaps(const texture_box& other) const
+		{
+			return level == other.level && slice == other.slice &&
+				x0 < other.x1 && other.x0 < x1 && y0 < other.y1 && other.y0 < y1 && z0 < other.z1 && other.z0 < z1;
+		}
+	};
+
+	// The Vulkan blit mapping (vkCmdBlitImage): the source coordinate, in texels, of the destination pixel centre x + 0.5
+	// for a source span [s0, s1) (mirrored when s0 > s1) scaled onto a destination span [d0, d1). The blit shader
+	// computes s0 + (x + 0.5 - d0) * blit_scale(s0, s1, d0, d1).
+	constexpr f32 blit_scale(s32 s0, s32 s1, s32 d0, s32 d1)
+	{
+		return static_cast<f32>(static_cast<f64>(s1 - s0) / static_cast<f64>(d1 - d0));
+	}
+
+	constexpr f32 blit_source_coord(s32 s0, s32 s1, s32 d0, s32 d1, u32 x)
+	{
+		return static_cast<f32>(s0) + (static_cast<f32>(x) + 0.5f - static_cast<f32>(d0)) * blit_scale(s0, s1, d0, d1);
+	}
+
+	// Metal's limits on unnormalized coordinates (MTLSamplerDescriptor.normalizedCoordinates = NO): clamp-to-edge or
+	// clamp-to-zero addressing, equal min/mag filters, no mipmaps, no anisotropy. Returns how many fields it changed.
+	inline u32 sanitize_unnormalized_sampler(sampler_descriptor& d)
+	{
+		if (d.normalized_coordinates)
+		{
+			return 0;
+		}
+
+		u32 changed = 0;
+		const auto fix = [&](sampler_address_mode& mode)
+		{
+			if (mode != sampler_address_mode::clamp_to_edge && mode != sampler_address_mode::clamp_to_zero)
+			{
+				mode = sampler_address_mode::clamp_to_edge;
+				changed++;
+			}
+		};
+		fix(d.address_s);
+		fix(d.address_t);
+		fix(d.address_r);
+		if (d.mag_filter != d.min_filter) { d.mag_filter = d.min_filter; changed++; }
+		if (d.mip_filter != sampler_mip_filter::not_mipmapped) { d.mip_filter = sampler_mip_filter::not_mipmapped; changed++; }
+		if (d.max_anisotropy != 1) { d.max_anisotropy = 1; changed++; }
+		return changed;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTransferPass.cpp b/rpcs3/Emu/RSX/Metal/MTLTransferPass.cpp
new file mode 100644
index 0000000..366543f
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTransferPass.cpp
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): the quad draw of the full-screen transfer passes (see MTLTransferPass.h).
+
+#include "stdafx.h"
+#include "MTLTransferPass.h"
+
+#include "MTLCommandContext.h"
+
+namespace mtl
+{
+	void draw_transfer_quad(command_context& ctx, const render_pass_descriptor& pass, std::string_view label, const object& pipeline,
+		const object* depth_stencil_state, const object& table, u32 stages, u32 x, u32 y, u32 w, u32 h)
+	{
+		const object& encoder = ctx.begin_render(pass, 0, label);
+		set_render_pipeline(encoder, pipeline);
+		if (depth_stencil_state)
+		{
+			set_depth_stencil_state(encoder, *depth_stencil_state);
+		}
+		set_cull_mode(encoder, cull_mode::none);
+		set_viewport(encoder, { static_cast<f64>(x), static_cast<f64>(y), static_cast<f64>(w), static_cast<f64>(h), 0., 1. });
+		set_scissor(encoder, { x, y, w, h });
+		set_argument_table(encoder, table, stages);
+		draw_primitives(encoder, primitive_type::triangle_strip, 0, 4);
+
+		// The next encoder starts with a queue barrier after this one (command_context).
+		ctx.end_encoder();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTransferPass.h b/rpcs3/Emu/RSX/Metal/MTLTransferPass.h
new file mode 100644
index 0000000..f3d8414
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTransferPass.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the pipeline machinery of the full-screen transfer passes, shared by the blit engine's
+// scaled copies (MTLBlit.h) and the MSAA resolve and unresolve passes (MTLResolve.h):
+//   - transfer_pipeline_cache: one render pipeline per key (the owner's pass, attachment format and sample count),
+//     created on first use; a pipeline that cannot be built is reported once to its owner and stays cached as null,
+//     so the pass is refused (and counted by the owner) without a rebuild every time;
+//   - draw_transfer_quad: one quad over a rectangle of a render pass (pipeline, optional depth-stencil state, no
+//     culling, the argument table, a four-vertex strip); the encoder ends, so whatever follows starts after the
+//     command context's queue barrier.
+
+#include "MTLAPI.h"
+
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+
+namespace mtl
+{
+	class command_context;
+
+	class transfer_pipeline_cache
+	{
+	public:
+		void init(const object& compiler)
+		{
+			m_compiler = compiler;
+		}
+
+		void clear()
+		{
+			m_pipelines.clear();
+			m_compiler.reset();
+		}
+
+		// describe(render_pipeline_descriptor&) fills the descriptor of a pipeline not built yet; on_failure(descriptor,
+		// error) runs once if it cannot be built.
+		template <typename Describe, typename OnFailure>
+		const object& get(u64 key, Describe&& describe, OnFailure&& on_failure)
+		{
+			auto [it, inserted] = m_pipelines.try_emplace(key);
+			if (inserted)
+			{
+				render_pipeline_descriptor desc{};
+				std::forward<Describe>(describe)(desc);
+
+				std::string error;
+				it->second = m_compiler ? new_render_pipeline(m_compiler, desc, error) : object{};
+				if (!it->second)
+				{
+					std::forward<OnFailure>(on_failure)(desc, m_compiler ? error : std::string("no compiler"));
+				}
+			}
+			return it->second;
+		}
+
+	private:
+		object m_compiler;
+		std::unordered_map<u64, object> m_pipelines;
+	};
+
+	// The rectangle is the viewport and the scissor. depth_stencil_state may be null (no depth or stencil attachment).
+	void draw_transfer_quad(command_context& ctx, const render_pass_descriptor& pass, std::string_view label, const object& pipeline,
+		const object* depth_stencil_state, const object& table, u32 stages, u32 x, u32 y, u32 w, u32 h);
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.cpp b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.cpp
new file mode 100644
index 0000000..eaef04e
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.cpp
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): the renderer's typeless image copy, VKTexture.cpp vk::copy_image_typeless (declared in
+// MTLBlit.h; the kernel selection and the steps are described in MTLTypelessCopy.h).
+
+#include "stdafx.h"
+#include "MTLTypelessCopy.h"
+
+#include "MTLBlit.h"
+#include "MTLCommandContext.h"
+#include "MTLDataHeap.h"
+#include "MTLM4Counters.h"
+#include "MTLRenderTargets.h"
+#include "MTLTexture.h"
+
+#include "util/asm.hpp"
+
+namespace mtl
+{
+	namespace
+	{
+		bool is_packed_depth(pixel_format format)
+		{
+			return format == pixel_format::depth32_float || format == pixel_format::depth32_float_stencil8;
+		}
+
+		// Colour and Depth16 data are copied as they are: the texture's texel is the guest texel.
+		bool plain_layout(pixel_format format)
+		{
+			const u32 texel = get_format_texel_width(format);
+			return texel && !is_compressed_format(format) && !is_packed_depth(format) && get_texel_size(format) == texel;
+		}
+
+		u64 align256(u64 value)
+		{
+			return utils::align<u64>(value, 256);
+		}
+
+		// Nothing of the destination is written: counted and logged once, as every refused transfer.
+		bool refuse(const image* src, const image* dst, std::string_view why)
+		{
+			get_texture_counters().typeless_not_implemented++;
+			log_once("copy-typeless", fmt::format("typeless copy %u (class %u) -> %u (class %u) refused: %s", static_cast<u32>(src->format()),
+				static_cast<u32>(src->format_class()), static_cast<u32>(dst->format()), static_cast<u32>(dst->format_class()), why));
+			return false;
+		}
+	}
+
+	bool copy_image_typeless(command_context& ctx, image* src, image* dst, const areai& src_area, const areai& dst_area, u32 dst_level, u32 dst_slice, u32 dst_z)
+	{
+		// VK: identical formats of one class are a plain copy ("Image copy requested incorrectly for matching formats").
+		if (src->format() == dst->format() && src->format_class() == dst->format_class())
+		{
+			return copy_image(ctx, src, dst, src_area, dst_area, dst_level, dst_slice, dst_z);
+		}
+
+		if (!transferable(src, dst))
+		{
+			return false;
+		}
+
+		const pixel_format src_format = src->format();
+		const pixel_format dst_format = dst->format();
+		if ((!plain_layout(src_format) && !is_packed_depth(src_format)) || (!plain_layout(dst_format) && !is_packed_depth(dst_format)))
+		{
+			return refuse(src, dst, "compressed or unknown format");
+		}
+
+		if (src_area.is_flipped() || dst_area.is_flipped() || src_area.x1 < 0 || src_area.y1 < 0 || dst_area.x1 < 0 || dst_area.y1 < 0)
+		{
+			return refuse(src, dst, "flipped or negative region");
+		}
+
+		const u32 src_texel = get_format_texel_width(src_format);
+		const u32 dst_texel = get_format_texel_width(dst_format);
+		const u32 sx = static_cast<u32>(src_area.x1), sy = static_cast<u32>(src_area.y1);
+		const u32 sw = static_cast<u32>(src_area.width()), sh = static_cast<u32>(src_area.height());
+		const u32 dx = static_cast<u32>(dst_area.x1), dy = static_cast<u32>(dst_area.y1);
+		const u32 dw = static_cast<u32>(dst_area.width()), dh = static_cast<u32>(dst_area.height());
+		if (!typeless_regions_fit(sw, sh, src_texel, dw, dh, dst_texel))
+		{
+			return refuse(src, dst, "the regions do not hold the same bytes per row");
+		}
+
+		const u32 level_w = std::max(dst->width() >> dst_level, 1u);
+		const u32 level_h = std::max(dst->height() >> dst_level, 1u);
+		if (u64{sx} + sw > src->width() || u64{sy} + sh > src->height() || u64{dx} + dw > level_w || u64{dy} + dh > level_h)
+		{
+			return refuse(src, dst, "a region outside its image");
+		}
+
+		const auto shuffle = get_typeless_shuffle(get_format_convert_flags(src_format), get_format_convert_flags(dst_format));
+		if (shuffle.needed && shuffle.kernel == compute_kernel::count)
+		{
+			return refuse(src, dst, "a byte swap granule no kernel handles");
+		}
+
+		compute_tasks* const tasks = get_compute_tasks();
+		const bool uses_kernels = shuffle.needed || is_packed_depth(src_format) || is_packed_depth(dst_format);
+		if (uses_kernels && (!tasks || !tasks->ready()))
+		{
+			return refuse(src, dst, "the conversion kernels are not available");
+		}
+
+		data_heap* const heap = get_upload_heap();
+		if (!heap)
+		{
+			return refuse(src, dst, "no transfer heap");
+		}
+
+		// Scratch memory (VK calculate_working_buffer_size: three times the data when a depth aspect is involved), taken
+		// before any encoder opens: the ring may make room by submitting.
+		const u64 src_n = u64{sw} * sh;
+		const u64 dst_n = u64{dw} * dh;
+		const u64 length = src_n * src_texel;  // the guest bytes: the same on both sides
+		if (length > (256ull << 20))
+		{
+			// The kernels address the scratch memory with 32-bit offsets (a 4096 x 4096 RGBA32F region is 256 MiB).
+			return refuse(src, dst, "a region over 256 MiB");
+		}
+
+		const bool depth_involved = src->is_depth() || dst->is_depth();
+		const auto staging = allocate_staging(ctx, *heap, (depth_involved ? length * 3 : length) + 1024);
+
+		const object& buffer = staging.buffer;
+		const u64 base = staging.offset;
+		transfer_scope scope(ctx, "typeless copy");
+
+		// 1. vk::copy_image_to_buffer (no byte swap)
+		const region src_region{ { sx, sy, 0 }, { sw, sh, 1 } };
+		const auto src_box = texture_box::make(0, 0, sx, sy, 0, sw, sh);
+		switch (src_format)
+		{
+		case pixel_format::depth32_float:
+		{
+			// D32F -> D16F (e4m12): the depth plane after the packed output, then cs_fconvert_task<f32, f16>
+			const u64 z32_offset = align256(base + src_n * 2);
+			copy_texture_to_buffer(scope.for_read(src->texture, src_box), src->texture, 0, 0, src_region, buffer, z32_offset, sw * 4, 0);
+			scope.split();
+			if (!tasks->run_fconvert(ctx, compute_kernel::f32_to_f16, buffer, static_cast<u32>(z32_offset), static_cast<u32>(src_n * 4), static_cast<u32>(base)))
+			{
+				return refuse(src, dst, "conversion kernel failure (counted)");
+			}
+			break;
+		}
+		case pixel_format::depth32_float_stencil8:
+		{
+			// Depth and stencil planes to separate banks (two reads of one image), then interleaved by cs_gather_d32x8
+			const u64 packed_length = src_n * 4;
+			const u64 z_offset = align256(base + packed_length);
+			const u64 s_offset = align256(z_offset + packed_length);
+			copy_texture_to_buffer(scope.for_read(src->texture, src_box), src->texture, 0, 0, src_region, buffer, z_offset, sw * 4, 0, blit_depth_from_depth_stencil);
+			copy_texture_to_buffer(scope.for_read(src->texture, src_box), src->texture, 0, 0, src_region, buffer, s_offset, sw, 0, blit_stencil_from_depth_stencil);
+			scope.split();
+
+			const auto kernel = get_depth_gather_kernel(src->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32);
+			if (!tasks->run_interleave(ctx, kernel, buffer, static_cast<u32>(base), static_cast<u32>(packed_length), static_cast<u32>(z_offset), static_cast<u32>(s_offset)))
+			{
+				return refuse(src, dst, "conversion kernel failure (counted)");
+			}
+			break;
+		}
+		default:
+			copy_texture_to_buffer(scope.for_read(src->texture, src_box), src->texture, 0, 0, src_region, buffer, base, sw * src_texel, 0);
+			scope.split();
+			break;
+		}
+
+		// 2. The byte shuffle between the two layouts
+		if (shuffle.needed && !tasks->run_shuffle(ctx, shuffle.kernel, buffer, static_cast<u32>(length), static_cast<u32>(base)))
+		{
+			return refuse(src, dst, "conversion kernel failure (counted)");
+		}
+
+		// 3. vk::copy_buffer_to_image
+		const size3 dst_size{ dw, dh, 1 };
+		const origin dst_origin{ dx, dy, dst_z };
+		const auto dst_box = texture_box::make(dst_level, dst_slice, dx, dy, dst_z, dw, dh);
+		switch (dst_format)
+		{
+		case pixel_format::depth32_float:
+		{
+			// D16F (e4m12) -> D32F through cs_fconvert_task<f16, f32>, then the depth plane
+			const u64 packed16_length = dst_n * 2;
+			const u64 z32_offset = align256(base + packed16_length);
+			if (!tasks->run_fconvert(ctx, compute_kernel::f16_to_f32, buffer, static_cast<u32>(base), static_cast<u32>(packed16_length), static_cast<u32>(z32_offset)))
+			{
+				return refuse(src, dst, "conversion kernel failure (counted)");
+			}
+			copy_buffer_to_texture(scope.for_write(dst->texture, dst_box), buffer, z32_offset, dw * 4, 0, dst_size, dst->texture, dst_slice, dst_level, dst_origin);
+			break;
+		}
+		case pixel_format::depth32_float_stencil8:
+		{
+			// The stencil block is cleared, the packed words scattered (cs_scatter_d32x8), then both planes copied in (the
+			// scope orders the second plane after the first: planes of one image count as one region)
+			const u64 packed_length = dst_n * 4;
+			const u64 z_offset = align256(base + packed_length);
+			const u64 s_offset = align256(z_offset + packed_length);
+			fill_buffer(scope.encoder(nullptr, {}, nullptr, {}), buffer, s_offset, utils::align<u64>(dst_n, 4), 0);
+			scope.split();
+
+			const auto kernel = get_depth_scatter_kernel(dst->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32);
+			if (!tasks->run_interleave(ctx, kernel, buffer, static_cast<u32>(base), static_cast<u32>(packed_length), static_cast<u32>(z_offset), static_cast<u32>(s_offset)))
+			{
+				return refuse(src, dst, "conversion kernel failure (counted)");
+			}
+
+			copy_buffer_to_texture(scope.for_write(dst->texture, dst_box), buffer, z_offset, dw * 4, 0, dst_size, dst->texture, dst_slice, dst_level, dst_origin,
+				blit_depth_from_depth_stencil);
+			copy_buffer_to_texture(scope.for_write(dst->texture, dst_box), buffer, s_offset, dw, 0, dst_size, dst->texture, dst_slice, dst_level, dst_origin,
+				blit_stencil_from_depth_stencil);
+			break;
+		}
+		default:
+			copy_buffer_to_texture(scope.for_write(dst->texture, dst_box), buffer, base, dw * dst_texel, 0, dst_size, dst->texture, dst_slice, dst_level, dst_origin);
+			break;
+		}
+
+		if (uses_kernels)
+		{
+			m4_count(get_m4_counters().typeless_conversions);
+		}
+		else
+		{
+			get_texture_counters().buffer_bitcasts++;
+		}
+		return true;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.h b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.h
new file mode 100644
index 0000000..9dfdff8
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the kernel selection of the renderer's one typeless image copy, copy_image_typeless
+// (declared with the other transfers in MTLBlit.h, implemented in MTLTypelessCopy.cpp). It is VKTexture.cpp
+// vk::copy_image_typeless with vk::copy_image_to_buffer / vk::copy_buffer_to_image, for every caller: the texture
+// cache's region copies (direct, or into a typeless helper before a scaled copy) and the blitter (vk::blitter::
+// scale_image: the blit engine and the surface inheritance):
+//   1. the source region goes to a scratch buffer as the guest stores it: colour and Depth16 texels as they are,
+//      Depth32Float through cs_fconvert_task<f32, f16> (e4m12), Depth32Float_Stencil8 through cs_gather_d32x8 (float
+//      or unorm depth by format class);
+//   2. when the two formats swap bytes differently on upload, the cs_shuffle_16 / _32 / _32_16 kernel VK picks;
+//   3. the scratch buffer goes to the destination region, depth planes unpacked through cs_fconvert_task<f16, f32> or
+//      cs_scatter_d32x8 (stencil block cleared first).
+// Identical formats of one class are a plain copy (VK copy_image). The kernels are the M4 conversion kernels
+// (MTLComputeTasks.h). The copies are recorded in a transfer scope (MTLTexture.h), and each buffer dependency
+// (copy -> kernel -> copy) starts a new encoder, whose queue barrier waits for the step before.
+
+#include "MTLAPI.h"
+#include "MTLComputeTasks.h"
+
+#include <utility>
+
+namespace mtl
+{
+	// VK copy_image_typeless: the byte shuffle between two layouts given their get_format_convert_flags (byteswapped on
+	// upload, swap granule): none when neither swaps or both swap the same way; cs_shuffle_32_16 when both swap with
+	// different granules; otherwise the granule of the one that swaps (cs_shuffle_32 or cs_shuffle_16).
+	struct typeless_shuffle
+	{
+		bool needed = false;
+		compute_kernel kernel = compute_kernel::count;  // count with needed: a granule no kernel handles
+	};
+
+	constexpr typeless_shuffle get_typeless_shuffle(std::pair<bool, u32> src_convert, std::pair<bool, u32> dst_convert)
+	{
+		const bool needed = (src_convert.first || dst_convert.first) &&
+			(src_convert.first != dst_convert.first || src_convert.second != dst_convert.second);
+		if (!needed)
+		{
+			return {};
+		}
+
+		if (src_convert.first && dst_convert.first)
+		{
+			return { true, compute_kernel::bswap_u16_u32 };
+		}
+
+		const u32 block_size = src_convert.first ? src_convert.second : dst_convert.second;
+		return { true, block_size == 4 ? compute_kernel::bswap_u32 : block_size == 2 ? compute_kernel::bswap_u16 : compute_kernel::count };
+	}
+
+	// vk::copy_image_to_buffer / vk::copy_buffer_to_image for D32_SFLOAT_S8_UINT: the interleave kernel by depth class
+	// (DEPTH24_FLOAT_X8_PACK32 keeps float depth bits, the unorm class converts), no byte swap in a typeless copy.
+	constexpr compute_kernel get_depth_gather_kernel(bool float_depth)
+	{
+		return float_depth ? compute_kernel::gather_d32fx8 : compute_kernel::gather_d32x8;
+	}
+
+	constexpr compute_kernel get_depth_scatter_kernel(bool float_depth)
+	{
+		return float_depth ? compute_kernel::scatter_d32fx8 : compute_kernel::scatter_d32x8;
+	}
+
+	// The regions of a typeless copy carry the same guest bytes row for row: the same height, the same bytes per row
+	// (texel counts in the ratio of the guest texel sizes). VK's scratch buffer is packed by each side's own row size, so
+	// other pairs skew the rows (or read stale scratch memory): those are refused and counted.
+	constexpr bool typeless_regions_fit(u32 src_w, u32 src_h, u32 src_texel, u32 dst_w, u32 dst_h, u32 dst_texel)
+	{
+		return src_w && src_h && src_texel && dst_texel && src_h == dst_h && u64{src_w} * src_texel == u64{dst_w} * dst_texel;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp b/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp
new file mode 100644
index 0000000..3ac9934
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp
@@ -0,0 +1,456 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): host unit test of the pure logic of stage M4 (no Metal device, no emulator):
+//   - the visibility slot pool, and the Vulkan renderer's occlusion query rules (check, gather) on segments, including
+//     the exactness of folding (a folded record answers exactly as the unfolded one, for random records);
+//   - the conversion arithmetic (MTLM4Math.h, the very tokens the MSL kernels compile) against independent references;
+//   - the MSAA resolve/unresolve coordinate math (both directions are inverse, and match the Vulkan compute passes);
+//   - the MSAA configuration (sample counts, grids, sample masks) and the compute dispatch parameters.
+//   - the typeless copy's kernel selection (VK copy_image_typeless, copy_image_to_buffer / copy_buffer_to_image).
+// With a directory argument it also writes the MSL libraries (m4_compute.metal, m4_resolve.metal) for Apple's offline
+// compiler: xcrun -sdk iphoneos metal -std=metal3.2 -target air64-apple-ios26.0 -Werror -Wno-unused-variable
+// -Wno-unused-but-set-variable -Wno-unused-function -c m4_compute.metal. Pure logic: no Metal, g++ or clang++.
+//
+//   S=<rpcs3 source root>
+//   c++ -std=gnu++20 -Wall -I "$S/rpcs3" -I "$S" -I "$S/rpcs3/Emu" -I "$S/3rdparty"
+//       "$S/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp" -o mtl_m4_unit_test
+//   ./mtl_m4_unit_test [MSL output directory]
+
+#include "Emu/RSX/Metal/MTLComputeTasks.h"
+#include "Emu/RSX/Metal/MTLM4Math.h"
+#include "Emu/RSX/Metal/MTLM4Shaders.h"
+#include "Emu/RSX/Metal/MTLQueries.h"
+#include "Emu/RSX/Metal/MTLTextureFormats.h"
+#include "Emu/RSX/Metal/MTLTypelessCopy.h"
+
+#include <bit>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace
+{
+	int g_failures = 0;
+	int g_checks = 0;
+
+	void check(bool condition, const char* what, long long a = 0, long long b = 0)
+	{
+		g_checks++;
+		if (!condition)
+		{
+			std::fprintf(stderr, "FAIL: %s (%lld, %lld)\n", what, a, b);
+			++g_failures;
+		}
+	}
+
+	using namespace mtl;
+	using namespace mtl::m4_math;
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_slot_pool()
+	{
+		visibility_slot_pool pool(4);
+		check(pool.capacity() == 4 && pool.available() == 4 && pool.in_use() == 0, "pool starts free");
+
+		const u32 a = pool.allocate(), b = pool.allocate(), c = pool.allocate(), d = pool.allocate();
+		check(a == 0 && b == 1 && c == 2 && d == 3, "slots in order", a, d);
+		check(pool.allocate() == umax, "exhausted pool returns umax");
+		check(pool.in_use() == 4, "all in use");
+
+		check(pool.release(b, 7), "release b at fence 7");
+		check(pool.release(a, 9), "release a at fence 9");
+		check(!pool.release(a, 9), "double release refused");
+		check(!pool.release(17, 1), "out of range release refused");
+		check(pool.pending() == 2 && pool.available() == 0, "released slots wait for their fence");
+
+		check(pool.collect(6) == 0, "nothing complete at 6");
+		check(pool.allocate() == umax, "pending slots are not reused");
+		check(pool.collect(8) == 1, "fence 7 completed at 8");
+		check(pool.allocate() == b, "b reused after its fence");
+		check(pool.collect(100) == 1 && pool.allocate() == a, "a reused after its fence");
+		check(pool.allocate() == umax, "full again");
+
+		// Out-of-order fences are all collected
+		pool.release(c, 30);
+		pool.release(d, 20);
+		check(pool.collect(25) == 1 && pool.allocate() == d, "the earlier fence first, whatever the release order");
+		check(pool.collect(30) == 1 && pool.allocate() == c, "the later fence next");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	// A reference model of the Vulkan renderer on per-command-buffer host queries (VKGSRender.cpp, RPCS3_IOS variant):
+	// each index has a value and an availability; is_current = the query's last command buffer is still recording.
+	struct vk_query
+	{
+		u32 value = 0;
+		u64 fence = 0;
+	};
+
+	bool vk_check(const std::vector<vk_query>& indices, bool is_current, u64 completed, bool precise)
+	{
+		if (indices.empty()) return true;
+		if (is_current) return false;
+		for (const auto& index : indices)
+		{
+			if (index.fence > completed) return false;
+			if (!precise && index.value) return true;
+		}
+		return true;
+	}
+
+	u32 vk_gather(const std::vector<vk_query>& indices, bool precise)
+	{
+		u32 result = 0;
+		for (const auto& index : indices)
+		{
+			result += index.value;
+			if (result && !precise) break;
+		}
+		return result;
+	}
+
+	void test_query_rules()
+	{
+		std::map<u32, u64> values;  // slot -> value
+		const auto read = [&](u32 slot) { return values[slot]; };
+
+		occlusion_record record{};
+		check(occlusion_ready(record, 10, 10, false, read), "no data: ready");
+		check(occlusion_gather(record, false, [](u64) {}, read) == 0, "no data: 0");
+
+		record.has_data = true;
+		record.segments = { { 0, 5 }, { 1, 6 } };
+		record.last_fence = 6;
+		values = { { 0, 0 }, { 1, 12 } };
+		check(!occlusion_ready(record, 5, 5, false, read), "last segment in the open command buffer: not ready");
+		check(!occlusion_ready(record, 6, 5, false, read), "second segment not complete: not ready");
+		check(occlusion_ready(record, 6, 6, false, read), "all complete: ready");
+
+		values = { { 0, 3 }, { 1, 12 } };
+		check(occlusion_ready(record, 6, 5, false, read), "first segment complete with samples: ready (non-precise)");
+		check(!occlusion_ready(record, 6, 5, true, read), "precise needs every segment");
+
+		u64 waited = 0;
+		const auto wait = [&](u64 fence) { waited = std::max(waited, fence); };
+		check(occlusion_gather(record, false, wait, read) == 3 && waited == 5, "non-precise stops at the first hit, waits only for it");
+		waited = 0;
+		check(occlusion_gather(record, true, wait, read) == 15 && waited == 6, "precise sums all, waits for all");
+
+		// 32-bit results, as Vulkan's
+		values = { { 0, 0x1'0000'0002ull }, { 1, 0xFFFF'FFFFull } };
+		check(occlusion_gather(record, true, wait, read) == 1u, "32-bit wrap of the sum", occlusion_gather(record, true, wait, read));
+
+		// Random records: the model and the implementation agree, and folding changes nothing.
+		std::mt19937_64 rng(902);
+		for (int iteration = 0; iteration < 20000; ++iteration)
+		{
+			const bool precise = rng() & 1;
+			const usz count = rng() % 6;
+			std::vector<vk_query> model;
+			occlusion_record r{};
+			std::map<u32, u64> slot_values;
+			u64 fence = 1 + rng() % 3;
+			for (usz n = 0; n < count; ++n)
+			{
+				fence += rng() % 3;  // never decreases
+				const u32 value = (rng() % 3 == 0) ? static_cast<u32>(rng() % 50) : 0;
+				model.push_back({ value, fence });
+				r.segments.push_back({ static_cast<u32>(n), fence });
+				slot_values[static_cast<u32>(n)] = value;
+			}
+			r.has_data = count > 0;
+			r.last_fence = count ? fence : 0;
+			const auto rd = [&](u32 slot) { return slot_values.at(slot); };
+
+			const u64 last_submitted = fence + (rng() % 2) - (count && (rng() % 4 == 0) ? 1 : 0);
+			const u64 completed = std::min<u64>(last_submitted, rng() % (fence + 2));
+			const bool is_current = r.last_fence > last_submitted;
+
+			const bool expected_ready = vk_check(model, is_current, completed, precise);
+			check(occlusion_ready(r, last_submitted, completed, precise, rd) == expected_ready, "ready matches the Vulkan model", iteration);
+			const u32 expected_value = vk_gather(model, precise);
+			check(occlusion_gather(r, precise, [](u64) {}, rd) == expected_value, "gather matches the Vulkan model", iteration);
+
+			// Fold at an earlier completion point, then ask again at the same and at a later point.
+			occlusion_record folded = r;
+			std::vector<std::pair<u32, u64>> released;
+			const u64 fold_point = std::min<u64>(completed, rng() % (fence + 2));
+			fold_completed(folded, fold_point, precise, rd, [&](u32 slot, u64 f) { released.emplace_back(slot, f); });
+			check(released.size() + folded.segments.size() == r.segments.size(), "every segment is either kept or released once", iteration);
+			std::set<u32> unique_slots;
+			for (const auto& [slot, f] : released) unique_slots.insert(slot);
+			for (const auto& s : folded.segments) unique_slots.insert(s.slot);
+			check(unique_slots.size() == r.segments.size(), "no slot released twice", iteration);
+			for (const auto& [slot, f] : released)
+			{
+				check(f == r.segments[slot].fence, "a slot is released with its own fence", iteration);
+			}
+
+			check(occlusion_ready(folded, last_submitted, completed, precise, rd) == expected_ready, "folding keeps readiness", iteration);
+			check(occlusion_ready(folded, last_submitted, last_submitted, precise, rd) ==
+				vk_check(model, is_current, last_submitted, precise), "folding keeps readiness later", iteration);
+			check(occlusion_gather(folded, precise, [](u64) {}, rd) == expected_value, "folding keeps the value", iteration);
+		}
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_conversion_math()
+	{
+		// Byte swaps (ShuffleBytes.glsl) against independent definitions
+		std::mt19937 rng(7);
+		for (int n = 0; n < 100000; ++n)
+		{
+			const u32 v = static_cast<u32>(rng());
+			const u32 swapped16 = ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+			check(m4_bswap_u16(v) == swapped16, "bswap_u16 swaps the bytes of each half", v, m4_bswap_u16(v));
+			check(m4_bswap_u32(v) == __builtin_bswap32(v), "bswap_u32 is a 32-bit byte swap", v, m4_bswap_u32(v));
+			check(m4_bswap_u16_u32(v) == ((v << 16) | (v >> 16)), "bswap_u16_u32 swaps the halves", v);
+			check(m4_d24x8_to_d24x8_swapped(v) == ((v & 0x0000FF00u) | ((v >> 16) & 0xFFu) | ((v & 0xFFu) << 16)), "d24x8 swap", v);
+			check(m4_d24f_to_f32(v) == (v << 7) && m4_f32_to_d24f(v) == (v >> 7), "d24f shifts", v);
+		}
+
+		// D24 -> F32: float(d) / 16777215 is correctly rounded (computed exactly in double, then rounded once: innocuous
+		// double rounding for division, 53 >= 2 * 24 + 2 bits).
+		u32 mismatches = 0;
+		for (u32 d = 0; d < (1u << 24); ++d)
+		{
+			const u32 expected = std::bit_cast<u32>(static_cast<float>(static_cast<double>(d) / 16777215.0));
+			mismatches += m4_d24_to_f32(d) != expected;
+		}
+		check(mismatches == 0, "d24_to_f32 is the correctly rounded quotient for every 24-bit value", mismatches);
+		check(m4_d24x8_to_f32(0xFFFFFF00u) == std::bit_cast<u32>(1.f), "d24x8 all ones is 1.0");
+		check(m4_d24x8_to_f32(0x000000FFu) == 0, "stencil bits are ignored");
+
+		// F32 -> D24: truncation of the product (the GLSL uint() conversion)
+		check(m4_f32_to_d24(std::bit_cast<u32>(1.f)) == 16777215u, "1.0 -> 0xFFFFFF");
+		check(m4_f32_to_d24(std::bit_cast<u32>(0.f)) == 0u, "0.0 -> 0");
+		check(m4_f32_to_d24(std::bit_cast<u32>(0.5f)) == 8388607u, "0.5 -> 8388607 (truncated)", m4_f32_to_d24(std::bit_cast<u32>(0.5f)));
+		for (int n = 0; n < 100000; ++n)
+		{
+			const float f = std::uniform_real_distribution<float>(0.f, 1.f)(rng);
+			const float product = f * 16777215.f;
+			check(m4_f32_to_d24(std::bit_cast<u32>(f)) == static_cast<u32>(product), "f32_to_d24 truncates the float product");
+			check(m4_f32_to_d24x8_swapped(std::bit_cast<u32>(f)) == m4_d24x8_to_d24x8_swapped(static_cast<u32>(product)), "f32_to_d24x8_swapped");
+		}
+
+		// Interleave (cs_gather / cs_scatter): a scatter followed by a gather restores the D24S8 words.
+		for (int n = 0; n < 4096; ++n)
+		{
+			const u32 index = static_cast<u32>(rng() % 1024);
+			const u32 value = static_cast<u32>(rng());
+			const u32 depth = m4_scatter_d24(value);
+			const u32 stencil_word = m4_scatter_stencil(value, index);
+			check(m4_gather_d24x8(depth, stencil_word, index) == value, "scatter then gather of D24S8", value);
+			check(m4_gather_stencil(stencil_word, index) == (value & 0xFF), "stencil byte position", index);
+			check(m4_stencil_shift(index) == (index % 4) * 8, "stencil shift");
+		}
+
+		check(m4_gather_d32x8(std::bit_cast<u32>(1.f), 0xAB000000u, 3) == 0xFFFFFFABu, "gather d32: 1.0 and stencil byte 3");
+		check(m4_scatter_d32(0xFFFFFF12u) == std::bit_cast<u32>(1.f), "scatter d32: 0xFFFFFF -> 1.0");
+		check(m4_gather_d32fx8(m4_scatter_d32f(0x12345678u), 0x78u, 0) == 0x12345678u, "d24f round trip");
+
+		// e4m12 (cs_fconvert_task): 1.0f <-> 0x7000, and exact round trips of the representable values
+		check(m4_pack_e4m12_pack16(std::bit_cast<u32>(1.f), std::bit_cast<u32>(1.f)) == 0x70007000u, "1.0 packs to 0x7000");
+		check(m4_unpack_e4m12_lo(0x7000u) == std::bit_cast<u32>(1.f) && m4_unpack_e4m12_hi(0x70000000u) == std::bit_cast<u32>(1.f), "0x7000 unpacks to 1.0");
+		for (u32 bits = 0; bits <= 0xFFFF; ++bits)
+		{
+			const u32 packed = bits | (bits << 16);
+			const u32 lo = m4_unpack_e4m12_lo(packed);
+			const u32 hi = m4_unpack_e4m12_hi(packed);
+			check(lo == hi && m4_pack_e4m12_pack16(lo, hi) == packed, "e4m12 unpack/pack round trip", bits);
+		}
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_resolve_math()
+	{
+		for (const u32 samples : { 1u, 2u, 4u })
+		{
+			const auto grid = msaa::grid_for(samples);
+			check(grid.x * grid.y == samples, "grid holds every sample", samples);
+
+			const int sx = static_cast<int>(grid.x), sy = static_cast<int>(grid.y);
+			const int width = 7, height = 5;  // multisampled image size
+			std::set<std::pair<std::pair<int, int>, int>> seen;
+			for (int ry = 0; ry < height * sy; ++ry)
+			{
+				for (int rx = 0; rx < width * sx; ++rx)
+				{
+					// Colour/Depth resolve passes: resolve texel -> (pixel, sample)
+					const int px = m4_resolve_source(rx, sx), py = m4_resolve_source(ry, sy);
+					const int sample = m4_resolve_sample_index(rx, ry, sx, sy);
+					check(px < width && py < height && sample >= 0 && sample < static_cast<int>(samples), "resolve stays in the image", rx, ry);
+					seen.insert({ { px, py }, sample });
+
+					// Unresolve passes (per sample): (pixel, sample) -> the same resolve texel
+					check(m4_unresolve_target_x(px, sample, sx) == rx && m4_unresolve_target_y(py, sample, sx, sy) == ry,
+						"unresolve inverts resolve", rx, ry);
+
+					// ColorUnresolvePass.glsl (compute, per resolve texel) stores the texel at (rc / sc, loc.x + loc.y * sc.y):
+					// the per-sample render pass reads it back from the same texel.
+					const int loc_x = rx % sx, loc_y = ry % sy;
+					check(loc_x + loc_y * sy == sample, "same sample index as the compute unresolve", rx, ry);
+				}
+			}
+			check(seen.size() == static_cast<usz>(width * height) * samples, "every sample of every pixel exactly once", samples);
+		}
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_msaa_config()
+	{
+		check(msaa::grid_for(2).x == 2 && msaa::grid_for(2).y == 1, "2 samples side by side (diagonal_centered_2)");
+		check(msaa::grid_for(4).x == 2 && msaa::grid_for(4).y == 2, "4 samples as 2x2 (square_centered/rotated_4)");
+		check(msaa::grid_for(8).x == 0, "8 samples is not an RSX mode");
+
+		// VK create_new_surface: get_format_sample_count(aa) at "Auto" (1, 2, 4, 4), one sample when disabled
+		for (const u32 rsx_samples : { 1u, 2u, 4u })
+		{
+			check(msaa::host_samples(true, rsx_samples) == rsx_samples, "Auto keeps the AA mode's samples", rsx_samples);
+			check(msaa::host_samples(false, rsx_samples) == 1, "Disabled is single-sampled", rsx_samples);
+		}
+
+		check(msaa::pipeline_sample_mask(4, 0xFFFF) == msaa::all_samples, "full RSX mask: no shader mask");
+		check(msaa::pipeline_sample_mask(4, 0x000F) == msaa::all_samples, "mask of every existing sample: no shader mask");
+		check(msaa::pipeline_sample_mask(4, 0x0005) == 0x5, "partial mask kept");
+		check(msaa::pipeline_sample_mask(2, 0xFFFE) == 0x2, "bits beyond the sample count dropped");
+		check(msaa::pipeline_sample_mask(2, 0x0000) == 0x0, "empty mask writes no sample");
+		check(msaa::pipeline_sample_mask(1, 0x0000) == msaa::all_samples, "one sample: Vulkan applies no mask");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_dispatch_params()
+	{
+		check(compute_shuffle_workgroups(0) == 0 && compute_shuffle_workgroups(1) == 1 && compute_shuffle_workgroups(1024) == 1 &&
+			compute_shuffle_workgroups(1025) == 2, "cs_shuffle_base::run work groups (256 invocations of 4 bytes)");
+
+		for (const u32 invocations : { 1u, 255u, 256u, 257u, 65535u * 256u, 65536u * 256u, 1000000u * 256u })
+		{
+			const auto size = get_dispatch_size(invocations, 256);
+			const u64 covered = static_cast<u64>(size.groups.width) * size.groups.height * size.threads.width;
+			check(covered >= invocations, "the dispatch covers every invocation", invocations, static_cast<long long>(covered));
+			check(size.groups.width <= 65535 && size.groups.height <= 65535, "groups within the limit", size.groups.width, size.groups.height);
+		}
+
+		const auto shuffle = shuffle_params(1030);
+		check(shuffle[0] == 257 && shuffle[3] == 257, "shuffle: whole words of the bound range", shuffle[0]);
+
+		u32 bound = 0;
+		const auto interleave = interleave_params(0x100, 0x400, 0x200, 0x900, bound);
+		check(bound == 0x100 && interleave[0] == 0x400 && interleave[1] == 0x100 && interleave[2] == 0x800 &&
+			interleave[3] == (0x900 + 0x100 - 0x100) / 4, "cs_interleave_task::run parameters");
+
+		const auto contract = fconvert_params(compute_kernel::f32_to_f16, 0x1000, 0x800, 0x400, bound);
+		check(bound == 0x400 && contract[0] == 0x800 && contract[1] == 0xC00 && contract[2] == 0 && contract[3] == (0x1800 - 0x400) / 4,
+			"cs_fconvert_task<f32, f16>::run, source after destination");
+		const auto expand = fconvert_params(compute_kernel::f16_to_f32_swap_both, 0x400, 0x800, 0x1000, bound);
+		check(bound == 0x400 && expand[1] == 0 && expand[2] == 0xC00 && expand[3] == (0xC00 + (0x800 / 2) * 4) / 4,
+			"cs_fconvert_task<f16, f32>::run, destination after source");
+
+		check(get_kernel_family(compute_kernel::d24x8_to_d24x8_swapped) == compute_kernel_family::shuffle &&
+			get_kernel_family(compute_kernel::gather_d24x8) == compute_kernel_family::interleave &&
+			get_kernel_family(compute_kernel::scatter_d32fx8) == compute_kernel_family::interleave &&
+			get_kernel_family(compute_kernel::f32_to_f16) == compute_kernel_family::fconvert, "kernel families");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_typeless_selection()
+	{
+		using flags = std::pair<bool, u32>;
+		// get_format_convert_flags pairs (VKFormats.cpp): {byteswapped on upload, swap granule}
+		const flags none{ false, 1 }, swap2{ true, 2 }, swap4{ true, 4 }, unknown{ false, 0 }, swap8{ true, 8 };
+
+		check(!get_typeless_shuffle(swap4, swap4).needed, "same granule both sides: no shuffle (rgba8 <-> r32f)");
+		check(!get_typeless_shuffle(swap2, swap2).needed, "same granule both sides: no shuffle (r16 <-> d16)");
+		check(!get_typeless_shuffle(none, unknown).needed, "neither swaps: no shuffle");
+		check(get_typeless_shuffle(swap4, swap2).kernel == compute_kernel::bswap_u16_u32, "both swap, granules differ: cs_shuffle_32_16");
+		check(get_typeless_shuffle(swap2, swap4).kernel == compute_kernel::bswap_u16_u32, "both swap, granules differ (reverse): cs_shuffle_32_16");
+		check(get_typeless_shuffle(none, swap2).kernel == compute_kernel::bswap_u16, "only the destination swaps by 2: cs_shuffle_16");
+		check(get_typeless_shuffle(swap4, none).kernel == compute_kernel::bswap_u32, "only the source swaps by 4: cs_shuffle_32");
+		check(get_typeless_shuffle(none, swap8).needed && get_typeless_shuffle(none, swap8).kernel == compute_kernel::count,
+			"a granule without a kernel is refused (VK: unreachable)");
+
+		check(get_depth_gather_kernel(true) == compute_kernel::gather_d32fx8 && get_depth_gather_kernel(false) == compute_kernel::gather_d32x8,
+			"cs_gather_d32x8<false, true> for float depth, <false, false> for unorm depth");
+		check(get_depth_scatter_kernel(true) == compute_kernel::scatter_d32fx8 && get_depth_scatter_kernel(false) == compute_kernel::scatter_d32x8,
+			"cs_scatter_d32x8<true> for float depth, <false> for unorm depth");
+
+		// The renderer's formats (MTLTextureFormats.h get_format_convert_flags, VKFormats.cpp's table)
+		const auto shuffle_of = [](pixel_format a, pixel_format b) { return get_typeless_shuffle(get_format_convert_flags(a), get_format_convert_flags(b)); };
+		check(shuffle_of(pixel_format::depth16_unorm, pixel_format::bgra8_unorm).kernel == compute_kernel::bswap_u16_u32, "D16 -> BGRA8: cs_shuffle_32_16");
+		check(shuffle_of(pixel_format::depth32_float, pixel_format::rgba8_unorm).kernel == compute_kernel::bswap_u16_u32, "D32F (D16F) -> RGBA8: cs_shuffle_32_16");
+		check(!shuffle_of(pixel_format::depth32_float_stencil8, pixel_format::bgra8_unorm).needed, "D32F_S8 -> BGRA8: packing only");
+		check(!shuffle_of(pixel_format::r32_float, pixel_format::rgba8_unorm).needed, "R32F -> RGBA8: no shuffle");
+		check(!shuffle_of(pixel_format::depth16_unorm, pixel_format::rg8_unorm).needed, "D16 -> RG8: no shuffle");
+		check(shuffle_of(pixel_format::r8_unorm, pixel_format::rg8_unorm).kernel == compute_kernel::bswap_u16, "R8 -> RG8: cs_shuffle_16");
+		check(shuffle_of(pixel_format::bgra8_unorm, pixel_format::r8_unorm).kernel == compute_kernel::bswap_u32, "BGRA8 -> R8: cs_shuffle_32");
+		check(shuffle_of(pixel_format::r16_float, pixel_format::r32_float).kernel == compute_kernel::bswap_u16_u32, "R16F -> R32F: cs_shuffle_32_16");
+
+		// Regions: the same bytes row for row, nothing else
+		check(typeless_regions_fit(10, 4, 4, 20, 4, 2), "10 texels of 4 bytes are 20 of 2");
+		check(typeless_regions_fit(7, 3, 2, 7, 3, 2), "the same size");
+		check(!typeless_regions_fit(11, 4, 2, 5, 4, 4), "22 bytes are not 20: rows would skew (VK packs each side by its own rows)");
+		check(!typeless_regions_fit(5, 4, 4, 11, 4, 2), "20 bytes are not 22: the destination would read stale scratch memory");
+		check(!typeless_regions_fit(10, 4, 4, 20, 5, 2), "different heights");
+		check(!typeless_regions_fit(0, 4, 4, 0, 4, 2) && !typeless_regions_fit(10, 4, 0, 20, 4, 2), "empty regions, unknown texel sizes");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_msl_text(const char* directory)
+	{
+		const std::string compute = m4_shaders::compute_library_source();
+		const std::string resolve = m4_shaders::resolve_library_source();
+
+		check(m4_shaders::compute_kernel_names.size() == static_cast<usz>(compute_kernel::count), "one MSL kernel per compute_kernel");
+		for (const auto name : m4_shaders::compute_kernel_names)
+		{
+			// Each kernel is declared once through its M4_*_KERNEL macro
+			const std::string declaration = "(" + std::string(name) + ",";
+			const usz first = compute.find(declaration);
+			check(first != std::string::npos && compute.find(declaration, first + 1) == std::string::npos, "kernel declared once", static_cast<long long>(first));
+		}
+
+		for (const char* function : { "m4_resolve_vertex", "m4_color_resolve", "m4_color_unresolve", "m4_depth_resolve", "m4_depth_unresolve",
+			"m4_depth_stencil_resolve", "m4_depth_stencil_unresolve" })
+		{
+			check(resolve.find(std::string(" ") + function + "(") != std::string::npos, "resolve function present");
+		}
+
+		// The C++ and MSL halves of the dual sources are the same tokens
+		check(m4_source::conversion_math.find("m4_pack_e4m12_pack16") != std::string_view::npos &&
+			m4_source::resolve_math.find("m4_unresolve_target_y") != std::string_view::npos, "dual sources stringized");
+		check(compute.find(m4_source::conversion_math) != std::string::npos && resolve.find(m4_source::resolve_math) != std::string::npos,
+			"the libraries hold the tested math");
+
+		if (directory)
+		{
+			std::ofstream(std::string(directory) + "/m4_compute.metal", std::ios::binary) << compute;
+			std::ofstream(std::string(directory) + "/m4_resolve.metal", std::ios::binary) << resolve;
+		}
+	}
+}
+
+int main(int argc, char** argv)
+{
+	test_slot_pool();
+	test_query_rules();
+	test_conversion_math();
+	test_resolve_math();
+	test_msaa_config();
+	test_dispatch_params();
+	test_typeless_selection();
+	test_msl_text(argc > 1 ? argv[1] : nullptr);
+
+	if (g_failures)
+	{
+		std::fprintf(stderr, "%d of %d checks failed\n", g_failures, g_checks);
+		return 1;
+	}
+
+	std::printf("PASS: Metal M4 unit (%d checks)\n", g_checks);
+	return 0;
+}
