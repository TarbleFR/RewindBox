+
+	// VKDraw.cpp get_compare_func(op, reverse_direction = true)
+	constexpr compare_function get_compare_func(rsx::comparison_function op, bool reverse_direction)
+	{
+		switch (op)
+		{
+		case rsx::comparison_function::never: return compare_function::never;
+		case rsx::comparison_function::greater: return reverse_direction ? compare_function::less : compare_function::greater;
+		case rsx::comparison_function::less: return reverse_direction ? compare_function::greater : compare_function::less;
+		case rsx::comparison_function::less_or_equal: return reverse_direction ? compare_function::greater_equal : compare_function::less_equal;
+		case rsx::comparison_function::greater_or_equal: return reverse_direction ? compare_function::less_equal : compare_function::greater_equal;
+		case rsx::comparison_function::equal: return compare_function::equal;
+		case rsx::comparison_function::not_equal: return compare_function::not_equal;
+		case rsx::comparison_function::always: return compare_function::always;
+		default: return compare_function::never;
+		}
+	}
+
+	// vk::get_border_color + get_closest_border_color_enum: Metal has only the three preset border colours (as
+	// MoltenVK without VK_EXT_custom_border_color). `exact` reports whether the colour is one of them.
+	inline sampler_border_color get_border_color(const color4f& color, bool& exact)
+	{
+		const u32 encoded = rsx::encode_color_to_storage_key(color);
+		exact = true;
+		switch (encoded)
+		{
+		case 0x00000000: return sampler_border_color::transparent_black;
+		case 0xFFFFFFFF: return sampler_border_color::opaque_white;
+		case 0xFF000000: return sampler_border_color::opaque_black;
+		default: break;
+		}
+
+		exact = false;
+		if ((color.r + color.g + color.b) > 1.35f)
+		{
+			return sampler_border_color::opaque_white;
+		}
+		if (color.a > 0.5f)
+		{
+			return sampler_border_color::opaque_black;
+		}
+		return sampler_border_color::transparent_black;
+	}
+
+	// The key of a sampler state in the renderer's sampler cache (every field of sampler_descriptor).
+	struct sampler_key
+	{
+		u64 lo = 0;
+		u64 hi = 0;
+
+		bool operator==(const sampler_key&) const = default;
+	};
+
+	inline sampler_key make_sampler_key(const sampler_descriptor& d)
+	{
+		sampler_key key{};
+		key.lo = static_cast<u64>(d.min_filter) |
+			(static_cast<u64>(d.mag_filter) << 1) |
+			(static_cast<u64>(d.mip_filter) << 2) |
+			(static_cast<u64>(d.address_s) << 4) |
+			(static_cast<u64>(d.address_t) << 7) |
+			(static_cast<u64>(d.address_r) << 10) |
+			(static_cast<u64>(d.border) << 13) |
+			(static_cast<u64>(d.compare) << 15) |
+			(static_cast<u64>(d.compare_enabled ? 1 : 0) << 18) |
+			(static_cast<u64>(d.max_anisotropy & 0x1f) << 19) |
+			(static_cast<u64>(d.normalized_coordinates ? 1 : 0) << 24) |
+			(static_cast<u64>(std::bit_cast<u32>(d.lod_bias)) << 32);
+		key.hi = static_cast<u64>(std::bit_cast<u32>(d.lod_min)) | (static_cast<u64>(std::bit_cast<u32>(d.lod_max)) << 32);
+		return key;
+	}
+
+	struct sampler_key_hash
+	{
+		usz operator()(const sampler_key& key) const noexcept
+		{
+			return static_cast<usz>(key.lo * 0x9E3779B97F4A7C15ull ^ (key.hi + 0x632BE59BD9B4E019ull + (key.lo << 6) + (key.lo >> 2)));
+		}
+	};
+
+	// Metal's limits on unnormalized coordinates (MTLSamplerDescriptor.normalizedCoordinates = NO): clamp-to-edge or
+	// clamp-to-zero addressing, equal min/mag filters, no mipmaps, no anisotropy. Returns how many fields it changed.
+	inline u32 sanitize_unnormalized_sampler(sampler_descriptor& d)
+	{
+		if (d.normalized_coordinates)
+		{
+			return 0;
+		}
+
+		u32 changed = 0;
+		const auto fix = [&](sampler_address_mode& mode)
+		{
+			if (mode != sampler_address_mode::clamp_to_edge && mode != sampler_address_mode::clamp_to_zero)
+			{
+				mode = sampler_address_mode::clamp_to_edge;
+				changed++;
+			}
+		};
+		fix(d.address_s);
+		fix(d.address_t);
+		fix(d.address_r);
+		if (d.mag_filter != d.min_filter) { d.mag_filter = d.min_filter; changed++; }
+		if (d.mip_filter != sampler_mip_filter::not_mipmapped) { d.mip_filter = sampler_mip_filter::not_mipmapped; changed++; }
+		if (d.max_anisotropy != 1) { d.max_anisotropy = 1; changed++; }
+		return changed;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.cpp b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.cpp
new file mode 100644
index 0000000..ef4f136
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.cpp
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): typeless image copies through the conversion kernels (see MTLTypelessCopy.h).
+
+#include "stdafx.h"
+#include "MTLTypelessCopy.h"
+
+#include "MTLCommandContext.h"
+#include "MTLDataHeap.h"
+#include "MTLM4Counters.h"
+#include "MTLTexture.h"
+
+#include "util/asm.hpp"
+
+namespace mtl
+{
+	namespace
+	{
+		bool is_packed_depth(pixel_format format)
+		{
+			return format == pixel_format::depth32_float || format == pixel_format::depth32_float_stencil8;
+		}
+
+		// Colour and Depth16 data are copied as they are: the texture's texel is the guest texel.
+		bool plain_layout(pixel_format format, u32 texel_width)
+		{
+			return !is_packed_depth(format) && get_texel_size(format) == texel_width;
+		}
+
+		u64 align256(u64 value)
+		{
+			return utils::align<u64>(value, 256);
+		}
+	}
+
+	u32 typeless_destination_width(const image* src, const image* dst, u32 src_w)
+	{
+		const u32 src_texel = get_format_texel_width(src->format());
+		const u32 dst_texel = get_format_texel_width(dst->format());
+		if (!src_texel || !dst_texel || ((src_w * src_texel) % dst_texel) != 0)
+		{
+			return 0;
+		}
+		return (src_w * src_texel) / dst_texel;
+	}
+
+	bool copy_image_typeless(command_context& cmd, data_heap& heap, image* src, image* dst, const typeless_region& copy)
+	{
+		const pixel_format src_format = src->format();
+		const pixel_format dst_format = dst->format();
+		const u32 src_texel = get_format_texel_width(src_format);
+		const u32 dst_texel = get_format_texel_width(dst_format);
+		const u32 dst_w = typeless_destination_width(src, dst, copy.src_w);
+		const u32 h = copy.src_h;
+		const u32 level_w = std::max(dst->width() >> copy.dst_level, 1u);
+		const u32 level_h = std::max(dst->height() >> copy.dst_level, 1u);
+
+		if (!src->texture || !dst->texture || src->samples() > 1 || dst->samples() > 1 ||
+			is_compressed_format(src_format) || is_compressed_format(dst_format) ||
+			!dst_w || !copy.src_w || !h ||
+			(!plain_layout(src_format, src_texel) && !is_packed_depth(src_format)) ||
+			(!plain_layout(dst_format, dst_texel) && !is_packed_depth(dst_format)) ||
+			copy.src_x + copy.src_w > src->width() || copy.src_y + h > src->height() ||
+			copy.dst_x + dst_w > level_w || copy.dst_y + h > level_h)
+		{
+			return false;
+		}
+
+		// VK copy_image_typeless: identical formats of the same class are a plain copy.
+		if (src_format == dst_format && src->format_class() == dst->format_class())
+		{
+			copy_texture(cmd.compute("typeless copy"), src->texture, 0, 0, { { copy.src_x, copy.src_y, 0 }, { copy.src_w, h, 1 } },
+				dst->texture, copy.dst_slice, copy.dst_level, { copy.dst_x, copy.dst_y, copy.dst_z });
+			cmd.end_encoder();
+			return true;
+		}
+
+		const auto shuffle = get_typeless_shuffle(get_format_convert_flags(src_format), get_format_convert_flags(dst_format));
+		if (shuffle.needed && shuffle.kernel == compute_kernel::count)
+		{
+			return false;
+		}
+
+		compute_tasks* const tasks = get_compute_tasks();
+		if ((shuffle.needed || is_packed_depth(src_format) || is_packed_depth(dst_format)) && (!tasks || !tasks->ready()))
+		{
+			return false;
+		}
+
+		// Scratch memory (VK calculate_working_buffer_size: three times the data when a depth aspect is involved), taken
+		// before any encoder opens: the ring may make room by submitting.
+		const u64 src_n = static_cast<u64>(copy.src_w) * h;
+		const u64 dst_n = static_cast<u64>(dst_w) * h;
+		const u64 src_length = src_n * src_texel;
+		const bool depth_involved = is_depth_format(src_format) || is_depth_format(dst_format);
+		auto staging = allocate_staging(cmd, heap, (depth_involved ? src_length * 3 : src_length) + 1024);
+		if (!staging.buffer)
+		{
+			return false;
+		}
+
+		const object& buffer = staging.buffer;
+		const u64 base = staging.offset;
+		cmd.end_encoder();  // the first copy waits for every write to the source
+
+		// 1. vk::copy_image_to_buffer (no byte swap)
+		const mtl::region src_area{ { copy.src_x, copy.src_y, 0 }, { copy.src_w, h, 1 } };
+		switch (src_format)
+		{
+		case pixel_format::depth32_float:
+		{
+			// D32F -> D16F (e4m12): the depth plane after the packed output, then cs_fconvert_task<f32, f16>
+			const u64 z32_offset = align256(base + src_n * 2);
+			copy_texture_to_buffer(cmd.compute("typeless copy"), src->texture, 0, 0, src_area, buffer, z32_offset, copy.src_w * 4, 0);
+			cmd.end_encoder();
+			if (!tasks->run_fconvert(cmd, compute_kernel::f32_to_f16, buffer, static_cast<u32>(z32_offset), static_cast<u32>(src_n * 4), static_cast<u32>(base)))
+			{
+				return false;
+			}
+			break;
+		}
+		case pixel_format::depth32_float_stencil8:
+		{
+			// Depth and stencil planes to separate banks, then interleaved (cs_gather_d32x8, float or unorm depth)
+			const u64 packed_length = src_n * 4;
+			const u64 z_offset = align256(base + packed_length);
+			const u64 s_offset = align256(z_offset + packed_length);
+			const auto& encoder = cmd.compute("typeless copy");
+			copy_texture_to_buffer(encoder, src->texture, 0, 0, src_area, buffer, z_offset, copy.src_w * 4, 0, blit_depth_from_depth_stencil);
+			copy_texture_to_buffer(encoder, src->texture, 0, 0, src_area, buffer, s_offset, copy.src_w, 0, blit_stencil_from_depth_stencil);
+			cmd.end_encoder();
+
+			const auto kernel = get_depth_gather_kernel(src->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32);
+			if (!tasks->run_interleave(cmd, kernel, buffer, static_cast<u32>(base), static_cast<u32>(packed_length), static_cast<u32>(z_offset), static_cast<u32>(s_offset)))
+			{
+				return false;
+			}
+			break;
+		}
+		default:
+			copy_texture_to_buffer(cmd.compute("typeless copy"), src->texture, 0, 0, src_area, buffer, base, copy.src_w * src_texel, 0);
+			cmd.end_encoder();
+			break;
+		}
+
+		// 2. The byte shuffle between the two layouts
+		if (shuffle.needed && !tasks->run_shuffle(cmd, shuffle.kernel, buffer, static_cast<u32>(src_length), static_cast<u32>(base)))
+		{
+			return false;
+		}
+
+		// 3. vk::copy_buffer_to_image
+		const size3 dst_size{ dst_w, h, 1 };
+		const origin dst_origin{ copy.dst_x, copy.dst_y, copy.dst_z };
+		switch (dst_format)
+		{
+		case pixel_format::depth32_float:
+		{
+			// D16F (e4m12) -> D32F through cs_fconvert_task<f16, f32>, then the depth plane
+			const u64 packed16_length = dst_n * 2;
+			const u64 z32_offset = align256(base + packed16_length);
+			if (!tasks->run_fconvert(cmd, compute_kernel::f16_to_f32, buffer, static_cast<u32>(base), static_cast<u32>(packed16_length), static_cast<u32>(z32_offset)))
+			{
+				return false;
+			}
+			copy_buffer_to_texture(cmd.compute("typeless copy"), buffer, z32_offset, dst_w * 4, 0, dst_size, dst->texture, copy.dst_slice, copy.dst_level, dst_origin);
+			cmd.end_encoder();
+			break;
+		}
+		case pixel_format::depth32_float_stencil8:
+		{
+			// The stencil block is cleared, the packed words scattered (cs_scatter_d32x8), then both planes copied in
+			const u64 packed_length = dst_n * 4;
+			const u64 z_offset = align256(base + packed_length);
+			const u64 s_offset = align256(z_offset + packed_length);
+			fill_buffer(cmd.compute("typeless copy"), buffer, s_offset, utils::align<u64>(dst_n, 4), 0);
+			cmd.end_encoder();
+
+			const auto kernel = get_depth_scatter_kernel(dst->format_class() == rsx::RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32);
+			if (!tasks->run_interleave(cmd, kernel, buffer, static_cast<u32>(base), static_cast<u32>(packed_length), static_cast<u32>(z_offset), static_cast<u32>(s_offset)))
+			{
+				return false;
+			}
+
+			const auto& encoder = cmd.compute("typeless copy");
+			copy_buffer_to_texture(encoder, buffer, z_offset, dst_w * 4, 0, dst_size, dst->texture, copy.dst_slice, copy.dst_level, dst_origin, blit_depth_from_depth_stencil);
+			copy_buffer_to_texture(encoder, buffer, s_offset, dst_w, 0, dst_size, dst->texture, copy.dst_slice, copy.dst_level, dst_origin, blit_stencil_from_depth_stencil);
+			cmd.end_encoder();
+			break;
+		}
+		default:
+			copy_buffer_to_texture(cmd.compute("typeless copy"), buffer, base, dst_w * dst_texel, 0, dst_size, dst->texture, copy.dst_slice, copy.dst_level, dst_origin);
+			cmd.end_encoder();
+			break;
+		}
+
+		m4_count(get_m4_counters().typeless_copies);
+		return true;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.h b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.h
new file mode 100644
index 0000000..eb233ca
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLTypelessCopy.h
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the Vulkan renderer's typeless image copy (VKTexture.cpp vk::copy_image_typeless with
+// vk::copy_image_to_buffer / vk::copy_buffer_to_image) on Metal, for the texture cache (MTLTextureCache.cpp
+// copy_transfer_regions_impl) and the surface inheritance (MTLRenderTargets.cpp memory_barrier):
+//   1. the source region goes to a scratch buffer, depth planes packed as the guest stores them: Depth32Float through
+//      cs_fconvert_task<f32, f16> (e4m12), Depth32Float_Stencil8 through cs_gather_d32x8 (unorm or float class);
+//   2. when the two formats swap bytes differently, the cs_shuffle_16 / _32 / _32_16 kernel the Vulkan renderer picks;
+//   3. the scratch buffer goes to the destination region, depth planes unpacked through cs_fconvert_task<f16, f32> or
+//      cs_scatter_d32x8 (stencil block cleared first).
+// The kernels are the M4 conversion kernels (MTLComputeTasks.h). Every step is its own encoder (each starts with the
+// command context's queue barrier), so each reads what the previous one wrote.
+
+#include "MTLAPI.h"
+#include "MTLComputeTasks.h"
+
+#include <utility>
+
+namespace mtl
+{
+	// VK copy_image_typeless: the byte shuffle between two layouts given their get_format_convert_flags (byteswapped on
+	// upload, swap granule): none when neither swaps or both swap the same way; cs_shuffle_32_16 when both swap with
+	// different granules; otherwise the granule of the one that swaps (cs_shuffle_32 or cs_shuffle_16).
+	struct typeless_shuffle
+	{
+		bool needed = false;
+		compute_kernel kernel = compute_kernel::count;  // count with needed: a granule no kernel handles
+	};
+
+	constexpr typeless_shuffle get_typeless_shuffle(std::pair<bool, u32> src_convert, std::pair<bool, u32> dst_convert)
+	{
+		const bool needed = (src_convert.first || dst_convert.first) &&
+			(src_convert.first != dst_convert.first || src_convert.second != dst_convert.second);
+		if (!needed)
+		{
+			return {};
+		}
+
+		if (src_convert.first && dst_convert.first)
+		{
+			return { true, compute_kernel::bswap_u16_u32 };
+		}
+
+		const u32 block_size = src_convert.first ? src_convert.second : dst_convert.second;
+		return { true, block_size == 4 ? compute_kernel::bswap_u32 : block_size == 2 ? compute_kernel::bswap_u16 : compute_kernel::count };
+	}
+
+	// vk::copy_image_to_buffer / vk::copy_buffer_to_image for D32_SFLOAT_S8_UINT: the interleave kernel by depth class
+	// (DEPTH24_FLOAT_X8_PACK32 keeps float depth bits, the unorm class converts), no byte swap in a typeless copy.
+	constexpr compute_kernel get_depth_gather_kernel(bool float_depth)
+	{
+		return float_depth ? compute_kernel::gather_d32fx8 : compute_kernel::gather_d32x8;
+	}
+
+	constexpr compute_kernel get_depth_scatter_kernel(bool float_depth)
+	{
+		return float_depth ? compute_kernel::scatter_d32fx8 : compute_kernel::scatter_d32x8;
+	}
+
+	class command_context;
+	class data_heap;
+	class image;
+
+	// One region of level 0, slice 0 of the source; the destination region starts at (dst_x, dst_y) of a level and slice
+	// (or depth slice) and is (src_w * source texel width / destination texel width) x src_h, the same bytes.
+	struct typeless_region
+	{
+		u32 src_x = 0, src_y = 0, src_w = 0, src_h = 0;
+		u32 dst_x = 0, dst_y = 0;
+		u32 dst_slice = 0, dst_level = 0, dst_z = 0;
+	};
+
+	// The destination width the source bytes make, or 0 when the formats cannot be reinterpreted this way.
+	u32 typeless_destination_width(const image* src, const image* dst, u32 src_w);
+
+	// False when the copy cannot be done exactly (a compressed or unknown format, a multisampled image, a region outside
+	// an image, or a conversion kernel unavailable): the destination is not written, the caller counts it.
+	bool copy_image_typeless(command_context& cmd, data_heap& heap, image* src, image* dst, const typeless_region& copy);
+}
diff --git a/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp b/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp
new file mode 100644
index 0000000..c95663e
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): host unit test of the pure logic of stage M4 (no Metal device, no emulator):
+//   - the visibility slot pool, and the Vulkan renderer's occlusion query rules (check, gather) on segments, including
+//     the exactness of folding (a folded record answers exactly as the unfolded one, for random records);
+//   - the conversion arithmetic (MTLM4Math.h, the very tokens the MSL kernels compile) against independent references;
+//   - the MSAA resolve/unresolve coordinate math (both directions are inverse, and match the Vulkan compute passes);
+//   - the MSAA configuration (sample counts, grids, sample masks) and the compute dispatch parameters.
+//   - the typeless copy's kernel selection (VK copy_image_typeless, copy_image_to_buffer / copy_buffer_to_image).
+// With a directory argument it also writes the MSL libraries (m4_compute.metal, m4_resolve.metal) for Apple's offline
+// compiler: xcrun -sdk iphoneos metal -std=metal3.2 -target air64-apple-ios26.0 -Werror -Wno-unused-variable
+// -Wno-unused-but-set-variable -Wno-unused-function -c m4_compute.metal. Pure logic: no Metal, g++ or clang++.
+//
+//   S=<rpcs3 source root>
+//   c++ -std=gnu++20 -Wall -I "$S/rpcs3" -I "$S" -I "$S/rpcs3/Emu" -I "$S/3rdparty"
+//       "$S/rpcs3/Emu/RSX/Metal/tests/mtl_m4_unit_test.cpp" -o mtl_m4_unit_test
+//   ./mtl_m4_unit_test [MSL output directory]
+
+#include "Emu/RSX/Metal/MTLComputeTasks.h"
+#include "Emu/RSX/Metal/MTLM4Math.h"
+#include "Emu/RSX/Metal/MTLM4Shaders.h"
+#include "Emu/RSX/Metal/MTLQueries.h"
+#include "Emu/RSX/Metal/MTLTypelessCopy.h"
+
+#include <bit>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <random>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace
+{
+	int g_failures = 0;
+	int g_checks = 0;
+
+	void check(bool condition, const char* what, long long a = 0, long long b = 0)
+	{
+		g_checks++;
+		if (!condition)
+		{
+			std::fprintf(stderr, "FAIL: %s (%lld, %lld)\n", what, a, b);
+			++g_failures;
+		}
+	}
+
+	using namespace mtl;
+	using namespace mtl::m4_math;
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_slot_pool()
+	{
+		visibility_slot_pool pool(4);
+		check(pool.capacity() == 4 && pool.available() == 4 && pool.in_use() == 0, "pool starts free");
+
+		const u32 a = pool.allocate(), b = pool.allocate(), c = pool.allocate(), d = pool.allocate();
+		check(a == 0 && b == 1 && c == 2 && d == 3, "slots in order", a, d);
+		check(pool.allocate() == umax, "exhausted pool returns umax");
+		check(pool.in_use() == 4, "all in use");
+
+		check(pool.release(b, 7), "release b at fence 7");
+		check(pool.release(a, 9), "release a at fence 9");
+		check(!pool.release(a, 9), "double release refused");
+		check(!pool.release(17, 1), "out of range release refused");
+		check(pool.pending() == 2 && pool.available() == 0, "released slots wait for their fence");
+
+		check(pool.collect(6) == 0, "nothing complete at 6");
+		check(pool.allocate() == umax, "pending slots are not reused");
+		check(pool.collect(8) == 1, "fence 7 completed at 8");
+		check(pool.allocate() == b, "b reused after its fence");
+		check(pool.collect(100) == 1 && pool.allocate() == a, "a reused after its fence");
+		check(pool.allocate() == umax, "full again");
+
+		// Out-of-order fences are all collected
+		pool.release(c, 30);
+		pool.release(d, 20);
+		check(pool.collect(25) == 1 && pool.allocate() == d, "the earlier fence first, whatever the release order");
+		check(pool.collect(30) == 1 && pool.allocate() == c, "the later fence next");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	// A reference model of the Vulkan renderer on per-command-buffer host queries (VKGSRender.cpp, RPCS3_IOS variant):
+	// each index has a value and an availability; is_current = the query's last command buffer is still recording.
+	struct vk_query
+	{
+		u32 value = 0;
+		u64 fence = 0;
+	};
+
+	bool vk_check(const std::vector<vk_query>& indices, bool is_current, u64 completed, bool precise)
+	{
+		if (indices.empty()) return true;
+		if (is_current) return false;
+		for (const auto& index : indices)
+		{
+			if (index.fence > completed) return false;
+			if (!precise && index.value) return true;
+		}
+		return true;
+	}
+
+	u32 vk_gather(const std::vector<vk_query>& indices, bool precise)
+	{
+		u32 result = 0;
+		for (const auto& index : indices)
+		{
+			result += index.value;
+			if (result && !precise) break;
+		}
+		return result;
+	}
+
+	void test_query_rules()
+	{
+		std::map<u32, u64> values;  // slot -> value
+		const auto read = [&](u32 slot) { return values[slot]; };
+
+		occlusion_record record{};
+		check(occlusion_ready(record, 10, 10, false, read), "no data: ready");
+		check(occlusion_gather(record, false, [](u64) {}, read) == 0, "no data: 0");
+
+		record.has_data = true;
+		record.segments = { { 0, 5 }, { 1, 6 } };
+		record.last_fence = 6;
+		values = { { 0, 0 }, { 1, 12 } };
+		check(!occlusion_ready(record, 5, 5, false, read), "last segment in the open command buffer: not ready");
+		check(!occlusion_ready(record, 6, 5, false, read), "second segment not complete: not ready");
+		check(occlusion_ready(record, 6, 6, false, read), "all complete: ready");
+
+		values = { { 0, 3 }, { 1, 12 } };
+		check(occlusion_ready(record, 6, 5, false, read), "first segment complete with samples: ready (non-precise)");
+		check(!occlusion_ready(record, 6, 5, true, read), "precise needs every segment");
+
+		u64 waited = 0;
+		const auto wait = [&](u64 fence) { waited = std::max(waited, fence); };
+		check(occlusion_gather(record, false, wait, read) == 3 && waited == 5, "non-precise stops at the first hit, waits only for it");
+		waited = 0;
+		check(occlusion_gather(record, true, wait, read) == 15 && waited == 6, "precise sums all, waits for all");
+
+		// 32-bit results, as Vulkan's
+		values = { { 0, 0x1'0000'0002ull }, { 1, 0xFFFF'FFFFull } };
+		check(occlusion_gather(record, true, wait, read) == 1u, "32-bit wrap of the sum", occlusion_gather(record, true, wait, read));
+
+		// Random records: the model and the implementation agree, and folding changes nothing.
+		std::mt19937_64 rng(902);
+		for (int iteration = 0; iteration < 20000; ++iteration)
+		{
+			const bool precise = rng() & 1;
+			const usz count = rng() % 6;
+			std::vector<vk_query> model;
+			occlusion_record r{};
+			std::map<u32, u64> slot_values;
+			u64 fence = 1 + rng() % 3;
+			for (usz n = 0; n < count; ++n)
+			{
+				fence += rng() % 3;  // never decreases
+				const u32 value = (rng() % 3 == 0) ? static_cast<u32>(rng() % 50) : 0;
+				model.push_back({ value, fence });
+				r.segments.push_back({ static_cast<u32>(n), fence });
+				slot_values[static_cast<u32>(n)] = value;
+			}
+			r.has_data = count > 0;
+			r.last_fence = count ? fence : 0;
+			const auto rd = [&](u32 slot) { return slot_values.at(slot); };
+
+			const u64 last_submitted = fence + (rng() % 2) - (count && (rng() % 4 == 0) ? 1 : 0);
+			const u64 completed = std::min<u64>(last_submitted, rng() % (fence + 2));
+			const bool is_current = r.last_fence > last_submitted;
+
+			const bool expected_ready = vk_check(model, is_current, completed, precise);
+			check(occlusion_ready(r, last_submitted, completed, precise, rd) == expected_ready, "ready matches the Vulkan model", iteration);
+			const u32 expected_value = vk_gather(model, precise);
+			check(occlusion_gather(r, precise, [](u64) {}, rd) == expected_value, "gather matches the Vulkan model", iteration);
+
+			// Fold at an earlier completion point, then ask again at the same and at a later point.
+			occlusion_record folded = r;
+			std::vector<std::pair<u32, u64>> released;
+			const u64 fold_point = std::min<u64>(completed, rng() % (fence + 2));
+			fold_completed(folded, fold_point, precise, rd, [&](u32 slot, u64 f) { released.emplace_back(slot, f); });
+			check(released.size() + folded.segments.size() == r.segments.size(), "every segment is either kept or released once", iteration);
+			std::set<u32> unique_slots;
+			for (const auto& [slot, f] : released) unique_slots.insert(slot);
+			for (const auto& s : folded.segments) unique_slots.insert(s.slot);
+			check(unique_slots.size() == r.segments.size(), "no slot released twice", iteration);
+			for (const auto& [slot, f] : released)
+			{
+				check(f == r.segments[slot].fence, "a slot is released with its own fence", iteration);
+			}
+
+			check(occlusion_ready(folded, last_submitted, completed, precise, rd) == expected_ready, "folding keeps readiness", iteration);
+			check(occlusion_ready(folded, last_submitted, last_submitted, precise, rd) ==
+				vk_check(model, is_current, last_submitted, precise), "folding keeps readiness later", iteration);
+			check(occlusion_gather(folded, precise, [](u64) {}, rd) == expected_value, "folding keeps the value", iteration);
+		}
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_conversion_math()
+	{
+		// Byte swaps (ShuffleBytes.glsl) against independent definitions
+		std::mt19937 rng(7);
+		for (int n = 0; n < 100000; ++n)
+		{
+			const u32 v = static_cast<u32>(rng());
+			const u32 swapped16 = ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+			check(m4_bswap_u16(v) == swapped16, "bswap_u16 swaps the bytes of each half", v, m4_bswap_u16(v));
+			check(m4_bswap_u32(v) == __builtin_bswap32(v), "bswap_u32 is a 32-bit byte swap", v, m4_bswap_u32(v));
+			check(m4_bswap_u16_u32(v) == ((v << 16) | (v >> 16)), "bswap_u16_u32 swaps the halves", v);
+			check(m4_d24x8_to_d24x8_swapped(v) == ((v & 0x0000FF00u) | ((v >> 16) & 0xFFu) | ((v & 0xFFu) << 16)), "d24x8 swap", v);
+			check(m4_d24f_to_f32(v) == (v << 7) && m4_f32_to_d24f(v) == (v >> 7), "d24f shifts", v);
+		}
+
+		// D24 -> F32: float(d) / 16777215 is correctly rounded (computed exactly in double, then rounded once: innocuous
+		// double rounding for division, 53 >= 2 * 24 + 2 bits).
+		u32 mismatches = 0;
+		for (u32 d = 0; d < (1u << 24); ++d)
+		{
+			const u32 expected = std::bit_cast<u32>(static_cast<float>(static_cast<double>(d) / 16777215.0));
+			mismatches += m4_d24_to_f32(d) != expected;
+		}
+		check(mismatches == 0, "d24_to_f32 is the correctly rounded quotient for every 24-bit value", mismatches);
+		check(m4_d24x8_to_f32(0xFFFFFF00u) == std::bit_cast<u32>(1.f), "d24x8 all ones is 1.0");
+		check(m4_d24x8_to_f32(0x000000FFu) == 0, "stencil bits are ignored");
+
+		// F32 -> D24: truncation of the product (the GLSL uint() conversion)
+		check(m4_f32_to_d24(std::bit_cast<u32>(1.f)) == 16777215u, "1.0 -> 0xFFFFFF");
+		check(m4_f32_to_d24(std::bit_cast<u32>(0.f)) == 0u, "0.0 -> 0");
+		check(m4_f32_to_d24(std::bit_cast<u32>(0.5f)) == 8388607u, "0.5 -> 8388607 (truncated)", m4_f32_to_d24(std::bit_cast<u32>(0.5f)));
+		for (int n = 0; n < 100000; ++n)
+		{
+			const float f = std::uniform_real_distribution<float>(0.f, 1.f)(rng);
+			const float product = f * 16777215.f;
+			check(m4_f32_to_d24(std::bit_cast<u32>(f)) == static_cast<u32>(product), "f32_to_d24 truncates the float product");
+			check(m4_f32_to_d24x8_swapped(std::bit_cast<u32>(f)) == m4_d24x8_to_d24x8_swapped(static_cast<u32>(product)), "f32_to_d24x8_swapped");
+		}
+
+		// Interleave (cs_gather / cs_scatter): a scatter followed by a gather restores the D24S8 words.
+		for (int n = 0; n < 4096; ++n)
+		{
+			const u32 index = static_cast<u32>(rng() % 1024);
+			const u32 value = static_cast<u32>(rng());
+			const u32 depth = m4_scatter_d24(value);
+			const u32 stencil_word = m4_scatter_stencil(value, index);
+			check(m4_gather_d24x8(depth, stencil_word, index) == value, "scatter then gather of D24S8", value);
+			check(m4_gather_stencil(stencil_word, index) == (value & 0xFF), "stencil byte position", index);
+			check(m4_stencil_shift(index) == (index % 4) * 8, "stencil shift");
+		}
+
+		check(m4_gather_d32x8(std::bit_cast<u32>(1.f), 0xAB000000u, 3) == 0xFFFFFFABu, "gather d32: 1.0 and stencil byte 3");
+		check(m4_scatter_d32(0xFFFFFF12u) == std::bit_cast<u32>(1.f), "scatter d32: 0xFFFFFF -> 1.0");
+		check(m4_gather_d32fx8(m4_scatter_d32f(0x12345678u), 0x78u, 0) == 0x12345678u, "d24f round trip");
+
+		// e4m12 (cs_fconvert_task): 1.0f <-> 0x7000, and exact round trips of the representable values
+		check(m4_pack_e4m12_pack16(std::bit_cast<u32>(1.f), std::bit_cast<u32>(1.f)) == 0x70007000u, "1.0 packs to 0x7000");
+		check(m4_unpack_e4m12_lo(0x7000u) == std::bit_cast<u32>(1.f) && m4_unpack_e4m12_hi(0x70000000u) == std::bit_cast<u32>(1.f), "0x7000 unpacks to 1.0");
+		for (u32 bits = 0; bits <= 0xFFFF; ++bits)
+		{
+			const u32 packed = bits | (bits << 16);
+			const u32 lo = m4_unpack_e4m12_lo(packed);
+			const u32 hi = m4_unpack_e4m12_hi(packed);
+			check(lo == hi && m4_pack_e4m12_pack16(lo, hi) == packed, "e4m12 unpack/pack round trip", bits);
+		}
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_resolve_math()
+	{
+		for (const u32 samples : { 1u, 2u, 4u })
+		{
+			const auto grid = msaa::grid_for(samples);
+			check(grid.x * grid.y == samples, "grid holds every sample", samples);
+
+			const int sx = static_cast<int>(grid.x), sy = static_cast<int>(grid.y);
+			const int width = 7, height = 5;  // multisampled image size
+			std::set<std::pair<std::pair<int, int>, int>> seen;
+			for (int ry = 0; ry < height * sy; ++ry)
+			{
+				for (int rx = 0; rx < width * sx; ++rx)
+				{
+					// Colour/Depth resolve passes: resolve texel -> (pixel, sample)
+					const int px = m4_resolve_source(rx, sx), py = m4_resolve_source(ry, sy);
+					const int sample = m4_resolve_sample_index(rx, ry, sx, sy);
+					check(px < width && py < height && sample >= 0 && sample < static_cast<int>(samples), "resolve stays in the image", rx, ry);
+					seen.insert({ { px, py }, sample });
+
+					// Unresolve passes (per sample): (pixel, sample) -> the same resolve texel
+					check(m4_unresolve_target_x(px, sample, sx) == rx && m4_unresolve_target_y(py, sample, sx, sy) == ry,
+						"unresolve inverts resolve", rx, ry);
+
+					// ColorUnresolvePass.glsl (compute, per resolve texel) stores the texel at (rc / sc, loc.x + loc.y * sc.y):
+					// the per-sample render pass reads it back from the same texel.
+					const int loc_x = rx % sx, loc_y = ry % sy;
+					check(loc_x + loc_y * sy == sample, "same sample index as the compute unresolve", rx, ry);
+				}
+			}
+			check(seen.size() == static_cast<usz>(width * height) * samples, "every sample of every pixel exactly once", samples);
+		}
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_msaa_config()
+	{
+		check(msaa::grid_for(2).x == 2 && msaa::grid_for(2).y == 1, "2 samples side by side (diagonal_centered_2)");
+		check(msaa::grid_for(4).x == 2 && msaa::grid_for(4).y == 2, "4 samples as 2x2 (square_centered/rotated_4)");
+		check(msaa::grid_for(8).x == 0, "8 samples is not an RSX mode");
+
+		// VK create_new_surface: get_format_sample_count(aa) at "Auto" (1, 2, 4, 4), one sample when disabled
+		for (const u32 rsx_samples : { 1u, 2u, 4u })
+		{
+			check(msaa::host_samples(true, rsx_samples) == rsx_samples, "Auto keeps the AA mode's samples", rsx_samples);
+			check(msaa::host_samples(false, rsx_samples) == 1, "Disabled is single-sampled", rsx_samples);
+		}
+
+		check(msaa::pipeline_sample_mask(4, 0xFFFF) == msaa::all_samples, "full RSX mask: no shader mask");
+		check(msaa::pipeline_sample_mask(4, 0x000F) == msaa::all_samples, "mask of every existing sample: no shader mask");
+		check(msaa::pipeline_sample_mask(4, 0x0005) == 0x5, "partial mask kept");
+		check(msaa::pipeline_sample_mask(2, 0xFFFE) == 0x2, "bits beyond the sample count dropped");
+		check(msaa::pipeline_sample_mask(2, 0x0000) == 0x0, "empty mask writes no sample");
+		check(msaa::pipeline_sample_mask(1, 0x0000) == msaa::all_samples, "one sample: Vulkan applies no mask");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_dispatch_params()
+	{
+		check(compute_shuffle_workgroups(0) == 0 && compute_shuffle_workgroups(1) == 1 && compute_shuffle_workgroups(1024) == 1 &&
+			compute_shuffle_workgroups(1025) == 2, "cs_shuffle_base::run work groups (256 invocations of 4 bytes)");
+
+		for (const u32 invocations : { 1u, 255u, 256u, 257u, 65535u * 256u, 65536u * 256u, 1000000u * 256u })
+		{
+			const auto size = get_dispatch_size(invocations, 256);
+			const u64 covered = static_cast<u64>(size.groups.width) * size.groups.height * size.threads.width;
+			check(covered >= invocations, "the dispatch covers every invocation", invocations, static_cast<long long>(covered));
+			check(size.groups.width <= 65535 && size.groups.height <= 65535, "groups within the limit", size.groups.width, size.groups.height);
+		}
+
+		const auto shuffle = shuffle_params(1030);
+		check(shuffle[0] == 257 && shuffle[3] == 257, "shuffle: whole words of the bound range", shuffle[0]);
+
+		u32 bound = 0;
+		const auto interleave = interleave_params(0x100, 0x400, 0x200, 0x900, bound);
+		check(bound == 0x100 && interleave[0] == 0x400 && interleave[1] == 0x100 && interleave[2] == 0x800 &&
+			interleave[3] == (0x900 + 0x100 - 0x100) / 4, "cs_interleave_task::run parameters");
+
+		const auto contract = fconvert_params(compute_kernel::f32_to_f16, 0x1000, 0x800, 0x400, bound);
+		check(bound == 0x400 && contract[0] == 0x800 && contract[1] == 0xC00 && contract[2] == 0 && contract[3] == (0x1800 - 0x400) / 4,
+			"cs_fconvert_task<f32, f16>::run, source after destination");
+		const auto expand = fconvert_params(compute_kernel::f16_to_f32_swap_both, 0x400, 0x800, 0x1000, bound);
+		check(bound == 0x400 && expand[1] == 0 && expand[2] == 0xC00 && expand[3] == (0xC00 + (0x800 / 2) * 4) / 4,
+			"cs_fconvert_task<f16, f32>::run, destination after source");
+
+		check(get_kernel_family(compute_kernel::d24x8_to_d24x8_swapped) == compute_kernel_family::shuffle &&
+			get_kernel_family(compute_kernel::gather_d24x8) == compute_kernel_family::interleave &&
+			get_kernel_family(compute_kernel::scatter_d32fx8) == compute_kernel_family::interleave &&
+			get_kernel_family(compute_kernel::f32_to_f16) == compute_kernel_family::fconvert, "kernel families");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_typeless_selection()
+	{
+		using flags = std::pair<bool, u32>;
+		// get_format_convert_flags pairs (VKFormats.cpp): {byteswapped on upload, swap granule}
+		const flags none{ false, 1 }, swap2{ true, 2 }, swap4{ true, 4 }, unknown{ false, 0 }, swap8{ true, 8 };
+
+		check(!get_typeless_shuffle(swap4, swap4).needed, "same granule both sides: no shuffle (rgba8 <-> r32f)");
+		check(!get_typeless_shuffle(swap2, swap2).needed, "same granule both sides: no shuffle (r16 <-> d16)");
+		check(!get_typeless_shuffle(none, unknown).needed, "neither swaps: no shuffle");
+		check(get_typeless_shuffle(swap4, swap2).kernel == compute_kernel::bswap_u16_u32, "both swap, granules differ: cs_shuffle_32_16");
+		check(get_typeless_shuffle(swap2, swap4).kernel == compute_kernel::bswap_u16_u32, "both swap, granules differ (reverse): cs_shuffle_32_16");
+		check(get_typeless_shuffle(none, swap2).kernel == compute_kernel::bswap_u16, "only the destination swaps by 2: cs_shuffle_16");
+		check(get_typeless_shuffle(swap4, none).kernel == compute_kernel::bswap_u32, "only the source swaps by 4: cs_shuffle_32");
+		check(get_typeless_shuffle(none, swap8).needed && get_typeless_shuffle(none, swap8).kernel == compute_kernel::count,
+			"a granule without a kernel is refused (VK: unreachable)");
+
+		check(get_depth_gather_kernel(true) == compute_kernel::gather_d32fx8 && get_depth_gather_kernel(false) == compute_kernel::gather_d32x8,
+			"cs_gather_d32x8<false, true> for float depth, <false, false> for unorm depth");
+		check(get_depth_scatter_kernel(true) == compute_kernel::scatter_d32fx8 && get_depth_scatter_kernel(false) == compute_kernel::scatter_d32x8,
+			"cs_scatter_d32x8<true> for float depth, <false> for unorm depth");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_msl_text(const char* directory)
+	{
+		const std::string compute = m4_shaders::compute_library_source();
+		const std::string resolve = m4_shaders::resolve_library_source();
+
+		check(m4_shaders::compute_kernel_names.size() == static_cast<usz>(compute_kernel::count), "one MSL kernel per compute_kernel");
+		for (const auto name : m4_shaders::compute_kernel_names)
+		{
+			// Each kernel is declared once through its M4_*_KERNEL macro
+			const std::string declaration = "(" + std::string(name) + ",";
+			const usz first = compute.find(declaration);
+			check(first != std::string::npos && compute.find(declaration, first + 1) == std::string::npos, "kernel declared once", static_cast<long long>(first));
+		}
+
+		for (const char* function : { "m4_resolve_vertex", "m4_color_resolve", "m4_color_unresolve", "m4_depth_resolve", "m4_depth_unresolve",
+			"m4_depth_stencil_resolve", "m4_depth_stencil_unresolve" })
+		{
+			check(resolve.find(std::string(" ") + function + "(") != std::string::npos, "resolve function present");
+		}
+
+		// The C++ and MSL halves of the dual sources are the same tokens
+		check(m4_source::conversion_math.find("m4_pack_e4m12_pack16") != std::string_view::npos &&
+			m4_source::resolve_math.find("m4_unresolve_target_y") != std::string_view::npos, "dual sources stringized");
+		check(compute.find(m4_source::conversion_math) != std::string::npos && resolve.find(m4_source::resolve_math) != std::string::npos,
+			"the libraries hold the tested math");
+
+		if (directory)
+		{
+			std::ofstream(std::string(directory) + "/m4_compute.metal", std::ios::binary) << compute;
+			std::ofstream(std::string(directory) + "/m4_resolve.metal", std::ios::binary) << resolve;
+		}
+	}
+}
+
+int main(int argc, char** argv)
+{
+	test_slot_pool();
+	test_query_rules();
+	test_conversion_math();
+	test_resolve_math();
+	test_msaa_config();
+	test_dispatch_params();
+	test_typeless_selection();
+	test_msl_text(argc > 1 ? argv[1] : nullptr);
+
+	if (g_failures)
+	{
+		std::fprintf(stderr, "%d of %d checks failed\n", g_failures, g_checks);
+		return 1;
+	}
+
+	std::printf("PASS: Metal M4 unit (%d checks)\n", g_checks);
+	return 0;
+}
