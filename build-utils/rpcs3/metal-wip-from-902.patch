+
+	enum class compute_kernel_family : u8
+	{
+		shuffle,
+		interleave,
+		fconvert,
+	};
+
+	constexpr compute_kernel_family get_kernel_family(compute_kernel kernel)
+	{
+		if (kernel <= compute_kernel::d24x8_to_d24x8_swapped) return compute_kernel_family::shuffle;
+		if (kernel <= compute_kernel::scatter_d32fx8) return compute_kernel_family::interleave;
+		return compute_kernel_family::fconvert;
+	}
