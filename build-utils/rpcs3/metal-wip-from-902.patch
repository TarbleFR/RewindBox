+	}
+}
+
+namespace
+{
+	int g_failures = 0;
+	int g_checks = 0;
+
+	void check(bool condition, const char* what, int line)
+	{
+		g_checks++;
+		if (!condition)
+		{
+			g_failures++;
+			std::fprintf(stderr, "FAIL line %d: %s\n", line, what);
