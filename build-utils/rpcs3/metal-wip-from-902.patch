@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M3.1): textures of the native Metal 4 renderer (vk::image / vk::viewable_image /
+// vk::image_view counterparts) and the CPU texture upload path.
+//
+// An image owns one MTLTexture (private storage, resident in the renderer's residency set) and the views made of
+// it: one per (RSX remap, aspect, format), with the swizzle the Vulkan renderer puts in its VkImageView. Render
+// targets are images too, so the texture cache samples them through the same views.
+//
+// Uploads run on the CPU exactly as the Vulkan renderer's upload_image does when its GPU helpers are not used:
+// rsx::upload_texture_subresource deswizzles, byteswaps and (without BC support) decompresses into the upload
+// ring, then the compute encoder copies the ring into the texture. Depth formats are converted on the CPU with
+// the Vulkan renderer's formulas (MTLTextureFormats.h) and copied per plane.
+
+#include "MTLAPI.h"
+#include "MTLDataHeap.h"
+#include "MTLFormats.h"
+#include "MTLTextureFormats.h"
+
+#include "Emu/RSX/Common/TextureUtils.h"
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace mtl
+{
+	class command_context;
+	class image;
+
+	// The renderer's command context, for destructors and code paths that have none at hand (RSX thread only).
+	void set_command_context(command_context* ctx);
+	command_context* get_command_context();
+
+	enum image_aspect : u32
+	{
+		aspect_color = 1,
+		aspect_depth = 2,
+		aspect_stencil = 4,
+	};
+
+	// What the texture paths did or could not do yet; read and reset by the performance report (COREPROF METAL).
+	struct texture_counters
+	{
+		std::atomic<u64> images_created{0};
+		std::atomic<u64> image_allocation_failures{0};
+		std::atomic<u64> views_created{0};
+		std::atomic<u64> view_failures{0};
+		std::atomic<u64> uploads{0};
+		std::atomic<u64> upload_bytes{0};
+		std::atomic<u64> upload_dedicated_buffers{0};
+		std::atomic<u64> depth_uploads_converted{0};
+		std::atomic<u64> uploads_unsupported_format{0};     // no Metal format (counted, the section keeps zeros)
+		std::atomic<u64> clears{0};
+		std::atomic<u64> copies{0};
+		std::atomic<u64> typeless_copies{0};                // bit-compatible format views
+		std::atomic<u64> buffer_bitcasts{0};                // reinterpretations through a buffer (no byte shuffle)
+		std::atomic<u64> typeless_not_implemented{0};       // needs a byte shuffle or a depth conversion on the GPU
+		std::atomic<u64> scaled_not_implemented{0};         // a scaled region copy (no blit-scale pipeline yet)
+		std::atomic<u64> copies_clipped{0};                 // region copies kept inside the textures (Metal does not clip)
+		std::atomic<u64> feedback_snapshots{0};             // bound attachments sampled through a copy
+		std::atomic<u64> readbacks{0};
+		std::atomic<u64> readback_bytes{0};
+		std::atomic<u64> readbacks_not_implemented{0};      // scaled, tiled, compressed or DMA-only (guest memory kept)
+		std::atomic<u64> samplers_created{0};
+		std::atomic<u64> border_colors_approximated{0};     // RSX custom border colour -> closest Metal preset
+		std::atomic<u64> lod_bias_not_applied{0};           // the device has no sampler LOD bias
+		std::atomic<u64> filters_downgraded{0};             // linear filter on a format the device cannot filter
+		std::atomic<u64> unnormalized_samplers_adjusted{0}; // Metal limits on unnormalized coordinates
+		std::atomic<u64> textures_failed{0};                // enabled unit without a texture: neutral texture bound
+	};
+
+	texture_counters& get_texture_counters();
+
+	// Logs a message once per process (counters keep the totals).
+	void log_once(const char* key, const std::string& message);
+
+	class image_view
+	{
+	public:
+		image_view(mtl::image* owner, object handle, const texture_view_descriptor& desc, u32 aspect, u64 key);
+		~image_view();
+
+		image_view(const image_view&) = delete;
+		image_view& operator=(const image_view&) = delete;
+
+		mtl::image* image() const { return m_owner; }
+		const object& handle() const { return m_handle; }
+		pixel_format format() const { return m_desc.format; }
+		u32 aspect() const { return m_aspect; }
+		const texture_view_descriptor& descriptor() const { return m_desc; }
+
+		// The shader reads native swizzles: nothing to emulate (VK_DISABLE_COMPONENT_SWIZZLE is off).
+		u32 encoded_component_map() const { return 0; }
+
+		// The same view in another compatible format (hardware SNORM / sRGB conversion), or this view on failure.
+		image_view* as(pixel_format format);
+
+	private:
+		mtl::image* m_owner = nullptr;
+		object m_handle;
+		texture_view_descriptor m_desc{};
+		u32 m_aspect = aspect_color;
+		u64 m_key = 0;
+	};
+
+	class image
+	{
+	public:
+		object texture;
+		texture_type type = texture_type::type_2d;
+		pixel_format native_format = pixel_format::invalid;
+		u32 texture_width = 0;    // texture size (resolution scale applied for surfaces)
+		u32 texture_height = 0;
+		u32 texture_depth = 1;
+		u32 mip_count = 1;
+		u32 layer_count = 1;
+		u8 sample_count = 1;
+		u32 usage = usage_shader_read;
+		rsx::format_class image_format_class = rsx::RSX_FORMAT_CLASS_COLOR;
+		component_map native_component_map = default_component_map;
+		std::string debug_name;
+
+		image() = default;
+		virtual ~image();
+
+		image(const image&) = delete;
+		image& operator=(const image&) = delete;
+
+		// Allocates the texture (private storage) and makes it resident. False on failure (counted, logged).
+		bool create(command_context& ctx, const texture_descriptor& desc, rsx::format_class format_class);
+
+		u32 width() const { return texture_width; }
+		u32 height() const { return texture_height; }
+		u32 depth() const { return texture_depth; }
+		u32 mipmaps() const { return mip_count; }
+		u32 layers() const { return layer_count; }
+		u8 samples() const { return sample_count; }
+		pixel_format format() const { return native_format; }
+		rsx::format_class format_class() const { return image_format_class; }
+		u32 aspect() const;
+		bool is_depth() const { return is_depth_format(native_format); }
+		bool has_stencil_aspect() const { return has_stencil(native_format); }
+
+		// A view with the RSX remap applied over the native component layout (viewable_image::get_view).
+		image_view* get_view(const rsx::texture_channel_remap_t& remap, u32 aspect_mask = aspect_color | aspect_depth);
+		// A view with an explicit format and swizzle (cached by key).
+		image_view* get_view(pixel_format format, const component_map& swizzle, u32 aspect, u64 key);
+
+		void set_native_component_layout(const component_map& layout);
+		const component_map& get_native_component_layout() const { return native_component_map; }
+		void set_name(const std::string& name) { debug_name = name; }
+
+		// The texture type a view of the whole image uses.
+		texture_type view_type() const { return type; }
+
+	protected:
+		void release_views();
+
+	private:
+		std::unordered_map<u64, std::unique_ptr<image_view>> m_views;
+		image_view* m_last_view = nullptr;
+		u64 m_last_view_key = 0;
+	};
+
+	// Uploads guest subresources (rsx::get_subresources_layout) into an image, in the compute encoder of ctx.
+	// The upload ring may make room by submitting: the caller must not hold an encoder across this call.
+	void upload_image(command_context& ctx, data_heap& heap, image* dst, const std::vector<rsx::subresource_layout>& layouts,
+		u32 gcm_format, bool is_swizzled, bool supports_bc);
+
+	// Clears every level and slice: colour images to zero (buffer copy), depth images to depth 1, stencil 0.
+	void clear_image(command_context& ctx, data_heap& heap, image* dst);
+
+	// Staging memory for a transfer: the ring, or a dedicated shared buffer released after the submission.
+	struct staging_allocation
+	{
+		object buffer;
+		u64 offset = 0;
+		u8* data = nullptr;
+	};
+
+	staging_allocation allocate_staging(command_context& ctx, data_heap& heap, u64 size);
