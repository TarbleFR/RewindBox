+	void test_component_orders()
+	{
+		const auto identity = rsx::default_remap_vector;
+		mtl::component_map out{};
+
+		// ARGB8 in BGRA8: the view reads R, G, B, A (VK: { R, G, B, A }).
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_A8R8G8B8, 0, identity, out));
+		CHECK((out == mtl::component_map{ R, G, B, A }));
+
+		// B8 -> R8: { 1, R, R, R } in ARGB order -> RGBA { R, R, R, 1 }.
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_B8, 0, identity, out));
+		CHECK((out == mtl::component_map{ R, R, R, ONE }));
+
+		// G8B8 -> RG8: { G, R, G, R } -> { R, G, R, G }.
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_G8B8, 0, identity, out));
+		CHECK((out == mtl::component_map{ R, G, R, G }));
+
+		// A4R4G4B4 -> ABGR4: { R, G, B, A } -> { G, B, A, R }.
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_A4R4G4B4, 0, identity, out));
+		CHECK((out == mtl::component_map{ G, B, A, R }));
+
+		// X16: { R, 1, R, 1 } -> { 1, R, 1, R }.
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_X16, 0, identity, out));
+		CHECK((out == mtl::component_map{ ONE, R, ONE, R }));
+
+		// Depth: R everywhere, whatever the order.
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_DEPTH24_D8, 2, identity, out));
+		CHECK((out == mtl::component_map{ R, R, R, R }));
+
+		// Native and swapped native orders (blit engine and framebuffer views).
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_A8R8G8B8, 1, identity, out));
+		CHECK((out == mtl::component_map{ R, G, B, A }));
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_A8R8G8B8, 2, identity, out));
+		CHECK((out == mtl::component_map{ A, R, G, B }));
+
+		// An RSX remap of ARGB8: out.A = in.B, out.R = in.G, out.G = in.R, out.B = in.A (selectors 3, 2, 1, 0 in A,R,G,B
+		// order), all REMAP controls (2 per channel: 0xAA). The view must read B, G, R in R, G, B and A in B... in
+		// RGBA terms: R <- G, G <- R, B <- A, A <- B.
+		const u32 encoded = (3u << 0) | (2u << 2) | (1u << 4) | (0u << 6) | (0xAAu << 8);
+		const auto remap = remap_from(encoded);
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_A8R8G8B8, 0, remap, out));
+		CHECK((out == mtl::component_map{ G, R, A, B }));
+
+		// ZERO / ONE controls: A forced to 1, R forced to 0 (control 1 = ZERO, 0 = ONE in RSX encoding? use decode).
+		const u32 forced = (0u << 0) | (1u << 2) | (2u << 4) | (3u << 6) | ((1u << 0) | (0u << 2) | (2u << 4) | (2u << 6)) << 8;
+		const auto remap2 = remap_from(forced);
+		CHECK(mtl::apply_component_mapping_flags(CELL_GCM_TEXTURE_A8R8G8B8, 0, remap2, out));
+		const auto expected = remap2.remap(mtl::argb_map{ A, R, G, B }, ZERO, ONE);
+		CHECK((out == mtl::component_map{ expected[1], expected[2], expected[3], expected[0] }));
+
+		// View swizzles over a native layout (viewable_image::get_view).
+		const mtl::component_map native{ R, R, R, ONE };   // B8
+		CHECK((mtl::view_swizzle(native, identity) == native));
+		CHECK((mtl::view_swizzle(native, identity.with_encoding(mtl::remap_identity_raw)) == mtl::default_component_map));
+		const auto remapped = mtl::view_swizzle(native, remap);
+		const auto expected3 = remap.remap(mtl::argb_map{ ONE, R, R, R }, ZERO, ONE);
+		CHECK((remapped == mtl::component_map{ expected3[1], expected3[2], expected3[3], expected3[0] }));
+
+		// View keys: raw identity on an identity layout shares the RSX identity view; formats and aspects differ.
+		CHECK(mtl::view_key(mtl::default_component_map, identity.with_encoding(mtl::remap_identity_raw), 1, pixel_format::bgra8_unorm) ==
+			mtl::view_key(mtl::default_component_map, identity, 1, pixel_format::bgra8_unorm));
+		CHECK(mtl::view_key(native, identity.with_encoding(mtl::remap_identity_raw), 1, pixel_format::r8_unorm) !=
+			mtl::view_key(native, identity, 1, pixel_format::r8_unorm));
+		CHECK(mtl::view_key(native, identity, 1, pixel_format::r8_unorm) != mtl::view_key(native, identity, 1, pixel_format::r8_snorm));
+		CHECK(mtl::view_key(native, identity, 2, pixel_format::r8_unorm) != mtl::view_key(native, identity, 4, pixel_format::r8_unorm));
+	}
+
+	void test_format_properties()
+	{
+		// VK bitcast rules: same guest texel width and same byte order transform.
+		CHECK(mtl::formats_are_bitcast_compatible(pixel_format::bgra8_unorm, pixel_format::rgba8_unorm));
+		CHECK(mtl::formats_are_bitcast_compatible(pixel_format::bgra8_unorm, pixel_format::r32_float));
+		CHECK(!mtl::formats_are_bitcast_compatible(pixel_format::bgra8_unorm, pixel_format::rg16_unorm));   // swap 4 vs swap 2
+		CHECK(!mtl::formats_are_bitcast_compatible(pixel_format::rgba16_float, pixel_format::rg16_float));  // 8 vs 4 bytes
+		CHECK(mtl::formats_are_bitcast_compatible(pixel_format::rg16_unorm, pixel_format::rg16_float));
+		CHECK(!mtl::formats_are_bitcast_compatible(pixel_format::r8_unorm, pixel_format::rg8_unorm));
+		// Depth-float data only matches the same class (RSX_FORMAT_CLASS_DEPTH24_FLOAT_X8_PACK32 = 16, UNORM = 8).
+		CHECK(!mtl::images_are_bitcast_compatible(pixel_format::depth32_float_stencil8, 16, pixel_format::depth32_float_stencil8, 8));
+		CHECK(mtl::images_are_bitcast_compatible(pixel_format::depth32_float_stencil8, 8, pixel_format::bgra8_unorm, 1));
+
+		CHECK(mtl::get_format_element_size(pixel_format::rgba16_float).first == 2);
+		CHECK(mtl::get_format_element_size(pixel_format::bgra8_unorm).first == 4);
+		CHECK(mtl::get_format_element_size(pixel_format::r8_unorm).first == 1);
+		CHECK(mtl::get_format_texel_width(pixel_format::depth32_float) == 2);          // stands for 16-bit guest depth
+		CHECK(mtl::get_format_texel_width(pixel_format::depth32_float_stencil8) == 4);
+
+		CHECK(mtl::get_compatible_srgb_format(pixel_format::bgra8_unorm) == pixel_format::bgra8_unorm_srgb);
+		CHECK(mtl::get_compatible_srgb_format(pixel_format::bc1_rgba) == pixel_format::bc1_rgba_srgb);
+		CHECK(mtl::get_compatible_srgb_format(pixel_format::r8_unorm) == pixel_format::invalid);
+		CHECK(mtl::get_compatible_snorm_format(pixel_format::rg8_unorm) == pixel_format::rg8_snorm);
+		CHECK(mtl::get_compatible_snorm_format(pixel_format::bgra8_unorm) == pixel_format::invalid);   // no BGRA8Snorm in Metal
+
+		CHECK(mtl::render_target_format_is_compatible(pixel_format::bgra8_unorm, CELL_GCM_TEXTURE_A8R8G8B8));
+		CHECK(mtl::render_target_format_is_compatible(pixel_format::depth32_float_stencil8, CELL_GCM_TEXTURE_A8R8G8B8));
+		CHECK(mtl::render_target_format_is_compatible(pixel_format::depth32_float_stencil8, CELL_GCM_TEXTURE_DEPTH24_D8));
+		CHECK(!mtl::render_target_format_is_compatible(pixel_format::rgba8_unorm, CELL_GCM_TEXTURE_A8R8G8B8));
+		CHECK(mtl::render_target_format_is_compatible(pixel_format::depth32_float, CELL_GCM_TEXTURE_DEPTH16_FLOAT));
+		CHECK(!mtl::render_target_format_is_compatible(pixel_format::bgra8_unorm, CELL_GCM_TEXTURE_COMPRESSED_DXT1));
+	}
+
+	void test_depth_conversions()
+	{
+		CHECK(mtl::d24_to_f32(0) == 0.f);
+		CHECK(mtl::d24_to_f32(0xffffff) == 1.f);
+		CHECK(mtl::f32_to_d24(1.f) == 0xffffff);
+		CHECK(mtl::f32_to_d24(0.f) == 0);
+		// Every unorm value that survives the float round trip exactly does so for a dense sample.
+		u32 mismatches = 0;
+		for (u32 v = 0; v <= 0xffffff; v += 4093)
+		{
+			if (mtl::f32_to_d24(mtl::d24_to_f32(v)) != v && mtl::f32_to_d24(mtl::d24_to_f32(v)) + 1 != v)
+			{
+				mismatches++;
+			}
+		}
+		CHECK(mismatches == 0);
+
+		// Float depth: 24-bit pattern <-> f32 bits (shift by 7), exact both ways.
+		for (u32 v : { 0u, 1u, 0x123456u, 0x7fffffu, 0xffffffu })
+		{
+			CHECK(mtl::f32_bits_to_d24f(mtl::d24f_to_f32_bits(v)) == v);
+		}
+
+		// e4m12: 16-bit pattern <-> f32 bits, exact both ways.
+		for (u32 v = 0; v <= 0xffff; ++v)
+		{
+			if (mtl::f32_bits_to_e4m12(mtl::e4m12_to_f32_bits(static_cast<u16>(v))) != v)
+			{
+				mismatches++;
+			}
+		}
+		CHECK(mismatches == 0);
+		CHECK(std::bit_cast<f32>(mtl::e4m12_to_f32_bits(0)) == std::bit_cast<f32>(120u << 23));
+	}
+
+	void test_samplers()
+	{
+		using rsx::texture_minify_filter;
+		CHECK(mtl::get_min_filter(texture_minify_filter::linear_linear).filter == mtl::sampler_min_mag_filter::linear);
+		CHECK(mtl::get_min_filter(texture_minify_filter::linear_linear).mip == mtl::sampler_mip_filter::linear);
+		CHECK(mtl::get_min_filter(texture_minify_filter::linear_linear).sample_mipmaps);
+		CHECK(!mtl::get_min_filter(texture_minify_filter::linear).sample_mipmaps);
+		CHECK(mtl::get_min_filter(texture_minify_filter::nearest_linear).mip == mtl::sampler_mip_filter::linear);
+		CHECK(mtl::get_min_filter(texture_minify_filter::convolution_min).filter == mtl::sampler_min_mag_filter::linear);
+		CHECK(mtl::get_mag_filter(rsx::texture_magnify_filter::convolution_mag) == mtl::sampler_min_mag_filter::linear);
+
+		CHECK(mtl::get_wrap_mode(rsx::texture_wrap_mode::wrap) == mtl::sampler_address_mode::repeat);
+		CHECK(mtl::get_wrap_mode(rsx::texture_wrap_mode::mirror) == mtl::sampler_address_mode::mirror_repeat);
+		CHECK(mtl::get_wrap_mode(rsx::texture_wrap_mode::clamp) == mtl::sampler_address_mode::clamp_to_edge);
+		CHECK(mtl::get_wrap_mode(rsx::texture_wrap_mode::border) == mtl::sampler_address_mode::clamp_to_border_color);
+		CHECK(mtl::get_wrap_mode(rsx::texture_wrap_mode::mirror_once_border) == mtl::sampler_address_mode::mirror_clamp_to_edge);
+
+		CHECK(mtl::get_max_anisotropy(rsx::texture_max_anisotropy::x16) == 16);
+		CHECK(mtl::get_max_anisotropy(rsx::texture_max_anisotropy::x6) == 6);
+
+		// Shadow compares are reversed (VK get_compare_func(op, true)).
+		CHECK(mtl::get_compare_func(rsx::comparison_function::less, true) == mtl::compare_function::greater);
+		CHECK(mtl::get_compare_func(rsx::comparison_function::greater_or_equal, true) == mtl::compare_function::less_equal);
+		CHECK(mtl::get_compare_func(rsx::comparison_function::equal, true) == mtl::compare_function::equal);
+
+		bool exact = false;
+		CHECK(mtl::get_border_color(color4f(0.f, 0.f, 0.f, 0.f), exact) == mtl::sampler_border_color::transparent_black && exact);
+		CHECK(mtl::get_border_color(color4f(1.f, 1.f, 1.f, 1.f), exact) == mtl::sampler_border_color::opaque_white && exact);
+		CHECK(mtl::get_border_color(color4f(0.f, 0.f, 0.f, 1.f), exact) == mtl::sampler_border_color::opaque_black && exact);
+		CHECK(mtl::get_border_color(color4f(0.9f, 0.9f, 0.9f, 0.f), exact) == mtl::sampler_border_color::opaque_white && !exact);
+		CHECK(mtl::get_border_color(color4f(0.1f, 0.2f, 0.1f, 0.8f), exact) == mtl::sampler_border_color::opaque_black && !exact);
+
+		// Sampler keys: every field takes part.
+		mtl::sampler_descriptor base{};
+		std::set<std::pair<u64, u64>> keys;
+		const auto add = [&](const mtl::sampler_descriptor& d) { const auto k = mtl::make_sampler_key(d); keys.insert({ k.lo, k.hi }); };
+		add(base);
+		auto d = base; d.min_filter = mtl::sampler_min_mag_filter::linear; add(d);
+		d = base; d.mag_filter = mtl::sampler_min_mag_filter::linear; add(d);
+		d = base; d.mip_filter = mtl::sampler_mip_filter::linear; add(d);
+		d = base; d.address_s = mtl::sampler_address_mode::repeat; add(d);
+		d = base; d.address_t = mtl::sampler_address_mode::repeat; add(d);
+		d = base; d.address_r = mtl::sampler_address_mode::repeat; add(d);
+		d = base; d.border = mtl::sampler_border_color::opaque_white; add(d);
+		d = base; d.compare_enabled = true; add(d);
+		d = base; d.compare_enabled = true; d.compare = mtl::compare_function::less; add(d);
+		d = base; d.max_anisotropy = 16; add(d);
+		d = base; d.lod_min = 1.f; add(d);
+		d = base; d.lod_max = 2.f; add(d);
+		d = base; d.lod_bias = 0.5f; add(d);
+		d = base; d.normalized_coordinates = false; add(d);
+		CHECK(keys.size() == 15);
+		CHECK(mtl::make_sampler_key(base) == mtl::make_sampler_key(mtl::sampler_descriptor{}));
+		CHECK(mtl::sampler_key_hash{}(mtl::make_sampler_key(base)) == mtl::sampler_key_hash{}(mtl::make_sampler_key(mtl::sampler_descriptor{})));
+
+		// Metal's limits on unnormalized coordinates.
+		d = base;
+		d.normalized_coordinates = false;
+		d.address_s = mtl::sampler_address_mode::repeat;
+		d.mip_filter = mtl::sampler_mip_filter::nearest;
+		d.max_anisotropy = 4;
+		CHECK(mtl::sanitize_unnormalized_sampler(d) == 3);
+		CHECK(d.address_s == mtl::sampler_address_mode::clamp_to_edge && d.mip_filter == mtl::sampler_mip_filter::not_mipmapped && d.max_anisotropy == 1);
+		d = base;
+		CHECK(mtl::sanitize_unnormalized_sampler(d) == 0);
+	}
+}
+
+int main()
+{
+	test_sampler_formats();
+	test_component_orders();
+	test_format_properties();
+	test_depth_conversions();
+	test_samplers();
+
+	if (g_failures)
+	{
+		std::fprintf(stderr, "%d of %d checks failed\n", g_failures, g_checks);
+		return 1;
+	}
+
+	std::printf("PASS: Metal texture formats, component orders and samplers (%d checks)\n", g_checks);
+	return 0;
+}
