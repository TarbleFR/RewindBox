+namespace mtl
+{
+	namespace
+	{
+		constexpr u32 swap32(u32 v)
+		{
+			return (v >> 24) | ((v >> 8) & 0xff00u) | ((v << 8) & 0xff0000u) | (v << 24);
+		}
+
+		template <typename T>
+		void byteswap_elements(u8* data, usz bytes)
+		{
+			for (usz offset = 0; offset + sizeof(T) <= bytes; offset += sizeof(T))
+			{
+				T value;
+				std::memcpy(&value, data + offset, sizeof(T));
+				if constexpr (sizeof(T) == 2)
+				{
+					value = static_cast<T>((value >> 8) | (value << 8));
+				}
+				else
+				{
+					value = swap32(value);
+				}
+				std::memcpy(data + offset, &value, sizeof(T));
+			}
+		}
+
+		u16 swap16(u16 value) { return static_cast<u16>((value >> 8) | (value << 8)); }
+	}
+
+	// cached_texture_section
+
+	void cached_texture_section::create(u16 w, u16 h, u16 depth_, u16 mipmaps_, mtl::image* image, u32 rsx_pitch_, bool managed, u32 gcm_format_, bool pack_swap_bytes)
+	{
+#ifdef RPCS3_IOS
+		// REWINDBOX_TEXTURE_LOOKUP_MEMO_660: image, dimensions, pitch, format and swizzle are written directly below.
+		ios_memo_changed();
+#endif
+		ensure(!exists() || !is_managed() || vram_texture == image);
+
+		if (vram_texture != image && !managed_texture && get_protection() == utils::protection::no)
+		{
+			// In-place image swap, still locked. Likely a color buffer that got rebound as depth buffer or vice-versa.
+			as_rtt(vram_texture)->on_swap_out();
+
+			if (!managed)
+			{
+				// Incoming is also an external resource, reference it immediately
+				as_rtt(image)->on_swap_in(is_locked());
+			}
+		}
+
+		vram_texture = image;
+		ensure(rsx_pitch_);
+
+		width = w;
+		height = h;
+		this->depth = depth_;
+		this->mipmaps = mipmaps_;
+		this->rsx_pitch = rsx_pitch_;
+		this->gcm_format = gcm_format_;
+		this->pack_unpack_swap_bytes = pack_swap_bytes;
+
+		if (managed)
+		{
+			managed_texture.reset(vram_texture);
+		}
+
+		if (auto rtt = try_as_rtt(image))
+		{
+			swizzled = (rtt->raster_type != rsx::surface_raster_type::linear);
+		}
+
+		if (synchronized)
+		{
+#ifdef RPCS3_IOS
+			// CELL560_DEFERRED_COMMIT: new GPU contents replace bytes nobody accessed.
+			this->drop_deferred_commit();
+#endif
+			// Even if we are managing the same vram section, we cannot guarantee contents are static
+			release_dma_resources();
+			synchronized = false;
+			flushed = false;
+			sync_timestamp = 0ull;
+		}
+
+		baseclass::on_section_resources_created();
+	}
+
+	void cached_texture_section::create(u16 w, u16 h, u16 depth_, u16 mipmaps_, mtl::image* image, u32 rsx_pitch_, bool managed, const mtl::render_target* surface)
+	{
+		const auto info = surface->is_depth_surface() ?
+			rsx::get_compatible_gcm_format(surface->get_surface_depth_format()) :
+			rsx::get_compatible_gcm_format(surface->get_surface_color_format());
+		create(w, h, depth_, mipmaps_, image, rsx_pitch_, managed, info.first, info.second);
+	}
+
+	void cached_texture_section::release_dma_resources()
+	{
+		if (m_download)
+		{
+			// A copy may still be writing it.
+			if (auto ctx = get_command_context())
+			{
+				ctx->dispose(std::move(m_download), true);
+			}
+			m_download.reset();
+			m_download_size = 0;
+		}
+
+		m_fence = 0;
+		m_converted = false;
+		m_mode = readback_mode::none;
+	}
+
+	void cached_texture_section::dma_abort()
+	{
+		// A reset after a bad prediction: the next sync, if any, records a new copy.
+		ensure(synchronized);
+		ensure(!flushed);
+		m_fence = 0;
+		m_converted = false;
+		m_mode = readback_mode::none;
+	}
+
+	void cached_texture_section::destroy()
+	{
+		if (!exists() && context != rsx::texture_upload_context::dma)
+		{
+			return;
+		}
+#ifdef RPCS3_IOS
+		ios_memo_changed(); // REWINDBOX_TEXTURE_LOOKUP_MEMO_660: the image and its views go
+#endif
+
+		m_tex_cache->on_section_destroyed(*this);
+
+		vram_texture = nullptr;
+		ensure(!managed_texture);
+		release_dma_resources();
+
+		baseclass::on_section_resources_destroyed();
+	}
+
+	image_view* cached_texture_section::get_view(const rsx::texture_channel_remap_t& remap)
+	{
+		ensure(vram_texture != nullptr);
+		return vram_texture->get_view(remap);
+	}
+
+	image_view* cached_texture_section::get_raw_view()
+	{
+		ensure(vram_texture != nullptr);
+		return vram_texture->get_view(rsx::default_remap_vector);
+	}
+
+	pixel_format cached_texture_section::get_format() const
+	{
+		if (context == rsx::texture_upload_context::dma)
+		{
+			return pixel_format::r32_uint;
+		}
+
+		ensure(vram_texture != nullptr);
+		return vram_texture->format();
+	}
+
+	void cached_texture_section::set_rsx_pitch(u32 pitch)
+	{
+		ensure(!is_locked());
+#ifdef RPCS3_IOS
+		ios_memo_changed(); // REWINDBOX_TEXTURE_LOOKUP_MEMO_660: read by pitch_compatible()
+#endif
+		rsx_pitch = pitch;
+	}
+
+	void cached_texture_section::sync_surface_memory(const rsx::simple_array<cached_texture_section*>& surfaces)
+	{
+		auto rtt = as_rtt(vram_texture);
+		rtt->sync_tag();
+
+		for (auto& surface : surfaces)
+		{
+			rtt->inherit_surface_contents(as_rtt(surface->vram_texture));
+		}
