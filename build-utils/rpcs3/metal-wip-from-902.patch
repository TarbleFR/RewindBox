+			*sampler_state = m_texture_cache.upload_sampler_texture(m_commands, tex, m_rtts, validation_index,
+				rpcs3::ios::texture_lookup_memo::vertex_flag);
+		}
+		else
+		{
+			const auto validation_stamp = m_texture_cache.prepare_sampler_validation(validation_index);
+			*sampler_state = m_texture_cache.upload_texture(m_commands, tex, m_rtts);
+			m_texture_cache.finish_sampler_validation(validation_index, *sampler_state, validation_stamp, m_rtts);
+		}
+#else
+		*sampler_state = m_texture_cache.upload_texture(m_commands, tex, m_rtts);
+#endif
+
+		if (!sampler_state->validate())
+		{
+			if (!is_sampler_dirty && previous_shader_state.valid)
+			{
+				m_graphics_state |= rsx::vertex_program_state_dirty;
+			}
+			continue;
+		}
+
+		if (!is_sampler_dirty)
+		{
+			if (!previous_shader_state.matches_vertex(*sampler_state))
+			{
+				// Host details changed but RSX is not aware
+				m_graphics_state |= rsx::vertex_program_state_dirty;
+			}
+
+			if (m_vs_sampler_handles[i])
+			{
+				continue;
+			}
+		}
+
+		mtl::sampler_descriptor desc{};
+		desc.normalized_coordinates = !(tex.format() & CELL_GCM_TEXTURE_UN);
+		desc.lod_min = tex.min_lod();
+		desc.lod_max = tex.max_lod();
+		desc.address_s = mtl::get_wrap_mode(tex.wrap_s());
+		desc.address_t = mtl::get_wrap_mode(tex.wrap_t());
+		desc.address_r = mtl::sampler_address_mode::repeat;
+		desc.min_filter = desc.mag_filter = mtl::sampler_min_mag_filter::nearest;
+		desc.mip_filter = mtl::sampler_mip_filter::nearest;
+		desc.border = rsx::is_border_clamped_texture(tex) ? to_border(get_border_color(tex, false)) : mtl::sampler_border_color::opaque_black;
+		if (mtl::sanitize_unnormalized_sampler(desc))
+		{
+			tc.unnormalized_samplers_adjusted++;
+		}
+
+		const auto key = mtl::make_sampler_key(desc);
+		if (m_vs_sampler_handles[i] && m_vs_sampler_keys[i] == key)
+		{
+			continue;
+		}
+
+		m_vs_sampler_handles[i] = get_sampler(desc);
+		m_vs_sampler_keys[i] = key;
+	}
+
+	m_samplers_dirty.store(false);
+}
