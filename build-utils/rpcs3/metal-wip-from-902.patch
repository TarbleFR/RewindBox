+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the Metal Shading Language libraries of stage M4, compiled at runtime by the MTL4
+// compiler (MTLComputeTasks.cpp, MTLResolve.cpp). Header-only and free of renderer dependencies, so a host tool can
+// write them out for Apple's offline compiler (xcrun metal) and the host unit test can check their text.
+//
+// The arithmetic is MTLM4Math.h (the same tokens the unit test runs as C++). The kernels add what Vulkan gets from the
+// descriptor: every storage-buffer access is bounded by the bound range (`words`), as the Vulkan renderer's robust
+// buffer access bounds it; inside the range each kernel reads and writes exactly what the GLSL kernel does.
+
+#include "MTLM4Math.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+
+namespace mtl::m4_shaders
+{
+	constexpr std::string_view prelude =
+		"#include <metal_stdlib>\n"
+		"using namespace metal;\n\n";
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// Conversion kernels (VKCompute.h). Buffer 0: the data (uint words, bound at the task's data offset), buffer 1: the
+	// parameters, uint4 as the Vulkan push constants params[0] plus the bound length in words:
+	//   shuffles:    x = word count (data_length / 4), w = word count
+	//   interleave:  x = data_length (bytes), y = zeta offset (bytes), z = stencil offset (bytes), w = bound words
+	//   fconvert:    x = source length (bytes), y = source offset, z = destination offset (bytes), w = bound words
+	// The invocation index is ShuffleBytes.glsl linear_invocation_id() with KERNEL_SIZE 1 (MoltenVK's optimal kernel size).
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view compute_kernels = R"(
+inline uint m4_linear_invocation_id(uint3 global_id, uint3 grid_size)
+{
+	return (global_id.y * grid_size.x) + global_id.x;
+}
+
+inline uint m4_load(device uint* data, uint words, uint index)
+{
+	return (index < words) ? data[index] : 0u;
+}
+
+inline void m4_store(device uint* data, uint words, uint index, uint value)
+{
+	if (index < words)
+	{
+		data[index] = value;
+	}
+}
+
+inline void m4_atomic_or(device uint* data, uint words, uint index, uint value)
+{
+	if (index < words)
+	{
+		atomic_fetch_or_explicit((device atomic_uint*)(data + index), value, memory_order_relaxed);
+	}
+}
+
+#define M4_KERNEL_ARGS device uint* data [[buffer(0)]], constant uint4& params [[buffer(1)]], uint3 global_id [[thread_position_in_grid]], uint3 grid_size [[threads_per_grid]]
+
+// cs_shuffle_16, cs_shuffle_32, cs_shuffle_32_16, cs_shuffle_d24x8_f32, cs_shuffle_se_f32_d24x8, cs_shuffle_se_d24x8:
+// value = data[index]; data[index] = f(value);
+#define M4_SHUFFLE_KERNEL(name, function) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= params.x) return; \
+	const uint value = m4_load(data, params.w, index); \
+	m4_store(data, params.w, index, function(value)); \
+}
+
+M4_SHUFFLE_KERNEL(m4_bswap_u16_kernel, m4_bswap_u16)
+M4_SHUFFLE_KERNEL(m4_bswap_u32_kernel, m4_bswap_u32)
+M4_SHUFFLE_KERNEL(m4_bswap_u16_u32_kernel, m4_bswap_u16_u32)
+M4_SHUFFLE_KERNEL(m4_d24x8_to_f32_kernel, m4_d24x8_to_f32)
+M4_SHUFFLE_KERNEL(m4_f32_to_d24x8_swapped_kernel, m4_f32_to_d24x8_swapped)
+M4_SHUFFLE_KERNEL(m4_d24x8_to_d24x8_swapped_kernel, m4_d24x8_to_d24x8_swapped)
+
+inline uint m4_identity(uint value)
+{
+	return value;
+}
+
+// cs_gather_d24x8<_SwapBytes>, cs_gather_d32x8<_SwapBytes, _DepthFloat>
+#define M4_GATHER_KERNEL(name, combine, store_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint z_offset = params.y >> 2; \
+	const uint s_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint depth_word = m4_load(data, params.w, index + z_offset); \
+	const uint stencil_word = m4_load(data, params.w, (index / 4) + s_offset); \
+	m4_store(data, params.w, index, store_transform(combine(depth_word, stencil_word, index))); \
+}
+
+M4_GATHER_KERNEL(m4_gather_d24x8_kernel, m4_gather_d24x8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d24x8_swapped_kernel, m4_gather_d24x8, m4_bswap_u32)
+M4_GATHER_KERNEL(m4_gather_d32x8_kernel, m4_gather_d32x8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d32x8_swapped_kernel, m4_gather_d32x8, m4_bswap_u32)
+M4_GATHER_KERNEL(m4_gather_d32fx8_kernel, m4_gather_d32fx8, m4_identity)
+M4_GATHER_KERNEL(m4_gather_d32fx8_swapped_kernel, m4_gather_d32fx8, m4_bswap_u32)
+
+// cs_scatter_d24x8, cs_scatter_d32x8<_DepthFloat>: the stencil words are expected cleared (atomicOr), as in Vulkan.
+#define M4_SCATTER_KERNEL(name, depth_function) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint z_offset = params.y >> 2; \
+	const uint s_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint value = m4_load(data, params.w, index); \
+	m4_store(data, params.w, index + z_offset, depth_function(value)); \
+	m4_atomic_or(data, params.w, (index / 4) + s_offset, m4_scatter_stencil(value, index)); \
+}
+
+M4_SCATTER_KERNEL(m4_scatter_d24x8_kernel, m4_scatter_d24)
+M4_SCATTER_KERNEL(m4_scatter_d32x8_kernel, m4_scatter_d32)
+M4_SCATTER_KERNEL(m4_scatter_d32fx8_kernel, m4_scatter_d32f)
+
+// cs_fconvert_task<f32, f16, _SwapSrc, _SwapDst>: two source words make one destination word.
+#define M4_CONTRACT_KERNEL(name, source_transform, destination_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint in_offset = params.y >> 2; \
+	const uint out_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint src_offset = (index * 2) + in_offset; \
+	const uint dst_offset = index + out_offset; \
+	const uint x = source_transform(m4_load(data, params.w, src_offset)); \
+	const uint y = source_transform(m4_load(data, params.w, src_offset + 1)); \
+	m4_store(data, params.w, dst_offset, destination_transform(m4_pack_e4m12_pack16(x, y))); \
+}
+
+M4_CONTRACT_KERNEL(m4_f32_to_f16_kernel, m4_identity, m4_identity)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_src_kernel, m4_bswap_u32, m4_identity)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_dst_kernel, m4_identity, m4_bswap_u16)
+M4_CONTRACT_KERNEL(m4_f32_to_f16_swap_both_kernel, m4_bswap_u32, m4_bswap_u16)
+
+// cs_fconvert_task<f16, f32, _SwapSrc, _SwapDst>: one source word makes two destination words.
+#define M4_EXPAND_KERNEL(name, source_transform, destination_transform) \
+kernel void name(M4_KERNEL_ARGS) \
+{ \
+	const uint block_length = params.x >> 2; \
+	const uint in_offset = params.y >> 2; \
+	const uint out_offset = params.z >> 2; \
+	const uint index = m4_linear_invocation_id(global_id, grid_size); \
+	if (index >= block_length) return; \
+	const uint src_offset = index + in_offset; \
+	const uint dst_offset = (index * 2) + out_offset; \
+	const uint x = source_transform(m4_load(data, params.w, src_offset)); \
+	m4_store(data, params.w, dst_offset, destination_transform(m4_unpack_e4m12_lo(x))); \
+	m4_store(data, params.w, dst_offset + 1, destination_transform(m4_unpack_e4m12_hi(x))); \
+}
+
+M4_EXPAND_KERNEL(m4_f16_to_f32_kernel, m4_identity, m4_identity)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_src_kernel, m4_bswap_u16, m4_identity)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_dst_kernel, m4_identity, m4_bswap_u32)
+M4_EXPAND_KERNEL(m4_f16_to_f32_swap_both_kernel, m4_bswap_u16, m4_bswap_u32)
+)";
+
+	// The kernels, in mtl::compute_kernel order (MTLComputeTasks.h).
+	constexpr std::array<std::string_view, 23> compute_kernel_names =
+	{
+		"m4_bswap_u16_kernel",
+		"m4_bswap_u32_kernel",
+		"m4_bswap_u16_u32_kernel",
+		"m4_d24x8_to_f32_kernel",
+		"m4_f32_to_d24x8_swapped_kernel",
+		"m4_d24x8_to_d24x8_swapped_kernel",
+		"m4_gather_d24x8_kernel",
+		"m4_gather_d24x8_swapped_kernel",
+		"m4_gather_d32x8_kernel",
+		"m4_gather_d32x8_swapped_kernel",
+		"m4_gather_d32fx8_kernel",
+		"m4_gather_d32fx8_swapped_kernel",
+		"m4_scatter_d24x8_kernel",
+		"m4_scatter_d32x8_kernel",
+		"m4_scatter_d32fx8_kernel",
+		"m4_f32_to_f16_kernel",
+		"m4_f32_to_f16_swap_src_kernel",
+		"m4_f32_to_f16_swap_dst_kernel",
+		"m4_f32_to_f16_swap_both_kernel",
+		"m4_f16_to_f32_kernel",
+		"m4_f16_to_f32_swap_src_kernel",
+		"m4_f16_to_f32_swap_dst_kernel",
+		"m4_f16_to_f32_swap_both_kernel",
+	};
+
+	inline std::string compute_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::bit_casts;
+		source += m4_source::conversion_math;
+		source += "\n";
+		source += compute_kernels;
+		return source;
+	}
+
+	// ---------------------------------------------------------------------------------------------------------------
+	// MSAA resolve and unresolve passes (VKResolveHelper, Program/MSAA). Every pass draws the 4-vertex strip of
+	// GenericVSPassthrough.glsl over the whole target; buffer 0 holds the Vulkan push constants (int2 sample_count).
+	// Resolve: each texel of the single-sampled image takes one sample of the multisampled image. Unresolve: each sample
+	// (the pass runs per sample through [[sample_id]], as the Vulkan pass at sample shading rate 1) takes one texel back.
+	// Colour passes are render passes here (Metal has no multisampled storage images): same coordinates, same samples.
+	// Depth and stencil go through the fragment depth and stencil exports (the _EXT passes; Apple GPUs export stencil).
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view resolve_passes = R"(
+struct m4_resolve_params
+{
+	int2 sample_count;
+	int stencil_mask;
+	int reserved;
+};
+
+struct m4_fullscreen_vertex
+{
+	float4 position [[position]];
+};
+
+constant float2 m4_passthrough_positions[4] = { float2(-1., -1.), float2(1., -1.), float2(-1., 1.), float2(1., 1.) };
+
+vertex m4_fullscreen_vertex m4_resolve_vertex(uint vertex_id [[vertex_id]])
+{
+	m4_fullscreen_vertex out;
+	out.position = float4(m4_passthrough_positions[vertex_id % 4], 0., 1.);
+	return out;
+}
+
+struct m4_depth_output
+{
+	float depth [[depth(any)]];
+};
+
+struct m4_depth_stencil_output
+{
+	float depth [[depth(any)]];
+	uint stencil [[stencil]];
+};
+
+inline uint2 m4_resolve_pixel(float4 position, int2 samples)
+{
+	const int2 out_coord = int2(position.xy);
+	return uint2(m4_resolve_source(out_coord.x, samples.x), m4_resolve_source(out_coord.y, samples.y));
+}
+
+inline uint m4_resolve_sample(float4 position, int2 samples)
+{
+	const int2 out_coord = int2(position.xy);
+	return uint(m4_resolve_sample_index(out_coord.x, out_coord.y, samples.x, samples.y));
+}
+
+inline uint2 m4_unresolve_texel(float4 position, uint sample_id, int2 samples)
+{
+	const int2 pixel_coord = int2(position.xy);
+	return uint2(m4_unresolve_target_x(pixel_coord.x, int(sample_id), samples.x),
+		m4_unresolve_target_y(pixel_coord.y, int(sample_id), samples.x, samples.y));
+}
+
+// ColorResolvePass.glsl
+fragment float4 m4_color_resolve(float4 position [[position]], texture2d_ms<float, access::read> multisampled [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	return multisampled.read(m4_resolve_pixel(position, params.sample_count), m4_resolve_sample(position, params.sample_count));
+}
+
+// ColorUnresolvePass.glsl
+fragment float4 m4_color_unresolve(float4 position [[position]], uint sample_id [[sample_id]], texture2d<float, access::read> resolve [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	return resolve.read(m4_unresolve_texel(position, sample_id, params.sample_count));
+}
+
+// DepthResolvePass.glsl
+fragment m4_depth_output m4_depth_resolve(float4 position [[position]], depth2d_ms<float, access::read> fs0 [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	m4_depth_output out;
+	out.depth = fs0.read(m4_resolve_pixel(position, params.sample_count), m4_resolve_sample(position, params.sample_count));
+	return out;
+}
+
+// DepthUnresolvePass.glsl
+fragment m4_depth_output m4_depth_unresolve(float4 position [[position]], uint sample_id [[sample_id]], depth2d<float, access::read> fs0 [[texture(0)]],
+	constant m4_resolve_params& params [[buffer(0)]])
+{
+	m4_depth_output out;
+	out.depth = fs0.read(m4_unresolve_texel(position, sample_id, params.sample_count));
+	return out;
+}
+
+// DepthStencilResolvePass.glsl
+fragment m4_depth_stencil_output m4_depth_stencil_resolve(float4 position [[position]], depth2d_ms<float, access::read> fs0 [[texture(0)]],
+	texture2d_ms<uint, access::read> fs1 [[texture(1)]], constant m4_resolve_params& params [[buffer(0)]])
+{
+	const uint2 in_coord = m4_resolve_pixel(position, params.sample_count);
+	const uint sample_index = m4_resolve_sample(position, params.sample_count);
+	m4_depth_stencil_output out;
+	out.depth = fs0.read(in_coord, sample_index);
+	out.stencil = fs1.read(in_coord, sample_index).x;
+	return out;
+}
+
+// DepthStencilUnresolvePass.glsl
+fragment m4_depth_stencil_output m4_depth_stencil_unresolve(float4 position [[position]], uint sample_id [[sample_id]],
+	depth2d<float, access::read> fs0 [[texture(0)]], texture2d<uint, access::read> fs1 [[texture(1)]], constant m4_resolve_params& params [[buffer(0)]])
+{
+	const uint2 pixel_coord = m4_unresolve_texel(position, sample_id, params.sample_count);
+	m4_depth_stencil_output out;
+	out.depth = fs0.read(pixel_coord);
+	out.stencil = fs1.read(pixel_coord).x;
+	return out;
+}
+)";
+
+	inline std::string resolve_library_source()
+	{
+		std::string source(prelude);
+		source += m4_source::resolve_math;
+		source += "\n";
+		source += resolve_passes;
+		return source;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h b/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h
new file mode 100644
index 0000000..2449a50
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlayShaders.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the GLSL of the native overlay pipeline (MTLOverlays.h) and its resource contract, for the
+// renderer and for the shader stack host test (GLSL -> SPIR-V -> MSL on the host, then Apple's offline compiler).
+//
+// The sources are the Vulkan renderer's (Program/GLSLSnippets/OverlayRenderVS.glsl, OverlayRenderFS.glsl) with its own
+// replacements (VKOverlays.cpp ui_overlay_renderer::ui_overlay_renderer), then the Metal resource adaptation: the vertex
+// attribute becomes the same 16-byte vertex read from a storage buffer at gl_VertexIndex, the fragment textures move to
+// the fragment descriptor set (MTLShaderTranslator slot contract). Nothing else changes.
+
+#include "MTLCommonDecompiler.h"
+
+#include "Utilities/StrFmt.h"
+#include "Utilities/StrUtil.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace mtl::overlay_shaders
+{
+	constexpr u32 vertex_push_constants_size = 68;    // VK ui_overlay_renderer::vertex_push_constants_size
+	constexpr u32 fragment_push_constants_size = 60;  // VK ui_overlay_renderer::fragment_push_constants_size
+	constexpr u32 push_constants_size = vertex_push_constants_size + fragment_push_constants_size;
+
+	inline constexpr std::string_view vertex_source =
+#include "Emu/RSX/Program/GLSLSnippets/OverlayRenderVS.glsl"
+		;
+
+	inline constexpr std::string_view fragment_source =
+#include "Emu/RSX/Program/GLSLSnippets/OverlayRenderFS.glsl"
+		;
+
+	// The Metal resource adaptation: exact declarations, each expected exactly once.
+	inline constexpr std::string_view vertex_attribute = "layout(location=0) in vec4 in_pos;";
+	inline constexpr std::string_view vertex_storage =
+		"layout(set=0, binding=0, std430) readonly buffer OverlayVertices { vec4 overlay_vertices[]; };\n"
+		"#define in_pos overlay_vertices[gl_VertexIndex]";
+	inline constexpr std::string_view fragment_texture_2d = "layout(set=0, binding=0) uniform sampler2D fs0;";
+	inline constexpr std::string_view fragment_texture_2d_metal = "layout(set=1, binding=0) uniform sampler2D fs0;";
+	inline constexpr std::string_view fragment_texture_array = "layout(set=0, binding=1) uniform sampler2DArray fs1;";
+	inline constexpr std::string_view fragment_texture_array_metal = "layout(set=1, binding=1) uniform sampler2DArray fs1;";
+
+	inline bool replace_once(std::string& text, std::string_view from, std::string_view to, std::string& error)
+	{
+		const usz position = text.find(from);
+		if (position == std::string::npos || text.find(from, position + 1) != std::string::npos)
+		{
+			error = fmt::format("the overlay shader source does not declare '%s' exactly once", from);
+			return false;
+		}
+
+		text.replace(position, from.size(), to);
+		return true;
+	}
+
+	// Empty with `error` set when a source no longer has the declarations the adaptation expects.
+	inline std::string vertex_glsl(std::string& error)
+	{
+		std::string source = fmt::replace_all(std::string(vertex_source),
+		{
+			{ "%preprocessor", "// %preprocessor" },
+			{ "%push_block", "push_constant" }
+		});
+
+		if (!replace_once(source, vertex_attribute, vertex_storage, error))
+		{
+			return {};
+		}
+		return source;
+	}
+
+	inline std::string fragment_glsl(std::string& error)
+	{
+		std::string source = fmt::replace_all(std::string(fragment_source),
+		{
+			{ "%preprocessor", "// %preprocessor" },
+			{ "%push_block_offset", "layout(offset=68)" },
+			{ "%push_block", "push_constant" }
+		});
+
+		if (!replace_once(source, fragment_texture_2d, fragment_texture_2d_metal, error) ||
+			!replace_once(source, fragment_texture_array, fragment_texture_array_metal, error))
+		{
+			return {};
+		}
+		return source;
+	}
+
+	// The resources the translator binds (MTLShaderTranslator.h): buffer 0 the vertices, the push constant block of both
+	// stages at push_constant_buffer_slot (68 bytes of vertex configuration, then the fragment's 60), fs0 / fs1 at texture
+	// slots 0 / 1 with samplers 0 / 1.
+	inline std::vector<glsl::program_input> vertex_inputs()
+	{
+		auto push = glsl::program_input::make(::glsl::glsl_vertex_program, "push_constants", glsl::input_type_push_constant,
+			glsl::binding_set_index_vertex, 0);
+		push.push_constant_size = vertex_push_constants_size;
+		return
+		{
+			glsl::program_input::make(::glsl::glsl_vertex_program, "overlay_vertices", glsl::input_type_storage_buffer,
+				glsl::binding_set_index_vertex, 0),
+			push,
+		};
+	}
+
+	inline std::vector<glsl::program_input> fragment_inputs()
+	{
+		auto push = glsl::program_input::make(::glsl::glsl_fragment_program, "push_constants", glsl::input_type_push_constant,
+			glsl::binding_set_index_fragment, 0);
+		push.push_constant_offset = vertex_push_constants_size;
+		push.push_constant_size = fragment_push_constants_size;
+		return
+		{
+			glsl::program_input::make(::glsl::glsl_fragment_program, "fs0", glsl::input_type_texture, glsl::binding_set_index_fragment, 0),
+			glsl::program_input::make(::glsl::glsl_fragment_program, "fs1", glsl::input_type_texture, glsl::binding_set_index_fragment, 1),
+			push,
+		};
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlays.cpp b/rpcs3/Emu/RSX/Metal/MTLOverlays.cpp
new file mode 100644
index 0000000..5cf8a14
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlays.cpp
@@ -0,0 +1,517 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M4): native overlays of the native Metal 4 renderer (VKOverlays.cpp ui_overlay_renderer).
+
+#include "stdafx.h"
+#include "MTLOverlays.h"
+#include "MTLOverlayShaders.h"
+
+#include "MTLCommandContext.h"
+#include "MTLCommonDecompiler.h"
+#include "MTLDataHeap.h"
+#include "MTLM4Counters.h"
+#include "MTLShaderTranslator.h"
+
+#include "Emu/Cell/timers.hpp"
+#include "Emu/RSX/Overlays/overlays.h"
+#include "Emu/RSX/Program/RSXOverlay.h"
+#include "Emu/RSX/Program/SPIRVCommon.h"
+
+#include <cstring>
+
+namespace mtl
+{
+	namespace
+	{
+		const resource_slot* find_slot(const std::vector<resource_slot>& slots, std::string_view name)
+		{
+			for (const auto& slot : slots)
+			{
+				if (slot.name == name)
+				{
+					return &slot;
+				}
+			}
+			return nullptr;
+		}
+
+		template <typename T>
+		void write_floats(std::array<f32, 32>& buffer, usz& position, const T& values)
+		{
+			for (const f32 value : values)
+			{
+				buffer[position++] = value;
+			}
+		}
+	}
+
+	bool ui_overlay_renderer::create(const object& device, const object& compiler, bool fast_math, std::string& error)
+	{
+		m_device = device;
+
+		const std::string vs = overlay_shaders::vertex_glsl(error);
+		const std::string fs = vs.empty() ? std::string{} : overlay_shaders::fragment_glsl(error);
+		if (vs.empty() || fs.empty())
+		{
+			return false;
+		}
+
+		std::vector<u32> vs_spirv, fs_spirv;
+		std::string vs_text = vs, fs_text = fs;
+		if (!spirv::compile_glsl_to_spv(vs_spirv, vs_text, ::glsl::glsl_vertex_program, ::glsl::glsl_rules_vulkan) ||
+			!spirv::compile_glsl_to_spv(fs_spirv, fs_text, ::glsl::glsl_fragment_program, ::glsl::glsl_rules_vulkan))
+		{
+			error = "glslang refused the overlay shaders";
+			return false;
+		}
+
+		translation_options vertex_options{};
+		const auto vertex = translate_spirv_to_msl(vs_spirv, shader_stage::vertex, overlay_shaders::vertex_inputs(), vertex_options);
+
+		translation_options fragment_options{};
+		fragment_options.depth_attachment = false;
+		fragment_options.stencil_attachment = false;
+		fragment_options.color_output_mask = 1;
+		const auto fragment = translate_spirv_to_msl(fs_spirv, shader_stage::fragment, overlay_shaders::fragment_inputs(), fragment_options);
+
+		if (!vertex.ok || !fragment.ok)
+		{
+			error = fmt::format("overlay shaders not translated: %s", !vertex.ok ? vertex.error : fragment.error);
+			return false;
+		}
+
+		const object vertex_library = compile_library(compiler, vertex.msl, { fast_math, vertex.position_invariant }, error);
+		const object fragment_library = vertex_library ? compile_library(compiler, fragment.msl, { fast_math, false }, error) : object{};
+		if (!vertex_library || !fragment_library)
+		{
+			return false;
+		}
+
+		const auto* vertices = find_slot(vertex.slots, "overlay_vertices");
+		const auto* fs0 = find_slot(fragment.slots, "fs0");
+		const auto* fs1 = find_slot(fragment.slots, "fs1");
+		if (!vertices || !fs0 || !fs1)
+		{
+			error = "overlay shader slots missing";
+			return false;
+		}
+
+		m_vertex_buffer_slot = vertices->buffer;
+		m_texture_slots = { fs0->texture, fs1->texture };
+		m_sampler_slots = { fs0->sampler, fs1->sampler };
+		m_vertex_constants_slot = push_constant_buffer_slot;
+		m_fragment_constants_slot = push_constant_buffer_slot;
+
+		// VK ui_overlay_renderer: one colour attachment, all channels written, blend (src_alpha, zero, 1 - src_alpha, one, add, add)
+		render_pipeline_descriptor desc{};
+		desc.vertex_library = vertex_library;
+		desc.fragment_library = fragment_library;
+		desc.vertex_function = vertex.entry_point;
+		desc.fragment_function = fragment.entry_point;
+		auto& color = desc.color[0];
+		color.format = pixel_format::bgra8_unorm;
+		color.blending = true;
+		color.source_rgb = blend_factor::source_alpha;
+		color.source_alpha = blend_factor::zero;
+		color.destination_rgb = blend_factor::one_minus_source_alpha;
+		color.destination_alpha = blend_factor::one;
+		color.rgb_operation = blend_operation::add;
+		color.alpha_operation = blend_operation::add;
+		color.write_mask = write_all;
+		desc.sample_count = 1;
+		desc.label = "RSX overlays";
+		m_pipeline = new_render_pipeline(compiler, desc, error);
+		if (!m_pipeline)
+		{
+			return false;
+		}
+
+		m_vertex_table = new_argument_table(device, max_buffer_slots, max_texture_slots, max_sampler_slots);
+		m_fragment_table = new_argument_table(device, max_buffer_slots, max_texture_slots, max_sampler_slots);
+
+		// VK overlay_pass::load_program: clamp to edge, linear (ui_overlay_renderer's filter), one level
+		sampler_descriptor sampler{};
+		sampler.min_filter = sampler_min_mag_filter::linear;
+		sampler.mag_filter = sampler_min_mag_filter::linear;
+		m_sampler = new_sampler(device, sampler);
+
+		// VK binds vk::null_image_view for both units when a command has no texture.
+		texture_descriptor null_desc{};
+		null_desc.format = pixel_format::bgra8_unorm;
+		null_desc.usage = usage_shader_read;
+		null_desc.storage = storage_mode::shared;
+		m_null_2d = new_texture(device, null_desc);
+		null_desc.type = texture_type::type_2d_array;
+		m_null_2d_array = new_texture(device, null_desc);
+
+		if (!m_vertex_table || !m_fragment_table || !m_sampler || !m_null_2d || !m_null_2d_array)
+		{
+			error = "overlay argument tables, sampler or null textures";
+			m_pipeline.reset();
+			return false;
+		}
+
+		const u32 zero = 0;
+		texture_replace_region(m_null_2d, {{0, 0, 0}, {1, 1, 1}}, 0, 0, &zero, 4, 4);
+		texture_replace_region(m_null_2d_array, {{0, 0, 0}, {1, 1, 1}}, 0, 0, &zero, 4, 4);
+		return true;
+	}
+
+	void ui_overlay_renderer::destroy(command_context& ctx)
+	{
+		for (auto* cache : { &m_resources, &m_fonts, &m_temp_images })
+		{
+			for (auto& [key, entry] : *cache)
+			{
+				ctx.dispose(std::move(entry.texture), true);
+			}
+			cache->clear();
+		}
+
+		m_draws.clear();
+		ctx.dispose(std::move(m_null_2d), true);
+		ctx.dispose(std::move(m_null_2d_array), true);
+		m_pipeline.reset();
+		m_vertex_table.reset();
+		m_fragment_table.reset();
+		m_sampler.reset();
+		m_ring_buffer.reset();
+		m_device.reset();
+		m_resources_loaded = false;
+	}
+
+	const ui_overlay_renderer::texture_entry& ui_overlay_renderer::upload(command_context& ctx, std::unordered_map<u64, texture_entry>& cache,
+		u64 key, u32 width, u32 height, u32 layers, bool font, const void* pixels, u32 owner_uid)
+	{
+		// VK upload_simple_texture: R8 for fonts, B8G8R8A8 for images (the shader reads .bgra), at least one texel; an
+		// image without data is uploaded as zeros.
+		auto& entry = cache[key];
+		if (entry.texture)
+		{
+			ctx.dispose(std::move(entry.texture), true);
+		}
+
+		const u32 upload_width = std::max(width, 1u);
+		const u32 upload_height = std::max(height, 1u);
+		const u32 upload_layers = std::max(layers, 1u);
+		const u32 pitch = font ? upload_width : upload_width * 4;
+		const usz layer_size = static_cast<usz>(pitch) * upload_height;
+
+		texture_descriptor desc{};
+		desc.type = upload_layers > 1 ? texture_type::type_2d_array : texture_type::type_2d;
+		desc.format = font ? pixel_format::r8_unorm : pixel_format::bgra8_unorm;
+		desc.width = upload_width;
+		desc.height = upload_height;
+		desc.array_length = upload_layers;
+		desc.usage = usage_shader_read;
+		desc.storage = storage_mode::shared;
+		entry.texture = new_texture(m_device, desc);
+		ensure(entry.texture, "Metal overlay texture");
+
+		std::vector<u8> zeros;
+		const u8* source = static_cast<const u8*>(pixels);
+		if (!source || !width || !height)
+		{
+			zeros.resize(layer_size * upload_layers);
+			source = zeros.data();
+		}
+
+		for (u32 layer = 0; layer < upload_layers; ++layer)
+		{
+			texture_replace_region(entry.texture, {{0, 0, 0}, {upload_width, upload_height, 1}}, 0, layer, source + layer * layer_size,
+				pitch, static_cast<u32>(layer_size));
+		}
+
+		ctx.make_resident(entry.texture);
+		entry.width = upload_width;
+		entry.height = upload_height;
+		entry.layers = upload_layers;
+		entry.owner_uid = owner_uid;
+		return entry;
+	}
+
+	void ui_overlay_renderer::load_resources(command_context& ctx)
+	{
+		// VK ui_overlay_renderer::init: the standard resources, keyed from 1 in load order (rsx::overlays::image_resource_id).
+		rsx::overlays::resource_config configuration;
+		configuration.load_files();
+
+		u64 storage_key = 1;
+		for (const auto& res : configuration.texture_raw_data)
+		{
+			upload(ctx, m_resources, storage_key++, res->w, res->h, 1, false, res->get_data(), umax);
+		}
+
+		configuration.free_resources();
+		m_resources_loaded = true;
+	}
+
+	void ui_overlay_renderer::remove_temp_resources(command_context& ctx, u32 uid)
+	{
+		for (auto it = m_temp_images.begin(); it != m_temp_images.end();)
+		{
+			if (it->second.owner_uid == uid)
+			{
+				ctx.dispose(std::move(it->second.texture), true);
+				it = m_temp_images.erase(it);
+				continue;
+			}
+			++it;
+		}
+	}
+
+	const ui_overlay_renderer::texture_entry* ui_overlay_renderer::find_font(command_context& ctx, const rsx::overlays::font* font)
+	{
+		const auto image_size = font->get_glyph_data_dimensions();
+		const u64 key = reinterpret_cast<u64>(font);
+
+		if (const auto found = m_fonts.find(key); found != m_fonts.end() && found->second.texture &&
+			found->second.width == image_size.width && found->second.height == image_size.height && found->second.layers == image_size.depth)
+		{
+			return &found->second;
+		}
+
+		const std::vector<u8>& bytes = font->get_glyph_data();
+		return &upload(ctx, m_fonts, key, image_size.width, image_size.height, image_size.depth, true, bytes.data(), umax);
+	}
+
+	const ui_overlay_renderer::texture_entry* ui_overlay_renderer::find_temp_image(command_context& ctx, const rsx::overlays::image_info_base* desc, u32 owner_uid)
+	{
+		const bool dirty = std::exchange(desc->dirty, false);
+		const u64 key = reinterpret_cast<u64>(desc);
+
+		if (const auto cached = m_temp_images.find(key); cached != m_temp_images.end() && cached->second.texture && !dirty)
+		{
+			return &cached->second;
+		}
+
+		// New or changed: a new texture (the previous one is released once the GPU no longer reads it).
+		return &upload(ctx, m_temp_images, key, desc->w, desc->h, 1, false, desc->get_data(), owner_uid);
+	}
+
+	void ui_overlay_renderer::prepare(command_context& ctx, data_heap& ring, const areau& viewport, u32 target_width, u32 target_height,
+		rsx::overlays::overlay& ui)
+	{
+		if (!m_pipeline)
+		{
+			// Not drawn (counted); the overlay's own state still advances as it would on the Vulkan renderer.
+			m4_count(get_m4_counters().overlay_failures);
+			ui.update(get_system_time());
+			return;
+		}
+
+		if (!m_resources_loaded)
+		{
+			load_resources(ctx);
+		}
+
+		m_ring_buffer = ring.buffer;
+
+		// VK ui_overlay_renderer::run
+		ui.set_render_viewport(
+			static_cast<u16>(std::min<u32>(viewport.width(), std::numeric_limits<u16>::max())),
+			static_cast<u16>(std::min<u32>(viewport.height(), std::numeric_limits<u16>::max())));
+		const color4f scale_offset(ui.get_virtual_width(), ui.get_virtual_height(), 1.f, 1.f);
+		const coordf view_area = { { static_cast<f32>(viewport.x1), static_cast<f32>(viewport.y1) }, { static_cast<f32>(viewport.width()), static_cast<f32>(viewport.height()) } };
+
+		std::array<object, 2> image_views{ m_null_2d, m_null_2d_array };
+
+		if (ui.status_flags & rsx::overlays::status_bits::invalidate_image_cache)
+		{
+			remove_temp_resources(ctx, ui.uid);
+			ui.status_flags.clear(rsx::overlays::status_bits::invalidate_image_cache);
+		}
+
+		// The viewport and scissor of overlay_pass::set_up_viewport, the scissor inside the target as Metal requires.
+		mtl::viewport area{ static_cast<f64>(viewport.x1), static_cast<f64>(viewport.y1), static_cast<f64>(viewport.width()), static_cast<f64>(viewport.height()), 0., 1. };
+		scissor_rect scissor{};
+		scissor.x = std::min(viewport.x1, target_width);
+		scissor.y = std::min(viewport.y1, target_height);
+		scissor.width = std::min(viewport.width(), target_width - scissor.x);
+		scissor.height = std::min(viewport.height(), target_height - scissor.y);
+
+		const auto compiled = ui.get_compiled();
+		for (const auto& command : compiled.draw_commands)
+		{
+			const u32 vertex_count = static_cast<u32>(command.verts.size());
+
+			auto texture_type = rsx::overlays::texture_sampling_mode::texture2D;
+			auto sdf_config = command.config.sdf_config;
+			sdf_config.transform(static_cast<areaf>(viewport), { scale_offset.x, scale_offset.y });
+
+			const texture_entry* source = nullptr;
+			switch (command.config.texture_ref)
+			{
+			case rsx::overlays::image_resource_id::game_icon:
+			case rsx::overlays::image_resource_id::backbuffer:
+				// TODO in the Vulkan renderer as well: drawn without a texture
+			case rsx::overlays::image_resource_id::none:
+				texture_type = rsx::overlays::texture_sampling_mode::none;
+				break;
+			case rsx::overlays::image_resource_id::font_file:
+				source = find_font(ctx, command.config.font_ref);
+				texture_type = source->layers == 1
+					? rsx::overlays::texture_sampling_mode::font2D
+					: rsx::overlays::texture_sampling_mode::font3D;
+				break;
+			case rsx::overlays::image_resource_id::raw_image:
+				source = find_temp_image(ctx, static_cast<const rsx::overlays::image_info_base*>(command.config.external_data_ref), ui.uid);
+				break;
+			default:
+				if (const auto found = m_resources.find(command.config.texture_ref); found != m_resources.end())
+				{
+					source = &found->second;
+				}
+				break;
+			}
+
+			if (source)
+			{
+				image_views[source->layers > 1 ? 1 : 0] = source->texture;
+			}
+
+			if (!vertex_count)
+			{
+				continue;
+			}
+
+			draw_item item{};
+			item.primitives = static_cast<u32>(command.config.primitives);
+			item.vertex_count = vertex_count;
+			item.textures = image_views;
+			item.area = area;
+			item.scissor = scissor;
+
+			// overlay_pass::upload_vertex_data
+			const usz vertex_bytes = static_cast<usz>(vertex_count) * sizeof(command.verts[0]);
+			static_assert(sizeof(command.verts[0]) == 16);
+			item.vertex_offset = ring.alloc<256>(vertex_bytes);
+			std::memcpy(ring.map(item.vertex_offset), command.verts.data(), vertex_bytes);
+
+			if (command.config.primitives == rsx::overlays::primitive_type::triangle_fan && vertex_count >= 3)
+			{
+				// Metal has no fans: the same triangles, (0, n, n + 1), as an index list.
+				item.index_count = (vertex_count - 2) * 3;
+				item.index_offset = ring.alloc<256>(static_cast<usz>(item.index_count) * sizeof(u16));
+				u16* indices = ring.map<u16>(item.index_offset);
+				for (u32 n = 1; n + 1 < vertex_count; ++n)
+				{
+					*indices++ = 0;
+					*indices++ = static_cast<u16>(n);
+					*indices++ = static_cast<u16>(n + 1);
+				}
+			}
+
+			// ui_overlay_renderer::update_uniforms, byte for byte
+			std::array<f32, 32> push{};
+			usz pos = 0;
+			write_floats(push, pos, scale_offset.rgba);
+			write_floats(push, pos, command.config.color.rgba);
+			push[pos++] = view_area.width;
+			push[pos++] = view_area.height;
+			push[pos++] = view_area.x;
+			push[pos++] = view_area.y;
+			push[pos++] = command.config.clip_rect.x1;
+			push[pos++] = command.config.clip_rect.y1;
+			push[pos++] = command.config.clip_rect.x2;
+			push[pos++] = command.config.clip_rect.y2;
+
+			rsx::overlays::vertex_options vert_opts{};
+			push[pos++] = std::bit_cast<f32>(vert_opts.disable_vertex_snap(command.config.disable_vertex_snap).get());
+			ensure(pos == overlay_shaders::vertex_push_constants_size / sizeof(f32));
+
+			rsx::overlays::fragment_options frag_opts{};
+			const u32 frag_config = frag_opts
+				.texture_mode(texture_type)
+				.clip_fragments(command.config.clip_region)
+				.pulse_glow(command.config.pulse_glow)
+				.set_sdf(sdf_config.func)
+				.get();
+
+			push[pos++] = std::bit_cast<f32>(frag_config);
+			push[pos++] = command.config.get_sinus_value();
+			push[pos++] = static_cast<f32>(command.config.blur_strength) * 0.01f;
+			push[pos++] = sdf_config.hx;
+			push[pos++] = sdf_config.hy;
+			push[pos++] = sdf_config.br;
+			push[pos++] = sdf_config.bw;
+			push[pos++] = sdf_config.cx;
+			push[pos++] = sdf_config.cy;
+			push[pos++] = 0.f;
+			push[pos++] = 0.f;
+			write_floats(push, pos, sdf_config.border_color.rgba);
+			ensure(pos == overlay_shaders::push_constants_size / sizeof(f32));
+
+			item.constants_offset = ring.alloc<256>(overlay_shaders::push_constants_size);
+			std::memcpy(ring.map(item.constants_offset), push.data(), overlay_shaders::push_constants_size);
+
+			m_draws.push_back(std::move(item));
+			m4_count(get_m4_counters().overlay_draws);
+		}
+
+		ui.update(get_system_time());
+		m4_count(get_m4_counters().overlay_views);
+	}
+
+	void ui_overlay_renderer::encode(const object& encoder)
+	{
+		if (m_draws.empty())
+		{
+			return;
+		}
+
+		set_render_pipeline(encoder, m_pipeline);
+		set_cull_mode(encoder, cull_mode::none);
+
+		for (const auto& item : m_draws)
+		{
+			set_viewport(encoder, item.area);
+			set_scissor(encoder, item.scissor);
+
+			table_set_buffer(m_vertex_table, m_ring_buffer, item.vertex_offset, m_vertex_buffer_slot);
+			table_set_buffer(m_vertex_table, m_ring_buffer, item.constants_offset, m_vertex_constants_slot);
+			table_set_buffer(m_fragment_table, m_ring_buffer, item.constants_offset, m_fragment_constants_slot);
+			for (u32 unit = 0; unit < 2; ++unit)
+			{
+				if (m_texture_slots[unit] != umax)
+				{
+					table_set_texture(m_fragment_table, item.textures[unit], m_texture_slots[unit]);
+				}
+				if (m_sampler_slots[unit] != umax)
+				{
+					table_set_sampler(m_fragment_table, m_sampler, m_sampler_slots[unit]);
+				}
+			}
+			set_argument_table(encoder, m_vertex_table, stage_vertex);
+			set_argument_table(encoder, m_fragment_table, stage_fragment);
+
+			switch (static_cast<rsx::overlays::primitive_type>(item.primitives))
+			{
+			case rsx::overlays::primitive_type::quad_list:
+				// VK ui_overlay_renderer::emit_geometry: quads as disjoint 4-vertex triangle strips
+				for (u32 first = 0; first + 4 <= item.vertex_count; first += 4)
+				{
+					draw_primitives(encoder, primitive_type::triangle_strip, first, 4);
+				}
+				break;
+			case rsx::overlays::primitive_type::triangle_strip:
+				draw_primitives(encoder, primitive_type::triangle_strip, 0, item.vertex_count);
+				break;
+			case rsx::overlays::primitive_type::line_list:
+				draw_primitives(encoder, primitive_type::line, 0, item.vertex_count);
+				break;
+			case rsx::overlays::primitive_type::line_strip:
+				draw_primitives(encoder, primitive_type::line_strip, 0, item.vertex_count);
+				break;
+			case rsx::overlays::primitive_type::triangle_fan:
+				if (item.index_count)
+				{
+					draw_indexed_primitives(encoder, primitive_type::triangle, item.index_count, index_type::uint16, m_ring_buffer,
+						item.index_offset, static_cast<u64>(item.index_count) * sizeof(u16));
+				}
+				break;
+			}
+		}
+
+		m_draws.clear();
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLOverlays.h b/rpcs3/Emu/RSX/Metal/MTLOverlays.h
new file mode 100644
index 0000000..499f9af
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLOverlays.h
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M4): the native interface (rsx::overlays: message, save data, trophy and OSK dialogs,
+// shader compilation notices, the performance overlay) drawn by the native Metal 4 renderer over the presented frame,
+// as VKOverlays.cpp ui_overlay_renderer draws it for the Vulkan renderer.
+//
+// The shaders are the Vulkan renderer's own (Program/GLSLSnippets/OverlayRenderVS.glsl and OverlayRenderFS.glsl),
+// compiled at runtime through the renderer's shader stack (glslang, then SPIRV-Cross with the RSX programs' options).
+// Only their resource declarations are adapted: the vertex attribute becomes a read of the same 16-byte vertices from a
+// storage buffer at gl_VertexIndex (Metal 4 pipelines here have no vertex descriptor), and the fragment textures move to
+// the fragment descriptor set of the translator's slot contract. The push constants keep their Vulkan byte layout
+// (68 bytes of vertex configuration, then 60 bytes of fragment configuration) in one block shared by both stages.
+//
+// The textures (font atlases, the standard icons, the images overlays pass) use a minimal local upload path, not the
+// texture cache: shared-storage textures written by the CPU when they are created. A changed image gets a new texture
+// (the previous one is released once the GPU is done with it), so no texture is rewritten while a frame may read it.
+
+#include "MTLAPI.h"
+
+#include "Utilities/geometry.h"
+
+#include <array>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+namespace rsx::overlays
+{
+	struct overlay;
+	class font;
+	struct image_info_base;
+}
+
+namespace mtl
+{
+	class command_context;
+	class data_heap;
+
+	class ui_overlay_renderer
+	{
+	public:
+		bool create(const object& device, const object& compiler, bool fast_math, std::string& error);
+		void destroy(command_context& ctx);
+		bool ready() const { return !!m_pipeline; }
+
+		// VKGSRender's frame-end cleanup: the images of overlays that were closed are released.
+		void remove_temp_resources(command_context& ctx, u32 uid);
+
+		// Prepares the draws of one overlay view (VK ui_overlay_renderer::run) into the ring, before the presentation pass
+		// is opened: the ring may then still make room by submitting.
+		void prepare(command_context& ctx, data_heap& ring, const areau& viewport, u32 target_width, u32 target_height,
+			rsx::overlays::overlay& ui);
+
+		// Encodes the prepared draws into the open presentation pass and forgets them.
+		void encode(const object& encoder);
+		void clear_prepared() { m_draws.clear(); }
+		bool has_prepared() const { return !m_draws.empty(); }
+
+	private:
+		struct texture_entry
+		{
+			object texture;
+			u32 width = 0, height = 0, layers = 0;
+			u32 owner_uid = umax;
+		};
+
+		struct draw_item
+		{
+			u32 primitives = 0;                  // rsx::overlays::primitive_type
+			u32 vertex_count = 0;
+			u64 vertex_offset = 0;               // in the ring
+			u64 index_offset = 0;                // triangle fans: 16-bit indices in the ring
+			u32 index_count = 0;
+			u64 constants_offset = 0;            // the push constant block in the ring
+			std::array<object, 2> textures{};   // fs0 (2D), fs1 (2D array)
+			viewport area{};
+			scissor_rect scissor{};
+		};
+
+		const texture_entry& upload(command_context& ctx, std::unordered_map<u64, texture_entry>& cache, u64 key, u32 width, u32 height,
+			u32 layers, bool font, const void* pixels, u32 owner_uid);
+		const texture_entry* find_font(command_context& ctx, const rsx::overlays::font* font);
+		const texture_entry* find_temp_image(command_context& ctx, const rsx::overlays::image_info_base* desc, u32 owner_uid);
+		void load_resources(command_context& ctx);
+
+		object m_device;
+		object m_pipeline;
+		object m_vertex_table;
+		object m_fragment_table;
+		object m_sampler;
+		object m_null_2d;
+		object m_null_2d_array;
+		object m_ring_buffer;                    // the ring the prepared draws point into
+		u32 m_vertex_buffer_slot = umax;
+		u32 m_vertex_constants_slot = umax;
+		u32 m_fragment_constants_slot = umax;
+		std::array<u32, 2> m_texture_slots{ umax, umax };
+		std::array<u32, 2> m_sampler_slots{ umax, umax };
+		bool m_resources_loaded = false;
+
+		std::unordered_map<u64, texture_entry> m_resources;    // standard icons (resource_config), by image_resource_id
+		std::unordered_map<u64, texture_entry> m_fonts;        // by font
+		std::unordered_map<u64, texture_entry> m_temp_images;  // by image_info_base, with the overlay that owns it
+		std::vector<draw_item> m_draws;
+	};
+}
