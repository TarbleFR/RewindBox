+void MTLGSRender::bind_textures()
+{
+	const auto& slots = *m_program;
+
+	const auto null_for = [&](rsx::texture_dimension_extended dimension) -> const mtl::object&
+	{
+		switch (dimension)
+		{
+		case rsx::texture_dimension_extended::texture_dimension_cubemap: return m_null_textures[2];
+		case rsx::texture_dimension_extended::texture_dimension_3d: return m_null_textures[3];
+		default: return m_null_textures[1];
+		}
+	};
+
+	for (u32 textures_ref = current_fp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		const u32 location = m_fragment_prog->binding_table.ftex_location[i];
+		if (location == umax)
+		{
+			break;
+		}
+
+		const auto view = m_fs_views[i];
+		const bool shadow = !!(current_fragment_program.texture_state.shadow_textures & (1 << i));
+		if (const u32 slot = slots.fragment_texture_slot(location); slot != umax)
+		{
+			mtl::table_set_texture(m_fragment_table, view ? view->handle() :
+				(shadow ? m_null_depth_texture : null_for(current_fragment_program.get_texture_dimension(i))), slot);
+		}
+		if (const u32 slot = slots.fragment_sampler_slot(location); slot != umax)
+		{
+			mtl::table_set_sampler(m_fragment_table, (view && m_fs_sampler_handles[i]) ? m_fs_sampler_handles[i] : m_null_sampler, slot);
+		}
+
+		if (current_fragment_program.texture_state.redirected_textures & (1 << i))
+		{
+			const u32 stencil_location = m_fragment_prog->binding_table.ftex_stencil_location[i];
+			if (const u32 slot = stencil_location != umax ? slots.fragment_texture_slot(stencil_location) : umax; slot != umax)
+			{
+				mtl::table_set_texture(m_fragment_table, m_fs_stencil_views[i] ? m_fs_stencil_views[i]->handle() : m_null_stencil_texture, slot);
+			}
+		}
+	}
+
+	for (u32 textures_ref = current_vp_metadata.referenced_textures_mask; textures_ref; textures_ref &= textures_ref - 1)
+	{
+		const auto i = std::countr_zero(textures_ref);
+		const u32 location = m_vertex_prog->binding_table.vtex_location[i];
+		if (location == umax)
+		{
+			break;
+		}
+
+		const auto view = m_vs_views[i];
+		if (const u32 slot = slots.vertex_texture_slot(location); slot != umax)
+		{
+			mtl::table_set_texture(m_vertex_table, view ? view->handle() : null_for(current_vertex_program.get_texture_dimension(i)), slot);
+		}
+		if (const u32 slot = slots.vertex_sampler_slot(location); slot != umax)
+		{
+			mtl::table_set_sampler(m_vertex_table, (view && m_vs_sampler_handles[i]) ? m_vs_sampler_handles[i] : m_null_sampler, slot);
+		}
+	}
+
+	if (current_fragment_program.ctrl & RSX_SHADER_CONTROL_EMULATE_DEPTH_COMPARE)
+	{
+		const u32 location = m_fragment_prog->binding_table.frag_depth_input_location;
+		if (const u32 slot = location != umax ? slots.fragment_texture_slot(location) : umax; slot != umax)
+		{
+			mtl::table_set_texture(m_fragment_table, m_frag_depth_view ? m_frag_depth_view->handle() : m_null_depth_texture, slot);
+		}
 	}
 }
 
