diff --git a/rpcs3/ios/IOSBo2RdrawFlushPatch940.h b/rpcs3/ios/IOSBo2RdrawFlushPatch940.h
new file mode 100644
index 0000000..8dcd972
--- /dev/null
+++ b/rpcs3/ios/IOSBo2RdrawFlushPatch940.h
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+// REWINDBOX_BO2_RDRAW_FLUSH_940: the cause of the Black Ops II multiplayer freeze, and the game-side fix.
+//
+// IPA 756, BLES01717 t6mp (PPU-fa8ffe9a...), freeze capture RPCS3-freeze-guest-1.bin (16 Nov 2026), read offline:
+// the RSX loops on a JUMP-to-self (JTS) at EA 0x385165c0 (I/O offset 0x084165c0; EA = offset + 0x30100000). That
+// block is the image of SPU5's local store (bytes 0x2f980..0x306ff, identical), written by the r_draw_lit SPU job.
+// The r_draw_* jobs end in this order: X pushes the entry {A,B,C,D} into the CellSyncLFQueue 0x2e1f400 (the request
+// to "r_shaderpatch_ps3", which later replaces the JTS at A with JUMP(A+4) and fills the 0xca holes), then copy, then
+// J writes the final JUMP of the block in local store, then F flushes the block to main memory (PUT, wait). When the
+// PPU Backend drains the queue and r_shaderpatch_ps3 runs between X and F, F's flush overwrites the release with the
+// JTS from local store: the RSX then waits forever. Rare, after minutes of play, as the maintainer reports it.
+//
+// The fix reorders the end of the four r_draw_* images (11 words each, 44 words): J, then F (flush and wait), then X
+// (push), then the copy of desc+0x20 to ctx+0x20 done inline (lqd/stqd), which was the copy call. The push is still
+// before the close of the block, as in the original. Each word is the one read in the capture; the replacement is
+// written only on that exact executable, at a fresh boot, and only if all 44 words hold their original value (all 44
+// already holding the replacement means a patch.yml or an earlier pass applied it). Any other content refuses the
+// whole patch and says so: a different executable or revision is never patched. Like every executable patch, a
+// savestate keeps the memory of the boot it was made from (state=savestate).
+namespace rpcs3::ios::bo2_rdraw_flush940
+{
+inline constexpr std::string_view executable = "PPU-fa8ffe9ae59bfa8575027c9a6ec5aab7fb0215ab";
+inline constexpr std::size_t words_per_image = 11;
+
+struct image
+{
+	std::string_view name;
+	std::uint32_t address; // guest address of the first word, in the executable's image
+	std::array<std::uint32_t, words_per_image> original;
+	std::array<std::uint32_t, words_per_image> replacement;
+};
+
+inline constexpr image images[] = {
+	{"r_draw_depth", 0x00b4605c,
+		{0x04002883, 0x40800084, 0x3304fd80, 0x04002883, 0x337c4d80, 0x1c080083, 0x3fe02804, 0x330b6800, 0x1c080083, 0x04002804, 0x330bbc80},
+		{0x1c080083, 0x3fe02804, 0x330b6a80, 0x04002804, 0x330bbf80, 0x04002883, 0x40800084, 0x3304fb00, 0x34010082, 0x2400a802, 0x4020007f}},
+	{"r_draw_lit", 0x00b062a4,
+		{0x04002883, 0x40800084, 0x33054980, 0x04002883, 0x337cd080, 0x1c080083, 0x3fe02804, 0x33151600, 0x1c080083, 0x04002804, 0x33156a80},
+		{0x1c080083, 0x3fe02804, 0x33151880, 0x04002804, 0x33156d80, 0x04002883, 0x40800084, 0x33054700, 0x34010082, 0x2400a802, 0x4020007f}},
+	{"r_draw_lit_bsp", 0x00b1ecf4,
+		{0x04002883, 0x40800084, 0x33049780, 0x04002883, 0x337cb680, 0x1c080083, 0x3fe02804, 0x33088b00, 0x1c080083, 0x04002804, 0x3308df80},
+		{0x1c080083, 0x3fe02804, 0x33088d80, 0x04002804, 0x3308e280, 0x04002883, 0x40800084, 0x33049500, 0x34010082, 0x2400a802, 0x4020007f}},
+	{"r_draw_lit_static_model", 0x00b31f2c,
+		{0x04002883, 0x40800084, 0x33048480, 0x04002883, 0x337cb680, 0x1c080083, 0x3fe02804, 0x33086c00, 0x1c080083, 0x04002804, 0x3308c080},
+		{0x1c080083, 0x3fe02804, 0x33086e80, 0x04002804, 0x3308c380, 0x04002883, 0x40800084, 0x33048200, 0x34010082, 0x2400a802, 0x4020007f}},
+};
+
+inline constexpr std::size_t word_count = std::size(images) * words_per_image;
+
+enum class outcome : std::uint8_t { applied, already_applied, refused_guard };
+
+constexpr const char* name(outcome o) noexcept
+{
+	return o == outcome::applied ? "applied" : o == outcome::already_applied ? "already_applied" : "refused_guard";
+}
+
+struct result
+{
+	outcome what = outcome::refused_guard;
+	std::uint32_t writes = 0;
+	std::uint32_t original_matches = 0;    // words holding their original value
+	std::uint32_t replacement_matches = 0; // words already holding their replacement
+	std::uint32_t first_mismatch = 0;      // address of the first word holding neither (0: none)
+	std::uint32_t first_mismatch_word = 0;
+};
+
+// `mapped(address, bytes)` says whether the range lies in the executable's image; read32/write32 take a guest
+// address and the host-order value of a big-endian word; `wrote(address)` is called for each word changed.
+template <typename Mapped, typename Read32, typename Write32, typename Wrote>
+result apply(Mapped&& mapped, Read32&& read32, Write32&& write32, Wrote&& wrote)
+{
+	result r;
+
+	for (const image& img : images)
+	{
+		if (!mapped(img.address, static_cast<std::uint32_t>(words_per_image * 4)))
+		{
+			r.first_mismatch = img.address;
+			return r;
+		}
+
+		for (std::size_t i = 0; i < words_per_image; i++)
+		{
+			const std::uint32_t address = img.address + static_cast<std::uint32_t>(i * 4);
+			const std::uint32_t word = read32(address);
+			const bool is_original = word == img.original[i];
+			const bool is_replacement = word == img.replacement[i];
+			r.original_matches += is_original;
+			r.replacement_matches += is_replacement;
+
+			if (!is_original && !is_replacement && !r.first_mismatch)
+			{
+				r.first_mismatch = address;
+				r.first_mismatch_word = word;
+			}
+		}
+	}
+
+	if (r.replacement_matches == word_count)
+	{
+		r.what = outcome::already_applied;
+		return r;
+	}
+
+	if (r.original_matches != word_count)
+	{
+		return r;
+	}
+
+	for (const image& img : images)
+	{
+		for (std::size_t i = 0; i < words_per_image; i++)
+		{
+			const std::uint32_t address = img.address + static_cast<std::uint32_t>(i * 4);
+			write32(address, img.replacement[i]);
+			wrote(address);
+			r.writes++;
+		}
+	}
+
+	r.what = outcome::applied;
+	return r;
+}
+} // namespace rpcs3::ios::bo2_rdraw_flush940
