diff --git a/rpcs3/ios/IOSWorkInterval940.h b/rpcs3/ios/IOSWorkInterval940.h
new file mode 100644
index 0000000..f9e7cc0
--- /dev/null
+++ b/rpcs3/ios/IOSWorkInterval940.h
@@ -0,0 +1,164 @@
+#pragma once
+
+// REWINDBOX_WORK_INTERVAL_PROBE_940 (thermal plan of IPA 756, 16 Nov 2026): can this app tell iOS when a frame must
+// be ready? The scheduler's performance controller (CLPC) takes per-interval start, finish and deadline from "work
+// intervals" (xnu bsd/sys/work_interval.h). With WORK_INTERVAL_FLAG_FINISH_AT_DEADLINE (0x40) it is asked for "just
+// enough performance to finish at the deadline and no sooner": the emulator knows the next PS3 VBLANK boundary, so it
+// could let early frames run at a lower clock instead of the maximum. The creation call is a private interface (not
+// in the public SDK), and whether iOS 27 lets a third-party app use it, and keeps the flag, is unknown. This probe
+// answers that once per process, on its own short-lived thread, before anything relies on it: it creates an interval,
+// reads its flags back, joins it, sends one notification, leaves and destroys it, for the variants 0x47 (joinable,
+// group, unrestricted, finish at deadline) and 0x07 (the same without the deadline flag). Nothing else uses the
+// interval; no emulation thread joins it. The symbols are looked up with dlsym: a missing one ends the probe.
+// One line: CONFIG_LAYERS part=deadline_probe status=ok|eperm|missing|error tries=<variant>:<call>=<ret>/<errno>,...
+// chosen=0x47|0x07|none.
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+#if defined(__APPLE__)
+#include <cerrno>
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#endif
+
+namespace rpcs3::ios::work_interval940
+{
+inline constexpr std::uint32_t flag_joinable = 0x1;
+inline constexpr std::uint32_t flag_group = 0x2;
+inline constexpr std::uint32_t flag_unrestricted = 0x4;
+inline constexpr std::uint32_t flag_finish_at_deadline = 0x40;
+
+#if defined(__APPLE__)
+struct api
+{
+	using handle = void*;
+	int (*create)(handle*, std::uint32_t) = nullptr;
+	int (*copy_port)(handle, mach_port_t*) = nullptr;
+	int (*get_flags_from_port)(mach_port_t, std::uint32_t*) = nullptr;
+	int (*join)(handle) = nullptr;
+	int (*leave)() = nullptr;
+	int (*notify)(handle, std::uint64_t, std::uint64_t, std::uint64_t, std::uint64_t, std::uint32_t) = nullptr;
+	int (*destroy)(handle) = nullptr;
+
+	bool load() noexcept
+	{
+		create = reinterpret_cast<decltype(create)>(dlsym(RTLD_DEFAULT, "work_interval_create"));
+		copy_port = reinterpret_cast<decltype(copy_port)>(dlsym(RTLD_DEFAULT, "work_interval_copy_port"));
+		get_flags_from_port = reinterpret_cast<decltype(get_flags_from_port)>(dlsym(RTLD_DEFAULT, "work_interval_get_flags_from_port"));
+		join = reinterpret_cast<decltype(join)>(dlsym(RTLD_DEFAULT, "work_interval_join"));
+		leave = reinterpret_cast<decltype(leave)>(dlsym(RTLD_DEFAULT, "work_interval_leave"));
+		notify = reinterpret_cast<decltype(notify)>(dlsym(RTLD_DEFAULT, "work_interval_notify"));
+		destroy = reinterpret_cast<decltype(destroy)>(dlsym(RTLD_DEFAULT, "work_interval_destroy"));
+		return create && copy_port && get_flags_from_port && join && leave && notify && destroy;
+	}
+};
+
+// One variant; appends "<variant>:create=r/e,flags=0x..,join=r/e,notify=r/e,leave=r/e,destroy=r/e" and returns
+// true if every call succeeded and the flags read back hold the deadline flag when it was asked for.
+inline bool try_variant(const api& wi, std::uint32_t flags, std::string& out, bool& eperm) noexcept
+{
+	char part[256];
+	const auto call = [&](const char* name, int ret) {
+		std::snprintf(part, sizeof(part), ",%s=%d/%d", name, ret, ret ? errno : 0);
+		out += part;
+		eperm = eperm || (ret && (errno == EPERM || errno == EACCES));
+		return ret == 0;
+	};
+
+	std::snprintf(part, sizeof(part), "%s0x%x:", out.empty() || out.back() == '=' ? "" : ";", flags);
+	out += part;
+	api::handle h = nullptr;
+	errno = 0;
+	const int created = wi.create(&h, flags);
+	std::snprintf(part, sizeof(part), "create=%d/%d", created, created ? errno : 0);
+	out += part;
+	if (created || !h)
+	{
+		eperm = eperm || (created && (errno == EPERM || errno == EACCES));
+		return false;
+	}
+
+	bool ok = true;
+	std::uint32_t got = 0;
+	mach_port_t port = MACH_PORT_NULL;
+	if (call("copy_port", wi.copy_port(h, &port)) && port != MACH_PORT_NULL)
+	{
+		ok = call("get_flags", wi.get_flags_from_port(port, &got)) && ok;
+		mach_port_deallocate(mach_task_self(), port);
+	}
+	else
+	{
+		ok = false;
+	}
+	std::snprintf(part, sizeof(part), ",flags=0x%x", got);
+	out += part;
+	if ((flags & flag_finish_at_deadline) && !(got & flag_finish_at_deadline))
+	{
+		ok = false;
+	}
+
+	if (call("join", wi.join(h)))
+	{
+		const std::uint64_t now = mach_absolute_time();
+		mach_timebase_info_data_t tb{};
+		mach_timebase_info(&tb);
+		// 1 ms in mach units (numer/denom converts mach units to ns).
+		const std::uint64_t ms = tb.numer ? 1'000'000ull * tb.denom / tb.numer : 24'000;
+		ok = call("notify", wi.notify(h, now - 2 * ms, now - ms, now + 14 * ms, now + 14 * ms, 0)) && ok;
+		ok = call("leave", wi.leave()) && ok;
+	}
+	else
+	{
+		ok = false;
+	}
+	ok = call("destroy", wi.destroy(h)) && ok;
+	return ok;
+}
+#endif
+
+// Runs the probe and returns the CONFIG_LAYERS line. Call it on a thread that may join and leave an interval: it
+// does both, and leaves before returning.
+inline std::string run_probe()
+{
+#if defined(__APPLE__)
+	api wi;
+	if (!wi.load())
+	{
+		return "CONFIG_LAYERS part=deadline_probe status=missing tries= chosen=none";
+	}
+
+	const std::uint32_t base = flag_joinable | flag_group | flag_unrestricted;
+	std::string tries;
+	bool eperm = false;
+	std::uint32_t chosen = 0;
+	for (const std::uint32_t flags : {base | flag_finish_at_deadline, base})
+	{
+		if (try_variant(wi, flags, tries, eperm) && !chosen)
+		{
+			chosen = flags;
+		}
+	}
+
+	mach_timebase_info_data_t tb{};
+	mach_timebase_info(&tb);
+	char head[160];
+	std::snprintf(head, sizeof(head), "CONFIG_LAYERS part=deadline_probe status=%s timebase=%u/%u tries=",
+		chosen ? "ok" : eperm ? "eperm" : "error", tb.numer, tb.denom);
+	char tail[48];
+	if (chosen)
+	{
+		std::snprintf(tail, sizeof(tail), " chosen=0x%x", chosen);
+	}
+	else
+	{
+		std::snprintf(tail, sizeof(tail), " chosen=none");
+	}
+	return std::string(head) + tries + tail;
+#else
+	return "CONFIG_LAYERS part=deadline_probe status=missing tries= chosen=none";
+#endif
+}
+} // namespace rpcs3::ios::work_interval940
