diff --git a/rpcs3/ios/IOSSpuNoopSpin.h b/rpcs3/ios/IOSSpuNoopSpin.h
new file mode 100644
index 0000000..4162bfa
--- /dev/null
+++ b/rpcs3/ios/IOSSpuNoopSpin.h
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_SPU_NOOP_SPIN_WAIT_627: Build 624 logs (PID 1893, Black Ops II). The six
+// CellSpursKernel threads take 5.0-5.3 cores in the menus and 3.3-4.0 in a match, on a
+// device with two performance cores, while they complete 5-7 million PUTLLC per 5 s
+// window with almost no failure (0-4,900) and SPUWAIT551 getllar_poll=0.
+// With Accurate SPU Reservations off, a PUTLLC that writes back the data it read returns
+// at the top of do_putllc() with raddr = 0, without touching the reservation. The next
+// GETLLAR then finds no reservation and takes the plain read path: everything RPCS3 has
+// against SPU polling (the spin detection, the passive wait on the reservation notifier,
+// SPU GETLLAR Busy Waiting Percentage, SPU Spin Timing) sits in the "raddr == addr"
+// branch and is never reached. The polling loop GETLLAR, no-op PUTLLC, GETLLAR runs at about
+// 4 us per round on every thread, on lines of the title's own job queues (FREEZE_DUMP:
+// 0x2e20880, 0x2e20c00, several lines per thread).
+//
+// A thread is polling once it has completed `streak_threshold` no-op PUTLLC in a row, each
+// within `spin_gap_ns` of the previous one, on lines that keep their reservation time. Real
+// progress does not always reach do_putllc(): with this setting's reservation mode the
+// recognised 16-byte atomics are inlined by the recompiler (putllc16_pattern) and PUTLLUC has
+// its own path. So the tracker keeps the last `polled_lines` lines with their times: a line
+// whose time moved, or one it has not seen, restarts the streak, and a loop over more lines
+// than that never reaches a wait.
+//
+// A polling thread's next no-op PUTLLC sleeps on the reservation notifier of the line before
+// it returns, for a bounded time that doubles from first_wait_ns to max_wait_ns, unless the
+// line already changed. The PUTLLC has stored nothing and its result is decided: the sleep is
+// what a host preemption of the SPU thread at that point would be, and the next GETLLAR reads
+// as usual. A wait that ends early restarts the streak. One that times out leaves
+// `rearm_rounds` rounds before the next one, and that spacing bounds the two costs left:
+// - A wrong guess: work the tracker cannot see, on a line it does not poll, in rounds shorter
+//   than spin_gap_ns. A 40 us round loses at most a third of its time, not five sixths.
+// - The wait is on one line of the loop, and direct reservation stores do not always notify
+//   (docs/PROJECT_RULES.md; the inlined PUTLLC16 notifies another word): the bound, not the
+//   notifier, is what ends it. One pass over the polled lines holds at most one wait, so a new
+//   job waits at most max_wait_ns more, plus the pass.
+// At max_wait_ns and 4.3 us per round a thread makes about 41,000 rounds per second instead of
+// 230,000 and uses about 18 % of a core. Model figures: the device decides.
+// The tracker lives in a thread_local of SPUThread.cpp (spu_thread's layout is a codegen
+// input), and process_mfc_cmd, the input of the reused full-queue harness, does not change.
+namespace rpcs3::ios::spu_noop_spin
+{
+inline constexpr std::uint32_t streak_threshold = 64;      // about 280 us of polling at 4.3 us per round
+inline constexpr std::uint32_t rearm_rounds = 8;           // rounds between two waits, at least polled_lines
+inline constexpr std::size_t polled_lines = 8;             // lines one polling loop can watch
+inline constexpr std::uint64_t spin_gap_ns = 50'000;       // a longer gap means real work ran in between
+inline constexpr std::uint64_t first_wait_ns = 20'000;
+inline constexpr std::uint64_t max_wait_ns = 160'000;
+
+class tracker
+{
+	struct polled_line
+	{
+		std::uint32_t addr = 0;
+		std::uint64_t rtime = 0;
+	};
+
+	std::array<polled_line, polled_lines> m_lines{};
+	std::size_t m_line_count = 0;
+	std::uint64_t m_last_tick = 0;
+	std::uint64_t m_wait_ns = first_wait_ns;
+	std::uint32_t m_streak = 0;
+
+	void restart() noexcept
+	{
+		m_streak = 0;
+		m_wait_ns = first_wait_ns;
+	}
+
+public:
+	// do_putllc(): a PUTLLC on `addr`, whose reservation time the thread read as `rtime`, wrote
+	// nothing back and completed at `now` (ticks).
+	void on_noop(std::uint64_t now, std::uint64_t gap_ticks, std::uint32_t addr, std::uint64_t rtime) noexcept
+	{
+		if (now - m_last_tick > gap_ticks)
+		{
+			restart();
+			m_line_count = 0;
+		}
+
+		m_last_tick = now;
+
+		for (std::size_t i = 0; i < m_line_count; i++)
+		{
+			if (m_lines[i].addr != addr)
+			{
+				continue;
+			}
+
+			if (m_lines[i].rtime != rtime)
+			{
+				m_lines[i].rtime = rtime; // somebody wrote it, possibly this thread with no PUTLLC seen here
+				restart();
+			}
+			else if (m_streak < streak_threshold)
+			{
+				m_streak++;
+			}
+
+			return;
+		}
+
+		// Not the loop of this streak, or not yet.
+		m_line_count = m_line_count < polled_lines ? m_line_count + 1 : 1;
+		m_lines[m_line_count - 1] = {addr, rtime};
+		restart();
+	}
+
+	// do_putllc(): a PUTLLC that changes data; the thread is working.
+	void on_progress() noexcept
+	{
+		restart();
+	}
+
+	// The thread is polling: wait now.
+	bool due() const noexcept
+	{
+		return m_streak >= streak_threshold;
+	}
+
+	// The bound of the wait about to start; the next one doubles it.
+	std::uint64_t next_wait_ns() noexcept
+	{
+		const std::uint64_t value = m_wait_ns;
+		m_wait_ns = value * 2 < max_wait_ns ? value * 2 : max_wait_ns;
+		return value;
+	}
+
+	// After the wait, at `now` (ticks): the sleep is not a gap. A wait that ended before half
+	// of its bound was woken by a write to the line, or never started: the thread polls again
+	// from the start. Otherwise it runs rearm_rounds rounds before the next wait.
+	void on_woken(std::uint64_t now, std::uint64_t waited_ns, std::uint64_t bound_ns) noexcept
+	{
+		m_last_tick = now;
+
+		if (waited_ns < bound_ns / 2)
+		{
+			restart();
+		}
+		else
+		{
+			m_streak = streak_threshold - rearm_rounds;
+		}
+	}
+};
+}
