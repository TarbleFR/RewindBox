diff --git a/rpcs3/ios/IOSStaleTextureSweep.h b/rpcs3/ios/IOSStaleTextureSweep.h
new file mode 100644
index 0000000..92aeed8
--- /dev/null
+++ b/rpcs3/ios/IOSStaleTextureSweep.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_STALE_TEXTURE_SWEEP_921: on iOS every CPU texture is confirmed by a hash of its guest bytes, never by page
+// protection (Emu/RSX/Common/texture_cache_protection_policy.h), so a texture whose guest memory the title has filled
+// with other data is found stale only when a lookup asks for it again; one that is never asked for again keeps its
+// image and its section for the rest of the boot. Upstream releases such hashed sections in
+// ranged_storage::trim_sections, but only in blocks of more than 256 locked sections: on the PC only textures under
+// 4 KiB are hashed. Call of Duty: Black Ops II streams its textures through guest memory at shifting addresses: in
+// every journal of builds 620 to 721 its texture cache gains 200-450 sections per 5 s window, trim releases none
+// (JITMEM texture_trim_sections=0), the cache's live bytes reach 527 MiB and its pool 568 MiB in 4.4 minutes (build
+// 666, more than the PS3's whole memory, still climbing) and the process footprint grows 5-20 MiB/s without plateau.
+//
+// Once per presented frame this pass hashes the guest bytes of the CPU textures (hash-validated shader reads and blit
+// sources) no lookup has used for texture_residency::min_idle_frames frames, at most `bytes_per_pass` bytes and
+// `sections_per_pass` sections looked at, resuming where the previous pass stopped, and releases exactly those whose
+// bytes no longer match: the next lookup of such a section would reject it and upload the memory again, as a write
+// fault would have on the PC. A section whose bytes still match is kept, however long it stays idle; the textures bound
+// to the current registers are not examined; the hash and its comparison are those of the lookups (without the
+// prehash tables, which predict the next frame's lookups). No cap, no eviction of a valid texture.
+namespace rpcs3::ios::stale_texture_sweep
+{
+inline std::atomic<bool> enabled{false};
+
+// Guest bytes hashed per pass at most: about 0.25-0.31 ms at the 12.8-16.8 GiB/s the texture hash ran at on the device
+// (JITMEM texture_hash_bytes / texture_hash_ticks, builds 694, 718 and 721). Over the 568 MiB pool of build 666 a full
+// revolution takes about 142 frames, 5 s at 28 FPS.
+constexpr std::uint64_t bytes_per_pass = 4ull << 20;
+// Sections looked at per pass at most, idle or not, so a pass over many small or busy sections stays short.
+constexpr std::uint32_t sections_per_pass = 2048;
+// A section found intact is looked at again only after this many frames (about 2 s at 30 FPS): a valid idle texture
+// costs one hash per `revisit_frames` frames instead of one per revolution of the storage.
+constexpr std::uint64_t revisit_frames = 64;
+
+inline bool revisit_due(std::uint64_t swept_frame, std::uint64_t now) noexcept
+{
+	return swept_frame == 0 || swept_frame > now || now - swept_frame >= revisit_frames;
+}
+
+// Read and reset by the 5 s report (COREPROF TEXSWEEP921).
+struct counters_t
+{
+	std::atomic<std::uint64_t> passes{0}, refused_locked{0}, seen{0}, examined{0}, examined_bytes{0};
+	std::atomic<std::uint64_t> released{0}, released_bytes{0}, released_host_bytes{0}, revolutions{0}, ticks{0};
+};
+inline counters_t counters;
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& value) noexcept
+{
+	return value.exchange(0, std::memory_order_relaxed);
+}
+
+// Where the next pass starts: a block of the texture cache storage and a slot inside it.
+struct cursor
+{
+	std::uint32_t block = 0;
+	std::uint32_t slot = 0;
+};
+
+struct pass_limits
+{
+	std::uint64_t bytes = bytes_per_pass;
+	std::uint32_t sections = sections_per_pass;
+};
+
+// What one pass did (the counters add these).
+struct pass_result
+{
+	std::uint32_t seen = 0, examined = 0, released = 0, revolutions = 0;
+	std::uint64_t examined_bytes = 0, released_bytes = 0, released_host_bytes = 0;
+};
+
+inline void record(const pass_result& result, std::uint64_t ticks) noexcept
+{
+	counters.passes.fetch_add(1, std::memory_order_relaxed);
+	counters.seen.fetch_add(result.seen, std::memory_order_relaxed);
+	counters.examined.fetch_add(result.examined, std::memory_order_relaxed);
+	counters.examined_bytes.fetch_add(result.examined_bytes, std::memory_order_relaxed);
+	counters.released.fetch_add(result.released, std::memory_order_relaxed);
+	counters.released_bytes.fetch_add(result.released_bytes, std::memory_order_relaxed);
+	counters.released_host_bytes.fetch_add(result.released_host_bytes, std::memory_order_relaxed);
+	counters.revolutions.fetch_add(result.revolutions, std::memory_order_relaxed);
+	counters.ticks.fetch_add(ticks, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::stale_texture_sweep
