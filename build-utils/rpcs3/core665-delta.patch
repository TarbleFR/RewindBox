diff --git a/rpcs3/ios/IOSPipelineQueue.h b/rpcs3/ios/IOSPipelineQueue.h
new file mode 100644
index 0000000..9772d6e
--- /dev/null
+++ b/rpcs3/ios/IOSPipelineQueue.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_PIPELINE_QUEUE_621: the graphics pipeline compile queue per profiler
+// window (COREPROF PIPEQUEUE621): jobs queued and built, the deepest queue,
+// the longest time a job waited before a compiler thread took it, the longest
+// build, and the draws the renderer skipped because their program was not
+// ready (VKDraw.cpp, asynchronous shader modes only: the synchronous modes
+// build inline and never skip). It sits beside the LLVM admission (JITMEM,
+// WAITPROF527 llvm_*) and the SPU busy waits (SPUWAIT551 getllar_poll,
+// PRESSURE547 spu_passive_waits), which have their own lines.
+namespace rpcs3::ios::pipeline_queue
+{
+struct counters
+{
+	std::atomic<std::uint64_t> queued{0}, completed{0}, skipped_draws{0};
+	std::atomic<std::uint64_t> depth_peak{0};
+	std::atomic<std::uint64_t> wait_total_tsc{0}, wait_max_tsc{0}, build_total_tsc{0}, build_max_tsc{0};
+};
+
+inline counters& stats() noexcept
+{
+	static counters s_counters;
+	return s_counters;
+}
+
+inline void raise(std::atomic<std::uint64_t>& value, std::uint64_t candidate) noexcept
+{
+	std::uint64_t current = value.load(std::memory_order_relaxed);
+	while (candidate > current && !value.compare_exchange_weak(current, candidate, std::memory_order_relaxed)) {}
+}
+
+inline void on_queued(std::uint32_t pending) noexcept
+{
+	stats().queued.fetch_add(1, std::memory_order_relaxed);
+	raise(stats().depth_peak, pending);
+}
+
+inline void on_completed(std::uint64_t wait_tsc, std::uint64_t build_tsc) noexcept
+{
+	auto& s = stats();
+	s.completed.fetch_add(1, std::memory_order_relaxed);
+	s.wait_total_tsc.fetch_add(wait_tsc, std::memory_order_relaxed);
+	s.build_total_tsc.fetch_add(build_tsc, std::memory_order_relaxed);
+	raise(s.wait_max_tsc, wait_tsc);
+	raise(s.build_max_tsc, build_tsc);
+}
+
+inline void on_skipped_draw() noexcept
+{
+	stats().skipped_draws.fetch_add(1, std::memory_order_relaxed);
+}
+
+struct window
+{
+	std::uint64_t queued = 0, completed = 0, skipped_draws = 0, depth_peak = 0;
+	std::uint64_t wait_total_tsc = 0, wait_max_tsc = 0, build_total_tsc = 0, build_max_tsc = 0;
+};
+
+inline window take() noexcept
+{
+	auto& s = stats();
+	window w;
+	w.queued = s.queued.exchange(0, std::memory_order_relaxed);
+	w.completed = s.completed.exchange(0, std::memory_order_relaxed);
+	w.skipped_draws = s.skipped_draws.exchange(0, std::memory_order_relaxed);
+	w.depth_peak = s.depth_peak.exchange(0, std::memory_order_relaxed);
+	w.wait_total_tsc = s.wait_total_tsc.exchange(0, std::memory_order_relaxed);
+	w.wait_max_tsc = s.wait_max_tsc.exchange(0, std::memory_order_relaxed);
+	w.build_total_tsc = s.build_total_tsc.exchange(0, std::memory_order_relaxed);
+	w.build_max_tsc = s.build_max_tsc.exchange(0, std::memory_order_relaxed);
+	return w;
+}
+}
diff --git a/rpcs3/ios/IOSReadbackPrediction.h b/rpcs3/ios/IOSReadbackPrediction.h
new file mode 100644
index 0000000..0246ac0
--- /dev/null
+++ b/rpcs3/ios/IOSReadbackPrediction.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_READBACK_PREDICTION_638: whether a guest read of a written-back surface found its data
+// already copied by the upstream speculative readback (texture_cache_predictor.h) or paid the copy at
+// fault time. Build 622 God of War III: READBACK555 fault_read 132 sections of 3.69 MB per 5 s window,
+// 554 ms. READBACK555 counts only the sections still unsynchronized at the read, so it cannot say
+// whether speculation never fired for them, fired and was wasted, or was capped. Five process-wide
+// counters, read once per window; no behavior, ordering or cache decision changes.
+namespace rpcs3::ios::readback::prediction
+{
+inline std::atomic<std::uint64_t> flushes{0};            // sections written back to guest memory
+inline std::atomic<std::uint64_t> speculative_copies{0}; // copies recorded ahead of a predicted read
+inline std::atomic<std::uint64_t> flushes_after_speculation{0}; // write-backs of a section whose upstream speculation flag is set (it survives a later write)
+inline std::atomic<std::uint64_t> mispredictions{0};     // a speculative copy overwritten before any read
+inline std::atomic<std::uint64_t> misses{0};             // a read that recorded its copy at fault time
+
+struct sample
+{
+	std::uint64_t flushes = 0, speculative_copies = 0, flushes_after_speculation = 0, mispredictions = 0, misses = 0;
+};
+
+inline void count(std::atomic<std::uint64_t>& counter) noexcept
+{
+	counter.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline sample take() noexcept
+{
+	return {flushes.exchange(0, std::memory_order_relaxed), speculative_copies.exchange(0, std::memory_order_relaxed),
+		flushes_after_speculation.exchange(0, std::memory_order_relaxed), mispredictions.exchange(0, std::memory_order_relaxed),
+		misses.exchange(0, std::memory_order_relaxed)};
+}
+}
diff --git a/rpcs3/ios/IOSRenderPassCensus.h b/rpcs3/ios/IOSRenderPassCensus.h
new file mode 100644
index 0000000..fd49ada
--- /dev/null
+++ b/rpcs3/ios/IOSRenderPassCensus.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_RENDERPASS_CENSUS_652: why render passes end. IPA 643 Assassin's Creed (window 18): 51 render passes per
+// frame for 1401 draws. FEEDBACK610 counts the passes the draw path began and TEXCACHE621 the depth feedback barriers
+// (8.7 per frame), but no journal line said which code ended the other passes, nor whether the next pass resumed the
+// same framebuffer (a restart that a barrier or a copy forced) or bound another one (a target switch).
+// vk::end_renderpass records its caller's file and line (a std::source_location default argument: no call site
+// changes); vk::begin_renderpass, when it really begins a pass on a command buffer whose previous pass was ended,
+// attributes that begin to the site of the end, on the same framebuffer or another. The performance reporter prints
+// the totals and the busiest sites once per window (COREPROF RPASS652). The render pass helpers are not thread safe
+// by design (RSX thread); the counters are relaxed atomics only because the reporter thread exchanges them.
+// Counting changes no render pass, barrier, copy or command.
+namespace rpcs3::ios::renderpass_census
+{
+constexpr std::size_t site_capacity = 48;
+
+struct site
+{
+	std::atomic<const char*> file{nullptr};
+	std::atomic<std::uint32_t> line{0};
+	std::atomic<std::uint64_t> ends{0};         // passes this site ended
+	std::atomic<std::uint64_t> same_target{0};  // begins that followed an end here on the same framebuffer
+	std::atomic<std::uint64_t> other_target{0}; // begins that followed an end here on another framebuffer
+};
+
+struct window_counters
+{
+	std::atomic<std::uint64_t> begins{0};       // passes vk::begin_renderpass really began
+	std::atomic<std::uint64_t> fresh{0};        // of which nothing had ended before on that command buffer
+	std::atomic<std::uint64_t> same_target{0};  // of which the previous pass ended on the same framebuffer
+	std::atomic<std::uint64_t> other_target{0}; // of which the previous pass ended on another framebuffer
+	std::atomic<std::uint64_t> overflow{0};     // ends of a site that found no free slot
+	std::array<site, site_capacity> sites{};
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+// Slot of a call site (single writer). A std::source_location file name is a string literal of its translation unit,
+// stable for the life of the program. -1 when the table is full.
+inline int slot(const char* file, std::uint32_t line) noexcept
+{
+	for (std::size_t index = 0; index < site_capacity; index++)
+	{
+		auto& entry = counters.sites[index];
+		const char* known = entry.file.load(std::memory_order_acquire);
+		if (known == nullptr)
+		{
+			entry.line.store(line, std::memory_order_relaxed);
+			entry.file.store(file, std::memory_order_release);
+			return static_cast<int>(index);
+		}
+		if (known == file && entry.line.load(std::memory_order_relaxed) == line)
+		{
+			return static_cast<int>(index);
+		}
+	}
+	return -1;
+}
+
+// The previous end on one command buffer: its framebuffer and site.
+struct last_end
+{
+	const void* framebuffer = nullptr;
+	int site = -1;
+	bool valid = false;
+};
+
+inline void on_end(last_end& previous, const void* framebuffer, const char* file, std::uint32_t line) noexcept
+{
+	const int index = slot(file, line);
+	add(index >= 0 ? counters.sites[index].ends : counters.overflow);
+	previous = { framebuffer, index, true };
+}
+
+inline void on_begin(last_end& previous, const void* framebuffer) noexcept
+{
+	add(counters.begins);
+	if (!previous.valid)
+	{
+		add(counters.fresh);
+		return;
+	}
+
+	const bool same = previous.framebuffer == framebuffer;
+	add(same ? counters.same_target : counters.other_target);
+	if (previous.site >= 0)
+	{
+		add(same ? counters.sites[previous.site].same_target : counters.sites[previous.site].other_target);
+	}
+	previous.valid = false;
+}
+}
diff --git a/rpcs3/ios/IOSRsxLabelAccess.h b/rpcs3/ios/IOSRsxLabelAccess.h
new file mode 100644
index 0000000..cd745c8
--- /dev/null
+++ b/rpcs3/ios/IOSRsxLabelAccess.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Emu/Memory/vm.h"
+#include "Emu/Cell/lv2/sys_rsx.h"
+#include "ios/RPCS3IOSExperimentalPolicy.h"
+
+// REWINDBOX_ZCULL_ON_DEMAND_619 (ios/IOSZcullOnDemand.h): the RSX thread's own
+// reads and writes of GCM labels, notifies and flip semaphores. On a 16 KiB host
+// page the label area shares its page with local reports 0-703, which ZCULL
+// protects while one of them is pending: through the protected view, an RSX
+// label access would fault and switch the location to the upstream mode for the
+// rest of the boot. With the lever, the RSX thread reaches the GCM label/report
+// area, and any page ZCULL holds locked, through the unprotected view: the bytes
+// are the same, the page stays protected for the guest threads, whose accesses
+// are served on demand. Elsewhere, and without the lever, the protected view
+// (upstream) is kept.
+namespace rpcs3::ios::zcull_on_demand
+{
+template <typename T, typename Thread>
+auto rsx_label_ptr(Thread* rsx, u32 address)
+{
+	if (rpcs3::ios::get_experimental_policy().zcull_on_demand &&
+		(address - rsx->label_addr < sizeof(RsxReports) || rsx->ios_zcull_page_locked(address)))
+	{
+		return vm::get_super_ptr<T>(address);
+	}
+
+	return vm::_ptr<T>(address);
+}
+}
