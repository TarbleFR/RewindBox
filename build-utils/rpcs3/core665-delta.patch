+			{
+				if (It->query && It->query->num_draws)
+				{
+					front = It->query;
+					break;
+				}
+			}
+
+			const u64 front_cb = (front && pending < zw::depth_hard_cap) ? ios_open_cb_serial(front) : zw::cb_unknown;
+			// The skips are counted per open command buffer, the one that holds `newest`.
+			const u64 newest_cb = ios_open_cb_serial(newest);
+			if (newest_cb != m_ios_depth_skip_cb)
