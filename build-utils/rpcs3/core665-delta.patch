--- /dev/null
+++ b/rpcs3/ios/IOSZcullWatched.h
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_ZCULL_WATCHED_FLUSH_660: IPA 657 logs (Core 655, PID 10471). Assassin's Creed waits
+// 32.0 ms per frame for ZCULL reports (window 1:42: ZCULLDEMAND619 waits=259:3779.8 ms, max 43.7)
+// for 30.5 ms of GPU work: MoltenVK publishes an occlusion result only when its whole command
+// buffer has completed, and the command buffer of a report is submitted only when a guest asks for
+// that report (ZCULLSYNC613: every command buffer besides the flip one is such a hint flush,
+// 344 = 118 + 226). Black Ops II waits 12.5 ms per report for the GPU side (window 3:16:
+// 1566.5 ms over 107 waits). The guest of these titles faults on a few report slots per frame
+// (ZCULLDEMAND619 faults report=259 per 118 frames).
+// - Learning (guest threads, fault handler, under the pages mutex). With the asynchronous reads of
+//   630 the handler knows the slot a guest waits for, and the page's slots record when their newest
+//   pending report was queued: the read waits for that one last. A slot waited for at least
+//   min_lead_us after that report is learned (a read closer to its report gains little from an
+//   earlier submission, and the RSX thread rarely reaches a pass boundary before it). A watched slot
+//   read again (waited for, or read final by the handler) stays watched, and the number of reports
+//   queued into it between two such reads is kept; a watched slot waited for closer than
+//   min_lead_us after its newest report is dropped. A slot no guest waited for or read for
+//   watch_frames frames is forgotten.
+// - Arming (RSX thread). When a report is queued into a watched slot as the last one expected
+//   before the next read (as many reports as between the last two reads), and the query that
+//   decides its value is still in the open command buffer, the backend arms the boundary submission
+//   of 659 for that buffer: taken at the next draw start or after the next draw's textures with no
+//   render pass open, at the end of a draw after max_deferred_draws more draws (the fallback), or
+//   carried by any other primary submission. The GPU-idle test of 561 does not apply (the guest
+//   reads this report); the 561 cap of early submissions per frame does, and at most
+//   max_watched_submits_per_frame such submissions are taken per frame (an arm another submission
+//   carries costs nothing and is not counted).
+// Only command buffer boundaries move: the guest still reads the GPU result of every report, written
+// in the same order; no report value, query or m_sync_tag is touched here.
+//
+// REWINDBOX_ZCULL_DEPTH_GUARD_660: Black Ops II windows 3:12-3:13 of the same logs record about
+// 140 submissions per frame in some frames (ZCULLSYNC613 hint_flushes 2,844 and 2,861 per window,
+// 2,686/2,671 render pass re-begins). The cause inferred is the queue-depth branch of
+// ZCULL_control::update(): above max_safe_queue_depth pending reports, every new report submits
+// the open command buffer for its query, a render pass split each time, while the reports at the
+// head of the queue are already on the GPU. At that limit the hint is now sent only while the
+// oldest pending query is still in the open command buffer (nothing can drain before it is
+// submitted), and after open_cb_skip_bound skipped hints for the same open command buffer: its
+// queries cannot complete before it is submitted (MoltenVK publishes results at the end of a
+// command buffer), so it is submitted at least every 256 queue-depth checks instead of at every
+// report; upstream applies again at or above depth_hard_cap pending reports. The 2,048 query slots
+// are not reserved: one report holds one query, so a reserve of free slots would end the guard as
+// soon as the depth branch runs. When the slots run out, allocate_new_query reads the oldest report
+// synchronously as upstream does (values exact). Host model of the reviews (not device numbers):
+// with more than 2,048 reports in flight per frame the guard makes those synchronous reads longer
+// (2,600 reports per frame: 45.8 -> 53.4 ms per frame) and the hint storm shorter (4,000: 156.8 ->
+// 77.0 ms; BO2-like 1,900 peak: 103.7 -> 75.2 ms), hence its own setting for an A/B on the device.
+// The guard applies only while the on-demand reads really run (not after a 619 trip or with accurate
+// RSX reservation access). Guest reads are served by their own paths (ios_service_read, sync(),
+// read_barrier()), which keep their hints.
+namespace rpcs3::ios::zcull_watched
+{
+inline constexpr std::uint32_t slot_bytes = 16;                   // a GCM report (zcull_on_demand::report_slot_bytes)
+inline constexpr std::uint32_t capacity = 32;                     // learned slots kept; the least recently read is replaced
+inline constexpr std::uint64_t watch_frames = 8;                  // frames a slot stays watched after its last wait or read
+inline constexpr std::uint32_t max_watched_submits_per_frame = 2; // watched submissions taken per frame, inside the 561 cap
+inline constexpr std::uint64_t min_lead_us = 1000;                // report -> read time below which an earlier submission gains little
+inline constexpr std::uint32_t query_scan_limit = 64;             // pending writes scanned for the deciding or oldest query
+
+// REWINDBOX_ZCULL_DEPTH_GUARD_660
+inline constexpr std::uint32_t depth_limit = 1792;                // rsx::reports::max_safe_queue_depth (RSXZCULL.h), for the reports
+inline constexpr std::uint32_t depth_hard_cap = 8192;             // pending reports from which the upstream hint applies again
+inline constexpr std::uint32_t open_cb_skip_bound = 256;          // skipped hints for one open command buffer before one is sent
+inline constexpr std::uint64_t cb_unknown = ~std::uint64_t{0};    // the backend cannot tell (upstream behaviour)
+
+// Process-wide counters of COREPROF ZCULLWATCH660 and ZCULLDEPTH660 (taken per window).
+struct tally
+{
+	// REWINDBOX_ZCULL_WATCHED_FLUSH_660: the table.
+	std::atomic<std::uint64_t> learned{0};         // a guest waited, min_lead_us or more after its newest report, for a slot not watched
+	std::atomic<std::uint64_t> refreshed{0};       // a watched slot waited for or read final again
+	std::atomic<std::uint64_t> expired{0};         // watched slots forgotten after watch_frames
+	std::atomic<std::uint64_t> evicted{0};         // ... replaced while the table was full
+	std::atomic<std::uint64_t> short_leads{0};     // waits closer than min_lead_us after the newest report (not learned, or dropped)
+	std::atomic<std::uint32_t> watched_now{0};     // slots in the table at the last change
+	// ... the reports queued into watched slots (RSX thread).
+	std::atomic<std::uint64_t> watched_reports{0};
+	std::atomic<std::uint64_t> early_writes{0};    // ... with more reports expected before the next read: not armed
+	std::atomic<std::uint64_t> armed{0};           // ... that armed the boundary submission
+	std::atomic<std::uint64_t> joined{0};          // ... whose command buffer had a submission armed already
+	std::atomic<std::uint64_t> submitted{0};       // ... whose deciding query had left the open command buffer
+	std::atomic<std::uint64_t> no_query{0};        // ... without a query with draws to wait for
+	std::atomic<std::uint64_t> capped{0};          // ... over max_watched_submits_per_frame or the 561 cap of the frame
+	std::atomic<std::uint64_t> off{0};             // ... with early submission off or not in the boundary mode
+	// ... where the watched arms went (backend).
+	std::atomic<std::uint64_t> taken_start{0};     // taken at the start of a draw
+	std::atomic<std::uint64_t> taken_textures{0};  // ... after a draw's textures
+	std::atomic<std::uint64_t> fallback{0};        // ... at the end of a draw after max_deferred_draws draws
+	std::atomic<std::uint64_t> carried{0};         // ... carried by another primary submission
+	// REWINDBOX_ZCULL_DEPTH_GUARD_660: update() at the queue-depth limit, where upstream hints.
+	std::atomic<std::uint64_t> depth_checks{0};
+	std::atomic<std::uint64_t> depth_hints{0};          // hinted: oldest query in the open command buffer, first time there
+	std::atomic<std::uint64_t> depth_skip_submitted{0}; // not hinted: the oldest pending query is on the GPU
+	std::atomic<std::uint64_t> depth_skip_same_cb{0};   // not hinted: this command buffer had its hint
+	std::atomic<std::uint64_t> depth_hard_cap_hints{0}; // hinted as upstream: at or above depth_hard_cap
+	std::atomic<std::uint64_t> depth_unknown{0};        // hinted as upstream: no oldest query found or no answer
+	std::atomic<std::uint64_t> depth_open_cb_bound{0};  // hinted: open_cb_skip_bound hints skipped for this open command buffer
+	std::atomic<std::uint64_t> depth_peak{0};           // the most pending reports seen at the limit
+
+	static void raise_max(std::atomic<std::uint64_t>& max_value, std::uint64_t value) noexcept
+	{
+		std::uint64_t max = max_value.load(std::memory_order_relaxed);
+		while (value > max && !max_value.compare_exchange_weak(max, value, std::memory_order_relaxed)) {}
+	}
+};
+
+inline tally& counters() noexcept
+{
+	static tally s_tally;
+	return s_tally;
+}
+
+constexpr std::uint32_t slot_of(std::uint32_t address) noexcept
+{
+	return address & ~(slot_bytes - 1);
+}
+
+enum class learn_result : std::uint8_t
+{
+	learned,     // a new watched slot
+	refreshed,   // a watched slot read again
+	short_lead,  // not watched: its report came too close before the read
+	dropped,     // was watched: the read followed its newest report too closely
+};
+
+// REWINDBOX_ZCULL_WATCHED_FLUSH_660: the report slots guests waited for. Under
+// ZCULL_control::m_pages_mutex: guest threads write it in the fault handler, the RSX thread reads
+// and counts in it when a report locks its page.
+class watched_slots
+{
+	struct entry
+	{
+		std::uint32_t slot = 0;
+		std::uint32_t writes = 0;          // reports queued into the slot since its last read
+		std::uint32_t per_read = 1;        // ... between its last two reads (1 when just learned)
+		std::uint64_t frame = 0;           // frame of the last wait or final read
+		std::uint64_t order = 0;           // ... and its rank among them (ties of a frame)
+	};
+
+	entry m_entries[capacity]{};
+	std::uint32_t m_count = 0;
+	std::uint64_t m_frame = 0;   // the RSX frame (rsx::thread::int_flip_index) at its last report
+	std::uint64_t m_filter = 0;  // one bit per (slot / slot_bytes) % 64 of the entries
+	std::uint64_t m_order = 0;
+
+	static constexpr std::uint64_t bit(std::uint32_t slot) noexcept
+	{
+		return std::uint64_t{1} << ((slot / slot_bytes) & 63);
+	}
+
+	bool live(const entry& e) const noexcept
+	{
+		return m_frame <= e.frame + watch_frames;
+	}
+
+	void publish() const noexcept
+	{
+		counters().watched_now.store(m_count, std::memory_order_relaxed);
+	}
+
+	void rebuild_filter() noexcept
+	{
+		m_filter = 0;
+		for (std::uint32_t i = 0; i < m_count; i++)
+		{
+			m_filter |= bit(m_entries[i].slot);
+		}
+	}
+
+	void remove(std::uint32_t index) noexcept
+	{
+		m_entries[index] = m_entries[--m_count];
+		rebuild_filter();
+		publish();
+	}
+
+	// Drops the slots not waited for or read for watch_frames frames.
+	void expire() noexcept
+	{
+		std::uint32_t kept = 0;
+		for (std::uint32_t i = 0; i < m_count; i++)
+		{
+			if (live(m_entries[i]))
+			{
+				m_entries[kept++] = m_entries[i];
+			}
+			else
+			{
+				counters().expired.fetch_add(1, std::memory_order_relaxed);
+			}
+		}
+
+		if (kept != m_count)
+		{
+			m_count = kept;
+			rebuild_filter();
+			publish();
+		}
+	}
+
+	std::uint32_t find(std::uint32_t slot) const noexcept
+	{
+		if (m_filter & bit(slot))
+		{
+			for (std::uint32_t i = 0; i < m_count; i++)
+			{
+				if (m_entries[i].slot == slot)
+				{
+					return i;
+				}
+			}
+		}
+
+		return capacity;
+	}
+
+	void read_again(entry& e) noexcept
+	{
+		e.per_read = e.writes ? e.writes : 1;
+		e.writes = 0;
+		e.frame = m_frame;
+		e.order = ++m_order;
+		counters().refreshed.fetch_add(1, std::memory_order_relaxed);
+	}
+
+public:
+	// RSX thread, a report queued at `address` locks its page: the clock moves to `frame` (expired slots
+	// are dropped once per frame). True when the slot is watched and this report is the last one expected
+	// before the slot's next read.
+	bool on_report(std::uint32_t address, std::uint64_t frame) noexcept
+	{
+		if (frame != m_frame)
+		{
+			m_frame = frame;
+			expire();
+		}
+
+		const std::uint32_t index = m_count ? find(slot_of(address)) : capacity;
+		if (index == capacity || !live(m_entries[index]))
+		{
+			return false;
+		}
+
+		entry& e = m_entries[index];
+		counters().watched_reports.fetch_add(1, std::memory_order_relaxed);
+		if (++e.writes < e.per_read)
+		{
+			counters().early_writes.fetch_add(1, std::memory_order_relaxed);
+			return false;
+		}
+
+		return true;
+	}
+
+	// Guest thread: its access waits for the slot at `address`, whose newest pending report was queued
+	// `lead_us` before (page_slots::newest_age_us).
+	learn_result learn(std::uint32_t address, std::uint64_t lead_us) noexcept
+	{
+		const std::uint32_t slot = slot_of(address);
+		if (const std::uint32_t index = find(slot); index != capacity)
+		{
+			entry& e = m_entries[index];
+			if (lead_us < min_lead_us)
+			{
+				remove(index);
+				counters().short_leads.fetch_add(1, std::memory_order_relaxed);
+				return learn_result::dropped;
+			}
+
+			read_again(e);
+			return learn_result::refreshed;
+		}
+
+		if (lead_us < min_lead_us)
+		{
+			counters().short_leads.fetch_add(1, std::memory_order_relaxed);
+			return learn_result::short_lead;
+		}
+
+		if (m_count == capacity)
+		{
+			std::uint32_t oldest = 0;
+			for (std::uint32_t i = 1; i < m_count; i++)
+			{
+				const entry& e = m_entries[i];
+				if (e.frame < m_entries[oldest].frame || (e.frame == m_entries[oldest].frame && e.order < m_entries[oldest].order))
+				{
+					oldest = i;
+				}
+			}
+
+			m_entries[oldest] = {};
+			m_entries[oldest].slot = slot;
+			m_entries[oldest].frame = m_frame;
+			m_entries[oldest].order = ++m_order;
+			rebuild_filter();
+			counters().evicted.fetch_add(1, std::memory_order_relaxed);
+		}
+		else
+		{
+			entry& e = m_entries[m_count++];
+			e = {};
+			e.slot = slot;
+			e.frame = m_frame;
+			e.order = ++m_order;
+			m_filter |= bit(slot);
+		}
+
+		counters().learned.fetch_add(1, std::memory_order_relaxed);
+		publish();
+		return learn_result::learned;
+	}
+
+	// Guest thread: its access read the slot at `address` final. A watched slot stays watched (the
+	// submissions that made it final keep it); any other slot is not learned.
+	bool refresh(std::uint32_t address) noexcept
+	{
+		if (const std::uint32_t index = find(slot_of(address)); index != capacity)
+		{
+			read_again(m_entries[index]);
+			return true;
+		}
+
+		return false;
+	}
+
+	std::uint32_t size() const noexcept
+	{
+		return m_count;
+	}
+};
+
+// Backend, RSX thread: the watched submissions taken in the current frame.
+struct frame_budget
+{
+	std::uint64_t frame = ~std::uint64_t{0};
+	std::uint32_t used = 0;
+
+	bool available(std::uint64_t now_frame) noexcept
+	{
+		if (now_frame != frame)
+		{
+			frame = now_frame;
+			used = 0;
+		}
+
+		return used < max_watched_submits_per_frame;
+	}
+
+	void consume() noexcept
+	{
+		used++;
+	}
+};
+
+// What the backend did with a watched report (VKGSRender::ios_arm_watched_submit).
+enum class arm_result : std::uint8_t
+{
+	off,        // early submission off, or not in the boundary mode: nothing armed
+	armed,      // the boundary submission of the open command buffer is armed
+	joined,     // a submission was already armed for it
+	submitted,  // the deciding query no longer has host queries in the open command buffer
+	capped,     // the 561 cap or max_watched_submits_per_frame is used up for this frame
+};
+
+// REWINDBOX_ZCULL_DEPTH_GUARD_660
+enum class depth_verdict : std::uint8_t
+{
+	hint,                // the oldest pending query is in the open command buffer, not hinted there yet
+	hard_cap,            // at or above depth_hard_cap: upstream
+	unknown,             // no oldest query found, or the backend cannot tell: upstream
+	front_submitted,     // the oldest pending query is on the GPU: no hint
+	same_command_buffer, // this command buffer had its guarded hint: no hint
+	open_cb_bound,       // open_cb_skip_bound hints were skipped for the open command buffer: hint
+};
+
+// pending: ptimer->async_tasks_pending; front_cb: the backend's serial of the open command buffer
+// holding the oldest pending query (0 when it was submitted, cb_unknown when unknown); last_cb: the
+// serial of the last guarded hint; open_cb_skips: hints already skipped for the open command buffer.
+constexpr depth_verdict decide_depth(std::uint32_t pending, std::uint64_t front_cb, std::uint64_t last_cb,
+	std::uint32_t open_cb_skips = 0) noexcept
+{
+	if (pending >= depth_hard_cap)
+	{
+		return depth_verdict::hard_cap;
+	}
+
+	if (front_cb == cb_unknown)
+	{
+		return depth_verdict::unknown;
+	}
+
+	if (front_cb == 0)
+	{
+		return open_cb_skips >= open_cb_skip_bound ? depth_verdict::open_cb_bound : depth_verdict::front_submitted;
+	}
+
+	return front_cb == last_cb ? depth_verdict::same_command_buffer : depth_verdict::hint;
+}
+
+constexpr bool depth_hint_sent(depth_verdict verdict) noexcept
+{
+	return verdict == depth_verdict::hint || verdict == depth_verdict::hard_cap || verdict == depth_verdict::unknown ||
+		verdict == depth_verdict::open_cb_bound;
+}
+}
