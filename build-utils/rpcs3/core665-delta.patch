+		void ZCULL_control::ios_service_read(::rsx::thread* ptimer)
+		{
+			// REWINDBOX_ZCULL_ASYNC_READS_630: RSX thread. A guest waits for one report slot. Submit the
+			// command buffer that holds its newest query if it is still open, write what the GPU has
