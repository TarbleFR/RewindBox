+			const u64 started = get_system_time();
+			bool requested = false;
+			u64 requested_at = 0; // REWINDBOX_ZCULL_DEMAND_GUARD_621: the latest request
+			u64 picked_at = 0;    // ... and when the RSX thread was seen to pick it up
