+	{
+		return RPCS3_IOS_INVALID_ARGUMENT;
+	}
+
+	try
+	{
+		const u32 struct_size = info->struct_size;
+		std::memset(info, 0, sizeof(rpcs3_ios_ra_session_info));
+		info->struct_size = struct_size;
+		info->emulation_state = static_cast<u32>(current_emulation_state());
+
+		const frame_limit_type limit = g_cfg.video.frame_limit.get();
+		rpcs3::ios::achievements::speed_settings speed;
+		speed.vblank_rate = static_cast<u32>(g_cfg.video.vblank_rate.get());
+		speed.clocks_scale = static_cast<u32>(g_cfg.core.clocks_scale.get());
+		speed.frame_limit_unbounded = limit == frame_limit_type::none ||
+			limit == frame_limit_type::_120 || limit == frame_limit_type::infinite;
+
+		info->vblank_rate = speed.vblank_rate;
+		info->clocks_scale = speed.clocks_scale;
+		info->frame_limit_unbounded = speed.frame_limit_unbounded ? 1 : 0;
+		info->hardcore_compatible = rpcs3::ios::achievements::hardcore_compatible(speed) ? 1 : 0;
+
+		u64 generation = 0;
+		rpcs3::ios::achievements::last_boot().copy(info->title_id, sizeof(info->title_id),
+			info->content_path, sizeof(info->content_path), generation);
+		info->boot_generation = generation;
+		return RPCS3_IOS_OK;
+	}
+	catch (...)
+	{
+		return RPCS3_IOS_INTERNAL_ERROR;
+	}
+}
