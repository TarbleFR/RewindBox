+				break;
+			case zw::depth_verdict::hard_cap:
+				tally.depth_hard_cap_hints.fetch_add(1, std::memory_order_relaxed);
+				break;
+			case zw::depth_verdict::unknown:
+				tally.depth_unknown.fetch_add(1, std::memory_order_relaxed);
+				break;
+			case zw::depth_verdict::front_submitted:
