+#include <cstring>
+#include <mutex>
+#include <shared_mutex>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// REWINDBOX_SPIRV_DISK_CACHE_634: every boot of the Build 629 logs regenerates the GLSL of the
+// whole shader cache and compiles it with glslang. Black Ops II multiplayer: 1,072 sources, 5.49 s
+// of CPU (5.1 ms each, 53.8 ms at most), 1.47 s of a 1.60 s warmup, on all 6 cores, before the PPU
+// objects start loading; Assassin's Creed: 412 sources, 1.88 s of CPU. Only one of them is new per
+// 5 s window during the game. The Metal library behind each module is cached, the SPIR-V is not.
+//
+// One file per title holds the SPIR-V of each source, under SHA-256(source, stage, compiler
+// environment): the same text through the same glslang options gives the same words, so what
+// the game gets cannot differ from a compilation. The GLSL is still generated (the key), and the
+// module, the MoltenVK pipeline cache and the program caches see the same words as before.
+// Mapped read-only: clean file pages, not in the footprint, the system drops them under pressure.
+// Nothing here is needed: a missing, truncated or damaged file means compiling, as before. Entries
+// are appended; the valid prefix survives a torn tail, and a damaged entry fails its CRC at use.
+// Old Cores ignore the file. A change of glslang or of its options must change environment_revision.
+namespace rpcs3::ios::spirv_cache
+{
+using key = std::array<std::uint8_t, 32>;
+
+inline constexpr char file_magic[8] = {'R', 'B', 'S', 'P', 'I', 'R', 'V', '1'};
+// SPIRVCommon.cpp: glslang as pinned by the Core, Vulkan 1.2 rules, SPIR-V 1.5, optimizer off, optimizeSize.
+inline constexpr std::uint32_t environment_revision = 0x0105'0634;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 20;
+inline constexpr std::uint32_t max_entry_words = (16u << 20) / 4;
+
+struct file_header
+{
+	char magic[8];
+	std::uint32_t revision;
+	std::uint32_t reserved;
+};
+
+struct entry_header
+{
+	std::uint8_t name[32];
+	std::uint32_t words;
+	std::uint32_t crc;
+};
+
+static_assert(sizeof(file_header) == 16 && sizeof(entry_header) == 40);
+
+inline bool make_key(std::string_view source, std::uint32_t stage, key& out) noexcept
+{
+	const std::uint32_t prefix[2] = {stage, environment_revision};
+	mbedtls_sha256_context context;
+	mbedtls_sha256_init(&context);
+	int result = mbedtls_sha256_starts_ret(&context, 0);
+	if (!result) result = mbedtls_sha256_update_ret(&context, reinterpret_cast<const unsigned char*>(prefix), sizeof(prefix));
+	if (!result) result = mbedtls_sha256_update_ret(&context, reinterpret_cast<const unsigned char*>(source.data()), source.size());
+	if (!result) result = mbedtls_sha256_finish_ret(&context, out.data());
+	mbedtls_sha256_free(&context);
+	return result == 0;
+}
+
+class store
+{
+	struct key_hash
+	{
+		std::size_t operator()(const key& name) const noexcept
+		{
+			std::size_t value;
+			std::memcpy(&value, name.data(), sizeof(value));
+			return value;
+		}
+	};
+
+	struct located
+	{
+		std::uint64_t offset;
+		std::uint32_t words;
+		std::uint32_t crc;
+	};
+
+	mutable std::shared_mutex m_mutex;
+	std::mutex m_write_mutex;
+	std::string m_path;
+	const std::uint8_t* m_map = nullptr;
+	std::size_t m_map_bytes = 0;
+	std::uint64_t m_valid_bytes = 0; // the end of the last good entry: a torn tail starts here
+	std::uint64_t m_pending_bytes = 0;
+	std::uint64_t m_flushing_bytes = 0; // REWINDBOX_SPIRV_CAP_636: the batch flush() is writing, header included
+	std::unordered_map<key, located, key_hash> m_index;
+	std::unordered_map<key, std::vector<std::uint32_t>, key_hash> m_pending;
+	std::unordered_set<key, key_hash> m_written; // this session's entries: not mapped, not added twice
+
+	void unmap() noexcept
+	{
+		if (m_map)
+		{
+			::munmap(const_cast<std::uint8_t*>(m_map), m_map_bytes);
+		}
+
+		m_map = nullptr;
+		m_map_bytes = 0;
+		m_index.clear();
+	}
+
+	void map_file() noexcept
+	{
+		const int file = ::open(m_path.c_str(), O_RDONLY | O_CLOEXEC);
+
+		if (file < 0)
+		{
+			return;
+		}
+
+		struct stat info{};
+
+		if (::fstat(file, &info) == 0 && S_ISREG(info.st_mode) && static_cast<std::uint64_t>(info.st_size) >= sizeof(file_header))
+		{
+			void* const mapped = ::mmap(nullptr, static_cast<std::size_t>(info.st_size), PROT_READ, MAP_PRIVATE, file, 0);
+
+			if (mapped != MAP_FAILED)
+			{
+				m_map = static_cast<const std::uint8_t*>(mapped);
+				m_map_bytes = static_cast<std::size_t>(info.st_size);
+				::madvise(mapped, m_map_bytes, MADV_SEQUENTIAL);
+				index_entries();
+				::madvise(mapped, m_map_bytes, MADV_RANDOM);
+			}
+		}
+
+		::close(file);
+	}
+
+	void index_entries() noexcept
+	{
+		file_header header;
+		std::memcpy(&header, m_map, sizeof(header));
+
+		if (std::memcmp(header.magic, file_magic, sizeof(file_magic)) != 0 || header.revision != environment_revision)
+		{
+			return; // Rewritten from the start at the next flush.
+		}
+
+		std::uint64_t position = sizeof(file_header);
+
+		while (m_map_bytes - position >= sizeof(entry_header))
+		{
+			entry_header entry;
+			std::memcpy(&entry, m_map + position, sizeof(entry));
+			const std::uint64_t bytes = std::uint64_t{entry.words} * sizeof(std::uint32_t);
+
+			if (!entry.words || entry.words > max_entry_words || m_map_bytes - position - sizeof(entry) < bytes)
+			{
+				break;
+			}
+
+			key name;
+			std::memcpy(name.data(), entry.name, name.size());
+			m_index[name] = {position + sizeof(entry), entry.words, entry.crc}; // the last copy wins
+			position += sizeof(entry) + bytes;
+		}
+
+		m_valid_bytes = position;
+	}
+
+	static bool write_all(int file, const void* data, std::size_t size) noexcept
+	{
+		const auto* bytes = static_cast<const std::uint8_t*>(data);
+
+		while (size)
+		{
+			const auto written = ::write(file, bytes, size);
+
+			if (written <= 0)
+			{
+				return false;
+			}
+
+			bytes += written;
+			size -= static_cast<std::size_t>(written);
+		}
+
+		return true;
+	}
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+
+	~store()
+	{
+		close();
+	}
+
+	void open(std::string path) noexcept
+	{
+		close();
+		std::unique_lock lock(m_mutex);
+		m_path = std::move(path);
+		map_file();
+	}
+
+	bool active() const noexcept
+	{
+		std::shared_lock lock(m_mutex);
+		return !m_path.empty();
+	}
+
+	bool find(const key& name, std::vector<std::uint32_t>& words) const
+	{
+		std::shared_lock lock(m_mutex);
+
+		if (const auto pending = m_pending.find(name); pending != m_pending.end())
+		{
+			words = pending->second;
+			return true;
+		}
+
+		const auto found = m_index.find(name);
+
+		if (found == m_index.end())
+		{
+			return false;
+		}
+
+		const std::uint8_t* const payload = m_map + found->second.offset;
+		const std::size_t bytes = std::size_t{found->second.words} * sizeof(std::uint32_t);
+
+		if (::crc32(0, payload, static_cast<uInt>(bytes)) != found->second.crc)
+		{
+			return false;
+		}
+
+		words.resize(found->second.words);
+		std::memcpy(words.data(), payload, bytes);
+		return true;
+	}
+
+	void add(const key& name, const std::vector<std::uint32_t>& words)
+	{
+		const std::uint64_t bytes = sizeof(entry_header) + std::uint64_t{words.size()} * sizeof(std::uint32_t);
+		std::unique_lock lock(m_mutex);
+		// REWINDBOX_SPIRV_CAP_636: the batch flush() is writing and, for an empty file, the header count too.
+		const std::uint64_t header = m_valid_bytes == 0 && m_flushing_bytes == 0 ? sizeof(file_header) : 0;
+
+		if (m_path.empty() || words.empty() || words.size() > max_entry_words ||
+			m_valid_bytes + m_flushing_bytes + header + m_pending_bytes + bytes > max_file_bytes || m_written.contains(name))
+		{
+			return;
+		}
+
+		// A CRC failure in find() brings a damaged entry here: the new copy is the last one.
+		if (m_pending.try_emplace(name, words).second)
+		{
+			m_pending_bytes += bytes;
+		}
+	}
+
+	// Appends what add() kept. A failed write leaves the valid prefix as it was.
+	void flush() noexcept
+	{
+		std::lock_guard writer(m_write_mutex);
+		std::unordered_map<key, std::vector<std::uint32_t>, key_hash> batch;
+		std::uint64_t valid_bytes;
+		std::string path;
+
+		{
+			std::unique_lock lock(m_mutex);
+			batch.swap(m_pending);
+			valid_bytes = m_valid_bytes;
+			path = m_path;
+			// REWINDBOX_SPIRV_CAP_636: reserved until the write ends, so add() keeps counting these bytes.
+			m_flushing_bytes = batch.empty() ? 0 : m_pending_bytes + (valid_bytes == 0 ? sizeof(file_header) : 0);
+			m_pending_bytes = 0;
+		}
+
+		if (batch.empty() || path.empty())
+		{
+			std::unique_lock lock(m_mutex);
+			m_flushing_bytes = 0;
+			return;
+		}
+
+		const int file = ::open(path.c_str(), O_WRONLY | O_CREAT | O_CLOEXEC, 0644);
+
+		if (file < 0)
+		{
+			std::unique_lock lock(m_mutex);
+			m_flushing_bytes = 0;
+			return;
+		}
+
+		bool good = ::ftruncate(file, static_cast<off_t>(valid_bytes)) == 0 && ::lseek(file, static_cast<off_t>(valid_bytes), SEEK_SET) >= 0;
+
+		if (good && !valid_bytes)
+		{
+			file_header header{};
+			std::memcpy(header.magic, file_magic, sizeof(file_magic));
+			header.revision = environment_revision;
+			good = write_all(file, &header, sizeof(header));
+			valid_bytes = sizeof(header);
+		}
+
+		std::vector<key> written;
+
+		for (const auto& [name, words] : batch)
+		{
+			if (!good)
+			{
+				break;
+			}
+
+			const std::size_t bytes = words.size() * sizeof(std::uint32_t);
+
+			// REWINDBOX_SPIRV_CAP_636: the bound holds at the write too, whatever the accounting before it.
+			if (valid_bytes + sizeof(entry_header) + bytes > max_file_bytes)
+			{
+				continue;
+			}
+
+			entry_header entry;
+			std::memcpy(entry.name, name.data(), name.size());
+			entry.words = static_cast<std::uint32_t>(words.size());
+			entry.crc = static_cast<std::uint32_t>(::crc32(0, reinterpret_cast<const Bytef*>(words.data()), static_cast<uInt>(bytes)));
+			good = write_all(file, &entry, sizeof(entry)) && write_all(file, words.data(), bytes);
+
+			if (good)
+			{
+				valid_bytes += sizeof(entry) + bytes;
+				written.push_back(name);
+			}
+		}
+
+		if (!good)
+		{
+			(void)!::ftruncate(file, static_cast<off_t>(valid_bytes));
+		}
+
+		::close(file);
+		std::unique_lock lock(m_mutex);
+		m_valid_bytes = valid_bytes;
+		m_flushing_bytes = 0;
+		m_written.insert(written.begin(), written.end());
+	}
+
+	void close() noexcept
+	{
+		flush();
+		std::unique_lock lock(m_mutex);
+		unmap();
+		m_path.clear();
+		m_pending.clear();
+		m_written.clear();
+		m_pending_bytes = 0;
+		m_flushing_bytes = 0;
+		m_valid_bytes = 0;
+	}
+};
+
+inline store& instance() noexcept
+{
+	static store global;
+	return global;
+}
+}
diff --git a/rpcs3/ios/IOSSpuNoopSpin.h b/rpcs3/ios/IOSSpuNoopSpin.h
new file mode 100644
index 0000000..4162bfa
--- /dev/null
+++ b/rpcs3/ios/IOSSpuNoopSpin.h
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_SPU_NOOP_SPIN_WAIT_627: Build 624 logs (PID 1893, Black Ops II). The six
+// CellSpursKernel threads take 5.0-5.3 cores in the menus and 3.3-4.0 in a match, on a
+// device with two performance cores, while they complete 5-7 million PUTLLC per 5 s
+// window with almost no failure (0-4,900) and SPUWAIT551 getllar_poll=0.
+// With Accurate SPU Reservations off, a PUTLLC that writes back the data it read returns
+// at the top of do_putllc() with raddr = 0, without touching the reservation. The next
+// GETLLAR then finds no reservation and takes the plain read path: everything RPCS3 has
+// against SPU polling (the spin detection, the passive wait on the reservation notifier,
+// SPU GETLLAR Busy Waiting Percentage, SPU Spin Timing) sits in the "raddr == addr"
+// branch and is never reached. The polling loop GETLLAR, no-op PUTLLC, GETLLAR runs at about
+// 4 us per round on every thread, on lines of the title's own job queues (FREEZE_DUMP:
+// 0x2e20880, 0x2e20c00, several lines per thread).
+//
+// A thread is polling once it has completed `streak_threshold` no-op PUTLLC in a row, each
+// within `spin_gap_ns` of the previous one, on lines that keep their reservation time. Real
+// progress does not always reach do_putllc(): with this setting's reservation mode the
+// recognised 16-byte atomics are inlined by the recompiler (putllc16_pattern) and PUTLLUC has
+// its own path. So the tracker keeps the last `polled_lines` lines with their times: a line
+// whose time moved, or one it has not seen, restarts the streak, and a loop over more lines
+// than that never reaches a wait.
+//
+// A polling thread's next no-op PUTLLC sleeps on the reservation notifier of the line before
+// it returns, for a bounded time that doubles from first_wait_ns to max_wait_ns, unless the
+// line already changed. The PUTLLC has stored nothing and its result is decided: the sleep is
+// what a host preemption of the SPU thread at that point would be, and the next GETLLAR reads
+// as usual. A wait that ends early restarts the streak. One that times out leaves
+// `rearm_rounds` rounds before the next one, and that spacing bounds the two costs left:
+// - A wrong guess: work the tracker cannot see, on a line it does not poll, in rounds shorter
+//   than spin_gap_ns. A 40 us round loses at most a third of its time, not five sixths.
+// - The wait is on one line of the loop, and direct reservation stores do not always notify
+//   (docs/PROJECT_RULES.md; the inlined PUTLLC16 notifies another word): the bound, not the
+//   notifier, is what ends it. One pass over the polled lines holds at most one wait, so a new
+//   job waits at most max_wait_ns more, plus the pass.
+// At max_wait_ns and 4.3 us per round a thread makes about 41,000 rounds per second instead of
+// 230,000 and uses about 18 % of a core. Model figures: the device decides.
+// The tracker lives in a thread_local of SPUThread.cpp (spu_thread's layout is a codegen
+// input), and process_mfc_cmd, the input of the reused full-queue harness, does not change.
+namespace rpcs3::ios::spu_noop_spin
+{
+inline constexpr std::uint32_t streak_threshold = 64;      // about 280 us of polling at 4.3 us per round
+inline constexpr std::uint32_t rearm_rounds = 8;           // rounds between two waits, at least polled_lines
+inline constexpr std::size_t polled_lines = 8;             // lines one polling loop can watch
+inline constexpr std::uint64_t spin_gap_ns = 50'000;       // a longer gap means real work ran in between
+inline constexpr std::uint64_t first_wait_ns = 20'000;
+inline constexpr std::uint64_t max_wait_ns = 160'000;
+
+class tracker
+{
+	struct polled_line
+	{
+		std::uint32_t addr = 0;
+		std::uint64_t rtime = 0;
+	};
+
+	std::array<polled_line, polled_lines> m_lines{};
+	std::size_t m_line_count = 0;
+	std::uint64_t m_last_tick = 0;
+	std::uint64_t m_wait_ns = first_wait_ns;
+	std::uint32_t m_streak = 0;
+
+	void restart() noexcept
+	{
+		m_streak = 0;
+		m_wait_ns = first_wait_ns;
+	}
+
+public:
+	// do_putllc(): a PUTLLC on `addr`, whose reservation time the thread read as `rtime`, wrote
+	// nothing back and completed at `now` (ticks).
+	void on_noop(std::uint64_t now, std::uint64_t gap_ticks, std::uint32_t addr, std::uint64_t rtime) noexcept
+	{
+		if (now - m_last_tick > gap_ticks)
+		{
+			restart();
+			m_line_count = 0;
+		}
+
+		m_last_tick = now;
+
+		for (std::size_t i = 0; i < m_line_count; i++)
+		{
+			if (m_lines[i].addr != addr)
+			{
+				continue;
+			}
+
+			if (m_lines[i].rtime != rtime)
+			{
+				m_lines[i].rtime = rtime; // somebody wrote it, possibly this thread with no PUTLLC seen here
+				restart();
+			}
+			else if (m_streak < streak_threshold)
+			{
+				m_streak++;
+			}
+
+			return;
+		}
+
+		// Not the loop of this streak, or not yet.
+		m_line_count = m_line_count < polled_lines ? m_line_count + 1 : 1;
+		m_lines[m_line_count - 1] = {addr, rtime};
+		restart();
+	}
+
+	// do_putllc(): a PUTLLC that changes data; the thread is working.
+	void on_progress() noexcept
+	{
+		restart();
+	}
+
+	// The thread is polling: wait now.
+	bool due() const noexcept
+	{
+		return m_streak >= streak_threshold;
+	}
+
+	// The bound of the wait about to start; the next one doubles it.
+	std::uint64_t next_wait_ns() noexcept
+	{
+		const std::uint64_t value = m_wait_ns;
+		m_wait_ns = value * 2 < max_wait_ns ? value * 2 : max_wait_ns;
+		return value;
+	}
+
+	// After the wait, at `now` (ticks): the sleep is not a gap. A wait that ended before half
+	// of its bound was woken by a write to the line, or never started: the thread polls again
+	// from the start. Otherwise it runs rearm_rounds rounds before the next wait.
+	void on_woken(std::uint64_t now, std::uint64_t waited_ns, std::uint64_t bound_ns) noexcept
+	{
+		m_last_tick = now;
+
+		if (waited_ns < bound_ns / 2)
+		{
+			restart();
+		}
+		else
+		{
+			m_streak = streak_threshold - rearm_rounds;
+		}
+	}
+};
+}
diff --git a/rpcs3/ios/IOSSpuObjectBindings.h b/rpcs3/ios/IOSSpuObjectBindings.h
new file mode 100644
index 0000000..e2ccd63
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectBindings.h
@@ -0,0 +1,355 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+// REWINDBOX_SPU_DIRECT_OBJECT_HIT_660: Black Ops II links 8,700-8,800 SPU blocks at the first
+// transition of each boot, every one of them a hit of the persistent object cache (IPA 657,
+// Core 655, session 2 window 5: 8,793 blocks). A hit still builds the whole IR of the block,
+// only to name the symbols the cached object needs, then throws it away: about 0.19 ms of
+// spu_build per block next to 0.18 ms of object load.
+//
+// The object itself already names what it needs. Its undefined symbols are exactly the names
+// the IR declared and mapped on the engine:
+// - the helper of every call("name", function, ...) of the block translator (CPUTranslator.h
+//   call() maps the literal name to that function), plus spu_dispatcher, spu_timebase_offs and
+//   spu_segment_base, each mapped by one line of SPULLVMRecompiler.cpp;
+// - "<module name>-pp-<N>", one fresh branch patchpoint (make_branch_patchpoint(), data 0) each.
+// A hit whose undefined symbols are all of these links the object directly: the bindings are the
+// same expressions the IR path maps under the same names, the patchpoints are fresh stubs of the
+// same kind. Anything else (a name the table does not know, libm, memcpy, outline atomics, an
+// absolute global, a duplicate, a malformed or out-of-bound patchpoint, a second definition, a
+// missing entry, a failed copy of the object) leaves the object to the IR path of the same
+// compile() call, exactly as before.
+//
+// Name resolution is MCJIT's and the same on both paths (LLVM 18 and 20, checked on the host): an
+// undefined name of an object being loaded resolves first from RuntimeDyld's own table, which holds
+// every named definition of the objects already loaded in this engine, local and internal ones
+// included; then from the engine's resolver (the global map, where the bindings are, then that
+// table); last from the memory manager (MemoryManager1/2::findSymbol in Utilities/JITLLVM.cpp:
+// process symbols, then make_null_function()). The global map does not come first: a binding
+// decides a name only because no object of this engine defines that name. None does: a block
+// object defines its entry (its only global) and the locals spu_test_state, __spu-null,
+// __spu-cx*, __spu-fx*, __unnamed_N and the $x/$d mapping symbols; the LLVM interpreter object
+// defines spu_interpreter, spu_<MNEMONIC>[_<hex>], spu_ret and __unnamed_N. No table name and no
+// "<hash>-pp-<N>" name is among them, and the host audit (spu_direct_hit660_test.py) fails if one
+// of these names gets a body, an initializer or an internal or private linkage anywhere in
+// SPULLVMRecompiler.cpp or CPUTranslator.h. The IR hit path links the same object under the same
+// names in the same engine, with exactly this precedence too.
+//
+// This header only classifies a symbol list against a table of names. It has no LLVM or RPCS3
+// dependency so that the host test compiles it as it is.
+namespace rpcs3::ios::spu_direct_hit
+{
+inline std::atomic<bool> enabled{false}; // experimental.spu_direct_object_hits
+
+enum class reason : std::uint32_t
+{
+	accepted,
+	object_unreadable,    // the object does not parse or is not for this engine's architecture
+	symbol_unreadable,    // a symbol name or flags could not be read
+	symbol_bound,         // more symbols than max_symbols
+	absolute_global,      // a global absolute symbol (same rule as JITMinimalObject.h)
+	unknown_symbol,       // an undefined name that is neither a table name nor a patchpoint of this module
+	duplicate_symbol,     // an undefined name listed twice
+	malformed_patchpoint, // "<entry>-pp-" followed by anything but the regenerated decimal number
+	patchpoint_bound,     // a patchpoint number or count above the bounds
+	foreign_definition,   // a defined global symbol that is not the entry
+	missing_entry,        // the entry is not defined
+	duplicate_entry,      // the entry is defined twice
+	null_binding,         // a table expression evaluated to 0 in this process
+	copy_failed,          // the copy of the object handed to MCJIT could not be allocated
+	add_rejected,         // jit_minimal_object::add refused the object before loading it
+	count
+};
+
+inline constexpr std::size_t reason_count = static_cast<std::size_t>(reason::count);
+
+inline constexpr std::array<std::string_view, reason_count> reason_names{
+	"accepted", "object_unreadable", "symbol_unreadable", "symbol_bound", "absolute_global", "unknown_symbol",
+	"duplicate_symbol", "malformed_patchpoint", "patchpoint_bound", "foreign_definition", "missing_entry",
+	"duplicate_entry", "null_binding", "copy_failed", "add_rejected"};
+static_assert(!reason_names[reason_count - 1].empty(), "one name per reason");
+
+struct symbol
+{
+	std::string_view name;
+	bool readable = true;   // name and flags could be read
+	bool undefined = false; // SF_Undefined
+	bool absolute = false;  // SF_Absolute
+	bool global = false;    // SF_Global
+};
+
+struct plan
+{
+	reason result = reason::accepted;
+	std::vector<std::uint32_t> named;       // indices into the binding table, ascending, each once
+	std::vector<std::uint32_t> patchpoints; // patchpoint numbers, ascending, each once
+	std::string_view offending;             // the symbol that decided a rejection (a view of the input: copy it)
+};
+
+inline constexpr std::size_t max_symbols = 65536;
+inline constexpr std::uint32_t max_patchpoint = (1u << 20) - 1;
+
+// The direct path never allocates more stubs than this for one block. The IR path allocates one per
+// tail_chunk(nullptr) of each emitted chunk; an object above the bound keeps the IR path.
+constexpr std::size_t patchpoint_limit(std::size_t guest_words) noexcept
+{
+	return std::min<std::size_t>(guest_words * 16 + 64, std::size_t{max_patchpoint} + 1);
+}
+
+// name == entry + "-pp-" + decimal(id) exactly, the way fmt::format("%s-pp-%u", m_hash, id) wrote it:
+// no sign, no leading zero, no suffix, a value that fits 32 bits.
+constexpr bool parse_patchpoint(std::string_view entry, std::string_view name, std::uint32_t& id) noexcept
+{
+	constexpr std::string_view infix = "-pp-";
+	if (name.size() <= entry.size() + infix.size() || name.substr(0, entry.size()) != entry ||
+		name.substr(entry.size(), infix.size()) != infix)
+	{
+		return false;
+	}
+
+	const std::string_view digits = name.substr(entry.size() + infix.size());
+	std::uint32_t value = 0;
+	const auto [end, error] = std::from_chars(digits.data(), digits.data() + digits.size(), value, 10);
+	if (error != std::errc() || end != digits.data() + digits.size())
+	{
+		return false;
+	}
+
+	char regenerated[16]{};
+	const auto [last, error2] = std::to_chars(regenerated, regenerated + sizeof(regenerated), value, 10);
+	if (error2 != std::errc() || std::string_view(regenerated, static_cast<std::size_t>(last - regenerated)) != digits)
+	{
+		return false;
+	}
+
+	id = value;
+	return true;
+}
+
+constexpr bool is_patchpoint_name(std::string_view entry, std::string_view name) noexcept
+{
+	constexpr std::string_view infix = "-pp-";
+	return name.size() >= entry.size() + infix.size() && name.substr(0, entry.size()) == entry &&
+		name.substr(entry.size(), infix.size()) == infix;
+}
+
+// Every undefined, named symbol must be a table name or a patchpoint of `entry`; the entry must be the
+// only defined global symbol, defined once. Undefined symbols without a name are ignored, as
+// JITMinimalObject.h ignores them.
+inline plan classify(std::string_view entry, std::span<const symbol> symbols, std::span<const std::string_view> table,
+	std::size_t max_patchpoints)
+{
+	plan result;
+	const auto reject = [&](reason why, std::string_view name)
+	{
+		result.result = why;
+		result.offending = name;
+		result.named.clear();
+		result.patchpoints.clear();
+		return result;
+	};
+
+	if (entry.empty() || symbols.size() > max_symbols)
+	{
+		return reject(entry.empty() ? reason::missing_entry : reason::symbol_bound, {});
+	}
+
+	std::size_t entries = 0;
+	std::vector<bool> seen(table.size(), false);
+
+	for (const symbol& sym : symbols)
+	{
+		if (!sym.readable)
+		{
+			return reject(reason::symbol_unreadable, sym.name);
+		}
+
+		if (sym.absolute && sym.global)
+		{
+			return reject(reason::absolute_global, sym.name);
+		}
+
+		if (!sym.undefined)
+		{
+			if (sym.name == entry)
+			{
+				// MCJIT finds the entry by name among the global symbols of the loaded objects.
+				if (!sym.global)
+				{
+					return reject(reason::missing_entry, sym.name);
+				}
+
+				if (++entries > 1)
+				{
+					return reject(reason::duplicate_entry, sym.name);
+				}
+			}
+			else if (sym.global)
+			{
+				return reject(reason::foreign_definition, sym.name);
+			}
+
+			continue;
+		}
+
+		if (sym.name.empty())
+		{
+			continue;
+		}
+
+		const auto found = std::find(table.begin(), table.end(), sym.name);
+		if (found != table.end())
+		{
+			const auto index = static_cast<std::size_t>(found - table.begin());
+			if (seen[index])
+			{
+				return reject(reason::duplicate_symbol, sym.name);
+			}
+
+			seen[index] = true;
+			continue;
+		}
+
+		if (!is_patchpoint_name(entry, sym.name))
+		{
+			return reject(reason::unknown_symbol, sym.name);
+		}
+
+		std::uint32_t id = 0;
+		if (!parse_patchpoint(entry, sym.name, id))
+		{
+			return reject(reason::malformed_patchpoint, sym.name);
+		}
+
+		if (id > max_patchpoint || result.patchpoints.size() >= max_patchpoints)
+		{
+			return reject(reason::patchpoint_bound, sym.name);
+		}
+
+		result.patchpoints.push_back(id);
+	}
+
+	if (!entries)
+	{
+		return reject(reason::missing_entry, entry);
+	}
+
+	std::sort(result.patchpoints.begin(), result.patchpoints.end());
+	if (std::adjacent_find(result.patchpoints.begin(), result.patchpoints.end()) != result.patchpoints.end())
+	{
+		return reject(reason::duplicate_symbol, {});
+	}
+
+	for (std::size_t index = 0; index < seen.size(); ++index)
+	{
+		if (seen[index])
+		{
+			result.named.push_back(static_cast<std::uint32_t>(index));
+		}
+	}
+
+	return result;
+}
+
+// The fallback notice of compile() ("SPUDIRECT660 fallback <reason>: <symbol> (<module>)"): the first 8
+// hits of each reason in this process, then every 256th, as should_emit_spu_compile_diagnostic() in
+// SPULLVMRecompiler.cpp limits its diagnostics. An accepted hit formats nothing.
+inline bool should_log_fallback(reason why) noexcept
+{
+	static std::array<std::atomic<std::uint64_t>, reason_count> seen{};
+	const auto index = static_cast<std::size_t>(why);
+	if (why == reason::accepted || index >= reason_count)
+	{
+		return false;
+	}
+
+	const std::uint64_t current = seen[index].fetch_add(1, std::memory_order_relaxed) + 1;
+	return current <= 8 || (current % 256) == 0;
+}
+
+// Per-window counters for COREPROF SPUDIRECT660 (rpcs3/ios/RPCS3IOSPerformance.cpp). Ticks are TSC ticks.
+struct window_counters
+{
+	std::uint64_t direct = 0, direct_bytes = 0;     // blocks linked directly, their object bytes
+	std::uint64_t direct_ticks = 0, direct_max_ticks = 0; // compile() start to the published entry
+	std::uint64_t classify_ticks = 0;               // object parse, classification and bindings
+	std::uint64_t link_ticks = 0;                   // add + finalize of the object
+	std::uint64_t bindings = 0, patchpoints = 0;    // table bindings and patchpoint stubs of those blocks
+	std::uint64_t failures = 0;                     // link/finalize/entry failures, handled as on the IR path
+	std::array<std::uint64_t, reason_count> fallbacks{}; // hits left to the IR path, by reason
+};
+
+class counters
+{
+	std::atomic<std::uint64_t> m_direct{0}, m_direct_bytes{0}, m_direct_ticks{0}, m_direct_max_ticks{0};
+	std::atomic<std::uint64_t> m_classify_ticks{0}, m_link_ticks{0}, m_bindings{0}, m_patchpoints{0}, m_failures{0};
+	std::array<std::atomic<std::uint64_t>, reason_count> m_fallbacks{};
+
+public:
+	void record_direct(std::uint64_t bytes, std::uint64_t ticks, std::uint64_t classify_ticks, std::uint64_t link_ticks,
+		std::uint64_t bindings, std::uint64_t patchpoints) noexcept
+	{
+		m_direct.fetch_add(1, std::memory_order_relaxed);
+		m_direct_bytes.fetch_add(bytes, std::memory_order_relaxed);
+		m_direct_ticks.fetch_add(ticks, std::memory_order_relaxed);
+		m_classify_ticks.fetch_add(classify_ticks, std::memory_order_relaxed);
+		m_link_ticks.fetch_add(link_ticks, std::memory_order_relaxed);
+		m_bindings.fetch_add(bindings, std::memory_order_relaxed);
+		m_patchpoints.fetch_add(patchpoints, std::memory_order_relaxed);
+		std::uint64_t seen = m_direct_max_ticks.load(std::memory_order_relaxed);
+		while (ticks > seen && !m_direct_max_ticks.compare_exchange_weak(seen, ticks, std::memory_order_relaxed))
+		{
+		}
+	}
+
+	void record_fallback(reason why) noexcept
+	{
+		const auto index = static_cast<std::size_t>(why);
+		if (index < reason_count)
+		{
+			m_fallbacks[index].fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	void record_failure() noexcept
+	{
+		m_failures.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	window_counters take_window() noexcept
+	{
+		window_counters result;
+		result.direct = m_direct.exchange(0, std::memory_order_relaxed);
+		result.direct_bytes = m_direct_bytes.exchange(0, std::memory_order_relaxed);
+		result.direct_ticks = m_direct_ticks.exchange(0, std::memory_order_relaxed);
+		result.direct_max_ticks = m_direct_max_ticks.exchange(0, std::memory_order_relaxed);
+		result.classify_ticks = m_classify_ticks.exchange(0, std::memory_order_relaxed);
+		result.link_ticks = m_link_ticks.exchange(0, std::memory_order_relaxed);
+		result.bindings = m_bindings.exchange(0, std::memory_order_relaxed);
+		result.patchpoints = m_patchpoints.exchange(0, std::memory_order_relaxed);
+		result.failures = m_failures.exchange(0, std::memory_order_relaxed);
+		for (std::size_t index = 0; index < reason_count; ++index)
+		{
+			result.fallbacks[index] = m_fallbacks[index].exchange(0, std::memory_order_relaxed);
+		}
+		return result;
+	}
+};
+
+inline counters& stats() noexcept
+{
+	static counters instance;
+	return instance;
+}
+}
diff --git a/rpcs3/ios/IOSSpuObjectPrefetch.h b/rpcs3/ios/IOSSpuObjectPrefetch.h
new file mode 100644
index 0000000..62dc2dd
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectPrefetch.h
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <sys/qos.h>
+#endif
+
+// REWINDBOX_SPU_OBJECT_PREFETCH_616: Call of Duty: Black Ops II (BLES01717),
+// Build 614 iPhone logs (PID 64664, multiplayer session 3). At the start of a
+// match one 5 s window opens 7,162 cached SPU objects (JITPROF spu_cache_read
+// 7,162 calls, 4,300.8 ms, 21.2 MB inflated, 0.6 ms per object of about 3 KB):
+// the cost of opening thousands of small files on the compile path, not their
+// size. The 2,038.7 ms frame 2388 of that window has no blocking pipeline and
+// no LLVM budget wait; the 1,121.4 ms frame 3537 (window 17) also falls in a
+// burst of 613 object reads. The objects are already on disk: this module reads
+// the bytes of the title's object directory into memory on one utility-class
+// thread from the runtime's creation (menus, loading), newest objects first and
+// within a byte budget. A compile thread that needs an object takes its bytes
+// once (they leave the store) and inflates and validates them exactly as it
+// would after reading the file; an object not read yet is claimed and read from
+// the disk as before, never awaited. Same bytes, same validation, same link:
+// guest code is unchanged. Title scoped (ios/IOSTitleLevers.h); the store is
+// emptied when emulation stops.
+namespace rpcs3::ios::spu_object_prefetch
+{
+inline constexpr std::uint64_t max_resident_bytes = 48ull << 20;
+inline constexpr std::uint64_t max_file_bytes = 256ull << 10; // larger objects keep the disk path
+inline constexpr std::uint64_t min_file_bytes = 18;           // smallest gzip member
+
+struct candidate
+{
+	std::string name;
+	std::uint64_t bytes = 0;
+	std::int64_t mtime = 0;
+};
+
+// Compressed objects (".gz") within the per-file bounds, newest first (then by
+// name), as long as they fit in the budget.
+inline std::vector<candidate> plan(std::vector<candidate> entries, std::uint64_t budget = max_resident_bytes,
+	std::uint64_t file_limit = max_file_bytes)
+{
+	std::erase_if(entries, [file_limit](const candidate& entry)
+	{
+		const std::string_view name = entry.name;
+		return name.size() <= 3 || name.substr(name.size() - 3) != ".gz" || entry.bytes < min_file_bytes || entry.bytes > file_limit;
+	});
+
+	std::sort(entries.begin(), entries.end(), [](const candidate& a, const candidate& b)
+	{
+		return a.mtime != b.mtime ? a.mtime > b.mtime : a.name < b.name;
+	});
+
+	std::vector<candidate> chosen;
+	std::uint64_t total = 0;
+
+	for (candidate& entry : entries)
+	{
+		if (entry.bytes > budget - total)
+		{
+			continue;
+		}
+
+		total += entry.bytes;
+		chosen.push_back(std::move(entry));
+	}
+
+	return chosen;
+}
+
+// Reads the whole file into `out`; false when it cannot or its size is not `expected`.
+using reader_fn = std::function<bool(const std::string& path, std::uint64_t expected, std::vector<unsigned char>& out)>;
+
+struct window_counters
+{
+	std::uint64_t hits = 0, hit_bytes = 0;   // objects served from memory
+	std::uint64_t claimed = 0;               // planned objects a compile thread read from disk first
+	std::uint64_t dropped = 0;               // read, but claimed meanwhile
+	std::uint64_t read = 0, read_bytes = 0, read_us = 0, failures = 0;
+};
+
+struct gauges
+{
+	bool active = false, done = false;
+	std::uint64_t planned = 0, planned_bytes = 0, pending = 0, resident = 0, resident_bytes = 0;
+};
+
+class store
+{
+	mutable std::mutex m_mutex;
+	std::unordered_map<std::string, std::vector<unsigned char>> m_ready; // full path of the ".gz" object
+	std::unordered_set<std::string> m_pending;                         // planned, neither read nor claimed
+	std::uint64_t m_resident_bytes = 0, m_planned = 0, m_planned_bytes = 0;
+	std::thread m_worker;
+	std::atomic<bool> m_stop{false}, m_active{false}, m_done{false};
+	window_counters m_window{};
+
+public:
+	store() = default;
+	store(const store&) = delete;
+	store& operator=(const store&) = delete;
+	~store() { stop(); }
+
+	void start(std::string directory, std::vector<candidate> chosen, reader_fn reader)
+	{
+		stop();
+
+		{
+			std::lock_guard lock(m_mutex);
+			m_planned = chosen.size();
+			m_planned_bytes = 0;
+
+			for (const candidate& entry : chosen)
+			{
+				m_pending.insert(directory + entry.name);
+				m_planned_bytes += entry.bytes;
+			}
+		}
+
+		m_stop.store(false);
+		m_done.store(chosen.empty());
+		m_active.store(true);
+
+		if (chosen.empty())
+		{
+			return;
+		}
+
+		m_worker = std::thread([this, directory = std::move(directory), chosen = std::move(chosen), reader = std::move(reader)]()
+		{
+#if defined(__APPLE__)
+			pthread_setname_np("SPU object prefetch");
+			pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#endif
+			for (const candidate& entry : chosen)
+			{
+				if (m_stop.load(std::memory_order_relaxed))
+				{
+					break;
+				}
+
+				std::string path = directory + entry.name;
+
+				{
+					std::lock_guard lock(m_mutex);
+					if (!m_pending.contains(path))
+					{
+						continue; // claimed by a compile thread
+					}
+				}
+
+				std::vector<unsigned char> bytes;
+				const auto started = std::chrono::steady_clock::now();
+				const bool ok = reader(path, entry.bytes, bytes) && bytes.size() == entry.bytes;
+				const auto elapsed = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - started).count());
+
+				std::lock_guard lock(m_mutex);
+				m_window.read_us += elapsed;
+
+				if (!m_pending.erase(path))
+				{
+					m_window.dropped++;
+					continue;
+				}
+
+				if (!ok)
+				{
+					m_window.failures++;
+					continue;
+				}
+
+				m_window.read++;
+				m_window.read_bytes += bytes.size();
+				m_resident_bytes += bytes.size();
+				m_ready.emplace(std::move(path), std::move(bytes));
+			}
+
+			m_done.store(true);
+		});
+	}
+
+	// The prefetched bytes of this ".gz" object, once; nothing when they are
+	// not in memory (the caller reads the file, and the worker will skip it).
+	std::optional<std::vector<unsigned char>> take(const std::string& gz_path)
+	{
+		if (!m_active.load(std::memory_order_relaxed))
+		{
+			return std::nullopt;
+		}
+
+		std::lock_guard lock(m_mutex);
+
+		if (auto found = m_ready.find(gz_path); found != m_ready.end())
+		{
+			std::vector<unsigned char> bytes = std::move(found->second);
+			m_ready.erase(found);
+			m_resident_bytes -= bytes.size();
+			m_window.hits++;
+			m_window.hit_bytes += bytes.size();
+			return bytes;
+		}
+
+		if (m_pending.erase(gz_path))
+		{
+			m_window.claimed++;
+		}
+
+		return std::nullopt;
+	}
+
+	// Joins the worker and frees every byte still held.
+	void stop()
+	{
+		m_stop.store(true);
+
+		if (m_worker.joinable())
+		{
+			m_worker.join();
+		}
+
+		m_active.store(false);
+		std::lock_guard lock(m_mutex);
+		m_ready.clear();
+		m_pending.clear();
+		m_resident_bytes = 0;
+		m_planned = 0;
+		m_planned_bytes = 0;
+	}
+
+	window_counters take_window()
+	{
+		std::lock_guard lock(m_mutex);
+		return std::exchange(m_window, window_counters{});
+	}
+
+	gauges current() const
+	{
+		std::lock_guard lock(m_mutex);
+		return {m_active.load(), m_done.load(), m_planned, m_planned_bytes, m_pending.size(), m_ready.size(), m_resident_bytes};
+	}
+};
+
+inline store& instance()
+{
+	static store s_store;
+	return s_store;
+}
+}
diff --git a/rpcs3/ios/IOSTextureCacheProfile.h b/rpcs3/ios/IOSTextureCacheProfile.h
new file mode 100644
index 0000000..b0964fd
--- /dev/null
+++ b/rpcs3/ios/IOSTextureCacheProfile.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_TEXCACHE_PROFILE_621: what the Vulkan texture cache did in each
+// performance window. Build 620 Black Ops II multiplayer spent 6-7 ms per frame
+// in the RSX texture stage and its resident texture memory kept growing, but no
+// journal line said whether that came from uploads, cache misses, flushes, surface
+// copies for samplers or memory never released. The RSX thread adds the texture
+// cache's own per-frame statistics just before they are reset at the end of each
+// frame, counts the temporary subresource copies the draw path makes for samplers,
+// and counts the depth/color feedback barriers of render targets (Assassin's Creed
+// torch passages). The performance reporter exchanges the sums once per window
+// into one COREPROF TEXCACHE621 line. Counting changes no texture, copy, barrier,
+// eviction or cache decision.
+namespace rpcs3::ios::texture_cache_profile
+{
+struct window_counters
+{
+	std::atomic<std::uint64_t> frames{0};               // frame ends sampled
+	std::atomic<std::uint64_t> upload_calls{0};         // texture upload calls (cache lookups for sampling)
+	std::atomic<std::uint64_t> upload_misses{0};        // of which needed a new upload
+	std::atomic<std::uint64_t> cache_misses{0};         // flushes that missed (data had to be read back)
+	std::atomic<std::uint64_t> flushes{0};              // flush requests (GPU to guest memory)
+	std::atomic<std::uint64_t> hard_faults{0};          // unavoidable hard faults
+	std::atomic<std::uint64_t> copies_elided{0};        // copies the cache avoided
+	std::atomic<std::uint64_t> temp_subresources{0};    // sampler copies of surface regions made by the draw path
+	std::atomic<std::uint64_t> temp_failures{0};        // of which failed (out of memory)
+	std::atomic<std::uint64_t> feedback_barriers{0};    // render_target::texture_barrier inserted
+	std::atomic<std::uint64_t> feedback_skipped{0};     // back-to-back read-only depth barriers skipped
+	std::atomic<std::uint64_t> post_barriers{0};        // render_target::post_texture_barrier inserted
+	std::atomic<std::uint64_t> post_skipped{0};         // fall-out barriers elided (no write in the chain)
+	// REWINDBOX_DEPTH_TEST_OFF_READ_ONLY_652: of the skips above, those only the depth-test-off rule allowed.
+	std::atomic<std::uint64_t> feedback_skipped_test_off{0};
+	std::atomic<std::uint64_t> post_skipped_test_off{0};
+	// Gauges: the last frame end of the window, and the window peak.
+	std::atomic<std::uint64_t> texture_bytes{0}, texture_bytes_peak{0};
+	std::atomic<std::uint64_t> temp_bytes{0}, temp_bytes_peak{0};
+	std::atomic<std::uint64_t> unreleased{0};
+};
+
+inline window_counters counters{};
+
+inline void add(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+inline void raise(std::atomic<std::uint64_t>& peak, std::uint64_t value) noexcept
+{
+	auto current = peak.load(std::memory_order_relaxed);
+	while (value > current && !peak.compare_exchange_weak(current, value, std::memory_order_relaxed))
+	{
+	}
+}
+
+struct frame_statistics
+{
+	std::uint64_t upload_calls = 0, upload_misses = 0, cache_misses = 0, flushes = 0, hard_faults = 0, copies_elided = 0;
+	std::uint64_t texture_bytes = 0, temp_bytes = 0, unreleased = 0;
+};
+
+// Called by the RSX thread once per frame, before the cache resets its statistics.
+inline void on_frame_end(const frame_statistics& s) noexcept
+{
+	auto& c = counters;
+	add(c.frames);
+	add(c.upload_calls, s.upload_calls);
+	add(c.upload_misses, s.upload_misses);
+	add(c.cache_misses, s.cache_misses);
+	add(c.flushes, s.flushes);
+	add(c.hard_faults, s.hard_faults);
+	add(c.copies_elided, s.copies_elided);
+	c.texture_bytes.store(s.texture_bytes, std::memory_order_relaxed);
+	c.temp_bytes.store(s.temp_bytes, std::memory_order_relaxed);
+	c.unreleased.store(s.unreleased, std::memory_order_relaxed);
+	raise(c.texture_bytes_peak, s.texture_bytes);
+	raise(c.temp_bytes_peak, s.temp_bytes);
+}
+
+// A temporary subresource the draw path asked the cache for; `ok` is false when it failed.
+inline void on_temporary_subresource(bool ok) noexcept
+{
+	add(counters.temp_subresources);
+	if (!ok) add(counters.temp_failures);
+}
+}
diff --git a/rpcs3/ios/IOSTextureLookupMemo.h b/rpcs3/ios/IOSTextureLookupMemo.h
new file mode 100644
index 0000000..20660f4
--- /dev/null
+++ b/rpcs3/ios/IOSTextureLookupMemo.h
@@ -0,0 +1,467 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSTextureValidationProfile.h"
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+
+// REWINDBOX_TEXTURE_LOOKUP_MEMO_660: per sampler slot, the last results of an exact texture lookup
+// (texture_cache::upload_texture), reused for an identical lookup in the same validation epoch.
+//
+// IPA 657 (Core 655, PID 10471), Assassin's Creed window 1:42: 904 lookups per frame for 1,515 draws
+// (TEXCACHE621 upload_calls 106,705 over 118 frames), 61 % of them confirmed without hashing because
+// the section had already been validated in the same epoch (OPT559 epoch_skips 64,999), and 5.03 ms
+// of texture stage per sampled frame (RSXFRAME551). A slot is looked up again whenever one of its
+// registers is rewritten (A/B/A alternation, a filter or LOD change), even when the texture is the same.
+//
+// The key is everything the lookup reads from the texture unit: the six raw words of OFFSET, FORMAT,
+// ADDRESS, CONTROL1, IMAGE_RECT and CONTROL3 (rsx::fragment_texture::lookup_words(); a vertex texture
+// has no CONTROL1), the address they resolve to now (IO mappings can change under the same words), and
+// whether the slot is a vertex slot or a BX2 read of the fragment program. The value is the descriptor
+// upload_texture returned, before VKDraw.cpp derives the format, view override and sampler from it (that
+// code still runs on every hit); the validation stamp and binding are set again by every hit.
+//
+// An entry is used only while nothing the exact lookup reads can have changed:
+// - the validation epoch (a lookup repeated in the same epoch never hashes: buffered_section::sync) and
+//   sampler_revision (every advance_epoch: PUT, semaphores, RSX writes, frame end);
+// - a scoped RSX write over the entry's section range (CELL573: revalidate_overlapping drops it through
+//   the memo's own sampler bindings, as it does for the slot bindings);
+// - the section-state generations below, bumped under the cache lock by every change of a section, of
+//   its block or of its image views that the lookup reads (create, reset, destroy, protection, dirty,
+//   context, format, dimensions, pitch, swizzle, view flags, ranges, block size, component order):
+//   local for an uncompressed entry, all for a compressed one (find_texture_from_dimensions does not
+//   filter contexts);
+// - the sampler context generation, bumped by a global sampler refresh (m_samplers_dirty);
+// - for an uncompressed entry, no render target bound at the address, checked at every use (the only
+//   surface store input of an exact local lookup; the write tag is stamped again on every hit).
+// Only direct shader_read views of a section are stored: no render target, no deferred or gathered
+// descriptor, no cyclic reference, nothing created or changed by the lookup that produced it.
+//
+// Self-verification: the first reuse of each (slot, key) of a boot, the first 256 hits of a boot, then
+// one hit in 64 (every hit in verify_all mode) run the full lookup under the same lock and use its
+// result; a difference in the descriptor, the view or the sampler inputs, or a section change during
+// that lookup, is counted, logged once with the slot and key, and turns the memo off for the rest of
+// the boot. This is a spot check, not a bound: one hit clock is shared by all slots, so a stale path
+// that occurs rarely may never be sampled. Correctness rests on the invalidation census above (checked
+// by test/rpcs3_texture_lookup_memo660_test.py); the verification catches what the census would miss
+// systematically, for every texture of the boot at least once.
+namespace rpcs3::ios::texture_lookup_memo
+{
+enum class mode : std::uint32_t
+{
+	off = 0,        // The Core 659 lookup: prepare, upload_texture and finish, three cache locks.
+	active = 1,     // One cache lock per lookup; hits served, sampled verification.
+	verify_all = 2, // One cache lock per lookup; every hit runs the full lookup (counters only).
+};
+
+constexpr std::size_t ways = 4;
+constexpr std::uint64_t verify_first = 256;
+constexpr std::uint64_t verify_period = 64;
+
+constexpr std::uint32_t vertex_flag = 1u;
+constexpr std::uint32_t bx2_flag = 2u;
+
+inline std::atomic<std::uint32_t> boot_mode{0};
+// Set by the first verified difference: no hit for the rest of the boot.
+inline std::atomic<bool> disabled{false};
+inline std::atomic<bool> mismatch_logged{false};
+// Hits of this boot, the sampling clock of the verification.
+inline std::atomic<std::uint64_t> boot_hits{0};
+// The first reuse of each (slot, key) is verified. Always true in the Core; the host test turns it off only to
+// exercise served hits directly (test/rpcs3_texture_lookup_memo660_test.py, mode active_served).
+inline std::atomic<bool> verify_first_reuse{true};
+
+// Section-state generations (see above). Bumped on every title: one atomic increment per change.
+inline std::atomic<std::uint64_t> local_generation{1}, all_generation{1}, context_generation{1};
+
+struct counters_t
+{
+	std::atomic<std::uint64_t> lookups{0}, hits{0}, verified{0}, mismatches{0}, stores{0};
+	std::atomic<std::uint64_t> miss_empty{0}, miss_epoch{0}, miss_revision{0}, miss_range{0}, miss_context{0},
+		miss_section{0}, miss_bound{0}, miss_disabled{0};
+	std::atomic<std::uint64_t> unstored_kind{0}, unstored_changed{0}, unstored_bound{0};
+	std::atomic<std::uint64_t> locks_avoided{0}, cpu_uploads{0};
+	// First reuses of a (slot, key) verified; reuses not checked that way because the key table was full.
+	std::atomic<std::uint64_t> first_reuses{0}, seen_full{0};
+	std::atomic<std::uint64_t> hit_ticks{0}, lookup_ticks{0};
+};
+inline counters_t counters;
+
+inline void count(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+inline mode current_mode() noexcept
+{
+	return static_cast<mode>(boot_mode.load(std::memory_order_relaxed));
+}
+
+// The lookups of load_texture_env take the one-lock path (with or without hits).
+inline bool consolidated() noexcept
+{
+	return current_mode() != mode::off;
+}
+
+// Boot policy (resolve_experimental_policy), after the texture epoch was set and before the RSX
+// thread starts. New generations: no entry survives a boot or a change of epoch_enabled.
+inline void configure(mode value) noexcept
+{
+	boot_mode.store(static_cast<std::uint32_t>(value), std::memory_order_relaxed);
+	disabled.store(false, std::memory_order_relaxed);
+	mismatch_logged.store(false, std::memory_order_relaxed);
+	boot_hits.store(0, std::memory_order_relaxed);
+	local_generation.fetch_add(1, std::memory_order_acq_rel);
+	all_generation.fetch_add(1, std::memory_order_acq_rel);
+	context_generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+// A section change the exact lookup can observe. framebuffer_only: the section's context is
+// framebuffer_storage before and after the change (no uncompressed lookup visits it).
+inline void section_changed(bool framebuffer_only) noexcept
+{
+	all_generation.fetch_add(1, std::memory_order_acq_rel);
+	if (!framebuffer_only)
+	{
+		local_generation.fetch_add(1, std::memory_order_acq_rel);
+	}
+}
+
+// A global sampler refresh (VKGSRender::m_samplers_dirty) drops every entry.
+inline void sampler_refresh() noexcept
+{
+	context_generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+constexpr bool should_verify(mode value, std::uint64_t hit) noexcept
+{
+	return value == mode::verify_all || hit < verify_first || (hit - verify_first) % verify_period == 0;
+}
+
+constexpr std::uint32_t fragment_flags(std::uint32_t bx2_mask, std::uint32_t slot) noexcept
+{
+	return ((bx2_mask >> slot) & 1u) ? bx2_flag : 0u;
+}
+
+struct key
+{
+	std::uint32_t address = 0;            // rsx::get_address(offset, location), resolved at every use
+	std::array<std::uint32_t, 6> words{}; // OFFSET FORMAT ADDRESS CONTROL1 IMAGE_RECT CONTROL3
+	std::uint32_t flags = 0;              // vertex_flag, bx2_flag
+
+	bool operator==(const key&) const = default;
+};
+
+enum class miss : std::uint32_t
+{
+	none = 0, empty, epoch, revision, range, context, section, bound, disabled
+};
+
+inline void count_miss(miss reason) noexcept
+{
+	switch (reason)
+	{
+	case miss::none: break;
+	case miss::empty: count(counters.miss_empty); break;
+	case miss::epoch: count(counters.miss_epoch); break;
+	case miss::revision: count(counters.miss_revision); break;
+	case miss::range: count(counters.miss_range); break;
+	case miss::context: count(counters.miss_context); break;
+	case miss::section: count(counters.miss_section); break;
+	case miss::bound: count(counters.miss_bound); break;
+	case miss::disabled: count(counters.miss_disabled); break;
+	}
+}
+
+// Differences found by a verification (bits of the logged reasons).
+enum difference : std::uint32_t
+{
+	differs_view = 1u,       // image_handle
+	differs_descriptor = 2u, // context, image type, reference address, ranges, deferred operation, flags
+	differs_sampler = 4u,    // format class, texture coordinate transform, samples, cyclic reference
+	differs_state = 8u,      // the full lookup changed a section: the memo would have skipped that change
+};
+
+// Fields a memo hit hands to the sampler setup and to the draw (VKDraw.cpp). Both sides come straight
+// from upload_texture (before the validation stamp); surface_cache_tag is the store's current write tag.
+template <typename Descriptor>
+std::uint32_t compare(const Descriptor& memo, const Descriptor& full) noexcept
+{
+	std::uint32_t result = 0;
+	if (memo.image_handle != full.image_handle)
+	{
+		result |= differs_view;
+	}
+	if (memo.upload_context != full.upload_context || memo.image_type != full.image_type || memo.ref_address != full.ref_address ||
+		memo.surface_cache_tag != full.surface_cache_tag || memo.flag != full.flag ||
+		memo.external_subresource_desc.op != full.external_subresource_desc.op ||
+		memo.ios_validation_range != full.ios_validation_range || !(memo.format_ex == full.format_ex) ||
+		memo.format_ex.texel_remap_control != full.format_ex.texel_remap_control)
+	{
+		result |= differs_descriptor;
+	}
+	// The coordinate transform: scale and bias, and the clamp bounds only when clamping (the constructors
+	// leave the bounds unset and RSXThread.cpp reads them only for a clamped descriptor).
+	using xform_type = std::remove_cvref_t<decltype(memo.texcoord_xform)>;
+	const auto* memo_xform = reinterpret_cast<const unsigned char*>(&memo.texcoord_xform);
+	const auto* full_xform = reinterpret_cast<const unsigned char*>(&full.texcoord_xform);
+	constexpr std::size_t bounds_offset = offsetof(xform_type, clamp_min);
+	constexpr std::size_t flag_offset = offsetof(xform_type, clamp);
+	bool xform_differs = std::memcmp(memo_xform, full_xform, bounds_offset) != 0 || memo.texcoord_xform.clamp != full.texcoord_xform.clamp;
+	if (!xform_differs && memo.texcoord_xform.clamp)
+	{
+		xform_differs = std::memcmp(memo_xform + bounds_offset, full_xform + bounds_offset, flag_offset - bounds_offset) != 0;
+	}
+	if (memo.format_class != full.format_class || memo.samples != full.samples || memo.is_cyclic_reference != full.is_cyclic_reference ||
+		xform_differs)
+	{
+		result |= differs_sampler;
+	}
+	return result;
+}
+
+struct generations
+{
+	std::uint64_t epoch = 0, local = 0, all = 0, context = 0;
+
+	static generations now() noexcept
+	{
+		return { texture_validation::current_epoch(), local_generation.load(std::memory_order_acquire),
+			all_generation.load(std::memory_order_acquire), context_generation.load(std::memory_order_acquire) };
+	}
+
+	bool sections_equal(const generations& other) const noexcept
+	{
+		return local == other.local && all == other.all;
+	}
+};
+
+// Owned by the texture cache. The RSX thread finds, stores and clears entries under the cache reader
+// lock; invalidate() runs under the exclusive lock on any thread and only touches the range bindings.
+template <typename Descriptor, std::size_t Slots>
+class table
+{
+	struct entry
+	{
+		key k{};
+		Descriptor value{};
+		texture_validation::sampler_stamp stamp{};
+		generations gen{};
+		bool compressed = false;
+		bool valid = false;
+		std::uint32_t used = 0;
+	};
+
+	std::array<entry, Slots * ways> m_entries{};
+	texture_validation::sampler_bindings<Slots * ways> m_ranges;
+	std::uint32_t m_clock = 0;
+	// Hashes of the (slot, key) pairs whose first reuse this table has verified (0: free), filled to half at
+	// most; the table lives as long as the texture cache, one boot.
+	static constexpr std::size_t seen_capacity = 4096;
+	std::array<std::uint64_t, seen_capacity> m_seen{};
+	std::size_t m_seen_count = 0;
+
+public:
+	struct found
+	{
+		const Descriptor* value = nullptr;
+		miss reason = miss::empty;
+	};
+
+	// Under the cache reader lock. bound: a render target is bound at k.address (uncompressed only).
+	found find(std::size_t slot, const key& k, bool compressed, bool bound) noexcept
+	{
+		if (disabled.load(std::memory_order_relaxed))
+		{
+			return { nullptr, miss::disabled };
+		}
+
+		for (std::size_t way = 0; way < ways; ++way)
+		{
+			const std::size_t index = slot * ways + way;
+			auto& e = m_entries[index];
+			if (!e.valid || !(e.k == k) || e.compressed != compressed)
+			{
+				continue;
+			}
+
+			const auto now = generations::now();
+			miss reason = miss::none;
+			if (!now.epoch || e.gen.epoch != now.epoch)
+			{
+				reason = miss::epoch;
+			}
+			else if (e.stamp.memory != texture_validation::sampler_revision.load(std::memory_order_acquire))
+			{
+				reason = miss::revision;
+			}
+			else if (!m_ranges.matches(index, e.stamp))
+			{
+				reason = miss::range;
+			}
+			else if (e.gen.context != now.context)
+			{
+				reason = miss::context;
+			}
+			else if (e.gen.local != now.local || (compressed && e.gen.all != now.all))
+			{
+				reason = miss::section;
+			}
+			else if (!compressed && bound)
+			{
+				reason = miss::bound;
+			}
+
+			if (reason != miss::none)
+			{
+				e.valid = false;
+				m_ranges.forget(index);
+				return { nullptr, reason };
+			}
+
+			e.used = ++m_clock;
+			return { &e.value, miss::none };
+		}
+
+		return { nullptr, miss::empty };
+	}
+
+	// Under the cache reader lock, on the RSX thread, for a hit: true the first time this (slot, key) is
+	// reused in this table's life (that hit is verified). Once the key table is half full, false (only the
+	// sampled verification remains) and counted.
+	bool first_reuse(std::size_t slot, const key& k) noexcept
+	{
+		std::uint64_t h = 1469598103934665603ull;
+		const auto mix = [&h](std::uint64_t value) { h = (h ^ value) * 1099511628211ull; };
+		mix(slot);
+		mix(k.address);
+		for (const std::uint32_t word : k.words)
+		{
+			mix(word);
+		}
+		mix(k.flags);
+		if (!h)
+		{
+			h = 1;
+		}
+
+		for (std::size_t probe = 0, at = h % seen_capacity; probe < seen_capacity; ++probe, at = (at + 1) % seen_capacity)
+		{
+			if (m_seen[at] == h)
+			{
+				return false;
+			}
+			if (!m_seen[at])
+			{
+				if (m_seen_count >= seen_capacity / 2)
+				{
+					count(counters.seen_full);
+					return false;
+				}
+				m_seen[at] = h;
+				++m_seen_count;
+				return true;
+			}
+		}
+		count(counters.seen_full);
+		return false;
+	}
+
+	struct ticket
+	{
+		std::size_t index = 0;
+		texture_validation::sampler_stamp stamp{};
+		generations gen{};
+	};
+
+	// Under the cache reader lock, before the lookup. The way of the same key, else a free way, else the
+	// least recently used one. Its range is unknown until end(): a scoped write in between drops it.
+	ticket begin(std::size_t slot, const key& k) noexcept
+	{
+		std::size_t victim = slot * ways;
+		std::uint32_t best = 0;
+		for (std::size_t way = 0; way < ways; ++way)
+		{
+			const std::size_t index = slot * ways + way;
+			const auto& e = m_entries[index];
+			const std::uint32_t rank = e.k == k ? 3 : !e.valid ? 2 : 1;
+			if (rank > best || (rank == best && rank == 1 && e.used < m_entries[victim].used))
+			{
+				best = rank;
+				victim = index;
+			}
+		}
+
+		m_entries[victim].valid = false;
+		const auto gen = generations::now();
+		return { victim, m_ranges.prepare(victim), gen };
+	}
+
+	enum class store_result
+	{
+		stored, changed, kind, bound
+	};
+
+	// Under the cache reader (or upgraded) lock, after the lookup and its sampler validation. direct: the
+	// descriptor is a direct shader_read view of a section at k.address. length: the length the slot
+	// binding received (0: unknown, then any scoped write drops the entry).
+	store_result end(const ticket& t, const key& k, bool compressed, bool bound, const Descriptor& value, bool direct,
+		std::uint32_t start, std::uint64_t length) noexcept
+	{
+		const auto now = generations::now();
+		if (!t.gen.epoch || now.epoch != t.gen.epoch || now.local != t.gen.local || now.context != t.gen.context ||
+			(compressed && now.all != t.gen.all) || disabled.load(std::memory_order_relaxed))
+		{
+			m_ranges.forget(t.index);
+			return store_result::changed;
+		}
+		if (!compressed && bound)
+		{
+			m_ranges.forget(t.index);
+			return store_result::bound;
+		}
+		if (!direct)
+		{
+			m_ranges.forget(t.index);
+			return store_result::kind;
+		}
+
+		m_ranges.set_range(t.index, start, length);
+		auto& e = m_entries[t.index];
+		e.k = k;
+		e.value = value;
+		e.stamp = t.stamp;
+		e.gen = t.gen;
+		e.compressed = compressed;
+		e.valid = true;
+		e.used = ++m_clock;
+		return store_result::stored;
+	}
+
+	// Under the cache exclusive lock, next to the slot bindings (revalidate_overlapping).
+	void invalidate(std::uint32_t start, std::uint64_t length) noexcept
+	{
+		m_ranges.invalidate(start, length);
+	}
+
+	// Under the cache reader lock: after a verified difference.
+	void clear() noexcept
+	{
+		for (std::size_t index = 0; index < m_entries.size(); ++index)
+		{
+			m_entries[index].valid = false;
+			m_ranges.forget(index);
+		}
+	}
+};
+}
diff --git a/rpcs3/ios/IOSThreadOrchestrator.h b/rpcs3/ios/IOSThreadOrchestrator.h
new file mode 100644
index 0000000..d62694e
--- /dev/null
+++ b/rpcs3/ios/IOSThreadOrchestrator.h
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+
+#if defined(__APPLE__)
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <pthread/qos.h>
+#include <sys/qos.h>
+#elif defined(__linux__)
+#include <sched.h>
+#endif
+
+// REWINDBOX_THREAD_ORCHESTRATOR_665: scheduling and measurement only. Nothing here changes
+// what a guest thread computes, when a lock is taken or what a writer waits for.
+//
+// Measurement: where emulator threads actually run. Every class has a histogram of the
+// CPU a sampling thread was on and of its QoS class, filled by rate-limited samples (at
+// most one per millisecond per thread, a thread_local next-due tick), plus, for each
+// vm::writer_lock with a range lock, the time of its whole suspend phase (cpu_flag::memory
+// publication, the drain of overlapping range locks, then the PPU wait) and of its last
+// step alone, the wait for every PPU thread to carry cpu_flag::wait, with how often that
+// PPU wait exceeded 50 us (a PPU thread that did not reach a check point: probably not
+// running).
+//
+// Assignment: every emulator thread already runs USER_INTERACTIVE; the RSX-over-PPU lever
+// (CELL567) lowers the default relative priority of threads that ask for nothing to -2, so
+// the PPU threads share it with every background USER_INTERACTIVE thread (texture worker,
+// pipeline workers, publishers). Black Ops II is PPU bound and every vm::writer_lock waits for
+// every running PPU thread to reach a check point, so a preempted PPU thread delays every
+// writer and every SPU waiting behind it. With the orchestrator the PPU threads start one
+// step above that default (relative -1 against -2), still below the RSX and audio threads
+// (relative 0), which keep their precedence. SPU threads keep the Core 627 behaviour. With
+// the default at 0 (lever off) the PPU stays at 0. Disabled is exactly Core 664.
+namespace rpcs3::ios::orchestrator
+{
+enum class cls : unsigned
+{
+	ppu,
+	spu,
+	rsx,
+	audio,
+	compile,
+	other,
+};
+
+constexpr std::size_t class_count = 6;
+constexpr std::size_t cpu_buckets = 9; // cpu0..cpu7 and one overflow bucket
+constexpr std::size_t qos_buckets = 6; // ui, in, df, ut, bg, other
+
+constexpr const char* class_name(cls c) noexcept
+{
+	switch (c)
+	{
+	case cls::ppu: return "ppu";
+	case cls::spu: return "spu";
+	case cls::rsx: return "rsx";
+	case cls::audio: return "audio";
+	case cls::compile: return "compile";
+	default: return "other";
+	}
+}
+
+// The values of <sys/qos.h> (qos_class_t); 0 means "leave the thread as it is".
+constexpr unsigned qos_unspecified = 0x00;
+constexpr unsigned qos_user_interactive = 0x21;
+constexpr unsigned qos_user_initiated = 0x19;
+constexpr unsigned qos_default = 0x15;
+constexpr unsigned qos_utility = 0x11;
+constexpr unsigned qos_background = 0x09;
+
+#if defined(__APPLE__)
+static_assert(qos_user_interactive == QOS_CLASS_USER_INTERACTIVE && qos_user_initiated == QOS_CLASS_USER_INITIATED &&
+	qos_default == QOS_CLASS_DEFAULT && qos_utility == QOS_CLASS_UTILITY && qos_background == QOS_CLASS_BACKGROUND);
+#endif
+
+// Set by the policy: sampling, the assignment and the writer-lock timing are on.
+inline std::atomic<bool> enabled{false};
+// Set by the policy: 50 us in utils::get_tsc() ticks (0 while the orchestrator is off).
+inline std::atomic<std::uint64_t> slow_park_ticks{0};
+
+struct class_counters
+{
+	std::atomic<std::uint64_t> samples{0};
+	std::atomic<std::uint64_t> cpu[cpu_buckets]{};
+	std::atomic<std::uint64_t> qos[qos_buckets]{};
+};
+
+inline class_counters counters[class_count];
+
+// vm::writer_lock with a range lock: suspend phases, their time, the PPU-wait part of it,
+// and the PPU waits longer than slow_park_ticks.
+inline std::atomic<std::uint64_t> wl_suspends{0};
+inline std::atomic<std::uint64_t> wl_suspend_ticks{0};
+inline std::atomic<std::uint64_t> wl_ppu_wait_ticks{0};
+inline std::atomic<std::uint64_t> wl_slow_ppu_waits{0};
+inline std::atomic<std::uint64_t> wl_slow_ppu_wait_ticks{0};
+
+struct snapshot
+{
+	std::uint64_t samples = 0;
+	std::uint64_t cpu[cpu_buckets]{};
+	std::uint64_t qos[qos_buckets]{};
+};
+
+struct writer_snapshot
+{
+	std::uint64_t suspends = 0;
+	std::uint64_t suspend_ticks = 0;
+	std::uint64_t ppu_wait_ticks = 0;
+	std::uint64_t slow_ppu_waits = 0;
+	std::uint64_t slow_ppu_wait_ticks = 0;
+};
+
+constexpr std::size_t cpu_bucket(long cpu) noexcept
+{
+	return cpu >= 0 && cpu < static_cast<long>(cpu_buckets - 1) ? static_cast<std::size_t>(cpu) : cpu_buckets - 1;
+}
+
+constexpr std::size_t qos_bucket(unsigned raw) noexcept
+{
+	switch (raw)
+	{
+	case qos_user_interactive: return 0;
+	case qos_user_initiated: return 1;
+	case qos_default: return 2;
+	case qos_utility: return 3;
+	case qos_background: return 4;
+	default: return 5;
+	}
+}
+
+inline void record(cls c, long cpu, unsigned qos_raw) noexcept
+{
+	class_counters& k = counters[static_cast<std::size_t>(c) < class_count ? static_cast<std::size_t>(c) : class_count - 1];
+	k.samples.fetch_add(1, std::memory_order_relaxed);
+	k.cpu[cpu_bucket(cpu)].fetch_add(1, std::memory_order_relaxed);
+	k.qos[qos_bucket(qos_raw)].fetch_add(1, std::memory_order_relaxed);
+}
+
+// Exchange-and-reset for the performance window.
+inline snapshot take(cls c) noexcept
+{
+	class_counters& k = counters[static_cast<std::size_t>(c) < class_count ? static_cast<std::size_t>(c) : class_count - 1];
+	snapshot s;
+	s.samples = k.samples.exchange(0, std::memory_order_relaxed);
+	for (std::size_t i = 0; i < cpu_buckets; i++)
+	{
+		s.cpu[i] = k.cpu[i].exchange(0, std::memory_order_relaxed);
+	}
+	for (std::size_t i = 0; i < qos_buckets; i++)
+	{
+		s.qos[i] = k.qos[i].exchange(0, std::memory_order_relaxed);
+	}
+	return s;
+}
+
+inline writer_snapshot take_writer() noexcept
+{
+	writer_snapshot s;
+	s.suspends = wl_suspends.exchange(0, std::memory_order_relaxed);
+	s.suspend_ticks = wl_suspend_ticks.exchange(0, std::memory_order_relaxed);
+	s.ppu_wait_ticks = wl_ppu_wait_ticks.exchange(0, std::memory_order_relaxed);
+	s.slow_ppu_waits = wl_slow_ppu_waits.exchange(0, std::memory_order_relaxed);
+	s.slow_ppu_wait_ticks = wl_slow_ppu_wait_ticks.exchange(0, std::memory_order_relaxed);
+	return s;
+}
+
+// One writer lock's suspend phase and its PPU-wait part; the slow threshold comes from the policy.
+inline void record_writer_suspend(std::uint64_t suspend_ticks, std::uint64_t ppu_wait_ticks) noexcept
+{
+	wl_suspends.fetch_add(1, std::memory_order_relaxed);
+	wl_suspend_ticks.fetch_add(suspend_ticks, std::memory_order_relaxed);
+	wl_ppu_wait_ticks.fetch_add(ppu_wait_ticks, std::memory_order_relaxed);
+	if (ppu_wait_ticks > slow_park_ticks.load(std::memory_order_relaxed))
+	{
+		wl_slow_ppu_waits.fetch_add(1, std::memory_order_relaxed);
+		wl_slow_ppu_wait_ticks.fetch_add(ppu_wait_ticks, std::memory_order_relaxed);
+	}
+}
+
+// Sampling clock: nanoseconds from a monotonic clock on Linux, mach_absolute_time ticks on Apple.
+inline std::uint64_t now_ticks() noexcept
+{
+#if defined(__APPLE__)
+	return mach_absolute_time();
+#else
+	timespec ts{};
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return static_cast<std::uint64_t>(ts.tv_sec) * 1'000'000'000ull + static_cast<std::uint64_t>(ts.tv_nsec);
+#endif
+}
+
+// One millisecond in now_ticks() units.
+inline std::uint64_t sample_interval_ticks() noexcept
+{
+#if defined(__APPLE__)
+	static const std::uint64_t interval = []
+	{
+		mach_timebase_info_data_t info{};
+		mach_timebase_info(&info);
+		return info.numer ? 1'000'000ull * info.denom / info.numer : 1'000'000ull;
+	}();
+	return interval;
+#else
+	return 1'000'000ull;
+#endif
+}
+
+// The thread's next-due tick; a sample is taken at most once per interval per thread.
+inline thread_local std::uint64_t next_due = 0;
+
+inline bool due(std::uint64_t now, std::uint64_t interval) noexcept
+{
+	if (now < next_due)
+	{
+		return false;
+	}
+	next_due = now + interval;
+	return true;
+}
+
+inline long current_cpu() noexcept
+{
+#if defined(__APPLE__)
+	// pthread_cpu_number_np returns the CPU through its argument.
+	std::size_t cpu = 0;
+	if (pthread_cpu_number_np(&cpu) != 0)
+	{
+		return -1;
+	}
+	return static_cast<long>(cpu);
+#elif defined(__linux__)
+	return sched_getcpu();
+#else
+	return -1;
+#endif
+}
+
+inline unsigned current_qos() noexcept
+{
+#if defined(__APPLE__)
+	return static_cast<unsigned>(qos_class_self());
+#else
+	return 0; // "other"
+#endif
+}
+
+// Hot path: one relaxed load while off; while on, a clock read and a compare, and once per
+// millisecond per thread two cheap reads and three relaxed increments.
+inline void sample(cls c) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+	{
+		return;
+	}
+
+	if (!due(now_ticks(), sample_interval_ticks()))
+	{
+		return;
+	}
+
+	record(c, current_cpu(), current_qos());
+}
+
+// thread_class (Utilities/Thread.h) values: general 0, ppu 1, spu 2, rsx 0x55.
+constexpr cls class_from_thread_class(unsigned v) noexcept
+{
+	return v == 1 ? cls::ppu : v == 2 ? cls::spu : v == 0x55 ? cls::rsx : cls::other;
+}
+
+struct policy
+{
+	bool enabled = false;
+	// ios/IOSThreadQoS.h default_relative_priority (0, or -2 with the RSX thread priority lever).
+	int default_relative_priority = 0;
+};
+
+struct assignment
+{
+	unsigned qos_class = qos_unspecified; // qos_unspecified: leave the thread as it is
+	int relative_priority = 0;
+
+	constexpr bool operator==(const assignment&) const = default;
+};
+
+// The orchestrator's QoS for a thread class at its start. PPU: USER_INTERACTIVE one relative
+// step above the default, at most 0 (see the top of this file). RSX (its own +1, relative 0),
+// SPU (the Core 627 lever) and the rest are not touched.
+constexpr assignment qos_for(cls c, const policy& p) noexcept
+{
+	if (!p.enabled || c != cls::ppu)
+	{
+		return {};
+	}
+
+	const int above_default = p.default_relative_priority + 1;
+	return {qos_user_interactive, above_default < 0 ? above_default : 0};
+}
+
+// Applies an assignment to the calling thread; false when nothing was applied.
+inline bool apply_to_current_thread(const assignment& a) noexcept
+{
+	if (a.qos_class == qos_unspecified)
+	{
+		return false;
+	}
+#if defined(__APPLE__)
+	return pthread_set_qos_class_self_np(static_cast<qos_class_t>(a.qos_class), a.relative_priority) == 0;
+#else
+	return false;
+#endif
+}
+}
diff --git a/rpcs3/ios/IOSThreadQoS.h b/rpcs3/ios/IOSThreadQoS.h
index 0f2f94b..b1d21f2 100644
--- a/rpcs3/ios/IOSThreadQoS.h
+++ b/rpcs3/ios/IOSThreadQoS.h
@@ -17,21 +17,42 @@
 // lowered itself (shader cache writer: set_native_priority(-1), never restored)
 // kept the utility class for the next thread it ran, an SPU or PPU thread for
 // instance. Each job now starts at the default level.
+//
+// REWINDBOX_SPU_QOS_627: relative priorities order threads inside one class, and the
+// iPhone has two performance cores for all of them. Build 622 and 624 logs: God of War III's
+// RSX thread is CPU bound (0.65-0.83 core, FIFO busy 78-96 %, GPU 30-40 % busy) beside 3.0-3.6
+// SPU cores; Black Ops II's six SPU threads take 3.3-5.3 cores of six. With this setting
+// SPU threads run in the user-initiated class, one class below the PPU, RSX and MoltenVK
+// threads: those keep the performance cores whenever they are runnable, and SPU threads
+// take what is left, the four efficiency cores and any idle performance core. A
+// user-initiated thread still runs at once on an idle core, so the guest's SPU work
+// does not wait for a free slot; it runs slower while the others need the fast cores.
+// The compile threads (utility class) and the idle worker pool stay as they are: their
+// load in game is compile_cores=0.000.
 namespace rpcs3::ios::thread_qos
 {
 // Relative priority of threads that request no priority while the ordering is on.
 constexpr int lowered_relative_priority = -2;
 inline std::atomic<int> default_relative_priority{0};
 
+// REWINDBOX_SPU_QOS_627: the thread_ctrl::set_native_priority() value of an SPU thread.
+constexpr int spu_native_priority = -2;
+
 struct level
 {
 	bool utility;           // QOS_CLASS_UTILITY instead of QOS_CLASS_USER_INTERACTIVE
 	int relative_priority;  // pthread_set_qos_class_self_np's relative priority
+	bool user_initiated = false; // REWINDBOX_SPU_QOS_627: QOS_CLASS_USER_INITIATED
 };
 
 // thread_ctrl::set_native_priority(priority); 0 is also every pooled job's start.
 inline level for_priority(int priority) noexcept
 {
+	if (priority == spu_native_priority)
+	{
+		return {false, 0, true};
+	}
+
 	if (priority < 0)
 	{
 		return {true, 0};
diff --git a/rpcs3/ios/IOSTitleLevers.h b/rpcs3/ios/IOSTitleLevers.h
index 2fe17df..019b80e 100644
--- a/rpcs3/ios/IOSTitleLevers.h
+++ b/rpcs3/ios/IOSTitleLevers.h
@@ -84,4 +84,160 @@ constexpr bool requires_position_invariance(std::string_view title_id) noexcept
 {
 	return is_black_ops_ii_title(title_id) || is_assassins_creed_title(title_id);
 }
+
+// REWINDBOX_ZCLIP_WINDOW_Z_616: Black Ops II draws an object in front of the
+// whole scene with the clip range [1, 1e19] and a viewport Z scale of 1e19
