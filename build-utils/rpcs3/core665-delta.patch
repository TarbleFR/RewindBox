+			const u32 last = utils::page_start(memory_address + (memory_range - 1));
+			reader_lock lock(m_pages_mutex);
+
+			for (u32 page = utils::page_start(memory_address);; page += page_size)
+			{
+				const auto& block = m_locked_pages[rsx::classify_location(page)];
