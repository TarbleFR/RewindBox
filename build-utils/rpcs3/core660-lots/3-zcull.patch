+// REWINDBOX_ZCULL_DEPTH_GUARD_660 (ios/IOSZcullWatched.h): the serial of the open command buffer while the
+// query has host queries in it, under the condition on which a zcull_sync hint for it submits that buffer
+// (sync_hint()); 0 otherwise (submitted, or nothing a hint would submit).
+u64 VKGSRender::ios_open_cb_serial(rsx::reports::occlusion_query_info* query)
+{
+	const auto& data = m_occlusion_map[query->driver_handle];
+	return ((m_current_command_buffer->flags & vk::command_buffer::cb_has_occlusion_task) && data.is_current(m_current_command_buffer) &&
+		!data.indices.empty()) ? m_ios_cb_serial : 0;
+}
+
+// REWINDBOX_ZCULL_WATCHED_FLUSH_660 (ios/IOSZcullWatched.h): RSX thread, read_report() queued into a watched slot
+// the report its next read is expected to wait for, and `query` decides its value. While that query is in the open
+// command buffer, the boundary submission of 659 is armed for this buffer: taken at the next draw start or after
+// the next draw's textures with no render pass open (ios_early_submit_at_boundary), at the end of a draw after
+// max_deferred_draws more draws (ios_early_submit), or carried by any other primary submission. The GPU-idle test
+// of 561 does not apply; its cap of early submissions per frame does, and so does the frame's budget of watched
+// submissions (a carried arm costs nothing and is not counted). Arming records nothing in the command buffer.
+rpcs3::ios::zcull_watched::arm_result VKGSRender::ios_arm_watched_submit(rsx::reports::occlusion_query_info* query)
+{
+	namespace early = rpcs3::ios::early_submit;
+	namespace watched = rpcs3::ios::zcull_watched;
+	if (!early::enabled.load(std::memory_order_relaxed) || !early::at_pass_boundary.load(std::memory_order_relaxed))
+	{
+		return watched::arm_result::off;
+	}
+
+	if (!ios_open_cb_serial(query))
+	{
+		return watched::arm_result::submitted;
+	}
+
+	if (m_ios_early_armed_draws)
+	{
+		return watched::arm_result::joined;
+	}
+
+	if (m_ios_early_submits_this_frame >= early::max_per_frame || !m_ios_watched_budget.available(int_flip_index))
+	{
+		return watched::arm_result::capped;
+	}
+
+	m_ios_early_armed_draws = 1;
+	m_ios_early_armed_watched = true;
+	early::armed.fetch_add(1, std::memory_order_relaxed);
+	return watched::arm_result::armed;
+}
