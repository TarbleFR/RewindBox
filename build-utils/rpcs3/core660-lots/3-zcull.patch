+// REWINDBOX_ZCULL_DEPTH_GUARD_660 (ios/IOSZcullWatched.h): at the ZCULL queue-depth limit the same titles
+// submit the open command buffer only while it holds the oldest pending query. IPA 657: Black Ops II frames
+// of about 140 submissions in windows 3:12-3:13 (ZCULLSYNC613 hint_flushes 2,844 and 2,861 per window).
+constexpr bool zcull_depth_guard(std::string_view title_id) noexcept
+{
+	return is_assassins_creed_title(title_id) || is_black_ops_ii_title(title_id);
+}
 }
