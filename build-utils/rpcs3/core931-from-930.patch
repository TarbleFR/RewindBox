+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+#include "IOSShardedCounter931.h"
+#include "IOSWriterParkSpin917.h" // compare::event_waits_forced, set by the report thread inside a comparison step
+
+// REWINDBOX_THERMAL_POLICY_931: the Core follows the iPhone's thermal state (ProcessInfo.thermalState, posted by
+// the system: 0 nominal, 1 fair, 2 serious, 3 critical) and, once the device is hot, changes HOW some short waits
+// wait, never WHAT they wait for. Black Ops II (IPA 725) reaches state 2 after about 35 s of play and stays there;
+// its frame rate falls from about 45 to about 30 while the work per frame stays the same.
+//
+// "Event waits when hot" (Automatic: from state 2): three waits that spin on a core for a few microseconds (the
+// writer's park spin of REWINDBOX_WRITER_PARK_SPIN_917, the PPU passive-lock spin before its timed wait, the RSX FIFO
+// idle wait before its park) wait instead with the ARM exclusive monitor (LDAXR then WFE): the core is clock-gated
+// until another core writes the watched line (the very write the wait is for) or the system's event stream ends the
+// WFE, which XNU enables as the WFE timeout (osfmk/arm64/machine_routines.c, _enable_timebase_event_stream). Each wait
+// keeps its condition, its time bound and its fallback. Below state 2, and with the setting Disabled, every wait is
+// exactly the previous one. With Lever Comparison Between Report Windows Enabled, the setting Automatic alternates by
+// window with the two levers of Cores 917 and 918 (IOSWriterParkSpin917.h, compare::event_waits_at).
+namespace rpcs3::ios::thermal
+{
+inline std::atomic<int> state{-1};                // thermalState, -1 until the platform has read it
+inline std::atomic<std::uint8_t> setting{0};      // 0 Automatic, 1 Enabled, 2 Disabled (boot policy)
+inline std::atomic<std::uint64_t> state_changes{0};
+inline constexpr int automatic_from = 2;          // serious
+
+constexpr bool decide(std::uint8_t mode, int thermal_state, int forced) noexcept
+{
+	if (forced >= 0)
+	{
+		return forced != 0;
+	}
+
+	return mode == 1 ? true : mode == 2 ? false : thermal_state >= automatic_from;
+}
+
+inline bool event_waits() noexcept
+{
+	return decide(setting.load(std::memory_order_relaxed), state.load(std::memory_order_relaxed),
+		writer_park::compare::event_waits_forced.load(std::memory_order_relaxed));
+}
+
+// Platform observer (RPCS3IOSPlatform.mm): the state the system posted.
+inline void set_state(int thermal_state) noexcept
+{
+	if (state.exchange(thermal_state, std::memory_order_relaxed) != thermal_state)
+	{
+		state_changes.fetch_add(1, std::memory_order_relaxed);
+	}
+}
+
+// Waits that took the event path, by site, for COREPROF THERMAL931 (per thread shards: no shared line on hot paths).
+enum site : std::size_t { writer_park, ppu_passive, rsx_idle, site_count };
+inline sharded::block<site_count> event_wait_counts{};
+
+inline void count(site where) noexcept
+{
+	event_wait_counts.add(where, 1);
+}
+
+inline const char* state_name(int thermal_state) noexcept
+{
+	switch (thermal_state)
+	{
+	case 0: return "nominal";
+	case 1: return "fair";
+	case 2: return "serious";
+	case 3: return "critical";
+	default: return "unknown";
+	}
+}
+} // namespace rpcs3::ios::thermal
