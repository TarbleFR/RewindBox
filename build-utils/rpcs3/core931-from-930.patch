+		__asm__ volatile("wfe" ::: "memory");
+	}
+	__asm__ volatile("clrex" ::: "memory");
+#else
+	(void)word;
+	(void)seen;
+	hint();
+#endif
+}
+} // namespace rpcs3::ios::event_wait
