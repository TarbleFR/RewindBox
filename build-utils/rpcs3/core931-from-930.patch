+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+#include "IOSWriterLockPhases.h"
+#include "IOSWriterParkSpin917.h"
+
+// REWINDBOX_WRITER_RECORD_AFTER_RELEASE_931: vm::writer_lock's constructor recorded the phases of an SPU PUTLLC lock
+// (REWINDBOX_WRITER_LOCK_PHASES_908, REWINDBOX_WRITER_PARK_SPIN_917) after its park loop, so while every PPU thread
+// was still parked behind the lock; CELL536 already publishes the lock's own counters after the release for that
+// reason ("Profiling must not keep guest PPU threads parked"). The constructor now keeps the measured phases in a
+// thread-local slot, and rpcs3::ios::record_writer_lock, which the destructor calls after releasing the lock on the
+// same thread, publishes them. Same values, same counters, same report; only the moment of the adds moves.
+namespace rpcs3::ios::writer_lock_record
+{
+struct pending_t
+{
+	std::uint64_t bits = 0, ranges = 0, park = 0, flagged = 0, slow_threshold = 0, ticks_per_second = 0;
+	bool budget_spent = false;
+	bool valid = false;
+};
+
+inline thread_local pending_t pending{};
+
+// Constructor of an SPU PUTLLC writer lock, after its park loop: keep the measured phases.
+inline void defer(std::uint64_t bits, std::uint64_t ranges, std::uint64_t park, std::uint64_t flagged, std::uint64_t slow_threshold,
+	std::uint64_t ticks_per_second, bool budget_spent) noexcept
+{
+	pending_t& slot = pending;
+	slot.bits = bits;
+	slot.ranges = ranges;
+	slot.park = park;
+	slot.flagged = flagged;
+	slot.slow_threshold = slow_threshold;
+	slot.ticks_per_second = ticks_per_second;
+	slot.budget_spent = budget_spent;
+	slot.valid = true;
+}
+
+// After the release, on the thread that held the lock: publish what the constructor kept, if anything.
+inline bool flush() noexcept
+{
+	pending_t& slot = pending;
+
+	if (!slot.valid)
+	{
+		return false;
+	}
+
+	slot.valid = false;
+	writer_lock_phases::record(slot.bits, slot.ranges, slot.park, slot.flagged, slot.slow_threshold);
+	writer_park::record_park(slot.park, slot.ticks_per_second, slot.budget_spent);
+	return true;
+}
+} // namespace rpcs3::ios::writer_lock_record
