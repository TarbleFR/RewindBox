index 0000000..829c13e
--- /dev/null
+++ b/rpcs3/ios/IOSShardedCounter931.h
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// REWINDBOX_HOT_COUNTERS_931: counters written on the hottest paths of the Core (about 265 000 heavy SPU PUTLLC
+// writer locks and 340 000 PPU parks per second in Black Ops II, IPA 725) were single process-wide atomics: every
+// event was several read-modify-writes on cache lines that the writing threads took from each other, and the writer
+// lock's ones ran while every PPU thread was parked. Each thread now adds to its own shard (one 128-byte line, the
+// cache line of the A-series cores); a report sums and clears the shards. The sums a report prints are the same:
+// an add that lands while a report clears a shard is counted in the next window, as with one atomic.
+namespace rpcs3::ios::sharded
+{
+inline constexpr std::size_t shards = 32; // threads that share a shard still count exactly (atomic adds)
+
+inline std::size_t shard_index() noexcept
+{
+	static std::atomic<std::uint32_t> next{0};
+	thread_local std::size_t index = shards; // constant-initialized: no guard on the hot path
+	if (index == shards) [[unlikely]]
+	{
+		index = next.fetch_add(1, std::memory_order_relaxed) % shards;
+	}
+	return index;
+}
+
+// N counters that are written together by one event share one line per shard.
+template <std::size_t N>
+struct alignas(128) line
+{
+	std::atomic<std::uint64_t> value[N]{};
+};
+
+template <std::size_t N>
+struct block
+{
+	line<N> per_shard[shards]{};
+
+	void add(std::size_t field, std::uint64_t amount) noexcept
+	{
+		per_shard[shard_index()].value[field].fetch_add(amount, std::memory_order_relaxed);
+	}
+
+	void add_at(std::size_t shard, std::size_t field, std::uint64_t amount) noexcept
+	{
+		per_shard[shard].value[field].fetch_add(amount, std::memory_order_relaxed);
+	}
+
+	// Largest value seen (a maximum field): compare-and-swap on the writer's own shard only.
+	void raise_at(std::size_t shard, std::size_t field, std::uint64_t candidate) noexcept
+	{
+		std::atomic<std::uint64_t>& slot = per_shard[shard].value[field];
+		std::uint64_t seen = slot.load(std::memory_order_relaxed);
+		while (candidate > seen && !slot.compare_exchange_weak(seen, candidate, std::memory_order_relaxed))
+		{
+		}
+	}
+
+	std::uint64_t take_sum(std::size_t field) noexcept
+	{
+		std::uint64_t sum = 0;
+		for (auto& shard : per_shard)
+		{
+			sum += shard.value[field].exchange(0, std::memory_order_relaxed);
+		}
+		return sum;
+	}
+
+	std::uint64_t take_max(std::size_t field) noexcept
+	{
+		std::uint64_t maximum = 0;
+		for (auto& shard : per_shard)
+		{
+			maximum = std::max(maximum, shard.value[field].exchange(0, std::memory_order_relaxed));
+		}
+		return maximum;
+	}
+
+	// The current value without clearing it, as reading one of the former atomics did.
+	std::uint64_t read(std::size_t field, bool maximum) const noexcept
+	{
+		std::uint64_t value = 0;
+		for (const auto& shard : per_shard)
+		{
+			const std::uint64_t part = shard.value[field].load(std::memory_order_relaxed);
+			value = maximum ? std::max(value, part) : value + part;
+		}
+		return value;
+	}
+};
+
+// A view of one field, so a report keeps calling take(counters.<name>) as it did on the single atomics.
+template <std::size_t N, bool Maximum = false>
+struct field
+{
+	block<N>* owner;
+	std::size_t index;
+
+	// Reading a field reads it, as reading the atomic did (`counters.ppu_parks == 2`); only take() clears it.
+	operator std::uint64_t() const noexcept
+	{
+		return owner->read(index, Maximum);
+	}
+};
+
+template <std::size_t N, bool Maximum>
+inline std::uint64_t take(field<N, Maximum> view) noexcept
+{
+	return Maximum ? view.owner->take_max(view.index) : view.owner->take_sum(view.index);
+}
+} // namespace rpcs3::ios::sharded
