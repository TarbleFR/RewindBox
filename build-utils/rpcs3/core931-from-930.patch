diff --git a/rpcs3/ios/IOSBackgroundPause931.h b/rpcs3/ios/IOSBackgroundPause931.h
new file mode 100644
index 0000000..40b606f
--- /dev/null
+++ b/rpcs3/ios/IOSBackgroundPause931.h
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_BACKGROUND_PAUSE_931: the emulation is paused while the application is in the background.
+//
+// Until Core 930 only the GPU stopped there (REWINDBOX_GPU_DEACTIVATION_GATE_928): the PPU, SPU and RSX threads kept
+// running, without any picture, as long as iOS let the process run. Build 725 (PID 52378) wrote its last session record
+// with app=background and the game still emulating at 8 frames per second, 2.8 GB in use: CPU heat and battery spent
+// on a game nobody sees. Now, after the background notification (once the gate has settled), the Core pauses the
+// emulation with its own rpcs3_ios_pause_emulation, which refuses unless the emulation is running; when the
+// application is active again (after the gate has reopened) it resumes it, only if it is the one that paused it. A pause
+// it did not make (a stopped, loading or already paused emulation) is never resumed by it. Guest time does not jump:
+// Emu.Resume adds the paused span to the pause amend time. The in-game menu still does not pause (a product decision
+// that stays the maintainer's).
+//
+// A game that was still booting when the application left (its first PPU compilation, say) was not running then, so
+// that pause was refused; it starts running in the background later. And the observers are installed with the first
+// Vulkan device, so a game started just before leaving can find the application already in the background. Both are
+// covered: the installation reads the application state once, and while the application is in the background and
+// the emulation runs, the report thread (one window every 5 s) asks for the pause again. Every pause is decided on the
+// main thread, where the notifications are posted, and only while the application is in the background there.
+//
+// Emu.Pause and Emu.Resume each wait once for the main thread (BlockingCallFromMainThread through the host's main
+// thread callback, which the host sets: RPCS3Dispatch) and run under g_api_mutex. The host calls every export that
+// takes that mutex from its own queues, never from the main thread, and the main thread never waits for those queues,
+// so the serial queue's wait for the main thread always ends.
+namespace rpcs3::ios::background_pause
+{
+// RPCS3IOSPlatform.mm: called from the notification blocks; the work runs on a serial queue of its own.
+void app_entered_background() noexcept;
+void app_became_active() noexcept;
+// Any thread: asks for the pause; the main thread decides, only while the application is in the background.
+void request_pause() noexcept;
+// Registers the two notifications above and the thermal state notification (REWINDBOX_THERMAL_POLICY_931). The pause
+// and the resume run after the posting has returned, so after the GPU gate's observers of the same notification.
+void install_observers() noexcept;
+
+class state
+{
+public:
+	static state& instance() noexcept
+	{
+		static state value;
+		return value;
+	}
+
+	// Background: pause if the emulation runs (the pause call itself refuses otherwise). True when paused here.
+	template <typename Pause>
+	bool pause_if_running(Pause&& pause) noexcept
+	{
+		if (m_ours.load(std::memory_order_relaxed))
+		{
+			return false;
+		}
+
+		if (!pause())
+		{
+			m_refused.fetch_add(1, std::memory_order_relaxed);
+			return false;
+		}
+
+		m_ours.store(true, std::memory_order_relaxed);
+		m_pauses.fetch_add(1, std::memory_order_relaxed);
+		return true;
+	}
+
+	// Active again: resume only a pause made here. True when resumed.
+	template <typename Resume>
+	bool resume_if_ours(Resume&& resume) noexcept
+	{
+		if (!m_ours.exchange(false, std::memory_order_relaxed))
+		{
+			return false;
+		}
+
+		if (!resume())
+		{
+			m_resume_refused.fetch_add(1, std::memory_order_relaxed);
+			return false;
+		}
+
+		m_resumes.fetch_add(1, std::memory_order_relaxed);
+		return true;
+	}
+
+	bool ours() const noexcept { return m_ours.load(std::memory_order_relaxed); }
+	// Set on the main thread (the observers and the installation), read by the report thread: only a hint for asking
+	// again, the pause itself is decided on the main thread.
+	void set_background(bool value) noexcept { m_background.store(value, std::memory_order_relaxed); }
+	bool background() const noexcept { return m_background.load(std::memory_order_relaxed); }
+	void count_late_request() noexcept { m_late_requests.fetch_add(1, std::memory_order_relaxed); }
+	std::uint64_t late_requests() const noexcept { return m_late_requests.load(std::memory_order_relaxed); }
+	std::uint64_t pauses() const noexcept { return m_pauses.load(std::memory_order_relaxed); }
+	std::uint64_t resumes() const noexcept { return m_resumes.load(std::memory_order_relaxed); }
+	std::uint64_t refused() const noexcept { return m_refused.load(std::memory_order_relaxed); }
+	std::uint64_t resume_refused() const noexcept { return m_resume_refused.load(std::memory_order_relaxed); }
+
+private:
+	std::atomic<bool> m_ours{false}, m_background{false};
+	std::atomic<std::uint64_t> m_pauses{0}, m_resumes{0}, m_refused{0}, m_resume_refused{0}, m_late_requests{0};
+};
+} // namespace rpcs3::ios::background_pause
diff --git a/rpcs3/ios/IOSEnergy931.h b/rpcs3/ios/IOSEnergy931.h
new file mode 100644
index 0000000..c2a6dee
--- /dev/null
+++ b/rpcs3/ios/IOSEnergy931.h
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+// REWINDBOX_ENERGY_931: what the system bills this process for, per 5 s report window, so that a thermal change is
+// judged on the iPhone by energy per frame and not by a host bench ("aucun gain iPhone inventé depuis un banc hôte").
+// Sources, read once per window by the report thread (RPCS3IOSPerformance.cpp, sample_energy):
+// - proc_pid_rusage(RUSAGE_INFO_V6) on the process itself: ri_energy_nj and ri_penergy_nj (energy the system
+//   attributes to its CPU work, all cores and the performance cores, in nanojoules), ri_user/system_time and their
+//   _ptime parts (Mach time units, converted with mach_timebase_info), cycles and instructions, interrupt and package
+//   idle wakeups, CPU time by QoS class;
+// - task_info TASK_POWER_INFO: timer wakeups whose deadline was at most 2 ms away (bin 1) and 2 to 5 ms (bin 2)
+//   (osfmk/kern/sched_prim.c, thread_unblock);
+// - task_info TASK_POWER_INFO_V2: the GPU utilisation counter and the switches between core clusters, printed raw.
+// COREPROF ENERGY931 prints differences between two consecutive windows of the same boot only; a source the system
+// refuses is printed as unavailable, never as 0.
+namespace energy931
+{
+struct sample
+{
+	bool rusage_valid = false, power_valid = false, power_v2_valid = false;
+	std::uint32_t timebase_numer = 1, timebase_denom = 1;
+	std::uint64_t energy_nj = 0, p_energy_nj = 0;
+	std::uint64_t user_ticks = 0, system_ticks = 0, p_user_ticks = 0, p_system_ticks = 0;
+	std::uint64_t cycles = 0, instructions = 0, p_cycles = 0;
+	std::uint64_t interrupt_wakeups = 0, idle_wakeups = 0;
+	std::uint64_t qos_user_interactive_ticks = 0, qos_user_initiated_ticks = 0, qos_default_ticks = 0, qos_utility_ticks = 0;
+	std::uint64_t timer_wakeups_2ms = 0, timer_wakeups_5ms = 0;
+	std::uint64_t gpu_time = 0, pset_switches = 0;
+
+	bool any_valid() const noexcept
+	{
+		return rusage_valid || power_valid || power_v2_valid;
+	}
+};
+
+constexpr std::uint64_t delta(std::uint64_t now, std::uint64_t before) noexcept
+{
+	return now >= before ? now - before : 0;
+}
+
+inline double ticks_to_ms(std::uint64_t ticks, std::uint32_t numer, std::uint32_t denom) noexcept
+{
+	return denom ? static_cast<double>(ticks) * static_cast<double>(numer) / static_cast<double>(denom) / 1e6 : 0.0;
+}
+
+inline std::string format_line(std::uint64_t session, std::uint64_t window, bool comparable, const sample& before, const sample& now,
+	std::uint64_t frames)
+{
+	char text[1024];
+	const char* status = comparable ? "available" : now.any_valid() ? "first_window" : "unavailable";
+	const bool rusage = comparable && before.rusage_valid && now.rusage_valid;
+	const bool power = comparable && before.power_valid && now.power_valid;
+	const bool power2 = comparable && before.power_v2_valid && now.power_v2_valid;
+
+	std::string rusage_part = "rusage=unavailable";
+	if (rusage)
+	{
+		const double mj = static_cast<double>(delta(now.energy_nj, before.energy_nj)) / 1e6;
+		const double p_mj = static_cast<double>(delta(now.p_energy_nj, before.p_energy_nj)) / 1e6;
+		const auto ms = [&](std::uint64_t a, std::uint64_t b) { return ticks_to_ms(delta(a, b), now.timebase_numer, now.timebase_denom); };
+		const double cpu_ms = ms(now.user_ticks + now.system_ticks, before.user_ticks + before.system_ticks);
+		const double p_cpu_ms = ms(now.p_user_ticks + now.p_system_ticks, before.p_user_ticks + before.p_system_ticks);
+		const std::uint64_t cycles = delta(now.cycles, before.cycles), instructions = delta(now.instructions, before.instructions);
+		char part[640];
+		std::snprintf(part, sizeof(part),
+			"cpu_energy_mj=%.1f p_energy_mj=%.1f mj_per_frame=%.3f cpu_ms=%.1f p_cpu_ms=%.1f p_share=%.3f mcycles=%.1f p_mcycles=%.1f "
+			"minstructions=%.1f ipc=%.3f interrupt_wakeups=%" PRIu64 " idle_wakeups=%" PRIu64 " qos_ms=%.1f:%.1f:%.1f:%.1f",
+			mj, p_mj, frames ? mj / static_cast<double>(frames) : 0.0, cpu_ms, p_cpu_ms, cpu_ms > 0.0 ? p_cpu_ms / cpu_ms : 0.0,
+			static_cast<double>(cycles) / 1e6, static_cast<double>(delta(now.p_cycles, before.p_cycles)) / 1e6,
+			static_cast<double>(instructions) / 1e6, cycles ? static_cast<double>(instructions) / static_cast<double>(cycles) : 0.0,
+			delta(now.interrupt_wakeups, before.interrupt_wakeups), delta(now.idle_wakeups, before.idle_wakeups),
+			ms(now.qos_user_interactive_ticks, before.qos_user_interactive_ticks), ms(now.qos_user_initiated_ticks, before.qos_user_initiated_ticks),
+			ms(now.qos_default_ticks, before.qos_default_ticks), ms(now.qos_utility_ticks, before.qos_utility_ticks));
+		rusage_part = part;
+	}
+
+	char power_part[160] = "timer_wakeups=unavailable";
+	if (power)
+	{
+		std::snprintf(power_part, sizeof(power_part), "timer_wakeups_2ms=%" PRIu64 " timer_wakeups_5ms=%" PRIu64,
+			delta(now.timer_wakeups_2ms, before.timer_wakeups_2ms), delta(now.timer_wakeups_5ms, before.timer_wakeups_5ms));
+	}
+
+	char power2_part[160] = "gpu_utilisation_delta=unavailable";
+	if (power2)
+	{
+		std::snprintf(power2_part, sizeof(power2_part), "gpu_utilisation_delta=%" PRIu64 " pset_switches=%" PRIu64,
+			delta(now.gpu_time, before.gpu_time), delta(now.pset_switches, before.pset_switches));
+	}
+
+	std::snprintf(text, sizeof(text),
+		"COREPROF ENERGY931 session=%" PRIu64 " window=%" PRIu64 " energy=%s frames=%" PRIu64 " %s %s %s "
+		"units=energy_nj_billed_by_system,times_mach_timebase,gpu_raw scope=process_window",
+		session, window, status, frames, rusage_part.c_str(), power_part, power2_part);
+	return text;
+}
+} // namespace energy931
