+		const auto paths = make_archive_paths("/cache/BLUS00000/shaders_cache/metal/", a);
+		check(paths.archive == "/cache/BLUS00000/shaders_cache/metal/" + base + ".metallib", "archive path");
+		check(paths.archive_temp == "/cache/BLUS00000/shaders_cache/metal/" + base + ".partial.metallib", "archive temporary path (same extension)");
+		check(paths.identity == "/cache/BLUS00000/shaders_cache/metal/" + base + ".identity", "sidecar path");
+		check(paths.identity_temp == "/cache/BLUS00000/shaders_cache/metal/" + base + ".partial.identity", "sidecar temporary path");
+	}
