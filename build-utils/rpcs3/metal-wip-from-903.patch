+	// ---------------------------------------------------------------------------------------------------------------
+	// RSX tile decoder (VKCompute.h cs_tile_memcpy<decode>, Program/GLSLSnippets/RSXMemoryTiling.glsl; its CPU port is
+	// Common/tiled_dma_copy.hpp). Its own library, so that the conversion kernels never depend on it. Buffer 0: the data
+	// (uint words, bound at the task's data offset) holding the tiled bytes and the linear output; buffer 1: the 16
+	// parameter words of mtl::tile_decode_params (MTLComputeTasks.h). One invocation per word of the packed linear image:
+	// each of its bytes comes from its texel's tiled address (MTLM4Math.h m4_detile_source), so every texel size and row
+	// length decodes whole (the GLSL kernel decodes 4 / bpp texels per invocation by read-modify-write of shared words,
+	// from its first column), and the bytes tiled_dma_copy does not write are zero, as in the CPU decoder's buffer.
+	// ---------------------------------------------------------------------------------------------------------------
+	constexpr std::string_view tiling_kernels = R"(
+inline uint m4_tiling_invocation_id(uint3 global_id, uint3 grid_size)
+{
+	return (global_id.y * grid_size.x) + global_id.x;
+}
+
+kernel void m4_tile_decode_kernel(device uint* data [[buffer(0)]], constant uint* params [[buffer(1)]],
+	uint3 global_id [[thread_position_in_grid]], uint3 grid_size [[threads_per_grid]])
+{
+	const uint word = m4_tiling_invocation_id(global_id, grid_size);
+	if (word >= params[15])
+	{
+		return;
+	}
+
+	uint value = 0;
+	for (uint byte_index = 0; byte_index < 4; ++byte_index)
+	{
+		const uint source = m4_detile_source((word * 4) + byte_index, params[0], params[1], params[2], params[3], params[4], params[5],
+			params[6], params[7], params[8], params[9], params[10], params[11], params[13]);
+		if (source != 0xFFFFFFFFu)
+		{
+			const uint index = params[12] + source;
+			value |= ((data[index >> 2] >> ((index & 3) * 8)) & 0xFF) << (byte_index * 8);
+		}
+	}
+
+	data[(params[14] >> 2) + word] = value;
+}
+)";
+
+	constexpr std::string_view tile_decode_kernel_name = "m4_tile_decode_kernel";
+
+	inline std::string tiling_library_source()
+	{
