+		check(identity_text(a) == "RPCS3 Metal 4 pipeline archive\nversion=1\ndevice=Apple A17 Pro GPU\nsystem=Version 26.1 (Build 23B85)\n",
+			"sidecar text: one field per line");
+
+		const std::string base = archive_base_name(a);
+		bool hex = base.size() == archive_prefix.size() + 16 && starts_with(base, std::string(archive_prefix));
+		for (usz i = archive_prefix.size(); hex && i < base.size(); ++i)
+		{
+			hex = (base[i] >= '0' && base[i] <= '9') || (base[i] >= 'a' && base[i] <= 'f');
+		}
+		check(hex, "archive name: pipelines- and 16 lower-case hex digits");
+		check(archive_base_name(a) == base, "the name is deterministic");
+
+		archive_identity other_gpu = a;
+		other_gpu.device = "Apple A18 Pro GPU";
+		archive_identity other_build = a;
+		other_build.system = "Version 26.1 (Build 23B86)";
+		archive_identity other_version = a;
+		other_version.version = archive_format_version + 1;
+		check(archive_base_name(other_gpu) != base, "another GPU is another archive");
+		check(archive_base_name(other_build) != base, "another OS build is another archive");
+		check(archive_base_name(other_version) != base, "another format version is another archive");
+		check(identity_text(other_gpu) != identity_text(a) && identity_text(other_build) != identity_text(a) &&
+			identity_text(other_version) != identity_text(a), "and another sidecar text");
+
+		// A field cannot forge another one.
+		archive_identity forged = a;
+		forged.device = "X\nsystem=Version 26.1 (Build 23B85)";
+		const std::string forged_text = identity_text(forged);
+		usz lines = 0;
+		for (const char c : forged_text)
+		{
+			lines += c == '\n';
+		}
+		check(lines == 4 && forged_text.find("device=X system=") != std::string::npos, "line breaks inside a field are spaces");
