+	// ------------------------------------------------------------------------------------------------------------------
+	// One decode as upload_tiled_image runs it: the tile span copied out of the tile memory, then the kernel's loop for
+	// every word of the packed linear image (MTLM4Shaders.h m4_tile_decode_kernel), against rsx::tiled_dma_copy decoding
+	// the same region from the same memory into a zeroed buffer (what the CPU path uploads).
+	struct tile_case
+	{
+		u32 base, size, pitch, bank, origin_offset, width, height, bpp;
+	};
+
+	bool run_tile_case(const tile_case& c, const std::vector<u8>& tile_memory, const char*& failure)
+	{
+		const auto factors = get_tile_pitch_factors(c.pitch);
+		const u32 tiles_per_row = factors.prime * factors.factor;
+		const u32 image_pitch = c.width * c.bpp;
+		const u64 linear_length = u64{image_pitch} * c.height;
+
+		std::vector<u8> expected(linear_length, 0);
+		const rsx::detiler_config conf =
+		{
+			.prime = factors.prime,
+			.factor = factors.factor,
+			.num_tiles_per_row = tiles_per_row,
+			.tile_base_address = c.base,
+			.tile_size = c.size,
+			.tile_address_offset = c.origin_offset,
+			.tile_rw_offset = 0,
+			.tile_pitch = c.pitch,
+			.tile_bank = c.bank,
+			.image_width = c.width,
+			.image_height = c.height,
+			.image_pitch = image_pitch,
+			.image_bpp = c.bpp,
+		};
+		for (u32 row = 0; row < c.height; ++row)
+		{
+			for (u32 col = 0; col < c.width; ++col)
+			{
+				rsx::tiled_dma_copy(row, col, conf, const_cast<char*>(reinterpret_cast<const char*>(tile_memory.data())),
+					reinterpret_cast<char*>(expected.data()), 1 /* RSX_DMA_OP_DECODE_TILE */);
+
+				// The span holds every texel the tiler reads (inside the tile).
+				const u32 offset = m4_tile_offset(row, col, factors.factor, tiles_per_row, c.base, c.origin_offset, c.pitch, c.bank, c.bpp);
+				const tile_span span = get_tile_span(c.base, c.size, c.pitch, tiles_per_row, c.origin_offset, c.width, c.height, c.bpp);
+				if (offset < c.size && (offset < span.start || u64{offset} + c.bpp > span.end))
+				{
+					failure = "a texel's tiled bytes lie outside the staged span";
+					return false;
+				}
+			}
+		}
+
+		const tile_span span = get_tile_span(c.base, c.size, c.pitch, tiles_per_row, c.origin_offset, c.width, c.height, c.bpp);
+		const u32 tiled_length = span.end - span.start;
+		std::vector<u32> data((tiled_length + 3) / 4 + (linear_length + 3) / 4 + 1, 0xDEADBEEFu);
+		std::memcpy(data.data(), tile_memory.data() + span.start, tiled_length);
+		const u32 linear_offset = (tiled_length + 3) & ~3u;
+		const u32 linear_words = static_cast<u32>((linear_length + 3) / 4);
+
+		for (u32 word = 0; word < linear_words; ++word)
+		{
+			u32 value = 0;
+			for (u32 byte_index = 0; byte_index < 4; ++byte_index)
+			{
+				const u32 source = m4_detile_source((word * 4) + byte_index, factors.factor, tiles_per_row, c.base, c.size, c.origin_offset, span.start,
+					c.pitch, c.bank, c.width, c.height, image_pitch, c.bpp, tiled_length);
+				if (source != 0xFFFFFFFFu)
+				{
+					const u32 index = 0 + source;
+					value |= ((data[index >> 2] >> ((index & 3) * 8)) & 0xFF) << (byte_index * 8);
+				}
+			}
+			data[(linear_offset >> 2) + word] = value;
+		}
+
+		if (std::memcmp(reinterpret_cast<const u8*>(data.data()) + linear_offset, expected.data(), linear_length) != 0)
+		{
+			failure = "the decoded rows differ from the CPU tiler";
+			return false;
+		}
+
+		// The padding bytes of the last word are zero.
+		for (u64 i = linear_length; i < u64{linear_words} * 4; ++i)
+		{
+			if (reinterpret_cast<const u8*>(data.data())[linear_offset + i] != 0)
+			{
+				failure = "a padding byte is not zero";
+				return false;
+			}
+		}
+		return true;
+	}
