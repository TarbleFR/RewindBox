+	// ------------------------------------------------------------------------------------------------------------------
+	void test_program_cache_keys()
+	{
+		const std::string version = program_cache_version(sizeof(mtl::pipeline_props));
+		check(version == "v1-p52", "record version: v<record version>-p<sizeof(pipeline_props)>");
+		check(program_cache_version(56) != version, "another pipeline_props size is another version directory");
+
+		// The rsx::shaders_cache layout (rsx_cache.h): <root>raw/<hash>.vp|fp, <root>/pipelines/<class>/<version>/,
+		// <root>spirv.pack; the Vulkan device's pipeline cache beside them.
+		const std::string metal_root(program_cache_directory);
+		check(metal_root == "shaders_cache/metal/", "Metal's program cache root");
+		const std::vector<std::string> metal_paths = {
+			metal_root + "raw/0123ABCD.vp",
+			metal_root + "/pipelines/" + std::string(program_cache_class) + "/" + version + "/A+B+C+D.bin",
+			metal_root + "spirv.pack",
+			metal_root + "pipelines-0123456789abcdef.metallib",
+		};
+		const std::vector<std::string> vulkan_paths = {
+			"shaders_cache/raw/0123ABCD.vp",
+			"shaders_cache//pipelines/vulkan/v1.95/A+B+C+D.bin",
+			"shaders_cache//pipelines/opengl/v1.95/A+B+C+D.bin",
+			"shaders_cache/spirv.pack",
+			"shaders_cache/vk_pipeline_cache.bin",
+		};
+
+		for (const auto& vk : vulkan_paths)
+		{
+			check(!starts_with(vk, metal_root), "no Vulkan or OpenGL cache file is below Metal's root");
+			for (const auto& metal : metal_paths)
+			{
+				check(vk != metal, "no Metal cache file is a Vulkan one");
+			}
+		}
+
+		for (const auto& metal : metal_paths)
+		{
+			check(starts_with(metal, metal_root), "every Metal cache file is below Metal's root");
+		}
+
+		// Vulkan's directories under shaders_cache/ (raw, pipelines) cannot be Metal's: Metal's are one level down.
+		check(!starts_with(metal_root + "raw/", "shaders_cache/raw/") && !starts_with(metal_root + "/pipelines/", "shaders_cache//pipelines/"),
+			"Metal's raw and pipelines directories are not Vulkan's");
+		check(std::string(program_cache_class) != "vulkan" && std::string(program_cache_class) != "opengl", "Metal's pipeline class");
+	}
