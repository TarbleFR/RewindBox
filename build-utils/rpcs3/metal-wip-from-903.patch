+namespace
+{
+	int g_failures = 0;
+	int g_checks = 0;
+
+	void check(bool condition, const char* what)
+	{
+		g_checks++;
+		if (!condition)
+		{
+			g_failures++;
+			std::fprintf(stderr, "FAIL: %s\n", what);
+		}
+	}
+
+	bool starts_with(const std::string& text, const std::string& prefix)
+	{
+		return text.compare(0, prefix.size(), prefix) == 0;
+	}
