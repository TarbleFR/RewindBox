diff --git a/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp b/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp
new file mode 100644
index 0000000..9e0b043
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLM5Renderer.cpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M5): the renderer side of the shader and pipeline caches (MTLPipelineCache.h): the RSX
+// program cache on disk (rsx::shaders_cache, as VKGSRender) with its boot precompile, and the Metal 4 pipeline archive.
+
+#include "stdafx.h"
+#include "MTLGSRender.h"
+
+#include "Emu/RSX/rsx_cache.h"
+#include "Emu/RSX/Overlays/Shaders/shader_loading_dialog_native.h"
+#include "Emu/cache_utils.hpp"
+#include "Emu/system_config.h"
+
+namespace
+{
+	// The title's Metal cache directory (trailing separator); empty when the on-disk shader cache is off.
+	std::string metal_cache_directory()
+	{
+		if (g_cfg.video.disable_on_disk_shader_cache)
+		{
+			return {};
+		}
+
+		std::string path = rpcs3::cache::get_ppu_cache();
+		if (path.empty())
+		{
+			return {};
+		}
+		return path + std::string(mtl::pipeline_cache::program_cache_directory);
+	}
+}
+
+void MTLGSRender::open_pipeline_archive()
+{
+	// Before the compiler exists: the compiler captures into the archive's serializer.
+	mtl::pipeline_cache::archive_identity identity;
+	identity.device = m_device_info.name;
+	identity.system = mtl::system_version();
+	m_metal_cache_directory = metal_cache_directory();
+	m_pipeline_archive.open(m_device, m_metal_cache_directory, identity);
+}
+
+void MTLGSRender::create_program_cache()
+{
+	// VKGSRender: rsx::shaders_cache over the program cache, in Metal's own directory with Metal's record version.
+	m_shaders_cache = std::make_unique<shader_cache>(*m_prog_buffer, std::string(mtl::pipeline_cache::program_cache_class),
+		mtl::pipeline_cache::program_cache_version(sizeof(mtl::pipeline_props)), mtl::pipeline_cache::program_cache_directory);
+}
+
+void MTLGSRender::store_program(const mtl::pipeline_props& props, const RSXVertexProgram& vp, const RSXFragmentProgram& fp)
+{
+	// VKGSRender's program cache callback: the program was linked; the record is written by the cache's writer thread.
+	if (m_shaders_cache)
+	{
+		m_shaders_cache->store(props, vp, fp);
+	}
+}
+
+void MTLGSRender::load_program_cache()
+{
+	// VKGSRender::on_init_thread: every record of earlier sessions is built before the first draw, with the native
+	// interface's progress dialog (or the host's, the frame hidden meanwhile).
+	if (!m_shaders_cache)
+	{
+		return;
+	}
+
+	m_pipeline_archive.begin_boot();
+	mtl::set_pipeline_build_origin(mtl::pipeline_build_origin::boot);
+	if (!m_overlay_manager)
+	{
+		m_frame->hide();
+		m_shaders_cache->load(nullptr);
+		m_frame->show();
+	}
+	else
+	{
+		rsx::shader_loading_dialog_native dlg(this);
+		m_shaders_cache->load(&dlg);
+	}
+	mtl::set_pipeline_build_origin(mtl::pipeline_build_origin::draw);
+
+	// What the boot compiled is checkpointed now, by the worker (the Vulkan renderer's NEOSTATION_BUILD266 checkpoint),
+	// unless the emulation stopped during the precompile.
+	m_pipeline_archive.end_boot(!Emu.IsStopped());
+}
+
+void MTLGSRender::close_pipeline_caches()
+{
+	// VKGSRender::on_exit: every record the draws queued reaches disk; then the last archive checkpoint (no pipeline is
+	// built after this point).
+	if (m_shaders_cache)
+	{
+		m_shaders_cache->flush_pending_writes();
+		m_shaders_cache.reset();
+	}
+	m_pipeline_archive.close();
+}
+
+void MTLGSRender::report_m5_counters()
+{
+	const auto load = [](const std::atomic<u64>& value) { return static_cast<unsigned long long>(value.load(std::memory_order_relaxed)); };
+	const auto& p = mtl::get_pipeline_counters();
+	const auto& a = mtl::get_pipeline_archive_counters();
+	const auto& c = mtl::get_pipeline_cache_counters();
+	rsx_log.notice("COREPROF METAL M5 program_cache=%s boot_pipelines=%llu draw_pipelines=%llu archive=%s archive_hits=%llu archive_misses=%llu "
+		"archive_uncaptured=%llu archive_rejected=%llu checkpoints=%llu checkpoint_bytes=%llu checkpoint_failures=%llu archive_unavailable=%llu",
+		m_metal_cache_directory.empty() ? "off" : "on", load(p.boot_pipelines), load(p.draw_pipelines), m_pipeline_archive.state_name(), load(a.hits), load(a.misses),
+		load(a.uncaptured), load(c.rejections), load(c.checkpoints), load(c.checkpoint_bytes), load(c.checkpoint_failures), load(c.unavailable));
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.cpp b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.cpp
new file mode 100644
index 0000000..bdd1c5d
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.cpp
@@ -0,0 +1,393 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M5): the title's Metal 4 pipeline binaries (see MTLPipelineArchive.h, MTLPipelineCache.h).
+
+#include "stdafx.h"
+#include "MTLPipelineArchive.h"
+
+#include "MTLTexture.h"
+
+#include "Utilities/File.h"
+#include "Utilities/Thread.h"
+
+#include <chrono>
+#include <vector>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace mtl
+{
+	namespace
+	{
+		pipeline_cache_counters g_cache_counters{};
+
+		u64 now_us()
+		{
+			return static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+				std::chrono::steady_clock::now().time_since_epoch()).count());
+		}
+
+		// The checkpoint's file operations on disk (the unit test fakes the same interface).
+		struct disk_ops final : pipeline_cache::file_ops
+		{
+			const object& serializer;
+
+			explicit disk_ops(const object& value) : serializer(value) {}
+
+			bool read_text(const std::string& path, std::string& text) override
+			{
+				fs::file file(path);
+				if (!file)
+				{
+					return false;
+				}
+				text = file.to_string();
+				return true;
+			}
+
+			bool write_text(const std::string& path, std::string_view text) override
+			{
+				fs::file file(path, fs::rewrite);
+				return file && file.write(text.data(), text.size()) == text.size();
+			}
+
+			bool serialize(const std::string& path) override
+			{
+				std::string error;
+				if (!write_pipeline_archive(serializer, path, error))
+				{
+					log_once("archive-serialize", fmt::format("Metal 4 pipeline archive serialization failed: %s", error));
+					return false;
+				}
+				return true;
+			}
+
+			bool sync(const std::string& path) override
+			{
+				// POSIX directly: a failed sync is a failed checkpoint (counted), never a fatal error.
+				const int fd = ::open(path.c_str(), O_RDONLY);
+				if (fd < 0)
+				{
+					return false;
+				}
+				const bool ok = ::fsync(fd) == 0;
+				::close(fd);
+				return ok;
+			}
+
+			u64 size(const std::string& path) override
+			{
+				fs::stat_t info{};
+				return (fs::get_stat(path, info) && !info.is_directory) ? info.size : 0;
+			}
+
+			bool rename(const std::string& from, const std::string& to) override
+			{
+				return fs::rename(from, to, true);
+			}
+
+			bool remove(const std::string& path) override
+			{
+				return fs::remove_file(path) || !fs::is_file(path);
+			}
+		};
+
+		void reject(const std::string& path, std::string_view why)
+		{
+			g_cache_counters.rejections++;
+			log_once("archive-rejected", fmt::format("Metal 4 pipeline archive %s rejected (%s): removed, rebuilt from this session's pipelines", path, why));
+			fs::remove_file(path);
+		}
+	}
+
+	pipeline_cache_counters& get_pipeline_cache_counters()
+	{
+		return g_cache_counters;
+	}
+
+	pipeline_archive::~pipeline_archive()
+	{
+		close();
+	}
+
+	const char* pipeline_archive::state_name() const
+	{
+		switch (m_state)
+		{
+		case state::off: return "off";
+		case state::unavailable: return "unavailable";
+		case state::fresh: return "fresh";
+		case state::loaded: return "loaded";
+		}
+		return "unknown";
+	}
+
+	void pipeline_archive::open(const object& device, const std::string& directory, const pipeline_cache::archive_identity& identity)
+	{
+		ensure(!m_worker.joinable());
+		m_state = state::off;
+		if (directory.empty())
+		{
+			rsx_log.notice("Metal 4 pipeline archive: off (the on-disk shader cache is disabled or the title has no cache directory)");
+			return;
+		}
+
+		if (!fs::create_path(directory))
+		{
+			g_cache_counters.unavailable++;
+			log_once("archive-directory", fmt::format("Metal 4 pipeline archive: the directory %s cannot be created", directory));
+			return;
+		}
+
+		m_paths = pipeline_cache::make_archive_paths(directory, identity);
+		m_identity_text = pipeline_cache::identity_text(identity);
+		const std::string base = pipeline_cache::archive_base_name(identity);
+
+		// Every archive file of the directory: another identity's is rejected, an interrupted checkpoint's removed.
+		bool archive_exists = false;
+		bool identity_exists = false;
+		std::vector<std::string> stale;
+		for (const auto& entry : fs::dir(directory))
+		{
+			if (entry.is_directory)
+			{
+				continue;
+			}
+
+			switch (pipeline_cache::classify_file(entry.name, base))
+			{
+			case pipeline_cache::file_role::unrelated: break;
+			case pipeline_cache::file_role::current_archive: archive_exists = true; break;
+			case pipeline_cache::file_role::current_identity: identity_exists = true; break;
+			case pipeline_cache::file_role::other_archive: reject(directory + entry.name, "another GPU, system or archive version"); break;
+			case pipeline_cache::file_role::other_identity:
+			case pipeline_cache::file_role::leftover_temp: stale.push_back(directory + entry.name); break;
+			}
+		}
+
+		for (const auto& path : stale)
+		{
+			fs::remove_file(path);
+		}
+
+		std::string identity_on_disk;
+		if (identity_exists)
+		{
+			fs::file file(m_paths.identity);
+			identity_on_disk = file ? file.to_string() : std::string{};
+		}
+
+		switch (pipeline_cache::check_archive(archive_exists, identity_exists, identity_on_disk, m_identity_text))
+		{
+		case pipeline_cache::archive_state::usable:
+		{
+			std::string error;
+			m_archive = open_pipeline_archive(device, m_paths.archive, error);
+			if (!m_archive)
+			{
+				reject(m_paths.archive, fmt::format("Metal cannot open it: %s", error));
+			}
+			break;
+		}
+		case pipeline_cache::archive_state::absent:
+			break;
+		case pipeline_cache::archive_state::no_identity:
+			reject(m_paths.archive, "no identity sidecar");
+			break;
+		case pipeline_cache::archive_state::identity_mismatch:
+			reject(m_paths.archive, "its identity differs");
+			fs::remove_file(m_paths.identity);
+			break;
+		}
+
+		m_serializer = new_pipeline_serializer(device);
+		if (!m_serializer)
+		{
+			// Pipelines still use the loaded archive; nothing new is captured or written.
+			g_cache_counters.unavailable++;
+			log_once("archive-serializer", "Metal 4 pipeline archive: no pipeline data set serializer, pipeline binaries are not saved");
+			m_state = state::unavailable;
+		}
+		else
+		{
+			m_state = m_archive ? state::loaded : state::fresh;
+		}
+
+		set_pipeline_lookup_archive(m_archive);
+		m_checkpoint_misses = get_pipeline_archive_counters().misses.load();
+		m_last_checkpoint_us = now_us();
+		m_forced_pending = false;
+		m_keep_loaded = false;
+
+		if (m_serializer)
+		{
+			m_stop = false;
+			m_request = false;
+			m_busy = false;
+			m_worker = std::thread([this]() { worker_main(); });
+		}
+
+		rsx_log.notice("Metal 4 pipeline archive: %s (%s)", state_name(), m_paths.archive);
+	}
+
+	u64 pipeline_archive::new_pipelines() const
+	{
+		const u64 misses = get_pipeline_archive_counters().misses.load(std::memory_order_relaxed);
+		const u64 base = m_checkpoint_misses.load(std::memory_order_relaxed);
+		return misses > base ? misses - base : 0;
+	}
+
+	void pipeline_archive::begin_boot()
+	{
+		m_boot = true;
+	}
+
+	void pipeline_archive::end_boot(bool completed)
+	{
+		m_boot = false;
+		if (!completed && m_archive)
+		{
+			// The serializer holds only the records rebuilt before the stop: writing it would replace the complete
+			// archive with a part of it.
+			m_keep_loaded = true;
+			rsx_log.notice("Metal 4 pipeline archive: the boot precompile was interrupted, the loaded archive is kept unchanged");
+			return;
+		}
+
+		m_forced_pending = true;
+		tick();
+	}
+
+	void pipeline_archive::tick()
+	{
+		if (!m_worker.joinable() || m_keep_loaded)
+		{
+			return;
+		}
+
+		bool busy;
+		{
+			// Only flags: the worker never holds the lock while it writes.
+			std::lock_guard lock(m_mutex);
+			busy = m_busy || m_request;
+		}
+
+		pipeline_cache::checkpoint_state status;
+		status.now_us = now_us();
+		status.last_us = m_last_checkpoint_us.load(std::memory_order_relaxed);
+		status.new_pipelines = new_pipelines();
+		status.forced = m_forced_pending;
+		status.boot_in_progress = m_boot.load(std::memory_order_relaxed);
+		status.worker_busy = busy;
+
+		const auto reason = pipeline_cache::decide_checkpoint(m_policy, status);
+		if (reason == pipeline_cache::checkpoint_reason::none)
+		{
+			if (!status.new_pipelines)
+			{
+				m_forced_pending = false;  // nothing to force
+			}
+			return;
+		}
+
+		dispatch(reason == pipeline_cache::checkpoint_reason::forced);
+	}
+
+	void pipeline_archive::dispatch(bool forced)
+	{
+		if (forced)
+		{
+			m_forced_pending = false;
+		}
+
+		// The pipelines compiled from here on belong to the next checkpoint (back to this one's if it fails).
+		m_previous_misses = m_checkpoint_misses.load();
+		m_checkpoint_misses = get_pipeline_archive_counters().misses.load();
+		m_last_checkpoint_us = now_us();
+		{
+			std::lock_guard lock(m_mutex);
+			m_request = true;
+		}
+		m_wake.notify_one();
+	}
+
+	void pipeline_archive::worker_main()
+	{
+		thread_ctrl::set_native_priority(-1);
+
+		std::unique_lock lock(m_mutex);
+		while (true)
+		{
+			m_wake.wait(lock, [this]() { return m_request || m_stop; });
+			if (!m_request)
+			{
+				break;
+			}
+
+			m_request = false;
+			m_busy = true;
+			lock.unlock();
+			write();
+			lock.lock();
+			m_busy = false;
+			m_idle.notify_all();
+		}
+	}
+
+	void pipeline_archive::write()
+	{
+		disk_ops ops(m_serializer);
+		const auto result = pipeline_cache::write_checkpoint(ops, m_paths, m_identity_text);
+		if (result.ok())
+		{
+			g_cache_counters.checkpoints++;
+			g_cache_counters.checkpoint_bytes += result.bytes;
+			return;
+		}
+
+		// The pipelines of the failed checkpoint stay new: a later one (rate-limited from now) writes them again.
+		g_cache_counters.checkpoint_failures++;
+		m_checkpoint_misses = m_previous_misses.load();
+		m_last_checkpoint_us = now_us();
+		log_once("archive-checkpoint", fmt::format("Metal 4 pipeline archive checkpoint failed at its %s step: the previous archive stays",
+			pipeline_cache::checkpoint_step_name(result.failed)));
+	}
+
+	void pipeline_archive::close()
+	{
+		if (!m_worker.joinable())
+		{
+			end_pipeline_capture();
+			set_pipeline_lookup_archive({});
+			m_archive.reset();
+			m_serializer.reset();
+			return;
+		}
+
+		// The last checkpoint: after any running one, with everything compiled since it started.
+		{
+			std::unique_lock lock(m_mutex);
+			m_idle.wait(lock, [this]() { return !m_busy && !m_request; });
+		}
+
+		m_boot = false;
+		if (new_pipelines() && !m_keep_loaded)
+		{
+			dispatch(true);
+		}
+
+		{
+			std::unique_lock lock(m_mutex);
+			m_idle.wait(lock, [this]() { return !m_busy && !m_request; });
+			m_stop = true;
+		}
+		m_wake.notify_one();
+		m_worker.join();
+
+		end_pipeline_capture();
+		set_pipeline_lookup_archive({});
+		m_archive.reset();
+		m_serializer.reset();
+		m_state = state::off;
+	}
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.h b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.h
new file mode 100644
index 0000000..bb01940
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineArchive.h
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M5): the title's Metal 4 pipeline binaries (the rules are MTLPipelineCache.h).
+//
+// open() validates the title's archive (another identity, a missing sidecar or a file Metal cannot open is rejected:
+// counted, removed, rebuilt), hands it to every pipeline creation as a lookup (mtl::set_pipeline_lookup_archive), and
+// creates the serializer the renderer's compiler captures into. tick(), once per frame on the RSX thread, only reads
+// counters and the clock; a due checkpoint goes to the worker thread, which writes the archive atomically. close()
+// writes the last checkpoint and joins the worker (the end of the session). An archive that Metal cannot capture
+// (no serializer) is counted and logged once, and the session runs without one.
+
+#include "MTLAPI.h"
+#include "MTLPipelineCache.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace mtl
+{
+	struct pipeline_cache_counters
+	{
+		std::atomic<u64> rejections{0};          // archives (or their sidecars) of another identity, or unusable
+		std::atomic<u64> checkpoints{0};         // archives written
+		std::atomic<u64> checkpoint_bytes{0};
+		std::atomic<u64> checkpoint_failures{0};
+		std::atomic<u64> unavailable{0};         // sessions without a serializer or a cache directory
+	};
+
+	pipeline_cache_counters& get_pipeline_cache_counters();
+
+	class pipeline_archive
+	{
+	public:
+		enum class state : u8
+		{
+			off,          // the on-disk shader cache is disabled, or no title cache directory
+			unavailable,  // Metal created no serializer: nothing captured, nothing written
+			fresh,        // no usable archive: this session's pipelines build a new one
+			loaded,       // the archive is the lookup of every pipeline creation
+		};
+
+		pipeline_archive() = default;
+		pipeline_archive(const pipeline_archive&) = delete;
+		pipeline_archive& operator=(const pipeline_archive&) = delete;
+		~pipeline_archive();
+
+		// `directory` (the title's Metal cache, with a trailing separator) is empty when the cache is off.
+		void open(const object& device, const std::string& directory, const pipeline_cache::archive_identity& identity);
+		const object& serializer() const { return m_serializer; }
+		state get_state() const { return m_state; }
+		const char* state_name() const;
+
+		void begin_boot();  // the boot precompile starts: no checkpoint until end_boot()
+		// The boot precompile ended: a forced checkpoint of what it compiled. An interrupted one (the emulation stopped)
+		// rebuilt only part of the records: a loaded archive is then kept as it is for the whole session.
+		void end_boot(bool completed);
+		void tick();        // RSX thread, once per frame: never blocks, never writes
+		void close();       // the final checkpoint, then the worker stops (blocking)
+
+	private:
+		u64 new_pipelines() const;
+		void dispatch(bool forced);
+		void worker_main();
+		void write();
+
+		state m_state = state::off;
+		object m_serializer;
+		object m_archive;
+		pipeline_cache::archive_paths m_paths;
+		std::string m_identity_text;
+		pipeline_cache::checkpoint_policy m_policy{};
+
+		// The archive misses (compiled pipelines) counted when the last checkpoint started, and before it.
+		std::atomic<u64> m_checkpoint_misses{0};
+		std::atomic<u64> m_previous_misses{0};
+		std::atomic<u64> m_last_checkpoint_us{0};
+		std::atomic<bool> m_boot{false};
+		bool m_keep_loaded = false;     // an interrupted boot over a loaded archive: no checkpoint this session
+		bool m_forced_pending = false;  // RSX thread only
+
+		std::thread m_worker;
+		std::mutex m_mutex;
+		std::condition_variable m_wake;
+		std::condition_variable m_idle;
+		bool m_request = false;   // guarded by m_mutex
+		bool m_busy = false;      // guarded by m_mutex
+		bool m_stop = false;      // guarded by m_mutex
+	};
+}
diff --git a/rpcs3/Emu/RSX/Metal/MTLPipelineCache.h b/rpcs3/Emu/RSX/Metal/MTLPipelineCache.h
new file mode 100644
index 0000000..a0fd34c
--- /dev/null
+++ b/rpcs3/Emu/RSX/Metal/MTLPipelineCache.h
@@ -0,0 +1,353 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// REWINDBOX_METAL_NATIVE (M5): the rules of the Metal renderer's shader and pipeline caches, as pure functions (no
+// Metal, no file system; unit-tested on any host by tests/mtl_m5_unit_test.cpp).
+//
+// Both caches live under the title's cache directory, apart from every Vulkan file:
+//   - the RSX program cache is the Vulkan renderer's model (rsx::shaders_cache): raw RSX vertex and fragment programs
+//     and pipeline_props records, rebuilt into pipelines at boot before the first draw. Metal keeps it in
+//     shaders_cache/metal/ (raw/, pipelines/metal/<version>/). Vulkan uses shaders_cache/raw, shaders_cache/pipelines/
+//     vulkan, shaders_cache/spirv.pack and shaders_cache/vk_pipeline_cache.bin and reads nothing below metal/; Metal
+//     reads and writes nothing outside it. The iOS game library counts and clears shaders_cache/ as a whole.
+//   - the Metal 4 pipeline binaries: an MTL4PipelineDataSetSerializer attached to the compiler captures the binary of
+//     every pipeline it builds; checkpoints write the captured set as an MTL4Archive file, which the next session's
+//     pipeline creations look up first (a pipeline the archive does not hold is compiled as without it). The file name
+//     holds the hash of the archive's identity (format version, GPU, OS version and build) and a sidecar file holds the
+//     identity itself: an archive of another identity, or one without its sidecar, is rejected (counted, removed) and
+//     rebuilt from this session's pipelines.
+// Checkpoints are written by a worker, rate-limited (decide_checkpoint), atomically (write_checkpoint: temporary file,
+// sync, rename), never during the boot precompile (that archive would lack the records not rebuilt yet) and never by
+// the draw path.
+
+#include "util/types.hpp"
+
+#include <string>
+#include <string_view>
+
+namespace mtl::pipeline_cache
+{
+	// -----------------------------------------------------------------------------------------------------------------
+	// The RSX program cache (the rsx::shaders_cache arguments)
+
+	constexpr std::string_view program_cache_directory = "shaders_cache/metal/";  // relative to the title's cache
+	constexpr std::string_view program_cache_class = "metal";                     // pipelines/<class>/<version>/
+	constexpr u32 program_record_version = 1;  // bump when pipeline_props changes meaning without changing size
+
+	// The records' version directory: the record version and the size of pipeline_props (rsx::shaders_cache also
+	// removes records of another size; a new directory never reads old ones at all).
+	inline std::string program_cache_version(usz props_size)
+	{
+		return "v" + std::to_string(program_record_version) + "-p" + std::to_string(props_size);
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// Archive identity
+
+	constexpr u32 archive_format_version = 1;  // bump to reject every archive written before
+	constexpr std::string_view archive_prefix = "pipelines-";
+	// A Metal binary archive keeps the metallib extension Metal's archives use; a temporary file keeps the final
+	// extension too (".partial" before it), in case the serializer or the loader goes by the extension.
+	constexpr std::string_view archive_extension = ".metallib";
+	constexpr std::string_view identity_extension = ".identity";
+	constexpr std::string_view partial_infix = ".partial";
+
+	struct archive_identity
+	{
+		u32 version = archive_format_version;
+		std::string device;   // MTLDevice name
+		std::string system;   // operating system version and build
+	};
+
+	// One field per line: a line break inside a field cannot forge another field.
+	inline std::string identity_field(std::string_view value)
+	{
+		std::string result(value);
+		for (char& c : result)
+		{
+			if (c == '\n' || c == '\r')
+			{
+				c = ' ';
+			}
+		}
+		return result;
+	}
+
+	// The sidecar's text, compared byte for byte.
+	inline std::string identity_text(const archive_identity& identity)
+	{
+		std::string text = "RPCS3 Metal 4 pipeline archive\n";
+		text += "version=" + std::to_string(identity.version) + "\n";
+		text += "device=" + identity_field(identity.device) + "\n";
+		text += "system=" + identity_field(identity.system) + "\n";
+		return text;
+	}
+
+	constexpr u64 fnv1a64(std::string_view data)
+	{
+		u64 hash = 0xcbf29ce484222325ull;
+		for (const char c : data)
+		{
+			hash ^= static_cast<u8>(c);
+			hash *= 0x100000001b3ull;
+		}
+		return hash;
+	}
+
+	// "pipelines-<16 hex digits of the identity hash>"
+	inline std::string archive_base_name(const archive_identity& identity)
+	{
+		constexpr char digits[] = "0123456789abcdef";
+		const u64 hash = fnv1a64(identity_text(identity));
+		std::string name(archive_prefix);
+		for (int shift = 60; shift >= 0; shift -= 4)
+		{
+			name += digits[(hash >> shift) & 0xf];
+		}
+		return name;
+	}
+
+	struct archive_paths
+	{
+		std::string archive;         // <directory>pipelines-<hash>.metallib
+		std::string archive_temp;    // <directory>pipelines-<hash>.partial.metallib
+		std::string identity;        // <directory>pipelines-<hash>.identity
+		std::string identity_temp;   // <directory>pipelines-<hash>.partial.identity
+	};
+
+	// `directory` ends with a separator.
+	inline archive_paths make_archive_paths(std::string_view directory, const archive_identity& identity)
+	{
+		const std::string base = std::string(directory) + archive_base_name(identity);
+		archive_paths paths;
+		paths.archive = base + std::string(archive_extension);
+		paths.archive_temp = base + std::string(partial_infix) + std::string(archive_extension);
+		paths.identity = base + std::string(identity_extension);
+		paths.identity_temp = base + std::string(partial_infix) + std::string(identity_extension);
+		return paths;
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// Validation and rejection
+
+	// What a file of the cache directory is to this session.
+	enum class file_role : u8
+	{
+		unrelated,        // not an archive file (the program cache's raw/ and pipelines/, the SPIR-V pack, anything else)
+		current_archive,  // this identity's archive
+		current_identity, // this identity's sidecar
+		other_archive,    // another identity's archive: rejected (counted) and removed
+		other_identity,   // another identity's sidecar: removed with it
+		leftover_temp,    // an interrupted checkpoint's temporary file: removed
+	};
+
+	constexpr bool ends_with(std::string_view text, std::string_view suffix)
+	{
+		return text.size() >= suffix.size() && text.substr(text.size() - suffix.size()) == suffix;
+	}
+
+	constexpr file_role classify_file(std::string_view name, std::string_view base_name)
+	{
+		if (name.substr(0, archive_prefix.size()) != archive_prefix)
+		{
+			return file_role::unrelated;
+		}
+
+		const bool archive = ends_with(name, archive_extension);
+		const bool identity = ends_with(name, identity_extension);
+		if (!archive && !identity)
+		{
+			return file_role::unrelated;
+		}
+
+		const std::string_view stem = name.substr(0, name.size() - (archive ? archive_extension.size() : identity_extension.size()));
+		if (ends_with(stem, partial_infix))
+		{
+			return file_role::leftover_temp;
+		}
+
+		if (stem == base_name)
+		{
+			return archive ? file_role::current_archive : file_role::current_identity;
+		}
+		return archive ? file_role::other_archive : file_role::other_identity;
+	}
+
+	// Whether this identity's archive may be handed to Metal (which may still fail to open it: a rejection too).
+	enum class archive_state : u8
+	{
+		usable,             // archive and sidecar present, the sidecar holds this identity
+		absent,             // no archive: built from this session's pipelines (not a rejection)
+		no_identity,        // an archive without its sidecar: rejected
+		identity_mismatch,  // a sidecar that does not hold this identity (damaged, or a hash collision): rejected
+	};
+
+	constexpr archive_state check_archive(bool archive_exists, bool identity_exists, std::string_view identity_on_disk, std::string_view expected)
+	{
+		if (!archive_exists)
+		{
+			return archive_state::absent;
+		}
+		if (!identity_exists)
+		{
+			return archive_state::no_identity;
+		}
+		return identity_on_disk == expected ? archive_state::usable : archive_state::identity_mismatch;
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// Checkpoint rate limit
+
+	struct checkpoint_policy
+	{
+		u64 interval_us = 180'000'000;     // a trickle of new pipelines is written within this time
+		u64 burst = 64;                    // or as soon as this many are new
+		u64 min_spacing_us = 15'000'000;   // never two checkpoints closer than this (a compile storm)
+	};
+
+	enum class checkpoint_reason : u8
+	{
+		none,
+		interval,
+		burst,
+		forced,   // the end of the boot precompile, the end of the session
+	};
+
+	struct checkpoint_state
+	{
+		u64 now_us = 0;
+		u64 last_us = 0;            // the last checkpoint's start, or the session's
+		u64 new_pipelines = 0;      // compiled (not from the archive) since the last checkpoint started
+		bool forced = false;
+		bool boot_in_progress = false;
+		bool worker_busy = false;
+	};
+
+	constexpr checkpoint_reason decide_checkpoint(const checkpoint_policy& policy, const checkpoint_state& state)
+	{
+		// Nothing new: the archive on disk already holds every pipeline of this session (or there are none).
+		if (!state.new_pipelines || state.worker_busy)
+		{
+			return checkpoint_reason::none;
+		}
+
+		if (state.forced)
+		{
+			return checkpoint_reason::forced;
+		}
+
+		if (state.boot_in_progress)
+		{
+			return checkpoint_reason::none;
+		}
+
+		const u64 elapsed = state.now_us >= state.last_us ? state.now_us - state.last_us : 0;
+		if (elapsed < policy.min_spacing_us)
+		{
+			return checkpoint_reason::none;
+		}
+
+		if (state.new_pipelines >= policy.burst)
+		{
+			return checkpoint_reason::burst;
+		}
+
+		return elapsed >= policy.interval_us ? checkpoint_reason::interval : checkpoint_reason::none;
+	}
+
+	// -----------------------------------------------------------------------------------------------------------------
+	// The atomic checkpoint sequence, through its file operations (the seam the unit test fakes)
+
+	struct file_ops
+	{
+		virtual ~file_ops() = default;
+		virtual bool read_text(const std::string& path, std::string& text) = 0;        // false when absent
+		virtual bool write_text(const std::string& path, std::string_view text) = 0;   // creates or truncates
+		virtual bool serialize(const std::string& path) = 0;                          // the serializer writes the archive
+		virtual bool sync(const std::string& path) = 0;                               // the data on storage
+		virtual u64 size(const std::string& path) = 0;                                // 0 when absent
+		virtual bool rename(const std::string& from, const std::string& to) = 0;      // atomic replace
+		virtual bool remove(const std::string& path) = 0;                             // true when absent afterwards
+	};
+
+	enum class checkpoint_step : u8
+	{
+		done,
+		identity_write,
+		identity_rename,
+		serialize,
+		sync,
+		empty,
+		rename,
+	};
+
+	struct checkpoint_result
+	{
+		checkpoint_step failed = checkpoint_step::done;
+		u64 bytes = 0;
+
+		bool ok() const { return failed == checkpoint_step::done; }
+	};
+
+	// 1. The sidecar, unless it holds this identity already: temporary file, sync, rename.
+	// 2. The archive: a leftover temporary file is removed, the serializer writes a new one, sync, it must not be empty,
+	//    rename over the archive. On any failure the temporary file is removed and the archive on disk stays the
+	//    previous complete one; a crash at any point leaves either the previous or the new archive, never a partial one.
+	inline checkpoint_result write_checkpoint(file_ops& ops, const archive_paths& paths, std::string_view identity)
+	{
+		const auto fail = [&](checkpoint_step step, const std::string& temp)
+		{
+			ops.remove(temp);
+			return checkpoint_result{ step, 0 };
+		};
+
+		std::string current;
+		if (!ops.read_text(paths.identity, current) || current != identity)
+		{
+			if (!ops.write_text(paths.identity_temp, identity) || !ops.sync(paths.identity_temp))
+			{
+				return fail(checkpoint_step::identity_write, paths.identity_temp);
+			}
+			if (!ops.rename(paths.identity_temp, paths.identity))
+			{
+				return fail(checkpoint_step::identity_rename, paths.identity_temp);
+			}
+		}
+
+		ops.remove(paths.archive_temp);
+		if (!ops.serialize(paths.archive_temp))
+		{
+			return fail(checkpoint_step::serialize, paths.archive_temp);
+		}
+		if (!ops.sync(paths.archive_temp))
+		{
+			return fail(checkpoint_step::sync, paths.archive_temp);
+		}
+
+		const u64 bytes = ops.size(paths.archive_temp);
+		if (!bytes)
+		{
+			return fail(checkpoint_step::empty, paths.archive_temp);
+		}
+		if (!ops.rename(paths.archive_temp, paths.archive))
+		{
+			return fail(checkpoint_step::rename, paths.archive_temp);
+		}
+		return { checkpoint_step::done, bytes };
+	}
+
+	constexpr const char* checkpoint_step_name(checkpoint_step step)
+	{
+		switch (step)
+		{
+		case checkpoint_step::done: return "done";
+		case checkpoint_step::identity_write: return "identity write";
+		case checkpoint_step::identity_rename: return "identity rename";
+		case checkpoint_step::serialize: return "serialization";
+		case checkpoint_step::sync: return "sync";
+		case checkpoint_step::empty: return "empty archive";
+		case checkpoint_step::rename: return "rename";
+		}
+		return "unknown";
+	}
+}
