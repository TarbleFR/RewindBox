+// SPDX-License-Identifier: GPL-2.0-only
+// REWINDBOX_METAL_NATIVE (M5): host unit test of the Metal renderer's shader and pipeline cache rules
+// (MTLPipelineCache.h):
+//   - cache keys: the program cache's directory and record version, apart from every Vulkan cache file, and the
+//     archive's name from its identity;
+//   - versioning and rejection: the identity sidecar, the classification of the directory's files, check_archive;
+//   - the checkpoint rate limit, rule by rule and over a simulated session;
+//   - the atomic checkpoint sequence through its file-operation seam: an in-memory file system that records every
+//     operation and fails the one it is told to.
+// Pure logic: no Metal, g++ or clang++.
+//
+//   S=<rpcs3 source root>
+//   c++ -std=gnu++20 -Wall -I "$S/rpcs3" -I "$S" -I "$S/rpcs3/Emu" -I "$S/3rdparty"
+//       "$S/rpcs3/Emu/RSX/Metal/tests/mtl_m5_unit_test.cpp" -o mtl_m5_unit_test
+//   ./mtl_m5_unit_test
+
+#include "Emu/RSX/Metal/MTLPipelineCache.h"
