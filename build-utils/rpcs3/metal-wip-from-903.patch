+	void test_identity()
+	{
+		check(fnv1a64("") == 0xcbf29ce484222325ull && fnv1a64("a") == 0xaf63dc4c8601ec8cull, "FNV-1a 64 reference values");
+
+		archive_identity a;
+		a.device = "Apple A17 Pro GPU";
