+	// ------------------------------------------------------------------------------------------------------------------
+	void test_rejection_rules()
+	{
+		archive_identity a;
+		a.device = "Apple M4 GPU";
+		a.system = "Version 26.0 (Build 25A354)";
+		archive_identity b = a;
+		b.system = "Version 26.1 (Build 25B78)";
+		const std::string base = archive_base_name(a);
+		const std::string other = archive_base_name(b);
+
+		check(classify_file(base + ".metallib", base) == file_role::current_archive, "this identity's archive");
+		check(classify_file(base + ".identity", base) == file_role::current_identity, "this identity's sidecar");
+		check(classify_file(other + ".metallib", base) == file_role::other_archive, "another identity's archive is rejected");
+		check(classify_file(other + ".identity", base) == file_role::other_identity, "another identity's sidecar is removed");
+		check(classify_file(base + ".partial.metallib", base) == file_role::leftover_temp, "an interrupted archive write");
+		check(classify_file(other + ".partial.identity", base) == file_role::leftover_temp, "an interrupted sidecar write");
+		check(classify_file(make_archive_paths("", a).archive_temp, base) == file_role::leftover_temp &&
+			classify_file(make_archive_paths("", a).identity_temp, base) == file_role::leftover_temp, "the temporary names are recognised");
+		for (const char* name : { "raw", "pipelines", "spirv.pack", "vk_pipeline_cache.bin", "pipelines-notes.txt", "pipelines-x.tmp",
+			"xpipelines-0123456789abcdef.metallib", "pipelines", "" })
+		{
+			check(classify_file(name, base) == file_role::unrelated, "the program cache's files and anything else are left alone");
+		}
+
+		const std::string expected = identity_text(a);
+		check(check_archive(false, false, "", expected) == archive_state::absent, "no archive: built this session (not a rejection)");
+		check(check_archive(false, true, expected, expected) == archive_state::absent, "a sidecar alone: no archive");
+		check(check_archive(true, false, "", expected) == archive_state::no_identity, "an archive without its sidecar is rejected");
+		check(check_archive(true, true, expected, expected) == archive_state::usable, "matching identity: usable");
+		check(check_archive(true, true, identity_text(b), expected) == archive_state::identity_mismatch, "another identity is rejected");
+		check(check_archive(true, true, expected.substr(0, expected.size() - 1), expected) == archive_state::identity_mismatch,
+			"a truncated sidecar is rejected");
+		check(check_archive(true, true, "", expected) == archive_state::identity_mismatch, "an empty sidecar is rejected");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	void test_rate_limit()
+	{
+		const checkpoint_policy policy{};
+		check(policy.interval_us == 180'000'000 && policy.burst == 64 && policy.min_spacing_us == 15'000'000, "default policy");
+
+		const auto decide = [&](u64 now_s, u64 last_s, u64 fresh, bool forced = false, bool boot = false, bool busy = false)
+		{
+			checkpoint_state state;
+			state.now_us = now_s * 1'000'000;
+			state.last_us = last_s * 1'000'000;
+			state.new_pipelines = fresh;
+			state.forced = forced;
+			state.boot_in_progress = boot;
+			state.worker_busy = busy;
+			return decide_checkpoint(policy, state);
+		};
+
+		check(decide(1000, 0, 0) == checkpoint_reason::none, "nothing new: no checkpoint");
+		check(decide(1000, 0, 0, true) == checkpoint_reason::none, "nothing new: not even forced");
+		check(decide(1000, 999, 1, true) == checkpoint_reason::forced, "forced ignores the spacing");
+		check(decide(1000, 999, 1, true, true) == checkpoint_reason::forced, "forced at the end of the boot");
+		check(decide(1000, 0, 1000, false, true) == checkpoint_reason::none, "never during the boot precompile");
+		check(decide(1000, 0, 1000, true, false, true) == checkpoint_reason::none, "never while the worker writes (kept pending)");
+		check(decide(1000, 0, 1000, false, false, true) == checkpoint_reason::none, "never while the worker writes");
+		check(decide(110, 100, 1000) == checkpoint_reason::none, "a burst waits for the spacing");
+		check(decide(115, 100, 64) == checkpoint_reason::burst, "a burst after the spacing");
+		check(decide(115, 100, 63) == checkpoint_reason::none, "below the burst size");
+		check(decide(279, 100, 1) == checkpoint_reason::none, "a trickle waits for the interval");
+		check(decide(280, 100, 1) == checkpoint_reason::interval, "a trickle after the interval");
+		check(decide(100, 200, 1000) == checkpoint_reason::none, "a clock going back never triggers");
+
+		// A session: 20 minutes of frames (16 ms); compile storms and trickles; the runtime's dispatch resets the count
+		// and the time at each checkpoint (MTLPipelineArchive.cpp).
+		const u64 frame_us = 16'000;
+		const u64 end_us = 20ull * 60 * 1'000'000;
+		std::vector<u64> compiled_at;    // pending pipelines' compile times
+		u64 last_us = 0;
+		u64 checkpoints = 0;
+		u64 closest_us = ~0ull;
+		u64 worst_latency_us = 0;
+		u64 previous_checkpoint_us = 0;
+		bool any_checkpoint = false;
+		for (u64 now = 0; now < end_us; now += frame_us)
+		{
+			// One pipeline a frame for the first 3 s, then one every 7 s, and a storm of 200 at minute 10.
+			if (now < 3'000'000)
+			{
+				compiled_at.push_back(now);
+			}
+			if (now >= 3'000'000 && (now % 7'000'000) < frame_us)
+			{
+				compiled_at.push_back(now);
+			}
+			if (now >= 600'000'000 && now < 600'000'000 + 200 * frame_us)
+			{
+				compiled_at.push_back(now);
+			}
+
+			checkpoint_state state;
+			state.now_us = now;
+			state.last_us = last_us;
+			state.new_pipelines = compiled_at.size();
+			if (decide_checkpoint(policy, state) != checkpoint_reason::none)
+			{
+				for (const u64 at : compiled_at)
+				{
+					worst_latency_us = std::max(worst_latency_us, now - at);
+				}
+				compiled_at.clear();
+				if (any_checkpoint)
+				{
+					closest_us = std::min(closest_us, now - previous_checkpoint_us);
+				}
+				previous_checkpoint_us = now;
+				any_checkpoint = true;
+				last_us = now;
+				checkpoints++;
+			}
+		}
+
+		check(checkpoints >= 6 && checkpoints <= 12, "a 20-minute session writes a handful of checkpoints");
+		check(closest_us >= policy.min_spacing_us, "no two checkpoints closer than the spacing");
+		check(worst_latency_us <= policy.interval_us + frame_us, "every pipeline is written within the interval (and a frame)");
+	}
+
+	// ------------------------------------------------------------------------------------------------------------------
+	// An in-memory file system behind the seam: it records every operation and fails the one it is told to.
+	struct fake_files : file_ops
+	{
+		std::map<std::string, std::string> files;
+		std::vector<std::string> log;
+		std::string fail;                 // "<operation> <path>" to fail
+		std::string archive_content = "MTL4ARCHIVE#2";
+
+		bool failing(const std::string& op, const std::string& path)
+		{
+			log.push_back(op + " " + path);
+			return fail == op + " " + path;
+		}
+
+		bool read_text(const std::string& path, std::string& text) override
+		{
+			if (failing("read", path) || !files.count(path))
+			{
+				return false;
+			}
+			text = files[path];
+			return true;
+		}
+
+		bool write_text(const std::string& path, std::string_view text) override
+		{
+			if (failing("write", path))
+			{
+				files[path] = "PARTIAL";  // a failed write may leave a partial file behind
+				return false;
+			}
+			files[path] = std::string(text);
+			return true;
+		}
+
+		bool serialize(const std::string& path) override
+		{
+			if (failing("serialize", path))
+			{
+				files[path] = "PARTIAL";
+				return false;
+			}
+			files[path] = archive_content;
+			return true;
+		}
+
+		bool sync(const std::string& path) override
+		{
+			return !failing("sync", path) && files.count(path);
+		}
+
+		u64 size(const std::string& path) override
+		{
+			log.push_back("size " + path);
+			return files.count(path) ? files[path].size() : 0;
+		}
+
+		bool rename(const std::string& from, const std::string& to) override
+		{
+			if (failing("rename", from) || !files.count(from))
+			{
+				return false;
+			}
+			files[to] = files[from];
+			files.erase(from);
+			return true;
+		}
+
+		bool remove(const std::string& path) override
+		{
+			log.push_back("remove " + path);
+			files.erase(path);
+			return true;
+		}
+	};
+
+	bool no_temporaries(const fake_files& fs)
+	{
+		for (const auto& [path, data] : fs.files)
+		{
+			if (path.find(".partial.") != std::string::npos)
+			{
+				return false;
+			}
+		}
+		return true;
+	}
+
+	void test_checkpoint_sequence()
+	{
+		archive_identity identity;
+		identity.device = "Apple A17 Pro GPU";
+		identity.system = "Version 26.1 (Build 23B85)";
+		const std::string text = identity_text(identity);
+		const auto paths = make_archive_paths("/c/", identity);
+
+		// A first checkpoint: sidecar, then archive, each through a temporary file, sync and rename.
+		{
+			fake_files fs;
+			const auto result = write_checkpoint(fs, paths, text);
+			check(result.ok() && result.bytes == fs.archive_content.size(), "first checkpoint written, its size reported");
+			check(fs.files[paths.archive] == fs.archive_content && fs.files[paths.identity] == text, "archive and sidecar in place");
+			check(no_temporaries(fs), "no temporary file left");
+			const std::vector<std::string> expected = {
+				"read " + paths.identity,
+				"write " + paths.identity_temp,
+				"sync " + paths.identity_temp,
+				"rename " + paths.identity_temp,
+				"remove " + paths.archive_temp,
+				"serialize " + paths.archive_temp,
+				"sync " + paths.archive_temp,
+				"size " + paths.archive_temp,
+				"rename " + paths.archive_temp,
+			};
+			check(fs.log == expected, "the exact sequence: sidecar (temp, sync, rename), archive (clear temp, serialize, sync, size, rename)");
+		}
+
+		// A later checkpoint: the sidecar holds the identity already, only the archive is replaced.
+		{
+			fake_files fs;
+			fs.files[paths.identity] = text;
+			fs.files[paths.archive] = "MTL4ARCHIVE#1";
+			const auto result = write_checkpoint(fs, paths, text);
+			check(result.ok() && fs.files[paths.archive] == "MTL4ARCHIVE#2", "the archive is replaced");
+			check(fs.log.size() == 6 && fs.log[0] == "read " + paths.identity && fs.log[1] == "remove " + paths.archive_temp,
+				"no sidecar write when it holds the identity");
+		}
+
+		// A sidecar of another identity (or damaged) is rewritten.
+		{
+			fake_files fs;
+			fs.files[paths.identity] = "damaged";
+			check(write_checkpoint(fs, paths, text).ok() && fs.files[paths.identity] == text, "a damaged sidecar is rewritten");
+		}
+
+		// Every failure leaves the previous archive untouched and no temporary file.
+		struct failure_case
+		{
+			std::string fail;
+			checkpoint_step step;
+			bool sidecar_written;
+		};
+		const std::vector<failure_case> failures = {
+			{ "write " + paths.identity_temp, checkpoint_step::identity_write, false },
+			{ "sync " + paths.identity_temp, checkpoint_step::identity_write, false },
+			{ "rename " + paths.identity_temp, checkpoint_step::identity_rename, false },
+			{ "serialize " + paths.archive_temp, checkpoint_step::serialize, true },
+			{ "sync " + paths.archive_temp, checkpoint_step::sync, true },
+			{ "rename " + paths.archive_temp, checkpoint_step::rename, true },
+		};
+		for (const auto& test : failures)
+		{
+			fake_files fs;
+			fs.files[paths.identity] = "an older sidecar";
+			fs.files[paths.archive] = "MTL4ARCHIVE#1";
+			fs.fail = test.fail;
+			const auto result = write_checkpoint(fs, paths, text);
+			check(!result.ok() && result.failed == test.step && !result.bytes, "the failing step is reported");
+			check(fs.files[paths.archive] == "MTL4ARCHIVE#1", "the previous archive stays");
+			check(no_temporaries(fs), "the temporary file is removed");
+			check((fs.files[paths.identity] == text) == test.sidecar_written, "the sidecar is replaced only by its own complete rename");
+		}
+
+		// An empty archive is never published.
+		{
+			fake_files fs;
+			fs.files[paths.identity] = text;
+			fs.files[paths.archive] = "MTL4ARCHIVE#1";
+			fs.archive_content.clear();
+			const auto result = write_checkpoint(fs, paths, text);
+			check(result.failed == checkpoint_step::empty && fs.files[paths.archive] == "MTL4ARCHIVE#1" && no_temporaries(fs),
+				"an empty serialization is refused");
+		}
+
+		// The temporary file of a checkpoint a crash interrupted is cleared before the serializer writes.
+		{
+			fake_files fs;
+			fs.files[paths.identity] = text;
+			fs.files[paths.archive_temp] = "STALE";
+			check(write_checkpoint(fs, paths, text).ok() && fs.files[paths.archive] == "MTL4ARCHIVE#2" && no_temporaries(fs),
+				"a stale temporary file never becomes the archive");
+		}
+
+		// A crash between any two operations leaves the previous or the new archive, never a partial one.
+		{
+			fake_files reference;
+			reference.files[paths.identity] = text;
+			reference.files[paths.archive] = "MTL4ARCHIVE#1";
+			write_checkpoint(reference, paths, text);
+			for (usz crash_after = 0; crash_after <= reference.log.size(); ++crash_after)
+			{
+				struct crashing final : fake_files
+				{
+					usz budget = 0;
+					bool alive() { return budget ? (budget--, true) : false; }
+					bool read_text(const std::string& p, std::string& t) override { return alive() && fake_files::read_text(p, t); }
+					bool write_text(const std::string& p, std::string_view t) override { return alive() && fake_files::write_text(p, t); }
+					bool serialize(const std::string& p) override { return alive() && fake_files::serialize(p); }
+					bool sync(const std::string& p) override { return alive() && fake_files::sync(p); }
+					u64 size(const std::string& p) override { return alive() ? fake_files::size(p) : 0; }
+					bool rename(const std::string& f, const std::string& t) override { return alive() && fake_files::rename(f, t); }
+					bool remove(const std::string& p) override { return alive() && fake_files::remove(p); }
+				} fs;
+				fs.files[paths.identity] = text;
+				fs.files[paths.archive] = "MTL4ARCHIVE#1";
+				fs.budget = crash_after;
+				write_checkpoint(fs, paths, text);
+				const std::string archive = fs.files.count(paths.archive) ? fs.files[paths.archive] : std::string("(none)");
+				check(archive == "MTL4ARCHIVE#1" || archive == "MTL4ARCHIVE#2", "after a crash: the previous or the new archive");
+			}
+		}
+
+		check(std::string(checkpoint_step_name(checkpoint_step::serialize)) == "serialization", "step names for the log");
+	}
+}
+
+int main()
+{
+	test_program_cache_keys();
+	test_identity();
+	test_rejection_rules();
+	test_rate_limit();
+	test_checkpoint_sequence();
+
+	if (g_failures)
+	{
+		std::fprintf(stderr, "%d of %d checks failed\n", g_failures, g_checks);
+		return 1;
+	}
+
+	std::printf("PASS: Metal M5 cache rules (%d checks)\n", g_checks);
+	return 0;
+}
