+	inline uint m4_tile_bank_lookup(uint index)
+	{
+		const uint table_row = (index >> 2) & 3;
+		return ((index & 3) + (((table_row & 1) << 1) | (table_row >> 1))) & 3;
+	}
+
+	inline uint m4_tile_offset(uint row, uint col, uint factor, uint num_tiles_per_row, uint tile_base_address, uint tile_address_offset,
+		uint tile_pitch, uint tile_bank, uint image_bpp)
+	{
+		const uint row_offset = (row * tile_pitch) + tile_base_address + tile_address_offset;
+		const uint this_address = row_offset + (col * image_bpp);
+		const uint texel_offset = (this_address - tile_base_address) / 256;
+		const uint tile_x = texel_offset % num_tiles_per_row;
+		const uint tile_y = (texel_offset / num_tiles_per_row) / 64;
+		const uint tile_id = tile_y * num_tiles_per_row + tile_x;
+		const uint tile_selector = (tile_id + (tile_base_address >> 14)) & 0x3ffff;
+		const uint row_address = (tile_selector >> 2) & 0xffff;
+		uint bank_selector = 0;
+		if (factor == 1)
+		{
+			bank_selector = (tile_selector & 3);
+		}
+		else if (factor == 2)
+		{
+			bank_selector = m4_tile_bank_lookup(((tile_selector + ((tile_y & 1) << 1)) & 3) * 4 + (tile_y & 3));
+		}
+		else if (factor >= 4)
+		{
+			bank_selector = m4_tile_bank_lookup((tile_selector & 3) * 4 + (tile_y & 3));
+		}
+		bank_selector = (bank_selector + tile_bank) & 3;
+		uint column_selector = 0;
+		const uint line_offset_in_tile = (texel_offset / num_tiles_per_row) % 64;
+		column_selector |= ((line_offset_in_tile >> 3) & 0x7) << 7;
+		column_selector |= ((this_address >> 5) & 0x7) << 4;
+		column_selector |= ((line_offset_in_tile >> 0) & 0x3) << 2;
+		const uint partition_selector = (((line_offset_in_tile >> 2) & 1) + ((this_address >> 6) & 1)) & 1;
+		uint tile_address = 0;
+		tile_address |= ((row_address >> 0) & 0xFFFF) << 16;
+		tile_address |= ((bank_selector >> 0) & 0x3) << 14;
+		tile_address |= ((column_selector >> 4) & 0x3F) << 8;
+		tile_address |= ((partition_selector >> 0) & 0x1) << 7;
+		tile_address |= ((column_selector >> 2) & 0x3) << 5;
+		tile_address |= ((this_address >> 0) & 0x1F) << 0;
+		tile_address ^= (((tile_address >> 12) ^ ((bank_selector ^ tile_selector) & 1) ^ (tile_address >> 14)) & 1) << 9;
+		tile_address ^= ((tile_address >> 11) & 1) << 10;
+		return tile_address - tile_base_address;
+	}
+
+	inline uint m4_detile_source(uint linear_byte, uint factor, uint num_tiles_per_row, uint tile_base_address, uint tile_size,
+		uint tile_address_offset, uint tile_rw_offset, uint tile_pitch, uint tile_bank, uint image_width, uint image_height,
+		uint image_pitch, uint image_bpp, uint tiled_length)
+	{
+		const uint row = linear_byte / image_pitch;
+		const uint in_row = linear_byte % image_pitch;
+		if (row >= image_height || in_row >= image_width * image_bpp)
+		{
+			return 0xFFFFFFFFu;
+		}
+		const uint tile_base_offset = m4_tile_offset(row, in_row / image_bpp, factor, num_tiles_per_row, tile_base_address, tile_address_offset,
+			tile_pitch, tile_bank, image_bpp);
+		if (tile_base_offset >= tile_size || tile_base_offset < tile_rw_offset)
+		{
+			return 0xFFFFFFFFu;
+		}
+		const uint source = tile_base_offset - tile_rw_offset + (in_row % image_bpp);
+		return (source < tiled_length) ? source : 0xFFFFFFFFu;
+	}
+)
