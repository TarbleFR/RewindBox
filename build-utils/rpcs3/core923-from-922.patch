--- /dev/null
+++ b/rpcs3/ios/IOSAutoSpuProfile923.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+
+// REWINDBOX_SPU_PROFILE_923: where do the SPU threads spend their time?
+//
+// Build 723, God of War III (BCES00510, PID 48627, fresh boot, MLAA bypass applied, no colour read-back): the play
+// windows 41-52 run at 9-13 guest frames per second with the GPU busy 14-21 %, the main PPU thread at 0.8-0.85 core and
+// five SPU threads at 0.6-0.83 core each (3.3-3.6 cores) on a device of two performance and four efficiency cores;
+// waits, compilations and synchronisations are small. The frame follows the SPU work and nothing in the journal says
+// what that work is. The region profile of Core 912 (ios/IOSCapture912.h, ppu_profile) reads PPU threads only.
+// When the SPU threads used at least `bound_cores` cores together in `windows_needed` consecutive running windows that
+// showed frames, the report asks once per boot for a region profile; that capture also samples the SPU threads
+// (state, pc, system call when waiting), about once per millisecond for at most 5000 samples. It stops no thread and
+// changes nothing; lines COREPROF SPUPROF923. With the LLVM SPU recompiler the pc field is written at the entry of a
+// compiled chunk and before calls out of it: a sample names a chunk of the program, not an instruction.
+namespace rpcs3::ios::auto_spu_profile
+{
+inline constexpr double bound_cores = 2.5;
+inline constexpr std::uint32_t windows_needed = 2;
+inline constexpr std::uint32_t max_threads = 8;
+
+struct tracker
+{
+	std::uint64_t session = ~0ull;
+	std::uint32_t consecutive = 0;
+	bool asked = false;
+
+	// One call per report window. True once per boot session: ask for the profile now.
+	bool observe(std::uint64_t now_session, bool running, std::uint64_t guest_flips, double spu_cores) noexcept
+	{
+		if (now_session != session)
+		{
+			session = now_session;
+			consecutive = 0;
+			asked = false;
+		}
+
+		if (!running || !guest_flips || !(spu_cores >= bound_cores))
+		{
+			consecutive = 0;
+			return false;
+		}
+
+		if (asked || ++consecutive < windows_needed)
+		{
+			return false;
+		}
+
+		asked = true;
+		return true;
+	}
+};
+} // namespace rpcs3::ios::auto_spu_profile
