+// REWINDBOX_MEMORY_PARTS_923: what the kernel's ledger attributes the footprint to. JITMEM's pools are requested Vulkan
+// allocations (855 MiB of blocks "unused" in God of War III, build 723), which say nothing about physical memory; the
+// ledger's graphics tag is the memory Metal really holds for the process.
+struct memory_parts_sample
+{
+	bool valid = false;
+	u64 internal = 0, compressed = 0, graphics = 0, graphics_compressed = 0, external = 0, reusable = 0;
+};
+
+memory_parts_sample sample_memory_parts()
+{
+	memory_parts_sample parts;
+#if defined(__APPLE__) && defined(TASK_VM_INFO_REV3_COUNT)
+	task_vm_info_data_t info{};
+	mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+	if (task_info(mach_task_self(), TASK_VM_INFO, reinterpret_cast<task_info_t>(&info), &count) == KERN_SUCCESS &&
+		count >= TASK_VM_INFO_REV3_COUNT)
+	{
+		parts.valid = true;
+		parts.internal = info.internal;
+		parts.compressed = info.compressed;
+		parts.external = info.external;
+		parts.reusable = info.reusable;
+		parts.graphics = static_cast<u64>(info.ledger_tag_graphics_footprint);
+		parts.graphics_compressed = static_cast<u64>(info.ledger_tag_graphics_footprint_compressed);
+	}
+#endif
+	return parts;
+}
