+#pragma once
+#include <memory>
+#include <mutex>
+
+// Value owns its compiled resource; this gate itself holds no Vulkan owner.
+// The value is immutable after resolve returns and can be shared across cache merges.
+template<class Value> class MVKDeferredCompilation {
+public:
+	template<class Compile> bool resolve(bool failOnCompileRequired, Compile&& compile) {
+		std::unique_lock<std::mutex> lock(_lock, std::defer_lock);
+		if (failOnCompileRequired) {
+			if (!lock.try_lock()) { return false; }
+		} else {
+			lock.lock();
+		}
+		if (!_attempted && !failOnCompileRequired) {
+			// Set before calling the compiler: errors are terminal, not retry loops.
+			_attempted = true;
+			compile(_value);
+		}
+		return static_cast<bool>(_value);
+	}
+	const Value& value() const { return _value; }
+private:
+	std::mutex _lock;
+	bool _attempted = false;
+	Value _value;
+};
