+
+// A bad imported entry must not poison the entire cache (setConfigurationResult
+// is sticky). The existing graphics/compute caller reports a terminal pipeline
+// failure if both the imported MSL and the one fresh SPIR-V conversion fail.
+class MVKImportedShaderLibraryCompiler : public MVKShaderLibraryCompiler {
+public:
+	MVKImportedShaderLibraryCompiler(MVKVulkanAPIDeviceObject* owner) : MVKShaderLibraryCompiler(owner) {}
+protected:
+	void handleError() override {
+		if (_mtlLibrary) {
+			MVKShaderLibraryCompiler::handleError();
+		} else {
+			MVKLogWarn("Imported shader library compile failed (Error code %li): %s",
+				(long)_compileError.code, _compileError.localizedDescription.UTF8String);
+		}
+	}
+};
+
+static id<MTLLibrary> compileImportedMSL(MVKPipeline* pipeline, const string& msl,
+									   const SPIRVToMSLConversionResultInfo& resultInfo) {
+	auto* compiler = new MVKImportedShaderLibraryCompiler(pipeline);
+	NSString* source = [[NSString alloc] initWithUTF8String:msl.c_str()];
+	id<MTLLibrary> library = compiler->newMTLLibrary(source, resultInfo, {});
+	[source release];
+	compiler->destroy();
+	return library; // retained
+}
+
+bool MVKShaderLibrary::prepareDeferredLibrary(SPIRVToMSLConversionConfiguration* pShaderConfig,
+											MVKShaderModule* shaderModule, MVKPipeline* pipeline) {
+	if (!_deferredLibrary) { return true; }
+	bool ready = _deferredLibrary->resolve(pipeline->shouldFailOnPipelineCompileRequired(),
+		[&](MVKDeferredShaderLibrary& runtime) {
+			runtime.resultInfo = _shaderConversionResultInfo;
+			runtime.compressedMSL = _compressedMSL;
+			string msl;
+			decompressMSL(msl);
+			runtime.library = compileImportedMSL(pipeline, msl, runtime.resultInfo);
+			if (!runtime.library && !shaderModule->getSPIRV().empty()) {
+				// One fresh conversion per imported entry, with a private converter.
+				// Concurrent ordinary cache misses may use the module's converter.
+				SPIRVToMSLConversionResult conversion;
+				if (shaderModule->convertFresh(pShaderConfig, conversion)) {
+					runtime.library = compileImportedMSL(pipeline, conversion.msl, conversion.resultInfo);
+					if (runtime.library) {
+						runtime.resultInfo = conversion.resultInfo;
+						runtime.compressedMSL.compress(conversion.msl, getMVKConfig().shaderSourceCompressionAlgorithm);
+					}
+				}
+			}
+			runtime.shaderConfig = *pShaderConfig;
+		});
+	if (ready) { pShaderConfig->alignWith(_deferredLibrary->value().shaderConfig); }
+	return ready;
+}
