diff --git a/rpcs3/ios/IOSGpuMemoryPacking.h b/rpcs3/ios/IOSGpuMemoryPacking.h
new file mode 100644
index 0000000..2bd4633
--- /dev/null
+++ b/rpcs3/ios/IOSGpuMemoryPacking.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_GPU_MEMORY_PACKING_925: the Vulkan memory allocator (VMA) carves every allocation under half a block out
+// of 64 MiB blocks (VRAMBudgetPolicy.h), and on an Apple GPU MoltenVK backs each block with one placement MTLHeap of
+// that size: a block is physical memory for as long as one allocation lives in it. Upstream picks VMA's fastest
+// strategy until the allocator's load exceeds 75 % of the heap, and the heap MoltenVK reports is the unified memory of
+// the device (7.4 GiB), so on iOS the fastest strategy is the only one ever used.
+//
+// IPA 724, Call of Duty: Black Ops II, pid 50194, session 8 (JITMEM, one sample per 5 s): the bytes allocated reach
+// 805 MiB after 2 minutes and stay there (777-813 MiB), while the blocks go from 648 to 1136 MiB in steps of 64 MiB
+// and the unused part of the blocks from 45 to 360 MiB; the kernel's graphics ledger (COREPROF MEMPARTS923) follows the
+// blocks, not the allocations (ledger minus blocks: 198, 209, 250-290 MiB; ledger minus allocations: 293, 448,
+// 580 MiB), and the footprint goes from 3.40 to 4.06 GB. The textures the title streams are allocated and released all
+// the time, in every size; each release leaves a hole only an allocation of that size or smaller can take.
+//
+// With the lever on:
+// - an allocation of `dedicated_from` bytes or more gets device memory of its own (VMA dedicated memory, as it already
+//   does unasked above half a block): its memory goes back to the system when it is released, and it leaves no hole;
+// - the smaller ones are placed in the smallest free range that fits (VMA's minimum-memory strategy, the one upstream
+//   switches to under pressure) instead of the first one found.
+// What is allocated, when, and its contents do not change; only where the allocator places it.
+// Host experiment on the pinned VMA 3.3.0 behind a mock device (test/rpcs3_gpu_memory_packing925_test.py), a Black Ops
+// II-shaped load (521 MiB that stay, textures of 16 KiB to 4 MiB allocated and released at random up to 290 MiB):
+// unused block bytes 166-204 MiB before, 28-51 MiB after. Not measured on an iPhone.
+namespace rpcs3::ios::gpu_memory_packing
+{
+inline std::atomic<bool> enabled{false};
+
+// Allocations from this size up get memory of their own.
+inline constexpr std::uint64_t dedicated_from = 1024 * 1024;
+
+constexpr bool wants_dedicated(bool lever_on, std::uint64_t size) noexcept
+{
+	return lever_on && size >= dedicated_from;
+}
+
+// Since boot: allocations this lever gave memory of their own, and their bytes (COREPROF GPUPACK925).
+inline std::atomic<std::uint64_t> dedicated_allocations{0};
+inline std::atomic<std::uint64_t> dedicated_bytes{0};
+
+inline void note_dedicated(std::uint64_t size) noexcept
+{
+	dedicated_allocations.fetch_add(1, std::memory_order_relaxed);
+	dedicated_bytes.fetch_add(size, std::memory_order_relaxed);
+}
+} // namespace rpcs3::ios::gpu_memory_packing
