+
+void MTLGSRender::report_counters_if_due()
+{
+	// REWINDBOX_METAL_TIMED_REPORT_906: AC IV (BLES01882, IPA 676) stopped presenting after about 555 frames, before the
+	// 600-frame report, so its log held no COREPROF METAL line at all. RSX thread only (the counters it reads are its own).
+	const u64 now = get_system_time();
+	if (now - m_last_counter_report_us < 5'000'000)
+	{
+		return;
+	}
+	m_last_counter_report_us = now;
+	report_counters();
+}
+
+void MTLGSRender::report_drain_state()
+{
+	// What a guest waiting on the RSX can be waiting for while the FIFO is empty: submissions not yet made or not yet
+	// completed, ZCULL reports whose segments are in them, a scheduled ZCULL flush, a pending fault flush.
+	u64 unsubmitted_reports = 0;
+	u64 in_flight_reports = 0;
+	const u64 submitted = m_commands.last_submitted();
+	const u64 completed = m_commands.completed();
+	for (const auto& record : m_query_records)
+	{
+		if (!record.has_data)
+		{
+			continue;
+		}
+		unsubmitted_reports += record.last_fence > submitted ? 1 : 0;
+		in_flight_reports += (record.last_fence <= submitted && record.last_fence > completed) ? 1 : 0;
+	}
+	const u64 now = get_system_time();
+	rsx_log.notice("COREPROF METAL state frames=%llu flip_age_ms=%llu recording=%d submitted=%llu completed=%llu query_cb_fence=%llu "
+		"active_query=%d unsubmitted_reports=%llu in_flight_reports=%llu zcull_flush_pending=%d offloader_deadlock=%d in_begin_end=%d "
+		"get=0x%x put=0x%x",
+		m_frame_index, m_last_flip_us ? (now - m_last_flip_us) / 1000 : 0, m_commands.recording() ? 1 : 0, submitted, completed,
+		m_query_cb_fence, m_active_query_info ? 1 : 0, unsubmitted_reports, in_flight_reports, m_zcull_flush_pending ? 1 : 0,
+		m_offloader_deadlock ? 1 : 0, in_begin_end ? 1 : 0, ctrl ? +ctrl->get : 0u, ctrl ? +ctrl->put : 0u);
 }
 
