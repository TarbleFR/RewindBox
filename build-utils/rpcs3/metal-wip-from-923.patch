diff --git a/rpcs3/ios/IOSPassiveLockGate.h b/rpcs3/ios/IOSPassiveLockGate.h
index 0fe3d1f..3d51930 100644
--- a/rpcs3/ios/IOSPassiveLockGate.h
+++ b/rpcs3/ios/IOSPassiveLockGate.h
@@ -291,4 +291,63 @@ inline bool defer_writer() noexcept
 
 	return true;
 }
+
+// REWINDBOX_GATE_BEFORE_LINE_924: an accurate PUTLLC takes its line's reservation lock
+// (rsrv_unique_lock) and only then the writer lock, whose deferral above ran with that
+// line locked. During the window a
+// starving PPU opened on leaving, the first SPU to reach its writer lock therefore kept its
+// line locked for the whole window: a PPU whose next step is a conditional store on that
+// same line (ppu_store_reservation fails on a locked line) spent every window failing it.
+// IPA 724, Call of Duty: Black Ops II, pid 50194: the main thread waits for a semaphore, the
+// PPU thread Secondary holds a reservation on 0x2e208d8 whose word shows the lock of another
+// thread for 27 us across the dump, and six SPUs complete 1.5 million PUTLLC per second on
+// that line (7.5 million per 5 s window, none sleeping), 6010 windows opened and 8671 writer
+// locks deferred 115 us each in the same window; no frame for the rest of the session.
+// The deferral is now made before the line is locked, and the writer lock that follows does
+// not defer a second time. The same waits, in the same bound; the reservation time and the
+// line's contents are validated after it exactly as before (the lock is taken by the same
+// fetch_op, the comparison is made under the same writer lock). Nothing is skipped: a PUTLLC
+// whose line changed while it deferred fails, as it does when the line changes at any other
+// moment before its lock. A PPU's conditional store of a full line and a 128-byte store keep
+// the earlier order (they lock their line, then defer in the writer lock): neither is on the
+// path observed, and PPUThread.cpp is an input of the PPU cache identity.
+inline thread_local bool deferred_ahead = false;
+
+class ahead_scope
+{
+public:
+	// `active` false: no deferral here, and the writer lock defers as before.
+	explicit ahead_scope(bool active = true) noexcept
+		: m_active(active)
+	{
+		if (active)
+		{
+			defer_writer();
+			deferred_ahead = true;
+		}
+	}
+
+	ahead_scope(const ahead_scope&) = delete;
+	ahead_scope& operator=(const ahead_scope&) = delete;
+
+	~ahead_scope()
+	{
+		if (m_active)
+		{
+			deferred_ahead = false;
+		}
+	}
+
+private:
+	const bool m_active;
+};
+
+// vm::writer_lock: defers unless the caller did so before locking its line.
+inline void defer_writer_once() noexcept
+{
+	if (!deferred_ahead)
+	{
+		defer_writer();
+	}
+}
