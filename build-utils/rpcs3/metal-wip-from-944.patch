diff --git a/rpcs3/ios/IOSThermalPolicy931.h b/rpcs3/ios/IOSThermalPolicy931.h
index 041a100..c10817b 100644
--- a/rpcs3/ios/IOSThermalPolicy931.h
+++ b/rpcs3/ios/IOSThermalPolicy931.h
@@ -9,6 +9,7 @@
 
 #include "IOSShardedCounter931.h"
 #include "IOSWriterParkSpin917.h" // compare::event_waits_forced, set by the report thread inside a comparison step
+#include "IOSEventWait931.h"     // REWINDBOX_EVENT_WAITS_ALWAYS_945: event_wait::wfe_verdict
 
 // REWINDBOX_THERMAL_POLICY_931: the Core follows the iPhone's thermal state (ProcessInfo.thermalState, posted by
 // the system: 0 nominal, 1 fair, 2 serious, 3 critical) and, once the device is hot, changes HOW some short waits
@@ -40,10 +41,27 @@ constexpr bool decide(std::uint8_t mode, int thermal_state, int forced) noexcept
 	return mode == 1 ? true : mode == 2 ? false : thermal_state >= automatic_from;
 }
 
+// REWINDBOX_EVENT_WAITS_ALWAYS_945: on Automatic, the waits are event waits in every thermal state once the WFE
+// self-test has found that the sequence rests the core (event_wait::wfe_verdict 1, REWINDBOX_WFE_SLEEP_940). IPA 767
+// logs (17 November 2026, Core 943): the phone stayed nominal or fair in all 239 report windows since Core 931, so
+// these waits never rested a core (THERMAL931 event_waits=off in every window) while Black Ops II made 1.55 million
+// exact PUTLLC per 5 s window, each a writer spinning until every running PPU thread parks and the PPU threads
+// spinning behind it (build 676: 2.4 to 2.9 s of SPU thread time per window acquiring those locks; Core 935: 530 ms of
+// PPU time waiting behind them). The RSX FIFO idle wait has used the same rule since Core 941, and its wait ended
+// within 2 us in 99.7 % of 74,000 waits per window on IPA 767. What each wait waits for, its bound and its fallback
+// are unchanged; the awaited write clears the monitor and ends the WFE. Enabled and Disabled are as before, and so is a
+// lever comparison step (forced). Before the self-test, or if it fails, Automatic is the Core 931 rule (serious).
 inline bool event_waits() noexcept
 {
-	return decide(setting.load(std::memory_order_relaxed), state.load(std::memory_order_relaxed),
-		writer_park::compare::event_waits_forced.load(std::memory_order_relaxed));
+	const std::uint8_t mode = setting.load(std::memory_order_relaxed);
+	const int forced = writer_park::compare::event_waits_forced.load(std::memory_order_relaxed);
+
+	if (mode == 0 && forced < 0 && event_wait::wfe_verdict.load(std::memory_order_relaxed) == 1)
+	{
+		return true;
+	}
+
+	return decide(mode, state.load(std::memory_order_relaxed), forced);
 }
 
