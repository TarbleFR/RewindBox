+		// Lever off: the Core 659 sequence, prepare, upload_texture and finish (three cache locks).
+		// Lever on: one reader lock for the binding, the memo and the lookup, passed to upload_texture_impl,
+		// which upgrades it for a CPU upload. A hit returns the descriptor an identical lookup returned
+		// earlier in this epoch, stamped with the store's current write tag, without the lookup; the sampler
+		// validation and everything load_texture_env derives from the descriptor run as for any lookup.
+		// A sampled hit (should_verify) runs the full lookup, returns its result and compares.
+		template <typename RsxTextureType, typename surface_store_type>
+		sampled_image_descriptor upload_sampler_texture(commandbuffer_type& cmd, const RsxTextureType& tex, surface_store_type& m_rtts, u32 index, u32 memo_flags)
+		{
+			namespace memo = rpcs3::ios::texture_lookup_memo;
+			const auto memo_mode = memo::current_mode();
+			if (memo_mode == memo::mode::off)
+			{
+				const auto validation_stamp = prepare_sampler_validation(index);
+				auto result = upload_texture(cmd, tex, m_rtts);
+				finish_sampler_validation(index, result, validation_stamp, m_rtts);
+				return result;
+			}
+
+			const u64 lookup_begin = utils::get_tsc();
+			reader_lock lock(m_cache_mutex);
+			memo::count(memo::counters.lookups);
+			memo::count(memo::counters.locks_avoided, 2);
+			const auto validation_stamp = m_sampler_validation.prepare(index);
+
+			// Everything the exact lookup reads from the texture unit, and the address it resolves to now.
+			const memo::key key{ rsx::get_address(tex.offset(), tex.location()), tex.lookup_words(), memo_flags };
+			const bool compressed = helpers::is_compressed_gcm_format(tex.format() & ~(CELL_GCM_TEXTURE_LN | CELL_GCM_TEXTURE_UN));
+			// The only surface store input of an exact local lookup (fast_texture_search); address 0 is never memoized.
+			const bool bound = !compressed && (!key.address || m_rtts.address_is_bound(key.address));
+
+			const auto found = m_lookup_memo.find(index, key, compressed, bound);
+			// The first reuse of each (slot, key) of the boot, then the sampled hits (IOSTextureLookupMemo.h).
+			const bool first_reuse = found.value && memo_mode != memo::mode::verify_all &&
+				memo::verify_first_reuse.load(std::memory_order_relaxed) && m_lookup_memo.first_reuse(index, key);
+			const bool verify = found.value && (memo::should_verify(memo_mode, memo::boot_hits.fetch_add(1, std::memory_order_relaxed)) || first_reuse);
+			if (first_reuse)
+			{
+				memo::count(memo::counters.first_reuses);
+			}
+			if (found.value && !verify)
+			{
+				sampled_image_descriptor result = *found.value;
+				result.surface_cache_tag = m_rtts.write_tag;
+				result.ios_validation_stamp = validation_stamp;
+				finish_sampler_validation_locked(index, result, m_rtts);
+				memo::count(memo::counters.hits);
+				memo::count(memo::counters.hit_ticks, utils::get_tsc() - lookup_begin);
+				return result;
+			}
+
+			memo::count_miss(found.reason);
+			// After a verified difference the memo stays out of the way: the lookup and its binding only.
+			const bool store = !verify && found.reason != memo::miss::disabled;
+			sampled_image_descriptor expected;
+			typename lookup_memo_type::ticket ticket{};
+			if (verify)
+			{
+				expected = *found.value;
+			}
+			else if (store)
+			{
+				ticket = m_lookup_memo.begin(index, key);
+			}
+
+			const auto sections_before = memo::generations::now();
+			const u32 cpu_uploads_before = m_texture_upload_misses_this_frame;
+			auto result = upload_texture_impl(cmd, tex, m_rtts, &lock);
+			if (m_texture_upload_misses_this_frame != cpu_uploads_before)
+			{
+				memo::count(memo::counters.cpu_uploads);
+			}
+
+			if (verify)
+			{
+				expected.surface_cache_tag = m_rtts.write_tag;
+				u32 differences = memo::compare(expected, result);
+				if (!sections_before.sections_equal(memo::generations::now()))
+				{
+					// The memo would have skipped a change the full lookup made.
+					differences |= memo::differs_state;
+				}
+				memo::count(memo::counters.verified);
+				if (differences)
+				{
+					memo::count(memo::counters.mismatches);
+					memo::disabled.store(true, std::memory_order_relaxed);
+					m_lookup_memo.clear();
+					if (!memo::mismatch_logged.exchange(true, std::memory_order_relaxed))
+					{
+						rsx_log.error("TEXMEMO660 verification mismatch: slot=%u address=0x%x words=0x%x:0x%x:0x%x:0x%x:0x%x:0x%x flags=%u "
+							"differences=0x%x; the texture lookup memo is off for the rest of this boot", index, key.address,
+							key.words[0], key.words[1], key.words[2], key.words[3], key.words[4], key.words[5], key.flags, differences);
+					}
+				}
+			}
+
+			result.ios_validation_stamp = validation_stamp;
+			const u64 bound_length = finish_sampler_validation_locked(index, result, m_rtts);
+
+			if (store)
+			{
+				// Only a direct shader_read view of the section at the key's address: no render target, no
+				// deferred or gathered descriptor, no cyclic reference.
+				const bool direct = result.image_handle && result.upload_context == rsx::texture_upload_context::shader_read &&
+					result.external_subresource_desc.op == deferred_request_command::nop && !result.is_cyclic_reference &&
+					!result.ios_direct_framebuffer && result.ref_address == key.address &&
+					result.ios_validation_range.valid() && result.ios_validation_range.start == key.address;
+				switch (m_lookup_memo.end(ticket, key, compressed, bound, result, direct, key.address, bound_length))
+				{
+				case lookup_memo_type::store_result::stored: memo::count(memo::counters.stores); break;
+				case lookup_memo_type::store_result::changed: memo::count(memo::counters.unstored_changed); break;
+				case lookup_memo_type::store_result::kind: memo::count(memo::counters.unstored_kind); break;
+				case lookup_memo_type::store_result::bound: memo::count(memo::counters.unstored_bound); break;
+				}
+			}
+
+			memo::count(memo::counters.lookup_ticks, utils::get_tsc() - lookup_begin);
+			return result;
+		}
+#endif
+
