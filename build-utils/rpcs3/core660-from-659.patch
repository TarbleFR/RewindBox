diff --git a/rpcs3/ios/IOSSpuObjectBindings.h b/rpcs3/ios/IOSSpuObjectBindings.h
new file mode 100644
index 0000000..e2ccd63
--- /dev/null
+++ b/rpcs3/ios/IOSSpuObjectBindings.h
@@ -0,0 +1,355 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+// REWINDBOX_SPU_DIRECT_OBJECT_HIT_660: Black Ops II links 8,700-8,800 SPU blocks at the first
+// transition of each boot, every one of them a hit of the persistent object cache (IPA 657,
+// Core 655, session 2 window 5: 8,793 blocks). A hit still builds the whole IR of the block,
+// only to name the symbols the cached object needs, then throws it away: about 0.19 ms of
+// spu_build per block next to 0.18 ms of object load.
+//
+// The object itself already names what it needs. Its undefined symbols are exactly the names
+// the IR declared and mapped on the engine:
+// - the helper of every call("name", function, ...) of the block translator (CPUTranslator.h
+//   call() maps the literal name to that function), plus spu_dispatcher, spu_timebase_offs and
+//   spu_segment_base, each mapped by one line of SPULLVMRecompiler.cpp;
+// - "<module name>-pp-<N>", one fresh branch patchpoint (make_branch_patchpoint(), data 0) each.
+// A hit whose undefined symbols are all of these links the object directly: the bindings are the
+// same expressions the IR path maps under the same names, the patchpoints are fresh stubs of the
+// same kind. Anything else (a name the table does not know, libm, memcpy, outline atomics, an
+// absolute global, a duplicate, a malformed or out-of-bound patchpoint, a second definition, a
+// missing entry, a failed copy of the object) leaves the object to the IR path of the same
+// compile() call, exactly as before.
+//
+// Name resolution is MCJIT's and the same on both paths (LLVM 18 and 20, checked on the host): an
+// undefined name of an object being loaded resolves first from RuntimeDyld's own table, which holds
+// every named definition of the objects already loaded in this engine, local and internal ones
+// included; then from the engine's resolver (the global map, where the bindings are, then that
+// table); last from the memory manager (MemoryManager1/2::findSymbol in Utilities/JITLLVM.cpp:
+// process symbols, then make_null_function()). The global map does not come first: a binding
+// decides a name only because no object of this engine defines that name. None does: a block
+// object defines its entry (its only global) and the locals spu_test_state, __spu-null,
+// __spu-cx*, __spu-fx*, __unnamed_N and the $x/$d mapping symbols; the LLVM interpreter object
+// defines spu_interpreter, spu_<MNEMONIC>[_<hex>], spu_ret and __unnamed_N. No table name and no
+// "<hash>-pp-<N>" name is among them, and the host audit (spu_direct_hit660_test.py) fails if one
+// of these names gets a body, an initializer or an internal or private linkage anywhere in
+// SPULLVMRecompiler.cpp or CPUTranslator.h. The IR hit path links the same object under the same
+// names in the same engine, with exactly this precedence too.
+//
+// This header only classifies a symbol list against a table of names. It has no LLVM or RPCS3
+// dependency so that the host test compiles it as it is.
+namespace rpcs3::ios::spu_direct_hit
+{
+inline std::atomic<bool> enabled{false}; // experimental.spu_direct_object_hits
+
+enum class reason : std::uint32_t
+{
+	accepted,
+	object_unreadable,    // the object does not parse or is not for this engine's architecture
+	symbol_unreadable,    // a symbol name or flags could not be read
+	symbol_bound,         // more symbols than max_symbols
+	absolute_global,      // a global absolute symbol (same rule as JITMinimalObject.h)
+	unknown_symbol,       // an undefined name that is neither a table name nor a patchpoint of this module
+	duplicate_symbol,     // an undefined name listed twice
+	malformed_patchpoint, // "<entry>-pp-" followed by anything but the regenerated decimal number
+	patchpoint_bound,     // a patchpoint number or count above the bounds
+	foreign_definition,   // a defined global symbol that is not the entry
+	missing_entry,        // the entry is not defined
+	duplicate_entry,      // the entry is defined twice
+	null_binding,         // a table expression evaluated to 0 in this process
+	copy_failed,          // the copy of the object handed to MCJIT could not be allocated
+	add_rejected,         // jit_minimal_object::add refused the object before loading it
+	count
+};
+
+inline constexpr std::size_t reason_count = static_cast<std::size_t>(reason::count);
+
+inline constexpr std::array<std::string_view, reason_count> reason_names{
+	"accepted", "object_unreadable", "symbol_unreadable", "symbol_bound", "absolute_global", "unknown_symbol",
+	"duplicate_symbol", "malformed_patchpoint", "patchpoint_bound", "foreign_definition", "missing_entry",
+	"duplicate_entry", "null_binding", "copy_failed", "add_rejected"};
+static_assert(!reason_names[reason_count - 1].empty(), "one name per reason");
+
+struct symbol
+{
+	std::string_view name;
+	bool readable = true;   // name and flags could be read
+	bool undefined = false; // SF_Undefined
+	bool absolute = false;  // SF_Absolute
+	bool global = false;    // SF_Global
+};
+
+struct plan
+{
+	reason result = reason::accepted;
+	std::vector<std::uint32_t> named;       // indices into the binding table, ascending, each once
+	std::vector<std::uint32_t> patchpoints; // patchpoint numbers, ascending, each once
+	std::string_view offending;             // the symbol that decided a rejection (a view of the input: copy it)
+};
+
+inline constexpr std::size_t max_symbols = 65536;
+inline constexpr std::uint32_t max_patchpoint = (1u << 20) - 1;
+
+// The direct path never allocates more stubs than this for one block. The IR path allocates one per
+// tail_chunk(nullptr) of each emitted chunk; an object above the bound keeps the IR path.
+constexpr std::size_t patchpoint_limit(std::size_t guest_words) noexcept
+{
+	return std::min<std::size_t>(guest_words * 16 + 64, std::size_t{max_patchpoint} + 1);
+}
+
+// name == entry + "-pp-" + decimal(id) exactly, the way fmt::format("%s-pp-%u", m_hash, id) wrote it:
+// no sign, no leading zero, no suffix, a value that fits 32 bits.
+constexpr bool parse_patchpoint(std::string_view entry, std::string_view name, std::uint32_t& id) noexcept
+{
+	constexpr std::string_view infix = "-pp-";
+	if (name.size() <= entry.size() + infix.size() || name.substr(0, entry.size()) != entry ||
+		name.substr(entry.size(), infix.size()) != infix)
+	{
+		return false;
+	}
+
+	const std::string_view digits = name.substr(entry.size() + infix.size());
+	std::uint32_t value = 0;
+	const auto [end, error] = std::from_chars(digits.data(), digits.data() + digits.size(), value, 10);
+	if (error != std::errc() || end != digits.data() + digits.size())
+	{
+		return false;
+	}
+
+	char regenerated[16]{};
+	const auto [last, error2] = std::to_chars(regenerated, regenerated + sizeof(regenerated), value, 10);
+	if (error2 != std::errc() || std::string_view(regenerated, static_cast<std::size_t>(last - regenerated)) != digits)
+	{
+		return false;
+	}
+
+	id = value;
+	return true;
+}
+
+constexpr bool is_patchpoint_name(std::string_view entry, std::string_view name) noexcept
+{
+	constexpr std::string_view infix = "-pp-";
+	return name.size() >= entry.size() + infix.size() && name.substr(0, entry.size()) == entry &&
+		name.substr(entry.size(), infix.size()) == infix;
+}
+
+// Every undefined, named symbol must be a table name or a patchpoint of `entry`; the entry must be the
+// only defined global symbol, defined once. Undefined symbols without a name are ignored, as
+// JITMinimalObject.h ignores them.
+inline plan classify(std::string_view entry, std::span<const symbol> symbols, std::span<const std::string_view> table,
+	std::size_t max_patchpoints)
+{
+	plan result;
+	const auto reject = [&](reason why, std::string_view name)
+	{
+		result.result = why;
+		result.offending = name;
+		result.named.clear();
+		result.patchpoints.clear();
+		return result;
+	};
+
+	if (entry.empty() || symbols.size() > max_symbols)
+	{
+		return reject(entry.empty() ? reason::missing_entry : reason::symbol_bound, {});
+	}
+
+	std::size_t entries = 0;
+	std::vector<bool> seen(table.size(), false);
+
+	for (const symbol& sym : symbols)
+	{
+		if (!sym.readable)
+		{
+			return reject(reason::symbol_unreadable, sym.name);
+		}
+
+		if (sym.absolute && sym.global)
+		{
+			return reject(reason::absolute_global, sym.name);
+		}
+
+		if (!sym.undefined)
+		{
+			if (sym.name == entry)
+			{
+				// MCJIT finds the entry by name among the global symbols of the loaded objects.
+				if (!sym.global)
+				{
+					return reject(reason::missing_entry, sym.name);
+				}
+
+				if (++entries > 1)
+				{
+					return reject(reason::duplicate_entry, sym.name);
+				}
+			}
+			else if (sym.global)
+			{
+				return reject(reason::foreign_definition, sym.name);
+			}
+
+			continue;
+		}
+
+		if (sym.name.empty())
+		{
+			continue;
+		}
+
+		const auto found = std::find(table.begin(), table.end(), sym.name);
+		if (found != table.end())
+		{
+			const auto index = static_cast<std::size_t>(found - table.begin());
+			if (seen[index])
+			{
+				return reject(reason::duplicate_symbol, sym.name);
+			}
+
+			seen[index] = true;
+			continue;
+		}
+
+		if (!is_patchpoint_name(entry, sym.name))
+		{
+			return reject(reason::unknown_symbol, sym.name);
+		}
+
+		std::uint32_t id = 0;
+		if (!parse_patchpoint(entry, sym.name, id))
+		{
+			return reject(reason::malformed_patchpoint, sym.name);
+		}
+
+		if (id > max_patchpoint || result.patchpoints.size() >= max_patchpoints)
+		{
+			return reject(reason::patchpoint_bound, sym.name);
+		}
+
+		result.patchpoints.push_back(id);
+	}
+
+	if (!entries)
+	{
+		return reject(reason::missing_entry, entry);
+	}
+
+	std::sort(result.patchpoints.begin(), result.patchpoints.end());
+	if (std::adjacent_find(result.patchpoints.begin(), result.patchpoints.end()) != result.patchpoints.end())
+	{
+		return reject(reason::duplicate_symbol, {});
+	}
+
+	for (std::size_t index = 0; index < seen.size(); ++index)
+	{
+		if (seen[index])
+		{
+			result.named.push_back(static_cast<std::uint32_t>(index));
+		}
+	}
+
+	return result;
+}
+
+// The fallback notice of compile() ("SPUDIRECT660 fallback <reason>: <symbol> (<module>)"): the first 8
+// hits of each reason in this process, then every 256th, as should_emit_spu_compile_diagnostic() in
+// SPULLVMRecompiler.cpp limits its diagnostics. An accepted hit formats nothing.
+inline bool should_log_fallback(reason why) noexcept
+{
+	static std::array<std::atomic<std::uint64_t>, reason_count> seen{};
+	const auto index = static_cast<std::size_t>(why);
+	if (why == reason::accepted || index >= reason_count)
+	{
+		return false;
+	}
+
+	const std::uint64_t current = seen[index].fetch_add(1, std::memory_order_relaxed) + 1;
+	return current <= 8 || (current % 256) == 0;
+}
+
+// Per-window counters for COREPROF SPUDIRECT660 (rpcs3/ios/RPCS3IOSPerformance.cpp). Ticks are TSC ticks.
+struct window_counters
+{
+	std::uint64_t direct = 0, direct_bytes = 0;     // blocks linked directly, their object bytes
+	std::uint64_t direct_ticks = 0, direct_max_ticks = 0; // compile() start to the published entry
+	std::uint64_t classify_ticks = 0;               // object parse, classification and bindings
+	std::uint64_t link_ticks = 0;                   // add + finalize of the object
+	std::uint64_t bindings = 0, patchpoints = 0;    // table bindings and patchpoint stubs of those blocks
+	std::uint64_t failures = 0;                     // link/finalize/entry failures, handled as on the IR path
+	std::array<std::uint64_t, reason_count> fallbacks{}; // hits left to the IR path, by reason
+};
+
+class counters
+{
+	std::atomic<std::uint64_t> m_direct{0}, m_direct_bytes{0}, m_direct_ticks{0}, m_direct_max_ticks{0};
+	std::atomic<std::uint64_t> m_classify_ticks{0}, m_link_ticks{0}, m_bindings{0}, m_patchpoints{0}, m_failures{0};
+	std::array<std::atomic<std::uint64_t>, reason_count> m_fallbacks{};
+
+public:
+	void record_direct(std::uint64_t bytes, std::uint64_t ticks, std::uint64_t classify_ticks, std::uint64_t link_ticks,
+		std::uint64_t bindings, std::uint64_t patchpoints) noexcept
+	{
+		m_direct.fetch_add(1, std::memory_order_relaxed);
+		m_direct_bytes.fetch_add(bytes, std::memory_order_relaxed);
+		m_direct_ticks.fetch_add(ticks, std::memory_order_relaxed);
+		m_classify_ticks.fetch_add(classify_ticks, std::memory_order_relaxed);
+		m_link_ticks.fetch_add(link_ticks, std::memory_order_relaxed);
+		m_bindings.fetch_add(bindings, std::memory_order_relaxed);
+		m_patchpoints.fetch_add(patchpoints, std::memory_order_relaxed);
+		std::uint64_t seen = m_direct_max_ticks.load(std::memory_order_relaxed);
+		while (ticks > seen && !m_direct_max_ticks.compare_exchange_weak(seen, ticks, std::memory_order_relaxed))
+		{
+		}
+	}
+
+	void record_fallback(reason why) noexcept
+	{
+		const auto index = static_cast<std::size_t>(why);
+		if (index < reason_count)
+		{
+			m_fallbacks[index].fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	void record_failure() noexcept
+	{
+		m_failures.fetch_add(1, std::memory_order_relaxed);
+	}
+
+	window_counters take_window() noexcept
+	{
+		window_counters result;
+		result.direct = m_direct.exchange(0, std::memory_order_relaxed);
+		result.direct_bytes = m_direct_bytes.exchange(0, std::memory_order_relaxed);
+		result.direct_ticks = m_direct_ticks.exchange(0, std::memory_order_relaxed);
+		result.direct_max_ticks = m_direct_max_ticks.exchange(0, std::memory_order_relaxed);
+		result.classify_ticks = m_classify_ticks.exchange(0, std::memory_order_relaxed);
+		result.link_ticks = m_link_ticks.exchange(0, std::memory_order_relaxed);
+		result.bindings = m_bindings.exchange(0, std::memory_order_relaxed);
+		result.patchpoints = m_patchpoints.exchange(0, std::memory_order_relaxed);
+		result.failures = m_failures.exchange(0, std::memory_order_relaxed);
+		for (std::size_t index = 0; index < reason_count; ++index)
+		{
+			result.fallbacks[index] = m_fallbacks[index].exchange(0, std::memory_order_relaxed);
+		}
+		return result;
+	}
+};
+
+inline counters& stats() noexcept
+{
+	static counters instance;
+	return instance;
+}
+}
