@@ -0,0 +1,467 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSTextureValidationProfile.h"
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+
+// REWINDBOX_TEXTURE_LOOKUP_MEMO_660: per sampler slot, the last results of an exact texture lookup
+// (texture_cache::upload_texture), reused for an identical lookup in the same validation epoch.
+//
+// IPA 657 (Core 655, PID 10471), Assassin's Creed window 1:42: 904 lookups per frame for 1,515 draws
+// (TEXCACHE621 upload_calls 106,705 over 118 frames), 61 % of them confirmed without hashing because
+// the section had already been validated in the same epoch (OPT559 epoch_skips 64,999), and 5.03 ms
+// of texture stage per sampled frame (RSXFRAME551). A slot is looked up again whenever one of its
+// registers is rewritten (A/B/A alternation, a filter or LOD change), even when the texture is the same.
+//
+// The key is everything the lookup reads from the texture unit: the six raw words of OFFSET, FORMAT,
+// ADDRESS, CONTROL1, IMAGE_RECT and CONTROL3 (rsx::fragment_texture::lookup_words(); a vertex texture
+// has no CONTROL1), the address they resolve to now (IO mappings can change under the same words), and
+// whether the slot is a vertex slot or a BX2 read of the fragment program. The value is the descriptor
+// upload_texture returned, before VKDraw.cpp derives the format, view override and sampler from it (that
+// code still runs on every hit); the validation stamp and binding are set again by every hit.
+//
+// An entry is used only while nothing the exact lookup reads can have changed:
+// - the validation epoch (a lookup repeated in the same epoch never hashes: buffered_section::sync) and
+//   sampler_revision (every advance_epoch: PUT, semaphores, RSX writes, frame end);
+// - a scoped RSX write over the entry's section range (CELL573: revalidate_overlapping drops it through
+//   the memo's own sampler bindings, as it does for the slot bindings);
+// - the section-state generations below, bumped under the cache lock by every change of a section, of
+//   its block or of its image views that the lookup reads (create, reset, destroy, protection, dirty,
+//   context, format, dimensions, pitch, swizzle, view flags, ranges, block size, component order):
+//   local for an uncompressed entry, all for a compressed one (find_texture_from_dimensions does not
+//   filter contexts);
+// - the sampler context generation, bumped by a global sampler refresh (m_samplers_dirty);
+// - for an uncompressed entry, no render target bound at the address, checked at every use (the only
+//   surface store input of an exact local lookup; the write tag is stamped again on every hit).
+// Only direct shader_read views of a section are stored: no render target, no deferred or gathered
+// descriptor, no cyclic reference, nothing created or changed by the lookup that produced it.
+//
+// Self-verification: the first reuse of each (slot, key) of a boot, the first 256 hits of a boot, then
+// one hit in 64 (every hit in verify_all mode) run the full lookup under the same lock and use its
+// result; a difference in the descriptor, the view or the sampler inputs, or a section change during
+// that lookup, is counted, logged once with the slot and key, and turns the memo off for the rest of
+// the boot. This is a spot check, not a bound: one hit clock is shared by all slots, so a stale path
+// that occurs rarely may never be sampled. Correctness rests on the invalidation census above (checked
+// by test/rpcs3_texture_lookup_memo660_test.py); the verification catches what the census would miss
+// systematically, for every texture of the boot at least once.
+namespace rpcs3::ios::texture_lookup_memo
+{
+enum class mode : std::uint32_t
+{
+	off = 0,        // The Core 659 lookup: prepare, upload_texture and finish, three cache locks.
+	active = 1,     // One cache lock per lookup; hits served, sampled verification.
+	verify_all = 2, // One cache lock per lookup; every hit runs the full lookup (counters only).
+};
+
+constexpr std::size_t ways = 4;
+constexpr std::uint64_t verify_first = 256;
+constexpr std::uint64_t verify_period = 64;
+
+constexpr std::uint32_t vertex_flag = 1u;
+constexpr std::uint32_t bx2_flag = 2u;
+
+inline std::atomic<std::uint32_t> boot_mode{0};
+// Set by the first verified difference: no hit for the rest of the boot.
+inline std::atomic<bool> disabled{false};
+inline std::atomic<bool> mismatch_logged{false};
+// Hits of this boot, the sampling clock of the verification.
+inline std::atomic<std::uint64_t> boot_hits{0};
+// The first reuse of each (slot, key) is verified. Always true in the Core; the host test turns it off only to
+// exercise served hits directly (test/rpcs3_texture_lookup_memo660_test.py, mode active_served).
+inline std::atomic<bool> verify_first_reuse{true};
+
+// Section-state generations (see above). Bumped on every title: one atomic increment per change.
+inline std::atomic<std::uint64_t> local_generation{1}, all_generation{1}, context_generation{1};
+
+struct counters_t
+{
+	std::atomic<std::uint64_t> lookups{0}, hits{0}, verified{0}, mismatches{0}, stores{0};
+	std::atomic<std::uint64_t> miss_empty{0}, miss_epoch{0}, miss_revision{0}, miss_range{0}, miss_context{0},
+		miss_section{0}, miss_bound{0}, miss_disabled{0};
+	std::atomic<std::uint64_t> unstored_kind{0}, unstored_changed{0}, unstored_bound{0};
+	std::atomic<std::uint64_t> locks_avoided{0}, cpu_uploads{0};
+	// First reuses of a (slot, key) verified; reuses not checked that way because the key table was full.
+	std::atomic<std::uint64_t> first_reuses{0}, seen_full{0};
+	std::atomic<std::uint64_t> hit_ticks{0}, lookup_ticks{0};
+};
+inline counters_t counters;
+
+inline void count(std::atomic<std::uint64_t>& counter, std::uint64_t value = 1) noexcept
+{
+	counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+inline std::uint64_t take(std::atomic<std::uint64_t>& counter) noexcept
+{
+	return counter.exchange(0, std::memory_order_relaxed);
+}
+
+inline mode current_mode() noexcept
+{
+	return static_cast<mode>(boot_mode.load(std::memory_order_relaxed));
+}
+
+// The lookups of load_texture_env take the one-lock path (with or without hits).
+inline bool consolidated() noexcept
+{
+	return current_mode() != mode::off;
+}
+
+// Boot policy (resolve_experimental_policy), after the texture epoch was set and before the RSX
+// thread starts. New generations: no entry survives a boot or a change of epoch_enabled.
+inline void configure(mode value) noexcept
+{
+	boot_mode.store(static_cast<std::uint32_t>(value), std::memory_order_relaxed);
+	disabled.store(false, std::memory_order_relaxed);
+	mismatch_logged.store(false, std::memory_order_relaxed);
+	boot_hits.store(0, std::memory_order_relaxed);
+	local_generation.fetch_add(1, std::memory_order_acq_rel);
+	all_generation.fetch_add(1, std::memory_order_acq_rel);
+	context_generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+// A section change the exact lookup can observe. framebuffer_only: the section's context is
+// framebuffer_storage before and after the change (no uncompressed lookup visits it).
+inline void section_changed(bool framebuffer_only) noexcept
+{
+	all_generation.fetch_add(1, std::memory_order_acq_rel);
+	if (!framebuffer_only)
+	{
+		local_generation.fetch_add(1, std::memory_order_acq_rel);
+	}
+}
+
+// A global sampler refresh (VKGSRender::m_samplers_dirty) drops every entry.
+inline void sampler_refresh() noexcept
+{
+	context_generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+constexpr bool should_verify(mode value, std::uint64_t hit) noexcept
+{
+	return value == mode::verify_all || hit < verify_first || (hit - verify_first) % verify_period == 0;
+}
+
+constexpr std::uint32_t fragment_flags(std::uint32_t bx2_mask, std::uint32_t slot) noexcept
+{
+	return ((bx2_mask >> slot) & 1u) ? bx2_flag : 0u;
+}
+
+struct key
+{
+	std::uint32_t address = 0;            // rsx::get_address(offset, location), resolved at every use
+	std::array<std::uint32_t, 6> words{}; // OFFSET FORMAT ADDRESS CONTROL1 IMAGE_RECT CONTROL3
+	std::uint32_t flags = 0;              // vertex_flag, bx2_flag
+
+	bool operator==(const key&) const = default;
+};
+
+enum class miss : std::uint32_t
+{
+	none = 0, empty, epoch, revision, range, context, section, bound, disabled
+};
+
+inline void count_miss(miss reason) noexcept
+{
+	switch (reason)
+	{
+	case miss::none: break;
+	case miss::empty: count(counters.miss_empty); break;
+	case miss::epoch: count(counters.miss_epoch); break;
+	case miss::revision: count(counters.miss_revision); break;
+	case miss::range: count(counters.miss_range); break;
+	case miss::context: count(counters.miss_context); break;
+	case miss::section: count(counters.miss_section); break;
+	case miss::bound: count(counters.miss_bound); break;
+	case miss::disabled: count(counters.miss_disabled); break;
+	}
+}
+
+// Differences found by a verification (bits of the logged reasons).
+enum difference : std::uint32_t
+{
+	differs_view = 1u,       // image_handle
+	differs_descriptor = 2u, // context, image type, reference address, ranges, deferred operation, flags
+	differs_sampler = 4u,    // format class, texture coordinate transform, samples, cyclic reference
+	differs_state = 8u,      // the full lookup changed a section: the memo would have skipped that change
+};
+
+// Fields a memo hit hands to the sampler setup and to the draw (VKDraw.cpp). Both sides come straight
+// from upload_texture (before the validation stamp); surface_cache_tag is the store's current write tag.
+template <typename Descriptor>
+std::uint32_t compare(const Descriptor& memo, const Descriptor& full) noexcept
+{
+	std::uint32_t result = 0;
+	if (memo.image_handle != full.image_handle)
+	{
+		result |= differs_view;
+	}
+	if (memo.upload_context != full.upload_context || memo.image_type != full.image_type || memo.ref_address != full.ref_address ||
+		memo.surface_cache_tag != full.surface_cache_tag || memo.flag != full.flag ||
+		memo.external_subresource_desc.op != full.external_subresource_desc.op ||
+		memo.ios_validation_range != full.ios_validation_range || !(memo.format_ex == full.format_ex) ||
+		memo.format_ex.texel_remap_control != full.format_ex.texel_remap_control)
+	{
+		result |= differs_descriptor;
+	}
+	// The coordinate transform: scale and bias, and the clamp bounds only when clamping (the constructors
+	// leave the bounds unset and RSXThread.cpp reads them only for a clamped descriptor).
+	using xform_type = std::remove_cvref_t<decltype(memo.texcoord_xform)>;
+	const auto* memo_xform = reinterpret_cast<const unsigned char*>(&memo.texcoord_xform);
+	const auto* full_xform = reinterpret_cast<const unsigned char*>(&full.texcoord_xform);
+	constexpr std::size_t bounds_offset = offsetof(xform_type, clamp_min);
+	constexpr std::size_t flag_offset = offsetof(xform_type, clamp);
+	bool xform_differs = std::memcmp(memo_xform, full_xform, bounds_offset) != 0 || memo.texcoord_xform.clamp != full.texcoord_xform.clamp;
+	if (!xform_differs && memo.texcoord_xform.clamp)
+	{
+		xform_differs = std::memcmp(memo_xform + bounds_offset, full_xform + bounds_offset, flag_offset - bounds_offset) != 0;
+	}
+	if (memo.format_class != full.format_class || memo.samples != full.samples || memo.is_cyclic_reference != full.is_cyclic_reference ||
+		xform_differs)
+	{
+		result |= differs_sampler;
+	}
+	return result;
+}
+
+struct generations
+{
+	std::uint64_t epoch = 0, local = 0, all = 0, context = 0;
+
+	static generations now() noexcept
+	{
+		return { texture_validation::current_epoch(), local_generation.load(std::memory_order_acquire),
+			all_generation.load(std::memory_order_acquire), context_generation.load(std::memory_order_acquire) };
+	}
+
+	bool sections_equal(const generations& other) const noexcept
+	{
+		return local == other.local && all == other.all;
+	}
+};
+
+// Owned by the texture cache. The RSX thread finds, stores and clears entries under the cache reader
+// lock; invalidate() runs under the exclusive lock on any thread and only touches the range bindings.
+template <typename Descriptor, std::size_t Slots>
+class table
+{
+	struct entry
+	{
+		key k{};
+		Descriptor value{};
+		texture_validation::sampler_stamp stamp{};
+		generations gen{};
+		bool compressed = false;
+		bool valid = false;
+		std::uint32_t used = 0;
+	};
+
+	std::array<entry, Slots * ways> m_entries{};
+	texture_validation::sampler_bindings<Slots * ways> m_ranges;
+	std::uint32_t m_clock = 0;
+	// Hashes of the (slot, key) pairs whose first reuse this table has verified (0: free), filled to half at
+	// most; the table lives as long as the texture cache, one boot.
+	static constexpr std::size_t seen_capacity = 4096;
+	std::array<std::uint64_t, seen_capacity> m_seen{};
+	std::size_t m_seen_count = 0;
+
+public:
+	struct found
+	{
+		const Descriptor* value = nullptr;
+		miss reason = miss::empty;
+	};
+
+	// Under the cache reader lock. bound: a render target is bound at k.address (uncompressed only).
+	found find(std::size_t slot, const key& k, bool compressed, bool bound) noexcept
+	{
+		if (disabled.load(std::memory_order_relaxed))
+		{
+			return { nullptr, miss::disabled };
+		}
+
+		for (std::size_t way = 0; way < ways; ++way)
+		{
+			const std::size_t index = slot * ways + way;
+			auto& e = m_entries[index];
+			if (!e.valid || !(e.k == k) || e.compressed != compressed)
+			{
+				continue;
+			}
+
+			const auto now = generations::now();
+			miss reason = miss::none;
+			if (!now.epoch || e.gen.epoch != now.epoch)
+			{
+				reason = miss::epoch;
+			}
+			else if (e.stamp.memory != texture_validation::sampler_revision.load(std::memory_order_acquire))
+			{
+				reason = miss::revision;
+			}
+			else if (!m_ranges.matches(index, e.stamp))
+			{
+				reason = miss::range;
+			}
+			else if (e.gen.context != now.context)
+			{
+				reason = miss::context;
+			}
+			else if (e.gen.local != now.local || (compressed && e.gen.all != now.all))
+			{
+				reason = miss::section;
+			}
+			else if (!compressed && bound)
+			{
+				reason = miss::bound;
+			}
+
+			if (reason != miss::none)
+			{
+				e.valid = false;
+				m_ranges.forget(index);
+				return { nullptr, reason };
+			}
+
+			e.used = ++m_clock;
+			return { &e.value, miss::none };
+		}
+
+		return { nullptr, miss::empty };
+	}
+
+	// Under the cache reader lock, on the RSX thread, for a hit: true the first time this (slot, key) is
+	// reused in this table's life (that hit is verified). Once the key table is half full, false (only the
+	// sampled verification remains) and counted.
+	bool first_reuse(std::size_t slot, const key& k) noexcept
+	{
+		std::uint64_t h = 1469598103934665603ull;
+		const auto mix = [&h](std::uint64_t value) { h = (h ^ value) * 1099511628211ull; };
+		mix(slot);
+		mix(k.address);
+		for (const std::uint32_t word : k.words)
+		{
+			mix(word);
+		}
+		mix(k.flags);
+		if (!h)
+		{
+			h = 1;
+		}
+
+		for (std::size_t probe = 0, at = h % seen_capacity; probe < seen_capacity; ++probe, at = (at + 1) % seen_capacity)
+		{
+			if (m_seen[at] == h)
+			{
+				return false;
+			}
+			if (!m_seen[at])
+			{
+				if (m_seen_count >= seen_capacity / 2)
+				{
+					count(counters.seen_full);
+					return false;
+				}
+				m_seen[at] = h;
+				++m_seen_count;
+				return true;
+			}
+		}
+		count(counters.seen_full);
+		return false;
+	}
+
+	struct ticket
+	{
+		std::size_t index = 0;
+		texture_validation::sampler_stamp stamp{};
+		generations gen{};
+	};
+
+	// Under the cache reader lock, before the lookup. The way of the same key, else a free way, else the
+	// least recently used one. Its range is unknown until end(): a scoped write in between drops it.
+	ticket begin(std::size_t slot, const key& k) noexcept
+	{
+		std::size_t victim = slot * ways;
+		std::uint32_t best = 0;
+		for (std::size_t way = 0; way < ways; ++way)
+		{
+			const std::size_t index = slot * ways + way;
+			const auto& e = m_entries[index];
+			const std::uint32_t rank = e.k == k ? 3 : !e.valid ? 2 : 1;
+			if (rank > best || (rank == best && rank == 1 && e.used < m_entries[victim].used))
+			{
+				best = rank;
+				victim = index;
+			}
+		}
+
+		m_entries[victim].valid = false;
+		const auto gen = generations::now();
+		return { victim, m_ranges.prepare(victim), gen };
+	}
+
+	enum class store_result
+	{
+		stored, changed, kind, bound
+	};
+
+	// Under the cache reader (or upgraded) lock, after the lookup and its sampler validation. direct: the
+	// descriptor is a direct shader_read view of a section at k.address. length: the length the slot
+	// binding received (0: unknown, then any scoped write drops the entry).
+	store_result end(const ticket& t, const key& k, bool compressed, bool bound, const Descriptor& value, bool direct,
+		std::uint32_t start, std::uint64_t length) noexcept
+	{
+		const auto now = generations::now();
+		if (!t.gen.epoch || now.epoch != t.gen.epoch || now.local != t.gen.local || now.context != t.gen.context ||
+			(compressed && now.all != t.gen.all) || disabled.load(std::memory_order_relaxed))
+		{
+			m_ranges.forget(t.index);
+			return store_result::changed;
+		}
+		if (!compressed && bound)
+		{
+			m_ranges.forget(t.index);
+			return store_result::bound;
+		}
+		if (!direct)
+		{
+			m_ranges.forget(t.index);
+			return store_result::kind;
+		}
+
+		m_ranges.set_range(t.index, start, length);
+		auto& e = m_entries[t.index];
+		e.k = k;
+		e.value = value;
+		e.stamp = t.stamp;
+		e.gen = t.gen;
+		e.compressed = compressed;
+		e.valid = true;
+		e.used = ++m_clock;
+		return store_result::stored;
+	}
+
+	// Under the cache exclusive lock, next to the slot bindings (revalidate_overlapping).
+	void invalidate(std::uint32_t start, std::uint64_t length) noexcept
+	{
+		m_ranges.invalidate(start, length);
+	}
+
+	// Under the cache reader lock: after a verified difference.
+	void clear() noexcept
+	{
+		for (std::size_t index = 0; index < m_entries.size(); ++index)
+		{
+			m_entries[index].valid = false;
+			m_ranges.forget(index);
+		}
+	}
+};
+}
