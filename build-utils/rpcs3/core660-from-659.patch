index ef5f127..5baafcc 100644
--- a/Utilities/JITLLVM.cpp
+++ b/Utilities/JITLLVM.cpp
@@ -1627,9 +1627,68 @@ bool jit_compiler::try_add_cached(std::unique_ptr<llvm::Module> _module, const s
 bool jit_compiler::try_add_minimal_object(jit_cached_object object, const std::string& entry,
 	const std::unordered_map<std::string, u64>& bindings, std::string& error)
 {
-	// Prototype only: callers must provide every patchpoint/helper symbol from
-	// this process. No address is read from or written to the persistent cache.
-	return jit_minimal_object::add(*m_engine, object.buffer, entry, bindings, error);
+	// Callers must provide every patchpoint/helper symbol from this process. No
+	// address is read from or written to the persistent cache.
+	// REWINDBOX_SPU_DIRECT_OBJECT_HIT_660 (ios/IOSSpuObjectBindings.h): the SPU
+	// cache-hit path links validated objects here, and they are finalized here
+	// too: the load and finalizeObject run in one run_recoverable_llvm (one
+	// worker handoff instead of a second one in try_fin; RuntimeDyld reports
+	// errors as fatal errors). True: added and finalized, as try_fin succeeds.
+	// False with an error: LLVM fatal recovery while loading or finalizing, the
+	// compiler must be discarded. False with an empty error: jit_minimal_object::add
+	// refused the object before it touched the engine, nothing was finalized, and
+	// the caller may still link it another way.
+	std::unique_ptr<llvm::MemoryBuffer> buffer = std::move(object.buffer);
+#ifdef RPCS3_IOS
+	// REWINDBOX_JIT_OBJECT_RELEASE_634: MCJIT gets a view; the compiler keeps the
+	// bytes until finalizeObject, as ObjectCache::getObject does for a cached hit.
+	std::unique_ptr<llvm::MemoryBuffer> owner;
+	if (buffer && rpcs3::ios::jit_load::release_bytes.load(std::memory_order_relaxed))
+	{
+		owner = std::move(buffer);
+		buffer = llvm::MemoryBuffer::getMemBuffer(owner->getMemBufferRef(), false);
+	}
+#endif
+
+	bool added = false;
+	std::string refused;
+	const bool recovered = run_recoverable_llvm([&]()
+	{
+		added = jit_minimal_object::add(*m_engine, buffer, entry, bindings, refused);
+
+		if (added)
+		{
+			m_engine->finalizeObject();
+		}
+	}, error);
+
+	if (!recovered)
+	{
+#ifdef RPCS3_IOS
+		// As a failed try_add_cached or try_fin: the bytes stay with the compiler.
+		if (owner)
+		{
+			held_objects().hold(this, std::move(owner));
+		}
+#endif
+		if (m_announcer) m_announcer->finalized(false);
+		return false;
+	}
+
+	if (!added)
+	{
+		jit_log.trace("LLVM: Minimal object %s refused: %s", entry, refused);
+		error.clear();
+		return false;
+	}
+
+	// As try_fin after a successful finalizeObject; the bytes of this object
+	// (owner) are freed on return, after the finalize.
+	if (m_announcer) m_announcer->finalized(true);
+#ifdef RPCS3_IOS
+	held_objects().release(this);
+#endif
+	return true;
 }
 
