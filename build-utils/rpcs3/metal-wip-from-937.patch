 }
 
+// REWINDBOX_FREEZE_SPU_MEMORY_938: see RPCS3IOSFreezeDump.h.
+bool neostation_freeze_spu_memory(unsigned long long episode, double episode_seconds)
+{
+	static std::mutex s_memory_mutex;
+	static bool s_written = false; // once per process: the first long busy freeze of the boot
+
+	std::unique_lock lock(s_memory_mutex, std::try_to_lock);
+	if (!lock.owns_lock() || s_written || Emu.GetStatus(false) != system_state::running)
+	{
+		return false;
+	}
+
+	std::vector<stx::shared_ptr<named_thread<spu_thread>>> spus;
+	{
+		std::shared_lock idm_reader(id_manager::g_mutex, std::try_to_lock);
+		if (!idm_reader.owns_lock())
+		{
+			return false;
+		}
+
+		if (g_fxo->is_init<id_manager::id_map<named_thread<spu_thread>>>())
+		{
+			idm::select<named_thread<spu_thread>>([&](u32 id, named_thread<spu_thread>&)
+			{
+				if (spus.size() < 16)
+				{
+					if (auto ptr = idm::get_unlocked<named_thread<spu_thread>>(id))
+					{
+						spus.emplace_back(std::move(ptr));
+					}
+				}
+			}, idm::unlocked);
+		}
+	}
+
+	const char* home = std::getenv("HOME");
+	if (spus.empty() || !home || Emu.GetStatus(false) != system_state::running)
+	{
+		return false;
+	}
+
+	// Next to the RPCS3 journals the host writes (Rpcs3Diagnostics.mm: Documents/Diagnostics/PS3).
+	const std::string name = "RPCS3-freeze-spu.bin";
+	const std::string path = std::string(home) + "/Documents/Diagnostics/PS3/" + name;
+	fs::file file(path, fs::rewrite);
+	if (!file)
+	{
+		ios_freeze_dump.error("FREEZE_DUMP spu_memory episode=%llu file=%s error=open", episode, name);
+		s_written = true;
+		return false;
+	}
+
+	// Per SPU thread: a 4 KiB header (magic, ids, pc, reservation, last GETLLAR, pending MFC command, the 128 GPRs),
+	// then its 256 KiB local store. Plain reads of a running thread, as the dump lines: the bytes are those of the
+	// moment, possibly mid-update; nothing is written to the emulated threads.
+	u64 bytes = 0;
+	for (const auto& spu : spus)
+	{
+		std::array<u8, 4096> header{};
+		const spu_mfc_cmd pending = spu->ch_mfc_cmd;
+		const u32 fields[] = {spu->id, spu->lv2_id, spu->pc, spu->raddr, spu->last_getllar, spu->last_getllar_addr,
+			static_cast<u32>(pending.cmd), pending.lsa, pending.eal, static_cast<u32>(pending.size), spu->spurs_addr,
+			static_cast<u32>(SPU_LS_SIZE)};
+		std::memcpy(header.data(), "RBSPULS1", 8);
+		std::memcpy(header.data() + 8, fields, sizeof(fields));
+		const u64 rtime = spu->rtime;
+		std::memcpy(header.data() + 64, &rtime, sizeof(rtime));
+		const std::string thread_name = spu->get_name();
+		std::memcpy(header.data() + 128, thread_name.data(), std::min<usz>(thread_name.size(), 63));
+		std::memcpy(header.data() + 2048, spu->gpr.data(), sizeof(spu->gpr));
+		bytes += file.write(header.data(), header.size());
+		bytes += file.write(spu->ls, SPU_LS_SIZE);
+	}
+
+	file.close();
+	s_written = true;
+	ios_freeze_dump.notice("FREEZE_DUMP spu_memory episode=%llu episode_s=%.3f file=%s spus=%u bytes=%llu format=RBSPULS1",
+		episode, episode_seconds, name, static_cast<u32>(spus.size()), static_cast<unsigned long long>(bytes));
+	return true;
+}
