+			add_readable(plan, r13 - 0x7000, 2 * guest::page_size, guest::kind_tls);
+		}
+		for (u32 reg = 3; reg < 32 && chase_left >= guest::page_size; reg++)
+		{
+			const u32 target = static_cast<u32>(ppu.gpr[reg]);
+			if (guest::plausible_pointer(target & ~3u) && vm::check_addr(target, vm::page_readable, 4))
+			{
+				const u64 added = add_readable(plan, target & ~(guest::page_size - 1), 2 * guest::page_size, guest::kind_chased);
+				chase_left -= std::min(chase_left, added);
+			}
+		}
+	}
+
+	// 4. Every PPU thread: the code that asked for its wait and the top of its stack; for the first one (the title's
+	// main thread) more stack and the code around each saved return address.
+	for (usz i = 0; i < ppus.size(); i++)
+	{
+		const ppu_thread& ppu = *ppus[i];
+		add_around(plan, static_cast<u32>(ppu.lr), guest::page_size, guest::kind_code);
+		add_readable(plan, static_cast<u32>(ppu.gpr[1]), i == 0 ? 16 * 1024 : 2 * 1024, guest::kind_stack);
+		if (i == 0)
+		{
+			u32 frames[12]{};
+			const std::size_t count = rpcs3::ios::freeze_chain::back_chain(ppu.gpr[1],
+				[](u32 addr) { return vm::check_addr(addr, vm::page_readable, 8); },
+				[](u32 addr) { return guest_dword(addr); }, frames, std::size(frames));
+			for (std::size_t frame = 0; frame < count; frame++)
+			{
+				add_around(plan, frames[frame], 2 * guest::page_size, guest::kind_code);
+			}
+		}
+	}
+
+	// 5. With what is left of the budget, the executable segment the first spinning pc is in (the jobs' PPU side and
+	// their callers), from its start.
+	if (const auto main_module = g_fxo->try_get<main_ppu_module<lv2_obj>>(); main_module && !spinning.empty())
+	{
+		for (const ppu_segment& seg : main_module->segs)
+		{
+			if (seg.size && spinning.front()->cia - seg.addr < seg.size)
+			{
+				add_readable(plan, seg.addr, seg.size, guest::kind_segment);
+				break;
+			}
+		}
+	}
+
+	// The file. The header counts are those of the records written: it is written again at the end.
+	u64 bytes = 0;
+	bool complete = true;
+	const usz spu_records = std::min<usz>(spus.size(), 16);
+	std::array<u8, 4096> header{};
+	const auto fill_header = [&](u32 region_records)
+	{
+		std::memcpy(header.data(), "RBGUEST1", 8);
+		const u32 fields[] = {1u, 4096u, 32u, static_cast<u32>(ppus.size()), static_cast<u32>(spu_records),
+			region_records, seen.fifo_get, fifo_put, seen.fifo_last_cmd, fifo_word,
+			seen.spu_line.line, seen.spu_line.threads};
+		std::memcpy(header.data() + 8, fields, sizeof(fields));
+		const u64 wide[] = {episode, plan.bytes()};
+		std::memcpy(header.data() + 64, wide, sizeof(wide));
+		const std::string& title = Emu.GetTitleID();
+		std::memcpy(header.data() + 128, title.data(), std::min<usz>(title.size(), 31));
+	};
+	{
+		fill_header(static_cast<u32>(plan.regions().size()));
+		bytes += file.write(header.data(), header.size());
+		complete = bytes == header.size();
+	}
+
+	for (usz i = 0; complete && i < ppus.size(); i++)
+	{
+		const ppu_thread& ppu = *ppus[i];
+		std::array<u8, 512> record{};
+		const u32 fields[] = {ppu.id, ppu.cia, static_cast<u32>(ppu.lr), static_cast<u32>(ppu.ctr), ppu.cr.pack(),
+			static_cast<u32>(ppu.state.load()), static_cast<u32>(ppu.prio.load().prio), ppu.stack_addr, ppu.stack_size, ppu.raddr};
+		std::memcpy(record.data(), fields, sizeof(fields));
+		const u64 rtime = ppu.rtime;
+		std::memcpy(record.data() + 64, &rtime, sizeof(rtime));
+		std::memcpy(record.data() + 128, ppu.gpr, sizeof(ppu.gpr));
+		const std::string thread_name = ppu.get_name();
+		std::memcpy(record.data() + 384, thread_name.data(), std::min<usz>(thread_name.size(), 63));
+		if (const char* function = ppu.current_function)
+		{
+			std::memcpy(record.data() + 448, function, std::min<usz>(std::strlen(function), 63));
+		}
+		complete = write_record(file, "PPUT", 0, ppu.id, record.data(), static_cast<u32>(record.size()), bytes);
+	}
+
+	for (usz i = 0; complete && i < spu_records; i++)
+	{
+		const spu_thread& spu = *spus[i];
+		std::vector<u8> record(4096 + SPU_LS_SIZE);
+		const spu_mfc_cmd pending = spu.ch_mfc_cmd;
+		const u32 fields[] = {spu.id, spu.lv2_id, spu.pc, spu.raddr, spu.last_getllar, spu.last_getllar_addr,
+			static_cast<u32>(pending.cmd), pending.lsa, pending.eal, static_cast<u32>(pending.size), spu.spurs_addr,
+			static_cast<u32>(SPU_LS_SIZE)};
+		std::memcpy(record.data(), "RBSPULS1", 8);
+		std::memcpy(record.data() + 8, fields, sizeof(fields));
+		const u64 rtime = spu.rtime;
+		std::memcpy(record.data() + 64, &rtime, sizeof(rtime));
+		const std::string thread_name = spu.get_name();
+		std::memcpy(record.data() + 128, thread_name.data(), std::min<usz>(thread_name.size(), 63));
+		std::memcpy(record.data() + 2048, spu.gpr.data(), sizeof(spu.gpr));
+		std::memcpy(record.data() + 4096, spu.ls, SPU_LS_SIZE);
+		complete = write_record(file, "SPUT", 0, spu.id, record.data(), static_cast<u32>(record.size()), bytes);
+	}
+
+	u32 regions = 0;
+	for (const guest::region& region : plan.regions())
+	{
+		if (!complete)
+		{
+			break;
+		}
+
+		// The pages were readable when planned; one freed since then is written as zeroes.
+		std::vector<u8> payload(region.size);
+		for (u32 offset = 0; offset < region.size; offset += guest::page_size)
+		{
+			if (!vm::check_addr(region.addr + offset, vm::page_readable, guest::page_size) ||
+				!rpcs3::ios::copy_if_mapped(payload.data() + offset, vm::get_super_ptr<const void>(region.addr + offset), guest::page_size))
+			{
+				std::memset(payload.data() + offset, 0, guest::page_size);
+			}
+		}
+		complete = write_record(file, "MEMR", region.kind, region.addr, payload.data(), region.size, bytes);
+		regions += complete ? 1 : 0;
+	}
+
+	// The header again, with the number of MEMR records written.
+	if (regions != plan.regions().size())
+	{
+		fill_header(regions);
+		file.seek(0);
+		file.write(header.data(), header.size());
+	}
+
+	file.close();
+	const ppu_thread* first = spinning.empty() ? nullptr : spinning.front();
+	std::string line = fmt::format("FREEZE_DUMP guest_memory episode=%llu written=1 file=%s bytes=%llu complete=%u "
+		"guest_bytes=%llu regions=%u/%u lines=%u ppu=%u spu=%u spinning=0x%x pc=0x%x lr=0x%x ctr=0x%x fifo_get=0x%x "
+		"last_cmd=0x%x fifo_word=0x%x shared_line=0x%x:%u files=%u/%u format=RBGUEST1",
+		episode, name, static_cast<unsigned long long>(bytes), complete ? 1u : 0u,
+		static_cast<unsigned long long>(plan.bytes()), regions, static_cast<u32>(plan.regions().size()),
+		static_cast<u32>(roots.size()), static_cast<u32>(ppus.size()), static_cast<u32>(spus.size()),
+		first ? first->id : 0u, first ? first->cia : 0u, first ? static_cast<u32>(first->lr) : 0u,
+		first ? static_cast<u32>(first->ctr) : 0u, seen.fifo_get, seen.fifo_last_cmd, fifo_word,
+		seen.spu_line.line, seen.spu_line.threads, s_files, guest::max_files_per_process);
+	return bound_line(line);
+}
