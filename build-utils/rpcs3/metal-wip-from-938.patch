diff --git a/rpcs3/ios/IOSSpuPollIdle939.h b/rpcs3/ios/IOSSpuPollIdle939.h
new file mode 100644
index 0000000..9708861
--- /dev/null
+++ b/rpcs3/ios/IOSSpuPollIdle939.h
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include "IOSSpuIdleBackoff935.h" // the two counters of the existing report line (COREPROF THERMAL931)
+
+// REWINDBOX_SPU_POLL_IDLE_939: when a polling SPU thread is idle, and what its wait may then give up.
+//
+// iPhone logs of IPA 745 (Core 938, 14 Nov 2026), Black Ops II menus at 60 FPS, session 9077:5 windows 5 and 6:
+// 38,000 SPU sleeps a second of 150 us (SPUWAIT551 getllar_sleep), 48,000 timer wakeups a second, and only 276 to
+// 657 lengthened waits per 5 s window: the same as IPA 726 and 737, the idle backoff of Cores 935 and 937 changed
+// nothing there. What the logs show:
+// - These sleeps are not the 100 us wait of GETLLAR that Core 937 put under the backoff. They are the wait of
+//   REWINDBOX_SPU_NOOP_SPIN_WAIT_627 / _ACCURATE_911 after a PUTLLC that writes nothing (ios/IOSSpuNoopSpin.h):
+//   the counter is the same, the menus had getllar_sleep=0 before that wait existed (build 676), and a PUTLLC
+//   always drops the reservation, so the GETLLAR that follows never reaches its own wait.
+// - Of the 590,000 PUTLLC a second, 583,000 write nothing; 6,400 to 7,000 change data (putllc_heavy), about 107 a
+//   frame. The six threads poll a job queue that somebody writes about every 1.1 ms (14 times a frame).
+// - Each such write restarts the polling of all six threads: 64 rounds without a wait, then waits of 20, 40, 80
+//   and 160 us. Seven to eight waits fit between two writes (64 + 8 x 6.8 = 118 PUTLLC for 7.8 waits: the measured
+//   15.2 PUTLLC per sleep; (20 + 40 + 80 + 4.8 x 160) / 7.8 + 35 us of timer slack: the measured 150 us).
+//   The Core 935 rule lengthens the bound after eight waits in a row at 160 us that found nothing, about 2 ms
+//   without a write on any polled line: that almost never happens.
+// - When it does, the rule calls "found late" any data-changing PUTLLC within 250 us of a wait that lasted half of
+//   its bound: a wait a notification ended in its second half, or a job that arrived after the wait, counts. Six
+//   such finds per thread in the first menu window (36 to 42 in all) already hold the 160 us bound for 16,000
+//   waits, and each further one doubles that.
+//
+// So "idle" is decided here by what the thread itself does, not by whether the queue is quiet:
+// - A thread is idle once it has slept `idle_waits` times in a row without taking a job. A job taken is a PUTLLC
+//   of this thread that changes data, or polling that stopped for longer than spin_gap_ns (the thread ran
+//   something else). Without Accurate SPU Reservations a polled line written while the thread was awake also
+//   ends the count, without more: it may be the thread's own PUTLLC, inlined by the recompiler, which
+//   do_putllc() does not see. With them no PUTLLC is inlined and such a write is somebody else's.
+// - A line written while the thread was asleep is somebody else's write. For an idle thread it no longer brings
+//   the reference back to 20 us: the thread looks at every polled line again (rearm_rounds rounds after a wait
+//   that ran to its bound, a whole streak after one a notification ended), and if it still writes nothing it
+//   waits again with the same reference, and with the bound doubled for every `idle_waits` waits (160, 320,
+//   640 us). Until a thread is idle, and while it holds (below), everything is as before this change.
+// - A write that notifies the line the thread waits on still ends the wait at once, whatever the bound.
+// - Self-validation: a job taken right after a lengthened wait that ran to its bound, while no thread polling the
+//   same lines had looked at them for longer than a reference wait (look_gap_ns; no reservation time needs to
+//   have moved: a plain guest store moves none, ios/IOSSpursRelaxedStore.h), was found by the look and not by a
+//   notification, later than before this change. The thread then holds the rule of before for a number of waits
+//   that doubles each time (256, 512, ... about a million). A job taken after a wait that a notification ended
+//   was not delayed by the bound. Nor was one that another thread could have taken less than a
+//   reference wait earlier: a thread that looked and left it would have taken it, so it arrived after that look.
+//   The host model of this rule (six threads, a write about every 1.2 ms) shows why the last condition is needed:
+//   without it a timer that fires just after a write, before the notified threads run, counts as a late find
+//   every few tens of milliseconds and every thread ends up holding, as with the Core 935 rule.
+//   What follows from it: a thread that holds, or one that keeps taking the jobs, polls with the reference and
+//   covers the others; when nobody does, the first late find makes one thread do so.
+// Switched off with the lengthened idle waits of Core 935 ("Event Waits When Hot" = Disabled).
+//
+// Per host thread (thread_local in SPUThread.cpp: the layout of spu_thread is a code generation input).
+namespace rpcs3::ios::spu_poll_idle
+{
+inline constexpr std::uint32_t idle_waits = 8;            // waits in a row without a job: idle, and one more doubling
+inline constexpr std::uint32_t max_shift = 2;             // 160 us, 320, 640
+inline constexpr std::uint32_t first_hold = 256;          // waits under the rule of before after a late find
+inline constexpr std::uint32_t max_hold = 1u << 20;
+inline constexpr std::uint64_t late_find_window_ns = 250'000;
+inline constexpr std::uint64_t look_gap_ns = 220'000;     // the longest reference wait (160 us) and its timer slack
+
+// The last time a thread looked at the lines of a polling loop (ticks): written when a polling wait starts and
+// when it ends, by every thread that polls those lines. Keyed by the lowest polled line, which the threads of one
+// loop share; two loops in one cell only make a late find less likely to be seen.
+struct alignas(128) look_cell
+{
+	std::atomic<std::uint64_t> ticks{0};
+};
+
+inline look_cell looks[64];
+
+inline std::atomic<std::uint64_t>& look_of(std::uint32_t lowest_polled_line) noexcept
+{
+	return looks[(lowest_polled_line >> 7) & 63].ticks;
+}
+
+// A wait starts at `now_ticks`: this thread has just looked at its lines and left them as they were.
+inline void looked(std::atomic<std::uint64_t>& look, std::uint64_t now_ticks) noexcept
+{
+	look.store(now_ticks, std::memory_order_relaxed);
+}
+
+// A wait ended at `now_ticks`: true when a thread (this one before its wait included) looked at the lines less
+// than `gap_ticks` ago. Records the look this thread is about to make.
+inline bool looked_within(std::atomic<std::uint64_t>& look, std::uint64_t now_ticks, std::uint64_t gap_ticks) noexcept
+{
+	const std::uint64_t last = look.exchange(now_ticks, std::memory_order_relaxed);
+	return last >= now_ticks || now_ticks - last <= gap_ticks;
+}
+
+class tracker
+{
+	std::uint32_t m_waits = 0;      // waits since this thread last took a job (saturates)
+	std::uint32_t m_hold = 0;       // waits left under the rule of before
+	std::uint32_t m_next_hold = first_hold;
+	std::uint64_t m_late_end = 0;   // ticks at the end of a lengthened wait that may have delayed a job, 0 if none
+	bool m_held = false;            // the wait in progress is one of a hold: it does not count
+
+public:
+	// Before a wait. `allowed`: the lever is on. True when the thread is idle: lines written during this wait are
+	// taken in, and the bound may be lengthened by shift().
+	bool begin_wait(bool allowed) noexcept
+	{
+		m_late_end = 0;
+
+		if (m_hold)
+		{
+			m_hold--;
+			m_waits = 0;
+			m_held = true;
+			return false;
+		}
+
+		if (!allowed)
+		{
+			m_waits = 0;
+			return false;
+		}
+
+		return m_waits >= idle_waits;
+	}
+
+	// For an idle thread whose reference is at its maximum: 1 or 2.
+	std::uint32_t shift() const noexcept
+	{
+		const std::uint32_t steps = m_waits / idle_waits;
+		return steps < max_shift ? steps : max_shift;
+	}
+
+	// After the wait, at `now_ticks`. `lengthened_to_bound`: the bound was lengthened and the wait ran to it.
+	// `unseen`: no thread had looked at the lines for longer than a reference wait when it ended.
+	void end_wait(std::uint64_t now_ticks, bool lengthened_to_bound, bool unseen) noexcept
+	{
+		if (m_held)
+		{
+			m_held = false;
+		}
+		else if (m_waits < idle_waits * 8)
+		{
+			m_waits++;
+		}
+
+		m_late_end = lengthened_to_bound && unseen ? (now_ticks ? now_ticks : 1) : 0;
+
+		if (lengthened_to_bound)
+		{
+			spu_idle_backoff::lengthened_waits.fetch_add(1, std::memory_order_relaxed);
+		}
+	}
+
+	// Cheap test for callers on a hot path: job() or activity() has something to do.
+	bool counting() const noexcept
+	{
+		return m_waits != 0 || m_late_end != 0;
+	}
+
+	// This thread took a job.
+	void job(std::uint64_t now_ticks, std::uint64_t window_ticks) noexcept
+	{
+		if (m_late_end && now_ticks - m_late_end <= window_ticks)
+		{
+			// The bound ended the wait, not a notification: the rule of before, longer each time.
+			spu_idle_backoff::late_finds.fetch_add(1, std::memory_order_relaxed);
+			m_hold = m_next_hold;
+			m_next_hold = m_next_hold < max_hold ? m_next_hold * 2 : max_hold;
+		}
+
+		m_late_end = 0;
+		m_waits = 0;
+	}
+
+	// A polled line was written while this thread was awake, or the thread polls a line it did not: not idle.
+	void activity() noexcept
+	{
+		m_late_end = 0;
+		m_waits = 0;
+	}
+
+	std::uint32_t waits() const noexcept { return m_waits; }
+	std::uint32_t hold() const noexcept { return m_hold; }
+	std::uint32_t next_hold() const noexcept { return m_next_hold; }
+};
+}
