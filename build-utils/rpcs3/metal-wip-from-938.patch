+u64 guest_dword(u32 addr)
+{
+	be_t<u64> value{};
+	return vm::check_addr(addr, vm::page_readable, 8) && rpcs3::ios::copy_if_mapped(&value, vm::get_super_ptr<const void>(addr), 8) ?
+		+value : 0ull;
