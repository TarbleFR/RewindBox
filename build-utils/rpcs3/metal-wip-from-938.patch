+		const u64 added = add_readable(plan, target & ~(guest::page_size - 1), std::min<u64>(window, budget), guest::kind_chased);
+		budget -= std::min(budget, added);
+		if (deeper)
+		{
+			chase(plan, target, 256, guest::page_size, budget, false);
+		}
+	}
