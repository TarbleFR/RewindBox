+u32 guest_word(u32 addr)
+{
+	be_t<u32> value{};
+	return vm::check_addr(addr, vm::page_readable, 4) && rpcs3::ios::copy_if_mapped(&value, vm::get_super_ptr<const void>(addr), 4) ?
