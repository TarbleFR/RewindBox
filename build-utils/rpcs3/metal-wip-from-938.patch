+bool write_record(fs::file& file, const char* tag, u32 kind, u32 address, const void* payload, u32 size, u64& bytes)
+{
+	std::array<u8, 32> header{};
+	std::memcpy(header.data(), tag, 4);
+	const u32 fields[] = {kind, address, size};
+	std::memcpy(header.data() + 4, fields, sizeof(fields));
+	const u64 written = file.write(header.data(), header.size()) + file.write(payload, size);
+	bytes += written;
+	return written == header.size() + size;
