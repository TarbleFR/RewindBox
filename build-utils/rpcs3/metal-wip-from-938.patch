 }
+
+// REWINDBOX_WFE_PROBE_939 (iPhone logs of IPA 745, 14 Nov 2026, thermal state serious for the whole process): the
+// event waits do not rest the core. Black Ops II in play (PID 9077, session 5, windows 9 to 33): 3.2 million WFEs a
+// second, 99.98 % of them in the bucket under 2 us; the PPU threads make 2.18 million passive-lock turns a second
+// inside 0.166 core-second of parks (RANGELOCKPROF ppu_parked), at most 76 ns per turn, counter reads and
+// accounting included, and the writers at most 66 ns per turn. A WFE that waited for the write it watches, or for
+// the system's event stream, would last far longer: these return at once. The logs cannot say why (an event left by
+// the CLREX of the previous turn, an event stream much faster than assumed, or a WFE that never waits in user mode
+// on this device), and the three call for three different corrections. Measurement only, nothing in a wait changes:
+// - per report window, the time really spent inside the WFEs of the three sites (wfe_window_us, with the count
+//   THERMAL931 already prints it gives the mean, and against the window it gives the share of a core at rest);
+// - once per process, on the report thread, three sequences on a line of memory nobody writes, each for at most
+//   `turns` WFEs or `budget_ns`: the production sequence (LDAXR, WFE, CLREX), the same without CLREX (the monitor
+//   stays armed from one turn to the next), and WFE alone. For each: turns, mean and longest duration, and the
+//   number of turns under 100 ns. If only the first sequence returns at once, the CLREX ends the next WFE; the mean
+//   of the third is half the period of the system's event stream; if all three return at once, WFE does not wait
+//   here and the event waits can be removed.
+// One line per window: COREPROF WFEPROBE939 (the self-test values are repeated: a rotated journal keeps them).
+namespace probe939
+{
+inline constexpr std::uint32_t turns = 256;
+inline constexpr std::uint64_t budget_ns = 2'000'000; // per sequence: 6 ms at most, once, on the report thread
+
+struct sequence_result
+{
+	std::uint64_t turns = 0, total_ns = 0, longest_ns = 0, under_100ns = 0;
+};
+
+struct alignas(128) private_line
+{
+	std::uint64_t word[16] = {};
+};
+
+inline private_line watched{};
+
+inline std::uint64_t ticks_to_ns(std::uint64_t ticks, std::uint64_t hz) noexcept
+{
+	// Durations of a few milliseconds at most: no overflow below 18 s of ticks at 1 GHz.
+	return hz ? ticks * 1'000'000'000ull / hz : 0;
+}
+
+// kind 0: LDAXR, WFE, CLREX (IOSEventWait931.h once64). kind 1: LDAXR, WFE. kind 2: WFE.
+inline sequence_result run_sequence(int kind, std::uint64_t hz) noexcept
+{
+	sequence_result out;
+#if defined(__aarch64__)
+	const void* const word = &watched.word[0];
+	const std::uint64_t start = counter_now();
+
+	// The first turn is not counted: it may consume an event left by what ran before.
+	for (std::uint32_t turn = 0; turn <= turns; turn++)
+	{
+		std::uint64_t value = 0;
+		if (kind != 2)
+		{
+			__asm__ volatile("ldaxr %x0, [%1]" : "=&r"(value) : "r"(word) : "memory");
+		}
+		const std::uint64_t begin = counter_now();
+		__asm__ volatile("wfe" ::: "memory");
+		const std::uint64_t end = counter_now();
+		if (kind == 0)
+		{
+			__asm__ volatile("clrex" ::: "memory");
+		}
+		static_cast<void>(value);
+
+		if (turn)
+		{
+			const std::uint64_t ns = ticks_to_ns(end - begin, hz);
+			out.turns++;
+			out.total_ns += ns;
+			out.longest_ns = ns > out.longest_ns ? ns : out.longest_ns;
+			out.under_100ns += ns < 100 ? 1 : 0;
+		}
+
+		if (ticks_to_ns(end - start, hz) >= budget_ns)
+		{
+			break;
+		}
+	}
+
+	// Nothing stays armed after the test.
+	__asm__ volatile("clrex" ::: "memory");
+#else
+	static_cast<void>(kind);
+	static_cast<void>(hz);
+#endif
+	return out;
+}
+
+struct self_test
+{
+	bool ran = false;
+	std::uint64_t hz = 0;
+	sequence_result sequence[3];
+};
+
+// Report thread only (one caller, once per window).
+inline std::string take_line(std::uint64_t session, std::uint64_t window)
+{
+	static self_test test;
+	if (!test.ran)
+	{
+		test.ran = true;
+		test.hz = counter_hz();
+#if defined(__aarch64__)
+		for (int kind = 0; kind < 3; kind++)
+		{
+			test.sequence[kind] = run_sequence(kind, test.hz);
+		}
+#endif
+	}
+
+	// The window's sum can include a WFE that spanned a suspension of the application: no ticks * 1e9 product here.
+	const std::uint64_t window_ticks = latency.take_sum(latency_ticks_field);
+	const std::uint64_t window_us = test.hz ? window_ticks / test.hz * 1'000'000 + window_ticks % test.hz * 1'000'000 / test.hz : 0;
+	const auto mean = [](const sequence_result& r) { return r.turns ? r.total_ns / r.turns : 0; };
+	const sequence_result& a = test.sequence[0];
+	const sequence_result& b = test.sequence[1];
+	const sequence_result& c = test.sequence[2];
+
+	char line[512];
+	std::snprintf(line, sizeof(line),
+		"COREPROF WFEPROBE939 session=%llu window=%llu wfe_window_us=%llu cntfrq=%llu tuple=turns:mean_ns:under_100ns:longest_ns "
+		"ldaxr_wfe_clrex=%llu:%llu:%llu:%llu ldaxr_wfe=%llu:%llu:%llu:%llu wfe=%llu:%llu:%llu:%llu "
+		"scope=window_total_then_self_test_once_per_process",
+		static_cast<unsigned long long>(session), static_cast<unsigned long long>(window),
+		static_cast<unsigned long long>(window_us), static_cast<unsigned long long>(test.hz),
+		static_cast<unsigned long long>(a.turns), static_cast<unsigned long long>(mean(a)),
+		static_cast<unsigned long long>(a.under_100ns), static_cast<unsigned long long>(a.longest_ns),
+		static_cast<unsigned long long>(b.turns), static_cast<unsigned long long>(mean(b)),
+		static_cast<unsigned long long>(b.under_100ns), static_cast<unsigned long long>(b.longest_ns),
+		static_cast<unsigned long long>(c.turns), static_cast<unsigned long long>(mean(c)),
+		static_cast<unsigned long long>(c.under_100ns), static_cast<unsigned long long>(c.longest_ns));
+	return line;
+}
+} // namespace probe939
 } // namespace rpcs3::ios::event_wait
diff --git a/rpcs3/ios/IOSFreezeGuestMemory939.h b/rpcs3/ios/IOSFreezeGuestMemory939.h
new file mode 100644
index 0000000..8559b74
--- /dev/null
+++ b/rpcs3/ios/IOSFreezeGuestMemory939.h
@@ -0,0 +1,183 @@
+#pragma once
+
+// REWINDBOX_FREEZE_GUEST_939: IPA 745 logs, Black Ops II, session 2 (froze at guest flip 1960; the user stopped the game
+// 11 s later, before the 20 s the Core 938 SPU capture waits for, so no file was written).
+//
+// What the freeze dumps of builds 723 to 745 show: the game's own job manager keeps running. Its seven workers (the PPU
+// thread "Secondary" and the six SPURS kernels) take a job from a lock-free queue, find it may not run yet and put it
+// back: the tag of the node pool head (0x2e208a0) advances between two reads of one dump while the sum of the queued and
+// running counters (0x2e208d8, 0x2e208dc) stays the same. Each job type has a record with a queued and a running count,
+// 4 bytes apart, exactly as in Black Ops III, whose identical freeze ARMSX3 ended with a two-instruction patch of the
+// SPU job image (ios/IOSCanaryPatches932.h: two job types each waiting for the other's queued count). The job images
+// are data of the executable in guest memory, and the checks can only be read there.
+//
+// This header holds the two decisions that need no engine type, so they can be read and checked on their own:
+//  - job_queue_signature(): is this freeze the one above? The RSX FIFO stands on a jump to itself outside any draw (a
+//    pipeline is built inside a draw: a compile chain, as in session 5 of the same logs, never matches), one PPU thread
+//    at least runs guest code, and two SPU threads at least last reserved the same 128-byte line.
+//  - plan: which guest pages go into the file, each page once, under a byte budget.
+// The writer is in RPCS3IOSFreezeDump.cpp (freeze_guest_memory_line). Measurement only: reads, tried locks, the profiler
+// thread; nothing is written to the emulated machine.
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace rpcs3::ios::freeze_guest
+{
+inline constexpr std::uint32_t max_files_per_process = 4;                  // the file is rewritten: the last freeze stays
+inline constexpr std::uint32_t page_size = 4096;
+inline constexpr std::uint64_t memory_budget = 16ull * 1024 * 1024;         // guest memory per file
+inline constexpr std::uint64_t chase_budget = 4ull * 1024 * 1024;           // of which: what the watched lines point to
+inline constexpr std::uint32_t chase_window = 32u * 1024;                   // a job image of Black Ops II is 8 to 30 KiB
+inline constexpr std::uint32_t line_window = 16u * 1024;                    // each side of a watched line (the job type table)
+inline constexpr std::uint32_t code_window = 256u * 1024;                   // each side of a spinning thread's pc
+inline constexpr std::uint32_t call_window = 32u * 1024;                    // each side of its lr and ctr
+
+// RSX flow commands (gcm_enums.h: RSX_METHOD_OLD_JUMP_CMD, RSX_METHOD_NEW_JUMP_CMD and their masks).
+constexpr bool jump_to_self(std::uint32_t cmd, std::uint32_t get) noexcept
+{
+	if ((cmd & 0xe0000003u) == 0x20000000u)
+	{
+		return (cmd & 0x1ffffffcu) == get;
+	}
+
+	if ((cmd & 0xe0000003u) == 0x00000001u)
+	{
+		return (cmd & 0xfffffffcu) == get;
+	}
+
+	return false;
+}
+
+// The 128-byte line most SPU threads last reserved (0 entries are threads that reserved none) and how many did.
+struct shared_line
+{
+	std::uint32_t line = 0;
+	std::uint32_t threads = 0;
+};
+
+inline shared_line most_shared_line(const std::uint32_t* lines, std::size_t count) noexcept
+{
+	shared_line best;
+	for (std::size_t i = 0; i < count; i++)
+	{
+		const std::uint32_t line = lines[i] & ~127u;
+		if (!line)
+		{
+			continue;
+		}
+
+		std::uint32_t threads = 0;
+		for (std::size_t j = 0; j < count; j++)
+		{
+			threads += (lines[j] & ~127u) == line ? 1 : 0;
+		}
+
+		if (threads > best.threads)
+		{
+			best = {line, threads};
+		}
+	}
+	return best;
+}
+
+struct signature_input
+{
+	bool busy_no_frames = false;         // the episode's reason is no_frames_busy
+	bool fifo_present = false;
+	bool in_begin_end = false;           // the RSX thread is inside a draw
+	std::uint32_t fifo_get = 0;          // where the FIFO stands
+	std::uint32_t fifo_last_cmd = 0;     // the last command word it decoded
+	std::uint32_t ppu_in_guest_code = 0; // PPU threads outside any system call
+	shared_line spu_line;
+};
+
+// Why the file is not written, or nullptr when the freeze has the job-queue signature.
+constexpr const char* signature_refusal(const signature_input& in) noexcept
+{
+	if (!in.busy_no_frames) return "not_busy";
+	if (!in.fifo_present) return "no_rsx";
+	if (in.in_begin_end) return "rsx_in_draw";
+	if (!jump_to_self(in.fifo_last_cmd, in.fifo_get)) return "rsx_not_on_jump_to_self";
+	if (in.ppu_in_guest_code == 0) return "no_ppu_in_guest_code";
+	if (in.spu_line.threads < 2) return "no_shared_spu_line";
+	return nullptr;
+}
+
+enum region_kind : std::uint32_t
+{
+	kind_line = 1,    // around a 128-byte line the SPU threads reserve
+	kind_chased = 2,  // what a word of such a line (or of a spinning thread's registers) points to
+	kind_code = 3,    // around a pc, lr, ctr or saved return address
+	kind_stack = 4,
+	kind_tls = 5,
+	kind_fifo = 6,    // RSX commands around GET and PUT
+	kind_segment = 7, // the executable segment a spinning pc is in
+};
+
+struct region
+{
+	std::uint32_t addr = 0;
+	std::uint32_t size = 0;
+	std::uint32_t kind = 0;
+};
+
+// Pages to write, each once. add() rounds the range out to pages, drops the pages already planned and stops at the
+// budget; a range cut by pages planned earlier becomes several regions.
+class plan
+{
+public:
+	explicit plan(std::uint64_t budget_bytes) : m_budget(budget_bytes), m_taken(1u << 20, false) {}
+
+	std::uint64_t add(std::uint64_t addr, std::uint64_t size, std::uint32_t kind)
+	{
+		if (!size || addr >= 0x100000000ull)
+		{
+			return 0;
+		}
+
+		const std::uint64_t end = addr + size > 0x100000000ull ? 0x100000000ull : addr + size;
+		const std::uint32_t first = static_cast<std::uint32_t>(addr / page_size);
+		const std::uint32_t last = static_cast<std::uint32_t>((end - 1) / page_size);
+		std::uint64_t added = 0;
+		for (std::uint32_t p = first; p <= last && m_bytes + page_size <= m_budget; p++)
+		{
+			if (m_taken[p])
+			{
+				continue;
+			}
+
+			m_taken[p] = true;
+			m_bytes += page_size;
+			added += page_size;
+			if (!m_regions.empty() && m_regions.back().kind == kind &&
+				m_regions.back().addr + std::uint64_t{m_regions.back().size} == std::uint64_t{p} * page_size)
+			{
+				m_regions.back().size += page_size;
+			}
+			else
+			{
+				m_regions.push_back({p * page_size, page_size, kind});
+			}
+		}
+		return added;
+	}
+
+	bool full() const noexcept { return m_bytes + page_size > m_budget; }
+	std::uint64_t bytes() const noexcept { return m_bytes; }
+	const std::vector<region>& regions() const noexcept { return m_regions; }
+
+private:
+	std::uint64_t m_budget;
+	std::uint64_t m_bytes = 0;
+	std::vector<bool> m_taken; // one bit per 4 KiB page of the 32-bit guest address space
+	std::vector<region> m_regions;
+};
+
+// A big-endian guest word that may be an address worth following: above the null pages and aligned as data is.
+constexpr bool plausible_pointer(std::uint32_t word) noexcept
+{
+	return word >= 0x10000u && word < 0xf0000000u && (word & 3u) == 0;
+}
+}
diff --git a/rpcs3/ios/IOSSpuIdleEfficiency939.h b/rpcs3/ios/IOSSpuIdleEfficiency939.h
new file mode 100644
index 0000000..a7b8344
--- /dev/null
+++ b/rpcs3/ios/IOSSpuIdleEfficiency939.h
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <pthread/qos.h>
+#endif
+
+// REWINDBOX_SPU_IDLE_EFFICIENCY_939: an idle polling SPU thread sleeps in the utility class, so that iOS wakes it on an
+// efficiency core, and takes its own class back as soon as it wakes.
+//
+// iPhone logs of IPA 745 (Core 938, 14 Nov 2026, thermal state serious), Black Ops II menus at 60 FPS (PID 9077):
+// the performance cluster used 1.29 to 2.18 W for 0.47 to 1.44 core of work, against 1.25 W in play for 4.8 cores
+// (ENERGY931), with the performance cores at 3.6 to 3.96 GHz and 60 to 77 % of the CPU time on them. The six SPU
+// threads, which poll the game's job queue there, were 0.29 to 0.86 core of that time (qos_ms user-initiated); in play
+// they keep to the efficiency cores (about 0.1 core on the performance cores), but in the menus the performance cores
+// are mostly idle and iOS wakes the pollers there: each of the 38,000 short SPU sleeps a second can end on a
+// performance core at full frequency. The same menu took 0.46 to 0.60 W on IPA 726, when iOS kept the performance
+// cores at 1.7 GHz: the work is the same, its cost is where and how fast it runs.
+//
+// A thread is idle by the rule of REWINDBOX_SPU_POLL_IDLE_939 (ios/IOSSpuPollIdle939.h): eight sleeps in a row without
+// taking a job. Only the sleep changes class: once the thread is registered as waiting, just before it blocks, it asks
+// for the utility class, which iOS keeps on the efficiency cores (the utility compile threads of the same logs: 6 to
+// 9 % of their time on the performance cores), and the first thing it does when the wait ends, by a notification or
+// by its bound, is to take back the class of the SPU threads (user-initiated, ios/IOSThreadQoS.h). Whatever the thread
+// does after the wait, including the job it finds, runs in its own class, as before.
+//
+// Review of 16 Nov 2026 (XNU's Clutch scheduler): a utility thread made runnable waits until no user-initiated or
+// higher thread is ready on its cluster (its turn can come after tens of milliseconds), so a poller woken for a job
+// while the efficiency cores are busy with other SPU threads would start that job late. Hence three limits:
+// - only while the game is light: the profiler sampler (every 500 ms) sets light_load when the process uses at most
+//   2 cores and clears it from 3 (Black Ops II menus: 0.5 to 1.8 cores; play: 4.3 to 5.0, never light);
+// - only for a lengthened wait (320 or 640 us) of an idle poller, never for the short ones;
+// - self-check per thread: a sleep in the utility class that ends later than its bound plus a quarter plus 50 us
+//   (the kernel's timer slack for these waits is at most an eighth of the bound) waited for the scheduler; the thread
+//   then keeps its own class for 256 lengthened waits, then 512, ... about a million.
+// Only with the SPU threads one class below the RSX and PPU threads (REWINDBOX_SPU_QOS_627), whose class is the one
+// taken back, and with the idle rule switched on ("Event Waits When Hot" not Disabled). Cost: two class changes per
+// such sleep (a system call each, about a microsecond, on an efficiency core).
+namespace rpcs3::ios::spu_idle_efficiency
+{
+// Report counters (COREPROF THERMAL931 tail): sleeps taken in the utility class, class changes that failed, and
+// sleeps in the utility class that ended too late (each starts a hold of its thread).
+inline std::atomic<std::uint64_t> efficient_sleeps{0};
+inline std::atomic<std::uint64_t> failed_changes{0};
+inline std::atomic<std::uint64_t> late_wakeups{0};
+
+// Written by the profiler sampler, read by the SPU threads.
+inline constexpr double enter_light_cores = 2.0;
+inline constexpr double leave_light_cores = 3.0;
+inline std::atomic<bool> light_load{false};
+
+inline void observe_load(double process_cores) noexcept
+{
+	const bool light = light_load.load(std::memory_order_relaxed);
+	if (!light && process_cores <= enter_light_cores)
+	{
+		light_load.store(true, std::memory_order_relaxed);
+	}
+	else if (light && process_cores >= leave_light_cores)
+	{
+		light_load.store(false, std::memory_order_relaxed);
+	}
+}
+
+// Per host thread (thread_local in SPUThread.cpp).
+class check
+{
+	std::uint32_t m_hold = 0;
+	std::uint32_t m_next_hold = 256;
+
+public:
+	// Before a lengthened wait that may sleep in the utility class: false while the thread holds its own class.
+	bool allowed() noexcept
+	{
+		if (m_hold)
+		{
+			m_hold--;
+			return false;
+		}
+
+		return true;
+	}
+
+	// After such a sleep: `slept_ns` from before the wait to after the class was taken back.
+	void after(std::uint64_t slept_ns, std::uint64_t bound_ns) noexcept
+	{
+		if (slept_ns > bound_ns + bound_ns / 4 + 50'000)
+		{
+			late_wakeups.fetch_add(1, std::memory_order_relaxed);
+			m_hold = m_next_hold;
+			m_next_hold = m_next_hold < (1u << 20) ? m_next_hold * 2 : (1u << 20);
+		}
+	}
+};
+
+// Before the timed wait of an idle thread. True when the thread now runs in the utility class.
+inline bool enter() noexcept
+{
+#if defined(__APPLE__)
+	if (pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0) == 0)
+	{
+		efficient_sleeps.fetch_add(1, std::memory_order_relaxed);
+		return true;
+	}
+
+	failed_changes.fetch_add(1, std::memory_order_relaxed);
+#endif
+	return false;
+}
+
+// Right after that wait, when enter() returned true: the class of the SPU threads again.
+inline void leave() noexcept
+{
+#if defined(__APPLE__)
+	if (pthread_set_qos_class_self_np(QOS_CLASS_USER_INITIATED, 0) != 0)
+	{
+		failed_changes.fetch_add(1, std::memory_order_relaxed);
+	}
+#endif
+}
+}
