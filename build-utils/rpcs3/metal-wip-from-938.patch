+
+// The readable pages of [addr, addr + size) go to the plan; returns the bytes it took.
+u64 add_readable(guest::plan& plan, u64 addr, u64 size, u32 kind)
+{
+	u64 added = 0;
+	const u64 end = std::min<u64>(addr + size, 0x100000000ull);
+	for (u64 at = addr & ~u64{guest::page_size - 1}; at < end && !plan.full(); at += guest::page_size)
+	{
+		if (vm::check_addr(static_cast<u32>(at), vm::page_readable, guest::page_size))
+		{
+			added += plan.add(at, guest::page_size, kind);
+		}
+	}
+	return added;
