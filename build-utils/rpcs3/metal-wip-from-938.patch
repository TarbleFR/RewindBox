+
+// Follows the words of [addr, addr + size): what each plausible pointer leads to, `window` bytes from its page, within
+// `budget`. deeper: also one page for each pointer among the first 256 bytes found there (a queue node names its job,
+// the job its type record).
+void chase(guest::plan& plan, u32 addr, u32 size, u32 window, u64& budget, bool deeper)
+{
+	for (u32 offset = 0; offset + 4 <= size && budget >= guest::page_size && !plan.full(); offset += 4)
+	{
+		const u32 target = guest_word(addr + offset);
+		if (!guest::plausible_pointer(target) || !vm::check_addr(target, vm::page_readable, 4))
+		{
+			continue;
+		}
