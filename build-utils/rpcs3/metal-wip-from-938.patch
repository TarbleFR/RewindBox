@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "Emu/system_config_types.h"
+
+// REWINDBOX_ASYNC_SHADERS_939: the iOS default Shader Mode is now the Async Recompiler (RPCS3IOSGPUDefaults.h). RPCS3
+// writes every setting into config.yml, so an existing installation keeps the former default (Legacy Recompiler) there
+// and a new default alone would change nothing for it. Once per installation, the global value is migrated: the former
+// default becomes the Async Recompiler and any other value is kept. A marker beside config.yml records that the
+// migration ran, so a later explicit choice of the single-threaded mode in the global settings stays. Per-game choices
+// (sparse overrides) and the RPCS3 database's per-title Shader Mode are not touched; they still apply over the global
+// value at boot.
+namespace rpcs3::ios::async_shaders_939
+{
+	// Beside config.yml (fs::get_config_dir(true)).
+	inline constexpr const char marker_name[] = "rewindbox_async_shaders_939.done";
+
+	// The global Shader Mode after the migration, from the value config.yml holds.
+	constexpr shader_mode migrated(shader_mode global) noexcept
+	{
+		return global == shader_mode::recompiler ? shader_mode::async_recompiler : global;
+	}
+}
