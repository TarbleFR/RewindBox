+
+// Around an address: `each_side` bytes before and after it.
+u64 add_around(guest::plan& plan, u32 addr, u32 each_side, u32 kind)
+{
+	const u64 begin = addr > each_side ? addr - each_side : 0;
+	return add_readable(plan, begin, u64{addr} - begin + each_side, kind);
