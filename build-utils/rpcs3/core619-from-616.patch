diff --git a/rpcs3/ios/IOSZcullOnDemand.h b/rpcs3/ios/IOSZcullOnDemand.h
new file mode 100644
index 0000000..39d0a5b
--- /dev/null
+++ b/rpcs3/ios/IOSZcullOnDemand.h
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+// REWINDBOX_ZCULL_ON_DEMAND_619: Assassin's Creed (BLES00158, BLUS30089), Build
+// 617 iPhone logs (PID 65755, session 1, windows 17-28): 2,203-2,911 waits per
+// 5 s window, 4.15-4.32 s in all, every one of them inside ZCULL_control::sync()
+// (COREPROF ZCULLWAIT616 sync=, all other paths 0), 14-17 FPS. Once a report
+// page holding a pending report is touched, upstream marks the whole location
+// "accessed" for the rest of the boot (disable_optimizations): every report
+// becomes critical and every label write with a pipe flush, WAIT_FOR_IDLE or
+// NOTIFY waits for the GPU to retire all of them, about 33 times per frame.
+// On iOS the host page is 16 KiB: the GCM labels (4 KiB), the notifies (1 KiB)
+// and local reports 0-703 share one page, so the RSX thread's own label read or
+// write is enough to trigger it. With the lever the report pages stay
+// protected; the RSX thread reaches the label area and locked report pages
+// through the unprotected view (ios/IOSRsxLabelAccess.h); a PPU/SPU access to
+// a page that still holds a pending report asks the RSX thread to write every
+// claimed report (the writes sync() does), waits for them, then unprotects the
+// page. The guest reads the same values; the labels no longer wait. A request
+// not picked up within 2 s, guest waits above 400 ms per second or more than
+// 1,000 services per second return the boot to the upstream mode. Title scoped
+// (ios/IOSTitleLevers.h).
+namespace rpcs3::ios::zcull_on_demand
+{
+inline constexpr std::uint64_t pickup_deadline_us = 2'000'000;  // the RSX thread has not started the request
+inline constexpr std::uint64_t hard_deadline_us = 5'000'000;    // the request never completed
+inline constexpr std::uint64_t window_us = 1'000'000;
+inline constexpr std::uint32_t storm_services = 1'000;          // services per window
+inline constexpr std::uint64_t wait_budget_us = 400'000;        // guest wait per window
+
+enum class trip_reason : std::uint32_t
+{
+	none = 0,
+	storm = 1,       // more than storm_services services in a window
+	wait_budget = 2, // guest threads waited more than wait_budget_us in a window
+	pickup = 3,      // a request was not picked up in time
+	hard = 4,        // a request picked up but not completed in time
+};
+
+// Process-wide counters of COREPROF ZCULLDEMAND619 (taken per window).
+struct tally
+{
+	std::atomic<std::uint64_t> faults_label{0};     // guest access at a label/notify offset of a page with a pending report
+	std::atomic<std::uint64_t> faults_report{0};    // ... at a report offset of the GCM report area
+	std::atomic<std::uint64_t> faults_other{0};     // ... elsewhere (main-memory reports)
+	std::atomic<std::uint64_t> stale{0};            // guest accesses to a page whose reports were all written
+	std::atomic<std::uint64_t> services{0};         // RSX thread: every claimed report written for a request
+	std::atomic<std::uint64_t> waits{0};            // guest waits that ended served or released
+	std::atomic<std::uint64_t> wait_us{0};
+	std::atomic<std::uint64_t> wait_max_us{0};
+	std::atomic<std::uint64_t> timeouts{0};
+	std::atomic<std::uint64_t> stops{0};
+	std::atomic<std::uint64_t> rsx_reads{0};        // RSX copies out of locked report pages, served by writing the reports
+	std::atomic<std::uint64_t> upstream_cell{0};    // upstream disable_optimizations after a PPU/SPU access
+	std::atomic<std::uint64_t> upstream_other{0};   // ... after an access by another thread
+	std::atomic<std::uint64_t> upstream_rsx_read{0};// ... after an RSX copy out of report memory
+	std::atomic<std::uint32_t> tripped{0};          // trip_reason of the current boot
+
+	void add_wait(std::uint64_t us) noexcept
+	{
+		waits.fetch_add(1, std::memory_order_relaxed);
+		wait_us.fetch_add(us, std::memory_order_relaxed);
+		std::uint64_t max = wait_max_us.load(std::memory_order_relaxed);
+		while (us > max && !wait_max_us.compare_exchange_weak(max, us, std::memory_order_relaxed)) {}
+	}
+};
+
+inline tally& counters() noexcept
+{
+	static tally s_tally;
+	return s_tally;
+}
+
+// Request/serve handshake between faulting guest threads and the RSX thread.
+class gate
+{
+	std::atomic<std::uint64_t> m_requested{0};
+	std::atomic<std::uint64_t> m_picked{0};          // newest ticket the RSX thread started
+	std::atomic<std::uint64_t> m_served{0};          // newest ticket whose reports are written
+	std::atomic<std::uint32_t> m_tripped{0};
+	std::uint64_t m_window_start_us = 0;             // RSX thread only
+	std::uint32_t m_window_services = 0;             // RSX thread only
+	std::atomic<std::uint64_t> m_wait_window_start_us{0};
+	std::atomic<std::uint64_t> m_wait_window_us{0};
+
+	static void raise(std::atomic<std::uint64_t>& value, std::uint64_t ticket) noexcept
+	{
+		std::uint64_t current = value.load(std::memory_order_relaxed);
+		while (current < ticket && !value.compare_exchange_weak(current, ticket, std::memory_order_acq_rel, std::memory_order_relaxed)) {}
+	}
+
+public:
+	gate() noexcept
+	{
+		// One gate per renderer, that is per boot: the process-wide flag follows it.
+		counters().tripped.store(0, std::memory_order_relaxed);
+	}
+
+	gate(const gate&) = delete;
+	gate& operator=(const gate&) = delete;
+
+	// Guest thread: a new ticket, served once the RSX thread wrote every claimed report after it.
+	std::uint64_t request() noexcept
+	{
+		return m_requested.fetch_add(1, std::memory_order_acq_rel) + 1;
+	}
+
+	// RSX thread: the newest ticket waiting to be served, 0 when none.
+	std::uint64_t pending() const noexcept
+	{
+		const std::uint64_t requested = m_requested.load(std::memory_order_acquire);
+		return requested != m_served.load(std::memory_order_relaxed) ? requested : 0;
+	}
+
+	// RSX thread, before the forced pass for `ticket`.
+	void pick(std::uint64_t ticket) noexcept
+	{
+		raise(m_picked, ticket);
+	}
+
+	// RSX thread, after every report claimed when `ticket` was read is written.
+	// Returns true when this service tripped the storm guard.
+	bool serve(std::uint64_t ticket, std::uint64_t now_us) noexcept
+	{
+		raise(m_picked, ticket);
+		raise(m_served, ticket);
+
+		if (now_us - m_window_start_us >= window_us)
+		{
+			m_window_start_us = now_us;
+			m_window_services = 0;
+		}
+
+		return ++m_window_services > storm_services && trip(trip_reason::storm);
+	}
+
+	// Guest thread, after a wait. Returns true when it tripped the wait budget.
+	bool record_wait(std::uint64_t us, std::uint64_t now_us) noexcept
+	{
+		std::uint64_t start = m_wait_window_start_us.load(std::memory_order_relaxed);
+		if (now_us - start >= window_us && m_wait_window_start_us.compare_exchange_strong(start, now_us, std::memory_order_relaxed))
+		{
+			m_wait_window_us.store(0, std::memory_order_relaxed);
+		}
+
+		return m_wait_window_us.fetch_add(us, std::memory_order_relaxed) + us > wait_budget_us && trip(trip_reason::wait_budget);
+	}
+
+	bool is_picked(std::uint64_t ticket) const noexcept
+	{
+		return m_picked.load(std::memory_order_acquire) >= ticket;
+	}
+
+	bool is_served(std::uint64_t ticket) const noexcept
+	{
+		return m_served.load(std::memory_order_acquire) >= ticket;
+	}
+
+	// The first reason wins; returns true for the call that tripped.
+	bool trip(trip_reason reason) noexcept
+	{
+		std::uint32_t expected = 0;
+		if (!m_tripped.compare_exchange_strong(expected, static_cast<std::uint32_t>(reason), std::memory_order_acq_rel))
+		{
+			return false;
+		}
+
+		counters().tripped.store(static_cast<std::uint32_t>(reason), std::memory_order_relaxed);
+		return true;
+	}
+
+	bool tripped() const noexcept
+	{
+		return m_tripped.load(std::memory_order_acquire) != 0;
+	}
+};
+
+enum class wait_result
+{
+	served,    // the RSX thread wrote every report claimed at the request
+	released,  // the page no longer holds a pending report (written meanwhile)
+	stopped,   // emulation or renderer stopping
+	timed_out, // not picked up by pickup_deadline, or not completed by hard_deadline
+};
+
+// Guest thread: waits for `ticket`, measured from `started_us`. `released()` checks
+// the page, `stopped()` the emulator, `now_us()` the clock. A request the RSX thread
+// has picked up is waited for up to the hard deadline (a long pipeline compile or GPU
+// backlog is not a failure); one never picked up fails at the pickup deadline.
+// Spins briefly, then sleeps 50 us steps: the request costs one GPU round trip.
+template <typename Released, typename Stopped, typename Now>
+wait_result wait_for(const gate& g, std::uint64_t ticket, std::uint64_t started_us, Released&& released, Stopped&& stopped, Now&& now_us)
+{
+	for (unsigned step = 0;; step++)
+	{
+		if (g.is_served(ticket))
+		{
+			return wait_result::served;
+		}
+
+		if (released())
+		{
+			return wait_result::released;
+		}
+
+		if (stopped())
+		{
+			return wait_result::stopped;
+		}
+
+		const std::uint64_t elapsed = now_us() - started_us;
+		if (elapsed >= hard_deadline_us || (elapsed >= pickup_deadline_us && !g.is_picked(ticket)))
+		{
+			return wait_result::timed_out;
+		}
+
+		if (step < 32)
+		{
+			std::this_thread::yield();
+		}
+		else
+		{
+			std::this_thread::sleep_for(std::chrono::microseconds(50));
+		}
+	}
+}
+}
