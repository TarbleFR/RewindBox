+		void ZCULL_control::ios_release_stale_pages(u32 memory_address, u32 memory_range)
+		{
+			// RSX thread, after ios_retire_claimed(): the copy that follows reads these pages.
+			if (!memory_range)
+			{
+				return;
+			}
+
+			std::scoped_lock lock(m_pages_mutex);
+			const u32 page_size = static_cast<u32>(utils::get_page_size());
+			const u32 last = utils::page_start(memory_address + (memory_range - 1));
+
+			for (u32 page = utils::page_start(memory_address);; page += page_size)
+			{
+				auto& block = m_locked_pages[rsx::classify_location(page)];
