+					if (found->second.prot != utils::protection::rw)
+					{
+						utils::memory_protect(vm::base(page), utils::get_page_size(), utils::protection::rw);
+					}
+
+					block.erase(found);
+				}
+
+				if (page == last)
+				{
+					break;
+				}
+			}
+		}
+
+		ZCULL_control::ios_fault ZCULL_control::ios_on_demand_fault(u32 page_address, u32 location)
+		{
+			// PPU or SPU thread inside the access violation handler (vm::temporary_unlock done).
+			namespace od = rpcs3::ios::zcull_on_demand;
+			auto& tally = od::counters();
+			const u64 started = get_system_time();
+			const u64 deadline = started + od::fault_deadline_us;
+			bool requested = false;
+
+			const auto page_released = [&]()
+			{
+				reader_lock lock(m_pages_mutex);
+				const auto found = m_locked_pages[location].find(page_address);
+				return found == m_locked_pages[location].end() || !found->second.has_refs();
+			};
+
+			const auto finish = [&](ios_fault result)
+			{
+				if (requested && result == ios_fault::handled)
+				{
+					tally.add_wait(get_system_time() - started);
+				}
+
+				return result;
+			};
+
+			while (true)
+			{
+				{
+					std::scoped_lock lock(m_pages_mutex);
+					auto& block = m_locked_pages[location];
+					const auto found = block.find(page_address);
+
+					if (found == block.end() || found->second.prot == utils::protection::rw)
+					{
+						// Not a ZCULL page (upstream returns false), or unlocked meanwhile
+						// (served, or the upstream mode of another access unlocked the location).
+						return finish((requested || m_pages_accessed[location]) ? ios_fault::handled : ios_fault::not_ours);
+					}
+
+					if (!m_pages_accessed[location] && !found->second.has_refs())
+					{
+						// Every report of the page is written: unlock it, the next report locks it again.
+						utils::memory_protect(vm::base(page_address), utils::get_page_size(), utils::protection::rw);
+						block.erase(found);
+
+						if (!requested)
+						{
+							tally.stale.fetch_add(1, std::memory_order_relaxed);
+						}
+
+						return finish(ios_fault::handled);
+					}
+				}
+
+				if (m_pages_accessed[location] && get_system_time() < deadline)
+				{
+					// Another access is switching the location to the upstream mode, which
+					// unlocks every page of it: wait for that instead of failing the access.
+					std::this_thread::yield();
+					continue;
+				}
+
+				if (m_pages_accessed[location] || m_ios_demand.tripped())
+				{
+					return finish(ios_fault::upstream);
+				}
+
+				if (get_system_time() >= deadline)
+				{
+					tally.timeouts.fetch_add(1, std::memory_order_relaxed);
+					m_ios_demand.trip();
+					rsx_log.error("ZCULL on-demand read of page 0x%x not served in %u ms, upstream mode for the rest of this boot.",
+						page_address, static_cast<u32>(od::fault_deadline_us / 1000));
+					return finish(ios_fault::upstream);
+				}
+
+				if (!requested)
+				{
+					tally.faults.fetch_add(1, std::memory_order_relaxed);
+				}
+
+				// Ask the RSX thread to write every claimed report (sync() through pipe_flush_interrupt).
+				const u64 ticket = m_ios_demand.request();
+				requested = true;
+
+				auto thr = rsx::get_current_renderer();
+				thr->m_eng_interrupt_mask |= rsx::pipe_flush_interrupt;
+				rpcs3::ios::rsx_idle_park::wake();
+
+				const auto result = od::wait_for(m_ios_demand, ticket, deadline, page_released,
+					[&]() { return Emu.IsStopped() || thr->is_stopped(); },
+					[]() { return get_system_time(); });
+
+				if (result == od::wait_result::stopped)
+				{
+					tally.stops.fetch_add(1, std::memory_order_relaxed);
+					return finish(ios_fault::upstream);
+				}
+
+				// served, released or timed out: check the page again
+			}
+		}
+#endif
