+	// RewindBox Metal memory census: a resident allocation counted by kind, with its allocated size.
+	static void rbCensusResident(id<MTLAllocation> allocation, bool added) {
+		if ( !allocation ) { return; }
+		id object = (id)allocation;
+		int64_t size = (int64_t)((id<MTLResource>)object).allocatedSize;	// MoltenVK makes buffers and textures resident
+		rewindbox::MetalCensus* census = &rewindbox::residentOther;
+		if ([object conformsToProtocol: @protocol(MTLTexture)]) {
+			id<MTLTexture> texture = (id<MTLTexture>)object;
+			census = (texture.buffer || texture.heap) ? &rewindbox::residentAliases : &rewindbox::residentTextures;
+		} else if ([object conformsToProtocol: @protocol(MTLBuffer)]) {
+			census = ((id<MTLBuffer>)object).heap ? &rewindbox::residentAliases : &rewindbox::residentBuffers;
+		}
+		if (added) { census->add(size); } else { census->remove(size); }
 	}
 #endif
 
