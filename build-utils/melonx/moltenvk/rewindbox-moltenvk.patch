+					MVKLogInfo("RewindBox SPIR-V spill: no temporary file (errno %d); SPIR-V kept in memory.", errno);
+				}
+			}
+		}
+
+		/** The offset where all of the bytes were written, or kNotSpilled when they stay in memory. */
+		uint64_t write(const uint8_t* data, size_t size) {
+			if (_fd < 0 || size == 0) { return kNotSpilled; }
+			uint64_t offset = _next.fetch_add(size);
+			if (offset + size > kLimit) { return kNotSpilled; }
+			size_t done = 0;
+			while (done < size) {
+				ssize_t n = pwrite(_fd, data + done, size - done, (off_t)(offset + done));
+				if (n < 0 && errno == EINTR) { continue; }
+				if (n <= 0) { return kNotSpilled; }
+				done += (size_t)n;
+			}
+			return offset;
+		}
+
+		bool read(uint64_t offset, uint8_t* data, size_t size) {
+			size_t done = 0;
+			while (done < size) {
+				ssize_t n = pread(_fd, data + done, size - done, (off_t)(offset + done));
+				if (n < 0 && errno == EINTR) { continue; }
+				if (n <= 0) { return false; }
+				done += (size_t)n;
+			}
+			return true;
+		}
+
+	private:
+		int _fd = -1;
+		std::atomic<uint64_t> _next{0};
+	};
+
+	RewindBoxSPIRVSpill& rewindBoxSPIRVSpill() {
+		static RewindBoxSPIRVSpill spill;
+		return spill;
+	}
+}
+
+void MVKShaderModule::setSPIRV(const uint32_t* spirvCode, size_t wordCount) {
+	size_t byteCount = wordCount * sizeof(uint32_t);
+	_spirvWordCount = wordCount;
+	_spirvData.resize(byteCount);
+	size_t stored = 0;
+	if ( !rewindBoxRawSPIRV() ) {
+		stored = mvkCompress((const uint8_t*)spirvCode, byteCount, _spirvData.data(), byteCount, MVK_CONFIG_COMPRESSION_ALGORITHM_LZ4);
+	}
+	if (stored) {
+		_spirvAlgorithm = MVK_CONFIG_COMPRESSION_ALGORITHM_LZ4;
+	} else {
+		// The control, or words LZ4 does not make smaller: kept as given.
+		_spirvAlgorithm = MVK_CONFIG_COMPRESSION_ALGORITHM_NONE;
+		if (byteCount) { memcpy(_spirvData.data(), spirvCode, byteCount); }
+		stored = byteCount;
+	}
+	_spirvData.resize(stored);
+	// RewindBox (eighth part): the stored bytes to the spill file; kept here when they cannot go there.
+	_spirvOffset = rewindBoxSPIRVSpill().write(_spirvData.data(), stored);
+	if (_spirvOffset != RewindBoxSPIRVSpill::kNotSpilled) {
+		_spirvStoredSize = stored;
+		std::vector<uint8_t>().swap(_spirvData);
+	} else {
+		_spirvData.shrink_to_fit();
+	}
+}
+
+std::vector<uint32_t> MVKShaderModule::getSPIRV() {
+	std::vector<uint32_t> spirv(_spirvWordCount);
+	if (_spirvWordCount) {
+		size_t byteCount = _spirvWordCount * sizeof(uint32_t);
+		std::vector<uint8_t> spilled;
+		const std::vector<uint8_t>* stored = &_spirvData;
+		if (_spirvOffset != RewindBoxSPIRVSpill::kNotSpilled) {
+			spilled.resize(_spirvStoredSize);
+			if ( !rewindBoxSPIRVSpill().read(_spirvOffset, spilled.data(), _spirvStoredSize) ) {
+				reportError(VK_ERROR_INITIALIZATION_FAILED, "RewindBox SPIR-V spill: %zu bytes of SPIR-V not read back (errno %d).", _spirvStoredSize, errno);
+				spirv.clear();
+				return spirv;
+			}
+			stored = &spilled;
+		}
+		size_t read = mvkDecompress(stored->data(), stored->size(), (uint8_t*)spirv.data(), byteCount, _spirvAlgorithm);
+		if (read != byteCount) {
+			reportError(VK_ERROR_INITIALIZATION_FAILED, "RewindBox SPIR-V store: %zu of %zu bytes of SPIR-V decompressed.", read, byteCount);
+			spirv.clear();
+		}
+	}
+	return spirv;
+}
+
+bool MVKShaderModule::getShaderInterfaceVariables(spv::StorageClass storage, spv::ExecutionModel model, const string& entryName,
+												  MVKSmallVector<SPIRVShaderInterfaceVariable, 32>& vars, string& errorLog) {
+	{
+		lock_guard<mutex> lock(_reflectionLock);
+		for (const auto& reflected : _reflectedInterfaces) {
+			if (reflected.storage == storage && reflected.model == model && reflected.entryName == entryName) {
+				vars.clear();
+				for (const auto& var : reflected.vars) { vars.push_back(var); }
+				return true;
+			}
+		}
+	}
+
+	// Reflected without the lock, into the caller's container type: two threads may reflect the same interface at once,
+	// and they find the same variables; the first one kept stays.
+	auto spirv = getSPIRV();
+	bool wasReflected = (storage == spv::StorageClassOutput
+						 ? getShaderOutputs(spirv, model, entryName, vars, errorLog)
+						 : getShaderInputs(spirv, model, entryName, vars, errorLog));
+	if ( !wasReflected ) { return false; }
+
+	lock_guard<mutex> lock(_reflectionLock);
+	for (const auto& reflected : _reflectedInterfaces) {
+		if (reflected.storage == storage && reflected.model == model && reflected.entryName == entryName) { return true; }
+	}
+	_reflectedInterfaces.push_back({storage, model, entryName, std::vector<SPIRVShaderInterfaceVariable>(vars.begin(), vars.end())});
+	return true;
+}
