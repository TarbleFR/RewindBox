+// RewindBox: the configuration a cached shader library is kept under, without the resource bindings that decide nothing.
+// A pipeline layout lists every binding of its descriptor set layouts, for each of the five stages when Metal argument
+// buffers are used, whether a shader uses it or not; the cache then holds that whole table once per library, in memory
+// and in the pipeline cache data (MeloNX declares 130 bindings per stage: about 1 250 entries of 136 bytes per library,
+// 792 MiB of 4 669 libraries in IPA 724, read, copied at each merge and written again whole at each save).
+// What reads a cached configuration's resource bindings:
+// - matches(): only those of the entry point's stage that are used by the shader;
+// - alignWith(): a binding of the other configuration takes the used flag of the last binding here that matches it, and
+//   false when none does.
+// So a binding that is not used gives false, which is what its absence gives. It is dropped, unless a used binding before
+// it matches it: then it is the last match, its false wins over that true, and it stays. Every other member is copied.
+MVK_PUBLIC_SYMBOL SPIRVToMSLConversionConfiguration SPIRVToMSLConversionConfiguration::cacheKey() const {
+	SPIRVToMSLConversionConfiguration key;
+	key.options = options;
+	key.shaderInputs = shaderInputs;
+	key.shaderOutputs = shaderOutputs;
+	key.discreteDescriptorSets = discreteDescriptorSets;
+	key.dynamicBufferDescriptors = dynamicBufferDescriptors;
+
+	size_t usedCount = 0;
+	for (const auto& rb : resourceBindings) { if (rb.outIsUsedByShader) { usedCount++; } }
+	key.resourceBindings.reserve(usedCount);
+
+	for (const auto& rb : resourceBindings) {
+		bool keep = rb.outIsUsedByShader;
+		if ( !keep ) {
+			for (const auto& kept : key.resourceBindings) {
+				if (kept.outIsUsedByShader && kept.matches(rb)) { keep = true; break; }
+			}
+		}
+		if (keep) { key.resourceBindings.push_back(rb); }
+	}
+	return key;
+}
+
 
