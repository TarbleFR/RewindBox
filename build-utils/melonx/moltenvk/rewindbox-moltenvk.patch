+// RewindBox Metal memory census (eleventh part, measurement only): the allocations a device makes resident, by kind,
+// and the Metal buffers MoltenVK allocates for descriptor pools and visibility results outside its residency set,
+// counted as they are created and released (count, bytes, and how many were ever added); written with MoltenVK's
+// performance summary. A texture made on a buffer or a heap, or a buffer made on a heap, shares memory counted
+// elsewhere: it is counted apart, as an alias.
+namespace rewindbox {
+	struct MetalCensus {
+		std::atomic<int64_t> count{0}, bytes{0}, added{0};
+		void add(int64_t size) {
+			count.fetch_add(1, std::memory_order_relaxed);
+			bytes.fetch_add(size, std::memory_order_relaxed);
+			added.fetch_add(1, std::memory_order_relaxed);
+		}
+		void remove(int64_t size) {
+			count.fetch_sub(1, std::memory_order_relaxed);
+			bytes.fetch_sub(size, std::memory_order_relaxed);
+		}
+	};
+	extern MetalCensus residentTextures, residentBuffers, residentAliases, residentOther, descriptorPoolBuffers, visibilityBuffers;
+}
 
