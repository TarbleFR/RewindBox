+// RewindBox shared pipeline states: the state of an earlier pipeline whose descriptor equals this one, else a new one
+// compiled and offered to the next pipelines with the same descriptor.
+id<MTLRenderPipelineState> MVKGraphicsPipeline::getOrSharePipeline(MTLRenderPipelineDescriptor* plDesc,
+																	id<MTLRenderPipelineState>& plState) {
+	if (plState || rbSharingDisabled()) { return getOrCompilePipeline(plDesc, plState); }
+	std::string key;
+	if ( !rbRenderPipelineKey(plDesc, getMTLDevice(), _rbVertexCodeKey, _rbFragmentAbsent, _rbFragmentCodeKey, key) ) {
+		rbStatesUnkeyed.fetch_add(1, std::memory_order_relaxed);
+		return getOrCompilePipeline(plDesc, plState);
+	}
+	{
+		std::lock_guard<std::mutex> lock(rbSharedStatesLock());
+		auto found = rbSharedStates().find(key);
+		if (found != rbSharedStates().end()) {
+			plState = [found->second.state retain];	// retained
+			found->second.users++;
+			_rbSharedStateKey = std::move(key);
+		}
+	}
+	if (plState) {
+		uint64_t shared = rbStatesShared.fetch_add(1, std::memory_order_relaxed) + 1;
+		if (shared == 1 || (shared & 255) == 0) {
+			MVKLogInfo("RewindBox shared pipeline states: %llu shared, %llu compiled, %llu not shareable (process totals), %zu states in use",
+					   (unsigned long long)shared, (unsigned long long)rbStatesCompiled.load(std::memory_order_relaxed),
+					   (unsigned long long)rbStatesUnkeyed.load(std::memory_order_relaxed), rbSharedStatesInUse());
+		}
+		return plState;
+	}
+
+	getOrCompilePipeline(plDesc, plState);
+	if ( !plState ) { return plState; }
+	rbStatesCompiled.fetch_add(1, std::memory_order_relaxed);
+	std::lock_guard<std::mutex> lock(rbSharedStatesLock());
+	auto inserted = rbSharedStates().emplace(key, RBSharedPipelineState{plState, 1});
+	if ( !inserted.second ) {
+		// Another pipeline compiled the same state meanwhile: hold that one, drop this copy.
+		[plState release];
+		plState = [inserted.first->second.state retain];	// retained
+		inserted.first->second.users++;
+	}
+	_rbSharedStateKey = std::move(key);
+	return plState;
+}
