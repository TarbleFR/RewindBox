+// RewindBox shared pipeline states: this pipeline no longer uses its shared state (its own reference is released by
+// the destructor right after); the state leaves the table with its last pipeline.
+void MVKGraphicsPipeline::rbReleaseSharedPipelineState() {
+	if (_rbSharedStateKey.empty()) { return; }
+	std::lock_guard<std::mutex> lock(rbSharedStatesLock());
+	auto found = rbSharedStates().find(_rbSharedStateKey);
+	if (found != rbSharedStates().end() && found->second.state == _mtlPipelineState && --found->second.users == 0) {
+		rbSharedStates().erase(found);
+	}
+	_rbSharedStateKey.clear();
+}
