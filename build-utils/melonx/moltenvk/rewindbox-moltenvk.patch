+__attribute__((used)) static const char kRewindBoxMetalMemoryCensus[] =
+	"RewindBox Metal memory census: allocations made resident, descriptor pool and visibility buffers counted by kind";
+
+namespace rewindbox {
+	MetalCensus residentTextures, residentBuffers, residentAliases, residentOther, descriptorPoolBuffers, visibilityBuffers;
+}
+
 void MVKDevice::logPerformanceSummary() {
 
 	// Get a copy to minimize time under lock
 	MVKPerformanceStatistics perfStats;
 	getPerformanceStatistics(&perfStats);
 
+	// RewindBox Metal memory census (eleventh part): what the device's allocated size is made of, from counters kept as
+	// allocations are created and released (no walk of the residency set). Aliases share memory counted elsewhere: they
+	// are shown, not taken from the device's size.
+	{
+		auto mib = [](int64_t bytes) { return (long long)(bytes / (1 << 20)); };
+		auto n = [](const rewindbox::MetalCensus& c) { return (long long)c.count.load(std::memory_order_relaxed); };
+		auto b = [](const rewindbox::MetalCensus& c) { return c.bytes.load(std::memory_order_relaxed); };
+		auto a = [](const rewindbox::MetalCensus& c) { return (long long)c.added.load(std::memory_order_relaxed); };
+		const auto& tx = rewindbox::residentTextures;
+		const auto& bf = rewindbox::residentBuffers;
+		const auto& al = rewindbox::residentAliases;
+		const auto& ot = rewindbox::residentOther;
+		const auto& dp = rewindbox::descriptorPoolBuffers;
+		const auto& vb = rewindbox::visibilityBuffers;
+		int64_t device = (int64_t)_physicalDevice->getCurrentAllocatedSize();
+		int64_t counted = b(tx) + b(bf) + b(ot) + b(dp) + b(vb);
+		MVKLogInfo("RewindBox Metal memory: device %lld MiB; made resident: textures %lld (%lld MiB, %lld added), buffers %lld (%lld MiB, %lld added), "
+				   "aliases %lld (%lld MiB, %lld added), other %lld (%lld MiB); descriptor pool buffers %lld (%lld MiB, %lld added); "
+				   "visibility buffers %lld (%lld MiB); the rest %lld MiB",
+				   mib(device), n(tx), mib(b(tx)), a(tx), n(bf), mib(b(bf)), a(bf), n(al), mib(b(al)), a(al), n(ot), mib(b(ot)),
+				   n(dp), mib(b(dp)), a(dp), n(vb), mib(b(vb)), mib(device - counted));
+	}
+
 #define logDuration(s)   logActivityDuration(perfStats.s, perfStats)
 #define logByteCount(s)  logActivityByteCount(perfStats.s, perfStats)
 
