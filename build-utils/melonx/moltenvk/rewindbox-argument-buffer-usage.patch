+// RewindBox: the slot of a resource in the usage cache (Fibonacci hashing of the object address).
+static inline size_t mvkRBUsageSlot(void* resource) {
+	return size_t(((uint64_t)(uintptr_t)resource >> 4) * 0x9E3779B97F4A7C15ull >> 56);
+}
+
+// RewindBox: true when this encoder already made useResource with this resource and usage, for these stages.
+bool MVKResourcesCommandEncoderState::rbSkipResourceUsage(id<MTLResource> mtlResource, MTLResourceUsage mtlUsage, MTLRenderStages mtlStages) {
+	static_assert(kMVKRBUsageCacheSize == 256, "mvkRBUsageSlot gives 8 bits");
+	if ( !getDevice()->useRewindBoxFastUsageWalk() || _rbUsageCache.empty() ) { return false; }
+	auto& entry = _rbUsageCache[mvkRBUsageSlot((void*)mtlResource)];
+	if (entry.resource == (void*)mtlResource && entry.usage == mtlUsage && (entry.stages | mtlStages) == entry.stages) {
+		_rbCounts.skipped++;
+		return true;
+	}
+	return false;
+}
+
+// RewindBox: counts a useResource made, and with the fast walk remembers it until the encoder ends.
+void MVKResourcesCommandEncoderState::rbRecordResourceUsage(id<MTLResource> mtlResource, MTLResourceUsage mtlUsage, MTLRenderStages mtlStages) {
+	_rbCounts.calls++;
+	if ( !getDevice()->useRewindBoxFastUsageWalk() ) { return; }
+	if (_rbUsageCache.empty()) { _rbUsageCache.resize(kMVKRBUsageCacheSize); }
+	auto& entry = _rbUsageCache[mvkRBUsageSlot((void*)mtlResource)];
+	entry.resource = (void*)mtlResource;
+	entry.usage = mtlUsage;
+	entry.stages = mtlStages;
+	_rbUsageCacheFilled = true;
+}
+
+void MVKResourcesCommandEncoderState::rbClearResourceUsage() {
+	if ( !_rbUsageCacheFilled ) { return; }
+	std::fill(_rbUsageCache.begin(), _rbUsageCache.end(), MVKRBUsageEntry());
+	_rbUsageCacheFilled = false;
+}
+
+void MVKResourcesCommandEncoderState::flushRewindBoxUsageWalk() {
+	if ( !(_rbCounts.encodes || _rbCounts.calls || _rbCounts.skipped || _rbCounts.tessellation) ) { return; }
+	getDevice()->addRewindBoxUsageWalk(_rbCounts.encodes, _rbCounts.elements, _rbCounts.dirty, _rbCounts.calls,
+									   _rbCounts.skipped, _rbCounts.tessellation, _rbCounts.ticks);
+	_rbCounts = MVKRBUsageCounts();
+}
