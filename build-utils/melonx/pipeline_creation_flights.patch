+        private readonly HashTableSlim<TKey, byte> _active = new();
+
+        [ThreadStatic]
+        internal static long JoinedTicks;
+
+        public static PipelineCreationFlights<TKey> For(object owner) => Groups.GetValue(owner, static _ => new());
+
+        public bool Enter(ref TKey key, bool mayWait)
+        {
+            lock (_active)
+            {
+                while (_active.TryGetValue(ref key, out _))
