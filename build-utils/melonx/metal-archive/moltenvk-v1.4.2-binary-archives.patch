+	/** As newRenderPipelineState(), for a compute pipeline. */
+	id<MTLComputePipelineState> newComputePipelineState(MTLComputePipelineDescriptor* plDesc);
+
+	/** Queues the functions of a pipeline that was just compiled for this session's archive. Never waits. */
+	void collect(MTLRenderPipelineDescriptor* plDesc);
+
+	/** Queues the functions of a pipeline that was just compiled for this session's archive. Never waits. */
+	void collect(MTLComputePipelineDescriptor* plDesc);
