+// On the queue, once. Prunes, verifies and loads the segments of this identity, then publishes them for lookups.
+void MVKMetalBinaryArchives::loadOnQueue() {
+	uint64_t startTime = mvkGetTimestamp();
+	NSFileManager* fileMgr = NSFileManager.defaultManager;
+	NSString* directory = @(_directory.c_str());
+	NSError* err = nil;
+	if ( ![fileMgr createDirectoryAtPath: directory withIntermediateDirectories: YES attributes: nil error: &err] ) {
+		_directoryErrors++;
+		_isCollecting = false;
+		_isLoaded = true;
+		reportMessage(MVK_CONFIG_LOG_LEVEL_WARNING, "RewindBox Metal binary archives: no directory %s (%s); not used this session.",
+					  _directory.c_str(), err.localizedDescription.UTF8String);
+		return;
+	}
+
+	// Binaries of another identity (another OS build, MoltenVK revision or GPU) cannot be used here: the most recently
+	// used other identity is kept (a return to it finds its files), older ones are removed.
+	NSString* root = @(_rootDirectory.c_str());
+	NSString* keptOther = nil;
+	NSDate* keptOtherDate = nil;
+	NSMutableArray<NSString*>* others = [NSMutableArray array];
+	for (NSString* name in [fileMgr contentsOfDirectoryAtPath: root error: nil]) {
+		if ( ![name hasPrefix: @"id-"] || [name isEqualToString: @(_identity.c_str())] ) { continue; }
+		[others addObject: name];
+		NSDate* modified = [[fileMgr attributesOfItemAtPath: [root stringByAppendingPathComponent: name] error: nil] fileModificationDate];
+		if ( !keptOther || (modified && ( !keptOtherDate || [modified compare: keptOtherDate] == NSOrderedDescending )) ) { keptOther = name; keptOtherDate = modified; }
+	}
+	for (NSString* name in others) {
+		if ( ![name isEqualToString: keptOther] && [fileMgr removeItemAtPath: [root stringByAppendingPathComponent: name] error: nil] ) { _prunedIdentities++; }
+	}
+	// The directory's date is its last use.
+	[fileMgr setAttributes: @{NSFileModificationDate: [NSDate date]} ofItemAtPath: directory error: nil];
+
+	struct Segment { uint32_t number; uint32_t token; uint64_t bytes; std::string digest; std::string path; };
+	std::vector<Segment> segments;
+	uint32_t highestNumber = 0;
+	for (NSString* name in [fileMgr contentsOfDirectoryAtPath: directory error: nil]) {
+		std::string path = _directory + "/" + name.UTF8String;
+		struct stat fileStat;
+		if ([name hasSuffix: @".tmp"]) {
+			// A save that never completed; one less than ten minutes old may be another live device's.
+			if (stat(path.c_str(), &fileStat) == 0 && time(nullptr) - fileStat.st_mtime > 600) { unlink(path.c_str()); }
+			continue;
+		}
+		unsigned number = 0, token = 0;
+		unsigned long long bytes = 0;
+		char digest[17] = {};
+		int consumed = 0;
+		if (sscanf(name.UTF8String, "seg-%u-%8x-%llu-%16[0-9a-f].mtlarchive%n", &number, &token, &bytes, digest, &consumed) != 4 ||
+			consumed != (int)strlen(name.UTF8String) || strlen(digest) != 16) { continue; }
+		highestNumber = max<uint32_t>(highestNumber, number);
+		if (stat(path.c_str(), &fileStat) != 0 || (uint64_t)fileStat.st_size != bytes) {
+			unlink(path.c_str());
+			unlink((path + ".refused").c_str());
+			_removedDamaged++;
+			continue;
+		}
+		segments.push_back({number, token, bytes, digest, path});
+	}
+	_segmentNumber = highestNumber + 1;
+
+	// One generation per session's segment (the largest: a session's archive only grows), then the bounds, oldest first.
+	std::sort(segments.begin(), segments.end(), [](const Segment& a, const Segment& b) {
+		if (a.number != b.number) { return a.number < b.number; }
+		if (a.token != b.token) { return a.token < b.token; }
+		return a.bytes > b.bytes;
+	});
+	std::vector<Segment> kept;
+	for (auto& segment : segments) {
+		if ( !kept.empty() && kept.back().number == segment.number && kept.back().token == segment.token ) { unlink(segment.path.c_str()); continue; }
+		kept.push_back(segment);
+	}
+	uint64_t totalBytes = 0;
+	for (auto& segment : kept) { totalBytes += segment.bytes; }
+	size_t first = 0;
+	while (first < kept.size() && (kept.size() - first > _maxSegments - 1 || totalBytes > _maxBytes)) {
+		totalBytes -= kept[first].bytes;
+		unlink(kept[first].path.c_str());
+		unlink((kept[first].path + ".refused").c_str());
+		_prunedSegments++;
+		first++;
+	}
+
+	NSMutableArray<id<MTLBinaryArchive>>* archives = [NSMutableArray array];
+	for (size_t index = first; index < kept.size(); index++) {
+		Segment& segment = kept[index];
+		std::string refusedMarker = segment.path + ".refused";
+		if (_verifiesContent) {
+			uint64_t verifyStart = mvkGetTimestamp();
+			uint64_t fileSize = 0;
+			bool isIntact = rbxFileDigest(segment.path, fileSize) == segment.digest;
+			_verifyNanos += mvkGetElapsedNanoseconds(verifyStart);
+			if ( !isIntact ) {
+				unlink(segment.path.c_str());
+				unlink(refusedMarker.c_str());
+				_removedDamaged++;
+				continue;
+			}
+		}
+		MTLBinaryArchiveDescriptor* archDesc = [MTLBinaryArchiveDescriptor new];	// temp retain
+		archDesc.url = [NSURL fileURLWithPath: @(segment.path.c_str())];
+		err = nil;
+		id<MTLBinaryArchive> archive = [_mtlDevice newBinaryArchiveWithDescriptor: archDesc error: &err];	// temp retain
+		[archDesc release];															// temp release
+		if (archive) {
+			[archives addObject: archive];
+			[archive release];														// temp release
+			unlink(refusedMarker.c_str());
+			_loadedSegments++;
+			_loadedBytes += segment.bytes;
+		} else {
+			// An intact file Metal refuses: kept once (the refusal may not last), removed at its second refusal.
+			_refusedSegments++;
+			if (access(refusedMarker.c_str(), F_OK) == 0) {
+				unlink(segment.path.c_str());
+				unlink(refusedMarker.c_str());
+				_removedRefused++;
+			} else {
+				FILE* marker = fopen(refusedMarker.c_str(), "w");
+				if (marker) { fclose(marker); }
+			}
+		}
+	}
+
+	if (archives.count) {
+		NSArray<id<MTLBinaryArchive>>* loaded = [[NSArray alloc] initWithArray: archives];	// retained
+		lock_guard<mutex> lock(_lock);
+		_loadedArchives = loaded;
+	}
+	_loadNanos = mvkGetElapsedNanoseconds(startTime);
+	_isLoaded = true;
+	writeReport();
+	logSummary("loaded");
+}
+
+static double rbxMs(const std::atomic<uint64_t>& nanoseconds) { return (double)nanoseconds.load() / 1e6; }
+
+void MVKMetalBinaryArchives::logSummary(const char* when) {
+	reportMessage(MVK_CONFIG_LOG_LEVEL_INFO,
+				  "RewindBox Metal binary archives (%s): %llu segments loaded (%.2f MB, verify %.1f ms, load %.1f ms), removed damaged %llu, refused %llu, pruned %llu. "
+				  "Pipelines from an archive %llu (%.1f ms, max %.2f ms; compute %llu, %.1f ms), misses %llu (%.1f ms, max %.2f ms), lookups before the load %llu, with no archive %llu. "
+				  "Collected %llu of %llu queued (%.1f ms, max %.2f ms), errors %llu, already archived %llu, dropped %llu (queue) %llu (close), held for memory %llu, capped %llu. "
+				  "Saves %llu (%.1f ms, max %.1f ms, %llu bytes), save errors %llu. %s",
+				  when, _loadedSegments.load(), (double)_loadedBytes.load() / 1048576.0, rbxMs(_verifyNanos), rbxMs(_loadNanos),
+				  _removedDamaged.load(), _refusedSegments.load(), _prunedSegments.load(),
+				  _hits.load(), rbxMs(_hitNanos), rbxMs(_hitMaxNanos), _computeHits.load(), rbxMs(_computeHitNanos), _misses.load(), rbxMs(_missNanos), rbxMs(_missMaxNanos),
+				  _lookupsBeforeLoad.load(), _lookupsWithoutArchive.load(),
+				  _collected.load(), _collectQueued.load(), rbxMs(_addNanos), rbxMs(_addMaxNanos), _addErrors.load(), _collectAlreadyArchived.load(),
+				  _collectDroppedQueueFull.load(), _collectDroppedAtClose.load(), _collectHeldForMemory.load(), _collectCapped.load(),
+				  _saves.load(), rbxMs(_saveNanos), rbxMs(_saveMaxNanos), _savedBytes.load(), _saveErrors.load(), _identity.c_str());
+}
+
+// On the queue. The same figures for a test to read (RBX_MVK_BINARY_ARCHIVE_REPORT), written whole then renamed.
+void MVKMetalBinaryArchives::writeReport() {
+	if (_reportPath.empty()) { return; }
+	std::ostringstream json;
+	json << "{\"schema\": \"" << kRBXArchiveSchema << "\", \"identity\": \"" << _identity << "\""
+		 << ", \"strict\": " << (_isStrict ? "true" : "false")
+		 << ", \"loaded\": " << (_isLoaded ? "true" : "false")
+		 << ", \"loadedSegments\": " << _loadedSegments.load() << ", \"loadedBytes\": " << _loadedBytes.load()
+		 << ", \"verifyMs\": " << rbxMs(_verifyNanos) << ", \"loadMs\": " << rbxMs(_loadNanos)
+		 << ", \"removedDamaged\": " << _removedDamaged.load() << ", \"refusedSegments\": " << _refusedSegments.load()
+		 << ", \"removedRefused\": " << _removedRefused.load() << ", \"prunedSegments\": " << _prunedSegments.load()
+		 << ", \"prunedIdentities\": " << _prunedIdentities.load()
+		 << ", \"hits\": " << _hits.load() << ", \"hitMs\": " << rbxMs(_hitNanos) << ", \"hitMaxMs\": " << rbxMs(_hitMaxNanos)
+		 << ", \"computeHits\": " << _computeHits.load() << ", \"computeHitMs\": " << rbxMs(_computeHitNanos)
+		 << ", \"misses\": " << _misses.load() << ", \"missMs\": " << rbxMs(_missNanos) << ", \"missMaxMs\": " << rbxMs(_missMaxNanos)
+		 << ", \"lookupsBeforeLoad\": " << _lookupsBeforeLoad.load() << ", \"lookupsWithoutArchive\": " << _lookupsWithoutArchive.load()
+		 << ", \"collectQueued\": " << _collectQueued.load() << ", \"collected\": " << _collected.load()
+		 << ", \"addMs\": " << rbxMs(_addNanos) << ", \"addMaxMs\": " << rbxMs(_addMaxNanos) << ", \"addErrors\": " << _addErrors.load()
+		 << ", \"collectAlreadyArchived\": " << _collectAlreadyArchived.load()
+		 << ", \"collectDroppedQueueFull\": " << _collectDroppedQueueFull.load() << ", \"collectDroppedAtClose\": " << _collectDroppedAtClose.load()
+		 << ", \"collectHeldForMemory\": " << _collectHeldForMemory.load() << ", \"collectCapped\": " << _collectCapped.load()
+		 << ", \"saves\": " << _saves.load() << ", \"saveMs\": " << rbxMs(_saveNanos) << ", \"saveMaxMs\": " << rbxMs(_saveMaxNanos)
+		 << ", \"savedBytes\": " << _savedBytes.load() << ", \"saveErrors\": " << _saveErrors.load() << ", \"reopenErrors\": " << _reopenErrors.load()
+		 << ", \"directoryErrors\": " << _directoryErrors.load() << "}\n";
+	std::string tmpPath = _reportPath + ".tmp";
+	FILE* file = fopen(tmpPath.c_str(), "w");
+	if ( !file ) { return; }
+	std::string text = json.str();
+	fwrite(text.data(), 1, text.size(), file);
+	fclose(file);
+	rename(tmpPath.c_str(), _reportPath.c_str());
+}
