+#pragma mark -
+#pragma mark MVKMetalBinaryArchives
+
+// RewindBox prototype (lot 7). See MVKPipeline.h.
+
+static const char* const kRBXArchiveSchema = "rbx-mtl-archive-1";
+static const int32_t kRBXArchiveMaxPendingAdds = 256;
+
+static uint64_t rbxEnvNumber(const char* name, uint64_t defaultValue) {
+	const char* value = getenv(name);
+	return (value && value[0]) ? strtoull(value, nullptr, 10) : defaultValue;
+}
+
+static void rbxAtomicMax(std::atomic<uint64_t>& target, uint64_t value) {
+	uint64_t seen = target.load();
+	while (seen < value && !target.compare_exchange_weak(seen, value)) {}
+}
+
+static uint64_t rbxHash64(uint64_t hash, const void* data, size_t length) {
+	const uint8_t* bytes = (const uint8_t*)data;
+	for (size_t i = 0; i < length; i++) { hash ^= bytes[i]; hash *= 1099511628211ull; }
+	return hash;
+}
+
+// The first 16 hexadecimal digits of the SHA-256 of a file, or an empty string if it cannot be read.
+static std::string rbxFileDigest(const std::string& path, uint64_t& fileSize) {
+	fileSize = 0;
+	FILE* file = fopen(path.c_str(), "rb");
+	if ( !file ) { return std::string(); }
+	CC_SHA256_CTX ctx;
+	CC_SHA256_Init(&ctx);
+	std::vector<uint8_t> buffer(1 << 20);
+	size_t count;
+	while ((count = fread(buffer.data(), 1, buffer.size(), file)) > 0) {
+		CC_SHA256_Update(&ctx, buffer.data(), (CC_LONG)count);
+		fileSize += count;
+	}
+	bool failed = ferror(file) != 0;
+	fclose(file);
+	if (failed) { return std::string(); }
+	uint8_t digest[CC_SHA256_DIGEST_LENGTH];
+	CC_SHA256_Final(digest, &ctx);
+	char text[17];
+	for (int i = 0; i < 8; i++) { snprintf(text + i * 2, 3, "%02x", digest[i]); }
+	return std::string(text, 16);
+}
+
+MVKVulkanAPIObject* MVKMetalBinaryArchives::getVulkanAPIObject() { return _device; }
+
+MVKMetalBinaryArchives* MVKMetalBinaryArchives::create(MVKDevice* device) {
+	const char* directory = getenv("RBX_MVK_BINARY_ARCHIVE_DIR");
+	if ( !directory || !directory[0] ) { return nullptr; }
+	return new MVKMetalBinaryArchives(device, directory);
+}
+
+MVKMetalBinaryArchives::MVKMetalBinaryArchives(MVKDevice* device, const char* directory) : MVKBaseDeviceObject(device) {
+	_mtlDevice = [getMTLDevice() retain];		// retained
+	_rootDirectory = directory;
+	_isStrict = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_STRICT", 0) != 0;
+	_isCollecting = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_COLLECT", 1) != 0;
+	_verifiesContent = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_VERIFY", 1) != 0;
+	_reopensAfterSave = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_REOPEN", 1) != 0;
+	_maxSegments = (uint32_t)max<uint64_t>(2, rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_MAX_SEGMENTS", 8));
+	_maxBytes = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_MAX_MB", 192) << 20;
+	_maxSessionBytes = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_SESSION_MAX_MB", 64) << 20;
+	_maxSessionAdds = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_SESSION_MAX_ADDS", 4096);
+	_saveEveryAdds = max<uint64_t>(1, rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_SAVE_EVERY", 64));
+	// On macOS mvkGetAvailableMemorySize() counts free pages only, which says little: no floor there unless asked for.
+	_minFreeBytes = rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_MIN_FREE_MB", MVK_MACOS ? 0 : 384) << 20;
+	const char* report = getenv("RBX_MVK_BINARY_ARCHIVE_REPORT");
+	if (report && report[0]) { _reportPath = report; }
+
+	// What makes a Metal binary unusable: the MoltenVK revision, OS version, GPU family and argument buffer use
+	// (the Vulkan pipelineCacheUUID), the OS build, and the GPU.
+	const VkPhysicalDeviceProperties& props = getDeviceProperties();
+	char osBuild[64] = {};
+	size_t osBuildSize = sizeof(osBuild) - 1;
+	sysctlbyname("kern.osversion", osBuild, &osBuildSize, nullptr, 0);
+	uint64_t hash = rbxHash64(1469598103934665603ull, kRBXArchiveSchema, strlen(kRBXArchiveSchema));
+	hash = rbxHash64(hash, props.pipelineCacheUUID, VK_UUID_SIZE);
+	hash = rbxHash64(hash, osBuild, strlen(osBuild));
+	hash = rbxHash64(hash, props.deviceName, strlen(props.deviceName));
+	char identity[32];
+	snprintf(identity, sizeof(identity), "id-%016llx", (unsigned long long)hash);
+	_identity = identity;
+	_directory = _rootDirectory + "/" + _identity;
+
+	// Tells this device's files from those of another device of the same identity alive at the same time.
+	uint64_t tokenSeed = mvkGetTimestamp() ^ (uint64_t)(uintptr_t)this ^ ((uint64_t)getpid() << 32);
+	_sessionToken = (uint32_t)rbxHash64(hash, &tokenSeed, sizeof(tokenSeed));
+
+	_queue = dispatch_queue_create("RewindBox.MetalBinaryArchives",
+								   dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));	// retained
+
+	// The load never delays the device, except where a test needs every lookup to see the archives.
+	if (_isStrict || rbxEnvNumber("RBX_MVK_BINARY_ARCHIVE_SYNC_LOAD", 0) != 0) {
+		dispatch_sync(_queue, ^{ @autoreleasepool { loadOnQueue(); } });
+	} else {
+		dispatch_async(_queue, ^{ @autoreleasepool { loadOnQueue(); } });
+	}
+}
+
+MVKMetalBinaryArchives::~MVKMetalBinaryArchives() {
+	// Collections queued but not started are dropped (addOnQueue sees _isClosing); the one in progress finishes.
+	_isClosing = true;
+	dispatch_sync(_queue, ^{
+		@autoreleasepool {
+			saveOnQueue();
+			writeReport();
+			logSummary("at device destruction");
+		}
+	});
+	dispatch_release(_queue);
+	[_collectingArchive release];
+	[_loadedArchives release];
+	[_mtlDevice release];
+}
+
+NSArray<id<MTLBinaryArchive>>* MVKMetalBinaryArchives::copyLoadedArchives() {
+	lock_guard<mutex> lock(_lock);
+	return [_loadedArchives retain];	// retained
+}
+
+void MVKMetalBinaryArchives::noteLookup(bool isHit, bool isCompute, uint64_t nanoseconds) {
+	if (isHit) {
+		_hits++;
+		_hitNanos += nanoseconds;
+		rbxAtomicMax(_hitMaxNanos, nanoseconds);
+		if (isCompute) { _computeHits++; _computeHitNanos += nanoseconds; }
+	} else {
+		_misses++;
+		_missNanos += nanoseconds;
+		rbxAtomicMax(_missMaxNanos, nanoseconds);
+	}
+}
+
+NSError* MVKMetalBinaryArchives::strictMissError() {
+	return [NSError errorWithDomain: @"RewindBox.MetalBinaryArchives" code: 1
+						   userInfo: @{NSLocalizedDescriptionKey: @"not in a loaded Metal binary archive (RBX_MVK_BINARY_ARCHIVE_STRICT)"}];
+}
+
+// Only a loaded archive may serve: Metal returns the pipeline from its binaries or fails at once.
+// Called inside the compiler's block, which holds the device lock and is bounded by the compile timeout.
+id<MTLRenderPipelineState> MVKMetalBinaryArchives::newRenderPipelineState(MTLRenderPipelineDescriptor* plDesc) {
+	if ( !_isLoaded ) { _lookupsBeforeLoad++; return nil; }
+	NSArray<id<MTLBinaryArchive>>* archives = copyLoadedArchives();		// temp retain
+	if ( !archives ) { _lookupsWithoutArchive++; return nil; }
+
+	id<MTLRenderPipelineState> plState = nil;
+	uint64_t startTime = mvkGetTimestamp();
+	@autoreleasepool {
+		NSArray<id<MTLBinaryArchive>>* priorArchives = [plDesc.binaryArchives retain];		// temp retain
+		plDesc.binaryArchives = archives;
+		plState = [_mtlDevice newRenderPipelineStateWithDescriptor: plDesc
+														   options: MTLPipelineOptionFailOnBinaryArchiveMiss
+														reflection: nil
+															 error: nil];	// retained
+		plDesc.binaryArchives = priorArchives;
+		[priorArchives release];															// temp release
+	}
+	noteLookup(plState != nil, false, mvkGetElapsedNanoseconds(startTime));
+	[archives release];																		// temp release
+	return plState;
+}
+
+id<MTLComputePipelineState> MVKMetalBinaryArchives::newComputePipelineState(MTLComputePipelineDescriptor* plDesc) {
+	if ( !_isLoaded ) { _lookupsBeforeLoad++; return nil; }
+	NSArray<id<MTLBinaryArchive>>* archives = copyLoadedArchives();		// temp retain
+	if ( !archives ) { _lookupsWithoutArchive++; return nil; }
+
+	id<MTLComputePipelineState> plState = nil;
+	uint64_t startTime = mvkGetTimestamp();
+	@autoreleasepool {
+		NSArray<id<MTLBinaryArchive>>* priorArchives = [plDesc.binaryArchives retain];		// temp retain
+		plDesc.binaryArchives = archives;
+		plState = [_mtlDevice newComputePipelineStateWithDescriptor: plDesc
+															options: MTLPipelineOptionFailOnBinaryArchiveMiss
+														 reflection: nil
+															  error: nil];	// retained
+		plDesc.binaryArchives = priorArchives;
+		[priorArchives release];															// temp release
+	}
+	noteLookup(plState != nil, true, mvkGetElapsedNanoseconds(startTime));
+	[archives release];																		// temp release
+	return plState;
+}
+
+// Whether a collection may be queued now. Bounded: the queue, the session's additions, and nothing once closing.
+bool MVKMetalBinaryArchives::canCollect() {
+	if ( !_isCollecting || _isClosing ) { return false; }
+	if (_collectQueued.fetch_add(1) >= _maxSessionAdds) { _collectQueued--; _collectCapped++; return false; }
+	if (_pendingAdds.fetch_add(1) >= kRBXArchiveMaxPendingAdds) { _pendingAdds--; _collectQueued--; _collectDroppedQueueFull++; return false; }
+	return true;
+}
+
+void MVKMetalBinaryArchives::collect(MTLRenderPipelineDescriptor* plDesc) {
+	if ( !canCollect() ) { return; }
+	MTLRenderPipelineDescriptor* plDescCopy = [plDesc copy];	// retained, released by the queued block
+	plDescCopy.binaryArchives = nil;
+	bool wasCompiledBeforeLoad = !_isLoaded;
+	dispatch_async(_queue, ^{
+		@autoreleasepool {
+			addOnQueue(plDescCopy, nil, wasCompiledBeforeLoad);
+			[plDescCopy release];
+		}
+	});
+}
+
+void MVKMetalBinaryArchives::collect(MTLComputePipelineDescriptor* plDesc) {
+	if ( !canCollect() ) { return; }
+	MTLComputePipelineDescriptor* plDescCopy = [plDesc copy];	// retained, released by the queued block
+	plDescCopy.binaryArchives = nil;
+	bool wasCompiledBeforeLoad = !_isLoaded;
+	dispatch_async(_queue, ^{
+		@autoreleasepool {
+			addOnQueue(nil, plDescCopy, wasCompiledBeforeLoad);
+			[plDescCopy release];
+		}
+	});
+}
+
+void MVKMetalBinaryArchives::requestSave() {
+	if (_isClosing) { return; }
+	dispatch_async(_queue, ^{ @autoreleasepool { saveOnQueue(); } });
+}
+
+// On the queue. Adds the functions of one pipeline to this session's archive.
+void MVKMetalBinaryArchives::addOnQueue(MTLRenderPipelineDescriptor* renderDesc, MTLComputePipelineDescriptor* computeDesc, bool wasCompiledBeforeLoad) {
+	_pendingAdds--;
+	if (_isClosing) { _collectDroppedAtClose++; return; }
+	if ( !_isCollecting ) { _collectCapped++; return; }
+	if (_minFreeBytes && mvkGetAvailableMemorySize() < _minFreeBytes) { _collectHeldForMemory++; return; }
+
+	// Compiled while the archives were still loading (the load runs first on this queue, so it is done now): it may be
+	// in a loaded archive already. Asked here, off the creating thread, so that nothing is added twice.
+	if (wasCompiledBeforeLoad) {
+		NSArray<id<MTLBinaryArchive>>* archives = copyLoadedArchives();		// temp retain
+		if (archives) {
+			id<NSObject> archivedState = nil;
+			if (renderDesc) {
+				renderDesc.binaryArchives = archives;
+				archivedState = [_mtlDevice newRenderPipelineStateWithDescriptor: renderDesc options: MTLPipelineOptionFailOnBinaryArchiveMiss reflection: nil error: nil];	// temp retain
+				renderDesc.binaryArchives = nil;
+			} else {
+				computeDesc.binaryArchives = archives;
+				archivedState = [_mtlDevice newComputePipelineStateWithDescriptor: computeDesc options: MTLPipelineOptionFailOnBinaryArchiveMiss reflection: nil error: nil];	// temp retain
+				computeDesc.binaryArchives = nil;
+			}
+			[archives release];												// temp release
+			if (archivedState) {
+				[archivedState release];									// temp release
+				_collectAlreadyArchived++;
+				return;
+			}
+		}
+	}
+
+	NSError* err = nil;
+	if ( !_collectingArchive ) {
+		MTLBinaryArchiveDescriptor* archDesc = [MTLBinaryArchiveDescriptor new];	// temp retain
+		_collectingArchive = [_mtlDevice newBinaryArchiveWithDescriptor: archDesc error: &err];	// retained
+		[archDesc release];															// temp release
+		if ( !_collectingArchive ) {
+			_addErrors++;
+			_isCollecting = false;
+			reportMessage(MVK_CONFIG_LOG_LEVEL_WARNING, "RewindBox Metal binary archives: no new archive (%s); nothing is collected this session.",
+						  err.localizedDescription.UTF8String);
+			return;
+		}
+	}
+
+	uint64_t startTime = mvkGetTimestamp();
+	BOOL isAdded = renderDesc
+		? [_collectingArchive addRenderPipelineFunctionsWithDescriptor: renderDesc error: &err]
+		: [_collectingArchive addComputePipelineFunctionsWithDescriptor: computeDesc error: &err];
+	uint64_t nanoseconds = mvkGetElapsedNanoseconds(startTime);
+	_addNanos += nanoseconds;
+	rbxAtomicMax(_addMaxNanos, nanoseconds);
+	if (isAdded) {
+		_collected++;
+		_addsSinceSave++;
+		if (_addsSinceSave >= _saveEveryAdds) { saveOnQueue(); }
+	} else {
+		_addErrors++;
+	}
+}
+
+// On the queue. Writes this session's archive: a temporary file, one rename to a name that carries the size and the
+// checksum, then the removal of the previous generation of this segment. A failure leaves every published file as it was.
+void MVKMetalBinaryArchives::saveOnQueue() {
+	if ( !_collectingArchive || _addsSinceSave == 0 ) { return; }
+
+	uint64_t startTime = mvkGetTimestamp();
+	char name[128];
+	snprintf(name, sizeof(name), "/seg-%06u-%08x.tmp", _segmentNumber, _sessionToken);
+	std::string tmpPath = _directory + name;
+	NSError* err = nil;
+	NSURL* tmpURL = [NSURL fileURLWithPath: @(tmpPath.c_str())];
+	if ( ![_collectingArchive serializeToURL: tmpURL error: &err] ) {
+		_saveErrors++;
+		unlink(tmpPath.c_str());
+		reportMessage(MVK_CONFIG_LOG_LEVEL_WARNING, "RewindBox Metal binary archives: not saved (%s); the files already published stand.",
+					  err.localizedDescription.UTF8String);
+		return;
+	}
+
+	uint64_t fileSize = 0;
+	std::string digest = rbxFileDigest(tmpPath, fileSize);
+	snprintf(name, sizeof(name), "/seg-%06u-%08x-%llu-%s.mtlarchive", _segmentNumber, _sessionToken, (unsigned long long)fileSize, digest.c_str());
+	std::string finalPath = _directory + name;
+	if (digest.empty() || fileSize == 0 || rename(tmpPath.c_str(), finalPath.c_str()) != 0) {
+		_saveErrors++;
+		unlink(tmpPath.c_str());
+		return;
+	}
+	if ( !_segmentPath.empty() && _segmentPath != finalPath ) { unlink(_segmentPath.c_str()); }
+	_segmentPath = finalPath;
+	_addsSinceSave = 0;
+
+	// The file now holds everything this session collected: the archive is reopened from it, so the binaries it held in
+	// memory are released and later additions join the file's content at the next save. If it cannot be reopened, the
+	// published file stays as it is and later additions start another segment.
+	if (_reopensAfterSave && !_isClosing) {
+		MTLBinaryArchiveDescriptor* archDesc = [MTLBinaryArchiveDescriptor new];	// temp retain
+		archDesc.url = [NSURL fileURLWithPath: @(finalPath.c_str())];
+		id<MTLBinaryArchive> reopened = [_mtlDevice newBinaryArchiveWithDescriptor: archDesc error: &err];	// retained
+		[archDesc release];															// temp release
+		[_collectingArchive release];
+		_collectingArchive = reopened;
+		if ( !reopened ) {
+			_reopenErrors++;
+			_segmentNumber++;
+			_segmentPath.clear();
+		}
+	}
+
+	uint64_t nanoseconds = mvkGetElapsedNanoseconds(startTime);
+	_saves++;
+	_saveNanos += nanoseconds;
+	rbxAtomicMax(_saveMaxNanos, nanoseconds);
+	_savedBytes = fileSize;
+	if (fileSize >= _maxSessionBytes) { _isCollecting = false; }	// This session's segment is full.
+	writeReport();
+}
