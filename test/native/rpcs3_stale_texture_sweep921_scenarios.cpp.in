	// Scenarios of test/rpcs3_stale_texture_sweep921_test.py (inserted in namespace drive of the texture cache harness).
	// The tree's real rsx::texture_cache runs a Black Ops II-shaped texture stream. Each frame ends as
	// VKGSRender::flip does: with REWINDBOX_STALE_TEXTURE_SWEEP_921 (HAVE_SWEEP, setting on), the bound set of the
	// texture registers, one call of the tree's release_stale_idle_sections and the descriptor invalidation of
	// VKPresent.cpp; then vk::texture_cache::on_frame_end (the real trim_sections, the purge of 64 unreleased sections,
	// the real base on_frame_end) and the global sampler refresh. Draws look up their slots as VKDraw.cpp does (the real
	// skip condition and upload_sampler_texture) without the per-lookup records of the base driver.
	inline bool g_sweep = false;      // the pass runs at each frame end (candidate tree, setting on)
	inline bool g_invalidate = true;  // VKPresent.cpp invalidates the swept descriptor kinds after a release
	inline u64 g_stale_served = 0, g_served = 0;

	struct sweep_totals
	{
		u64 passes = 0, seen = 0, examined = 0, examined_bytes = 0, released = 0, released_bytes = 0, revolutions = 0;
		u64 max_pass_bytes = 0, max_pass_seen = 0, max_section_bytes = 0;
		u64 released_valid = 0;     // released while its guest bytes still matched its upload (must stay 0)
		u64 released_bound = 0;     // released while its base was bound (must stay 0)
		u64 released_recent = 0;    // released although used in the last idle_frames frames (must stay 0)
		u64 prehash_records = 0;    // texture_prehash::record calls made by the passes (must stay 0)
	};
	inline sweep_totals g_totals;

	u64 section_bytes(host::section& s) { return s.get_confirmed_range().length(); }

	bool section_matches_memory(host::section& s)
	{
		const auto& r = s.get_confirmed_range();
		return s.exists() && s.vram_texture->content == host::hash_bytes(vm::g_sudo_addr + r.start, r.length());
	}

	std::set<u32> bound_addresses()
	{
		std::set<u32> bound;
		for (u32 i = 0; i < 16; ++i)
		{
			rsx::fragment_texture tex(static_cast<u8>(i), W->regs);
			if (tex.enabled()) bound.insert(rsx::get_address(tex.offset(), tex.location()));
		}
		for (u32 i = 0; i < 4; ++i)
		{
			rsx::vertex_texture tex(static_cast<u8>(i), W->regs);
			if (tex.enabled()) bound.insert(rsx::get_address(tex.offset(), tex.location()));
		}
		return bound;
	}

	void stale_pass()
	{
#if HAVE_SWEEP
		const std::set<u32> bound = bound_addresses();
		struct before_t { bool matches; bool bound; u64 last_use; };
		std::map<host::section*, before_t> before;
		W->cache->for_each_section([&](host::section& s)
		{
			if (s.is_locked() && !s.is_dirty() && s.valid_range())
			{
				before[&s] = { section_matches_memory(s), bound.contains(s.get_section_base()), s.last_use_frame };
				g_totals.max_section_bytes = std::max<u64>(g_totals.max_section_bytes, section_bytes(s));
			}
		});
		const u64 records_before = host::prehash_records;
		const u64 now = rpcs3::ios::texture_residency::current_frame();
		const auto r = W->cache->release_stale_idle_sections(bound, [](host::section& s) -> u64
		{
			return s.exists() ? u64{s.get_width()} * s.get_height() * 4 : 0;
		});
		g_totals.prehash_records += host::prehash_records - records_before;
		g_totals.passes++;
		g_totals.seen += r.seen;
		g_totals.examined += r.examined;
		g_totals.examined_bytes += r.examined_bytes;
		g_totals.released += r.released;
		g_totals.released_bytes += r.released_bytes;
		g_totals.revolutions += r.revolutions;
		g_totals.max_pass_bytes = std::max<u64>(g_totals.max_pass_bytes, r.examined_bytes);
		g_totals.max_pass_seen = std::max<u64>(g_totals.max_pass_seen, r.seen);
		u64 released_here = 0;
		for (auto& [s, b] : before)
		{
			if (s->is_locked() && !s->is_dirty() && s->valid_range())
			{
				continue; // kept
			}
			++released_here;
			g_totals.released_valid += b.matches ? 1 : 0;
			g_totals.released_bound += b.bound ? 1 : 0;
			g_totals.released_recent += now - b.last_use < rpcs3::ios::texture_residency::min_idle_frames ? 1 : 0;
		}
		ensure(released_here == r.released);
		if (r.released && g_invalidate)
		{
			// rsx::invalidate_sampler_context(fs/vs_sampler_state, ..., shader_read / blit_engine_src) of VKPresent.cpp
			for (u32 i = 0; i < slot_count; ++i)
			{
				const auto context = W->state[i].upload_context;
				if (context == rsx::texture_upload_context::shader_read || context == rsx::texture_upload_context::blit_engine_src)
				{
					W->slot_dirty[i] = true;
				}
			}
		}
#endif
	}

	void frame_end()
	{
		if (g_sweep)
		{
			stale_pass();
		}
		// vk::texture_cache::on_frame_end: trim, purge at 64 unreleased sections, then the base frame end.
		W->cache->trim_sections();
		if (W->cache->get_unreleased_textures_count() >= 64)
		{
			W->cache->purge_unreleased_sections();
		}
		W->cache->on_frame_end();
		W->samplers_dirty = true; // VKPresent.cpp: m_samplers_dirty.store(true)
	}

	template <typename Tex>
	void quiet_lookup(u32 slot, const Tex& tex, u32 memo_flags)
	{
		auto& d = W->state[slot];
		if (!W->samplers_dirty && !W->slot_dirty[slot] &&
			(!tex.enabled() || !W->cache->sampler_requires_validation(slot, d)) &&
			!W->cache->test_if_descriptor_expired(W->cmd, W->rtts, &d, tex))
		{
			return;
		}
		W->slot_dirty[slot] = false;
		if (!tex.enabled())
		{
			d = {};
			return;
		}
		d = W->cache->upload_sampler_texture(W->cmd, tex, W->rtts, slot, memo_flags);
	}

	// One draw with these fragment slots referenced; what each serves is compared with guest memory now.
	void quiet_draw(std::initializer_list<std::pair<u32, const tex_desc*>> bound)
	{
		u32 mask = 0;
		for (const auto& [slot, t] : bound)
		{
			set_texture(slot, false, *t);
			mask |= 1u << slot;
		}
		if (W->samplers_dirty && memo::consolidated())
		{
			memo::sampler_refresh();
		}
		for (u32 ref = mask; ref; ref &= ref - 1)
		{
			const u32 i = std::countr_zero(ref);
			rsx::fragment_texture tex(static_cast<u8>(i), W->regs);
			quiet_lookup(i, tex, memo::fragment_flags(0, i));
		}
		W->samplers_dirty = false;
		W->draw++;
		for (const auto& [slot, t] : bound)
		{
			const auto& d = W->state[slot];
			const auto* img = d.image_handle ? d.image_handle->image() : nullptr;
			const auto& range = d.ios_validation_range;
			ensure(range.valid());
			const u64 expected = host::hash_bytes(vm::g_sudo_addr + range.start, range.length());
			g_served++;
			if (!img || img->destroyed || img->content != expected)
			{
				g_stale_served++;
			}
		}
	}

	struct census
	{
		u64 live = 0, live_bytes = 0, stale_idle = 0;
	};

	census take_census()
	{
		census c;
		const std::set<u32> bound = bound_addresses();
		const u64 now = rpcs3::ios::texture_residency::current_frame();
		W->cache->for_each_section([&](host::section& s)
		{
			if (s.is_locked() && !s.is_dirty() && s.valid_range())
			{
				c.live++;
				c.live_bytes += section_bytes(s);
				if (!section_matches_memory(s) && !bound.contains(s.get_section_base()) &&
					now - s.last_use_frame >= rpcs3::ios::texture_residency::min_idle_frames)
				{
					c.stale_idle++;
				}
			}
		});
		return c;
	}

	void sample(u32 frame, const char* label = "sample")
	{
		const census c = take_census();
		sep();
		append("{\"k\":\"%s\",\"frame\":%u,\"live\":%llu,\"live_bytes\":%llu,\"stale_idle\":%llu,\"memory_in_use\":%llu,\"uploads\":%llu,"
			"\"hashes\":%llu,\"destroyed_images\":%llu,\"released\":%llu,\"examined\":%llu,\"examined_bytes\":%llu,\"passes\":%llu,"
			"\"stale_served\":%llu,\"served\":%llu}",
			label, frame, (unsigned long long)c.live, (unsigned long long)c.live_bytes, (unsigned long long)c.stale_idle,
			(unsigned long long)W->cache->get_texture_memory_in_use(), (unsigned long long)W->cache->cpu_uploads,
			(unsigned long long)host::hashes, (unsigned long long)W->cache->graveyard.size(), (unsigned long long)g_totals.released,
			(unsigned long long)g_totals.examined, (unsigned long long)g_totals.examined_bytes, (unsigned long long)g_totals.passes,
			(unsigned long long)g_stale_served, (unsigned long long)g_served);
	}

	void start(const char* name)
	{
		begin_scenario(name);
		g_totals = {};
		g_stale_served = g_served = 0;
	}

	tex_desc linear(u32 offset, u16 width, u16 height)
	{
		return tex_desc{ .offset = offset, .width = width, .height = height, .pitch = static_cast<u32>(width * 4u) };
	}

	u32 bytes_of(const tex_desc& t) { return t.pitch * t.height; }

	// Black Ops II: a working set sampled every frame, and one texture per frame streamed into a 24 MiB pool of guest
	// memory at a cursor that advances by its size and a 4 KiB gap (32, 48 or 64 KiB), so each lap lands at other offsets
	// over textures no longer used; the last four streamed are sampled, then never again. 24 sections per 1 MiB block on
	// average, under the 256 that let upstream's trim validate a block, as on the device (texture_trim_sections=0).
	void s_stream()
	{
		start("stream");
		constexpr u32 frames = 2400, pool = 0x0400000, pool_size = 24u << 20, gap = 0x1000;
		std::array<tex_desc, 8> work;
		for (u32 i = 0; i < work.size(); ++i)
		{
			work[i] = linear(0x0100000 + i * 0x10000, 128, 128);
			fill(address_of(work[i]), bytes_of(work[i]), 7000 + i);
		}
		std::deque<tex_desc> recent;
		u32 cursor = 0;
		for (u32 frame = 0; frame < frames; ++frame)
		{
			const u16 heights[] = { 64, 96, 128 };
			tex_desc t = linear(pool + cursor, 128, heights[frame % 3]);
			if (cursor + bytes_of(t) > pool_size)
			{
				cursor = (cursor + bytes_of(t) + gap) % (pool_size - 0x20000);
				t = linear(pool + cursor, 128, heights[frame % 3]);
			}
			fill(address_of(t), bytes_of(t), 100000 + frame);
			cursor += bytes_of(t) + gap;
			recent.push_front(t);
			if (recent.size() > 4) recent.pop_back();
			std::vector<std::pair<u32, const tex_desc*>> slots;
			for (u32 i = 0; i < work.size(); ++i) slots.push_back({ i, &work[i] });
			for (u32 i = 0; i < recent.size(); ++i) slots.push_back({ 8 + i, &recent[i] });
			// A frame of three draws: the working set alone, then with the streamed textures, then the working set.
			quiet_draw({ slots[0], slots[1], slots[2], slots[3] });
			switch (slots.size())
			{
			case 12: quiet_draw({ slots[4], slots[5], slots[6], slots[7], slots[8], slots[9], slots[10], slots[11] }); break;
			case 11: quiet_draw({ slots[4], slots[5], slots[6], slots[7], slots[8], slots[9], slots[10] }); break;
			case 10: quiet_draw({ slots[4], slots[5], slots[6], slots[7], slots[8], slots[9] }); break;
			default: quiet_draw({ slots[4], slots[5], slots[6], slots[7], slots[8] }); break;
			}
			// The streamed slots are disabled again (the next frame binds the newest four).
			for (u32 i = 8; i < 12; ++i)
			{
				tex_desc off = t;
				off.enabled = false;
				set_texture(i, false, off);
			}
			frame_end();
			if ((frame + 1) % 200 == 0) sample(frame + 1);
		}
		sample(frames, "end");
		end_scenario();
	}

	// Idle textures whose bytes do not change are kept: none released, no upload when they come back, the same images.
	void s_idle_valid()
	{
		start("idle_valid");
		std::array<tex_desc, 32> idle;
		for (u32 i = 0; i < idle.size(); ++i)
		{
			idle[i] = linear(0x0800000 + i * 0x10000, 128, 128);
			fill(address_of(idle[i]), bytes_of(idle[i]), 300 + i);
		}
		const tex_desc other = linear(0x0100000, 64, 64);
		fill(address_of(other), bytes_of(other), 299);
		for (u32 i = 0; i < idle.size(); i += 8)
		{
			quiet_draw({ {0, &idle[i]}, {1, &idle[i + 1]}, {2, &idle[i + 2]}, {3, &idle[i + 3]}, {4, &idle[i + 4]}, {5, &idle[i + 5]}, {6, &idle[i + 6]}, {7, &idle[i + 7]} });
		}
		std::vector<u64> images;
		for (u32 i = 0; i < 8; ++i) images.push_back(W->state[i].image_handle->image()->id);
		for (u32 i = 0; i < 8; ++i)
		{
			tex_desc off = other;
			off.enabled = false;
			set_texture(i, false, off);
		}
		frame_end();
		for (u32 frame = 0; frame < 400; ++frame)
		{
			quiet_draw({ {12, &other} });
			frame_end();
		}
		sample(400, "before_return");
		const u64 uploads_before = W->cache->cpu_uploads;
		quiet_draw({ {0, &idle[24]}, {1, &idle[25]}, {2, &idle[26]}, {3, &idle[27]}, {4, &idle[28]}, {5, &idle[29]}, {6, &idle[30]}, {7, &idle[31]} });
		u32 same_images = 0;
		for (u32 i = 0; i < 8; ++i) same_images += W->state[i].image_handle->image()->id == images[i] ? 1 : 0;
		sep();
		append("{\"k\":\"return\",\"uploads\":%llu,\"same_images\":%u}", (unsigned long long)(W->cache->cpu_uploads - uploads_before), same_images);
		sample(401, "end");
		end_scenario();
	}

	// A texture whose memory is overwritten, then restored and sampled again: always the current bytes. The pass releases
	// it while its bytes differ; coming back then costs one upload (on the PC the write fault would have released it).
	void s_restored()
	{
		start("restored");
		const tex_desc t = linear(0x0800000, 128, 128), other = linear(0x0100000, 64, 64);
		fill(address_of(t), bytes_of(t), 501);
		fill(address_of(other), bytes_of(other), 502);
		quiet_draw({ {0, &t} });
		tex_desc off = t;
		off.enabled = false;
		set_texture(0, false, off);
		frame_end();
		fill(address_of(t), bytes_of(t), 503); // other data
		for (u32 frame = 0; frame < 200; ++frame)
		{
			quiet_draw({ {1, &other} });
			frame_end();
		}
		sample(200, "overwritten");
		fill(address_of(t), bytes_of(t), 501); // the texture again
		const u64 uploads_before = W->cache->cpu_uploads;
		quiet_draw({ {0, &t} });
		sep();
		append("{\"k\":\"return\",\"uploads\":%llu}", (unsigned long long)(W->cache->cpu_uploads - uploads_before));
		sample(201, "end");
		end_scenario();
	}

	// A texture left bound in the registers is not examined, even idle and changed; its next lookup uploads it again.
	void s_bound()
	{
		start("bound");
		const tex_desc t = linear(0x0800000, 128, 128), other = linear(0x0100000, 64, 64);
		fill(address_of(t), bytes_of(t), 601);
		fill(address_of(other), bytes_of(other), 602);
		quiet_draw({ {2, &t} });
		frame_end();
		fill(address_of(t), bytes_of(t), 603);
		for (u32 frame = 0; frame < 200; ++frame)
		{
			quiet_draw({ {1, &other} });
			frame_end();
		}
		sample(200, "idle_bound");
		const u64 uploads_before = W->cache->cpu_uploads;
		quiet_draw({ {2, &t} });
		sep();
		append("{\"k\":\"return\",\"uploads\":%llu}", (unsigned long long)(W->cache->cpu_uploads - uploads_before));
		sample(201, "end");
		end_scenario();
	}

	// 600 idle sections of 64 KiB whose bytes all changed: each pass hashes at most bytes_per_pass (plus the section that
	// crosses it) and looks at most sections_per_pass; the cursor resumes, so each one is examined once before release.
	void s_budget()
	{
		start("budget");
		constexpr u32 count = 600;
		std::vector<tex_desc> many;
		for (u32 i = 0; i < count; ++i)
		{
			many.push_back(linear(0x0400000 + i * 0x10000, 128, 128));
			fill(address_of(many[i]), bytes_of(many[i]), 700 + i);
		}
		for (u32 i = 0; i < count; i += 8)
		{
			quiet_draw({ {0, &many[i]}, {1, &many[i + 1]}, {2, &many[i + 2]}, {3, &many[i + 3]}, {4, &many[i + 4]}, {5, &many[i + 5]}, {6, &many[i + 6]}, {7, &many[i + 7]} });
		}
		for (u32 i = 0; i < 8; ++i)
		{
			tex_desc off = many[0];
			off.enabled = false;
			set_texture(i, false, off);
		}
		for (u32 i = 0; i < count; ++i) fill(address_of(many[i]), bytes_of(many[i]), 5000 + i);
		const tex_desc other = linear(0x0100000, 64, 64);
		fill(address_of(other), bytes_of(other), 703);
		for (u32 frame = 0; frame < 120; ++frame)
		{
			quiet_draw({ {12, &other} });
			frame_end();
			if (frame >= 60 && frame < 90) sample(frame, "pass");
		}
		sample(120, "end");
		end_scenario();
	}

	// Texture Pre-Validation on (God of War III's setting): the passes neither read nor feed the prehash tables.
	void s_prehash()
	{
		start("prehash");
		rpcs3::ios::texture_prehash::enabled.store(true);
		std::array<tex_desc, 8> big;
		for (u32 i = 0; i < big.size(); ++i)
		{
			big[i] = linear(0x0800000 + i * 0x40000, 256, 256); // 256 KiB: over the prehash minimum
			fill(address_of(big[i]), bytes_of(big[i]), 800 + i);
		}
		quiet_draw({ {0, &big[0]}, {1, &big[1]}, {2, &big[2]}, {3, &big[3]}, {4, &big[4]}, {5, &big[5]}, {6, &big[6]}, {7, &big[7]} });
		for (u32 i = 0; i < 8; ++i)
		{
			tex_desc off = big[0];
			off.enabled = false;
			set_texture(i, false, off);
		}
		for (u32 i = 0; i < 4; ++i) fill(address_of(big[i]), bytes_of(big[i]), 900 + i);
		const tex_desc other = linear(0x0100000, 64, 64);
		fill(address_of(other), bytes_of(other), 803);
		for (u32 frame = 0; frame < 150; ++frame)
		{
			quiet_draw({ {12, &other} });
			frame_end();
		}
		sample(150, "end");
		rpcs3::ios::texture_prehash::enabled.store(false);
		end_scenario();
	}

	void s_totals(const char* name)
	{
		sep();
		append("{\"k\":\"totals\",\"scenario\":\"%s\",\"passes\":%llu,\"seen\":%llu,\"examined\":%llu,\"examined_bytes\":%llu,\"released\":%llu,"
			"\"released_bytes\":%llu,\"revolutions\":%llu,\"max_pass_bytes\":%llu,\"max_pass_seen\":%llu,\"max_section_bytes\":%llu,"
			"\"released_valid\":%llu,\"released_bound\":%llu,\"released_recent\":%llu,\"prehash_records\":%llu}",
			name, (unsigned long long)g_totals.passes, (unsigned long long)g_totals.seen, (unsigned long long)g_totals.examined,
			(unsigned long long)g_totals.examined_bytes, (unsigned long long)g_totals.released, (unsigned long long)g_totals.released_bytes,
			(unsigned long long)g_totals.revolutions, (unsigned long long)g_totals.max_pass_bytes, (unsigned long long)g_totals.max_pass_seen,
			(unsigned long long)g_totals.max_section_bytes, (unsigned long long)g_totals.released_valid,
			(unsigned long long)g_totals.released_bound, (unsigned long long)g_totals.released_recent,
			(unsigned long long)g_totals.prehash_records);
	}

	void run_all()
	{
		using scenario_fn = void (*)();
		const std::pair<const char*, scenario_fn> list[] = {
			{ "stream", s_stream }, { "idle_valid", s_idle_valid }, { "restored", s_restored }, { "bound", s_bound },
			{ "budget", s_budget }, { "prehash", s_prehash } };
		for (const auto& [name, fn] : list)
		{
			fn();
			// The totals of the scenario are appended to its record list (end_scenario closed it).
			g_json.pop_back();
			W = new world();
			W->out.clear();
			W->first_record = false;
			s_totals(name);
			g_json += W->out;
			g_json += "]";
			delete W;
			W = nullptr;
		}
	}
}

int main(int argc, char** argv)
{
	namespace memo = rpcs3::ios::texture_lookup_memo;
	drive::g_mode = argc > 1 ? argv[1] : "control";
	drive::g_sweep = drive::g_mode == "sweep" || drive::g_mode == "sweep_no_invalidation";
	drive::g_invalidate = drive::g_mode != "sweep_no_invalidation";
	rpcs3::ios::texture_validation::epoch_enabled.store(true);
	// Black Ops II runs the lookup memo in verify_all mode (TEXMEMO660 mode=2 on build 721).
	memo::configure(argc > 2 && std::string_view(argv[2]) == "active" ? memo::mode::active
		: argc > 2 && std::string_view(argv[2]) == "off" ? memo::mode::off : memo::mode::verify_all);
	drive::run_all();
	std::printf("{\"mode\":\"%s\",\"have_sweep\":%d,\"scenarios\":{%s},\"log_errors\":%llu}\n", drive::g_mode.c_str(), HAVE_SWEEP,
		drive::g_json.c_str(), static_cast<unsigned long long>(host_log::errors));
	return 0;
}
