namespace rsx
{
	enum : u32 { result_none = 0, result_error = 1, result_zcull_intr = 2 };
	enum : u32 { pipe_flush_interrupt = 0x0008 };
	namespace FIFO { enum class interrupt_hint { conditional_render_eval = 1, zcull_sync = 2 }; }
	inline void mm_flush() {}
	inline void mm_flush_partial(u64) {}
	inline u64 g_shared_tag = 0;
	inline u64 get_shared_tag() { return ++g_shared_tag; }
	template <bool> struct reservation_lock { reservation_lock(u32, u32) {} };

	class thread
	{
	public:
		atomic_t<s32> async_tasks_pending{0};
		u64 int_flip_index = 0;
		u32 label_addr = 0x40300000u;
		std::atomic<u32> m_eng_interrupt_mask{0};
		reports::conditional_render_eval cond_render_ctrl;
		reports::ZCULL_control* zcull_ctrl = nullptr;
		struct { u32 scale_percent = 100; } resolution_scaling_config;
		bool m_guest_waiting = false;
		virtual ~thread() = default;
		u64 timestamp() const { return get_system_time() * 1000; }
		virtual void sync_hint(FIFO::interrupt_hint hint, reports::sync_hint_payload_t payload);
		virtual void end_conditional_rendering() { cond_render_ctrl.hw_cond_active = false; }
		virtual void on_guest_wait() {}
		// The guest's wait loop (od::wait_for, the slot pause) asks whether the renderer stops: in this
		// single-threaded harness the RSX thread runs one iteration there.
		bool is_stopped() { if (m_guest_waiting) on_guest_wait(); return false; }
	};
	inline thread* g_renderer = nullptr;
	inline thread* get_current_renderer() { return g_renderer; }
	struct eng_lock { explicit eng_lock(thread*) {} };

	// ---------------- rsx::thread::sync_hint (RSXThread.cpp) ----------------
@@THREAD_SYNC_HINT@@
}

// ---------------- RSXZCULL.cpp of the tree under test (from "namespace rsx") ----------------
@@ZCULL_CPP@@
// ---------------- end of RSXZCULL.cpp ----------------

// ---------------- Vulkan side ----------------
struct gpu_model;
namespace vk
{
	struct command_buffer
	{
		enum command_buffer_data_flag : u32
		{
			cb_has_occlusion_task = 0x01,
			cb_has_blit_transfer = 0x02,
			cb_has_dma_transfer = 0x04,
			cb_has_open_query = 0x08,
			cb_load_occluson_task = 0x10,
			cb_has_conditional_render = 0x20,
			cb_reload_dynamic_state = 0x40,
		};
		u32 flags = 0;
		int open_target = 0; // model: the target of the open render pass, 0 when none
	};

	struct command_buffer_chunk : command_buffer
	{
		u64 reset_id = 0;
		int id = 0;
		bool pending = false;  // submitted, its fence not seen signalled yet
		bool submitted = false;
		u64 done_at = 0;       // GPU completion of the last submission (virtual us)
		u32 draws = 0;
		s64 first_seq = -1, last_seq = -1;
		bool split_first = false;
		std::vector<u32> host_queries;
		void flush() {} // the offloader thread hands a submission to the queue at once here
		bool poke() { if (pending && g_now_us >= done_at) pending = false; return !pending; }
	};

	inline bool g_uninterruptible = false;
	inline bool is_uninterruptible() { return g_uninterruptible; }
	inline bool use_strict_query_scopes() { return false; }
	inline bool is_renderpass_open(const command_buffer& cmd) { return cmd.open_target != 0; }
	void end_renderpass(const command_buffer& cmd);

	// ---------------- vk::occlusion_data (VKGSRenderTypes.hpp) ----------------
@@OCCLUSION_DATA@@

	struct flush_request_task
	{
		bool pending_state = false;
		int num_waiters = 0;
		void post(bool) { pending_state = true; num_waiters++; }
		void remove_one() { num_waiters--; }
		void clear_pending_flag() { pending_state = false; }
		bool pending() const { return pending_state; }
	};

	struct AsyncTaskScheduler
	{
		bool host = true;
		bool is_host_mode() const { return host; }
	};

	// Host occlusion queries: a result is available when the command buffer that ran the query has
	// completed (MoltenVK: MVKCommandBuffer completion -> MVKQueryPool), get_query_result waits.
	class query_pool_manager
	{
		struct slot
		{
			bool active = false, submitted = false;
			u64 value = 0, done_at = 0;
		};
		std::vector<slot> m_slots;
		std::vector<u32> m_free;
	public:
		u64 allocations = 0, overflows = 0, waits = 0, wait_us = 0, unsubmitted_waits = 0;
		usz in_use = 0, peak = 0;
		explicit query_pool_manager(u32 count) : m_slots(count)
		{
			for (u32 i = count; i-- > 0;) m_free.push_back(i);
		}
		u32 allocate_query(command_buffer&)
		{
			if (m_free.empty()) { overflows++; return ~0u; }
			const u32 index = m_free.back();
			m_free.pop_back();
			m_slots[index] = {};
			m_slots[index].active = true;
			allocations++;
			peak = std::max(peak, ++in_use);
			return index;
		}
		void begin_query(command_buffer& cmd, u32 index)
		{
			HCHECK(m_slots[index].active);
			static_cast<command_buffer_chunk&>(cmd).host_queries.push_back(index);
		}
		void end_query(command_buffer&, u32 index) { HCHECK(m_slots[index].active); }
		void add_samples(u32 index, u32 samples) { m_slots[index].value += samples; }
		void on_submit(const command_buffer_chunk& cb)
		{
			for (const u32 index : cb.host_queries)
			{
				m_slots[index].submitted = true;
				m_slots[index].done_at = cb.done_at;
			}
		}
		bool check_query_status(u32 index) const
		{
			return m_slots[index].submitted && g_now_us >= m_slots[index].done_at;
		}
		u32 get_query_result(u32 index)
		{
			auto& s = m_slots[index];
			if (!s.submitted)
			{
				// vkGetQueryPoolResults(WAIT) on a query whose command buffer was never submitted: a hang.
				unsubmitted_waits++;
				harness_fail("a query result waited for while its command buffer was never submitted", "query_pool_manager", 0);
			}
			if (g_now_us < s.done_at)
			{
				waits++;
				wait_us += s.done_at - g_now_us;
				g_now_us = s.done_at;
			}
			return static_cast<u32>(s.value);
		}
		template <typename T> void free_queries(command_buffer&, T& list)
		{
			for (const u32 index : list)
			{
				HCHECK(m_slots[index].active);
				m_slots[index].active = false;
				m_free.push_back(index);
				in_use--;
			}
		}
	};
}

struct fxo_t
{
	vk::AsyncTaskScheduler* scheduler = nullptr;
	template <typename T> T* try_get() { return scheduler; }
};
inline fxo_t g_fxo_instance;
inline fxo_t* const g_fxo = &g_fxo_instance;
inline vk::AsyncTaskScheduler g_scheduler;

// ---------------- the renderer model ----------------
enum event_kind : int
{
	ev_begin = 1, ev_end_between, ev_end_textures, ev_end_target, ev_end_submit, ev_submit, ev_draw, ev_report, ev_read, ev_flip,
};
enum submit_cause : int
{
	cause_other = 0, cause_take_start, cause_take_textures, cause_draw_end, cause_fifo, cause_guest, cause_flip, cause_draw_query, cause_report,
	cause_count
};
static const char* const cause_names[cause_count] = {"other", "take_start", "take_textures", "draw_end", "fifo", "guest", "flip", "draw_query", "report"};

struct timing_t
{
	u64 record_us = 6, gpu_draw_us = 20, handoff_us = 1500, cb_fixed_us = 40, split_us = 250, service_step_us = 100;
};

class VKGSRender final : public rsx::thread, public rsx::reports::ZCULL_control
{
public:
	enum flush_queue_state : u32 { ok = 0, flushing = 1, deadlock = 2 };
	struct queue_status_t
	{
		u32 bits = 0;
		bool operator&(flush_queue_state state) const { return (bits & state) != 0; }
		bool test_and_set(flush_queue_state state) { const bool was = (bits & state) != 0; bits |= state; return was; }
		void clear(flush_queue_state state) { bits &= ~static_cast<u32>(state); }
	} m_queue_status;

	std::unique_ptr<vk::query_pool_manager> m_occlusion_query_manager;
	bool m_occlusion_query_active = false;
	rsx::reports::occlusion_query_info* m_active_query_info = nullptr;
	std::vector<vk::occlusion_data> m_occlusion_map;
	shared_mutex m_flush_queue_mutex;
	vk::flush_request_task m_flush_requests;
	ullong m_last_cond_render_eval_hint = 0;
	vk::command_buffer_chunk* m_current_command_buffer = nullptr;
	// CELL561_EARLY_SUBMIT, REWINDBOX_EARLY_SUBMIT_BOUNDARY_659 (and 660) state, as VKGSRender.h declares it.
	u32 m_ios_draws_since_submit = 0;
	u32 m_ios_early_submits_this_frame = 0;
	vk::command_buffer_chunk* m_ios_last_primary_submit = nullptr;
	u32 m_ios_early_armed_draws = 0;
#if CANDIDATE
	bool m_ios_early_armed_watched = false;
	rpcs3::ios::zcull_watched::frame_budget m_ios_watched_budget;
	u64 m_ios_cb_serial = 1;
#endif

	// Model state.
	std::vector<std::unique_ptr<vk::command_buffer_chunk>> m_chunks;
	u32 m_chunk_index = 0;
	timing_t t;
	u64 m_gpu_free_us = 0, gpu_busy_us = 0, gpu_idle_us = 0;
	std::vector<u64> m_completions;
	int m_cause = cause_other;
	u64 submits_by_cause[cause_count]{};
	u64 split_by_cause[cause_count]{};
	u64 chunks_submitted = 0, passes = 0, restarts_same_target = 0, restarts_after_submit = 0, draws = 0, seq = 0;
	int last_ended_target = 0, last_end_kind = 0;
	u64 log_digest = 1469598103934665603ull;
	u64 service_iterations = 0;
	u64 take_splits = 0;
	std::vector<s64> submitted_order_first, submitted_order_last;

	void log_event(int kind, s64 a, s64 b)
	{
		const u64 words[3] = {static_cast<u64>(kind), static_cast<u64>(a), static_cast<u64>(b)};
		for (const u64 w : words)
		{
			for (int i = 0; i < 8; i++)
			{
				log_digest ^= (w >> (8 * i)) & 0xff;
				log_digest *= 1099511628211ull;
			}
		}
	}

	struct cause_scope
	{
		VKGSRender& r;
		int previous;
		cause_scope(VKGSRender& renderer, int cause) : r(renderer), previous(renderer.m_cause) { r.m_cause = cause; }
		~cause_scope() { r.m_cause = previous; }
	};

	VKGSRender()
	{
		zcull_ctrl = this;
		rsx::g_renderer = this;
		m_occlusion_query_manager = std::make_unique<vk::query_pool_manager>(32768u);
		// VKGSRender::VKGSRender (checked by the driver):
		m_occlusion_map.resize(rsx::reports::occlusion_query_count);
		for (u32 n = 0; n < rsx::reports::occlusion_query_count; ++n)
		{
			m_occlusion_query_data[n].driver_handle = n;
		}
		for (int i = 0; i < 512; i++)
		{
			m_chunks.push_back(std::make_unique<vk::command_buffer_chunk>());
			m_chunks.back()->id = i;
		}
		m_current_command_buffer = m_chunks[0].get();
	}

	// ---- the real functions of VKGSRender.cpp ----
	void sync_hint(rsx::FIFO::interrupt_hint hint, rsx::reports::sync_hint_payload_t payload) override;
	void begin_occlusion_query(rsx::reports::occlusion_query_info* query) override;
	void end_occlusion_query(rsx::reports::occlusion_query_info* query) override;
	bool check_occlusion_query_status(rsx::reports::occlusion_query_info* query) override;
	void get_occlusion_query_result(rsx::reports::occlusion_query_info* query) override;
	void discard_occlusion_query(rsx::reports::occlusion_query_info* query) override;
	void emergency_query_cleanup(vk::command_buffer* commands);
	void ios_early_submit();
	void ios_early_submit_at_boundary(bool after_textures);
	void ios_take_early_submit();
#if CANDIDATE
	u64 ios_open_cb_serial(rsx::reports::occlusion_query_info* query) override;
	rpcs3::ios::zcull_watched::arm_result ios_arm_watched_submit(rsx::reports::occlusion_query_info* query) override;
#endif

	// ---- model of the rest of the renderer ----
	void end_pass(int kind)
	{
		auto* cb = m_current_command_buffer;
		HCHECK(cb->open_target);
		log_event(kind, cb->open_target, cb->id);
		last_ended_target = cb->open_target;
		last_end_kind = kind;
		cb->open_target = 0;
	}

	vk::command_buffer_chunk* next_chunk()
	{
		m_chunk_index = (m_chunk_index + 1) % m_chunks.size();
		auto* cb = m_chunks[m_chunk_index].get();
		// command_buffer_chunk::reset(): a chunk still on the GPU is waited for (cb_reuse).
		if (cb->pending && !cb->poke())
		{
			g_now_us = cb->done_at;
			cb->poke();
		}
		++cb->reset_id;
		cb->flags = 0;
		cb->open_target = 0;
		cb->draws = 0;
		cb->first_seq = cb->last_seq = -1;
		cb->split_first = false;
		cb->submitted = false;
		cb->host_queries.clear();
		return cb;
	}

	void gpu_submit(vk::command_buffer_chunk* cb)
	{
		const u64 ready = get_system_time() + t.handoff_us;
		const u64 start = std::max(ready, m_gpu_free_us);
		if (start > m_gpu_free_us && m_gpu_free_us) gpu_idle_us += start - m_gpu_free_us;
		const u64 duration = t.cb_fixed_us + u64{cb->draws} * t.gpu_draw_us + (cb->split_first ? t.split_us : 0);
		cb->done_at = start + duration;
		cb->pending = true;
		cb->submitted = true;
		m_gpu_free_us = cb->done_at;
		gpu_busy_us += duration;
		m_completions.push_back(cb->done_at);
		m_occlusion_query_manager->on_submit(*cb);
		if (cb->draws)
		{
			submitted_order_first.push_back(cb->first_seq);
			submitted_order_last.push_back(cb->last_seq);
		}
	}

	// close_and_submit_command_buffer(): the pass end, the real end of the open host query, the
	// submission (command_buffer::submit clears the flags), the real iOS tracking block.
	void close_and_submit_command_buffer()
	{
		HCHECK(!m_queue_status.test_and_set(flush_queue_state::flushing));
		auto* cb = m_current_command_buffer;
		const bool pass_was_open = vk::is_renderpass_open(*cb);
		if (pass_was_open)
		{
			end_pass(ev_end_submit);
			split_by_cause[m_cause]++;
			if (m_cause == cause_take_start || m_cause == cause_take_textures) take_splits++;
		}
		// ---- close_and_submit_command_buffer: end open queries (VKGSRender.cpp) ----
@@END_OPEN_QUERIES@@
		HCHECK((m_current_command_buffer->flags & vk::command_buffer::cb_has_open_query) == 0);
		m_current_command_buffer->flags = 0;
		gpu_submit(cb);
		submits_by_cause[m_cause]++;
		chunks_submitted++;
		log_event(ev_submit, cb->id, cb->draws);
		// ---- close_and_submit_command_buffer: the iOS tracking block (VKGSRender.cpp) ----
@@TRACKING@@
		m_queue_status.clear(flush_queue_state::flushing);
	}

	void flush_command_queue(bool hard_sync = false, bool do_not_switch = false)
	{
		HCHECK(!hard_sync && !do_not_switch);
		close_and_submit_command_buffer();
		m_current_command_buffer = next_chunk();
		// ---- flush_command_queue: the active query continues in the next command buffer ----
@@LOAD_TASK@@
	}

	// queue_swap_request(): the flip submission, the per-frame budget of 561, the next buffer (begun
	// without cb_load_occluson_task, as in VKPresent.cpp).
	void queue_swap_request()
	{
		{
			cause_scope cause(*this, cause_flip);
			close_and_submit_command_buffer();
		}
		m_ios_early_submits_this_frame = 0;
		m_current_command_buffer = next_chunk();
	}

	// rsx::thread::sync() (RSXThread.cpp, checked by the driver).
	void rsx_sync()
	{
		m_eng_interrupt_mask.fetch_and(~u32{rsx::pipe_flush_interrupt});
		rsx::mm_flush();
		if (has_pending())
		{
			ZCULL_control::sync(this);
		}
	}

	// The FIFO loop between commands: the pipe flush interrupt, then ZCULL_control::update.
	void fifo_tick()
	{
		cause_scope cause(*this, cause_fifo);
		if (m_eng_interrupt_mask.load() & rsx::pipe_flush_interrupt)
		{
			rsx_sync();
		}
		ZCULL_control::update(this);
	}

	// One RSX iteration while a guest waits (no FIFO command: the game waits for its report).
	void on_guest_wait() override
	{
		HCHECK(++service_iterations < 20'000'000);
		{
			cause_scope cause(*this, cause_guest);
			if (m_eng_interrupt_mask.load() & rsx::pipe_flush_interrupt)
			{
				rsx_sync();
			}
			ZCULL_control::update(this);
		}
		const auto next = std::upper_bound(m_completions.begin(), m_completions.end(), g_now_us);
		const u64 step = (next != m_completions.end() && *next - g_now_us < t.service_step_us) ? *next - g_now_us : t.service_step_us;
		g_now_us += step;
	}

	void emit_query_block();

	// VKGSRender::end(): the two boundary calls at their real positions, the query block of
	// emit_geometry, the draw, the end-of-draw early submission, rsx::thread::end() -> on_draw().
	void draw(int target, bool ends_between, bool ends_in_textures, u32 samples)
	{
		if (ends_between && vk::is_renderpass_open(*m_current_command_buffer)) end_pass(ev_end_between);
		{
			cause_scope cause(*this, cause_take_start);
			ios_early_submit_at_boundary(false);
		}
		if (ends_in_textures && vk::is_renderpass_open(*m_current_command_buffer)) end_pass(ev_end_textures);
		{
			cause_scope cause(*this, cause_take_textures);
			ios_early_submit_at_boundary(true);
		}
		{
			cause_scope cause(*this, cause_draw_query);
			emit_query_block();
		}
		auto* cb = m_current_command_buffer;
		if (cb->open_target && cb->open_target != target) end_pass(ev_end_target);
		if (!cb->open_target)
		{
			if (last_ended_target == target)
			{
				restarts_same_target++;
				if (last_end_kind == ev_end_submit)
				{
					restarts_after_submit++;
					if (!cb->draws) cb->split_first = true;
				}
			}
			cb->open_target = target;
			passes++;
			log_event(ev_begin, target, cb->id);
		}
		if (cb->first_seq < 0) cb->first_seq = static_cast<s64>(seq);
		cb->last_seq = static_cast<s64>(seq);
		cb->draws++;
		seq++;
		draws++;
		if (cb->flags & vk::command_buffer::cb_has_open_query)
		{
			m_occlusion_query_manager->add_samples(m_occlusion_map[m_active_query_info->driver_handle].indices.back(), samples);
		}
		log_event(ev_draw, target, cb->id);
		g_now_us += t.record_us;
		{
			cause_scope cause(*this, cause_draw_end);
			ios_early_submit();
		}
		on_draw();
		fifo_tick();
	}

	// VKGSRender::end() when load_program() fails (a pipeline still compiling): both boundary calls, then
	// execute_nop_draw() and rsx::thread::end() -> on_draw(): the query counts a draw that recorded nothing.
	void skipped_draw()
	{
		{
			cause_scope cause(*this, cause_take_start);
			ios_early_submit_at_boundary(false);
		}
		{
			cause_scope cause(*this, cause_take_textures);
			ios_early_submit_at_boundary(true);
		}
		on_draw();
		fifo_tick();
	}

	u32 slot_address(u32 slot) const { return label_addr + offset32(&RsxReports::report) + slot * 16; }

	void report(u32 slot, u32 type)
	{
		log_event(ev_report, slot, type);
		{
			cause_scope cause(*this, cause_report);
			read_report(this, slot_address(slot), type);
		}
		g_now_us += 1;
		fifo_tick();
	}

	void zcull_clear()
	{
		ZCULL_control::clear(this, CELL_GCM_ZPASS_PIXEL_CNT);
		fifo_tick();
	}

	// thread::on_frame_end (the ZCULL clear of pending work), handle_emu_flip (int_flip_index), flip.
	void flip()
	{
		log_event(ev_flip, 0, 0);
		if (has_pending())
		{
			ZCULL_control::clear(this, CELL_GCM_ZPASS_PIXEL_CNT | CELL_GCM_ZCULL_STATS);
		}
		int_flip_index++;
		queue_swap_request();
		fifo_tick();
	}

	struct read_result { u32 value; u64 waited_us; unsigned faults; bool emulated; };

	// A PPU thread reads the value word of a report slot: the MMU faults on a protected page, the
	// real ZCULL_control::on_access_violation handles it (the handler may complete the access
	// itself, or unlock the page), then the instruction reads guest memory.
	read_result guest_read(u32 slot)
	{
		const u32 address = slot_address(slot) + 8;
		cpu_mock cpu{thread_class::ppu};
		t_cpu = &cpu;
		const u64 started = get_system_time();
		read_result result{};
		while (utils::is_protected(address))
		{
			HCHECK(++result.faults < 100000);
			auto& access = rpcs3::ios::guest_access::t_access;
			access = {};
			access.size = 4;
			m_guest_waiting = true;
			const bool handled = static_cast<rsx::reports::ZCULL_control*>(this)->on_access_violation(address);
			m_guest_waiting = false;
			HCHECK(handled);
			if (access.emulate)
			{
				result.emulated = true;
				break;
			}
		}
		t_cpu = nullptr;
		result.value = vm::get_super_ptr<CellGcmReportData>(slot_address(slot))->value;
		result.waited_us = get_system_time() - started;
		log_event(ev_read, slot, result.value);
		return result;
	}

	bool pages_accessed() const { return m_pages_accessed[0] || m_pages_accessed[1]; }
	bool demand_tripped() const { return m_ios_demand.tripped(); }
	bool still_armed() const { return m_ios_early_armed_draws != 0; }
#if CANDIDATE
	bool still_armed_watched() const { return m_ios_early_armed_watched; }
	u32 watched_slots() const { return m_ios_watched.size(); }
#endif
	usz pending_writes() const { return m_pending_writes.size(); }
};

void vk::end_renderpass(const command_buffer& cmd)
{
	auto& renderer = static_cast<VKGSRender&>(*rsx::g_renderer);
	HCHECK(&cmd == renderer.m_current_command_buffer);
	renderer.end_pass(ev_end_between);
}

// ---------------- VKGSRender.cpp of the tree under test (the functions above) ----------------
@@VK_FUNCTIONS@@

// ---------------- VKDraw.cpp emit_geometry: the occlusion query block ----------------
void VKGSRender::emit_query_block()
{
@@DRAW_QUERY_BLOCK@@
}

// ---------------- scenarios ----------------
struct lcg
{
	u32 state;
	explicit lcg(u32 seed) : state(seed) {}
	u32 operator()(u32 n) { state = state * 1664525u + 1013904223u; return (state >> 8) % n; }
};

// The oracle: the value every report write must carry, from the command stream alone. A ZPASS
// report counts the samples of the draws since the last clear (ZCULL_control::clear); the
// non-precise mode writes 0xFFFF for any sample (ZCULL_control::write); STATS reports read 0
// with statistics off.
struct oracle_t
{
	bool precise = false;
	u64 samples = 0;
	std::vector<std::pair<u32, u32>> expected_writes; // (address, value) in report order
	std::unordered_map<u32, u32> slot_value;          // slot -> value of its last report
	void clear() { samples = 0; }
	void draw(u32 s) { samples += s; }
	void report(u32 address, u32 slot, u32 type)
	{
		u32 value = 0;
		if (type == CELL_GCM_ZPASS_PIXEL_CNT)
		{
			value = samples ? (precise ? static_cast<u32>(std::max<u64>(1, samples)) : 0xFFFFu) : 0u;
		}
		expected_writes.push_back({address, value});
		slot_value[slot] = value;
	}
	u32 read(u32 slot) const { const auto f = slot_value.find(slot); return f == slot_value.end() ? 0u : f->second; }
};

struct run_state
{
	VKGSRender& r;
	oracle_t oracle;
	u64 read_count = 0, read_mismatches = 0, read_wait_us = 0, read_wait_max_us = 0, read_faults = 0, reads_emulated = 0;
	u64 reads_digest = 1469598103934665603ull;
	u64 max_early_in_frame = 0, max_watched_submits_in_frame = 0, max_561_in_frame = 0;
	u64 frames = 0, frame_us_total = 0, frame_start_us = 0;
	u64 early_at_frame_start = 0, watched_at_frame_start = 0;
	std::vector<u64> watched_fallback_after;
	s64 watched_armed_at_seq = -1;
	u64 depth_flushes_at_check = 0;

	explicit run_state(VKGSRender& renderer) : r(renderer) {}

	static u64 watched_armed_now()
	{
#if CANDIDATE
		return rpcs3::ios::zcull_watched::counters().armed.load();
#else
		return 0;
#endif
	}

	static u64 watched_fallback_now()
	{
#if CANDIDATE
		return rpcs3::ios::zcull_watched::counters().fallback.load();
#else
		return 0;
#endif
	}

	static u64 watched_submits_now()
	{
#if CANDIDATE
		auto& zw = rpcs3::ios::zcull_watched::counters();
		return zw.taken_start.load() + zw.taken_textures.load() + zw.fallback.load();
#else
		return 0;
#endif
	}

	void track_watched(u64 armed_before, u64 fallback_before)
	{
		if (watched_armed_now() != armed_before) watched_armed_at_seq = static_cast<s64>(r.seq);
		if (watched_fallback_now() != fallback_before && watched_armed_at_seq >= 0)
		{
			watched_fallback_after.push_back(r.seq - static_cast<u64>(watched_armed_at_seq));
			watched_armed_at_seq = -1;
		}
	}

	void draw(int target, bool ends_between, bool ends_in_textures, u32 samples)
	{
		const u64 armed = watched_armed_now(), fallback = watched_fallback_now();
		oracle.draw(samples);
		r.draw(target, ends_between, ends_in_textures, samples);
		track_watched(armed, fallback);
	}

	void report(u32 slot, u32 type = CELL_GCM_ZPASS_PIXEL_CNT)
	{
		const u64 armed = watched_armed_now(), fallback = watched_fallback_now();
		oracle.report(r.slot_address(slot), slot, type);
		r.report(slot, type);
		track_watched(armed, fallback);
	}

	void clear() { oracle.clear(); r.zcull_clear(); }

	void read(u32 slot)
	{
		const u32 expected = oracle.read(slot);
		const auto got = r.guest_read(slot);
		read_count++;
		read_faults += got.faults;
		reads_emulated += got.emulated ? 1 : 0;
		read_wait_us += got.waited_us;
		read_wait_max_us = std::max(read_wait_max_us, got.waited_us);
		if (got.value != expected) read_mismatches++;
		for (const u64 w : {static_cast<u64>(slot), static_cast<u64>(got.value)})
		{
			for (int i = 0; i < 8; i++) { reads_digest ^= (w >> (8 * i)) & 0xff; reads_digest *= 1099511628211ull; }
		}
	}

	void frame_begin()
	{
		frame_start_us = get_system_time();
		early_at_frame_start = rpcs3::ios::early_submit::submits.load();
		watched_at_frame_start = watched_submits_now();
	}

	void flip()
	{
		max_early_in_frame = std::max<u64>(max_early_in_frame, rpcs3::ios::early_submit::submits.load() - early_at_frame_start);
		max_561_in_frame = std::max<u64>(max_561_in_frame, r.m_ios_early_submits_this_frame);
		max_watched_submits_in_frame = std::max<u64>(max_watched_submits_in_frame, watched_submits_now() - watched_at_frame_start);
		r.flip();
		frames++;
		frame_us_total += get_system_time() - frame_start_us;
	}
};

static void start_zcull(run_state& s)
{
	auto& r = s.r;
	r.set_enabled(&r, true);
	r.set_status(&r, true, true, false);
	s.clear();
}

// Assassin's Creed-like frames (IPA 657 shapes): about 44 passes and 1,500 draws, an occlusion test
// (clear, 1-3 test draws, report) about every 50 draws into a rotation of slots on the label page, one
// "watched" slot the game reads back about 300 draws after its report, a read of a slot already final
// on a page other reports hold (the handler completes it), and reads at the start of the next frame.
static void scenario_ac(run_state& s, int frames)
{
	lcg rnd(12345u);
	start_zcull(s);
	int report_index = 0;
	for (int f = 0; f < frames; f++)
	{
		s.frame_begin();
		s.clear();
		int target = 1, drawn = 0;
		int pending_watched_read = -1;
		const int watched_report_at = 400 + static_cast<int>(rnd(300));
		bool watched_written = false;
		for (int p = 0; p < 44; p++)
		{
			const int length = (p % 11 == 0) ? 120 + static_cast<int>(rnd(80)) : 10 + static_cast<int>(rnd(40));
			const u32 how = rnd(10);
			if (rnd(3) != 0) target = 1 + static_cast<int>(rnd(6));
			for (int d = 0; d < length; d++)
			{
				s.draw(target, d == 0 && how >= 5 && how < 8, d == 0 && how < 5, rnd(3) == 0 ? 0u : rnd(100));
				drawn++;
				if (drawn % 50 == 0)
				{
					// an occlusion test inside the pass
					s.clear();
					const int tests = 1 + static_cast<int>(rnd(3));
					const bool visible = rnd(2) == 0;
					for (int k = 0; k < tests; k++) s.draw(target, false, false, visible ? 1 + rnd(40) : 0u);
					drawn += tests;
					s.report(static_cast<u32>(report_index++ % 12));
				}
				if (!watched_written && drawn >= watched_report_at)
				{
					s.clear();
					const bool visible = rnd(3) != 0;
					s.draw(target, false, false, visible ? 1 + rnd(20) : 0u);
					drawn++;
					s.report(40);
					watched_written = true;
					pending_watched_read = drawn + 300;
				}
				if (pending_watched_read >= 0 && drawn >= pending_watched_read)
				{
					s.read(40);   // the watched slot, about 300 draws after its report
					s.read(5);    // a rotation slot: final or pending on the same page
					pending_watched_read = -1;
				}
			}
		}
		s.read(static_cast<u32>((report_index + 11) % 12)); // the newest rotation report of the frame
		s.flip();
	}
}

// Black Ops II-like frames: an occlusion test after most draws (about 2,000 reports per frame) into
// a rotation of 256 slots; the open command buffer reaches the queue-depth limit before the flip, so
// upstream submits it at every new report. One read per frame of a recent report.
static void scenario_bo2(run_state& s, int frames)
{
	lcg rnd(777u);
	start_zcull(s);
	u32 report_index = 0;
	for (int f = 0; f < frames; f++)
	{
		s.frame_begin();
		s.clear();
		int target = 1;
		u32 frame_reports = 0;
		for (int p = 0; p < 40; p++)
		{
			const int length = 40 + static_cast<int>(rnd(40));
			if (rnd(3) != 0) target = 1 + static_cast<int>(rnd(5));
			const u32 how = rnd(10);
			for (int d = 0; d < length; d++)
			{
				const bool test = rnd(100) < 85;
				if (test) s.clear();
				s.draw(target, d == 0 && how >= 6, d == 0 && how < 3, rnd(2) == 0 ? 0u : 1 + rnd(30));
				if (test)
				{
					s.report(report_index++ % 256);
					frame_reports++;
				}
				if (frame_reports == 1900)
				{
					s.read((report_index + 255) % 256); // the newest report: its query is in the open command buffer
					frame_reports++;
				}
			}
		}
		s.flip();
	}
}

// REWINDBOX_ZCULL_WATCHED_BO2_919: Black Ops II frames in the shape of the IPA 676 device windows (Core 905,
// PID 25658, session 3, window 12): about 3,700 draws in 7 submissions per frame of which OPT561 makes
// almost 6 early (615 over 104 frames, 72,019 capped checks: the GPU is idle at most draw ends, 32 % busy),
// about 1,300 reports per frame into rotating slots, and a guest that waits for a report slot queued 5 to 15
// ms before its read (ZCULLLEAD659 5.0-15.0 ms mean, 42-113 waits per window). Here one slot (300) takes one
// report at `report_percent` of the frame's draws and is read at `read_percent` of them. With the GPU-idle test
// true at most draw ends (bo2read) the 6 early submissions of the frame are spent before the report; with it
// false (bo2busy) 561 submits less often and the open command buffer holds the report until the read.
// The age of the newest report of a waited slot is not in the device journal (only the oldest one is): this
// stream gives the slot one report per frame, so both are the same.
static void scenario_bo2read(run_state& s, int frames, int report_percent, int read_percent)
{
	lcg rnd(919u);
	start_zcull(s);
	u32 report_index = 0;
	for (int f = 0; f < frames; f++)
	{
		s.frame_begin();
		s.clear();
		int target = 1;
		int drawn = 0;
		const int total = 40 * 60;
		const int watched_report_at = total * report_percent / 100 + static_cast<int>(rnd(60));
		const int watched_read_at = total * read_percent / 100 + static_cast<int>(rnd(60));
		for (int p = 0; p < 40; p++)
		{
			const int length = 45 + static_cast<int>(rnd(30));
			if (rnd(3) != 0) target = 1 + static_cast<int>(rnd(5));
			const u32 how = rnd(10);
			for (int d = 0; d < length; d++)
			{
				const bool test = rnd(100) < 35;
				if (test) s.clear();
				s.draw(target, d == 0 && how >= 6, d == 0 && how < 3, rnd(2) == 0 ? 0u : 1 + rnd(30));
				drawn++;
				if (test) s.report(report_index++ % 256);
				if (drawn == watched_report_at)
				{
					s.clear();
					s.draw(target, false, false, rnd(3) != 0 ? 1 + rnd(20) : 0u);
					drawn++;
					s.report(300);
				}
				if (drawn == watched_read_at)
				{
					s.read(300);
				}
			}
		}
		s.flip();
	}
}

// One long command buffer on the GPU holds the oldest pending query; then `stats` query-less
// STATS reports, then draws and a ZPASS report whose query is in the open command buffer (the
// queue-depth branch hints it upstream), then optionally a guest read of that report.
static void scenario_hard_cap(run_state& s, u32 stats, bool read_after)
{
	start_zcull(s);
	s.frame_begin();
	s.clear();
	for (int d = 0; d < 50; d++) s.draw(1, false, false, d == 3 ? 7u : 0u);
	s.report(1);
	s.flip();
	s.frame_begin();
	s.clear();
	for (u32 i = 0; i < stats; i++) s.report(2 + (i % 100), CELL_GCM_ZCULL_STATS);
	for (int d = 0; d < 20; d++) s.draw(2, false, false, d == 5 ? 3u : 0u);
	s.report(200);
	for (int d = 0; d < 10; d++) s.draw(2, false, false, 0u);
	if (read_after) s.read(200);
	s.clear();
	for (int d = 0; d < 10; d++) s.draw(3, false, false, 1u);
	s.report(201);
	s.flip();
	s.read(201);
}

// A queue at the depth limit, every pending query in the open command buffer, whose newest query only counts
// a skipped draw (no host query: the hint for it cannot submit); the next report's hint must submit, as upstream.
static void scenario_no_host(run_state& s)
{
	start_zcull(s);
	s.frame_begin();
	for (u32 i = 0; i < rsx::reports::max_safe_queue_depth - 1; i++)
	{
		s.clear();
		s.draw(1, false, false, i % 3 == 0 ? 2u : 0u);
		s.report(i % 512);
	}
	s.clear();
	s.r.skipped_draw();
	s.report(600);
	for (u32 i = 0; i < 40; i++)
	{
		s.clear();
		s.draw(1, false, false, 1u);
		s.report(601 + i);
	}
	s.flip();
	s.read(640);
}

// Black Ops II-like frames (Core 660 review) with more in-flight reports than the 2,048 ZCULL query slots before any read.
static void scenario_bo2deep(run_state& s, int frames, u32 read_at, int passes)
{
	lcg rnd(4242u);
	start_zcull(s);
	u32 report_index = 0;
	for (int f = 0; f < frames; f++)
	{
		s.frame_begin();
		s.clear();
		int target = 1;
		u32 frame_reports = 0;
		for (int p = 0; p < passes; p++)
		{
			const int length = 40 + static_cast<int>(rnd(40));
			if (rnd(3) != 0) target = 1 + static_cast<int>(rnd(5));
			const u32 how = rnd(10);
			for (int d = 0; d < length; d++)
			{
				const bool test = rnd(100) < 85;
				if (test) s.clear();
				s.draw(target, d == 0 && how >= 6, d == 0 && how < 3, rnd(2) == 0 ? 0u : 1 + rnd(30));
				if (test)
				{
					s.report(report_index++ % 256);
					frame_reports++;
				}
				if (frame_reports == read_at)
				{
					s.read((report_index + 255) % 256);
					frame_reports++;
				}
			}
		}
		s.flip();
	}
}

static void print_json(run_state& s, const char* scenario, const char* variant)
{
	auto& r = s.r;
	u64 digest = 1469598103934665603ull;
	u64 mismatches = 0;
	bool monotonic = true;
	u64 last_timer = 0;
	long first_mismatch = -1;
	const usz n = std::min(g_report_writes.size(), s.oracle.expected_writes.size());
	for (usz i = 0; i < g_report_writes.size(); i++)
	{
		const auto& w = g_report_writes[i];
		for (const u64 v : {static_cast<u64>(w.address), static_cast<u64>(w.value)})
		{
			for (int k = 0; k < 8; k++) { digest ^= (v >> (8 * k)) & 0xff; digest *= 1099511628211ull; }
		}
		if (w.timer < last_timer) monotonic = false;
		last_timer = w.timer;
		if (i < n && (w.address != s.oracle.expected_writes[i].first || w.value != s.oracle.expected_writes[i].second))
		{
			mismatches++;
			if (first_mismatch < 0) first_mismatch = static_cast<long>(i);
		}
	}
	// Every draw submitted once, in order.
	bool ordered = true;
	s64 expect = 0;
	for (usz i = 0; i < r.submitted_order_first.size(); i++)
	{
		if (r.submitted_order_first[i] != expect) ordered = false;
		expect = r.submitted_order_last[i] + 1;
	}
	const bool all_submitted = static_cast<u64>(expect) == r.draws;
	namespace early = rpcs3::ios::early_submit;
	namespace sync = rpcs3::ios::rsx_sync;
	auto& od = rpcs3::ios::zcull_on_demand::counters();
	std::printf("{\"result\":\"ran\",\"scenario\":\"%s\",\"variant\":\"%s\",\"candidate\":%d,", scenario, variant, CANDIDATE);
	std::printf("\"writes\":%zu,\"expected_writes\":%zu,\"writes_digest\":\"%016llx\",\"oracle_mismatches\":%llu,\"first_mismatch\":%ld,\"timers_monotonic\":%d,",
		g_report_writes.size(), s.oracle.expected_writes.size(), static_cast<ullong>(digest), static_cast<ullong>(mismatches), first_mismatch, monotonic ? 1 : 0);
	std::printf("\"reads\":%llu,\"read_mismatches\":%llu,\"reads_digest\":\"%016llx\",\"read_wait_us\":%llu,\"read_wait_max_us\":%llu,\"read_faults\":%llu,\"reads_emulated\":%llu,",
		static_cast<ullong>(s.read_count), static_cast<ullong>(s.read_mismatches), static_cast<ullong>(s.reads_digest), static_cast<ullong>(s.read_wait_us),
		static_cast<ullong>(s.read_wait_max_us), static_cast<ullong>(s.read_faults), static_cast<ullong>(s.reads_emulated));
	std::printf("\"draws\":%llu,\"ordered\":%d,\"all_submitted\":%d,\"log_digest\":\"%016llx\",\"chunks\":%llu,\"passes\":%llu,\"restarts_same_target\":%llu,\"restarts_after_submit\":%llu,\"take_splits\":%llu,",
		static_cast<ullong>(r.draws), ordered ? 1 : 0, all_submitted ? 1 : 0, static_cast<ullong>(r.log_digest), static_cast<ullong>(r.chunks_submitted),
		static_cast<ullong>(r.passes), static_cast<ullong>(r.restarts_same_target), static_cast<ullong>(r.restarts_after_submit), static_cast<ullong>(r.take_splits));
	std::printf("\"submits_by_cause\":{");
	for (int c = 0; c < cause_count; c++) std::printf("%s\"%s\":%llu", c ? "," : "", cause_names[c], static_cast<ullong>(r.submits_by_cause[c]));
	std::printf("},\"splits_by_cause\":{");
	for (int c = 0; c < cause_count; c++) std::printf("%s\"%s\":%llu", c ? "," : "", cause_names[c], static_cast<ullong>(r.split_by_cause[c]));
	std::printf("},\"hint_site_flushes\":[");
	for (unsigned i = 0; i < sync::hint_site_count; i++) std::printf("%s%llu", i ? "," : "", static_cast<ullong>(sync::zcull_hint_site_flushes[i].load()));
	std::printf("],\"hint_flushes\":%llu,\"result_flushes\":%llu,", static_cast<ullong>(sync::zcull_hint_flushes.load()), static_cast<ullong>(sync::zcull_result_flushes.load()));
	std::printf("\"early\":{\"submits\":%llu,\"armed\":%llu,\"boundary_starts\":%llu,\"boundary_textures\":%llu,\"fallback\":%llu,\"disarmed\":%llu,\"still_armed\":%d,\"gpu_busy\":%llu,\"capped\":%llu},",
		static_cast<ullong>(early::submits.load()), static_cast<ullong>(early::armed.load()), static_cast<ullong>(early::boundary_starts.load()),
		static_cast<ullong>(early::boundary_textures.load()), static_cast<ullong>(early::fallback_submits.load()), static_cast<ullong>(early::disarmed.load()),
		r.still_armed() ? 1 : 0, static_cast<ullong>(early::gpu_busy.load()), static_cast<ullong>(early::frame_capped.load()));
#if CANDIDATE
	auto& zw = rpcs3::ios::zcull_watched::counters();
	std::printf("\"watched\":{\"learned\":%llu,\"refreshed\":%llu,\"expired\":%llu,\"evicted\":%llu,\"short_leads\":%llu,\"table\":%u,\"reports\":%llu,\"early_writes\":%llu,\"armed\":%llu,\"joined\":%llu,"
		"\"submitted\":%llu,\"no_query\":%llu,\"capped\":%llu,\"off\":%llu,\"taken_start\":%llu,\"taken_textures\":%llu,\"fallback\":%llu,\"carried\":%llu,\"still_armed\":%d},",
		static_cast<ullong>(zw.learned.load()), static_cast<ullong>(zw.refreshed.load()), static_cast<ullong>(zw.expired.load()), static_cast<ullong>(zw.evicted.load()),
		static_cast<ullong>(zw.short_leads.load()), r.watched_slots(), static_cast<ullong>(zw.watched_reports.load()), static_cast<ullong>(zw.early_writes.load()),
		static_cast<ullong>(zw.armed.load()), static_cast<ullong>(zw.joined.load()),
		static_cast<ullong>(zw.submitted.load()), static_cast<ullong>(zw.no_query.load()), static_cast<ullong>(zw.capped.load()), static_cast<ullong>(zw.off.load()),
		static_cast<ullong>(zw.taken_start.load()), static_cast<ullong>(zw.taken_textures.load()), static_cast<ullong>(zw.fallback.load()),
		static_cast<ullong>(zw.carried.load()), r.still_armed_watched() ? 1 : 0);
	std::printf("\"depth\":{\"checks\":%llu,\"hints\":%llu,\"skip_submitted\":%llu,\"skip_same_cb\":%llu,\"hard_cap\":%llu,\"unknown\":%llu,\"open_cb_bound\":%llu,\"peak\":%llu},",
		static_cast<ullong>(zw.depth_checks.load()), static_cast<ullong>(zw.depth_hints.load()), static_cast<ullong>(zw.depth_skip_submitted.load()),
		static_cast<ullong>(zw.depth_skip_same_cb.load()), static_cast<ullong>(zw.depth_hard_cap_hints.load()), static_cast<ullong>(zw.depth_unknown.load()),
		static_cast<ullong>(zw.depth_open_cb_bound.load()), static_cast<ullong>(zw.depth_peak.load()));
#endif
	std::printf("\"watched_fallback_after\":[");
	for (usz i = 0; i < s.watched_fallback_after.size(); i++) std::printf("%s%llu", i ? "," : "", static_cast<ullong>(s.watched_fallback_after[i]));
	std::printf("],\"max_early_in_frame\":%llu,\"max_561_in_frame\":%llu,\"max_watched_submits_in_frame\":%llu,\"frames\":%llu,\"frame_us_mean\":%.1f,",
		static_cast<ullong>(s.max_early_in_frame), static_cast<ullong>(s.max_561_in_frame), static_cast<ullong>(s.max_watched_submits_in_frame), static_cast<ullong>(s.frames),
		s.frames ? static_cast<double>(s.frame_us_total) / static_cast<double>(s.frames) : 0.0);
	std::printf("\"pool\":{\"allocations\":%llu,\"peak\":%zu,\"overflows\":%llu,\"waits\":%llu,\"wait_us\":%llu,\"unsubmitted_waits\":%llu},",
		static_cast<ullong>(r.m_occlusion_query_manager->allocations), r.m_occlusion_query_manager->peak, static_cast<ullong>(r.m_occlusion_query_manager->overflows),
		static_cast<ullong>(r.m_occlusion_query_manager->waits), static_cast<ullong>(r.m_occlusion_query_manager->wait_us),
		static_cast<ullong>(r.m_occlusion_query_manager->unsubmitted_waits));
	std::printf("\"demand\":{\"services\":%llu,\"waits\":%llu,\"wait_us\":%llu,\"timeouts\":%llu,\"stale\":%llu,\"faults_report\":%llu,\"tripped\":%u,\"leads\":%llu},",
		static_cast<ullong>(od.services.load()), static_cast<ullong>(od.waits.load()), static_cast<ullong>(od.wait_us.load()), static_cast<ullong>(od.timeouts.load()),
		static_cast<ullong>(od.stale.load()), static_cast<ullong>(od.faults_report.load()), static_cast<unsigned>(od.tripped.load()), static_cast<ullong>(od.leads.load()));
#ifdef ZCULL_COST_920
	// REWINDBOX_ZCULL_COST_920 (test/rpcs3_zcull_cost920_test.py): the age of the newest awaited report and the watched submissions' cost.
	{
		auto& zw920 = rpcs3::ios::zcull_watched::counters();
		std::printf("\"cost920\":{\"lead_us\":%llu,\"newest_leads\":%llu,\"newest_us\":%llu,\"newest_max_us\":%llu,\"newest_over_1ms\":%llu,\"watched_submits\":%llu,\"watched_submit_ticks\":%llu},",
			static_cast<ullong>(od.lead_us.load()), static_cast<ullong>(od.newest_leads.load()), static_cast<ullong>(od.newest_lead_us.load()),
			static_cast<ullong>(od.newest_lead_max_us.load()), static_cast<ullong>(od.newest_leads_over_1ms.load()),
			static_cast<ullong>(zw920.watched_submits.load()), static_cast<ullong>(zw920.watched_submit_ticks.load()));
	}
#endif
	std::printf("\"gpu\":{\"busy_us\":%llu,\"idle_us\":%llu},\"pages_accessed\":%d,\"demand_tripped\":%d,\"pending_writes_left\":%zu,\"service_iterations\":%llu,",
		static_cast<ullong>(r.gpu_busy_us), static_cast<ullong>(r.gpu_idle_us), r.pages_accessed() ? 1 : 0, r.demand_tripped() ? 1 : 0, r.pending_writes(),
		static_cast<ullong>(r.service_iterations));
	std::printf("\"log\":{\"errors\":%u,\"warnings\":%u,\"messages\":{", rsx_log.errors, rsx_log.warnings);
	bool first = true;
	for (const auto& [text, count] : rsx_log.counts)
	{
		std::string clean;
		for (const char c : text) { if (c == '"' || c == '\\') clean += '\''; else if (static_cast<unsigned char>(c) >= 32) clean += c; }
		std::printf("%s\"%s\":%u", first ? "" : ",", clean.c_str(), count);
		first = false;
	}
	std::printf("}}}\n");
}

int main(int argc, char** argv)
{
	if (argc < 3)
	{
		std::printf("usage: harness SCENARIO VARIANT\n");
		return 2;
	}
	const std::string scenario = argv[1], variant = argv[2];
	auto has = [&](const char* flag) { return variant.find(flag) != std::string::npos; };
	// Policy of the two levers (the candidate tree only reads them), 561 and its boundary mode.
	rpcs3::ios::g_policy.zcull_watched_flush = has("watched");
	rpcs3::ios::g_policy.zcull_depth_guard = has("depth");
	rpcs3::ios::early_submit::enabled = !has("no561");
	rpcs3::ios::early_submit::at_pass_boundary = !has("no561");
	rpcs3::ios::g_policy.early_submit_at_pass_boundary = !has("no561");
	g_cfg.video.precise_zpass_count = has("precise");
	g_scheduler.host = !has("device");
	g_fxo_instance.scheduler = &g_scheduler;

	auto renderer = std::make_unique<VKGSRender>();
	run_state s(*renderer);
	s.oracle.precise = g_cfg.video.precise_zpass_count;
	if (scenario == "ac")
	{
		scenario_ac(s, 20);
	}
	else if (scenario == "bo2")
	{
		// GPU-bound: the last submission is still running at every draw end, so 561 never submits early
		// and the open command buffer reaches the queue-depth limit (the IPA 657 storm frames).
		renderer->t.gpu_draw_us = 30;
		renderer->t.record_us = 5;
		scenario_bo2(s, 6);
	}
	else if (scenario == "bo2fast")
	{
		// The GPU drains between submissions: with 561 on, its early submissions keep the queue short.
		renderer->t.gpu_draw_us = 4;
		renderer->t.record_us = 5;
		scenario_bo2(s, 6);
	}
	else if (scenario == "bo2read")
	{
		// The GPU drains between submissions (about a third busy) and the RSX thread records about 30 ms per frame.
		renderer->t.gpu_draw_us = 4;
		renderer->t.record_us = 12;
		scenario_bo2read(s, 24, 75, 95);
	}
	else if (scenario == "bo2busy")
	{
		// The same frames, the GPU-idle test of 561 false at most draw ends (a submission takes 5 ms to start and
		// complete): 561 submits about 4 times per frame, below its cap, and the open command buffer holds the
		// report from its queueing to the guest's read.
		renderer->t.gpu_draw_us = 4;
		renderer->t.record_us = 12;
		renderer->t.handoff_us = 5000;
		scenario_bo2read(s, 24, 55, 85);
	}
	else if (scenario == "bo2deep")
	{
		// More reports in flight than the 2,048 query slots before any read: the slots run out (allocate_new_query).
		renderer->t.gpu_draw_us = 30;
		renderer->t.record_us = 5;
		scenario_bo2deep(s, 6, 2900, 70);
	}
	else if (scenario == "nohost")
	{
		scenario_no_host(s);
	}
	else if (scenario == "cap_below" || scenario == "cap_above" || scenario == "served")
	{
		renderer->t.gpu_draw_us = 2000; // the first command buffer stays on the GPU about 100 ms
		const u32 stats = scenario == "cap_below" ? 7000u : scenario == "cap_above" ? 8400u : 2500u;
		scenario_hard_cap(s, stats, scenario == "served");
	}
	else
	{
		std::printf("unknown scenario\n");
		return 2;
	}
	// Drain: every queued report retires (a final forced pass, as the RSX thread's exit does).
	while (renderer->has_pending())
	{
		renderer->on_guest_wait();
		renderer->rsx_sync();
		renderer->ZCULL_control::update(renderer.get());
		if (renderer->service_iterations > 10'000'000) break;
	}
	print_json(s, scenario.c_str(), variant.c_str());
	return 0;
}
