// Host harness of REWINDBOX_ZCULL_WATCHED_FLUSH_660 and REWINDBOX_ZCULL_DEPTH_GUARD_660.
// The real code of the tree under test is spliced in at the @@...@@ markers by
// zcull_levers660_test.py: the ZCULL_control declaration (RSXZCULL.h) and every definition of
// RSXZCULL.cpp, rsx::thread::sync_hint (RSXThread.cpp), vk::occlusion_data (VKGSRenderTypes.hpp),
// the VKGSRender query, sync-hint and early-submission functions and the iOS tracking block of
// close_and_submit_command_buffer (VKGSRender.cpp), and the query block of emit_geometry (VKDraw.cpp).
// Around them: stubs of the RPCS3 utilities, a renderer model (command buffers, render passes, a
// GPU that runs submitted command buffers in order and publishes occlusion results at command
// buffer completion as MoltenVK does), a guest that reads report slots through the real fault
// path (single-threaded: the RSX thread is served from the guest's wait loop), and an oracle of
// every report value. Virtual clock in microseconds. Nothing here runs Metal or an iPhone.
#define RPCS3_IOS 1
#include <algorithm>
#include <array>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <map>
#include <memory>
#include <mutex>
#include <shared_mutex>
#include <stack>
#include <string>
#include <string_view>
#include <thread>
#include <unordered_map>
#include <unordered_set>
#include <utility>
#include <vector>

using u8 = std::uint8_t;
using u16 = std::uint16_t;
using u32 = std::uint32_t;
using u64 = std::uint64_t;
using s32 = std::int32_t;
using s64 = std::int64_t;
using usz = std::size_t;
using ullong = unsigned long long;
using flags32_t = u32;

[[noreturn]] static void harness_fail(const char* what, const char* where, int line)
{
	std::printf("{\"result\":\"failed\",\"what\":\"%s\",\"where\":\"%s:%d\"}\n", what, where, line);
	std::fflush(stdout);
	std::abort();
}
#define HCHECK(x) do { if (!(x)) harness_fail(#x, __FILE__, __LINE__); } while (0)

template <typename T>
static inline T&& ensure_value(T&& value, const char* what, int line)
{
	if (!value) harness_fail(what, "ensure", line);
	return std::forward<T>(value);
}
#define ensure(...) ensure_value((__VA_ARGS__), #__VA_ARGS__, __LINE__)
#define AUDIT(...) ((void)0)

namespace fmt
{
	[[noreturn]] inline void throw_exception(const char* message) { harness_fail(message, "fmt::throw_exception", 0); }
}

struct umax_t
{
	template <typename T> constexpr operator T() const noexcept { return static_cast<T>(~T{}); }
};
inline constexpr umax_t umax{};
template <typename T> constexpr bool operator==(const T& a, umax_t) noexcept { return a == static_cast<T>(~T{}); }

// Virtual clock (microseconds); the scenarios advance it.
inline u64 g_now_us = 1'000'000;
inline u64 get_system_time() { return g_now_us; }
inline void busy_wait(u64 = 3000) {}

struct log_channel
{
	std::map<std::string, unsigned> counts;
	unsigned errors = 0, warnings = 0, notices = 0;
	template <typename... A> void error(const char* format, A&&...) { errors++; counts[format]++; }
	template <typename... A> void warning(const char* format, A&&...) { warnings++; counts[format]++; }
	template <typename... A> void notice(const char* format, A&&...) { notices++; counts[format]++; }
	template <typename... A> void trace(const char*, A&&...) {}
};
inline log_channel rsx_log;

template <typename T>
struct atomic_t : std::atomic<T>
{
	using std::atomic<T>::atomic;
	using std::atomic<T>::operator=;
	constexpr atomic_t() noexcept : std::atomic<T>(T{}) {}
};

class shared_mutex
{
	std::shared_mutex m_mutex;
public:
	void lock() { m_mutex.lock(); }
	void unlock() { m_mutex.unlock(); }
	bool try_lock() { return m_mutex.try_lock(); }
	void lock_shared() { m_mutex.lock_shared(); }
	void unlock_shared() { m_mutex.unlock_shared(); }
};

class reader_lock
{
	shared_mutex& m_mutex;
	bool m_upgraded = false;
public:
	explicit reader_lock(shared_mutex& mutex) : m_mutex(mutex) { m_mutex.lock_shared(); }
	reader_lock(const reader_lock&) = delete;
	void upgrade() { if (!m_upgraded) { m_mutex.unlock_shared(); m_mutex.lock(); m_upgraded = true; } }
	~reader_lock() { if (m_upgraded) m_mutex.unlock(); else m_mutex.unlock_shared(); }
};

// Guest memory of the GCM label and report area (sys_rsx layout, label_addr = 0x40300000).
struct CellGcmReportData { u64 timer; u32 value; u32 padding; };
struct RsxReport { u8 bytes[16]; };
struct RsxReports
{
	u32 semaphore[1024];
	struct alignas(16) notify_t { u8 bytes[16]; } notify[64];
	RsxReport report[2048];
};
inline u32 offset32(decltype(&RsxReports::report)) { return static_cast<u32>(offsetof(RsxReports, report)); }

namespace vm
{
	using addr_t = u32;
	inline constexpr u32 g_base = 0x40300000u;
	inline constexpr u32 g_size = 0x10000u;
	alignas(64) inline u8 g_memory[g_size]{};
	inline void* base(u32 address) { return reinterpret_cast<void*>(static_cast<std::uintptr_t>(address)); }
	template <typename T> T* get_super_ptr(u32 address)
	{
		if (address < g_base || address + sizeof(T) > g_base + g_size) harness_fail("guest address outside the report area", "vm", 0);
		return reinterpret_cast<T*>(g_memory + (address - g_base));
	}
	template <typename T> T& _ref(u32 address) { return *get_super_ptr<T>(address); }
	inline u32 cast(u32 address) { return address; }
	template <typename T> struct ptr
	{
		u32 m_addr;
		ptr(u32 address) : m_addr(address) {}
		T* operator->() const { return get_super_ptr<T>(m_addr); }
	};
}

// Every report memory write, in order (ZCULL_control::write stores through this type).
struct report_write_t { u32 address; u32 value; u64 timer; };
inline std::vector<report_write_t> g_report_writes;
template <>
struct atomic_t<CellGcmReportData>
{
	CellGcmReportData raw;
	void store(const CellGcmReportData& value) noexcept
	{
		raw = value;
		g_report_writes.push_back({static_cast<u32>(reinterpret_cast<const u8*>(this) - vm::g_memory) + vm::g_base, value.value, value.timer});
	}
	CellGcmReportData load() const noexcept { return raw; }
};
static_assert(sizeof(atomic_t<CellGcmReportData>) == 16);

// The MMU of the guest: page protections set by utils::memory_protect.
namespace utils
{
	enum class protection { rw, ro, no, wx, rx };
	inline usz get_page_size() { return 16384; }
	template <typename T> constexpr T page_start(T address) { return address & ~static_cast<T>(16383); }
	inline std::unordered_map<u32, protection> g_page_protection;
	inline u64 g_protect_calls = 0;
	inline void memory_protect(void* pointer, usz size, protection prot)
	{
		const u32 first = static_cast<u32>(reinterpret_cast<std::uintptr_t>(pointer));
		for (u32 page = first; page < first + size; page += 16384) g_page_protection[page] = prot;
		g_protect_calls++;
	}
	inline bool is_protected(u32 address)
	{
		const auto found = g_page_protection.find(page_start(address));
		return found != g_page_protection.end() && found->second == protection::no;
	}
	inline u64 get_tsc() { return g_now_us * 24; }
	struct address_range32
	{
		u32 start = 0, end = 0;
		static address_range32 start_length(u32 start, u32 length) { return {start, start + length - 1}; }
		bool overlaps(u32 address) const { return address >= start && address <= end; }
	};
}

namespace rsx
{
	namespace constants { inline constexpr u32 local_mem_base = 0xC0000000u; }
	struct ref_counted
	{
		s32 m_refs = 0;
		void add_ref() { m_refs++; }
		void release() { m_refs--; }
		bool has_refs() const { return m_refs > 0; }
	};
	template <typename T> struct simple_array : std::vector<T> { using std::vector<T>::vector; };
}
enum : u32 { CELL_GCM_LOCATION_LOCAL = 0, CELL_GCM_LOCATION_MAIN = 1 };
enum : u32 { CELL_GCM_ZPASS_PIXEL_CNT = 1, CELL_GCM_ZCULL_STATS = 2, CELL_GCM_ZCULL_STATS1 = 3, CELL_GCM_ZCULL_STATS2 = 4, CELL_GCM_ZCULL_STATS3 = 5 };
template <typename T, std::size_t N> constexpr const T& at32(const T (&array)[N], u32 index) { return array[index]; }

enum class thread_class : u32 { general = 0, ppu = 1, spu = 2, rsx = 0x55 };
struct cpu_mock { thread_class cls; thread_class get_class() const { return cls; } };
