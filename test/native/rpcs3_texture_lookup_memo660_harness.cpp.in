namespace host_log
{
	inline u64 errors = 0, warnings = 0, texmemo_errors = 0;
	inline std::string last_error;
}

[[noreturn]] void fmt::raw_verify_error(std::source_location loc, const char8_t* msg, usz)
{
	std::fprintf(stderr, "VERIFY FAILED %s:%u: %s\n", loc.file_name(), loc.line(), reinterpret_cast<const char*>(msg));
	std::abort();
}

[[noreturn]] void fmt::raw_verify_error(std::source_location loc, std::source_location, const char8_t* msg, usz)
{
	std::fprintf(stderr, "VERIFY FAILED %s:%u: %s\n", loc.file_name(), loc.line(), reinterpret_cast<const char*>(msg));
	std::abort();
}

[[noreturn]] void fmt::raw_throw_exception(std::source_location loc, const char* fmt, const fmt_type_info*, const u64*)
{
	std::fprintf(stderr, "THROW %s:%u: %s\n", loc.file_name(), loc.line(), fmt);
	std::abort();
}

template <> void fmt_class_string<unsigned short>::format(std::string& out, u64 arg) { out += std::to_string(arg); }
template <> void fmt_class_string<unsigned int>::format(std::string& out, u64 arg) { out += std::to_string(arg); }
template <> void fmt_class_string<int>::format(std::string& out, u64 arg) { out += std::to_string(static_cast<s64>(arg)); }

long utils::get_page_size() { return 4096; }
u64 utils::_get_main_tid() { return 0; }
logs::registerer::registerer(logs::channel&) {}
void logs::message::broadcast(const char* fmt, const fmt_type_info*, ...) const
{
	const auto lvl = static_cast<logs::level>(*this);
	if (lvl <= logs::level::error)
	{
		host_log::errors++;
		host_log::last_error = fmt;
		if (std::string_view(fmt).find("TEXMEMO660") != std::string_view::npos)
		{
			host_log::texmemo_errors++;
		}
	}
	else if (lvl == logs::level::warning)
	{
		host_log::warnings++;
	}
}

template <> void fmt_class_string<unsigned long long>::format(std::string& out, u64 arg) { out += std::to_string(arg); }

// shared_mutex slow paths: the harness is single-threaded, so a slow path means this thread already
// holds the cache lock (a second shared lock before an upgrade would never let the upgrade finish).
namespace host_lock { inline u64 slow_paths = 0; }
void shared_mutex::imp_lock_shared(u32 value) { std::fprintf(stderr, "LOCK: shared lock while the cache lock is exclusive (0x%x)\n", value); std::abort(); }
void shared_mutex::imp_unlock_shared(u32 old) { std::fprintf(stderr, "LOCK: shared unlock with waiters (0x%x)\n", old); std::abort(); }
void shared_mutex::imp_lock(u32 value) { std::fprintf(stderr, "LOCK: exclusive lock while the cache lock is held (0x%x)\n", value); std::abort(); }
void shared_mutex::imp_unlock(u32 old) { std::fprintf(stderr, "LOCK: exclusive unlock with waiters (0x%x)\n", old); std::abort(); }
void shared_mutex::imp_lock_upgrade() { std::fprintf(stderr, "LOCK: upgrade while another reader holds the cache lock: it would wait forever\n"); std::abort(); }

