// Seams of the copied headers (one call each, asserted by the test).
namespace host_seam
{
	struct video_config
	{
		bool strict_texture_flushing = false, read_depth_buffer = false, read_color_buffers = false;
		bool write_depth_buffer = false, write_color_buffers = false, disable_blit_engine_upscaling = true;
		bool strict_rendering_mode = false, force_hw_MSAA_resolve = false;
		u32 resolution_scale_percent = 100, min_scalable_dimension = 16;
		msaa_level antialiasing_level = msaa_level::none;
	};
	inline video_config video;
	inline bool tiled = false;          // every range is tiled (the sampler binding length becomes unknown)
	inline u64 tiled_queries = 0;
	inline rsx::GCM_tile_reference tiled_memory_region(const utils::address_range32&)
	{
		++tiled_queries;
		rsx::GCM_tile_reference ref{};
		if (tiled)
		{
			static const GcmTileInfo dummy{};
			ref.base_address = 0;
			ref.tile = &dummy;
		}
		return ref;
	}
	inline bool is_rsx_thread() { return true; }
	inline u64 rop_sync_timestamp() { return 0; }
	inline const rsx::surface_scaling_config_t& scaling_config()
	{
		static rsx::surface_scaling_config_t config{};
		return config;
	}
}

#include "Emu/RSX/Common/texture_cache.h"

//@@COMPAT@@

// ---------------------------------------------------------------------------------------------
// Host stand-ins for the Vulkan objects (the extracted VK code names them vk::...).
// ---------------------------------------------------------------------------------------------
namespace host
{
	inline u64 next_id = 1;
	inline u64 hash_bytes(const u8* p, usz n)
	{
		u64 h = 1469598103934665603ull;
		for (usz i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ull; }
		return h;
	}
	inline u64 hashes = 0; // fast_hash_internal calls (rpcs3::ios::texture_prehash::range_hash)
	inline u64 protects = 0;
}

namespace vk
{
	struct render_device {};
	struct command_buffer
	{
		int id = 0;
		operator VkCommandBuffer() const { return VK_NULL_HANDLE; }
	};
	struct image;

	struct image_view
	{
		vk::image* owner = nullptr;
		u64 id = 0;
		u32 remap = 0;
		bool disposed = false;
		vk::image* image() const { return owner; }
		VkFormat format() const;
		u32 encoded_component_map() const { return remap; }
	};

	struct image
	{
		u64 id = host::next_id++;
		u32 w = 1, h = 1, d = 1, mips = 1, layer_count = 1;
		VkFormat fmt = VK_FORMAT_B8G8R8A8_UNORM;
		VkImageType type = VK_IMAGE_TYPE_2D;
		VkSharingMode sharing = VK_SHARING_MODE_EXCLUSIVE;
		VkImageLayout current_layout = VK_IMAGE_LAYOUT_UNDEFINED;
		VkImage value = VK_NULL_HANDLE;
		u64 content = 0;      // hash of the guest bytes last uploaded into it
		bool destroyed = false;
		rsx::format_class fclass = rsx::RSX_FORMAT_CLASS_COLOR;
		virtual ~image() = default;
		u32 width() const { return w; }
		u32 height() const { return h; }
		u32 depth() const { return d; }
		u32 mipmaps() const { return mips; }
		u32 layers() const { return layer_count; }
		VkFormat format() const { return fmt; }
		rsx::format_class format_class() const { return fclass; }
		VkImageAspectFlags aspect() const { return VK_IMAGE_ASPECT_COLOR_BIT; }
		VkImage handle() const { return value; }
		u8 samples() const { return 1; }
		VkSharingMode sharing_mode() const { return sharing; }
		void change_layout(const command_buffer&, VkImageLayout layout) { current_layout = layout; }
		void set_debug_name(const std::string&) {}
	};

	inline VkFormat image_view::format() const { return owner->format(); }

	struct viewable_image : image
	{
		std::map<u64, std::unique_ptr<image_view>> views;
		std::vector<std::unique_ptr<image_view>> disposed_views; // kept readable: a stale reference stays comparable
		VkComponentMapping native_component_map = { VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_A };

		viewable_image() = default;
		template <typename MemoryType, typename Format>
		viewable_image(render_device&, const MemoryType&, u32, VkImageType image_type, const Format& format, u16 width, u16 height, u16 depth, u16 mipmaps, u8 layers,
			VkSampleCountFlagBits, VkImageLayout layout, VkImageTiling, VkImageUsageFlags, VkImageCreateFlags, int, rsx::format_class format_class)
		{
			type = image_type; fmt = static_cast<VkFormat>(format); w = width; h = height; d = depth; mips = mipmaps; layer_count = layers; current_layout = layout; fclass = format_class;
		}

		image_view* get_view(const rsx::texture_channel_remap_t& remap)
		{
			const u64 key = remap.encoded;
			auto found = views.find(key);
			if (found != views.end())
			{
				return found->second.get();
			}
			auto view = std::make_unique<image_view>();
			view->owner = this;
			view->id = host::next_id++;
			view->remap = remap.encoded;
			auto result = view.get();
			views.emplace(key, std::move(view));
			return result;
		}

		void set_native_component_layout(VkComponentMapping layout)
		{
			if (layout.r != native_component_map.r || layout.g != native_component_map.g || layout.b != native_component_map.b || layout.a != native_component_map.a)
			{
				native_component_map = layout;
				for (auto& [key, view] : views)
				{
					view->disposed = true;
					disposed_views.push_back(std::move(view));
				}
				views.clear();
			}
		}
	};

	struct render_target : viewable_image, rsx::render_target_descriptor<vk::viewable_image*>
	{
		vk::viewable_image* get_surface(rsx::surface_access) override { return this; }
		bool is_depth_surface() const override { return false; }
		rsx::surface_color_format get_surface_color_format() const { return rsx::surface_color_format::a8r8g8b8; }
		rsx::surface_depth_format2 get_surface_depth_format() const { return rsx::surface_depth_format2::z24s8_uint; }
		void memory_barrier(const command_buffer&, rsx::surface_access) {}
		void texture_barrier(const command_buffer&) {}
		void read_barrier(const command_buffer&) {}
	};

	inline render_target* as_rtt(image* p) { return dynamic_cast<render_target*>(p); }

	struct disposable_t {};
	struct event {};
	struct memory_type_info {};
	struct memory_type_mapping { memory_type_info device_local; };
	struct gpu_formats_support {};
	struct VkFormatEx
	{
		VkFormat baseFormat;
		VkFormat* pViewFormats = nullptr;
		u32 viewFormatCount = 0;
		VkFormatEx(VkFormat format) : baseFormat(format) {}
		operator VkFormat() const { return baseFormat; }
	};

	inline void insert_image_memory_barrier(const command_buffer&, VkImage, VkImageLayout, VkImageLayout, VkPipelineStageFlags, VkPipelineStageFlags,
		VkAccessFlags, VkAccessFlags, const VkImageSubresourceRange&) {}
}

// Vulkan entry points the extracted create_new_texture records (no device).
inline void vkCmdClearColorImage(VkCommandBuffer, VkImage, VkImageLayout, const VkClearColorValue*, uint32_t, const VkImageSubresourceRange*) {}
inline void vkCmdClearDepthStencilImage(VkCommandBuffer, VkImage, VkImageLayout, const VkClearDepthStencilValue*, uint32_t, const VkImageSubresourceRange*) {}
#define VK_IMAGE_CREATE_SHAREABLE_RPCS3 0x80000000u

// ---------------------------------------------------------------------------------------------
// Host traits, section, surface store and cache.
// ---------------------------------------------------------------------------------------------
namespace host
{
	class section;
	class cache;
	using vk::VkFormatEx;
	constexpr int VMM_ALLOCATION_POOL_TEXTURE_CACHE = 1;

	inline VkFormat get_compatible_sampler_format(const vk::gpu_formats_support&, u32 gcm_format)
	{
		return static_cast<VkFormat>(VK_FORMAT_R8G8B8A8_UNORM + (gcm_format & 0x1f));
	}
	inline VkFormat get_compatible_snorm_format(VkFormat) { return VK_FORMAT_UNDEFINED; }
	inline VkFormat get_compatible_srgb_format(VkFormat) { return VK_FORMAT_UNDEFINED; }
	// One distinct component mapping per (format, component order): another order disposes the views.
	inline VkComponentMapping apply_component_mapping_flags(u32, rsx::component_order flags, const rsx::texture_channel_remap_t&)
	{
		if (flags == rsx::component_order::default_)
		{
			return { VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_A };
		}
		return { VK_COMPONENT_SWIZZLE_B, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_A };
	}

	struct traits
	{
		using commandbuffer_type      = vk::command_buffer;
		using section_storage_type    = section;
		using texture_cache_type      = cache;
		using texture_cache_base_type = rsx::texture_cache<cache, traits>;
		using image_resource_type     = vk::image*;
		using image_view_type         = vk::image_view*;
		using image_storage_type      = vk::image;
		using texture_format          = VkFormat;
		using viewable_image_type     = vk::viewable_image*;
	};

	class section : public rsx::cached_texture_section<section, traits>
	{
		using baseclass = rsx::cached_texture_section<section, traits>;
		friend baseclass;

	public:
		std::unique_ptr<vk::viewable_image> managed_texture = nullptr;
		std::unique_ptr<vk::event> dma_fence;
		vk::viewable_image* vram_texture = nullptr;

		using baseclass::cached_texture_section;

		void release_dma_resources() { dma_fence.reset(); }
		void dma_abort() override {}

		//@@VK_SECTION@@

		// The framebuffer overload of vk::cached_texture_section::create.
		//@@VK_SECTION_RT@@

		bool exists() const { return vram_texture != nullptr; }
		bool is_managed() const { return !exists() || managed_texture; }
		vk::image_view* get_view(const rsx::texture_channel_remap_t& remap) { ensure(vram_texture); return vram_texture->get_view(remap); }
		vk::image_view* get_raw_view() { ensure(vram_texture); return vram_texture->get_view(rsx::default_remap_vector); }
		vk::viewable_image* get_raw_texture() { return managed_texture.get(); }
		std::unique_ptr<vk::viewable_image>& get_texture() { return managed_texture; }
		vk::render_target* get_render_target() const { return vk::as_rtt(vram_texture); }
		VkFormat get_format() const { return vram_texture ? vram_texture->format() : VK_FORMAT_R32_UINT; }
		void copy_texture(vk::command_buffer&, bool) {}
		void imp_flush() override {}
		void* map_synchronized(u32, u32) { return nullptr; }
		void finish_flush() {}
		void set_unpack_swap_bytes(bool swap_bytes) { pack_unpack_swap_bytes = swap_bytes; }
		void sync_surface_memory(const rsx::simple_array<section*>&) {}
		bool has_compatible_format(vk::image* tex) const { return vram_texture->format() == tex->format(); }
		bool is_depth_texture() const { return false; }

		// Test access: writes that bypass every choke point (the forced-mismatch scenario).
		void test_poke_gcm_format(u32 format) { gcm_format = format; }
		u32 test_gcm_format() const { return gcm_format; }
		bool test_dirty() const { return is_dirty(); }
	};

	struct surface_store
	{
		using surface_type = vk::render_target*;
		using surface_overlap_info = rsx::surface_overlap_info_t<surface_type>;
		u64 write_tag = 1, cache_tag = 1;
		std::pair<u32, surface_type> m_bound_depth_stencil = {};
		std::set<u32> bound;
		vk::render_target fake_rt;
		bool address_is_bound(u32 address) const { ensure(address); return bound.contains(address); }
		// A bound target the framebuffer check refuses (pitch): the lookup continues with the local sections.
		surface_type get_surface_at(u32) { fake_rt.rsx_pitch = 0x7ff0; fake_rt.surface_width = 1; fake_rt.surface_height = 2; return &fake_rt; }
		template <typename... Args>
		void check_for_duplicates(Args&&...) {}
		template <typename commandbuffer_type>
		rsx::simple_array<surface_overlap_info> get_merged_texture_memory_region(commandbuffer_type&, u32, u32, u32, u32, u8, rsx::surface_access) { return {}; }
	};

	class cache : public rsx::texture_cache<cache, traits>
	{
	public:
		using baseclass = rsx::texture_cache<cache, traits>;
		friend baseclass;
		using cached_texture_section = section;
		using sampled_image_descriptor = typename baseclass::sampled_image_descriptor;

		enum texture_create_flags : u32
		{
			initialize_image_contents = 1,
			do_not_reuse = 2,
			shareable = 4,
			mutable_format = 8
		};

		vk::render_device device_storage;
		vk::render_device* m_device = &device_storage;
		vk::memory_type_mapping m_memory_types;
		vk::gpu_formats_support m_formats_support;
		std::vector<std::unique_ptr<vk::viewable_image>> graveyard;
		u64 cpu_uploads = 0;

		std::unique_ptr<vk::viewable_image> find_cached_image(VkFormat, u16, u16, u16, u16, VkImageType, VkImageCreateFlags, VkImageUsageFlags, VkSharingMode, rsx::format_class)
		{
			return {};
		}

		// vk::texture_cache::on_section_destroyed: the image leaves with its views (disposed later on device).
		void on_section_destroyed(section& tex) override
		{
			if (tex.is_managed() && tex.exists())
			{
				tex.get_texture()->destroyed = true;
				graveyard.push_back(std::move(tex.get_texture()));
			}
		}

		section* create_new_texture(vk::command_buffer& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch,
			u32 gcm_format, rsx::texture_upload_context context, rsx::texture_dimension_extended type, bool swizzled, rsx::component_order swizzle_flags, rsx::flags32_t flags) override
		//@@VK_CREATE_NEW_TEXTURE@@

		// vk::texture_cache::upload_image_from_cpu without the Vulkan upload: the bytes are hashed into the image.
		section* upload_image_from_cpu(vk::command_buffer& cmd, const utils::address_range32& rsx_range, u16 width, u16 height, u16 depth, u16 mipmaps, u32 pitch, u32 gcm_format,
			rsx::texture_upload_context context, const std::vector<rsx::subresource_layout>&, rsx::texture_dimension_extended type, bool swizzled) override
		{
			rsx::flags32_t create_flags = 0;
			if (context == rsx::texture_upload_context::shader_read)
			{
				create_flags |= texture_create_flags::mutable_format;
			}
			auto result = create_new_texture(cmd, rsx_range, width, height, depth, mipmaps, pitch, gcm_format, context, type, swizzled,
				rsx::component_order::default_, create_flags);
			result->get_raw_texture()->content = host::hash_bytes(vm::g_sudo_addr + rsx_range.start, rsx_range.length());
			result->last_write_tag = rsx::get_shared_tag();
			++cpu_uploads;
			return result;
		}

		void set_component_order(section& section, u32 gcm_format, rsx::component_order expected_flags) override
		//@@VK_SET_COMPONENT_ORDER@@

		vk::image_view* create_temporary_subresource_view(vk::command_buffer&, const typename baseclass::deferred_subresource&) override { std::abort(); }
		void release_temporary_subresource(vk::image_view*) override {}
		section* create_nul_section(vk::command_buffer&, const utils::address_range32&, const rsx::image_section_attributes_t&, const rsx::GCM_tile_reference&, bool) override { std::abort(); }
		void insert_texture_barrier(vk::command_buffer&, vk::image*, bool) override {}
		vk::image_view* generate_cubemap_from_images(vk::command_buffer&, const typename baseclass::deferred_subresource&) override { std::abort(); }
		vk::image_view* generate_3d_from_2d_images(vk::command_buffer&, const typename baseclass::deferred_subresource&) override { std::abort(); }
		vk::image_view* generate_atlas_from_images(vk::command_buffer&, const typename baseclass::deferred_subresource&) override { std::abort(); }
		vk::image_view* generate_2d_mipmaps_from_images(vk::command_buffer&, const typename baseclass::deferred_subresource&) override { std::abort(); }
		void update_image_contents(vk::command_buffer&, vk::image_view*, const typename baseclass::deferred_subresource&) override { std::abort(); }
		bool render_target_format_is_compatible(vk::image*, u32) override { return true; }
		void prepare_for_dma_transfers(vk::command_buffer&) override {}
		void cleanup_after_dma_transfers(vk::command_buffer&) override {}
		void destroy() override { clear(); }
		bool is_depth_texture(u32, u32) override { return false; }

		//@@TEST_ACCESS@@
	};
}

