namespace rsx
{
	atomic_t<u64> g_rsx_shared_tag{ 0 };
	void mm_protect(void*, u64, utils::protection) { host::protects++; }
}

namespace host
{
	constexpr usz guest_memory_size = 64u << 20;
	inline u8* guest_memory()
	{
		void* p = ::mmap(nullptr, guest_memory_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
		if (p == MAP_FAILED) std::abort();
		return static_cast<u8*>(p);
	}
}
u8* const vm::g_sudo_addr = host::guest_memory();
u8* const vm::g_base_addr = vm::g_sudo_addr;

namespace rpcs3::ios::texture_prehash
{
	std::uint64_t range_hash(const void* src, std::uint32_t length) noexcept
	{
		host::hashes++;
		return host::hash_bytes(static_cast<const u8*>(src), length);
	}
	void record(std::uint32_t, std::uint32_t, bool) noexcept {}
	void end_frame() noexcept {}
	void on_epoch_advance() noexcept {}
}

