// Host harness of REWINDBOX_TEXTURE_LOOKUP_MEMO_660, generated by texture_lookup_memo660_test.py.
// The real rsx::texture_cache (texture_cache.h), its sections and storage (texture_cache_utils.h), the
// real buffered_section methods (texture_cache.cpp), the real register accessors (RSXTexture.cpp) and
// texture size helpers (TextureUtils.cpp), and the real bodies of vk::cached_texture_section::create,
// destroy and set_rsx_pitch, vk::texture_cache::create_new_texture and set_component_order are
// compiled against host stand-ins for Vulkan images, the surface store and the renderer.
#define RPCS3_IOS 1
#include "stdafx.h"
#include "Emu/system_config_types.h"
#include "Emu/RSX/Core/RSXContext.h"
#include "Emu/RSX/Common/surface_utils.h"
#include "Emu/RSX/Host/MM.h"
#include <vulkan/vulkan_core.h>

#include <cstdio>
