	utils::address_range32 range_of(const tex_desc& t) { return utils::address_range32::start_length(address_of(t), t.pitch * t.height); }

	host::section* section_at(u32 address)
	{
		host::section* found = nullptr;
		W->cache->for_each_section([&](host::section& s)
		{
			if (!found && s.valid_range() && s.get_section_base() == address && s.exists() && !s.is_dirty()) found = &s;
		});
		return found;
	}

	// 1. A/B/A alternation on one slot: the first lookup of each texture uploads it (never stored:
	// the cache changed during it), the second is stored, then every switch is a hit.
	void s_aba()
	{
		begin_scenario("aba");
		prime({ A, B });
		for (int i = 0; i < 8; ++i)
		{
			set_texture(0, false, (i % 2) ? B : A);
			load_textures(1);
		}
		end_scenario();
	}

	// 2. A register rewrite that leaves the texture unchanged (FILTER): dirty slot, same key.
	void s_same_key()
	{
		begin_scenario("same_key_rewrite");
		prime({ A });
		set_texture(0, false, A);
		load_textures(1);
		for (int i = 0; i < 5; ++i)
		{
			bump_filter(0);
			load_textures(1);
		}
		load_textures(1); // nothing changed: no lookup
		end_scenario();
	}

	// 3. Epoch advances; an unsynchronized write in the epoch is seen by neither mode before the next one.
	void s_epoch()
	{
		begin_scenario("epoch");
		prime({ A, B });
		set_texture(0, false, A);
		set_texture(1, false, B);
		load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); load_textures(3);
		rpcs3::ios::texture_validation::advance_epoch(); event("advance_epoch");
		load_textures(3);
		bump_filter(0); load_textures(3);
		fill(address_of(A), 64, 99); event("unsynchronized_write");
		bump_filter(0); load_textures(3);
		rpcs3::ios::texture_validation::advance_epoch(); event("advance_epoch");
		load_textures(3);
		bump_filter(0); load_textures(3);
		bump_filter(0); load_textures(3);
		end_scenario();
	}

	// 4. CELL573 scoped writes: revalidate_overlapping drops the overlapped entry only; a commit as a
	// framebuffer (real invalidate_range, committed_as_fbo) over A's range.
	void s_scoped()
	{
		begin_scenario("scoped_write");
		prime({ A, B });
		set_texture(0, false, A);
		set_texture(1, false, B);
		load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->cache->test_revalidate(range_of(A)); event("revalidate_A");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->cache->test_revalidate(utils::address_range32::start_length(address_of(B) + 0x100000, 0x1000)); event("revalidate_elsewhere");
		bump_filter(0); bump_filter(1); load_textures(3);
		// The RSX wrote over A (a flushed render target): new bytes, scoped revalidation of A's range.
		fill(address_of(A), 512, 777); W->cache->test_revalidate(range_of(A)); event("rsx_write_A");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->cache->invalidate_range(W->cmd, range_of(A), rsx::invalidation_cause::committed_as_fbo); event("commit_as_fbo_A");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		end_scenario();
	}

	// 5. A section created for another slot (CPU upload) changes the section state: entries drop.
	void s_other_section()
	{
		begin_scenario("other_section_change");
		prime({ A, B });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		set_texture(1, false, B); load_textures(3);
		bump_filter(0); load_textures(3);
		bump_filter(0); load_textures(3);
		end_scenario();
	}

	// 6. Swizzle mismatch: the lookup unprotects and dirties the section it found, then uploads again.
	void s_swizzle()
	{
		begin_scenario("swizzle_mismatch");
		prime({ A });
		tex_desc swizzled = A;
		swizzled.format = CELL_GCM_TEXTURE_A8R8G8B8;
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		set_texture(0, false, swizzled); load_textures(1);
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 7. The 17th section of a block builds its address index (ranged_storage_block::create_section):
	// lookups switch from the range walk to the index.
	void s_index()
	{
		begin_scenario("address_index");
		std::vector<tex_desc> list;
		for (u32 i = 0; i < 19; ++i)
		{
			tex_desc t = A;
			t.offset = i * 0x8000;
			list.push_back(t);
		}
		for (const auto& t : list) fill(address_of(t), t.pitch * t.height, t.offset + 7);
		for (u32 i = 1; i < 16; ++i) { set_texture(2, false, list[i]); load_textures(4); }
		set_texture(0, false, list[0]); load_textures(5);
		bump_filter(0); load_textures(5);
		bump_filter(0); load_textures(5);
		set_texture(2, false, list[16]); load_textures(5); // 17 sections in the block
		bump_filter(0); load_textures(5);
		bump_filter(0); load_textures(5);
		set_texture(2, false, list[17]); load_textures(5);
		bump_filter(0); load_textures(5);
		bump_filter(0); load_textures(5);
		end_scenario();
	}

	// 8. A CPU write over A (real invalidate_range, write): epoch and section; the upload that follows
	// reuses the dirty section (create_new_texture: set_rsx_pitch); then a texture with another pitch.
	void s_reuse()
	{
		begin_scenario("cpu_write_reuse_pitch");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		fill(address_of(A), 256 * 64, 1234);
		W->cache->invalidate_range(W->cmd, range_of(A), rsx::invalidation_cause::write); event("cpu_write_A");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		tex_desc wide = A;
		wide.width = 32;
		wide.pitch = 512;
		set_texture(0, false, wide); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 9. vk::texture_cache::set_component_order (real body): the section's views are disposed.
	void s_component_order()
	{
		begin_scenario("component_order");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		W->cache->test_set_component_order(*ensure(section_at(address_of(A))), rsx::component_order::swapped_native); event("set_component_order");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 10. Eviction (evict_unused) and the purge of the sections it released, memory pressure (OOM: the
	// purge of unlocked sections, here a blit destination) and the texture residency eviction. A is
	// excluded as a bound texture wherever the API takes a list.
	void s_eviction()
	{
		begin_scenario("eviction_purge_oom_residency");
		prime({ A, B, C_dxt });
		set_texture(0, false, A); set_texture(1, false, B); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->cache->evict_unused({ address_of(A) }); event("evict_unused");
		W->cache->purge_unreleased_sections(); event("purge_unreleased");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		const auto blit_range = utils::address_range32::start_length(address_of(A) + 0x80000, 256 * 64);
		W->cache->create_new_texture(W->cmd, blit_range, 64, 64, 1, 1, 256, CELL_GCM_TEXTURE_A8R8G8B8, rsx::texture_upload_context::blit_engine_dst,
			rsx::texture_dimension_extended::texture_dimension_2d, false, rsx::component_order::default_, 0); event("blit_destination");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->cache->handle_memory_pressure(rsx::problem_severity::severe); event("memory_pressure_severe");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		set_texture(2, false, C_dxt); load_textures(7);
		bump_filter(0); bump_filter(2); load_textures(7);
		bump_filter(0); bump_filter(2); load_textures(7);
		rpcs3::ios::texture_residency::enabled.store(true);
		for (int i = 0; i < 70; ++i) rpcs3::ios::texture_residency::advance_frame();
		W->cache->evict_idle_sections({ address_of(A) }, 1ull << 40, [](host::section& s) { return u64{s.get_section_size()}; }); event("residency_evict");
		bump_filter(0); bump_filter(2); load_textures(7);
		bump_filter(0); bump_filter(2); load_textures(7);
		end_scenario();
	}

	// 11. Frame end: on_frame_end (epoch, residency frame) and the global sampler refresh of VKPresent.
	void s_frame_end()
	{
		begin_scenario("frame_end");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		W->cache->on_frame_end(); W->samplers_dirty = true; event("frame_end");
		load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 12. m_samplers_dirty alone (a blit, an access violation): the memo context generation.
	void s_samplers_dirty()
	{
		begin_scenario("samplers_dirty");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		W->samplers_dirty = true; event("samplers_dirty");
		load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 13. A render target bound at the texture address (the framebuffer check fails and the local
	// lookup runs in both modes): no hit while bound, the entry is dropped.
	void s_bound()
	{
		begin_scenario("render_target_bound");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		W->rtts.bound.insert(address_of(A)); event("bind_rt");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		W->rtts.bound.erase(address_of(A)); event("unbind_rt");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 14. IO remap: the same register words resolve to another address.
	void s_io_remap()
	{
		begin_scenario("io_remap");
		prime({ A });
		fill(0x00400000 + 0x100000, 256 * 64, 4242);
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		host::io_base = 0x00500000; event("io_remap");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		host::io_base = 0x00400000; event("io_restore");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 15. Compressed (find_texture_from_dimensions) and uncompressed entries, then a framebuffer
	// section (real lock_memory_region): its creation drops both; re-locking it changes only
	// framebuffer storage: the compressed entry drops, the uncompressed one stays.
	void s_framebuffer()
	{
		begin_scenario("compressed_and_framebuffer");
		prime({ A, C_dxt });
		set_texture(0, false, C_dxt); set_texture(1, false, A); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		auto rt = std::make_unique<vk::render_target>();
		rt->w = 128; rt->h = 64; rt->rsx_pitch = 512; rt->native_pitch = 512; rt->surface_width = 128; rt->surface_height = 64;
		const auto fb_range = utils::address_range32::start_length(host::local_base + 0x100000, 512 * 64);
		W->cache->lock_memory_region(W->cmd, rt.get(), fb_range, false, 128, 64, 512, rt.get()); event("lock_framebuffer");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->cache->lock_memory_region(W->cmd, rt.get(), fb_range, false, 128, 64, 512, rt.get()); event("relock_framebuffer");
		bump_filter(0); bump_filter(1); load_textures(3);
		bump_filter(0); bump_filter(1); load_textures(3);
		W->targets.push_back(std::move(rt));
		end_scenario();
	}

	// 16. Tiled memory: the binding length is unknown, any scoped write drops the entry.
	void s_tiled()
	{
		begin_scenario("tiled");
		prime({ A });
		host_seam::tiled = true;
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		W->cache->test_revalidate(utils::address_range32::start_length(0x00F00000, 0x1000)); event("revalidate_elsewhere");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	// 17. The validation epoch switched off: no hit, no store (every validation hashes as before).
	void s_epoch_off()
	{
		begin_scenario("epoch_disabled");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		rpcs3::ios::texture_validation::epoch_enabled.store(false); event("epoch_off");
		for (int i = 0; i < 4; ++i) { bump_filter(0); load_textures(1); }
		rpcs3::ios::texture_validation::epoch_enabled.store(true);
		rpcs3::ios::texture_validation::advance_epoch(); event("epoch_on");
		for (int i = 0; i < 3; ++i) { bump_filter(0); load_textures(1); }
		end_scenario();
	}

	// 18. Vertex slots, a BX2 fragment read and a disabled unit.
	void s_vertex()
	{
		begin_scenario("vertex_bx2_disabled");
		prime({ A, B });
		tex_desc off = B;
		off.enabled = false;
		set_texture(0, true, A); set_texture(0, false, B); set_texture(3, false, off);
		load_textures(9, 1, 1);
		for (int i = 0; i < 3; ++i)
		{
			W->regs[NV4097_SET_VERTEX_TEXTURE_FILTER] ^= 0x10; W->slot_dirty[16] = true;
			bump_filter(0); W->slot_dirty[3] = true;
			load_textures(9, 1, i == 1 ? 0 : 1);
		}
		end_scenario();
	}

	// 19. A blit source section answers the lookup: not a shader_read view, never stored.
	void s_blit_source()
	{
		begin_scenario("blit_source_never_memoized");
		prime({ A });
		W->cache->create_new_texture(W->cmd, range_of(A), 64, 64, 1, 1, 256, CELL_GCM_TEXTURE_A8R8G8B8, rsx::texture_upload_context::blit_engine_src,
			rsx::texture_dimension_extended::texture_dimension_2d, false, rsx::component_order::default_, 0); event("blit_source");
		set_texture(0, false, A); load_textures(1);
		for (int i = 0; i < 3; ++i) { bump_filter(0); load_textures(1); }
		end_scenario();
	}

	// 20. 400 hits of one key in one epoch: the verification samples the first 256 and then one in 64.
	void s_sampling()
	{
		begin_scenario("verification_sampling");
		prime({ A });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		for (int i = 0; i < 400; ++i) { bump_filter(0); load_textures(1); }
		end_scenario();
	}

	// 21. Last: a write to a section field that bypasses every choke point. A served hit is then
	// stale (active_served shows the hazard); a verified hit finds the difference, logs once and
	// turns the memo off for the rest of the boot.
	void s_forced_mismatch()
	{
		begin_scenario("forced_mismatch");
		prime({ A, B });
		set_texture(0, false, A); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		ensure(section_at(address_of(A)))->test_poke_gcm_format(CELL_GCM_TEXTURE_R5G6B5); event("poke_gcm_format");
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		set_texture(0, false, B); load_textures(1);
		bump_filter(0); load_textures(1);
		bump_filter(0); load_textures(1);
		end_scenario();
	}

	void reboot()
	{
#if CANDIDATE
		if (g_mode == "off") memo::configure(memo::mode::off);
		else if (g_mode == "verify_all") memo::configure(memo::mode::verify_all);
		else memo::configure(memo::mode::active);
		if (g_mode == "active_served") memo::boot_hits.store(memo::verify_first + 1);
		// active_served exercises served hits directly; every other mode keeps the first-reuse verification of the Core.
		memo::verify_first_reuse.store(g_mode != "active_served");
#endif
	}

	void run_all()
	{
		for (auto scenario : { s_aba, s_same_key, s_epoch, s_scoped, s_other_section, s_swizzle, s_index, s_reuse, s_component_order,
			s_eviction, s_frame_end, s_samplers_dirty, s_bound, s_io_remap, s_framebuffer, s_tiled, s_epoch_off, s_vertex, s_blit_source,
			s_sampling, s_forced_mismatch })
		{
			reboot();
			scenario();
		}
	}
