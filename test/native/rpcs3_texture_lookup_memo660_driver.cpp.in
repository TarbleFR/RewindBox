// Scenario driver of the REWINDBOX_TEXTURE_LOOKUP_MEMO_660 harness.
// load_textures() is VKGSRender::load_texture_env reduced to what decides and performs a lookup: the
// global refresh of the memo (candidate), the skip condition (m_samplers_dirty, slot dirty bit, real
// sampler_requires_validation, real test_if_descriptor_expired), the disabled unit and the lookup itself
// (candidate: the real upload_sampler_texture; control: the Core 660 prepare/upload_texture/finish).
// Every lookup and every section are printed canonically; the test compares the runs.

namespace host
{
	inline u32 io_base = 0x00400000;      // CELL_GCM_LOCATION_MAIN offset 0
	inline u32 local_base = 0x02000000;   // CELL_GCM_LOCATION_LOCAL offset 0
}

u32 rsx::get_address(u32 offset, u32 location, u32, std::source_location)
{
	return (location == CELL_GCM_LOCATION_LOCAL ? host::local_base : host::io_base) + offset;
}

namespace drive
{
	using cache_t = host::cache;
	using desc_t = cache_t::sampled_image_descriptor;
	constexpr u32 slot_count = 20;
#if CANDIDATE
	namespace memo = rpcs3::ios::texture_lookup_memo;
#endif

	struct tex_desc
	{
		u32 offset = 0;
		u32 location = CELL_GCM_LOCATION_MAIN;
		u32 format = CELL_GCM_TEXTURE_A8R8G8B8 | CELL_GCM_TEXTURE_LN;
		u16 width = 64, height = 64;
		u32 pitch = 256;
		u16 mipmaps = 1;
		u32 remap = 0xAAE4;
		u32 dimension = 2;
		u16 depth = 1;
		u32 filter = 0x02020000;
		u32 control0_lod = 0;
		bool enabled = true;
	};

	struct world
	{
		std::array<u32, 0x10000 / 4> regs{};
		host::surface_store rtts;
		vk::command_buffer cmd;
		std::unique_ptr<cache_t> cache;
		std::array<desc_t, slot_count> state{};
		std::array<bool, slot_count> slot_dirty{};
		bool samplers_dirty = true;
		u64 draw = 0;
		std::string out;
		bool first_record = true;
		std::vector<std::unique_ptr<vk::render_target>> targets;
	};
	inline world* W = nullptr;
	inline std::string g_mode;
	inline std::string g_json;
	inline bool g_first_scenario = true;

	void append(const char* fmt, auto... args)
	{
		char buffer[1024];
		std::snprintf(buffer, sizeof(buffer), fmt, args...);
		W->out += buffer;
	}

	u32 reg_index(bool vertex, u32 unit, u32 fragment_base, u32 vertex_base)
	{
		return (vertex ? vertex_base : fragment_base) + unit * 8;
	}

	void write_reg(u32 index, u32 value, u32 slot)
	{
		if (W->regs[index] != value)
		{
			W->regs[index] = value;
			W->slot_dirty[slot] = true; // the RSX method handlers mark the unit dirty on a changed value
		}
	}

	void set_texture(u32 unit, bool vertex, const tex_desc& t)
	{
		const u32 slot = vertex ? 16 + unit : unit;
		const u32 format_word = ((t.location + 1) & 3) | (1u << 3) | (t.dimension << 4) | ((t.format & 0xff) << 8) | (u32{t.mipmaps} << 16);
		write_reg(reg_index(vertex, unit, NV4097_SET_TEXTURE_OFFSET, NV4097_SET_VERTEX_TEXTURE_OFFSET), t.offset, slot);
		write_reg(reg_index(vertex, unit, NV4097_SET_TEXTURE_FORMAT, NV4097_SET_VERTEX_TEXTURE_FORMAT), format_word, slot);
		write_reg(reg_index(vertex, unit, NV4097_SET_TEXTURE_ADDRESS, NV4097_SET_VERTEX_TEXTURE_ADDRESS), 0x00010101, slot);
		write_reg(reg_index(vertex, unit, NV4097_SET_TEXTURE_CONTROL0, NV4097_SET_VERTEX_TEXTURE_CONTROL0), (t.enabled ? 0x80000000u : 0u) | t.control0_lod, slot);
		write_reg(reg_index(vertex, unit, NV4097_SET_TEXTURE_FILTER, NV4097_SET_VERTEX_TEXTURE_FILTER), t.filter, slot);
		write_reg(reg_index(vertex, unit, NV4097_SET_TEXTURE_IMAGE_RECT, NV4097_SET_VERTEX_TEXTURE_IMAGE_RECT), (u32{t.width} << 16) | t.height, slot);
		if (!vertex)
		{
			write_reg(NV4097_SET_TEXTURE_CONTROL1 + unit * 8, t.remap, slot);
			write_reg(NV4097_SET_TEXTURE_CONTROL3 + unit, t.pitch | (u32{t.depth} << 20), slot);
		}
		else
		{
			write_reg(NV4097_SET_VERTEX_TEXTURE_CONTROL3 + unit * 8, t.pitch | (u32{t.depth} << 20), slot);
		}
	}

	void fill(u32 address, u32 length, u32 seed)
	{
		u8* p = vm::g_sudo_addr + address;
		for (u32 i = 0; i < length; ++i) p[i] = static_cast<u8>((seed * 2654435761u + i * 97u) >> 13);
	}

	u32 address_of(const tex_desc& t) { return rsx::get_address(t.offset, t.location); }

	const char* context_name(rsx::texture_upload_context c)
	{
		switch (c)
		{
		case rsx::texture_upload_context::shader_read: return "shader_read";
		case rsx::texture_upload_context::blit_engine_src: return "blit_src";
		case rsx::texture_upload_context::blit_engine_dst: return "blit_dst";
		case rsx::texture_upload_context::framebuffer_storage: return "framebuffer";
		case rsx::texture_upload_context::dma: return "dma";
		}
		return "?";
	}

	void sep() { if (!W->first_record) W->out += ","; W->first_record = false; }

	std::string outcome_of(const std::array<u64, 12>& before);
	std::array<u64, 12> counters_now();

	void record_lookup(u32 slot, const desc_t& d, const std::string& outcome)
	{
		sep();
		const auto* view = d.image_handle;
		const auto* img = view ? view->image() : nullptr;
		append("{\"k\":\"lookup\",\"draw\":%llu,\"slot\":%u,\"outcome\":\"%s\",\"valid\":%d,\"view\":%llu,\"view_disposed\":%d,"
			"\"image\":%llu,\"image_destroyed\":%d,\"content\":\"%016llx\",\"context\":\"%s\",\"class\":%u,\"type\":%u,\"ref\":\"0x%x\","
			"\"range\":\"0x%x-0x%x\",\"op\":%u,\"cyclic\":%d,\"direct_fb\":%d,\"xform\":[%g,%g,%g,%d],\"tag_is_write_tag\":%d}",
			static_cast<unsigned long long>(W->draw), slot, outcome.c_str(), d.validate() ? 1 : 0,
			static_cast<unsigned long long>(view ? view->id : 0), view ? (view->disposed ? 1 : 0) : 0,
			static_cast<unsigned long long>(img ? img->id : 0), img ? (img->destroyed ? 1 : 0) : 0,
			static_cast<unsigned long long>(img ? img->content : 0), context_name(d.upload_context), static_cast<u32>(d.format_class),
			static_cast<u32>(d.image_type), d.ref_address, d.ios_validation_range.valid() ? d.ios_validation_range.start : 0,
			d.ios_validation_range.valid() ? d.ios_validation_range.end : 0, static_cast<u32>(d.external_subresource_desc.op),
			d.is_cyclic_reference ? 1 : 0, d.ios_direct_framebuffer ? 1 : 0, d.texcoord_xform.scale[0], d.texcoord_xform.scale[1],
			d.texcoord_xform.scale[2], d.texcoord_xform.clamp ? 1 : 0, d.surface_cache_tag == W->rtts.write_tag ? 1 : 0);
	}

	void record_sections(const char* label)
	{
		sep();
		append("{\"k\":\"sections\",\"draw\":%llu,\"label\":\"%s\",\"hashes\":%llu,\"cpu_uploads\":%llu,\"list\":[",
			static_cast<unsigned long long>(W->draw), label, static_cast<unsigned long long>(host::hashes),
			static_cast<unsigned long long>(W->cache->cpu_uploads));
		bool first = true;
		W->cache->for_each_section([&](host::section& s)
		{
			if (!s.valid_range() && !s.exists()) return;
			append("%s[\"0x%x\",\"%s\",%d,%d,%u,%u,%u,%u,%u,%u,%d,%u,%u,%d,%llu,%llu,%llu,\"%016llx\"]", first ? "" : ",",
				s.valid_range() ? s.get_section_base() : 0, context_name(s.get_context()), s.is_dirty() ? 1 : 0, s.is_locked() ? 1 : 0,
				static_cast<u32>(s.get_protection()), s.get_gcm_format(), u32{s.get_width()}, u32{s.get_height()}, u32{s.get_depth()},
				s.get_rsx_pitch(), s.is_swizzled() ? 1 : 0, static_cast<u32>(s.get_view_flags()), static_cast<u32>(s.get_image_type()),
				s.exists() ? 1 : 0, static_cast<unsigned long long>(s.last_use_frame),
				static_cast<unsigned long long>(s.exists() ? s.vram_texture->id : 0),
				static_cast<unsigned long long>(s.exists() ? s.vram_texture->views.size() : 0),
				static_cast<unsigned long long>(s.exists() ? s.vram_texture->content : 0));
			first = false;
		});
		W->out += "]}";
	}

	template <typename Tex>
	void lookup_slot(u32 slot, const Tex& tex, [[maybe_unused]] u32 memo_flags)
	{
		auto& d = W->state[slot];
		if (!W->samplers_dirty && !W->slot_dirty[slot] &&
			(!tex.enabled() || !W->cache->sampler_requires_validation(slot, d)) &&
			!W->cache->test_if_descriptor_expired(W->cmd, W->rtts, &d, tex))
		{
			return;
		}
		W->slot_dirty[slot] = false;
		if (!tex.enabled())
		{
			d = {};
			record_lookup(slot, d, "disabled");
			return;
		}
#if CANDIDATE
		const auto before = counters_now();
		d = W->cache->upload_sampler_texture(W->cmd, tex, W->rtts, slot, memo_flags);
		record_lookup(slot, d, outcome_of(before));
#else
		const auto stamp = W->cache->prepare_sampler_validation(slot);
		d = W->cache->upload_texture(W->cmd, tex, W->rtts);
		W->cache->finish_sampler_validation(slot, d, stamp, W->rtts);
		record_lookup(slot, d, "control");
#endif
	}

	// VKGSRender::load_texture_env for the referenced slots.
	void load_textures(u32 fs_mask, u32 vs_mask = 0, u32 bx2_mask = 0)
	{
#if CANDIDATE
		if (W->samplers_dirty && memo::consolidated())
		{
			memo::sampler_refresh();
		}
#endif
		for (u32 ref = fs_mask; ref; ref &= ref - 1)
		{
			const u32 i = std::countr_zero(ref);
			rsx::fragment_texture tex(static_cast<u8>(i), W->regs);
#if CANDIDATE
			lookup_slot(i, tex, memo::fragment_flags(bx2_mask, i));
#else
			(void)bx2_mask;
			lookup_slot(i, tex, 0);
#endif
		}
		for (u32 ref = vs_mask; ref; ref &= ref - 1)
		{
			const u32 i = std::countr_zero(ref);
			rsx::vertex_texture tex(static_cast<u8>(i), W->regs);
#if CANDIDATE
			lookup_slot(16 + i, tex, memo::vertex_flag);
#else
			lookup_slot(16 + i, tex, 0);
#endif
		}
		W->samplers_dirty = false;
		W->draw++;
		record_sections("draw");
	}

#if CANDIDATE
	std::array<u64, 12> counters_now()
	{
		auto& c = memo::counters;
		return { c.hits.load(), c.verified.load(), c.miss_empty.load(), c.miss_epoch.load(), c.miss_revision.load(), c.miss_range.load(),
			c.miss_context.load(), c.miss_section.load(), c.miss_bound.load(), c.miss_disabled.load(), c.stores.load(), c.mismatches.load() };
	}

	std::string outcome_of(const std::array<u64, 12>& before)
	{
		const auto now = counters_now();
		static const char* names[] = { "hit", "verified", "miss_empty", "miss_epoch", "miss_revision", "miss_range", "miss_context",
			"miss_section", "miss_bound", "miss_disabled", "stored", "mismatch" };
		std::string result;
		for (usz i = 0; i < now.size(); ++i)
		{
			if (now[i] != before[i])
			{
				if (!result.empty()) result += "+";
				result += names[i];
			}
		}
		if (memo::current_mode() == memo::mode::off) return "off";
		return result.empty() ? "unstored" : result;
	}
#else
	std::array<u64, 12> counters_now() { return {}; }
	std::string outcome_of(const std::array<u64, 12>&) { return "control"; }
#endif

	void event(const char* what)
	{
		sep();
		append("{\"k\":\"event\",\"draw\":%llu,\"what\":\"%s\"}", static_cast<unsigned long long>(W->draw), what);
	}

	void begin_scenario(const char* name)
	{
		// Scenarios are independent: object ids and hash counts restart (a divergence stays in its scenario).
		host::next_id = 1;
		host::hashes = 0;
		W = new world();
		W->cache = std::make_unique<cache_t>();
		host::io_base = 0x00400000;
		host_seam::tiled = false;
		rpcs3::ios::texture_validation::epoch_enabled.store(true);
		rpcs3::ios::texture_validation_scope::enabled.store(true);
		rpcs3::ios::texture_residency::enabled.store(false);
		std::memset(vm::g_sudo_addr, 0, 0x03000000);
		g_json += g_first_scenario ? "" : ",";
		g_first_scenario = false;
		g_json += "\"";
		g_json += name;
		g_json += "\":[";
	}

	void end_scenario()
	{
		W->cache->clear();
		g_json += W->out;
		g_json += "]";
		delete W;
		W = nullptr;
	}

	u32 bump_filter(u32 unit) // a register rewrite that leaves the texture unchanged (FILTER)
	{
		const u32 index = NV4097_SET_TEXTURE_FILTER + unit * 8;
		W->regs[index] ^= 0x00000010; // bias bit: the unit is dirty, the lookup key is the same
		W->slot_dirty[unit] = true;
		return W->regs[index];
	}

	const tex_desc A{ .offset = 0x000000 }, B{ .offset = 0x010000 }, C_dxt{ .offset = 0x020000, .format = CELL_GCM_TEXTURE_COMPRESSED_DXT1 | CELL_GCM_TEXTURE_LN, .pitch = 128 };

	void prime(std::initializer_list<tex_desc> list, u32 seed = 1)
	{
		for (const auto& t : list)
		{
			fill(address_of(t), t.pitch * t.height, seed++ + t.offset);
		}
	}

	//@@SCENARIOS@@
}

int main(int argc, char** argv)
{
	drive::g_mode = argc > 1 ? argv[1] : "control";
#if CANDIDATE
	namespace memo = rpcs3::ios::texture_lookup_memo;
	rpcs3::ios::texture_validation::epoch_enabled.store(true);
	if (drive::g_mode == "off") memo::configure(memo::mode::off);
	else if (drive::g_mode == "verify_all") memo::configure(memo::mode::verify_all);
	else memo::configure(memo::mode::active);
#endif
	drive::run_all();
	std::printf("{\"mode\":\"%s\",\"scenarios\":{%s},\"log_errors\":%llu,\"texmemo_errors\":%llu",
		drive::g_mode.c_str(), drive::g_json.c_str(), static_cast<unsigned long long>(host_log::errors), static_cast<unsigned long long>(host_log::texmemo_errors));
#if CANDIDATE
	auto& c = memo::counters;
	std::printf(",\"memo\":{\"mode\":%u,\"disabled\":%d,\"lookups\":%llu,\"hits\":%llu,\"verified\":%llu,\"mismatches\":%llu,\"stores\":%llu,\"locks_avoided\":%llu,\"cpu_uploads\":%llu,\"first_reuses\":%llu}",
		static_cast<u32>(memo::current_mode()), memo::disabled.load() ? 1 : 0, (unsigned long long)c.lookups.load(), (unsigned long long)c.hits.load(),
		(unsigned long long)c.verified.load(), (unsigned long long)c.mismatches.load(), (unsigned long long)c.stores.load(),
		(unsigned long long)c.locks_avoided.load(), (unsigned long long)c.cpu_uploads.load(), (unsigned long long)c.first_reuses.load());
#endif
	std::printf("}\n");
	return 0;
}
