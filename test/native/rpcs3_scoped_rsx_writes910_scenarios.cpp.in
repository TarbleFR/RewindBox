	// Scenarios of test/rpcs3_scoped_rsx_writes910_test.py (inserted in namespace drive of the texture cache harness).
	// "scoped": the real body of VKGSRender::ios_rsx_wrote_guest_memory (REWINDBOX_SCOPED_RSX_UPLOADS_909) on the real
	// texture cache. "witness": the conservative default of rsx::thread (a new global epoch for every RSX write).
	inline bool g_scoped = false;

	struct renderer_under_test
	{
		cache_t& m_texture_cache;
		// rsx::thread::ios_rsx_wrote_guest_memory (RSXThread.cpp), extracted.
		void base(u32 address, u32 length, u8 epoch_source)
		//@@BASE_HOOK_BODY@@
		// VKGSRender::ios_rsx_wrote_guest_memory (VKGSRender.cpp), extracted; its base call names base().
		void ios_rsx_wrote_guest_memory(u32 address, u32 length, u8 epoch_source)
		//@@VK_HOOK_BODY@@
	};

	constexpr u8 source_inline = static_cast<u8>(rpcs3::ios::texture_validation::epoch_source::inline_upload);

	// The RSX method writes its bytes first, then reports the range (nv308a.cpp, nv0039.cpp).
	void rsx_wrote(u32 address, u32 length, const char* what)
	{
		renderer_under_test renderer{*W->cache};
		if (g_scoped) renderer.ios_rsx_wrote_guest_memory(address, length, source_inline);
		else renderer.base(address, length, source_inline);
		event(what);
	}

	void rsx_write(u32 address, u32 length, u32 seed, const char* what)
	{
		fill(address, length, seed);
		rsx_wrote(address, length, what);
	}

	const tex_desc N1{ .offset = 0x100000 }, N2{ .offset = 0x104000 }; // adjacent: N1 ends where N2 starts
	const tex_desc L{ .offset = 0x200000, .width = 256, .height = 256, .pitch = 1024 }; // 256 KiB: prehash eligible
	const tex_desc M{ .offset = 0x300000, .width = 256, .height = 256, .pitch = 1024 };
	const tex_desc Lv{ .offset = 0x200000, .width = 512, .height = 128, .pitch = 2048 }; // the range of L, another shape
	const tex_desc Aw{ .offset = 0x000000, .width = 32, .height = 128, .pitch = 128 };   // the range of A, another shape

	u32 size_of(const tex_desc& t) { return t.pitch * t.height; }

	// One draw with these fragment textures bound; what each slot serves is compared with guest memory now.
	void draw(std::initializer_list<std::pair<u32, const tex_desc*>> bound)
	{
		u32 mask = 0;
		for (const auto& [slot, t] : bound)
		{
			set_texture(slot, false, *t);
			mask |= 1u << slot;
		}
		load_textures(mask);
		for (const auto& [slot, t] : bound)
		{
			const auto& d = W->state[slot];
			const auto* img = d.image_handle ? d.image_handle->image() : nullptr;
			const u64 expected = host::hash_bytes(vm::g_sudo_addr + address_of(*t), size_of(*t));
			sep();
			append("{\"k\":\"served\",\"draw\":%llu,\"slot\":%u,\"content\":\"%016llx\",\"fresh\":%d}", static_cast<unsigned long long>(W->draw), slot,
				static_cast<unsigned long long>(img ? img->content : 0), img && !img->destroyed && img->content == expected ? 1 : 0);
		}
	}

	void work(const char* label)
	{
		sep();
		append("{\"k\":\"work\",\"label\":\"%s\",\"hashes\":%llu,\"uploads\":%llu,\"epoch\":%llu,\"prehash_hits\":%llu}", label,
			static_cast<unsigned long long>(host::hashes), static_cast<unsigned long long>(W->cache->cpu_uploads),
			static_cast<unsigned long long>(rpcs3::ios::texture_validation::validation_epoch.load()),
			static_cast<unsigned long long>(rpcs3::ios::texture_prehash::hits.load()));
	}

	// 1. Disjoint textures: a write over A re-uploads A; B, intact, is not hashed again (scoped).
	void s_disjoint()
	{
		begin_scenario("disjoint");
		prime({ A, B });
		draw({ {0, &A}, {1, &B} });
		draw({ {0, &A}, {1, &B} });
		work("before");
		rsx_write(address_of(A) + 128, 64, 501, "write_A");
		draw({ {0, &A}, {1, &B} }); // no register change: only the bindings bring the slots back
		draw({ {0, &A}, {1, &B} });
		rsx_write(address_of(B), size_of(B), 502, "write_B_whole");
		draw({ {0, &A}, {1, &B} });
		work("after");
		end_scenario();
	}

	// 2. Range limits on adjacent textures: straddling write, first byte, last byte, the bytes just outside.
	void s_limits()
	{
		begin_scenario("limits");
		prime({ N1, N2 });
		draw({ {0, &N1}, {1, &N2} });
		draw({ {0, &N1}, {1, &N2} });
		rsx_write(address_of(N2) - 16, 32, 601, "straddle_N1_N2");
		draw({ {0, &N1}, {1, &N2} });
		rsx_write(address_of(N2), 1, 602, "first_byte_N2");
		draw({ {0, &N1}, {1, &N2} });
		rsx_write(address_of(N2) + size_of(N2) - 1, 1, 603, "last_byte_N2");
		draw({ {0, &N1}, {1, &N2} });
		rsx_write(address_of(N1) - 1, 1, 604, "byte_before_N1");
		draw({ {0, &N1}, {1, &N2} });
		rsx_write(address_of(N2) + size_of(N2), 64, 605, "bytes_after_N2");
		draw({ {0, &N1}, {1, &N2} });
		rsx_write(address_of(N1) + size_of(N1) - 1, 1, 606, "last_byte_N1");
		draw({ {0, &N1}, {1, &N2} });
		work("after");
		end_scenario();
	}

	// 3. Several writes in one epoch, with and without a draw in between.
	void s_repeated()
	{
		begin_scenario("repeated");
		prime({ A, B });
		draw({ {0, &A}, {1, &B} });
		draw({ {0, &A}, {1, &B} });
		rsx_write(address_of(A), 256, 701, "write_A_1");
		draw({ {0, &A}, {1, &B} });
		rsx_write(address_of(A), 256, 702, "write_A_2");
		draw({ {0, &A}, {1, &B} });
		rsx_write(address_of(A) + 512, 16, 703, "write_A_3");
		rsx_write(address_of(A) + 1024, 16, 704, "write_A_4");
		draw({ {0, &A}, {1, &B} });
		rsx_write(address_of(A), 64, 705, "write_A_5");
		rsx_write(address_of(B), 64, 706, "write_B_1");
		draw({ {0, &A}, {1, &B} });
		rsx_write(address_of(A), 64, 705, "write_A_same_bytes"); // rewritten with the bytes already there
		draw({ {0, &A}, {1, &B} });
		work("after");
		end_scenario();
	}

	// 4. A prehash of the old bytes published after the write (a worker that read the epoch, then the bytes), and a
	// correct prehash of an intact texture. The stale one must never validate; the correct one saves the hash.
	void s_prehash_late()
	{
		begin_scenario("prehash_late");
		namespace prehash = rpcs3::ios::texture_prehash;
		namespace validation = rpcs3::ios::texture_validation;
		prehash::enabled.store(true);
		prime({ L, M });
		draw({ {0, &L}, {1, &M} });
		draw({ {0, &L}, {1, &M} });
		validation::advance_epoch(); event("guest_put");
		const u64 worker_epoch = validation::current_epoch();
		const u64 stale = host::hash_bytes(vm::g_sudo_addr + address_of(L), size_of(L)); // the worker's read, before the write
		rsx_write(address_of(L) + 4096, 512, 801, "write_L");
		prehash::publish(address_of(L), size_of(L), worker_epoch, stale); event("stale_prehash_published");
		prehash::publish(address_of(M), size_of(M), validation::current_epoch(),
			host::hash_bytes(vm::g_sudo_addr + address_of(M), size_of(M))); event("valid_prehash_M");
		work("published");
		draw({ {0, &L}, {1, &M} });
		work("first_draw");
		draw({ {0, &L}, {1, &M} });
		// Published again after the section of L was replaced; a section of the same range and another shape is created.
		prehash::publish(address_of(L), size_of(L), validation::current_epoch(), stale); event("stale_prehash_again");
		draw({ {0, &L}, {1, &M} });
		draw({ {0, &Lv}, {1, &M} });
		draw({ {0, &L}, {1, &M} });
		// A second write in the same epoch, the stale result still in the table.
		rsx_write(address_of(L) + 8192, 512, 802, "write_L_2");
		draw({ {0, &L}, {1, &M} });
		work("after");
		prehash::enabled.store(false);
		end_scenario();
	}

	// 5. Sections destroyed and created again around the writes.
	void s_recreate()
	{
		begin_scenario("destroy_recreate");
		prime({ A, B });
		draw({ {0, &A}, {1, &B} });
		draw({ {0, &A}, {1, &B} });
		W->cache->invalidate_range(W->cmd, range_of(A), rsx::invalidation_cause::committed_as_fbo); event("commit_as_fbo_A");
		rsx_write(address_of(A), 128, 901, "write_A_no_section");
		draw({ {0, &A}, {1, &B} });
		W->cache->purge_unreleased_sections(); event("purge_unreleased");
		rsx_write(address_of(B) + 64, 128, 902, "write_B");
		draw({ {0, &A}, {1, &B} });
		W->cache->handle_memory_pressure(rsx::problem_severity::severe); event("memory_pressure_severe");
		rsx_write(address_of(A) + 300, 8, 903, "write_A_after_pressure");
		draw({ {0, &A}, {1, &B} });
		draw({ {0, &A}, {1, &B} });
		work("after");
		end_scenario();
	}

	// 6. Two shapes over one guest range (two sections): one write, both revalidated.
	void s_alias()
	{
		begin_scenario("alias");
		prime({ A });
		draw({ {0, &A}, {1, &Aw} });
		draw({ {0, &A}, {1, &Aw} });
		rsx_write(address_of(A) + 2048, 32, 1001, "write_shared_range");
		draw({ {0, &A}, {1, &Aw} });
		rsx_write(address_of(A) + 16, 32, 1002, "write_shared_range_2");
		draw({ {1, &Aw} });
		draw({ {0, &A}, {1, &Aw} });
		work("after");
		end_scenario();
	}

	// 7. What the hook does not scope: an empty range, a range that wraps, the scope off. A new epoch each.
	void s_fallback()
	{
		begin_scenario("fallback");
		prime({ A, B });
		draw({ {0, &A}, {1, &B} });
		draw({ {0, &A}, {1, &B} });
		work("before");
		rsx_wrote(address_of(A), 0, "empty_range");
		work("empty_range");
		fill(address_of(A), 64, 1101);
		rsx_wrote(0xffffff00u, 0x200, "wrapping_range");
		work("wrapping_range");
		draw({ {0, &A}, {1, &B} });
		rpcs3::ios::texture_validation_scope::enabled.store(false);
		rsx_write(address_of(A), 64, 1102, "scope_off");
		work("scope_off");
		draw({ {0, &A}, {1, &B} });
		rpcs3::ios::texture_validation_scope::enabled.store(true);
		work("after");
		end_scenario();
	}

	void run_all()
	{
		for (auto scenario : { s_disjoint, s_limits, s_repeated, s_prehash_late, s_recreate, s_alias, s_fallback })
		{
			scenario();
		}
	}
}

int main(int argc, char** argv)
{
	namespace memo = rpcs3::ios::texture_lookup_memo;
	drive::g_mode = argc > 1 ? argv[1] : "witness";
	drive::g_scoped = drive::g_mode == "scoped";
	rpcs3::ios::texture_validation::epoch_enabled.store(true);
	memo::configure(argc > 2 && std::string_view(argv[2]) == "memo" ? memo::mode::active : memo::mode::off);
	drive::run_all();
	std::printf("{\"mode\":\"%s\",\"scenarios\":{%s},\"log_errors\":%llu,\"scoped_rsx_writes\":%llu}\n", drive::g_mode.c_str(), drive::g_json.c_str(),
		static_cast<unsigned long long>(host_log::errors),
		static_cast<unsigned long long>(rpcs3::ios::texture_validation::scoped_rsx_writes.load()));
	return 0;
}
