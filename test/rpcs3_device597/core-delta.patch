+	if (!still_current()) return false;
+	const std::size_t stripes = ((size - 1) - blocks * block_size) / XXH_STRIPE_LEN;
+	Accumulate(acc, input + blocks * block_size, secret, stripes);
+	XXH3_accumulate_512(acc, input + size - XXH_STRIPE_LEN,
+		secret + secret_size - XXH_STRIPE_LEN - XXH_SECRET_LASTACC_START);
+	processed = size;
+	if (!still_current()) return false;
+	hash = XXH3_mergeAccs(acc, secret + XXH_SECRET_MERGEACCS_START,
+		static_cast<xxh_u64>(size) * XXH_PRIME64_1);
