diff --git a/rpcs3/ios/IOSFrameTrace.h b/rpcs3/ios/IOSFrameTrace.h
new file mode 100644
index 0000000..2a1e153
--- /dev/null
+++ b/rpcs3/ios/IOSFrameTrace.h
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+// Diagnostic observations only. Nothing in emulation consumes these values.
+// A frame-end record uses the existing sampled stage timers. Wait hooks add
+// owner-thread integers only, with no additional clock read or allocation.
+namespace rpcs3::ios::frame_trace
+{
+inline std::atomic<std::uint64_t> active_session{0};
+
+struct Waits
+{
+    std::uint64_t fence_ticks = 0, submit_ticks = 0, drawable_ticks = 0, present_ticks = 0;
+    std::uint64_t semaphore_us = 0, pipeline_us = 0;
+};
+inline thread_local Waits thread_waits{};
+inline thread_local std::uint64_t thread_session = 0;
+
+inline Waits& waits() noexcept
+{
+    const auto session = active_session.load(std::memory_order_relaxed);
+    if (thread_session != session)
+    {
+        thread_session = session;
+        thread_waits = {};
+    }
+    return thread_waits;
+}
+
+inline Waits take_thread_waits() noexcept
+{
+    auto& pending = waits();
+    const auto result = pending;
+    pending = {};
+    return result;
+}
+
+inline std::uint64_t microseconds(std::uint64_t ticks, std::uint64_t frequency) noexcept
+{
+    if (!frequency) return 0;
+    const auto seconds = ticks / frequency;
+    const auto remainder = ticks % frequency;
+    constexpr auto maximum = std::numeric_limits<std::uint64_t>::max();
+    if (seconds > maximum / 1'000'000) return maximum;
+    const auto fraction = remainder <= maximum / 1'000'000
+        ? remainder * 1'000'000 / frequency
+        : static_cast<std::uint64_t>(static_cast<long double>(remainder) * 1'000'000 / frequency);
+    const auto whole = seconds * 1'000'000;
+    return fraction > maximum - whole ? maximum : whole + fraction;
+}
+
+struct Progress
+{
+    double wall_guest_fps = 0.0, completed_interval_fps = 0.0, last_guest_flip_age_ms = -1.0;
+};
+
+inline Progress progress(std::uint64_t flips, double window_ms,
+    std::uint64_t intervals, std::uint64_t interval_us,
+    std::uint64_t last_flip_ticks, std::uint64_t now_ticks, std::uint64_t frequency) noexcept
+{
+    Progress result;
+    if (window_ms > 0.0) result.wall_guest_fps = static_cast<double>(flips) * 1000.0 / window_ms;
+    if (interval_us) result.completed_interval_fps = static_cast<double>(intervals) * 1'000'000.0 / interval_us;
+    if (last_flip_ticks && frequency && now_ticks >= last_flip_ticks)
+        result.last_guest_flip_age_ms = microseconds(now_ticks - last_flip_ticks, frequency) / 1000.0;
+    return result;
+}
+
+struct Frame
+{
+    std::uint64_t session = 0, frame = 0, begin_ticks = 0, end_ticks = 0, frequency = 0;
+    std::uint64_t interval_us = 0, draws = 0, submits = 0, vertex_requests = 0, vertex_misses = 0;
+    std::uint64_t setup_us = 0, vertex_us = 0, texture_us = 0, execution_us = 0, flip_us = 0;
+    Waits waits{};
+    bool interval_available = false, stages_sampled = false, forced = false;
+};
+
+class Profile final
+{
+public:
+    static constexpr std::size_t per_group = 4;
+    static constexpr std::size_t capacity = 2 * per_group;
+    static constexpr std::uint64_t slow_threshold_us = 35'000;
+    struct Snapshot
+    {
+        bool captured = false;
+        std::uint64_t session = 0, frames = 0, slow = 0, sampled = 0, unretained = 0, contended = 0;
+        std::size_t size = 0;
+        std::array<Frame, capacity> events{};
+    };
+
+    // Lifecycle owner, after the previous RSX producer has stopped. Serialized
+    // with report take() by performance_registry's existing profile mutex.
+    void reset(std::uint64_t session)
+    {
+        std::lock_guard lock(mutex_);
+        session_ = session;
+        previous_ticks_ = 0;
+        frames_ = slow_ = sampled_ = eligible_ = 0;
+        slow_size_ = sampled_size_ = 0;
+        contended_.store(0, std::memory_order_relaxed);
+        active_session.store(session, std::memory_order_release);
+    }
+
+    // One RSX producer. The baseline advances even if the diagnostic buffer
+    // is busy, so a missed observation cannot manufacture a long interval.
+    void record(Frame event) noexcept
+    {
+        event.begin_ticks = previous_ticks_;
+        previous_ticks_ = event.end_ticks;
+        event.interval_available = event.begin_ticks && event.frequency && event.end_ticks >= event.begin_ticks;
+        event.interval_us = event.interval_available
+            ? microseconds(event.end_ticks - event.begin_ticks, event.frequency) : 0;
+        if (!mutex_.try_lock())
+        {
+            contended_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        std::lock_guard lock(mutex_, std::adopt_lock);
+        if (!session_) return;
+        event.session = session_;
+        ++frames_;
+        const bool slow = event.interval_available && event.interval_us >= slow_threshold_us;
+        slow_ += slow;
+        sampled_ += event.stages_sampled;
+        eligible_ += slow || event.stages_sampled;
+        if (slow) retain(slow_events_, slow_size_, event);
+        if (event.stages_sampled) retain(sampled_events_, sampled_size_, event);
+    }
+
+    // Keep four worst intervals plus four worst sampled frames. Deduplicate a
+    // frame retained by both groups. Unretained is explicit, never silence
+    // interpreted as absence of stutter. The sampler never waits for RSX.
+    Snapshot take() noexcept
+    {
+        Snapshot result;
+        if (!mutex_.try_lock()) return result;
+        std::lock_guard lock(mutex_, std::adopt_lock);
+        result.captured = true;
+        result.session = session_;
+        result.frames = frames_;
+        result.slow = slow_;
+        result.sampled = sampled_;
+        result.contended = contended_.exchange(0, std::memory_order_relaxed);
+        for (std::size_t i = 0; i < slow_size_; ++i) result.events[result.size++] = slow_events_[i];
+        for (std::size_t i = 0; i < sampled_size_; ++i)
+        {
+            const auto& event = sampled_events_[i];
+            bool duplicate = false;
+            for (std::size_t j = 0; j < result.size; ++j)
+                duplicate |= result.events[j].end_ticks == event.end_ticks && result.events[j].frame == event.frame;
+            if (!duplicate) result.events[result.size++] = event;
+        }
+        result.unretained = eligible_ >= result.size ? eligible_ - result.size : 0;
+        std::sort(result.events.begin(), result.events.begin() + result.size,
+            [](const Frame& a, const Frame& b) { return a.end_ticks < b.end_ticks; });
+        frames_ = slow_ = sampled_ = eligible_ = 0;
+        slow_size_ = sampled_size_ = 0;
+        return result;
+    }
+
+private:
+    static void retain(std::array<Frame, per_group>& events, std::size_t& size, const Frame& event) noexcept
+    {
+        if (size < events.size()) { events[size++] = event; return; }
+        const auto smallest = std::min_element(events.begin(), events.end(),
+            [](const Frame& a, const Frame& b) { return a.interval_us < b.interval_us; });
+        if (smallest->interval_us <= event.interval_us) *smallest = event;
+    }
+
+    std::mutex mutex_;
+    std::atomic<std::uint64_t> contended_{0};
+    std::uint64_t session_ = 0, previous_ticks_ = 0;
+    std::uint64_t frames_ = 0, slow_ = 0, sampled_ = 0, eligible_ = 0;
+    std::size_t slow_size_ = 0, sampled_size_ = 0;
+    std::array<Frame, per_group> slow_events_{}, sampled_events_{};
+};
+inline Profile profile;
+}
diff --git a/rpcs3/ios/IOSRendererCausality.h b/rpcs3/ios/IOSRendererCausality.h
new file mode 100644
index 0000000..0ec4dd8
--- /dev/null
+++ b/rpcs3/ios/IOSRendererCausality.h
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+// Bounded observations of corrected renderer decisions. No guest-memory reads,
+// driver calls, allocations or logging. The RSX producer never waits for the
+// reporting thread. Counts include events rejected at capacity; contention is
+// separately counted because its kind/reasons could not be safely attributed.
+namespace rpcs3::ios::renderer_causality
+{
+enum class Kind : std::uint32_t { vertex_range, sampler_refresh, sampler_cyclic_fast, count };
+enum Reason : std::uint32_t
+{
+    source_range = 1u << 0,
+    validity = 1u << 1,
+    coordinates = 1u << 2,
+    clamp = 1u << 3,
+    dimension = 1u << 4,
+    samples = 1u << 5,
+    format = 1u << 6,
+    cyclic = 1u << 7,
+};
+inline constexpr std::size_t reason_count = 8;
+inline constexpr std::size_t event_capacity = 8;
+// Reserve observations for both defects even when one dominates a window.
+inline constexpr std::array<std::size_t, 3> event_budgets{2, 4, 2};
+
+struct SamplerState
+{
+    // Bit patterns of scale[3], bias[3], active clamp_min[2]/clamp_max[2].
+    // Inactive clamp values are zero; no uninitialized descriptor bytes are read.
+    std::array<std::uint32_t, 10> coordinates{};
+    std::uint32_t dimension = 0, format_class = 0, format_features = 0, texel_remap_control = 0;
+    std::uint8_t samples = 1;
+    bool cyclic = false, clamp = false, valid = false;
+
+    template <typename State>
+    static SamplerState from(const State& state) noexcept
+    {
+        return {state.coordinates, state.dimension, state.format_class,
+            state.format_features, state.texel_remap_control, state.samples,
+            state.cyclic, state.clamp, state.valid};
+    }
+};
+
+template <typename State>
+inline std::uint32_t changed_reasons(const State& before, const State& after, bool vertex) noexcept
+{
+    if (before.valid != after.valid) return validity;
+    if (!before.valid) return 0;
+    std::uint32_t result = 0;
+    if (before.dimension != after.dimension) result |= dimension;
+    if (before.format_class != after.format_class) result |= format;
+    if (before.samples != after.samples) result |= samples;
+    if (vertex) return result;
+    if (before.cyclic != after.cyclic) result |= cyclic;
+    for (std::size_t i = 0; i < 6; ++i)
+        if (before.coordinates[i] != after.coordinates[i]) result |= coordinates;
+    if (before.clamp != after.clamp) result |= clamp;
+    if (before.clamp && after.clamp)
+        for (std::size_t i = 6; i < before.coordinates.size(); ++i)
+            if (before.coordinates[i] != after.coordinates[i]) result |= clamp;
+    if (before.format_features != after.format_features ||
+        before.texel_remap_control != after.texel_remap_control) result |= format;
+    return result;
+}
+
+struct Event
+{
+    std::uint64_t session = 0, monotonic_us = 0, frame = 0;
+    Kind kind{};
+    std::uint32_t reasons = 0, draw = 0, fragment_offset = 0, vertex_start = 0;
+    std::uint32_t slot = 0, old_resource = 0, new_resource = 0;
+    bool vertex = false;
+    // vertex_range describes differing cache keys, not proven visible corruption.
+    std::uint32_t legacy_address = 0, actual_address = 0, bytes = 0;
+    std::uint32_t draw_first = 0, source_first = 0, count = 0, stride = 0;
+    bool cache_hit = false;
+    SamplerState before{}, after{};
+};
+
+class Profile final
+{
+    std::mutex mutex_;
+    std::uint64_t session_ = 0;
+    std::array<Event, event_capacity> events_{};
+    std::size_t size_ = 0;
+    std::array<std::uint64_t, static_cast<std::size_t>(Kind::count)> counts_{};
+    std::array<std::size_t, static_cast<std::size_t>(Kind::count)> kept_{};
+    std::array<std::uint64_t, reason_count> reasons_{};
+    std::uint64_t full_dropped_ = 0;
+    std::atomic<std::uint64_t> contended_{0};
+
+public:
+    struct Snapshot
+    {
+        bool captured = false;
+        std::uint64_t session = 0;
+        std::array<Event, event_capacity> events{};
+        std::size_t size = 0;
+        std::array<std::uint64_t, static_cast<std::size_t>(Kind::count)> counts{};
+        std::array<std::uint64_t, reason_count> reasons{};
+        std::uint64_t dropped = 0, contended = 0;
+    };
+
+    template <typename Fill>
+    bool record(Kind kind, std::uint32_t reasons, Fill&& fill) noexcept
+    {
+        reasons &= (1u << reason_count) - 1;
+        if (!reasons || kind >= Kind::count) return false;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock)
+        {
+            contended_.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        if (!session_) return false;
+        const auto index = static_cast<std::size_t>(kind);
+        ++counts_[index];
+        for (std::size_t bit = 0; bit < reason_count; ++bit)
+            reasons_[bit] += bool(reasons & (1u << bit));
+        if (size_ == events_.size() || kept_[index] == event_budgets[index])
+        {
+            ++full_dropped_;
+            return false;
+        }
+        auto& event = events_[size_++];
+        ++kept_[index];
+        event = {};
+        event.session = session_;
+        event.kind = kind;
+        event.reasons = reasons;
+        // Only retained events pay for a clock read or the caller's context copy.
+        event.monotonic_us = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+        fill(event);
+        return true;
+    }
+
+    // Called from the profiler's session reset, outside the RSX hot path.
+    // All retained events and attributed counts are cleared together. A
+    // concurrent rejected attempt can straddle the reset only in contended.
+    void reset(std::uint64_t session) noexcept
+    {
+        std::lock_guard lock(mutex_);
+        session_ = session;
+        size_ = 0;
+        counts_ = {};
+        kept_ = {};
+        reasons_ = {};
+        full_dropped_ = 0;
+        contended_.store(0, std::memory_order_relaxed);
+    }
+
+    Snapshot take() noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return {};
+        Snapshot result;
+        result.captured = true;
+        result.session = session_;
+        result.events = events_;
+        result.size = size_;
+        result.counts = counts_;
+        result.reasons = reasons_;
+        result.contended = contended_.exchange(0, std::memory_order_relaxed);
+        result.dropped = full_dropped_ + result.contended;
+        size_ = 0;
+        counts_ = {};
+        kept_ = {};
+        reasons_ = {};
+        full_dropped_ = 0;
+        return result;
+    }
+};
+inline constinit Profile profile;
+}
