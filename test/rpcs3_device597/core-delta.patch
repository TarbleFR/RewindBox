+// The pinned xxHash block, scramble, final-stripe and merge operations remain
+// unchanged. Only speculative work gets a cancellation point between groups
+// of 64 complete 1024-byte blocks; no streaming buffer or allocation is used.
+template <XXH3_f_accumulate Accumulate, XXH3_f_scrambleAcc Scramble, typename StillCurrent>
+bool hash_long_cancellable(const void* source, std::size_t size,
+	const void* secret_source, StillCurrent&& still_current,
+	std::uint64_t& hash, std::size_t& processed) noexcept
+{
+	constexpr std::size_t secret_size = XXH3_SECRET_DEFAULT_SIZE;
+	constexpr std::size_t stripes_per_block =
+		(secret_size - XXH_STRIPE_LEN) / XXH_SECRET_CONSUME_RATE;
+	constexpr std::size_t block_size = XXH_STRIPE_LEN * stripes_per_block;
+	static_assert(block_size == 1024);
