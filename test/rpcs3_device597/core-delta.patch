+inline void latch_stall(watch_token token, std::uint32_t observed, std::uint64_t now_us) noexcept
+{
+	stalls_total.fetch_add(1, std::memory_order_relaxed);
+	auto value = snapshot();
+	if (value.session != token.session || !value.enabled)
+	{
+		stale_session_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	// A busy watch slot must not change the identity of the incident. Unknown
+	// start/watch timestamps remain zero rather than borrowing another acquire.
+	if (value.watch.acquire_sequence != token.acquire_sequence)
+		value.watch = {token.session, token.acquire_sequence, 0, 0, now_us, token.address, token.expected, observed, true, true};
+	value.watch.observed = observed;
+	value.watch.published_us = now_us;
+	value.watch.active = value.watch.stalled = true;
+	if (!retained_stall.try_lock())
+	{
+		stall_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	if (retained_stall.value.pending)
+		stall_overwritten.fetch_add(1, std::memory_order_relaxed);
+	retained_stall.value = {value, true};
+	retained_stall.unlock();
+	stall_latched.fetch_add(1, std::memory_order_relaxed);
+}
+
+// Called only when the reporter's detail-rate quota allows a dump. Resolution
+// and ordinary ring eviction never consume this snapshot of the actual stall.
+inline bool take_stall_snapshot(snapshot_result& out) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+		return false;
+	if (!retained_stall.try_lock())
+	{
+		read_busy.fetch_add(1, std::memory_order_relaxed);
+		return false;
+	}
+	const bool valid = retained_stall.value.pending &&
+		retained_stall.value.snapshot.session == current_session.load(std::memory_order_acquire);
+	if (valid)
+		out = retained_stall.value.snapshot;
+	retained_stall.value.pending = false;
+	retained_stall.unlock();
+	return valid;
+}
