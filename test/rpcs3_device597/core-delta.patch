+	for (std::size_t block = 0; block < blocks;)
+	{
+		if (!still_current()) return false;
+		const std::size_t end = std::min(block + 64, blocks);
+		do
+		{
+			Accumulate(acc, input + block * block_size, secret, stripes_per_block);
+			Scramble(acc, secret + secret_size - XXH_STRIPE_LEN);
+		} while (++block < end);
+		processed = block * block_size;
+	}
