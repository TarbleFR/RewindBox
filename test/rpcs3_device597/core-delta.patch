diff --git a/rpcs3/ios/IOSSignalTrace.h b/rpcs3/ios/IOSSignalTrace.h
new file mode 100644
index 0000000..ca7a32c
--- /dev/null
+++ b/rpcs3/ios/IOSSignalTrace.h
@@ -0,0 +1,375 @@
+#pragma once
+
+// Bounded provenance for one recently acquired non-flip RSX label. This is
+// observational: a completed DMA range does not establish its written value.
+// No additional guest-memory read is performed to guess that value.
+// PPU direct stores, deferred GPU commits and reservation stores are outside
+// this coverage. Absence of a record is never proof of absence of a write.
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rpcs3::ios::signal_trace
+{
+
+inline constexpr std::size_t history_capacity = 64;
+inline constexpr std::size_t producer_capacity = 32;
+inline constexpr std::size_t queue_capacity = 16;
+
+enum class event_kind : std::uint32_t
+{
+	acquire = 1, stalled, resolved, aborted,
+	rsx_release_requested, rsx_cpu_commit, rsx_gpu_deferred,
+	spu_dma_commit, spu_list_commit,
+};
+
+enum class producer_phase : std::uint32_t
+{
+	mfc_blocked = 1, mfc_woke, mfc_irq, mfc_stopped, mfc_ready,
+};
+
+struct watch_state
+{
+	std::uint64_t session{}, acquire_sequence{}, watch_since_us{}, acquire_start_us{}, published_us{};
+	std::uint32_t address{}, expected{}, observed{};
+	bool active{}, stalled{};
+};
+
+struct watch_token
+{
+	std::uint64_t session{}, acquire_sequence{};
+	std::uint32_t address{}, expected{};
+	explicit operator bool() const noexcept { return session != 0; }
+};
+
+struct event
+{
+	std::uint64_t session{}, sequence{}, acquire_sequence{}, timestamp_us{};
+	event_kind kind{};
+	std::uint32_t address{}, expected{}, value{}, producer_id{}, pc{}, write_address{}, write_size{}, command{};
+	// True only for the argument of an executed CPU atomic label store.
+	// DMA records contain a completed range, without an extra guest-memory read.
+	bool value_is_written_argument{};
+	bool value_valid{true};
+};
+
+struct queue_entry
+{
+	std::uint32_t cmd{}, tag{}, lsa{}, eal{}, size{};
+};
+
+struct producer_state
+{
+	std::uint64_t session{}, serial{}, published_us{}, blocked_since_us{}, last_progress_us{};
+	std::uint32_t id{}, pc{}, return_pc{}, size{}, barrier{}, fence{}, stall_mask{}, tag_mask{}, tag_update{};
+	std::uint32_t event_bits{}, event_mask{}, event_count{}, event_waiting{}, interrupts_enabled{}, snr1_count{}, snr2_count{};
+	producer_phase phase{};
+	queue_entry unaccepted{};
+	std::array<queue_entry, queue_capacity> queue{};
+};
+
+template <typename T>
+struct guarded
+{
+	std::atomic_flag busy = ATOMIC_FLAG_INIT;
+	T value{};
+	bool try_lock() noexcept { return !busy.test_and_set(std::memory_order_acquire); }
+	void unlock() noexcept { busy.clear(std::memory_order_release); }
+};
+
+struct counters
+{
+	std::uint64_t events_published{}, events_dropped{}, history_overwritten{}, stale_session_dropped{};
+	std::uint64_t producer_published{}, producer_dropped{}, producer_replaced{}, read_busy{}, watch_changes{};
+	std::uint64_t stalls_total{}, stall_latched{}, stall_overwritten{}, stall_dropped{};
+};
+
+// Counters are process totals, deliberately not reset while old producers can
+// still finish. Session tags isolate payloads, including writes in flight at a
+// reset. Sequence/serial values are process-unique and support deduplication.
+inline std::atomic<bool> enabled{false};
+inline std::atomic<std::uint64_t> current_session{}, next_event{}, next_acquire{}, next_producer{};
+inline std::atomic<std::uint32_t> watched_address{};
+inline guarded<watch_state> watch{};
+inline std::array<guarded<event>, history_capacity> history{};
+inline std::array<guarded<producer_state>, producer_capacity> producers{};
+inline std::atomic<std::uint64_t> events_published{}, events_dropped{}, history_overwritten{}, stale_session_dropped{};
+inline std::atomic<std::uint64_t> producer_published{}, producer_dropped{}, producer_replaced{}, read_busy{}, watch_changes{};
+inline std::atomic<std::uint64_t> stalls_total{}, stall_latched{}, stall_overwritten{}, stall_dropped{};
+
+inline void latch_stall(watch_token token, std::uint32_t observed, std::uint64_t now_us) noexcept;
+
+inline void reset(std::uint64_t session, bool active) noexcept
+{
+	// The profiler supplies a new monotonically increasing session ID for
+	// every start/restore. Old in-flight publications retain their old ID.
+	enabled.store(false, std::memory_order_release);
+	current_session.store(session, std::memory_order_release);
+	watched_address.store(0, std::memory_order_release);
+	enabled.store(active && session != 0, std::memory_order_release);
+}
+
+inline void append(event value) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed) || value.session != current_session.load(std::memory_order_acquire))
+	{
+		stale_session_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	value.sequence = next_event.fetch_add(1, std::memory_order_relaxed) + 1;
+	auto& slot = history[(value.sequence - 1) % history_capacity];
+	if (!slot.try_lock())
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	if (slot.value.sequence > value.sequence)
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+	}
+	else
+	{
+		if (slot.value.sequence)
+			history_overwritten.fetch_add(1, std::memory_order_relaxed);
+		slot.value = value;
+		events_published.fetch_add(1, std::memory_order_relaxed);
+	}
+	slot.unlock();
+}
+
+inline watch_token begin_acquire(std::uint32_t address, std::uint32_t expected, std::uint32_t observed, std::uint64_t now_us) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+		return {};
+	const auto session = current_session.load(std::memory_order_acquire);
+	if (!watch.try_lock())
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+		return {};
+	}
+	const bool changed = watch.value.session != session || watch.value.address != address;
+	if (changed)
+		watch_changes.fetch_add(1, std::memory_order_relaxed);
+	watch_state value{session, next_acquire.fetch_add(1, std::memory_order_relaxed) + 1,
+		changed ? now_us : watch.value.watch_since_us, now_us, now_us, address, expected, observed,
+		observed != expected, false};
+	watch.value = value;
+	watched_address.store(address, std::memory_order_release);
+	watch.unlock();
+	append({session, 0, value.acquire_sequence, now_us, event_kind::acquire, address, expected, observed});
+	return {session, value.acquire_sequence, address, expected};
+}
+
+inline void acquire_state(watch_token token, event_kind kind, std::uint32_t observed, std::uint64_t now_us) noexcept
+{
+	if (!token)
+		return;
+	if (watch.try_lock())
+	{
+		if (watch.value.session == token.session && watch.value.acquire_sequence == token.acquire_sequence)
+		{
+			watch.value.observed = observed;
+			watch.value.published_us = now_us;
+			watch.value.stalled = kind == event_kind::stalled;
+			watch.value.active = kind == event_kind::stalled;
+		}
+		watch.unlock();
+	}
+	else
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+	}
+	append({token.session, 0, token.acquire_sequence, now_us, kind, token.address, token.expected, observed});
+	if (kind == event_kind::stalled)
+		latch_stall(token, observed, now_us);
+}
+
+inline watch_token overlap(std::uint32_t address, std::uint32_t size) noexcept
+{
+	if (!size || !enabled.load(std::memory_order_relaxed))
+		return {};
+	const auto target = watched_address.load(std::memory_order_acquire);
+	// Widen before addition: an invalid wrap must not match an unrelated label.
+	if (!target || std::uint64_t(address) >= std::uint64_t(target) + 4 || std::uint64_t(address) + size <= target)
+		return {};
+	if (!watch.try_lock())
+	{
+		events_dropped.fetch_add(1, std::memory_order_relaxed);
+		return {};
+	}
+	const auto value = watch.value;
+	watch.unlock();
+	if (value.address != target || value.session != current_session.load(std::memory_order_acquire))
+		return {};
+	return {value.session, value.acquire_sequence, target, value.expected};
+}
+
+inline void write_event(watch_token token, event_kind kind, std::uint32_t value, std::uint64_t now_us,
+	std::uint32_t address, std::uint32_t size, std::uint32_t id = 0, std::uint32_t pc = 0, std::uint32_t command = 0) noexcept
+{
+	if (token)
+		append({token.session, 0, token.acquire_sequence, now_us, kind, token.address, token.expected,
+			value, id, pc, address, size, command, kind == event_kind::rsx_cpu_commit,
+			kind != event_kind::spu_dma_commit && kind != event_kind::spu_list_commit});
+}
+
+inline void publish_producer(producer_state value) noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed))
+		return;
+	if (!value.session || value.session != current_session.load(std::memory_order_acquire))
+	{
+		stale_session_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	auto& slot = producers[value.id % producer_capacity];
+	if (!slot.try_lock())
+	{
+		producer_dropped.fetch_add(1, std::memory_order_relaxed);
+		return;
+	}
+	const bool previous = slot.value.session == value.session && slot.value.id == value.id;
+	if (previous)
+	{
+		value.last_progress_us = value.size < slot.value.size ? value.published_us : slot.value.last_progress_us;
+		value.blocked_since_us = value.phase == producer_phase::mfc_blocked && slot.value.phase == producer_phase::mfc_blocked
+			? slot.value.blocked_since_us : value.published_us;
+	}
+	else if (slot.value.serial)
+	{
+		producer_replaced.fetch_add(1, std::memory_order_relaxed);
+	}
+	if (!value.blocked_since_us && value.phase == producer_phase::mfc_blocked)
+		value.blocked_since_us = value.published_us;
+	value.serial = next_producer.fetch_add(1, std::memory_order_relaxed) + 1;
+	slot.value = value;
+	slot.unlock();
+	producer_published.fetch_add(1, std::memory_order_relaxed);
+}
+
+struct summary_result
+{
+	std::uint64_t session{};
+	bool enabled{};
+	watch_state watch{};
+	counters totals{};
+};
+
+inline summary_result summary() noexcept
+{
+	summary_result out{};
+	out.session = current_session.load(std::memory_order_acquire);
+	out.enabled = enabled.load(std::memory_order_relaxed);
+	if (watch.try_lock())
+	{
+		if (watch.value.session == out.session)
+			out.watch = watch.value;
+		watch.unlock();
+	}
+	else
+		read_busy.fetch_add(1, std::memory_order_relaxed);
+	out.totals = {events_published.load(), events_dropped.load(), history_overwritten.load(), stale_session_dropped.load(),
+		producer_published.load(), producer_dropped.load(), producer_replaced.load(), read_busy.load(), watch_changes.load(),
+		stalls_total.load(), stall_latched.load(), stall_overwritten.load(), stall_dropped.load()};
+	return out;
+}
+
+struct snapshot_result : summary_result
+{
+	std::array<event, history_capacity> events{};
+	std::array<producer_state, producer_capacity> producers{};
+	std::size_t event_count{}, producer_count{};
+};
+
+// Non-destructive. Ordinary reporting uses summary(); details are sampled only
+// on a bounded stall report. The caller sorts/deduplicates by event sequence
+// and producer serial, and must label snapshot age rather than call it live.
+inline snapshot_result snapshot() noexcept
+{
+	snapshot_result out{};
+	static_cast<summary_result&>(out) = summary();
+	for (auto& slot : history)
+	{
+		if (slot.try_lock())
+		{
+			if (slot.value.session == out.session && slot.value.sequence)
+				out.events[out.event_count++] = slot.value;
+			slot.unlock();
+		}
+		else
+			read_busy.fetch_add(1, std::memory_order_relaxed);
+	}
+	for (auto& slot : producers)
+	{
+		if (slot.try_lock())
+		{
+			if (slot.value.session == out.session && slot.value.serial)
+				out.producers[out.producer_count++] = slot.value;
+			slot.unlock();
+		}
+		else
+			read_busy.fetch_add(1, std::memory_order_relaxed);
+	}
+	return out;
+}
+
+struct retained_stall_state
+{
+	snapshot_result snapshot{};
+	bool pending{};
+};
+
+inline guarded<retained_stall_state> retained_stall{};
+static_assert(sizeof(history) + sizeof(producers) + sizeof(watch) + sizeof(retained_stall) <= 40 * 1024);
