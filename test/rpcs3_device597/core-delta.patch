diff --git a/rpcs3/Emu/RSX/VK/vkutils/sampler_shader_state.hpp b/rpcs3/Emu/RSX/VK/vkutils/sampler_shader_state.hpp
new file mode 100644
index 0000000..f8fb59f
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/sampler_shader_state.hpp
@@ -0,0 +1,91 @@
+#pragma once
+
+#include "../../Common/TextureUtils.h"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace vk
+{
+	// A texture can be rebound to a different host subresource without a guest
+	// sampler-register write. Keep only the descriptor fields consumed by shader
+	// selection/uniform preparation; do not copy deferred image lists or pixels.
+	struct sampler_shader_state
+	{
+		std::array<std::uint32_t, 10> coordinates{};
+		std::uint32_t dimension = 0;
+		std::uint32_t format_class = 0;
+		std::uint32_t format_features = 0;
+		std::uint32_t texel_remap_control = 0;
+		std::uint8_t samples = 1;
+		bool cyclic = false;
+		bool clamp = false;
+		bool valid = false;
+
+		template <typename Descriptor>
+		static sampler_shader_state capture_vertex(const Descriptor& descriptor)
+		{
+			sampler_shader_state result;
+			result.valid = descriptor.validate();
+			if (!result.valid)
+			{
+				return result;
+			}
+
+			result.dimension = static_cast<std::uint32_t>(descriptor.image_type);
+			result.format_class = static_cast<std::uint32_t>(descriptor.format_class);
+			result.samples = descriptor.samples;
+			return result;
+		}
+
+		template <typename Descriptor>
+		static sampler_shader_state capture_fragment(const Descriptor& descriptor)
+		{
+			auto result = capture_vertex(descriptor);
+			if (!result.valid)
+			{
+				return result;
+			}
+			result.cyclic = descriptor.format_class != rsx::RSX_FORMAT_CLASS_COLOR && descriptor.is_cyclic_reference;
+			result.clamp = descriptor.texcoord_xform.clamp;
+			result.format_features = descriptor.format_ex.features;
+			result.texel_remap_control = result.format_features ? descriptor.format_ex.texel_remap_control : 0;
+			std::memcpy(result.coordinates.data(), descriptor.texcoord_xform.scale, 6 * sizeof(std::uint32_t));
+			if (result.clamp)
+			{
+				// Inactive clamp bounds are intentionally not read: descriptors do
+				// not initialize them until clipping is required.
+				std::memcpy(result.coordinates.data() + 6, descriptor.texcoord_xform.clamp_min, 4 * sizeof(std::uint32_t));
+			}
+			return result;
+		}
+
+		template <typename Descriptor>
+		bool matches_vertex(const Descriptor& descriptor) const
+		{
+			return valid && descriptor.validate() &&
+				dimension == static_cast<std::uint32_t>(descriptor.image_type) &&
+				format_class == static_cast<std::uint32_t>(descriptor.format_class) &&
+				samples == descriptor.samples;
+		}
+
+		template <typename Descriptor>
+		bool matches_fragment(const Descriptor& descriptor) const
+		{
+			return matches_vertex(descriptor) &&
+				cyclic == (descriptor.format_class != rsx::RSX_FORMAT_CLASS_COLOR && descriptor.is_cyclic_reference) &&
+				clamp == descriptor.texcoord_xform.clamp &&
+				std::memcmp(coordinates.data(), descriptor.texcoord_xform.scale, 6 * sizeof(std::uint32_t)) == 0 &&
+				(!clamp || std::memcmp(coordinates.data() + 6, descriptor.texcoord_xform.clamp_min, 4 * sizeof(std::uint32_t)) == 0);
+		}
+
+		template <typename Descriptor>
+		bool matches_format(const Descriptor& descriptor) const
+		{
+			return valid &&
+				format_features == descriptor.format_ex.features &&
+				(!format_features || texel_remap_control == descriptor.format_ex.texel_remap_control);
+		}
+	};
+}
