+        result.new_fragment = new_fragment.exchange(0, std::memory_order_relaxed);
+        result.state_only = state_only.exchange(0, std::memory_order_relaxed);
+        result.abandoned = abandoned.exchange(0, std::memory_order_relaxed);
+        result.pending_wait = pending_wait.take();
