+        result.vertex_cached = vertex_cached.exchange(0, std::memory_order_relaxed);
+        result.vertex_compiled = vertex_compiled.exchange(0, std::memory_order_relaxed);
+        result.fragment_cached = fragment_cached.exchange(0, std::memory_order_relaxed);
+        result.fragment_compiled = fragment_compiled.exchange(0, std::memory_order_relaxed);
+        result.cache_additions = cache_additions.exchange(0, std::memory_order_relaxed);
+        result.live = live.load(std::memory_order_relaxed);
+        return result;
+    }
