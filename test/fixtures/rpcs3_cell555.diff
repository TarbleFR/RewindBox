diff --git a/rpcs3/ios/IOSReadbackProfile.h b/rpcs3/ios/IOSReadbackProfile.h
new file mode 100644
index 0000000..afd1835
--- /dev/null
+++ b/rpcs3/ios/IOSReadbackProfile.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include "util/tsc.hpp"
+
+// CELL555: identify synchronous GPU-to-guest transfers without recording guest
+// addresses or changing their ordering. Five fixed counters; two clock reads
+// only for a nonempty DMA batch, never for an ordinary draw/cache hit.
+namespace rpcs3::ios::readback
+{
+enum class Origin : unsigned
+{
+    unknown, texture_cpu, blit_source_cpu, blit_destination_dma, presentation_cpu, count
+};
+inline constexpr unsigned origin_count = static_cast<unsigned>(Origin::count);
+inline constexpr std::array<const char*, origin_count> names{
+    "unknown", "texture_cpu", "blit_source_cpu", "blit_destination_dma", "presentation_cpu"};
+inline thread_local Origin current_origin = Origin::unknown;
+
+class OriginScope final
+{
+    Origin previous_;
+public:
+    explicit OriginScope(Origin value) noexcept : previous_(current_origin) { current_origin = value; }
+    ~OriginScope() noexcept { current_origin = previous_; }
+    OriginScope(const OriginScope&) = delete;
+    OriginScope& operator=(const OriginScope&) = delete;
+};
+
+struct Counter
+{
+    diagnostics::EventCost duration_ticks;
+    std::atomic<std::uint64_t> sections{0}, confirmed_bytes{0};
+    struct Sample
+    {
+        diagnostics::EventCost::Sample duration_ticks;
+        std::uint64_t sections = 0, confirmed_bytes = 0;
+    };
+    Sample take() noexcept
+    {
+        return {duration_ticks.take(), sections.exchange(0, std::memory_order_relaxed),
+            confirmed_bytes.exchange(0, std::memory_order_relaxed)};
+    }
+};
+inline std::array<Counter, origin_count> counters{};
+
+class BatchScope final
+{
+    unsigned origin_;
+    std::uint64_t sections_, bytes_, begin_;
+public:
+    BatchScope(std::uint64_t sections, std::uint64_t confirmed_bytes) noexcept
+        : origin_(static_cast<unsigned>(current_origin)), sections_(sections), bytes_(confirmed_bytes),
+          begin_(sections ? utils::get_tsc() : 0)
+    {
+        if (origin_ >= origin_count) origin_ = 0;
+    }
+    ~BatchScope() noexcept
+    {
+        if (!sections_) return;
+        const auto end = utils::get_tsc();
+        auto& counter = counters[origin_];
+        counter.sections.fetch_add(sections_, std::memory_order_relaxed);
+        counter.confirmed_bytes.fetch_add(bytes_, std::memory_order_relaxed);
+        counter.duration_ticks.record(end >= begin_ ? end - begin_ : 0);
+    }
+    BatchScope(const BatchScope&) = delete;
+    BatchScope& operator=(const BatchScope&) = delete;
+};
+
+inline auto take() noexcept
+{
+    std::array<Counter::Sample, origin_count> result{};
+    for (unsigned i = 0; i < origin_count; ++i) result[i] = counters[i].take();
+    return result;
+}
+}
