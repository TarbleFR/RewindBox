diff --git a/rpcs3/ios/IOSEarlySubmit.h b/rpcs3/ios/IOSEarlySubmit.h
index e5df604df..3e85b64cd 100644
--- a/rpcs3/ios/IOSEarlySubmit.h
+++ b/rpcs3/ios/IOSEarlySubmit.h
@@ -17,6 +17,9 @@
 namespace rpcs3::ios::early_submit
 {
 inline std::atomic<bool> enabled{false};
+// CELL563_EARLY_AB: set when the lever alternates per profiling window, so one
+// session measures both states under the same device conditions and scenes.
+inline std::atomic<bool> alternate{false};
 
 // An early submission carries at least this many draws; a frame has at most this many.
 constexpr std::uint32_t min_draws = 32;
@@ -48,4 +51,18 @@ constexpr verdict decide(bool on, std::uint32_t draws, std::uint32_t this_frame,
 
 	return gpu_idle ? verdict::submit : verdict::gpu_busy;
 }
+
+// CELL563_EARLY_AB: called once per profiling window, at its boundary. Returns the
+// state the ending window ran with; when alternating, the next window runs with the
+// other one. Each end of draw reads the state on its own, so a switch between draws
+// changes no command, only where later command buffer boundaries may fall.
+inline bool window_boundary() noexcept
+{
+	const bool state = enabled.load(std::memory_order_relaxed);
+	if (alternate.load(std::memory_order_relaxed))
+	{
+		enabled.store(!state, std::memory_order_relaxed);
+	}
+	return state;
+}
 }
