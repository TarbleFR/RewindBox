diff --git a/rpcs3/Emu/RSX/VK/VKFramebuffer.cpp b/rpcs3/Emu/RSX/VK/VKFramebuffer.cpp
--- a/rpcs3/Emu/RSX/VK/VKFramebuffer.cpp
+++ b/rpcs3/Emu/RSX/VK/VKFramebuffer.cpp
@@ -24,7 +24,13 @@
 		};
 
 		framebuffer_storage_key(u16 width_, u16 height_, VkBool32 has_input_attachments)
+#ifdef RPCS3_IOS
+			// Every bit enters the cache key. Initializing only the bitfields
+			// leaves the upper 31 bits dependent on the previous stack contents.
+			: encoded(u64(width_) | (u64(height_) << 16) | ((u64(has_input_attachments) & 1u) << 32))
+#else
 			: width(width_), height(height_), ia_ref(has_input_attachments)
+#endif
 		{}
 	};
 
