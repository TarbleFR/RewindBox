diff --git a/rpcs3/ios/IOSCompilePressure.h b/rpcs3/ios/IOSCompilePressure.h
new file mode 100644
index 0000000..98abac4
--- /dev/null
+++ b/rpcs3/ios/IOSCompilePressure.h
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+// REWINDBOX_COMPILE_PRESSURE_V1: cooperative CPU release while the RSX thread
+// waits for a graphics pipeline that a draw needs.
+//
+// MoltenVK 1.4.2 builds the Metal pipeline on a global GCD queue and Metal
+// compiles out of process, both below the emulator threads' USER_INTERACTIVE
+// QoS (MVKMetalCompiler::compile), while the RSX thread waits. On the A18 Pro
+// (2 performance + 4 efficiency cores) God of War III builds took 0.3-0.8 s
+// per pipeline with 2.3-3.9 busy SPU cores (build 538) and 2-4 s with 3.3-3.7
+// SPU cores spinning in reservation loops (build 541, docs/rpcs3-cell543.md).
+// During such a build a SPU thread that only polls an unchanged reservation
+// takes RPCS3's own passive path (it sleeps on the reservation notifier, woken
+// by any store to the line or after 100 us) instead of spinning. Guest instructions, their order and the SPU work that
+// actually executes are unchanged: only how an idle poll waits.
+namespace rpcs3::ios::compile_pressure
+{
+inline std::atomic<std::uint32_t> blocking_builds{0};
+// Profiler window counters (exchanged once per report, never per draw).
+inline diagnostics::EventCost blocking_build_us{};
+inline std::atomic<std::uint64_t> spu_passive_waits{0};
+
+inline bool active() noexcept
+{
+    return blocking_builds.load(std::memory_order_relaxed) != 0;
+}
+
+// Held around one pipeline build that a draw waits for. Preload workers and
+// asynchronous builds do not hold it: the frame does not wait for them.
+class BlockingBuildScope final
+{
+    bool active_;
+    std::chrono::steady_clock::time_point begin_{};
+public:
+    explicit BlockingBuildScope(bool draw_waits) noexcept : active_(draw_waits)
+    {
+        if (!active_) return;
+        begin_ = std::chrono::steady_clock::now();
+        blocking_builds.fetch_add(1, std::memory_order_relaxed);
+    }
+    ~BlockingBuildScope() noexcept
+    {
+        if (!active_) return;
+        blocking_builds.fetch_sub(1, std::memory_order_relaxed);
+        blocking_build_us.record(static_cast<std::uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - begin_).count()));
+    }
+    BlockingBuildScope(const BlockingBuildScope&) = delete;
+    BlockingBuildScope& operator=(const BlockingBuildScope&) = delete;
+};
+}
+
+// REWINDBOX_FENCE_WAIT_V1: a command buffer reuse wait (vk::wait_for_fence
+// without timeout) spun on vkGetFenceStatus for the whole GPU time: build 541
+// logged 0.4-1.7 s of such waits per 5 s window on the RSX thread, the busiest
+// thread of the process. It now spins for a bounded time, then blocks in
+// vkWaitForFences (MoltenVK's fence sitter, signalled by the Metal completion
+// handler). Same result, same order.
+namespace rpcs3::ios::fence_wait
+{
+// Bounded spin before blocking: covers GPU work that is about to complete.
+inline constexpr std::uint64_t spin_microseconds = 100;
+// Blocking slices; the wait itself has no timeout, as before.
+inline constexpr std::uint64_t slice_nanoseconds = 100'000'000;
+inline std::atomic<std::uint64_t> spin_completed{0};
+inline diagnostics::EventCost blocked_us{};
+}
