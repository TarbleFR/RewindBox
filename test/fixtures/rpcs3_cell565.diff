diff --git a/rpcs3/ios/IOSRsxIdlePark.h b/rpcs3/ios/IOSRsxIdlePark.h
new file mode 100644
index 000000000..b3442839e
--- /dev/null
+++ b/rpcs3/ios/IOSRsxIdlePark.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+// CELL565_RSX_IDLE_PARK: with an empty FIFO the RSX thread yields in a loop, so
+// it keeps a whole core while it waits for the next guest commands (Dragon Ball
+// Z Budokai HD on build 564: 0.90 core with the FIFO busy 33-43 % of the time,
+// one idle period of about 12 ms per frame). The iPhone has two performance
+// cores; that core is taken from the SPU and PPU threads doing the guest's
+// work. After the FIFO has stayed empty for grace_us, the thread sleeps in
+// slices of slice_us instead. The guest's next PUT is seen at the end of the
+// current slice at worst; a flush request, a flip request or a ZCULL pipe flush
+// posted by another thread wakes it at once.
+namespace rpcs3::ios::rsx_idle_park
+{
+inline std::atomic<bool> enabled{false};
+
+// Short gaps inside a frame keep the yield loop; only a long idle period parks.
+constexpr std::uint64_t grace_us = 1000;
+constexpr std::uint64_t slice_us = 50;
+
+inline std::mutex gate_mutex;
+inline std::condition_variable gate;
+inline std::uint64_t generation = 0;
+inline std::atomic<std::uint32_t> parked{0};
+
+// RSX thread only: sleep one slice unless woken.
+inline void park() noexcept
+{
+	parked.fetch_add(1, std::memory_order_seq_cst);
+	{
+		std::unique_lock lock(gate_mutex);
+		const std::uint64_t seen = generation;
+		gate.wait_for(lock, std::chrono::microseconds(slice_us), [&] { return generation != seen; });
+	}
+	parked.fetch_sub(1, std::memory_order_relaxed);
+}
+
+// Any thread, after posting work the RSX thread must service.
+inline void wake() noexcept
+{
+	if (!enabled.load(std::memory_order_relaxed) || !parked.load(std::memory_order_seq_cst))
+	{
+		return;
+	}
+
+	{
+		std::lock_guard lock(gate_mutex);
+		generation++;
+	}
+	gate.notify_all();
+}
+}
