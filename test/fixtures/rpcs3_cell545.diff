+// component leaves the directory it is installed into. Checked on the raw name bytes.
+static bool leaves_directory(std::string_view name)
+{
+	if (name.starts_with('/'))
+	{
+		return true;
+	}
+
+	for (std::string_view rest = name; !rest.empty();)
+	{
+		const usz sep = rest.find('/');
+		const std::string_view component = rest.substr(0, sep);
+		rest = sep == umax ? std::string_view{} : rest.substr(sep + 1);
+
+		if (component == "." || component == "..")
+		{
+			return true;
+		}
+	}
+
+	return false;
+}
+
+// NEOSTATION_CELL545_PKG_PATHS (ARMSX3 471b57b36): where a name that leaves its directory lands, for a package
+// unpacking on the emulated hard drive. "Custom installer" packages (PS3 avatar and mod packs) declare an ordinary
+// content type, then name their files from the root: "../../dev_hdd0/home/psn_avatar/PSNA_....edat" from
+// dev_hdd0/theme/, which a PS3 resolves from the install directory. Resolved the same way from install_dir, the
+// install directory's PS3 path ("dev_hdd0/theme/"). The result is the path below dev_hdd0 (empty for dev_hdd0
+// itself), or nothing when the name leaves the emulated hard drive.
+static std::optional<std::string> resolve_on_hdd0(std::string_view install_dir, std::string_view name)
+{
+	if (install_dir.empty() || name.starts_with('/'))
+	{
+		return std::nullopt;
+	}
+
+	std::vector<std::string_view> parts;
+
+	const auto append = [&parts](std::string_view path)
+	{
+		for (std::string_view rest = path; !rest.empty();)
+		{
+			const usz sep = rest.find('/');
+			const std::string_view component = rest.substr(0, sep);
+			rest = sep == umax ? std::string_view{} : rest.substr(sep + 1);
+
+			if (component.empty() || component == ".")
+			{
+				continue;
+			}
+
+			if (component == "..")
+			{
+				// Above the root: a PS3 has nothing there
+				if (parts.empty())
+				{
+					return false;
+				}
+
+				parts.pop_back();
+				continue;
+			}
+
+			parts.push_back(component);
+		}
+
+		return true;
+	};
+
+	if (!append(install_dir) || !append(name) || parts.empty() || parts[0] != "dev_hdd0")
+	{
+		return std::nullopt;
+	}
+
+	std::string result;
+
+	for (usz i = 1; i < parts.size(); i++)
+	{
+		if (i > 1)
+		{
+			result += '/';
+		}
+
+		result += parts[i];
+	}
+
+	return result;
+}
