diff --git a/rpcs3/ios/IOSThreadQoS.h b/rpcs3/ios/IOSThreadQoS.h
new file mode 100644
index 000000000..0f2f94b52
--- /dev/null
+++ b/rpcs3/ios/IOSThreadQoS.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+
+// CELL567_THREAD_QOS: iOS schedules threads by QoS class and, within a class,
+// by relative priority (0 down to QOS_MIN_RELATIVE_PRIORITY, -15). RPCS3 raises
+// the RSX thread and the two audio threads "above other threads" (priority +1)
+// and lowers compilers and loggers (-1); on iOS +1 and the default 0 were the
+// same user-interactive class at relative priority 0, so the RSX thread had no
+// precedence over the SPU and PPU threads when they oversubscribe the two
+// performance cores (God of War III on build 565: about 4.7 cores requested,
+// RSX FIFO 85-90 % busy at 0.57 core). Threads that ask for nothing now run one
+// step below the raised ones in the same class.
+//
+// The native worker pool also reuses threads: a worker that ran a thread which
+// lowered itself (shader cache writer: set_native_priority(-1), never restored)
+// kept the utility class for the next thread it ran, an SPU or PPU thread for
+// instance. Each job now starts at the default level.
+namespace rpcs3::ios::thread_qos
+{
+// Relative priority of threads that request no priority while the ordering is on.
+constexpr int lowered_relative_priority = -2;
+inline std::atomic<int> default_relative_priority{0};
+
+struct level
+{
+	bool utility;           // QOS_CLASS_UTILITY instead of QOS_CLASS_USER_INTERACTIVE
+	int relative_priority;  // pthread_set_qos_class_self_np's relative priority
+};
+
+// thread_ctrl::set_native_priority(priority); 0 is also every pooled job's start.
+inline level for_priority(int priority) noexcept
+{
+	if (priority < 0)
+	{
+		return {true, 0};
+	}
+
+	if (priority > 0)
+	{
+		return {false, 0};
+	}
+
+	return {false, default_relative_priority.load(std::memory_order_relaxed)};
+}
+}
