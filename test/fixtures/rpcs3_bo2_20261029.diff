+#ifdef RPCS3_IOS
+static u16 fragment_instruction_input_mask(v128 inst)
+{
+	using namespace rsx::assembler;
+	const auto dst = OPDEST::from_be32(inst._u32[0]);
+	const SRC1 src1{ .HEX = OPDEST::from_be32(inst._u32[2]).HEX };
+	const u32 opcode = dst.opcode | (src1.opcode_hi << 6);
+	if (opcode >= RSX_FP_OPCODE_BRK || opcode == 0x30 || opcode == 0x32 || opcode == 0x3f ||
+		!FP::is_instruction_valid(static_cast<FP_opcode>(opcode)))
+	{
+		return 0xffff;
+	}
+	// TEMP (00) and CONSTANT (10) cannot reference an input. Avoid decoding
+	// operand counts and addressing for the common arithmetic-only instruction.
+	if (((inst._u32[1] | inst._u32[2] | inst._u32[3]) & 0x100) == 0)
+	{
+		return 0;
+	}
+	const SRC2 src2{ .HEX = OPDEST::from_be32(inst._u32[3]).HEX };
+
+	// TXD's GLSL consumes the coordinate and both explicit gradients, although
+	// the generic register-annotation operand count only reports its coordinate.
+	const u32 operands = opcode == RSX_FP_OPCODE_TXD ? 3 : FP::get_operand_count(static_cast<FP_opcode>(opcode));
+	u16 inputs = 0;
+	for (u32 i = 0; i < operands; ++i)
+	{
+		const u32 type = (inst._u32[i + 1] >> 8) & 3;
+		if (type == RSX_FP_REGISTER_TYPE_UNKNOWN)
+		{
+			return 0xffff;
+		}
+		if (type != RSX_FP_REGISTER_TYPE_INPUT)
+		{
+			continue;
+		}
+		if (src2.use_index_reg || dst.src_attr_reg_num >= 15)
+		{
+			return 0xffff;
+		}
+		inputs |= u16{1} << dst.src_attr_reg_num;
+	}
+	return inputs;
+}
+
+u16 fragment_program_utils::get_fragment_program_input_mask(const RSXFragmentProgram& program)
+{
+	if (!program.get_data() || !program.ucode_length || program.ucode_length % 16)
+	{
+		return 0xffff;
+	}
+
+	u16 inputs = 0;
+	for (usz offset = 0; offset < program.ucode_length;)
+	{
+		const auto inst = v128::loadu(static_cast<const u8*>(program.get_data()) + offset);
+		inputs |= fragment_instruction_input_mask(inst);
+		if (inputs == 0xffff)
+		{
+			return inputs;
+		}
+		const usz length = is_any_src_constant(inst) ? 32 : 16;
+		if (length > program.ucode_length - offset)
+		{
+			return 0xffff;
+		}
+		offset += length;
+		if ((inst._u32[0] >> 8) & 1)
+		{
+			return offset == program.ucode_length ? inputs : 0xffff;
+		}
+	}
+	return 0xffff;
+}
+
+std::optional<RSXFragmentProgram> fragment_program_utils::normalize_fragment_program_key(const RSXFragmentProgram& program, u16 inputs)
+{
+	if (inputs == 0xffff)
+	{
+		return {};
+	}
+	const u32 texcoords = (inputs >> 4) & 0x3ff;
+	const u32 texcoord_control = program.texcoord_control_mask & (texcoords | (texcoords << 16));
+	const bool uses_color = inputs & 6;
+	const bool two_sided_lighting = uses_color && program.two_sided_lighting;
+	const u32 ctrl = uses_color ? program.ctrl : program.ctrl & ~RSX_SHADER_CONTROL_FLAT_SHADING;
+	if (texcoord_control == program.texcoord_control_mask && two_sided_lighting == program.two_sided_lighting && ctrl == program.ctrl)
+	{
+		return {};
+	}
+
+	// Only the private cache key changes. Constants, guest properties, disk
+	// records and the original GLSL generation retain their existing inputs.
+	RSXFragmentProgram key = program;
+	key.texcoord_control_mask = texcoord_control;
+	key.two_sided_lighting = two_sided_lighting;
+	key.ctrl = ctrl;
+	return key;
+}
