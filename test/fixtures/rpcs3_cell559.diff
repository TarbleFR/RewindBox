diff --git a/rpcs3/ios/IOSFullOverwrite.h b/rpcs3/ios/IOSFullOverwrite.h
new file mode 100644
index 000000000..dc152fa3d
--- /dev/null
+++ b/rpcs3/ios/IOSFullOverwrite.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// CELL559_FULL_OVERWRITE: a GPU transfer that replaces every byte of its
+// destination does not need the previous destination contents. These pure
+// decisions stay conservative: any doubt keeps the existing read-back/reload.
+namespace rpcs3::ios::full_overwrite
+{
+// Guest bytes [start, end] (inclusive, like address_range32) that the transfer
+// on this thread writes completely. Only the RSX thread sets it, around the one
+// invalidation that precedes its own DMA destination; other threads see none.
+struct Range
+{
+    std::uint32_t start = 1, end = 0;
+    bool valid() const noexcept { return start <= end; }
+    bool contains(std::uint32_t first, std::uint32_t last) const noexcept
+    {
+        return valid() && first <= last && first >= start && last <= end;
+    }
+};
+inline thread_local Range current_range{};
+
+class RangeScope final
+{
+    Range previous_;
+public:
+    RangeScope(bool enabled, std::uint32_t start, std::uint32_t length) noexcept
+        : previous_(current_range)
+    {
+        current_range = (enabled && length) ? Range{start, start + (length - 1)} : Range{};
+    }
+    ~RangeScope() noexcept { current_range = previous_; }
+    RangeScope(const RangeScope&) = delete;
+    RangeScope& operator=(const RangeScope&) = delete;
+};
+
+// A 1:1 DMA copy writes rows of src_w texels at the destination pitch. All
+// payload bytes are written only when the rows are contiguous (or single),
+// the copy keeps its texel size and no tiling or partial source applies.
+constexpr bool dma_copy_writes_whole_payload(
+    std::uint32_t dst_w, std::uint32_t dst_h, std::uint32_t dst_bpp, std::uint32_t dst_pitch,
+    std::int64_t src_area_w, std::int64_t src_area_h, std::uint32_t src_bpp,
+    bool src_typeless, bool dst_tiled) noexcept
+{
+    if (!dst_w || !dst_h || !dst_bpp || dst_tiled || src_typeless || src_bpp != dst_bpp)
+        return false;
+    if (src_area_w != static_cast<std::int64_t>(dst_w) || src_area_h != static_cast<std::int64_t>(dst_h))
+        return false;
+    return dst_h == 1 || static_cast<std::uint64_t>(dst_w) * dst_bpp == dst_pitch;
+}
+
+// A blit into an existing single-sampled color target replaces all of it when
+// the destination rectangle covers the target. Depth/stencil, typeless and
+// multisampled targets keep the existing memory reload.
+constexpr bool blit_replaces_whole_surface(
+    std::int64_t x1, std::int64_t y1, std::int64_t x2, std::int64_t y2,
+    std::uint32_t surface_w, std::uint32_t surface_h,
+    std::uint32_t surface_samples_w, std::uint32_t surface_samples_h,
+    bool depth, bool dst_typeless) noexcept
+{
+    if (depth || dst_typeless || !surface_w || !surface_h)
+        return false;
+    if (surface_samples_w != surface_w || surface_samples_h != surface_h)
+        return false;
+    // Exact bounds, as upstream requires for a newly created blit target.
+    return x1 == 0 && y1 == 0 &&
+        x2 == static_cast<std::int64_t>(surface_w) && y2 == static_cast<std::int64_t>(surface_h);
+}
+
+// Fixed counters exported once per profiler window (OPT559 line).
+inline std::atomic<std::uint64_t> dma_flush_skips{0}, dma_flush_skip_bytes{0};
+inline std::atomic<std::uint64_t> rt_reload_skips{0}, rt_reload_skip_bytes{0};
+}
diff --git a/rpcs3/ios/IOSTextureValidationProfile.h b/rpcs3/ios/IOSTextureValidationProfile.h
index 7861c6ff9..13baaa863 100644
--- a/rpcs3/ios/IOSTextureValidationProfile.h
+++ b/rpcs3/ios/IOSTextureValidationProfile.h
@@ -11,4 +11,32 @@ namespace rpcs3::ios::texture_validation
 // existing hash measurements, not an extra cost. No new per-hash observation.
 inline std::atomic<std::uint64_t> trim_calls{0}, trim_sections{0};
 inline std::atomic<std::uint64_t> trim_bytes{0}, trim_ticks{0};
+// CELL559_DIRTY_HASH_SKIP: dirty hashed sections released without hashing.
+inline std::atomic<std::uint64_t> dirty_releases{0}, dirty_release_bytes{0};
+
+// CELL559_TEXTURE_EPOCH: "Texture Validation Per FIFO Batch". A clean section
+// whose hash matched stays validated until the next synchronization point:
+// new commands made visible by the guest (PUT), a semaphore acquire, an RSX
+// write, flush or invalidation of guest memory, or the end of a frame. Guest
+// data a command needs is written before that command becomes visible, or
+// before the semaphore the RSX waits for is released; only an unsynchronized
+// write racing the RSX can be seen one batch later. Disabled: epoch 0, every
+// validation hashes as before.
+inline std::atomic<bool> epoch_enabled{false};
+inline std::atomic<std::uint64_t> validation_epoch{1};
+inline std::atomic<std::uint64_t> epoch_skips{0}, epoch_skip_bytes{0}, epoch_bumps{0};
+
+inline std::uint64_t current_epoch() noexcept
+{
+	return epoch_enabled.load(std::memory_order_relaxed) ? validation_epoch.load(std::memory_order_acquire) : 0;
+}
+
+inline void advance_epoch() noexcept
+{
+	if (epoch_enabled.load(std::memory_order_relaxed))
+	{
+		validation_epoch.fetch_add(1, std::memory_order_acq_rel);
+		epoch_bumps.fetch_add(1, std::memory_order_relaxed);
+	}
+}
 }
