diff --git a/rpcs3/ios/IOSMoltenVKAsyncCanary.h b/rpcs3/ios/IOSMoltenVKAsyncCanary.h
new file mode 100644
index 000000000..3acfa4662
--- /dev/null
+++ b/rpcs3/ios/IOSMoltenVKAsyncCanary.h
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// CELL587_MVK_ASYNC_CANARY: asynchronous MoltenVK submits run only for titles
+// whose last asynchronous boot finished. A boot that turns them on first
+// records the title as armed, durably; it becomes ok after confirm_presents
+// presents or when the renderer shuts down cleanly. A boot that finds its title
+// still armed knows the previous asynchronous boot ended without either (a
+// crash, or the process being killed): the title is marked failed and keeps
+// synchronous submits from then on. The record file carries the Core cell in
+// its name, so a later Core tries again once.
+namespace rpcs3::ios::mvk_async_canary
+{
+inline constexpr std::string_view file_name = "rewindbox-mvk-async-587.txt";
+inline constexpr std::uint32_t confirm_presents = 900;
+
+enum class state : std::uint8_t
+{
+	armed,
+	ok,
+	failed,
+};
+
+struct record
+{
+	std::string title;
+	state value = state::ok;
+};
+
+constexpr std::string_view state_name(state value) noexcept
+{
+	switch (value)
+	{
+	case state::armed: return "armed";
+	case state::ok: return "ok";
+	case state::failed: return "failed";
+	}
+
+	return "ok";
+}
+
+// Title IDs are 4 upper-case letters and 5 digits; anything else in the file is ignored.
+constexpr bool valid_title(std::string_view title) noexcept
+{
+	if (title.size() != 9)
+	{
+		return false;
+	}
+
+	for (std::size_t i = 0; i < title.size(); i++)
+	{
+		const char c = title[i];
+		if (i < 4 ? !(c >= 'A' && c <= 'Z') : !(c >= '0' && c <= '9'))
+		{
+			return false;
+		}
+	}
+
+	return true;
+}
+
+// One "<title> <state>" line per title; the last line of a title wins.
+inline std::vector<record> parse(std::string_view text)
+{
+	std::vector<record> records;
+	while (!text.empty())
+	{
+		const std::size_t end = text.find('\n');
+		std::string_view line = text.substr(0, end);
+		text = end == std::string_view::npos ? std::string_view{} : text.substr(end + 1);
+
+		const std::size_t space = line.find(' ');
+		if (space == std::string_view::npos)
+		{
+			continue;
+		}
+
+		const std::string_view title = line.substr(0, space);
+		const std::string_view name = line.substr(space + 1);
+		state value;
+		if (name == "armed") value = state::armed;
+		else if (name == "ok") value = state::ok;
+		else if (name == "failed") value = state::failed;
+		else continue;
+
+		if (!valid_title(title))
+		{
+			continue;
+		}
+
+		bool replaced = false;
+		for (auto& existing : records)
+		{
+			if (existing.title == title)
+			{
+				existing.value = value;
+				replaced = true;
+			}
+		}
+
+		if (!replaced)
+		{
+			records.push_back({std::string(title), value});
+		}
+	}
+
+	return records;
+}
+
+inline std::string serialize(const std::vector<record>& records)
+{
+	std::string text;
+	for (const auto& entry : records)
+	{
+		text += entry.title;
+		text += ' ';
+		text += state_name(entry.value);
+		text += '\n';
+	}
+
+	return text;
+}
+
+inline record* find(std::vector<record>& records, std::string_view title) noexcept
+{
+	for (auto& entry : records)
+	{
+		if (entry.title == title)
+		{
+			return &entry;
+		}
+	}
+
+	return nullptr;
+}
+
+enum class verdict : std::uint8_t
+{
+	off,                  // not requested: the records are unchanged
+	run,                  // requested and allowed: the title is now armed
+	failed_before,        // an earlier asynchronous boot of the title failed
+	previous_boot_failed, // this boot found the title armed: now failed
+	invalid_title,        // no usable title ID: synchronous
+	record_failed,        // the armed record could not be written: synchronous
+};
+
+constexpr std::string_view verdict_name(verdict value) noexcept
+{
+	switch (value)
+	{
+	case verdict::off: return "off";
+	case verdict::run: return "armed";
+	case verdict::failed_before: return "failed_before";
+	case verdict::previous_boot_failed: return "previous_boot_failed";
+	case verdict::invalid_title: return "invalid_title";
+	case verdict::record_failed: return "record_failed";
+	}
+
+	return "off";
+}
+
+// At boot, before the Vulkan instance exists. Returns whether this boot may use
+// asynchronous submits; records receives the state to write before it continues.
+inline verdict on_boot(std::vector<record>& records, std::string_view title, bool requested)
+{
+	record* entry = find(records, title);
+	if (entry && entry->value == state::armed)
+	{
+		entry->value = state::failed;
+		return verdict::previous_boot_failed;
+	}
+
+	if (!requested)
+	{
+		return verdict::off;
+	}
+
+	if (!valid_title(title))
+	{
+		return verdict::invalid_title;
+	}
+
+	if (entry && entry->value == state::failed)
+	{
+		return verdict::failed_before;
+	}
+
+	if (entry)
+	{
+		entry->value = state::armed;
+	}
+	else
+	{
+		records.push_back({std::string(title), state::armed});
+	}
+
+	return verdict::run;
+}
+
+// After confirm_presents presents, or at a clean renderer shutdown. Returns true when
+// the title was armed and is now ok.
+inline bool on_confirm(std::vector<record>& records, std::string_view title)
+{
+	record* entry = find(records, title);
+	if (!entry || entry->value != state::armed)
+	{
+		return false;
+	}
+
+	entry->value = state::ok;
+	return true;
+}
+}
diff --git a/rpcs3/ios/IOSMoltenVKExec.h b/rpcs3/ios/IOSMoltenVKExec.h
new file mode 100644
index 000000000..4067a67cb
--- /dev/null
+++ b/rpcs3/ios/IOSMoltenVKExec.h
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <string_view>
+
+// CELL587_MVK_ENCODE_BARRIER: with MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=0,
+// MoltenVK 1.4.2 returns from vkQueueSubmit and vkQueuePresentKHR once the
+// submission is queued on the serial GCD queue of the VkQueue
+// (MVKQueue::submit, MVKQueue.mm:87); the Metal commands are encoded later on
+// that queue. RPCS3 was written for synchronous submits, where everything that
+// follows vkQueueSubmit follows the encoding. MoltenVK itself breaks with
+// that order at one point: vkAcquireNextImageKHR releases the drawable of the
+// image it returns (MVKPresentableSwapchainImage::acquireAndSignalWhenAvailable,
+// MVKImage.mm:1569), without a lock, while the queue thread fetches the same
+// drawable when it encodes a render into that image or its present
+// (getCAMetalDrawable, MVKImage.mm:1608). An acquisition that overtakes a
+// queued present either releases the drawable that holds the frame, so the
+// present takes a new drawable and the next render of the image draws into an
+// already presented one, or races with the queue thread on the same pointer.
+// The native shader cache dialog flips frames back to back, so the window is
+// widest in the first second of a boot, when every 551 boot ended.
+//
+// The build renames the MoltenVK archive's only dispatch_queue_create
+// reference (MVKQueue::initExecQueue) to rbx_mvk_exec_q_create
+// (RPCS3IOSPlatform.mm), which records the queue. After each present the RSX
+// thread queues a marker behind it; before the next acquisition it waits for
+// the marker of the last present. Command buffers submitted since that present
+// keep encoding while the RSX thread records.
+namespace rpcs3::ios::moltenvk_exec
+{
+// MVKQueue::initName and initExecQueue: "MoltenVKQueue-<family>-<index>-<priority>-Dispatch".
+constexpr bool is_exec_queue_label(std::string_view label) noexcept
+{
+	constexpr std::string_view prefix = "MoltenVKQueue-";
+	constexpr std::string_view suffix = "-Dispatch";
+	return label.size() > prefix.size() + suffix.size() && label.starts_with(prefix) && label.ends_with(suffix);
+}
+
+// A waiter gives up after this long and acquires as before (a stalled queue thread is a
+// GPU or driver failure that the fence timeouts of RPCS3 report).
+constexpr std::chrono::milliseconds wait_limit{2000};
+
+// Present tickets: issued in order on the presenting thread, completed in order by the
+// marker that runs behind each present on MoltenVK's serial queue. Tickets never
+// restart, so a marker left on the queue of a destroyed device cannot complete a newer
+// ticket of the next device's queue.
+class present_tracker
+{
+	std::mutex m_mutex;
+	std::condition_variable m_cv;
+	std::uint64_t m_issued = 0;
+	std::uint64_t m_completed = 0;
+	std::array<std::uint64_t, 16> m_issue_us{};
+
+public:
+	std::uint64_t issue(std::uint64_t now_us) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		const std::uint64_t ticket = ++m_issued;
+		m_issue_us[ticket % m_issue_us.size()] = now_us;
+		return ticket;
+	}
+
+	// Returns the microseconds the ticket spent queued behind earlier work, or 0 for a
+	// ticket that a later one already completed.
+	std::uint64_t complete(std::uint64_t ticket, std::uint64_t now_us) noexcept
+	{
+		std::uint64_t lag = 0;
+		{
+			std::lock_guard lock(m_mutex);
+			if (ticket <= m_completed)
+			{
+				return 0;
+			}
+
+			m_completed = ticket;
+			const std::uint64_t issued = m_issue_us[ticket % m_issue_us.size()];
+			lag = now_us > issued ? now_us - issued : 0;
+		}
+
+		m_cv.notify_all();
+		return lag;
+	}
+
+	bool completed(std::uint64_t ticket) noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return m_completed >= ticket;
+	}
+
+	enum class wait_result : std::uint8_t
+	{
+		ready,     // already completed: no wait
+		waited,    // completed while waiting
+		timed_out, // wait_limit elapsed
+	};
+
+	wait_result wait(std::uint64_t ticket, std::chrono::milliseconds limit = wait_limit) noexcept
+	{
+		std::unique_lock lock(m_mutex);
+		if (m_completed >= ticket)
+		{
+			return wait_result::ready;
+		}
+
+		return m_cv.wait_for(lock, limit, [&] { return m_completed >= ticket; }) ? wait_result::waited : wait_result::timed_out;
+	}
+};
+
+// Profile counters, read and cleared by the 5 s performance window (COREPROF OPT587).
+inline std::atomic<std::uint32_t> exec_queues{0};
+inline std::atomic<bool> barrier_missing{false};
+inline std::atomic<std::uint64_t> presents_marked{0}, marker_lag_us{0}, marker_lag_max_us{0};
+inline std::atomic<std::uint64_t> acquire_waits{0}, acquire_wait_us{0}, acquire_wait_max_us{0}, acquire_timeouts{0};
