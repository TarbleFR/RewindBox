diff --git a/rpcs3/ios/IOSMoltenVKExecQueue.h b/rpcs3/ios/IOSMoltenVKExecQueue.h
new file mode 100644
index 000000000..d2d0c2916
--- /dev/null
+++ b/rpcs3/ios/IOSMoltenVKExecQueue.h
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSMoltenVKExec.h"
+
+#include <dispatch/dispatch.h>
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+
+// CELL587_MVK_ENCODE_BARRIER: the GCD side of ios/IOSMoltenVKExec.h. Included
+// by RPCS3IOSPlatform.mm, which forwards rbx_mvk_exec_q_create and the
+// moltenvk_exec functions to registry::instance(), and by the host test that
+// runs it against the real libdispatch on macOS.
+namespace rpcs3::ios::moltenvk_exec::gcd
+{
+inline std::uint64_t now_us() noexcept
+{
+	return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// Replaces the queue held by slot, keeping one reference to the new one.
+inline void hold(dispatch_queue_t& slot, dispatch_queue_t queue) noexcept
+{
+#if defined(__OBJC__) && __has_feature(objc_arc)
+	slot = queue;
+#else
+	if (queue)
+	{
+		dispatch_retain(queue);
+	}
+	if (slot)
+	{
+		dispatch_release(slot);
+	}
+	slot = queue;
+#endif
+}
+
+class registry
+{
+	std::mutex m_mutex;
+	std::array<dispatch_queue_t, 4> m_queues{};
+	std::uint32_t m_count = 0;
+	present_tracker m_presents;
+
+	static void present_marker(void* context) noexcept
+	{
+		const std::uint64_t lag = instance().m_presents.complete(reinterpret_cast<std::uintptr_t>(context), now_us());
+		marker_lag_us.fetch_add(lag, std::memory_order_relaxed);
+		record_max(marker_lag_max_us, lag);
+	}
+
+	static void drain_marker(void*) noexcept
+	{
+	}
+
+	// The single recorded queue with a reference for the caller, or null.
+	dispatch_queue_t single_queue() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		dispatch_queue_t queue = nullptr;
+		if (m_count == 1)
+		{
+			hold(queue, m_queues[0]);
+		}
+
+		return queue;
+	}
+
+public:
+	static registry& instance() noexcept
+	{
+		static registry s_registry;
+		return s_registry;
+	}
+
+	// rbx_mvk_exec_q_create: a queue MoltenVK created for a VkQueue.
+	void record(dispatch_queue_t queue, const char* label) noexcept
+	{
+		if (!queue || !label || !is_exec_queue_label(label))
+		{
+			return;
+		}
+
+		std::lock_guard lock(m_mutex);
+		if (m_count < m_queues.size())
+		{
+			hold(m_queues[m_count++], queue);
+		}
+
+		exec_queues.store(m_count, std::memory_order_relaxed);
+	}
+
+	void begin_device() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		for (auto& slot : m_queues)
+		{
+			hold(slot, nullptr);
+		}
+
+		m_count = 0;
+		exec_queues.store(0, std::memory_order_relaxed);
+	}
+
+	std::uint32_t queue_count() noexcept
+	{
+		std::lock_guard lock(m_mutex);
+		return m_count;
+	}
+
+	std::uint64_t mark_present() noexcept
+	{
+		dispatch_queue_t queue = single_queue();
+		if (!queue)
+		{
+			return 0;
+		}
+
+		const std::uint64_t ticket = m_presents.issue(now_us());
+		// A serial queue runs the marker right after the present queued before it.
+		dispatch_async_f(queue, reinterpret_cast<void*>(static_cast<std::uintptr_t>(ticket)), present_marker);
+		presents_marked.fetch_add(1, std::memory_order_relaxed);
+		hold(queue, nullptr);
+		return ticket;
+	}
+
+	void wait_for_present(std::uint64_t ticket) noexcept
+	{
+		if (!ticket)
+		{
+			return;
+		}
+
+		const std::uint64_t begin = now_us();
+		switch (m_presents.wait(ticket))
+		{
+		case present_tracker::wait_result::ready:
+			return;
+		case present_tracker::wait_result::waited:
+			break;
+		case present_tracker::wait_result::timed_out:
+			acquire_timeouts.fetch_add(1, std::memory_order_relaxed);
+			break;
+		}
+
+		const std::uint64_t waited = now_us() - begin;
+		acquire_waits.fetch_add(1, std::memory_order_relaxed);
+		acquire_wait_us.fetch_add(waited, std::memory_order_relaxed);
+		record_max(acquire_wait_max_us, waited);
+	}
+
+	void drain() noexcept
+	{
+		std::array<dispatch_queue_t, 4> queues{};
+		{
+			std::lock_guard lock(m_mutex);
+			for (std::uint32_t i = 0; i < m_count; i++)
+			{
+				hold(queues[i], m_queues[i]);
+			}
+		}
+
+		const std::uint64_t begin = now_us();
+		bool any = false;
+		for (auto& queue : queues)
+		{
+			if (queue)
+			{
+				// A serial queue runs this after everything queued on it before.
+				dispatch_sync_f(queue, nullptr, drain_marker);
+				hold(queue, nullptr);
+				any = true;
+			}
+		}
+
+		if (any)
+		{
+			drains.fetch_add(1, std::memory_order_relaxed);
+			drain_us.fetch_add(now_us() - begin, std::memory_order_relaxed);
+		}
+	}
+};
+}
