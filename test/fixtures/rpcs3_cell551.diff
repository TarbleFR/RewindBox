diff --git a/rpcs3/ios/IOSRsxSyncProfile.h b/rpcs3/ios/IOSRsxSyncProfile.h
new file mode 100644
index 0000000..612c9b4
--- /dev/null
+++ b/rpcs3/ios/IOSRsxSyncProfile.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+// REWINDBOX_RSX_SYNC_PROFILE_V1: where the RSX thread's frame goes. Dragon Ball
+// Z HD Collection (547 logs, BLES01658) runs at 31-35 fps with an unimodal
+// 22-36 ms frame (not a 30 fps cap): per frame the RSX thread uses 21 ms of CPU
+// and waits twice for the GPU, 7.3 ms in total, i.e. 28 of the 30 ms. Neither
+// which waits these are nor how much of that CPU is MoltenVK encoding the Metal
+// commands inside vkQueueSubmit (synchronous submits) was measured. Durations
+// are TSC ticks; the profiler converts and drains them once per window.
+namespace rpcs3::ios::rsx_sync
+{
+enum site : unsigned
+{
+    other,
+    frame_cleanup, // frame_context_cleanup: the frame queue waits for an older frame
+    cb_reuse,      // a command buffer still pending on the GPU is recycled
+    hard_sync,     // flush_command_queue(hard_sync): wait for everything submitted
+    texture,       // texture cache readback or DMA completion
+    site_count
+};
+
+inline const char* site_name(site value) noexcept
+{
+    switch (value)
+    {
+    case frame_cleanup: return "frame_cleanup";
+    case cb_reuse: return "cb_reuse";
+    case hard_sync: return "hard_sync";
+    case texture: return "texture";
+    default: return "other";
+    }
+}
+
+inline thread_local site t_site = other;
+
+// The outermost reason wins unless `override` is set: a hard sync drains the
+// frame queue and recycles buffers, and those waits belong to the hard sync.
+class SiteScope final
+{
+    site previous_;
+public:
+    explicit SiteScope(site value, bool override = false) noexcept : previous_(t_site)
+    {
+        if (override || t_site == other) t_site = value;
+    }
+    ~SiteScope() noexcept { t_site = previous_; }
+    SiteScope(const SiteScope&) = delete;
+    SiteScope& operator=(const SiteScope&) = delete;
+};
+
+inline std::array<diagnostics::EventCost, site_count> fence_wait_ticks{};
+inline diagnostics::EventCost submit_ticks{};  // vkQueueSubmit on the calling thread
+inline diagnostics::EventCost acquire_ticks{}; // vkAcquireNextImageKHR (CAMetalLayer drawable)
+inline diagnostics::EventCost present_ticks{}; // vkQueuePresentKHR
+// Swap submission to observed completion of the same frame (frame cleanup):
+// about one frame when the GPU keeps up, up to the frames in flight when it
+// does not.
+inline diagnostics::EventCost frame_latency_ticks{};
+// REWINDBOX_MOLTENVK_COMPILE_QOS_V1: MoltenVK Metal compiles dispatched in the
+// waiting thread's user-interactive class, or at the default priority.
+inline std::atomic<std::uint64_t> metal_compiles_interactive{0};
+inline std::atomic<std::uint64_t> metal_compiles_default{0};
+
+// REWINDBOX_RSX_FRAME_PROFILE_V1: RPCS3's own per-frame RSX statistics
+// (frame_statistics_t). Counters are taken every frame; the stage timers only
+// run on sampled frames (one in rsx_frame_sample_period) because they read
+// the clock around every draw. The RSX thread adds once per flip; the
+// profiler exchanges once per window. FIFO idle entries count transitions of
+// the puller from running to empty, NOP or jump-to-self.
+inline constexpr unsigned rsx_frame_sample_period = 8;
+struct rsx_frame_window
+{
+    std::atomic<std::uint64_t> frames{0}, sampled{0}, draws{0}, submits{0};
+    std::atomic<std::uint64_t> setup_us{0}, vertex_us{0}, texture_us{0}, exec_us{0}, flip_us{0}, sampled_draws{0};
+    std::atomic<std::uint64_t> vertex_cache_requests{0}, vertex_cache_misses{0}, program_lookups{0}, program_lookups_elided{0};
+    std::atomic<std::uint64_t> fifo_idle_entries{0};
+};
+inline rsx_frame_window rsx_frames{};
+
+inline void record_fence_wait(std::uint64_t ticks) noexcept
+{
+    fence_wait_ticks[t_site < site_count ? t_site : other].record(ticks);
+}
+}
diff --git a/rpcs3/ios/IOSSpuWaitProfile.h b/rpcs3/ios/IOSSpuWaitProfile.h
new file mode 100644
index 0000000..7167ee8
--- /dev/null
+++ b/rpcs3/ios/IOSSpuWaitProfile.h
@@ -0,0 +1,130 @@
+#pragma once
+
+// REWINDBOX_SPU_WAIT_PROFILE_V1: where SPU threads spend time outside guest
+// code. The 547 God of War III logs show about 3.4 SPU cores per frame, also
+// while every draw waited for a pipeline, with almost no confirmed GETLLAR
+// poll (PRESSURE547 spu_passive_waits 0-33): which wait burns that CPU was not
+// measurable. Counters live in per-thread slots written only by their owner
+// (relaxed load + store, no shared read-modify-write on the hot paths); the
+// profiler sums every slot. Slots are claimed at first use and released when
+// the thread exits; totals only grow, so window deltas stay exact.
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace rpcs3::ios::spu_wait
+{
+	enum counter : std::size_t
+	{
+		getllar_poll_ticks, // busy polling of unchanged reservation data, between consecutive polls
+		getllar_polls,
+		getllar_sleep_ticks, // a polling GETLLAR asleep on the reservation notifier
+		getllar_sleeps,
+		event_wait_ticks, // RdEventStat calls that had to wait (busy and passive)
+		event_waits,
+		putllc_ok,
+		putllc_fail,
+		putllc_heavy, // stores under the exclusive vm::writer_lock (every running PPU parked)
+		counter_count
+	};
+
+	// A gap above this between two polls is a new polling episode, not polling time.
+	inline constexpr std::uint64_t poll_gap_ns = 20'000;
+
+	struct alignas(128) slot
+	{
+		std::array<std::atomic<std::uint64_t>, counter_count> value{};
+		std::atomic<bool> owned{false};
+	};
+
+	inline constexpr std::size_t slot_count = 32;
+
+	// The last slot is shared by threads beyond slot_count and uses fetch_add.
+	inline std::array<slot, slot_count + 1> g_slots{};
+
+	struct claim
+	{
+		slot* owned = nullptr;
+		std::uint64_t last_poll = 0;
+
+		~claim()
+		{
+			if (owned && owned != &g_slots[slot_count])
+			{
+				owned->owned.store(false, std::memory_order_release);
+			}
+		}
+	};
+
+	inline claim& local() noexcept
+	{
+		thread_local claim t_claim;
+
+		if (!t_claim.owned)
+		{
+			for (std::size_t i = 0; i < slot_count && !t_claim.owned; i++)
+			{
+				bool expected = false;
+
+				if (g_slots[i].owned.compare_exchange_strong(expected, true, std::memory_order_acquire))
+				{
+					t_claim.owned = &g_slots[i];
+				}
+			}
+
+			if (!t_claim.owned)
+			{
+				t_claim.owned = &g_slots[slot_count];
+			}
+		}
+
+		return t_claim;
+	}
+
+	inline void add(counter c, std::uint64_t v = 1) noexcept
+	{
+		slot& s = *local().owned;
+		auto& value = s.value[c];
+
+		if (&s == &g_slots[slot_count])
+		{
+			value.fetch_add(v, std::memory_order_relaxed);
+		}
+		else
+		{
+			value.store(value.load(std::memory_order_relaxed) + v, std::memory_order_relaxed);
+		}
+	}
+
+	// One busy poll at tick `now`; the gap since the previous poll counts as
+	// polling time when it is shorter than poll_gap_ticks.
+	inline void poll(std::uint64_t now, std::uint64_t poll_gap_ticks) noexcept
+	{
+		claim& c = local();
+
+		if (c.last_poll && now > c.last_poll && now - c.last_poll <= poll_gap_ticks)
+		{
+			add(getllar_poll_ticks, now - c.last_poll);
+		}
+
+		c.last_poll = now;
+		add(getllar_polls);
+	}
+
+	inline std::array<std::uint64_t, counter_count> totals() noexcept
+	{
+		std::array<std::uint64_t, counter_count> sum{};
+
+		for (const slot& s : g_slots)
+		{
+			for (std::size_t i = 0; i < counter_count; i++)
+			{
+				sum[i] += s.value[i].load(std::memory_order_relaxed);
+			}
+		}
+
+		return sum;
+	}
+}
