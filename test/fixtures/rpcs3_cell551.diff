diff --git a/rpcs3/ios/RPCS3IOSConfigInheritance.h b/rpcs3/ios/RPCS3IOSConfigInheritance.h
new file mode 100644
index 0000000..23005f9
--- /dev/null
+++ b/rpcs3/ios/RPCS3IOSConfigInheritance.h
@@ -0,0 +1,119 @@
+#pragma once
+
+// REWINDBOX_LEGACY_CONFIG_INHERITANCE_V1: a full custom_configs/config_<TITLE>.yml
+// written by an earlier build is a snapshot of every setting, taken at the
+// title's first per-game change. Upstream then ignores the title's database
+// (GameDB/RewindBox profile) config entirely. God of War III ran every build
+// from 412 to 547 on such a snapshot (CONFIG_LAYERS legacy_custom=1
+// database=0): none of its profile settings was ever applied. A snapshot value
+// equal to the global config is not a choice the file made, so the database
+// value applies there; a value the file changed relative to the global config
+// stays. The result is the layering titles without a snapshot already get:
+// global < database < the file's own changes.
+
+#include "util/yaml.hpp"
+
+#include <string>
+
+namespace rpcs3::ios::config_inheritance
+{
+	struct result
+	{
+		std::string yaml;       // database settings to apply after the full file
+		unsigned inherited = 0; // database leaves the file left at the global value
+		unsigned kept = 0;      // database leaves the file changed: its value stays
+		bool ok = false;        // the three documents parsed and the database is a map
+	};
+
+	namespace detail
+	{
+		inline YAML::Node child(const YAML::Node& node, const std::string& key)
+		{
+			if (node.IsDefined() && node.IsMap())
+			{
+				return node[key];
+			}
+
+			return YAML::Node(YAML::NodeType::Undefined);
+		}
+
+		// Scalars compare as written by cfg::node::to_string(); sequences and maps
+		// compare as their emitted text.
+		inline std::string leaf_text(const YAML::Node& node)
+		{
+			if (!node.IsDefined() || node.IsNull())
+			{
+				return {};
+			}
+
+			if (node.IsScalar())
+			{
+				return node.Scalar();
+			}
+
+			return YAML::Dump(node);
+		}
+
+		inline void filter(const YAML::Node& database, const YAML::Node& file, const YAML::Node& global, YAML::Node& out, result& r)
+		{
+			for (const auto& entry : database)
+			{
+				if (!entry.first.IsScalar())
+				{
+					continue;
+				}
+
+				const std::string key = entry.first.Scalar();
+				const YAML::Node value = entry.second;
+				const YAML::Node in_file = child(file, key);
+				const YAML::Node in_global = child(global, key);
+
+				if (value.IsMap())
+				{
+					YAML::Node section(YAML::NodeType::Map);
+					filter(value, in_file, in_global, section, r);
+
+					if (section.size())
+					{
+						out[key] = section;
+					}
+				}
+				else if (in_file.IsDefined() && leaf_text(in_file) != leaf_text(in_global))
+				{
+					r.kept++;
+				}
+				else
+				{
+					out[key] = value;
+					r.inherited++;
+				}
+			}
+		}
+	}
+
+	// database: the title's database config; file: the full config file applied
+	// on this boot; global: g_cfg.to_string() before that file was applied.
+	inline result inherit_database(const std::string& database, const std::string& file, const std::string& global)
+	{
+		result r;
+		const auto [database_node, database_error] = yaml_load(database);
+		const auto [file_node, file_error] = yaml_load(file);
+		const auto [global_node, global_error] = yaml_load(global);
+
+		if (!database_error.empty() || !file_error.empty() || !global_error.empty() || !database_node.IsMap())
+		{
+			return r;
+		}
+
+		YAML::Node out(YAML::NodeType::Map);
+		detail::filter(database_node, file_node, global_node, out, r);
+		r.ok = true;
+
+		if (r.inherited)
+		{
+			r.yaml = YAML::Dump(out);
+		}
+
+		return r;
+	}
+}
