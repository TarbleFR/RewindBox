 #include <dispatch/dispatch.h>
+#include <pthread/qos.h>
+
+#include "IOSRsxSyncProfile.h"
+
+// REWINDBOX_MOLTENVK_COMPILE_QOS_V1: MoltenVK 1.4.2 builds every Metal library
+// and pipeline with dispatch_async(dispatch_get_global_queue(
+// DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ...) and blocks the calling thread on a
+// condition variable until it finishes (MVKMetalCompiler::compile,
+// MVKSync.mm:451). GCD propagates a user-interactive caller as
+// user-initiated and the condition variable donates nothing, so the RSX thread
+// waited for compiles running below the user-interactive emulator threads
+// (God of War III pipelines: 0.6-4 s each, build 547 logs). That call is the
+// archive's only reference to dispatch_get_global_queue; the build renames it
+// to this function (build-utils/rpcs3/patch_moltenvk_compile_qos.py). The
+// compile now runs in the class of the thread that waits for it.
+extern "C" __attribute__((visibility("hidden"))) dispatch_queue_t rbx_mvk_compile_qos_queue(intptr_t identifier, uintptr_t flags)
+{
+	if (qos_class_self() == QOS_CLASS_USER_INTERACTIVE)
+	{
+		rpcs3::ios::rsx_sync::metal_compiles_interactive.fetch_add(1, std::memory_order_relaxed);
+		return dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0);
+	}
+
+	rpcs3::ios::rsx_sync::metal_compiles_default.fetch_add(1, std::memory_order_relaxed);
+	return dispatch_get_global_queue(identifier, flags);
+}
 
