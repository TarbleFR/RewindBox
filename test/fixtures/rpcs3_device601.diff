+				emit_log(1, "RPCS3 internal process transition preparation failed.");
+			}
+		}, token);
+		return admitted || !restore_jobs().current(token);
+	}
+	catch (...) { return false; }
+}
+}
+
+bool defer_continuous_stop(std::function<void(std::uint64_t)> main_stop, std::uint64_t token, std::uint64_t emulation_id, std::string title_id) noexcept
+{
+	if (!main_stop) return false;
+	try
+	{
+		return schedule_continuous_stop(std::make_shared<continuous_stop_request>(continuous_stop_request{
+			std::move(main_stop), token, emulation_id, std::move(title_id)}));
+	}
+	catch (...) { return false; }
+}
+
+bool defer_continuous_boot(std::function<void()> boot, std::uint64_t token, std::uint64_t emulation_id, std::string title_id) noexcept
+{
+	if (!boot) return false;
+	try
+	{
+		const bool admitted = restore_jobs().post_continuation([boot = std::move(boot), emulation_id, title_id = std::move(title_id)](std::uint64_t generation)
+		{
+			std::lock_guard api_lock(g_api_mutex);
+			if (!restore_jobs().current(generation) || Emu.GetTitleID() != title_id) return;
+			if (g_lifecycle.state() != RPCS3_IOS_STATE_READY ||
+				!g_accept_display_surfaces.load() || Emu.GetStatus(false) != system_state::stopped ||
+				static_cast<std::uint64_t>(Emu.GetEmulationIdentifier()) != emulation_id ||
+				neostation::savestate::current.read().active)
+			{
+				emit_log(1, "RPCS3 internal process boot was no longer ready.");
+				return;
+			}
+			thread_base::set_name("RPCS3 Reboot");
+			try { boot(); }
+			catch (const std::exception& error)
+			{
+				Emu.SetContinuousMode(false);
+				Emu.SetForceBoot(false);
+				set_error(error.what());
+				emit_log(1, "RPCS3 internal process boot failed.");
+			}
+			catch (...)
+			{
+				Emu.SetContinuousMode(false);
+				Emu.SetForceBoot(false);
+				set_error("RPCS3 could not boot the next internal process.");
+				emit_log(1, "RPCS3 internal process boot failed.");
+			}
+		}, token);
+		return admitted || !restore_jobs().current(token);
+	}
+	catch (...) { return false; }
+}
 }
 
