--- /dev/null
+++ b/rpcs3/Emu/CPU/JITCacheCompatibility.cmake
@@ -0,0 +1,13 @@
+# CELL538: the exact reviewed JITLLVM change only suppresses a second SPU
+# cache probe after a validated miss. It changes neither generated objects nor
+# their ABI. Preserve the 536 identity for this exact source snapshot only.
+# Unknown paths or future file changes retain their actual hash and invalidate
+# the cache normally. Never alias older reservation implementations to 536.
+function(neostation_codegen_compatible_hash source actual output)
+    if(source STREQUAL "../../Utilities/JITLLVM.cpp" AND
+       actual STREQUAL "d7094a664f5b59510e518e09e115a01ec0c1cd899d2550dab324b5e925a02fc9")
+        set(${output} "001be95de7767a086647076009cdd9a2d92bf0b82d64a6560f2b06f13111bbdf" PARENT_SCOPE)
+    else()
+        set(${output} "${actual}" PARENT_SCOPE)
+    endif()
+endfunction()
