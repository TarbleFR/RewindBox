 // Fixed process-wide storage, no allocation, no logs and no emulation choices.
 enum class Stage : std::size_t { source, module, graphics, compute, debug_source, count };
 inline std::array<diagnostics::EventCost, static_cast<std::size_t>(Stage::count)> costs{};
+
+// CELL538: operation boundaries permit alignment with guest-flip intervals.
+// Fixed 32-entry storage; producers never wait for the reporter or each other.
+// Slow startup bursts may overflow: every rejected record is counted.
+struct SlowOperation { Stage stage{}; std::uint64_t begin_us = 0, end_us = 0; };
+class SlowOperations final
+{
+    std::mutex mutex_;
+    std::array<SlowOperation, 32> events_{};
+    std::size_t size_ = 0;
+    std::atomic<std::uint64_t> dropped_{0};
+public:
+    struct Snapshot
+    {
+        std::array<SlowOperation, 32> events{};
+        std::size_t size = 0;
+        std::uint64_t dropped = 0;
+        bool captured = false;
+    };
+    void record(Stage stage, std::uint64_t begin_us, std::uint64_t end_us) noexcept
+    {
+        if (end_us < begin_us || end_us - begin_us < 50'000) return;
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock || size_ == events_.size())
+        {
+            dropped_.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        events_[size_++] = {stage, begin_us, end_us};
+    }
+    Snapshot take() noexcept
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        if (!lock) return {};
+        Snapshot result{events_, size_, dropped_.exchange(0, std::memory_order_relaxed), true};
+        size_ = 0;
+        return result;
+    }
+};
