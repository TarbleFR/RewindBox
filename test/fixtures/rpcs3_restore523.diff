+static bool ppu_restore_functions_fit(u32 address, u64 count)
+{
+	// REWINDBOX_RESTORE_HLE_RANGE_V1: a readable first byte does not prove
+	// that the entire saved HLE table (or its 64 KiB registration envelope)
+	// exists. Validate before page protection, dispatch writes or fake OPDs.
+	if (!address || address % 4096 || !count || count > u32{umax} / 8) return false;
+	const u64 length = utils::align<u64>(address % 65536 + count * 8, 65536);
+	const u32 begin = address & -65536;
+	if (length > u32{umax} || length > 0x1'0000'0000ull - begin) return false;
+	return vm::check_addr(begin, vm::page_allocated, static_cast<u32>(length)) &&
+		vm::check_addr(address, vm::page_readable, static_cast<u32>(count * 8));
+}
