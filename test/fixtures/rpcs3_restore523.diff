+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <thread>
+
+namespace rpcs3::ios {
+// One owned worker, created only on the first internal restore. One admission
+// at a time; no unbounded queue, detached thread or new host ABI. Cancellation
+// invalidates a task even after dequeue while it waits for the Core API lock.
+class restore_executor final {
+public:
+    using task = std::function<void(std::uint64_t)>;
+    restore_executor() = default;
+    ~restore_executor();
+    restore_executor(const restore_executor&) = delete;
+    restore_executor& operator=(const restore_executor&) = delete;
+    bool post(task work, std::uint64_t token) noexcept;
+    bool cancel() noexcept;
+    bool current(std::uint64_t token) const noexcept;
+    std::uint64_t generation() const noexcept { return generation_.load(std::memory_order_acquire); }
+    bool close() noexcept; // join outside emulator/API/UI locks
+private:
+    struct job { std::uint64_t token; task work; };
+    std::mutex mutex_, join_mutex_;
+    std::condition_variable changed_;
+    std::optional<job> pending_;
+    std::thread worker_;
+    std::thread::id worker_id_{}; // mutex_: self-close check never reads a joining std::thread
+    std::atomic<std::uint64_t> generation_{1};
+    bool closed_ = false, active_ = false;
+    void run() noexcept;
+};
+// Called after UIKit has completed the existing stop/renderer cleanup.
+// The continuation runs under the Core API mutex, after generation and
+// lifecycle checks. A failure is reported; it never falls back to UIKit I/O.
+std::uint64_t savestate_restore_generation() noexcept;
+// True means scheduled OR an obsolete request safely discarded. False means
+// admission failed for the still-current request. No stale callback may mutate
+// a newer title, even if UIKit delivers it only after a later boot/stop.
+bool defer_savestate_restore(std::function<void()> continuation, std::uint64_t token) noexcept;
+}
