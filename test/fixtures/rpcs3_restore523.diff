+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+namespace rpcs3::ios {
+struct graphics_memory_snapshot {
+    bool valid = false;
+    std::uint64_t system = 0, surfaces = 0, textures = 0, swapchain = 0, scratch = 0, other = 0;
+    std::uint64_t samplers = 0; // object count, never bytes
+};
+// Existing allocation registry, one try-reader-lock, no allocation or wait.
+// Requested bytes classify VMA allocations; they are NOT additional physical
+// RAM and must not be added to VMA/resident/NeoSwap/alias statistics.
+graphics_memory_snapshot capture_graphics_memory_snapshot() noexcept;
+}
