+namespace rpcs3::ios {
+// REWINDBOX_RESTORE_EXECUTOR_BEGIN: portable owned-queue implementation.
+restore_executor::~restore_executor() { close(); }
+bool restore_executor::post(task work, std::uint64_t token) noexcept
+{
+	if (!work) return false;
+	try
+	{
+		std::lock_guard lock(mutex_);
+		if (closed_ || active_ || pending_ || !current(token)) return false;
+		if (!worker_.joinable())
+		{
+			worker_ = std::thread([this] { run(); });
+			worker_id_ = worker_.get_id();
+		}
+		pending_.emplace(job{token, std::move(work)});
+		changed_.notify_one();
+		return true;
+	}
+	catch (...) { return false; }
+}
+bool restore_executor::cancel() noexcept
+{
+	std::optional<job> retired;
+	bool had_work = false;
+	{
+		std::lock_guard lock(mutex_);
+		had_work = active_ || pending_.has_value();
+		generation_.fetch_add(1, std::memory_order_acq_rel);
+		retired.swap(pending_);
+	}
+	return had_work;
+}
+bool restore_executor::current(std::uint64_t token) const noexcept
+{
+	return token == generation_.load(std::memory_order_acquire);
+}
+bool restore_executor::close() noexcept
+{
+	{
+		std::lock_guard lock(mutex_);
+		if (worker_id_ == std::this_thread::get_id()) return false;
+	}
+	std::lock_guard join_lock(join_mutex_);
+	std::optional<job> retired;
+	{
+		std::lock_guard lock(mutex_);
+		closed_ = true;
+		generation_.fetch_add(1, std::memory_order_acq_rel);
+		retired.swap(pending_);
+	}
+	changed_.notify_all();
+	if (worker_.joinable()) worker_.join();
+	{
+		std::lock_guard lock(mutex_);
+		worker_id_ = {};
+	}
+	return true;
+}
+void restore_executor::run() noexcept
+{
+	for (;;)
+	{
+		std::optional<job> selected;
+		{
+			std::unique_lock lock(mutex_);
+			changed_.wait(lock, [this] { return closed_ || pending_.has_value(); });
+			if (closed_) return;
+			selected.swap(pending_);
+			active_ = true;
+		}
+		// The Core continuation wrapper reports execution errors. Always retire
+		// the task and keep queue ownership consistent on an unexpected exception.
+		try { selected->work(selected->token); } catch (...) {}
+		selected.reset();
+		{
+			std::lock_guard lock(mutex_);
+			active_ = false;
+		}
+	}
+}
+// REWINDBOX_RESTORE_EXECUTOR_END
+
+std::uint64_t savestate_restore_generation() noexcept
+{
+	return restore_jobs().generation();
+}
+
+bool defer_savestate_restore(std::function<void()> continuation, std::uint64_t token) noexcept
+{
+	try
+	{
+		const bool admitted = restore_jobs().post([continuation = std::move(continuation)](std::uint64_t generation)
+		{
+			std::lock_guard api_lock(g_api_mutex);
+			if (!restore_jobs().current(generation))
+			{
+				emit_log(4, "SAVESTATE_RESTORE phase=worker_cancelled");
+				return; // Do not finish or mutate a newer title's save operation.
+			}
+			if (g_lifecycle.state() != RPCS3_IOS_STATE_READY ||
+				!g_accept_display_surfaces.load() || Emu.GetStatus(false) != system_state::stopped)
+			{
+				emit_log(1, "SAVESTATE_RESTORE phase=worker_state_rejected");
+				neostation::savestate::current.finish(false, "RPCS3 was no longer ready for savestate restoration.");
+				return;
+			}
+			thread_base::set_name("RPCS3 Restore");
+			emit_log(4, fmt::format("SAVESTATE_RESTORE phase=worker_begin main_thread=%u", pthread_main_np() ? 1u : 0u));
+			try { continuation(); }
+			catch (const std::exception& error)
+			{
+				Emu.SetContinuousMode(false);
+				neostation::savestate::current.finish(false, error.what());
+				emit_log(1, "SAVESTATE_RESTORE phase=worker_exception");
+			}
+			catch (...)
+			{
+				Emu.SetContinuousMode(false);
+				neostation::savestate::current.finish(false, "RPCS3 could not restore the savestate.");
+				emit_log(1, "SAVESTATE_RESTORE phase=worker_exception");
+			}
+			emit_log(4, "SAVESTATE_RESTORE phase=worker_end");
+		}, token);
+		if (!admitted && !restore_jobs().current(token))
+		{
+			emit_log(4, "SAVESTATE_RESTORE phase=worker_cancelled_before_admission");
+			return true;
+		}
+		return admitted;
+	}
+	catch (...) { return false; }
+}
