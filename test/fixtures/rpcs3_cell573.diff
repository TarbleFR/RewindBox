diff --git a/rpcs3/ios/IOSTextureResidency.h b/rpcs3/ios/IOSTextureResidency.h
new file mode 100644
index 000000000..65acd8efe
--- /dev/null
+++ b/rpcs3/ios/IOSTextureResidency.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// CELL573_TEXTURE_RESIDENCY: on iOS the texture cache confirms CPU textures by
+// content hash, not page protection, so a guest write to their memory never
+// faults. A texture whose memory the title has reused for other data is found
+// stale only when it is looked up again; one that is never looked up again
+// keeps its GPU image. God of War III streams its levels through the same
+// guest memory: on build 567 the texture pool grew to 1.72 GB (the PS3 has
+// 512 MB in all), fell to 366 MB when the memory-pressure reclaim purged it,
+// and grew back to 1.56 GB within 75 s. While the live texture bytes exceed
+// `soft_cap_bytes`, idle sections are released, at most `max_bytes_per_pass`
+// per pass, one pass every `pass_interval` frames: first those overlapped by a
+// section used after them that extends past them, whose guest memory holds
+// other data now, once idle for `min_idle_frames_superseded` frames; then the
+// least recently used of those no lookup has used for `min_idle_frames`.
+// Bound textures are never released. A released texture the title samples
+// again is uploaded from guest memory as on its first use.
+namespace rpcs3::ios::texture_residency
+{
+inline std::atomic<bool> enabled{false};
+// Frames presented since boot, advanced by the texture cache's frame end.
+inline std::atomic<std::uint64_t> frame{1};
+
+constexpr std::uint64_t soft_cap_bytes = 768ull << 20;
+constexpr std::uint64_t min_idle_frames = 64;
+constexpr std::uint64_t min_idle_frames_superseded = 8;
+constexpr std::uint64_t pass_interval = 16;
+constexpr std::uint64_t max_bytes_per_pass = 128ull << 20;
+
+inline std::uint64_t current_frame() noexcept
+{
+	return frame.load(std::memory_order_relaxed);
+}
+
+inline void advance_frame() noexcept
+{
+	frame.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline bool pass_due() noexcept
+{
+	return enabled.load(std::memory_order_relaxed) && current_frame() % pass_interval == 0;
+}
+
+inline bool idle(std::uint64_t last_use, std::uint64_t now, bool superseded = false) noexcept
+{
+	return last_use <= now && now - last_use >= (superseded ? min_idle_frames_superseded : min_idle_frames);
+}
+
+template <typename Section>
+struct candidate
+{
+	std::uint64_t last_use = 0;
+	std::uint64_t bytes = 0;
+	Section section{};
+	// Overlapped by a section used after it that extends past it.
+	bool superseded = false;
+};
+
+// Moves the candidates to release to the front and returns their count: only
+// idle ones, superseded first, then least recently used first, until
+// `excess_bytes` (at most `max_bytes_per_pass`) are covered.
+template <typename Section>
+std::size_t select(std::vector<candidate<Section>>& candidates, std::uint64_t now, std::uint64_t excess_bytes)
+{
+	const auto idle_end = std::partition(candidates.begin(), candidates.end(), [now](const candidate<Section>& c)
+	{
+		return idle(c.last_use, now, c.superseded);
+	});
+
+	std::stable_sort(candidates.begin(), idle_end, [](const candidate<Section>& a, const candidate<Section>& b)
+	{
+		return a.superseded != b.superseded ? a.superseded : a.last_use < b.last_use;
+	});
+
+	const std::uint64_t target = std::min(excess_bytes, max_bytes_per_pass);
+	std::uint64_t covered = 0;
+	std::size_t count = 0;
+
+	for (auto it = candidates.begin(); it != idle_end && covered < target; ++it, ++count)
+	{
+		covered += it->bytes;
+	}
+
+	return count;
+}
+}
+
+// CELL573_SCOPED_RSX_WRITES: under "Texture Validation Per FIFO Batch" every
+// guest-memory write by the RSX itself (a render target written back for a
+// CPU read, a render target committed over a range) advanced the global
+// epoch, so the next lookup of every texture hashed it again, wherever it
+// was. God of War III goes through about nine epochs per frame and hashes
+// 6-12 GB of texture data per 5 s window on build 567 (8 ms of its 10 ms
+// texture time per frame). The RSX knows the range it writes: only the
+// sections over it are revalidated. Guest PUT, semaphore acquires, CPU write
+// faults, unmaps and the frame end still advance the global epoch.
+namespace rpcs3::ios::texture_validation_scope
+{
+inline std::atomic<bool> enabled{false};
+}
