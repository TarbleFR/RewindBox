diff --git a/rpcs3/Emu/RSX/Program/ShaderParam.h b/rpcs3/Emu/RSX/Program/ShaderParam.h
--- a/rpcs3/Emu/RSX/Program/ShaderParam.h
+++ b/rpcs3/Emu/RSX/Program/ShaderParam.h
@@ -7,6 +7,42 @@
 #include "util/types.hpp"
 
 #include <unordered_map>
+
+#ifdef RPCS3_IOS
+// Shader placeholders all start with '$'. Copy literal spans once instead of
+// testing every placeholder at every character and moving the remaining text
+// after every replacement. Keep list priority and never reparse replacements.
+template <usz Count>
+std::string replace_shader_tokens(std::string_view source,
+	const std::pair<std::string_view, std::function<std::string()>> (&tokens)[Count])
+{
+	std::string result;
+	result.reserve(source.size());
+	usz cursor = 0;
+	for (usz pos; (pos = source.find('$', cursor)) != std::string_view::npos;)
+	{
+		result.append(source.substr(cursor, pos - cursor));
+		bool matched = false;
+		for (const auto& token : tokens)
+		{
+			if (source.substr(pos, token.first.size()) == token.first)
+			{
+				result += token.second();
+				cursor = pos + token.first.size();
+				matched = true;
+				break;
+			}
+		}
+		if (!matched)
+		{
+			result += '$';
+			cursor = pos + 1;
+		}
+	}
+	result.append(source.substr(cursor));
+	return result;
+}
+#endif
 
