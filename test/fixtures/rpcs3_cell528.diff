diff --git a/rpcs3/ios/IOSRestoreFailure.h b/rpcs3/ios/IOSRestoreFailure.h
new file mode 100644
index 0000000..8c8be8d
--- /dev/null
+++ b/rpcs3/ios/IOSRestoreFailure.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+
+// A recoverable missing-resource failure on the one restore worker. No throws
+// cross the noexcept ID constructors, and no serialized format is changed.
+namespace rpcs3::ios::restore_failure
+{
+struct failure
+{
+    std::uint32_t id = 0, error = 0;
+    std::array<char, 256> disc_path{};
+    bool active = false;
+};
+inline constinit thread_local failure current{};
+inline void reset() noexcept { current = {}; }
+inline bool failed() noexcept { return current.active; }
+inline void missing(std::uint32_t id, std::uint32_t error, std::string_view path) noexcept
+{
+    if (current.active) return; // Preserve the first cause.
+    current.id = id; current.error = error; current.active = true;
+    // Only disc-relative guest names can be exported. Never an iOS container,
+    // host_root, user save name, file content or a persisted absolute host path.
+    if (!path.starts_with("/dev_bdvd/")) return;
+    const auto count = path.size() < current.disc_path.size() ? path.size() : current.disc_path.size() - 1;
+    for (std::size_t i = 0; i < count; ++i)
+    {
+        const auto c = static_cast<unsigned char>(path[i]);
+        current.disc_path[i] = c >= 32 && c < 127 ? static_cast<char>(c) : '?';
+    }
+}
+}
