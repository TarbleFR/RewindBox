diff --git a/rpcs3/ios/IOSPassiveLockGate.h b/rpcs3/ios/IOSPassiveLockGate.h
new file mode 100644
index 000000000..50c4250a7
--- /dev/null
+++ b/rpcs3/ios/IOSPassiveLockGate.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+// CELL571_PASSIVE_LOCK_FAIRNESS: a CPU thread re-entering guest memory
+// (vm::passive_lock) waits until no exclusive writer lock is held anywhere, and
+// a heavy PUTLLC or reservation write takes one while waiting for every PPU
+// thread to park. Several SPUs taking writer locks back to back keep the word
+// set, and the waiter, woken only when it clears, finds a new writer each time
+// (build 567, Dragon Ball Z combat: 520-720 episodes and up to 10 ms per 5 s
+// window, against 3-10 ms in total on build 564). A waiter that has gone
+// through `starving_after` timed waits marks itself starving; a writer about to
+// take its lock first lets the held ones drain while one is, for at most
+// `writer_deferral`. No lock is skipped or weakened: the waiter still waits for
+// the word to clear, and the writer still takes its lock afterwards.
+namespace rpcs3::ios::passive_gate
+{
+inline std::atomic<bool> enabled{false};
+inline std::atomic<std::uint32_t> starving{0};
+
+// passive_lock: timed waits (50 us each) before a waiter counts as starving.
+constexpr std::uint64_t starving_after = 2;
+// Longest a writer defers to a starving waiter before taking its lock anyway.
+constexpr std::chrono::microseconds writer_deferral{500};
+
+// A waiter's starving mark, released on every exit of the wait loop.
+class waiter_mark
+{
+	bool m_marked = false;
+
+public:
+	waiter_mark() noexcept = default;
+	waiter_mark(const waiter_mark&) = delete;
+	waiter_mark& operator=(const waiter_mark&) = delete;
+
+	// Called once per timed wait; marks the waiter from the `starving_after`-th on.
+	void on_timed_wait(std::uint64_t timed_waits) noexcept
+	{
+		if (!m_marked && timed_waits >= starving_after && enabled.load(std::memory_order_relaxed))
+		{
+			m_marked = true;
+			starving.fetch_add(1, std::memory_order_acq_rel);
+		}
+	}
+
+	bool marked() const noexcept
+	{
+		return m_marked;
+	}
+
+	~waiter_mark()
+	{
+		if (m_marked)
+		{
+			starving.fetch_sub(1, std::memory_order_acq_rel);
+		}
+	}
+};
+
+// Before a writer publishes its lock: wait while a waiter starves, bounded.
+// Returns true when it deferred at all.
+inline bool defer_writer() noexcept
+{
+	if (!starving.load(std::memory_order_acquire))
+	{
+		return false;
+	}
+
+	const auto stop = std::chrono::steady_clock::now() + writer_deferral;
+
+	while (starving.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < stop)
+	{
+		std::this_thread::yield();
+	}
+
+	return true;
+}
+}
