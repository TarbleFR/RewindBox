diff --git a/rpcs3/ios/IOSTitleLevers.h b/rpcs3/ios/IOSTitleLevers.h
new file mode 100644
index 000000000..9d6e815da
--- /dev/null
+++ b/rpcs3/ios/IOSTitleLevers.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <string_view>
+
+// CELL575_TITLE_LEVERS: titles whose build 567 logs show the bottleneck an
+// existing lever removes, so that lever's Automatic mode includes them.
+// - Call of Duty: Black Ops II (SPU and RSX bound, accurate reservations on):
+//   3.5-10 million failed SPU PUTLLC per 5 s window (the no-op write-back
+//   pattern of Dragon Ball Z before 565), and 9-16 ms of texture preparation
+//   per frame at about 5,270 draws, every texture lookup hashing again.
+// - Bladestorm: The Hundred Years' War (30 fps, main PPU thread 18.8 ms per
+//   frame): an RSX thread at 0.66 core for a FIFO busy 31 % of the time, and
+//   7.4 ms of texture preparation per frame.
+// Only serials seen in those logs or in the shipped catalogue are listed.
+namespace rpcs3::ios::title_levers
+{
+constexpr bool is_black_ops_ii_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES01717";
+}
+
+constexpr bool is_bladestorm_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES00113" || title_id == "BLUS30070";
+}
+}
diff --git a/rpcs3/ios/RPCS3IOSExperimentalPolicy.cpp b/rpcs3/ios/RPCS3IOSExperimentalPolicy.cpp
index 128aa5cfc..dc809f104 100644
--- a/rpcs3/ios/RPCS3IOSExperimentalPolicy.cpp
+++ b/rpcs3/ios/RPCS3IOSExperimentalPolicy.cpp
@@ -12,6 +12,7 @@
 #include "IOSRsxIdlePark.h"
 #include "IOSPassiveLockGate.h"
 #include "IOSTextureResidency.h"
+#include "IOSTitleLevers.h"
 #include "IOSThreadQoS.h"
 #include "util/asm.hpp" // NEOSTATION_BUILD487_DIAGNOSTICS_V1 (L2): utils::arm_timer_scale
 #include "util/logs.hpp"
@@ -128,10 +129,13 @@ void resolve_experimental_policy() noexcept
 	const bool fps_batch = resolve_mode(g_cfg.ios_experimental.fps_optimization_batch, false);
 	resolved.dma_copy_specialization = arm64_default && resolve_mode(g_cfg.ios_experimental.dma_copy_specialization, fps_batch);
 	resolved.texture_hash_hybrid = arm64_default && resolve_mode(g_cfg.ios_experimental.texture_hash_hybrid, fps_batch);
-	// CELL559_TEXTURE_EPOCH: Automatic is God of War III only, where per-draw
-	// revalidation hashed about 270 MiB per frame interval on build 553.
-	resolved.texture_validation_epoch = resolve_mode(g_cfg.ios_experimental.texture_validation_epoch,
-		is_god_of_war_iii_title(Emu.GetTitleID()));
+	// CELL559_TEXTURE_EPOCH: Automatic is God of War III, where per-draw revalidation
+	// hashed about 270 MiB per frame interval on build 553; CELL575_TITLE_LEVERS adds
+	// Call of Duty: Black Ops II and Bladestorm (ios/IOSTitleLevers.h).
+	const std::string_view title_id = Emu.GetTitleID();
+	const bool texture_epoch_title = is_god_of_war_iii_title(title_id) ||
+		rpcs3::ios::title_levers::is_black_ops_ii_title(title_id) || rpcs3::ios::title_levers::is_bladestorm_title(title_id);
+	resolved.texture_validation_epoch = resolve_mode(g_cfg.ios_experimental.texture_validation_epoch, texture_epoch_title);
 	texture_validation::epoch_enabled.store(resolved.texture_validation_epoch, std::memory_order_relaxed);
 	// CELL560_DEFERRED_COMMIT: Automatic is Dragon Ball Z Budokai HD Collection only,
 	// where build 559 waited for the GPU on one or two framebuffer commits per frame.
@@ -148,15 +152,19 @@ void resolve_experimental_policy() noexcept
 	// build 564 counted about 120,000 successful and 75,000 failed PUTLLC per frame in
 	// combat for about 500 that changed data: the no-op write-backs invalidated each
 	// other's reservations.
+	// CELL575_TITLE_LEVERS adds Call of Duty: Black Ops II: 3.5-10 million failed PUTLLC
+	// per 5 s window on build 567, with accurate reservations on.
 	resolved.noop_putllc_keeps_reservations = resolve_mode(g_cfg.ios_experimental.noop_putllc_keeps_reservations,
-		rpcs3::ios::deferred_commit::is_dbz_budokai_hd_title(Emu.GetTitleID()));
+		rpcs3::ios::deferred_commit::is_dbz_budokai_hd_title(title_id) || rpcs3::ios::title_levers::is_black_ops_ii_title(title_id));
 	// CELL565_RSX_IDLE_PARK: Automatic is Dragon Ball Z Budokai HD Collection, whose RSX
 	// thread yielded 0.90 core for a FIFO busy 33-43 % of the time on build 564, and
 	// God of War III, whose CELL threads need every core. A non-default FIFO idle wait
 	// (Wait for event, Bounded sleep) keeps its own behaviour.
+	// CELL575_TITLE_LEVERS adds Bladestorm: RSX thread 0.66 core for a FIFO busy 31 % on build 567.
 	resolved.rsx_idle_park = g_cfg.ios_experimental.fifo_idle_mode == ios_fifo_idle_mode::yield &&
 		resolve_mode(g_cfg.ios_experimental.rsx_idle_park,
-			rpcs3::ios::deferred_commit::is_dbz_budokai_hd_title(Emu.GetTitleID()) || is_god_of_war_iii_title(Emu.GetTitleID()));
+			rpcs3::ios::deferred_commit::is_dbz_budokai_hd_title(title_id) || is_god_of_war_iii_title(title_id) ||
+			rpcs3::ios::title_levers::is_bladestorm_title(title_id));
 	rpcs3::ios::rsx_idle_park::enabled.store(resolved.rsx_idle_park, std::memory_order_relaxed);
 	// CELL567_THREAD_QOS: Automatic is every title. RPCS3 raises the RSX and audio threads
 	// above the others; on iOS that order only exists while the others run one step lower.
@@ -174,8 +182,8 @@ void resolve_experimental_policy() noexcept
 	resolved.texture_residency = resolve_mode(g_cfg.ios_experimental.texture_residency,
 		is_god_of_war_iii_title(Emu.GetTitleID()));
 	rpcs3::ios::texture_residency::enabled.store(resolved.texture_residency, std::memory_order_relaxed);
-	resolved.scoped_texture_revalidation = resolve_mode(g_cfg.ios_experimental.scoped_texture_revalidation,
-		is_god_of_war_iii_title(Emu.GetTitleID()));
+	// CELL575_TITLE_LEVERS: with the texture epoch, Call of Duty: Black Ops II and Bladestorm.
+	resolved.scoped_texture_revalidation = resolve_mode(g_cfg.ios_experimental.scoped_texture_revalidation, texture_epoch_title);
 	rpcs3::ios::texture_validation_scope::enabled.store(resolved.scoped_texture_revalidation, std::memory_order_relaxed);
 	resolved.neon_byte_swap = resolve_mode(g_cfg.ios_experimental.neon_byte_swap, arm64_default);
 	resolved.neon_primitive_restart = resolve_mode(g_cfg.ios_experimental.neon_primitive_restart, arm64_default);
