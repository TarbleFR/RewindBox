diff --git a/rpcs3/ios/IOSDeferredCommit.h b/rpcs3/ios/IOSDeferredCommit.h
new file mode 100644
index 000000000..661bcee0d
--- /dev/null
+++ b/rpcs3/ios/IOSDeferredCommit.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+
+#include <atomic>
+#include <cstdint>
+#include <string_view>
+
+// CELL560_DEFERRED_COMMIT: with Write Color Buffers off, binding a region as a
+// framebuffer writes a GPU-resident section starting at that address back to
+// guest memory before releasing its pages: the RSX thread submits, waits for
+// the GPU and copies. The GPU copy is recorded at the same point; the wait and
+// the copy to guest memory happen when an access needs the bytes. The pages
+// stay locked until then, so guest code cannot observe the difference; a
+// section rewritten by the GPU before any access never needs the bytes.
+namespace rpcs3::ios::deferred_commit
+{
+inline std::atomic<bool> enabled{false};
+
+inline std::atomic<std::uint64_t> deferrals{0}, deferral_bytes{0};
+// Write-backs of deferred bytes; the forced ones release pages without a flush request.
+inline diagnostics::EventCost writeback_ticks;
+inline std::atomic<std::uint64_t> writeback_bytes{0}, forced_writebacks{0};
+inline std::atomic<std::uint64_t> dropped{0}, dropped_bytes{0};
+inline std::atomic<std::uint64_t> submits{0};
+
+constexpr bool is_dbz_budokai_hd_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES01658";
+}
+}
