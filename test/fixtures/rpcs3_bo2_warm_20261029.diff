 	void driver_manager_t::notify_completed(u64 eid)
 	{
+#ifdef RPCS3_IOS
+		// Only a higher watermark gives the worker another scope to reclaim.
+		// Use the result of the winning CAS: a competing advance can make this
+		// completion obsolete while atomic_op retries. drain() keeps its own wake.
+		const bool advanced = m_eid_ctr.atomic_op([eid](u64& value)
+		{
+			const u64 previous = value;
+			value = std::max(value, eid);
+			return value != previous;
+		});
+		if (!advanced)
+		{
+			return;
+		}
+#else
 		m_eid_ctr.atomic_op([eid](u64& value)
 		{
 			value = std::max(value, eid);
 		});
+#endif
 
 		m_wake_event++;
 		m_wake_event.notify_one();
