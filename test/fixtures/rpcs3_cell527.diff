@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// Build527: bounded, allocation-free observations. No emulation decision reads
+// these counters. Frame samples are guest flips only, not UIKit/overlay frames.
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace rpcs3::ios::diagnostics
+{
+class GuestFrameWindow final
+{
+public:
+    static constexpr std::size_t capacity = 2048;
+    static constexpr std::size_t histogram_bins = 256;
+    static constexpr std::uint32_t histogram_upper_us(std::size_t bin) noexcept
+    {
+        return bin < 128 ? static_cast<std::uint32_t>((bin + 1) * 1000 - 1)
+            : bin < 255 ? static_cast<std::uint32_t>(128000 + (bin - 127) * 8000 - 1) : UINT32_MAX;
+    }
+    struct Sample
+    {
+        std::array<std::uint64_t, histogram_bins> histogram{};
+        std::uint64_t intervals = 0, unavailable = 0, total_us = 0;
+        std::uint32_t median_us = 0, p95_us = 0, p99_us = 0, maximum_us = 0;
+        std::uint64_t over_50ms = 0, over_100ms = 0;
+    };
+
+    // One producer: rsx::thread::flip(). UI flips do not advance the guest
+    // baseline. Microsecond quantization bounds the packed interval to 71 min;
+    // saturation is explicit in the output. The sequence shares the same atomic
+    // word, so a wrap/overwrite cannot produce a torn frame/timestamp pair.
+    void record(bool guest_flip, std::uint64_t now_ticks, std::uint64_t frequency) noexcept
+    {
+        if (!guest_flip || !frequency) return;
+        const auto previous = last_ticks_.exchange(now_ticks, std::memory_order_relaxed);
+        if (!previous || now_ticks <= previous) return;
+        const auto ticks = now_ticks - previous;
+        const auto whole_seconds = ticks / frequency;
+        const auto remainder = ticks % frequency;
+        const auto micros = whole_seconds > UINT32_MAX / 1'000'000
+            ? UINT32_MAX : std::min<std::uint64_t>(UINT32_MAX,
+                whole_seconds * 1'000'000 + (remainder <= UINT64_MAX / 1'000'000
+                    ? remainder * 1'000'000 / frequency
+                    : static_cast<std::uint64_t>(static_cast<long double>(remainder) * 1'000'000 / frequency)));
+        const auto index = published_.load(std::memory_order_relaxed);
+        const auto packed = (static_cast<std::uint64_t>(static_cast<std::uint32_t>(index)) << 32) | micros;
+        ring_[index % capacity].store(packed, std::memory_order_release);
+        published_.store(index + 1, std::memory_order_release);
+    }
+
+    // Lifecycle owner calls only after the old renderer producer has stopped,
+    // as required by reset_performance_metrics(). Monotonic indices preserve
+    // overwrite detection without touching all 2048 slots at every new session.
+    void reset() noexcept
+    {
+        last_ticks_.store(0, std::memory_order_relaxed);
+        cursor_ = published_.load(std::memory_order_acquire);
+    }
+
+    // One consumer: the existing 5 s sampler. At most capacity samples are
+    // sorted on its stack. Concurrent overwrite is counted as unavailable;
+    // UI frames and unsupported/invalid clocks cannot create intervals.
+    Sample take() noexcept
+    {
+        const auto end = published_.load(std::memory_order_acquire);
+        const auto first = std::max(cursor_, end > capacity ? end - capacity : 0);
+        Sample result;
+        result.unavailable = first - cursor_;
+        std::array<std::uint32_t, capacity> intervals{};
+        std::size_t count = 0;
+        for (auto i = first; i < end; ++i)
+        {
+            const auto packed = ring_[i % capacity].load(std::memory_order_acquire);
+            if (static_cast<std::uint32_t>(packed >> 32) != static_cast<std::uint32_t>(i))
+            {
+                ++result.unavailable;
+                continue;
+            }
+            const auto interval = static_cast<std::uint32_t>(packed);
+            intervals[count++] = interval;
+            result.total_us += interval;
+            const auto bin = interval < 128000 ? interval / 1000
+                : std::min<std::uint32_t>(255, 128 + (interval - 128000) / 8000);
+            ++result.histogram[bin];
+            result.over_50ms += interval > 50'000;
+            result.over_100ms += interval > 100'000;
+        }
+        cursor_ = end;
+        result.intervals = count;
+        if (count)
+        {
+            std::sort(intervals.begin(), intervals.begin() + count);
+            const auto percentile = [&](std::size_t percent)
+            {
+                return intervals[(count * percent + 99) / 100 - 1];
+            };
+            result.median_us = percentile(50);
+            result.p95_us = percentile(95);
+            result.p99_us = percentile(99);
+            result.maximum_us = intervals[count - 1];
+        }
+        return result;
+    }
+private:
+    std::array<std::atomic<std::uint64_t>, capacity> ring_{};
+    std::atomic<std::uint64_t> last_ticks_{0}, published_{0};
+    std::uint64_t cursor_ = 0;
+};
+
+// Maxima are observational window maxima. Drain can split an event's count,
+// sum and maximum over adjacent windows; totals across completed drains are
+// conserved. No lock, allocation or clock call is added to the existing hooks.
+class EventCost final
+{
+public:
+    struct Sample { std::uint64_t count = 0, total = 0, maximum = 0; };
+    void record(std::uint64_t duration) noexcept
+    {
+        count_.fetch_add(1, std::memory_order_relaxed);
+        total_.fetch_add(duration, std::memory_order_relaxed);
+        auto old = maximum_.load(std::memory_order_relaxed);
+        while (old < duration && !maximum_.compare_exchange_weak(old, duration, std::memory_order_relaxed)) {}
+    }
+    Sample take() noexcept
+    {
+        return {count_.exchange(0, std::memory_order_relaxed),
+                total_.exchange(0, std::memory_order_relaxed),
+                maximum_.exchange(0, std::memory_order_relaxed)};
+    }
+private:
+    std::atomic<std::uint64_t> count_{0}, total_{0}, maximum_{0};
+};
+
+struct ProcessMemorySample
+{
+    bool valid = false;
+    std::uint64_t footprint = 0, resident = 0, compressed = 0, virtual_bytes = 0;
+};
+class ProcessMemoryWindow final
+{
+public:
+    void reset() noexcept { latest = {}; peak = {}; samples = 0; }
+    void record(ProcessMemorySample value) noexcept
+    {
+        latest = value;
+        if (!value.valid) return;
+        peak.valid = true;
+        peak.footprint = std::max(peak.footprint, value.footprint);
+        peak.resident = std::max(peak.resident, value.resident);
+        peak.compressed = std::max(peak.compressed, value.compressed);
+        peak.virtual_bytes = std::max(peak.virtual_bytes, value.virtual_bytes);
+        ++samples;
+    }
+    ProcessMemorySample latest{}, peak{};
+    std::uint64_t samples = 0;
+};
+}
