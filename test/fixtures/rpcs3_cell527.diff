--- a/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h
+++ b/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h
@@ -52,4 +52,24 @@ inline llvm::Value* halfword_pair_dot(llvm::IRBuilder<>& ir, llvm::Value* accumu
         llvm::Intrinsic::aarch64_neon_addp, {accumulator->getType()});
     return ir.CreateAdd(accumulator, ir.CreateCall(pair, {low, high}));
 }
+// Four adjacent CELL byte terms fit exactly in signed/unsigned 32-bit lanes.
+// DOT with ones replaces the widening, masking and pairwise-add preparation;
+// the caller retains the guest saturating addition and SAT update unchanged.
+inline llvm::Value* byte_sum(llvm::IRBuilder<>& ir, llvm::Value* bytes, bool is_signed)
+{
+    auto* words = llvm::FixedVectorType::get(ir.getInt32Ty(), 4);
+    auto* sum = llvm::Intrinsic::getOrInsertDeclaration(ir.GetInsertBlock()->getModule(),
+        is_signed ? llvm::Intrinsic::aarch64_neon_sdot : llvm::Intrinsic::aarch64_neon_udot,
+        {words, bytes->getType()});
+    return ir.CreateCall(sum, {llvm::Constant::getNullValue(words), bytes,
+        llvm::ConstantInt::get(bytes->getType(), 1)});
+}
+
+inline llvm::Value* signed_halfword_pair_sum(llvm::IRBuilder<>& ir, llvm::Value* halfwords)
+{
+    auto* words = llvm::FixedVectorType::get(ir.getInt32Ty(), 4);
+    auto* sum = llvm::Intrinsic::getOrInsertDeclaration(ir.GetInsertBlock()->getModule(),
+        llvm::Intrinsic::aarch64_neon_saddlp, {words, halfwords->getType()});
+    return ir.CreateCall(sum, {halfwords});
+}
 } // namespace rpcs3::cell::arm64
