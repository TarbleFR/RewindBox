diff --git a/rpcs3/ios/IOSRecyclableImagePool.h b/rpcs3/ios/IOSRecyclableImagePool.h
new file mode 100644
index 0000000..65d78d3
--- /dev/null
+++ b/rpcs3/ios/IOSRecyclableImagePool.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdlib>
+#include <cstdint>
+#include <utility>
+#include <memory>
+
+
+namespace rpcs3::ios::recyclable_image_pool
+{
+// Preserve the pre-existing iOS recycling thresholds; these are neither an
+// active-texture budget nor a change to NeoSwap/driver allocation admission.
+inline constexpr std::uint64_t byte_limit = 256ull * 1024 * 1024;
+inline constexpr std::size_t item_limit = 256;
+
+// At most item_limit entries can be in a newly constructed iOS pool. Only
+// their already-retired unique_ptrs are detached here. A raw-pointer RAII
+// batch avoids allocating during memory pressure; unwritten slots are never
+// initialized, read or deleted. Its count-only common path does no heap work.
+template <typename Image>
+class retirement_batch
+{
+    std::array<Image*, item_limit> images;
+    std::size_t count = 0;
+public:
+    retirement_batch() noexcept = default;
+    retirement_batch(const retirement_batch&) = delete;
+    retirement_batch& operator=(const retirement_batch&) = delete;
+    ~retirement_batch() { clear(); }
+    void emplace_back(std::unique_ptr<Image>&& image) noexcept
+    {
+        if (count == images.size()) std::abort(); // broken pool invariant
+        images[count++] = image.release();
+    }
+    void clear() noexcept
+    {
+        while (count) delete images[--count];
+    }
+};
+
+// Caller owns the existing pool mutex. Entries are newest-first and have
+// already retired from the GPU. A caller-owned retirement batch keeps image
+// destruction out of the pool critical section. The bounded batch never allocates; no per-frame historical walk is needed.
+// incoming_bytes <= byte_limit is the caller's admission precondition.
+template <typename Pool, typename ByteCount, typename Retired>
+void trim_to_fit(Pool& pool, ByteCount& bytes, Retired& retired,
+    std::uint64_t incoming_bytes = 0, bool incoming_item = false)
+{
+    const auto allowed_bytes = byte_limit - incoming_bytes;
+    const auto allowed_items = item_limit - static_cast<std::size_t>(incoming_item);
+    while (!pool.empty() && (pool.size() > allowed_items ||
+        static_cast<std::uint64_t>(bytes) > allowed_bytes))
+    {
+        auto& oldest = pool.back();
+        const auto released_bytes = oldest.data->memory->size();
+        retired.emplace_back(std::move(oldest.data));
+        pool.pop_back();
+        bytes -= released_bytes;
+    }
+}
+}
