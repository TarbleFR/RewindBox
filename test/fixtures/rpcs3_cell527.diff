diff --git a/Utilities/JITPublicationQueue.h b/Utilities/JITPublicationQueue.h
new file mode 100644
index 0000000..1708e6f
--- /dev/null
+++ b/Utilities/JITPublicationQueue.h
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// NEOSTATION_BUILD527_INCREMENTAL_JIT_PUBLICATION_V1
+// MCJIT serializes a memory manager's allocate/notify/finalize callbacks under
+// its engine lock. This queue shares that ownership; it is not a concurrent
+// allocator. Publish only after RuntimeDyld relocation resolution. A resolver
+// error may leave relocations to older sections outstanding: in that case the
+// caller flushes but MUST keep the ranges dirty. Explicit writes made after a
+// successful publication (patchpoints/trampolines) keep their existing direct
+// jit::flush calls and do not rely on this allocation queue.
+namespace jit_publication
+{
+struct snapshot
+{
+	std::uint64_t calls{}, empty_calls{}, deferred_calls{};
+	std::uint64_t history_ranges{}, dirty_ranges{}, flushed_bytes{};
+	std::uint64_t ticks{}, max_ticks{};
+	std::uint64_t retained_metadata_bytes{}, peak_metadata_bytes{};
+};
+
+struct registry
+{
+	std::atomic<std::uint64_t> calls{0}, empty_calls{0}, deferred_calls{0};
+	std::atomic<std::uint64_t> history_ranges{0}, dirty_ranges{0}, flushed_bytes{0};
+	std::atomic<std::uint64_t> ticks{0}, max_ticks{0};
+	std::atomic<std::uint64_t> retained_metadata_bytes{0}, peak_metadata_bytes{0};
+
+	static void maximum(std::atomic<std::uint64_t>& target, std::uint64_t value) noexcept
+	{
+		auto prior = target.load(std::memory_order_relaxed);
+		while (prior < value && !target.compare_exchange_weak(prior, value, std::memory_order_relaxed)) {}
+	}
+
+	snapshot exchange() noexcept
+	{
+		snapshot result;
+		result.calls = calls.exchange(0, std::memory_order_relaxed);
+		result.empty_calls = empty_calls.exchange(0, std::memory_order_relaxed);
+		result.deferred_calls = deferred_calls.exchange(0, std::memory_order_relaxed);
+		result.history_ranges = history_ranges.exchange(0, std::memory_order_relaxed);
+		result.dirty_ranges = dirty_ranges.exchange(0, std::memory_order_relaxed);
+		result.flushed_bytes = flushed_bytes.exchange(0, std::memory_order_relaxed);
+		result.ticks = ticks.exchange(0, std::memory_order_relaxed);
+		result.max_ticks = max_ticks.exchange(0, std::memory_order_relaxed);
+		result.retained_metadata_bytes = retained_metadata_bytes.load(std::memory_order_relaxed);
+		result.peak_metadata_bytes = peak_metadata_bytes.load(std::memory_order_relaxed);
+		return result;
+	}
+};
+
+inline registry& metrics() noexcept
+{
+	static registry instance;
+	return instance;
+}
+
+struct range
+{
+	void* target = nullptr;
+	std::size_t size = 0;
+};
+
+// MM1 owns allocations and keeps target/size records for destruction. MM2's
+// process-lifetime runtime owns them: once published its records can disappear.
+// Neither variant keeps the unused historical writable pointer.
+template <bool RetainAllocations>
+class queue
+{
+	std::vector<range> m_ranges;
+	std::size_t m_published = 0;
+	std::uint64_t m_history = 0;
+
+	void account_capacity(std::size_t old_capacity) noexcept
+	{
+		const auto growth = (m_ranges.capacity() - old_capacity) * sizeof(range);
+		if (growth)
+		{
+			auto& stats = metrics();
+			const auto total = stats.retained_metadata_bytes.fetch_add(growth, std::memory_order_relaxed) + growth;
+			registry::maximum(stats.peak_metadata_bytes, total);
+		}
+	}
+
+public:
+	queue() = default;
+	queue(const queue&) = delete;
+	queue& operator=(const queue&) = delete;
+	~queue()
+	{
+		metrics().retained_metadata_bytes.fetch_sub(m_ranges.capacity() * sizeof(range), std::memory_order_relaxed);
+	}
+
+	void add(void* target, std::size_t size)
+	{
+		const auto old_capacity = m_ranges.capacity();
+		m_ranges.push_back({target, size});
+		account_capacity(old_capacity);
+		++m_history;
+	}
+
+	const std::vector<range>& allocations() const noexcept { return m_ranges; }
+	std::size_t pending() const noexcept { return m_ranges.size() - m_published; }
+	std::size_t metadata_bytes() const noexcept { return m_ranges.capacity() * sizeof(range); }
+
+	template <typename Flush, typename Clock>
+	void publish(Flush&& flush, Clock&& clock, bool can_commit)
+	{
+		const auto begin = clock();
+		auto& stats = metrics();
+		const auto record_duration = [&]() {
+			const auto elapsed = clock() - begin;
+			stats.ticks.fetch_add(elapsed, std::memory_order_relaxed);
+			registry::maximum(stats.max_ticks, elapsed);
+		};
+		stats.calls.fetch_add(1, std::memory_order_relaxed);
+		stats.history_ranges.fetch_add(m_history, std::memory_order_relaxed);
+		const auto count = pending();
+		if (!count)
+		{
+			stats.empty_calls.fetch_add(1, std::memory_order_relaxed);
+			record_duration();
+			return;
+		}
+
+		std::uint64_t bytes = 0;
+		// Commit the cursor only after every flush. If a test/platform flush
+		// throws, the complete dirty suffix remains available for retry.
+		for (auto index = m_published; index < m_ranges.size(); ++index)
+		{
+			const auto& item = m_ranges[index];
+			flush(item.target, item.size);
+			bytes += item.size;
+		}
+		stats.dirty_ranges.fetch_add(count, std::memory_order_relaxed);
+		stats.flushed_bytes.fetch_add(bytes, std::memory_order_relaxed);
+		if (!can_commit)
+		{
+			stats.deferred_calls.fetch_add(1, std::memory_order_relaxed);
+			record_duration();
+			return;
+		}
+		if constexpr (RetainAllocations)
+		{
+			m_published = m_ranges.size();
+		}
+		else
+		{
+			m_ranges.clear();
+			m_published = 0;
+		}
+		record_duration();
+	}
+};
+}
