diff --git a/rpcs3/Emu/RSX/VK/vkutils/pipeline_key_normalization.h b/rpcs3/Emu/RSX/VK/vkutils/pipeline_key_normalization.h
new file mode 100644
index 0000000..95b4aff
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/pipeline_key_normalization.h
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "graphics_pipeline_state.hpp"
+
+namespace vk
+{
+    // CELL542: a pipeline may be used with a compatible render pass. The
+    // current encoder stores five 3-bit layouts at bits 22..36. General and
+    // attachment-optimal layouts do not change compatibility. Preserve slot
+    // presence, formats, samples, input references, reserved bits and the
+    // feedback-loop encoding (4). Never use this key to begin a render pass or
+    // transition an image: only normalize the private compiled-pipeline key.
+    constexpr u64 compatible_pipeline_renderpass_key(u64 key) noexcept
+    {
+        for (u32 shift = 22; shift < 37; shift += 3)
+        {
+            const u64 layout = (key >> shift) & 7;
+            if (layout == 2 || layout == 3)
+                key = (key & ~(7ull << shift)) | (1ull << shift);
+        }
+        return key;
+    }
+
+    inline void normalize_pipeline_blending(graphics_pipeline_state& state) noexcept
+    {
+        for (u32 i = 0; i < state.cs.attachmentCount; ++i)
+        {
+            auto& a = state.att_state[i];
+            if (!a.colorWriteMask || state.cs.logicOpEnable)
+                a.blendEnable = VK_FALSE;
+
+            const bool rgb_unused = !a.blendEnable ||
+                !(a.colorWriteMask & (VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT));
+            const bool alpha_unused = !a.blendEnable || !(a.colorWriteMask & VK_COLOR_COMPONENT_A_BIT);
+            if (rgb_unused) a.colorBlendOp = VK_BLEND_OP_ADD;
+            if (alpha_unused) a.alphaBlendOp = VK_BLEND_OP_ADD;
+
+            // MIN/MAX do not multiply by the factors. Masked alpha blending
+            // does not remove the shader's alpha output: RGB may still use it.
+            if (rgb_unused || a.colorBlendOp == VK_BLEND_OP_MIN || a.colorBlendOp == VK_BLEND_OP_MAX)
+            {
+                a.srcColorBlendFactor = VK_BLEND_FACTOR_ONE;
+                a.dstColorBlendFactor = VK_BLEND_FACTOR_ZERO;
+            }
+            if (alpha_unused || a.alphaBlendOp == VK_BLEND_OP_MIN || a.alphaBlendOp == VK_BLEND_OP_MAX)
+            {
+                a.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+                a.dstAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+            }
+        }
+    }
+}
