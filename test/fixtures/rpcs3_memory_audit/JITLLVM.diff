+void jit_compiler::release_cached_object_buffers()
+{
+#ifdef RPCS3_IOS
+	auto& window = validated_objects();
+	std::lock_guard lock(window.mutex);
+	for (auto& [path, item] : window.entries) item.buffer.reset();
+	window.bytes = 0;
+#endif
+}
