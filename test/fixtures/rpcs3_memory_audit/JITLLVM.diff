+struct object_file_identity
+{
+	std::string path;
+	std::uint64_t device{}, inode{}, size{};
+	std::int64_t modified{}, changed{}, modified_ns{}, changed_ns{};
+	bool valid = false;
+	bool operator==(const object_file_identity&) const = default;
+};
+object_file_identity object_identity(const std::string& path)
+{
+	object_file_identity result;
+	struct stat st{};
+	result.path = path + ".gz";
+	if (::stat(result.path.c_str(), &st) != 0)
+	{
+		result.path = path;
+		if (::stat(result.path.c_str(), &st) != 0) return result;
+	}
+	if (!S_ISREG(st.st_mode)) return result;
+	result.device = st.st_dev; result.inode = st.st_ino; result.size = st.st_size;
+#ifdef __APPLE__
+	result.modified = st.st_mtimespec.tv_sec; result.modified_ns = st.st_mtimespec.tv_nsec;
+	result.changed = st.st_ctimespec.tv_sec; result.changed_ns = st.st_ctimespec.tv_nsec;
+#else
+	result.modified = st.st_mtim.tv_sec; result.modified_ns = st.st_mtim.tv_nsec;
+	result.changed = st.st_ctim.tv_sec; result.changed_ns = st.st_ctim.tv_nsec;
+#endif
+	result.valid = true;
+	return result;
+}
+// Validation metadata is bounded to 4096 entries; at most 32 MiB of validated
+// object bytes survive until linking. No full-title decompressed cache.
+struct validated_object_window
+{
+	struct entry { object_file_identity identity; std::unique_ptr<llvm::MemoryBuffer> buffer; };
+	std::mutex mutex;
+	std::unordered_map<std::string, entry> entries;
+	std::size_t bytes = 0;
+	bool checked(const std::string& path, const object_file_identity& identity)
+	{
+		std::lock_guard lock(mutex);
+		const auto it = entries.find(path);
+		return identity.valid && it != entries.end() && it->second.identity == identity;
+	}
+	void remember(const std::string& path, object_file_identity identity, std::unique_ptr<llvm::MemoryBuffer> buffer)
+	{
+		if (!identity.valid) return;
+		std::lock_guard lock(mutex);
+		if (entries.size() >= 4096) { entries.clear(); bytes = 0; }
+		if (auto it = entries.find(path); it != entries.end() && it->second.buffer)
+			bytes -= it->second.buffer->getBufferSize();
+		if (buffer->getBufferSize() > 32 * 1024 * 1024 - bytes) buffer.reset();
+		if (buffer) bytes += buffer->getBufferSize();
+		entries[path] = {std::move(identity), std::move(buffer)};
+	}
+	std::unique_ptr<llvm::MemoryBuffer> take(const std::string& path, const object_file_identity& identity)
+	{
+		std::lock_guard lock(mutex);
+		const auto it = entries.find(path);
+		if (it == entries.end()) return nullptr;
+		if (it->second.buffer) bytes -= it->second.buffer->getBufferSize();
+		auto buffer = it->second.identity == identity && identity.valid ? std::move(it->second.buffer) : nullptr;
+		entries.erase(it);
+		return buffer;
+	}
+};
+validated_object_window& validated_objects()
+{
+	static validated_object_window window;
+	return window;
+}
+}
 #endif
 
