diff --git a/rpcs3/ios/IOSTitleLevers.h b/rpcs3/ios/IOSTitleLevers.h
index 6327e8557..4d0bcdd5b 100644
--- a/rpcs3/ios/IOSTitleLevers.h
+++ b/rpcs3/ios/IOSTitleLevers.h
@@ -27,6 +27,15 @@
 // Its build 583 logs spend 490-640 ms per 5 s window in vkQueueSubmit (1,200-2,500
 // submits, RSXSYNC551 submit=), the Metal encoding of synchronous submits, on the
 // RSX offloader thread that the RSX thread waits for at each submission.
+//
+// CELL589_TITLE_LEVERS: Assassin's Creed joins the texture validation epoch
+// (559) and the scoped revalidation (573), the two levers of Black Ops II and
+// Bladestorm (575). Its first build 585 run (BLES00158) is bound by the RSX
+// thread in the game scenes (10-29 fps; RSX thread 0.4-0.8 core, FIFO busy
+// 70-96 %) at 1,000-3,300 draws per frame, with 14-45 ms of texture
+// preparation per frame (RSXFRAME551 texture_ms) and no epoch (OPT559
+// texture_epoch=0): every texture lookup hashing again.
+// Serials of the shipped cheat catalogue (BLES00158, BLUS30089).
 namespace rpcs3::ios::title_levers
 {
 constexpr bool is_black_ops_ii_title(std::string_view title_id) noexcept
@@ -38,4 +47,9 @@ constexpr bool is_bladestorm_title(std::string_view title_id) noexcept
 {
 	return title_id == "BLES00113" || title_id == "BLUS30070";
 }
+
+constexpr bool is_assassins_creed_title(std::string_view title_id) noexcept
+{
+	return title_id == "BLES00158" || title_id == "BLUS30089";
+}
 }
