diff --git a/rpcs3/ios/IOSEarlySubmit.h b/rpcs3/ios/IOSEarlySubmit.h
new file mode 100644
index 000000000..e5df604df
--- /dev/null
+++ b/rpcs3/ios/IOSEarlySubmit.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// CELL561_EARLY_SUBMIT: the RSX thread records the draws of a frame into one
+// command buffer and submits it at the flip, or when a guest access to memory
+// the GPU wrote asks for a flush. A title that reads a render target back every
+// frame then waits, from that access, for the GPU to execute everything the
+// frame recorded. When the GPU has completed every command buffer already
+// submitted, the draws recorded since then are submitted at the end of a draw,
+// so the GPU renders while the RSX thread keeps recording. The commands, their
+// order and their synchronization are unchanged; only command buffer
+// boundaries move, at the point a flush request already uses. A GPU that is
+// still busy never sees an early submission.
+namespace rpcs3::ios::early_submit
+{
+inline std::atomic<bool> enabled{false};
+
+// An early submission carries at least this many draws; a frame has at most this many.
+constexpr std::uint32_t min_draws = 32;
+constexpr std::uint32_t max_per_frame = 6;
+
+inline std::atomic<std::uint64_t> submits{0}, submitted_draws{0}, gpu_busy{0}, frame_capped{0};
+
+enum class verdict : std::uint8_t
+{
+	keep,      // fewer than min_draws recorded, or disabled
+	gpu_busy,  // the last submission has not completed: the GPU has work
+	capped,    // this frame already used max_per_frame early submissions
+	submit,
+};
+
+// draws: recorded since the last primary submission; this_frame: early
+// submissions since the last flip; gpu_idle: the last primary submission completed.
+constexpr verdict decide(bool on, std::uint32_t draws, std::uint32_t this_frame, bool gpu_idle) noexcept
+{
+	if (!on || draws < min_draws)
+	{
+		return verdict::keep;
+	}
+
+	if (this_frame >= max_per_frame)
+	{
+		return verdict::capped;
+	}
+
+	return gpu_idle ? verdict::submit : verdict::gpu_busy;
+}
+}
