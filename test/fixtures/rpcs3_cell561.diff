+#ifdef RPCS3_IOS
+void VKGSRender::ios_early_submit()
+{
+	namespace early = rpcs3::ios::early_submit;
+	if (!early::enabled.load(std::memory_order_relaxed))
+	{
+		return;
+	}
+
+	if (++m_ios_draws_since_submit < early::min_draws)
+	{
+		return;
+	}
+
+	// A submission in progress, an offloader fault or uninterruptible recording keep the current boundaries.
+	if ((m_queue_status & flush_queue_state::flushing) || (m_queue_status & flush_queue_state::deadlock) ||
+		vk::is_uninterruptible())
+	{
+		return;
+	}
+
+	// Non-blocking: the fence of the last primary submission, if it has completed.
+	const bool gpu_idle = !m_ios_last_primary_submit || m_ios_last_primary_submit->poke();
+	switch (early::decide(true, m_ios_draws_since_submit, m_ios_early_submits_this_frame, gpu_idle))
+	{
+	case early::verdict::submit:
+	{
+		const u32 draws = m_ios_draws_since_submit;
+		flush_command_queue();
+		m_ios_early_submits_this_frame++;
+		early::submits.fetch_add(1, std::memory_order_relaxed);
+		early::submitted_draws.fetch_add(draws, std::memory_order_relaxed);
+		break;
+	}
+	case early::verdict::gpu_busy:
+		early::gpu_busy.fetch_add(1, std::memory_order_relaxed);
+		break;
+	case early::verdict::capped:
+		early::frame_capped.fetch_add(1, std::memory_order_relaxed);
+		break;
+	case early::verdict::keep:
+		break;
+	}
+}
+#endif
