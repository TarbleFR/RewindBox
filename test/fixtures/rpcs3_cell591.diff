@@ -1374,6 +1374,11 @@ bool jit_compiler::try_add(std::unique_ptr<llvm::Module> _module, const std::str
 		m_engine->generateCodeForModule(ptr);
 	}, error))
 	{
+#ifdef RPCS3_IOS
+		// CELL591_OBJECT_CACHE_LIFETIME: cache belongs to this stack frame.
