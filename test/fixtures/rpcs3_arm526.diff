diff --git a/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h b/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h
new file mode 100644
index 00000000..7771e2d7
--- /dev/null
+++ b/rpcs3/Emu/CPU/Backends/AArch64/CellVectorLowering.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <llvm/IR/Constants.h>
+#include <llvm/IR/IRBuilder.h>
+#include <llvm/IR/Intrinsics.h>
+#include <llvm/IR/IntrinsicsAArch64.h>
+#include <llvm/IR/Module.h>
+
+// Exact modulo-2^32 CELL dot products. This layer builds guest instructions;
+// it is independent of the host runtime SIMD implementation and never changes
+// memory accesses, saturation state, floating-point state or instruction order.
+namespace rpcs3::cell::arm64
+{
+inline llvm::Value* unsigned_byte_dot(llvm::IRBuilder<>& ir, llvm::Value* accumulator,
+    llvm::Value* a, llvm::Value* b)
+{
+    auto* dot = llvm::Intrinsic::getOrInsertDeclaration(ir.GetInsertBlock()->getModule(),
+        llvm::Intrinsic::aarch64_neon_udot, {accumulator->getType(), a->getType()});
+    return ir.CreateCall(dot, {accumulator, a, b});
+}
+
+inline llvm::Value* signed_unsigned_byte_dot(llvm::IRBuilder<>& ir, llvm::Value* accumulator,
+    llvm::Value* a, llvm::Value* b)
+{
+    // sign_extend(a) == zero_extend(a XOR 0x80) - 128. UDOT handles
+    // four adjacent bytes per word; the correction is exact modulo 2^32,
+    // including accumulator wraparound. This requires DOTPROD, not I8MM.
+    auto* bias = llvm::ConstantInt::get(a->getType(), 0x80);
+    auto* ones = llvm::ConstantInt::get(b->getType(), 1);
+    auto* zero = llvm::Constant::getNullValue(accumulator->getType());
+    auto* product = unsigned_byte_dot(ir, accumulator, ir.CreateXor(a, bias), b);
+    auto* correction = unsigned_byte_dot(ir, zero, b, ones);
+    return ir.CreateSub(product, ir.CreateShl(correction, 7));
+}
+
+inline llvm::Value* halfword_pair_dot(llvm::IRBuilder<>& ir, llvm::Value* accumulator,
+    llvm::Value* a, llvm::Value* b, bool is_signed)
+{
+    // Each host word contains the two corresponding guest halfwords. Addition
+    // is commutative within the pair, so host little-endian lane order needs
+    // no byte reversal. Wider products and ADDP all have defined wrapping.
+    auto* module = ir.GetInsertBlock()->getModule();
+    auto* multiply = llvm::Intrinsic::getOrInsertDeclaration(module,
+        is_signed ? llvm::Intrinsic::aarch64_neon_smull : llvm::Intrinsic::aarch64_neon_umull,
+        {accumulator->getType()});
+    auto* low = ir.CreateCall(multiply, {ir.CreateShuffleVector(a, {0, 1, 2, 3}),
+        ir.CreateShuffleVector(b, {0, 1, 2, 3})});
+    auto* high = ir.CreateCall(multiply, {ir.CreateShuffleVector(a, {4, 5, 6, 7}),
+        ir.CreateShuffleVector(b, {4, 5, 6, 7})});
+    auto* pair = llvm::Intrinsic::getOrInsertDeclaration(module,
+        llvm::Intrinsic::aarch64_neon_addp, {accumulator->getType()});
+    return ir.CreateAdd(accumulator, ir.CreateCall(pair, {low, high}));
+}
+} // namespace rpcs3::cell::arm64
