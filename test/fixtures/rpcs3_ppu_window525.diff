+// Cache buffers belong to PPU loading, not to a query of the codegen setting.
+// The boot contains module calls; precompilation can also run module calls in
+// parallel. Release transient bytes only after their last loading owner exits.
+// Identity metadata and the global 32 MiB bound remain in validated_objects().
+namespace
+{
+class ppu_object_window_scope
+{
+	inline static std::mutex s_mutex;
+	inline static std::size_t s_owners = 0;
+
+public:
+	ppu_object_window_scope()
+	{
+		std::lock_guard lock(s_mutex);
+		++s_owners;
+	}
+
+	~ppu_object_window_scope()
+	{
+		std::lock_guard lock(s_mutex);
+		if (--s_owners == 0)
+		{
+			jit_compiler::release_cached_object_buffers();
+		}
+	}
+
+	ppu_object_window_scope(const ppu_object_window_scope&) = delete;
+	ppu_object_window_scope& operator=(const ppu_object_window_scope&) = delete;
+};
+}
