diff --git a/rpcs3/Crypto/unzip.cpp b/rpcs3/Crypto/unzip.cpp
index 6485e4d..0057235 100644
--- a/rpcs3/Crypto/unzip.cpp
+++ b/rpcs3/Crypto/unzip.cpp
@@ -141,7 +141,16 @@ bool zip(const void* src, usz size, fs::file& out, bool multi_thread_it)
 
 	utils::serial compressor;
 	compressor.set_expect_little_data(!multi_thread_it || size < 0x40'0000);
-	compressor.m_file_handler = make_compressed_serialization_file_handler(out);
+	auto handler = make_compressed_serialization_file_handler(out);
+#ifdef RPCS3_IOS
+	// REWINDBOX_JIT_OBJECT_DEFLATE_LEVEL_V1: zip() stores the PPU/SPU LLVM
+	// objects on the compiling thread. Level 9 cost 3.58 s for one 6.66 MB PPU
+	// object on an iPhone (build 541), inside a 6.93 s code generation; level 1
+	// is 3.3x-9.5x faster on ARM64 code for 8-9% more bytes. The gzip stream
+	// stays readable by every Core, so no cache is invalidated.
+	handler->set_deflate_level(Z_BEST_SPEED);
+#endif
+	compressor.m_file_handler = std::move(handler);
 
 	std::string_view buffer_view{static_cast<const char*>(src), size};
 
