diff --git a/rpcs3/ios/IOSShaderTiming.h b/rpcs3/ios/IOSShaderTiming.h
new file mode 100644
index 0000000..b0a06a6
--- /dev/null
+++ b/rpcs3/ios/IOSShaderTiming.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include "IOSRuntimeMetrics.h"
+#include <chrono>
+
+namespace rpcs3::ios::shader_timing
+{
+// Measure the actual Vulkan/compiler entry points: the legacy synchronous
+// path does not visit the asynchronous pipeline worker's existing counters.
+// Fixed process-wide storage, no allocation, no logs and no emulation choices.
+enum class Stage : std::size_t { source, module, graphics, compute, debug_source, count };
+inline std::array<diagnostics::EventCost, static_cast<std::size_t>(Stage::count)> costs{};
+
+class Scope final
+{
+    using Clock = std::chrono::steady_clock;
+    Stage stage_;
+    Clock::time_point begin_ = Clock::now();
+public:
+    explicit Scope(Stage stage) noexcept : stage_(stage) {}
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+    ~Scope() noexcept
+    {
+        const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - begin_).count();
+        costs[static_cast<std::size_t>(stage_)].record(static_cast<std::uint64_t>(std::max<std::int64_t>(elapsed, 0)));
+    }
+};
+
+inline auto take() noexcept
+{
+    std::array<diagnostics::EventCost::Sample, costs.size()> result{};
+    for (std::size_t i = 0; i < result.size(); ++i) result[i] = costs[i].take();
+    return result;
+}
+}
