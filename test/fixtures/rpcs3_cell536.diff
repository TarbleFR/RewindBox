+// CELL536: retain the renderer's actual configuration in periodic evidence.
+// Fixed storage, no renderer dereference, no lock on a frame/compile path.
+struct Configuration
+{
+    bool captured = false, live = false, interpreter_supported = false;
+    std::uint32_t configured = 0, applied = 0;
+    std::uint64_t generation = 0;
+};
+class ConfigurationProfile final
+{
+    mutable std::mutex mutex_;
+    const void* owner_ = nullptr;
+    Configuration value_{};
+public:
+    void begin(const void* owner, std::uint32_t configured, std::uint32_t applied, bool supported)
+    {
+        std::lock_guard lock(mutex_);
+        owner_ = owner;
+        value_ = {true, true, supported, configured, applied, value_.generation + 1};
+    }
+    void end(const void* owner)
+    {
+        std::lock_guard lock(mutex_);
+        if (owner_ != owner) return;
+        owner_ = nullptr;
+        value_ = {true, false, false, 0, 0, value_.generation};
+    }
+    Configuration capture() const
+    {
+        std::unique_lock lock(mutex_, std::try_to_lock);
+        return lock ? value_ : Configuration{};
+    }
+};
+inline constinit ConfigurationProfile configuration;
+
 class Scope final
