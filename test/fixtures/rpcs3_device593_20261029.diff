+
+// MoltenVK creates a separate encoding queue for every VkQueue, including the
+// spare transfer queue. Match the family and index used by vkQueuePresentKHR;
+// neither creation order nor the total number of queues identifies it.
+struct queue_identity
+{
+	std::uint32_t family = 0;
+	std::uint32_t index = 0;
+	bool valid = false;
+};
+
+constexpr queue_identity parse_exec_queue_label(std::string_view label) noexcept
+{
+	if (!is_exec_queue_label(label))
+	{
+		return {};
+	}
+
+	label.remove_prefix(std::string_view{"MoltenVKQueue-"}.size());
+	label.remove_suffix(std::string_view{"-Dispatch"}.size());
+	auto number = [&label](std::uint32_t& value)
+	{
+		std::size_t count = 0;
+		while (count < label.size() && label[count] >= '0' && label[count] <= '9')
+		{
+			const auto digit = static_cast<std::uint32_t>(label[count] - '0');
+			if (value > (UINT32_MAX - digit) / 10)
+			{
+				return false;
+			}
+			value = value * 10 + digit;
+			++count;
+		}
+		if (!count || count == label.size() || label[count] != '-' || (count > 1 && label[0] == '0'))
+		{
+			return false;
+		}
+		label.remove_prefix(count + 1);
+		return true;
+	};
+
+	queue_identity result;
+	if (!number(result.family) || !number(result.index))
+	{
+		return {};
+	}
+
+	// MVKQueue::initName uses %.1f for a Vulkan priority in [0, 1]. Treat an
+	// unfamiliar format as missing identity and retain the existing fallback.
+	result.valid = label.size() == 3 && label[1] == '.' &&
+		((label[0] == '0' && label[2] >= '0' && label[2] <= '9') || label == "1.0");
+	return result;
 }
 
