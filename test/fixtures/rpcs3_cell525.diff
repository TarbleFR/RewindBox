diff --git a/rpcs3/ios/IOSGPUMemoryProfile.h b/rpcs3/ios/IOSGPUMemoryProfile.h
new file mode 100644
index 0000000..286359d
--- /dev/null
+++ b/rpcs3/ios/IOSGPUMemoryProfile.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include <mutex>
+namespace rpcs3::ios {
+// Diagnostic copies only. Neither the reporter nor this lock accesses a live
+// Vulkan allocator/cache. Hot-path publication and capture never wait; start /
+// stop may take the lock, but do not hold it across any GPU or allocator work.
+struct memory_sample_status {
+    bool captured = false, owner_live = false, sampled = false;
+    std::uint64_t generation = 0;
+};
+struct vma_memory_sample : memory_sample_status {
+    std::uint64_t block_bytes = 0, allocated = 0, unused = 0;
+};
+struct texture_memory_sample : memory_sample_status {
+    std::uint64_t recyclable_images = 0, recyclable_bytes = 0;
+};
+template <typename Sample> class owned_memory_profile {
+    mutable std::mutex mutex;
+    const void* owner = nullptr;
+    std::uint64_t generation = 0;
+    Sample value{};
+public:
+    void begin(const void* current) {
+        std::lock_guard lock(mutex);
+        owner = current;
+        value = {};
+        value.owner_live = true;
+        value.generation = ++generation;
+    }
+    void end(const void* current) {
+        std::lock_guard lock(mutex);
+        // A delayed teardown from an older device must not erase the new one.
+        if (owner != current) return;
+        owner = nullptr;
+        value = {};
+        value.generation = generation;
+    }
+    bool publish(const void* current, Sample sample) {
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock || owner != current) return false;
+        sample.owner_live = sample.sampled = true;
+        sample.generation = generation;
+        value = sample;
+        return true;
+    }
+    Sample capture() const {
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock) return {};
+        auto result = value;
+        result.captured = true;
+        return result;
+    }
+};
+inline constinit owned_memory_profile<vma_memory_sample> vma_profile;
+inline constinit owned_memory_profile<texture_memory_sample> texture_profile;
+}
