diff --git a/rpcs3/Emu/RSX/RSXThread.cpp b/rpcs3/Emu/RSX/RSXThread.cpp
--- a/rpcs3/Emu/RSX/RSXThread.cpp
+++ b/rpcs3/Emu/RSX/RSXThread.cpp
@@ -2166,9 +2166,29 @@
 
 		const auto [program_offset, program_location] = method_registers.shader_program_address();
 		const auto prev_textures_reference_mask = current_fp_metadata.referenced_textures_mask;
+#ifdef RPCS3_IOS
+		const auto prev_bx2_texture_reads_mask = current_fp_metadata.bx2_texture_reads_mask;
+#endif
 
 		auto data_ptr = vm::base(rsx::get_address(program_offset, program_location));
 		current_fp_metadata = program_hash_util::fragment_program_utils::analyse_fragment_program(data_ptr);
+#ifdef RPCS3_IOS
+		// The shader's BX2 use also selects the texture view and filtering. Keep
+		// dormant units dirty so their next use cannot reuse the old selection.
+		const auto changed_bx2_reads = prev_bx2_texture_reads_mask ^ current_fp_metadata.bx2_texture_reads_mask;
+		for (u32 changed = changed_bx2_reads, i = 0; changed; changed >>= 1, ++i)
+		{
+			if (changed & 1) m_textures_dirty[i] = true;
+		}
+
+		// Conversion control is shared by the fragment program. Rebuild it when
+		// references change in either direction, including the last software-
+		// converted texture disappearing without any BX2 change.
+		if (changed_bx2_reads || (prev_textures_reference_mask != current_fp_metadata.referenced_textures_mask))
+		{
+			m_graphics_state |= rsx::pipeline_state::fragment_program_state_dirty;
+		}
+#endif
 
 		current_fragment_program.data = (static_cast<u8*>(data_ptr) + current_fp_metadata.program_start_offset);
 		current_fragment_program.offset = program_offset + current_fp_metadata.program_start_offset;
diff --git a/rpcs3/Emu/RSX/VK/VKGSRender.cpp b/rpcs3/Emu/RSX/VK/VKGSRender.cpp
--- a/rpcs3/Emu/RSX/VK/VKGSRender.cpp
+++ b/rpcs3/Emu/RSX/VK/VKGSRender.cpp
@@ -2574,7 +2574,13 @@
 		{
 			const VkSemaphore async_sema = *async_scheduler->get_sema();
 			secondary_submit_info.queue_signal(async_sema);
+			// Layout transitions and vertex sampling may consume the upload first.
+#ifdef RPCS3_IOS
+			primary_submit_info.wait_on(async_sema, VK_PIPELINE_STAGE_TRANSFER_BIT |
+				VK_PIPELINE_STAGE_VERTEX_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT);
+#else
 			primary_submit_info.wait_on(async_sema, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT);
+#endif
 
 			// Delay object destruction by one cycle
 			vk::get_resource_manager()->push_down_current_scope();
