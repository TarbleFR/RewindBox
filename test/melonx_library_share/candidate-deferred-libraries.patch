@@ -2811,8 +2814,11 @@ void MVKPipelineCache::readData(const VkPipelineCacheCreateInfo* pCreateInfo) {
 		// (a read-only mapping of the cache file) instead of being copied: the caller keeps that data mapped and
 		// unchanged until this cache, and every cache its libraries are merged into, is destroyed.
 		bool referenceData = false;
+		bool deferLibraries = false;
+		uint32_t librariesRead = 0;
 		for (const auto* next = (const VkBaseInStructure*)pCreateInfo->pNext; next; next = next->pNext) {
 			if ((uint32_t)next->sType == kRewindBoxMappedCacheDataSType) { referenceData = true; }
+			if ((uint32_t)next->sType == kRewindBoxDeferredLibrariesSType) { deferLibraries = true; }
 		}
 
 		// Read the data header...and ensure correct byte-order.
