+// RewindBox: the MTLLibrary of a deferred library, compiled from its compressed MSL (Metal finds a source it compiled
+// before in its own cache). Touches no member: concurrent retrievals each compile and release their own.
+id<MTLLibrary> MVKShaderLibrary::newDeferredMTLLibrary() {
+	string msl;
+	decompressMSL(msl);
+	MVKShaderLibraryCompiler* slc = new MVKShaderLibraryCompiler(_owner);
+	NSString* nsSrc = [[NSString alloc] initWithUTF8String: msl.c_str()];	// temp retained
+	vector<pair<MSLSpecializationMacroInfo, MVKShaderMacroValue>> macro_def;
+	id<MTLLibrary> mtlLibrary = slc->newMTLLibrary(nsSrc, _shaderConversionResultInfo, macro_def);	// retained
+	[nsSrc release];
+	slc->destroy();
+	return mtlLibrary;
+}
