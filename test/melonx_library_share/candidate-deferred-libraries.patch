+					slCache->addShaderLibrary(&shaderConversionConfig, resultInfo, compressedMSL, deferLibraries);
+					librariesRead++;
 
 					break;
 				}
@@ -2879,6 +2886,13 @@ void MVKPipelineCache::readData(const VkPipelineCacheCreateInfo* pCreateInfo) {
 			}
 		}
 
+		// RewindBox: one line per loaded cache, so a journal says which way its data was taken.
+		if (librariesRead > 0) {
+			MVKLogInfo("RewindBox pipeline cache load: %u shader libraries from %zu bytes; compressed MSL %s; MTLLibraries %s.",
+					   librariesRead, byteCount, referenceData ? "referenced in the caller's data" : "copied",
+					   deferLibraries ? "deferred to their first use" : "compiled now");
+		}
+
 	} catch (cereal::Exception& ex) {
 		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "Error reading pipeline cache data: %s", ex.what()));
 	}
