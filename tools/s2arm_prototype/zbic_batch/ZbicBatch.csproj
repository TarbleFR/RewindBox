<!-- CI only: runs S2Arm's own pack/nx_unpack/ZbicDecoder.cs and NsoZbic.cs (compiled from the
     pinned checkout given as S2ArmRoot, nothing of them stored here) over a manifest of inputs,
     so that tools/s2arm_prototype/run_zbic_test.py can compare thousands of cases with the C port
     in one process. No package reference: restore needs no feed. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ZbicBatch</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(S2ArmRoot)/pack/nx_unpack/ZbicDecoder.cs" />
    <Compile Include="$(S2ArmRoot)/pack/nx_unpack/NsoZbic.cs" />
  </ItemGroup>
</Project>
