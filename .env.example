# NeoStation iOS build-time environment variables.
#
# Local macOS build:
#   cp .env.example .env
#   # Fill the two required ScreenScraper values below, then use:
#   flutter build ios --release --no-codesign --dart-define-from-file=.env
#
# The real .env file is intentionally ignored by Git and must never be
# committed. These values are compiled into the app through Dart defines; the
# installed application does not read a runtime .env file.
#
# RetroAchievements has no build-time key here. Each user signs in with their
# own RetroAchievements credentials at runtime inside NeoStation.

# ScreenScraper developer credentials (required for the iOS CI build)
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# Optional. The Library can query Google Books without a key at public quota,
# but a production key can be compiled in to provide the configured API quota.
GOOGLE_BOOKS_API_KEY=

# Optional. Nextendo Network (community online service for Switch games,
# https://nextendo.network). The client identifier (nxc_...) is issued to the
# maintainer by the Nextendo Developers portal for a public application (PKCE,
# no secret); empty means RewindBox's registered application (nxc_Qs2TRpZuxz1X),
# whose redirect is a loopback address (http://127.0.0.1/callback, any port).
# The two game-server addresses are not needed: the app looks up
# nex.nextendo.network (game server) and nat.nextendo.network (secondary NAT
# test) when it starts, keeps the answer about ten minutes and keeps the last
# good address when a lookup fails (Nextendo's developer, 17 November 2026).
# NEXTENDO_SERVER_IP and NEXTENDO_NAT_IP stay as a maintainer's test override
# only; leave them empty.
NEXTENDO_CLIENT_ID=
NEXTENDO_SERVER_IP=
NEXTENDO_NAT_IP=
