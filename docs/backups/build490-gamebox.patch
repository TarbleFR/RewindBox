+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Executable check of the box reader's recognition code (BoxTextRecognizer)
+// with Apple's real frameworks, built for macOS and for the iOS Simulator by
+// .github/workflows/game-box-checks.yml.
+//
+// For each of NeoStation's twelve languages it draws a back-cover-like text
+// with the system font for that language, recognises it with the plugin's
+// own code and the hints the app would give, and measures how close the
+// result is. It also checks the language detection, lists the recognition
+// languages of this OS and the Translation availability of the twelve targets.
+// The report is JSON on stdout; the exit status is 1 when a check fails.
+
+import CoreGraphics
+import CoreText
+import Foundation
+import ImageIO
+#if canImport(Translation)
+import Translation
+#endif
+
+struct Sample {
+    let code: String       // NeoStation code
+    let hints: [String]    // what the app passes for that edition's region
+    let detect: String     // NaturalLanguage identifier expected
+    let text: String
+}
+
+let samples: [Sample] = [
+    Sample(code: "en", hints: ["en-US"], detect: "en", text: "Explore forty dangerous caves and defeat the Shadow King."),
+    Sample(code: "fr", hints: ["fr-FR", "en-US"], detect: "fr", text: "Explorez quarante grottes dangereuses et battez le roi des ombres."),
+    Sample(code: "de", hints: ["de-DE", "en-US"], detect: "de", text: "Erkunde vierzig gefährliche Höhlen und besiege den Schattenkönig."),
+    Sample(code: "es", hints: ["es-ES", "en-US"], detect: "es", text: "Explora cuarenta cuevas peligrosas y derrota al rey de las sombras."),
+    Sample(code: "it", hints: ["it-IT", "en-US"], detect: "it", text: "Esplora quaranta grotte pericolose e sconfiggi il re delle ombre."),
+    Sample(code: "pt", hints: ["pt-BR", "en-US"], detect: "pt", text: "Explore quarenta cavernas perigosas e derrote o rei das sombras."),
+    Sample(code: "ru", hints: ["ru-RU", "en-US"], detect: "ru", text: "Исследуйте сорок опасных пещер и победите короля теней."),
+    Sample(code: "id", hints: ["en-US"], detect: "id", text: "Jelajahi empat puluh gua berbahaya dan kalahkan raja bayangan."),
+    Sample(code: "ja", hints: ["ja-JP", "en-US"], detect: "ja", text: "四十の危険な洞窟を探検して、影の王を倒そう。"),
+    Sample(code: "ko", hints: ["ko-KR", "en-US"], detect: "ko", text: "위험한 동굴 마흔 곳을 탐험하고 그림자 왕을 물리치세요."),
+    Sample(code: "zh", hints: ["zh-Hans", "en-US"], detect: "zh-Hans", text: "探索四十个危险的洞穴，打败影子之王。"),
+    Sample(code: "zh_Hant", hints: ["zh-Hant", "en-US"], detect: "zh-Hant", text: "探索四十個危險的洞穴，打敗影子之王。"),
+]
+
+func render(_ text: String, language: String, to path: String) -> Bool {
+    let width = 1400, height = 360
+    guard let space = CGColorSpace(name: CGColorSpace.sRGB),
+          let ctx = CGContext(data: nil, width: width, height: height, bitsPerComponent: 8, bytesPerRow: 0,
+                              space: space, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { return false }
+    ctx.setFillColor(CGColor(red: 0.08, green: 0.08, blue: 0.12, alpha: 1))
+    ctx.fill(CGRect(x: 0, y: 0, width: width, height: height))
+    let font = CTFontCreateUIFontForLanguage(.system, 44, language as CFString)
+        ?? CTFontCreateWithName("Helvetica" as CFString, 44, nil)
+    let attributes: [CFString: Any] = [
+        kCTFontAttributeName: font,
+        kCTForegroundColorAttributeName: CGColor(red: 1, green: 1, blue: 1, alpha: 1),
+    ]
+    let attributed = CFAttributedStringCreate(nil, text as CFString, attributes as CFDictionary)!
+    let framesetter = CTFramesetterCreateWithAttributedString(attributed)
+    let frame = CTFramesetterCreateFrame(framesetter, CFRange(location: 0, length: 0),
+                                         CGPath(rect: CGRect(x: 60, y: 40, width: width - 120, height: height - 80), transform: nil), nil)
+    CTFrameDraw(frame, ctx)
+    guard let image = ctx.makeImage(),
+          let dest = CGImageDestinationCreateWithURL(URL(fileURLWithPath: path) as CFURL, "public.png" as CFString, 1, nil) else { return false }
+    CGImageDestinationAddImage(dest, image, nil)
+    return CGImageDestinationFinalize(dest)
+}
+
+/// Similarity of two strings ignoring spaces and punctuation (1 = equal).
+func similarity(_ a: String, _ b: String) -> Double {
+    func norm(_ s: String) -> [Character] {
+        Array(s.lowercased().filter { $0.isLetter || $0.isNumber })
+    }
+    let x = norm(a), y = norm(b)
+    if x.isEmpty || y.isEmpty { return 0 }
+    var previous = Array(0...y.count)
+    for i in 1...x.count {
+        var current = [i] + Array(repeating: 0, count: y.count)
+        for j in 1...y.count {
+            current[j] = min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + (x[i - 1] == y[j - 1] ? 0 : 1))
+        }
+        previous = current
+    }
+    return 1 - Double(previous[y.count]) / Double(max(x.count, y.count))
+}
+
+var failures: [String] = []
+var results: [[String: Any]] = []
+let supported = BoxTextRecognizer.supportedLanguages()
+let temp = NSTemporaryDirectory()
+
+for sample in samples {
+    let path = (temp as NSString).appendingPathComponent("gamebox-\(sample.code).png")
+    guard render(sample.text, language: sample.hints.first ?? "en", to: path) else {
+        failures.append("\(sample.code): could not render")
+        continue
+    }
+    var entry: [String: Any] = ["code": sample.code, "hints": sample.hints]
+    do {
+        let r = try BoxTextRecognizer.recognize(path: path, languages: sample.hints)
+        let text = r.lines.map { $0.text }.joined(separator: " ")
+        let score = similarity(text, sample.text)
+        entry["recognized"] = text
+        entry["similarity"] = score
+        entry["languagesUsed"] = r.languages
+        entry["hintSupported"] = sample.hints.allSatisfy { supported.contains($0) }
+        // Latin scripts must read almost exactly; ideographic text a little
+        // less (punctuation and close glyphs).
+        let threshold = ["ja", "zh", "zh_Hant", "ko"].contains(sample.code) ? 0.75 : 0.85
+        if score < threshold { failures.append("\(sample.code): similarity \(score) < \(threshold) (\(text))") }
+    } catch {
+        failures.append("\(sample.code): recognition failed \(error)")
+    }
+    if case let (lang, p)? = BoxTextRecognizer.detectLanguage(sample.text) {
+        entry["detected"] = lang
+        entry["detectedConfidence"] = p
+        if lang != sample.detect { failures.append("\(sample.code): detected \(lang), expected \(sample.detect)") }
+    } else {
+        failures.append("\(sample.code): language not detected")
+    }
+    results.append(entry)
+}
+
+var translation: [String: String] = [:]
+var translationNote = "Translation framework not available on this OS"
+#if canImport(Translation)
+if #available(macOS 15.0, iOS 18.0, *) {
+    translationNote = "LanguageAvailability.status(from: en / ja, to: target)"
+    let targets = ["en", "es", "ru", "zh-Hans", "zh-Hant", "pt-BR", "fr", "de", "it", "id", "ja", "ko"]
+    let semaphore = DispatchSemaphore(value: 0)
+    Task {
+        let availability = LanguageAvailability()
+        for target in targets {
+            let source = target == "en" ? "ja" : "en"
+            let status = await availability.status(from: Locale.Language(identifier: source), to: Locale.Language(identifier: target))
+            switch status {
+            case .installed: translation["\(source)->\(target)"] = "installed"
+            case .supported: translation["\(source)->\(target)"] = "supported"
+            case .unsupported: translation["\(source)->\(target)"] = "unsupported"
+            @unknown default: translation["\(source)->\(target)"] = "unknown"
+            }
+        }
+        semaphore.signal()
+    }
+    semaphore.wait()
+    // The Simulator may not provide translation models: required on macOS only.
+    if ProcessInfo.processInfo.environment["GAMEBOX_REQUIRE_TRANSLATION"] == "1" {
+        for (pair, status) in translation where status == "unsupported" || status == "unknown" {
+            failures.append("translation \(pair): \(status)")
+        }
+    }
+}
+#endif
+
+let report: [String: Any] = [
+    "os": ProcessInfo.processInfo.operatingSystemVersionString,
+    "recognitionLanguages": supported,
+    "samples": results,
+    "translation": translation,
+    "translationNote": translationNote,
+    "failures": failures,
+    "passed": failures.isEmpty,
+]
+let data = try! JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
+print(String(data: data, encoding: .utf8)!)
+exit(failures.isEmpty ? 0 : 1)
diff --git a/packages/neo_box_reader/ios/Classes/BoxTextRecognizer.swift b/packages/neo_box_reader/ios/Classes/BoxTextRecognizer.swift
new file mode 100644
index 0000000..a42fca3
--- /dev/null
+++ b/packages/neo_box_reader/ios/Classes/BoxTextRecognizer.swift
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Text recognition of a box scan. Platform-neutral (iOS and macOS) so the
+// same code runs in the macOS CI test (packages/neo_box_reader/ci).
+
+import Foundation
+import ImageIO
+import NaturalLanguage
+import Vision
+
+/// One recognised line, in normalised coordinates with a top-left origin.
+public struct BoxTextLine {
+    public let text: String
+    public let confidence: Float
+    public let x: Double
+    public let y: Double
+    public let width: Double
+    public let height: Double
+
+    public var dictionary: [String: Any] {
+        ["text": text, "confidence": Double(confidence), "x": x, "y": y, "w": width, "h": height]
+    }
+}
+
+public struct BoxTextRecognition {
+    public let lines: [BoxTextLine]
+    public let pixelWidth: Int
+    public let pixelHeight: Int
+    /// Recognition languages Vision was given ("auto" when it detected them).
+    public let languages: [String]
+}
+
+public enum BoxTextRecognizerError: Error {
+    case unreadableImage
+}
+
+public enum BoxTextRecognizer {
+    /// Languages the accurate recogniser of this OS supports.
+    public static func supportedLanguages() -> [String] {
+        let request = VNRecognizeTextRequest()
+        request.recognitionLevel = .accurate
+        return (try? request.supportedRecognitionLanguages()) ?? []
+    }
+
+    /// Loads a scan, downscaled so that its longest side is at most
+    /// [maxDimension] pixels (Vision gains nothing beyond, memory does).
+    static func loadImage(path: String, maxDimension: Int) -> CGImage? {
+        let url = URL(fileURLWithPath: path) as CFURL
+        guard let source = CGImageSourceCreateWithURL(url, nil) else { return nil }
+        let options: [CFString: Any] = [
+            kCGImageSourceCreateThumbnailFromImageAlways: true,
+            kCGImageSourceCreateThumbnailWithTransform: true,
+            kCGImageSourceThumbnailMaxPixelSize: maxDimension,
+            kCGImageSourceShouldCacheImmediately: true,
+        ]
+        return CGImageSourceCreateThumbnailAtIndex(source, 0, options as CFDictionary)
+    }
+
+    /// Recognises the text of the scan at [path].
+    ///
+    /// [languages] are hints from the region of the scan (`ja-JP` first for
+    /// a Japanese edition). Without usable hints, or when the hinted pass
+    /// finds almost nothing, Vision's automatic language detection runs and
+    /// the richer result is kept. Nothing is ever invented: only what Vision
+    /// returns is passed on, with its confidence.
+    public static func recognize(path: String, languages: [String], maxDimension: Int = 4096) throws -> BoxTextRecognition {
+        guard let image = loadImage(path: path, maxDimension: maxDimension) else {
+            throw BoxTextRecognizerError.unreadableImage
+        }
+        let supported = Set(supportedLanguages())
+        let hints = languages.filter { supported.contains($0) }
+        var best = try run(image: image, languages: hints)
+        if !hints.isEmpty && best.lines.count < 3 {
+            let auto = try run(image: image, languages: [])
+            if score(auto) > score(best) { best = auto }
+        }
+        return best
+    }
+
+    static func score(_ r: BoxTextRecognition) -> Double {
+        r.lines.reduce(0) { $0 + Double($1.text.count) * Double($1.confidence) }
+    }
+
+    static func run(image: CGImage, languages: [String]) throws -> BoxTextRecognition {
+        let request = VNRecognizeTextRequest()
+        request.recognitionLevel = .accurate
+        request.usesLanguageCorrection = true
+        if languages.isEmpty {
+            request.automaticallyDetectsLanguage = true
+        } else {
+            request.recognitionLanguages = languages
+        }
+        let handler = VNImageRequestHandler(cgImage: image, options: [:])
+        try handler.perform([request])
+        var lines: [BoxTextLine] = []
+        for observation in request.results ?? [] {
+            guard let candidate = observation.topCandidates(1).first else { continue }
+            let text = candidate.string.trimmingCharacters(in: .whitespacesAndNewlines)
+            if text.isEmpty { continue }
+            let box = observation.boundingBox
+            lines.append(BoxTextLine(
+                text: text,
+                confidence: candidate.confidence,
+                x: Double(box.origin.x),
+                y: Double(1 - box.origin.y - box.height),
+                width: Double(box.width),
+                height: Double(box.height)
+            ))
+        }
+        return BoxTextRecognition(
+            lines: lines,
+            pixelWidth: image.width,
+            pixelHeight: image.height,
+            languages: languages.isEmpty ? ["auto"] : languages
+        )
+    }
+
+    /// Dominant language of [text] (BCP 47, e.g. "ja", "zh-Hans") with its
+    /// probability, or nil when undetermined.
+    public static func detectLanguage(_ text: String) -> (String, Double)? {
+        let recognizer = NLLanguageRecognizer()
+        recognizer.processString(text)
+        guard let language = recognizer.dominantLanguage, language != .undetermined else { return nil }
+        let p = recognizer.languageHypotheses(withMaximum: 1)[language] ?? 0
+        return (language.rawValue, p)
+    }
+}
diff --git a/packages/neo_box_reader/ios/Classes/BoxTranslator.swift b/packages/neo_box_reader/ios/Classes/BoxTranslator.swift
new file mode 100644
index 0000000..e854d38
--- /dev/null
+++ b/packages/neo_box_reader/ios/Classes/BoxTranslator.swift
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// On-device translation with Apple's Translation framework (iOS 18).
+//
+// iOS 18 hands out a TranslationSession only to a SwiftUI view through
+// `.translationTask`. A 1-point, invisible hosting controller is therefore
+// attached to the visible view controller for the time of one request; it is
+// also what lets iOS show its own prompt to download a missing language.
+// Nothing is translated by a server of NeoStation.
+
+import Foundation
+import SwiftUI
+import Translation
+import UIKit
+
+enum BoxTranslatorError: Error {
+    case noPresenter
+    case unsupported
+    case notInstalled(String)
+    case failed(String)
+}
+
+enum BoxTranslator {
+    static func language(_ identifier: String?) -> Locale.Language? {
+        guard let identifier, !identifier.isEmpty else { return nil }
+        return Locale.Language(identifier: identifier)
+    }
+
+    /// "installed", "supported" (can be downloaded) or "unsupported".
+    static func status(source: String?, target: String, sample: String?) async -> String {
+        let availability = LanguageAvailability()
+        let to = Locale.Language(identifier: target)
+        let status: LanguageAvailability.Status
+        if let from = language(source) {
+            status = await availability.status(from: from, to: to)
+        } else if let sample, !sample.isEmpty {
+            status = (try? await availability.status(for: sample, to: to)) ?? .unsupported
+        } else {
+            return "unsupported"
+        }
+        switch status {
+        case .installed: return "installed"
+        case .supported: return "supported"
+        case .unsupported: return "unsupported"
+        @unknown default: return "unsupported"
+        }
+    }
+
+    /// Identifiers of the languages Translation supports on this device.
+    static func supportedLanguages() async -> [String] {
+        let languages = await LanguageAvailability().supportedLanguages
+        return languages.map { $0.minimalIdentifier }
+    }
+
+    /// The hosting controller of one request and whether it has answered.
+    final class Request {
+        var host: UIViewController?
+        var finished = false
+    }
+
+    @MainActor
+    static func translate(
+        texts: [String],
+        source: String?,
+        target: String,
+        presenter: UIViewController,
+        completion: @escaping (Result<([String], String?), Error>) -> Void
+    ) {
+        let configuration = TranslationSession.Configuration(source: language(source), target: language(target))
+        let request = Request()
+        let finish: @MainActor (Result<([String], String?), Error>) -> Void = { result in
+            if request.finished { return }
+            request.finished = true
+            if let host = request.host {
+                host.willMove(toParent: nil)
+                host.view.removeFromSuperview()
+                host.removeFromParent()
+            }
+            request.host = nil
+            completion(result)
+        }
+        let view = BoxTranslationTaskView(configuration: configuration, texts: texts, finish: finish)
+        let controller = UIHostingController(rootView: view)
+        controller.view.frame = CGRect(x: 0, y: 0, width: 1, height: 1)
+        controller.view.backgroundColor = .clear
+        controller.view.isUserInteractionEnabled = false
+        controller.view.alpha = 0.011
+        presenter.addChild(controller)
+        presenter.view.addSubview(controller.view)
+        controller.didMove(toParent: presenter)
+        request.host = controller
+    }
+}
+
+struct BoxTranslationTaskView: View {
+    let configuration: TranslationSession.Configuration
+    let texts: [String]
+    let finish: @MainActor (Result<([String], String?), Error>) -> Void
+
+    var body: some View {
+        Color.clear
+            .frame(width: 1, height: 1)
+            .translationTask(configuration) { session in
+                do {
+                    try await session.prepareTranslation()
+                    let requests = texts.enumerated().map { index, text in
+                        TranslationSession.Request(sourceText: text, clientIdentifier: String(index))
+                    }
+                    let responses = try await session.translations(from: requests)
+                    var output = Array(repeating: "", count: texts.count)
+                    var detected: String?
+                    for response in responses {
+                        if detected == nil { detected = response.sourceLanguage.minimalIdentifier }
+                        if let id = response.clientIdentifier, let index = Int(id), index < output.count {
+                            output[index] = response.targetText
+                        }
+                    }
+                    let answer = (output, detected)
+                    await finish(.success(answer))
+                } catch {
+                    await finish(.failure(error))
+                }
+            }
+    }
+}
diff --git a/packages/neo_box_reader/ios/Classes/NeoBoxReaderPlugin.swift b/packages/neo_box_reader/ios/Classes/NeoBoxReaderPlugin.swift
new file mode 100644
index 0000000..73625b8
--- /dev/null
+++ b/packages/neo_box_reader/ios/Classes/NeoBoxReaderPlugin.swift
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+import Flutter
+import UIKit
+
+/// Channel `neostation/neo_box_reader` (docs/game-box-3d.md § 7).
+///
+/// Errors carry a stable code for the Flutter side, which shows its own
+/// translated explanation; the native message is only the technical detail.
+public final class NeoBoxReaderPlugin: NSObject, FlutterPlugin {
+    private let work = DispatchQueue(label: "neostation.box-reader", qos: .userInitiated)
+
+    public static func register(with registrar: FlutterPluginRegistrar) {
+        let channel = FlutterMethodChannel(name: "neostation/neo_box_reader", binaryMessenger: registrar.messenger())
+        registrar.addMethodCallDelegate(NeoBoxReaderPlugin(), channel: channel)
+    }
+
+    public func handle(_ call: FlutterMethodCall, result: @escaping FlutterResult) {
+        let args = call.arguments as? [String: Any] ?? [:]
+        switch call.method {
+        case "capabilities":
+            work.async {
+                let languages = BoxTextRecognizer.supportedLanguages()
+                DispatchQueue.main.async {
+                    // The pod requires iOS 18, where TranslationSession exists.
+                    result(["ocr": true, "translation": true, "ocrLanguages": languages])
+                }
+            }
+        case "recognize":
+            guard let path = args["path"] as? String, FileManager.default.fileExists(atPath: path) else {
+                result(FlutterError(code: "missing-image", message: "No scan at the given path", details: nil))
+                return
+            }
+            let languages = args["languages"] as? [String] ?? []
+            work.async {
+                do {
+                    let recognition = try BoxTextRecognizer.recognize(path: path, languages: languages)
+                    let payload: [String: Any] = [
+                        "lines": recognition.lines.map { $0.dictionary },
+                        "width": recognition.pixelWidth,
+                        "height": recognition.pixelHeight,
+                        "languages": recognition.languages,
+                    ]
+                    DispatchQueue.main.async { result(payload) }
+                } catch {
+                    DispatchQueue.main.async {
+                        result(FlutterError(code: "ocr-failed", message: String(describing: error), details: nil))
+                    }
+                }
+            }
+        case "detectLanguage":
+            let text = args["text"] as? String ?? ""
+            work.async {
+                let guess = BoxTextRecognizer.detectLanguage(text)
+                DispatchQueue.main.async {
+                    if case let (language, p)? = guess {
+                        result(["language": language, "confidence": p])
+                    } else {
+                        result(["language": NSNull(), "confidence": 0.0])
+                    }
+                }
+            }
+        case "translationStatus":
+            let target = args["target"] as? String ?? "en"
+            let source = args["source"] as? String
+            let sample = args["sample"] as? String
+            Task {
+                let status = await BoxTranslator.status(source: source, target: target, sample: sample)
+                await MainActor.run { result(status) }
+            }
+        case "supportedTranslationLanguages":
+            Task {
+                let languages = await BoxTranslator.supportedLanguages()
+                await MainActor.run { result(languages) }
+            }
+        case "translate":
+            let texts = args["texts"] as? [String] ?? []
+            let target = args["target"] as? String ?? "en"
+            let source = args["source"] as? String
+            guard !texts.isEmpty else {
+                result(["texts": [String](), "source": Self.nullable(source)])
+                return
+            }
+            guard let presenter = Self.visibleController() else {
+                result(FlutterError(code: "no-presenter", message: "No visible view controller", details: nil))
+                return
+            }
+            Task { @MainActor in
+                let sample = texts.joined(separator: "\n")
+                let before = await BoxTranslator.status(source: source, target: target, sample: sample)
+                if before == "unsupported" {
+                    result(FlutterError(code: "unsupported", message: "Language pair not supported", details: nil))
+                    return
+                }
+                BoxTranslator.translate(texts: texts, source: source, target: target, presenter: presenter) { outcome in
+                    switch outcome {
+                    case .success(let (translated, detected)):
+                        result(["texts": translated, "source": Self.nullable(detected ?? source)])
+                    case .failure(let error):
+                        Task { @MainActor in
+                            // A language still not installed after the request means
+                            // the download was declined or could not run.
+                            let after = await BoxTranslator.status(source: source, target: target, sample: sample)
+                            let code = after == "supported" ? "not-installed" : (error is CancellationError ? "cancelled" : "failed")
+                            result(FlutterError(code: code, message: String(describing: error), details: nil))
+                        }
+                    }
+                }
+            }
+        default:
+            result(FlutterMethodNotImplemented)
+        }
+    }
+
+    static func nullable(_ value: String?) -> Any {
+        if let value { return value }
+        return NSNull()
+    }
+
+    /// Topmost presented view controller of the key window.
+    static func visibleController() -> UIViewController? {
+        let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+        let window = scenes.flatMap { $0.windows }.first { $0.isKeyWindow } ?? scenes.first?.windows.first
+        var controller = window?.rootViewController
+        while let presented = controller?.presentedViewController, !presented.isBeingDismissed {
+            controller = presented
+        }
+        return controller
+    }
+}
diff --git a/packages/neo_box_reader/ios/neo_box_reader.podspec b/packages/neo_box_reader/ios/neo_box_reader.podspec
new file mode 100644
index 0000000..469651f
--- /dev/null
+++ b/packages/neo_box_reader/ios/neo_box_reader.podspec
@@ -0,0 +1,16 @@
+Pod::Spec.new do |s|
+  s.name = 'neo_box_reader'
+  s.version = '0.1.0'
+  s.summary = 'On-device reading of game box backs'
+  s.description = 'Vision text recognition, NaturalLanguage detection and Apple Translation for the 3D game box reader.'
+  s.homepage = 'https://github.com/TarbleFR/neostation-ios'
