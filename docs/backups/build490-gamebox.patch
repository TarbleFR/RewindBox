+++ b/test/game_box_inspector_test.dart
@@ -0,0 +1,252 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:neostation/models/game_model.dart';
+import 'package:neostation/providers/file_provider.dart';
+import 'package:neostation/screens/game_box/game_box_inspector.dart';
+import 'package:neostation/services/game_box/game_box_media.dart';
+import 'package:neostation/services/game_box/game_box_preferences.dart';
+import 'package:neostation/services/game_launch_manager.dart';
+import 'package:neostation/widgets/game_box/game_box_geometry.dart';
+import 'package:path/path.dart' as p;
+import 'package:shared_preferences/shared_preferences.dart';
+
+class _TestFileProvider extends FileProvider {
+  _TestFileProvider(this.root);
+  final String root;
+
+  @override
+  bool get isInitialized => true;
+
+  @override
+  String getMediaPath(String systemFolderName, String imageType, String romName, String extension) =>
+      p.join(root, 'media', systemFolderName, imageType, '${FileProvider.stripRomExtension(romName)}.$extension');
+
+  @override
+  String getMediaDirectoryPath() => p.join(root, 'media');
+
+  @override
+  List<String> getEsdeMediaCandidates(String systemFolderName, String imageType, String romName) => const [];
+}
+
+final _png = base64Decode(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==',
+);
+
+GameModel _game() => const GameModel(
+      romname: 'Box Test (USA).iso',
+      realname: 'Box Test',
+      name: 'Box Test',
+      year: '',
+      developer: '',
+      publisher: '',
+      genre: '',
+      players: '',
+      rating: 0,
+      systemId: 'ps2',
+      systemFolderName: 'ps2',
+    );
+
+/// Advances time frame by frame, as the device would.
+Future<void> _frames(WidgetTester tester, Duration total) async {
+  const step = Duration(milliseconds: 32);
+  var elapsed = Duration.zero;
+  while (elapsed < total) {
+    await tester.pump(step);
+    elapsed += step;
+  }
+}
+
+double _wrap(double a) {
+  final t = a % (2 * math.pi);
+  return t < 0 ? t + 2 * math.pi : t;
+}
+
+void main() {
+  late Directory dir;
+  late _TestFileProvider fp;
+
+  setUp(() {
+    dir = Directory.systemTemp.createTempSync('game_box_inspector');
+    fp = _TestFileProvider(dir.path);
+    final store = GameBoxMediaStore(fp);
+    for (final folder in ['box2d', GameBoxMediaFolders.back]) {
+      File(store.canonicalPath(_game(), 'ps2', folder, 'png'))
+        ..createSync(recursive: true)
+        ..writeAsBytesSync(_png);
+    }
+    SharedPreferences.setMockInitialValues({});
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(const MethodChannel('xyz.luan/gamepads'), (call) async => <Object>[]);
+  });
+
+  tearDown(() {
+    GameBoxLaunchGate.leave();
+    dir.deleteSync(recursive: true);
+  });
+
+  Future<GameBoxInspectorState> open(
+    WidgetTester tester, {
+    required VoidCallback onPlay,
+    bool reduceMotion = false,
+  }) async {
+    await tester.pumpWidget(MaterialApp(
+      // Applies to every route, the viewer's included.
+      builder: (context, child) => MediaQuery(
+        data: MediaQuery.of(context).copyWith(disableAnimations: reduceMotion),
+        child: child!,
+      ),
+      home: Builder(
+        builder: (context) => Scaffold(
+          body: Center(
+            child: ElevatedButton(
+              onPressed: () => GameBoxInspector.open(
+                context,
+                onPlay: onPlay,
+                subject: GameBoxSubject(game: _game(), systemFolder: 'ps2', fileProvider: fp, systemId: 'ps2'),
+              ),
+              child: const Text('open'),
+            ),
+          ),
+        ),
+      ),
+    ));
+    await tester.tap(find.text('open'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400));
+    await tester.pump(const Duration(milliseconds: 50));
+    return tester.state<GameBoxInspectorState>(find.byType(GameBoxInspector));
+  }
+
+  testWidgets('Front, Back and Reset turn the box to a stable pose', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    final state = await open(tester, onPlay: () {});
+    expect(state.pose.yaw, closeTo(BoxPose.rest.yaw, 1e-9));
+    await tester.tap(find.text('Back'));
+    await tester.pumpAndSettle();
+    expect(_wrap(state.pose.yaw), closeTo(math.pi, 1e-6));
+    expect(state.pose.perspective, lessThan(0.5), reason: 'the reading pose reduces the perspective');
+    expect(find.bySemanticsLabel(RegExp('showing the back')), findsOneWidget);
+    await tester.tap(find.text('Front'));
+    await tester.pumpAndSettle();
+    expect(_wrap(state.pose.yaw), anyOf(closeTo(0, 1e-6), closeTo(2 * math.pi, 1e-6)));
+    await tester.tap(find.text('Reset view'));
+    await tester.pumpAndSettle();
+    expect(state.pose.yaw, closeTo(BoxPose.rest.yaw, 1e-6));
+    expect(state.pose.pitch, closeTo(BoxPose.rest.pitch, 1e-6));
+  });
+
+  testWidgets('dragging turns the box freely; it comes to rest by itself', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    final state = await open(tester, onPlay: () {});
+    final start = state.pose.yaw;
+    final box = find.bySemanticsLabel(RegExp('Box of Box Test'));
+    await tester.fling(box, const Offset(-500, 0), 2000);
+    await tester.pumpAndSettle();
+    expect(state.pose.yaw - start, greaterThan(math.pi / 2), reason: 'a drag to the left turns past a quarter');
+    final settled = state.pose.yaw;
+    await tester.pump(const Duration(seconds: 2));
+    expect(state.pose.yaw, settled, reason: 'no idle spin');
+    await tester.drag(box, const Offset(0, 200));
+    await tester.pumpAndSettle();
+    expect(state.pose.pitch, lessThanOrEqualTo(BoxPose.maxPitch));
+    expect(state.pose.pitch, greaterThan(BoxPose.rest.pitch));
+  });
+
+  testWidgets('Play opens the box and launches once, then leaves for the launch', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    var plays = 0;
+    final state = await open(tester, onPlay: () {
+      plays++;
+      GameLaunchManager().beginSession();
+    });
+    await tester.tap(find.text('Play'));
+    await tester.pump();
+    await tester.tap(find.text('Play'), warnIfMissed: false);
+    await tester.pump(const Duration(milliseconds: 900));
+    expect(state.phase, GameBoxInspectorPhase.opening);
+    expect(GameBoxLaunchGate.busy, isTrue);
+    await tester.pump(const Duration(milliseconds: 1000));
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(plays, 1);
+    for (var i = 0; i < 6; i++) {
+      await tester.pump(const Duration(milliseconds: 20));
+    }
+    expect(find.byType(GameBoxInspector), findsNothing, reason: 'the viewer leaves once the session began');
+    expect(GameBoxLaunchGate.busy, isFalse);
+    GameLaunchManager().onDialogDisposed();
+    await tester.pump(const Duration(seconds: 1));
+  });
+
+  testWidgets('a launch that does not start brings the closed box back', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    var plays = 0;
+    final state = await open(tester, onPlay: () => plays++);
+    await tester.tap(find.text('Play'));
+    await _frames(tester, const Duration(milliseconds: 2100));
+    expect(plays, 1);
+    expect(state.phase, GameBoxInspectorPhase.launching);
+    await _frames(tester, const Duration(seconds: 7));
+    expect(state.phase, GameBoxInspectorPhase.inspecting);
+    expect(GameBoxLaunchGate.busy, isFalse);
+    expect(find.text('Play'), findsOneWidget);
+  });
+
+  testWidgets('Reduce Motion: no turning, a single launch', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    var plays = 0;
+    final state = await open(tester, onPlay: () => plays++, reduceMotion: true);
+    await tester.tap(find.text('Back'));
+    await tester.pump();
+    expect(_wrap(state.pose.yaw), closeTo(math.pi, 1e-6), reason: 'poses change without animation');
+    await tester.tap(find.text('Play'));
+    await tester.pump();
+    await tester.pump();
+    expect(state.pose.yaw, closeTo(-0.22, 1e-9), reason: 'the opened box appears without movement');
+    await _frames(tester, const Duration(milliseconds: 700));
+    expect(plays, 1);
+    await _frames(tester, const Duration(seconds: 7));
+  });
+
+  testWidgets('with the opening turned off, the game starts right away', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    await GameBoxPreferences.setOpeningAnimation(false);
+    var plays = 0;
+    final state = await open(tester, onPlay: () => plays++);
+    await tester.tap(find.text('Play'));
+    await _frames(tester, const Duration(milliseconds: 300));
+    expect(plays, 1);
+    expect(state.pose.yaw, closeTo(BoxPose.rest.yaw, 1e-9), reason: 'the box did not move');
+    await _frames(tester, const Duration(seconds: 7));
+  });
+
+  testWidgets('a damaged scan never prevents the launch', (tester) async {
+    tester.view.physicalSize = const Size(800, 1200);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    final store = GameBoxMediaStore(fp);
+    File(store.canonicalPath(_game(), 'ps2', 'box2d', 'png')).writeAsBytesSync([1, 2, 3, 4, 5]);
+    var plays = 0;
+    await open(tester, onPlay: () => plays++);
+    await tester.tap(find.text('Play'));
+    await _frames(tester, const Duration(milliseconds: 2100));
+    expect(plays, 1);
+    await _frames(tester, const Duration(seconds: 7));
+  });
+}
diff --git a/test/game_box_locale_test.dart b/test/game_box_locale_test.dart
new file mode 100644
index 0000000..da6acce
--- /dev/null
+++ b/test/game_box_locale_test.dart
@@ -0,0 +1,77 @@
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:neostation/l10n/app_locale.dart';
+import 'package:neostation/l10n/game_box_locale.dart';
+
+void main() {
+  final placeholders = RegExp(r'\{\w+\}');
+  final english = GameBoxLocale.values['en']!;
+
+  // Shared words that are legitimately written the same as in English.
+  const sameAsEnglish = {
+    'source', 'play', 'region.us', 'region.eu', 'region.it', 'region.fr', 'region.pt', 'region.au',
+    'region.asi', 'region.ca', 'region.kr', 'region.cn', 'region.br', 'region.tw', 'region.jp',
+    'region.uk', 'region.ru', 'region.se', 'region.nl', 'region.de', 'region.sp', 'region.wor',
+    'supportDisc', 'supportCartridge', 'lang.it', 'lang.id', 'lang.ko', 'lang.pt', 'lang.fr', 'lang.de',
+    'lang.ru', 'lang.ja', 'lang.es', 'lang.en', 'retry', 'original', 'front', 'back', 'edition', 'close',
+  };
+
+  test('the box catalogue covers exactly the twelve NeoStation languages', () {
+    expect(GameBoxLocale.values.keys.toSet(), AppLocale.supportedLanguages.keys.toSet());
+    expect(GameBoxLocale.values.length, 12);
+  });
+
+  for (final entry in GameBoxLocale.values.entries) {
+    test('${entry.key}: same keys, same placeholders, translated text', () {
+      expect(entry.value.keys.toSet(), english.keys.toSet());
+      var translatedCount = 0;
+      for (final message in english.entries) {
+        final translated = entry.value[message.key]!;
+        final reason = '${entry.key}:${message.key}';
+        expect(translated.trim(), isNotEmpty, reason: reason);
+        expect(
+          placeholders.allMatches(translated).map((m) => m[0]).toSet(),
+          placeholders.allMatches(message.value).map((m) => m[0]).toSet(),
+          reason: reason,
+        );
+        if (translated != message.value) translatedCount++;
+        if (entry.key != 'en' && !sameAsEnglish.contains(message.key)) {
+          expect(translated, isNot(message.value), reason: '$reason is English');
+        }
+      }
+      if (entry.key != 'en') expect(translatedCount, greaterThan(english.length * 0.7));
+    });
+  }
+
+  test('script and regional Chinese settings select Traditional Chinese', () {
+    const key = GameBoxLocale.readingLanguage;
+    final traditional = GameBoxLocale.values['zh_Hant']![key];
+    expect(traditional, isNot(GameBoxLocale.values['zh']![key]));
+    for (final locale in <Locale>[
+      const Locale.fromSubtags(languageCode: 'zh', scriptCode: 'Hant'),
+      const Locale('zh', 'TW'),
+      const Locale('zh', 'HK'),
+      const Locale('zh', 'MO'),
+      const Locale('zh_Hant'),
+    ]) {
+      expect(GameBoxLocale.forLocale(locale, key), traditional, reason: locale.toString());
+    }
+    expect(GameBoxLocale.forLocale(const Locale('zh', 'CN'), key), GameBoxLocale.values['zh']![key]);
+    expect(GameBoxLocale.forLocale(const Locale('xx'), key), english[key]);
+  });
+
+  test('every reading language has a translated name in every language', () {
+    for (final code in AppLocale.supportedLanguages.keys) {
+      for (final locale in GameBoxLocale.locales) {
+        expect(GameBoxLocale.forCode(locale, 'lang.$code').trim(), isNotEmpty);
+      }
+    }
+  });
+
+  test('placeholders are filled', () {
+    expect(
+      GameBoxLocale.fill(GameBoxLocale.forCode('fr', GameBoxLocale.otherEdition), {'region': 'Japon', 'game': 'Europe'}),
+      "Édition Japon : ce n'est pas l'édition de votre jeu (Europe).",
+    );
+  });
+}
diff --git a/test/game_box_media_test.dart b/test/game_box_media_test.dart
new file mode 100644
index 0000000..0d8e5f8
--- /dev/null
+++ b/test/game_box_media_test.dart
@@ -0,0 +1,218 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:neostation/models/game_model.dart';
+import 'package:neostation/providers/file_provider.dart';
+import 'package:neostation/services/game_box/game_box_media.dart';
+import 'package:neostation/services/game_box/game_box_regions.dart';
+import 'package:path/path.dart' as p;
+
+class _TestFileProvider extends FileProvider {
+  _TestFileProvider(this.root);
+  final String root;
+
+  @override
+  bool get isInitialized => true;
+
+  @override
+  String getMediaPath(String systemFolderName, String imageType, String romName, String extension) =>
+      p.join(root, 'media', systemFolderName, imageType, '${FileProvider.stripRomExtension(romName)}.$extension');
+
+  @override
+  String getMediaDirectoryPath() => p.join(root, 'media');
+
+  @override
+  List<String> getEsdeMediaCandidates(String systemFolderName, String imageType, String romName) => const [];
+}
+
+GameModel _game(String romname) => GameModel(
+      romname: romname,
+      realname: 'Test',
+      name: 'Test Game',
+      year: '',
+      developer: '',
+      publisher: '',
+      genre: '',
+      players: '',
+      rating: 0,
+    );
+
+Map<String, dynamic> _ss(String type, String region, {String? md5, String format = 'png'}) => {
+      'type': type,
+      'parent': 'jeu',
+      'url': 'https://neoclone.screenscraper.fr/api2/mediaJeu.php?devid=DEV&devpassword=SECRET'
+          '&softname=neostation&ssid=user&sspassword=PASS&systemeid=57&jeuid=1234&media=$type($region)',
+      'region': region,
+      'crc': 'CRC$region',
+      'md5': md5 ?? 'md5-$type-$region',
+      'sha1': 'sha-$type-$region',
+      'size': '12345',
+      'format': format,
+    };
+
+void main() {
+  group('regions', () {
+    test('No-Intro and Redump tags give the regions of the copy', () {
+      expect(GameBoxRegions.fromFileName('Final Fantasy VII (USA) (Disc 1).cue'), ['us']);
+      expect(GameBoxRegions.fromFileName('Tetris (World) (Rev 1).gb'), ['wor']);
+      expect(GameBoxRegions.fromFileName('Mario Kart 64 (Europe) (En,Fr,De).z64'), ['eu']);
+      expect(GameBoxRegions.fromFileName('Zelda (USA, Europe).sfc'), ['us', 'eu']);
+      expect(GameBoxRegions.fromFileName('Game (Beta) (Proto).bin'), isEmpty);
+      expect(GameBoxRegions.fromFileName('My Game.iso'), isEmpty);
+      expect(GameBoxRegions.languagesFromFileName('Mario Kart 64 (Europe) (En,Fr,De).z64'), ['en', 'fr', 'de']);
+    });
+
+    test('the print language is a presumption from the region', () {
+      expect(GameBoxRegions.languageOfRegion('jp'), 'ja');
+      expect(GameBoxRegions.languageOfRegion('fr'), 'fr');
+      expect(GameBoxRegions.languageOfRegion('tw'), 'zh_Hant');
+      expect(GameBoxRegions.languageOfRegion('cn'), 'zh');
+      expect(GameBoxRegions.languageOfRegion('br'), 'pt');
+      expect(GameBoxRegions.languageOfRegion('cus'), isNull);
+      expect(GameBoxRegions.isMultilingualRegion('eu'), isTrue);
+      expect(GameBoxRegions.recognitionHints('jp').first, 'ja-JP');
+    });
+  });
+
+  group('manifest', () {
+    test('ScreenScraper entries keep the media token, never the credentials', () {
+      final entry = GameBoxMediaEntry.fromScreenScraper(_ss('box-2D-back', 'fr'))!;
+      expect(entry.kind, GameBoxMediaKind.back);
+      expect(entry.token, 'box-2D-back(fr)');
+      expect(entry.region, 'fr');
+      final manifest = GameBoxManifest(
+        screenScraperSystemId: '57',
+        screenScraperGameId: '1234',
+        matchedBy: GameBoxMatch.md5,
+        entries: [entry],
+      );
+      final json = jsonEncode(manifest.toJson());
+      for (final secret in ['SECRET', 'PASS', 'devpassword', 'sspassword', 'DEV&', 'http']) {
+        expect(json, isNot(contains(secret)));
+      }
+      final back = GameBoxManifest.fromJson(jsonDecode(json) as Map<String, dynamic>)!;
+      expect(back.entries.single.token, 'box-2D-back(fr)');
+      expect(back.matchedBy, GameBoxMatch.md5);
+    });
+
+    test('unknown media types are ignored, unsafe edition file names rejected', () {
+      expect(GameBoxMediaEntry.fromScreenScraper(_ss('wheel', 'us')), isNull);
+      final m = GameBoxManifest.fromJson({
+        'version': 1,
+        'screenscraper': {'systemId': '1', 'gameId': '2'},
+        'matchedBy': 'fileName',
+        'media': [],
+        'backEditionFiles': {'a': '../escape.png', 'b': 'ok.png', 'c': '.hidden'},
+      })!;
+      expect(m.backEditionFiles, {'b': 'ok.png'});
+    });
+
+    test('one picture listed under several regions is one edition', () {
+      final entries = [
+        GameBoxMediaEntry.fromScreenScraper(_ss('box-2D-back', 'wor', md5: 'same'))!,
+        GameBoxMediaEntry.fromScreenScraper(_ss('box-2D-back', 'us', md5: 'same'))!,
+        GameBoxMediaEntry.fromScreenScraper(_ss('box-2D-back', 'fr'))!,
+      ];
+      final m = GameBoxManifest(
+        screenScraperSystemId: '57', screenScraperGameId: '1', matchedBy: GameBoxMatch.fileName, entries: entries,
+      );
+      final editions = m.backEditions();
+      expect(editions, hasLength(2));
+      expect(editions.first.regions, ['wor', 'us']);
+    });
+  });
+
+  group('selection', () {
+    final entries = [
+      for (final r in ['wor', 'us', 'eu', 'jp', 'fr']) GameBoxMediaEntry.fromScreenScraper(_ss('box-2D-back', r))!,
+      GameBoxMediaEntry.fromScreenScraper(_ss('box-2D', 'jp', md5: 'front-jp'))!,
+    ];
+
+    test('the edition of the copy wins over the front region and the priority', () {
+      final pick = GameBoxMediaSelection.choose(entries, GameBoxMediaKind.back,
+          gameRegions: ['eu'], frontRegion: 'jp', regionPriority: {'wor': 100, 'us': 90});
+      expect(pick!.region, 'eu');
+    });
+
+    test('without a known copy, the edition of the front shown wins', () {
+      final pick = GameBoxMediaSelection.choose(entries, GameBoxMediaKind.back,
+          frontRegion: 'jp', regionPriority: {'wor': 100, 'us': 90});
+      expect(pick!.region, 'jp');
+    });
+
+    test('otherwise the user region priority decides', () {
+      final pick = GameBoxMediaSelection.choose(entries, GameBoxMediaKind.back,
+          regionPriority: {'wor': 100, 'us': 90});
+      expect(pick!.region, 'wor');
+    });
+
+    test('a reading language finds a scan published for it, or none', () {
+      final m = GameBoxManifest(
+        screenScraperSystemId: '57', screenScraperGameId: '1', matchedBy: GameBoxMatch.fileName, entries: entries,
+      );
+      expect(GameBoxMediaSelection.backForLanguage(m, 'fr')!.entry.region, 'fr');
+      expect(GameBoxMediaSelection.backForLanguage(m, 'ja')!.entry.region, 'jp');
+      expect(GameBoxMediaSelection.backForLanguage(m, 'id'), isNull, reason: 'no Indonesian edition: translated reading');
+      expect(GameBoxMediaSelection.backForLanguage(m, 'de'), isNull);
+    });
+  });
+
+  group('store', () {
+    late Directory dir;
+    setUp(() => dir = Directory.systemTemp.createTempSync('game_box_media'));
+    tearDown(() => dir.deleteSync(recursive: true));
+
+    test('reads the faces at the reader lookup paths and writes the manifest atomically', () async {
+      final fp = _TestFileProvider(dir.path);
+      final game = _game('Game (USA).cue');
+      final store = GameBoxMediaStore(fp);
+      final backPath = store.canonicalPath(game, 'ps1', GameBoxMediaFolders.back, 'jpg');
+      File(backPath)
+        ..createSync(recursive: true)
+        ..writeAsBytesSync([0xFF, 0xD8, 0xFF, 0xE0]);
+      var local = store.read(game, 'ps1');
+      expect(local.back, backPath);
+      expect(local.front, isNull);
+      expect(local.spine, isNull);
+      expect(local.manifest, isNull);
+
+      await store.writeManifest(game, 'ps1', GameBoxManifest(
+        screenScraperSystemId: '57', screenScraperGameId: '1', matchedBy: GameBoxMatch.fileName,
+        entries: [GameBoxMediaEntry.fromScreenScraper(_ss('box-2D-back', 'us'))!],
+        backEditionFiles: {'md5:x': 'us-x.png'},
+      ));
+      expect(File('${store.manifestPath(game, 'ps1')}.part').existsSync(), isFalse);
+      local = store.read(game, 'ps1');
+      expect(local.manifest!.entries, hasLength(1));
+      expect(local.backEditionsDir, p.join(dir.path, 'media', 'ps1', GameBoxMediaFolders.backEditions, 'Game (USA)'));
+    });
+
+    test('a damaged manifest never hides the faces', () {
+      final fp = _TestFileProvider(dir.path);
+      final game = _game('Game.cue');
+      final store = GameBoxMediaStore(fp);
+      File(store.manifestPath(game, 'ps1'))
+        ..createSync(recursive: true)
+        ..writeAsStringSync('{not json');
+      final back = store.canonicalPath(game, 'ps1', GameBoxMediaFolders.back, 'png');
+      File(back)
+        ..createSync(recursive: true)
+        ..writeAsBytesSync([0x89, 0x50, 0x4E, 0x47]);
+      final local = store.read(game, 'ps1');
+      expect(local.manifest, isNull);
+      expect(local.back, back);
+    });
+
+    test('image sizes come from PNG and JPEG headers', () {
+      final png = File(p.join(dir.path, 'a.png'))
+        ..writeAsBytesSync([
+          0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 13, 0x49, 0x48, 0x44, 0x52,
+          0, 0, 2, 0x58, 0, 0, 2, 0x52, 8, 6, 0, 0, 0,
+        ]);
+      final size = GameBoxImageSize.of(png.path)!;
+      expect(size.width, 600);
+      expect(size.height, 594);
+    });
+  });
+}
diff --git a/test/game_box_render_inspector_preview_test.dart b/test/game_box_render_inspector_preview_test.dart
