+import 'dart:math' as math;
+
+import 'package:neo_box_reader/neo_box_reader.dart';
+
+enum BoxTextBlockKind { heading, paragraph, list, legal }
+
+/// A section of the back as printed: a heading, a paragraph, a bullet list
+/// or the small legal print.
+class BoxTextBlock {
+  BoxTextBlock({
+    required this.kind,
+    required this.units,
+    required this.lowConfidence,
+    required this.left,
+    required this.top,
+    required this.right,
+    required this.bottom,
+  });
+
+  final BoxTextBlockKind kind;
+
+  /// Texts translated one by one: the paragraph, or each list item.
+  final List<String> units;
+  final bool lowConfidence;
+  final double left, top, right, bottom;
+
+  Map<String, dynamic> toJson() => {
+        'kind': kind.name,
+        'units': units,
+        'lowConfidence': lowConfidence,
+        'box': [left, top, right, bottom],
+      };
+
+  static BoxTextBlock? fromJson(Object? raw) {
+    if (raw is! Map) return null;
+    final kind = BoxTextBlockKind.values.where((k) => k.name == raw['kind']).firstOrNull;
+    final units = raw['units'];
+    final box = raw['box'];
+    if (kind == null || units is! List || box is! List || box.length != 4) return null;
+    double d(Object? v) => v is num ? v.toDouble() : 0;
+    return BoxTextBlock(
+      kind: kind,
+      units: [for (final u in units) u.toString()],
+      lowConfidence: raw['lowConfidence'] == true,
+      left: d(box[0]),
+      top: d(box[1]),
+      right: d(box[2]),
+      bottom: d(box[3]),
+    );
+  }
+}
+
+/// Result of [BoxTextLayout.group].
+class BoxTextDocument {
+  BoxTextDocument({required this.blocks, required this.illegibleLines});
+  final List<BoxTextBlock> blocks;
+
+  /// Lines Vision saw but could not read with any confidence; they are
+  /// reported, never reconstructed.
+  final int illegibleLines;
+
+  bool get isEmpty => blocks.isEmpty;
+  bool get hasLowConfidence => blocks.any((b) => b.lowConfidence);
+
+  /// Every unit, in reading order (the translation request).
+  List<String> get units => [for (final b in blocks) ...b.units];
+
+  String get plainText => blocks.map((b) => b.units.join('\n')).join('\n\n');
+}
+
+/// Turns recognised lines into the sections of the back, in reading order.
+///
+/// Only the recognised text is used; columns are separated by their
+/// horizontal extent, sections by line gaps and size changes. Lines with too
+/// little confidence are counted as illegible and left out.
+class BoxTextLayout {
+  BoxTextLayout._();
+
+  static const double minConfidence = 0.15;
+  static const double weakConfidence = 0.5;
+
+  static final RegExp _letterOrDigit = RegExp(r'[\p{L}\p{N}]', unicode: true);
+  static final RegExp _cjk = RegExp(r'[぀-ヿ㐀-鿿가-힯豈-﫿]');
+  static final RegExp _bullet = RegExp(r'^\s*([•・●■□◆◇▶►▸‣∙·○\-–—*]|\d{1,2}[.)])\s*');
+  static final RegExp _legal = RegExp(
+    r'(©|®|™|\(c\)|all rights reserved|tous droits réservés|licensed|alle rechte|todos los derechos|'
+    r'tutti i diritti|무단|禁止|版权|版權|著作権|права защищены)',
+    caseSensitive: false,
+  );
+
+  static BoxTextDocument group(List<BoxReaderLine> raw) {
+    var illegible = 0;
+    final lines = <BoxReaderLine>[];
+    for (final l in raw) {
+      if (!_letterOrDigit.hasMatch(l.text)) continue;
+      if (l.confidence < minConfidence) {
+        illegible++;
+        continue;
+      }
+      lines.add(l);
+    }
+    if (lines.isEmpty) return BoxTextDocument(blocks: const [], illegibleLines: illegible);
+
+    final heights = lines.map((l) => l.height).toList()..sort();
+    final median = heights[heights.length ~/ 2];
+    lines.sort((a, b) => a.y.compareTo(b.y));
+
+    final groups = <List<BoxReaderLine>>[];
+    for (final line in lines) {
+      List<BoxReaderLine>? target;
+      var bestGap = double.infinity;
+      for (final g in groups) {
+        final last = g.last;
+        final gap = line.y - last.bottom;
+        final h = math.max(line.height, last.height);
+        if (gap < -h * 0.5 || gap > h * 0.95) continue;
+        final ratio = line.height / last.height;
+        if (ratio < 0.65 || ratio > 1.55) continue;
+        if (!_sameColumn(line, last, median)) continue;
+        if (gap < bestGap) {
+          bestGap = gap;
+          target = g;
+        }
+      }
+      if (target == null) {
+        groups.add([line]);
+      } else {
+        target.add(line);
+      }
+    }
+
+    final blocks = groups.map((g) => _block(g, median)).toList();
+    return BoxTextDocument(blocks: _readingOrder(blocks), illegibleLines: illegible);
+  }
+
+  static bool _sameColumn(BoxReaderLine a, BoxReaderLine b, double median) {
+    final overlap = math.min(a.right, b.right) - math.max(a.x, b.x);
+    final narrow = math.min(a.width, b.width);
+    if (narrow > 0 && overlap >= narrow * 0.3) return true;
+    // Left-aligned short lines (last line of a paragraph, list items).
+    return (a.x - b.x).abs() <= median * 1.5;
+  }
+
+  static BoxTextBlock _block(List<BoxReaderLine> g, double median) {
+    final left = g.map((l) => l.x).reduce(math.min);
+    final top = g.map((l) => l.y).reduce(math.min);
+    final right = g.map((l) => l.right).reduce(math.max);
+    final bottom = g.map((l) => l.bottom).reduce(math.max);
+    final weak = g.any((l) => l.confidence < weakConfidence);
+    final avgHeight = g.map((l) => l.height).reduce((a, b) => a + b) / g.length;
+    final joined = g.map((l) => l.text).join(' ');
+
+    BoxTextBlockKind kind;
+    final bullets = g.where((l) => _bullet.hasMatch(l.text)).length;
+    if (_legal.hasMatch(joined) && avgHeight <= median * 1.05) {
+      kind = BoxTextBlockKind.legal;
+    } else if (g.length >= 2 && bullets * 2 >= g.length) {
+      kind = BoxTextBlockKind.list;
+    } else if (g.length <= 2 && avgHeight >= median * 1.35) {
+      kind = BoxTextBlockKind.heading;
+    } else {
+      kind = BoxTextBlockKind.paragraph;
+    }
+
+    final units = <String>[];
+    if (kind == BoxTextBlockKind.list) {
+      for (final l in g) {
+        if (_bullet.hasMatch(l.text) || units.isEmpty) {
+          units.add(l.text.replaceFirst(_bullet, '').trim());
+        } else {
+          units[units.length - 1] = join(units.last, l.text);
+        }
+      }
+    } else {
+      var text = '';
+      for (final l in g) {
+        text = text.isEmpty ? l.text : join(text, l.text);
+      }
+      units.add(text);
+    }
+    return BoxTextBlock(
+      kind: kind,
+      units: units.where((u) => u.isNotEmpty).toList(),
+      lowConfidence: weak,
+      left: left,
+      top: top,
+      right: right,
+      bottom: bottom,
+    );
+  }
+
+  /// Joins two printed lines: no space between CJK lines, hyphenated words
+  /// rejoined, one space otherwise.
+  static String join(String a, String b) {
+    final aa = a.trimRight(), bb = b.trimLeft();
+    if (aa.isEmpty) return bb;
+    if (bb.isEmpty) return aa;
+    final lastA = aa.substring(aa.length - 1);
+    final firstB = bb.substring(0, 1);
+    if (_cjk.hasMatch(lastA) || _cjk.hasMatch(firstB)) return '$aa$bb';
+    if (lastA == '-' && aa.length > 1 && RegExp(r'\p{Ll}', unicode: true).hasMatch(firstB)) {
+      return '${aa.substring(0, aa.length - 1)}$bb';
+    }
+    return '$aa $bb';
+  }
+
+  /// Top to bottom; sections side by side (columns) left to right.
+  static List<BoxTextBlock> _readingOrder(List<BoxTextBlock> blocks) {
+    final sorted = [...blocks]..sort((a, b) => a.top.compareTo(b.top));
+    final bands = <List<BoxTextBlock>>[];
+    for (final b in sorted) {
+      final band = bands.isEmpty ? null : bands.last;
+      if (band != null) {
+        final bandTop = band.map((x) => x.top).reduce(math.min);
+        final bandBottom = band.map((x) => x.bottom).reduce(math.max);
+        final overlap = math.min(bandBottom, b.bottom) - math.max(bandTop, b.top);
+        final smaller = math.min(bandBottom - bandTop, b.bottom - b.top);
+        if (smaller > 0 && overlap > smaller * 0.4) {
+          band.add(b);
+          continue;
+        }
+      }
+      bands.add([b]);
+    }
+    int columnFirst(BoxTextBlock a, BoxTextBlock b) {
+      if ((a.left - b.left).abs() < 0.05) return a.top.compareTo(b.top);
+      return a.left.compareTo(b.left);
+    }
+    return [
+      for (final band in bands) ...(band..sort(columnFirst)),
+    ];
+  }
+}
diff --git a/lib/services/game_box/box_text_service.dart b/lib/services/game_box/box_text_service.dart
new file mode 100644
index 0000000..cf5d3b1
--- /dev/null
+++ b/lib/services/game_box/box_text_service.dart
@@ -0,0 +1,212 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:crypto/crypto.dart';
+import 'package:neo_box_reader/neo_box_reader.dart';
+import 'package:path/path.dart' as p;
+import 'package:path_provider/path_provider.dart';
+
+import 'package:neostation/services/game_box/box_text_layout.dart';
+import 'package:neostation/services/game_box/game_box_regions.dart';
+import 'package:neostation/services/logger_service.dart';
+
+/// Text of a back scan as recognised on the device.
+class BoxTranscript {
+  BoxTranscript({
+    required this.imageSha256,
+    required this.lines,
+    required this.document,
+    required this.language,
+    required this.languageConfidence,
+    required this.recognitionLanguages,
+    required this.createdAt,
+    this.fromCache = false,
+  });
+
+  static const int version = 1;
+
+  /// SHA-256 of the scan: a different picture never reuses this text.
+  final String imageSha256;
+  final List<BoxReaderLine> lines;
+  final BoxTextDocument document;
+
+  /// NeoStation code of the dominant language (null: not one of the twelve,
+  /// or not identified) and the raw identifier when known.
+  final String? language;
+  final double languageConfidence;
+  final List<String> recognitionLanguages;
+  final DateTime createdAt;
+  final bool fromCache;
+
+  String? rawLanguage;
+
+  Map<String, dynamic> toJson() => {
+        'version': version,
+        'engine': 'apple-vision',
+        'imageSha256': imageSha256,
+        'language': language,
+        'rawLanguage': rawLanguage,
+        'languageConfidence': languageConfidence,
+        'recognitionLanguages': recognitionLanguages,
+        'createdAt': createdAt.toIso8601String(),
+        'lines': [for (final l in lines) l.toJson()],
+      };
+
+  static BoxTranscript? fromJson(Map<String, dynamic> json) {
+    if (json['version'] != version) return null;
+    final lines = <BoxReaderLine>[];
+    for (final raw in (json['lines'] as List? ?? const [])) {
+      final l = BoxReaderLine.fromJson(raw);
+      if (l != null) lines.add(l);
+    }
+    final t = BoxTranscript(
+      imageSha256: json['imageSha256']?.toString() ?? '',
+      lines: lines,
+      document: BoxTextLayout.group(lines),
+      language: json['language'] as String?,
+      languageConfidence: (json['languageConfidence'] as num?)?.toDouble() ?? 0,
+      recognitionLanguages: [for (final l in (json['recognitionLanguages'] as List? ?? const [])) l.toString()],
+      createdAt: DateTime.tryParse(json['createdAt']?.toString() ?? '') ?? DateTime.now(),
+      fromCache: true,
+    );
+    t.rawLanguage = json['rawLanguage'] as String?;
+    return t;
+  }
+}
+
+/// A translation of a transcript into one NeoStation language.
+class BoxTranslation {
+  BoxTranslation({required this.target, required this.units, this.source, this.fromCache = false});
+  final String target;
+  final List<String> units;
+  final String? source;
+  final bool fromCache;
+}
+
+/// Reads and translates the back of a box on the device, with a cache.
+///
+/// Cache: `Application Support/NeoStation/BoxText/<scan SHA-256>/` keeps the
+/// recognised lines (`transcript.json`) and one file per target language
+/// (`<code>.json`), so a later reading, or a reading offline, reuses them.
+/// The scan itself stays the source; nothing is uploaded.
+class BoxTextService {
+  BoxTextService._();
+
+  static final _log = LoggerService.instance;
+  static String? _rootOverride;
+
+  /// Tests point the cache at a temporary folder.
+  static set rootForTesting(String? path) => _rootOverride = path;
+
+  static Future<Directory> _root() async {
+    if (_rootOverride != null) return Directory(_rootOverride!);
+    final support = await getApplicationSupportDirectory();
+    return Directory(p.join(support.path, 'NeoStation', 'BoxText'));
+  }
+
+  static Future<String> sha256Of(String path) => Isolate.run(() async {
+        final digest = await sha256.bind(File(path).openRead()).first;
+        return digest.toString();
+      });
+
+  static Future<Directory> _dirFor(String sha) async => Directory(p.join((await _root()).path, sha));
+
+  /// Cached transcript of the scan at [path], or a new recognition.
+  ///
+  /// [scanRegion] (ScreenScraper code) gives Vision its language hints.
+  static Future<BoxTranscript> transcript(String path, {String? scanRegion}) async {
+    final sha = await sha256Of(path);
+    final dir = await _dirFor(sha);
+    final file = File(p.join(dir.path, 'transcript.json'));
+    try {
+      if (await file.exists()) {
+        final cached = BoxTranscript.fromJson(jsonDecode(await file.readAsString()) as Map<String, dynamic>);
+        if (cached != null && cached.imageSha256 == sha) return cached;
+      }
+    } catch (_) {
+      // A damaged cache file is replaced by a new recognition.
+    }
+    final recognition = await NeoBoxReader.recognize(
+      path,
+      languages: GameBoxRegions.recognitionHints(scanRegion),
+    );
+    final document = BoxTextLayout.group(recognition.lines);
+    String? raw;
+    var confidence = 0.0;
+    if (!document.isEmpty) {
+      try {
+        final (lang, p) = await NeoBoxReader.detectLanguage(document.plainText);
+        raw = lang;
+        confidence = p;
+      } catch (_) {}
+    }
+    final transcript = BoxTranscript(
+      imageSha256: sha,
+      lines: recognition.lines,
+      document: document,
+      language: NeoBoxReader.appCodeOf(raw),
+      languageConfidence: confidence,
+      recognitionLanguages: recognition.languages,
+      createdAt: DateTime.now().toUtc(),
+    )..rawLanguage = raw;
+    try {
+      await dir.create(recursive: true);
+      await _writeAtomic(file, jsonEncode(transcript.toJson()));
+    } catch (e) {
+      _log.w('[GameBox] transcript cache not written: $e');
+    }
+    return transcript;
+  }
+
+  /// Translation of [transcript] into [target] (NeoStation code), cached.
+  static Future<BoxTranslation> translate(BoxTranscript transcript, String target) async {
+    final dir = await _dirFor(transcript.imageSha256);
+    final file = File(p.join(dir.path, '${_safe(target)}.json'));
+    final units = transcript.document.units;
+    try {
+      if (await file.exists()) {
+        final json = jsonDecode(await file.readAsString()) as Map<String, dynamic>;
+        final cached = (json['units'] as List?)?.map((e) => e.toString()).toList();
+        if (json['version'] == 1 && cached != null && cached.length == units.length &&
+            json['sourceUnits'] is List && _same(json['sourceUnits'] as List, units)) {
+          return BoxTranslation(target: target, units: cached, source: json['source'] as String?, fromCache: true);
+        }
+      }
+    } catch (_) {}
+    final appleTarget = NeoBoxReader.appleLanguages[target] ?? target;
+    final source = transcript.languageConfidence >= 0.5 ? transcript.rawLanguage : null;
+    final (translated, detected) = await NeoBoxReader.translate(units, source: source, target: appleTarget);
+    final result = BoxTranslation(target: target, units: translated, source: detected ?? source);
+    try {
+      await dir.create(recursive: true);
+      await _writeAtomic(file, jsonEncode({
+        'version': 1,
+        'engine': 'apple-translation',
+        'target': target,
+        'source': result.source,
+        'sourceUnits': units,
+        'units': translated,
+      }));
+    } catch (e) {
+      _log.w('[GameBox] translation cache not written: $e');
+    }
+    return result;
+  }
+
+  static bool _same(List a, List<String> b) {
+    if (a.length != b.length) return false;
+    for (var i = 0; i < a.length; i++) {
+      if (a[i].toString() != b[i]) return false;
+    }
+    return true;
+  }
+
+  static String _safe(String s) => s.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
+
+  static Future<void> _writeAtomic(File file, String content) async {
+    final temp = File('${file.path}.part');
+    await temp.writeAsString(content, flush: true);
+    await temp.rename(file.path);
+  }
+}
diff --git a/lib/services/game_box/game_box_fetcher.dart b/lib/services/game_box/game_box_fetcher.dart
new file mode 100644
index 0000000..c1433a0
--- /dev/null
+++ b/lib/services/game_box/game_box_fetcher.dart
@@ -0,0 +1,288 @@
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+import 'package:neostation/models/game_model.dart';
+import 'package:neostation/providers/file_provider.dart';
+import 'package:neostation/repositories/scraper_repository.dart';
+import 'package:neostation/services/game_box/game_box_media.dart';
+import 'package:neostation/services/game_box/game_box_regions.dart';
+import 'package:neostation/services/logger_service.dart';
+import 'package:neostation/services/screenscraper/media_downloader.dart';
+import 'package:neostation/services/screenscraper/region_config.dart';
+import 'package:neostation/services/screenscraper/rom_hasher.dart';
+import 'package:neostation/services/screenscraper/screenscraper_exceptions.dart';
+import 'package:neostation/services/screenscraper_service.dart';
+
+enum GameBoxFetchStatus {
+  updated,
+  nothingNew,
+  needsLogin,
+  systemNotMapped,
+  notFound,
+  quota,
+  failed,
+}
+
+class GameBoxFetchResult {
+  const GameBoxFetchResult(this.status, {this.downloaded = const {}});
+  final GameBoxFetchStatus status;
+  final Set<GameBoxMediaKind> downloaded;
+}
+
+/// Gets the faces of a game's box from ScreenScraper, through the scraper's
+/// own client, credentials, quota counter and payload validation.
+///
+/// Identification: the ScreenScraper system of the console, the ROM's MD5
+/// when the file is local and small enough to hash quickly, its serial when
+/// known, and its file name (No-Intro/Redump names carry the region). A game
+/// is never matched by its display title alone. The front already in the
+/// library is never replaced; it is only compared with the listed fronts to
+/// record which edition it shows.
+class GameBoxMediaFetcher {
+  GameBoxMediaFetcher._();
+
+  static final _log = LoggerService.instance;
+
+  /// ROMs up to this size are hashed (cartridges, small discs).
+  static const int md5Limit = 64 * 1024 * 1024;
+
+  static const _faces = [GameBoxMediaKind.back, GameBoxMediaKind.spine, GameBoxMediaKind.support];
+
+  static Future<GameBoxFetchResult> fetch({
+    required GameModel game,
+    required String appSystemId,
+    required String systemFolder,
+    required FileProvider fileProvider,
+  }) async {
+    try {
+      if (!await ScreenScraperService.hasSavedCredentials()) {
+        return const GameBoxFetchResult(GameBoxFetchStatus.needsLogin);
+      }
+      var ssSystem = await ScraperRepository.getScreenScraperIdByAppSystemId(appSystemId);
+      if (ssSystem == null) {
+        await ScreenScraperService.syncSystemIds();
+        ssSystem = await ScraperRepository.getScreenScraperIdByAppSystemId(appSystemId);
+      }
+      if (ssSystem == null) return const GameBoxFetchResult(GameBoxFetchStatus.systemNotMapped);
+
+      final md5 = await _romMd5(game.romPath);
+      final serial = game.titleId?.trim();
+      Map<String, dynamic>? info;
+      var matched = GameBoxMatch.fileName;
+      if (md5 != null) {
+        info = await ScreenScraperService.fetchGameInfo(
+          ssSystem.toString(), game.romname,
+          appSystemId: appSystemId, md5: md5, maxDailyRequests: 0,
+          serialNumber: (serial?.isEmpty ?? true) ? null : serial,
+        );
+        if (info?['gameInfo'] != null) matched = GameBoxMatch.md5;
+      }
+      if (info?['gameInfo'] == null) {
+        info = await ScreenScraperService.fetchGameInfo(
+          ssSystem.toString(), game.romname,
+          appSystemId: appSystemId, maxDailyRequests: 0,
+          serialNumber: (serial?.isEmpty ?? true) ? null : serial,
+        );
+        matched = (serial?.isNotEmpty ?? false) ? GameBoxMatch.serial : GameBoxMatch.fileName;
+      }
+      final jeu = info?['gameInfo'];
+      if (jeu is! Map) return const GameBoxFetchResult(GameBoxFetchStatus.notFound);
+      final gameId = jeu['id']?.toString() ?? '';
+      final rawMedias = jeu['medias'];
+      final medias = rawMedias is List ? rawMedias : const [];
+
+      final entries = <GameBoxMediaEntry>[];
+      final urls = <String, String>{}; // identity → URL (with credentials, memory only)
+      for (final m in medias) {
+        if (m is! Map) continue;
+        final e = GameBoxMediaEntry.fromScreenScraper(m);
+        if (e == null) continue;
+        entries.add(e);
+        final url = m['url']?.toString() ?? '';
+        if (url.isNotEmpty) urls.putIfAbsent('${e.kind.name}|${e.identity}|${e.region}', () => url);
+      }
+
+      final store = GameBoxMediaStore(fileProvider);
+      final local = store.read(game, systemFolder);
+      final (regions, regionSource) = _gameRegions(jeu, game.romname, trustRom: matched == GameBoxMatch.md5);
+      final front = _frontEdition(local.front, entries);
+      final priority = await ScreenscraperRegionConfig.getRegionPriority();
+
+      final defaults = <GameBoxMediaKind, String>{};
+      final downloaded = <GameBoxMediaKind>{};
+      for (final kind in _faces) {
+        final choice = GameBoxMediaSelection.choose(
+          entries, kind,
+          gameRegions: regions, frontRegion: front?.region, regionPriority: priority,
+        );
+        if (choice == null) continue;
+        defaults[kind] = choice.identity;
+        final previous = local.manifest?.defaults[kind];
+        final existing = _localPath(local, kind);
+        if (existing != null && previous == choice.identity) continue;
+        final url = urls['${kind.name}|${choice.identity}|${choice.region}'];
+        if (url == null) continue;
+        final target = store.canonicalPath(game, systemFolder, kind.folder, choice.format);
+        final ok = await ScreenscraperMediaDownloader.downloadValidatedMedia(
+          url, target,
+          mediaType: kind.screenScraperType,
+          // A different edition replaces the previous default face.
+          forceOverwrite: existing != null,
+        );
+        if (ok) {
+          downloaded.add(kind);
+          GameBoxImageSize.evict(target);
+        } else {
+          defaults.remove(kind);
+          if (previous != null && existing != null) defaults[kind] = previous;
+        }
+      }
+
+      final manifest = GameBoxManifest(
+        screenScraperSystemId: ssSystem.toString(),
+        screenScraperGameId: gameId,
+        matchedBy: matched,
+        entries: entries,
+        gameRegions: regions,
+        gameRegionSource: regionSource,
+        frontRegion: front?.region,
+        frontConfirmed: front != null,
+        defaults: defaults,
+        backEditionFiles: _keptEditionFiles(local),
+      );
+      await store.writeManifest(game, systemFolder, manifest);
+      return GameBoxFetchResult(
+        downloaded.isEmpty ? GameBoxFetchStatus.nothingNew : GameBoxFetchStatus.updated,
+        downloaded: downloaded,
+      );
+    } on ScreenscraperQuotaExceededException {
+      return const GameBoxFetchResult(GameBoxFetchStatus.quota);
+    } catch (e) {
+      _log.e('[GameBox] faces fetch failed: $e');
+      return const GameBoxFetchResult(GameBoxFetchStatus.failed);
+    }
+  }
+
+  /// Path of the back scan of [edition], downloading it once if needed.
+  ///
+  /// A scan whose identity (MD5, else SHA-1) is already on disk, as the
+  /// default back or as another edition, is never downloaded again. Offline,
+  /// an edition not yet downloaded returns null.
+  static Future<String?> ensureBackEdition({
+    required GameModel game,
+    required String systemFolder,
+    required FileProvider fileProvider,
+    required GameBoxBackEdition edition,
+  }) async {
+    final store = GameBoxMediaStore(fileProvider);
+    final local = store.read(game, systemFolder);
+    final manifest = local.manifest;
+    if (manifest == null) return null;
+    final existing = local.backEditionFile(edition.entry);
+    if (existing != null) return existing;
+    final uri = await ScreenScraperService.mediaJeuUri(
+      systemId: manifest.screenScraperSystemId,
+      gameId: manifest.screenScraperGameId,
+      media: edition.entry.token,
+    );
+    if (uri == null || manifest.screenScraperGameId.isEmpty) return null;
+    final name = '${_safe(edition.entry.region)}-${_safe(edition.entry.identity)}.${edition.entry.format}';
+    final dir = local.backEditionsDir!;
+    final target = p.join(dir, name);
+    final ok = await ScreenscraperMediaDownloader.downloadValidatedMedia(
+      uri.toString(), target, mediaType: GameBoxMediaKind.back.screenScraperType,
+    );
+    if (!ok) return null;
+    final files = Map<String, String>.from(manifest.backEditionFiles)..[edition.entry.identity] = name;
+    await store.writeManifest(
+      game, systemFolder,
+      GameBoxManifest(
+        screenScraperSystemId: manifest.screenScraperSystemId,
+        screenScraperGameId: manifest.screenScraperGameId,
+        matchedBy: manifest.matchedBy,
+        entries: manifest.entries,
+        gameRegions: manifest.gameRegions,
+        gameRegionSource: manifest.gameRegionSource,
+        frontRegion: manifest.frontRegion,
+        frontConfirmed: manifest.frontConfirmed,
+        defaults: manifest.defaults,
+        backEditionFiles: files,
+        fetchedAt: manifest.fetchedAt,
+      ),
+    );
+    return target;
+  }
+
+  static String _safe(String s) => s.replaceAll(RegExp(r'[^A-Za-z0-9]'), '_');
+
+  static String? _localPath(GameBoxLocalMedia local, GameBoxMediaKind kind) => switch (kind) {
+        GameBoxMediaKind.front => local.front,
+        GameBoxMediaKind.back => local.back,
+        GameBoxMediaKind.spine => local.spine,
+        GameBoxMediaKind.support => local.support,
+      };
+
+  static Map<String, String> _keptEditionFiles(GameBoxLocalMedia local) {
+    final kept = <String, String>{};
+    final m = local.manifest;
+    final dir = local.backEditionsDir;
+    if (m == null || dir == null) return kept;
+    m.backEditionFiles.forEach((id, name) {
+      if (File(p.join(dir, name)).existsSync()) kept[id] = name;
+    });
+    return kept;
+  }
+
+  static Future<String?> _romMd5(String? romPath) async {
+    if (romPath == null || romPath.isEmpty || romPath.contains('://')) return null;
+    try {
+      final f = File(romPath);
+      if (!await f.exists()) return null;
+      final size = await f.length();
+      if (size <= 0 || size > md5Limit) return null;
+      return await ScreenscraperRomHasher.calculateMd5InIsolate(romPath);
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// Regions of the user's copy: the ROM record of a checksum match, else the
+  /// file name's region tags.
+  static (List<String>, String?) _gameRegions(Map jeu, String romName, {required bool trustRom}) {
+    if (trustRom) {
+      final rom = jeu['rom'];
+      if (rom is Map) {
+        final raw = rom['romregions'] ?? rom['regions'];
+        final regions = <String>[];
+        if (raw is String) {
+          regions.addAll(raw.split(RegExp(r'[,;\s]+')).where((r) => r.isNotEmpty));
+        } else if (raw is Map) {
+          for (final v in raw.values) {
+            if (v is String && v.isNotEmpty) regions.add(v);
+          }
+        } else if (raw is List) {
+          for (final v in raw) {
+            final s = v is Map ? (v['shortname'] ?? v['nomcourt'] ?? '').toString() : v.toString();
+            if (s.isNotEmpty) regions.add(s);
+          }
+        }
+        if (regions.isNotEmpty) return (regions.map((r) => r.toLowerCase()).toList(), 'screenscraper');
+      }
+    }
+    final fromName = GameBoxRegions.fromFileName(romName);
+    return (fromName, fromName.isEmpty ? null : 'filename');
+  }
+
+  /// The listed front whose MD5 equals the local front: proves which edition
+  /// the library already shows.
+  static GameBoxMediaEntry? _frontEdition(String? frontPath, List<GameBoxMediaEntry> entries) {
+    if (frontPath == null) return null;
+    final md5 = gameBoxFileMd5(frontPath);
+    if (md5 == null) return null;
+    for (final e in entries) {
+      if (e.kind == GameBoxMediaKind.front && e.md5 != null && e.md5!.toLowerCase() == md5) return e;
+    }
+    return null;
+  }
+}
diff --git a/lib/services/game_box/game_box_media.dart b/lib/services/game_box/game_box_media.dart
new file mode 100644
index 0000000..4d46ce9
--- /dev/null
+++ b/lib/services/game_box/game_box_media.dart
@@ -0,0 +1,507 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+import 'dart:ui' show Size;
+
+import 'package:crypto/crypto.dart';
+import 'package:path/path.dart' as p;
+
+import 'package:neostation/models/game_model.dart';
+import 'package:neostation/providers/file_provider.dart';
+import 'package:neostation/services/game_box/game_box_regions.dart';
+
+/// Kinds of box media fetched for the 3D box, with their ScreenScraper type
+/// and NeoStation media folder (`media/<system>/<folder>/<rom>.<ext>`).
+enum GameBoxMediaKind {
+  front('box-2D', 'box2d'),
+  back('box-2D-back', 'box2dback'),
+  spine('box-2D-side', 'box2dside'),
+  support('support-2D', 'support2d');
+
+  const GameBoxMediaKind(this.screenScraperType, this.folder);
+  final String screenScraperType;
+  final String folder;
+
+  static GameBoxMediaKind? ofType(String type) {
+    for (final k in values) {
+      if (k.screenScraperType == type) return k;
+    }
+    return null;
+  }
+}
+
+/// Media folders written by the 3D box, for cleanup and storage lists.
+abstract final class GameBoxMediaFolders {
+  static const back = 'box2dback';
+  static const spine = 'box2dside';
+  static const support = 'support2d';
+
+  /// Back scans of other editions, one folder per game.
+  static const backEditions = 'box2dback-editions';
+
+  /// Per-game JSON manifest of the editions ScreenScraper lists.
+  static const manifest = 'boxmeta';
+
+  static const all = [back, spine, support, backEditions, manifest];
+}
+
+/// One scan listed by ScreenScraper for a game, without any credential.
+///
+/// [token] is the `media` argument of `mediaJeu.php` (`box-2D-back(fr)`):
+/// with the game and system ids of the manifest it is enough to download
+/// the same scan later, credentials being added at request time only.
+class GameBoxMediaEntry {
+  const GameBoxMediaEntry({
+    required this.kind,
+    required this.region,
+    required this.format,
+    required this.token,
+    this.md5,
+    this.sha1,
+    this.crc,
+    this.size,
+  });
+
+  final GameBoxMediaKind kind;
+  final String region;
+  final String format;
+  final String token;
+  final String? md5;
+  final String? sha1;
+  final String? crc;
+  final int? size;
+
+  /// Presumed print language (see [GameBoxRegions.languageOfRegion]).
+  String? get language => GameBoxRegions.languageOfRegion(region);
+
+  /// Identity used to avoid downloading the same scan twice: ScreenScraper
+  /// often lists one picture under several regions (`wor`, `us`).
+  String get identity => (md5?.isNotEmpty ?? false)
+      ? 'md5:${md5!.toLowerCase()}'
+      : (sha1?.isNotEmpty ?? false)
+          ? 'sha1:${sha1!.toLowerCase()}'
+          : 'token:$token';
+
+  Map<String, dynamic> toJson() => {
+        'type': kind.screenScraperType,
+        'region': region,
+        'format': format,
+        'media': token,
+        if (md5 != null) 'md5': md5,
+        if (sha1 != null) 'sha1': sha1,
+        if (crc != null) 'crc': crc,
+        if (size != null) 'size': size,
+      };
+
+  static GameBoxMediaEntry? fromJson(Map<String, dynamic> json) {
+    final kind = GameBoxMediaKind.ofType(json['type']?.toString() ?? '');
+    final token = json['media']?.toString() ?? '';
+    if (kind == null || token.isEmpty) return null;
+    return GameBoxMediaEntry(
+      kind: kind,
+      region: json['region']?.toString() ?? '',
+      format: _format(json['format']),
+      token: token,
+      md5: _optional(json['md5']),
+      sha1: _optional(json['sha1']),
+      crc: _optional(json['crc']),
+      size: int.tryParse(json['size']?.toString() ?? ''),
+    );
+  }
+
+  /// Reads one entry of a `jeuInfos.php` `medias` list. The URL is only used
+  /// to extract its `media` token; it is never stored.
+  static GameBoxMediaEntry? fromScreenScraper(Map<dynamic, dynamic> media) {
+    final kind = GameBoxMediaKind.ofType(media['type']?.toString() ?? '');
+    if (kind == null) return null;
+    final region = media['region']?.toString() ?? '';
+    var token = '';
+    final url = media['url']?.toString() ?? '';
+    final uri = Uri.tryParse(url);
+    if (uri != null) token = uri.queryParameters['media'] ?? '';
+    if (token.isEmpty) {
+      token = region.isEmpty ? kind.screenScraperType : '${kind.screenScraperType}($region)';
+    }
+    return GameBoxMediaEntry(
+      kind: kind,
+      region: region,
+      format: _format(media['format']),
+      token: token,
+      md5: _optional(media['md5']),
+      sha1: _optional(media['sha1']),
+      crc: _optional(media['crc']),
+      size: int.tryParse(media['size']?.toString() ?? ''),
+    );
+  }
+
+  static String _format(Object? raw) {
+    final f = raw?.toString().toLowerCase() ?? '';
+    return const {'png', 'jpg', 'jpeg', 'webp'}.contains(f) ? (f == 'jpeg' ? 'jpg' : f) : 'png';
+  }
+
+  static String? _optional(Object? raw) {
+    final s = raw?.toString().trim() ?? '';
+    return s.isEmpty ? null : s;
+  }
+}
+
+/// How the game was identified when its editions were listed.
+enum GameBoxMatch { md5, serial, fileName, title }
+
+/// Record of the editions available for one game (`boxmeta/<rom>.json`).
+///
+/// It is the offline source of truth of the 3D box: which scans exist, for
+/// which regions, which one is on disk for each face, and how the game was
+/// identified. It never holds credentials or full URLs.
+class GameBoxManifest {
+  GameBoxManifest({
+    required this.screenScraperSystemId,
+    required this.screenScraperGameId,
+    required this.matchedBy,
+    required this.entries,
+    this.gameRegions = const [],
+    this.gameRegionSource,
+    this.frontRegion,
+    this.frontConfirmed = false,
+    Map<GameBoxMediaKind, String>? defaults,
+    Map<String, String>? backEditionFiles,
+    DateTime? fetchedAt,
+  })  : defaults = defaults ?? {},
+        backEditionFiles = backEditionFiles ?? {},
+        fetchedAt = fetchedAt ?? DateTime.now().toUtc();
+
+  static const int version = 1;
+
+  final String screenScraperSystemId;
+  final String screenScraperGameId;
+  final GameBoxMatch matchedBy;
+  final List<GameBoxMediaEntry> entries;
+
+  /// Regions of the user's own copy, when known, and where they come from
+  /// (`filename`: No-Intro/Redump tags; `screenscraper`: the ROM record of a
+  /// checksum match).
+  final List<String> gameRegions;
+  final String? gameRegionSource;
+
+  /// Region of the front scan already in the library, confirmed when its
+  /// MD5 equals one listed by ScreenScraper for this game.
+  final String? frontRegion;
+  final bool frontConfirmed;
+
+  /// Identity ([GameBoxMediaEntry.identity]) of the scan saved as the default
+  /// face of each kind.
+  final Map<GameBoxMediaKind, String> defaults;
+
+  /// Back scans of other editions already downloaded: identity → file name
+  /// in the game's `box2dback-editions` folder.
+  final Map<String, String> backEditionFiles;
+  final DateTime fetchedAt;
+
+  List<GameBoxMediaEntry> of(GameBoxMediaKind kind) =>
+      entries.where((e) => e.kind == kind).toList();
+
+  GameBoxMediaEntry? defaultEntry(GameBoxMediaKind kind) {
+    final id = defaults[kind];
+    if (id == null) return null;
+    for (final e in of(kind)) {
+      if (e.identity == id) return e;
+    }
+    return null;
+  }
+
+  /// Distinct back scans (one per picture), with every region that lists it.
+  List<GameBoxBackEdition> backEditions() {
+    final byId = <String, GameBoxBackEdition>{};
+    for (final e in of(GameBoxMediaKind.back)) {
+      final existing = byId[e.identity];
+      if (existing == null) {
+        byId[e.identity] = GameBoxBackEdition(entry: e, regions: [e.region]);
+      } else if (!existing.regions.contains(e.region)) {
+        existing.regions.add(e.region);
+      }
+    }
+    return byId.values.toList();
+  }
+
+  Map<String, dynamic> toJson() => {
+        'version': version,
+        'screenscraper': {'systemId': screenScraperSystemId, 'gameId': screenScraperGameId},
+        'matchedBy': matchedBy.name,
+        'gameRegions': gameRegions,
+        if (gameRegionSource != null) 'gameRegionSource': gameRegionSource,
+        if (frontRegion != null) 'frontRegion': frontRegion,
+        'frontConfirmed': frontConfirmed,
+        'defaults': {for (final e in defaults.entries) e.key.name: e.value},
+        'backEditionFiles': backEditionFiles,
+        'fetchedAt': fetchedAt.toIso8601String(),
+        'media': [for (final e in entries) e.toJson()],
+      };
+
+  static GameBoxManifest? fromJson(Map<String, dynamic> json) {
+    if (json['version'] != version) return null;
+    final ss = json['screenscraper'];
+    if (ss is! Map) return null;
+    final entries = <GameBoxMediaEntry>[];
+    for (final raw in (json['media'] as List? ?? const [])) {
+      if (raw is Map) {
+        final e = GameBoxMediaEntry.fromJson(Map<String, dynamic>.from(raw));
+        if (e != null) entries.add(e);
+      }
+    }
+    final defaults = <GameBoxMediaKind, String>{};
+    final rawDefaults = json['defaults'];
+    if (rawDefaults is Map) {
+      for (final k in GameBoxMediaKind.values) {
+        final v = rawDefaults[k.name];
+        if (v is String) defaults[k] = v;
+      }
+    }
+    final files = <String, String>{};
+    final rawFiles = json['backEditionFiles'];
+    if (rawFiles is Map) {
+      rawFiles.forEach((k, v) {
+        final name = v.toString();
+        // Only plain file names inside the game's own folder.
+        if (name == p.basename(name) && !name.startsWith('.')) files[k.toString()] = name;
+      });
+    }
+    return GameBoxManifest(
+      screenScraperSystemId: ss['systemId']?.toString() ?? '',
+      screenScraperGameId: ss['gameId']?.toString() ?? '',
+      matchedBy: GameBoxMatch.values.firstWhere(
+        (m) => m.name == json['matchedBy'],
+        orElse: () => GameBoxMatch.title,
+      ),
+      entries: entries,
+      gameRegions: [for (final r in (json['gameRegions'] as List? ?? const [])) r.toString()],
+      gameRegionSource: json['gameRegionSource']?.toString(),
+      frontRegion: json['frontRegion']?.toString(),
+      frontConfirmed: json['frontConfirmed'] == true,
+      defaults: defaults,
+      backEditionFiles: files,
+      fetchedAt: DateTime.tryParse(json['fetchedAt']?.toString() ?? ''),
+    );
+  }
+}
+
+/// One distinct back scan and the regions that list it.
+class GameBoxBackEdition {
+  GameBoxBackEdition({required this.entry, required this.regions});
+  final GameBoxMediaEntry entry;
+  final List<String> regions;
+
+  /// Languages presumed from all of its regions.
+  Set<String> get languages => {
+        for (final r in regions)
+          if (GameBoxRegions.languageOfRegion(r) != null) GameBoxRegions.languageOfRegion(r)!,
+      };
+}
+
+/// Choice of default scans, kept pure for tests.
+class GameBoxMediaSelection {
+  GameBoxMediaSelection._();
+
+  /// Best scan of [kind] for a copy of [gameRegions], then the region of the
+  /// front scan already shown, then the user's region priority.
+  static GameBoxMediaEntry? choose(
+    List<GameBoxMediaEntry> entries,
+    GameBoxMediaKind kind, {
+    List<String> gameRegions = const [],
+    String? frontRegion,
+    Map<String, int> regionPriority = const {},
+  }) {
+    final candidates = entries.where((e) => e.kind == kind).toList();
+    if (candidates.isEmpty) return null;
+    int score(GameBoxMediaEntry e) {
+      var s = regionPriority[e.region] ?? 5;
+      final i = gameRegions.indexOf(e.region);
+      if (i >= 0) s += 1000 - i;
+      if (frontRegion != null && e.region == frontRegion) s += 500;
+      return s;
+    }
+    candidates.sort((a, b) => score(b).compareTo(score(a)));
+    return candidates.first;
+  }
+
+  /// Back scan to read in [language]: one whose region presumes that
+  /// language, preferring the default edition, then the copy's own regions.
+  static GameBoxBackEdition? backForLanguage(
+    GameBoxManifest manifest,
+    String language, {
+    List<String> gameRegions = const [],
+  }) {
+    final editions = manifest.backEditions().where((e) => e.languages.contains(language)).toList();
+    if (editions.isEmpty) return null;
+    final defaultId = manifest.defaults[GameBoxMediaKind.back];
+    int score(GameBoxBackEdition e) {
+      var s = 0;
+      if (e.entry.identity == defaultId) s += 100;
+      if (e.regions.any(gameRegions.contains)) s += 50;
+      // A region that names the language alone (fr) over a multilingual one.
+      if (e.regions.any((r) => !GameBoxRegions.isMultilingualRegion(r))) s += 10;
+      return s;
+    }
+    editions.sort((a, b) => score(b).compareTo(score(a)));
+    return editions.first;
+  }
+}
+
+/// The files of a game's box as they are on disk.
+class GameBoxLocalMedia {
+  const GameBoxLocalMedia({
+    this.front,
+    this.back,
+    this.spine,
+    this.support,
+    this.manifest,
+    this.manifestPath,
+    this.backEditionsDir,
+  });
+
+  final String? front;
+  final String? back;
+  final String? spine;
+  final String? support;
+  final GameBoxManifest? manifest;
+  final String? manifestPath;
+  final String? backEditionsDir;
+
+  bool get hasBack => back != null;
+
+  /// Path of an already downloaded back scan of another edition.
+  String? backEditionFile(GameBoxMediaEntry entry) {
+    final m = manifest;
+    final dir = backEditionsDir;
+    if (m == null || dir == null) return null;
+    if (m.defaults[GameBoxMediaKind.back] == entry.identity && back != null) return back;
+    final name = m.backEditionFiles[entry.identity];
+    if (name == null) return null;
+    final f = File(p.join(dir, name));
+    return f.existsSync() ? f.path : null;
+  }
+}
+
+/// Reads the box media of a game from the media folders.
+class GameBoxMediaStore {
+  GameBoxMediaStore(this.fileProvider);
+  final FileProvider fileProvider;
+
+  String _existing(GameModel game, String system, String folder) {
+    final path = game.getImagePath(system, folder, fileProvider);
+    return File(path).existsSync() ? path : '';
+  }
+
+  /// Canonical path of [folder] for [game] with [extension]: the reader's
+  /// own lookup (see [GameModel.getImagePath]) so writer and reader agree.
+  String canonicalPath(GameModel game, String system, String folder, String extension) {
+    final png = game.getImagePath(system, folder, fileProvider);
+    return '${p.withoutExtension(png)}.$extension';
+  }
+
+  String manifestPath(GameModel game, String system) =>
+      canonicalPath(game, system, GameBoxMediaFolders.manifest, 'json');
+
+  String backEditionsDir(GameModel game, String system) {
+    final key = p.basenameWithoutExtension(manifestPath(game, system));
+    return p.join(p.dirname(p.dirname(manifestPath(game, system))), GameBoxMediaFolders.backEditions, key);
+  }
+
+  GameBoxLocalMedia read(GameModel game, String system) {
+    String? orNull(String s) => s.isEmpty ? null : s;
+    final mPath = manifestPath(game, system);
+    GameBoxManifest? manifest;
+    try {
+      final f = File(mPath);
+      if (f.existsSync()) {
+        final json = jsonDecode(f.readAsStringSync());
+        if (json is Map<String, dynamic>) manifest = GameBoxManifest.fromJson(json);
+      }
+    } catch (_) {
+      manifest = null; // Unreadable manifest: the faces stay usable.
+    }
+    return GameBoxLocalMedia(
+      front: orNull(_existing(game, system, GameBoxMediaKind.front.folder)),
+      back: orNull(_existing(game, system, GameBoxMediaFolders.back)),
+      spine: orNull(_existing(game, system, GameBoxMediaFolders.spine)),
+      support: orNull(_existing(game, system, GameBoxMediaFolders.support)),
+      manifest: manifest,
+      manifestPath: mPath,
+      backEditionsDir: backEditionsDir(game, system),
+    );
+  }
+
+  /// Writes [manifest] atomically.
+  Future<void> writeManifest(GameModel game, String system, GameBoxManifest manifest) async {
+    final path = manifestPath(game, system);
+    final file = File(path);
+    await file.parent.create(recursive: true);
+    final temp = File('$path.part');
+    await temp.writeAsString(const JsonEncoder.withIndent(' ').convert(manifest.toJson()), flush: true);
+    await temp.rename(path);
+  }
+}
+
+/// Pixel size of a PNG or JPEG from its header (no decoding).
+class GameBoxImageSize {
+  GameBoxImageSize._();
+
+  static final Map<String, Size?> _cache = {};
+
+  static void evict(String path) => _cache.remove(path);
+
+  static Size? of(String path) {
+    if (_cache.containsKey(path)) return _cache[path];
+    Size? result;
+    try {
+      final raf = File(path).openSync();
+      try {
+        final len = raf.lengthSync().clamp(0, 262144).toInt();
+        final buf = Uint8List(len);
+        raf.readIntoSync(buf);
+        result = fromBytes(buf);
+      } finally {
+        raf.closeSync();
+      }
+    } catch (_) {
+      result = null;
+    }
+    _cache[path] = result;
+    return result;
+  }
+
+  static Size? fromBytes(Uint8List b) {
+    if (b.length > 24 && b[0] == 0x89 && b[1] == 0x50 && b[2] == 0x4E && b[3] == 0x47) {
+      final w = (b[16] << 24) | (b[17] << 16) | (b[18] << 8) | b[19];
+      final h = (b[20] << 24) | (b[21] << 16) | (b[22] << 8) | b[23];
+      return (w > 0 && h > 0 && w < 30000 && h < 30000) ? Size(w.toDouble(), h.toDouble()) : null;
+    }
+    if (b.length > 4 && b[0] == 0xFF && b[1] == 0xD8) {
+      var i = 2;
+      while (i + 9 < b.length) {
+        if (b[i] != 0xFF) {
+          i++;
+          continue;
+        }
+        final marker = b[i + 1];
+        if (marker >= 0xC0 && marker <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC) {
+          final h = (b[i + 5] << 8) | b[i + 6];
+          final w = (b[i + 7] << 8) | b[i + 8];
+          return (w > 0 && h > 0) ? Size(w.toDouble(), h.toDouble()) : null;
+        }
+        i += ((b[i + 2] << 8) | b[i + 3]) + 2;
+      }
+    }
+    return null;
+  }
+}
+
+/// MD5 of a small local file (scans), hex.
+String? gameBoxFileMd5(String path) {
+  try {
+    final f = File(path);
+    if (!f.existsSync() || f.lengthSync() > 64 * 1024 * 1024) return null;
+    return md5.convert(f.readAsBytesSync()).toString();
+  } catch (_) {
+    return null;
+  }
+}
diff --git a/lib/services/game_box/game_box_preferences.dart b/lib/services/game_box/game_box_preferences.dart
new file mode 100644
index 0000000..4e7f6e5
