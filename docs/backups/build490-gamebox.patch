+      case 'ru':
+        return const ['ru-RU', 'en-US'];
+      case 'fr':
+        return const ['fr-FR', 'en-US'];
+      case 'de':
+        return const ['de-DE', 'en-US'];
+      case 'sp':
+        return const ['es-ES', 'en-US'];
+      case 'it':
+        return const ['it-IT', 'en-US'];
+      case 'pt':
+      case 'br':
+        return const ['pt-BR', 'en-US'];
+      case 'eu':
+        return const ['en-US', 'fr-FR', 'de-DE', 'es-ES', 'it-IT'];
+      default:
+        return const ['en-US'];
+    }
+  }
+}
