+// The caller supplies a 2D linear texture. Snapshot source rows before changing pool
+// memory, since a second virtual address can expose the same physical storage.
+static int write_region_linear(const tex_t *t, const NVNcopyRegion *r, const uint8_t *src,
+                               size_t row, int bw, int bh, int bpb) {
+    if (r->zoffset || (r->depth != 0 && r->depth != 1) ||
+        r->width <= 0 || r->height <= 0 || r->xoffset < 0 || r->yoffset < 0 ||
+        (uint64_t)r->xoffset + (unsigned)r->width > t->d.width ||
+        (uint64_t)r->yoffset + (unsigned)r->height > t->d.height ||
+        r->xoffset % bw || r->yoffset % bh || !src) return 0;
+    if (!r->xoffset && !r->yoffset && (uint32_t)r->width == t->d.width &&
+        (uint32_t)r->height == t->d.height) return 0;
+
+    // The old encoder replays every row. Unchanged texels later in the level
+    // can alias earlier writes. A small level has distinct offsets inside
+    // a VM page's length. A full suffix has no later unmodified texel.
+    int suffix = (uint64_t)r->yoffset + (unsigned)r->height == t->d.height &&
+                 ((!r->xoffset && (uint32_t)r->width == t->d.width) ||
+                  (r->height <= bh && (uint64_t)r->xoffset + (unsigned)r->width == t->d.width));
+    int page = getpagesize();
+    if (!suffix || page <= 0) return 0;
+    // Within-row store order in memcpy is unspecified for a row containing the
+    // same physical byte twice. Exclude rows wide enough for such aliasing.
+    uint64_t useful = ((uint64_t)t->d.width + bw - 1) / bw * bpb;
+    if (useful > (unsigned)page) return 0;
+    uint64_t rows = ((uint64_t)t->d.height + bh - 1) / bh;
+    uint64_t align = t->L.align;
+    uint64_t pitch = t->d.stride ? t->d.stride : (useful + align - 1) & -align;
+    if (pitch < useful || pitch > UINT32_MAX || rows > SIZE_MAX / pitch || rows * pitch != t->L.size ||
+        t->L.size - 1 > UINTPTR_MAX - (uintptr_t)t->mem) return 0;
+    size_t x = (size_t)(r->xoffset / bw) * bpb, y = (size_t)(r->yoffset / bh);
+    size_t bytes = (size_t)(((uint64_t)r->width + bw - 1) / bw) * bpb;
+    size_t count = (size_t)(((uint64_t)r->height + bh - 1) / bh);
+    if (!row) row = bytes;
+    if (row < bytes || (count - 1) > (SIZE_MAX - bytes) / row ||
+        row * (count - 1) + bytes - 1 > UINTPTR_MAX - (uintptr_t)src) return 0;
+
+    uint8_t *first = t->mem + y * (size_t)pitch + x;
+    uint8_t local[512];
+    size_t scratch_bytes = bytes * count; // At most the checked source span.
+    uint8_t *scratch = scratch_bytes <= sizeof local ? local : malloc(scratch_bytes);
+    if (!scratch) return 0;
+    dm_guest_write_prepare(t->mem, t->L.size);
+    if (bytes == row) memcpy(scratch, src, scratch_bytes);
+    else for (size_t i = 0; i < count; i++) memcpy(scratch + i * bytes, src + i * row, bytes);
+    // Distinct VM mappings may alias. Materialize the region snapshot before writing.
+    __asm__ volatile("" : : "r"(scratch) : "memory");
+    for (size_t i = 0; i < count; i++) memcpy(first + i * (size_t)pitch, scratch + i * bytes, bytes);
+    if (scratch != local) free(scratch);
+    return 1;
+}
