diff --git a/graphics/nvn/gfx/nvn/rb_pass_cut_rule.h b/graphics/nvn/gfx/nvn/rb_pass_cut_rule.h
new file mode 100644
index 0000000..5cb6061
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/rb_pass_cut_rule.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: Apache-2.0
+// RewindBox (patch 0440): Apple A18 Pro TBDR attachment-footprint-scaled mid-pass cut policy.
+//
+// Between-pass sub_cut() has ZERO extra attachment traffic and stays at DM_NVN_CUT (default 64).
+// Inside an open render pass (sub_cut_pass), ending and reopening the encoder forces Apple9 TBDR
+// to Store every active color/depth/stencil tile to LPDDR5X and Load it back on the next draw
+// (2x attachment footprint per split: e.g., 72 MiB DRAM round-trip per split on a 4-MRT + D32F
+// 1440x810 G-buffer at 60 GB/s peak bandwidth = ~1.2-2.4 ms wasted DRAM bandwidth + tile stalls).
+//
+// Policy:
+//   - DM_NVN_CUT=0: disabled (returns 0).
+//   - Explicit DM_NVN_CUT env override (e.g. t_nvn_cut_inpass.m DM_NVN_CUT=4) or tiny targets
+//     (< 1 MiB with <= 1 attachment): returns base_cut unchanged.
+//   - S2A_RB_PASS_CUT_SCALE=1: restores unscaled mid-pass cuts; 2..16 forces a fixed multiplier.
+//   - Default: scales mid-pass cut threshold by active attachment footprint & MRT count:
+//       * >= 24 MiB or >= 4 attachments: 8x (512 draws)
+//       * >= 10 MiB or >= 2 attachments: 6x (384 draws)
+//       * >=  1 MiB:                     4x (256 draws)
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+
+static inline int rb_pass_cut_scale_env(const char *env) {
+    if (!env || !*env) return 0;
+    int v = atoi(env);
+    if (v <= 0) return 0;
+    if (v > 16) return 16;
+    return v;
+}
+
+static inline int rb_pass_cut_draws_ex(int base_cut, int explicit_cut, int scale_override,
+                                       int n_color, int has_depth, uint64_t att_bytes) {
+    if (base_cut <= 0) return 0;
+    if (explicit_cut || scale_override == 1) return base_cut;
+    if (scale_override >= 2) {
+        int64_t scaled = (int64_t)base_cut * (int64_t)scale_override;
+        return scaled > 4096 ? 4096 : (int)scaled;
+    }
+    const int n_att = (n_color > 0 ? n_color : 0) + (has_depth ? 1 : 0);
+    int mult = 1;
+    if (att_bytes >= (UINT64_C(24) << 20) || n_att >= 4) mult = 8;
+    else if (att_bytes >= (UINT64_C(10) << 20) || n_att >= 2) mult = 6;
+    else if (att_bytes >= (UINT64_C(1) << 20)) mult = 4;
+    int64_t scaled = (int64_t)base_cut * (int64_t)mult;
+    return scaled > 4096 ? 4096 : (int)scaled;
+}
+
+static inline int rb_pass_cut_draws(int base_cut, int n_color, int has_depth, uint64_t att_bytes) {
+    return rb_pass_cut_draws_ex(base_cut, 0, 0, n_color, has_depth, att_bytes);
+}
+
+// Conservative bytes-per-pixel estimate for common Metal render-target pixel formats
+// (values match MTLPixelFormat enum constants in Metal/MTLPixelFormat.h).
+static inline uint64_t rb_pass_mtl_bpp(uint32_t pf) {
+    switch (pf) {
+        case 0: return 0;
+        case 1: case 10: case 11: case 12: case 13: case 14: case 253: return 1; // A8 / R8 / Stencil8
+        case 20: case 22: case 23: case 24: case 25: case 30: case 31: case 32: case 33: case 34:
+        case 40: case 41: case 42: case 43: case 250: return 2; // R16 / RG8 / B5G6R5 / Depth16
+        case 110: case 112: case 113: case 114: case 115: case 103: case 104: case 105:
+        case 260: return 8; // RG32 / RGBA16 / Depth32_Stencil8
+        case 123: case 124: case 125: return 16; // RGBA32
+        default: return 4; // RGBA8 / BGRA8 / RGB10A2 / RG11B10F / R32 / Depth32Float
+    }
+}
+
+static inline uint64_t rb_pass_footprint_bytes(const uint32_t cfmt[8], uint32_t dfmt, uint32_t sfmt,
+                                               uint32_t samples, uint64_t w, uint64_t h,
+                                               int *n_color_out, int *has_depth_out) {
+    int nc = 0;
+    uint64_t bpp = 0;
+    for (int i = 0; i < 8; i++) {
+        if (cfmt[i]) { nc++; bpp += rb_pass_mtl_bpp(cfmt[i]); }
+    }
+    int hd = (dfmt != 0 || sfmt != 0) ? 1 : 0;
+    if (dfmt) bpp += rb_pass_mtl_bpp(dfmt);
+    if (sfmt && sfmt != dfmt) bpp += rb_pass_mtl_bpp(sfmt);
+    if (n_color_out) *n_color_out = nc;
+    if (has_depth_out) *has_depth_out = hd;
+    uint64_t ms = samples > 1 ? (uint64_t)samples : 1ull;
+    return w * h * bpp * ms;
+}
