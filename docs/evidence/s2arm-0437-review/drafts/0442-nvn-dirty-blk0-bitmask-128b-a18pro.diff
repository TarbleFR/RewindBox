-    if (atomic_load(&g_track_unreliable)) return 1;   // 有保护失败过：一律视为脏，不靠旧代际比较
+    if (atomic_load_explicit(&g_track_unreliable, memory_order_relaxed)) return 1;   // 有保护失败过：一律视为脏，不靠旧代际比较
     uintptr_t p = (a - r->base) >> g_shift, q = (a + len - 1 - r->base) >> g_shift;
-    for (uintptr_t i = p; i <= q; i++) if (atomic_load(&r->gen[i]) > stamp) return 1;   // The generation of the last write before upload is <= the stamp; any later write must be > the stamp
+    const _Atomic uint64_t *gen = r->gen;
+    for (uintptr_t i = p; i <= q; i++) if (atomic_load_explicit(&gen[i], memory_order_acquire) > stamp) return 1;   // The generation of the last write before upload is <= the stamp; any later write must be > the stamp
     return 0;
 }
 int nvn_dirty_since_span(const void *span, const void *addr, size_t len, uint64_t stamp) { return nvn_dirty_since_cached(&span, addr, len, stamp); }
@@ -779,7 +815,7 @@ uint64_t nvn_dirty_range_writes(const void **span, const void *addr, size_t len)
     if (!len || atomic_load_explicit(&g_wseq_on, memory_order_relaxed) <= 0) return 0;
     range_t *r = span_slot(*span); uintptr_t a = (uintptr_t)addr;
     if (!r || !atomic_load_explicit(&r->live, memory_order_acquire) || a < r->base || a + len > r->end) { r = find_span(a, len); *span = r; }
-    if (!r || atomic_load(&g_track_unreliable) || atomic_load(&r->ovl)) return 0;
+    if (!r || atomic_load_explicit(&g_track_unreliable, memory_order_relaxed) || atomic_load_explicit(&r->ovl, memory_order_acquire)) return 0;
     if (a + len <= r->base + g_pg || a + g_pg >= r->end) return 0;   // wholly inside the first or the last host page
     uint64_t w;
     if (atomic_load_explicit(&r->use_stripes, memory_order_acquire) && r->stripes) {
@@ -787,15 +823,20 @@ uint64_t nvn_dirty_range_writes(const void **span, const void *addr, size_t len)
         const unsigned sh = atomic_load_explicit(&r->stripe_shift, memory_order_relaxed);
         uintptr_t s0 = p >> sh, s1 = q >> sh;
         if (s1 >= RB_DIRTY_STRIPES) s1 = RB_DIRTY_STRIPES - 1;
-        w = 0;
-        for (uintptr_t s = s0; s <= s1; s++) {
-            if (atomic_load_explicit(&r->stripes[s].wbusy, memory_order_acquire)) return 0;
-            const uint64_t v = atomic_load_explicit(&r->stripes[s].wseq, memory_order_acquire);
-            if (v > w) w = v;
+        if (s0 == s1) {
+            if (atomic_load_explicit(&r->stripes[s0].wbusy, memory_order_acquire)) return 0;
+            w = atomic_load_explicit(&r->stripes[s0].wseq, memory_order_acquire);
+        } else {
+            w = 0;
+            for (uintptr_t s = s0; s <= s1; s++) {
+                if (atomic_load_explicit(&r->stripes[s].wbusy, memory_order_acquire)) return 0;
+                const uint64_t v = atomic_load_explicit(&r->stripes[s].wseq, memory_order_acquire);
+                if (v > w) w = v;
+            }
         }
     } else {
-        if (atomic_load(&r->wbusy)) return 0;   // read before wseq: an unprotect that began earlier either shows here or has stored its generations and its count
-        w = atomic_load(&r->wseq);
+        if (atomic_load_explicit(&r->wbusy, memory_order_acquire)) return 0;   // read before wseq: an unprotect that began earlier either shows here or has stored its generations and its count
+        w = atomic_load_explicit(&r->wseq, memory_order_acquire);
     }
     return atomic_load_explicit(&r->live, memory_order_acquire) ? w : 0;
 }
