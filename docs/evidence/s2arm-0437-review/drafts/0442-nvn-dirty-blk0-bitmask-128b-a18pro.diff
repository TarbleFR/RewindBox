@@ -61,9 +61,32 @@ enum { BLK_SHIFT = 10, BLK = 1 << BLK_SHIFT, NBLK = 256, MAX_RANGE = BLK * NBLK
 // RewindBox (patch 0025): sparse: per page, protected for a placement sparse tile (nvn_dirty_protect_sparse; seedds/nxnative 1d4b8e82, dm/gfx/nvn/nvn_dirty.c:31 at 0c078130, MIT,
 //   Copyright (c) 2026 seedds). ovl (S2Arm adaptation): the pool overlaps another live one past the host page adjacent pools share, so find_span never answers it from its cache
 enum { RB_DIRTY_STRIPES = 64, RB_DIRTY_STRIPE_MIN_PAGES = 128 };
-typedef struct { _Atomic uint64_t wseq; _Atomic uint32_t wbusy; } rb_dirty_stripe;
-typedef struct { uintptr_t base, end, mem; _Atomic uint8_t *state; _Atomic uint64_t *gen; _Atomic(_Atomic uint8_t *) sparse; size_t cap; _Atomic int live; _Atomic uint8_t ovl;
-                 _Atomic uint64_t wseq; _Atomic uint32_t wbusy; rb_dirty_stripe *stripes; _Atomic uint8_t stripe_shift; _Atomic uint8_t use_stripes; } range_t;   // RewindBox (patch 0320/0425): wseq / wbusy + per-stripe wseq/wbusy for large pools (>=128 pages)
+// RewindBox (patch 0442): pad range_t to exact 128B power-of-two (1 A18 Pro cache line per pool,
+// turning span_slot()'s 64-bit modulo into (o & 127)), while keeping rb_dirty_stripe compact
+// (16B -> all 64 stripes fit in 1 KiB = 8 A18 Pro cache lines; 128B stripe padding was tested
