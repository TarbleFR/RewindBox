+    uintptr_t mem;
+    _Atomic uint8_t *state;
+    _Atomic(_Atomic uint8_t *) sparse;
+    size_t cap;
+    uint8_t pad1_[32];
+} range_t;   // RewindBox (patch 0320/0425/0442): hot64+cold64 = 128B power-of-two range_t
+_Static_assert(sizeof(range_t) == 128, "range_t must be 128B power-of-two for bitmask span_slot");
 static _Atomic(range_t *) g_blk[NBLK];
 static inline range_t *rg(int i) { return &atomic_load_explicit(&g_blk[i >> BLK_SHIFT], memory_order_acquire)[i & (BLK - 1)]; }
 static _Atomic int g_nr;
@@ -750,11 +773,23 @@ uint64_t nvn_dirty_now(void) { return atomic_load(&g_now); }
 //   Kart World race). nvn_dirty_since_span is it with the caller's handle, as upstream. S2Arm adaptations: the "tracking unreliable" answer (written) stays; and a kept handle is
 //   used only while it is a slot of the current range table (span_slot), as nvn_dirty_reset_session frees the table and a handle kept in a thread-local (229fc22c's
 //   hle_nvn.c t_rw_span) can outlive it. A handle nvn_dirty_span gave in this session always passes, so nvn_dirty_since_span answers as before
-static range_t *span_slot(const void *h) {
-    int n = atomic_load(&g_nr);
-    for (int b = 0; h && b < NBLK && (b << BLK_SHIFT) < n; b++) {
-        range_t *blk = atomic_load_explicit(&g_blk[b], memory_order_acquire); uintptr_t o = (uintptr_t)h - (uintptr_t)blk;
-        if (blk && (uintptr_t)h >= (uintptr_t)blk && o < BLK * sizeof *blk && o % sizeof *blk == 0) return (range_t *)h;
+static inline range_t *span_slot(const void *h) {
+    if (!h) return NULL;
+    // RewindBox (patch 0442): O(1) 6-instruction fast path for pools 0..1023 (g_blk[0]) using
+    // power-of-two 128B range_t bitmask alignment and unsigned wrap range check.
+    range_t *b0 = atomic_load_explicit(&g_blk[0], memory_order_acquire);
+    if (__builtin_expect(b0 != NULL, 1)) {
+        uintptr_t o = (uintptr_t)h - (uintptr_t)b0;
+        if (__builtin_expect(o < BLK * sizeof *b0 && (o & (sizeof *b0 - 1u)) == 0, 1))
+            return (range_t *)h;
+    }
+    int n = atomic_load_explicit(&g_nr, memory_order_acquire);
+    for (int b = 1; b < NBLK && (b << BLK_SHIFT) < n; b++) {
+        range_t *blk = atomic_load_explicit(&g_blk[b], memory_order_acquire);
+        if (!blk) continue;
+        uintptr_t o = (uintptr_t)h - (uintptr_t)blk;
+        if (o < BLK * sizeof *blk && (o & (sizeof *blk - 1u)) == 0)
+            return (range_t *)h;
     }
     return NULL;
 }
@@ -763,9 +798,10 @@ int nvn_dirty_since_cached(const void **span, const void *addr, size_t len, uint
     range_t *r = span_slot(*span); uintptr_t a = (uintptr_t)addr;
     if (!r || !atomic_load_explicit(&r->live, memory_order_acquire) || a < r->base || a + len > r->end) { r = find_span(a, len); *span = r; }
