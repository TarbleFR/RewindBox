+static inline uint64_t nvn_hm_slot_hash(const void *k, uint32_t len) {
+    if (len < 32) return nvn_hm_hash(k, len);
+    const uint8_t *p = (const uint8_t *)k;
+    uint64_t h0 = 0x9e3779b97f4a7c15ull ^ len;
+    uint64_t h1 = 0xbf58476d1ce4e5b9ull ^ len;
+    uint64_t h2 = 0x94d049bb133111ebull ^ len;
+    uint64_t h3 = 0xff51afd7ed558ccdull ^ len;
+    for (; len >= 32; p += 32, len -= 32) {
