+        memcpy(&w0, p,      8); memcpy(&w1, p + 8,  8);
+        memcpy(&w2, p + 16, 8); memcpy(&w3, p + 24, 8);
+        h0 = (h0 ^ w0) * 0xff51afd7ed558ccdull;
+        h1 = (h1 ^ w1) * 0xc4ceb9fe1a85ec53ull;
+        h2 = (h2 ^ w2) * 0x9e3779b97f4a7c15ull;
+        h3 = (h3 ^ w3) * 0xbf58476d1ce4e5b9ull;
+    }
