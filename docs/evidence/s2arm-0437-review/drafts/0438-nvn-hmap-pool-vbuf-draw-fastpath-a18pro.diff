+    uint64_t h = (0x9e3779b97f4a7c15ull ^ 8ull ^ w) * 0xff51afd7ed558ccdull;
+    h ^= h >> 32;
+    h ^= h >> 33; h *= 0xc4ceb9fe1a85ec53ull; h ^= h >> 33;
+    return h;
