index 54a59e4..08fe240 100644
--- a/graphics/nvn/gfx/nvn/rb_args_ubo.h
+++ b/graphics/nvn/gfx/nvn/rb_args_ubo.h
@@ -267,3 +267,194 @@ static inline int rb_args_needs_rmu_lock(const rb_args_masks *m, int is_partial,
     if (is_partial) return handle_partial || m->needs_rmu_partial;
     return m->needs_rmu;
 }
+
+// RewindBox (patch 0439): monotone per-stage slot generations & per-shader snapshot diff.
+// Enables:
+//   1. Surviving A -> B -> A shader switches without losing whole-block reuse or partial rebuilds.
+//   2. Surviving safe render-pass boundaries (rp_begin_ex_) without wiping slot provenance.
+//   3. Selective dirty-slot UBO/SSBO patching (including texture-less multi-UBO vertex shaders).
+//   4. O(1) UBO bounds table (NVN_RB_UBOLEN) reuse via per-stage size-change generation.
+#define RB_ARGS_HAS_SLOT_GENS 1
+
+typedef struct {
+    uint64_t other_gen;
+    uint32_t ubo_all;
+    uint32_t ssbo_all;
+    uint32_t tex_all;
+    uint32_t samp_all;
+    uint8_t ubo_last_slot;
+    uint8_t pad_[3];
+    uint32_t ubo[16];
+    uint32_t ssbo[16];
+    uint32_t tex_blk[4];
+    uint32_t samp_blk[2];
+} rb_args_stage_gens;
+
+typedef rb_args_stage_gens rb_args_slot_snap;
+
+typedef struct {
+    uint8_t unchanged;
+    uint8_t partial_ok;
+    uint8_t tex_unchanged;
+    uint8_t tex_blk_dirty;
+    uint8_t samp_blk_dirty;
+    uint16_t ubo_dirty;
+    uint16_t ssbo_dirty;
+} rb_args_diff;
+
+static inline void rb_args_stage_init_all(rb_args_stage_gens g[6]) {
+    memset(g, 0, sizeof(rb_args_stage_gens) * 6u);
+    for (int st = 0; st < 6; st++) g[st].other_gen = 1;
+}
+static inline void rb_args_stage_bump_other(rb_args_stage_gens *g) {
+    g->other_gen++;
+}
+static inline void rb_args_stage_bump_all_other(rb_args_stage_gens g[6]) {
+    for (int st = 0; st < 6; st++) g[st].other_gen++;
+}
+static inline void rb_args_stage_bump_ubo(rb_args_stage_gens *g, unsigned idx) {
+    if (idx < 16u) {
+        g->ubo_last_slot = (uint8_t)idx;
+        if (__builtin_expect(++g->ubo_all == 0u || ++g->ubo[idx] == 0u, 0)) g->other_gen++;
+    } else g->other_gen++;
+}
+static inline void rb_args_stage_bump_ssbo(rb_args_stage_gens *g, unsigned idx) {
+    if (idx < 16u) {
+        if (__builtin_expect(++g->ssbo_all == 0u || ++g->ssbo[idx] == 0u, 0)) g->other_gen++;
+    } else g->other_gen++;
+}
+static inline void rb_args_stage_bump_tex(rb_args_stage_gens *g, unsigned idx) {
+    if (__builtin_expect(++g->tex_all == 0u, 0)) g->other_gen++;
+    if (idx < 256u) {
+        if (__builtin_expect(++g->tex_blk[idx >> 6] == 0u, 0)) g->other_gen++;
+    } else g->other_gen++;
+}
+static inline void rb_args_stage_bump_tex_range(rb_args_stage_gens *g, int first, int n) {
+    if (__builtin_expect(++g->tex_all == 0u, 0)) g->other_gen++;
+    if (first < 0 || n < 0 || first + n > 256) { g->other_gen++; return; }
+    if (!n) return;
+    unsigned b0 = (unsigned)first >> 6;
+    unsigned b1 = (unsigned)(first + n - 1) >> 6;
+    for (unsigned b = b0; b <= b1; b++) {
+        if (__builtin_expect(++g->tex_blk[b] == 0u, 0)) g->other_gen++;
+    }
+}
+static inline void rb_args_stage_bump_samp_range(rb_args_stage_gens *g, int first, int n) {
+    if (__builtin_expect(++g->samp_all == 0u, 0)) g->other_gen++;
+    if (first < 0 || n < 0 || first + n > 128) { g->other_gen++; return; }
+    if (!n) return;
+    unsigned b0 = (unsigned)first >> 6;
+    unsigned b1 = (unsigned)(first + n - 1) >> 6;
+    for (unsigned b = b0; b <= b1; b++) {
+        if (__builtin_expect(++g->samp_blk[b] == 0u, 0)) g->other_gen++;
+    }
+}
+static inline void rb_args_stage_capture(rb_args_slot_snap *snap, const rb_args_stage_gens *g) {
+    if (__builtin_expect(snap->other_gen != g->other_gen, 0)) {
+        *snap = *g;
+        return;
+    }
+    if (snap->ubo_all != g->ubo_all) {
+        if (g->ubo_all == snap->ubo_all + 1u) {
+            unsigned r = g->ubo_last_slot;
+            snap->ubo[r] = g->ubo[r];
+        } else {
+            memcpy(snap->ubo, g->ubo, sizeof snap->ubo);
+        }
+        snap->ubo_all = g->ubo_all;
+    }
+    if (__builtin_expect(snap->ssbo_all != g->ssbo_all, 0)) {
+        snap->ssbo_all = g->ssbo_all;
+        memcpy(snap->ssbo, g->ssbo, sizeof snap->ssbo);
+    }
+    if (__builtin_expect(snap->tex_all != g->tex_all, 0)) {
+        snap->tex_all = g->tex_all;
+        memcpy(snap->tex_blk, g->tex_blk, sizeof snap->tex_blk);
+    }
+    if (__builtin_expect(snap->samp_all != g->samp_all, 0)) {
+        snap->samp_all = g->samp_all;
+        memcpy(snap->samp_blk, g->samp_blk, sizeof snap->samp_blk);
+    }
+}
+static inline rb_args_diff rb_args_stage_diff(const rb_args_stage_gens *g,
+                                              const rb_args_slot_snap *snap,
+                                              const rb_args_masks *m) {
+    rb_args_diff d = {0};
+    if (__builtin_expect(!m || !m->built || !snap->other_gen || g->other_gen != snap->other_gen || m->has_img, 0))
+        return d;
+
+    // O(1) fast path: all 4 summary counters unchanged (1 cache line compare).
+    if (g->ubo_all == snap->ubo_all && g->ssbo_all == snap->ssbo_all &&
+        g->tex_all == snap->tex_all && g->samp_all == snap->samp_all) {
+        d.unchanged = 1;
+        d.partial_ok = 1;
+        d.tex_unchanged = 1;
+        return d;
+    }
+
+    if (m->ubo && g->ubo_all != snap->ubo_all) {
+        if (g->ubo_all == snap->ubo_all + 1u) {
+            uint16_t bit = (uint16_t)(1u << g->ubo_last_slot);
+            if (m->ubo & bit) d.ubo_dirty = bit;
+        } else {
+            uint16_t um = m->ubo;
+            while (um) {
+                unsigned r = (unsigned)__builtin_ctz(um);
+                um &= (uint16_t)(um - 1);
+                if (g->ubo[r] != snap->ubo[r]) d.ubo_dirty |= (uint16_t)(1u << r);
+            }
+        }
+    }
+    if (m->ssbo && g->ssbo_all != snap->ssbo_all) {
+        uint16_t sm = m->ssbo;
+        while (sm) {
+            unsigned r = (unsigned)__builtin_ctz(sm);
+            sm &= (uint16_t)(sm - 1);
+            if (g->ssbo[r] != snap->ssbo[r]) d.ssbo_dirty |= (uint16_t)(1u << r);
+        }
+    }
+
+    uint8_t tb = 0;
+    if (g->tex_all != snap->tex_all) {
+        if (m->dyn_tex) tb = 0x0fu;
+        else {
+            for (unsigned w = 0; w < 4u; w++) {
+                if (m->tex[w] && g->tex_blk[w] != snap->tex_blk[w]) tb |= (uint8_t)(1u << w);
+            }
+        }
+    }
+    uint8_t sb = 0;
+    if (g->samp_all != snap->samp_all) {
+        if (m->dyn_samp) sb = 0x03u;
+        else {
+            for (unsigned w = 0; w < 2u; w++) {
+                if (m->samp[w] && g->samp_blk[w] != snap->samp_blk[w]) sb |= (uint8_t)(1u << w);
+            }
+        }
+    }
+
+    d.tex_blk_dirty = tb;
+    d.samp_blk_dirty = sb;
+    d.tex_unchanged = (uint8_t)(!tb && !sb);
+
+    if (!d.ubo_dirty && !d.ssbo_dirty && d.tex_unchanged) {
+        d.unchanged = 1;
+        d.partial_ok = 1;
+        return d;
+    }
+    if ((m->dyn_tex && tb) || (m->dyn_samp && sb)) return d;
+    if (m->has_ubo_handles && d.ubo_dirty) return d;
+    d.partial_ok = 1;
+    return d;
+}
+static inline int rb_args_kept_snap_tex(unsigned kind, unsigned f1d, unsigned dtt, unsigned reg,
+                                        const rb_args_diff *diff) {
+    if (!rb_args_kept(kind, f1d, dtt)) return 0;
+    if (diff->tex_unchanged) return 1;
+    if (kind == RB_AK_TEX || kind == RB_AK_SAMPT)
+        return reg < 256u && !((diff->tex_blk_dirty >> (reg >> 6)) & 1u);
+    if (kind == RB_AK_SAMP)
+        return reg < 128u && !((diff->samp_blk_dirty >> (reg >> 6)) & 1u);
+    return 0;
+}
+
